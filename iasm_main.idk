// Author: Karac V. Thweatt
//
// iasm_main.idk - IDEKA x86-64 assembler, stand alone entry point
//
// Usage:
//     iasm --encode <file.s>
//
// --encode prints the machine code of every instruction line of the file, one line
// of hex per instruction. It is the unit level check against llvm-mc --show-encoding.

module IDEKA_Assembler_Entrypoint
{
    #import <standard.idk>;
    #import <runtime/ffifio.idk>;
    #import "src/compiler/iasm_elf.idk";
    #import "src/compiler/iasm_coff.idk";

    using standard::io::console;
    using standard::io::file;
    using IDEKA::iasm;

    iasm_read_file(byte* path, int* out_len) -> byte*
    {
        void* f = fopen(path, "rb\0");
        int size;
        int n = 0;
        byte* buf;
        if (f == (void*)0) { -> (byte*)0; };
        fseek(f, 0, 2);
        size = ftell(f);
        fseek(f, 0, 0);
        buf = (byte*)fmalloc((u64)(size + 1));
        if (buf == (byte*)0) { fclose(f); -> (byte*)0; };
        n = fread(buf, 1, size, f);
        fclose(f);
        if (n < 0) { ffree(buf); -> (byte*)0; };
        buf[n] = (byte)0;
        *out_len = n;
        -> buf;
    };

    iasm_usage() -> void
    {
        println("IDEKA assembler (x86-64, AT&T syntax)\0");
        println("Usage: iasm [-f elf|coff] <file.s> -o <out.o>\0");
        println("       iasm --encode <file.s>\0");
        ->;
    };

    // Strips a trailing # comment (outside double quotes) and trims, in place
    iasm_clean(byte* s) -> byte*
    {
        int n = ia_strlen(s);
        int i = 0;
        int st = 0;
        bool inq = false;
        while (i < n)
        {
            if (s[i] == '"') { inq = !inq; };
            if (s[i] == '#' & !inq) { s[i] = (byte)0; n = i; break; };
            i++;
        };
        while (n > 0 & (s[n - 1] == 32 | s[n - 1] == 9 | s[n - 1] == 13)) { n--; s[n] = (byte)0; };
        st = 0;
        while (st < n & (s[st] == 32 | s[st] == 9)) { st++; };
        -> s + st;
    };

    iasm_encode_file(byte* path) -> int
    {
        int len;
        byte* text = iasm_read_file(path, @len);
        IasmCtx* cx;
        Ib ib;
        int i = 0;
        int st = 0;
        int k = 0;
        byte* line;
        byte[8] hx;
        if (text == (byte*)0)
        {
            println("iasm: cannot read file\0");
            -> 1;
        };
        IasmCtx* nc = (IasmCtx*)0;
        cx = (IasmCtx*)fmalloc((u64)@nc[1]);
        iasm_init(cx);
        i = 0;
        while (i < len)
        {
            st = i;
            while (i < len & text[i] != 10) { i++; };
            text[i] = (byte)0;
            line = iasm_clean(text + st);
            i++;
            if (line[0] == 0) { continue; };
            if (line[0] == '.') { continue; };
            if (iasm_encode_line(cx, line, @ib))
            {
                k = 0;
                while (k < ib.n)
                {
                    hx[0] = (byte)ia_hexd(((int)ib.b[k] >> 4) `& 15);
                    hx[1] = (byte)ia_hexd((int)ib.b[k] `& 15);
                    hx[2] = (byte)0;
                    print(hx);
                    k++;
                };
                println("\0");
            }
            else
            {
                print("ERR \0");
                println(cx.err);
            };
        };
        -> 0;
    };

    iasm_assemble_file(byte* src, byte* dst, int fmt) -> int
    {
        int len;
        byte* text = iasm_read_file(src, @len);
        Asm* a;
        if (text == (byte*)0)
        {
            println("iasm: cannot read file\0");
            -> 1;
        };
        a = iasm_new_for(fmt);
        if (!iasm_assemble(a, text, len))
        {
            print("iasm: \0");
            print(src);
            print(":\0");
            print(a.line);
            print(": \0");
            println(a.err);
            -> 1;
        };
        if (!iasm_finish(a))
        {
            print("iasm: \0");
            println(a.err);
            -> 1;
        };
        bool wrote = false;
        if (fmt == IA_FMT_COFF) { wrote = iasm_write_coff(a, dst); }
        else { wrote = iasm_write_elf(a, dst); };
        if (!wrote)
        {
            print("iasm: \0");
            println(a.err);
            -> 1;
        };
        -> 0;
    };

    iasm_run(int argc, byte** argv) -> int
    {
        byte* src = (byte*)0;
        byte* dst = (byte*)0;
        bool enc = false;
        int fmt = IA_FMT_ELF;
        int i = 1;
        while (i < argc)
        {
            if (ia_streq(argv[i], "--encode\0")) { enc = true; }
            else if (ia_streq(argv[i], "-f\0"))
            {
                i++;
                if (i >= argc) { iasm_usage(); -> 1; };
                if (ia_streq(argv[i], "coff\0")) { fmt = IA_FMT_COFF; }
                else
                {
                    if (!ia_streq(argv[i], "elf\0")) { iasm_usage(); -> 1; };
                };
            }
            else
            {
                if (ia_streq(argv[i], "-o\0"))
                {
                    i++;
                    if (i >= argc) { iasm_usage(); -> 1; };
                    dst = argv[i];
                }
                else { src = argv[i]; };
            };
            i++;
        };
        if (src == (byte*)0) { iasm_usage(); -> 1; };
        if (enc) { -> iasm_encode_file(src); };
        if (dst == (byte*)0) { iasm_usage(); -> 1; };
        -> iasm_assemble_file(src, dst, fmt);
    };

    main() -> int
    {
        -> iasm_run(1, (byte**)0);
    };

    main(int argc, byte** argv) -> int
    {
        -> iasm_run(argc, argv);
    };
}
#build
{
    #[name] = "iasm"
};
