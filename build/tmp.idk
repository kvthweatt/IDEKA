        idkvm_host_triple() -> byte*
        {






            -> g"x86_64-pc-windows-msvc\0";
        };


        idkvm_has_ci(byte* s, byte* lit) -> bool
        {
            int n = idkvm_strlen(s);
            int m = idkvm_strlen(lit);
            int i, j;
            bool hit;
            while (i + m <= n)
            {
                hit = true;
                j = 0;
                while (j < m & hit)
                {
                    switch (idkvm_lower((int)s[i + j]) != idkvm_lower((int)lit[j])) { case (true) { hit = false; } default {}; };
                    j++;
                };
                switch (hit) { case (true) { -> true; } default {}; };
                i++;
            };
            -> false;
        };


        idkvm_arch_of(byte* t) -> byte*
        {
            int n = idkvm_strlen(t);
            int k;
            byte* r;
            switch (idkvm_has_ci(t, g"x86_64\0") | idkvm_has_ci(t, g"amd64\0")) { case (true) { -> g"x86_64\0"; } default {}; };
            switch (idkvm_has_ci(t, g"aarch64\0") | idkvm_has_ci(t, g"arm64\0")) { case (true) { -> g"arm64\0"; } default {}; };
            switch (idkvm_has_ci(t, g"i386\0") | idkvm_has_ci(t, g"i686\0")) { case (true) { -> g"x86\0"; } default {}; };
            switch (idkvm_has_ci(t, g"arm\0")) { case (true) { -> g"arm\0"; } default {}; };
            while (k < n & t[k] != '-') { k++; };
            r = idkvm_dup(t, k);
            k = 0;
            while (r != (byte*)0 & r[k] != 0)
            {
                r[k] = (byte)idkvm_lower((int)r[k]);
                k++;
            };
            switch (r == (byte*)0) { case (true) { -> g"\0"; } default {}; };
            -> r;
        };


        idkvm_os_of(byte* t) -> byte*
        {
            switch (idkvm_has_ci(t, g"windows\0") | idkvm_has_ci(t, g"win32\0")) { case (true) { -> g"windows\0"; } default {}; };
            switch (idkvm_has_ci(t, g"darwin\0") | idkvm_has_ci(t, g"macos\0") | idkvm_has_ci(t, g"apple\0")) { case (true) { -> g"macos\0"; } default {}; };
            switch (idkvm_has_ci(t, g"linux\0")) { case (true) { -> g"linux\0"; } default {}; };
            switch (idkvm_has_ci(t, g"freestanding\0") | idkvm_has_ci(t, g"none\0")) { case (true) { -> g"freestanding\0"; } default {}; };
            -> g"unknown\0";
        };


        idkvm_abi_of(byte* t) -> byte*
        {
            switch (idkvm_has_ci(t, g"msvc\0")) { case (true) { -> g"msvc\0"; } default {}; };
            switch (idkvm_has_ci(t, g"musl\0")) { case (true) { -> g"musl\0"; } default {}; };
            switch (idkvm_has_ci(t, g"gnu\0")) { case (true) { -> g"gnu\0"; } default {}; };
            -> g"unknown\0";
        };






        idkvm_cpuid(u64 leaf, u64 sub, u64* out) -> void
        {
            u64 a, b, c, d;
            volatile asm
            {
                movq $4, %rax
                movq $5, %rcx
                cpuid
                movq %rax, $0
                movq %rbx, $1
                movq %rcx, $2
                movq %rdx, $3
            } : "=r"(a), "=r"(b), "=r"(c), "=r"(d) : "r"(leaf), "r"(sub) : "rax","rbx","rcx","rdx","memory";
            out[0] = a `& (u64)0xFFFFFFFF;
            out[1] = b `& (u64)0xFFFFFFFF;
            out[2] = c `& (u64)0xFFFFFFFF;
            out[3] = d `& (u64)0xFFFFFFFF;
            ->;
        };


        idkvm_xcr0() -> u64
        {
            u64 x;
            volatile asm
            {
                xorq %rcx, %rcx
                xgetbv
                shlq $$32, %rdx
                orq %rdx, %rax
                movq %rax, $0
            } : "=r"(x) : : "rax","rcx","rdx","memory";
            -> x;
        };

        idkvm_bit(u64 v, int n) -> bool -> ((v >> n) `& (u64)1) != (u64)0;



        idkvm_cpu_has(byte* feat) -> bool
        {
            u64[4] r1 = noinit;
            u64[4] r7 = noinit;
            u64[4] r0 = noinit;
            u64 ecx1, edx1, ebx7, x;
            bool osavx;
            idkvm_cpuid(0, 0, @r0[0]);
            idkvm_cpuid(1, 0, @r1[0]);
            ecx1 = r1[2];
            edx1 = r1[3];
            switch (r0[0] >= (u64)7)
            {
                case (true) {
                    idkvm_cpuid(7, 0, @r7[0]);
                    ebx7 = r7[1];
                }
                default {};
            };
            switch (idkvm_streq(feat, g"sse\0")) { case (true) { -> idkvm_bit(edx1, 25); } default {}; };
            switch (idkvm_streq(feat, g"sse2\0")) { case (true) { -> idkvm_bit(edx1, 26); } default {}; };
            switch (idkvm_streq(feat, g"sse4\0")) { case (true) { -> idkvm_bit(ecx1, 19) & idkvm_bit(ecx1, 20); } default {}; };
            switch (idkvm_streq(feat, g"aes\0")) { case (true) { -> idkvm_bit(ecx1, 25); } default {}; };
            switch (idkvm_streq(feat, g"popcnt\0")) { case (true) { -> idkvm_bit(ecx1, 23); } default {}; };
            switch (idkvm_streq(feat, g"bmi2\0")) { case (true) { -> idkvm_bit(ebx7, 8); } default {}; };

            osavx = false;
            switch (idkvm_bit(ecx1, 27))
            {
                case (true) {
                    x = idkvm_xcr0();
                    osavx = (x `& (u64)6) == (u64)6;
                }
                default {};
            };
            switch (idkvm_streq(feat, g"avx\0")) { case (true) { -> idkvm_bit(ecx1, 28) & osavx; } default {}; };
            switch (idkvm_streq(feat, g"avx2\0")) { case (true) { -> idkvm_bit(ebx7, 5) & idkvm_bit(ecx1, 28) & osavx; } default {}; };

            switch (idkvm_streq(feat, g"avx512\0"))
            {
                case (true) {
                    switch (osavx & idkvm_bit(ebx7, 16) & idkvm_bit(ecx1, 28))
                    {
                        case (true) { -> (idkvm_xcr0() `& (u64)0xE0) == (u64)0xE0; }
                        default {};
                    };
                    -> false;
                }
                default {};
            };
            -> false;
        };


        idkvm_page_size() -> int
        {
            byte* sym, si;
            i64 r;
            int ps = 4096;


            void* hl = LoadLibraryA(g"kernel32.dll\0");
            switch (hl != (void*)0)
            {
                case (true) {
                    sym = GetProcAddress(hl, g"GetSystemInfo\0");
                    switch (sym != (byte*)0)
                    {
                        case (true) {
                            si = idkvm_alloc(64);
                            switch (si != (byte*)0)
                            {
                                case (true) {
                                    def{}* fp(byte*) -> void = sym;
                                    fp(si);
                                    ps = (int)si[4] `| ((int)si[5] << 8) `| ((int)si[6] << 16) `| ((int)si[7] << 24);
                                }
                                default {};
                            };
                        }
                        default {};
                    };
                }
                default {};
            };












            switch (ps <= 0) { case (true) { ps = 4096; } default {}; };
            -> ps;
        };



        object FvmLayouts
        {
            byte** sname, sendian;
            int* ssize, sbits, sfirst, scount;
            int n, cap;
            byte** fname;
            int* ftag, foff, fsize;
            int fn, fcap, cur;
            bool ok;

            __init() -> this
            {
                this.n = 0;
                this.cap = 16;
                this.fn = 0;
                this.fcap = 64;
                this.ok = true;
                this.sname = (byte**)idkvm_alloc(this.cap * 8);
                this.sendian = (byte**)idkvm_alloc(this.cap * 8);
                this.ssize = (int*)idkvm_alloc(this.cap * 4);
                this.sbits = (int*)idkvm_alloc(this.cap * 4);
                this.sfirst = (int*)idkvm_alloc(this.cap * 4);
                this.scount = (int*)idkvm_alloc(this.cap * 4);
                this.fname = (byte**)idkvm_alloc(this.fcap * 8);
                this.ftag = (int*)idkvm_alloc(this.fcap * 4);
                this.foff = (int*)idkvm_alloc(this.fcap * 4);
                this.fsize = (int*)idkvm_alloc(this.fcap * 4);
                switch (this.sname == (byte**)0 | this.sendian == (byte**)0 | this.ssize == (int*)0 | this.sbits == (int*)0 | this.sfirst == (int*)0 | this.scount == (int*)0 | this.fname == (byte**)0 | this.ftag == (int*)0 | this.foff == (int*)0 | this.fsize == (int*)0)
                {
                    case (true) { this.ok = false; }
                    default {};
                };
                -> this;
            };

            __expr() -> FvmLayouts* -> this;

            __exit() -> void
            {
                switch (this.sname != (byte**)0) { case (true) { ffree((byte*)this.sname); } default {}; };
                switch (this.sendian != (byte**)0) { case (true) { ffree((byte*)this.sendian); } default {}; };
                switch (this.ssize != (int*)0) { case (true) { ffree((byte*)this.ssize); } default {}; };
                switch (this.sbits != (int*)0) { case (true) { ffree((byte*)this.sbits); } default {}; };
                switch (this.sfirst != (int*)0) { case (true) { ffree((byte*)this.sfirst); } default {}; };
                switch (this.scount != (int*)0) { case (true) { ffree((byte*)this.scount); } default {}; };
                switch (this.fname != (byte**)0) { case (true) { ffree((byte*)this.fname); } default {}; };
                switch (this.ftag != (int*)0) { case (true) { ffree((byte*)this.ftag); } default {}; };
                switch (this.foff != (int*)0) { case (true) { ffree((byte*)this.foff); } default {}; };
                switch (this.fsize != (int*)0) { case (true) { ffree((byte*)this.fsize); } default {}; };
                this.sname = (byte**)0;
                this.n = 0;
                this.fn = 0;
                ->;
            };

            find(byte* name) -> int
            {
                int i;
                while (i < this.n)
                {
                    switch (idkvm_streq(this.sname[i], name))
                    {
                        case (true) { -> i; }
                        default
                        {
                            i++;
                        };
                    };
                };
                -> -1;
            };


            add_struct(byte* name, byte* endian, int size, int bits) -> bool
            {
                int nc;
                byte** n1, n2;
                int* n3, n4, n5, n6;
                int e = this.find(name);
                switch (e >= 0)
                {
                    case (true) {
                        this.sendian[e] = endian;
                        this.ssize[e] = size;
                        this.sbits[e] = bits;
                        this.sfirst[e] = this.fn;
                        this.scount[e] = 0;
                        this.cur = e;
                        -> true;
                    }
                    default {};
                };
                switch (!this.ok)
                {
                    case (true) { -> false; }
                    default {};
                };
                switch (this.n >= this.cap)
                {
                    case (true) {
                        nc = this.cap * 2;
                        n1 = (byte**)idkvm_grow((byte*)this.sname, nc * 8);
                        n2 = (byte**)idkvm_grow((byte*)this.sendian, nc * 8);
                        n3 = (int*)idkvm_grow((byte*)this.ssize, nc * 4);
                        n4 = (int*)idkvm_grow((byte*)this.sbits, nc * 4);
                        n5 = (int*)idkvm_grow((byte*)this.sfirst, nc * 4);
                        n6 = (int*)idkvm_grow((byte*)this.scount, nc * 4);
                        switch (n1 == (byte**)0 | n2 == (byte**)0 | n3 == (int*)0 | n4 == (int*)0 | n5 == (int*)0 | n6 == (int*)0)
                        {
                            case (true) {
                                this.ok = false;
                                -> false;
                            }
                            default {};
                        };
                        this.sname = n1;
                        this.sendian = n2;
                        this.ssize = n3;
                        this.sbits = n4;
                        this.sfirst = n5;
                        this.scount = n6;
                        this.cap = nc;
                    }
                    default {};
                };
                this.sname[this.n] = name;
                this.sendian[this.n] = endian;
                this.ssize[this.n] = size;
                this.sbits[this.n] = bits;
                this.sfirst[this.n] = this.fn;
                this.scount[this.n] = 0;
                this.cur = this.n;
                this.n++;
                -> true;
            };


            add_field(byte* name, int tag, int off, int size) -> bool
            {
                int nc;
                byte** n1;
                int* n2, n3, n4;
                switch (!this.ok | this.n == 0)
                {
                    case (true) { -> false; }
                    default {};
                };
                switch (this.fn >= this.fcap)
                {
                    case (true) {
                        nc = this.fcap * 2;
                        n1 = (byte**)idkvm_grow((byte*)this.fname, nc * 8);
                        n2 = (int*)idkvm_grow((byte*)this.ftag, nc * 4);
                        n3 = (int*)idkvm_grow((byte*)this.foff, nc * 4);
                        n4 = (int*)idkvm_grow((byte*)this.fsize, nc * 4);
                        switch (n1 == (byte**)0 | n2 == (int*)0 | n3 == (int*)0 | n4 == (int*)0)
                        {
                            case (true) {
                                this.ok = false;
                                -> false;
                            }
                            default {};
                        };
                        this.fname = n1;
                        this.ftag = n2;
                        this.foff = n3;
                        this.fsize = n4;
                        this.fcap = nc;
                    }
                    default {};
                };
                this.fname[this.fn] = name;
                this.ftag[this.fn] = tag;
                this.foff[this.fn] = off;
                this.fsize[this.fn] = size;
                this.fn++;
                this.scount[this.cur] = this.scount[this.cur] + 1;
                -> true;
            };
        };



        object IDEKAVM
        {
            FvmHeap vheap;
            FvmCode code;
            FvmCode mp;             
            FvmFuncs funcs;
            FvmLayouts layouts;
