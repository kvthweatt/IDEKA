                switch (newline)
                {
                    case (true) { standard::io::console::print(g"\n\0"); }
                    default {};
                };
                ->;
            };

            str_op(int op) -> void
            {
                int at, n, an, bn, i, j;
                i64 ad, bd, cd;
                byte* a, b, r;
                bool ok2;
                i64 v;
                switch (op)
                {
                    case (102)
                    {
                        this.pop_val();
                        a = this.str_of(this.pt, this.pd);
                        switch (this.failed) { case (true) { ->; } default {}; };
