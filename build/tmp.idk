            ef_put_val(FvmBuf* o, int tag, i64 d, i64 m) -> void
            {
                u64 u;
                byte[24] tmp = noinit;
                int n;
                switch (tag)
                {
                    case (6)
                    {
                        switch (d != (i64)0)
                        {
                            case (true) { o.put_str(g"true\0"); }
                            default { o.put_str(g"false\0"); };
                        };
                    }
                    case (4) { idkvm_put_double(o, idkvm_dv(tag, d, m)); }
                    case (5) { idkvm_put_double(o, idkvm_dv(tag, d, m)); }
                    case (15) { o.put_n(idkvm_i2p(d), (int)m); }
                    case (3)
                    {
                        switch (d < (i64)0)
                        {
                            case (true) {
                                u = (u64)d;
                                while (u != (u64)0)
                                {
                                    tmp[n] = (byte)(48 + (int)(u % (u64)10));
                                    u = u / (u64)10;
                                    n++;
                                };
                                while (n > 0) { n--; o.put((int)tmp[n]); };
                            }
                            default { o.put_i64(d); };
                        };
                    }
                    default { o.put_i64(d); };
                };
                ->;
            };


            ef_find(FvmVars* v, byte* nm, int nl) -> int
            {
                int i = v.n - 1;
                int k;
                bool same;
                while (i >= 0)
                {
                    same = idkvm_strlen(v.names[i]) == nl;
                    k = 0;
                    while (same & k < nl)
                    {
                        same = v.names[i][k] == nm[k];
                        k++;
                    };
                    switch (same) { case (true) { -> i; } default {}; };
                    i--;
                };
                -> -1;
            };


            ef_get(FvmVars* v, int bi, int* tag, i64* d, i64* m) -> void
            {
                int fi = this.nframes - 1;
                int sl;
                *tag = 0;
                *d = 0;
                *m = 0;
                switch (bi >= 0)
                {
                    case (true) {
                        sl = v.slots[bi];
                        switch (fi >= 0 & sl >= 0)
                        {
                            case (true) {
                                switch (sl < this.fr_nloc[fi])
                                {
                                    case (true) {
                                        sl = this.fr_base[fi] + sl;
                                        switch (this.lc_set[sl] != 0)
                                        {
                                            case (true) {
                                                *tag = this.lc_tag[sl];
                                                *d = this.lc_data[sl];
                                                *m = this.lc_meta[sl];
                                            }
                                            default {};
                                        };
                                    }
                                    default {};
                                };
                            }
                            default {};
                        };
                    }
                    default {};
                };
                ->;
            };


            ef_subst(FvmBuf* o, FvmVars* v, byte* nm, int nl) -> void
            {
                int bi = this.ef_find(v, nm, nl);
                int t;
                i64 d, m;
                switch (bi >= 0)
                {
                    case (true) {
                        this.ef_get(v, bi, @t, @d, @m);
                        this.ef_put_val(o, t, d, m);
                    }
                    default { o.put_n(nm, nl); };
                };
                ->;
            };


            ef_expr(FvmBuf* o, FvmVars* v, byte* e, int n) -> void
            {
                int br = -1;
                int k = 0;
                int t, ai, ii, ds;
                i64 d, m, idx;
                i64* blk;
                bool ok2, digits, plain;
                while (k < n)
                {
                    switch (e[k] == '[' & br < 0) { case (true) { br = k; } default {}; };
                    k++;
                };
                switch (br >= 0 & e[n - 1] == ']')
                {
                    case (true) {
                        ds = br + 1;

                        k = ds;
                        while (k < n - 1 & e[k] == '-') { k++; };
                        digits = k < n - 1;
                        while (k < n - 1) { digits = digits & e[k] >= '0' & e[k] <= '9'; k++; };
                        idx = 0;
                        switch (digits)
                        {
                            case (true) {
                                idx = idkvm_parse_int(e + ds, n - 1 - ds, @ok2);
                                switch (!ok2) { case (true) { idx = -1; } default {}; };
                            }
                            default {
                                ii = this.ef_find(v, e + ds, n - 1 - ds);
                                switch (ii >= 0)
                                {
                                    case (true) {
                                        this.ef_get(v, ii, @t, @d, @m);
                                        switch (t == 4 | t == 5)
                                        {
                                            case (true) { idx = (i64)idkvm_dv(t, d, m); }
                                            default { idx = d; };
                                        };
                                    }
                                    default {};
                                };
                            };
                        };
                        ai = this.ef_find(v, e, br);
                        this.ef_get(v, ai, @t, @d, @m);
                        switch (ai >= 0 & t == 14)
                        {
                            case (true) {
                                blk = (i64*)idkvm_i2p(d);
                                switch (idx >= (i64)0 & idx < blk[0])
                                {
                                    case (true) {
                                        k = 2 + (int)idx * 3;
                                        this.ef_put_val(o, (int)blk[k], blk[k + 1], blk[k + 2]);
                                    }
                                    default { o.put(48); };
                                };
                            }
                            default { o.put(48); };
                        };
                        ->;
                    }
                    default {};
                };

                plain = n > 0;
                k = 0;
                while (k < n)
                {
                    plain = plain & ((e[k] >= 'a' & e[k] <= 'z') | (e[k] >= 'A' & e[k] <= 'Z') | (e[k] >= '0' & e[k] <= '9') | e[k] == '_');
                    k++;
                };
                switch (plain)
                {
                    case (true) { this.ef_subst(o, v, e, n); }
                    default { o.put_n(e, n); };
                };
                ->;
            };


            ef_nth(byte* es, int el, int slot, int* os, int* ol) -> bool
            {
                int k = 0;
                int st, en, cnt;
                while (k <= el)
                {
                    st = k;
                    while (k < el & es[k] != ';') { k++; };
                    en = k;
                    while (st < en & (es[st] == ' ' | es[st] == 9 | es[st] == 10 | es[st] == 13 | es[st] == 11 | es[st] == 12)) { st++; };
                    while (en > st & (es[en - 1] == ' ' | es[en - 1] == 9 | es[en - 1] == 10 | es[en - 1] == 13 | es[en - 1] == 11 | es[en - 1] == 12)) { en--; };
                    switch (en > st)
                    {
                        case (true) {
                            switch (cnt == slot)
                            {
                                case (true) { *os = st; *ol = en - st; -> true; }
                                default {};
                            };
                            cnt++;
                        }
                        default {};
                    };
                    k++;
                };
                -> false;
            };



            op_emitideka(byte* src, FvmVars* v) -> void
            {
                FvmBuf ob;
                FvmBuf* o = @ob;
                int n = idkvm_strlen(src);
                int i = 0;
                int j, bs, be, k, ns, nb, es, ee, slot, ps, pl, kind;
                byte c;
                bool tok, id, quoted;
                byte* body;
                ob.__init();
                defer ob.__exit();
                switch (!o.ok) { case (true) { this.fail(g"allocation failed\0"); ->; } default {}; };
                while (i < n)
                {
                    tok = false;
                    switch (src[i] == '~' & i + 1 < n & src[i + 1] == '$' & i + 2 < n)
                    {
                        case (true) {
                            kind = (int)src[i + 2];
                            quoted = (kind == 'f' | kind == 'i') & i + 3 < n & src[i + 3] == '"';
                            id = (kind >= 'a' & kind <= 'z') | (kind >= 'A' & kind <= 'Z') | kind == '_';
                            switch (quoted)
                            {
                                case (true) {
                                    j = i + 4;
                                    bs = j;
                                    be = -1;
                                    while (j < n & be < 0)
                                    {
                                        c = src[j];
                                        switch (c == 92) { case (true) { j = j + 2; } default {
                                            switch (c == '"') { case (true) { be = j; j++; } default { j++; }; };
                                        }; };
                                    };
                                    switch (be < 0) { case (true) { be = n; } default {}; };
                                    switch (j > n) { case (true) { j = n; } default {}; };
                                    nb = be - bs;
                                    body = src + bs;
                                    switch (kind == 'f')
                                    {
                                        case (true) {
                                            tok = true;
                                            k = 0;
                                            while (k < nb)
                                            {
                                                switch (body[k] == '{' & k + 1 < nb & body[k + 1] != '{')
                                                {
                                                    case (true) {
                                                        k++;
                                                        ns = k;
                                                        while (k < nb & body[k] != '}') { k++; };
                                                        this.ef_subst(o, v, body + ns, k - ns);
                                                        switch (k < nb) { case (true) { k++; } default {}; };
                                                    }
                                                    default {
                                                        switch (body[k] == '{' & k + 1 < nb & body[k + 1] == '{')
                                                        {
                                                            case (true) { o.put(123); k = k + 2; }
                                                            default { o.put((int)body[k]); k++; };
                                                        };
                                                    };
                                                };
                                            };
                                            i = j;
                                        }
                                        default {

                                            k = j;
                                            while (k < n & (src[k] == ' ' | src[k] == 9 | src[k] == 10 | src[k] == 13)) { k++; };
                                            switch (k < n & src[k] == ':')
                                            {
                                                case (true) {
                                                    k++;
                                                    while (k < n & (src[k] == ' ' | src[k] == 9 | src[k] == 10 | src[k] == 13)) { k++; };
                                                    switch (k < n & src[k] == '{')
                                                    {
                                                        case (true) {
                                                            tok = true;
                                                            k++;
                                                            es = k;
                                                            while (k < n & src[k] != '}') { k++; };
                                                            ee = k;
                                                            switch (k < n) { case (true) { k++; } default {}; };
                                                            slot = 0;
                                                            ns = 0;
                                                            while (ns < nb)
                                                            {
                                                                switch (body[ns] == '{' & ns + 1 < nb & body[ns + 1] == '}')
                                                                {
                                                                    case (true) {
                                                                        switch (this.ef_nth(src + es, ee - es, slot, @ps, @pl))
                                                                        {
                                                                            case (true) {
                                                                                this.ef_expr(o, v, src + es + ps, pl);
                                                                                slot++;
                                                                            }
                                                                            default {};
                                                                        };
                                                                        ns = ns + 2;
                                                                    }
                                                                    default { o.put((int)body[ns]); ns++; };
                                                                };
                                                            };
                                                            i = k;
                                                        }
                                                        default {};
                                                    };
                                                }
                                                default {};
                                            };
                                        };
                                    };
                                }
                                default {
                                    switch (id)
                                    {
                                        case (true) {
                                            tok = true;
                                            j = i + 2;
                                            while (j < n & ((src[j] >= 'a' & src[j] <= 'z') | (src[j] >= 'A' & src[j] <= 'Z') | (src[j] >= '0' & src[j] <= '9') | src[j] == '_')) { j++; };
                                            this.ef_subst(o, v, src + i + 2, j - i - 2);
                                            i = j;
                                        }
                                        default {};
                                    };
                                };
                            };
                        }
                        default {};
                    };
                    switch (tok)
                    {
                        case (false) { o.put((int)src[i]); i++; }
                        default {};
                    };
                };
                switch (!o.ok) { case (true) { this.fail(g"allocation failed\0"); ->; } default {}; };
                this.emit_add(3, 15, (i64)o.len, 0, idkvm_dup(o.mem, o.len));
                ->;
            };


            cast_f(int target, int at, i64 ad, i64 am) -> bool
            {
                switch (target == 4 | target == 5)
                {
                    case (true) {
                        switch (target == 4)
                        {
                            case (true) { this.push(target, idkvm_dbl_bits(idkvm_f32_dbl(idkvm_dbl_f32(idkvm_dv(at, ad, am)))), 0); }
                            default { this.push(target, idkvm_dbl_bits(idkvm_dv(at, ad, am)), 0); };
                        };
                        -> true;
                    }
                    default {};
                };
                switch (!idkvm_isf(at, am))
                {
                    case (true) { -> false; }
                    default {};
                };
                switch (target == 6)
                {
                    case (true) {
                        switch (idkvm_bits_dbl(ad) != (double)0.0) { case (true) { this.push(6, 1, 0); } default { this.push(6, 0, 0); }; };
                        -> true;
                    }
                    default {};
                };
                switch (idkvm_is_intlike(target))
                {
                    case (true) {
                        this.push(target, idkvm_trunc(idkvm_bits_dbl(ad)), 0);
                        -> true;
                    }
                    default {};
                };
                -> false;
            };

            truthy(int tag, i64 d, i64 m) -> bool
            {
                switch (idkvm_isf(tag, m))
                {
                    case (true) { -> idkvm_bits_dbl(d) != (double)0.0; }
                    default {};
                };
                switch (tag == 15)
                {
                    case (true) { -> m > (i64)0; }
                    default { -> d != (i64)0; };
                };
            };

            grow_handlers() -> void
            {
                int nc = this.hcap * 2;
                int* n1 = (int*)idkvm_grow((byte*)this.h_frame, nc * 4);
                int* n2 = (int*)idkvm_grow((byte*)this.h_catch, nc * 4);
                int* n3 = (int*)idkvm_grow((byte*)this.h_depth, nc * 4);
                switch (n1 == (int*)0 | n2 == (int*)0 | n3 == (int*)0)
                {
                    case (true) {
                        this.fail(g"handler stack allocation failed\0");
                        ->;
                    }
                    default {};
                };
                this.h_frame = n1;
                this.h_catch = n2;
                this.h_depth = n3;
                this.hcap = nc;
                ->;
            };




            parse_fail(int lineno, byte* msg, byte* extra) -> void
            {
                switch (!this.failed)
                {
                    case (true) {
                        this.errb.clear();
                        this.errb.put_str(g"line \0");
                        this.errb.put_int(lineno);
                        this.errb.put_str(g": \0");
                        this.errb.put_str(msg);
                        switch (extra != (byte*)0) { case (true) { this.errb.put_str(extra); } default {}; };
                        this.failed = true;
                        this.parse_line = lineno;
                    }
                    default {};
                };
                ->;
            };


            parse_fail_tok(int lineno, byte* msg, byte* ln, int k) -> void
            {
                byte* t = idkvm_dup(ln + this.tk_s[k], this.tk_e[k] - this.tk_s[k]);
                switch (t == (byte*)0)
                {
                    case (true) { this.parse_fail(lineno, msg, (byte*)0); }
                    default
                    {
                        this.tmp.clear();
                        this.tmp.put(39);
                        this.tmp.put_str(t);
                        this.tmp.put(39);
                        this.parse_fail(lineno, msg, this.tmp.mem);
                        ffree(t);
                    };
                };
                ->;
            };

            tk_add(int s, int e) -> void
            {
                int nc;
                int* n1, n2;
                switch (this.tk_n >= this.tk_cap)
                {
                    case (true) {
                        nc = this.tk_cap * 2;
                        switch (nc < 16) { case (true) { nc = 16; } default {}; };
                        n1 = (int*)idkvm_grow((byte*)this.tk_s, nc * 4);
                        n2 = (int*)idkvm_grow((byte*)this.tk_e, nc * 4);
                        switch (n1 == (int*)0 | n2 == (int*)0)
                        {
                            case (true) {
                                this.fail(g"token buffer allocation failed\0");
                                ->;
                            }
                            default {};
                        };
                        this.tk_s = n1;
                        this.tk_e = n2;
                        this.tk_cap = nc;
                    }
                    default {};
                };
                this.tk_s[this.tk_n] = s;
                this.tk_e[this.tk_n] = e;
                this.tk_n++;
                ->;
            };


            tokenize(byte* ln, int n) -> void
            {
                int i = 0;
                int j;
                bool inq;
                this.tk_n = 0;
                while (i < n)
                {
                    switch (idkvm_is_space((int)ln[i]))
                    {
                        case (true) { i++; }
                        default
                        {
                            j = i;
                            while (j < n & !idkvm_is_space((int)ln[j]) & ln[j] != '"') { j++; };
                            switch (j < n & ln[j] == '"')
                            {
                                case (true) {
                                    j++;
                                    inq = true;
                                    while (j < n & inq)
                                    {
                                        switch (ln[j] == '\\')
                                        {
                                            case (true) { j = j + 2; }
                                            default
                                            {
                                                switch (ln[j] == '"')
                                                {
                                                    case (true) {
                                                        j++;
                                                        inq = false;
                                                    }
                                                    default { j++; };
                                                };
                                            };
                                        };
                                    };
                                    switch (j > n) { case (true) { j = n; } default {}; };
                                    this.tk_add(i, j);
                                }
                                default
                                {
                                    switch (j > i) { case (true) { this.tk_add(i, j); } default {}; };
                                };
                            };
                            i = j;
                        };
                    };
                };
                ->;
            };


            ttag_index(byte* s, int n) -> int
            {
                int t = 0;
                while (t < 19)
                {
                    switch (idkvm_eq_ci(s, n, idkvm_ttag_name(t))) { case (true) { -> t; } default {}; };
                    t++;
                };
                -> -1;
            };


            unescape(byte* s, int n, int* outlen) -> byte*
            {
                byte* r = idkvm_alloc(n + 1);
                int i = 0;
                int o = 0;
                byte c;
                switch (r == (byte*)0)
                {
                    case (true) { -> r; }
                    default {};
                };
                while (i < n)
                {
                    c = s[i];
                    switch (c == '\\' & i + 1 < n)
                    {
                        case (true) {
                            switch (s[i + 1])
                            {
                                case (110) { r[o] = 10; i = i + 2; }
                                case (114) { r[o] = 13; i = i + 2; }
                                case (116) { r[o] = 9; i = i + 2; }
                                case (48) { r[o] = 0; i = i + 2; }
                                case (92) { r[o] = 92; i = i + 2; }
                                case (34) { r[o] = 34; i = i + 2; }
                                default { r[o] = c; i++; };
                            };
                        }
                        default
                        {
                            r[o] = c;
                            i++;
                        };
                    };
                    o++;
                };
                *outlen = o;
                -> r;
            };


            unescape_text(byte* s, int n) -> byte*
            {
                byte* r = idkvm_alloc(n + 1);
                int i = 0;
                int o = 0;
                switch (r == (byte*)0)
                {
                    case (true) { -> r; }
                    default {};
                };
                while (i < n)
                {
                    switch (s[i] == '\\' & i + 1 < n)
                    {
                        case (true) {
                            switch (s[i + 1])
                            {
                                case (110) { r[o] = 10; i = i + 2; }
                                case (114) { r[o] = 13; i = i + 2; }
                                case (116) { r[o] = 9; i = i + 2; }
                                case (48) { r[o] = 0; i = i + 2; }
                                case (92) { r[o] = 92; i = i + 2; }
                                case (34) { r[o] = 34; i = i + 2; }
                                case (39) { r[o] = 39; i = i + 2; }
                                default
                                {
                                    r[o] = s[i];
                                    i++;
                                };
                            };
                        }
                        default
                        {
                            r[o] = s[i];
                            i++;
                        };
                    };
                    o++;
                };
                -> r;
            };



            parse_val(byte* s, int n) -> byte*
            {
                int i, c, qpos, bpos, rawn, rn, ulen, tg, ms, me, is_, ie, k;
                byte* rest, ub;
                bool ok2, quoted;
                i64 v;
                this.pt = 0;
                this.pd = 0;
                this.pm = 0;
                switch (n >= 2 & s[0] == '"' & s[n - 1] == '"')
                {
                    case (true) {
                        ub = this.unescape(s + 1, n - 2, @ulen);
                        switch (ub == (byte*)0) { case (true) { -> g"allocation failed\0"; } default {}; };
                        this.pt = 15;
                        this.pd = idkvm_p2i(ub);
                        this.pm = (i64)ulen;
                        -> (byte*)0;
                    }
                    default {};
                };
                c = -1;
                i = 0;
                while (i < n & c < 0)
                {
                    switch (s[i] == ':') { case (true) { c = i; } default {}; };
                    i++;
                };
                switch (c < 0)
                {
                    case (true) { -> g"cannot parse value token (expected type:value)\0"; }
                    default {};
                };
                rest = s + c + 1;
                rn = c;
                rn = n - c - 1;
                qpos = -1;
                bpos = -1;
                i = 0;
                while (i < rn)
                {
                    switch (rest[i] == '"' & qpos < 0) { case (true) { qpos = i; } default {}; };
                    switch (rest[i] == '[' & bpos < 0) { case (true) { bpos = i; } default {}; };
                    i++;
                };
                rawn = rn;
                switch (bpos >= 0 & (qpos < 0 | bpos < qpos))
                {
                    case (true) {
                        rawn = bpos;

                        ms = bpos + 1;
                        me = rn;
                        while (me > ms & rest[me - 1] == ']') { me--; };
                        is_ = ms;
                        while (is_ <= me)
                        {
                            ie = is_;
                            while (ie < me & rest[ie] != ',') { ie++; };
                            k = ie - is_;
                            switch (k > 0)
                            {
                                case (true) {
                                    switch (idkvm_eq_ci(rest + is_, k, g"stack_slot\0"))
                                    {
                                        case (true) { this.pm = (i64)1; }
                                        default { this.stub_note(g".ivm PTR meta (struct_type, field offsets, elements)\0"); };
                                    };
                                }
                                default {};
                            };
                            is_ = ie + 1;
                        };
                    }
                    default {};
                };
                quoted = rawn >= 2 & rest[0] == '"' & rest[rawn - 1] == '"';
                switch (idkvm_eq_ci(s, c, g"bytes\0"))
                {
                    case (true) {
                        switch (quoted)
                        {
                            case (true) { ub = this.unescape(rest + 1, rawn - 2, @ulen); }
                            default
                            {
                                ub = idkvm_dup(rest, rawn);
                                ulen = rawn;
                            };
                        };
                        switch (ub == (byte*)0) { case (true) { -> g"allocation failed\0"; } default {}; };
                        this.pt = 15;
                        this.pd = idkvm_p2i(ub);
                        this.pm = (i64)ulen;
                        -> (byte*)0;
                    }
                    default {};
                };
                tg = this.ttag_index(s, c);
                switch (tg < 0 | tg == 9 | tg == 12 | tg == 13 | tg == 14 | tg == 16 | tg == 17 | tg == 18 | tg == 15)
                {
                    case (true) { -> g"unknown type tag\0"; }
                    default {};
                };
                this.pt = tg;
                switch (tg == 4 | tg == 5)
                {
                    case (true) {
                        this.pd = idkvm_dbl_bits(idkvm_parse_double(rest, rawn, @ok2));
                        switch (!ok2) { case (true) { -> g"invalid float value\0"; } default {}; };
                        -> (byte*)0;
                    }
                    default {};
                };
                switch (tg == 11)
                {
                    case (true) {
                        this.pd = 0;
                        this.pm = 0;
                        -> (byte*)0;
                    }
                    default {};
                };
                switch (tg == 6)
                {
                    case (true) {
                        switch (idkvm_eq_ci(rest, rawn, g"true\0") | idkvm_eq_ci(rest, rawn, g"1\0"))
                        {
                            case (true) { this.pd = 1; -> (byte*)0; }
                            default {};
                        };
                        switch (idkvm_eq_ci(rest, rawn, g"false\0") | idkvm_eq_ci(rest, rawn, g"0\0"))
                        {
                            case (true) { this.pd = 0; -> (byte*)0; }
                            default {};
                        };
                        -> g"invalid bool value\0";
                    }
                    default {};
                };
                v = idkvm_parse_int(rest, rawn, @ok2);
                switch (!ok2) { case (true) { -> g"invalid integer value\0"; } default {}; };
                this.pd = v;
                -> (byte*)0;
            };


            is_zero_op(int op) -> bool
            {
                switch (op >= 1 & op <= 20) { case (true) { -> true; } default {}; };
                switch (op >= 21 & op <= 22) { case (true) { -> true; } default {}; };
                switch (op >= 29 & op <= 37) { case (true) { -> true; } default {}; };
                switch (op == 26 | op == 44 | op == 46 | op == 47 | op == 49) { case (true) { -> true; } default {}; };
                switch (op == 52 | op == 53 | op == 56 | op == 57 | op == 60) { case (true) { -> true; } default {}; };
                switch (op == 65 | op == 66 | op == 72 | op == 82) { case (true) { -> true; } default {}; };
                switch (op >= 68 & op <= 70) { case (true) { -> true; } default {}; };
                switch (op >= 75 & op <= 78) { case (true) { -> true; } default {}; };
                switch (op >= 83 & op <= 95) { case (true) { -> true; } default {}; };
                switch (op >= 102 & op <= 108) { case (true) { -> true; } default {}; };
                switch (op >= 111 & op <= 114) { case (true) { -> true; } default {}; };
                switch (op == 116 | op == 119) { case (true) { -> true; } default {}; };
                -> false;
            };


            tok_int(byte* ln, int k, int lineno, i64* out) -> bool
            {
                bool ok2;
                i64 v = idkvm_parse_int(ln + this.tk_s[k], this.tk_e[k] - this.tk_s[k], @ok2);
                switch (!ok2)
                {
                    case (true) {
                        this.parse_fail_tok(lineno, g"invalid integer operand \0", ln, k);
                        -> false;
                    }
                    default {};
                };
                *out = v;
                -> true;
            };


            tok_ttag(byte* ln, int k, int lineno, int* out) -> bool
            {
                int t = this.ttag_index(ln + this.tk_s[k], this.tk_e[k] - this.tk_s[k]);
                switch (t < 0)
                {
                    case (true) {
                        this.parse_fail_tok(lineno, g"unknown TTag \0", ln, k);
                        -> false;
                    }
                    default {};
                };
                *out = t;
                -> true;
            };


            tok_str(byte* ln, int k) -> byte*
            {
                -> idkvm_dup(ln + this.tk_s[k], this.tk_e[k] - this.tk_s[k]);
            };



            parse_operands(int op, byte* ln, int lineno) -> bool
            {
                int rc = this.tk_n - 1;
                int t, k, cnt;
                i64 a, b;
                byte* em, s1;
                FvmVars* evars;
                bool ok3;
                int np, pt1;
                i64* ptg;
                byte* ub;
                i64* tbl;
                bool pf;
                switch (this.is_zero_op(op))
                {
                    case (true) {
                        this.code.add(op, 0, 0, 0, (byte*)0, 0);
                        -> true;
                    }
                    default {};
                };
                switch (op)
                {
                    case (0)
                    {
                        switch (rc < 1)
                        {
                            case (true) {
                                this.parse_fail(lineno, g"PUSH requires a value operand\0", (byte*)0);
                                -> false;
                            }
                            default {};
                        };

                        pf = idkvm_eq_n(ln + this.tk_s[1], 4, g"ptr:\0") & rc > 1;
                        switch (pf)
                        {
                            case (true) {
                                pf = true;
                                k = this.tk_s[1];
                                while (k < this.tk_e[1])
                                {
                                    switch (ln[k] == '[') { case (true) { pf = false; } default {}; };
                                    k++;
                                };
                            }
                            default {};
                        };
                        switch (pf)
                        {
                            case (true) {
                                this.tmp.clear();
                                this.tmp.put_n(ln + this.tk_s[1], this.tk_e[1] - this.tk_s[1]);
                                this.tmp.put(91);
                                t = 2;
                                while (t < this.tk_n)
                                {
                                    switch (t > 2) { case (true) { this.tmp.put(44); } default {}; };
                                    this.tmp.put_n(ln + this.tk_s[t], this.tk_e[t] - this.tk_s[t]);
                                    t++;
                                };
                                switch (this.tmp.mem[this.tmp.len - 1] != ']') { case (true) { this.tmp.put(93); } default {}; };
                                em = this.parse_val(this.tmp.mem, this.tmp.len);
                            }
                            default { em = this.parse_val(ln + this.tk_s[1], this.tk_e[1] - this.tk_s[1]); };
                        };
                        switch (em != (byte*)0)
                        {
                            case (true) {
                                this.parse_fail(lineno, em, (byte*)0);
                                -> false;
                            }
                            default {};
                        };
                        this.code.add(op, (i64)this.pt, this.pd, this.pm, (byte*)0, 0);
                        -> true;
                    }
                    case (43)
                    {
                        switch (rc < 1)
                        {
                            case (true) {
                                this.parse_fail(lineno, g"CALL_PTR requires an argc operand\0", (byte*)0);
                                -> false;
                            }
                            default {};
                        };
                        switch (!this.tok_int(ln, 1, lineno, @a)) { case (true) { -> false; } default {}; };
                        this.code.add(op, a, 0, 0, (byte*)0, 0);
                        -> true;
                    }
                    default {};
                };

                switch (op == 38 | op == 39 | op == 40 | op == 50 | op == 51 | op == 45 | op == 115 | op == 48 | op == 23 | op == 24 | op == 25 | op == 27 | op == 28)
                {
                    case (true) {
                        switch (rc < 1)
                        {
                            case (true) {
                                this.parse_fail(lineno, g"missing integer operand for \0", idkvm_op_name(op));
                                -> false;
                            }
                            default {};
                        };
                        switch (!this.tok_int(ln, 1, lineno, @a)) { case (true) { -> false; } default {}; };
                        this.code.add(op, a, 0, 0, (byte*)0, 0);
                        -> true;
                    }
                    default {};
                };

                switch (op == 71 | op == 73 | op == 74 | op == 61 | op == 62 | op == 63 | op == 64 | op == 54 | op == 55 | op == 80 | op == 97 | op == 100)
                {
                    case (true) {
                        switch (rc < 1)
                        {
                            case (true) {
                                this.parse_fail(lineno, g"missing name operand for \0", idkvm_op_name(op));
                                -> false;
                            }
                            default {};
                        };
                        s1 = this.tok_str(ln, 1);
                        switch (s1 == (byte*)0) { case (true) { this.fail(g"allocation failed\0"); -> false; } default {}; };
                        this.code.add(op, 0, 0, 0, s1, 0);
                        -> true;
                    }
                    default {};
                };
                switch (op)
                {
                    case (101)
                    {
                        switch (rc < 2)
                        {
                            case (true) {
                                this.parse_fail(lineno, g"EXTERN_DECL requires name and ret_tag\0", (byte*)0);
                                -> false;
                            }
                            default {};
                        };
                        t = this.ttag_index(ln + this.tk_s[2], this.tk_e[2] - this.tk_s[2]);
                        switch (t < 0) { case (true) { t = 11; } default {}; };
                        s1 = this.tok_str(ln, 1);
                        switch (s1 == (byte*)0) { case (true) { this.fail(g"allocation failed\0"); -> false; } default {}; };
                        np = rc - 2;
                        switch (np < 0) { case (true) { np = 0; } default {}; };
                        ptg = (i64*)idkvm_alloc((np + 1) * 8);
                        switch (ptg == (i64*)0) { case (true) { this.fail(g"allocation failed\0"); -> false; } default {}; };
                        k = 0;
                        while (k < np)
                        {
                            pt1 = this.ttag_index(ln + this.tk_s[3 + k], this.tk_e[3 + k] - this.tk_s[3 + k]);
                            switch (pt1 < 0) { case (true) { pt1 = 11; } default {}; };
                            ptg[k] = pt1;
                            k++;
                        };
                        this.code.add(op, (i64)t, (i64)np, idkvm_p2i((byte*)ptg), s1, 0);
                        -> true;
                    }
                    case (67)
                    {
                        switch (rc < 2)
                        {
                            case (true) {
                                this.parse_fail(lineno, g"ARRAY_NEW requires type_name and count\0", (byte*)0);
                                -> false;
                            }
                            default {};
                        };
                        switch (!this.tok_int(ln, 2, lineno, @a)) { case (true) { -> false; } default {}; };
                        s1 = this.tok_str(ln, 1);
                        switch (s1 == (byte*)0) { case (true) { this.fail(g"allocation failed\0"); -> false; } default {}; };
                        this.code.add(op, a, 0, 0, s1, 0);
                        -> true;
                    }
                    case (58)
                    {
                        switch (rc < 2)
                        {
                            case (true) {
                                this.parse_fail(lineno, g"LOAD requires ttag and byte_size\0", (byte*)0);
                                -> false;
                            }
                            default {};
                        };
                        switch (!this.tok_ttag(ln, 1, lineno, @t)) { case (true) { -> false; } default {}; };
                        switch (!this.tok_int(ln, 2, lineno, @b)) { case (true) { -> false; } default {}; };
                        this.code.add(op, (i64)t, b, 0, (byte*)0, 0);
                        -> true;
                    }
                    case (59)
                    {
                        switch (rc < 2)
                        {
                            case (true) {
                                this.parse_fail(lineno, g"STORE requires ttag and byte_size\0", (byte*)0);
                                -> false;
                            }
                            default {};
                        };
                        switch (!this.tok_ttag(ln, 1, lineno, @t)) { case (true) { -> false; } default {}; };
                        switch (!this.tok_int(ln, 2, lineno, @b)) { case (true) { -> false; } default {}; };
                        this.code.add(op, (i64)t, b, 0, (byte*)0, 0);
                        -> true;
                    }
                    case (109)
                    {
                        switch (rc < 1)
                        {
                            case (true) {
                                this.parse_fail(lineno, g"CAST requires a type tag operand\0", (byte*)0);
                                -> false;
                            }
                            default {};
                        };
                        switch (!this.tok_ttag(ln, 1, lineno, @t)) { case (true) { -> false; } default {}; };
                        s1 = (byte*)0;
                        switch (rc > 1) { case (true) { s1 = this.tok_str(ln, 2); } default {}; };
                        this.code.add(op, (i64)t, 0, 0, s1, 0);
                        -> true;
                    }
                    case (110)
                    {
                        switch (rc < 1)
                        {
                            case (true) {
                                this.parse_fail(lineno, g"BITCAST requires a type tag operand\0", (byte*)0);
                                -> false;
                            }
                            default {};
                        };
                        switch (!this.tok_ttag(ln, 1, lineno, @t)) { case (true) { -> false; } default {}; };
                        s1 = (byte*)0;
                        switch (rc > 1) { case (true) { s1 = this.tok_str(ln, 2); } default {}; };
                        this.code.add(op, (i64)t, 0, 0, s1, 0);
                        -> true;
                    }
                    case (42)
                    {
                        switch (rc < 2)
                        {
                            case (true) {
                                this.parse_fail(lineno, g"CALL requires name and argc\0", (byte*)0);
                                -> false;
                            }
                            default {};
                        };
                        switch (!this.tok_int(ln, 2, lineno, @a)) { case (true) { -> false; } default {}; };
                        s1 = this.tok_str(ln, 1);
                        switch (s1 == (byte*)0) { case (true) { this.fail(g"allocation failed\0"); -> false; } default {}; };
                        this.code.add(op, a, 0, 0, s1, 0);
                        -> true;
                    }
                    case (79)
                    {
                        switch (rc < 1)
                        {
                            case (true) {
                                this.parse_fail(lineno, g"FFI_LOAD requires a library path\0", (byte*)0);
                                -> false;
                            }
                            default {};
                        };
                        s1 = this.tok_str(ln, 1);
                        switch (s1 == (byte*)0) { case (true) { this.fail(g"allocation failed\0"); -> false; } default {}; };
                        this.code.add(op, 0, 0, 0, s1, 0);
                        -> true;
                    }
                    case (81)
                    {
                        switch (rc < 2)
                        {
                            case (true) {
                                this.parse_fail(lineno, g"FFI_CALL requires argc and ret_type_tag\0", (byte*)0);
                                -> false;
                            }
                            default {};
                        };
                        switch (!this.tok_int(ln, 1, lineno, @a)) { case (true) { -> false; } default {}; };
                        switch (!this.tok_ttag(ln, 2, lineno, @t)) { case (true) { -> false; } default {}; };
                        this.code.add(op, a, (i64)t, 0, (byte*)0, 0);
                        -> true;
                    }
                    case (41)
                    {
                        switch (rc < 1)
                        {
                            case (true) {
                                this.parse_fail(lineno, g"JTABLE requires at least a default address\0", (byte*)0);
                                -> false;
                            }
                            default {};
                        };
                        switch (!this.tok_int(ln, 1, lineno, @a)) { case (true) { -> false; } default {}; };
                        cnt = rc - 1;
                        tbl = (i64*)idkvm_alloc((cnt + 1) * 8);
                        switch (tbl == (i64*)0) { case (true) { this.fail(g"allocation failed\0"); -> false; } default {}; };
                        k = 0;
                        while (k < cnt)
                        {
                            switch (!this.tok_int(ln, k + 2, lineno, @b)) { case (true) { -> false; } default {}; };
                            tbl[k] = b;
                            k++;
                        };
                        this.code.add(op, a, (i64)cnt, 0, (byte*)tbl, 0);
                        -> true;
                    }
                    case (117)
                    {
                        switch (rc < 1)
                        {
                            case (true) {
                                this.parse_fail(lineno, g"EMITIDEKA requires a source text operand\0", (byte*)0);
                                -> false;
                            }
                            default {};
                        };

                        a = (i64)this.tk_s[1];
                        b = (i64)this.tk_e[1];
                        while (a < b & ln[(int)a] == '"') { a = a + (i64)1; };
                        while (b > a & ln[(int)b - 1] == '"') { b = b - (i64)1; };
                        ub = this.unescape_text(ln + (int)a, (int)(b - a));
                        switch (ub == (byte*)0) { case (true) { this.fail(g"allocation failed\0"); -> false; } default {}; };

                        cnt = 0;
                        k = 2;
                        while (k < this.tk_n)
                        {
                            a = (i64)this.tk_s[k];
                            while (a < (i64)this.tk_e[k] & ln[(int)a] != ':') { a = a + (i64)1; };
                            switch (a < (i64)this.tk_e[k]) { case (true) { cnt++; } default {}; };
                            k++;
                        };
                        evars = idkvm_vars_new(cnt);
                        switch (evars == (FvmVars*)0) { case (true) { this.fail(g"allocation failed\0"); -> false; } default {}; };
                        cnt = 0;
                        k = 2;
                        while (k < this.tk_n)
                        {
                            a = (i64)this.tk_s[k];
                            while (a < (i64)this.tk_e[k] & ln[(int)a] != ':') { a = a + (i64)1; };
                            switch (a < (i64)this.tk_e[k])
                            {
                                case (true) {
                                    evars.names[cnt] = idkvm_dup(ln + this.tk_s[k], (int)a - this.tk_s[k]);
                                    b = idkvm_parse_int(ln + (int)a + 1, this.tk_e[k] - (int)a - 1, @ok3);
                                    switch (!ok3)
                                    {
                                        case (true) {
                                            this.parse_fail_tok(lineno, g"invalid integer operand \0", ln, k);
                                            -> false;
                                        }
                                        default {};
                                    };
                                    evars.slots[cnt] = (int)b;
                                    cnt++;
                                }
                                default {};
                            };
                            k++;
                        };
                        this.code.add(op, (i64)cnt, 0, idkvm_p2i((byte*)evars), ub, 0);
                        -> true;
                    }
                    case (118)
                    {
                        switch (rc < 4)
                        {
                            case (true) {
                                this.parse_fail(lineno, g"INLINE_ASM requires body, constraints, n_inputs, n_outputs\0", (byte*)0);
                                -> false;
                            }
                            default {};
                        };
                        this.code.add(op, 0, 0, 0, (byte*)0, 0);
                        -> true;
                    }
                    default {};
                };
                this.parse_fail(lineno, g"unhandled operand encoding for \0", idkvm_op_name(op));
                -> false;
            };




            parse_one(byte* ln, int lineno) -> void
            {
                int n0 = this.tk_e[0] - this.tk_s[0];
                byte* t0 = ln + this.tk_s[0];
                int op = -1;
                int i, tg, sz, bits;
                i64 a, b, c, d;
                byte* nm, en;
                bool emit_here;
                switch (idkvm_eq_ci(t0, n0, g"locals\0"))
                {
                    case (true) {
                        switch (this.tk_n != 2)
                        {
                            case (true) {
                                this.parse_fail(lineno, g"'locals' requires exactly one argument\0", (byte*)0);
                                ->;
                            }
                            default {};
                        };
                        switch (!this.p_in_func & this.p_pass == 1)
                        {
                            case (true) {
                                switch (this.tok_int(ln, 1, lineno, @a)) { case (true) { this.main_locals = (int)a; } default {}; };
                            }
                            default {};
                        };
                        ->;
                    }
                    default {};
                };
                switch (idkvm_eq_ci(t0, n0, g"struct\0"))
                {
                    case (true) {
                        switch (this.p_in_struct)
                        {
                            case (true) {
                                this.parse_fail(lineno, g"nested 'struct' is not allowed\0", (byte*)0);
                                ->;
                            }
                            default {};
                        };
                        switch (this.tk_n < 2)
                        {
                            case (true) {
                                this.parse_fail(lineno, g"'struct' requires a name\0", (byte*)0);
                                ->;
                            }
                            default {};
                        };
                        this.p_in_struct = true;
                        switch (this.p_pass == 0)
                        {
                            case (true) {
                                nm = this.tok_str(ln, 1);
                                en = g"little\0";
                                sz = 0;
                                bits = 0;
                                switch (this.tk_n > 2) { case (true) { en = this.tok_str(ln, 2); } default {}; };
                                switch (this.tk_n > 3)
                                {
                                    case (true) {
                                        switch (!this.tok_int(ln, 3, lineno, @a)) { case (true) { ->; } default {}; };
                                        sz = (int)a;
                                    }
                                    default {};
                                };
                                switch (this.tk_n > 4)
                                {
                                    case (true) {
                                        switch (!this.tok_int(ln, 4, lineno, @b)) { case (true) { ->; } default {}; };
                                        bits = (int)b;
                                    }
                                    default {};
                                };
                                switch (nm == (byte*)0 | en == (byte*)0 | !this.layouts.add_struct(nm, en, sz, bits))
                                {
                                    case (true) { this.fail(g"struct layout allocation failed\0"); }
                                    default {};
                                };
                            }
                            default {};
                        };
                        ->;
                    }
                    default {};
                };
                switch (idkvm_eq_ci(t0, n0, g"field\0"))
                {
                    case (true) {
                        switch (!this.p_in_struct)
                        {
                            case (true) {
                                this.parse_fail(lineno, g"'field' outside 'struct' block\0", (byte*)0);
                                ->;
                            }
                            default {};
                        };
                        switch (this.tk_n < 5)
                        {
                            case (true) {
                                this.parse_fail(lineno, g"'field' requires fname ttag byte_offset byte_size\0", (byte*)0);
                                ->;
                            }
                            default {};
                        };
                        switch (this.p_pass == 0)
                        {
                            case (true) {
                                switch (!this.tok_ttag(ln, 2, lineno, @tg)) { case (true) { ->; } default {}; };
                                switch (!this.tok_int(ln, 3, lineno, @c)) { case (true) { ->; } default {}; };
                                switch (!this.tok_int(ln, 4, lineno, @d)) { case (true) { ->; } default {}; };
                                nm = this.tok_str(ln, 1);
                                switch (nm == (byte*)0 | !this.layouts.add_field(nm, tg, (int)c, (int)d))
                                {
                                    case (true) { this.fail(g"struct layout allocation failed\0"); }
                                    default {};
                                };
                            }
                            default {};
                        };
                        ->;
                    }
                    default {};
                };
                switch (idkvm_eq_ci(t0, n0, g"endstruct\0"))
                {
                    case (true) {
                        switch (!this.p_in_struct)
                        {
                            case (true) {
                                this.parse_fail(lineno, g"'endstruct' without matching 'struct'\0", (byte*)0);
                                ->;
                            }
                            default {};
                        };
                        this.p_in_struct = false;
                        ->;
                    }
                    default {};
                };
                switch (idkvm_eq_ci(t0, n0, g"func\0"))
                {
                    case (true) {
                        switch (this.p_in_func)
                        {
                            case (true) {
                                this.parse_fail(lineno, g"nested 'func' is not allowed\0", (byte*)0);
                                ->;
                            }
                            default {};
                        };
                        switch (this.tk_n < 2)
                        {
                            case (true) {
                                this.parse_fail(lineno, g"'func' requires a name\0", (byte*)0);
                                ->;
                            }
                            default {};
                        };
                        this.p_in_func = true;
                        switch (this.p_pass == 0)
                        {
                            case (true) {
                                this.p_fname = this.tok_str(ln, 1);
                                this.p_unit = this.code.unit_begin();
                                switch (this.p_fname == (byte*)0 | this.p_unit < 0) { case (true) { this.fail(g"code pool allocation failed\0"); } default {}; };
                            }
                            default {};
                        };
                        ->;
                    }
                    default {};
                };
                switch (idkvm_eq_ci(t0, n0, g"endfunc\0"))
                {
                    case (true) {
                        switch (!this.p_in_func)
                        {
                            case (true) {
                                this.parse_fail(lineno, g"'endfunc' without matching 'func'\0", (byte*)0);
                                ->;
                            }
                            default {};
                        };
                        this.p_in_func = false;
                        switch (this.p_pass == 0)
                        {
                            case (true) {
                                this.code.unit_end(this.p_unit);
                                this.register_function(this.p_fname, this.p_unit);
                            }
                            default {};
                        };
                        ->;
                    }
                    default {};
                };


                i = 0;
                while (i < 120 & op < 0)
                {
                    switch (idkvm_eq_ci(t0, n0, idkvm_op_name(i))) { case (true) { op = i; } default {}; };
                    i++;
                };
                emit_here = (this.p_pass == 0 & this.p_in_func) | (this.p_pass == 1 & !this.p_in_func);
                switch (!emit_here)
                {
                    case (true) { ->; }
                    default {};
                };
                switch (op < 0)
                {
                    case (true) {
                        this.parse_fail_tok(lineno, g"unknown opcode \0", ln, 0);
                        ->;
                    }
                    default {};
                };
                this.parse_operands(op, ln, lineno);
                ->;
            };



            load_idkvm(byte* text, int len) -> bool
            {
                int pass = 0;
                int pos, ls, le, cut, a, b, lineno;
                byte* ln;
                while (pass < 2 & !this.failed)
                {
                    this.p_pass = pass;
                    this.p_in_func = false;
                    this.p_in_struct = false;
                    pos = 0;
                    lineno = 0;
                    switch (pass == 1)
                    {
                        case (true) { this.p_main = this.code.unit_begin(); }
                        default {};
                    };
                    while (pos < len & !this.failed)
                    {
                        ls = pos;
                        le = pos;
                        while (le < len & text[le] != '\n') { le++; };
                        pos = le + 1;
                        lineno++;
                        cut = ls;
                        while (cut < le & text[cut] != '#') { cut++; };
                        a = ls;
                        b = cut;
                        while (a < b & idkvm_is_space((int)text[a])) { a++; };
                        while (b > a & idkvm_is_space((int)text[b - 1])) { b--; };
                        switch (b > a)
                        {
                            case (true) {
                                ln = idkvm_dup(text + a, b - a);
                                switch (ln == (byte*)0)
                                {
                                    case (true) { this.fail(g"line buffer allocation failed\0"); }
                                    default
                                    {
                                        this.tokenize(ln, b - a);
                                        switch (this.tk_n > 0 & !this.failed) { case (true) { this.parse_one(ln, lineno); } default {}; };
                                        ffree(ln);
                                    };
                                };
                            }
                            default {};
                        };
                    };
                    switch (!this.failed & pass == 0 & this.p_in_func)
                    {
                        case (true) {
                            this.parse_fail(lineno, g"unterminated 'func' at end of file\0", (byte*)0);
                        }
                        default {};
                    };
                    switch (!this.failed & pass == 0 & this.p_in_struct)
                    {
                        case (true) {
                            this.parse_fail(lineno, g"unterminated 'struct' at end of file\0", (byte*)0);
                        }
                        default {};
                    };
                    switch (pass == 1)
                    {
                        case (true) {
                            this.code.unit_end(this.p_main);
                            this.main_unit = this.p_main;
                        }
                        default {};
                    };
                    pass++;
                };
                -> !this.failed;
            };
        };
    };
};



    using standard::io::console;
    using standard::io::file;
    using IDEKA::IDKVM;

    idkvm_usage() -> void
    {
        println("IDEKA VM\0");
        println("Usage: idkvm <program.ivm>\0");
        println("       idkvm <program.idkb>\0");
        println("       idkvm <program.ivm> -o <out.idkb>\0");
        println("       idkvm <program.idkb> -o <out.ivm>\0");
        println("       idkvm --compile <program.ivm> [out.idkb]\0");
        println("       idkvm --decompile <program.idkb> [out.ivm]\0");
        println("       idkvm --inspect <program.ivm|program.idkb>\0");
        println("       idkvm --strings <program.ivm|program.idkb>\0");
        println("\0");
        println("Runs a .ivm opcode file or an IDKB binary on the IDEKA Virtual Machine.\0");
        println("The file type is detected from its contents (IDKB binaries start with IDKB).\0");
        println("\0");
        println("Convert: -o writes the converted file instead of running: .ivm text becomes an IDKB\0");
        println("binary and an IDKB binary becomes .ivm text, which parses back to the same binary.\0");
        println("\0");
        println("Compile: --compile turns .ivm text into an IDKB binary, written to out.idkb, to the\0");
        println("-o file, or to program.idkb next to the input when no output is given.\0");
        println("\0");
        println("Decompile: --decompile prints an IDKB binary as .ivm text, or writes it to out.ivm.\0");
        println("\0");
        println("Inspect: --inspect prints the format, sizes, structs, functions and instruction counts.\0");
        println("\0");
        println("Strings: --strings prints the string table, one escaped string per line in order of first use.\0");
        ->;
    };



    idkvm_read_text(byte* path, int* out_len) -> byte*
    {
        void* f = fopen(path, "rb\0");
        if (f == (void*)0) { -> (byte*)0; };

        fseek(f, 0, SEEK_END);
        int size = ftell(f);
        fseek(f, 0, SEEK_SET);
        if (size < 0)
        {
            fclose(f);
            -> (byte*)0;
        };

        byte* buf = (byte*)fmalloc((u64)size + (u64)1);
        if (buf == (byte*)0)
        {
            fclose(f);
            -> (byte*)0;
        };

        int n = fread(buf, 1, size, f);
        fclose(f);
        if (n < 0)
        {
            ffree(buf);
            -> (byte*)0;
        };
        buf[n] = (byte)0;
        *out_len = n;
        -> buf;
    };


    idkvm_hex_digit(int v) -> int
    {
        if (v < 10) { -> 48 + v; };
        -> 87 + v;
    };


    idkvm_print_val(int tag, i64 d, i64 m) -> void
    {
        FvmBuf nb;
        byte* p;
        int i, n, c;
        nb.__init();
        defer nb.__exit();
        print("Val(\0");
        print(idkvm_ttag_name(tag));
        print(", \0");
        if (tag == 15)
        {
            p = idkvm_i2p(d);
            n = (int)m;
            nb.put(98);
            nb.put(39);
            while (i < n)
            {
                c = (int)p[i];
                switch (c)
                {
                    case (10) { nb.put(92); nb.put(110); }
                    case (13) { nb.put(92); nb.put(114); }
                    case (9)  { nb.put(92); nb.put(116); }
                    case (92) { nb.put(92); nb.put(92); }
                    case (39) { nb.put(92); nb.put(39); }
                    default
                    {
                        switch (c >= 32 & c < 127)
                        {
                            case (true) { nb.put(c); }
                            default
                            {
                                nb.put(92);
                                nb.put(120);
                                nb.put(idkvm_hex_digit((c >> 4) `& 15));
                                nb.put(idkvm_hex_digit(c `& 15));
                            };
                        };
                    };
                };
                i++;
            };
            nb.put(39);
            print(nb.mem);
        }
        else
        {
            nb.put_i64(d);
            print(nb.mem);
        };
        print(")\0");
        ->;
    };


    idkvm_print_hex(byte* mem, int n) -> void
    {
        FvmBuf nb;
        int i;
        nb.__init();
        defer nb.__exit();
        while (i < n)
        {
            nb.put(idkvm_hex_digit(((int)mem[i] >> 4) `& 15));
            nb.put(idkvm_hex_digit((int)mem[i] `& 15));
            i++;
        };
        println(nb.mem);
        ->;
    };



    idkvm_compile(byte* inp, byte* outf) -> int
    {
        int len, k, dot;
        byte* text = idkvm_read_text(inp, @len);
        if (text == (byte*)0)
        {
            print("idkvm: cannot open '\0");
            print(inp);
            println("'\0");
            -> 1;
        };

        IDEKAVM vm;
        vm.__init();
        defer vm.__exit();
        if (!vm.ok)
        {
            println("idkvm: out of memory\0");
            ffree(text);
            -> 1;
        };

        if (!vm.load_idkvm(text, len))
        {
            print("idkvm: parse error in \0");
            print(inp);
            print(": \0");
            println(vm.err_text());
            ffree(text);
            -> 1;
        };
        ffree(text);

        FvmBuf o;
        o.__init();
        defer o.__exit();
        vm.compile_loaded(@o);

        FvmBuf outp;
        outp.__init();
        defer outp.__exit();
        if (outf != (byte*)0)
        {
            outp.put_str(outf);
        }
        else
        {

            dot = -1;
            k = 0;
            while (inp[k] != 0)
            {
                if (inp[k] == '/' | inp[k] == 92) { dot = -1; };
                if (inp[k] == '.' & k > 0 & inp[k - 1] != '/' & inp[k - 1] != 92) { dot = k; };
                k++;
            };
            if (dot < 0) { dot = k; };
            outp.put_n(inp, dot);
            outp.put_str(".idkb\0");
        };

        void* f = fopen(outp.mem, "wb\0");
        if (f == (void*)0)
        {
            print("idkvm: cannot write '\0");
            print(outp.mem);
            println("'\0");
            -> 1;
        };
        fwrite(o.mem, 1, o.len, f);
        fclose(f);
        -> 0;
    };


    idkvm_decompile(byte* inp, byte* outf) -> int
    {
        int len;
        byte* image = idkvm_read_text(inp, @len);
        if (image == (byte*)0)
        {
            print("idkvm: cannot open '\0");
            print(inp);
            println("'\0");
            -> 1;
        };

        IDEKAVM vm;
        vm.__init();
        defer vm.__exit();
        if (!vm.ok)
        {
            println("idkvm: out of memory\0");
            ffree(image);
            -> 1;
        };

        FvmBuf o;
        o.__init();
        defer o.__exit();
        if (!vm.decompile_bin(image, len, @o))
        {
            print("idkvm: parse error in \0");
            print(inp);
            print(": \0");
            println(vm.err_text());
            ffree(image);
            -> 1;
        };
        ffree(image);

        if (outf != (byte*)0)
        {
            void* f = fopen(outf, "w\0");
            if (f == (void*)0)
            {
                print("idkvm: cannot write '\0");
                print(outf);
                println("'\0");
                -> 1;
            };
            fwrite(o.mem, 1, o.len, f);
            fclose(f);
            -> 0;
        };
        print(o.mem);
        -> 0;
    };


    idkvm_is_bin(byte* text, int len) -> bool
    {
        -> len >= 4 & text[0] == 'I' & text[1] == 'D' & text[2] == 'K' & text[3] == 'B';
    };


    idkvm_convert(byte* inp, byte* outf) -> int
    {
        int len;
        bool bin;
        byte* text = idkvm_read_text(inp, @len);
        if (text == (byte*)0)
        {
            print("idkvm: cannot open '\0");
            print(inp);
            println("'\0");
            -> 1;
        };
        bin = idkvm_is_bin(text, len);
        ffree(text);
        if (bin) { -> idkvm_decompile(inp, outf); };
        -> idkvm_compile(inp, outf);
    };


    idkvm_inspect(byte* inp) -> int
    {
        int len;
        bool ok;
        byte* text = idkvm_read_text(inp, @len);
        if (text == (byte*)0)
        {
            print("idkvm: cannot open '\0");
            print(inp);
            println("'\0");
            -> 1;
        };

        IDEKAVM vm;
        vm.__init();
        defer vm.__exit();
        if (!vm.ok)
        {
            println("idkvm: out of memory\0");
            ffree(text);
            -> 1;
        };

        FvmBuf o;
        o.__init();
        defer o.__exit();
        o.put_str("file: \0");
        o.put_str(inp);
        o.put(10);
        ok = vm.inspect_file(text, len, @o);
        if (!ok)
        {
            print("idkvm: parse error in \0");
            print(inp);
            print(": \0");
            println(vm.err_text());
            ffree(text);
            -> 1;
        };
        ffree(text);
        print(o.mem);
        -> 0;
    };


    idkvm_strings(byte* inp) -> int
    {
        int len;
        byte* text = idkvm_read_text(inp, @len);
        if (text == (byte*)0)
        {
            print("idkvm: cannot open '\0");
            print(inp);
            println("'\0");
            -> 1;
        };

        IDEKAVM vm;
        vm.__init();
        defer vm.__exit();
        if (!vm.ok)
        {
            println("idkvm: out of memory\0");
            ffree(text);
            -> 1;
        };

        FvmBuf o;
        o.__init();
        defer o.__exit();
        if (!vm.strings_file(text, len, @o))
        {
            print("idkvm: parse error in \0");
            print(inp);
            print(": \0");
            println(vm.err_text());
            ffree(text);
            -> 1;
        };
        ffree(text);
        print(o.mem);
        -> 0;
    };

    idkvm_run(int argc, byte** argv) -> int
    {

        if (argc < 2)
        {
            idkvm_usage();
            -> 0;
        };


        int mode = 0;
        bool oflag = false;
        byte* src = (byte*)0;
        byte* dst = (byte*)0;
        byte* a;
        int i = 1;
        while (i < argc)
        {
            a = argv[i];
            if (idkvm_streq(a, "--compile\0") | idkvm_streq(a, "-c\0")) { mode = 1; }
            else
            {
                if (idkvm_streq(a, "--decompile\0") | idkvm_streq(a, "-d\0")) { mode = 2; }
                else
                {
                    if (idkvm_streq(a, "--inspect\0") | idkvm_streq(a, "-i\0")) { mode = 3; }
                    else
                    {
                      if (idkvm_streq(a, "--strings\0") | idkvm_streq(a, "-s\0")) { mode = 5; }
                      else
                      {
                        if (idkvm_streq(a, "-o\0"))
                        {
                            i++;
                            if (i >= argc)
                            {
                                println("idkvm: -o needs a file\0");
                                -> 1;
                            };
                            dst = argv[i];
                            oflag = true;
                        }
                        else
                        {
                            if (src == (byte*)0) { src = a; }
                            else
                            {
                                if (dst == (byte*)0) { dst = a; };
                            };
                        };
                      };
                    };
                };
            };
            i++;
        };
        if (mode == 0 & oflag) { mode = 4; };
        if (src == (byte*)0)
        {
            switch (mode)
            {
                case (1) { println("idkvm: --compile needs a .ivm file\0"); }
                case (2) { println("idkvm: --decompile needs an IDKB file\0"); }
                case (3) { println("idkvm: --inspect needs a file\0"); }
                case (4) { println("idkvm: -o needs an input file\0"); }
                case (5) { println("idkvm: --strings needs a file\0"); }
                default { println("idkvm: no input file\0"); };
            };
            -> 1;
        };
        if (mode == 1) { -> idkvm_compile(src, dst); };
        if (mode == 2) { -> idkvm_decompile(src, dst); };
        if (mode == 3) { -> idkvm_inspect(src); };
        if (mode == 4) { -> idkvm_convert(src, dst); };
        if (mode == 5) { -> idkvm_strings(src); };

        byte* path = src;
        int len;
        byte* text = idkvm_read_text(path, @len);
        if (text == (byte*)0)
        {
            print("idkvm: cannot open '\0");
            print(path);
            println("'\0");
            -> 1;
        };

        IDEKAVM vm;
        vm.__init();
        defer vm.__exit();
        if (!vm.ok)
        {
            println("idkvm: out of memory\0");
            ffree(text);
            -> 1;
        };


        bool loaded;
        if (len >= 4 & text[0] == 'I' & text[1] == 'D' & text[2] == 'K' & text[3] == 'B')
        {
            loaded = vm.load_bin(text, len);
        }
        else
        {
            loaded = vm.load_idkvm(text, len);
        };
        if (!loaded)
        {
            print("idkvm: parse error in \0");
            print(path);
            print(": \0");
            println(vm.err_text());
            ffree(text);
            -> 1;
        };
        ffree(text);

        if (!vm.execute_main())
        {
            print("idkvm: runtime error: \0");
            println(vm.err_text());
            vm.stubs.report("[IDKVM]\0");
            -> 1;
        };

        int i;
        int lint_depth;
        FvmBuf lint_out;
        lint_out.__init();
        while (i < vm.emit_count)
        {
            switch (vm.e_kind[i])
            {
                case (0)
                {
                    print("[emit:const] \0");
                    idkvm_print_val(vm.e_tag[i], vm.e_data[i], vm.e_meta[i]);
                    println("\0");
                }
                case (1)
                {
                    print("[emit:global] \0");
                    idkvm_print_hex(vm.e_text[i], (int)vm.e_data[i]);
                }
                case (2)
                {
                    print("[emit:type] \0");
                    idkvm_print_val(vm.e_tag[i], vm.e_data[i], vm.e_meta[i]);
                    println("\0");
                }
                default
                {
                    lint_out.len = 0;
                    lint_out.mem[0] = (byte)0;
                    idkvm_lint_IDEKA(@lint_out, g"[emit:IDEKA] \0", vm.e_text[i], @lint_depth);
                    print(lint_out.mem);
                };
            };
            i++;
        };
        vm.stubs.report("[IDKVM]\0");
        -> 0;
    };

    main() -> int
    {
        -> idkvm_run(1, (byte**)0);
    };

    main(int argc, byte** argv) -> int
    {
        -> idkvm_run(argc, argv);
    };
}
#build
{
    #[name] = "idkvm"
};