            int sp, scap;


            int* fr_unit, fr_ip, fr_base, fr_nloc;
            byte** fr_name;
            int nframes, fcap;


            int* lc_tag;
            int* lc_set;            
            i64* lc_data, lc_meta;
            int lc_top, lc_cap;


            int* h_frame, h_catch, h_depth;
            int nh, hcap;


            byte** g_name;
            int* g_tag;
            i64* g_data, g_meta;
            int gn, gcap;


            i64* arrs;
