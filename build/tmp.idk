        idkvm_bin_shape(int op) -> int
        {
            switch (op == 38 | op == 39 | op == 40 | op == 50 | op == 51 | op == 45 | op == 115 | op == 48 | op == 43 | op == 23 | op == 24 | op == 25 | op == 27 | op == 28)
            {
                case (true) { -> 1; }
                default {};
            };
            switch (op == 71 | op == 73 | op == 74 | op == 61 | op == 62 | op == 63 | op == 64 | op == 54 | op == 55 | op == 79 | op == 80)
            {
                case (true) { -> 2; }
                default {};
            };
            switch (op == 42 | op == 67) { case (true) { -> 3; } default {}; };
            switch (op == 58 | op == 59) { case (true) { -> 4; } default {}; };
            switch (op == 109 | op == 110) { case (true) { -> 5; } default {}; };
            switch (op == 81) { case (true) { -> 6; } default {}; };
            switch (op == 101) { case (true) { -> 7; } default {}; };
            switch (op == 41) { case (true) { -> 8; } default {}; };
            switch (op == 0) { case (true) { -> 9; } default {}; };
            switch (op == 118) { case (true) { -> 10; } default {}; };
            switch (op == 117) { case (true) { -> 11; } default {}; };
            -> 0;
        };


