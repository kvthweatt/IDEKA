// Author: Karac V. Thweatt
//
// ivmcodegen.idk - IDEKA VM code generator (bootstrap, port of ivmcodegen.py)
//
// Compiles the AST of a comptime block to IDKVM bytecode for idkvm.idk.
//
// What is stubbed:
//     every IDKVMCodegen method of ivmcodegen.py that emits bytecode. A stub
//     counts "IDKVMCodegen.<python method>" and emits nothing, so compiling a
//     comptime block shows exactly which parts of ivmcodegen.py are missing.
//     The counts are merged into the code generator's "not generated yet"
//     report (idkc prints them).
//
// What is real:
//     the statement and expression dispatchers (visit_stmt, visit_expr),
//     body traversal, and the DataType to TTag mappings.
//
// What is never ported:
//     inline asm at comptime (visit_inline_asm). It needs a backend that
//     assembles the text, the way Keystone does in the Python compiler.
//
// Usage from icodegen.idk:
//
//     IDKVMCodegen cg;
//     cg.__init();
//     defer cg.__exit();
//     cg.compile_comptime(node);       // COMPTIME_BLOCK, EMIT_IDEKA or IDEKAVM_BLOCK node
//     // cg.ucounts: NameMap of stub name to i64* count, cg.nstubs: total

#ifndef IDEKA_STANDARD
#import <standard.idk>;
#endif;

#ifndef IDEKA_AST
#import "iast.idk";
#endif;

#ifndef IDEKA_TYPES
#import "itypesys.idk";
#endif;

#ifndef IDEKA_LEXER
#import "ilexer.idk";
#endif;

#ifndef IDEKA_IDKVM
#import "idkvm.idk";
#endif;

using IDEKA::ast;
using IDEKA::types;
using IDEKA::lexer;
using IDEKA::IDKVM;

#ifndef IDEKA_IDKVMCODEGEN
#def IDEKA_IDKVMCODEGEN 1;

namespace IDEKA
{
    namespace idkvmcodegen
    {
        // idkvmcodegen._datatype_to_ttag: closest VM tag of a DataType, INT when none fits
        idkvmcg_datatype_ttag(int dt) -> int
        {
            switch (dt)
            {
                case (DataType.SINT) { -> IDKVM_T_INT; }
                case (DataType.UINT) { -> IDKVM_T_UINT; }
                case (DataType.SLONG) { -> IDKVM_T_LONG; }
                case (DataType.ULONG) { -> IDKVM_T_ULONG; }
                case (DataType.FLOAT) { -> IDKVM_T_FLOAT; }
                case (DataType.DOUBLE) { -> IDKVM_T_DOUBLE; }
                case (DataType.BOOL) { -> IDKVM_T_BOOL; }
                case (DataType.BYTE) { -> IDKVM_T_BYTE; }
                case (DataType.CHAR) { -> IDKVM_T_CHAR; }
                default { -> IDKVM_T_INT; };
            };
            -> IDKVM_T_INT;
        };

        // the compiler.target.* properties
        idkvmcg_target_prop(byte* dotted) -> byte*
        {
            byte* pre = g"compiler.target.\0";
            int i;
            while (pre[i] != 0)
            {
                switch (dotted[i] != pre[i]) { case (true) { -> (byte*)0; } default {}; };
                i++;
            };
            byte* p = dotted + i;
            switch (idkvm_streq(p, g"arch\0") | idkvm_streq(p, g"os\0") | idkvm_streq(p, g"abi\0") | idkvm_streq(p, g"ptr_width\0") | idkvm_streq(p, g"endian\0") | idkvm_streq(p, g"cache_line\0") | idkvm_streq(p, g"page_size\0"))
            {
                case (true) { -> p; }
                default {};
            };
            switch (idkvm_streq(p, g"has_sse\0") | idkvm_streq(p, g"has_sse2\0") | idkvm_streq(p, g"has_sse4\0") | idkvm_streq(p, g"has_avx\0") | idkvm_streq(p, g"has_avx2\0") | idkvm_streq(p, g"has_avx512\0") | idkvm_streq(p, g"has_aes\0") | idkvm_streq(p, g"has_popcnt\0") | idkvm_streq(p, g"has_bmi2\0"))
            {
                case (true) { -> p; }
                default {};
            };
            -> (byte*)0;
        };

        // compiler.symbol_table.<kind> gives <kind>
        idkvmcg_symtab_filter(byte* dotted) -> byte*
        {
            byte* pre = g"compiler.symbol_table.\0";
            int i;
            while (pre[i] != 0)
            {
                switch (dotted[i] != pre[i]) { case (true) { -> (byte*)0; } default {}; };
                i++;
            };
            byte* p = dotted + i;
            switch (idkvm_streq(p, g"functions\0") | idkvm_streq(p, g"structs\0") | idkvm_streq(p, g"objects\0") | idkvm_streq(p, g"traits\0") | idkvm_streq(p, g"interfaces\0") | idkvm_streq(p, g"namespaces\0"))
            {
                case (true) { -> p; }
                default {};
            };
            switch (idkvm_streq(p, g"variables\0") | idkvm_streq(p, g"enums\0") | idkvm_streq(p, g"unions\0") | idkvm_streq(p, g"effects\0") | idkvm_streq(p, g"constraints\0") | idkvm_streq(p, g"contracts\0"))
            {
                case (true) { -> p; }
                default {};
            };
            -> (byte*)0;
        };

        // bit width of an integer type for packing and unpacking, dflt for any other
        idkvmcg_type_bits(int dt, int dflt) -> int
        {
            switch (dt)
            {
                case (DataType.SINT) { -> 32; }
                case (DataType.UINT) { -> 32; }
                case (DataType.SLONG) { -> 64; }
                case (DataType.ULONG) { -> 64; }
                case (DataType.BYTE) { -> 8; }
                case (DataType.CHAR) { -> 8; }
                case (DataType.BOOL) { -> 1; }
                default { -> dflt; };
            };
            -> dflt;
        };

        // the integer types a pack or unpack works on
        idkvmcg_unpack_type(int dt) -> bool
        {
            -> dt == DataType.SINT | dt == DataType.UINT | dt == DataType.SLONG | dt == DataType.ULONG | dt == DataType.BYTE | dt == DataType.CHAR;
        };

        // idkvmcodegen._emit_binary_op_for_compound: VM opcode of a compound assignment token, -1 for none
        idkvmcg_compound_op(int tok) -> int
        {
            switch (tok)
            {
                case (TokenType.PLUS_ASSIGN) { -> IDKVM_ADD; }
                case (TokenType.MINUS_ASSIGN) { -> IDKVM_SUB; }
                case (TokenType.MULTIPLY_ASSIGN) { -> IDKVM_MUL; }
                case (TokenType.DIVIDE_ASSIGN) { -> IDKVM_DIV; }
                case (TokenType.MODULO_ASSIGN) { -> IDKVM_MOD; }
                case (TokenType.EXPONENT_ASSIGN) { -> IDKVM_POW; }
                case (TokenType.AND_ASSIGN) { -> IDKVM_BAND; }
                case (TokenType.OR_ASSIGN) { -> IDKVM_BOR; }
                case (TokenType.XOR_ASSIGN) { -> IDKVM_BXOR; }
                case (TokenType.BITAND_ASSIGN) { -> IDKVM_BAND; }
                case (TokenType.BITOR_ASSIGN) { -> IDKVM_BOR; }
                case (TokenType.BITXOR_ASSIGN) { -> IDKVM_BXOR; }
                case (TokenType.BITSHIFT_LEFT_ASSIGN) { -> IDKVM_SHL; }
                case (TokenType.BITSHIFT_RIGHT_ASSIGN) { -> IDKVM_SHR; }
                default { -> -1; };
            };
            -> -1;
        };

        // idkvmcodegen._op_map: VM opcode of a single opcode binary operator, -1 when none
        idkvmcg_binop_single(int op) -> int
        {
            switch (op)
            {
                case (Operator.ADD) { -> IDKVM_ADD; }
                case (Operator.SUB) { -> IDKVM_SUB; }
                case (Operator.MUL) { -> IDKVM_MUL; }
                case (Operator.DIV) { -> IDKVM_DIV; }
                case (Operator.MOD) { -> IDKVM_MOD; }
                case (Operator.POWER) { -> IDKVM_POW; }
                case (Operator.XOR) { -> IDKVM_BXOR; }
                case (Operator.BITAND) { -> IDKVM_BAND; }
                case (Operator.BITOR) { -> IDKVM_BOR; }
                case (Operator.BITXOR) { -> IDKVM_BXOR; }
                case (Operator.BITSHIFT_LEFT) { -> IDKVM_SHL; }
                case (Operator.BITSHIFT_RIGHT) { -> IDKVM_SHR; }
                case (Operator.EQUAL) { -> IDKVM_CMP_EQ; }
                case (Operator.NOT_EQUAL) { -> IDKVM_CMP_NE; }
                case (Operator.LESS_THAN) { -> IDKVM_CMP_LT; }
                case (Operator.LESS_EQUAL) { -> IDKVM_CMP_LE; }
                case (Operator.GREATER_THAN) { -> IDKVM_CMP_GT; }
                case (Operator.GREATER_EQUAL) { -> IDKVM_CMP_GE; }
                default {};
            };
            -> -1;
        };

        // idkvmcodegen._composite_map: base opcode of an operator emitted as base op + BNOT, -1 when none
        idkvmcg_binop_composite(int op) -> int
        {
            switch (op)
            {
                case (Operator.NAND) { -> IDKVM_BAND; }
                case (Operator.NOR) { -> IDKVM_BOR; }
                case (Operator.BITNAND) { -> IDKVM_BAND; }
                case (Operator.BITNOR) { -> IDKVM_BOR; }
                case (Operator.BITXNOT) { -> IDKVM_BXOR; }
                case (Operator.BITXNAND) { -> IDKVM_BAND; }
                case (Operator.BITXNOR) { -> IDKVM_BOR; }
                default {};
            };
            -> -1;
        };

        // idkvmcodegen._COMPILER_IO: opcode of a compiler.* builtin call name, -1 when the name is none
        idkvmcg_compiler_io(byte* name) -> int
        {
            switch (idkvm_streq(name, g"compiler__io__console__print\0") | idkvm_streq(name, g"compiler.io.console.print\0")) { case (true) { -> IDKVM_COMPILER_PRINT; } default {}; };
            switch (idkvm_streq(name, g"compiler__io__console__println\0") | idkvm_streq(name, g"compiler.io.console.println\0")) { case (true) { -> IDKVM_COMPILER_PRINTLN; } default {}; };
            switch (idkvm_streq(name, g"compiler__io__console__input\0") | idkvm_streq(name, g"compiler.io.console.input\0")) { case (true) { -> IDKVM_COMPILER_INPUT; } default {}; };
            switch (idkvm_streq(name, g"compiler__io__readfile\0") | idkvm_streq(name, g"compiler.io.readfile\0")) { case (true) { -> IDKVM_COMPILER_READFILE; } default {}; };
            switch (idkvm_streq(name, g"compiler__io__writefile\0") | idkvm_streq(name, g"compiler.io.writefile\0")) { case (true) { -> IDKVM_COMPILER_WRITEFILE; } default {}; };
            switch (idkvm_streq(name, g"compiler.idkvm.dump\0") | idkvm_streq(name, g"compiler__idkvm__dump\0")) { case (true) { -> IDKVM_COMPILER_IDKVM_DUMP; } default {}; };
            switch (idkvm_streq(name, g"compiler.idkvm.bindump\0") | idkvm_streq(name, g"compiler__idkvm__bindump\0")) { case (true) { -> IDKVM_COMPILER_IDKVM_BINDUMP; } default {}; };
            switch (idkvm_streq(name, g"compiler.idkvm.loadlib\0") | idkvm_streq(name, g"compiler__idkvm__loadlib\0")) { case (true) { -> IDKVM_COMPILER_LOADLIB; } default {}; };
            switch (idkvm_streq(name, g"compiler.idkvm.trace.begin\0") | idkvm_streq(name, g"compiler__idkvm__trace__begin\0")) { case (true) { -> IDKVM_COMPILER_IDKVM_TRACE_BEGIN; } default {}; };
            switch (idkvm_streq(name, g"compiler.idkvm.trace.end\0") | idkvm_streq(name, g"compiler__idkvm__trace__end\0")) { case (true) { -> IDKVM_COMPILER_IDKVM_TRACE_END; } default {}; };
            switch (idkvm_streq(name, g"compiler.idkvm.setbp\0") | idkvm_streq(name, g"compiler__idkvm__setbp\0")) { case (true) { -> IDKVM_COMPILER_IDKVM_SETBP; } default {}; };
            switch (idkvm_streq(name, g"compiler.import.stdlib\0") | idkvm_streq(name, g"compiler__import__stdlib\0")) { case (true) { -> IDKVM_COMPILER_IMPORT_STDLIB; } default {}; };
            switch (idkvm_streq(name, g"compiler.import.local\0") | idkvm_streq(name, g"compiler__import__local\0")) { case (true) { -> IDKVM_COMPILER_IMPORT_LOCAL; } default {}; };
            switch (idkvm_streq(name, g"compiler.fpm.package\0") | idkvm_streq(name, g"compiler__fpm__package\0")) { case (true) { -> IDKVM_COMPILER_FPM_PACKAGE; } default {}; };
            -> -1;
        };

        // true when s ends with suffix
        idkvmcg_ends_with(byte* s, byte* suffix) -> bool
        {
            int ls = idkvm_strlen(s);
            int lx = idkvm_strlen(suffix);
            int i;
            switch (lx > ls)
            {
                case (true) { -> false; }
                default {};
            };
            while (i < lx)
            {
                switch (s[ls - lx + i] != suffix[i]) { case (true) { -> false; } default {}; };
                i++;
            };
            -> true;
        };

        // ARRAY_NEW names the element type as the VM reads it
        idkvmcg_ttag_type_name(int tag) -> byte*
        {
            switch (tag)
            {
                case (IDKVM_T_INT) { -> g"int\0"; }
                case (IDKVM_T_UINT) { -> g"uint\0"; }
                case (IDKVM_T_LONG) { -> g"long\0"; }
                case (IDKVM_T_ULONG) { -> g"ulong\0"; }
                case (IDKVM_T_FLOAT) { -> g"float\0"; }
                case (IDKVM_T_DOUBLE) { -> g"double\0"; }
                case (IDKVM_T_BOOL) { -> g"bool\0"; }
                case (IDKVM_T_BYTE) { -> g"byte\0"; }
                case (IDKVM_T_CHAR) { -> g"char\0"; }
                default { -> g"int\0"; };
            };
        };

        // a heap variable: reads LOAD it. count is the element count of a heap array, 0 otherwise
        struct FvmHeapVar
        {
            int ttag, bytes, count;
        };

        // one captured scope variable: PUSH tag:d (meta m), then LOCAL_SET
        struct FvmCap
        {
            byte* name;
            int tag;
            i64 d;
            i64 m;
        };

        // Python int(text, 0): optional sign, 0x, 0o and 0b prefixes, a decimal number without
        // leading zeros, single underscores between digits, surrounding whitespace.
        idkvmcg_parse_pyint(byte* s, i64* out) -> bool
        {
            int i;
            int n = idkvm_strlen(s);
            int base = 10;
            int dv;
            int c;
            int ndig;
            bool neg;
            bool prev_us;
            bool lead_zero;
            i64 v;
            while (i < n & (s[i] == ' ' | s[i] == '\t' | s[i] == '\n' | s[i] == '\r')) { i++; };
            while (n > i & (s[n - 1] == ' ' | s[n - 1] == '\t' | s[n - 1] == '\n' | s[n - 1] == '\r')) { n--; };
            switch (i < n & (s[i] == '+' | s[i] == '-'))
            {
                case (true) { neg = s[i] == '-'; i++; }
                default {};
            };
            switch (i + 1 < n & s[i] == '0')
            {
                case (true)
                {
                    switch (s[i + 1] == 'x' | s[i + 1] == 'X') { case (true) { base = 16; i = i + 2; } default {}; };
                    switch (s[i + 1] == 'o' | s[i + 1] == 'O') { case (true) { base = 8; i = i + 2; } default {}; };
                    switch (s[i + 1] == 'b' | s[i + 1] == 'B') { case (true) { base = 2; i = i + 2; } default {}; };
                }
                default {};
            };
            switch (i >= n) { case (true) { -> false; } default {}; };
            // a prefixed number may start with an underscore after the prefix, a decimal may not
            lead_zero = base == 10 & s[i] == '0';
            prev_us = base == 10;
            while (i < n)
            {
                c = (int)s[i];
                switch (c == '_')
                {
                    case (true)
                    {
                        switch (prev_us) { case (true) { -> false; } default {}; };
                        prev_us = true;
                    }
                    default
                    {
                        dv = 99;
                        switch (c >= '0' & c <= '9') { case (true) { dv = c - '0'; } default {}; };
                        switch (c >= 'a' & c <= 'f') { case (true) { dv = c - 'a' + 10; } default {}; };
                        switch (c >= 'A' & c <= 'F') { case (true) { dv = c - 'A' + 10; } default {}; };
                        switch (dv >= base) { case (true) { -> false; } default {}; };
                        switch (lead_zero & ndig > 0 & dv != 0) { case (true) { -> false; } default {}; };
                        v = v * (i64)base + (i64)dv;
                        ndig++;
                        prev_us = false;
                    };
                };
                i++;
            };
            switch (prev_us & n > 0 & s[n - 1] == '_') { case (true) { -> false; } default {}; };
            switch (neg) { case (true) { v = (i64)0 - v; } default {}; };
            *out = v;
            -> ndig > 0;
        };

        object IDKVMCodegen
        {
            NameMap* ucounts;   // stub name to i64* count
            PtrVec* owned;      // heap blocks owned until __exit
            int nstubs;         // total stub hits
            int cur_line;       // source line of the node being compiled
            FvmCode code;       // emitted instructions, one unit
            int unit;           // unit id in code
            int ubase;          // pool index where the unit starts
            NameMap* locals;    // name to i64* slot
            PtrVec* lnames;     // local names in slot order
            int nlocals;        // next free slot
            NameMap* bglobals;  // names mirrored as VM globals (_block_globals)
            NameMap* oglobals;  // outer globals (_outer_globals)
            NameMap* lvars;     // local storage class names (_local_vars)
            NameMap* ltypes;    // name to TypeSpec* (_local_typespecs)
            PtrVec* brks;       // break patch lists, one PtrVec* per loop (entries are index + 1)
            PtrVec* conts;      // continue patch lists
            byte* tail_self;    // name of the <~ function being compiled, null outside
            int tail_argc;
            bool in_func;       // _is_function_body
            bool failed;        // a compile error was recorded
            int errline;
            FvmBuf errb;        // message of the first compile error
            PtrVec* caps;       // FvmCap*, captured scope in order
            NameMap* capidx;    // name to FvmCap*
            IDKVMCodegen* par;    // the codegen that made this one for a function body, null for the root
            PtrVec* kids;       // codegens made for function bodies, owned
            PtrVec* fnames;     // compiled_functions in insertion order: names
            PtrVec* fcgs;       // and the IDKVMCodegen* holding each one's bytecode (borrowed)
            NameMap* fidx;      // function name to its index in fnames, plus one
            NameMap* known;     // functions registered with the VM by earlier blocks (_known_functions)
            PtrVec* defers;     // defer scopes: one PtrVec* of DEFER_STATEMENT nodes per body being compiled
            PtrVec* usings;     // active using namespaces ("::" replaced by "__"), byte*, in order
            NameMap* ltn;       // name to declared type name, byte* (_local_types)
            NameMap* enums;     // known enum type names (_enum_names)
            NameMap* alspec;    // name to TypeSpec* of the declared `as` aliases (_type_alias_specs)
            NameMap* hvars;     // name to FvmHeapVar*, heap allocated variables (_heap_vars)
            NameMap* labels;    // label name to its instruction index + 1 (_labels)
            PtrVec* gp_idx;     // forward goto patches: instruction index + 1
            PtrVec* gp_name;    // and the label each waits for (byte*)
            NameMap* excluded;  // namespaces named by not using (_excluded_namespaces)
            NodeVec* pstmts;    // the top level statements of the program (_program_statements), borrowed
            FvmLayouts lay;     // struct layouts defined by comptime StructDefs (_struct_layouts)
            NameMap* ldirty;    // layouts this codegen defined, merged into the VM after compile
            int lay_seed;       // layouts copied in at the start, they are not merged back unless redefined
            NameMap* macros;    // name to macroDef Node* (_macro_table)
            NameMap* mcomp;     // names of the macros being compiled into functions (_macros_compiling)
            NameMap* trreg;     // trait name to TRAIT_DEF Node* (_trait_registry)
            NameMap* ifreg;     // interface name to INTERFACE_DEF Node* (_interface_registry)
            NameMap* iwl;       // CALL_ON whitelist: "caller<1>callee" to a NameMap* set of method names
            NameMap* pwl;       // PASS_INTO whitelist, same shape
            NameMap* rwl;       // RETURN_TO whitelist, same shape
            NameMap* otr;       // object name to PtrVec* of trait names (_object_traits)
            PtrVec* wsets;      // NameMap* sets made by this codegen
            PtrVec* tlists;     // PtrVec* trait lists made by this codegen
            byte* cur_obj;      // _current_object_name, null outside object methods
            NodeVec* cbody;     // statements of the comptime body (_comptime_body_stmts)
            bool shared_ifc;    // trreg, ifreg and the whitelists belong to the codegen of the object
            bool in_method;     // _is_method_body: a method returns this, then its own return value

            __init() -> this
            {
                this.ucounts = nm_new();
                this.owned = pv_new();
                this.nstubs = 0;
                this.cur_line = 0;
                this.code.__init();
                this.errb.__init();
                this.unit = this.code.unit_begin();
                this.ubase = this.code.len;
                this.locals = nm_new();
                this.lnames = pv_new();
                this.nlocals = 0;
                this.bglobals = nm_new();
                this.oglobals = nm_new();
                this.lvars = nm_new();
                this.ltypes = nm_new();
                this.brks = pv_new();
                this.conts = pv_new();
                this.tail_self = (byte*)0;
                this.tail_argc = 0;
                this.in_func = false;
                this.failed = false;
                this.errline = 0;
                this.caps = pv_new();
                this.capidx = nm_new();
                this.par = (IDKVMCodegen*)0;
                this.kids = pv_new();
                this.fnames = pv_new();
                this.fcgs = pv_new();
                this.fidx = nm_new();
                this.known = nm_new();
                this.defers = pv_new();
                this.usings = pv_new();
                this.ltn = nm_new();
                this.enums = nm_new();
                this.alspec = nm_new();
                this.hvars = nm_new();
                this.macros = nm_new();
                this.mcomp = nm_new();
                this.trreg = nm_new();
                this.ifreg = nm_new();
                this.iwl = nm_new();
                this.pwl = nm_new();
                this.rwl = nm_new();
                this.otr = nm_new();
                this.wsets = pv_new();
                this.tlists = pv_new();
                this.cur_obj = (byte*)0;
                this.cbody = (NodeVec*)0;
                this.shared_ifc = false;
                this.in_method = false;
                this.labels = nm_new();
                this.ldirty = nm_new();
                this.lay_seed = 0;
                this.gp_idx = pv_new();
                this.gp_name = pv_new();
                this.excluded = nm_new();
                this.pstmts = (NodeVec*)0;
                this.lay.__init();
                -> this;
            };

            __expr() -> IDKVMCodegen* -> this;

            __exit() -> void
            {
                int i;
                while (i < this.owned.len)
                {
                    ffree((byte*)this.owned.items[i]);
                    i++;
                };
                i = 0;
                while (i < this.brks.len)
                {
                    pv_free((PtrVec*)this.brks.items[i]);
                    i++;
                };
                i = 0;
                while (i < this.conts.len)
                {
                    pv_free((PtrVec*)this.conts.items[i]);
                    i++;
                };
                i = 0;
                while (i < this.kids.len)
                {
                    ((IDKVMCodegen*)this.kids.items[i]).__exit();
                    ffree((byte*)this.kids.items[i]);
                    i++;
                };
                i = 0;
                while (i < this.defers.len)
                {
                    pv_free((PtrVec*)this.defers.items[i]);
                    i++;
                };
                pv_free(this.kids);
                pv_free(this.fnames);
                pv_free(this.fcgs);
                nm_free(this.fidx);
                nm_free(this.known);
                pv_free(this.defers);
                pv_free(this.usings);
                nm_free(this.ltn);
                nm_free(this.enums);
                nm_free(this.alspec);
                nm_free(this.hvars);
                nm_free(this.macros);
                nm_free(this.mcomp);
                switch (!this.shared_ifc)
                {
                    case (true)
                    {
                        nm_free(this.trreg);
                        nm_free(this.ifreg);
                        nm_free(this.iwl);
                        nm_free(this.pwl);
                        nm_free(this.rwl);
                    }
                    default {};
                };
                nm_free(this.otr);
                i = 0;
                while (i < this.wsets.len)
                {
                    nm_free((NameMap*)this.wsets.items[i]);
                    i++;
                };
                pv_free(this.wsets);
                i = 0;
                while (i < this.tlists.len)
                {
                    pv_free((PtrVec*)this.tlists.items[i]);
                    i++;
                };
                pv_free(this.tlists);
                nm_free(this.labels);
                nm_free(this.ldirty);
                pv_free(this.gp_idx);
                pv_free(this.gp_name);
                nm_free(this.excluded);
                this.lay.__exit();
                pv_free(this.brks);
                pv_free(this.conts);
                pv_free(this.caps);
                pv_free(this.lnames);
                nm_free(this.capidx);
                pv_free(this.owned);
                nm_free(this.ucounts);
                nm_free(this.locals);
                nm_free(this.bglobals);
                nm_free(this.oglobals);
                nm_free(this.lvars);
                nm_free(this.ltypes);
                this.code.__exit();
                this.errb.__exit();
                ->;
            };

            // Records the first compile error (IDKVMCodegenError / NameError of ivmcodegen.py)
            fail(Node* n, byte* msg) -> void
            {
                switch (this.par != (IDKVMCodegen*)0)
                {
                    case (true) { -> this.par.fail(n, msg); }
                    default {};
                };
                switch (this.failed)
                {
                    case (true) { ->; }
                    default {};
                };
                this.failed = true;
                this.errb.put_str(msg);
                switch (n != (Node*)0)
                {
                    case (true) { this.errline = n.line; }
                    default {};
                };
                ->;
            };

            // Same as fail, with a quoted name between two message parts
            fail_name(Node* n, byte* pre, byte* name, byte* post) -> void
            {
                switch (this.par != (IDKVMCodegen*)0)
                {
                    case (true) { -> this.par.fail_name(n, pre, name, post); }
                    default {};
                };
                switch (this.failed)
                {
                    case (true) { ->; }
                    default {};
                };
                this.failed = true;
                this.errb.put_str(pre);
                this.errb.put(39);
                this.errb.put_str(name);
                this.errb.put(39);
                this.errb.put_str(post);
                switch (n != (Node*)0)
                {
                    case (true) { this.errline = n.line; }
                    default {};
                };
                ->;
            };

            // Heap copy of a name, owned until __exit, so instruction operands stay valid
            keep(byte* s) -> byte*
            {
                byte* d = ts_dup(s);
                pv_push(this.owned, (void*)d);
                -> d;
            };

            // Adds a captured scope variable (IDKVMCodegen.compile captured_scope). A name that
            // is already captured keeps its position and takes the new value, like a dict.
            capture(byte* name, int tag, i64 d, i64 m) -> void
            {
                FvmCap* c = (FvmCap*)nm_get(this.capidx, name);
                switch (c == (FvmCap*)0)
                {
                    case (true)
                    {
                        c = (FvmCap*)fmalloc((u64)((sizeof(FvmCap) + 7) / 8));
                        pv_push(this.owned, (void*)c);
                        c.name = this.keep(name);
                        nm_put(this.capidx, name, (void*)c);
                        pv_push(this.caps, (void*)c);
                    }
                    default {};
                };
                c.tag = tag;
                c.d = d;
                c.m = m;
                ->;
            };

            // A preprocessor constant. Python reads its text as int(value, 0), then float(value),
            // then keeps the text as BYTES. A name already captured is left alone.
            capture_macro(byte* name, byte* text) -> void
            {
                i64 iv;
                bool ok;
                double dv;
                switch (this.captured(name))
                {
                    case (true) { ->; }
                    default {};
                };
                switch (idkvmcg_parse_pyint(text, @iv))
                {
                    case (true) { this.capture(name, IDKVM_T_INT, iv, (i64)0); ->; }
                    default {};
                };
                dv = idkvm_parse_double(text, idkvm_strlen(text), @ok);
                switch (ok)
                {
                    case (true) { this.capture(name, IDKVM_T_DOUBLE, idkvm_dbl_bits(dv), (i64)0); ->; }
                    default {};
                };
                this.capture_bytes(name, text);
                ->;
            };

            // true when name is already captured
            captured(byte* name) -> bool -> nm_has(this.capidx, name);

            // BYTES value: the text is copied
            capture_bytes(byte* name, byte* text) -> void
            {
                byte* t = this.keep(text);
                this.capture(name, IDKVM_T_BYTES, idkvm_p2i(t), (i64)idkvm_strlen(t));
                ->;
            };

            // IDKVMCodegen._emit: appends an instruction, returns its index
            emit(int op, i64 oa, i64 ob, i64 oc, byte* os) -> int
            {
                int r = this.code.add(op, oa, ob, oc, os, this.cur_line);
                switch (r < 0)
                {
                    case (true) { this.fail((Node*)0, g"instruction pool allocation failed\0"); }
                    default {};
                };
                -> r;
            };

            emit0(int op) -> int -> this.emit(op, (i64)0, (i64)0, (i64)0, (byte*)0);

            emit1(int op, i64 oa) -> int -> this.emit(op, oa, (i64)0, (i64)0, (byte*)0);

            // operand is a name (GLOBAL_GET, GLOBAL_SET, STRUCT_NEW, ...)
            emits(int op, byte* name) -> int -> this.emit(op, (i64)0, (i64)0, (i64)0, this.keep(name));

            // PUSH tag:data
            emit_push(int tag, i64 dval) -> int -> this.emit(IDKVM_PUSH, (i64)tag, dval, (i64)0, (byte*)0);

            // IDKVMCodegen._current_ip: jump targets are relative to the unit
            ip() -> int -> this.code.len - this.ubase;

            // IDKVMCodegen._patch_at: replaces the instruction at idx with op targeting addr
            patch_at(int idx, int op, int addr) -> void
            {
                this.code.ops[idx] = op;
                this.code.a[idx] = (i64)addr;
                this.code.b[idx] = (i64)0;
                this.code.c[idx] = (i64)0;
                this.code.s[idx] = (byte*)0;
                ->;
            };

            // IDKVMCodegen._alloc_local
            alloc_local(byte* name) -> int
            {
                i64* box = (i64*)nm_get(this.locals, name);
                switch (box == (i64*)0)
                {
                    case (true)
                    {
                        box = (i64*)fmalloc((u64)8);
                        pv_push(this.owned, (void*)box);
                        *box = (i64)this.nlocals;
                        nm_put(this.locals, name, (void*)box);
                        pv_push(this.lnames, (void*)this.keep(name));
                        this.nlocals++;
                    }
                    default {};
                };
                -> (int)*box;
            };

            // name set helpers (the values are not read, only presence)
            set_add(NameMap* m, byte* name) -> void
            {
                nm_put(m, name, (void*)this);
                ->;
            };

            // IDKVMCodegen._check_const_assign
            check_const_assign(byte* name, Node* n, byte* what) -> void
            {
                TypeSpec* ts = (TypeSpec*)nm_get(this.ltypes, name);
                switch (ts != (TypeSpec*)0)
                {
                    case (true)
                    {
                        switch ((ts.flags `& TS_CONST) != 0)
                        {
                            case (true) { this.fail_name(n, g"Cannot modify const variable \0", name, what); }
                            default {};
                        };
                    }
                    default {};
                };
                ->;
            };

            // break and continue patch lists of the loop being compiled
            loop_push() -> void
            {
                pv_push(this.brks, (void*)pv_new());
                pv_push(this.conts, (void*)pv_new());
                ->;
            };

            // patches the jumps of the innermost loop: breaks to brk_to, continues to cont_to
            loop_pop(int brk_to, int cont_to) -> void
            {
                PtrVec* bl = (PtrVec*)this.brks.items[this.brks.len - 1];
                PtrVec* cl = (PtrVec*)this.conts.items[this.conts.len - 1];
                int i;
                this.brks.len--;
                this.conts.len--;
                while (i < bl.len)
                {
                    this.patch_at((int)(u64)bl.items[i] - 1, IDKVM_JMP, brk_to);
                    i++;
                };
                i = 0;
                while (i < cl.len)
                {
                    this.patch_at((int)(u64)cl.items[i] - 1, IDKVM_JMP, cont_to);
                    i++;
                };
                pv_free(bl);
                pv_free(cl);
                ->;
            };

            // compiled_functions: has, and put (a name that is already there keeps its position)
            cf_has(byte* name) -> bool -> nm_has(this.fidx, name);

            cf_put(byte* name, IDKVMCodegen* c) -> void
            {
                i64* box = (i64*)nm_get(this.fidx, name);
                byte* nm;
                switch (box != (i64*)0)
                {
                    case (true) { this.fcgs.items[(int)*box - 1] = (void*)c; }
                    default
                    {
                        nm = this.keep(name);
                        box = (i64*)fmalloc((u64)8);
                        pv_push(this.owned, (void*)box);
                        pv_push(this.fnames, (void*)nm);
                        pv_push(this.fcgs, (void*)c);
                        *box = (i64)this.fnames.len;
                        nm_put(this.fidx, nm, (void*)box);
                    };
                };
                ->;
            };

            // adopts the functions of a child that this codegen does not have yet
            cf_adopt(IDKVMCodegen* c) -> void
            {
                int i;
                while (i < c.fnames.len)
                {
                    switch (!this.cf_has((byte*)c.fnames.items[i]))
                    {
                        case (true) { this.cf_put((byte*)c.fnames.items[i], (IDKVMCodegen*)c.fcgs.items[i]); }
                        default {};
                    };
                    i++;
                };
                ->;
            };

            // a function known to the VM from an earlier block
            known_add(byte* name) -> void
            {
                nm_put(this.known, name, (void*)this);
                ->;
            };

            // compiled_functions or known_functions
            fn_known(byte* name) -> bool -> this.cf_has(name) | nm_has(this.known, name);

            // The codegen of a function body: it reads the block globals through GLOBAL_GET and
            // GLOBAL_SET (_outer_globals), and starts from copies of the scope tables
            make_child() -> IDKVMCodegen*
            {
                // heap sizes the object by its real layout: sizeof counts the field widths
                // without the alignment padding, so it under-allocates an object like this one
                heap IDKVMCodegen c;
                int i;
                c.__init();
                c.par = this;
                c.pstmts = this.pstmts;
                pv_push(this.kids, (void*)c);
                while (i < this.bglobals.count)
                {
                    c.set_add(c.oglobals, (byte*)this.bglobals.keys[i]);
                    i++;
                };
                c.in_func = true;
                c.lay_copy_from(@this.lay);
                i = 0;
                while (i < this.known.count)
                {
                    c.known_add((byte*)this.known.keys[i]);
                    i++;
                };
                i = 0;
                while (i < this.usings.len)
                {
                    pv_push(c.usings, this.usings.items[i]);
                    i++;
                };
                i = 0;
                while (i < this.enums.count)
                {
                    nm_put(c.enums, (byte*)this.enums.keys[i], this.enums.vals[i]);
                    i++;
                };
                i = 0;
                while (i < this.alspec.count)
                {
                    nm_put(c.alspec, (byte*)this.alspec.keys[i], this.alspec.vals[i]);
                    i++;
                };
                i = 0;
                while (i < this.ltn.count)
                {
                    nm_put(c.ltn, (byte*)this.ltn.keys[i], this.ltn.vals[i]);
                    i++;
                };
                i = 0;
                while (i < this.ltypes.count)
                {
                    nm_put(c.ltypes, (byte*)this.ltypes.keys[i], this.ltypes.vals[i]);
                    i++;
                };
                i = 0;
                while (i < this.macros.count)
                {
                    nm_put(c.macros, (byte*)this.macros.keys[i], this.macros.vals[i]);
                    i++;
                };
                i = 0;
                while (i < this.mcomp.count)
                {
                    nm_put(c.mcomp, (byte*)this.mcomp.keys[i], this.mcomp.vals[i]);
                    i++;
                };
                -> c;
            };

            // A parameter of a function body takes the next local slot and records its type
            bind_param(Node* p) -> void
            {
                // the unnamed parameters of a prototype share one key, like a None name in a dict
                byte* pn = p.text;
                switch (pn == (byte*)0) { case (true) { pn = g"\0"; } default {}; };
                this.alloc_local(pn);
                switch (p.ts != (TypeSpec*)0)
                {
                    case (true)
                    {
                        nm_put(this.ltypes, pn, (void*)p.ts);
                        switch (p.ts.custom_typename != (byte*)0)
                        {
                            case (true) { nm_put(this.ltn, pn, (void*)p.ts.custom_typename); }
                            default
                            {
                                switch (p.ts.base_type >= 0)
                                {
                                    case (true) { nm_put(this.ltn, pn, (void*)datatype_text(p.ts.base_type)); }
                                    default {};
                                };
                            };
                        };
                    }
                    default {};
                };
                ->;
            };

            // Registers the compiled functions with the VM, in order. A later registration of a
            // name replaces the earlier one.
            register_functions(IDEKAVM* vm) -> bool
            {
                int i;
                int u;
                IDKVMCodegen* c;
                while (i < this.fnames.len)
                {
                    c = (IDKVMCodegen*)this.fcgs.items[i];
                    u = vm.import_unit(@c.code, c.unit);
                    switch (u < 0)
                    {
                        case (true) { -> false; }
                        default {};
                    };
                    vm.register_function((byte*)this.fnames.items[i], u);
                    i++;
                };
                -> true;
            };

            // The statements of a body visited one by one without a defer scope: a BLOCK holds
            // them, any other node is the one statement
            visit_stmts_direct(Node* b) -> void
            {
                int i;
                switch (b == (Node*)0)
                {
                    case (true) { ->; }
                    default {};
                };
                switch (b.kind == NodeKind.BLOCK)
                {
                    case (true)
                    {
                        while (i < node_count(b, 0))
                        {
                            this.visit_stmt(node_child(b, 0, i));
                            i++;
                        };
                    }
                    default { this.visit_stmt(b); };
                };
                ->;
            };

            // A scope for break only (a switch): break and break switch inside jump past it
            brk_push() -> void
            {
                pv_push(this.brks, (void*)pv_new());
                ->;
            };

            brk_pop(int to) -> void
            {
                PtrVec* bl = (PtrVec*)this.brks.items[this.brks.len - 1];
                int i;
                this.brks.len--;
                while (i < bl.len)
                {
                    this.patch_at((int)(u64)bl.items[i] - 1, IDKVM_JMP, to);
                    i++;
                };
                pv_free(bl);
                ->;
            };

            // alloc_local of "<pre><i><post>" (the f-string names of the Python codegen)
            numbered_slot(byte* pre, int i, byte* post) -> int
            {
                FvmBuf b;
                int s;
                b.__init();
                b.put_str(pre);
                b.put_i64((i64)i);
                b.put_str(post);
                b.put(0);
                s = this.alloc_local(b.mem);
                b.__exit();
                -> s;
            };

            // Operand of a constant index: true when n is a literal, v is its integer value
            const_int(Node* n, i64* v) -> bool
            {
                switch (n == (Node*)0) { case (true) { -> false; } default {}; };
                switch (n.kind == NodeKind.LITERAL)
                {
                    case (true) { *v = n.ival; -> true; }
                    default {};
                };
                -> false;
            };

            // Copies every layout of src into this codegen. The names stay owned by src.
            lay_copy_from(FvmLayouts* src) -> void
            {
                int i, k, f;
                while (i < src.n)
                {
                    this.lay.add_struct(src.sname[i], src.sendian[i], src.ssize[i], src.sbits[i]);
                    k = 0;
                    while (k < src.scount[i])
                    {
                        f = src.sfirst[i] + k;
                        this.lay.add_field(src.fname[f], src.ftag[f], src.foff[f], src.fsize[f]);
                        k++;
                    };
                    i++;
                };
                this.lay_seed = this.lay.n;
                ->;
            };

            // Merges the layouts this codegen defined into dst (the VM). The names are copied.
            lay_merge_into(FvmLayouts* dst) -> bool
            {
                int i, k, f;
                bool take;
                while (i < this.lay.n)
                {
                    take = i >= this.lay_seed | nm_has(this.ldirty, this.lay.sname[i]);
                    switch (take)
                    {
                        case (true)
                        {
                            switch (!dst.add_struct(idkvm_dup(this.lay.sname[i], idkvm_strlen(this.lay.sname[i])), this.lay.sendian[i], this.lay.ssize[i], this.lay.sbits[i]))
                            {
                                case (true) { -> false; }
                                default {};
                            };
                            k = 0;
                            while (k < this.lay.scount[i])
                            {
                                f = this.lay.sfirst[i] + k;
                                switch (!dst.add_field(idkvm_dup(this.lay.fname[f], idkvm_strlen(this.lay.fname[f])), this.lay.ftag[f], this.lay.foff[f], this.lay.fsize[f]))
                                {
                                    case (true) { -> false; }
                                    default {};
                                };
                                k++;
                            };
                        }
                        default {};
                    };
                    i++;
                };
                -> true;
            };

            // "<prefix>__<name>" kept
            joined_name(byte* prefix, byte* name) -> byte*
            {
                FvmBuf b;
                byte* r;
                switch (prefix == (byte*)0)
                {
                    case (true) { -> name; }
                    default {};
                };
                b.__init();
                b.put_str(prefix);
                b.put_str(g"__\0");
                b.put_str(name);
                b.put(0);
                r = this.keep(b.mem);
                b.__exit();
                -> r;
            };

            // Registers a layout under name from members (STRUCT_MEMBER or UNION_MEMBER nodes).
            // Structs are tightly packed, a union puts every field at offset 0.
            define_layout(byte* name, Node* n, bool is_union) -> void
            {
                int i, bits, bsz, off, total_bits, maxsz;
                Node* m;
                int total = 0;
                int nm_n = node_count(n, 0);
                // the size and bits are only known after the members, so they are computed first
                while (i < nm_n)
                {
                    m = node_child(n, 0, i);
                    bits = this.type_bit_width(m.ts);
                    bsz = (bits + 7) / 8;
                    switch (bsz < 1) { case (true) { bsz = 1; } default {}; };
                    switch (is_union)
                    {
                        case (true) { switch (bsz > maxsz) { case (true) { maxsz = bsz; } default {}; }; }
                        default
                        {
                            total = total + bsz;
                            total_bits = total_bits + bits;
                        };
                    };
                    i++;
                };
                switch (is_union) { case (true) { total = maxsz; } default {}; };
                this.lay.add_struct(name, this.keep(g"little\0"), total, total_bits);
                nm_put(this.ldirty, name, (void*)name);
                i = 0;
                while (i < nm_n)
                {
                    m = node_child(n, 0, i);
                    bits = this.type_bit_width(m.ts);
                    bsz = (bits + 7) / 8;
                    switch (bsz < 1) { case (true) { bsz = 1; } default {}; };
                    this.lay.add_field(this.keep(m.text), this.type_ttag_from_ts(m.ts), off, bsz);
                    switch (!is_union) { case (true) { off = off + bsz; } default {}; };
                    i++;
                };
                ->;
            };

            struct_def_prefixed(Node* n, byte* prefix) -> void
            {
                byte* full = this.joined_name(prefix, n.text);
                int i;
                int li;
                // nested structs first, their layouts are needed by the members
                while (i < node_count(n, 3))
                {
                    this.struct_def_prefixed(node_child(n, 3, i), full);
                    i++;
                };
                this.define_layout(full, n, false);
                switch (prefix != (byte*)0)
                {
                    case (true)
                    {
                        // the bare name shares the layout
                        li = this.lay.find(full);
                        this.lay.add_struct(this.keep(n.text), this.lay.sendian[li], this.lay.ssize[li], this.lay.sbits[li]);
                        nm_put(this.ldirty, this.lay.sname[this.lay.n - 1], (void*)n.text);
                        this.copy_fields_of(li, this.lay.n - 1);
                    }
                    default {};
                };
                ->;
            };

            // The fields of layout src are added to the layout last added (dst)
            copy_fields_of(int src, int dst) -> void
            {
                int k, f;
                while (k < this.lay.scount[src])
                {
                    f = this.lay.sfirst[src] + k;
                    this.lay.add_field(this.lay.fname[f], this.lay.ftag[f], this.lay.foff[f], this.lay.fsize[f]);
                    k++;
                };
                ->;
            };

            // Struct type of a local: the name recorded for it, else the custom type of its type spec
            struct_tn_of(byte* name) -> byte*
            {
                byte* tn = (byte*)nm_get(this.ltn, name);
                TypeSpec* ts;
                switch (tn != (byte*)0) { case (true) { -> tn; } default {}; };
                ts = (TypeSpec*)nm_get(this.ltypes, name);
                switch (ts != (TypeSpec*)0) { case (true) { -> ts.custom_typename; } default {}; };
                -> (byte*)0;
            };

            // Slot write back of a variable that may be a block global
            // IDKVMCodegen._emit_var_set: the value on top of the stack goes back to the variable,
            // the local slot and its global mirror kept in step
            write_back(byte* name) -> void
            {
                i64* box;
                switch (nm_has(this.oglobals, name))
                {
                    case (true) { this.emits(IDKVM_GLOBAL_SET, name); ->; }
                    default {};
                };
                box = (i64*)nm_get(this.locals, name);
                switch (box != (i64*)0)
                {
                    case (true)
                    {
                        switch (nm_has(this.bglobals, name))
                        {
                            case (true)
                            {
                                this.emit0(IDKVM_DUP);
                                this.emit1(IDKVM_LOCAL_SET, *box);
                                this.emits(IDKVM_GLOBAL_SET, name);
                            }
                            default { this.emit1(IDKVM_LOCAL_SET, *box); };
                        };
                        ->;
                    }
                    default {};
                };
                switch (nm_has(this.bglobals, name))
                {
                    case (true) { this.emits(IDKVM_GLOBAL_SET, name); }
                    default { this.emit1(IDKVM_LOCAL_SET, (i64)this.alloc_local(name)); };
                };
                ->;
            };

            // member = value where the member is '#': a union tag
            assign_tag(Node* n) -> void
            {
                Node* t = n.a;
                byte* tn;
                int slot;
                FvmBuf b;
                switch (t.a.kind == NodeKind.IDENTIFIER)
                {
                    case (true)
                    {
                        tn = (byte*)nm_get(this.ltn, t.a.text);
                        switch (tn != (byte*)0)
                        {
                            case (true)
                            {
                                switch (nm_has(this.enums, tn))
                                {
                                    case (true)
                                    {
                                        this.visit_expr(t.a);
                                        this.visit_expr(n.b);
                                        this.emit0(IDKVM_ENUM_STORE);
                                        slot = this.alloc_local(t.a.text);
                                        this.emit1(IDKVM_LOCAL_SET, (i64)slot);
                                        ->;
                                    }
                                    default {};
                                };
                            }
                            default {};
                        };
                    }
                    default {};
                };
                // synthetic tag slot named __<object>__tag__
                b.__init();
                b.put_str(g"__\0");
                switch (t.a.kind == NodeKind.IDENTIFIER)
                {
                    case (true) { b.put_str(t.a.text); }
                    default { b.put_str(g"__\0"); };
                };
                b.put_str(g"__tag__\0");
                b.put(0);
                slot = this.alloc_local(b.mem);
                b.__exit();
                this.visit_expr(n.b);
                this.emit1(IDKVM_LOCAL_SET, (i64)slot);
                ->;
            };

            // tbl[idx].field = value
            assign_elem_field(Node* n) -> void
            {
                Node* o = n.a.a;
                Node* t = n.a;
                byte* an = o.a.text;
                byte* tn = this.struct_tn_of(an);
                int li = this.lay.find(tn);
                int size = this.lay.ssize[li];
                int tmp, slot;
                bool is_global;
                switch (nm_has(this.hvars, an))
                {
                    case (true)
                    {
                        this.visit_expr(o.a);
                        this.visit_expr(o.b);
                        this.emit_push(IDKVM_T_UINT, (i64)size);
                        this.emit0(IDKVM_MUL);
                        this.emit0(IDKVM_ADD);
                        this.emit0(IDKVM_DUP);
                        this.emit(IDKVM_LOAD, (i64)IDKVM_T_STRUCT, (i64)size, (i64)0, this.keep(tn));
                        this.visit_expr(n.b);
                        this.emits(IDKVM_STRUCT_STORE, t.text);
                        this.emit(IDKVM_STORE, (i64)IDKVM_T_STRUCT, (i64)size, (i64)0, this.keep(tn));
                        ->;
                    }
                    default {};
                };
                is_global = nm_has(this.bglobals, an) | nm_has(this.oglobals, an);
                this.visit_expr(o.a);
                this.visit_expr(o.b);
                this.emit0(IDKVM_ARRAY_LOAD);
                this.visit_expr(n.b);
                this.emits(IDKVM_STRUCT_STORE, t.text);
                tmp = this.alloc_local(g"__mae_tmp__\0");
                this.emit1(IDKVM_LOCAL_SET, (i64)tmp);
                this.visit_expr(o.a);
                this.visit_expr(o.b);
                this.emit1(IDKVM_LOCAL_GET, (i64)tmp);
                this.emit0(IDKVM_ARRAY_STORE);
                switch (is_global)
                {
                    case (true)
                    {
                        this.emit0(IDKVM_DUP);
                        slot = this.alloc_local(an);
                        this.emit1(IDKVM_LOCAL_SET, (i64)slot);
                        this.emits(IDKVM_GLOBAL_SET, an);
                    }
                    default
                    {
                        slot = this.alloc_local(an);
                        this.emit1(IDKVM_LOCAL_SET, (i64)slot);
                    };
                };
                ->;
            };

            assign_member(Node* n) -> void
            {
                Node* t = n.a;
                Node* o = t.a;
                byte* tn;
                bool elem_field;
                FvmHeapVar* hv;
                i64* box;
                switch (idkvm_streq(t.text, g"#\0"))
                {
                    case (true) { this.assign_tag(n); ->; }
                    default {};
                };
                switch (o.kind == NodeKind.IDENTIFIER)
                {
                    case (true)
                    {
                        hv = (FvmHeapVar*)nm_get(this.hvars, o.text);
                        box = (i64*)nm_get(this.locals, o.text);
                        switch (hv != (FvmHeapVar*)0 & box != (i64*)0)
                        {
                            case (true)
                            {
                                // heap struct: the slot holds the pointer, so the updated struct is
                                // STOREd back through it and the slot keeps the pointer
                                switch (hv.count == 0 & hv.ttag == IDKVM_T_STRUCT)
                                {
                                    case (true)
                                    {
                                        this.emit1(IDKVM_LOCAL_GET, *box);
                                        this.visit_expr(o);
                                        this.visit_expr(n.b);
                                        this.emits(IDKVM_STRUCT_STORE, t.text);
                                        this.emit(IDKVM_STORE, (i64)hv.ttag, (i64)hv.bytes, (i64)0, (byte*)0);
                                        ->;
                                    }
                                    default {};
                                };
                            }
                            default {};
                        };
                        this.visit_expr(o);
                        this.visit_expr(n.b);
                        this.emits(IDKVM_STRUCT_STORE, t.text);
                        this.write_back(o.text);
                        ->;
                    }
                    default {};
                };
                // a struct element of an array: arr[idx].field
                switch (o.kind == NodeKind.ARRAY_ACCESS)
                {
                    case (true)
                    {
                        switch (o.a.kind == NodeKind.IDENTIFIER)
                        {
                            case (true)
                            {
                                tn = this.struct_tn_of(o.a.text);
                                switch (tn != (byte*)0)
                                {
                                    case (true) { elem_field = this.lay.find(tn) >= 0; }
                                    default {};
                                };
                            }
                            default {};
                        };
                    }
                    default {};
                };
                switch (elem_field)
                {
                    case (true) { this.assign_elem_field(n); }
                    default
                    {
                        this.visit_expr(o);
                        this.visit_expr(n.b);
                        this.emits(IDKVM_STRUCT_STORE, t.text);
                    };
                };
                ->;
            };

            assign_array_elem(Node* n) -> void
            {
                Node* t = n.a;
                byte* an;
                FvmHeapVar* hv;
                i64* box;
                TypeSpec* ts;
                int arr_slot;
                bool pp;
                switch (t.a.kind != NodeKind.IDENTIFIER)
                {
                    case (true)
                    {
                        this.fail(n, g"idkvmcodegen: array assignment target must be a simple identifier in comptime\0");
                        ->;
                    }
                    default {};
                };
                an = t.a.text;
                hv = (FvmHeapVar*)nm_get(this.hvars, an);
                switch (hv != (FvmHeapVar*)0)
                {
                    case (true)
                    {
                        box = (i64*)nm_get(this.locals, an);
                        switch (hv.count > 0 & box != (i64*)0)
                        {
                            case (true)
                            {
                                this.emit1(IDKVM_LOCAL_GET, *box);
                                this.visit_expr(t.b);
                                switch (hv.bytes > 1)
                                {
                                    case (true)
                                    {
                                        this.emit_push(IDKVM_T_UINT, (i64)hv.bytes);
                                        this.emit0(IDKVM_MUL);
                                    }
                                    default {};
                                };
                                this.emit0(IDKVM_ADD);
                                this.visit_expr(n.b);
                                this.emit(IDKVM_STORE, (i64)hv.ttag, (i64)hv.bytes, (i64)0, (byte*)0);
                                ->;
                            }
                            default {};
                        };
                    }
                    default {};
                };
                arr_slot = this.alloc_local(an);
                ts = (TypeSpec*)nm_get(this.ltypes, an);
                switch (ts != (TypeSpec*)0)
                {
                    case (true)
                    {
                        pp = ts.pointer_depth >= 2;
                        switch (!pp & ts.custom_typename != (byte*)0)
                        {
                            case (true)
                            {
                                switch ((ts.flags `& TS_POINTER) != 0 & (ts.flags `& TS_ARRAY) == 0 & this.lay.find(ts.custom_typename) >= 0)
                                {
                                    case (true) { pp = true; }
                                    default {};
                                };
                            }
                            default {};
                        };
                    }
                    default {};
                };
                switch (pp)
                {
                    case (true)
                    {
                        this.visit_expr(t.a);
                        this.visit_expr(t.b);
                        this.emit_push(IDKVM_T_UINT, (i64)8);
                        this.emit0(IDKVM_MUL);
                        this.emit0(IDKVM_ADD);
                        this.visit_expr(n.b);
                        this.emit(IDKVM_STORE, (i64)IDKVM_T_PTR, (i64)8, (i64)0, (byte*)0);
                        ->;
                    }
                    default {};
                };
                this.visit_expr(t.a);
                this.visit_expr(t.b);
                this.visit_expr(n.b);
                this.emit0(IDKVM_ARRAY_STORE);
                this.emit1(IDKVM_LOCAL_SET, (i64)arr_slot);
                ->;
            };

            // decimal value of the digits at s
            dec_of(byte* s) -> int
            {
                bool ok;
                -> (int)idkvm_parse_int(s, idkvm_strlen(s), @ok);
            };

            // bit width of a primitive type name, -1 when it is none
            name_bits(byte* tn) -> int
            {
                switch (idkvm_streq(tn, g"int\0") | idkvm_streq(tn, g"uint\0") | idkvm_streq(tn, g"float\0")) { case (true) { -> 32; } default {}; };
                switch (idkvm_streq(tn, g"long\0") | idkvm_streq(tn, g"ulong\0") | idkvm_streq(tn, g"double\0")) { case (true) { -> 64; } default {}; };
                switch (idkvm_streq(tn, g"bool\0")) { case (true) { -> 1; } default {}; };
                switch (idkvm_streq(tn, g"byte\0") | idkvm_streq(tn, g"char\0")) { case (true) { -> 8; } default {}; };
                -> -1;
            };

            // typeof kind of a DataType: 0 when unknown
            dt_kind(int dt) -> int
            {
                switch (dt)
                {
                    case (DataType.SINT) { -> 1; }
                    case (DataType.UINT) { -> 2; }
                    case (DataType.FLOAT) { -> 3; }
                    case (DataType.DOUBLE) { -> 4; }
                    case (DataType.BOOL) { -> 5; }
                    case (DataType.CHAR) { -> 6; }
                    case (DataType.BYTE) { -> 7; }
                    case (DataType.SLONG) { -> 8; }
                    case (DataType.ULONG) { -> 9; }
                    case (DataType.STRUCT) { -> 12; }
                    case (DataType.OBJECT) { -> 13; }
                    case (DataType.VOID) { -> 14; }
                    default { -> 0; };
                };
                -> 0;
            };

            // typeof kind of a type name keyword: 0 when it is none
            name_kind(byte* tn) -> int
            {
                switch (idkvm_streq(tn, g"int\0")) { case (true) { -> 1; } default {}; };
                switch (idkvm_streq(tn, g"uint\0")) { case (true) { -> 2; } default {}; };
                switch (idkvm_streq(tn, g"float\0")) { case (true) { -> 3; } default {}; };
                switch (idkvm_streq(tn, g"double\0")) { case (true) { -> 4; } default {}; };
                switch (idkvm_streq(tn, g"bool\0")) { case (true) { -> 5; } default {}; };
                switch (idkvm_streq(tn, g"char\0")) { case (true) { -> 6; } default {}; };
                switch (idkvm_streq(tn, g"byte\0")) { case (true) { -> 7; } default {}; };
                switch (idkvm_streq(tn, g"long\0")) { case (true) { -> 8; } default {}; };
                switch (idkvm_streq(tn, g"ulong\0")) { case (true) { -> 9; } default {}; };
                -> 0;
            };

            // typeof kind of a type spec: pointers are depth * 100 + the pointee kind
            ts_kind(TypeSpec* ts) -> int
            {
                int depth;
                switch ((ts.flags `& TS_POINTER) != 0)
                {
                    case (true)
                    {
                        depth = ts.pointer_depth;
                        switch (depth == 0) { case (true) { depth = 1; } default {}; };
                        -> depth * 100 + this.dt_kind(ts.base_type);
                    }
                    default {};
                };
                -> this.dt_kind(ts.base_type);
            };

            // true when the type spec is a pointer (is_pointer or a pointer depth)
            ts_is_ptr(TypeSpec* ts) -> bool
            {
                -> (ts.flags `& TS_POINTER) != 0 | ts.pointer_depth != 0;
            };

            // Counts one hit of an unported feature. n may be null.
            stub(Node* n, byte* what) -> void
            {
                i64* box;
                switch (this.par != (IDKVMCodegen*)0)
                {
                    case (true) { -> this.par.stub(n, what); }
                    default {};
                };
                box = (i64*)nm_get(this.ucounts, what);
                switch (n != (Node*)0)
                {
                    case (true) { this.cur_line = n.line; }
                    default {};
                };
                switch (box == (i64*)0)
                {
                    case (true)
                    {
                        box = (i64*)fmalloc((u64)8);
                        pv_push(this.owned, (void*)box);
                        *box = (i64)0;
                        nm_put(this.ucounts, what, (void*)box);
                    }
                    default {};
                };
                *box = *box + (i64)1;
                this.nstubs++;
                ->;
            };

            // IDKVMCodegen.compile: a COMPTIME_BLOCK compiles its body, EMIT_IDEKA and
            // IDEKAVM_BLOCK nodes compile as the single statement they are, then HALT.
            // Returns true when no stub was hit and no error was recorded.
            // The structs of the program are known to the comptime code: the layout of each top
            // level struct definition (runtime.idk included, the IDKC reflection structs live
            // there) is defined unless the VM already knows it.
            seed_program_structs() -> void
            {
                int i;
                Node* s;
                switch (this.pstmts == (NodeVec*)0) { case (true) { ->; } default {}; };
                while (i < this.pstmts.len)
                {
                    s = this.pstmts.items[i];
                    switch (s.kind == NodeKind.STRUCT_DEF_STATEMENT) { case (true) { s = s.a; } default {}; };
                    switch (s.kind == NodeKind.STRUCT_DEF)
                    {
                        case (true)
                        {
                            switch (this.lay.find(s.text) < 0) { case (true) { this.struct_def_prefixed(s, (byte*)0); } default {}; };
                        }
                        default {};
                    };
                    i++;
                };
                ->;
            };

            compile_comptime(Node* n) -> bool
            {
                int before = this.nstubs;
                int i;
                int slot;
                Node* st;
                FvmCap* cp;
                this.seed_program_structs();
                // captured scope: read only locals set from the enclosing scope
                while (i < this.caps.len)
                {
                    cp = (FvmCap*)this.caps.items[i];
                    slot = this.alloc_local(cp.name);
                    this.emit(IDKVM_PUSH, (i64)cp.tag, cp.d, cp.m, (byte*)0);
                    this.emit1(IDKVM_LOCAL_SET, (i64)slot);
                    i++;
                };
                i = 0;
                // trait and interface pre-pass: a forward referenced name is known before an
                // object that uses it is compiled
                switch (n.kind == NodeKind.COMPTIME_BLOCK)
                {
                    case (true)
                    {
                        this.cbody = n.l0;
                        while (i < node_count(n, 0))
                        {
                            st = node_child(n, 0, i);
                            switch (st != (Node*)0)
                            {
                                case (true)
                                {
                                    switch (st.kind == NodeKind.TRAIT_DEF)
                                    {
                                        case (true)
                                        {
                                            switch (!nm_has(this.trreg, st.text)) { case (true) { nm_put(this.trreg, st.text, (void*)st); } default {}; };
                                        }
                                        default {};
                                    };
                                    switch (st.kind == NodeKind.INTERFACE_DEF)
                                    {
                                        case (true)
                                        {
                                            switch (!nm_has(this.ifreg, st.text)) { case (true) { nm_put(this.ifreg, st.text, (void*)st); } default {}; };
                                        }
                                        default {};
                                    };
                                }
                                default {};
                            };
                            i++;
                        };
                        this.visit_body(n);
                    }
                    default { this.visit_stmt(n); };
                };
                this.resolve_goto_patches();
                this.emit0(IDKVM_HALT);
                this.code.unit_end(this.unit);
                -> this.nstubs == before & !this.failed;
            };

            // The global constants of an imported program (_collect_global_consts): a literal
            // becomes a VM global, a declaration without value an array or a null pointer, so the
            // function bodies of the import read them through GLOBAL_GET. A name the VM already
            // holds is left alone.
            import_const(Node* s, IDEKAVM* vm) -> void
            {
                int k = s.kind;
                Node* ns = s;
                Node* ini;
                Node* inner;
                TypeSpec* ts;
                byte* nm;
                i64* blk;
                int i;
                int cnt;
                switch (k == NodeKind.NAMESPACE_DEF_STATEMENT | k == NodeKind.NAMESPACE_DEF)
                {
                    case (true)
                    {
                        switch (k == NodeKind.NAMESPACE_DEF_STATEMENT) { case (true) { ns = s.a; } default {}; };
                        switch (ns.a != (Node*)0)
                        {
                            case (true)
                            {
                                i = 0;
                                while (i < node_count(ns.a, 0)) { this.import_const(node_child(ns.a, 0, i), vm); i++; };
                            }
                            default {};
                        };
                        switch (ns.b != (Node*)0)
                        {
                            case (true)
                            {
                                i = 0;
                                while (i < node_count(ns.b, 0)) { this.import_const(node_child(ns.b, 0, i), vm); i++; };
                            }
                            default {};
                        };
                        ->;
                    }
                    default {};
                };
                switch (k != NodeKind.VARIABLE_DECLARATION) { case (true) { ->; } default {}; };
                switch (vm.global_find(s.text) >= 0) { case (true) { ->; } default {}; };
                nm = this.keep(s.text);
                ini = s.a;
                ts = s.ts;
                switch (ini == (Node*)0)
                {
                    case (true)
                    {
                        cnt = 0;
                        switch (ts != (TypeSpec*)0)
                        {
                            case (true)
                            {
                                switch ((ts.flags `& TS_ARRAY) != 0 & ts.array_size != (Node*)0 & ts.array_size.kind == NodeKind.LITERAL)
                                {
                                    case (true) { cnt = (int)ts.array_size.ival; }
                                    default {};
                                };
                            }
                            default {};
                        };
                        switch (cnt > 0)
                        {
                            case (true)
                            {
                                blk = vm.arr_make(cnt, IDKVM_T_PTR);
                                switch (blk != (i64*)0) { case (true) { vm.global_set(nm, IDKVM_T_ARRAY, (i64)blk, (i64)cnt); } default {}; };
                            }
                            default { vm.global_set(nm, IDKVM_T_PTR, (i64)0, (i64)0); };
                        };
                        ->;
                    }
                    default {};
                };
                switch (ini.kind == NodeKind.LITERAL)
                {
                    case (true)
                    {
                        switch (ini.op)
                        {
                            case (DataType.BOOL) { vm.global_set(nm, IDKVM_T_BOOL, (i64)(ini.ival != (i64)0), (i64)0); }
                            case (DataType.FLOAT) { vm.global_set(nm, IDKVM_T_DOUBLE, idkvm_dbl_bits(ini.fval), (i64)0); }
                            case (DataType.DOUBLE) { vm.global_set(nm, IDKVM_T_DOUBLE, idkvm_dbl_bits(ini.fval), (i64)0); }
                            case (DataType.SINT) { vm.global_set(nm, IDKVM_T_LONG, ini.ival, (i64)0); }
                            case (DataType.UINT) { vm.global_set(nm, IDKVM_T_LONG, ini.ival, (i64)0); }
                            case (DataType.SLONG) { vm.global_set(nm, IDKVM_T_LONG, ini.ival, (i64)0); }
                            case (DataType.ULONG) { vm.global_set(nm, IDKVM_T_LONG, ini.ival, (i64)0); }
                            case (DataType.BYTE) { vm.global_set(nm, IDKVM_T_LONG, ini.ival, (i64)0); }
                            default {};
                        };
                        ->;
                    }
                    default {};
                };
                switch (ini.kind == NodeKind.CAST_EXPRESSION & ini.a != (Node*)0 & ini.a.kind == NodeKind.ADDRESS_OF)
                {
                    case (true)
                    {
                        inner = ini.a.a;
                        switch (inner != (Node*)0 & inner.kind == NodeKind.LITERAL & (inner.op == DataType.VOID | (inner.ival == (i64)0 & inner.fval == (double)0.0)))
                        {
                            case (true) { vm.global_set(nm, IDKVM_T_PTR, (i64)0, (i64)0); }
                            default {};
                        };
                        ->;
                    }
                    default {};
                };
                vm.global_set(nm, IDKVM_T_PTR, (i64)0, (i64)0);
                ->;
            };

            // idkvm.py _compile_imported_source after the parse: the declarations of an imported
            // program are compiled with this fresh codegen, which starts from the layouts, the
            // functions and the globals the VM holds
            compile_import(PtrVec* stmts, IDEKAVM* vm) -> bool
            {
                int i;
                int k;
                Node* s;
                int before = this.nstubs;
                i = 0;
                while (i < stmts.len) { this.import_const((Node*)stmts.items[i], vm); i++; };
                this.lay_copy_from(@vm.layouts);
                i = 0;
                while (i < vm.funcs.n)
                {
                    this.known_add(vm.funcs.names[i]);
                    i++;
                };
                i = 0;
                while (i < vm.gn)
                {
                    this.set_add(this.bglobals, vm.g_name[i]);
                    i++;
                };
                i = 0;
                while (i < stmts.len & !this.failed)
                {
                    s = (Node*)stmts.items[i];
                    k = s.kind;
                    switch (k == NodeKind.FUNCTION_DEF | k == NodeKind.FUNCTION_DEF_STATEMENT | k == NodeKind.NAMESPACE_DEF | k == NodeKind.NAMESPACE_DEF_STATEMENT | k == NodeKind.STRUCT_DEF | k == NodeKind.STRUCT_DEF_STATEMENT | k == NodeKind.UNION_DEF | k == NodeKind.UNION_DEF_STATEMENT | k == NodeKind.ENUM_DEF | k == NodeKind.ENUM_DEF_STATEMENT | k == NodeKind.TYPE_FUNC_DEF | k == NodeKind.EXTERN_BLOCK)
                    {
                        case (true) { this.visit_stmt(s); }
                        default {};
                    };
                    i++;
                };
                this.resolve_goto_patches();
                this.emit0(IDKVM_HALT);
                this.code.unit_end(this.unit);
                -> this.nstubs == before & !this.failed;
            };

            // Registers the functions of an import that the VM does not hold yet: a prototype must
            // not replace a definition that is already there
            register_new_functions(IDEKAVM* vm) -> bool
            {
                int i;
                int u;
                IDKVMCodegen* c;
                while (i < this.fnames.len)
                {
                    switch (vm.funcs.find((byte*)this.fnames.items[i]) < 0)
                    {
                        case (true)
                        {
                            c = (IDKVMCodegen*)this.fcgs.items[i];
                            u = vm.import_unit(@c.code, c.unit);
                            switch (u < 0) { case (true) { -> false; } default {}; };
                            vm.register_function((byte*)this.fnames.items[i], u);
                        }
                        default {};
                    };
                    i++;
                };
                -> true;
            };

            // The extern prototypes an import declared, at the top level and inside its function
            // bodies (the EXTERN_DECL instructions)
            collect_externs(IDEKAVM* vm) -> void
            {
                int i;
                int k;
                IDKVMCodegen* c;
                k = this.ubase;
                while (k < this.code.len)
                {
                    switch (this.code.ops[k] == IDKVM_EXTERN_DECL)
                    {
                        case (true) { vm.extern_add(this.code.s[k], (int)this.code.a[k], (int)this.code.b[k], (i64*)idkvm_i2p(this.code.c[k])); }
                        default {};
                    };
                    k++;
                };
                while (i < this.fnames.len)
                {
                    c = (IDKVMCodegen*)this.fcgs.items[i];
                    k = c.ubase;
                    while (k < c.code.len)
                    {
                        switch (c.code.ops[k] == IDKVM_EXTERN_DECL)
                        {
                            case (true) { vm.extern_add(c.code.s[k], (int)c.code.a[k], (int)c.code.b[k], (i64*)idkvm_i2p(c.code.c[k])); }
                            default {};
                        };
                        k++;
                    };
                    i++;
                };
                ->;
            };

            // IDKVMCodegen._visit_body and _visit_body_stmts: a BLOCK or COMPTIME_BLOCK
            // node visits its statements, any other node is the one statement.
            // The per body defer scope and the unpack group scan are not emitted yet.
            // IDKVMCodegen._visit_body_stmts: the statements of a body. A run of declarations without
            // initializer followed by one declaration initialized from a one element array literal
            // is an unpack group.
            visit_body_stmts(Node* b) -> void
            {
                int c = node_count(b, 0);
                int i;
                int j;
                int k;
                int gs;
                int* ends = (int*)fmalloc((u64)((c + 1) * 4));
                Node* s;
                j = 0;
                while (j < c)
                {
                    ends[j] = -1;
                    j++;
                };
                // marks: ends[start] = last index of the group, -2 for the members after the start
                j = 0;
                while (j < c)
                {
                    s = node_child(b, 0, j);
                    switch (this.is_unpack_init(s))
                    {
                        case (true)
                        {
                            k = j - 1;
                            while (k >= 0 & ends[k] == -1 & this.is_bare_decl(node_child(b, 0, k), s.ts.base_type))
                            {
                                k--;
                            };
                            gs = k + 1;
                            switch (gs < j)
                            {
                                case (true)
                                {
                                    ends[gs] = j;
                                    k = gs + 1;
                                    while (k <= j)
                                    {
                                        ends[k] = -2;
                                        k++;
                                    };
                                }
                                default {};
                            };
                        }
                        default {};
                    };
                    j++;
                };
                while (i < c)
                {
                    switch (ends[i] >= 0)
                    {
                        case (true)
                        {
                            this.emit_unpack(b, i, ends[i]);
                            i = ends[i] + 1;
                        }
                        default
                        {
                            switch (ends[i] == -2)
                            {
                                case (true) { i++; }
                                default
                                {
                                    this.visit_stmt(node_child(b, 0, i));
                                    i++;
                                };
                            };
                        };
                    };
                };
                ffree((byte*)ends);
                ->;
            };

            // the declaration that ends an unpack group: T x = [src]; with T an integer type
            is_unpack_init(Node* s) -> bool
            {
                int dt;
                switch (s.kind != NodeKind.VARIABLE_DECLARATION | s.a == (Node*)0)
                {
                    case (true) { -> false; }
                    default
                    {
                        switch (s.a.kind != NodeKind.ARRAY_LITERAL | (s.a.flags `& NF_IS_STRING) != 0 | node_count(s.a, 0) != 1 | s.ts == (TypeSpec*)0)
                        {
                            case (true) { -> false; }
                            default
                            {
                                dt = s.ts.base_type;
                                -> (s.ts.flags `& TS_ARRAY) == 0 & idkvmcg_unpack_type(dt);
                            };
                        };
                    };
                };
            };

            // a declaration without initializer of the given type
            is_bare_decl(Node* s, int dt) -> bool
            {
                switch (s.kind != NodeKind.VARIABLE_DECLARATION | s.ts == (TypeSpec*)0)
                {
                    case (true) { -> false; }
                    default { -> s.a == (Node*)0 & s.ts.base_type == dt; };
                };
            };

            // IDKVMCodegen._visit_body: a BLOCK or COMPTIME_BLOCK node visits its statements in a defer
            // scope of their own, any other node is the one statement. The statements registered with
            // defer run in reverse order when the body falls through.
            visit_body(Node* b) -> void
            {
                PtrVec* scope;
                switch (b == (Node*)0)
                {
                    case (true) { ->; }
                    default {};
                };
                scope = pv_new();
                pv_push(this.defers, (void*)scope);
                switch (b.kind == NodeKind.BLOCK | b.kind == NodeKind.COMPTIME_BLOCK)
                {
                    case (true) { this.visit_body_stmts(b); }
                    default { this.visit_stmt(b); };
                };
                this.flush_defers(scope);
                this.defers.len--;
                pv_free(scope);
                ->;
            };

            // IDKVMCodegen._visit_stmt
            visit_stmt(Node* n) -> void
            {
                int k;
                switch (n == (Node*)0)
                {
                    case (true) { ->; }
                    default {};
                };
                k = n.kind;
                this.cur_line = n.line;
                switch (k)
                {
                case (NodeKind.VARIABLE_DECLARATION) { this.visit_var_decl(n); }
                case (NodeKind.TYPE_DECLARATION) { this.visit_type_decl(n); }
                case (NodeKind.ASSIGNMENT) { this.visit_assignment(n); }
                case (NodeKind.COMPOUND_ASSIGNMENT) { this.visit_compound_assign(n); }
                case (NodeKind.RANGE_ASSIGNMENT) { this.visit_range_assignment(n); }
                case (NodeKind.TERNARY_ASSIGN) { this.visit_ternary_assign(n); }
                case (NodeKind.EXPRESSION_STATEMENT) { this.visit_expr_stmt(n); }
                case (NodeKind.IF_STATEMENT) { this.visit_if(n); }
                case (NodeKind.FOR_LOOP) { this.visit_for(n); }
                case (NodeKind.FOR_IN_LOOP) { this.visit_for_in(n); }
                case (NodeKind.WHILE_LOOP) { this.visit_while(n); }
                case (NodeKind.DO_LOOP) { this.visit_do(n); }
                case (NodeKind.DO_WHILE_LOOP) { this.visit_do_while(n); }
                case (NodeKind.DEFER_STATEMENT) { this.visit_defer(n); }
                case (NodeKind.NORETURN_STATEMENT) { this.visit_noreturn(n); }
                case (NodeKind.TRY_BLOCK) { this.visit_try(n); }
                case (NodeKind.THROW_STATEMENT) { this.visit_throw(n); }
                case (NodeKind.RETURN_STATEMENT) { this.visit_return(n); }
                case (NodeKind.BREAK_STATEMENT) { this.visit_break(n); }
                case (NodeKind.BREAK_SWITCH_STATEMENT) { this.visit_break_switch(n); }
                case (NodeKind.ESCAPE_STATEMENT) { this.visit_escape(n); }
                case (NodeKind.CONTINUE_STATEMENT) { this.visit_continue(n); }
                case (NodeKind.BLOCK) { this.visit_body(n); }
                case (NodeKind.SWITCH_STATEMENT) { this.visit_switch(n); }
                case (NodeKind.FUNCTION_DEF) { this.visit_function_def(n); }
                case (NodeKind.FUNCTION_DEF_STATEMENT) { this.visit_function_def(n.a); }
                case (NodeKind.FUNCTION_POINTER_DECLARATION) { this.visit_fp_decl(n); }
                case (NodeKind.FUNCTION_POINTER_ASSIGNMENT) { this.visit_fp_assignment(n); }
                case (NodeKind.TYPE_FUNC_DEF) { this.visit_type_func_def(n); }
                case (NodeKind.NAMESPACE_DEF) { this.visit_namespace_def(n); }
                case (NodeKind.NAMESPACE_DEF_STATEMENT) { this.visit_namespace_def(n.a); }
                case (NodeKind.STRUCT_DEF) { this.visit_struct_def(n); }
                case (NodeKind.STRUCT_DEF_STATEMENT) { this.visit_struct_def(n.a); }
                case (NodeKind.STRUCT_FIELD_ASSIGN) { this.visit_struct_field_assign(n); }
                case (NodeKind.UNION_DEF) { this.visit_union_def(n); }
                case (NodeKind.UNION_DEF_STATEMENT) { this.visit_union_def(n.a); }
                case (NodeKind.OBJECT_DEF) { this.visit_object_def(n); }
                case (NodeKind.OBJECT_DEF_STATEMENT) { this.visit_object_def(n.a); }
                case (NodeKind.TRAIT_DEF) { this.visit_trait_def(n); }
                case (NodeKind.INTERFACE_DEF) { this.visit_interface_def(n); }
                case (NodeKind.DEPRECATE_STATEMENT) { this.visit_deprecate(n); }
                case (NodeKind.ASSERT_STATEMENT) { this.visit_assert(n); }
                case (NodeKind.MACRO_DEF_STATEMENT) { this.visit_macro_def(n); }
                case (NodeKind.EXTERN_BLOCK) { this.visit_extern_block(n); }
                case (NodeKind.ENUM_DEF) { this.visit_enum_def(n); }
                case (NodeKind.ENUM_DEF_STATEMENT) { this.visit_enum_def(n.a); }
                case (NodeKind.LABEL_STATEMENT) { this.visit_label(n); }
                case (NodeKind.GOTO_STATEMENT) { this.visit_goto(n); }
                case (NodeKind.JUMP_STATEMENT) { this.visit_jump(n); }
                case (NodeKind.EMIT_IDEKA) { this.visit_emitideka(n); }
                case (NodeKind.IDEKAVM_BLOCK) { this.visit_idkvm_block(n); }
                case (NodeKind.COMPTIME_BLOCK) { this.visit_body(n); }
                case (NodeKind.USING_STATEMENT) { this.visit_using(n); }
                case (NodeKind.NOT_USING_STATEMENT) { this.visit_not_using(n); }
                case (NodeKind.CONTRACT_DEF) {}
                case (NodeKind.CONSTRA_DEF) {}
                case (NodeKind.MACRO_DEF) {}
                case (NodeKind.EXPORT_BLOCK) {}
                default { this.stub(n, node_kind_name(k)); };
                };
                ->;
            };

            // IDKVMCodegen._visit_expr: true when a value was left on the VM stack
            visit_expr(Node* n) -> bool
            {
                int k;
                switch (n == (Node*)0)
                {
                    case (true) { -> false; }
                    default {};
                };
                k = n.kind;
                switch (k)
                {
                case (NodeKind.LITERAL) { -> this.visit_literal(n); }
                case (NodeKind.STRING_LITERAL) { -> this.visit_string_literal(n); }
                case (NodeKind.F_STRING_LITERAL) { -> this.visit_fstring_literal(n); }
                case (NodeKind.ARRAY_LITERAL) { -> this.visit_array_literal(n); }
                case (NodeKind.IDENTIFIER) { -> this.visit_identifier(n); }
                case (NodeKind.BINARY_OP) { -> this.visit_binary_op(n); }
                case (NodeKind.UNARY_OP) { -> this.visit_unary_op(n); }
                case (NodeKind.FUNCTION_CALL) { -> this.visit_function_call(n); }
                case (NodeKind.FUNCTION_POINTER_CALL) { -> this.visit_fp_call(n); }
                case (NodeKind.METHOD_CALL) { -> this.visit_method_call(n); }
                case (NodeKind.ARRAY_ACCESS) { -> this.visit_array_access(n); }
                case (NodeKind.BIT_SLICE) { -> this.visit_bit_slice(n); }
                case (NodeKind.BIT_INDEX_ACCESS) { -> this.visit_bit_index_access(n); }
                case (NodeKind.NULL_COALESCE) { -> this.visit_null_coalesce(n); }
                case (NodeKind.TERNARY_ASSIGN) { -> this.visit_ternary_assign(n); }
                case (NodeKind.NOT_NULL) { -> this.visit_not_null(n); }
                case (NodeKind.ARRAY_SLICE) { -> this.visit_array_slice(n); }
                case (NodeKind.ARRAY_COMPREHENSION) { -> this.visit_array_comprehension(n); }
                case (NodeKind.RANGE_EXPRESSION) { -> this.visit_range_expression(n); }
                case (NodeKind.TIE_EXPRESSION) { -> this.visit_tie_expression(n); }
                case (NodeKind.VARIADIC_ACCESS) { -> this.visit_variadic_access(n); }
                case (NodeKind.MACRO_CALL) { -> this.visit_macro_call(n); }
                case (NodeKind.TYPE_FUNC_CALL) { -> this.visit_type_func_call(n); }
                case (NodeKind.STRUCT_FIELD_ACCESS) { -> this.visit_struct_field_access(n); }
                case (NodeKind.STRUCT_INSTANCE) { -> this.visit_struct_instance(n); }
                case (NodeKind.STRUCT_LITERAL) { -> this.visit_struct_literal(n); }
                case (NodeKind.STRUCT_RECAST) { -> this.visit_struct_recast(n); }
                case (NodeKind.MEMBER_ACCESS) { -> this.visit_member_access(n); }
                case (NodeKind.ADDRESS_OF) { -> this.visit_address_of(n); }
                case (NodeKind.POINTER_DEREF) { -> this.visit_pointer_deref(n); }
                case (NodeKind.SIZE_OF) { -> this.visit_sizeof(n); }
                case (NodeKind.ALIGN_OF) { -> this.visit_alignof(n); }
                case (NodeKind.TYPE_OF) { -> this.visit_typeof(n); }
                case (NodeKind.ENDIAN_OF) { -> this.visit_endianof(n); }
                case (NodeKind.IN_EXPRESSION) { -> this.visit_in_expression(n); }
                case (NodeKind.HAS_EXPRESSION) { -> this.visit_has_expression(n); }
                case (NodeKind.CAST_EXPRESSION) { -> this.visit_cast(n); }
                case (NodeKind.TYPE_CONVERT_EXPRESSION) { -> this.visit_cast(n); }
                case (NodeKind.INLINE_ASM) { -> this.visit_inline_asm(n); }
                case (NodeKind.TERNARY_OP) { -> this.visit_ternary_op(n); }
                case (NodeKind.IF_EXPRESSION) { -> this.visit_if_expression(n); }
                case (NodeKind.STRINGIFY) { -> this.visit_stringify(n); }
                case (NodeKind.ASSIGNMENT) { this.visit_assignment(n); -> false; }
                case (NodeKind.COMPOUND_ASSIGNMENT) { this.visit_compound_assign(n); -> false; }
                case (NodeKind.RANGE_ASSIGNMENT) { this.visit_range_assignment(n); -> false; }
                case (NodeKind.BLOCK) { this.visit_body(n); -> false; }
                default { this.stub(n, node_kind_name(k)); };
                };
                -> false;
            };

            // ----- ported visitors -----

            // IDKVMCodegen._visit_literal: true when a value was pushed
            visit_literal(Node* n) -> bool
            {
                int dt = n.op;
                switch (dt)
                {
                    case (DataType.FLOAT) { this.emit_push(IDKVM_T_FLOAT, idkvm_dbl_bits(n.fval)); -> true; }
                    case (DataType.DOUBLE) { this.emit_push(IDKVM_T_DOUBLE, idkvm_dbl_bits(n.fval)); -> true; }
                    case (DataType.BOOL)
                    {
                        switch (n.ival != (i64)0)
                        {
                            case (true) { this.emit_push(IDKVM_T_BOOL, (i64)1); }
                            default { this.emit_push(IDKVM_T_BOOL, (i64)0); };
                        };
                        -> true;
                    }
                    case (DataType.SINT) { this.emit_push(IDKVM_T_INT, n.ival); -> true; }
                    case (DataType.UINT) { this.emit_push(IDKVM_T_UINT, n.ival); -> true; }
                    case (DataType.SLONG) { this.emit_push(IDKVM_T_LONG, n.ival); -> true; }
                    case (DataType.ULONG) { this.emit_push(IDKVM_T_ULONG, n.ival); -> true; }
                    case (DataType.BYTE) { this.emit_push(IDKVM_T_BYTE, n.ival); -> true; }
                    case (DataType.CHAR) { this.emit_push(IDKVM_T_CHAR, n.ival); -> true; }
                    case (DataType.STRUCT)
                    {
                        // the value is the text of the type and int() of it raises
                        this.fail_pieces(n, g"invalid literal for int() with base 10: '\0", datatype_text(dt), g"'\0", (byte*)0, (byte*)0, (byte*)0, (byte*)0);
                        -> false;
                    }
                    case (DataType.OBJECT)
                    {
                        this.fail_pieces(n, g"invalid literal for int() with base 10: '\0", datatype_text(dt), g"'\0", (byte*)0, (byte*)0, (byte*)0, (byte*)0);
                        -> false;
                    }
                    default {};
                };
                // any other type (void) maps to an int tag and carries its value
                this.emit_push(IDKVM_T_INT, n.ival);
                -> true;
            };

            // IDKVMCodegen._visit_identifier
            // IDKVMCodegen._visit_identifier
            visit_identifier(Node* n) -> bool
            {
                i64* box;
                int i;
                FvmBuf b;
                FvmHeapVar* hv;
                switch (nm_has(this.oglobals, n.text))
                {
                    case (true) { this.emits(IDKVM_GLOBAL_GET, n.text); -> true; }
                    default {};
                };
                box = (i64*)nm_get(this.locals, n.text);
                switch (box != (i64*)0)
                {
                    case (true)
                    {
                        this.emit1(IDKVM_LOCAL_GET, *box);
                        hv = (FvmHeapVar*)nm_get(this.hvars, n.text);
                        // a heap scalar auto-dereferences, a heap array names its base pointer
                        switch (hv != (FvmHeapVar*)0)
                        {
                            case (true)
                            {
                                switch (hv.count == 0)
                                {
                                    case (true) { this.emit(IDKVM_LOAD, (i64)hv.ttag, (i64)hv.bytes, (i64)0, (byte*)0); }
                                    default {};
                                };
                            }
                            default {};
                        };
                        -> true;
                    }
                    default {};
                };
                // active using namespaces: standard::datetime makes standard__datetime__name
                i = this.usings.len - 1;
                while (i >= 0)
                {
                    b.__init();
                    b.put_str((byte*)this.usings.items[i]);
                    b.put_str(g"__\0");
                    b.put_str(n.text);
                    b.put(0);
                    box = (i64*)nm_get(this.locals, b.mem);
                    b.__exit();
                    switch (box != (i64*)0)
                    {
                        case (true)
                        {
                            this.emit1(IDKVM_LOCAL_GET, *box);
                            -> true;
                        }
                        default {};
                    };
                    i--;
                };
                // a struct type name used as a value
                switch (this.lay.find(n.text) >= 0)
                {
                    case (true)
                    {
                        this.emit(IDKVM_PUSH, (i64)IDKVM_T_BYTES, idkvm_p2i(this.keep(n.text)), (i64)idkvm_strlen(n.text), (byte*)0);
                        -> true;
                    }
                    default {};
                };
                switch (nm_has(this.bglobals, n.text))
                {
                    case (true) { this.emits(IDKVM_GLOBAL_GET, n.text); -> true; }
                    default {};
                };
                this.fail_name(n, g"idkvmcodegen: undefined comptime variable \0", n.text, g"\0");
                -> false;
            };

            // IDKVMCodegen._visit_binary_op
            visit_binary_op(Node* n) -> bool
            {
                int op = n.op;
                int j;
                int vm;
                switch (op == Operator.AND)
                {
                    case (true)
                    {
                        this.visit_expr(n.a);
                        this.emit0(IDKVM_DUP);
                        j = this.emit1(IDKVM_JNF, (i64)0);
                        this.emit0(IDKVM_POP);
                        this.visit_expr(n.b);
                        this.patch_at(j, IDKVM_JNF, this.ip());
                        -> true;
                    }
                    default {};
                };
                switch (op == Operator.OR)
                {
                    case (true)
                    {
                        this.visit_expr(n.a);
                        this.emit0(IDKVM_DUP);
                        j = this.emit1(IDKVM_JIF, (i64)0);
                        this.emit0(IDKVM_POP);
                        this.visit_expr(n.b);
                        this.patch_at(j, IDKVM_JIF, this.ip());
                        -> true;
                    }
                    default {};
                };
                this.visit_expr(n.a);
                this.visit_expr(n.b);
                vm = idkvmcg_binop_single(op);
                switch (vm >= 0)
                {
                    case (true) { this.emit0(vm); -> true; }
                    default {};
                };
                vm = idkvmcg_binop_composite(op);
                switch (vm >= 0)
                {
                    case (true)
                    {
                        this.emit0(vm);
                        this.emit0(IDKVM_BNOT);
                        -> true;
                    }
                    default {};
                };
                this.fail(n, g"idkvmcodegen: binary operator not supported in comptime\0");
                -> false;
            };

            // IDKVMCodegen._visit_var_decl: scalar, struct and pointer variables.
            // Heap, singinit, constructor, pack and stack array forms are stubbed.
            // records the declared type of a variable: the type spec and the type name
            note_decl_type(byte* name, TypeSpec* ts) -> void
            {
                nm_put(this.ltypes, name, (void*)ts);
                switch (ts.custom_typename != (byte*)0)
                {
                    case (true) { nm_put(this.ltn, name, (void*)ts.custom_typename); }
                    default { nm_put(this.ltn, name, (void*)datatype_text(ts.base_type)); };
                };
                ->;
            };

            // IDKVMCodegen._declared_float_ttag: FLOAT or DOUBLE when ts declares a plain float or
            // double scalar, else -1. The declared type dictates the representation, whatever
            // tag the value carries.
            declared_float_ttag(TypeSpec* ts) -> int
            {
                switch (ts == (TypeSpec*)0) { case (true) { -> -1; } default {}; };
                switch (this.ts_is_ptr(ts) | (ts.flags `& TS_ARRAY) != 0 | ts.custom_typename != (byte*)0) { case (true) { -> -1; } default {}; };
                switch (ts.base_type == DataType.FLOAT) { case (true) { -> IDKVM_T_FLOAT; } default {}; };
                switch (ts.base_type == DataType.DOUBLE) { case (true) { -> IDKVM_T_DOUBLE; } default {}; };
                -> -1;
            };

            // CAST to the declared float type of ts on the value on top of the stack
            cast_declared_float(TypeSpec* ts) -> void
            {
                int ft = this.declared_float_ttag(ts);
                switch (ft >= 0) { case (true) { this.emit(IDKVM_CAST, (i64)ft, (i64)0, (i64)0, (byte*)0); } default {}; };
                ->;
            };

            // IDKVMCodegen._visit_var_decl: heap and singinit storage, constructor calls, pack
            // expressions, stack arrays and zero initialisation
            visit_var_decl(Node* n) -> bool
            {
                TypeSpec* ts = n.ts;
                Node* ini = n.a;
                int slot = this.alloc_local(n.text);
                bool has_init;
                int dt;
                int i;
                int argc;
                int total;
                int ebytes;
                int cnt;
                int tt;
                int bsz;
                int jnf;
                int jmp;
                int done_ip;
                byte* guard;
                byte* tn;
                FvmBuf b;
                FvmHeapVar* hv;
                switch (ts != (TypeSpec*)0)
                {
                    case (true)
                    {
                        switch ((ts.flags `& TS_LOCAL) != 0) { case (true) { this.set_add(this.lvars, n.text); } default {}; };
                        switch (ts.storage_class == StorageClass.HEAP)
                        {
                            case (true)
                            {
                                hv = (FvmHeapVar*)fmalloc((u64)((sizeof(FvmHeapVar) + 7) / 8));
                                pv_push(this.owned, (void*)hv);
                                switch ((ts.flags `& TS_ARRAY) != 0)
                                {
                                    case (true)
                                    {
                                        switch (ts.array_size == (Node*)0)
                                        {
                                            case (true)
                                            {
                                                this.fail(n, g"idkvmcodegen: heap array needs a size\0");
                                                -> false;
                                            }
                                            default {};
                                        };
                                        cnt = (int)ts.array_size.ival;
                                        ebytes = this.type_bit_width_base(ts.base_type, ts) / 8;
                                        switch (ebytes < 1) { case (true) { ebytes = 1; } default {}; };
                                        tt = idkvmcg_datatype_ttag(ts.base_type);
                                        total = cnt * ebytes;
                                        hv.ttag = tt;
                                        hv.bytes = ebytes;
                                        hv.count = cnt;
                                        nm_put(this.hvars, n.text, (void*)hv);
                                        this.emit_push(IDKVM_T_UINT, (i64)total);
                                        this.emit0(IDKVM_ALLOC);
                                        switch (ini != (Node*)0)
                                        {
                                            case (true)
                                            {
                                                switch (ini.kind == NodeKind.ARRAY_LITERAL)
                                                {
                                                    case (true)
                                                    {
                                                        while (i < node_count(ini, 0))
                                                        {
                                                            this.emit0(IDKVM_DUP);
                                                            this.emit_push(IDKVM_T_UINT, (i64)(i * ebytes));
                                                            this.emit0(IDKVM_ADD);
                                                            this.visit_expr(node_child(ini, 0, i));
                                                            this.emit(IDKVM_STORE, (i64)tt, (i64)ebytes, (i64)0, (byte*)0);
                                                            i++;
                                                        };
                                                    }
                                                    default {};
                                                };
                                            }
                                            default {};
                                        };
                                        this.emit1(IDKVM_LOCAL_SET, (i64)slot);
                                        -> false;
                                    }
                                    default {};
                                };
                                bsz = this.type_bit_width(ts) / 8;
                                switch (bsz < 1) { case (true) { bsz = 1; } default {}; };
                                tt = this.type_ttag_from_ts(ts);
                                hv.ttag = tt;
                                hv.bytes = bsz;
                                hv.count = 0;
                                nm_put(this.hvars, n.text, (void*)hv);
                                this.emit_push(IDKVM_T_UINT, (i64)bsz);
                                this.emit0(IDKVM_ALLOC);
                                switch (ini != (Node*)0)
                                {
                                    case (true)
                                    {
                                        switch (ini.kind != NodeKind.NO_INIT)
                                        {
                                            case (true)
                                            {
                                                this.emit0(IDKVM_DUP);
                                                this.visit_expr(ini);
                                                this.emit(IDKVM_STORE, (i64)tt, (i64)bsz, (i64)0, (byte*)0);
                                            }
                                            default {};
                                        };
                                    }
                                    default {};
                                };
                                this.emit1(IDKVM_LOCAL_SET, (i64)slot);
                                -> false;
                            }
                            default {};
                        };
                        switch (ts.storage_class == StorageClass.SINGINIT)
                        {
                            case (true)
                            {
                                // initialised once: a guard global says whether it already was
                                b.__init();
                                b.put_str(g"__singinit_guard__\0");
                                b.put_str(n.text);
                                b.put(0);
                                guard = this.keep(b.mem);
                                b.__exit();
                                this.emits(IDKVM_GLOBAL_GET, guard);
                                this.emit_push(IDKVM_T_INT, (i64)0);
                                this.emit0(IDKVM_CMP_EQ);
                                jnf = this.emit1(IDKVM_JNF, (i64)0);
                                switch (ini != (Node*)0)
                                {
                                    case (true)
                                    {
                                        switch (ini.kind != NodeKind.NO_INIT)
                                        {
                                            case (true) { this.visit_expr(ini); }
                                            default { this.emit_push(this.type_ttag_from_ts(ts), (i64)0); };
                                        };
                                    }
                                    default { this.emit_push(this.type_ttag_from_ts(ts), (i64)0); };
                                };
                                this.emit0(IDKVM_DUP);
                                this.emit1(IDKVM_LOCAL_SET, (i64)slot);
                                this.emits(IDKVM_GLOBAL_SET, n.text);
                                this.emit_push(IDKVM_T_INT, (i64)1);
                                this.emits(IDKVM_GLOBAL_SET, guard);
                                jmp = this.emit1(IDKVM_JMP, (i64)0);
                                done_ip = this.ip();
                                this.patch_at(jnf, IDKVM_JNF, done_ip);
                                this.emits(IDKVM_GLOBAL_GET, n.text);
                                this.emit1(IDKVM_LOCAL_SET, (i64)slot);
                                this.patch_at(jmp, IDKVM_JMP, this.ip());
                                this.set_add(this.bglobals, n.text);
                                this.set_add(this.bglobals, guard);
                                this.note_decl_type(n.text, ts);
                                -> false;
                            }
                            default {};
                        };
                        this.note_decl_type(n.text, ts);
                    }
                    default {};
                };
                switch (ini != (Node*)0)
                {
                    case (true) { has_init = ini.kind != NodeKind.NO_INIT; }
                    default {};
                };
                switch (has_init)
                {
                    case (true)
                    {
                        switch (ini.kind == NodeKind.FUNCTION_CALL)
                        {
                            case (true)
                            {
                                switch (idkvmcg_ends_with(ini.text, g".__init\0"))
                                {
                                    case (true)
                                    {
                                        // MyObj o(args): the struct is made, then __init runs with it as slot 0
                                        tn = idkvm_dup(ini.text, idkvm_strlen(ini.text) - 7);
                                        pv_push(this.owned, (void*)tn);
                                        this.emits(IDKVM_STRUCT_NEW, tn);
                                        argc = node_count(ini, 0);
                                        while (i < argc)
                                        {
                                            this.visit_expr(node_child(ini, 0, i));
                                            i++;
                                        };
                                        this.emit(IDKVM_CALL, (i64)(1 + argc), (i64)0, (i64)0, this.keep(ini.text));
                                        this.emit0(IDKVM_POP);
                                        this.emit0(IDKVM_DUP);
                                        this.emit1(IDKVM_LOCAL_SET, (i64)slot);
                                        this.emits(IDKVM_GLOBAL_SET, n.text);
                                        this.set_add(this.bglobals, n.text);
                                        -> false;
                                    }
                                    default {};
                                };
                            }
                            default {};
                        };
                        switch (ts != (TypeSpec*)0 & ini.kind == NodeKind.ARRAY_LITERAL)
                        {
                            case (true)
                            {
                                dt = ts.base_type;
                                switch ((ts.flags `& TS_ARRAY) == 0 & (ini.flags `& NF_IS_STRING) == 0 & idkvmcg_unpack_type(dt))
                                {
                                    case (true) { this.emit_pack(ini, ts); }
                                    default
                                    {
                                        this.struct_elem_type(ts, ini);
                                        this.visit_expr(ini);
                                    };
                                };
                            }
                            default { this.visit_expr(ini); };
                        };
                        // the declared float type dictates the representation of the value
                        this.cast_declared_float(ts);
                        // pointer to a named struct: tag the pointer with the struct name
                        switch (ts != (TypeSpec*)0)
                        {
                            case (true)
                            {
                                switch ((ts.flags `& TS_POINTER) != 0 & ts.custom_typename != (byte*)0)
                                {
                                    case (true)
                                    {
                                        switch (!nm_has(this.enums, ts.custom_typename) & this.alias_ttag(ts.custom_typename) < 0)
                                        {
                                            case (true) { this.emit(IDKVM_CAST, (i64)IDKVM_T_PTR, (i64)0, (i64)0, this.keep(ts.custom_typename)); }
                                            default {};
                                        };
                                    }
                                    default {};
                                };
                            }
                            default {};
                        };
                    }
                    default
                    {
                        // zero initialise: every IDEKA variable is zero-init by default
                        switch (ts != (TypeSpec*)0)
                        {
                            case (true)
                            {
                                switch ((ts.flags `& TS_ARRAY) != 0 & ts.array_size != (Node*)0)
                                {
                                    case (true)
                                    {
                                        switch (ts.array_size.kind != NodeKind.LITERAL)
                                        {
                                            case (true)
                                            {
                                                this.fail(n, g"idkvmcodegen: stack array size must be an integer literal\0");
                                                -> false;
                                            }
                                            default {};
                                        };
                                        // stack array: ARRAY_NEW with zero elements, element tag from the base type
                                        this.emit(IDKVM_ARRAY_NEW, (i64)ts.array_size.ival, (i64)0, (i64)0, this.keep(idkvmcg_ttag_type_name(idkvmcg_datatype_ttag(ts.base_type))));
                                    }
                                    default
                                    {
                                        switch (ts.custom_typename != (byte*)0)
                                        {
                                            case (true)
                                            {
                                                dt = this.alias_ttag(ts.custom_typename);
                                                switch (dt >= 0)
                                                {
                                                    case (true) { this.emit_push(dt, (i64)0); }
                                                    default
                                                    {
                                                        switch (nm_has(this.enums, ts.custom_typename))
                                                        {
                                                            case (true) { this.emits(IDKVM_ENUM_NEW, ts.custom_typename); }
                                                            default { this.emits(IDKVM_STRUCT_NEW, ts.custom_typename); };
                                                        };
                                                    };
                                                };
                                            }
                                            default { this.emit_push(idkvmcg_datatype_ttag(ts.base_type), (i64)0); };
                                        };
                                    };
                                };
                            }
                            default { this.emit_push(IDKVM_T_INT, (i64)0); };
                        };
                    };
                };
                // mirror to VM globals so nested function bodies can access the variable
                this.set_add(this.bglobals, n.text);
                this.emit0(IDKVM_DUP);
                this.emit1(IDKVM_LOCAL_SET, (i64)slot);
                this.emits(IDKVM_GLOBAL_SET, n.text);
                -> false;
            };

            // an array of structs: the struct literals of the initializer take the element type name
            struct_elem_type(TypeSpec* ts, Node* ini) -> void
            {
                int i;
                Node* e;
                switch ((ts.flags `& TS_ARRAY) != 0 & ts.custom_typename != (byte*)0)
                {
                    case (true)
                    {
                        while (i < node_count(ini, 0))
                        {
                            e = node_child(ini, 0, i);
                            switch (e.kind == NodeKind.STRUCT_LITERAL & e.text == (byte*)0)
                            {
                                case (true) { e.text = ts.custom_typename; }
                                default {};
                            };
                            i++;
                        };
                    }
                    default {};
                };
                ->;
            };

            // IDKVMCodegen._visit_assignment: identifier targets. Member, array and
            // other targets are stubbed.
            visit_assignment(Node* n) -> bool
            {
                Node* t = n.a;
                int slot;
                FvmHeapVar* hv;
                i64* hbox;
                switch (t.kind == NodeKind.IDENTIFIER)
                {
                    case (true)
                    {
                        this.check_const_assign(t.text, n, g" with assignment\0");
                        hv = (FvmHeapVar*)nm_get(this.hvars, t.text);
                        switch (hv != (FvmHeapVar*)0)
                        {
                            case (true)
                            {
                                hbox = (i64*)nm_get(this.locals, t.text);
                                switch (hv.count <= 0 & hbox != (i64*)0)
                                {
                                    case (true)
                                    {
                                        // heap scalar: the slot holds the pointer, so the value is STOREd through it
                                        this.emit1(IDKVM_LOCAL_GET, *hbox);
                                        this.visit_expr(n.b);
                                        this.emit(IDKVM_STORE, (i64)hv.ttag, (i64)hv.bytes, (i64)0, (byte*)0);
                                        -> false;
                                    }
                                    default {};
                                };
                            }
                            default {};
                        };
                        switch (nm_has(this.oglobals, t.text))
                        {
                            case (true)
                            {
                                this.visit_expr(n.b);
                                this.cast_declared_float((TypeSpec*)nm_get(this.ltypes, t.text));
                                this.emits(IDKVM_GLOBAL_SET, t.text);
                                -> false;
                            }
                            default {};
                        };
                        switch (this.in_func)
                        {
                            case (true)
                            {
                                this.visit_expr(n.b);
                                this.cast_declared_float((TypeSpec*)nm_get(this.ltypes, t.text));
                                slot = this.alloc_local(t.text);
                                this.emit1(IDKVM_LOCAL_SET, (i64)slot);
                                -> false;
                            }
                            default {};
                        };
                        this.set_add(this.bglobals, t.text);
                        this.visit_expr(n.b);
                        this.cast_declared_float((TypeSpec*)nm_get(this.ltypes, t.text));
                        slot = this.alloc_local(t.text);
                        this.emit0(IDKVM_DUP);
                        this.emit1(IDKVM_LOCAL_SET, (i64)slot);
                        this.emits(IDKVM_GLOBAL_SET, t.text);
                        -> false;
                    }
                    default {};
                };
                switch (t.kind)
                {
                    case (NodeKind.MEMBER_ACCESS) { this.assign_member(n); }
                    case (NodeKind.ARRAY_ACCESS) { this.assign_array_elem(n); }
                    case (NodeKind.POINTER_DEREF)
                    {
                        this.visit_expr(t.a);
                        this.visit_expr(n.b);
                        this.emit0(IDKVM_LOCAL_DEREF_SET);
                    }
                    default
                    {
                        this.fail(n, g"idkvmcodegen: unsupported assignment target in comptime\0");
                    };
                };
                -> false;
            };

            // IDKVMCodegen._visit_expr_stmt: pops the value the expression left
            visit_expr_stmt(Node* n) -> bool
            {
                switch (this.visit_expr(n.a))
                {
                    case (true) { this.emit0(IDKVM_POP); }
                    default {};
                };
                -> false;
            };

            // IDKVMCodegen._visit_return (defer flush is not ported with defer)
            visit_return(Node* n) -> bool
            {
                switch (n.a != (Node*)0)
                {
                    case (true)
                    {
                        switch (n.a.kind == NodeKind.IDENTIFIER)
                        {
                            case (true)
                            {
                                switch (nm_has(this.lvars, n.a.text))
                                {
                                    case (true)
                                    {
                                        this.fail_name(n, g"idkvmcodegen: local variable \0", n.a.text, g" cannot escape scope (returned from function)\0");
                                        -> false;
                                    }
                                    default {};
                                };
                            }
                            default {};
                        };
                        // a call that leaves no value (compiler.io.console.println) returns void
                        switch (this.visit_expr(n.a))
                        {
                            case (false) { this.emit_push(IDKVM_T_VOID, (i64)0); }
                            default {};
                        };
                    }
                    default { this.emit_push(IDKVM_T_VOID, (i64)0); };
                };
                switch (this.in_method)
                {
                    case (true)
                    {
                        // [value] becomes [this, value], the caller stores this back into the receiver
                        this.emit1(IDKVM_LOCAL_GET, (i64)0);
                        this.emit0(IDKVM_SWAP);
                    }
                    default {};
                };
                // a return exits every enclosing block: the pending defers run now, after the
                // return value is pushed and before RET consumes it
                this.flush_all_defers();
                switch (this.tail_self != (byte*)0)
                {
                    case (true) { this.emit1(IDKVM_TAIL_SELF, (i64)this.tail_argc); }
                    default { this.emit0(IDKVM_RET); };
                };
                -> false;
            };

            // IDKVMCodegen._visit_if
            visit_if(Node* n) -> bool
            {
                PtrVec* ends = pv_new();
                int j;
                int i;
                this.visit_expr(n.a);
                j = this.emit1(IDKVM_JNF, (i64)0);
                this.visit_body(n.b);
                pv_push(ends, (void*)(u64)(this.emit1(IDKVM_JMP, (i64)0) + 1));
                this.patch_at(j, IDKVM_JNF, this.ip());
                while (i < node_count(n, 0))
                {
                    this.visit_expr(node_child(n, 0, i));
                    j = this.emit1(IDKVM_JNF, (i64)0);
                    this.visit_body(node_child(n, 1, i));
                    pv_push(ends, (void*)(u64)(this.emit1(IDKVM_JMP, (i64)0) + 1));
                    this.patch_at(j, IDKVM_JNF, this.ip());
                    i++;
                };
                switch (n.c != (Node*)0)
                {
                    case (true) { this.visit_body(n.c); }
                    default {};
                };
                i = 0;
                while (i < ends.len)
                {
                    this.patch_at((int)(u64)ends.items[i] - 1, IDKVM_JMP, this.ip());
                    i++;
                };
                pv_free(ends);
                -> false;
            };

            // IDKVMCodegen._visit_while: body statements are visited directly (no defer scope)
            visit_while(Node* n) -> bool
            {
                int start = this.ip();
                int exit_patch;
                int i;
                int after;
                this.visit_expr(n.a);
                exit_patch = this.emit1(IDKVM_JNF, (i64)0);
                this.loop_push();
                switch (n.b != (Node*)0 & (n.b.kind == NodeKind.BLOCK))
                {
                    case (true)
                    {
                        while (i < node_count(n.b, 0))
                        {
                            this.visit_stmt(node_child(n.b, 0, i));
                            i++;
                        };
                    }
                    default { this.visit_stmt(n.b); };
                };
                this.emit1(IDKVM_JMP, (i64)start);
                after = this.ip();
                this.patch_at(exit_patch, IDKVM_JNF, after);
                this.loop_pop(after, start);
                -> false;
            };

            // IDKVMCodegen._visit_break
            visit_break(Node* n) -> bool
            {
                int idx = this.emit1(IDKVM_JMP, (i64)0);
                switch (this.brks.len > 0)
                {
                    case (true) { pv_push((PtrVec*)this.brks.items[this.brks.len - 1], (void*)(u64)(idx + 1)); }
                    default {};
                };
                -> false;
            };

            // IDKVMCodegen._visit_continue
            visit_continue(Node* n) -> bool
            {
                int idx = this.emit1(IDKVM_JMP, (i64)0);
                switch (this.conts.len > 0)
                {
                    case (true) { pv_push((PtrVec*)this.conts.items[this.conts.len - 1], (void*)(u64)(idx + 1)); }
                    default {};
                };
                -> false;
            };

            // IDKVMCodegen._visit_function_call: compiler.* builtins, then CALL or TAIL_SELF.
            // Function pointer variables and using-namespace resolution are not ported.
            // IDKVMCodegen._visit_function_call: compiler.* builtins, function pointer variables, then
            // CALL or TAIL_SELF
            visit_function_call(Node* n) -> bool
            {
                int op = idkvmcg_compiler_io(n.text);
                int argc = node_count(n, 0);
                int i;
                Node* arg;
                byte* rname = n.text;
                byte* tn;
                byte* q;
                FvmBuf b;
                i64* box;
                switch (op >= 0)
                {
                    case (true)
                    {
                        switch (op != IDKVM_COMPILER_INPUT)
                        {
                            case (true)
                            {
                                while (i < argc)
                                {
                                    this.visit_expr(node_child(n, 0, i));
                                    i++;
                                };
                            }
                            default {};
                        };
                        this.emit0(op);
                        -> op == IDKVM_COMPILER_INPUT | op == IDKVM_COMPILER_READFILE;
                    }
                    default {};
                };
                // function pointer call: the local holds a PTR to the slot that holds the name
                box = (i64*)nm_get(this.locals, n.text);
                tn = (byte*)nm_get(this.ltn, n.text);
                switch (box != (i64*)0 & tn != (byte*)0)
                {
                    case (true)
                    {
                        switch (idkvm_streq(tn, g"__funcptr__\0"))
                        {
                            case (true)
                            {
                                while (i < argc)
                                {
                                    this.visit_expr(node_child(n, 0, i));
                                    i++;
                                };
                                this.emit1(IDKVM_LOCAL_GET, *box);
                                this.emit0(IDKVM_LOCAL_DEREF);
                                this.emit1(IDKVM_CALL_PTR, (i64)argc);
                                -> true;
                            }
                            default {};
                        };
                    }
                    default {};
                };
                // an unqualified name known under an active using namespace takes the qualified name;
                // otherwise the bare name stays and the VM suffix match finds it at run time
                i = this.usings.len - 1;
                while (i >= 0)
                {
                    b.__init();
                    b.put_str((byte*)this.usings.items[i]);
                    b.put_str(g"__\0");
                    b.put_str(n.text);
                    b.put(0);
                    q = this.keep(b.mem);
                    b.__exit();
                    switch (this.fn_known(q))
                    {
                        case (true)
                        {
                            rname = q;
                            i = -1;
                        }
                        default { i--; };
                    };
                };
                i = 0;
                while (i < argc)
                {
                    arg = node_child(n, 0, i);
                    switch (arg.kind == NodeKind.IDENTIFIER)
                    {
                        case (true)
                        {
                            switch (nm_has(this.lvars, arg.text))
                            {
                                case (true)
                                {
                                    this.fail_name(arg, g"idkvmcodegen: local variable \0", arg.text, g" cannot escape scope (passed to function)\0");
                                    -> false;
                                }
                                default {};
                            };
                        }
                        default {};
                    };
                    this.visit_expr(arg);
                    i++;
                };
                switch (this.tail_self != (byte*)0)
                {
                    case (true)
                    {
                        switch (idkvm_streq(rname, this.tail_self))
                        {
                            case (true)
                            {
                                this.emit1(IDKVM_TAIL_SELF, (i64)argc);
                                -> true;
                            }
                            default {};
                        };
                    }
                    default {};
                };
                this.emit(IDKVM_CALL, (i64)argc, (i64)0, (i64)0, this.keep(rname));
                -> true;
            };

            // ----- .ivm dump: idkvm.py serialise_idkvm for the main block -----

            // idkvm.py _serialise_val of a PUSH operand
            dump_push(FvmBuf* o, int idx) -> void
            {
                int tag = (int)this.code.a[idx];
                i64 d = this.code.b[idx];
                byte* p;
                int k;
                int len;
                int ch;
                switch (tag == IDKVM_T_BYTES)
                {
                    case (true)
                    {
                        o.put_str(g"bytes:\"\0");
                        p = idkvm_i2p(d);
                        len = (int)this.code.c[idx];
                        while (k < len)
                        {
                            ch = (int)p[k];
                            switch (ch)
                            {
                                case (92) { o.put_str(g"\\\\\0"); }
                                case (34) { o.put_str(g"\\\"\0"); }
                                case (10) { o.put_str(g"\\n\0"); }
                                case (13) { o.put_str(g"\\r\0"); }
                                case (9) { o.put_str(g"\\t\0"); }
                                case (0) { o.put_str(g"\\0\0"); }
                                default { o.put(ch); };
                            };
                            k++;
                        };
                        o.put(34);
                        ->;
                    }
                    default {};
                };
                switch (tag == IDKVM_T_BOOL)
                {
                    case (true)
                    {
                        o.put_str(g"bool:\0");
                        switch (d != (i64)0)
                        {
                            case (true) { o.put_str(g"true\0"); }
                            default { o.put_str(g"false\0"); };
                        };
                        ->;
                    }
                    default {};
                };
                switch (tag == IDKVM_T_VOID)
                {
                    case (true) { o.put_str(g"void:0\0"); ->; }
                    default {};
                };
                switch (tag == IDKVM_T_FLOAT | tag == IDKVM_T_DOUBLE)
                {
                    case (true)
                    {
                        o.put_str(idkvm_ttag_name(tag));
                        o.put(58);
                        idkvm_put_double(o, idkvm_bits_dbl(d));
                        ->;
                    }
                    default {};
                };
                o.put_str(idkvm_ttag_name(tag));
                o.put(58);
                o.put_i64(d);
                ->;
            };

            // idkvm.py _serialise_instr
            // The .name of a TTag member (upper case) where idkvm_ttag_name is the .value
            put_upper(FvmBuf* o, byte* nm) -> void
            {
                int k;
                byte ch;
                while (nm[k] != 0)
                {
                    ch = nm[k];
                    switch (ch >= 'a' & ch <= 'z') { case (true) { ch = (byte)(ch - 32); } default {}; };
                    o.put((int)ch);
                    k++;
                };
                ->;
            };

            dump_instr(FvmBuf* o, int idx) -> void
            {
                int op = this.code.ops[idx];
                int k0;
                o.put_str(idkvm_op_name(op));
                switch (op)
                {
                    case (IDKVM_PUSH) { o.put(32); this.dump_push(o, idx); }
                    case (IDKVM_JMP) { o.put(32); o.put_i64(this.code.a[idx]); }
                    case (IDKVM_JIF) { o.put(32); o.put_i64(this.code.a[idx]); }
                    case (IDKVM_JNF) { o.put(32); o.put_i64(this.code.a[idx]); }
                    case (IDKVM_CALL_PTR) { o.put(32); o.put_i64(this.code.a[idx]); }
                    case (IDKVM_TAIL_SELF) { o.put(32); o.put_i64(this.code.a[idx]); }
                    case (IDKVM_LOCAL_GET) { o.put(32); o.put_i64(this.code.a[idx]); }
                    case (IDKVM_LOCAL_SET) { o.put(32); o.put_i64(this.code.a[idx]); }
                    case (IDKVM_GLOBAL_GET) { o.put(32); o.put_str(this.code.s[idx]); }
                    case (IDKVM_GLOBAL_SET) { o.put(32); o.put_str(this.code.s[idx]); }
                    case (IDKVM_STRUCT_NEW) { o.put(32); o.put_str(this.code.s[idx]); }
                    case (IDKVM_CALL)
                    {
                        o.put(32);
                        o.put_str(this.code.s[idx]);
                        o.put(32);
                        o.put_i64(this.code.a[idx]);
                    }
                    case (IDKVM_STRUCT_LOAD) { o.put(32); o.put_str(this.code.s[idx]); }
                    case (IDKVM_STRUCT_STORE) { o.put(32); o.put_str(this.code.s[idx]); }
                    case (IDKVM_SIZEOF) { o.put(32); o.put_str(this.code.s[idx]); }
                    case (IDKVM_ALIGNOF) { o.put(32); o.put_str(this.code.s[idx]); }
                    case (IDKVM_ENDIANOF) { o.put(32); o.put_str(this.code.s[idx]); }
                    case (IDKVM_ENUM_NEW) { o.put(32); o.put_str(this.code.s[idx]); }
                    case (IDKVM_EXTERN_DECL)
                    {
                        o.put(32);
                        o.put_str(this.code.s[idx]);
                        o.put(32);
                        this.put_upper(o, idkvm_ttag_name((int)this.code.a[idx]));
                        k0 = 0;
                        while ((i64)k0 < this.code.b[idx])
                        {
                            o.put(32);
                            this.put_upper(o, idkvm_ttag_name((int)(((i64*)idkvm_i2p(this.code.c[idx]))[k0])));
                            k0++;
                        };
                    }
                    case (IDKVM_LOAD)
                    {
                        o.put(32);
                        o.put_str(idkvm_ttag_name((int)this.code.a[idx]));
                        o.put(32);
                        o.put_i64(this.code.b[idx]);
                    }
                    case (IDKVM_STORE)
                    {
                        o.put(32);
                        o.put_str(idkvm_ttag_name((int)this.code.a[idx]));
                        o.put(32);
                        o.put_i64(this.code.b[idx]);
                    }
                    case (IDKVM_EMITIDEKA) { idkvm_put_emitideka(o, this.code.s[idx], (FvmVars*)idkvm_i2p(this.code.c[idx])); }
                    case (IDKVM_ARRAY_NEW)
                    {
                        o.put(32);
                        o.put_str(this.code.s[idx]);
                        o.put(32);
                        o.put_i64(this.code.a[idx]);
                    }
                    case (IDKVM_BITCAST)
                    {
                        o.put(32);
                        o.put_str(idkvm_ttag_name((int)this.code.a[idx]));
                        switch (this.code.s[idx] != (byte*)0)
                        {
                            case (true) { o.put(32); o.put_str(this.code.s[idx]); }
                            default {};
                        };
                    }
                    case (IDKVM_CAST)
                    {
                        o.put(32);
                        o.put_str(idkvm_ttag_name((int)this.code.a[idx]));
                        switch (this.code.s[idx] != (byte*)0)
                        {
                            case (true) { o.put(32); o.put_str(this.code.s[idx]); }
                            default {};
                        };
                    }
                    default {};
                };
                o.put(10);
                ->;
            };

            // The .ivm text of the compiled block. No struct layouts or functions are
            // emitted yet because struct_def and function_def are stubs.
            // The .ivm text of the compiled block: the functions first, then the main block.
            // No struct layouts are emitted.
            dump_idkvm(FvmBuf* o) -> void
            {
                int i = this.ubase;
                int f;
                int k;
                IDKVMCodegen* c;
                o.put_str(g"# Generated by compiler.idkvm.dump\n\n\0");
                while (f < this.fnames.len)
                {
                    c = (IDKVMCodegen*)this.fcgs.items[f];
                    o.put_str(g"func \0");
                    o.put_str((byte*)this.fnames.items[f]);
                    o.put(10);
                    k = c.ubase;
                    while (k < c.code.len)
                    {
                        o.put_str(g"    \0");
                        c.dump_instr(o, k);
                        k++;
                    };
                    o.put_str(g"endfunc\n\n\0");
                    f++;
                };
                switch (this.nlocals > 0)
                {
                    case (true)
                    {
                        o.put_str(g"locals \0");
                        o.put_int(this.nlocals);
                        o.put(10);
                    }
                    default {};
                };
                while (i < this.code.len)
                {
                    this.dump_instr(o, i);
                    i++;
                };
                ->;
            };

            // ----- stubs, one per IDKVMCodegen method of ivmcodegen.py -----

            // true when name is mang, or starts with mang followed by two underscores
            dep_matches(byte* name, byte* mang, int ml) -> bool
            {
                int i;
                int nl;
                switch (name == (byte*)0)
                {
                    case (true) { -> false; }
                    default {};
                };
                nl = idkvm_strlen(name);
                switch (nl < ml)
                {
                    case (true) { -> false; }
                    default {};
                };
                while (i < ml)
                {
                    switch (name[i] != mang[i])
                    {
                        case (true) { -> false; }
                        default {};
                    };
                    i++;
                };
                switch (nl == ml)
                {
                    case (true) { -> true; }
                    default {};
                };
                -> nl >= ml + 2 & name[ml] == '_' & name[ml + 1] == '_';
            };

            // The reference scan of IDKVMCodegen._visit_deprecate. A call also walks its arguments on
            // their own before the generic walk of every child, like the Python walk does.
            // Children are visited in field order a, b, c, d, e, then the lists.
            dep_walk(Node* n, byte* mang, int ml, FvmBuf* out, int* cnt) -> void
            {
                int i;
                int sl;
                switch (n == (Node*)0)
                {
                    case (true) { ->; }
                    default {};
                };
                switch (n.kind == NodeKind.IDENTIFIER)
                {
                    case (true)
                    {
                        switch (this.dep_matches(n.text, mang, ml))
                        {
                            case (true)
                            {
                                switch (*cnt > 0) { case (true) { out.put(10); } default {}; };
                                out.put_str(g"Identifier \0");
                                out.put_str(n.text);
                                *cnt = *cnt + 1;
                            }
                            default {};
                        };
                    }
                    default {};
                };
                switch (n.kind == NodeKind.FUNCTION_CALL)
                {
                    case (true)
                    {
                        switch (this.dep_matches(n.text, mang, ml))
                        {
                            case (true)
                            {
                                switch (*cnt > 0) { case (true) { out.put(10); } default {}; };
                                out.put_str(g"Function call \0");
                                out.put_str(n.text);
                                out.put_str(g"()\0");
                                *cnt = *cnt + 1;
                            }
                            default {};
                        };
                        i = 0;
                        while (i < node_count(n, 0))
                        {
                            this.dep_walk(node_child(n, 0, i), mang, ml, out, cnt);
                            i++;
                        };
                    }
                    default {};
                };
                this.dep_walk(n.a, mang, ml, out, cnt);
                this.dep_walk(n.b, mang, ml, out, cnt);
                this.dep_walk(n.c, mang, ml, out, cnt);
                this.dep_walk(n.d, mang, ml, out, cnt);
                this.dep_walk(n.e, mang, ml, out, cnt);
                sl = 0;
                while (sl < 6)
                {
                    i = 0;
                    while (i < node_count(n, sl))
                    {
                        this.dep_walk(node_child(n, sl, i), mang, ml, out, cnt);
                        i++;
                    };
                    sl++;
                };
                ->;
            };

            // IDKVMCodegen._visit_deprecate: emits nothing; any remaining reference to the namespace
            // in the program is an error listing each one
            visit_deprecate(Node* n) -> bool
            {
                FvmBuf mb;
                FvmBuf out;
                FvmBuf msg;
                int cnt;
                int i;
                int ml;
                byte* path = n.text;
                byte* mang;
                mb.__init();
                out.__init();
                msg.__init();
                i = 0;
                while (path != (byte*)0 & path[i] != 0)
                {
                    switch (path[i] == ':' & path[i + 1] == ':')
                    {
                        case (true) { mb.put(95); mb.put(95); i = i + 2; }
                        default { mb.put(path[i]); i++; };
                    };
                };
                mb.put(0);
                mang = mb.mem;
                ml = idkvm_strlen(mang);
                switch (this.pstmts != (NodeVec*)0)
                {
                    case (true)
                    {
                        i = 0;
                        while (i < this.pstmts.len)
                        {
                            this.dep_walk(this.pstmts.items[i], mang, ml, @out, @cnt);
                            i++;
                        };
                    }
                    default {};
                };
                switch (cnt > 0)
                {
                    case (true)
                    {
                        out.put(0);
                        msg.put_str(g"Deprecated namespace '\0");
                        msg.put_str(path);
                        msg.put_str(g"' is still referenced:\n\0");
                        msg.put_str(out.mem);
                        msg.put(0);
                        this.fail(n, msg.mem);
                    }
                    default {};
                };
                mb.__exit();
                out.__exit();
                msg.__exit();
                -> false;
            };

            // one error message from up to seven parts, null parts are skipped
            fail_pieces(Node* n, byte* a, byte* b, byte* c, byte* d, byte* e, byte* f, byte* g) -> void
            {
                FvmBuf m;
                m.__init();
                switch (a != (byte*)0) { case (true) { m.put_str(a); } default {}; };
                switch (b != (byte*)0) { case (true) { m.put_str(b); } default {}; };
                switch (c != (byte*)0) { case (true) { m.put_str(c); } default {}; };
                switch (d != (byte*)0) { case (true) { m.put_str(d); } default {}; };
                switch (e != (byte*)0) { case (true) { m.put_str(e); } default {}; };
                switch (f != (byte*)0) { case (true) { m.put_str(f); } default {}; };
                switch (g != (byte*)0) { case (true) { m.put_str(g); } default {}; };
                m.put(0);
                this.fail(n, m.mem);
                m.__exit();
                ->;
            };

            // "<a><1><b>", the key of the interface whitelists
            wl_key(byte* a, byte* b) -> byte*
            {
                FvmBuf k;
                byte* r;
                k.__init();
                k.put_str(a);
                k.put(1);
                k.put_str(b);
                k.put(0);
                r = this.keep(k.mem);
                k.__exit();
                -> r;
            };

            // the set of a whitelist pair, created empty when the pair is new
            wl_set(NameMap* wl, byte* a, byte* b) -> NameMap*
            {
                byte* key = this.wl_key(a, b);
                NameMap* st = (NameMap*)nm_get(wl, key);
                switch (st == (NameMap*)0)
                {
                    case (true)
                    {
                        st = nm_new();
                        pv_push(this.wsets, (void*)st);
                        nm_put(wl, key, (void*)st);
                    }
                    default {};
                };
                -> st;
            };

            // the set of a whitelist pair, null when the pair is not governed
            wl_get(NameMap* wl, byte* a, byte* b) -> NameMap*
            {
                byte* key = this.wl_key(a, b);
                -> (NameMap*)nm_get(wl, key);
            };

            // the ObjectDef named name among the comptime body and the program statements, the
            // last definition wins
            find_objdef(byte* name) -> Node*
            {
                Node* found = this.objdef_in(this.pstmts, name, (Node*)0);
                -> this.objdef_in(this.cbody, name, found);
            };

            // the last ObjectDef of a statement list that is named name, cur when there is none
            objdef_in(NodeVec* v, byte* name, Node* cur) -> Node*
            {
                int i;
                Node* st;
                Node* od;
                Node* found = cur;
                switch (v == (NodeVec*)0) { case (true) { -> cur; } default {}; };
                while (i < v.len)
                {
                    st = v.items[i];
                    od = (Node*)0;
                    switch (st != (Node*)0)
                    {
                        case (true)
                        {
                            switch (st.kind == NodeKind.OBJECT_DEF) { case (true) { od = st; } default {}; };
                            switch (st.kind == NodeKind.OBJECT_DEF_STATEMENT) { case (true) { od = st.a; } default {}; };
                        }
                        default {};
                    };
                    switch (od != (Node*)0)
                    {
                        case (true) { switch (idkvm_streq(od.text, name)) { case (true) { found = od; } default {}; }; }
                        default {};
                    };
                    i++;
                };
                -> found;
            };

            // an object has a method of this name
            obj_has_method(Node* od, byte* name) -> bool
            {
                int i;
                while (i < node_count(od, 1))
                {
                    switch (idkvm_streq(node_child(od, 1, i).text, name)) { case (true) { -> true; } default {}; };
                    i++;
                };
                -> false;
            };

            // a name is in the trait list of an object
            otr_has(byte* obj, byte* tname) -> bool
            {
                PtrVec* tl = (PtrVec*)nm_get(this.otr, obj);
                int i;
                switch (tl == (PtrVec*)0) { case (true) { -> false; } default {}; };
                while (i < tl.len)
                {
                    switch (idkvm_streq((byte*)tl.items[i], tname)) { case (true) { -> true; } default {}; };
                    i++;
                };
                -> false;
            };

            // The interface part of IDKVMCodegen._visit_object_def: for every interface attached to
            // the object, the trait constraints are checked and the three whitelists are built.
            // False after an error.
            object_interfaces(Node* n) -> bool
            {
                int ii;
                int k;
                int pi;
                int mi;
                Node* ia;
                Node* idef;
                Node* prm;
                Node* proto;
                Node* pr;
                Node* td;
                Node* target;
                NameMap* roles;
                NameMap* st;
                byte* concrete;
                byte* arg;
                FvmBuf ib;
                byte* c1;
                byte* c2;
                PtrVec* tl;
                int kind;
                bool ok = true;
                switch (n.e == (Node*)0) { case (true) { -> true; } default {}; };
                roles = nm_new();
                while (ii < node_count(n.e, 0) & ok)
                {
                    ia = node_child(n.e, 0, ii);
                    ii++;
                    idef = (Node*)nm_get(this.ifreg, ia.text);
                    switch (idef == (Node*)0) { case (true) { continue; } default {}; };
                    switch (node_count(ia, 0) != node_count(idef, 0)) { case (true) { continue; } default {}; };
                    nm_free(roles);
                    roles = nm_new();
                    k = 0;
                    while (k < node_count(idef, 0))
                    {
                        arg = node_child(ia, 0, k).text;
                        switch (idkvm_streq(arg, g"this\0")) { case (true) { arg = n.text; } default {}; };
                        nm_put(roles, node_child(idef, 0, k).text, (void*)arg);
                        k++;
                    };
                    pi = 0;
                    while (pi < node_count(idef, 0) & ok)
                    {
                        prm = node_child(idef, 0, pi);
                        pi++;
                        switch (prm.text2 == (byte*)0)
                        {
                            case (true)
                            {
                                this.fail_pieces(n, g"Interface \0", ia.text, g": parameter \0", prm.text, g" has no trait constraint -- all interface parameters must declare a trait\0", (byte*)0, (byte*)0);
                                ok = false;
                                continue;
                            }
                            default {};
                        };
                        concrete = (byte*)nm_get(roles, prm.text);
                        switch (concrete == (byte*)0) { case (true) { continue; } default {}; };
                        td = (Node*)nm_get(this.trreg, prm.text2);
                        switch (td == (Node*)0)
                        {
                            case (true)
                            {
                                this.fail_pieces(n, g"Trait \0", prm.text2, g" required by interface \0", ia.text, g" for role \0", prm.text, g" is not defined\0");
                                ok = false;
                                continue;
                            }
                            default {};
                        };
                        switch (idkvm_streq(concrete, n.text))
                        {
                            case (true) { target = n; }
                            default
                            {
                                target = this.find_objdef(concrete);
                                switch (target == (Node*)0)
                                {
                                    case (true)
                                    {
                                        this.fail_pieces(n, g"Interface \0", ia.text, g": role \0", prm.text, g" is bound to \0", concrete, g", which is not a known object\0");
                                        ok = false;
                                        continue;
                                    }
                                    default {};
                                };
                            };
                        };
                        k = 0;
                        while (k < node_count(td, 0) & ok)
                        {
                            proto = node_child(td, 0, k);
                            k++;
                            switch ((proto.flags `& NF_TEMPLATE) != 0) { case (true) { continue; } default {}; };
                            switch (!this.obj_has_method(target, proto.text))
                            {
                                case (true)
                                {
                                    ib.__init();
                                    ib.put_str(g" trait (required by interface \0");
                                    ib.put_str(ia.text);
                                    ib.put_str(g" for role \0");
                                    ib.put_str(prm.text);
                                    ib.put(41);
                                    ib.put(0);
                                    this.fail_pieces(n, g"Object \0", concrete, g" does not implement required function \0", proto.text, g" from \0", prm.text2, ib.mem);
                                    ib.__exit();
                                    ok = false;
                                }
                                default {};
                            };
                        };
                        switch (!ok) { case (true) { continue; } default {}; };
                        tl = (PtrVec*)nm_get(this.otr, concrete);
                        switch (tl == (PtrVec*)0)
                        {
                            case (true)
                            {
                                tl = pv_new();
                                pv_push(this.tlists, (void*)tl);
                                nm_put(this.otr, this.keep(concrete), (void*)tl);
                            }
                            default {};
                        };
                        switch (!this.otr_has(concrete, prm.text2)) { case (true) { pv_push(tl, (void*)this.keep(prm.text2)); } default {}; };
                    };
                    switch (!ok) { case (true) { continue; } default {}; };
                    pi = 0;
                    while (pi < node_count(idef, 1))
                    {
                        pr = node_child(idef, 1, pi);
                        pi++;
                        c1 = (byte*)nm_get(roles, pr.text);
                        c2 = (byte*)nm_get(roles, pr.text2);
                        switch (c1 == (byte*)0 | c2 == (byte*)0) { case (true) { continue; } default {}; };
                        kind = pr.op;
                        switch (kind == ProtocolKind.CALL_ON) { case (true) { this.wl_set(this.iwl, c1, c2); } default {}; };
                        switch (kind == ProtocolKind.PASS_INTO) { case (true) { this.wl_set(this.pwl, c1, c2); } default {}; };
                        switch (kind == ProtocolKind.RETURN_TO) { case (true) { this.wl_set(this.rwl, c1, c2); } default {}; };
                    };
                    pi = 0;
                    while (pi < node_count(idef, 1))
                    {
                        pr = node_child(idef, 1, pi);
                        pi++;
                        c1 = (byte*)nm_get(roles, pr.text);
                        c2 = (byte*)nm_get(roles, pr.text2);
                        switch (c1 == (byte*)0 | c2 == (byte*)0) { case (true) { continue; } default {}; };
                        kind = pr.op;
                        switch (kind == ProtocolKind.CALL_ON) { case (true) { st = this.wl_set(this.iwl, c1, c2); } default {}; };
                        switch (kind == ProtocolKind.PASS_INTO) { case (true) { st = this.wl_set(this.pwl, c1, c2); } default {}; };
                        switch (kind == ProtocolKind.RETURN_TO) { case (true) { st = this.wl_set(this.rwl, c1, c2); } default {}; };
                        mi = 0;
                        while (mi < node_count(pr, 0))
                        {
                            nm_put(st, this.keep(node_child(pr, 0, mi).text), (void*)n);
                            mi++;
                        };
                    };
                };
                nm_free(roles);
                -> ok;
            };

            // IDKVMCodegen._visit_object_def: the traits, a layout from the members packed without
            // padding, the interface checks, then every method with a body is compiled as
            // "Object.method". Slot 0 is 'this', the parameters follow, and a method that does not end
            // in a return gives 'this' back so the caller can store the mutated object.
            visit_object_def(Node* n) -> bool
            {
                int i;
                int fsz;
                int off;
                int np;
                int j;
                int total;
                byte* nm = this.keep(n.text);
                byte* key;
                Node* m;
                IDKVMCodegen* f;
                PtrVec* tl = pv_new();
                FvmBuf b;
                int last;
                pv_push(this.tlists, (void*)tl);
                while (i < node_count(n, 5))
                {
                    pv_push(tl, (void*)this.keep(node_child(n, 5, i).text));
                    i++;
                };
                nm_put(this.otr, nm, (void*)tl);
                i = 0;
                while (i < node_count(n, 0))
                {
                    m = node_child(n, 0, i);
                    i++;
                    switch (m.ts == (TypeSpec*)0) { case (true) { continue; } default {}; };
                    fsz = this.type_bit_width(m.ts) / 8;
                    switch (fsz < 1) { case (true) { fsz = 1; } default {}; };
                    total = total + fsz;
                };
                this.lay.add_struct(nm, this.keep(g"little\0"), total, 0);
                nm_put(this.ldirty, nm, (void*)nm);
                i = 0;
                while (i < node_count(n, 0))
                {
                    m = node_child(n, 0, i);
                    i++;
                    switch (m.ts == (TypeSpec*)0) { case (true) { continue; } default {}; };
                    fsz = this.type_bit_width(m.ts) / 8;
                    switch (fsz < 1) { case (true) { fsz = 1; } default {}; };
                    this.lay.add_field(this.keep(m.text), this.type_ttag_from_ts(m.ts), off, fsz);
                    off = off + fsz;
                };
                switch (!this.object_interfaces(n)) { case (true) { -> false; } default {}; };
                i = 0;
                while (i < node_count(n, 1))
                {
                    m = node_child(n, 1, i);
                    i++;
                    switch (m.a == (Node*)0) { case (true) { continue; } default {}; };
                    f = this.make_child();
                    nm_free(f.trreg);
                    nm_free(f.ifreg);
                    nm_free(f.iwl);
                    nm_free(f.pwl);
                    nm_free(f.rwl);
                    f.trreg = this.trreg;
                    f.ifreg = this.ifreg;
                    f.iwl = this.iwl;
                    f.pwl = this.pwl;
                    f.rwl = this.rwl;
                    f.shared_ifc = true;
                    f.cur_obj = nm;
                    f.in_method = true;
                    f.cbody = this.cbody;
                    j = 0;
                    while (j < this.otr.count)
                    {
                        nm_put(f.otr, (byte*)this.otr.keys[j], this.otr.vals[j]);
                        j++;
                    };
                    j = 0;
                    while (j < this.fnames.len)
                    {
                        f.cf_put((byte*)this.fnames.items[j], (IDKVMCodegen*)this.fcgs.items[j]);
                        j++;
                    };
                    f.alloc_local(g"this\0");
                    nm_put(f.ltn, g"this\0", (void*)nm);
                    np = node_count(m, 0);
                    j = 0;
                    while (j < np)
                    {
                        f.bind_param(node_child(m, 0, j));
                        j++;
                    };
                    f.visit_body(m.a);
                    last = f.last_op();
                    switch (last != IDKVM_RET & last != IDKVM_TAIL_SELF)
                    {
                        case (true)
                        {
                            f.emit1(IDKVM_LOCAL_GET, (i64)0);
                            f.emit_push(IDKVM_T_VOID, (i64)0);
                            f.emit0(IDKVM_RET);
                        }
                        default {};
                    };
                    f.code.unit_end(f.unit);
                    b.__init();
                    b.put_str(nm);
                    b.put('.');
                    b.put_str(m.text);
                    b.put(0);
                    key = this.keep(b.mem);
                    b.__exit();
                    this.cf_put(key, f);
                    this.cf_adopt(f);
                };
                -> false;
            };

            // IDKVMCodegen._visit_assert: JIF skips the failure block, a missing message is
            // "Assertion failed at [line:col]" and the failure block ends in PANIC
            visit_assert(Node* n) -> bool
            {
                int skip;
                byte* t;
                FvmBuf b;
                this.visit_expr(n.a);
                skip = this.emit1(IDKVM_JIF, (i64)0);
                switch (n.b != (Node*)0)
                {
                    case (true)
                    {
                        switch (n.b.kind == NodeKind.STRING_LITERAL)
                        {
                            case (true) { this.visit_string_literal(n.b); }
                            default { this.visit_expr(n.b); };
                        };
                    }
                    default
                    {
                        b.__init();
                        b.put_str(g"Assertion failed at [\0");
                        b.put_i64((i64)n.line);
                        b.put_str(g":\0");
                        b.put_i64((i64)n.col);
                        b.put_str(g"]\n\0");
                        b.put(0);
                        t = this.keep(b.mem);
                        b.__exit();
                        this.emit(IDKVM_PUSH, (i64)IDKVM_T_BYTES, idkvm_p2i(t), (i64)idkvm_strlen(t), (byte*)0);
                    };
                };
                this.emit0(IDKVM_PANIC);
                this.patch_at(skip, IDKVM_JIF, this.ip());
                -> false;
            };

            // IDKVMCodegen._visit_throw
            visit_throw(Node* n) -> bool
            {
                this.visit_expr(n.a);
                this.emit0(IDKVM_THROW);
                -> false;
            };

            // IDKVMCodegen._visit_try: TRY_BEGIN catch, body, TRY_END, JMP past; each catch binds the
            // thrown value (or pops it) and ends in a JMP to the common exit
            visit_try(Node* n) -> bool
            {
                int begin = this.emit1(IDKVM_TRY_BEGIN, (i64)0);
                int past;
                int i;
                int slot;
                int nc = node_count(n, 0);
                PtrVec* after = pv_new();
                Node* c;
                this.visit_body(n.a);
                this.emit0(IDKVM_TRY_END);
                past = this.emit1(IDKVM_JMP, (i64)0);
                this.patch_at(begin, IDKVM_TRY_BEGIN, this.ip());
                while (i < nc)
                {
                    c = node_child(n, 0, i);
                    switch (c.text != (byte*)0 & c.text[0] != 0)
                    {
                        case (true)
                        {
                            slot = this.alloc_local(c.text);
                            switch (c.ts != (TypeSpec*)0)
                            {
                                case (true)
                                {
                                    switch (c.ts.custom_typename != (byte*)0)
                                    {
                                        case (true) { nm_put(this.ltn, c.text, (void*)c.ts.custom_typename); }
                                        default {};
                                    };
                                }
                                default {};
                            };
                            this.emit1(IDKVM_LOCAL_SET, (i64)slot);
                        }
                        default { this.emit0(IDKVM_POP); };
                    };
                    this.visit_body(c.a);
                    pv_push(after, (void*)(u64)(this.emit1(IDKVM_JMP, (i64)0) + 1));
                    i++;
                };
                this.patch_at(past, IDKVM_JMP, this.ip());
                i = 0;
                while (i < after.len)
                {
                    this.patch_at((int)(u64)after.items[i] - 1, IDKVM_JMP, this.ip());
                    i++;
                };
                pv_free(after);
                -> false;
            };

            // IDKVMCodegen._visit_defer: the statement waits in the innermost defer scope
            visit_defer(Node* n) -> bool
            {
                switch (this.defers.len > 0)
                {
                    case (true) { pv_push((PtrVec*)this.defers.items[this.defers.len - 1], (void*)n); }
                    default {};
                };
                -> false;
            };

            // IDKVMCodegen._visit_type_decl: an alias records the name as a type, an initial value makes
            // it a variable
            visit_type_decl(Node* n) -> bool
            {
                TypeSpec* ts = n.ts;
                int slot;
                FvmBuf b;
                switch (ts != (TypeSpec*)0)
                {
                    case (true)
                    {
                        switch (ts.custom_typename != (byte*)0)
                        {
                            case (true) { nm_put(this.ltn, n.text, (void*)ts.custom_typename); }
                            default
                            {
                                switch (ts.base_type == DataType.DATA & ts.bit_width > 0)
                                {
                                    case (true)
                                    {
                                        b.__init();
                                        b.put_str(g"__data_\0");
                                        b.put_int(ts.bit_width);
                                        b.put(0);
                                        nm_put(this.ltn, n.text, (void*)this.keep(b.mem));
                                        b.__exit();
                                    }
                                    default { nm_put(this.ltn, n.text, (void*)datatype_text(ts.base_type)); };
                                };
                            };
                        };
                    }
                    default {};
                };
                switch (n.a != (Node*)0)
                {
                    case (true)
                    {
                        switch (n.a.kind != NodeKind.NO_INIT)
                        {
                            case (true)
                            {
                                slot = this.alloc_local(n.text);
                                this.visit_expr(n.a);
                                this.emit1(IDKVM_LOCAL_SET, (i64)slot);
                            }
                            default {};
                        };
                    }
                    default {};
                };
                -> false;
            };



            // IDKVMCodegen._visit_range_assignment: a counted loop of ARRAY_STORE over a plain identifier
            visit_range_assignment(Node* n) -> bool
            {
                int arr;
                int ctr;
                int st;
                int en;
                int fl;
                int cond;
                int jend;
                switch (n.ival != (i64)0)
                {
                    case (true)
                    {
                        this.fail(n, g"idkvmcodegen: range assignment from an array value is not supported in comptime\0");
                        -> false;
                    }
                    default {};
                };
                switch (n.a.kind != NodeKind.IDENTIFIER)
                {
                    case (true)
                    {
                        this.fail(n, g"idkvmcodegen: range assignment target must be a simple identifier in comptime\0");
                        -> false;
                    }
                    default {};
                };
                arr = this.alloc_local(n.a.text);
                ctr = this.alloc_local(this.fresh_tmp());
                st = this.alloc_local(this.fresh_tmp());
                en = this.alloc_local(this.fresh_tmp());
                fl = this.alloc_local(this.fresh_tmp());
                this.visit_expr(n.b);
                this.emit1(IDKVM_LOCAL_SET, (i64)st);
                this.visit_expr(n.c);
                this.emit1(IDKVM_LOCAL_SET, (i64)en);
                this.visit_expr(n.d);
                this.emit1(IDKVM_LOCAL_SET, (i64)fl);
                this.emit1(IDKVM_LOCAL_GET, (i64)st);
                this.emit1(IDKVM_LOCAL_SET, (i64)ctr);
                cond = this.ip();
                this.emit1(IDKVM_LOCAL_GET, (i64)ctr);
                this.emit1(IDKVM_LOCAL_GET, (i64)en);
                this.emit0(IDKVM_CMP_LE);
                jend = this.emit1(IDKVM_JNF, (i64)0);
                this.emit1(IDKVM_LOCAL_GET, (i64)arr);
                this.emit1(IDKVM_LOCAL_GET, (i64)ctr);
                this.emit1(IDKVM_LOCAL_GET, (i64)fl);
                this.emit0(IDKVM_ARRAY_STORE);
                this.emit1(IDKVM_LOCAL_SET, (i64)arr);
                this.emit1(IDKVM_LOCAL_GET, (i64)ctr);
                this.emit_push(IDKVM_T_INT, (i64)1);
                this.emit0(IDKVM_ADD);
                this.emit1(IDKVM_LOCAL_SET, (i64)ctr);
                this.emit1(IDKVM_JMP, (i64)cond);
                this.patch_at(jend, IDKVM_JNF, this.ip());
                -> false;
            };

            visit_compound_assign(Node* n) -> bool
            {
                Node* t = n.a;
                int slot;
                switch (t.kind != NodeKind.IDENTIFIER)
                {
                    case (true)
                    {
                        this.fail(n, g"idkvmcodegen: only simple identifier compound-assignment in comptime\0");
                        -> false;
                    }
                    default
                    {
                        this.check_const_assign(t.text, n, g" with compound assignment\0");
                        slot = this.alloc_local(t.text);
                        this.emit1(IDKVM_LOCAL_GET, (i64)slot);
                        this.visit_expr(n.b);
                        this.emit_compound_op(n.op, n);
                        this.cast_declared_float((TypeSpec*)nm_get(this.ltypes, t.text));
                        this.emit1(IDKVM_LOCAL_SET, (i64)slot);
                        -> false;
                    };
                };
            };



            // IDKVMCodegen._visit_string_literal
            visit_string_literal(Node* n) -> bool
            {
                byte* t = this.keep(n.text);
                this.cur_line = n.line;
                this.emit(IDKVM_PUSH, (i64)IDKVM_T_BYTES, idkvm_p2i(t), (i64)idkvm_strlen(t), (byte*)0);
                -> true;
            };

            // one part of an f-string: text as BYTES, an expression converted with INT_TO_STR
            fstring_part(Node* p, bool first, bool last) -> void
            {
                bool unbound;
                byte* s;
                int len;
                byte* kept;
                switch (p.kind == NodeKind.STRING_LITERAL)
                {
                    case (true)
                    {
                        s = p.text;
                        len = idkvm_strlen(s);
                        // the f" prefix and the closing quote are cut when the parser left them
                        switch (first & len >= 2)
                        {
                            case (true)
                            {
                                switch (s[0] == 'f' & s[1] == 34)
                                {
                                    case (true) { s = s + 2; len = len - 2; }
                                    default {};
                                };
                            }
                            default {};
                        };
                        switch (last & len >= 1)
                        {
                            case (true)
                            {
                                switch (s[len - 1] == 34) { case (true) { len--; } default {}; };
                            }
                            default {};
                        };
                        kept = idkvm_dup(s, len);
                        pv_push(this.owned, (void*)kept);
                        this.emit(IDKVM_PUSH, (i64)IDKVM_T_BYTES, idkvm_p2i(kept), (i64)len, (byte*)0);
                        ->;
                    }
                    default
                    {
                        unbound = false;
                        switch (p.kind == NodeKind.IDENTIFIER)
                        {
                            case (true) { unbound = !(nm_has(this.locals, p.text) | nm_has(this.bglobals, p.text) | nm_has(this.oglobals, p.text)); }
                            default {};
                        };
                        switch (unbound)
                        {
                            case (true)
                            {
                                // not in scope: the {name} placeholder
                                kept = idkvm_alloc(idkvm_strlen(p.text) + 3);
                                pv_push(this.owned, (void*)kept);
                                kept[0] = '{';
                                len = 0;
                                while (p.text[len] != 0) { kept[len + 1] = p.text[len]; len++; };
                                kept[len + 1] = '}';
                                kept[len + 2] = 0;
                                this.emit(IDKVM_PUSH, (i64)IDKVM_T_BYTES, idkvm_p2i(kept), (i64)(len + 2), (byte*)0);
                                ->;
                            }
                            default
                            {
                                this.visit_expr(p);
                                switch (p.kind != NodeKind.F_STRING_LITERAL & p.kind != NodeKind.STRING_LITERAL)
                                {
                                    case (true) { this.emit0(IDKVM_INT_TO_STR); }
                                    default {};
                                };
                                ->;
                            };
                        };
                    };
                };
            };

            // IDKVMCodegen._visit_fstring_literal: every part is pushed as BYTES and the parts are
            // joined pairwise with STR_CAT. An empty f-string pushes an empty BYTES value.
            // pushes an empty BYTES value
            push_empty_bytes() -> void
            {
                byte* kept = idkvm_dup(g"\0", 0);
                pv_push(this.owned, (void*)kept);
                this.emit(IDKVM_PUSH, (i64)IDKVM_T_BYTES, idkvm_p2i(kept), (i64)0, (byte*)0);
                ->;
            };

            // IDKVMCodegen._visit_fstring_literal: every part is pushed as BYTES and the parts are
            // joined pairwise with STR_CAT. ivmcodegen.py sees the f" prefix and the closing quote
            // as parts of their own when the string starts or ends with an expression, which
            // leaves an empty BYTES value at that end, so it is emitted here too.
            visit_fstring_literal(Node* n) -> bool
            {
                int c = node_count(n, 0);
                int i = 1;
                bool lead;
                bool trail;
                switch (c == 0)
                {
                    case (true)
                    {
                        this.push_empty_bytes();
                        -> true;
                    }
                    default
                    {
                        lead = node_child(n, 0, 0).kind != NodeKind.STRING_LITERAL;
                        trail = node_child(n, 0, c - 1).kind != NodeKind.STRING_LITERAL;
                        switch (lead)
                        {
                            case (true)
                            {
                                this.push_empty_bytes();
                                i = 0;
                            }
                            default { this.fstring_part(node_child(n, 0, 0), true, c == 1 & !trail); };
                        };
                        while (i < c)
                        {
                            this.fstring_part(node_child(n, 0, i), false, i == c - 1 & !trail);
                            this.emit0(IDKVM_STR_CAT);
                            i++;
                        };
                        switch (trail)
                        {
                            case (true)
                            {
                                this.push_empty_bytes();
                                this.emit0(IDKVM_STR_CAT);
                            }
                            default {};
                        };
                        -> true;
                    };
                };
            };

            // IDKVMCodegen._visit_array_literal: a string literal is a BYTES constant, any other array
            // is allocated on the VM heap and filled element by element
            visit_array_literal(Node* n) -> bool
            {
                byte* et = this.keep(g"int\0");
                int i;
                int slot;
                int dt;
                switch ((n.flags `& NF_IS_STRING) != 0 & n.text != (byte*)0)
                {
                    case (true) { -> this.visit_string_literal(n); }
                    default {};
                };
                switch (n.ts != (TypeSpec*)0)
                {
                    case (true)
                    {
                        dt = n.ts.base_type;
                        switch (dt)
                        {
                            case (DataType.SINT) { et = this.keep(g"int\0"); }
                            case (DataType.UINT) { et = this.keep(g"uint\0"); }
                            case (DataType.SLONG) { et = this.keep(g"long\0"); }
                            case (DataType.ULONG) { et = this.keep(g"ulong\0"); }
                            case (DataType.FLOAT) { et = this.keep(g"float\0"); }
                            case (DataType.DOUBLE) { et = this.keep(g"double\0"); }
                            case (DataType.BOOL) { et = this.keep(g"bool\0"); }
                            case (DataType.BYTE) { et = this.keep(g"byte\0"); }
                            case (DataType.CHAR) { et = this.keep(g"char\0"); }
                            default {};
                        };
                    }
                    default {};
                };
                this.emit(IDKVM_ARRAY_NEW, (i64)node_count(n, 0), (i64)0, (i64)0, et);
                slot = this.alloc_local(g"__arr_tmp__\0");
                this.emit1(IDKVM_LOCAL_SET, (i64)slot);
                while (i < node_count(n, 0))
                {
                    this.emit1(IDKVM_LOCAL_GET, (i64)slot);
                    this.emit_push(IDKVM_T_INT, (i64)i);
                    this.visit_expr(node_child(n, 0, i));
                    this.emit0(IDKVM_ARRAY_STORE);
                    this.emit1(IDKVM_LOCAL_SET, (i64)slot);
                    i++;
                };
                this.emit1(IDKVM_LOCAL_GET, (i64)slot);
                -> true;
            };


            // IDKVMCodegen._visit_stringify: $name pushes the string form of a local or global,
            // an unknown name pushes the name itself
            visit_stringify(Node* n) -> bool
            {
                byte* name = n.text;
                byte* kept;
                switch (nm_has(this.locals, name))
                {
                    case (true)
                    {
                        this.emit1(IDKVM_LOCAL_GET, (i64)this.alloc_local(name));
                        this.emit0(IDKVM_INT_TO_STR);
                        -> true;
                    }
                    default
                    {
                        switch (nm_has(this.bglobals, name) | nm_has(this.oglobals, name))
                        {
                            case (true)
                            {
                                this.emits(IDKVM_GLOBAL_GET, name);
                                this.emit0(IDKVM_INT_TO_STR);
                                -> true;
                            }
                            default
                            {
                                kept = this.keep(name);
                                this.emit(IDKVM_PUSH, (i64)IDKVM_T_BYTES, idkvm_p2i(kept), (i64)idkvm_strlen(kept), (byte*)0);
                                -> true;
                            };
                        };
                    };
                };
            };


            // one side of ++/-- on a struct field receiver: load or store the receiver variable
            // IDKVMCodegen._emit_var_get: outer globals, then the local slot, then the block global
            unary_recv_get(byte* var_name) -> void
            {
                i64* box;
                switch (nm_has(this.oglobals, var_name))
                {
                    case (true) { this.emits(IDKVM_GLOBAL_GET, var_name); ->; }
                    default {};
                };
                box = (i64*)nm_get(this.locals, var_name);
                switch (box != (i64*)0)
                {
                    case (true) { this.emit1(IDKVM_LOCAL_GET, *box); ->; }
                    default {};
                };
                switch (nm_has(this.bglobals, var_name))
                {
                    case (true) { this.emits(IDKVM_GLOBAL_GET, var_name); }
                    default { this.emit1(IDKVM_LOCAL_GET, (i64)this.alloc_local(var_name)); };
                };
                ->;
            };

            // IDKVMCodegen._visit_unary_op
            visit_unary_op(Node* n) -> bool
            {
                int op = n.op;
                int arith;
                int slot;
                int vm;
                bool post = (n.flags `& NF_POSTFIX) != 0;
                bool bg;
                byte* name;
                Node* o = n.a;
                switch (op == Operator.INCREMENT | op == Operator.DECREMENT)
                {
                    case (true)
                    {
                        arith = IDKVM_SUB;
                        switch (op == Operator.INCREMENT) { case (true) { arith = IDKVM_ADD; } default {}; };
                        switch (o.kind == NodeKind.MEMBER_ACCESS)
                        {
                            case (true)
                            {
                                switch (o.a.kind == NodeKind.IDENTIFIER)
                                {
                                    case (true)
                                    {
                                        // struct.field++ on a simple identifier receiver
                                        name = o.a.text;
                                        switch (post)
                                        {
                                            case (true)
                                            {
                                                this.unary_recv_get(name);
                                                this.emits(IDKVM_STRUCT_LOAD, o.text);
                                            }
                                            default {};
                                        };
                                        this.unary_recv_get(name);
                                        this.emits(IDKVM_STRUCT_LOAD, o.text);
                                        this.emit_push(IDKVM_T_INT, (i64)1);
                                        this.emit0(arith);
                                        switch (!post) { case (true) { this.emit0(IDKVM_DUP); } default {}; };
                                        this.unary_recv_get(name);
                                        this.emit0(IDKVM_SWAP);
                                        this.emits(IDKVM_STRUCT_STORE, o.text);
                                        this.write_back(name);
                                        -> true;
                                    }
                                    default {};
                                };
                            }
                            default {};
                        };
                        switch (o.kind != NodeKind.IDENTIFIER)
                        {
                            case (true)
                            {
                                this.fail(n, g"idkvmcodegen: ++/-- only on simple identifiers in comptime\0");
                                -> false;
                            }
                            default {};
                        };
                        name = o.text;
                        switch (nm_has(this.oglobals, name))
                        {
                            case (true)
                            {
                                this.emits(IDKVM_GLOBAL_GET, name);
                                this.emit_push(IDKVM_T_INT, (i64)1);
                                this.emit0(arith);
                                this.emit0(IDKVM_DUP);
                                this.emits(IDKVM_GLOBAL_SET, name);
                                -> true;
                            }
                            default {};
                        };
                        slot = this.alloc_local(name);
                        bg = nm_has(this.bglobals, name);
                        switch (post)
                        {
                            case (true)
                            {
                                this.emit1(IDKVM_LOCAL_GET, (i64)slot);
                                this.emit1(IDKVM_LOCAL_GET, (i64)slot);
                                this.emit_push(IDKVM_T_INT, (i64)1);
                                this.emit0(arith);
                                switch (bg) { case (true) { this.emit0(IDKVM_DUP); } default {}; };
                                this.emit1(IDKVM_LOCAL_SET, (i64)slot);
                                switch (bg) { case (true) { this.emits(IDKVM_GLOBAL_SET, name); } default {}; };
                            }
                            default
                            {
                                this.emit1(IDKVM_LOCAL_GET, (i64)slot);
                                this.emit_push(IDKVM_T_INT, (i64)1);
                                this.emit0(arith);
                                this.emit0(IDKVM_DUP);
                                this.emit1(IDKVM_LOCAL_SET, (i64)slot);
                                switch (bg) { case (true) { this.emits(IDKVM_GLOBAL_SET, name); } default {}; };
                            };
                        };
                        -> true;
                    }
                    default {};
                };
                this.visit_expr(o);
                vm = -1;
                switch (op)
                {
                    case (Operator.SUB) { vm = IDKVM_NEG; }
                    case (Operator.NOT) { vm = IDKVM_NOT; }
                    case (Operator.BITNOT) { vm = IDKVM_BNOT; }
                    case (Operator.BITXNOT) { vm = IDKVM_BNOT; }
                    default {};
                };
                switch (vm < 0)
                {
                    case (true)
                    {
                        this.fail(n, g"idkvmcodegen: unary operator not supported in comptime\0");
                        -> false;
                    }
                    default
                    {
                        this.emit0(vm);
                        -> true;
                    };
                };
            };

            // IDKVMCodegen._visit_type_func_call: receiver first (slot 0 of the callee), then the
            // arguments, then CALL
            visit_type_func_call(Node* n) -> bool
            {
                int argc = node_count(n, 0);
                int i;
                FvmBuf b;
                this.visit_expr(n.a);
                while (i < argc)
                {
                    this.visit_expr(node_child(n, 0, i));
                    i++;
                };
                b.__init();
                b.put_str(g"__typefunc__\0");
                b.put_str(n.text);
                b.put_str(g"__\0");
                b.put_str(n.text2);
                b.put(0);
                this.emit(IDKVM_CALL, (i64)(1 + argc), (i64)0, (i64)0, this.keep(b.mem));
                b.__exit();
                -> true;
            };

            // IDKVMCodegen._visit_sizeof: the bit width of a type or a variable as a ulong
            visit_sizeof(Node* n) -> bool
            {
                int bits = -1;
                TypeSpec* ts = n.ts;
                switch (ts != (TypeSpec*)0)
                {
                    case (true)
                    {
                        switch (ts.base_type == DataType.DATA & ts.bit_width > 0)
                        {
                            case (true) { bits = ts.bit_width; }
                            default
                            {
                                switch ((ts.flags `& TS_POINTER) != 0)
                                {
                                    case (true) { bits = 64; }
                                    default { bits = this.prim_bits(ts.base_type); };
                                };
                            };
                        };
                    }
                    default
                    {
                        switch (n.a != (Node*)0)
                        {
                            case (true)
                            {
                                switch (n.a.kind == NodeKind.IDENTIFIER)
                                {
                                    case (true) { bits = this.ident_bits(n.a.text); }
                                    default {};
                                };
                            }
                            default {};
                        };
                    };
                };
                switch (bits < 0) { case (true) { bits = 0; } default {}; };
                this.emit_push(IDKVM_T_ULONG, (i64)bits);
                -> true;
            };

            // bit width of a primitive DataType, -1 when it is none
            prim_bits(int dt) -> int
            {
                switch (dt)
                {
                    case (DataType.SINT) { -> 32; }
                    case (DataType.UINT) { -> 32; }
                    case (DataType.SLONG) { -> 64; }
                    case (DataType.ULONG) { -> 64; }
                    case (DataType.FLOAT) { -> 32; }
                    case (DataType.DOUBLE) { -> 64; }
                    case (DataType.BOOL) { -> 1; }
                    case (DataType.BYTE) { -> 8; }
                    case (DataType.CHAR) { -> 8; }
                    case (DataType.DATA) { -> 0; }
                    default { -> -1; };
                };
                -> -1;
            };

            // bit width of a named variable or type: heap variable, type spec, type name, struct layout
            ident_bits(byte* name) -> int
            {
                FvmHeapVar* hv = (FvmHeapVar*)nm_get(this.hvars, name);
                TypeSpec* ts;
                byte* tn;
                int li, bits;
                switch (hv != (FvmHeapVar*)0)
                {
                    case (true)
                    {
                        switch (hv.count > 0)
                        {
                            case (true) { -> hv.bytes * 8 * hv.count; }
                            default { -> hv.bytes * 8; };
                        };
                    }
                    default {};
                };
                ts = (TypeSpec*)nm_get(this.ltypes, name);
                switch (ts != (TypeSpec*)0) { case (true) { -> this.type_bit_width(ts); } default {}; };
                tn = (byte*)nm_get(this.ltn, name);
                switch (tn != (byte*)0)
                {
                    case (true)
                    {
                        switch (idkvm_starts_with(tn, g"__data_\0"))
                        {
                            case (true) { -> this.dec_of(tn + 7); }
                            default {};
                        };
                        bits = this.name_bits(tn);
                        switch (bits >= 0) { case (true) { -> bits; } default {}; };
                    }
                    default {};
                };
                li = this.lay.find(name);
                switch (li >= 0)
                {
                    case (true)
                    {
                        switch (this.lay.sbits[li] != 0) { case (true) { -> this.lay.sbits[li]; } default {}; };
                        -> this.lay.ssize[li] * 8;
                    }
                    default {};
                };
                -> -1;
            };

            // IDKVMCodegen._visit_alignof: the alignment in bytes as a uint
            visit_alignof(Node* n) -> bool
            {
                int align = -1;
                switch (n.ts != (TypeSpec*)0)
                {
                    case (true) { align = this.ts_align(n.ts); }
                    default
                    {
                        switch (n.a != (Node*)0)
                        {
                            case (true)
                            {
                                switch (n.a.kind == NodeKind.IDENTIFIER)
                                {
                                    case (true) { align = this.ident_align(n.a.text); }
                                    default {};
                                };
                            }
                            default {};
                        };
                    };
                };
                switch (align < 0) { case (true) { align = 1; } default {}; };
                this.emit_push(IDKVM_T_UINT, (i64)align);
                -> true;
            };

            // alignment of a type spec in bytes, -1 when unknown
            ts_align(TypeSpec* ts) -> int
            {
                int b;
                switch (ts.alignment >= 0) { case (true) { -> ts.alignment; } default {}; };
                switch (ts.base_type == DataType.DATA & ts.bit_width >= 0) { case (true) { -> (ts.bit_width + 7) / 8; } default {}; };
                switch ((ts.flags `& TS_POINTER) != 0) { case (true) { -> 8; } default {}; };
                b = this.prim_bits(ts.base_type);
                switch (b < 0) { case (true) { -> -1; } default {}; };
                switch (ts.base_type == DataType.DATA) { case (true) { -> -1; } default {}; };
                switch (b < 8) { case (true) { -> 1; } default {}; };
                -> b / 8;
            };

            ident_align(byte* name) -> int
            {
                FvmHeapVar* hv = (FvmHeapVar*)nm_get(this.hvars, name);
                TypeSpec* ts;
                byte* tn;
                int li, a, k, best, f, bits;
                switch (hv != (FvmHeapVar*)0) { case (true) { -> hv.bytes; } default {}; };
                ts = (TypeSpec*)nm_get(this.ltypes, name);
                switch (ts != (TypeSpec*)0)
                {
                    case (true)
                    {
                        a = this.ts_align(ts);
                        switch (a >= 0) { case (true) { -> a; } default {}; };
                    }
                    default {};
                };
                tn = (byte*)nm_get(this.ltn, name);
                switch (tn != (byte*)0)
                {
                    case (true)
                    {
                        switch (idkvm_starts_with(tn, g"__data_\0"))
                        {
                            case (true)
                            {
                                bits = this.dec_of(tn + 7);
                                -> (bits + 7) / 8;
                            }
                            default {};
                        };
                        bits = this.name_bits(tn);
                        switch (bits >= 8) { case (true) { -> bits / 8; } default {}; };
                        switch (bits == 1) { case (true) { -> 1; } default {}; };
                    }
                    default {};
                };
                li = this.lay.find(name);
                switch (li >= 0)
                {
                    case (true)
                    {
                        best = 1;
                        while (k < this.lay.scount[li])
                        {
                            f = this.lay.sfirst[li] + k;
                            switch (this.lay.fsize[f] > best) { case (true) { best = this.lay.fsize[f]; } default {}; };
                            k++;
                        };
                        -> best;
                    }
                    default {};
                };
                -> -1;
            };

            // IDKVMCodegen._visit_endianof: 0 little, 1 big
            visit_endianof(Node* n) -> bool
            {
                int endian = -1;
                TypeSpec* ts;
                byte* tn;
                switch (n.ts != (TypeSpec*)0)
                {
                    case (true) { endian = n.ts.endianness; }
                    default
                    {
                        switch (n.a != (Node*)0)
                        {
                            case (true)
                            {
                                switch (n.a.kind == NodeKind.IDENTIFIER)
                                {
                                    case (true)
                                    {
                                        ts = (TypeSpec*)nm_get(this.ltypes, n.a.text);
                                        switch (ts != (TypeSpec*)0)
                                        {
                                            case (true) { endian = ts.endianness; }
                                            default
                                            {
                                                tn = (byte*)nm_get(this.ltn, n.a.text);
                                                switch (tn != (byte*)0)
                                                {
                                                    case (true)
                                                    {
                                                        switch (tn[0] == 'b' & tn[1] == 'e') { case (true) { endian = 1; } default {}; };
                                                        switch (tn[0] == 'l' & tn[1] == 'e') { case (true) { endian = 0; } default {}; };
                                                    }
                                                    default {};
                                                };
                                            };
                                        };
                                    }
                                    default {};
                                };
                            }
                            default {};
                        };
                    };
                };
                switch (endian < 0) { case (true) { endian = 0; } default {}; };
                this.emit_push(IDKVM_T_INT, (i64)endian);
                -> true;
            };

            // IDKVMCodegen._visit_typeof: the kind constant of a type or an expression
            visit_typeof(Node* n) -> bool
            {
                int kind = 0;
                TypeSpec* ts;
                byte* tn;
                byte* name;
                switch (n.ts != (TypeSpec*)0)
                {
                    case (true) { kind = this.ts_kind(n.ts); }
                    default
                    {
                        switch (n.a != (Node*)0)
                        {
                            case (true)
                            {
                                switch (n.a.kind == NodeKind.IDENTIFIER)
                                {
                                    case (true)
                                    {
                                        name = n.a.text;
                                        kind = this.name_kind(name);
                                        switch (kind == 0)
                                        {
                                            case (true)
                                            {
                                                switch (this.lay.find(name) >= 0)
                                                {
                                                    case (true) { kind = 12; }
                                                    default
                                                    {
                                                        ts = (TypeSpec*)nm_get(this.ltypes, name);
                                                        switch (ts != (TypeSpec*)0)
                                                        {
                                                            case (true) { kind = this.ts_kind(ts); }
                                                            default
                                                            {
                                                                tn = (byte*)nm_get(this.ltn, name);
                                                                switch (tn != (byte*)0)
                                                                {
                                                                    case (true)
                                                                    {
                                                                        kind = this.name_kind(tn);
                                                                        switch (kind == 0 & this.lay.find(tn) >= 0) { case (true) { kind = 12; } default {}; };
                                                                    }
                                                                    default {};
                                                                };
                                                            };
                                                        };
                                                    };
                                                };
                                            }
                                            default {};
                                        };
                                    }
                                    default {};
                                };
                            }
                            default {};
                        };
                    };
                };
                this.emit_push(IDKVM_T_INT, (i64)kind);
                -> true;
            };

            // IDKVMCodegen._visit_in_expression: a counted loop over the array, the matches are or-ed
            visit_in_expression(Node* n) -> bool
            {
                int ns, arrs, rs, ix, ls, loop_start, exit_patch;
                this.visit_expr(n.a);
                ns = this.alloc_local(g"__in_needle__\0");
                this.emit1(IDKVM_LOCAL_SET, (i64)ns);
                this.visit_expr(n.b);
                arrs = this.alloc_local(g"__in_arr__\0");
                this.emit1(IDKVM_LOCAL_SET, (i64)arrs);
                rs = this.alloc_local(g"__in_result__\0");
                this.emit_push(IDKVM_T_BOOL, (i64)0);
                this.emit1(IDKVM_LOCAL_SET, (i64)rs);
                ix = this.alloc_local(g"__in_idx__\0");
                this.emit_push(IDKVM_T_INT, (i64)0);
                this.emit1(IDKVM_LOCAL_SET, (i64)ix);
                ls = this.alloc_local(g"__in_len__\0");
                this.emit1(IDKVM_LOCAL_GET, (i64)arrs);
                this.emit0(IDKVM_ARRAY_LEN);
                this.emit1(IDKVM_LOCAL_SET, (i64)ls);
                loop_start = this.ip();
                this.emit1(IDKVM_LOCAL_GET, (i64)ix);
                this.emit1(IDKVM_LOCAL_GET, (i64)ls);
                this.emit0(IDKVM_CMP_GE);
                exit_patch = this.emit1(IDKVM_JIF, (i64)0);
                this.emit1(IDKVM_LOCAL_GET, (i64)arrs);
                this.emit1(IDKVM_LOCAL_GET, (i64)ix);
                this.emit0(IDKVM_ARRAY_LOAD);
                this.emit1(IDKVM_LOCAL_GET, (i64)ns);
                this.emit0(IDKVM_CMP_EQ);
                this.emit1(IDKVM_LOCAL_GET, (i64)rs);
                this.emit0(IDKVM_BOR);
                this.emit1(IDKVM_LOCAL_SET, (i64)rs);
                this.emit1(IDKVM_LOCAL_GET, (i64)ix);
                this.emit_push(IDKVM_T_INT, (i64)1);
                this.emit0(IDKVM_ADD);
                this.emit1(IDKVM_LOCAL_SET, (i64)ix);
                this.emit1(IDKVM_JMP, (i64)loop_start);
                this.patch_at(exit_patch, IDKVM_JIF, this.ip());
                this.emit1(IDKVM_LOCAL_GET, (i64)rs);
                switch ((n.flags `& NF_NEGATED) != 0) { case (true) { this.emit0(IDKVM_NOT); } default {}; };
                -> true;
            };

            // IDKVMCodegen._visit_has_expression: 'subject has Trait' is a constant BOOL, resolved
            // from the static type of the subject (a local of an object type, or an object name)
            visit_has_expression(Node* n) -> bool
            {
                byte* tn = (byte*)0;
                PtrVec* tl;
                int i;
                bool hit;
                FvmBuf loc;
                switch (n.a.kind == NodeKind.IDENTIFIER)
                {
                    case (true)
                    {
                        tn = (byte*)nm_get(this.ltn, n.a.text);
                        switch (tn == (byte*)0 & nm_has(this.otr, n.a.text)) { case (true) { tn = n.a.text; } default {}; };
                    }
                    default {};
                };
                loc.__init();
                loc.put(91);
                loc.put_int(n.line);
                loc.put(58);
                loc.put_int(n.col);
                loc.put(93);
                loc.put(0);
                switch (tn == (byte*)0)
                {
                    case (true)
                    {
                        switch (n.a.kind == NodeKind.IDENTIFIER)
                        {
                            case (true) { this.fail_pieces(n, g"'has': cannot determine static type of subject '\0", n.a.text, g"' -- only object instances or object type names are supported \0", loc.mem, (byte*)0, (byte*)0, (byte*)0); }
                            default { this.fail_pieces(n, g"'has': cannot determine static type of subject '\0", node_kind_name(n.a.kind), g"' -- only object instances or object type names are supported \0", loc.mem, (byte*)0, (byte*)0, (byte*)0); };
                        };
                        loc.__exit();
                        -> false;
                    }
                    default {};
                };
                switch (!nm_has(this.trreg, n.text))
                {
                    case (true)
                    {
                        this.fail_pieces(n, g"'has': '\0", n.text, g"' is not a defined trait \0", loc.mem, (byte*)0, (byte*)0, (byte*)0);
                        loc.__exit();
                        -> false;
                    }
                    default {};
                };
                switch (!nm_has(this.otr, tn))
                {
                    case (true)
                    {
                        this.fail_pieces(n, g"'has': type '\0", tn, g"' is not an object type -- 'has' requires an object instance or object type name \0", loc.mem, (byte*)0, (byte*)0, (byte*)0);
                        loc.__exit();
                        -> false;
                    }
                    default {};
                };
                loc.__exit();
                tl = (PtrVec*)nm_get(this.otr, tn);
                hit = false;
                while (i < tl.len)
                {
                    switch (idkvm_streq((byte*)tl.items[i], n.text)) { case (true) { hit = true; } default {}; };
                    i++;
                };
                switch (hit)
                {
                    case (true) { this.emit_push(IDKVM_T_BOOL, (i64)1); }
                    default { this.emit_push(IDKVM_T_BOOL, (i64)0); };
                };
                -> true;
            };

            // IDKVMCodegen._visit_pointer_deref: *ptr, a function pointer yields its slot as a ulong
            visit_pointer_deref(Node* n) -> bool
            {
                byte* tn;
                i64* box;
                TypeSpec* dts;
                // a number, a bool or a char is never a pointer (fcodegen: Cannot dereference non-pointer type)
                switch (n.a.kind == NodeKind.LITERAL)
                {
                    case (true) { this.fail(n, g"Cannot dereference non-pointer type\0"); -> false; }
                    default {};
                };
                switch (n.a.kind == NodeKind.IDENTIFIER)
                {
                    case (true)
                    {
                        tn = (byte*)nm_get(this.ltn, n.a.text);
                        box = (i64*)nm_get(this.locals, n.a.text);
                        switch (tn != (byte*)0 & box != (i64*)0)
                        {
                            case (true)
                            {
                                switch (idkvm_streq(tn, g"__funcptr__\0"))
                                {
                                    case (true)
                                    {
                                        this.emit1(IDKVM_LOCAL_GET, *box);
                                        this.emit(IDKVM_CAST, (i64)IDKVM_T_ULONG, (i64)0, (i64)0, (byte*)0);
                                        -> true;
                                    }
                                    default {};
                                };
                            }
                            default {};
                        };
                    }
                    default {};
                };
                // a variable declared with a plain scalar type is never a pointer
                switch (n.a.kind == NodeKind.IDENTIFIER)
                {
                    case (true)
                    {
                        dts = (TypeSpec*)nm_get(this.ltypes, n.a.text);
                        switch (dts != (TypeSpec*)0)
                        {
                            case (true)
                            {
                                switch (dts.custom_typename == (byte*)0 & !this.ts_is_ptr(dts) & (dts.flags `& TS_ARRAY) == 0 & this.ts_is_scalar(dts))
                                {
                                    case (true) { this.fail(n, g"Cannot dereference non-pointer type\0"); -> false; }
                                    default {};
                                };
                            }
                            default {};
                        };
                    }
                    default {};
                };
                this.visit_expr(n.a);
                this.emit0(IDKVM_LOCAL_DEREF);
                -> true;
            };

            // true when the type spec is a number, a bool or a char
            ts_is_scalar(TypeSpec* ts) -> bool
            {
                int b = ts.base_type;
                -> b == DataType.SINT | b == DataType.UINT | b == DataType.SLONG | b == DataType.ULONG | b == DataType.FLOAT | b == DataType.DOUBLE | b == DataType.BOOL | b == DataType.BYTE | b == DataType.CHAR;
            };

            // IDKVMCodegen._visit_address_of: @x pushes a pointer to the variable's slot
            visit_address_of(Node* n) -> bool
            {
                Node* e = n.a;
                int k = e.kind;
                int tslot;
                byte* nm_t;
                byte* name;
                i64* box;
                TypeSpec* ts;
                bool ptr_type;
                byte* tn;
                FvmBuf b;
                switch (k == NodeKind.POINTER_DEREF)
                {
                    case (true) { this.visit_expr(e.a); -> true; }
                    default {};
                };
                switch (k == NodeKind.LITERAL | k == NodeKind.FUNCTION_CALL | k == NodeKind.STRING_LITERAL | k == NodeKind.F_STRING_LITERAL | k == NodeKind.ARRAY_LITERAL | k == NodeKind.MEMBER_ACCESS | k == NodeKind.ARRAY_ACCESS)
                {
                    case (true)
                    {
                        nm_t = this.fresh_tmp();
                        tslot = this.alloc_local(nm_t);
                        this.visit_expr(e);
                        this.emit1(IDKVM_LOCAL_SET, (i64)tslot);
                        this.emit_push(IDKVM_T_PTR, (i64)tslot);
                        -> true;
                    }
                    default {};
                };
                switch (k != NodeKind.IDENTIFIER)
                {
                    case (true)
                    {
                        this.fail(n, g"idkvmcodegen: address-of is unsupported on this expression in comptime\0");
                        -> false;
                    }
                    default {};
                };
                name = e.text;
                box = (i64*)nm_get(this.locals, name);
                switch (box != (i64*)0)
                {
                    case (true)
                    {
                        // a heap variable's slot holds the pointer to its storage, which is its address
                        switch (nm_has(this.hvars, name))
                        {
                            case (true) { this.emit1(IDKVM_LOCAL_GET, *box); -> true; }
                            default {};
                        };
                        ts = (TypeSpec*)nm_get(this.ltypes, name);
                        tn = (byte*)nm_get(this.ltn, name);
                        switch (ts != (TypeSpec*)0) { case (true) { ptr_type = this.ts_is_ptr(ts); } default {}; };
                        switch (tn != (byte*)0)
                        {
                            case (true) { ptr_type = ptr_type | this.alias_is_ptr(tn); }
                            default {};
                        };
                        switch (ptr_type)
                        {
                            case (true) { this.emit1(IDKVM_LOCAL_GET, *box); }
                            default { this.emit_push(IDKVM_T_PTR, *box); };
                        };
                        -> true;
                    }
                    default {};
                };
                b.__init();
                b.put_str(g"__fnaddr_\0");
                b.put_str(name);
                b.put_str(g"__\0");
                b.put(0);
                tslot = this.alloc_local(b.mem);
                b.__exit();
                this.emit(IDKVM_PUSH, (i64)IDKVM_T_BYTES, idkvm_p2i(this.keep(name)), (i64)idkvm_strlen(name), (byte*)0);
                this.emit1(IDKVM_LOCAL_SET, (i64)tslot);
                this.emit_push(IDKVM_T_PTR, (i64)tslot);
                -> true;
            };

            // IDKVMCodegen._visit_ternary_op: cond ? a : b
            visit_ternary_op(Node* n) -> bool
            {
                int jnf, jmp;
                this.visit_expr(n.a);
                jnf = this.emit1(IDKVM_JNF, (i64)0);
                this.visit_expr(n.b);
                jmp = this.emit1(IDKVM_JMP, (i64)0);
                this.patch_at(jnf, IDKVM_JNF, this.ip());
                this.visit_expr(n.c);
                this.patch_at(jmp, IDKVM_JMP, this.ip());
                -> true;
            };

            // IDKVMCodegen._visit_if_expression: value if (cond) else other, 0 without an else
            visit_if_expression(Node* n) -> bool
            {
                int jnf, jmp;
                this.visit_expr(n.b);
                jnf = this.emit1(IDKVM_JNF, (i64)0);
                this.visit_expr(n.a);
                jmp = this.emit1(IDKVM_JMP, (i64)0);
                this.patch_at(jnf, IDKVM_JNF, this.ip());
                switch (n.c != (Node*)0)
                {
                    case (true) { this.visit_expr(n.c); }
                    default { this.emit_push(IDKVM_T_INT, (i64)0); };
                };
                this.patch_at(jmp, IDKVM_JMP, this.ip());
                -> true;
            };

            visit_inline_asm(Node* n) -> bool
            {
                this.stub(n, g"IDKVMCodegen._visit_inline_asm (never ported: needs an assembler backend)\0");
                -> false;
            };

            // IDKVMCodegen._visit_cast: CAST to the TTag of the target type. A pointer cast to a struct
            // is tagged with the struct, a bit cast of a scalar becomes BITCAST.
            visit_cast(Node* n) -> bool
            {
                TypeSpec* ts = n.ts;
                int tt;
                int bits;
                this.visit_expr(n.a);
                switch (this.ts_is_ptr(ts))
                {
                    case (true) { tt = IDKVM_T_PTR; }
                    default
                    {
                        switch (ts.base_type)
                        {
                            case (DataType.SINT) { tt = IDKVM_T_INT; }
                            case (DataType.UINT) { tt = IDKVM_T_UINT; }
                            case (DataType.SLONG) { tt = IDKVM_T_LONG; }
                            case (DataType.ULONG) { tt = IDKVM_T_ULONG; }
                            case (DataType.FLOAT) { tt = IDKVM_T_FLOAT; }
                            case (DataType.DOUBLE) { tt = IDKVM_T_DOUBLE; }
                            case (DataType.BOOL) { tt = IDKVM_T_BOOL; }
                            case (DataType.BYTE) { tt = IDKVM_T_BYTE; }
                            case (DataType.CHAR) { tt = IDKVM_T_CHAR; }
                            case (DataType.DATA)
                            {
                                bits = ts.bit_width;
                                switch (bits <= 0) { case (true) { bits = 32; } default {}; };
                                switch (bits <= 32)
                                {
                                    case (true)
                                    {
                                        switch ((ts.flags `& TS_SIGNED) != 0)
                                        {
                                            case (true) { tt = IDKVM_T_INT; }
                                            default { tt = IDKVM_T_UINT; };
                                        };
                                    }
                                    default
                                    {
                                        switch ((ts.flags `& TS_SIGNED) != 0)
                                        {
                                            case (true) { tt = IDKVM_T_LONG; }
                                            default { tt = IDKVM_T_ULONG; };
                                        };
                                    };
                                };
                            }
                            default { tt = IDKVM_T_PTR; };
                        };
                    };
                };
                switch (tt == IDKVM_T_PTR & ts.pointer_depth >= 1 & ts.custom_typename != (byte*)0)
                {
                    case (true)
                    {
                        switch (this.lay.find(ts.custom_typename) >= 0)
                        {
                            case (true)
                            {
                                this.emit(IDKVM_CAST, (i64)tt, (i64)0, (i64)0, this.keep(ts.custom_typename));
                                -> true;
                            }
                            default {};
                        };
                    }
                    default {};
                };
                switch (n.ival != (i64)0 & tt != IDKVM_T_PTR)
                {
                    case (true) { this.emit(IDKVM_BITCAST, (i64)tt, (i64)0, (i64)0, (byte*)0); }
                    default { this.emit(IDKVM_CAST, (i64)tt, (i64)0, (i64)0, (byte*)0); };
                };
                -> true;
            };


            // IDKVMCodegen._visit_method_call: compiler.* builtins map to their opcodes.
            // Symbol table queries and object method calls are not ported yet.
            visit_method_call(Node* n) -> bool
            {
                byte* full = this.flatten_dotted_name(n);
                int op;
                int i;
                int argc = node_count(n, 0);
                if (full != (byte*)0)
                {
                    op = idkvmcg_compiler_io(full);
                    if (op >= 0)
                    {
                        if (op != IDKVM_COMPILER_INPUT)
                        {
                            while (i < argc)
                            {
                                this.visit_expr(node_child(n, 0, i));
                                i++;
                            };
                        };
                        this.cur_line = n.line;
                        this.emit0(op);
                        -> op == IDKVM_COMPILER_INPUT | op == IDKVM_COMPILER_READFILE;
                    };
                };
                switch (full == (byte*)0)
                {
                    case (true)
                    {
                        this.fail(n, g"idkvmcodegen: method call on complex receiver not supported in comptime\0");
                        -> false;
                    }
                    default {};
                };
                switch (idkvm_streq(full, g"compiler.symbol_table.lookup\0") | idkvm_streq(full, g"compiler.symbol_table.funcinfo\0"))
                {
                    case (true)
                    {
                        while (i < argc)
                        {
                            this.visit_expr(node_child(n, 0, i));
                            i++;
                        };
                        switch (idkvm_streq(full, g"compiler.symbol_table.lookup\0"))
                        {
                            case (true) { this.emit0(IDKVM_COMPILER_SYMTABLE_LOOKUP); }
                            default { this.emit0(IDKVM_COMPILER_SYMTABLE_FUNCINFO); };
                        };
                        -> true;
                    }
                    default {};
                };
                -> this.visit_receiver_call(n, full, argc);
            };

            // The interface enforcement of _visit_method_call for a call on a local of object type
            // tn. RETURN_TO comes first, a method that a RETURN_TO block permits is not blocked by
            // a CALL_ON block that does not list it. PASS_INTO then checks the arguments that are
            // method calls on locals. False after an error.
            check_interfaces(Node* n, byte* tn) -> bool
            {
                NameMap* st;
                NameMap* ps;
                bool rgov;
                bool rok;
                int i;
                Node* arg;
                byte* inner;
                switch (this.cur_obj != (byte*)0)
                {
                    case (true)
                    {
                        st = this.wl_get(this.rwl, tn, this.cur_obj);
                        rgov = st != (NameMap*)0;
                        rok = false;
                        switch (rgov) { case (true) { rok = nm_has(st, n.text); } default {}; };
                        switch (rgov & !rok)
                        {
                            case (true)
                            {
                                this.fail_pieces(n, g"Interface violation: \0", tn, g".\0", n.text, g" is not permitted to be called from inside \0", this.cur_obj, (byte*)0);
                                -> false;
                            }
                            default {};
                        };
                        switch (!rok)
                        {
                            case (true)
                            {
                                st = this.wl_get(this.iwl, this.cur_obj, tn);
                                switch (st != (NameMap*)0)
                                {
                                    case (true)
                                    {
                                        switch (!nm_has(st, n.text))
                                        {
                                            case (true)
                                            {
                                                this.fail_pieces(n, g"Interface violation: \0", this.cur_obj, g" is not permitted to call \0", n.text, g" from \0", tn, (byte*)0);
                                                -> false;
                                            }
                                            default {};
                                        };
                                    }
                                    default {};
                                };
                            }
                            default {};
                        };
                    }
                    default {};
                };
                while (i < node_count(n, 0))
                {
                    arg = node_child(n, 0, i);
                    i++;
                    switch (arg.kind == NodeKind.METHOD_CALL)
                    {
                        case (true)
                        {
                            switch (arg.a != (Node*)0)
                            {
                                case (true)
                                {
                                    switch (arg.a.kind == NodeKind.IDENTIFIER)
                                    {
                                        case (true)
                                        {
                                            inner = (byte*)nm_get(this.ltn, arg.a.text);
                                            switch (inner != (byte*)0)
                                            {
                                                case (true)
                                                {
                                                    ps = this.wl_get(this.pwl, inner, tn);
                                                    switch (ps != (NameMap*)0)
                                                    {
                                                        case (true)
                                                        {
                                                            switch (!nm_has(ps, arg.text))
                                                            {
                                                                case (true)
                                                                {
                                                                    this.fail_pieces(n, g"Interface violation: return value of \0", inner, g".\0", arg.text, g" is not permitted to be passed as an argument into \0", tn, (byte*)0);
                                                                    -> false;
                                                                }
                                                                default {};
                                                            };
                                                        }
                                                        default {};
                                                    };
                                                }
                                                default {};
                                            };
                                        }
                                        default {};
                                    };
                                }
                                default {};
                            };
                        }
                        default {};
                    };
                };
                -> true;
            };

            // The tail of _visit_method_call: receiver.method(args) on a local of a known object
            // type, a type function, or a plain call by the dotted name. The interface whitelists
            // (RETURN_TO, CALL_ON, PASS_INTO) are enforced here once the interface registries are
            // ported, they are empty until an interface definition has been compiled.
            visit_receiver_call(Node* n, byte* full, int argc) -> bool
            {
                byte* tn;
                byte* mk;
                byte* recv;
                FvmBuf b;
                int i;
                int slot;
                bool isobj;
                switch (n.a != (Node*)0)
                {
                    case (true)
                    {
                        switch (n.a.kind == NodeKind.IDENTIFIER)
                        {
                            case (true)
                            {
                                tn = (byte*)nm_get(this.ltn, n.a.text);
                                switch (tn != (byte*)0)
                                {
                                    case (true)
                                    {
                                        b.__init();
                                        b.put_str(tn);
                                        b.put('.');
                                        b.put_str(n.text);
                                        b.put(0);
                                        mk = this.keep(b.mem);
                                        b.__exit();
                                        isobj = this.lay.find(tn) >= 0 | this.fn_known(mk);
                                        switch (isobj)
                                        {
                                            case (true)
                                            {
                                                recv = n.a.text;
                                                switch (!this.check_interfaces(n, tn)) { case (true) { -> false; } default {}; };
                                                this.visit_expr(n.a);
                                                i = 0;
                                                while (i < argc)
                                                {
                                                    this.visit_expr(node_child(n, 0, i));
                                                    i++;
                                                };
                                                this.emit(IDKVM_CALL, (i64)(1 + argc), (i64)0, (i64)0, mk);
                                                slot = this.alloc_local(recv);
                                                this.emit0(IDKVM_SWAP);
                                                this.emit0(IDKVM_DUP);
                                                this.emit1(IDKVM_LOCAL_SET, (i64)slot);
                                                this.emit(IDKVM_GLOBAL_SET, (i64)0, (i64)0, (i64)0, this.keep(recv));
                                                -> true;
                                            }
                                            default {};
                                        };
                                        b.__init();
                                        b.put_str(g"__typefunc__\0");
                                        b.put_str(tn);
                                        b.put_str(g"__\0");
                                        b.put_str(n.text);
                                        b.put(0);
                                        mk = this.keep(b.mem);
                                        b.__exit();
                                        switch (this.fn_known(mk))
                                        {
                                            case (true)
                                            {
                                                this.visit_expr(n.a);
                                                i = 0;
                                                while (i < argc)
                                                {
                                                    this.visit_expr(node_child(n, 0, i));
                                                    i++;
                                                };
                                                this.emit(IDKVM_CALL, (i64)(1 + argc), (i64)0, (i64)0, mk);
                                                -> true;
                                            }
                                            default {};
                                        };
                                    }
                                    default {};
                                };
                            }
                            default {};
                        };
                    }
                    default {};
                };
                i = 0;
                while (i < argc)
                {
                    this.visit_expr(node_child(n, 0, i));
                    i++;
                };
                this.emit(IDKVM_CALL, (i64)argc, (i64)0, (i64)0, this.keep(full));
                -> true;
            };

            // IDKVMCodegen._visit_macro_call: the macro body is compiled once into the function
            // __macro__<name> and every call site, a recursive one included, calls it
            visit_macro_call(Node* n) -> bool
            {
                Node* md = (Node*)nm_get(this.macros, n.text);
                int argc = node_count(n, 0);
                int np, i;
                byte* key;
                FvmBuf b;
                IDKVMCodegen* f;
                bool have;
                switch (md == (Node*)0)
                {
                    case (true)
                    {
                        this.fail_name(n, g"idkvmcodegen: unknown expression macro \0", n.text, g"\0");
                        -> false;
                    }
                    default {};
                };
                np = node_count(md, 0);
                switch (argc != np)
                {
                    case (true)
                    {
                        b.__init();
                        b.put_str(g"idkvmcodegen: macro '\0");
                        b.put_str(n.text);
                        b.put_str(g"' expects \0");
                        b.put_int(np);
                        b.put_str(g" argument(s), got \0");
                        b.put_int(argc);
                        b.put(0);
                        this.fail(n, b.mem);
                        b.__exit();
                        -> false;
                    }
                    default {};
                };
                b.__init();
                b.put_str(g"__macro__\0");
                b.put_str(n.text);
                b.put(0);
                key = this.keep(b.mem);
                b.__exit();
                have = nm_get(this.mcomp, n.text) != (void*)0 | this.fn_known(key);
                switch (!have)
                {
                    case (true)
                    {
                        nm_put(this.mcomp, n.text, (void*)this);
                        f = this.make_child();
                        i = 0;
                        while (i < this.fnames.len)
                        {
                            f.known_add((byte*)this.fnames.items[i]);
                            i++;
                        };
                        i = 0;
                        while (i < np)
                        {
                            f.alloc_local(node_child(md, 0, i).text);
                            i++;
                        };
                        f.visit_expr(md.a);
                        f.emit0(IDKVM_RET);
                        f.code.unit_end(f.unit);
                        this.cf_put(key, f);
                        this.cf_adopt(f);
                        nm_put(this.mcomp, n.text, (void*)0);
                    }
                    default {};
                };
                i = 0;
                while (i < argc)
                {
                    this.visit_expr(node_child(n, 0, i));
                    i++;
                };
                this.emit(IDKVM_CALL, (i64)argc, (i64)0, (i64)0, key);
                -> true;
            };

            // IDKVMCodegen._visit_array_access: a heap array or a pointer to a struct is addressed
            // with typed loads, anything else is a VM array
            visit_array_access(Node* n) -> bool
            {
                FvmHeapVar* hv;
                i64* box;
                byte* tn;
                TypeSpec* ts;
                int li;
                int size;
                bool is_arr, is_ptr;
                switch (n.a.kind == NodeKind.IDENTIFIER)
                {
                    case (true)
                    {
                        hv = (FvmHeapVar*)nm_get(this.hvars, n.a.text);
                        box = (i64*)nm_get(this.locals, n.a.text);
                        switch (hv != (FvmHeapVar*)0)
                        {
                            case (true)
                            {
                                switch (hv.count > 0 & box != (i64*)0)
                                {
                                    case (true)
                                    {
                                        this.emit1(IDKVM_LOCAL_GET, *box);
                                        this.visit_expr(n.b);
                                        switch (hv.bytes > 1)
                                        {
                                            case (true)
                                            {
                                                this.emit_push(IDKVM_T_UINT, (i64)hv.bytes);
                                                this.emit0(IDKVM_MUL);
                                            }
                                            default {};
                                        };
                                        this.emit0(IDKVM_ADD);
                                        this.emit(IDKVM_LOAD, (i64)hv.ttag, (i64)hv.bytes, (i64)0, (byte*)0);
                                        -> true;
                                    }
                                    default {};
                                };
                            }
                            default {};
                        };
                        tn = (byte*)nm_get(this.ltn, n.a.text);
                        switch (tn != (byte*)0)
                        {
                            case (true)
                            {
                                li = this.lay.find(tn);
                                switch (li >= 0)
                                {
                                    case (true)
                                    {
                                        ts = (TypeSpec*)nm_get(this.ltypes, n.a.text);
                                        switch (ts != (TypeSpec*)0)
                                        {
                                            case (true)
                                            {
                                                is_arr = (ts.flags `& TS_ARRAY) != 0;
                                                is_ptr = (ts.flags `& TS_POINTER) != 0;
                                            }
                                            default {};
                                        };
                                        switch (!is_arr & is_ptr)
                                        {
                                            case (true)
                                            {
                                                size = this.lay.ssize[li];
                                                this.visit_expr(n.a);
                                                this.visit_expr(n.b);
                                                this.emit_push(IDKVM_T_UINT, (i64)size);
                                                this.emit0(IDKVM_MUL);
                                                this.emit0(IDKVM_ADD);
                                                this.emit(IDKVM_LOAD, (i64)IDKVM_T_STRUCT, (i64)size, (i64)0, this.keep(tn));
                                                -> true;
                                            }
                                            default {};
                                        };
                                    }
                                    default {};
                                };
                            }
                            default {};
                        };
                    }
                    default {};
                };
                this.visit_expr(n.a);
                this.visit_expr(n.b);
                this.emit0(IDKVM_ARRAY_LOAD);
                -> true;
            };

            // IDKVMCodegen._visit_bit_slice: value[start``end], MSB first. Constant bounds on a variable
            // with a known width fold to (v >> shift) & mask, anything else takes the byte window path.
            visit_bit_slice(Node* n) -> bool
            {
                TypeSpec* vts;
                bool is_le;
                int total_bits = -1;
                i64 s, e;
                int nbytes, num_bits, inner, byte_shift, total_shift;
                i64 mask;
                int vslot, sslot, eslot, ishift, nbslot, mslot;
                vts = (TypeSpec*)0;
                switch (n.a.kind == NodeKind.IDENTIFIER) { case (true) { vts = (TypeSpec*)nm_get(this.ltypes, n.a.text); } default {}; };
                switch (vts != (TypeSpec*)0)
                {
                    case (true)
                    {
                        is_le = vts.endianness == 0;
                        total_bits = this.type_bit_width(vts);
                    }
                    default {};
                };
                switch (this.const_int(n.b, @s) & this.const_int(n.c, @e) & total_bits >= 0)
                {
                    case (true)
                    {
                        nbytes = total_bits / 8;
                        num_bits = (int)(e - s) + 1;
                        mask = ((i64)1 << (i64)num_bits) - (i64)1;
                        this.visit_expr(n.a);
                        vslot = this.alloc_local(g"__bs_val__\0");
                        this.emit1(IDKVM_LOCAL_SET, (i64)vslot);
                        inner = 7 - (int)(e % (i64)8);
                        switch (is_le)
                        {
                            case (true) { byte_shift = (int)(s / (i64)8) * 8; }
                            default { byte_shift = (nbytes - 1 - (int)(s / (i64)8)) * 8; };
                        };
                        total_shift = byte_shift + inner;
                        this.emit1(IDKVM_LOCAL_GET, (i64)vslot);
                        switch (total_shift > 0)
                        {
                            case (true)
                            {
                                this.emit_push(IDKVM_T_INT, (i64)total_shift);
                                this.emit0(IDKVM_SHR);
                            }
                            default {};
                        };
                        this.emit_push(IDKVM_T_LONG, mask);
                        this.emit0(IDKVM_BAND);
                        -> true;
                    }
                    default {};
                };
                this.visit_expr(n.a);
                vslot = this.alloc_local(g"__bs_val__\0");
                this.emit1(IDKVM_LOCAL_SET, (i64)vslot);
                this.visit_expr(n.b);
                sslot = this.alloc_local(g"__bs_start__\0");
                this.emit1(IDKVM_LOCAL_SET, (i64)sslot);
                this.visit_expr(n.c);
                eslot = this.alloc_local(g"__bs_end__\0");
                this.emit1(IDKVM_LOCAL_SET, (i64)eslot);
                this.emit1(IDKVM_LOCAL_GET, (i64)eslot);
                this.emit_push(IDKVM_T_INT, (i64)8);
                this.emit0(IDKVM_MOD);
                this.emit_push(IDKVM_T_INT, (i64)7);
                this.emit0(IDKVM_SWAP);
                this.emit0(IDKVM_SUB);
                ishift = this.alloc_local(g"__bs_inner_shift__\0");
                this.emit1(IDKVM_LOCAL_SET, (i64)ishift);
                this.emit1(IDKVM_LOCAL_GET, (i64)eslot);
                this.emit1(IDKVM_LOCAL_GET, (i64)sslot);
                this.emit0(IDKVM_SUB);
                this.emit_push(IDKVM_T_INT, (i64)1);
                this.emit0(IDKVM_ADD);
                nbslot = this.alloc_local(g"__bs_nb__\0");
                this.emit1(IDKVM_LOCAL_SET, (i64)nbslot);
                this.emit_push(IDKVM_T_INT, (i64)1);
                this.emit1(IDKVM_LOCAL_GET, (i64)nbslot);
                this.emit0(IDKVM_SHL);
                this.emit_push(IDKVM_T_INT, (i64)1);
                this.emit0(IDKVM_SUB);
                mslot = this.alloc_local(g"__bs_mask__\0");
                this.emit1(IDKVM_LOCAL_SET, (i64)mslot);
                this.emit1(IDKVM_LOCAL_GET, (i64)vslot);
                this.emit1(IDKVM_LOCAL_GET, (i64)ishift);
                this.emit0(IDKVM_SHR);
                this.emit1(IDKVM_LOCAL_GET, (i64)mslot);
                this.emit0(IDKVM_BAND);
                -> true;
            };

            // IDKVMCodegen._visit_bit_index_access: value[`index], bit 0 is the MSB
            visit_bit_index_access(Node* n) -> bool
            {
                int total_bits = -1;
                TypeSpec* vts;
                i64 s, e, idx;
                int shift_amt, w, vslot, islot;
                switch (n.a.kind == NodeKind.IDENTIFIER)
                {
                    case (true)
                    {
                        vts = (TypeSpec*)nm_get(this.ltypes, n.a.text);
                        switch (vts != (TypeSpec*)0) { case (true) { total_bits = this.type_bit_width(vts); } default {}; };
                    }
                    default
                    {
                        switch (n.a.kind == NodeKind.BIT_SLICE)
                        {
                            case (true)
                            {
                                switch (this.const_int(n.a.b, @s) & this.const_int(n.a.c, @e))
                                {
                                    case (true) { total_bits = (int)(e - s) + 1; }
                                    default {};
                                };
                            }
                            default {};
                        };
                    };
                };
                switch (this.const_int(n.b, @idx) & total_bits >= 0)
                {
                    case (true)
                    {
                        shift_amt = total_bits - 1 - (int)idx;
                        this.visit_expr(n.a);
                        switch (shift_amt > 0)
                        {
                            case (true)
                            {
                                this.emit_push(IDKVM_T_INT, (i64)shift_amt);
                                this.emit0(IDKVM_SHR);
                            }
                            default {};
                        };
                        this.emit_push(IDKVM_T_INT, (i64)1);
                        this.emit0(IDKVM_BAND);
                        -> true;
                    }
                    default {};
                };
                w = 64;
                switch (total_bits >= 0) { case (true) { w = total_bits; } default {}; };
                this.visit_expr(n.a);
                vslot = this.alloc_local(g"__bia_val__\0");
                this.emit1(IDKVM_LOCAL_SET, (i64)vslot);
                this.visit_expr(n.b);
                islot = this.alloc_local(g"__bia_idx__\0");
                this.emit1(IDKVM_LOCAL_SET, (i64)islot);
                this.emit_push(IDKVM_T_INT, (i64)(w - 1));
                this.emit1(IDKVM_LOCAL_GET, (i64)islot);
                this.emit0(IDKVM_SUB);
                this.emit1(IDKVM_LOCAL_GET, (i64)vslot);
                this.emit0(IDKVM_SWAP);
                this.emit0(IDKVM_SHR);
                this.emit_push(IDKVM_T_INT, (i64)1);
                this.emit0(IDKVM_BAND);
                -> true;
            };

            // IDKVMCodegen._visit_array_slice: arr[start:end] with constant bounds, either direction
            visit_array_slice(Node* n) -> bool
            {
                i64 s, e;
                int count, step, src, out_i, aslot, rslot, eslot;
                switch (!(this.const_int(n.b, @s) & this.const_int(n.c, @e)))
                {
                    case (true)
                    {
                        this.fail(n, g"idkvmcodegen: array slice [start:end] requires compile-time constant indices in comptime\0");
                        -> false;
                    }
                    default {};
                };
                switch (e >= s)
                {
                    case (true) { count = (int)(e - s) + 1; step = 1; }
                    default { count = (int)(s - e) + 1; step = -1; };
                };
                this.visit_expr(n.a);
                aslot = this.alloc_local(g"__slice_arr__\0");
                this.emit1(IDKVM_LOCAL_SET, (i64)aslot);
                this.emit(IDKVM_ARRAY_NEW, (i64)count, (i64)0, (i64)0, this.keep(g"int\0"));
                rslot = this.alloc_local(g"__slice_result__\0");
                this.emit1(IDKVM_LOCAL_SET, (i64)rslot);
                src = (int)s;
                while (out_i < count)
                {
                    this.emit1(IDKVM_LOCAL_GET, (i64)aslot);
                    this.emit_push(IDKVM_T_INT, (i64)src);
                    this.emit0(IDKVM_ARRAY_LOAD);
                    eslot = this.numbered_slot(g"__slice_e\0", out_i, g"__\0");
                    this.emit1(IDKVM_LOCAL_SET, (i64)eslot);
                    this.emit1(IDKVM_LOCAL_GET, (i64)rslot);
                    this.emit_push(IDKVM_T_INT, (i64)out_i);
                    this.emit1(IDKVM_LOCAL_GET, (i64)eslot);
                    this.emit0(IDKVM_ARRAY_STORE);
                    this.emit1(IDKVM_LOCAL_SET, (i64)rslot);
                    src = src + step;
                    out_i++;
                };
                this.emit1(IDKVM_LOCAL_GET, (i64)rslot);
                -> true;
            };

            // IDKVMCodegen._visit_array_comprehension: [expr for var in iterable] over a constant range
            // or an array literal, unrolled
            visit_array_comprehension(Node* n) -> bool
            {
                Node* it = n.b;
                i64 s, e;
                int count, i, rslot, vslot, eslot;
                switch (it.kind == NodeKind.RANGE_EXPRESSION)
                {
                    case (true)
                    {
                        switch (!(this.const_int(it.a, @s) & this.const_int(it.b, @e)))
                        {
                            case (true)
                            {
                                this.fail(n, g"idkvmcodegen: array comprehension over range requires compile-time constant bounds\0");
                                -> false;
                            }
                            default {};
                        };
                        count = (int)(e - s) + 1;
                        switch (count <= 0)
                        {
                            case (true)
                            {
                                this.fail(n, g"idkvmcodegen: array comprehension range must have positive count\0");
                                -> false;
                            }
                            default {};
                        };
                    }
                    default
                    {
                        switch (it.kind == NodeKind.ARRAY_LITERAL)
                        {
                            case (true) { count = node_count(it, 0); }
                            default
                            {
                                this.fail(n, g"idkvmcodegen: array comprehension only supports range and array literal iterables\0");
                                -> false;
                            };
                        };
                    };
                };
                this.emit(IDKVM_ARRAY_NEW, (i64)count, (i64)0, (i64)0, this.keep(g"int\0"));
                rslot = this.alloc_local(g"__comp_result__\0");
                this.emit1(IDKVM_LOCAL_SET, (i64)rslot);
                vslot = this.alloc_local(n.text);
                while (i < count)
                {
                    switch (it.kind == NodeKind.RANGE_EXPRESSION)
                    {
                        case (true) { this.emit_push(IDKVM_T_INT, s + (i64)i); }
                        default { this.visit_expr(node_child(it, 0, i)); };
                    };
                    this.emit1(IDKVM_LOCAL_SET, (i64)vslot);
                    this.visit_expr(n.a);
                    eslot = this.numbered_slot(g"__comp_e\0", i, g"__\0");
                    this.emit1(IDKVM_LOCAL_SET, (i64)eslot);
                    this.emit1(IDKVM_LOCAL_GET, (i64)rslot);
                    this.emit_push(IDKVM_T_INT, (i64)i);
                    this.emit1(IDKVM_LOCAL_GET, (i64)eslot);
                    this.emit0(IDKVM_ARRAY_STORE);
                    this.emit1(IDKVM_LOCAL_SET, (i64)rslot);
                    i++;
                };
                this.emit1(IDKVM_LOCAL_GET, (i64)rslot);
                -> true;
            };

            // IDKVMCodegen._visit_range_expression: start..end as a two element array
            visit_range_expression(Node* n) -> bool
            {
                int rs = this.alloc_local(g"__range__\0");
                int ss;
                int es;
                this.emit(IDKVM_ARRAY_NEW, (i64)2, (i64)0, (i64)0, this.keep(g"int\0"));
                this.emit1(IDKVM_LOCAL_SET, (i64)rs);
                this.visit_expr(n.a);
                ss = this.alloc_local(g"__range_start__\0");
                this.emit1(IDKVM_LOCAL_SET, (i64)ss);
                this.visit_expr(n.b);
                es = this.alloc_local(g"__range_end__\0");
                this.emit1(IDKVM_LOCAL_SET, (i64)es);
                this.emit1(IDKVM_LOCAL_GET, (i64)rs);
                this.emit_push(IDKVM_T_INT, (i64)0);
                this.emit1(IDKVM_LOCAL_GET, (i64)ss);
                this.emit0(IDKVM_ARRAY_STORE);
                this.emit1(IDKVM_LOCAL_SET, (i64)rs);
                this.emit1(IDKVM_LOCAL_GET, (i64)rs);
                this.emit_push(IDKVM_T_INT, (i64)1);
                this.emit1(IDKVM_LOCAL_GET, (i64)es);
                this.emit0(IDKVM_ARRAY_STORE);
                this.emit1(IDKVM_LOCAL_SET, (i64)rs);
                this.emit1(IDKVM_LOCAL_GET, (i64)rs);
                -> true;
            };

            // IDKVMCodegen._visit_tie_expression: ~x reads the variable and zeroes it
            visit_tie_expression(Node* n) -> bool
            {
                i64* box;
                switch (n.a.kind != NodeKind.IDENTIFIER)
                {
                    case (true)
                    {
                        this.fail(n, g"idkvmcodegen: tie operator ~ can only be applied to variables\0");
                        -> false;
                    }
                    default {};
                };
                box = (i64*)nm_get(this.locals, n.a.text);
                switch (box == (i64*)0)
                {
                    case (true)
                    {
                        this.fail_name(n, g"idkvmcodegen: tie: unknown variable \0", n.a.text, g"\0");
                        -> false;
                    }
                    default
                    {
                        this.emit1(IDKVM_LOCAL_GET, *box);
                        this.emit_push(IDKVM_T_INT, (i64)0);
                        this.emit1(IDKVM_LOCAL_SET, *box);
                        -> true;
                    };
                };
            };

            // IDKVMCodegen._visit_variadic_access: not supported in comptime blocks
            visit_variadic_access(Node* n) -> bool
            {
                this.fail(n, g"idkvmcodegen: variadic access ...[N] is not supported in comptime blocks\0");
                -> false;
            };

            // IDKVMCodegen._visit_ternary_assign: target ?= value assigns only when the target is 0
            visit_ternary_assign(Node* n) -> bool
            {
                i64* box;
                int skip;
                switch (n.a.kind != NodeKind.IDENTIFIER)
                {
                    case (true)
                    {
                        this.fail(n, g"idkvmcodegen: TernaryAssign target must be an identifier\0");
                        -> false;
                    }
                    default {};
                };
                box = (i64*)nm_get(this.locals, n.a.text);
                switch (box == (i64*)0)
                {
                    case (true)
                    {
                        this.fail_name(n, g"idkvmcodegen: TernaryAssign: unknown variable \0", n.a.text, g"\0");
                        -> false;
                    }
                    default
                    {
                        this.emit1(IDKVM_LOCAL_GET, *box);
                        this.emit_push(IDKVM_T_INT, (i64)0);
                        this.emit0(IDKVM_CMP_EQ);
                        skip = this.emit1(IDKVM_JNF, (i64)0);
                        this.visit_expr(n.b);
                        this.emit1(IDKVM_LOCAL_SET, *box);
                        this.patch_at(skip, IDKVM_JNF, this.ip());
                        -> false;
                    };
                };
            };

            // IDKVMCodegen._visit_break_switch: jumps past the enclosing switch
            visit_break_switch(Node* n) -> bool
            {
                int idx = this.emit1(IDKVM_JMP, (i64)0);
                switch (this.brks.len > 0)
                {
                    case (true) { pv_push((PtrVec*)this.brks.items[this.brks.len - 1], (void*)(u64)(idx + 1)); }
                    default {};
                };
                -> false;
            };

            // IDKVMCodegen._visit_for_in: iterates an array
            visit_for_in(Node* n) -> bool
            {
                int it;
                int ln;
                int ix;
                int vs;
                int start;
                int exit_patch;
                int update_ip;
                int after;
                switch ((n.flags `& NF_BIT_ITER) != 0)
                {
                    case (true)
                    {
                        this.fail(n, g"idkvmcodegen: bit iteration is not supported in comptime\0");
                        -> false;
                    }
                    default {};
                };
                this.visit_expr(n.a);
                it = this.alloc_local(g"__forin_iter__\0");
                this.emit1(IDKVM_LOCAL_SET, (i64)it);
                this.emit1(IDKVM_LOCAL_GET, (i64)it);
                this.emit0(IDKVM_ARRAY_LEN);
                ln = this.alloc_local(g"__forin_len__\0");
                this.emit1(IDKVM_LOCAL_SET, (i64)ln);
                this.emit_push(IDKVM_T_INT, (i64)0);
                ix = this.alloc_local(g"__forin_idx__\0");
                this.emit1(IDKVM_LOCAL_SET, (i64)ix);
                vs = this.alloc_local(node_child(n, 0, 0).text);
                // the other variables take their slots too, only the first one is assigned
                ln = 1;
                while (ln < node_count(n, 0))
                {
                    this.alloc_local(node_child(n, 0, ln).text);
                    ln++;
                };
                ln = this.alloc_local(g"__forin_len__\0");
                start = this.ip();
                this.emit1(IDKVM_LOCAL_GET, (i64)ix);
                this.emit1(IDKVM_LOCAL_GET, (i64)ln);
                this.emit0(IDKVM_CMP_LT);
                exit_patch = this.emit1(IDKVM_JNF, (i64)0);
                this.loop_push();
                this.emit1(IDKVM_LOCAL_GET, (i64)it);
                this.emit1(IDKVM_LOCAL_GET, (i64)ix);
                this.emit0(IDKVM_ARRAY_LOAD);
                this.emit1(IDKVM_LOCAL_SET, (i64)vs);
                this.visit_stmts_direct(n.b);
                update_ip = this.ip();
                this.emit1(IDKVM_LOCAL_GET, (i64)ix);
                this.emit_push(IDKVM_T_INT, (i64)1);
                this.emit0(IDKVM_ADD);
                this.emit1(IDKVM_LOCAL_SET, (i64)ix);
                this.emit1(IDKVM_JMP, (i64)start);
                after = this.ip();
                this.patch_at(exit_patch, IDKVM_JNF, after);
                this.loop_pop(after, update_ip);
                -> false;
            };

            // IDKVMCodegen._visit_null_coalesce: left ?? right is left unless it is zero
            visit_null_coalesce(Node* n) -> bool
            {
                int ls;
                int rs;
                int rr;
                int jnf;
                int merge;
                int endj;
                this.visit_expr(n.a);
                ls = this.alloc_local(g"__nc_left__\0");
                this.emit1(IDKVM_LOCAL_SET, (i64)ls);
                this.emit1(IDKVM_LOCAL_GET, (i64)ls);
                jnf = this.emit1(IDKVM_JNF, (i64)0);
                this.visit_expr(n.b);
                rs = this.alloc_local(g"__nc_right__\0");
                this.emit1(IDKVM_LOCAL_SET, (i64)rs);
                merge = this.emit1(IDKVM_JMP, (i64)0);
                this.patch_at(jnf, IDKVM_JNF, this.ip());
                this.emit1(IDKVM_LOCAL_GET, (i64)ls);
                rr = this.alloc_local(g"__nc_result__\0");
                this.emit1(IDKVM_LOCAL_SET, (i64)rr);
                endj = this.emit1(IDKVM_JMP, (i64)0);
                this.patch_at(merge, IDKVM_JMP, this.ip());
                this.emit1(IDKVM_LOCAL_GET, (i64)rs);
                this.emit1(IDKVM_LOCAL_SET, (i64)rr);
                this.patch_at(endj, IDKVM_JMP, this.ip());
                this.emit1(IDKVM_LOCAL_GET, (i64)rr);
                -> true;
            };

            // IDKVMCodegen._visit_not_null: expr!? is 1 for a non-zero value
            visit_not_null(Node* n) -> bool
            {
                this.visit_expr(n.a);
                this.emit_push(IDKVM_T_INT, (i64)0);
                this.emit0(IDKVM_CMP_EQ);
                this.emit0(IDKVM_NOT);
                -> true;
            };


            // IDKVMCodegen._visit_fp_decl: the slot holds the pointer value, the name is typed __funcptr__
            visit_fp_decl(Node* n) -> bool
            {
                int slot = this.alloc_local(n.text);
                switch (n.a != (Node*)0)
                {
                    case (true) { this.visit_expr(n.a); }
                    default { this.emit_push(IDKVM_T_PTR, (i64)0); };
                };
                this.emit1(IDKVM_LOCAL_SET, (i64)slot);
                nm_put(this.ltn, n.text, (void*)g"__funcptr__\0");
                -> false;
            };

            // IDKVMCodegen._visit_fp_call: arguments, the pointer, a LOCAL_DEREF for a __funcptr__ name, CALL_PTR
            visit_fp_call(Node* n) -> bool
            {
                int i = 0;
                int argc = node_count(n, 0);
                byte* tn;
                while (i < argc)
                {
                    this.visit_expr(node_child(n, 0, i));
                    i++;
                };
                this.visit_expr(n.a);
                switch (n.a.kind == NodeKind.IDENTIFIER)
                {
                    case (true)
                    {
                        tn = (byte*)nm_get(this.ltn, n.a.text);
                        switch (tn != (byte*)0)
                        {
                            case (true)
                            {
                                switch (idkvm_streq(tn, g"__funcptr__\0")) { case (true) { this.emit0(IDKVM_LOCAL_DEREF); } default {}; };
                            }
                            default {};
                        };
                    }
                    default {};
                };
                this.emit1(IDKVM_CALL_PTR, (i64)argc);
                -> true;
            };

            // IDKVMCodegen._visit_fp_assignment: pb = @bar;
            visit_fp_assignment(Node* n) -> bool
            {
                i64* box = (i64*)nm_get(this.locals, n.text);
                switch (box == (i64*)0)
                {
                    case (true)
                    {
                        this.fail_name(n, g"idkvmcodegen: function pointer \0", n.text, g" not declared\0");
                        -> false;
                    }
                    default {};
                };
                this.visit_expr(n.a);
                this.emit1(IDKVM_LOCAL_SET, *box);
                -> false;
            };

            // the last emitted opcode of this body, -1 when nothing was emitted
            last_op() -> int
            {
                switch (this.code.len > this.ubase)
                {
                    case (true) { -> this.code.ops[this.code.len - 1]; }
                    default { -> -1; };
                };
            };

            // the end of a function body: a recursive function ends with TAIL_SELF, any other with
            // a void RET, unless the last instruction already is one
            end_function_body(bool recursive, int argc) -> void
            {
                int last = this.last_op();
                switch (recursive)
                {
                    case (true)
                    {
                        switch (last != IDKVM_TAIL_SELF & last != IDKVM_RET)
                        {
                            case (true) { this.emit1(IDKVM_TAIL_SELF, (i64)argc); }
                            default {};
                        };
                    }
                    default
                    {
                        switch (last != IDKVM_RET)
                        {
                            case (true)
                            {
                                this.emit_push(IDKVM_T_VOID, (i64)0);
                                this.emit0(IDKVM_RET);
                            }
                            default {};
                        };
                    };
                };
                this.code.unit_end(this.unit);
                ->;
            };

            // IDKVMCodegen._visit_function_def: the bytecode of a comptime function. The parameters
            // are loaded into the local slots 0..N-1 by the VM call.
            visit_function_def(Node* n) -> bool
            {
                IDKVMCodegen* f = this.make_child();
                int np = node_count(n, 0);
                int i;
                bool rec = (n.flags `& NF_RECURSIVE) != 0;
                while (i < np)
                {
                    f.bind_param(node_child(n, 0, i));
                    i++;
                };
                switch (rec)
                {
                    case (true)
                    {
                        f.tail_self = this.keep(n.text);
                        f.tail_argc = np;
                    }
                    default {};
                };
                switch ((n.flags `& NF_PROTOTYPE) != 0 | n.a == (Node*)0)
                {
                    case (true) { -> false; }
                    default
                    {
                        f.visit_body(n.a);
                        f.end_function_body(rec, np);
                        this.cf_adopt(f);
                        this.cf_put(n.text, f);
                        -> false;
                    };
                };
            };

            // IDKVMCodegen._visit_type_func_def: registered under __typefunc__<type>__<name>; the
            // implicit receiver '_' takes slot 0
            visit_type_func_def(Node* n) -> bool
            {
                IDKVMCodegen* f = this.make_child();
                int np = node_count(n, 0);
                int i;
                FvmBuf b;
                f.alloc_local(g"_\0");
                while (i < np)
                {
                    f.bind_param(node_child(n, 0, i));
                    i++;
                };
                f.visit_body(n.a);
                f.end_function_body(false, np);
                this.cf_adopt(f);
                b.__init();
                b.put_str(g"__typefunc__\0");
                b.put_str(n.text);
                b.put_str(g"__\0");
                b.put_str(n.text2);
                b.put(0);
                this.cf_put(b.mem, f);
                b.__exit();
                -> false;
            };

            // IDKVMCodegen._visit_struct_def
            visit_struct_def(Node* n) -> bool
            {
                this.struct_def_prefixed(n, (byte*)0);
                -> false;
            };

            // IDKVMCodegen._visit_struct_instance: STRUCT_NEW, then a store per field
            visit_struct_instance(Node* n) -> bool
            {
                int i, slot;
                this.emits(IDKVM_STRUCT_NEW, n.text);
                slot = this.alloc_local(g"__struct_tmp__\0");
                this.emit1(IDKVM_LOCAL_SET, (i64)slot);
                while (i < node_count(n, 0))
                {
                    this.emit1(IDKVM_LOCAL_GET, (i64)slot);
                    this.visit_expr(node_child(n, 1, i));
                    this.emits(IDKVM_STRUCT_STORE, node_child(n, 0, i).text);
                    this.emit1(IDKVM_LOCAL_SET, (i64)slot);
                    i++;
                };
                this.emit1(IDKVM_LOCAL_GET, (i64)slot);
                -> true;
            };

            // IDKVMCodegen._visit_struct_literal: named fields, then positional values in layout order
            visit_struct_literal(Node* n) -> bool
            {
                int i, slot, li, f;
                switch (n.text == (byte*)0)
                {
                    case (true)
                    {
                        this.fail(n, g"idkvmcodegen: StructLiteral has no struct_type in comptime\0");
                        -> false;
                    }
                    default {};
                };
                this.emits(IDKVM_STRUCT_NEW, n.text);
                slot = this.alloc_local(g"__struct_lit_tmp__\0");
                this.emit1(IDKVM_LOCAL_SET, (i64)slot);
                while (i < node_count(n, 0))
                {
                    this.emit1(IDKVM_LOCAL_GET, (i64)slot);
                    this.visit_expr(node_child(n, 1, i));
                    this.emits(IDKVM_STRUCT_STORE, node_child(n, 0, i).text);
                    this.emit1(IDKVM_LOCAL_SET, (i64)slot);
                    i++;
                };
                switch (node_count(n, 2) > 0)
                {
                    case (true)
                    {
                        li = this.lay.find(n.text);
                        switch (li >= 0)
                        {
                            case (true)
                            {
                                i = 0;
                                while (i < this.lay.scount[li] & i < node_count(n, 2))
                                {
                                    f = this.lay.sfirst[li] + i;
                                    this.emit1(IDKVM_LOCAL_GET, (i64)slot);
                                    this.visit_expr(node_child(n, 2, i));
                                    this.emits(IDKVM_STRUCT_STORE, this.lay.fname[f]);
                                    this.emit1(IDKVM_LOCAL_SET, (i64)slot);
                                    i++;
                                };
                            }
                            default {};
                        };
                    }
                    default {};
                };
                this.emit1(IDKVM_LOCAL_GET, (i64)slot);
                -> true;
            };

            // IDKVMCodegen._visit_struct_recast: T t from src, every field is cut out of the source
            // integer by shifting and masking, the source name is invalidated unless suppressed
            visit_struct_recast(Node* n) -> bool
            {
                int li, k, f, fb, bit_cursor, src_slot, tslot;
                i64* box;
                i64 mask;
                int ft;
                li = this.lay.find(n.text);
                switch (li < 0)
                {
                    case (true)
                    {
                        this.fail_name(n, g"idkvmcodegen: StructRecast: unknown struct type '\0", n.text, g"'\0");
                        -> false;
                    }
                    default {};
                };
                switch (n.a.kind != NodeKind.IDENTIFIER)
                {
                    case (true)
                    {
                        this.fail(n, g"idkvmcodegen: StructRecast source must be a simple identifier in comptime\0");
                        -> false;
                    }
                    default {};
                };
                box = (i64*)nm_get(this.locals, n.a.text);
                switch (box == (i64*)0)
                {
                    case (true)
                    {
                        this.fail_name(n, g"idkvmcodegen: StructRecast: source '\0", n.a.text, g"' not found in locals\0");
                        -> false;
                    }
                    default {};
                };
                src_slot = (int)*box;
                this.emits(IDKVM_STRUCT_NEW, n.text);
                tslot = this.alloc_local(g"__recast_tmp__\0");
                this.emit1(IDKVM_LOCAL_SET, (i64)tslot);
                k = 0;
                while (k < this.lay.scount[li])
                {
                    f = this.lay.sfirst[li] + k;
                    ft = this.lay.ftag[f];
                    fb = this.recast_bits(ft, this.lay.fsize[f]);
                    mask = ((i64)1 << (i64)fb) - (i64)1;
                    this.emit1(IDKVM_LOCAL_GET, (i64)src_slot);
                    switch (bit_cursor != 0)
                    {
                        case (true)
                        {
                            this.emit_push(IDKVM_T_INT, (i64)bit_cursor);
                            this.emit0(IDKVM_SHR);
                        }
                        default {};
                    };
                    this.emit_push(IDKVM_T_LONG, mask);
                    this.emit0(IDKVM_BAND);
                    this.emit(IDKVM_CAST, (i64)ft, (i64)0, (i64)0, (byte*)0);
                    this.emit1(IDKVM_LOCAL_GET, (i64)tslot);
                    this.emit0(IDKVM_SWAP);
                    this.emits(IDKVM_STRUCT_STORE, this.lay.fname[f]);
                    this.emit1(IDKVM_LOCAL_SET, (i64)tslot);
                    bit_cursor = bit_cursor + fb;
                    k++;
                };
                this.emit1(IDKVM_LOCAL_GET, (i64)tslot);
                switch (n.ival == (i64)0)
                {
                    case (true)
                    {
                        nm_del(this.locals, n.a.text);
                        nm_del(this.ltn, n.a.text);
                    }
                    default {};
                };
                -> true;
            };

            // bits a field of tag ft occupies in a recast: the precise width of a scalar,
            // otherwise its byte size times 8
            recast_bits(int ft, int fsize) -> int
            {
                switch (ft)
                {
                    case (IDKVM_T_BOOL) { -> 1; }
                    case (IDKVM_T_BYTE) { -> 8; }
                    case (IDKVM_T_CHAR) { -> 8; }
                    case (IDKVM_T_INT) { -> 32; }
                    case (IDKVM_T_UINT) { -> 32; }
                    case (IDKVM_T_LONG) { -> 64; }
                    case (IDKVM_T_ULONG) { -> 64; }
                    case (IDKVM_T_FLOAT) { -> 32; }
                    case (IDKVM_T_DOUBLE) { -> 64; }
                    default { -> fsize * 8; };
                };
                -> fsize * 8;
            };

            // IDKVMCodegen._visit_member_access: compiler.* properties, enum values, struct fields.
            // A name that is no variable is a namespace prefix and pushes nothing.
            visit_member_access(Node* n) -> bool
            {
                byte* dotted = this.flatten_dotted_name(n);
                byte* tn;
                byte* prop;
                byte* vn;
                bool produced;
                Node* ed;
                int ei;
                switch (dotted != (byte*)0)
                {
                    case (true)
                    {
                        prop = idkvmcg_target_prop(dotted);
                        switch (prop != (byte*)0)
                        {
                            case (true) { this.emits(IDKVM_COMPILER_TARGET_GET, this.keep(prop)); -> true; }
                            default {};
                        };
                        switch (idkvm_streq(dotted, g"compiler.symbol_table\0"))
                        {
                            case (true) { this.emit0(IDKVM_COMPILER_SYMTABLE); -> true; }
                            default {};
                        };
                        prop = idkvmcg_symtab_filter(dotted);
                        switch (prop != (byte*)0)
                        {
                            case (true) { this.emits(IDKVM_COMPILER_SYMTABLE_FILTERED, this.keep(prop)); -> true; }
                            default {};
                        };
                    }
                    default {};
                };
                switch (n.a.kind == NodeKind.IDENTIFIER)
                {
                    case (true)
                    {
                        vn = n.a.text;
                        tn = (byte*)nm_get(this.ltn, vn);
                        switch (nm_has(this.locals, vn))
                        {
                            case (true)
                            {
                                switch (tn != (byte*)0)
                                {
                                    case (true)
                                    {
                                        switch (nm_has(this.enums, tn))
                                        {
                                            case (true)
                                            {
                                                this.visit_expr(n.a);
                                                this.emit0(IDKVM_ENUM_LOAD);
                                                -> true;
                                            }
                                            default {};
                                        };
                                    }
                                    default {};
                                };
                                this.visit_expr(n.a);
                                this.emits(IDKVM_STRUCT_LOAD, n.text);
                                -> true;
                            }
                            default {};
                        };
                        switch (nm_has(this.bglobals, vn) | nm_has(this.oglobals, vn))
                        {
                            case (true)
                            {
                                this.visit_expr(n.a);
                                this.emits(IDKVM_STRUCT_LOAD, n.text);
                                -> true;
                            }
                            default {};
                        };
                        // Color.BLUE is the constant of that member
                        ed = (Node*)nm_get(this.enums, vn);
                        switch (ed != (Node*)0)
                        {
                            case (true)
                            {
                                ei = 0;
                                while (ei < node_count(ed, 0))
                                {
                                    switch (idkvm_streq(node_child(ed, 0, ei).text, n.text))
                                    {
                                        case (true)
                                        {
                                            this.emit_push(IDKVM_T_INT, node_child(ed, 0, ei).ival);
                                            -> true;
                                        }
                                        default {};
                                    };
                                    ei++;
                                };
                            }
                            default {};
                        };
                        -> false;
                    }
                    default {};
                };
                switch (n.a.kind == NodeKind.MEMBER_ACCESS)
                {
                    case (true)
                    {
                        produced = this.visit_member_access(n.a);
                        switch (produced)
                        {
                            case (true)
                            {
                                this.emits(IDKVM_STRUCT_LOAD, n.text);
                                -> true;
                            }
                            default {};
                        };
                        -> false;
                    }
                    default {};
                };
                this.visit_expr(n.a);
                this.emits(IDKVM_STRUCT_LOAD, n.text);
                -> true;
            };

            // IDKVMCodegen._visit_struct_field_access
            visit_struct_field_access(Node* n) -> bool
            {
                this.visit_expr(n.a);
                this.emits(IDKVM_STRUCT_LOAD, n.text);
                -> true;
            };

            // IDKVMCodegen._visit_struct_field_assign
            visit_struct_field_assign(Node* n) -> bool
            {
                this.visit_expr(n.a);
                this.visit_expr(n.b);
                this.emits(IDKVM_STRUCT_STORE, n.text);
                -> false;
            };

            // An enum of the program: Color.BLUE resolves in the block, the type is known
            // a declared `as` alias: a variable of this type takes the type of the alias
            alias_seed(byte* name, TypeSpec* ts) -> void
            {
                nm_put(this.alspec, this.keep(name), (void*)ts);
                ->;
            };

            // true when name is a declared `as` alias of a pointer or an array type
            alias_is_ptr(byte* name) -> bool
            {
                TypeSpec* sp = (TypeSpec*)nm_get(this.alspec, name);
                switch (sp == (TypeSpec*)0) { case (true) { -> false; } default {}; };
                -> this.ts_is_ptr(sp) | (sp.flags `& TS_ARRAY) != 0;
            };

            // tag of a declared alias of a built in type, -1 for any other name
            alias_ttag(byte* name) -> int
            {
                TypeSpec* sp = (TypeSpec*)nm_get(this.alspec, name);
                int t;
                switch (sp == (TypeSpec*)0) { case (true) { -> -1; } default {}; };
                t = this.type_ttag_from_ts(sp);
                switch (t == IDKVM_T_STRUCT) { case (true) { -> -1; } default {}; };
                -> t;
            };

            enum_seed(Node* ed) -> void
            {
                nm_put(this.enums, this.keep(ed.text), (void*)ed);
                ->;
            };

            // IDKVMCodegen._visit_enum_def: every value becomes an int local
            visit_enum_def(Node* n) -> bool
            {
                int i, slot;
                Node* v;
                nm_put(this.enums, this.keep(n.text), (void*)n);
                while (i < node_count(n, 0))
                {
                    v = node_child(n, 0, i);
                    slot = this.alloc_local(v.text);
                    this.emit_push(IDKVM_T_INT, v.ival);
                    this.emit1(IDKVM_LOCAL_SET, (i64)slot);
                    nm_put(this.ltn, this.keep(v.text), (void*)this.keep(g"int\0"));
                    i++;
                };
                -> false;
            };

            // IDKVMCodegen._visit_union_def
            visit_union_def(Node* n) -> bool
            {
                this.define_layout(this.keep(n.text), n, true);
                -> false;
            };

            // IDKVMCodegen._visit_extern_block: one EXTERN_DECL per prototype, the operand is the
            // return TTag (VOID without a return type)
            visit_extern_block(Node* n) -> bool
            {
                int i, j, np;
                Node* d;
                Node* pp;
                i64* ptg;
                int rt;
                while (i < node_count(n, 0))
                {
                    d = node_child(n, 0, i);
                    rt = IDKVM_T_VOID;
                    switch (d.ts != (TypeSpec*)0)
                    {
                        case (true) { rt = this.type_ttag_from_ts(d.ts); }
                        default {};
                    };
                    np = node_count(d, 0);
                    ptg = (i64*)idkvm_alloc((np + 1) * 8);
                    switch (ptg == (i64*)0) { case (true) { this.fail(d, g"allocation failed\0"); -> false; } default {}; };
                    pv_push(this.owned, (void*)ptg);
                    j = 0;
                    while (j < np)
                    {
                        pp = node_child(d, 0, j);
                        ptg[j] = (i64)IDKVM_T_VOID;
                        switch (pp.ts != (TypeSpec*)0) { case (true) { ptg[j] = (i64)this.type_ttag_from_ts(pp.ts); } default {}; };
                        j++;
                    };
                    this.emit(IDKVM_EXTERN_DECL, (i64)rt, (i64)np, idkvm_p2i((byte*)ptg), this.keep(d.text));
                    i++;
                };
                -> false;
            };

            // the _ts_tag of _visit_namespace_def: one token of an overload signature
            sig_tag(TypeSpec* ts, FvmBuf* b) -> void
            {
                switch (ts == (TypeSpec*)0)
                {
                    case (true) { b.put_str(g"void\0"); ->; }
                    default {};
                };
                switch (ts.base_type < 0)
                {
                    case (true) { b.put_str(g"ptr\0"); ->; }
                    default {};
                };
                b.put_str(datatype_text(ts.base_type));
                switch ((ts.flags `& TS_ARRAY) != 0)
                {
                    case (true) { b.put_str(g"arr\0"); ->; }
                    default {};
                };
                switch ((ts.flags `& TS_POINTER) != 0 | ts.pointer_depth != 0)
                {
                    case (true) { b.put_str(g"ptr\0"); }
                    default {};
                };
                ->;
            };

            // IDKVMCodegen._visit_namespace_def: variables, functions under their mangled names
            // (the signature keyed form first, then the mangled and the bare name when free),
            // structs, extern blocks and nested namespaces
            ns_def(Node* n, byte* prefix) -> void
            {
                byte* nsn = this.joined_name(prefix, n.text);
                int i;
                int j;
                int np;
                Node* fn;
                IDKVMCodegen* f;
                bool fwd;
                bool named;
                FvmBuf sb;
                byte* key;
                byte* mangled;
                Node* var;
                int nvars;
                int nnest;
                i = 0;
                nvars = 0;
                switch (n.a != (Node*)0) { case (true) { nvars = node_count(n.a, 0); } default {}; };
                while (i < nvars)
                {
                    var = node_child(n.a, 0, i);
                    this.visit_var_decl(var);
                    this.set_add(this.bglobals, this.keep(var.text));
                    i++;
                };
                i = 0;
                while (i < node_count(n, 0))
                {
                    fn = node_child(n, 0, i);
                    i++;
                    switch (fn == (Node*)0)
                    {
                        case (true) { continue; }
                        default {};
                    };
                    f = this.make_child();
                    np = node_count(fn, 0);
                    j = 0;
                    while (j < np)
                    {
                        f.bind_param(node_child(fn, 0, j));
                        j++;
                    };
                    named = false;
                    j = 0;
                    while (j < np)
                    {
                        switch (node_child(fn, 0, j).text != (byte*)0) { case (true) { named = true; } default {}; };
                        j++;
                    };
                    fwd = fn.a == (Node*)0 | (fn.a.kind == NodeKind.BLOCK & node_count(fn.a, 0) == 0 & !named);
                    switch (fwd)
                    {
                        case (true) { continue; }
                        default {};
                    };
                    f.visit_body(fn.a);
                    f.end_function_body(false, np);
                    this.cf_adopt(f);
                    mangled = this.joined_name(nsn, fn.text);
                    sb.__init();
                    sb.put_str(mangled);
                    switch (np > 0)
                    {
                        case (true)
                        {
                            sb.put_str(g"__$\0");
                            j = 0;
                            while (j < np)
                            {
                                switch (j > 0) { case (true) { sb.put(95); } default {}; };
                                this.sig_tag(node_child(fn, 0, j).ts, @sb);
                                j++;
                            };
                        }
                        default {};
                    };
                    sb.put(0);
                    key = this.keep(sb.mem);
                    sb.__exit();
                    this.cf_put(key, f);
                    switch (!this.cf_has(mangled)) { case (true) { this.cf_put(mangled, f); } default {}; };
                    switch (!this.cf_has(fn.text)) { case (true) { this.cf_put(fn.text, f); } default {}; };
                };
                i = 0;
                while (i < node_count(n, 1))
                {
                    this.struct_def_prefixed(node_child(n, 1, i), nsn);
                    i++;
                };
                i = 0;
                while (i < node_count(n, 5))
                {
                    this.visit_extern_block(node_child(n, 5, i));
                    i++;
                };
                i = 0;
                nnest = 0;
                switch (n.b != (Node*)0) { case (true) { nnest = node_count(n.b, 0); } default {}; };
                while (i < nnest)
                {
                    this.ns_def(node_child(n.b, 0, i), nsn);
                    i++;
                };
                ->;
            };

            visit_namespace_def(Node* n) -> bool
            {
                this.ns_def(n, (byte*)0);
                -> false;
            };

            // IDKVMCodegen._visit_using: "a::b" becomes the namespace a__b
            ns_name(byte* path) -> byte*
            {
                FvmBuf b;
                byte* r;
                int i;
                b.__init();
                while (path[i] != 0)
                {
                    switch (path[i] == ':' & path[i + 1] == ':')
                    {
                        case (true)
                        {
                            b.put_str(g"__\0");
                            i = i + 2;
                        }
                        default
                        {
                            b.put(path[i]);
                            i++;
                        };
                    };
                };
                b.put(0);
                r = this.keep(b.mem);
                b.__exit();
                -> r;
            };

            visit_using(Node* n) -> bool
            {
                byte* ns = this.ns_name(n.text);
                int i;
                bool have;
                switch (nm_has(this.excluded, ns)) { case (true) { -> false; } default {}; };
                while (i < this.usings.len)
                {
                    switch (idkvm_streq((byte*)this.usings.items[i], ns)) { case (true) { have = true; } default {}; };
                    i++;
                };
                switch (!have) { case (true) { pv_push(this.usings, (void*)ns); } default {}; };
                -> false;
            };

            // IDKVMCodegen._visit_not_using
            visit_not_using(Node* n) -> bool
            {
                byte* ns = this.ns_name(n.text);
                int i;
                int j;
                this.set_add(this.excluded, ns);
                while (i < this.usings.len)
                {
                    switch (idkvm_streq((byte*)this.usings.items[i], ns))
                    {
                        case (true)
                        {
                            // remove the first match
                            j = i;
                            while (j < this.usings.len - 1)
                            {
                                this.usings.items[j] = this.usings.items[j + 1];
                                j++;
                            };
                            this.usings.len--;
                            -> false;
                        }
                        default {};
                    };
                    i++;
                };
                -> false;
            };

            // IDKVMCodegen._visit_switch: the subject is kept in a slot, every case compares it with
            // CMP_EQ and skips its body on a mismatch. The default case is emitted last. A case body
            // ends with a jump past the switch.
            visit_switch(Node* n) -> bool
            {
                int nc = node_count(n, 0);
                int i;
                int slot;
                int skip;
                Node* c;
                Node* dflt;
                this.visit_expr(n.a);
                slot = this.alloc_local(g"__switch_subject__\0");
                this.emit1(IDKVM_LOCAL_SET, (i64)slot);
                this.brk_push();
                while (i < nc)
                {
                    c = node_child(n, 0, i);
                    switch (c.a == (Node*)0)
                    {
                        case (true) { dflt = c; }
                        default
                        {
                            this.emit1(IDKVM_LOCAL_GET, (i64)slot);
                            this.visit_expr(c.a);
                            this.emit0(IDKVM_CMP_EQ);
                            skip = this.emit1(IDKVM_JNF, (i64)0);
                            this.visit_stmts_direct(c.b);
                            pv_push((PtrVec*)this.brks.items[this.brks.len - 1], (void*)(u64)(this.emit1(IDKVM_JMP, (i64)0) + 1));
                            this.patch_at(skip, IDKVM_JNF, this.ip());
                        };
                    };
                    i++;
                };
                switch (dflt != (Node*)0)
                {
                    case (true) { this.visit_stmts_direct(dflt.b); }
                    default {};
                };
                this.brk_pop(this.ip());
                -> false;
            };

            // IDKVMCodegen._visit_for: init, condition, body, update
            visit_for(Node* n) -> bool
            {
                int start;
                int exit_patch = -1;
                int update_ip;
                int after;
                switch (n.a != (Node*)0) { case (true) { this.visit_stmt(n.a); } default {}; };
                start = this.ip();
                switch (n.b != (Node*)0)
                {
                    case (true)
                    {
                        this.visit_expr(n.b);
                        exit_patch = this.emit1(IDKVM_JNF, (i64)0);
                    }
                    default {};
                };
                this.loop_push();
                this.visit_stmts_direct(n.d);
                update_ip = this.ip();
                switch (n.c != (Node*)0) { case (true) { this.visit_stmt(n.c); } default {}; };
                this.emit1(IDKVM_JMP, (i64)start);
                after = this.ip();
                switch (exit_patch >= 0) { case (true) { this.patch_at(exit_patch, IDKVM_JNF, after); } default {}; };
                this.loop_pop(after, update_ip);
                -> false;
            };


            // IDKVMCodegen._visit_label: the label is the current instruction, forward gotos waiting
            // for it are patched
            visit_label(Node* n) -> bool
            {
                i64* box = (i64*)fmalloc((u64)8);
                int i;
                PtrVec* ni = pv_new();
                PtrVec* nn = pv_new();
                pv_push(this.owned, (void*)box);
                *box = (i64)this.ip() + (i64)1;
                nm_put(this.labels, n.text, (void*)box);
                while (i < this.gp_idx.len)
                {
                    switch (idkvm_streq((byte*)this.gp_name.items[i], n.text))
                    {
                        case (true) { this.patch_at((int)(u64)this.gp_idx.items[i] - 1, IDKVM_JMP, this.ip()); }
                        default
                        {
                            pv_push(ni, this.gp_idx.items[i]);
                            pv_push(nn, this.gp_name.items[i]);
                        };
                    };
                    i++;
                };
                pv_free(this.gp_idx);
                pv_free(this.gp_name);
                this.gp_idx = ni;
                this.gp_name = nn;
                -> false;
            };

            // IDKVMCodegen._visit_goto: a jump to a label, or a CALL of a named comptime block of the
            // program, compiled once as the function __comptime_block__<name>
            visit_goto(Node* n) -> bool
            {
                int i;
                Node* s;
                FvmBuf b;
                byte* key;
                IDKVMCodegen* f;
                i64* box;
                switch (this.pstmts != (NodeVec*)0)
                {
                    case (true)
                    {
                        while (i < this.pstmts.len)
                        {
                            s = this.pstmts.items[i];
                            switch (s.kind == NodeKind.COMPTIME_BLOCK & s.text != (byte*)0)
                            {
                                case (true)
                                {
                                    switch (idkvm_streq(s.text, n.text))
                                    {
                                        case (true)
                                        {
                                            b.__init();
                                            b.put_str(g"__comptime_block__\0");
                                            b.put_str(n.text);
                                            b.put(0);
                                            key = this.keep(b.mem);
                                            b.__exit();
                                            switch (!this.cf_has(key))
                                            {
                                                case (true)
                                                {
                                                    // an empty entry first breaks the cycle of mutually recursive blocks
                                                    f = this.make_child();
                                                    f.in_func = false;
                                                    this.cf_put(key, f);
                                                    f.visit_body(s);
                                                    f.emit_push(IDKVM_T_VOID, (i64)0);
                                                    f.emit0(IDKVM_RET);
                                                    f.code.unit_end(f.unit);
                                                }
                                                default {};
                                            };
                                            this.emit(IDKVM_CALL, (i64)0, (i64)0, (i64)0, key);
                                            -> false;
                                        }
                                        default {};
                                    };
                                }
                                default {};
                            };
                            i++;
                        };
                    }
                    default {};
                };
                box = (i64*)nm_get(this.labels, n.text);
                switch (box != (i64*)0)
                {
                    case (true) { this.emit1(IDKVM_JMP, *box - (i64)1); }
                    default
                    {
                        i = this.emit1(IDKVM_JMP, (i64)0);
                        pv_push(this.gp_idx, (void*)(u64)(i + 1));
                        pv_push(this.gp_name, (void*)n.text);
                    };
                };
                -> false;
            };

            // IDKVMCodegen._visit_jump: a jump to a label by name, any other target is evaluated and
            // no jump follows
            visit_jump(Node* n) -> bool
            {
                i64* box;
                int idx;
                switch (n.a.kind == NodeKind.IDENTIFIER)
                {
                    case (true)
                    {
                        box = (i64*)nm_get(this.labels, n.a.text);
                        switch (box != (i64*)0)
                        {
                            case (true) { this.emit1(IDKVM_JMP, *box - (i64)1); }
                            default
                            {
                                idx = this.emit1(IDKVM_JMP, (i64)0);
                                pv_push(this.gp_idx, (void*)(u64)(idx + 1));
                                pv_push(this.gp_name, (void*)n.a.text);
                            };
                        };
                    }
                    default { this.visit_expr(n.a); };
                };
                -> false;
            };

            // IDKVMCodegen._visit_do: a loop that only break leaves
            visit_do(Node* n) -> bool
            {
                int start = this.ip();
                int after;
                this.loop_push();
                this.visit_stmts_direct(n.b);
                this.emit1(IDKVM_JMP, (i64)start);
                after = this.ip();
                this.loop_pop(after, start);
                -> false;
            };

            // IDKVMCodegen._visit_do_while
            visit_do_while(Node* n) -> bool
            {
                int start = this.ip();
                int cond_ip;
                int after;
                this.loop_push();
                this.visit_stmts_direct(n.b);
                cond_ip = this.ip();
                this.visit_expr(n.a);
                this.emit1(IDKVM_JIF, (i64)start);
                after = this.ip();
                this.loop_pop(after, cond_ip);
                -> false;
            };


            // IDKVMCodegen._visit_escape: the call is a normal call even inside a <~ function, and its
            // value is the return value
            visit_escape(Node* n) -> bool
            {
                byte* saved = this.tail_self;
                this.tail_self = (byte*)0;
                this.visit_expr(n.a);
                this.tail_self = saved;
                this.flush_all_defers();
                this.emit0(IDKVM_RET);
                -> false;
            };



            visit_idkvm_block(Node* n) -> bool
            {
                this.stub(n, g"IDKVMCodegen._visit_idkvm_block\0");
                -> false;
            };

            // IDKVMCodegen._visit_emitideka: source text plus a snapshot of the current locals
            visit_emitideka(Node* n) -> bool
            {
                int i;
                int cnt = this.lnames.len;
                FvmVars* vars = (FvmVars*)fmalloc((u64)((sizeof(FvmVars) + 7) / 8));
                byte** nms = (byte**)fmalloc((u64)((cnt + 1) * 8));
                int* sl = (int*)fmalloc((u64)((cnt + 1) * 4));
                byte* t;
                pv_push(this.owned, (void*)vars);
                pv_push(this.owned, (void*)nms);
                pv_push(this.owned, (void*)sl);
                while (i < cnt)
                {
                    nms[i] = (byte*)this.lnames.items[i];
                    sl[i] = this.alloc_local(nms[i]);
                    i++;
                };
                vars.names = nms;
                vars.slots = sl;
                vars.n = cnt;
                t = this.keep(n.text);
                this.cur_line = n.line;
                this.emit(IDKVM_EMITIDEKA, (i64)cnt, (i64)0, idkvm_p2i((byte*)vars), t);
                -> true;
            };

            // a noreturn statement: HALT, like fcodegen's builder.unreachable()
            visit_noreturn(Node* n) -> bool
            {
                this.emit0(IDKVM_HALT);
                -> false;
            };

            // IDKVMCodegen._visit_stmt TraitDef: the trait joins the registry
            visit_trait_def(Node* n) -> bool
            {
                nm_put(this.trreg, this.keep(n.text), (void*)n);
                -> false;
            };

            // IDKVMCodegen._visit_stmt InterfaceDef
            visit_interface_def(Node* n) -> bool
            {
                nm_put(this.ifreg, this.keep(n.text), (void*)n);
                -> false;
            };

            // IDKVMCodegen._visit_stmt macroDefStatement: the definition joins the macro table
            visit_macro_def(Node* n) -> bool
            {
                nm_put(this.macros, this.keep(n.a.text), (void*)n.a);
                -> false;
            };

            // A macro of the program, known to the block before it runs
            macro_seed(Node* md) -> void
            {
                nm_put(this.macros, this.keep(md.text), (void*)md);
                ->;
            };

            emit_instr(int op) -> int
            {
                this.stub((Node*)0, g"IDKVMCodegen._emit\0");
                -> 0;
            };

            current_ip() -> int
            {
                this.stub((Node*)0, g"IDKVMCodegen._current_ip\0");
                -> 0;
            };

            // IDKVMCodegen._fresh_tmp: "__tmp_<number of locals>__", kept
            fresh_tmp() -> byte*
            {
                FvmBuf b;
                byte* r;
                b.__init();
                b.put_str(g"__tmp_\0");
                b.put_i64((i64)this.nlocals);
                b.put_str(g"__\0");
                b.put(0);
                r = this.keep(b.mem);
                b.__exit();
                -> r;
            };

            // IDKVMCodegen._flush_defers: the deferred statements of one scope in reverse order
            flush_defers(PtrVec* scope) -> void
            {
                int i = scope.len - 1;
                int j;
                Node* d;
                Node* x;
                while (i >= 0)
                {
                    d = (Node*)scope.items[i];
                    switch ((d.flags `& NF_HAS_BODY) != 0)
                    {
                        case (true)
                        {
                            j = node_count(d, 0) - 1;
                            while (j >= 0)
                            {
                                this.visit_stmt(node_child(d, 0, j));
                                j--;
                            };
                        }
                        default
                        {
                            x = d.a;
                            switch (x != (Node*)0)
                            {
                                case (true)
                                {
                                    switch (x.kind <= NodeKind.NO_INIT)
                                    {
                                        case (true)
                                        {
                                            switch (this.visit_expr(x)) { case (true) { this.emit0(IDKVM_POP); } default {}; };
                                        }
                                        default { this.visit_stmt(x); };
                                    };
                                }
                                default {};
                            };
                        };
                    };
                    i--;
                };
                ->;
            };

            // IDKVMCodegen._flush_all_defers: every pending scope, innermost first, before RET
            flush_all_defers() -> void
            {
                int i = this.defers.len - 1;
                while (i >= 0)
                {
                    this.flush_defers((PtrVec*)this.defers.items[i]);
                    i--;
                };
                ->;
            };

            emit_compound_op(int op_token, Node* n) -> void
            {
                int vm = idkvmcg_compound_op(op_token);
                switch (vm >= 0)
                {
                    case (true) { this.emit0(vm); }
                    default { this.fail(n, g"idkvmcodegen: compound assign op not supported\0"); };
                };
                ->;
            };

            // IDKVMCodegen._emit_unpack: the declarations first..last of b take consecutive bit fields
            // of the source, the first one the highest bits
            emit_unpack(Node* b, int first, int last) -> void
            {
                Node* head = node_child(b, 0, first);
                Node* src = node_child(node_child(b, 0, last).a, 0, 0);
                int dt = head.ts.base_type;
                int ttag = idkvmcg_datatype_ttag(dt);
                int bits = idkvmcg_type_bits(dt, 32);
                int n = last - first + 1;
                int i;
                int src_slot;
                int slot;
                int shift;
                i64 mask = ((i64)1 << (i64)bits) - (i64)1;
                Node* d;
                this.visit_expr(src);
                src_slot = this.alloc_local(g"__unpack_src__\0");
                this.emit1(IDKVM_LOCAL_SET, (i64)src_slot);
                while (i < n)
                {
                    d = node_child(b, 0, first + i);
                    slot = this.alloc_local(d.text);
                    shift = (n - 1 - i) * bits;
                    this.emit1(IDKVM_LOCAL_GET, (i64)src_slot);
                    switch (shift > 0)
                    {
                        case (true)
                        {
                            this.emit_push(IDKVM_T_INT, (i64)shift);
                            this.emit0(IDKVM_SHR);
                        }
                        default {};
                    };
                    this.emit_push(IDKVM_T_LONG, mask);
                    this.emit0(IDKVM_BAND);
                    this.emit1(IDKVM_CAST, (i64)ttag);
                    this.emit1(IDKVM_LOCAL_SET, (i64)slot);
                    switch (d.ts != (TypeSpec*)0)
                    {
                        case (true) { nm_put(this.ltn, d.text, (void*)datatype_text(d.ts.base_type)); }
                        default {};
                    };
                    i++;
                };
                ->;
            };

            // IDKVMCodegen._emit_pack: an array literal packed into an integer, the first element in the
            // high bits
            emit_pack(Node* arr, TypeSpec* target) -> void
            {
                int tdt = DataType.SLONG;
                int ttag;
                int ebits = 32;
                int n = node_count(arr, 0);
                int i = 1;
                int shift;
                int acc;
                switch (target != (TypeSpec*)0) { case (true) { tdt = target.base_type; } default {}; };
                ttag = idkvmcg_datatype_ttag(tdt);
                switch (arr.ts != (TypeSpec*)0)
                {
                    case (true) { ebits = idkvmcg_type_bits(arr.ts.base_type, 32); }
                    default {};
                };
                switch (n == 0)
                {
                    case (true)
                    {
                        this.emit_push(ttag, (i64)0);
                        ->;
                    }
                    default {};
                };
                this.visit_expr(node_child(arr, 0, 0));
                shift = (n - 1) * ebits;
                switch (shift > 0)
                {
                    case (true)
                    {
                        this.emit_push(IDKVM_T_INT, (i64)shift);
                        this.emit0(IDKVM_SHL);
                    }
                    default {};
                };
                acc = this.alloc_local(g"__pack_acc__\0");
                this.emit1(IDKVM_LOCAL_SET, (i64)acc);
                while (i < n)
                {
                    shift = (n - 1 - i) * ebits;
                    this.visit_expr(node_child(arr, 0, i));
                    switch (shift > 0)
                    {
                        case (true)
                        {
                            this.emit_push(IDKVM_T_INT, (i64)shift);
                            this.emit0(IDKVM_SHL);
                        }
                        default {};
                    };
                    this.emit1(IDKVM_LOCAL_GET, (i64)acc);
                    this.emit0(IDKVM_BOR);
                    this.emit1(IDKVM_LOCAL_SET, (i64)acc);
                    i++;
                };
                this.emit1(IDKVM_LOCAL_GET, (i64)acc);
                this.emit1(IDKVM_CAST, (i64)ttag);
                ->;
            };

            // IDKVMCodegen._flatten_dotted_name: IDENTIFIER, MEMBER_ACCESS and METHOD_CALL chains as
            // "a.b.c", null when the chain holds another node. The text is owned until __exit.
            flatten_dotted_name(Node* n) -> byte*
            {
                byte* base;
                FvmBuf b;
                byte* r;
                if (n == (Node*)0) { -> (byte*)0; };
                if (n.kind == NodeKind.IDENTIFIER) { -> n.text; };
                if (n.kind == NodeKind.MEMBER_ACCESS | n.kind == NodeKind.METHOD_CALL)
                {
                    base = this.flatten_dotted_name(n.a);
                    if (base == (byte*)0) { -> (byte*)0; };
                    b.__init();
                    b.put_str(base);
                    b.put('.');
                    b.put_str(n.text);
                    b.put(0);
                    r = this.keep(b.mem);
                    b.__exit();
                    -> r;
                };
                -> (byte*)0;
            };

            // IDKVMCodegen._type_bit_width: structs are tightly packed
            type_bit_width(TypeSpec* ts) -> int
            {
                int elem;
                int li;
                switch (ts == (TypeSpec*)0)
                {
                    case (true) { -> 32; }
                    default {};
                };
                // a pointer is 64 bits whatever its pointee declares (byte* carries a width of 8)
                switch ((ts.flags `& TS_POINTER) != 0) { case (true) { -> 64; } default {}; };
                switch (ts.bit_width >= 0) { case (true) { -> ts.bit_width; } default {}; };
                switch ((ts.flags `& TS_ARRAY) != 0 & ts.array_size != (Node*)0)
                {
                    case (true)
                    {
                        elem = this.type_bit_width_base(ts.base_type, ts);
                        switch (ts.array_size.kind == NodeKind.LITERAL)
                        {
                            case (true) { -> elem * (int)ts.array_size.ival; }
                            default {};
                        };
                    }
                    default {};
                };
                switch (ts.custom_typename == (byte*)0)
                {
                    case (true) { -> this.type_bit_width_base(ts.base_type, ts); }
                    default
                    {
                        li = this.lay.find(ts.custom_typename);
                        switch (li >= 0)
                        {
                            case (true)
                            {
                                switch (this.lay.sbits[li] != 0) { case (true) { -> this.lay.sbits[li]; } default {}; };
                                -> this.lay.ssize[li] * 8;
                            }
                            default {};
                        };
                        -> 32;
                    };
                };
            };

            // IDKVMCodegen._type_bit_width_base
            type_bit_width_base(int bt, TypeSpec* ts) -> int
            {
                switch (bt)
                {
                    case (DataType.SINT) { -> 32; }
                    case (DataType.UINT) { -> 32; }
                    case (DataType.SLONG) { -> 64; }
                    case (DataType.ULONG) { -> 64; }
                    case (DataType.FLOAT) { -> 32; }
                    case (DataType.DOUBLE) { -> 64; }
                    case (DataType.BOOL) { -> 1; }
                    case (DataType.BYTE) { -> 8; }
                    case (DataType.CHAR) { -> 8; }
                    case (DataType.DATA)
                    {
                        switch (ts != (TypeSpec*)0)
                        {
                            case (true)
                            {
                                switch (ts.bit_width > 0) { case (true) { -> ts.bit_width; } default {}; };
                            }
                            default {};
                        };
                        -> 0;
                    }
                    default { -> 32; };
                };
                -> 32;
            };

            // IDKVMCodegen._type_ttag_from_ts
            type_ttag_from_ts(TypeSpec* ts) -> int
            {
                int bits;
                int pa;
                bool sg;
                switch (ts == (TypeSpec*)0) { case (true) { -> IDKVM_T_INT; } default {}; };
                switch ((ts.flags `& TS_POINTER) != 0) { case (true) { -> IDKVM_T_PTR; } default {}; };
                switch (ts.custom_typename != (byte*)0)
                {
                    case (true)
                    {
                        pa = this.alias_ttag(ts.custom_typename);
                        switch (pa >= 0) { case (true) { -> pa; } default {}; };
                        -> IDKVM_T_STRUCT;
                    }
                    default {};
                };
                switch (ts.base_type == DataType.DATA)
                {
                    case (true)
                    {
                        bits = 32;
                        sg = (ts.flags `& TS_SIGNED) != 0;
                        switch (ts.bit_width > 0) { case (true) { bits = ts.bit_width; } default {}; };
                        switch (bits <= 32)
                        {
                            case (true)
                            {
                                switch (sg) { case (true) { -> IDKVM_T_INT; } default { -> IDKVM_T_UINT; }; };
                            }
                            default
                            {
                                switch (sg) { case (true) { -> IDKVM_T_LONG; } default { -> IDKVM_T_ULONG; }; };
                            };
                        };
                    }
                    default {};
                };
                -> idkvmcg_datatype_ttag(ts.base_type);
            };

            // IDKVMCodegen._resolve_goto_patches: labels and gotos are stubs, so no patch is pending
            // IDKVMCodegen._resolve_goto_patches: the gotos whose label exists now are patched
            resolve_goto_patches() -> void
            {
                int i;
                i64* box;
                PtrVec* ni = pv_new();
                PtrVec* nn = pv_new();
                while (i < this.gp_idx.len)
                {
                    box = (i64*)nm_get(this.labels, (byte*)this.gp_name.items[i]);
                    switch (box != (i64*)0)
                    {
                        case (true) { this.patch_at((int)(u64)this.gp_idx.items[i] - 1, IDKVM_JMP, (int)(*box - (i64)1)); }
                        default
                        {
                            pv_push(ni, this.gp_idx.items[i]);
                            pv_push(nn, this.gp_name.items[i]);
                        };
                    };
                    i++;
                };
                pv_free(this.gp_idx);
                pv_free(this.gp_name);
                this.gp_idx = ni;
                this.gp_name = nn;
                ->;
            };
        };
    };
};

#endif;
