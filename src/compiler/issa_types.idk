// Author: Karac V. Thweatt
//
// issa_types.idk - target independent data structures of the SSA code generator (imported by the backend,
// ix64.idk for x86_64). The recorded instruction (SI), the blocks and phis of the SSA form and the state of
// the function being compiled. The machine instructions and the CPU features belong to the backend.

#ifndef IDEKA_SSA_TYPES
#def IDEKA_SSA_TYPES 1;

// Operations of the recorded instructions
#def SO_BIN 1;
#def SO_CMP 2;
#def SO_CAST 3;
#def SO_ALLOCA 4;
#def SO_ALLOCAN 5;
#def SO_LOAD 6;
#def SO_STORE 7;
#def SO_GEP 8;
#def SO_CALL 9;
#def SO_PHI 10;
#def SO_SELECT 11;
#def SO_VAARG 12;
#def SO_EXTRACT 13;
#def SO_INSERT 14;
#def SO_BR 15;
#def SO_CBR 16;
#def SO_RET 17;
#def SO_RETV 18;
#def SO_UNREACH 19;
#def SO_SWITCH 20;
#def SO_COPY 22;      // a destination ptr, b source ptr, c count: copies count elements of size sz forward, k 1 when the count is signed
#def SO_RETADDR 23;   // res the address of the slot that holds the return address of the function, no operands
#def SO_FILL 21;      // a ptr, b value, c count: stores the value over count elements of size sz from a, k 1 when the count is signed

// Binary operation kinds
#def SB_ADD 1;
#def SB_SUB 2;
#def SB_MUL 3;
#def SB_SDIV 4;
#def SB_UDIV 5;
#def SB_SREM 6;
#def SB_UREM 7;
#def SB_AND 8;
#def SB_OR 9;
#def SB_XOR 10;
#def SB_SHL 11;
#def SB_LSHR 12;
#def SB_ASHR 13;
#def SB_FADD 14;
#def SB_FSUB 15;
#def SB_FMUL 16;
#def SB_FDIV 17;
#def SB_FREM 18;

// Cast kinds
#def SK_TRUNC 1;
#def SK_ZEXT 2;
#def SK_SEXT 3;
#def SK_BITCAST 4;
#def SK_PTRTOINT 5;
#def SK_INTTOPTR 6;
#def SK_FPEXT 7;
#def SK_FPTRUNC 8;
#def SK_SITOFP 9;
#def SK_UITOFP 10;
#def SK_FPTOSI 11;
#def SK_FPTOUI 12;

// Compare predicates, integer 1..10 and float 11..
#def SP_EQ 1;
#def SP_NE 2;
#def SP_ULT 3;
#def SP_ULE 4;
#def SP_UGT 5;
#def SP_UGE 6;
#def SP_SLT 7;
#def SP_SLE 8;
#def SP_SGT 9;
#def SP_SGE 10;
#def SP_FALSE 11;
#def SP_TRUE 12;
#def SP_ORD 13;
#def SP_UNO 14;
#def SP_OEQ 15;
#def SP_ONE 16;
#def SP_UEQ 17;
#def SP_UNE 18;
#def SP_OGT 19;
#def SP_OGE 20;
#def SP_OLT 21;
#def SP_OLE 22;
#def SP_UGT_F 23;
#def SP_UGE_F 24;
#def SP_ULT_F 25;
#def SP_ULE_F 26;

// Kinds of constant operands, see s_ck
#def CK_NO 0;       // not a constant
#def CK_INT 1;      // integer bits in scv
#def CK_SYM 2;      // symbol scs plus scv
#def CK_FP 3;       // float bits in scv
#def CK_ZERO 4;     // zeroinitializer or undef of an aggregate
#def CK_BAD 5;      // constant text the selector cannot read

#endif;

// One recorded instruction. res is the value it defines, a b c its operands.
struct SI
{
    int op, n, k, sz, bi;
    IRType* ty;
    IRValue* res;
    IRValue* a;
    IRValue* b;
    IRValue* c;
    IRValue** args;
    IRBlock** blks;
    IRBlock* t;
    IRBlock* f;
    bool vol, flag;
    int pos;
};


// A phi of the SSA form
struct GP
{
    IRValue* res;
    int dst;            // virtual register
    PtrVec* preds;      // GB* of the incoming edges
    PtrVec* vals;       // IRValue* of the incoming values
    PtrVec* ops;        // MO* of the incoming values after selection
};

// A block of the function being compiled
struct GB
{
    IRBlock* ib;
    int id, rpo, idom, lbl, depth, nexti, lw;
    PtrVec* preds;      // GB*
    PtrVec* succs;      // GB*
    PtrVec* kids;       // GB* children in the dominator tree
    PtrVec* df;         // GB* dominance frontier
    PtrVec* phis;       // GP*
    PtrVec* mi;         // MI*
    int* livein;
    int* liveout;
    int* guse;
    int* gdef;
    int hd;             // shrink wrapping: 1 where the frame is set up, 2 below such a block, 0 outside
};

// Per function state of the code generator
struct GF
{
    IRFunc* f;
    PtrVec* bl;  // GB* in source order, reachable blocks only
    GB** rpo;  // GB* in reverse post order
    int nb;
    int nvr;  // virtual registers made so far
    int capvr;
    int* vcls;  // 0 general, 1 float and vector
    int* vwgt;  // spill cost
    int* vcol;  // assigned register, -1 spilled, -2 unassigned
    int* vslot;  // frame offset of a spilled register
    i64* vforb;  // registers it must not take, one bit per register of the target (up to 64)
    int* vhint;  // preferred register, or virtual register whose register is preferred (as -(v + 1))
    int* vdef;  // defining block id
    int* vglob;  // dense index among registers live across blocks, or -1
    int* vuse;  // number of uses
    int nglob;
    int mlast;
    int rcap, nl, occ;
    int* lpos;
    int* llist;
    int* gv;
    int* gw;
    int* cur;
    void* tg;           // state of the backend (XGF in ix64.idk)
};
