// Author: Karac V. Thweatt
//
// idkvm.idk - IDEKA Virtual Machine library (port of idkvm.py)
//
// This file is a library. It has no main and it does not import the compiler.
// The standalone runner is ivm_main.idk. The compiler side (ivmcodegen.idk)
// depends on this file, never the other way around.
//
// Usage:
//
//     #import "src/compiler/idkvm.idk";
//     using IDEKA::IDKVM;
//
//     IDEKAVM vm();
//     defer vm.__exit();
//     vm.load_idkvm(text, len);          // parse a .ivm ASM dump, register its functions
//     vm.load_bin(image, len);          // or load an IDKB binary dump (magic "IDKB") the same way
//     vm.execute_main();               // run the main block
//     vm.emit_count, vm.emit_kind(i)   // boundary crossing results
//
// Bootstrap method: every VM feature that is not ported yet is a stub that is
// counted by name in vm.stubs and makes execution fail with a message. After a
// run, vm.stubs.report(...) shows what is missing. Inline ASM is never ported
// (it needs an own backend, the way Keystone is used by the Python VM).

#ifndef IDEKA_STANDARD
#import <standard.idk>;
#endif;

#ifndef IDEKA_STANDARD_FFI_FIO
#import <runtime\ffifio.idk>;
#endif;

#ifndef IDEKA_STANDARD_WATCHDOG
#import <watchdog.idk>;
#endif;

#ifndef IDEKA_IDKVM
#def IDEKA_IDKVM 1;

