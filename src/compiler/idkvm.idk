                case (111) { -> g"ASSERT\0"; }
                case (112) { -> g"WARN\0"; }
                case (113) { -> g"PANIC\0"; }
                case (114) { -> g"EMIT_CONST\0"; }
                case (115) { -> g"EMIT_GLOBAL\0"; }
                case (116) { -> g"EMIT_TYPE\0"; }
                case (117) { -> g"EMITIDEKA\0"; }
