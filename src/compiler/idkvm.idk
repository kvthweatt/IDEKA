                case (55) { -> g"GLOBAL_SET\0"; }
                case (56) { -> g"ALLOC\0"; }
                case (57) { -> g"FREE\0"; }
                case (58) { -> g"LOAD\0"; }
                case (59) { -> g"STORE\0"; }
                case (60) { -> g"OFFSET\0"; }
                case (61) { -> g"STRUCT_NEW\0"; }
                case (62) { -> g"STRUCT_LOAD\0"; }
