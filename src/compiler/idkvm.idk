// Heap size of the VM (VMHeap.DEFAULT_SIZE) and call frame local slots
#def IDKVM_HEAP_SIZE 16777216;
// heap addresses start above every frame slot number, as in the Python VM
#def IDKVM_HEAP_BASE 65536;
#def IDKVM_CALL_LOCALS 32;
#def IDKVM_TRACE_LIMIT 2000;

#def IDKVM_HOST_NONE 0;
#def IDKVM_HOST_IMPORT_STDLIB 1;
#def IDKVM_HOST_IMPORT_LOCAL 2;

// meta bit of a PTR value: the pointer addresses a frame local slot
#def IDKVM_META_STACK_SLOT 1;
// meta of a PTR cast to a struct type: IDKVM_META_TYPE plus the index of the interned type name,
// the way the Python VM keeps meta['struct_type']
#def IDKVM_META_TYPE 256;
// meta of a runtime value operand (STRUCT, ARRAY and the like) read by a decompile: its data is a
// pointer to the text the binary file holds. Nothing else produces it.
#def IDKVM_META_OPAQUE 1869635953;

// Result kinds of emit_results
#def IDKVM_EMIT_K_CONST 0;
#def IDKVM_EMIT_K_GLOBAL 1;
#def IDKVM_EMIT_K_TYPE 2;
#def IDKVM_EMIT_K_IDEKA 3;

