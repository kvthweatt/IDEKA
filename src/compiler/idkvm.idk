                default { -> g"?\0"; };
            };
        };

        // The IDKB operand shape of an opcode (_bin_shape in idkvm.py). An opcode without a
        // shape is written bare, like the text dump does.
        idkvm_bin_shape(int op) -> int
        {
            switch (op == IDKVM_JMP | op == IDKVM_JIF | op == IDKVM_JNF | op == IDKVM_LOCAL_GET | op == IDKVM_LOCAL_SET | op == IDKVM_TAIL_SELF | op == IDKVM_EMIT_GLOBAL | op == IDKVM_TRY_BEGIN | op == IDKVM_CALL_PTR | op == IDKVM_ROTL | op == IDKVM_ROTR | op == IDKVM_BITREV | op == IDKVM_CLZ | op == IDKVM_CTZ)
            {
                case (true) { -> IDKVM_BS_I; }
                default {};
            };
            switch (op == IDKVM_SIZEOF | op == IDKVM_ALIGNOF | op == IDKVM_ENDIANOF | op == IDKVM_STRUCT_NEW | op == IDKVM_STRUCT_LOAD | op == IDKVM_STRUCT_STORE | op == IDKVM_ENUM_NEW | op == IDKVM_GLOBAL_GET | op == IDKVM_GLOBAL_SET | op == IDKVM_FFI_LOAD | op == IDKVM_FFI_SYM)
            {
                case (true) { -> IDKVM_BS_S; }
                default {};
            };
            switch (op == IDKVM_CALL | op == IDKVM_ARRAY_NEW) { case (true) { -> IDKVM_BS_SI; } default {}; };
            switch (op == IDKVM_LOAD | op == IDKVM_STORE) { case (true) { -> IDKVM_BS_TI; } default {}; };
            switch (op == IDKVM_CAST | op == IDKVM_BITCAST) { case (true) { -> IDKVM_BS_TS; } default {}; };
            switch (op == IDKVM_FFI_CALL) { case (true) { -> IDKVM_BS_IT; } default {}; };
            switch (op == IDKVM_EXTERN_DECL) { case (true) { -> IDKVM_BS_X; } default {}; };
            switch (op == IDKVM_JTABLE) { case (true) { -> IDKVM_BS_J; } default {}; };
            switch (op == IDKVM_PUSH) { case (true) { -> IDKVM_BS_V; } default {}; };
            switch (op == IDKVM_INLINE_ASM) { case (true) { -> IDKVM_BS_A; } default {}; };
            switch (op == IDKVM_EMITIDEKA) { case (true) { -> IDKVM_BS_E; } default {}; };
            -> IDKVM_BS_Z;
        };

        // TTag string value as used by the .ivm format
        idkvm_ttag_name(int tag) -> byte*
        {
            switch (tag)
            {
                case (0) { -> g"int\0"; }
                case (1) { -> g"uint\0"; }
                case (2) { -> g"long\0"; }
                case (3) { -> g"ulong\0"; }
                case (4) { -> g"float\0"; }
                case (5) { -> g"double\0"; }
                case (6) { -> g"bool\0"; }
                case (7) { -> g"byte\0"; }
                case (8) { -> g"char\0"; }
                case (9) { -> g"data\0"; }
                case (10) { -> g"ptr\0"; }
                case (11) { -> g"void\0"; }
                case (12) { -> g"struct\0"; }
                case (13) { -> g"enum\0"; }
                case (14) { -> g"array\0"; }
                case (15) { -> g"bytes\0"; }
                case (16) { -> g"ffi_lib\0"; }
                case (17) { -> g"ffi_sym\0"; }
                case (18) { -> g"file\0"; }
                default { -> g"?\0"; };
            };
        };

        // ===== BYTE HELPERS =====

        idkvm_strlen(byte* s) -> int
        {
            int n;
            while (s[n] != 0) { n++; };
            -> n;
        };

        idkvm_streq(byte* a, byte* b) -> bool
        {
            int i;
            while (a[i] != 0 & b[i] != 0)
            {
                switch (a[i] != b[i])
                {
                    case (true) { -> false; }
                    default
                    {
                        i++;
                    };
                };
            };
            -> a[i] == b[i];
        };

        // Compare of two null terminated strings, like strcmp
        idkvm_strcmp(byte* a, byte* b) -> int
        {
            int i;
            while (a[i] != 0 & b[i] != 0)
            {
                switch (a[i] != b[i])
                {
                    case (true) {
                        switch (a[i] < b[i])
                        {
                            case (true) { -> -1; }
                            default { -> 1; };
                        };
                    }
                    default
                    {
                        i++;
                    };
                };
            };
            switch (a[i] == b[i])
            {
                case (true) { -> 0; }
                default
                {
                    switch (a[i] < b[i])
                    {
                        case (true) { -> -1; }
                        default { -> 1; };
                    };
                };
            };
        };

        // Lower case of an ASCII character
        idkvm_lower(int c) -> int
        {
            switch (c >= 'A' & c <= 'Z')
            {
                case (true) { -> c + 32; }
                default { -> c; };
            };
        };

        // ASCII whitespace as str.strip() sees it
        idkvm_is_space(int c) -> bool
        {
            -> c == 32 | (c >= 9 & c <= 13);
        };

        // s[0, n) equals the null terminated lit, ignoring ASCII case
        idkvm_eq_ci(byte* s, int n, byte* lit) -> bool
        {
            int i;
            switch (idkvm_strlen(lit) != n)
            {
                case (true) { -> false; }
                default {};
            };
            while (i < n)
            {
                switch (idkvm_lower((int)s[i]) != idkvm_lower((int)lit[i]))
                {
                    case (true) { -> false; }
                    default
                    {
                        i++;
                    };
                };
            };
            -> true;
        };

        // s[0, n) equals the null terminated lit
        idkvm_eq_n(byte* s, int n, byte* lit) -> bool
        {
            int i;
            switch (idkvm_strlen(lit) != n)
            {
                case (true) { -> false; }
                default {};
            };
            while (i < n)
            {
                switch (s[i] != lit[i])
                {
                    case (true) { -> false; }
                    default
                    {
                        i++;
                    };
                };
            };
            -> true;
        };

        idkvm_alloc(int n) -> byte*
        {
            byte* p = (byte*)fmalloc((u64)n);
            int i;
            switch (p == (byte*)0)
            {
                case (true) { -> p; }
                default {};
            };
            while (i < n)
            {
                p[i] = 0;
                i++;
            };
            -> p;
        };

        // Grows an allocation to nbytes. The old pointer is invalid afterwards.
        idkvm_grow(byte* old, int nbytes) -> byte*
        {
            u64 np;
            switch (old == (byte*)0)
            {
                case (true) { np = (u64)fmalloc(nbytes); }
                default { np = frealloc((u64)old, nbytes); };
            };
            -> (byte*)np;
        };

        // Null terminated copy of s[0, n)
        idkvm_dup(byte* s, int n) -> byte*
        {
            byte* p = idkvm_alloc(n + 1);
            int i;
            switch (p == (byte*)0)
            {
                case (true) { -> p; }
                default {};
            };
            while (i < n)
            {
                p[i] = s[i];
                i++;
            };
            p[n] = 0;
            -> p;
        };

        idkvm_copy(byte* d, byte* s, int n) -> void
        {
            int k;
            while (k < n) { d[k] = s[k]; k++; };
            ->;
        };

        idkvm_p2i(byte* p) -> i64 -> (i64)(u64)p;

        idkvm_i2p(i64 v) -> byte* -> (byte*)(u64)v;

        idkvm_is_unsigned(int tag) -> bool
        {
            switch (tag)
            {
                case (1) { -> true; }
                case (3) { -> true; }
                case (6) { -> true; }
                case (7) { -> true; }
                case (8) { -> true; }
                case (9) { -> true; }
                case (10) { -> true; }
                default { -> false; };
            };
        };

        idkvm_is_intlike(int tag) -> bool
        {
            switch (tag)
            {
                case (0) { -> true; }
                case (1) { -> true; }
                case (2) { -> true; }
                case (3) { -> true; }
                case (6) { -> true; }
                case (7) { -> true; }
                case (8) { -> true; }
                case (9) { -> true; }
                case (10) { -> true; }
                case (13) { -> true; }
                default { -> false; };
            };
        };

        // ttag_byte_size of idkvm.py
        idkvm_ttag_size(int tag) -> int
        {
            switch (tag)
            {
                case (6) { -> 1; }
                case (7) { -> 1; }
                case (8) { -> 1; }
                case (2) { -> 8; }
                case (3) { -> 8; }
                case (5) { -> 8; }
                case (10) { -> 8; }
                default { -> 4; };
            };
        };

        // _wrap_int: result of an arithmetic or bitwise op wrapped to the width of tag
        idkvm_wrap(int tag, i64 v) -> i64
        {
            switch (tag)
            {
                case (0)
                {
                    v = v `& (i64)4294967295;
                    switch (v >= (i64)2147483648)
                    {
                        case (true) { v = v - (i64)4294967296; }
                        default {};
                    };
                    -> v;
                }
                case (1) { -> v `& (i64)4294967295; }
                case (6) { -> v `& (i64)255; }
                case (7) { -> v `& (i64)255; }
                case (8) { -> v `& (i64)255; }
                case (9) { -> v `& (i64)4294967295; }
                default { -> v; };
            };
        };

        // Logical shift right of a 64 bit value
        idkvm_lsr(i64 v, int n) -> i64
        {
            switch (n <= 0)
            {
                case (true) { -> v; }
                default {};
            };
            switch (n >= 64)
            {
                case (true) { -> 0; }
                default {};
            };
            -> (v >> n) `& (((i64)1 << (64 - n)) - (i64)1);
        };

        // s begins with the null terminated pre
        idkvm_starts_with(byte* s, byte* pre) -> bool
        {
            int i;
            while (pre[i] != 0)
            {
                switch (s[i] != pre[i])
                {
                    case (true) { -> false; }
                    default
                    {
                        i++;
                    };
                };
            };
            -> true;
        };

        // key ends with "__" followed by name and is longer than that suffix
        idkvm_ends_dunder(byte* key, byte* name) -> bool
        {
            int kl = idkvm_strlen(key);
            int nl = idkvm_strlen(name);
            int off;
            switch (kl < nl + 2)
            {
                case (true) { -> false; }
                default {};
            };
            off = kl - nl;
            switch (key[off - 1] != '_' | key[off - 2] != '_')
            {
                case (true) { -> false; }
                default {};
            };
            -> idkvm_eq_n(key + off, nl, name);
        };

        // Index of the first "__$" in key, or -1
        idkvm_find_sig(byte* key) -> int
        {
            int i;
            while (key[i] != 0)
            {
                switch (key[i] == '_' & key[i + 1] == '_' & key[i + 2] == '$')
                {
                    case (true) { -> i; }
                    default {};
                };
                i++;
            };
            -> -1;
        };

        // Number of '_' separated tokens of an overload signature (0 for an empty one)
        idkvm_sig_argc(byte* sig) -> int
        {
            int n = 1;
            int i;
            switch (sig[0] == 0)
            {
                case (true) { -> 0; }
                default {};
            };
            while (sig[i] != 0)
            {
                switch (sig[i] == '_')
                {
                    case (true) { n++; }
                    default {};
                };
                i++;
            };
            -> n;
        };

        // int(token, 0): optional sign, 0x 0o 0b prefixes or decimal. *ok is false on bad input.
        idkvm_parse_int(byte* s, int n, bool* ok) -> i64
        {
            i64 v = 0;
            i64 base = 10;
            int i = 0;
            int d;
            bool neg = false;
            bool any = false;
            *ok = true;
            switch (n > 0)
            {
                case (true) {
                    switch (s[0] == '-' | s[0] == '+')
                    {
                        case (true) {
                            neg = s[0] == '-';
                            i = 1;
                        }
                        default {};
                    };
                }
                default {};
            };
            switch (i + 1 < n)
            {
                case (true) {
                    switch (s[i] == '0')
                    {
                        case (true) {
                            switch (s[i + 1] == 'x' | s[i + 1] == 'X')
                            {
                                case (true) { base = 16; i = i + 2; }
                                default {
                                    switch (s[i + 1] == 'o' | s[i + 1] == 'O')
                                    {
                                        case (true) { base = 8; i = i + 2; }
                                        default {
                                            switch (s[i + 1] == 'b' | s[i + 1] == 'B')
                                            {
                                                case (true) { base = 2; i = i + 2; }
                                                default {};
                                            };
                                        };
                                    };
                                };
                            };
                        }
                        default {};
                    };
                }
                default {};
            };
            while (i < n)
            {
                d = -1;
                switch (s[i] >= '0' & s[i] <= '9')
                {
                    case (true) { d = (int)s[i] - 48; }
                    default {
                        switch (s[i] >= 'a' & s[i] <= 'f')
                        {
                            case (true) { d = (int)s[i] - 87; }
                            default {
                                switch (s[i] >= 'A' & s[i] <= 'F')
                                {
                                    case (true) { d = (int)s[i] - 55; }
                                    default {};
                                };
                            };
                        };
                    };
                };
                switch (d < 0 | (i64)d >= base)
                {
                    case (true) {
                        *ok = false;
                        -> 0;
                    }
                    default {};
                };
                v = v * base + (i64)d;
                any = true;
                i++;
            };
            switch (!any)
            {
                case (true) { *ok = false; }
                default {};
            };
            switch (neg)
            {
                case (true) { -> (i64)0 - v; }
                default { -> v; };
            };
        };

        // ===== GROWABLE BYTE BUFFER =====
        // mem is always null terminated while allocated; len excludes the terminator.

        object FvmBuf
        {
            byte* mem;
            int len, cap;
            bool ok;

            __init() -> this
            {
                this.len = 0;
                this.cap = 256;
                this.ok = true;
                this.mem = (byte*)fmalloc((u64)this.cap);
                switch (this.mem == (byte*)0)
                {
                    case (true) {
                        this.ok = false;
                        this.cap = 0;
                    }
                    default {
                        this.mem[0] = 0;
                    };
                };
                -> this;
            };

            __expr() -> FvmBuf* -> this;

            __exit() -> void
            {
                switch (this.mem != (byte*)0)
                {
                    case (true) { ffree(this.mem); }
                    default {};
                };
                this.mem = (byte*)0;
                this.len = 0;
                this.cap = 0;
                ->;
            };

            reserve(int extra) -> bool
            {
                int need = this.len + extra + 1;
                int nc = this.cap;
                byte* np;
                switch (!this.ok)
                {
                    case (true) { -> false; }
                    default {};
                };
                switch (need <= this.cap)
                {
                    case (true) { -> true; }
                    default {};
                };
                switch (nc < 256)
                {
                    case (true) { nc = 256; }
                    default {};
                };
                while (nc < need) { nc = nc * 2; };
                np = idkvm_grow(this.mem, nc);
                switch (np == (byte*)0)
                {
                    case (true) {
                        this.ok = false;
                        -> false;
                    }
                    default
                    {
                        this.mem = np;
                        this.cap = nc;
                        -> true;
                    };
                };
            };

            put(int b) -> void
            {
                switch (!this.reserve(1))
                {
                    case (true) { ->; }
                    default
                    {
                        this.mem[this.len] = (byte)b;
                        this.len++;
                        this.mem[this.len] = 0;
                        ->;
                    };
                };
            };

            // s must not point into this buffer
            put_n(byte* s, int n) -> void
            {
                int i;
                switch (n <= 0)
                {
                    case (true) { ->; }
                    default {};
                };
                switch (!this.reserve(n))
                {
                    case (true) { ->; }
                    default {};
                };
                while (i < n)
                {
                    this.mem[this.len + i] = s[i];
                    i++;
                };
                this.len = this.len + n;
                this.mem[this.len] = 0;
                ->;
            };

            put_str(byte* s) -> void -> this.put_n(s, idkvm_strlen(s));

            // The integers of the IDKB binary format: unsigned varints (LEB128, a count, size
            // or index), zigzag varints for signed values, and raw little endian for a double
            put_uv(u64 v) -> void
            {
                u64 r = v;
                while (r >= (u64)128)
                {
                    this.put((int)((r `& (u64)127) `| (u64)128));
                    r = r >> 7;
                };
                this.put((int)r);
                ->;
            };

            put_u32(int v) -> void -> this.put_uv((u64)v);

            put_iv(i64 v) -> void
            {
                switch (v < (i64)0)
                {
                    case (true) { this.put_uv((((u64)((i64)0 - (v + (i64)1))) << 1) `| (u64)1); }
                    default { this.put_uv(((u64)v) << 1); };
                };
                ->;
            };

            put_le64(i64 v) -> void
            {
                int k;
                while (k < 8)
                {
                    this.put((int)((v >> (i64)(8 * k)) `& (i64)255));
                    k++;
                };
                ->;
            };

            put_i64(i64 v) -> void
            {
                byte[24] tmp = noinit;
                int n, k;
                i64 t;
                switch (v < (i64)0)
                {
                    case (true) {
                        this.put(45);
                        t = (i64)0 - v;
                    }
                    default { t = v; };
                };
                switch (t == (i64)0)
                {
                    case (true) {
                        this.put(48);
                        ->;
                    }
                    default {};
                };
                while (t > (i64)0)
                {
                    tmp[n] = (byte)(48 + (int)(t % (i64)10));
                    t = t / (i64)10;
                    n++;
                };
                k = n;
                while (k > 0)
                {
                    k--;
                    this.put((int)tmp[k]);
                };
                ->;
            };

            put_int(int v) -> void -> this.put_i64((i64)v);

            clear() -> void
            {
                this.len = 0;
                switch (this.mem != (byte*)0)
                {
                    case (true) { this.mem[0] = 0; }
                    default {};
                };
                ->;
            };
        };

        // ===== DOUBLES =====
        // Float and double values live in the stack and instruction slots as the bit
        // pattern of a double (a float literal is kept as a double, the way idkvm.py keeps
        // a Python float).

        idkvm_dbl_bits(double d) -> i64
        {
            double dd = d;
            i64* bp = (i64*)@dd;
            -> *bp;
        };

        idkvm_bits_dbl(i64 b) -> double
        {
            i64 bb = b;
            double* dp = (double*)@bb;
            -> *dp;
        };

        // A value is float valued when its tag is FLOAT or DOUBLE, or when it is an integer
        // tagged value carrying a float (idkvm.py keeps the Python float under the left tag):
        // that case is marked with IDKVM_FMARK in the meta slot.
        idkvm_isf(int tag, i64 m) -> bool
        {
            switch (tag == IDKVM_T_FLOAT | tag == IDKVM_T_DOUBLE)
            {
                case (true) { -> true; }
                default {};
            };
            -> idkvm_is_intlike(tag) & m == (i64)IDKVM_FMARK;
        };

        idkvm_isflt_tag(int tag) -> bool
        {
            -> tag == IDKVM_T_FLOAT | tag == IDKVM_T_DOUBLE;
        };

        // numeric value of a stack item as a double
        idkvm_dv(int tag, i64 d, i64 m) -> double
        {
            switch (idkvm_isf(tag, m))
            {
                case (true) { -> idkvm_bits_dbl(d); }
                default {};
            };
            switch (idkvm_is_unsigned(tag))
            {
                case (true) { -> (double)(u64)d; }
                default {};
            };
            -> (double)d;
        };

        // Python int(x) of a float
        idkvm_trunc(double v) -> i64
        {
            -> (i64)v;
        };

        // fptosi like the compiled code: truncate, the x86 integer indefinite value when out of range
        idkvm_cvt_i(double x, int bits) -> i64
        {
            double lim = (double)2147483648.0;
            i64 lo = -2147483648;
            switch (bits == 64)
            {
                case (true)
                {
                    lim = (double)2147483648.0 * (double)4294967296.0;
                    lo = (i64)-9223372036854775807 - (i64)1;
                }
                default {};
            };
            switch (x != x | x >= lim | x < -lim) { case (true) { -> lo; } default {}; };
            -> (i64)x;
        };

        // The text of float2str and dbl2str: the integer part, '.', the fraction with leading zeros
        idkvm_fixed_text(FvmBuf* o, bool neg, i64 ip, i64 fp, int prec) -> void
        {
            i64 t;
            int nd, z;
            switch (neg) { case (true) { o.put('-'); } default {}; };
            switch (ip == (i64)0)
            {
                case (true) { o.put('0'); }
                default { switch (ip > (i64)0) { case (true) { o.put_i64(ip); } default {}; }; };
            };
            switch (prec > 0)
            {
                case (true)
                {
                    o.put('.');
                    switch (fp == (i64)0)
                    {
                        case (true) { while (z < prec) { o.put('0'); z++; }; }
                        default
                        {
                            t = fp;
                            while (t > (i64)0) { nd++; t = t / (i64)10; };
                            while (z < prec - nd) { o.put('0'); z++; };
                            o.put_i64(fp);
                        };
                    };
                }
                default {};
            };
            ->;
        };

        // standard::strings::float2str as fstr_append(float) runs it: single precision arithmetic
        idkvm_float2str(FvmBuf* o, double dv) -> void
        {
            float v = (float)dv;
            bool neg = v < (float)0.0;
            float fl, sc;
            float mf = (float)1000000.0;
            i64 ip, fp;
            switch (neg) { case (true) { v = -v; } default {}; };
            switch (v == (float)0.0)
            {
                case (true) { idkvm_fixed_text(o, false, 0, 0, 6); ->; }
                default {};
            };
            ip = idkvm_cvt_i((double)v, 32);
            fl = v - (float)(int)ip;
            sc = fl * mf;
            fp = idkvm_cvt_i((double)(sc + (float)0.5), 32);
            switch (fp >= (i64)1000000) { case (true) { ip = ip + (i64)1; fp = 0; } default {}; };
            idkvm_fixed_text(o, neg, ip, fp, 6);
            ->;
        };

        // standard::strings::dbl2str as fstr_append(double) runs it
        idkvm_dbl2str(FvmBuf* o, double dv) -> void
        {
            double v = dv;
            bool neg = v < (double)0.0;
            double fl;
            i64 ip, fp;
            i64 mult = 100000000000000;
            switch (neg) { case (true) { v = -v; } default {}; };
            switch (v == (double)0.0)
            {
                case (true) { idkvm_fixed_text(o, false, 0, 0, 14); ->; }
                default {};
            };
            ip = idkvm_cvt_i(v, 64);
            fl = v - (double)ip;
            fp = idkvm_cvt_i(fl * (double)mult + (double)0.5, 64);
            switch (fp >= mult) { case (true) { ip = ip + (i64)1; fp = 0; } default {}; };
            idkvm_fixed_text(o, neg, ip, fp, 14);
            ->;
        };

        // 32 bit float bits to double and back (LOAD/STORE of FLOAT)
        idkvm_f32_dbl(i64 b) -> double
        {
            i64 bb = b `& (i64)4294967295;
            float* fp = (float*)@bb;
            float f = *fp;
            -> (double)f;
        };

        idkvm_dbl_f32(double d) -> i64
        {
            float f = (float)d;
            float ff = f;
            i64 r = 0;
            i64* rp = @r;
            float* fp = (float*)rp;
            *fp = ff;
            -> r `& (i64)4294967295;
        };

        // fmod: exact, by subtracting scaled copies of the divisor (b is not zero)
        idkvm_fmod(double a, double b) -> double
        {
            double r = a;
            double d = b;
            double t;
            bool neg = a < (double)0.0;
            switch (neg) { case (true) { r = (double)0.0 - a; } default {}; };
            switch (d < (double)0.0) { case (true) { d = (double)0.0 - d; } default {}; };
            while (r >= d)
            {
                t = d;
                while (t + t <= r) { t = t + t; };
                r = r - t;
            };
            switch (neg) { case (true) { -> (double)0.0 - r; } default {}; };
            -> r;
        };

        // The address of a C runtime function by name (idkvm.py looks in the C runtime:
        // msvcrt on Windows, the process then libc and libm elsewhere); 0 when not found
        idkvm_find_sym(byte* name) -> byte*
        {
            byte* sym;
            void* hl;
#ifdef __WINDOWS__
            hl = LoadLibraryA(g"msvcrt.dll\0");
            sym = (byte*)0;
            switch (hl != (void*)0) { case (true) { sym = GetProcAddress(hl, name); } default {}; };
            -> sym;
#endif;
#ifdef __LINUX__
            sym = dlsym((void*)0, name);
            switch (sym == (byte*)0)
            {
                case (true) {
                    hl = dlopen(g"libc.so.6\0", 1);
                    switch (hl != (void*)0) { case (true) { sym = dlsym(hl, name); } default {}; };
                }
                default {};
            };
            switch (sym == (byte*)0)
            {
                case (true) {
                    hl = dlopen(g"libm.so.6\0", 1);
                    switch (hl != (void*)0) { case (true) { sym = dlsym(hl, name); } default {}; };
                }
                default {};
            };
            -> sym;
#endif;
        };

        // pow of the C math library, the way idkvm.py's a ** b reaches it; ok is false when
        // the function cannot be found
        idkvm_pow(double a, double b, bool* ok) -> double
        {
            byte* sym = idkvm_find_sym(g"pow\0");
            double r;
            *ok = true;
            switch (sym == (byte*)0)
            {
                case (true) {
                    *ok = false;
                    -> (double)0.0;
                }
                default {};
            };
            def{}* fp(double, double) -> double = sym;
            r = fp(a, b);
            -> r;
        };

        // big += nothing: a is a little endian number in base 1e9, a *= m (m below 2^31)
        idkvm_big_mul(u64* a, int* n, u64 m) -> void
        {
            u64 carry, t;
            int i;
            while (i < *n)
            {
                t = a[i] * m + carry;
                a[i] = t % (u64)1000000000;
                carry = t / (u64)1000000000;
                i++;
            };
            while (carry > (u64)0)
            {
                a[*n] = carry % (u64)1000000000;
                carry = carry / (u64)1000000000;
                *n = *n + 1;
            };
            ->;
        };

        // Exact decimal digits of the positive finite double v (no leading zeros, at most 800 into out),
        // v = 0.DIGITS * 10^decpt. Returns the digit count.
        idkvm_double_digits(double v, byte* out, int* decpt) -> int
        {
            u64 ub = (u64)idkvm_dbl_bits(v);
            int ex = (int)((ub >> 52) `& (u64)2047);
            u64 fr = ub `& (u64)4503599627370495;
            u64 mant;
            int e2, k, n, i, nd, j;
            u64 m5, limb;
            u64* a = (u64*)idkvm_alloc(8 * 128);
            byte[12] tmp = noinit;
            switch (a == (u64*)0)
            {
                case (true) { *decpt = 0; out[0] = '0'; -> 1; }
                default {};
            };
            switch (ex == 0)
            {
                case (true) { mant = fr; e2 = -1074; }
                default { mant = fr `| (u64)4503599627370496; e2 = ex - 1075; };
            };
            a[0] = mant % (u64)1000000000;
            a[1] = (mant / (u64)1000000000) % (u64)1000000000;
            a[2] = mant / (u64)1000000000000000000;
            n = 3;
            while (n > 1 & a[n - 1] == (u64)0) { n--; };
            switch (e2 > 0)
            {
                case (true)
                {
                    k = e2;
                    while (k >= 29) { idkvm_big_mul(a, @n, 536870912); k = k - 29; };
                    switch (k > 0) { case (true) { idkvm_big_mul(a, @n, (u64)1 << k); } default {}; };
                }
                default {};
            };
            switch (e2 < 0)
            {
                case (true)
                {
                    k = 0 - e2;
                    while (k >= 13) { idkvm_big_mul(a, @n, 1220703125); k = k - 13; };
                    m5 = 1;
                    while (k > 0) { m5 = m5 * (u64)5; k--; };
                    switch (m5 > (u64)1) { case (true) { idkvm_big_mul(a, @n, m5); } default {}; };
                }
                default {};
            };
            // most significant limb without padding, the others with nine digits each
            i = n - 1;
            limb = a[i];
            j = 0;
            while (limb > (u64)0)
            {
                tmp[j] = (byte)(48 + (int)(limb % (u64)10));
                limb = limb / (u64)10;
                j++;
            };
            while (j > 0)
            {
                j--;
                out[nd] = tmp[j];
                nd++;
            };
            i--;
            while (i >= 0)
            {
                limb = a[i];
                j = 9;
                while (j > 0)
                {
                    j--;
                    tmp[j] = (byte)(48 + (int)(limb % (u64)10));
                    limb = limb / (u64)10;
                };
                j = 0;
                while (j < 9) { out[nd] = tmp[j]; nd++; j++; };
                i--;
            };
            switch (nd == 0) { case (true) { out[0] = '0'; nd = 1; } default {}; };
            out[nd] = 0;
            switch (e2 < 0)
            {
                case (true) { *decpt = nd + e2; }
                default { *decpt = nd; };
            };
            ffree((byte*)a);
            -> nd;
        };

        // The first p of the nd digits in dg rounded to nearest (ties to even), or rounded up
        // when up is set and anything is cut. Written to out (p digits, NUL terminated);
        // *decpt grows by one when the rounding carries out of the first digit.
        idkvm_round_digits(byte* dg, int nd, int p, byte* out, int* decpt, bool up) -> void
        {
            int i;
            bool inc, rest;
            int c;
            while (i < p)
            {
                switch (i < nd) { case (true) { out[i] = dg[i]; } default { out[i] = '0'; }; };
                i++;
            };
            out[p] = 0;
            switch (nd > p)
            {
                case (true)
                {
                    i = p + 1;
                    while (i < nd) { switch (dg[i] != '0') { case (true) { rest = true; } default {}; }; i++; };
                    c = (int)dg[p];
                    switch (up)
                    {
                        case (true) { inc = c != '0' | rest; }
                        default
                        {
                            switch (c > '5' | (c == '5' & rest)) { case (true) { inc = true; } default {}; };
                            switch (c == '5' & !rest & ((int)out[p - 1] - '0') % 2 == 1) { case (true) { inc = true; } default {}; };
                        };
                    };
                }
                default {};
            };
            i = p;
            while (inc & i > 0)
            {
                i--;
                switch (out[i] == '9')
                {
                    case (true) { out[i] = '0'; }
                    default { out[i] = (byte)((int)out[i] + 1); inc = false; };
                };
            };
            switch (inc)
            {
                case (true)
                {
                    // carry out of the first digit: 999 becomes 100 with the point one place up
                    out[0] = '1';
                    *decpt = *decpt + 1;
                }
                default {};
            };
            ->;
        };

        // true when s[0, n) is a float literal as Python float() reads it: optional sign,
        // digits with an optional point and exponent, inf, infinity or nan
        idkvm_float_syntax(byte* s, int n) -> bool
        {
            int i, nd, m;
            while (i < n & (s[i] == ' ' | s[i] == '\t' | s[i] == '\n' | s[i] == '\r')) { i++; };
            while (n > i & (s[n - 1] == ' ' | s[n - 1] == '\t' | s[n - 1] == '\n' | s[n - 1] == '\r')) { n--; };
            switch (i < n & (s[i] == '+' | s[i] == '-')) { case (true) { i++; } default {}; };
            m = n - i;
            switch (m == 3 | m == 8)
            {
                case (true)
                {
                    switch (idkvm_eq_ci(s + i, m, g"inf\0") | idkvm_eq_ci(s + i, m, g"nan\0") | idkvm_eq_ci(s + i, m, g"infinity\0")) { case (true) { -> true; } default {}; };
                }
                default {};
            };
            while (i < n & s[i] >= '0' & s[i] <= '9') { i++; nd++; };
            switch (i < n & s[i] == '.')
            {
                case (true)
                {
                    i++;
                    while (i < n & s[i] >= '0' & s[i] <= '9') { i++; nd++; };
                }
                default {};
            };
            switch (nd == 0) { case (true) { -> false; } default {}; };
            switch (i < n & (s[i] == 'e' | s[i] == 'E'))
            {
                case (true)
                {
                    i++;
                    switch (i < n & (s[i] == '+' | s[i] == '-')) { case (true) { i++; } default {}; };
                    nd = 0;
                    while (i < n & s[i] >= '0' & s[i] <= '9') { i++; nd++; };
                    switch (nd == 0) { case (true) { -> false; } default {}; };
                }
                default {};
            };
            -> i == n;
        };

        // Parses all of s[0, n) as a float, ok is false when it is not one
        idkvm_parse_double(byte* s, int n, bool* ok) -> double
        {
            byte* z;
            double r;
            *ok = false;
            switch (n == 0 | !idkvm_float_syntax(s, n))
            {
                case (true) { -> 0.0; }
                default {};
            };
            z = idkvm_dup(s, n);
            switch (z == (byte*)0) { case (true) { -> 0.0; } default {}; };
            r = strtod(z, (byte**)0);
            ffree(z);
            *ok = true;
            -> r;
        };

        // Python repr(float(v)): the shortest digits that read back as v, fixed notation
        // for decimal exponents -4 to 15 and d.ddde+XX otherwise.
        idkvm_put_double(FvmBuf* o, double v) -> void
        {
            i64 bits = idkvm_dbl_bits(v);
            u64 ub = (u64)bits;
            int ex = (int)((ub >> 52) `& (u64)2047);
            int decpt, dpx, ndx, p, nd, i, k, ee;
            byte[820] exact = noinit;
            byte[24] rd = noinit;
            bool pow2;
            double a = v;
            double back;
            bool neg = (ub >> 63) != (u64)0;
            bool ok, found;
            FvmBuf cb, db;
            switch (ex == 2047)
            {
                case (true)
                {
                    switch ((ub `& (u64)4503599627370495) != (u64)0)
                    {
                        case (true) { o.put_str(g"nan\0"); ->; }
                        default {};
                    };
                    switch (neg) { case (true) { o.put(45); } default {}; };
                    o.put_str(g"inf\0");
                    ->;
                }
                default {};
            };
            switch (neg) { case (true) { o.put(45); a = (double)0.0 - v; } default {}; };
            switch (ex == 0 & (ub `& (u64)4503599627370495) == (u64)0)
            {
                case (true) { o.put_str(g"0.0\0"); ->; }
                default {};
            };
            cb.__init();
            defer cb.__exit();
            db.__init();
            defer db.__exit();
            ndx = idkvm_double_digits(a, exact, @dpx);
            pow2 = ex > 0 & (ub `& (u64)4503599627370495) == (u64)0;
            p = 1;
            while (p <= 17 & !found)
            {
                decpt = dpx;
                idkvm_round_digits(exact, ndx, p, rd, @decpt, false);
                cb.clear();
                cb.put_str(g"0.\0");
                cb.put_str(rd);
                cb.put(101);
                switch (decpt < 0) { case (true) { cb.put(45); cb.put_int(0 - decpt); } default { cb.put_int(decpt); }; };
                back = idkvm_parse_double(cb.mem, cb.len, @ok);
                switch (back == a)
                {
                    case (true) { found = true; }
                    default {};
                };
                switch (!found & pow2)
                {
                    case (true)
                    {
                        // at a power of two the interval above is wider than the one below
                        decpt = dpx;
                        idkvm_round_digits(exact, ndx, p, rd, @decpt, true);
                        cb.clear();
                        cb.put_str(g"0.\0");
                        cb.put_str(rd);
                        cb.put(101);
                        switch (decpt < 0) { case (true) { cb.put(45); cb.put_int(0 - decpt); } default { cb.put_int(decpt); }; };
                        back = idkvm_parse_double(cb.mem, cb.len, @ok);
                        switch (back == a) { case (true) { found = true; } default {}; };
                    }
                    default {};
                };
                switch (!found) { case (true) { p++; } default {}; };
            };
            switch (!found)
            {
                case (true)
                {
                    p = 17;
                    decpt = dpx;
                    idkvm_round_digits(exact, ndx, p, rd, @decpt, false);
                }
                default {};
            };
            db.put_str(rd);
            nd = db.len;
            while (nd > 1 & db.mem[nd - 1] == '0') { nd--; };
            switch (decpt <= 0 - 4 | decpt > 16)
            {
                case (true)
                {
                    o.put((int)db.mem[0]);
                    switch (nd > 1)
                    {
                        case (true)
                        {
                            o.put(46);
                            i = 1;
                            while (i < nd) { o.put((int)db.mem[i]); i++; };
                        }
                        default {};
                    };
                    o.put(101);
                    ee = decpt - 1;
                    switch (ee < 0) { case (true) { o.put(45); ee = 0 - ee; } default { o.put(43); }; };
                    switch (ee < 10) { case (true) { o.put(48); } default {}; };
                    o.put_int(ee);
                    ->;
                }
                default {};
            };
            switch (decpt <= 0)
            {
                case (true)
                {
                    o.put_str(g"0.\0");
                    k = 0;
                    while (k < 0 - decpt) { o.put(48); k++; };
                    i = 0;
                    while (i < nd) { o.put((int)db.mem[i]); i++; };
                    ->;
                }
                default {};
            };
            switch (decpt >= nd)
            {
                case (true)
                {
                    i = 0;
                    while (i < nd) { o.put((int)db.mem[i]); i++; };
                    k = nd;
                    while (k < decpt) { o.put(48); k++; };
                    o.put_str(g".0\0");
                    ->;
                }
                default {};
            };
            i = 0;
            while (i < decpt) { o.put((int)db.mem[i]); i++; };
            o.put(46);
            while (i < nd) { o.put((int)db.mem[i]); i++; };
            ->;
        };

        // ===== STUB COUNTERS =====
        // Names are counted the way fcodegen counts unsupported nodes. The name
        // pointers are kept, so they must stay valid (string literals do).

        object FvmStubs
        {
            byte** names;
            int* counts;
            int n, cap, total;
            bool ok;

            __init() -> this
            {
                this.n = 0;
                this.total = 0;
                this.cap = 32;
                this.ok = true;
                this.names = (byte**)idkvm_alloc(this.cap * 8);
                this.counts = (int*)idkvm_alloc(this.cap * 4);
                switch (this.names == (byte**)0 | this.counts == (int*)0)
                {
                    case (true) { this.ok = false; }
                    default {};
                };
                -> this;
            };

            __expr() -> FvmStubs* -> this;

            __exit() -> void
            {
                switch (this.names != (byte**)0)
                {
                    case (true) { ffree((byte*)this.names); }
                    default {};
                };
                switch (this.counts != (int*)0)
                {
                    case (true) { ffree((byte*)this.counts); }
                    default {};
                };
                this.names = (byte**)0;
                this.counts = (int*)0;
                this.n = 0;
                ->;
            };

            note(byte* what) -> void
            {
                int i;
                byte** nn;
                int* nc;
                int ncap;
                switch (!this.ok)
                {
                    case (true) { ->; }
                    default {};
                };
                this.total++;
                while (i < this.n)
                {
                    switch (idkvm_streq(this.names[i], what))
                    {
                        case (true) {
                            this.counts[i] = this.counts[i] + 1;
                            ->;
                        }
                        default
                        {
                            i++;
                        };
                    };
                };
                switch (this.n >= this.cap)
                {
                    case (true) {
                        ncap = this.cap * 2;
                        nn = (byte**)idkvm_grow((byte*)this.names, ncap * 8);
                        nc = (int*)idkvm_grow((byte*)this.counts, ncap * 4);
                        switch (nn == (byte**)0 | nc == (int*)0)
                        {
                            case (true) {
                                this.ok = false;
                                ->;
                            }
                            default {};
                        };
                        this.names = nn;
                        this.counts = nc;
                        this.cap = ncap;
                    }
                    default {};
                };
                this.names[this.n] = what;
                this.counts[this.n] = 1;
                this.n++;
                ->;
            };

            // Prints "<title> Stub summary:" with one line per counted name
            report(byte* title) -> void
            {
                int i;
                switch (this.n == 0)
                {
                    case (true) { ->; }
                    default {};
                };
                standard::io::console::print(title);
                standard::io::console::println(g" Stub summary:\0");
                while (i < this.n)
                {
                    standard::io::console::print(g"  not ported yet: \0");
                    standard::io::console::print(this.names[i]);
                    standard::io::console::print(g" x \0");
                    standard::io::console::println(this.counts[i]);
                    i++;
                };
                standard::io::console::print(g"  stub hits total: \0");
                standard::io::console::println(this.total);
                ->;
            };
        };

        // ===== VM HEAP (VMHeap) =====
        // First fit allocator over a fixed arena. Offset 0 is the null pointer.

        object FvmHeap
        {
            byte* mem;
            int size, bump, n, cap;
            int* ptrs, sizes, live;
            bool ok;

            __init() -> this
            {
                this.size = IDKVM_HEAP_SIZE;
                this.bump = IDKVM_HEAP_BASE;
                this.n = 0;
                this.cap = 64;
                this.ok = true;
                this.mem = idkvm_alloc(this.size);
                this.ptrs = (int*)idkvm_alloc(this.cap * 4);
                this.sizes = (int*)idkvm_alloc(this.cap * 4);
                this.live = (int*)idkvm_alloc(this.cap * 4);
                switch (this.mem == (byte*)0 | this.ptrs == (int*)0 | this.sizes == (int*)0 | this.live == (int*)0)
                {
                    case (true) { this.ok = false; }
                    default {};
                };
                -> this;
            };

            __expr() -> FvmHeap* -> this;

            __exit() -> void
            {
                switch (this.mem != (byte*)0)
                {
                    case (true) { ffree(this.mem); }
                    default {};
                };
                switch (this.ptrs != (int*)0)
                {
                    case (true) { ffree((byte*)this.ptrs); }
                    default {};
                };
                switch (this.sizes != (int*)0)
                {
                    case (true) { ffree((byte*)this.sizes); }
                    default {};
                };
                switch (this.live != (int*)0)
                {
                    case (true) { ffree((byte*)this.live); }
                    default {};
                };
                this.mem = (byte*)0;
                this.ptrs = (int*)0;
                this.sizes = (int*)0;
                this.live = (int*)0;
                ->;
            };

            // Offset of a new block of sz bytes, 0 when out of memory or sz <= 0
            alloc(int sz) -> int
            {
                int i, p, k, nc;
                int* a, b, c;
                switch (sz <= 0 | !this.ok)
                {
                    case (true) { -> 0; }
                    default {};
                };
                while (i < this.n)
                {
                    switch (this.live[i] == 0 & this.sizes[i] >= sz)
                    {
                        case (true) {
                            p = this.ptrs[i];
                            this.live[i] = 1;
                            this.sizes[i] = sz;
                            k = 0;
                            while (k < sz)
                            {
                                this.mem[p + k] = 0;
                                k++;
                            };
                            -> p;
                        }
                        default
                        {
                            i++;
                        };
                    };
                };
                switch (this.bump + sz > this.size)
                {
                    case (true) { -> 0; }
                    default {};
                };
                switch (this.n >= this.cap)
                {
                    case (true) {
                        nc = this.cap * 2;
                        a = (int*)idkvm_grow((byte*)this.ptrs, nc * 4);
                        b = (int*)idkvm_grow((byte*)this.sizes, nc * 4);
                        c = (int*)idkvm_grow((byte*)this.live, nc * 4);
                        switch (a == (int*)0 | b == (int*)0 | c == (int*)0)
                        {
                            case (true) {
                                this.ok = false;
                                -> 0;
                            }
                            default {};
                        };
                        this.ptrs = a;
                        this.sizes = b;
                        this.live = c;
                        this.cap = nc;
                    }
                    default {};
                };
                p = this.bump;
                this.bump = (this.bump + sz + 7) / 8 * 8;
                this.ptrs[this.n] = p;
                this.sizes[this.n] = sz;
                this.live[this.n] = 1;
                this.n++;
                -> p;
            };

            // False when p is not the start of a live block
            free(int p) -> bool
            {
                int i;
                while (i < this.n)
                {
                    switch (this.ptrs[i] == p & this.live[i] == 1)
                    {
                        case (true) {
                            this.live[i] = 0;
                            -> true;
                        }
                        default
                        {
                            i++;
                        };
                    };
                };
                -> false;
            };

            // _check: ptr < 8 or past the end is out of bounds
            in_bounds(i64 p, int sz) -> bool
            {
                switch (p < (i64)8 | p + (i64)sz > (i64)this.size)
                {
                    case (true) { -> false; }
                    default { -> true; };
                };
            };

            // Little endian unsigned read of sz bytes
            rd(int p, int sz) -> i64
            {
                i64 v = 0;
                int k = sz - 1;
                while (k >= 0)
                {
                    v = (v << 8) `| ((i64)this.mem[p + k] `& (i64)255);
                    k--;
                };
                -> v;
            };

            wr(int p, int sz, i64 v) -> void
            {
                int k;
                i64 t = v;
                while (k < sz)
                {
                    this.mem[p + k] = (byte)(t `& (i64)255);
                    t = t >> 8;
                    k++;
                };
                ->;
            };
        };

        // ===== INSTRUCTION POOL =====
        // Every instruction of every code unit lives in one set of parallel
        // arrays. A unit (a function body or the main block) is a start and a
        // length. Jump targets are indexes relative to the start of the unit.
        //   op     opcode
        //   a b c  integer operands, meaning depends on the opcode:
        //            PUSH       a tag, b data, c meta
        //            JMP JIF JNF TRY_BEGIN LOCAL_GET LOCAL_SET TAIL_SELF EMIT_GLOBAL CALL_PTR
        //                       a operand
        //            JTABLE     a default address, b entry count, s the i64 entry table
        //            CALL       a argc, s function name
        //            LOAD STORE a ttag, b byte size, s optional struct name
        //            CAST BITCAST a ttag, s optional struct name
        //            ARRAY_NEW  a count, s element type name
        //            FFI_CALL   a argc, b ttag
        //            EXTERN_DECL a return ttag, s name
        //            EMITIDEKA   s source text, a variable count, c FvmVars*
        //   s      string operand (name), null when unused
        //   line   source line, 0 when unknown

        struct FvmVars
        {
            byte** names;
            int* slots;
            int n;
        };

        // A binding list of n entries (names and slots are filled by the caller), null on failure
        idkvm_vars_new(int n) -> FvmVars*
        {
            FvmVars* v = (FvmVars*)idkvm_alloc(sizeof(FvmVars) / 8);
            switch (v == (FvmVars*)0) { case (true) { -> v; } default {}; };
            v.names = (byte**)idkvm_alloc((n + 1) * 8);
            v.slots = (int*)idkvm_alloc((n + 1) * 4);
            v.n = n;
            switch (v.names == (byte**)0 | v.slots == (int*)0) { case (true) { -> (FvmVars*)0; } default {}; };
            -> v;
        };

        // True when image starts with the IDKB magic
        idkvm_is_bin_image(byte* image, int len) -> bool
        {
            -> len >= 4 & image[0] == 'I' & image[1] == 'D' & image[2] == 'K' & image[3] == 'B';
        };

        // One string of the --strings listing: \\, newline, return, tab and other control bytes
        // escaped, then a newline
        idkvm_put_esc_line(FvmBuf* o, byte* s, int n) -> void
        {
            int k, c, hx;
            while (k < n)
            {
                c = (int)s[k];
                switch (c)
                {
                    case (92) { o.put_str(g"\\\\\0"); }
                    case (10) { o.put_str(g"\\n\0"); }
                    case (13) { o.put_str(g"\\r\0"); }
                    case (9) { o.put_str(g"\\t\0"); }
                    default
                    {
                        switch (c < 32 | c == 127)
                        {
                            case (true) {
                                o.put_str(g"\\x\0");
                                hx = c >> 4;
                                switch (hx < 10) { case (true) { o.put(48 + hx); } default { o.put(87 + hx); }; };
                                hx = c `& 15;
                                switch (hx < 10) { case (true) { o.put(48 + hx); } default { o.put(87 + hx); }; };
                            }
                            default { o.put(c); };
                        };
                    };
                };
                k++;
            };
            o.put(10);
            ->;
        };

        // "N word", the word in the plural unless N is 1
        idkvm_put_pl(FvmBuf* o, int n, byte* word) -> void
        {
            o.put_int(n);
            o.put(32);
            o.put_str(word);
            switch (n != 1) { case (true) { o.put(115); } default {}; };
            ->;
        };

        // ---- Lint of emitted source: Allman braces, four space indentation, normal spacing ----
        // (mirrors lint_IDEKA_source of idkvm.py)

        struct FvmLint
        {
            int* pa_s;          // open parentheses: first part index, and whether an operand preceded
            int* pa_o;
            byte** pp;          // the parts of the current line
            int* pl;
            byte* lp;           // the last part, null at the start of a line
            FvmBuf* cur, out;
            byte* prefix;
            int np, psn, ll;
            int lu;             // the last part was a unary operator
            int lc;             // the last part closed a cast
            int lptr;           // the last part was the star of a pointer type
            int depth;
        };

        // t[0..l) is exactly the text lit
        idkvm_lint_eq(byte* t, int l, byte* lit) -> bool
        {
            int i;
            switch (idkvm_strlen(lit) != l) { case (true) { -> false; } default {}; };
            while (i < l)
            {
                switch (t[i] != lit[i]) { case (true) { -> false; } default {}; };
                i++;
            };
            -> true;
        };

        // t[0..l) is one of the space separated words
        idkvm_lint_word(byte* t, int l, byte* words) -> bool
        {
            int i = 0;
            int st, k;
            while (words[i] != 0)
            {
                while (words[i] == 32) { i++; };
                st = i;
                while (words[i] != 0 & words[i] != 32) { i++; };
                switch (i - st == l & l > 0)
                {
                    case (true) {
                        k = 0;
                        while (k < l & t[k] == words[st + k]) { k++; };
                        switch (k == l) { case (true) { -> true; } default {}; };
                    }
                    default {};
                };
            };
            -> false;
        };

        idkvm_lint_type(byte* t, int l) -> bool
        {
            -> idkvm_lint_word(t, l, g"byte char bool int uint long ulong short ushort float double void data i8 i16 i32 i64 u8 u16 u32 u64\0");
        };

        idkvm_lint_kw(byte* t, int l) -> bool
        {
            -> idkvm_lint_word(t, l, g"if while for switch case return in is and or not else elif catch throw assert\0");
        };

        // True when t can end an operand
        idkvm_lint_operand(byte* t, int l) -> bool
        {
            int c;
            switch (t == (byte*)0) { case (true) { -> false; } default {}; };
            switch (idkvm_lint_kw(t, l)) { case (true) { -> false; } default {}; };
            switch (idkvm_lint_eq(t, l, g")\0") | idkvm_lint_eq(t, l, g"]\0") | idkvm_lint_eq(t, l, g"{}\0")) { case (true) { -> true; } default {}; };
            c = (int)t[0];
            -> (c >= 'a' & c <= 'z') | (c >= 'A' & c <= 'Z') | (c >= '0' & c <= '9') | c == '_' | c == '"' | c == 39 | c >= 128;
        };

        idkvm_lint_flush(FvmLint* s) -> void
        {
            int i;
            switch (s.cur.len > 0)
            {
                case (true) {
                    s.out.put_str(s.prefix);
                    while (i < s.depth * 4) { s.out.put(32); i++; };
                    s.out.put_str(s.cur.mem);
                    s.out.put(10);
                }
                default {};
            };
            s.cur.len = 0;
            s.cur.mem[0] = 0;
            s.np = 0;
            s.lp = (byte*)0;
            s.ll = 0;
            s.lu = 0;
            s.lc = 0;
            s.lptr = 0;
            s.psn = 0;
            ->;
        };

        idkvm_lint_add(FvmLint* s, byte* t, int l) -> void
        {
            int unary, ptr, cast, sp, k, st, ao;
            bool lop = idkvm_lint_operand(s.lp, s.ll);
            unary = 0;
            ptr = 0;
            cast = 0;
            sp = 1;
            switch (idkvm_lint_eq(t, l, g"*\0") & s.lp != (byte*)0 & (idkvm_lint_type(s.lp, s.ll) | s.lptr != 0))
            {
                case (true) { ptr = 1; }
                default {
                    switch (idkvm_lint_word(t, l, g"- + * & @ ! ~\0") & (!lop | s.lc != 0)) { case (true) { unary = 1; } default {}; };
                };
            };
            switch (s.lp == (byte*)0 | s.lu != 0 | s.lc != 0)
            {
                case (true) { sp = 0; }
                default
                {
                    switch (idkvm_lint_word(t, l, g", ; ) ] . ::\0") | idkvm_lint_word(s.lp, s.ll, g"( [ . ::\0"))
                    {
                        case (true) { sp = 0; }
                        default
                        {
                            switch (idkvm_lint_eq(t, l, g"(\0"))
                            {
                                case (true) { sp = (int)(!lop | idkvm_lint_kw(s.lp, s.ll)); }
                                default
                                {
                                    switch (idkvm_lint_eq(t, l, g"[\0"))
                                    {
                                        case (true) { sp = (int)!(lop | s.lptr != 0); }
                                        default
                                        {
                                            switch (ptr != 0)
                                            {
                                                case (true) { sp = 0; }
                                                default
                                                {
                                                    switch ((idkvm_lint_eq(t, l, g"++\0") | idkvm_lint_eq(t, l, g"--\0")) & lop)
                                                    {
                                                        case (true) { sp = 0; }
                                                        default
                                                        {
                                                            switch (s.lptr != 0 & idkvm_lint_word(t, l, g") [ , ; >\0")) { case (true) { sp = 0; } default {}; };
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };
            switch (idkvm_lint_eq(t, l, g"(\0"))
            {
                case (true) {
                    s.pa_s[s.psn] = s.np + 1;
                    s.pa_o[s.psn] = lop;
                    s.psn++;
                }
                default
                {
                    switch (idkvm_lint_eq(t, l, g")\0") & s.psn > 0)
                    {
                        case (true) {
                            s.psn--;
                            st = s.pa_s[s.psn];
                            ao = s.pa_o[s.psn];
                            k = s.np - st;
                            switch (ao == 0 & k > 0)
                            {
                                case (true) {
                                    switch (k == 1 & idkvm_lint_type(s.pp[st], s.pl[st])) { case (true) { cast = 1; } default {}; };
                                    switch (k > 1)
                                    {
                                        case (true) {
                                            cast = (int)(idkvm_lint_type(s.pp[st], s.pl[st]) | idkvm_lint_operand(s.pp[st], s.pl[st]));
                                            k = st + 1;
                                            while (k < s.np)
                                            {
                                                switch (!idkvm_lint_eq(s.pp[k], s.pl[k], g"*\0")) { case (true) { cast = 0; } default {}; };
                                                k++;
                                            };
                                        }
                                        default {};
                                    };
                                }
                                default {};
                            };
                        }
                        default {};
                    };
                };
            };
            switch (sp != 0) { case (true) { s.cur.put(32); } default {}; };
            s.cur.put_n(t, l);
            s.pp[s.np] = t;
            s.pl[s.np] = l;
            s.np++;
            s.lp = t;
            s.ll = l;
            s.lu = unary;
            s.lc = cast;
            s.lptr = ptr;
            ->;
        };

        // Formats one piece of emitted source into o, every line led by prefix. *depth is the
        // block depth the piece starts at and the depth it leaves.
        idkvm_lint_IDEKA(FvmBuf* o, byte* prefix, byte* text, int* depth) -> void
        {
            int n = idkvm_strlen(text);
            int i = 0;
            int j, nt, paren, q;
            int* ts = (int*)idkvm_alloc((n + 2) * 4);
            int* tl = (int*)idkvm_alloc((n + 2) * 4);
            FvmLint st;
            FvmBuf cb;
            byte* t;
            int l;
            bool more;
            cb.__init();
            defer cb.__exit();
            st.pa_s = (int*)idkvm_alloc((n + 2) * 4);
            st.pa_o = (int*)idkvm_alloc((n + 2) * 4);
            st.pp = (byte**)idkvm_alloc((n + 2) * 8);
            st.pl = (int*)idkvm_alloc((n + 2) * 4);
            switch (ts == (int*)0 | tl == (int*)0 | st.pa_s == (int*)0 | st.pa_o == (int*)0 | st.pp == (byte**)0 | st.pl == (int*)0) { case (true) { ->; } default {}; };
            // tokens: runs between white space, strings kept whole
            nt = 0;
            while (i < n)
            {
                switch (text[i] == 32 | text[i] == 9 | text[i] == 13 | text[i] == 10)
                {
                    case (true) { i++; }
                    default
                    {
                        j = i;
                        while (j < n & text[j] != 32 & text[j] != 9 & text[j] != 13 & text[j] != 10)
                        {
                            switch (text[j] == '"' | text[j] == 39)
                            {
                                case (true) {
                                    q = (int)text[j];
                                    j++;
                                    while (j < n & (int)text[j] != q)
                                    {
                                        switch (text[j] == 92) { case (true) { j = j + 2; } default { j++; }; };
                                    };
                                    j++;
                                }
                                default { j++; };
                            };
                        };
                        switch (j > n) { case (true) { j = n; } default {}; };
                        ts[nt] = i;
                        tl[nt] = j - i;
                        nt++;
                        i = j;
                    };
                };
            };
            st.cur = @cb;
            st.out = o;
            st.prefix = prefix;
            st.depth = *depth;
            st.np = 0;
            st.psn = 0;
            st.lp = (byte*)0;
            st.ll = 0;
            st.lu = 0;
            st.lc = 0;
            st.lptr = 0;
            paren = 0;
            i = 0;
            while (i < nt)
            {
                t = text + ts[i];
                l = tl[i];
                more = i + 1 < nt;
                switch (idkvm_lint_eq(t, l, g"{\0") & paren == 0)
                {
                    case (true) {
                        switch (more)
                        {
                            case (true) { more = idkvm_lint_eq(text + ts[i + 1], tl[i + 1], g"}\0"); }
                            default {};
                        };
                        switch (more)
                        {
                            case (true) {
                                idkvm_lint_add(@st, g"{}\0", 2);
                                i = i + 2;
                                continue;
                            }
                            default {};
                        };
                        idkvm_lint_flush(@st);
                        j = 0;
                        o.put_str(prefix);
                        while (j < st.depth * 4) { o.put(32); j++; };
                        o.put_str(g"{\n\0");
                        st.depth++;
                    }
                    default
                    {
                        switch (idkvm_lint_eq(t, l, g"}\0") & paren == 0)
                        {
                            case (true) {
                                idkvm_lint_flush(@st);
                                switch (st.depth > 0) { case (true) { st.depth--; } default {}; };
                                cb.put(125);
                                st.pp[0] = g"}\0";
                                st.pl[0] = 1;
                                st.np = 1;
                                st.lp = g"}\0";
                                st.ll = 1;
                                switch (more & idkvm_lint_eq(text + ts[i + 1], tl[i + 1], g";\0"))
                                {
                                    case (true) {
                                        cb.put(59);
                                        i++;
                                        idkvm_lint_flush(@st);
                                    }
                                    default
                                    {
                                        switch (!(more & idkvm_lint_eq(text + ts[i + 1], tl[i + 1], g"if\0"))) { case (true) { idkvm_lint_flush(@st); } default {}; };
                                    };
                                };
                            }
                            default
                            {
                                switch (idkvm_lint_eq(t, l, g";\0") & paren == 0)
                                {
                                    case (true) {
                                        idkvm_lint_add(@st, t, l);
                                        idkvm_lint_flush(@st);
                                    }
                                    default
                                    {
                                        switch (idkvm_lint_eq(t, l, g"(\0")) { case (true) { paren++; } default {}; };
                                        switch (idkvm_lint_eq(t, l, g")\0") & paren > 0) { case (true) { paren--; } default {}; };
                                        idkvm_lint_add(@st, t, l);
                                    };
                                };
                            };
                        };
                    };
                };
                i++;
            };
            idkvm_lint_flush(@st);
            *depth = st.depth;
            ->;
        };

        // ---- LZSS of the IDKB payload (_lz_compress and _lz_decompress of idkvm.py) ----
        // Groups of one control byte and up to eight items, the lowest bit first. A clear bit is
        // a literal byte; a set bit is a match of two bytes: the low 8 bits of (offset - 1), then
        // the high 4 bits of (offset - 1) above (length - 3). Window 4096, lengths 3 to 18; the
        // longest match wins, the nearest on a tie; 64 candidates of the three byte hash chain.

        idkvm_lz_hash(int a, int b, int c) -> int
        {
            -> ((a << 8) `^| (b << 4) `^| c) `& 4095;
        };

        // Compresses d[0..n) into out. False when memory runs out.
        idkvm_lz_compress(byte* d, int n, FvmBuf* out) -> bool
        {
            int* head = (int*)idkvm_alloc(4096 * 4);
            int* prev = (int*)idkvm_alloc((n + 1) * 4);
            byte[16] grp = noinit;
            int i, k, c, h, e, best, boff, maxl, tried, ctl, nbit, gl;
            switch (head == (int*)0 | prev == (int*)0)
            {
                case (true) {
                    switch (head != (int*)0) { case (true) { ffree((byte*)head); } default {}; };
                    switch (prev != (int*)0) { case (true) { ffree((byte*)prev); } default {}; };
                    -> false;
                }
                default {};
            };
            i = 0;
            while (i < 4096) { head[i] = -1; i++; };
            i = 0;
            while (i < n) { prev[i] = -1; i++; };
            i = 0;
            while (i < n)
            {
                best = 0;
                boff = 0;
                switch (i + 2 < n)
                {
                    case (true) {
                        c = head[idkvm_lz_hash((int)d[i], (int)d[i + 1], (int)d[i + 2])];
                        maxl = 18;
                        switch (n - i < maxl) { case (true) { maxl = n - i; } default {}; };
                        tried = 0;
                        while (c >= 0 & tried < 64 & i - c <= 4096)
                        {
                            k = 0;
                            while (k < maxl & d[c + k] == d[i + k]) { k++; };
                            switch (k > best)
                            {
                                case (true) {
                                    best = k;
                                    boff = i - c;
                                }
                                default {};
                            };
                            switch (best == maxl)
                            {
                                case (true) { c = -1; }
                                default
                                {
                                    c = prev[c];
                                    tried++;
                                };
                            };
                        };
                    }
                    default {};
                };
                switch (best >= 3)
                {
                    case (true) {
                        ctl = ctl `| (1 << nbit);
                        grp[gl] = (byte)((boff - 1) `& 255);
                        grp[gl + 1] = (byte)((((boff - 1) >> 8) << 4) `| (best - 3));
                        gl = gl + 2;
                        k = 0;
                        while (k < best)
                        {
                            e = i + k;
                            switch (e + 2 < n)
                            {
                                case (true) {
                                    h = idkvm_lz_hash((int)d[e], (int)d[e + 1], (int)d[e + 2]);
                                    prev[e] = head[h];
                                    head[h] = e;
                                }
                                default {};
                            };
                            k++;
                        };
                        i = i + best;
                    }
                    default
                    {
                        grp[gl] = d[i];
                        gl++;
                        switch (i + 2 < n)
                        {
                            case (true) {
                                h = idkvm_lz_hash((int)d[i], (int)d[i + 1], (int)d[i + 2]);
                                prev[i] = head[h];
                                head[h] = i;
                            }
                            default {};
                        };
                        i++;
                    };
                };
                nbit++;
                switch (nbit == 8)
                {
                    case (true) {
                        out.put(ctl);
                        out.put_n(grp, gl);
                        ctl = 0;
                        nbit = 0;
                        gl = 0;
                    }
                    default {};
                };
            };
            switch (nbit > 0)
            {
                case (true) {
                    out.put(ctl);
                    out.put_n(grp, gl);
                }
                default {};
            };
            ffree((byte*)head);
            ffree((byte*)prev);
            -> out.ok;
        };

        // The raw_len bytes c[0..cl) decompress to, null with *err 1 (end of file), 2 (damaged
        // data) or 3 (out of memory)
        idkvm_lz_decompress(byte* c, int cl, int raw_len, int* err) -> byte*
        {
            byte* out = idkvm_alloc(raw_len + 1);
            int p, o, ctl, bit, off, n, k;
            *err = 0;
            switch (out == (byte*)0) { case (true) { *err = 3; -> out; } default {}; };
            while (o < raw_len)
            {
                switch (p >= cl) { case (true) { *err = 1; ffree(out); -> (byte*)0; } default {}; };
                ctl = (int)c[p];
                p++;
                bit = 0;
                while (bit < 8 & o < raw_len)
                {
                    switch (((ctl >> bit) `& 1) != 0)
                    {
                        case (true) {
                            switch (p + 2 > cl) { case (true) { *err = 1; ffree(out); -> (byte*)0; } default {}; };
                            off = ((int)c[p] `| (((int)c[p + 1] >> 4) << 8)) + 1;
                            n = ((int)c[p + 1] `& 15) + 3;
                            p = p + 2;
                            switch (off > o | o + n > raw_len) { case (true) { *err = 2; ffree(out); -> (byte*)0; } default {}; };
                            k = 0;
                            while (k < n)
                            {
                                out[o] = out[o - off];
                                o++;
                                k++;
                            };
                        }
                        default
                        {
                            switch (p >= cl) { case (true) { *err = 1; ffree(out); -> (byte*)0; } default {}; };
                            out[o] = c[p];
                            o++;
                            p++;
                        };
                    };
                    bit++;
                };
            };
            out[raw_len] = 0;
            -> out;
        };

        // The text of an EMITIDEKA operand: quoted, with \\ \" and \n escaped, then one
        // " name:slot" per binding
        idkvm_put_emitideka(FvmBuf* o, byte* s, FvmVars* vars) -> void
        {
            int k = 0;
            int i = 0;
            o.put_str(g" \"\0");
            while (s[k] != 0)
            {
                switch (s[k])
                {
                    case (92) { o.put_str(g"\\\\\0"); }
                    case (34) { o.put_str(g"\\\"\0"); }
                    case (10) { o.put_str(g"\\n\0"); }
                    default { o.put((int)s[k]); };
                };
                k++;
            };
            o.put(34);
            switch (vars != (FvmVars*)0)
            {
                case (true) {
                    while (i < vars.n)
                    {
                        o.put(32);
                        o.put_str(vars.names[i]);
                        o.put(58);
                        o.put_i64((i64)vars.slots[i]);
                        i++;
                    };
                }
                default {};
            };
            ->;
        };

        object FvmCode
        {
            int* ops;
            i64* a, b, c;
            byte** s;
            int* line;
            int len, cap;
            int* ustart, ulen;
            int ucount, ucap;
            bool ok;

            __init() -> this
            {
                this.len = 0;
                this.cap = 256;
                this.ucount = 0;
                this.ucap = 32;
                this.ok = true;
                this.ops = (int*)idkvm_alloc(this.cap * 4);
                this.a = (i64*)idkvm_alloc(this.cap * 8);
                this.b = (i64*)idkvm_alloc(this.cap * 8);
                this.c = (i64*)idkvm_alloc(this.cap * 8);
                this.s = (byte**)idkvm_alloc(this.cap * 8);
                this.line = (int*)idkvm_alloc(this.cap * 4);
                this.ustart = (int*)idkvm_alloc(this.ucap * 4);
                this.ulen = (int*)idkvm_alloc(this.ucap * 4);
                switch (this.ops == (int*)0 | this.a == (i64*)0 | this.b == (i64*)0 | this.c == (i64*)0 | this.s == (byte**)0 | this.line == (int*)0 | this.ustart == (int*)0 | this.ulen == (int*)0)
                {
                    case (true) { this.ok = false; }
                    default {};
                };
                -> this;
            };

            __expr() -> FvmCode* -> this;

            __exit() -> void
            {
                switch (this.ops != (int*)0) { case (true) { ffree((byte*)this.ops); } default {}; };
                switch (this.a != (i64*)0) { case (true) { ffree((byte*)this.a); } default {}; };
                switch (this.b != (i64*)0) { case (true) { ffree((byte*)this.b); } default {}; };
                switch (this.c != (i64*)0) { case (true) { ffree((byte*)this.c); } default {}; };
                switch (this.s != (byte**)0) { case (true) { ffree((byte*)this.s); } default {}; };
                switch (this.line != (int*)0) { case (true) { ffree((byte*)this.line); } default {}; };
                switch (this.ustart != (int*)0) { case (true) { ffree((byte*)this.ustart); } default {}; };
                switch (this.ulen != (int*)0) { case (true) { ffree((byte*)this.ulen); } default {}; };
                this.ops = (int*)0;
                this.a = (i64*)0;
                this.b = (i64*)0;
                this.c = (i64*)0;
                this.s = (byte**)0;
                this.line = (int*)0;
                this.ustart = (int*)0;
                this.ulen = (int*)0;
                this.len = 0;
                this.ucount = 0;
                ->;
            };

            // Appends an instruction, returns its index or -1 on allocation failure
            add(int op, i64 oa, i64 ob, i64 oc, byte* os, int ln) -> int
            {
                int nc;
                int* n1;
                i64* n2, n3, n4;
                byte** n5;
                int* n6;
                switch (!this.ok)
                {
                    case (true) { -> -1; }
                    default {};
                };
                switch (this.len >= this.cap)
                {
                    case (true) {
                        nc = this.cap * 2;
                        n1 = (int*)idkvm_grow((byte*)this.ops, nc * 4);
                        n2 = (i64*)idkvm_grow((byte*)this.a, nc * 8);
                        n3 = (i64*)idkvm_grow((byte*)this.b, nc * 8);
                        n4 = (i64*)idkvm_grow((byte*)this.c, nc * 8);
                        n5 = (byte**)idkvm_grow((byte*)this.s, nc * 8);
                        n6 = (int*)idkvm_grow((byte*)this.line, nc * 4);
                        switch (n1 == (int*)0 | n2 == (i64*)0 | n3 == (i64*)0 | n4 == (i64*)0 | n5 == (byte**)0 | n6 == (int*)0)
                        {
                            case (true) {
                                this.ok = false;
                                -> -1;
                            }
                            default {};
                        };
                        this.ops = n1;
                        this.a = n2;
                        this.b = n3;
                        this.c = n4;
                        this.s = n5;
                        this.line = n6;
                        this.cap = nc;
                    }
                    default {};
                };
                this.ops[this.len] = op;
                this.a[this.len] = oa;
                this.b[this.len] = ob;
                this.c[this.len] = oc;
                this.s[this.len] = os;
                this.line[this.len] = ln;
                this.len++;
                -> this.len - 1;
            };

            // Starts a new unit at the current end of the pool, returns its id or -1
            unit_begin() -> int
            {
                int nc;
                int* n1, n2;
                switch (!this.ok)
                {
                    case (true) { -> -1; }
                    default {};
                };
                switch (this.ucount >= this.ucap)
                {
                    case (true) {
                        nc = this.ucap * 2;
                        n1 = (int*)idkvm_grow((byte*)this.ustart, nc * 4);
                        n2 = (int*)idkvm_grow((byte*)this.ulen, nc * 4);
                        switch (n1 == (int*)0 | n2 == (int*)0)
                        {
                            case (true) {
                                this.ok = false;
                                -> -1;
                            }
                            default {};
                        };
                        this.ustart = n1;
                        this.ulen = n2;
                        this.ucap = nc;
                    }
                    default {};
                };
                this.ustart[this.ucount] = this.len;
                this.ulen[this.ucount] = 0;
                this.ucount++;
                -> this.ucount - 1;
            };

            // Closes unit u: its length is everything added since unit_begin
            unit_end(int u) -> void
            {
                this.ulen[u] = this.len - this.ustart[u];
                ->;
            };
        };

        // ===== FUNCTION TABLE =====

        object FvmFuncs
        {
            byte** names;
            int* units;
            int n, cap;
            bool ok;

            __init() -> this
            {
                this.n = 0;
                this.cap = 32;
                this.ok = true;
                this.names = (byte**)idkvm_alloc(this.cap * 8);
                this.units = (int*)idkvm_alloc(this.cap * 4);
                switch (this.names == (byte**)0 | this.units == (int*)0)
                {
                    case (true) { this.ok = false; }
                    default {};
                };
                -> this;
            };

            __expr() -> FvmFuncs* -> this;

            __exit() -> void
            {
                switch (this.names != (byte**)0) { case (true) { ffree((byte*)this.names); } default {}; };
                switch (this.units != (int*)0) { case (true) { ffree((byte*)this.units); } default {}; };
                this.names = (byte**)0;
                this.units = (int*)0;
                this.n = 0;
                ->;
            };

            // Index of the function called name, or -1
            find(byte* name) -> int
            {
                int i;
                while (i < this.n)
                {
                    switch (idkvm_streq(this.names[i], name))
                    {
                        case (true) { -> i; }
                        default
                        {
                            i++;
                        };
                    };
                };
                -> -1;
            };

            // register_function: a later registration of a name replaces the earlier one.
            // name must stay valid.
            add(byte* name, int unit) -> bool
            {
                int i = this.find(name);
                int nc;
                byte** n1;
                int* n2;
                switch (i >= 0)
                {
                    case (true) {
                        this.units[i] = unit;
                        -> true;
                    }
                    default {};
                };
                switch (!this.ok)
                {
                    case (true) { -> false; }
                    default {};
                };
                switch (this.n >= this.cap)
                {
                    case (true) {
                        nc = this.cap * 2;
                        n1 = (byte**)idkvm_grow((byte*)this.names, nc * 8);
                        n2 = (int*)idkvm_grow((byte*)this.units, nc * 4);
                        switch (n1 == (byte**)0 | n2 == (int*)0)
                        {
                            case (true) {
                                this.ok = false;
                                -> false;
                            }
                            default {};
                        };
                        this.names = n1;
                        this.units = n2;
                        this.cap = nc;
                    }
                    default {};
                };
                this.names[this.n] = name;
                this.units[this.n] = unit;
                this.n++;
                -> true;
            };
        };

        // ===== COMPILER REFLECTION (compiler.symbol_table) =====
        // The compiler hands the VM one FvmRefl per declaration. The VM turns them into the
        // IDKC_SYMTABLE, IDKC_SYMENTRY, IDKC_TYPESYS and IDKC_FUNCINFO values of runtime.idk.
        // A null string is an empty string.
        struct FvmReflTy
        {
            byte* base_type, custom, storage, dkey, dval;
            int pdepth, asize, bits, align, endian;
            bool is_signed, is_const, is_volatile, is_tied, is_pointer, is_array, is_dict;
        };

        struct FvmReflParam
        {
            byte* name;
            FvmReflTy ty;
        };

        // One function declaration
        struct FvmReflFn
        {
            int nparams;
            FvmReflParam* params;
            FvmReflTy ret;
            byte* cc;
            bool variadic, recursive, inl, nomangle, has_eff, has_att;
            int pre, post;
        };

        struct FvmRefl
        {
            byte* name, kind, ns;
            FvmReflTy ty;
            FvmReflFn* fn;      // functions only
        };

        // The triple idkvm.py assumes when __TARGET_TRIPLE__ is not defined: by host OS
        idkvm_host_triple() -> byte*
        {
#ifdef __WINDOWS__
            -> g"x86_64-pc-windows-msvc\0";
#elif __MACOS__
            -> g"arm64-apple-macosx11.0.0\0";
#else
            -> g"x86_64-pc-linux-gnu\0";
#endif;
        };

        // Whether the lower case lit is inside s, ignoring case
        idkvm_has_ci(byte* s, byte* lit) -> bool
        {
            int n = idkvm_strlen(s);
            int m = idkvm_strlen(lit);
            int i, j;
            bool hit;
            while (i + m <= n)
            {
                hit = true;
                j = 0;
                while (j < m & hit)
                {
                    switch (idkvm_lower((int)s[i + j]) != idkvm_lower((int)lit[j])) { case (true) { hit = false; } default {}; };
                    j++;
                };
                switch (hit) { case (true) { -> true; } default {}; };
                i++;
            };
            -> false;
        };

        // _arch_from_triple of idkvm.py, the text is null terminated
        idkvm_arch_of(byte* t) -> byte*
        {
            int n = idkvm_strlen(t);
            int k;
            byte* r;
            switch (idkvm_has_ci(t, g"x86_64\0") | idkvm_has_ci(t, g"amd64\0")) { case (true) { -> g"x86_64\0"; } default {}; };
            switch (idkvm_has_ci(t, g"aarch64\0") | idkvm_has_ci(t, g"arm64\0")) { case (true) { -> g"arm64\0"; } default {}; };
            switch (idkvm_has_ci(t, g"i386\0") | idkvm_has_ci(t, g"i686\0")) { case (true) { -> g"x86\0"; } default {}; };
            switch (idkvm_has_ci(t, g"arm\0")) { case (true) { -> g"arm\0"; } default {}; };
            while (k < n & t[k] != '-') { k++; };
            r = idkvm_dup(t, k);
            k = 0;
            while (r != (byte*)0 & r[k] != 0)
            {
                r[k] = (byte)idkvm_lower((int)r[k]);
                k++;
            };
            switch (r == (byte*)0) { case (true) { -> g"\0"; } default {}; };
            -> r;
        };

        // _os_from_triple of idkvm.py
        idkvm_os_of(byte* t) -> byte*
        {
            switch (idkvm_has_ci(t, g"windows\0") | idkvm_has_ci(t, g"win32\0")) { case (true) { -> g"windows\0"; } default {}; };
            switch (idkvm_has_ci(t, g"darwin\0") | idkvm_has_ci(t, g"macos\0") | idkvm_has_ci(t, g"apple\0")) { case (true) { -> g"macos\0"; } default {}; };
            switch (idkvm_has_ci(t, g"linux\0")) { case (true) { -> g"linux\0"; } default {}; };
            switch (idkvm_has_ci(t, g"freestanding\0") | idkvm_has_ci(t, g"none\0")) { case (true) { -> g"freestanding\0"; } default {}; };
            -> g"unknown\0";
        };

        // _abi_from_triple of idkvm.py
        idkvm_abi_of(byte* t) -> byte*
        {
            switch (idkvm_has_ci(t, g"msvc\0")) { case (true) { -> g"msvc\0"; } default {}; };
            switch (idkvm_has_ci(t, g"musl\0")) { case (true) { -> g"musl\0"; } default {}; };
            switch (idkvm_has_ci(t, g"gnu\0")) { case (true) { -> g"gnu\0"; } default {}; };
            -> g"unknown\0";
        };

#ifdef __ARCH_X86_64__
        // CPUID of leaf and sub: out[0..3] are eax, ebx, ecx, edx
        idkvm_cpuid(u64 leaf, u64 sub, u64* out) -> void
        {
            u64 a, b, c, d;
            volatile asm
            {
                movq $4, %rax
                movq $5, %rcx
                cpuid
                movq %rax, $0
                movq %rbx, $1
                movq %rcx, $2
                movq %rdx, $3
            } : "=r"(a), "=r"(b), "=r"(c), "=r"(d) : "r"(leaf), "r"(sub) : "rax","rbx","rcx","rdx","memory";
            out[0] = a `& (u64)0xFFFFFFFF;
            out[1] = b `& (u64)0xFFFFFFFF;
            out[2] = c `& (u64)0xFFFFFFFF;
            out[3] = d `& (u64)0xFFFFFFFF;
            ->;
        };

        // XCR0 by XGETBV, the state the OS saves
        idkvm_xcr0() -> u64
        {
            u64 x;
            volatile asm
            {
                xorq %rcx, %rcx
                xgetbv
                shlq $$32, %rdx
                orq %rdx, %rax
                movq %rax, $0
            } : "=r"(x) : : "rax","rcx","rdx","memory";
            -> x;
        };

        idkvm_bit(u64 v, int n) -> bool -> ((v >> n) `& (u64)1) != (u64)0;

        // compiler.target.has_<feat> of the host by CPUID, the way the instruction set defines
        // them: sse, sse2, sse4, avx, avx2, avx512, aes, popcnt or bmi2
        idkvm_cpu_has(byte* feat) -> bool
        {
            u64[4] r1 = noinit;
            u64[4] r7 = noinit;
            u64[4] r0 = noinit;
            u64 ecx1, edx1, ebx7, x;
            bool osavx;
            idkvm_cpuid(0, 0, @r0[0]);
            idkvm_cpuid(1, 0, @r1[0]);
            ecx1 = r1[2];
            edx1 = r1[3];
            switch (r0[0] >= (u64)7)
            {
                case (true) {
                    idkvm_cpuid(7, 0, @r7[0]);
                    ebx7 = r7[1];
                }
                default {};
            };
            switch (idkvm_streq(feat, g"sse\0")) { case (true) { -> idkvm_bit(edx1, 25); } default {}; };
            switch (idkvm_streq(feat, g"sse2\0")) { case (true) { -> idkvm_bit(edx1, 26); } default {}; };
            switch (idkvm_streq(feat, g"sse4\0")) { case (true) { -> idkvm_bit(ecx1, 19) & idkvm_bit(ecx1, 20); } default {}; };
            switch (idkvm_streq(feat, g"aes\0")) { case (true) { -> idkvm_bit(ecx1, 25); } default {}; };
            switch (idkvm_streq(feat, g"popcnt\0")) { case (true) { -> idkvm_bit(ecx1, 23); } default {}; };
            switch (idkvm_streq(feat, g"bmi2\0")) { case (true) { -> idkvm_bit(ebx7, 8); } default {}; };
            // AVX state is usable when the OS enabled XSAVE and saves the XMM and YMM state
            osavx = false;
            switch (idkvm_bit(ecx1, 27))
            {
                case (true) {
                    x = idkvm_xcr0();
                    osavx = (x `& (u64)6) == (u64)6;
                }
                default {};
            };
            switch (idkvm_streq(feat, g"avx\0")) { case (true) { -> idkvm_bit(ecx1, 28) & osavx; } default {}; };
            switch (idkvm_streq(feat, g"avx2\0")) { case (true) { -> idkvm_bit(ebx7, 5) & idkvm_bit(ecx1, 28) & osavx; } default {}; };
            // AVX512F, and the OS saves the opmask and ZMM state as well
            switch (idkvm_streq(feat, g"avx512\0"))
            {
                case (true) {
                    switch (osavx & idkvm_bit(ebx7, 16) & idkvm_bit(ecx1, 28))
                    {
                        case (true) { -> (idkvm_xcr0() `& (u64)0xE0) == (u64)0xE0; }
                        default {};
                    };
                    -> false;
                }
                default {};
            };
            -> false;
        };
#else
        idkvm_cpu_has(byte* feat) -> bool -> false;
#endif;

        // The page size of the host, 4096 when it cannot be asked
        idkvm_page_size() -> int
        {
            byte* sym, si;
            i64 r;
            int ps = 4096;
#ifdef __WINDOWS__
            void* hl = LoadLibraryA(g"kernel32.dll\0");
            switch (hl != (void*)0)
            {
                case (true) {
                    sym = GetProcAddress(hl, g"GetSystemInfo\0");
                    switch (sym != (byte*)0)
                    {
                        case (true) {
                            si = idkvm_alloc(64);
                            switch (si != (byte*)0)
                            {
                                case (true) {
                                    def{}* fp(byte*) -> void = sym;
                                    fp(si);
                                    ps = (int)si[4] `| ((int)si[5] << 8) `| ((int)si[6] << 16) `| ((int)si[7] << 24);
                                }
                                default {};
                            };
                        }
                        default {};
                    };
                }
                default {};
            };
#endif;
#ifdef __LINUX__
            sym = idkvm_find_sym(g"sysconf\0");
            switch (sym != (byte*)0)
            {
                case (true) {
                    def{}* sc(i64) -> i64 = sym;
                    r = sc(30);
                    switch (r > (i64)0) { case (true) { ps = (int)r; } default {}; };
                }
                default {};
            };
#endif;
            switch (ps <= 0) { case (true) { ps = 4096; } default {}; };
            -> ps;
        };

        // ===== STRUCT LAYOUTS (StructLayout) =====

        object FvmLayouts
        {
            byte** sname, sendian;
            int* ssize, sbits, sfirst, scount;
            int n, cap;
            byte** fname;
            int* ftag, foff, fsize;
            int fn, fcap, cur;
            bool ok;

            __init() -> this
            {
                this.n = 0;
                this.cap = 16;
                this.fn = 0;
                this.fcap = 64;
                this.ok = true;
                this.sname = (byte**)idkvm_alloc(this.cap * 8);
                this.sendian = (byte**)idkvm_alloc(this.cap * 8);
                this.ssize = (int*)idkvm_alloc(this.cap * 4);
                this.sbits = (int*)idkvm_alloc(this.cap * 4);
                this.sfirst = (int*)idkvm_alloc(this.cap * 4);
                this.scount = (int*)idkvm_alloc(this.cap * 4);
                this.fname = (byte**)idkvm_alloc(this.fcap * 8);
                this.ftag = (int*)idkvm_alloc(this.fcap * 4);
                this.foff = (int*)idkvm_alloc(this.fcap * 4);
                this.fsize = (int*)idkvm_alloc(this.fcap * 4);
                switch (this.sname == (byte**)0 | this.sendian == (byte**)0 | this.ssize == (int*)0 | this.sbits == (int*)0 | this.sfirst == (int*)0 | this.scount == (int*)0 | this.fname == (byte**)0 | this.ftag == (int*)0 | this.foff == (int*)0 | this.fsize == (int*)0)
                {
                    case (true) { this.ok = false; }
                    default {};
                };
                -> this;
            };

            __expr() -> FvmLayouts* -> this;

            __exit() -> void
            {
                switch (this.sname != (byte**)0) { case (true) { ffree((byte*)this.sname); } default {}; };
                switch (this.sendian != (byte**)0) { case (true) { ffree((byte*)this.sendian); } default {}; };
                switch (this.ssize != (int*)0) { case (true) { ffree((byte*)this.ssize); } default {}; };
                switch (this.sbits != (int*)0) { case (true) { ffree((byte*)this.sbits); } default {}; };
                switch (this.sfirst != (int*)0) { case (true) { ffree((byte*)this.sfirst); } default {}; };
                switch (this.scount != (int*)0) { case (true) { ffree((byte*)this.scount); } default {}; };
                switch (this.fname != (byte**)0) { case (true) { ffree((byte*)this.fname); } default {}; };
                switch (this.ftag != (int*)0) { case (true) { ffree((byte*)this.ftag); } default {}; };
                switch (this.foff != (int*)0) { case (true) { ffree((byte*)this.foff); } default {}; };
                switch (this.fsize != (int*)0) { case (true) { ffree((byte*)this.fsize); } default {}; };
                this.sname = (byte**)0;
                this.n = 0;
                this.fn = 0;
                ->;
            };

            find(byte* name) -> int
            {
                int i;
                while (i < this.n)
                {
                    switch (idkvm_streq(this.sname[i], name))
                    {
                        case (true) { -> i; }
                        default
                        {
                            i++;
                        };
                    };
                };
                -> -1;
            };

            // Fields added next belong to this struct. name and endian must stay valid.
            add_struct(byte* name, byte* endian, int size, int bits) -> bool
            {
                int nc;
                byte** n1, n2;
                int* n3, n4, n5, n6;
                int e = this.find(name);
                switch (e >= 0)
                {
                    case (true) {
                        this.sendian[e] = endian;
                        this.ssize[e] = size;
                        this.sbits[e] = bits;
                        this.sfirst[e] = this.fn;
                        this.scount[e] = 0;
                        this.cur = e;
                        -> true;
                    }
                    default {};
                };
                switch (!this.ok)
                {
                    case (true) { -> false; }
                    default {};
                };
                switch (this.n >= this.cap)
                {
                    case (true) {
                        nc = this.cap * 2;
                        n1 = (byte**)idkvm_grow((byte*)this.sname, nc * 8);
                        n2 = (byte**)idkvm_grow((byte*)this.sendian, nc * 8);
                        n3 = (int*)idkvm_grow((byte*)this.ssize, nc * 4);
                        n4 = (int*)idkvm_grow((byte*)this.sbits, nc * 4);
                        n5 = (int*)idkvm_grow((byte*)this.sfirst, nc * 4);
                        n6 = (int*)idkvm_grow((byte*)this.scount, nc * 4);
                        switch (n1 == (byte**)0 | n2 == (byte**)0 | n3 == (int*)0 | n4 == (int*)0 | n5 == (int*)0 | n6 == (int*)0)
                        {
                            case (true) {
                                this.ok = false;
                                -> false;
                            }
                            default {};
                        };
                        this.sname = n1;
                        this.sendian = n2;
                        this.ssize = n3;
                        this.sbits = n4;
                        this.sfirst = n5;
                        this.scount = n6;
                        this.cap = nc;
                    }
                    default {};
                };
                this.sname[this.n] = name;
                this.sendian[this.n] = endian;
                this.ssize[this.n] = size;
                this.sbits[this.n] = bits;
                this.sfirst[this.n] = this.fn;
                this.scount[this.n] = 0;
                this.cur = this.n;
                this.n++;
                -> true;
            };

            // Appends a field to the most recently added struct
            add_field(byte* name, int tag, int off, int size) -> bool
            {
                int nc;
                byte** n1;
                int* n2, n3, n4;
                switch (!this.ok | this.n == 0)
                {
                    case (true) { -> false; }
                    default {};
                };
                switch (this.fn >= this.fcap)
                {
                    case (true) {
                        nc = this.fcap * 2;
                        n1 = (byte**)idkvm_grow((byte*)this.fname, nc * 8);
                        n2 = (int*)idkvm_grow((byte*)this.ftag, nc * 4);
                        n3 = (int*)idkvm_grow((byte*)this.foff, nc * 4);
                        n4 = (int*)idkvm_grow((byte*)this.fsize, nc * 4);
                        switch (n1 == (byte**)0 | n2 == (int*)0 | n3 == (int*)0 | n4 == (int*)0)
                        {
                            case (true) {
                                this.ok = false;
                                -> false;
                            }
                            default {};
                        };
                        this.fname = n1;
                        this.ftag = n2;
                        this.foff = n3;
                        this.fsize = n4;
                        this.fcap = nc;
                    }
                    default {};
                };
                this.fname[this.fn] = name;
                this.ftag[this.fn] = tag;
                this.foff[this.fn] = off;
                this.fsize[this.fn] = size;
                this.fn++;
                this.scount[this.cur] = this.scount[this.cur] + 1;
                -> true;
            };
        };

        // ===== THE VM (IDEKAVM) =====

        object IDEKAVM
        {
            FvmHeap vheap;
            FvmCode code;
            FvmCode mp;             // main block while a .ivm file is parsed
            FvmFuncs funcs;
            FvmLayouts layouts;
            FvmStubs stubs;
            FvmBuf errb;            // error message of the last failure
            FvmBuf tmp;
            standard::watchdog::Watchdog wd;    // limit on one run, idkvm.py _run

            // value stack, one entry is (tag, data, meta)
            int* st_tag;
            i64* st_data, st_meta;
            int sp, scap;

            // call frames
            int* fr_unit, fr_ip, fr_base, fr_nloc;
            byte** fr_name;
            int nframes, fcap;

            // frame locals pool
            int* lc_tag;
            int* lc_set;            // 1 once the slot was written (only the trace shows the difference)
            i64* lc_data, lc_meta;
            int lc_top, lc_cap;

            // exception handlers pushed by TRY_BEGIN
            int* h_frame, h_catch, h_depth;
            int nh, hcap;

            // block level globals
            byte** g_name;
            int* g_tag;
            i64* g_data, g_meta;
            int gn, gcap;

            // arrays made by ARRAY_NEW and ARRAY_STORE: every one is freed with the VM
            i64* arrs;
            int an, acap;

            // extern prototypes registered by EXTERN_DECL
            byte** x_name;
            int* x_ret;
            i64** x_pt;         // per extern: [parameter count, parameter ttags...]
            int xn, xcap;

            // OS memory: the addresses that came from an extern call or a pinned buffer
            // (_os_ptrs), and the pinned native copies of BYTES values (_pinned_bufs)
            i64* osp;
            int osn, oscap;
            byte** pins;
            int pinn, pincap;
            FvmBuf osb;         // the text of a PTR into OS memory

            // emit_results
            int* e_kind, e_tag;
            i64* e_data, e_meta;
            byte** e_text;
            int emit_count, ecap;

            // struct type names named by PTR casts, the index is part of the PTR meta
            byte** tn_name;
            int tn_n, tn_cap;

            // compiler reflection (the compiler owns the records) and the preprocessor constants
            PtrVec* refl;           // FvmRefl*, null when the compiler gave none
            FvmReflTy* refl_zero;   // a zeroed type record
            PtrVec* cc_k;           // constant names, byte*
            PtrVec* cc_v;           // constant values, byte*

            // state
            int pt;                 // last popped value
            i64 pd, pm;
            bool failed, throwing, ok;
            int tv_tag;             // thrown value
            i64 tv_data, tv_meta;
            bool trace_on;
            int trace_left;

            // A request the VM cannot serve alone: the run stops after the instruction, the host
            // does the work (compile an import, write a dump) and calls resume
            int host_kind;          // IDKVM_HOST_*, 0 when none is pending
            byte* host_arg;         // the path of the request, owned by the VM until the host takes it

            // finished blocks for compiler.idkvm.dump (_comptime_log)
            int* log_unit;
            int log_n, log_cap, log_locals, cur_unit, last_line, main_unit, main_locals;
            int parse_line;         // line of the last parse error

            // dump mode and the IDKB reader cursor
            bool ser_bin;           // ser_item writes the binary form
            bool bin_lenient;       // load_bin keeps runtime value operands as text (decompile)
            int ser_n;              // instructions ser_item wrote
            int ser_last;           // opcode of the last one
            byte* bd;               // the IDKB file being read
            int bl, bp;             // its length and the read position
            byte** bt_s;            // string table being written: the strings, their lengths, the count
            int* bt_l;
            int bt_n, bt_cap;
            byte** rt_s;            // string table being read: into bd
            int* rt_l;
            int rt_n;
            int ib_flags, ib_raw, ib_nstr;     // header of the last IDKB file loaded
            FvmBuf* str_out;                   // --strings: the string table is listed here

            // .ivm token scratch (offsets into the current line)
            int* tk_s, tk_e;
            int tk_n, tk_cap;

            // .ivm parser state
            bool p_in_func, p_in_struct;
            int p_pass, p_unit, p_main;
            byte* p_fname;

            __init() -> this
            {
                this.vheap.__init();
                this.code.__init();
                this.mp.__init();
                this.funcs.__init();
                this.layouts.__init();
                this.stubs.__init();
                this.errb.__init();
                this.tmp.__init();
                this.wd.__init();

                this.refl = (PtrVec*)0;
                this.refl_zero = (FvmReflTy*)0;
                this.cc_k = (PtrVec*)0;
                this.cc_v = (PtrVec*)0;
                this.ok = true;
                this.failed = false;
                this.throwing = false;
                this.trace_on = false;
                this.trace_left = 0;
                this.host_kind = 0;
                this.host_arg = (byte*)0;
                this.log_cap = 16;
                this.log_n = 0;
                this.log_locals = 0;
                this.cur_unit = -1;
                this.log_unit = (int*)idkvm_alloc(this.log_cap * 4);
                switch (this.log_unit == (int*)0) { case (true) { this.ok = false; } default {}; };
                this.last_line = 0;
                this.main_unit = -1;
                this.main_locals = 0;
                this.parse_line = 0;
                this.ser_bin = false;
                this.bin_lenient = false;
                this.ser_n = 0;
                this.ser_last = -1;
                this.bd = (byte*)0;
                this.bl = 0;
                this.bp = 0;
                this.bt_s = (byte**)0;
                this.bt_l = (int*)0;
                this.bt_n = 0;
                this.bt_cap = 0;
                this.rt_s = (byte**)0;
                this.rt_l = (int*)0;
                this.rt_n = 0;
                this.ib_flags = 0;
                this.ib_raw = 0;
                this.ib_nstr = 0;
                this.str_out = (FvmBuf*)0;
                this.sp = 0;
                this.scap = 256;
                this.nframes = 0;
                this.fcap = 32;
                this.lc_top = 0;
                this.lc_cap = 1024;
                this.nh = 0;
                this.hcap = 16;
                this.gn = 0;
                this.gcap = 16;
                this.an = 0;
                this.acap = 16;
                this.arrs = (i64*)idkvm_alloc(this.acap * 8);
                this.tn_n = 0;
                this.tn_cap = 16;
                this.tn_name = (byte**)idkvm_alloc(this.tn_cap * 8);
                this.xn = 0;
                this.xcap = 16;
                this.osn = 0;
                this.oscap = 16;
                this.pinn = 0;
                this.pincap = 8;
                this.osb.__init();
                this.emit_count = 0;
                this.ecap = 16;

                this.st_tag = (int*)idkvm_alloc(this.scap * 4);
                this.st_data = (i64*)idkvm_alloc(this.scap * 8);
                this.st_meta = (i64*)idkvm_alloc(this.scap * 8);
                this.fr_unit = (int*)idkvm_alloc(this.fcap * 4);
                this.fr_ip = (int*)idkvm_alloc(this.fcap * 4);
                this.fr_base = (int*)idkvm_alloc(this.fcap * 4);
                this.fr_nloc = (int*)idkvm_alloc(this.fcap * 4);
                this.fr_name = (byte**)idkvm_alloc(this.fcap * 8);
                this.lc_tag = (int*)idkvm_alloc(this.lc_cap * 4);
                this.lc_set = (int*)idkvm_alloc(this.lc_cap * 4);
                this.lc_data = (i64*)idkvm_alloc(this.lc_cap * 8);
                this.lc_meta = (i64*)idkvm_alloc(this.lc_cap * 8);
                this.h_frame = (int*)idkvm_alloc(this.hcap * 4);
                this.h_catch = (int*)idkvm_alloc(this.hcap * 4);
                this.h_depth = (int*)idkvm_alloc(this.hcap * 4);
                this.g_name = (byte**)idkvm_alloc(this.gcap * 8);
                this.g_tag = (int*)idkvm_alloc(this.gcap * 4);
                this.g_data = (i64*)idkvm_alloc(this.gcap * 8);
                this.g_meta = (i64*)idkvm_alloc(this.gcap * 8);
                this.x_name = (byte**)idkvm_alloc(this.xcap * 8);
                this.x_ret = (int*)idkvm_alloc(this.xcap * 4);
                this.x_pt = (i64**)idkvm_alloc(this.xcap * 8);
                this.osp = (i64*)idkvm_alloc(this.oscap * 8);
                this.pins = (byte**)idkvm_alloc(this.pincap * 8);
                this.e_kind = (int*)idkvm_alloc(this.ecap * 4);
                this.e_tag = (int*)idkvm_alloc(this.ecap * 4);
                this.e_data = (i64*)idkvm_alloc(this.ecap * 8);
                this.e_meta = (i64*)idkvm_alloc(this.ecap * 8);
                this.e_text = (byte**)idkvm_alloc(this.ecap * 8);

                switch (this.st_tag == (int*)0 | this.st_data == (i64*)0 | this.st_meta == (i64*)0 | this.fr_unit == (int*)0 | this.fr_ip == (int*)0 | this.fr_base == (int*)0 | this.fr_nloc == (int*)0 | this.fr_name == (byte**)0)
                {
                    case (true) { this.ok = false; }
                    default {};
                };
                switch (this.lc_tag == (int*)0 | this.lc_set == (int*)0 | this.lc_data == (i64*)0 | this.lc_meta == (i64*)0 | this.h_frame == (int*)0 | this.h_catch == (int*)0 | this.h_depth == (int*)0 | this.g_name == (byte**)0 | this.g_tag == (int*)0)
                {
                    case (true) { this.ok = false; }
                    default {};
                };
                switch (this.g_data == (i64*)0 | this.g_meta == (i64*)0 | this.x_name == (byte**)0 | this.x_ret == (int*)0 | this.x_pt == (i64**)0 | this.osp == (i64*)0 | this.pins == (byte**)0 | this.e_kind == (int*)0 | this.e_tag == (int*)0 | this.e_data == (i64*)0 | this.e_meta == (i64*)0 | this.e_text == (byte**)0)
                {
                    case (true) { this.ok = false; }
                    default {};
                };
                switch (!this.vheap.ok | !this.code.ok | !this.mp.ok | !this.funcs.ok | !this.layouts.ok | !this.stubs.ok | !this.errb.ok | !this.tmp.ok)
                {
                    case (true) { this.ok = false; }
                    default {};
                };
                -> this;
            };

            __expr() -> IDEKAVM* -> this;

            __exit() -> void
            {
                int k0, tk;
                this.arr_free_all();
                while (tk < this.tn_n)
                {
                    ffree(this.tn_name[tk]);
                    tk++;
                };
                switch (this.tn_name != (byte**)0) { case (true) { ffree((byte*)this.tn_name); } default {}; };
                this.vheap.__exit();
                this.code.__exit();
                this.mp.__exit();
                this.funcs.__exit();
                this.layouts.__exit();
                this.stubs.__exit();
                this.errb.__exit();
                this.tmp.__exit();
                switch (this.st_tag != (int*)0) { case (true) { ffree((byte*)this.st_tag); } default {}; };
                switch (this.st_data != (i64*)0) { case (true) { ffree((byte*)this.st_data); } default {}; };
                switch (this.st_meta != (i64*)0) { case (true) { ffree((byte*)this.st_meta); } default {}; };
                switch (this.fr_unit != (int*)0) { case (true) { ffree((byte*)this.fr_unit); } default {}; };
                switch (this.fr_ip != (int*)0) { case (true) { ffree((byte*)this.fr_ip); } default {}; };
                switch (this.fr_base != (int*)0) { case (true) { ffree((byte*)this.fr_base); } default {}; };
                switch (this.fr_nloc != (int*)0) { case (true) { ffree((byte*)this.fr_nloc); } default {}; };
                switch (this.fr_name != (byte**)0) { case (true) { ffree((byte*)this.fr_name); } default {}; };
                switch (this.lc_tag != (int*)0) { case (true) { ffree((byte*)this.lc_tag); } default {}; };
                switch (this.log_unit != (int*)0) { case (true) { ffree((byte*)this.log_unit); } default {}; };
                switch (this.lc_set != (int*)0) { case (true) { ffree((byte*)this.lc_set); } default {}; };
                switch (this.lc_data != (i64*)0) { case (true) { ffree((byte*)this.lc_data); } default {}; };
                switch (this.lc_meta != (i64*)0) { case (true) { ffree((byte*)this.lc_meta); } default {}; };
                switch (this.h_frame != (int*)0) { case (true) { ffree((byte*)this.h_frame); } default {}; };
                switch (this.h_catch != (int*)0) { case (true) { ffree((byte*)this.h_catch); } default {}; };
                switch (this.h_depth != (int*)0) { case (true) { ffree((byte*)this.h_depth); } default {}; };
                switch (this.g_name != (byte**)0) { case (true) { ffree((byte*)this.g_name); } default {}; };
                switch (this.g_tag != (int*)0) { case (true) { ffree((byte*)this.g_tag); } default {}; };
                switch (this.g_data != (i64*)0) { case (true) { ffree((byte*)this.g_data); } default {}; };
                switch (this.g_meta != (i64*)0) { case (true) { ffree((byte*)this.g_meta); } default {}; };
                switch (this.x_name != (byte**)0) { case (true) { ffree((byte*)this.x_name); } default {}; };
                switch (this.x_ret != (int*)0) { case (true) { ffree((byte*)this.x_ret); } default {}; };
                while (k0 < this.xn)
                {
                    switch (this.x_pt[k0] != (i64*)0) { case (true) { ffree((byte*)this.x_pt[k0]); } default {}; };
                    k0++;
                };
                switch (this.x_pt != (i64**)0) { case (true) { ffree((byte*)this.x_pt); } default {}; };
                k0 = 0;
                while (k0 < this.pinn)
                {
                    ffree(this.pins[k0]);
                    k0++;
                };
                switch (this.pins != (byte**)0) { case (true) { ffree((byte*)this.pins); } default {}; };
                switch (this.osp != (i64*)0) { case (true) { ffree((byte*)this.osp); } default {}; };
                this.osb.__exit();
                switch (this.e_kind != (int*)0) { case (true) { ffree((byte*)this.e_kind); } default {}; };
                switch (this.e_tag != (int*)0) { case (true) { ffree((byte*)this.e_tag); } default {}; };
                switch (this.e_data != (i64*)0) { case (true) { ffree((byte*)this.e_data); } default {}; };
                switch (this.e_meta != (i64*)0) { case (true) { ffree((byte*)this.e_meta); } default {}; };
                switch (this.e_text != (byte**)0) { case (true) { ffree((byte*)this.e_text); } default {}; };
                switch (this.tk_s != (int*)0) { case (true) { ffree((byte*)this.tk_s); } default {}; };
                switch (this.tk_e != (int*)0) { case (true) { ffree((byte*)this.tk_e); } default {}; };
                this.tk_s = (int*)0;
                this.tk_e = (int*)0;
                this.st_tag = (int*)0;
                this.fr_unit = (int*)0;
                this.lc_tag = (int*)0;
                this.lc_set = (int*)0;
                this.h_frame = (int*)0;
                this.g_name = (byte**)0;
                this.x_name = (byte**)0;
                this.e_kind = (int*)0;
                ->;
            };

            // ===== ERRORS =====

            fail(byte* msg) -> void
            {
                switch (!this.failed)
                {
                    case (true) {
                        this.errb.clear();
                        this.errb.put_str(msg);
                        this.failed = true;
                    }
                    default {};
                };
                ->;
            };

            // Fails with "msg name" (name is a null terminated string)
            fail_name(byte* msg, byte* name) -> void
            {
                switch (!this.failed)
                {
                    case (true) {
                        this.errb.clear();
                        this.errb.put_str(msg);
                        this.errb.put_str(name);
                        this.failed = true;
                    }
                    default {};
                };
                ->;
            };

            // A feature that is not ported yet: counted by name, and the run fails
            stub(byte* what) -> void
            {
                this.stubs.note(what);
                this.fail_name(g"not ported yet in the bootstrapped IDKVM: \0", what);
                ->;
            };

            // Counts a feature that is not ported yet without failing the run
            stub_note(byte* what) -> void
            {
                this.stubs.note(what);
                ->;
            };

            err_text() -> byte* -> this.errb.mem;

            // ===== STACK =====

            push(int tag, i64 d, i64 m) -> void
            {
                int nc;
                int* n1;
                i64* n2, n3;
                switch (this.sp >= this.scap)
                {
                    case (true) {
                        nc = this.scap * 2;
                        n1 = (int*)idkvm_grow((byte*)this.st_tag, nc * 4);
                        n2 = (i64*)idkvm_grow((byte*)this.st_data, nc * 8);
                        n3 = (i64*)idkvm_grow((byte*)this.st_meta, nc * 8);
                        switch (n1 == (int*)0 | n2 == (i64*)0 | n3 == (i64*)0)
                        {
                            case (true) {
                                this.fail(g"value stack allocation failed\0");
                                ->;
                            }
                            default {};
                        };
                        this.st_tag = n1;
                        this.st_data = n2;
                        this.st_meta = n3;
                        this.scap = nc;
                    }
                    default {};
                };
                this.st_tag[this.sp] = tag;
                this.st_data[this.sp] = d;
                this.st_meta[this.sp] = m;
                this.sp++;
                ->;
            };

            // Pops into pt/pd/pm. On underflow the run fails and the value is zero.
            pop_val() -> void
            {
                switch (this.sp <= 0)
                {
                    case (true) {
                        this.fail(g"Stack underflow\0");
                        this.pt = 0;
                        this.pd = 0;
                        this.pm = 0;
                        ->;
                    }
                    default
                    {
                        this.sp--;
                        this.pt = this.st_tag[this.sp];
                        this.pd = this.st_data[this.sp];
                        this.pm = this.st_meta[this.sp];
                        ->;
                    };
                };
            };

            // Stack entry needs at least n values, otherwise the run fails
            need(int n) -> bool
            {
                switch (this.sp < n)
                {
                    case (true) {
                        this.fail(g"Stack underflow\0");
                        -> false;
                    }
                    default { -> true; };
                };
            };

            // Pushes a BYTES value that owns a fresh copy of s[0, n)
            push_bytes(byte* s, int n) -> void
            {
                byte* p = idkvm_dup(s, n);
                switch (p == (byte*)0)
                {
                    case (true) {
                        this.fail(g"allocation failed\0");
                        ->;
                    }
                    default {};
                };
                this.push(IDKVM_T_BYTES, idkvm_p2i(p), (i64)n);
                ->;
            };

            // Text of a string-like value (BYTES or a PTR into the VM heap), null otherwise
            str_of(int tag, i64 d) -> byte*
            {
                int k;
                i64 b;
                switch (tag == IDKVM_T_BYTES)
                {
                    case (true) { -> idkvm_i2p(d); }
                    default {};
                };
                switch (tag == IDKVM_T_PTR & this.ptr_is_os(d))
                {
                    case (true) {
                        // OS pointer: up to 4096 bytes until the NUL
                        this.osb.clear();
                        k = 0;
                        while (k < 4096)
                        {
                            b = this.os_rd(d + (i64)k, 1);
                            switch (b == (i64)0) { case (true) { k = 4096; } default { this.osb.put((int)b); k++; }; };
                        };
                        -> this.osb.mem;
                    }
                    default {};
                };
                switch (tag == IDKVM_T_PTR)
                {
                    case (true) {
                        switch (this.vheap.in_bounds(d, 1))
                        {
                            case (true) { -> this.vheap.mem + (int)d; }
                            default {};
                        };
                    }
                    default {};
                };
                -> (byte*)0;
            };

            // ===== FRAMES =====

            ensure_locals(int need_slots) -> bool
            {
                int nc = this.lc_cap;
                int* n1;
                i64* n2, n3;
                int* n4;
                switch (this.lc_top + need_slots <= this.lc_cap)
                {
                    case (true) { -> true; }
                    default {};
                };
                while (nc < this.lc_top + need_slots) { nc = nc * 2; };
                n1 = (int*)idkvm_grow((byte*)this.lc_tag, nc * 4);
                n2 = (i64*)idkvm_grow((byte*)this.lc_data, nc * 8);
                n3 = (i64*)idkvm_grow((byte*)this.lc_meta, nc * 8);
                n4 = (int*)idkvm_grow((byte*)this.lc_set, nc * 4);
                switch (n1 == (int*)0 | n2 == (i64*)0 | n3 == (i64*)0 | n4 == (int*)0)
                {
                    case (true) {
                        this.fail(g"locals allocation failed\0");
                        -> false;
                    }
                    default {};
                };
                this.lc_tag = n1;
                this.lc_set = n4;
                this.lc_data = n2;
                this.lc_meta = n3;
                this.lc_cap = nc;
                -> true;
            };

            // Pushes a frame for code unit `unit` with nloc zeroed local slots.
            // name must stay valid. An unset local reads as int 0.
            push_frame(int unit, byte* name, int nloc) -> bool
            {
                int nc, i;
                int* n1, n2, n3, n4;
                byte** n5;
                switch (this.nframes >= this.fcap)
                {
                    case (true) {
                        nc = this.fcap * 2;
                        n1 = (int*)idkvm_grow((byte*)this.fr_unit, nc * 4);
                        n2 = (int*)idkvm_grow((byte*)this.fr_ip, nc * 4);
                        n3 = (int*)idkvm_grow((byte*)this.fr_base, nc * 4);
                        n4 = (int*)idkvm_grow((byte*)this.fr_nloc, nc * 4);
                        n5 = (byte**)idkvm_grow((byte*)this.fr_name, nc * 8);
                        switch (n1 == (int*)0 | n2 == (int*)0 | n3 == (int*)0 | n4 == (int*)0 | n5 == (byte**)0)
                        {
                            case (true) {
                                this.fail(g"frame allocation failed\0");
                                -> false;
                            }
                            default {};
                        };
                        this.fr_unit = n1;
                        this.fr_ip = n2;
                        this.fr_base = n3;
                        this.fr_nloc = n4;
                        this.fr_name = n5;
                        this.fcap = nc;
                    }
                    default {};
                };
                switch (!this.ensure_locals(nloc))
                {
                    case (true) { -> false; }
                    default {};
                };
                i = 0;
                while (i < nloc)
                {
                    this.lc_tag[this.lc_top + i] = IDKVM_T_INT;
                    this.lc_set[this.lc_top + i] = 0;
                    this.lc_data[this.lc_top + i] = 0;
                    this.lc_meta[this.lc_top + i] = 0;
                    i++;
                };
                this.fr_unit[this.nframes] = unit;
                this.fr_ip[this.nframes] = 0;
                this.fr_base[this.nframes] = this.lc_top;
                this.fr_nloc[this.nframes] = nloc;
                this.fr_name[this.nframes] = name;
                this.lc_top = this.lc_top + nloc;
                this.nframes++;
                -> true;
            };

            // Pops the top frame together with its locals and exception handlers
            pop_frame() -> void
            {
                switch (this.nframes <= 0)
                {
                    case (true) { ->; }
                    default {};
                };
                this.nframes--;
                this.lc_top = this.fr_base[this.nframes];
                while (this.nh > 0 & this.h_frame[this.nh - 1] >= this.nframes)
                {
                    this.nh--;
                };
                ->;
            };

            // ===== TYPE SIZES (_type_byte_size) =====

            // Byte size of a type name, -1 when unknown
            type_size(byte* name) -> int
            {
                int e = this.layouts.find(name);
                switch (e >= 0)
                {
                    case (true) { -> this.layouts.ssize[e]; }
                    default {};
                };
                switch (idkvm_streq(name, g"bool\0") | idkvm_streq(name, g"byte\0") | idkvm_streq(name, g"char\0"))
                {
                    case (true) { -> 1; }
                    default {};
                };
                switch (idkvm_streq(name, g"int\0") | idkvm_streq(name, g"uint\0") | idkvm_streq(name, g"float\0"))
                {
                    case (true) { -> 4; }
                    default {};
                };
                switch (idkvm_streq(name, g"long\0") | idkvm_streq(name, g"ulong\0") | idkvm_streq(name, g"double\0"))
                {
                    case (true) { -> 8; }
                    default {};
                };
                -> -1;
            };

            // ===== EXTERNS, GLOBALS, EMIT RESULTS =====

            // Index of the extern prototype called name, or -1
            extern_find(byte* name) -> int
            {
                int i;
                while (i < this.xn)
                {
                    switch (idkvm_streq(this.x_name[i], name))
                    {
                        case (true) { -> i; }
                        default
                        {
                            i++;
                        };
                    };
                };
                -> -1;
            };

            // EXTERN_DECL. name must stay valid. tags are the np parameter ttags, copied.
            extern_add(byte* name, int ret, int np, i64* tags) -> void
            {
                int e = this.extern_find(name);
                int nc, k;
                byte** n1;
                int* n2;
                i64** n3;
                i64* blk;
                blk = (i64*)idkvm_alloc((np + 1) * 8);
                switch (blk == (i64*)0) { case (true) { this.fail(g"extern table allocation failed\0"); ->; } default {}; };
                blk[0] = (i64)np;
                while (k < np)
                {
                    blk[1 + k] = tags[k];
                    k++;
                };
                switch (e >= 0)
                {
                    case (true) {
                        this.x_ret[e] = ret;
                        ffree((byte*)this.x_pt[e]);
                        this.x_pt[e] = blk;
                        ->;
                    }
                    default {};
                };
                switch (this.xn >= this.xcap)
                {
                    case (true) {
                        nc = this.xcap * 2;
                        n1 = (byte**)idkvm_grow((byte*)this.x_name, nc * 8);
                        n2 = (int*)idkvm_grow((byte*)this.x_ret, nc * 4);
                        n3 = (i64**)idkvm_grow((byte*)this.x_pt, nc * 8);
                        switch (n1 == (byte**)0 | n2 == (int*)0 | n3 == (i64**)0)
                        {
                            case (true) {
                                this.fail(g"extern table allocation failed\0");
                                ->;
                            }
                            default {};
                        };
                        this.x_name = n1;
                        this.x_ret = n2;
                        this.x_pt = n3;
                        this.xcap = nc;
                    }
                    default {};
                };
                this.x_name[this.xn] = name;
                this.x_ret[this.xn] = ret;
                this.x_pt[this.xn] = blk;
                this.xn++;
                ->;
            };

            global_find(byte* name) -> int
            {
                int i;
                while (i < this.gn)
                {
                    switch (idkvm_streq(this.g_name[i], name))
                    {
                        case (true) { -> i; }
                        default
                        {
                            i++;
                        };
                    };
                };
                -> -1;
            };

            // GLOBAL_SET. name must stay valid.
            global_set(byte* name, int tag, i64 d, i64 m) -> void
            {
                int e = this.global_find(name);
                int nc;
                byte** n1;
                int* n2;
                i64* n3, n4;
                switch (e < 0)
                {
                    case (true) {
                        switch (this.gn >= this.gcap)
                        {
                            case (true) {
                                nc = this.gcap * 2;
                                n1 = (byte**)idkvm_grow((byte*)this.g_name, nc * 8);
                                n2 = (int*)idkvm_grow((byte*)this.g_tag, nc * 4);
                                n3 = (i64*)idkvm_grow((byte*)this.g_data, nc * 8);
                                n4 = (i64*)idkvm_grow((byte*)this.g_meta, nc * 8);
                                switch (n1 == (byte**)0 | n2 == (int*)0 | n3 == (i64*)0 | n4 == (i64*)0)
                                {
                                    case (true) {
                                        this.fail(g"globals allocation failed\0");
                                        ->;
                                    }
                                    default {};
                                };
                                this.g_name = n1;
                                this.g_tag = n2;
                                this.g_data = n3;
                                this.g_meta = n4;
                                this.gcap = nc;
                            }
                            default {};
                        };
                        e = this.gn;
                        this.g_name[e] = name;
                        this.gn++;
                    }
                    default {};
                };
                this.g_tag[e] = tag;
                this.g_data[e] = d;
                this.g_meta[e] = m;
                ->;
            };

            // Appends to emit_results. text is owned by the VM from here on.
            emit_add(int kind, int tag, i64 d, i64 m, byte* text) -> void
            {
                int nc;
                int* n1, n2;
                i64* n3, n4;
                byte** n5;
                switch (this.emit_count >= this.ecap)
                {
                    case (true) {
                        nc = this.ecap * 2;
                        n1 = (int*)idkvm_grow((byte*)this.e_kind, nc * 4);
                        n2 = (int*)idkvm_grow((byte*)this.e_tag, nc * 4);
                        n3 = (i64*)idkvm_grow((byte*)this.e_data, nc * 8);
                        n4 = (i64*)idkvm_grow((byte*)this.e_meta, nc * 8);
                        n5 = (byte**)idkvm_grow((byte*)this.e_text, nc * 8);
                        switch (n1 == (int*)0 | n2 == (int*)0 | n3 == (i64*)0 | n4 == (i64*)0 | n5 == (byte**)0)
                        {
                            case (true) {
                                this.fail(g"emit results allocation failed\0");
                                ->;
                            }
                            default {};
                        };
                        this.e_kind = n1;
                        this.e_tag = n2;
                        this.e_data = n3;
                        this.e_meta = n4;
                        this.e_text = n5;
                        this.ecap = nc;
                    }
                    default {};
                };
                this.e_kind[this.emit_count] = kind;
                this.e_tag[this.emit_count] = tag;
                this.e_data[this.emit_count] = d;
                this.e_meta[this.emit_count] = m;
                this.e_text[this.emit_count] = text;
                this.emit_count++;
                ->;
            };

            // ===== PUBLIC API =====

            // register_function: unit is a code unit of this VM. name must stay valid.
            register_function(byte* name, int unit) -> void
            {
                switch (!this.funcs.add(name, unit))
                {
                    case (true) { this.fail(g"function table allocation failed\0"); }
                    default {};
                };
                ->;
            };

            // Copies unit su of src into this VM's code pool, returns the new unit id or -1.
            // Jump targets are unit relative, so the copy needs no patching. Operand strings
            // and FvmVars blocks stay owned by the producer, which must outlive the run.
            import_unit(FvmCode* src, int su) -> int
            {
                int u, i, at;
                int st = src.ustart[su];
                int n = src.ulen[su];
                u = this.code.unit_begin();
                switch (u < 0)
                {
                    case (true) { -> -1; }
                    default {};
                };
                while (i < n)
                {
                    at = this.code.add(src.ops[st + i], src.a[st + i], src.b[st + i], src.c[st + i], src.s[st + i], src.line[st + i]);
                    switch (at < 0)
                    {
                        case (true) { -> -1; }
                        default {};
                    };
                    i++;
                };
                this.code.unit_end(u);
                -> u;
            };

            // Sets the run time limit in seconds and the instructions between clock reads
            set_watchdog(int limit_sec, int every) -> void
            {
                this.wd.configure(limit_sec, every);
                ->;
            };

            // Runs a code unit as the top-level block. True when it finished without failing.
            execute(int unit, int nloc) -> bool
            {
                switch (this.failed)
                {
                    case (true) { -> false; }
                    default {};
                };
                switch (nloc > this.log_locals) { case (true) { this.log_locals = nloc; } default {}; };
                switch (!this.push_frame(unit, g"<comptime>\0", nloc))
                {
                    case (true) { -> false; }
                    default {};
                };
                this.cur_unit = unit;
                -> this.run();
            };

            // Continues the run after the host served a request
            resume() -> bool
            {
                this.host_kind = 0;
                switch (this.host_arg != (byte*)0) { case (true) { ffree(this.host_arg); } default {}; };
                this.host_arg = (byte*)0;
                -> this.run();
            };

            // Pops the path of a compiler.import.* or compiler.idkvm.dump call and parks the request
            host_request(int kind) -> void
            {
                byte* s = this.pop_text();
                switch (s == (byte*)0) { case (true) { ->; } default {}; };
                this.host_arg = idkvm_dup(s, idkvm_strlen(s));
                switch (this.host_arg == (byte*)0)
                {
                    case (true) { this.fail(g"allocation failed\0"); ->; }
                    default {};
                };
                this.host_kind = kind;
                ->;
            };

            // Runs the main block of the loaded .ivm file
            execute_main() -> bool
            {
                bool ok;
                switch (this.main_unit < 0)
                {
                    case (true) {
                        this.fail(g"no main block loaded\0");
                        -> false;
                    }
                    default {};
                };
                ok = this.execute(this.main_unit, this.main_locals);
                // a standalone run has no compiler behind it to serve an import or a dump
                switch (ok & this.host_kind != 0)
                {
                    case (true) {
                        this.fail(g"compiler.import: no codegen class registered on VM\0");
                        -> false;
                    }
                    default {};
                };
                -> ok;
            };

            // Top of the stack after a run, false when it is empty
            top(int* tag, i64* d, i64* m) -> bool
            {
                switch (this.sp <= 0)
                {
                    case (true) { -> false; }
                    default
                    {
                        *tag = this.st_tag[this.sp - 1];
                        *d = this.st_data[this.sp - 1];
                        *m = this.st_meta[this.sp - 1];
                        -> true;
                    };
                };
            };

            // ===== EXECUTION LOOP =====

            // idkvm.py _run: a run that exceeds the watchdog limit (300 s, checked every 50000
            // instructions) fails as a likely infinite loop
            run() -> bool
            {
                int fi, unit, ip, pc, op;
                this.wd.arm();
                while (this.nframes > 0 & !this.failed & this.host_kind == 0)
                {
                    fi = this.nframes - 1;
                    unit = this.fr_unit[fi];
                    ip = this.fr_ip[fi];
                    switch (ip >= this.code.ulen[unit])
                    {
                        case (true) { this.pop_frame(); }
                        default
                        {
                            pc = this.code.ustart[unit] + ip;
                            op = this.code.ops[pc];
                            this.fr_ip[fi] = ip + 1;
                            switch (this.code.line[pc] != 0)
                            {
                                case (true) { this.last_line = this.code.line[pc]; }
                                default {};
                            };
                            switch (this.trace_on & this.trace_left > 0)
                            {
                                case (true) {
                                    this.trace_line(fi, pc, op);
                                    this.trace_left--;
                                    switch (this.trace_left == 0)
                                    {
                                        case (true) {
                                            this.trace_on = false;
                                            standard::io::console::println(g"[VMTRACE] trace limit reached, auto-disabling\0");
                                        }
                                        default {};
                                    };
                                }
                                default {};
                            };
                            switch (this.wd.tick())
                            {
                                case (true) {
                                    this.fail(g"comptime execution exceeded \0");
                                    this.errb.put_i64(this.wd.limit_sec());
                                    this.errb.put_str(g"s (\0");
                                    this.errb.put_i64(this.wd.count);
                                    this.errb.put_str(g" instructions executed) in function '\0");
                                    this.errb.put_str(this.fr_name[fi]);
                                    this.errb.put_str(g"' at ip=\0");
                                    this.errb.put_int(ip + 1);
                                    this.errb.put_str(g" - likely an infinite loop.\0");
                                    ->  false;
                                }
                                default {};
                            };
                            this.dispatch(op, pc, fi);
                            switch (this.throwing & !this.failed)
                            {
                                case (true) { this.unwind(); }
                                default {};
                            };
                        };
                    };
                };
                // a block that ran to its end joins the log of compiler.idkvm.dump
                switch (!this.failed & this.host_kind == 0 & this.nframes == 0 & this.cur_unit >= 0)
                {
                    case (true) {
                        this.log_block(this.cur_unit);
                        this.cur_unit = -1;
                    }
                    default {};
                };
                -> !this.failed;
            };

            // Walks the frames innermost first for a TRY_BEGIN handler
            unwind() -> void
            {
                int fi;
                while (this.nframes > 0)
                {
                    fi = this.nframes - 1;
                    switch (this.nh > 0 & this.h_frame[this.nh - 1] == fi)
                    {
                        case (true) {
                            this.nh--;
                            this.sp = this.h_depth[this.nh];
                            this.push(this.tv_tag, this.tv_data, this.tv_meta);
                            this.fr_ip[fi] = this.h_catch[this.nh];
                            this.throwing = false;
                            ->;
                        }
                        default {};
                    };
                    this.pop_frame();
                };
                this.throwing = false;
                this.fail(g"Unhandled comptime throw\0");
                ->;
            };

            // ===== ARITHMETIC, BITWISE, COMPARISON =====

            // _binop and friends on integer-like values. Result tag is the tag of the left operand.
            binop(int op) -> void
            {
                int at, bt;
                i64 ad, bd, am, bm, r, e, base;
                bool uns;
                this.pop_val();
                bt = this.pt;
                bd = this.pd;
                bm = this.pm;
                this.pop_val();
                at = this.pt;
                ad = this.pd;
                am = this.pm;
                r = 0;
                switch (this.failed)
                {
                    case (true) { ->; }
                    default {};
                };
                switch (idkvm_isf(at, am) | idkvm_isf(bt, bm))
                {
                    case (true) {
                        this.fbinop(op, at, am, ad, bt, bm, bd);
                        ->;
                    }
                    default {};
                };
                switch (at == IDKVM_T_BYTES & (bt == IDKVM_T_INT | bt == IDKVM_T_UINT | bt == IDKVM_T_LONG | bt == IDKVM_T_ULONG))
                {
                    case (true) {
                        r = this.pin_bytes(ad, am, bd);
                        switch (!this.failed) { case (true) { this.push(IDKVM_T_PTR, r, 0); } default {}; };
                        ->;
                    }
                    default {};
                };
                switch (at == IDKVM_T_BYTES)
                {
                    case (true) {
                        this.stub(g"BYTES arithmetic with a non integer operand\0");
                        ->;
                    }
                    default {};
                };
                switch (!idkvm_is_intlike(at) | !idkvm_is_intlike(bt))
                {
                    case (true) {
                        this.stub(g"arithmetic on struct, array or handle values\0");
                        ->;
                    }
                    default {};
                };
                uns = idkvm_is_unsigned(at);
                switch (op)
                {
                    case (IDKVM_ADD) { r = ad + bd; }
                    case (IDKVM_SUB) { r = ad - bd; }
                    case (IDKVM_MUL) { r = ad * bd; }
                    case (IDKVM_DIV)
                    {
                        switch (bd == (i64)0)
                        {
                            case (true) {
                                this.fail(g"Division by zero in comptime\0");
                                ->;
                            }
                            default {};
                        };
                        switch (uns)
                        {
                            case (true) { r = (i64)((u64)ad / (u64)bd); }
                            default { r = ad / bd; };
                        };
                    }
                    case (IDKVM_MOD)
                    {
                        switch (bd == (i64)0)
                        {
                            case (true) {
                                this.fail(g"Modulo by zero in comptime\0");
                                ->;
                            }
                            default {};
                        };
                        switch (uns)
                        {
                            case (true) { r = (i64)((u64)ad % (u64)bd); }
                            default
                            {
                                // Python floor modulo: the result takes the sign of the divisor
                                r = ad % bd;
                                switch (r != (i64)0 & ((r < (i64)0) != (bd < (i64)0)))
                                {
                                    case (true) { r = r + bd; }
                                    default {};
                                };
                            };
                        };
                    }
                    case (IDKVM_POW)
                    {
                        switch (bd < (i64)0)
                        {
                            case (true) {
                                switch (ad == (i64)0)
                                {
                                    case (true) {
                                        this.fail(g"Division by zero in comptime\0");
                                        ->;
                                    }
                                    default {};
                                };
                                this.push_pow(at, idkvm_dv(at, ad, 0), (double)bd);
                                ->;
                            }
                            default {};
                        };
                        r = 1;
                        base = ad;
                        e = bd;
                        while (e > (i64)0)
                        {
                            switch ((e `& (i64)1) != (i64)0)
                            {
                                case (true) { r = r * base; }
                                default {};
                            };
                            base = base * base;
                            e = e >> 1;
                        };
                    }
                    case (IDKVM_MIN)
                    {
                        switch (uns)
                        {
                            case (true) {
                                switch ((u64)ad < (u64)bd) { case (true) { r = ad; } default { r = bd; }; };
                            }
                            default
                            {
                                switch (ad < bd) { case (true) { r = ad; } default { r = bd; }; };
                            };
                        };
                    }
                    case (IDKVM_MAX)
                    {
                        switch (uns)
                        {
                            case (true) {
                                switch ((u64)ad > (u64)bd) { case (true) { r = ad; } default { r = bd; }; };
                            }
                            default
                            {
                                switch (ad > bd) { case (true) { r = ad; } default { r = bd; }; };
                            };
                        };
                    }
                    case (IDKVM_BAND) { r = ad `& bd; }
                    case (IDKVM_BOR) { r = ad `| bd; }
                    case (IDKVM_BXOR) { r = ad `^| bd; }
                    case (IDKVM_SHL)
                    {
                        switch (bd < (i64)0 | bd > (i64)63)
                        {
                            case (true) { r = 0; }
                            default { r = ad << (int)bd; };
                        };
                    }
                    case (IDKVM_SHR)
                    {
                        switch (bd < (i64)0 | bd > (i64)63)
                        {
                            case (true) { r = 0; }
                            default
                            {
                                switch (uns)
                                {
                                    case (true) { r = idkvm_lsr(ad, (int)bd); }
                                    default { r = ad >> (int)bd; };
                                };
                            };
                        };
                    }
                    case (IDKVM_AND)
                    {
                        switch (ad != (i64)0 & bd != (i64)0) { case (true) { r = 1; } default {}; };
                    }
                    case (IDKVM_OR)
                    {
                        switch (ad != (i64)0 | bd != (i64)0) { case (true) { r = 1; } default {}; };
                    }
                    default {};
                };
                this.push(at, idkvm_wrap(at, r), 0);
                ->;
            };

            // pushes a float result under the tag at
            push_f(int at, double r) -> void
            {
                switch (at == IDKVM_T_FLOAT)
                {
                    case (true) { this.push(at, idkvm_dbl_bits(idkvm_f32_dbl(idkvm_dbl_f32(r))), 0); ->; }
                    default {};
                };
                switch (idkvm_isflt_tag(at))
                {
                    case (true) { this.push(at, idkvm_dbl_bits(r), 0); }
                    default { this.push(at, idkvm_dbl_bits(r), (i64)IDKVM_FMARK); };
                };
                ->;
            };

            // pushes the operand (ct, cd, cm) that MIN, MAX or CLAMP picked, under the tag at
            push_pick(int at, int ct, i64 cd, i64 cm) -> void
            {
                switch (idkvm_isf(ct, cm))
                {
                    case (true) { this.push_f(at, idkvm_bits_dbl(cd)); ->; }
                    default {};
                };
                switch (idkvm_isflt_tag(at))
                {
                    case (true) { this.push_f(at, idkvm_dv(ct, cd, cm)); }
                    default { this.push(at, idkvm_wrap(at, cd), 0); };
                };
                ->;
            };

            push_pow(int at, double a, double b) -> void
            {
                bool ok;
                double r = idkvm_pow(a, b, @ok);
                switch (ok)
                {
                    case (true) { this.push_f(at, r); }
                    default { this.fail(g"POW: the C math library cannot be loaded\0"); };
                };
                ->;
            };

            // binop where at least one operand is a float
            fbinop(int op, int at, i64 am, i64 ad, int bt, i64 bm, i64 bd) -> void
            {
                double a = idkvm_dv(at, ad, am);
                double b = idkvm_dv(bt, bd, bm);
                double r;
                // the usual arithmetic conversions: a double operand makes a double, else a
                // float operand makes a float, else the left tag stays
                int rt = at;
                switch (at == IDKVM_T_DOUBLE | bt == IDKVM_T_DOUBLE) { case (true) { rt = IDKVM_T_DOUBLE; } default { switch (at == IDKVM_T_FLOAT | bt == IDKVM_T_FLOAT) { case (true) { rt = IDKVM_T_FLOAT; } default {}; }; }; };
                switch (op)
                {
                    case (IDKVM_ADD) { this.push_f(rt, a + b); }
                    case (IDKVM_SUB) { this.push_f(rt, a - b); }
                    case (IDKVM_MUL) { this.push_f(rt, a * b); }
                    case (IDKVM_DIV)
                    {
                        switch (b == (double)0.0)
                        {
                            case (true) {
                                this.fail(g"Division by zero in comptime\0");
                                ->;
                            }
                            default {};
                        };
                        switch (idkvm_isflt_tag(rt))
                        {
                            case (true) { this.push_f(rt, a / b); }
                            default { this.push(at, idkvm_wrap(at, idkvm_trunc(a / b)), 0); };
                        };
                    }
                    case (IDKVM_MOD)
                    {
                        switch (b == (double)0.0)
                        {
                            case (true) {
                                this.fail(g"Modulo by zero in comptime\0");
                                ->;
                            }
                            default {};
                        };
                        r = idkvm_fmod(a, b);
                        switch (r != (double)0.0 & ((r < (double)0.0) != (b < (double)0.0)))
                        {
                            case (true) { r = r + b; }
                            default {};
                        };
                        this.push_f(rt, r);
                    }
                    case (IDKVM_POW)
                    {
                        switch (a == (double)0.0 & b < (double)0.0)
                        {
                            case (true) {
                                this.fail(g"Division by zero in comptime\0");
                                ->;
                            }
                            default {};
                        };
                        this.push_pow(rt, a, b);
                    }
                    case (IDKVM_MIN)
                    {
                        switch (a < b)
                        {
                            case (true) { this.push_pick(rt, at, ad, am); }
                            default { this.push_pick(rt, bt, bd, bm); };
                        };
                    }
                    case (IDKVM_MAX)
                    {
                        switch (a > b)
                        {
                            case (true) { this.push_pick(rt, at, ad, am); }
                            default { this.push_pick(rt, bt, bd, bm); };
                        };
                    }
                    case (IDKVM_AND)
                    {
                        switch (a != (double)0.0 & b != (double)0.0) { case (true) { this.push_f(at, (double)1.0); } default { this.push_f(at, (double)0.0); }; };
                    }
                    case (IDKVM_OR)
                    {
                        switch (a != (double)0.0 | b != (double)0.0) { case (true) { this.push_f(at, (double)1.0); } default { this.push_f(at, (double)0.0); }; };
                    }
                    default { this.fail(g"unsupported operand type(s) for a bitwise operation on a float\0"); };
                };
                ->;
            };

            unop(int op) -> void
            {
                int at, k;
                i64 ad, am, r;
                double a;
                this.pop_val();
                at = this.pt;
                ad = this.pd;
                am = this.pm;
                r = 0;
                switch (this.failed)
                {
                    case (true) { ->; }
                    default {};
                };
                switch (idkvm_isf(at, am))
                {
                    case (true) {
                        a = idkvm_dv(at, ad, am);
                        switch (op)
                        {
                            case (IDKVM_NEG) { this.push_f(at, (double)0.0 - a); }
                            case (IDKVM_ABS)
                            {
                                switch (a < (double)0.0) { case (true) { this.push_f(at, (double)0.0 - a); } default { this.push_f(at, a); }; };
                            }
                            case (IDKVM_NOT)
                            {
                                switch (a == (double)0.0) { case (true) { this.push_f(at, (double)1.0); } default { this.push_f(at, (double)0.0); }; };
                            }
                            default { this.fail(g"bad operand type for a bitwise unary operation on a float\0"); };
                        };
                        ->;
                    }
                    default {};
                };
                switch (!idkvm_is_intlike(at))
                {
                    case (true) {
                        this.stub(g"arithmetic on struct, array, bytes or handle values\0");
                        ->;
                    }
                    default {};
                };
                switch (op)
                {
                    case (IDKVM_NEG) { r = (i64)0 - ad; }
                    case (IDKVM_ABS)
                    {
                        switch (ad < (i64)0 & !idkvm_is_unsigned(at)) { case (true) { r = (i64)0 - ad; } default { r = ad; }; };
                    }
                    case (IDKVM_BNOT) { r = `!ad; }
                    case (IDKVM_NOT)
                    {
                        switch (ad == (i64)0) { case (true) { r = 1; } default {}; };
                    }
                    case (IDKVM_POPCOUNT)
                    {
                        k = 0;
                        while (k < 64)
                        {
                            r = r + (idkvm_lsr(ad, k) `& (i64)1);
                            k++;
                        };
                    }
                    default {};
                };
                this.push(at, idkvm_wrap(at, r), 0);
                ->;
            };

            // CMP_*: pushes a BOOL
            cmp(int op) -> void
            {
                int at, bt, c;
                i64 ad, bd, am, bm;
                double fa, fb;
                bool r = false;
                this.pop_val();
                bt = this.pt;
                bd = this.pd;
                bm = this.pm;
                this.pop_val();
                at = this.pt;
                ad = this.pd;
                am = this.pm;
                switch (this.failed)
                {
                    case (true) { ->; }
                    default {};
                };
                switch (idkvm_isf(at, am) | idkvm_isf(bt, bm))
                {
                    case (true) {
                        fa = idkvm_dv(at, ad, am);
                        fb = idkvm_dv(bt, bd, bm);
                        switch (op)
                        {
                            case (IDKVM_CMP_EQ) { r = fa == fb; }
                            case (IDKVM_CMP_NE) { r = fa != fb; }
                            case (IDKVM_CMP_LT) { r = fa < fb; }
                            case (IDKVM_CMP_LE) { r = fa <= fb; }
                            case (IDKVM_CMP_GT) { r = fa > fb; }
                            default { r = fa >= fb; };
                        };
                        switch (r)
                        {
                            case (true) { this.push(IDKVM_T_BOOL, 1, 0); }
                            default { this.push(IDKVM_T_BOOL, 0, 0); };
                        };
                        ->;
                    }
                    default {};
                };
                switch (at == IDKVM_T_BYTES & bt == IDKVM_T_BYTES)
                {
                    case (true) {
                        c = idkvm_strcmp(idkvm_i2p(ad), idkvm_i2p(bd));
                        switch (op)
                        {
                            case (IDKVM_CMP_EQ) { r = c == 0; }
                            case (IDKVM_CMP_NE) { r = c != 0; }
                            case (IDKVM_CMP_LT) { r = c < 0; }
                            case (IDKVM_CMP_LE) { r = c <= 0; }
                            case (IDKVM_CMP_GT) { r = c > 0; }
                            default { r = c >= 0; };
                        };
                    }
                    default
                    {
                        switch (idkvm_is_unsigned(at))
                        {
                            case (true) {
                                switch (op)
                                {
                                    case (IDKVM_CMP_EQ) { r = ad == bd; }
                                    case (IDKVM_CMP_NE) { r = ad != bd; }
                                    case (IDKVM_CMP_LT) { r = (u64)ad < (u64)bd; }
                                    case (IDKVM_CMP_LE) { r = (u64)ad <= (u64)bd; }
                                    case (IDKVM_CMP_GT) { r = (u64)ad > (u64)bd; }
                                    default { r = (u64)ad >= (u64)bd; };
                                };
                            }
                            default
                            {
                                switch (op)
                                {
                                    case (IDKVM_CMP_EQ) { r = ad == bd; }
                                    case (IDKVM_CMP_NE) { r = ad != bd; }
                                    case (IDKVM_CMP_LT) { r = ad < bd; }
                                    case (IDKVM_CMP_LE) { r = ad <= bd; }
                                    case (IDKVM_CMP_GT) { r = ad > bd; }
                                    default { r = ad >= bd; };
                                };
                            };
                        };
                    };
                };
                switch (r)
                {
                    case (true) { this.push(IDKVM_T_BOOL, 1, 0); }
                    default { this.push(IDKVM_T_BOOL, 0, 0); };
                };
                ->;
            };

            // CLAMP: pops hi, lo, val
            clamp() -> void
            {
                int vt, ht, lt;
                i64 hi, lo, v, hm, lm, vm;
                double fv, fl, fh;
                this.pop_val();
                ht = this.pt;
                hi = this.pd;
                hm = this.pm;
                this.pop_val();
                lt = this.pt;
                lo = this.pd;
                lm = this.pm;
                this.pop_val();
                vt = this.pt;
                v = this.pd;
                vm = this.pm;
                switch (this.failed)
                {
                    case (true) { ->; }
                    default {};
                };
                switch (idkvm_isf(vt, vm) | idkvm_isf(lt, lm) | idkvm_isf(ht, hm))
                {
                    case (true) {
                        fv = idkvm_dv(vt, v, vm);
                        fl = idkvm_dv(lt, lo, lm);
                        fh = idkvm_dv(ht, hi, hm);
                        switch (fv < fl)
                        {
                            case (true) { this.push_pick(vt, lt, lo, lm); }
                            default {
                                switch (fv > fh)
                                {
                                    case (true) { this.push_pick(vt, ht, hi, hm); }
                                    default { this.push_pick(vt, vt, v, vm); };
                                };
                            };
                        };
                        ->;
                    }
                    default {};
                };
                switch (v < lo)
                {
                    case (true) { v = lo; }
                    default {
                        switch (v > hi) { case (true) { v = hi; } default {}; };
                    };
                };
                this.push(vt, v, 0);
                ->;
            };

            // ROTL ROTR BITREV CLZ CTZ over `width` bits
            bitop(int op, int width) -> void
            {
                int vt, k, sh, cnt;
                i64 vd, mask, n, r, sd;
                switch (width <= 0 | width > 64)
                {
                    case (true) {
                        this.fail(g"bit width out of range\0");
                        ->;
                    }
                    default {};
                };
                switch (op == IDKVM_ROTL | op == IDKVM_ROTR)
                {
                    case (true) {
                        this.pop_val();
                        sd = this.pd;
                    }
                    default {};
                };
                this.pop_val();
                vt = this.pt;
                vd = this.pd;
                switch (this.failed)
                {
                    case (true) { ->; }
                    default {};
                };
                switch (width >= 64)
                {
                    case (true) { mask = `!(0); }
                    default { mask = ((i64)1 << width) - (i64)1; };
                };
                n = vd `& mask;
                switch (op)
                {
                    case (IDKVM_ROTL)
                    {
                        sh = (int)(sd % (i64)width);
                        switch (sh < 0) { case (true) { sh = sh + width; } default {}; };
                        switch (sh == 0)
                        {
                            case (true) { r = n; }
                            default { r = ((n << sh) `| idkvm_lsr(n, width - sh)) `& mask; };
                        };
                        this.push(vt, r, 0);
                    }
                    case (IDKVM_ROTR)
                    {
                        sh = (int)(sd % (i64)width);
                        switch (sh < 0) { case (true) { sh = sh + width; } default {}; };
                        switch (sh == 0)
                        {
                            case (true) { r = n; }
                            default { r = (idkvm_lsr(n, sh) `| (n << (width - sh))) `& mask; };
                        };
                        this.push(vt, r, 0);
                    }
                    case (IDKVM_BITREV)
                    {
                        r = 0;
                        k = 0;
                        while (k < width)
                        {
                            r = (r << 1) `| (idkvm_lsr(n, k) `& (i64)1);
                            k++;
                        };
                        this.push(vt, r, 0);
                    }
                    case (IDKVM_CLZ)
                    {
                        cnt = 0;
                        k = width - 1;
                        while (k >= 0 & (idkvm_lsr(n, k) `& (i64)1) == (i64)0)
                        {
                            cnt++;
                            k--;
                        };
                        this.push(IDKVM_T_UINT, (i64)cnt, 0);
                    }
                    default
                    {
                        cnt = 0;
                        k = 0;
                        while (k < width & (idkvm_lsr(n, k) `& (i64)1) == (i64)0)
                        {
                            cnt++;
                            k++;
                        };
                        this.push(IDKVM_T_UINT, (i64)cnt, 0);
                    };
                };
                ->;
            };

            // ===== CALLS =====

            // Copies the top argc stack values into local slots 0..argc-1 of frame fi
            take_args(int fi, int argc) -> void
            {
                int k = argc - 1;
                int slot;
                switch (!this.need(argc))
                {
                    case (true) { ->; }
                    default {};
                };
                while (k >= 0)
                {
                    this.pop_val();
                    slot = this.fr_base[fi] + k;
                    this.lc_tag[slot] = this.pt;
                    this.lc_set[slot] = 1;
                    this.lc_data[slot] = this.pd;
                    this.lc_meta[slot] = this.pm;
                    k--;
                };
                ->;
            };

            // _sig_score of _call: the argument tags against the tokens of an overload signature.
            // A BYTES argument likes an 'arr' token, a PTR a 'ptr' token, any other argument a
            // plain one.
            sig_score(byte* sig, int argc) -> int
            {
                int score, a, i, ts, te, tag;
                bool arr;
                switch (sig[0] == 0 | this.sp < argc)
                {
                    case (true) { -> 0; }
                    default {};
                };
                while (a < argc)
                {
                    ts = i;
                    while (sig[i] != 0 & sig[i] != '_') { i++; };
                    te = i;
                    arr = te - ts >= 3 & ((sig[te - 3] == 'a' & sig[te - 2] == 'r' & sig[te - 1] == 'r') | (sig[te - 3] == 'p' & sig[te - 2] == 't' & sig[te - 1] == 'r'));
                    tag = this.st_tag[this.sp - argc + a];
                    switch (tag == IDKVM_T_BYTES & te - ts >= 3 & sig[te - 3] == 'a' & sig[te - 2] == 'r' & sig[te - 1] == 'r')
                    {
                        case (true) { score = score + 2; }
                        default
                        {
                            switch (tag == IDKVM_T_PTR & te - ts >= 3 & sig[te - 3] == 'p' & sig[te - 2] == 't' & sig[te - 1] == 'r')
                            {
                                case (true) { score = score + 2; }
                                default
                                {
                                    switch (tag != IDKVM_T_BYTES & tag != IDKVM_T_PTR & !arr) { case (true) { score = score + 1; } default {}; };
                                };
                            };
                        };
                    };
                    switch (sig[i] == '_') { case (true) { i++; } default {}; };
                    a++;
                };
                -> score;
            };

            // double that holds the bits of a float in its low 32 bits (the xmm register of a float argument)
            flt_reg(double d) -> double
            {
                float f = (float)d;
                i32* fp = (i32*)@f;
                i64 b = (i64)(u32)(*fp);
                -> idkvm_bits_dbl(b);
            };

            // An extern call through the C runtime: the symbol comes from dlsym, the call goes
            // through a function pointer with 6 + 6 integer and 8 float argument slots
            call_extern(byte* name, int argc) -> void
            {
                int e = this.extern_find(name);
                int ret = this.x_ret[e];
                i64* pt = this.x_pt[e];
                int np = (int)pt[0];
                i64* av;
                int k, ni, nf, ptag, t;
                i64 d, m, r, sz;
                i64[12] iv;
                double[8] fv;
                double dv, fr;
                byte* sym, cp;
                bool bad;
                float frf;
                int nm0;
                byte ch;
                this.errb.clear();
                av = (i64*)idkvm_alloc((argc + 1) * 3 * 8);
                switch (av == (i64*)0)
                {
                    case (true) { this.fail(g"allocation failed\0"); ->; }
                    default {};
                };
                k = argc - 1;
                while (k >= 0)
                {
                    this.pop_val();
                    av[k * 3] = (i64)this.pt;
                    av[k * 3 + 1] = this.pd;
                    av[k * 3 + 2] = this.pm;
                    k--;
                };
                switch (this.failed) { case (true) { ffree((byte*)av); ->; } default {}; };
                sym = idkvm_find_sym(name);
                switch (sym == (byte*)0)
                {
                    case (true) {
                        this.fail_parts(g"extern: symbol '\0", name, g"' not found in any loaded library\0", g"\0");
                        ffree((byte*)av);
                        ->;
                    }
                    default {};
                };
                k = 0;
                while (k < argc)
                {
                    t = (int)av[k * 3];
                    d = av[k * 3 + 1];
                    m = av[k * 3 + 2];
                    // the declared parameter type, past it the default promotion of a float
                    switch (t != IDKVM_T_BYTES & t != IDKVM_T_PTR)
                    {
                        case (true) {
                            switch (k < np)
                            {
                                case (true) {
                                    ptag = (int)pt[1 + k];
                                    dv = idkvm_dv(t, d, m);
                                    switch (ptag == IDKVM_T_FLOAT | ptag == IDKVM_T_DOUBLE)
                                    {
                                        case (true) { d = idkvm_dbl_bits(dv); t = ptag; m = 0; }
                                        default
                                        {
                                            switch (idkvm_is_intlike(ptag) | ptag == IDKVM_T_PTR)
                                            {
                                                case (true) {
                                                    switch (idkvm_isf(t, m)) { case (true) { d = idkvm_trunc(dv); } default {}; };
                                                    t = ptag;
                                                    m = 0;
                                                }
                                                default {};
                                            };
                                        };
                                    };
                                }
                                default
                                {
                                    switch (t == IDKVM_T_FLOAT) { case (true) { t = IDKVM_T_DOUBLE; } default {}; };
                                };
                            };
                        }
                        default {};
                    };
                    // into a register slot
                    bad = false;
                    switch (idkvm_is_intlike(t) & idkvm_isf(t, m))
                    {
                        case (true) { d = idkvm_trunc(idkvm_bits_dbl(d)); m = 0; }
                        default {};
                    };
                    switch (t)
                    {
                        case (IDKVM_T_FLOAT) { switch (nf >= 8) { case (true) { bad = true; } default { fv[nf] = this.flt_reg(idkvm_bits_dbl(d)); nf++; }; }; }
                        case (IDKVM_T_DOUBLE) { switch (nf >= 8) { case (true) { bad = true; } default { fv[nf] = idkvm_bits_dbl(d); nf++; }; }; }
                        default
                        {
                            switch (ni >= 12)
                            {
                                case (true) { bad = true; }
                                default
                                {
                                    switch (t)
                                    {
                                        case (IDKVM_T_INT) { iv[ni] = (i64)(int)d; }
                                        case (IDKVM_T_UINT) { iv[ni] = d `& (i64)4294967295; }
                                        case (IDKVM_T_LONG) { iv[ni] = d; }
                                        case (IDKVM_T_ULONG) { iv[ni] = d; }
                                        case (IDKVM_T_BOOL) { switch (d != (i64)0) { case (true) { iv[ni] = 1; } default { iv[ni] = 0; }; }; }
                                        case (IDKVM_T_BYTE) { iv[ni] = d `& (i64)255; }
                                        case (IDKVM_T_CHAR) { iv[ni] = d `& (i64)255; }
                                        case (IDKVM_T_PTR) { iv[ni] = d; }
                                        case (IDKVM_T_BYTES)
                                        {
                                            cp = idkvm_alloc((int)m + 1);
                                            switch (cp == (byte*)0) { case (true) { this.fail(g"allocation failed\0"); } default { idkvm_copy(cp, idkvm_i2p(d), (int)m); }; };
                                            this.pin_keep(cp);
                                            iv[ni] = idkvm_p2i(cp);
                                        }
                                        default
                                        {
                                            this.errb.clear();
                                            this.errb.put_str(g"_val_to_ctype: unhandled tag TTag.\0");
                                            cp = idkvm_ttag_name(t);
                                            nm0 = 0;
                                            while (cp[nm0] != 0)
                                            {
                                                ch = cp[nm0];
                                                switch (ch >= 'a' & ch <= 'z') { case (true) { ch = (byte)(ch - 32); } default {}; };
                                                this.errb.put(ch);
                                                nm0++;
                                            };
                                            this.failed = true;
                                        };
                                    };
                                    ni++;
                                };
                            };
                        };
                    };
                    switch (bad)
                    {
                        case (true) {
                            this.fail_parts(g"extern call '\0", name, g"': more than 12 integer or 8 float arguments are not supported\0", g"\0");
                        }
                        default {};
                    };
                    switch (this.failed)
                    {
                        case (true) {
                            k = argc;
                        }
                        default { k++; };
                    };
                };
                r = 0;
                fr = (double)0.0;
                switch (!this.failed)
                {
                    case (true) {
                        switch (ret)
                        {
                            case (IDKVM_T_DOUBLE)
                            {
                                def{}* fd(i64, i64, i64, i64, i64, i64, double, double, double, double, double, double, double, double, i64, i64, i64, i64, i64, i64) -> double = sym;
                                fr = fd(iv[0], iv[1], iv[2], iv[3], iv[4], iv[5], fv[0], fv[1], fv[2], fv[3], fv[4], fv[5], fv[6], fv[7], iv[6], iv[7], iv[8], iv[9], iv[10], iv[11]);
                            }
                            case (IDKVM_T_FLOAT)
                            {
                                def{}* ff(i64, i64, i64, i64, i64, i64, double, double, double, double, double, double, double, double, i64, i64, i64, i64, i64, i64) -> float = sym;
                                frf = ff(iv[0], iv[1], iv[2], iv[3], iv[4], iv[5], fv[0], fv[1], fv[2], fv[3], fv[4], fv[5], fv[6], fv[7], iv[6], iv[7], iv[8], iv[9], iv[10], iv[11]);
                                fr = (double)frf;
                            }
                            default
                            {
                                def{}* fi(i64, i64, i64, i64, i64, i64, double, double, double, double, double, double, double, double, i64, i64, i64, i64, i64, i64) -> i64 = sym;
                                r = fi(iv[0], iv[1], iv[2], iv[3], iv[4], iv[5], fv[0], fv[1], fv[2], fv[3], fv[4], fv[5], fv[6], fv[7], iv[6], iv[7], iv[8], iv[9], iv[10], iv[11]);
                            };
                        };
                        // the value of the declared return type
                        switch (ret)
                        {
                            case (IDKVM_T_INT) { r = (i64)(int)r; }
                            case (IDKVM_T_UINT) { r = r `& (i64)4294967295; }
                            case (IDKVM_T_BYTE) { r = r `& (i64)255; }
                            case (IDKVM_T_CHAR) { r = r `& (i64)255; }
                            case (IDKVM_T_BOOL) { switch ((r `& (i64)255) != (i64)0) { case (true) { r = 1; } default { r = 0; }; }; }
                            default {};
                        };
                        switch (ret)
                        {
                            case (IDKVM_T_VOID) { this.push(IDKVM_T_VOID, 0, 0); }
                            case (IDKVM_T_FLOAT) { this.push(IDKVM_T_FLOAT, idkvm_dbl_bits(fr), 0); }
                            case (IDKVM_T_DOUBLE) { this.push(IDKVM_T_DOUBLE, idkvm_dbl_bits(fr), 0); }
                            case (IDKVM_T_PTR)
                            {
                                switch (r != (i64)0)
                                {
                                    case (true) {
                                        this.os_add(r);
                                        // a first integer argument is the size to zero
                                        sz = 0;
                                        switch (argc > 0)
                                        {
                                            case (true) {
                                                t = (int)av[0];
                                                switch (t == IDKVM_T_INT | t == IDKVM_T_UINT | t == IDKVM_T_LONG | t == IDKVM_T_ULONG)
                                                {
                                                    case (true) {
                                                        sz = av[1];
                                                        switch (idkvm_isf(t, av[2])) { case (true) { sz = idkvm_trunc(idkvm_bits_dbl(av[1])); } default {}; };
                                                    }
                                                    default {};
                                                };
                                            }
                                            default {};
                                        };
                                        cp = idkvm_i2p(r);
                                        k = 0;
                                        while ((i64)k < sz) { cp[k] = 0; k++; };
                                    }
                                    default {};
                                };
                                this.push(IDKVM_T_PTR, r, 0);
                            }
                            default
                            {
                                switch (ret == IDKVM_T_ULONG)
                                {
                                    case (true) {
                                        switch (r < (i64)0 | r > (i64)65535) { case (true) { this.os_add(r); } default {}; };
                                    }
                                    default
                                    {
                                        switch ((ret == IDKVM_T_LONG | ret == IDKVM_T_INT | ret == IDKVM_T_UINT) & r > (i64)65535) { case (true) { this.os_add(r); } default {}; };
                                    };
                                };
                                this.push(ret, r, 0);
                            };
                        };
                    }
                    default {};
                };
                ffree((byte*)av);
                ->;
            };

            // _call: exact name, then a unique '__name' suffix match, then the
            // arity of '__$' overload signatures, extern prototypes go to the C runtime.
            do_call(byte* name, int argc) -> void
            {
                int idx = this.funcs.find(name);
                int i, hits, first, p, ln, pl, sigc, sc, bsc;
                bool any;
                byte* nm, key;
                switch (idx < 0)
                {
                    case (true) {
                        hits = 0;
                        while (i < this.funcs.n)
                        {
                            switch (idkvm_ends_dunder(this.funcs.names[i], name))
                            {
                                case (true) {
                                    hits++;
                                    first = i;
                                }
                                default {};
                            };
                            i++;
                        };
                        switch (hits > 1)
                        {
                            case (true) {
                                this.fail_name(g"Ambiguous comptime function: \0", name);
                                ->;
                            }
                            default {};
                        };
                        switch (hits == 1)
                        {
                            case (true) { idx = first; }
                            default
                            {
                                switch (this.extern_find(name) >= 0)
                                {
                                    case (true) {
                                        this.call_extern(name, argc);
                                        ->;
                                    }
                                    default
                                    {
                                        this.fail_parts(g"Unknown comptime function: '\0", name, g"'\0", g"\0");
                                        ->;
                                    };
                                };
                            };
                        };
                    }
                    default {};
                };
                nm = this.funcs.names[idx];
                switch (this.extern_find(nm) >= 0)
                {
                    case (true) {
                        this.call_extern(nm, argc);
                        ->;
                    }
                    default {};
                };

                // Arity based overload resolution from '__$' signatures
                this.tmp.clear();
                this.tmp.put_str(nm);
                this.tmp.put_str(g"__$\0");
                any = false;
                hits = 0;
                first = -1;
                i = 0;
                while (i < this.funcs.n)
                {
                    switch (idkvm_starts_with(this.funcs.names[i], this.tmp.mem))
                    {
                        case (true) {
                            any = true;
                            sigc = idkvm_sig_argc(this.funcs.names[i] + this.tmp.len);
                            switch (sigc == argc)
                            {
                                case (true) {
                                    hits++;
                                    sc = this.sig_score(this.funcs.names[i] + this.tmp.len, argc);
                                    switch (first < 0 | sc > bsc) { case (true) { first = i; bsc = sc; } default {}; };
                                }
                                default {};
                            };
                        }
                        default {};
                    };
                    i++;
                };
                switch (!any)
                {
                    case (true) {
                        ln = idkvm_strlen(nm);
                        i = 0;
                        while (i < this.funcs.n)
                        {
                            key = this.funcs.names[i];
                            p = idkvm_find_sig(key);
                            switch (p >= ln + 2)
                            {
                                case (true) {
                                    switch (key[p - ln - 2] == '_' & key[p - ln - 1] == '_' & idkvm_eq_n(key + p - ln, ln, nm))
                                    {
                                        case (true) {
                                            any = true;
                                            sigc = idkvm_sig_argc(key + p + 3);
                                            switch (sigc == argc)
                                            {
                                                case (true) {
                                                    hits++;
                                                    sc = this.sig_score(key + p + 3, argc);
                                                    switch (first < 0 | sc > bsc) { case (true) { first = i; bsc = sc; } default {}; };
                                                }
                                                default {};
                                            };
                                        }
                                        default {};
                                    };
                                }
                                default {};
                            };
                            i++;
                        };
                    }
                    default {};
                };
                switch (hits >= 1)
                {
                    case (true) {
                        idx = first;
                    }
                    default {};
                };

                switch (argc > IDKVM_CALL_LOCALS)
                {
                    case (true) { pl = argc; }
                    default { pl = IDKVM_CALL_LOCALS; };
                };
                switch (!this.push_frame(this.funcs.units[idx], this.funcs.names[idx], pl))
                {
                    case (true) { ->; }
                    default {};
                };
                this.take_args(this.nframes - 1, argc);
                ->;
            };

            // ===== MEMORY =====

            // LOAD <ttag> <size>: pops a heap pointer, pushes the value
            // The PTR meta that names a struct type: the name is interned once
            tn_intern(byte* name) -> i64
            {
                int k;
                byte** nn;
                while (k < this.tn_n)
                {
                    switch (idkvm_streq(this.tn_name[k], name)) { case (true) { -> (i64)(IDKVM_META_TYPE + k); } default {}; };
                    k++;
                };
                switch (this.tn_n >= this.tn_cap)
                {
                    case (true)
                    {
                        nn = (byte**)idkvm_grow((byte*)this.tn_name, this.tn_cap * 2 * 8);
                        switch (nn == (byte**)0) { case (true) { this.fail(g"allocation failed\0"); -> 0; } default {}; };
                        this.tn_name = nn;
                        this.tn_cap = this.tn_cap * 2;
                    }
                    default {};
                };
                this.tn_name[this.tn_n] = idkvm_dup(name, idkvm_strlen(name));
                this.tn_n++;
                -> (i64)(IDKVM_META_TYPE + this.tn_n - 1);
            };

            // The layout a struct PTR points at, -1 after an error
            ptr_layout(i64 pm) -> int
            {
                int li;
                li = this.layouts.find(this.tn_name[(int)(pm - (i64)IDKVM_META_TYPE)]);
                switch (li < 0)
                {
                    case (true) { this.fail_parts(g"Unknown struct/object type: '\0", this.tn_name[(int)(pm - (i64)IDKVM_META_TYPE)], g"'\0", g"\0"); }
                    default {};
                };
                -> li;
            };

            // Field of a struct PTR: the index into the layout's field table, -1 after an error
            ptr_field(int li, byte* field) -> int
            {
                int k = this.field_index(li, field);
                switch (k < 0)
                {
                    case (true)
                    {
                        this.fail_parts(g"Field '\0", field, g"' not found in '\0", this.layouts.sname[li]);
                        this.errb.put_str(g"'\0");
                        -> -1;
                    }
                    default {};
                };
                -> this.layouts.sfirst[li] + k;
            };

            // LOAD <ttag> <size> [type]: pops a heap pointer
            do_load(int tag, int size, byte* tname) -> void
            {
                int pt0;
                i64 pd0, pm0;
                this.pop_val();
                pt0 = this.pt;
                pd0 = this.pd;
                pm0 = this.pm;
                switch (this.failed)
                {
                    case (true) { ->; }
                    default {};
                };
                switch (tag == IDKVM_T_STRUCT)
                {
                    case (true) { this.load_struct(size, tname, pm0, pd0); ->; }
                    default {};
                };
                this.load_at(tag, size, pd0);
                ->;
            };

            // A scalar of tag and size at a heap address
            load_at(int tag, int size, i64 pd0) -> void
            {
                i64 v;
                switch (tag == IDKVM_T_FLOAT & (size < 4 | size > 8))
                {
                    case (true) {
                        this.fail(g"LOAD: unsupported byte size\0");
                        ->;
                    }
                    default {};
                };
                switch (tag == IDKVM_T_DOUBLE & size != 8)
                {
                    case (true) {
                        this.fail(g"LOAD: unsupported byte size\0");
                        ->;
                    }
                    default {};
                };
                switch (size <= 0 | size > 8)
                {
                    case (true) {
                        this.fail(g"LOAD: unsupported byte size\0");
                        ->;
                    }
                    default {};
                };
                switch (!this.mem_ok(pd0, size))
                {
                    case (true) {
                        this.fail(g"VMHeap: out-of-bounds access\0");
                        ->;
                    }
                    default {};
                };
                switch (tag == IDKVM_T_FLOAT)
                {
                    case (true) {
                        switch (!this.mem_ok(pd0, 4))
                        {
                            case (true) {
                                this.fail(g"VMHeap: out-of-bounds access\0");
                                ->;
                            }
                            default {};
                        };
                        this.push(IDKVM_T_FLOAT, idkvm_dbl_bits(idkvm_f32_dbl(this.mem_rd(pd0, 4))), 0);
                        ->;
                    }
                    default {};
                };
                switch (tag == IDKVM_T_DOUBLE)
                {
                    case (true) {
                        this.push(IDKVM_T_DOUBLE, this.mem_rd(pd0, 8), 0);
                        ->;
                    }
                    default {};
                };
                v = this.mem_rd(pd0, size);
                switch (tag == IDKVM_T_INT | tag == IDKVM_T_LONG)
                {
                    case (true) {
                        switch (size < 8)
                        {
                            case (true) {
                                switch ((v `& ((i64)1 << (size * 8 - 1))) != (i64)0)
                                {
                                    case (true) { v = v - ((i64)1 << (size * 8)); }
                                    default {};
                                };
                            }
                            default {};
                        };
                    }
                    default {};
                };
                this.push(tag, v, 0);
                ->;
            };

            // LOAD of a struct: the fields are rebuilt from the layout. The type is the operand,
            // else the one the pointer was cast to, else the first layout of that byte size.
            load_struct(int size, byte* tname, i64 pm0, i64 addr) -> void
            {
                int li = -1;
                int n, k, f, ft, fs;
                i64* b;
                switch (tname != (byte*)0)
                {
                    case (true)
                    {
                        li = this.layouts.find(tname);
                        switch (li < 0) { case (true) { this.fail_parts(g"Unknown struct/object type: '\0", tname, g"'\0", g"\0"); ->; } default {}; };
                    }
                    default
                    {
                        switch (pm0 >= (i64)IDKVM_META_TYPE)
                        {
                            case (true) { li = this.ptr_layout(pm0); }
                            default
                            {
                                k = 0;
                                while (k < this.layouts.n & li < 0)
                                {
                                    switch (this.layouts.ssize[k] == size) { case (true) { li = k; } default {}; };
                                    k++;
                                };
                            };
                        };
                    };
                };
                switch (this.failed) { case (true) { ->; } default {}; };
                switch (li < 0)
                {
                    case (true) { this.stub(g"LOAD of a struct without a known type\0"); ->; }
                    default {};
                };
                switch (!this.mem_ok(addr, size))
                {
                    case (true) { this.fail(g"VMHeap: out-of-bounds access\0"); ->; }
                    default {};
                };
                n = this.layouts.scount[li];
                b = this.arr_make(n, 0);
                switch (this.failed) { case (true) { ->; } default {}; };
                b[1] = (i64)li;
                k = 0;
                while (k < n)
                {
                    f = this.layouts.sfirst[li] + k;
                    ft = this.layouts.ftag[f];
                    fs = this.layouts.fsize[f];
                    this.load_at(ft, fs, addr + (i64)this.layouts.foff[f]);
                    switch (this.failed) { case (true) { ->; } default {}; };
                    this.pop_val();
                    b[2 + k * 3] = (i64)this.pt;
                    b[3 + k * 3] = this.pd;
                    b[4 + k * 3] = this.pm;
                    k++;
                };
                this.push(IDKVM_T_STRUCT, (i64)b, (i64)li);
                ->;
            };

            // STORE <ttag> <size> [type]: pops the value and a heap pointer
            do_store(int tag, int size) -> void
            {
                int vt;
                i64 vd, vm, pd0;
                this.pop_val();
                vt = this.pt;
                vd = this.pd;
                vm = this.pm;
                this.pop_val();
                pd0 = this.pd;
                switch (this.failed)
                {
                    case (true) { ->; }
                    default {};
                };
                switch (vt == IDKVM_T_STRUCT & tag == IDKVM_T_STRUCT)
                {
                    case (true) { this.store_struct(size, vd, pd0); ->; }
                    default {};
                };
                this.store_at(tag, size, vt, vd, vm, pd0);
                ->;
            };

            // STORE of a struct value: the bytes are zero, then every field of the layout is written
            store_struct(int size, i64 blk, i64 addr) -> void
            {
                i64* b = (i64*)blk;
                int li = (int)b[1];
                int n = this.layouts.scount[li];
                int k, f, i;
                switch (!this.mem_ok(addr, size))
                {
                    case (true) { this.fail(g"VMHeap: out-of-bounds access\0"); ->; }
                    default {};
                };
                while (i < size)
                {
                    this.mem_wr(addr + (i64)i, 1, 0);
                    i++;
                };
                while (k < n)
                {
                    f = this.layouts.sfirst[li] + k;
                    this.store_at(this.layouts.ftag[f], this.layouts.fsize[f], (int)b[2 + k * 3], b[3 + k * 3], b[4 + k * 3], addr + (i64)this.layouts.foff[f]);
                    switch (this.failed) { case (true) { ->; } default {}; };
                    k++;
                };
                ->;
            };

            // A scalar of the declared tag and size at a heap address
            store_at(int tag, int size, int vt, i64 vd, i64 vm, i64 pd0) -> void
            {
                switch (vt == IDKVM_T_STRUCT | vt == IDKVM_T_ARRAY | vt == IDKVM_T_BYTES | tag == IDKVM_T_STRUCT)
                {
                    case (true) {
                        this.stub(g"STORE of a struct, array or bytes value\0");
                        ->;
                    }
                    default {};
                };
                // the declared type of the destination dictates the stored representation
                switch (idkvm_isf(vt, vm) & idkvm_is_intlike(tag) & tag != IDKVM_T_BOOL)
                {
                    case (true) { vd = idkvm_trunc(idkvm_bits_dbl(vd)); vt = tag; }
                    default {};
                };
                switch (tag == IDKVM_T_FLOAT | tag == IDKVM_T_DOUBLE)
                {
                    case (true) {
                        switch (idkvm_is_intlike(vt) & !idkvm_isf(vt, vm))
                        {
                            case (true) { vd = idkvm_dbl_bits(idkvm_dv(vt, vd, vm)); }
                            default {};
                        };
                        vt = tag;
                    }
                    default {};
                };
                switch (vt == IDKVM_T_FLOAT)
                {
                    case (true) {
                        switch (!this.mem_ok(pd0, 4))
                        {
                            case (true) {
                                this.fail(g"VMHeap: out-of-bounds access\0");
                                ->;
                            }
                            default {};
                        };
                        this.mem_wr(pd0, 4, idkvm_dbl_f32(idkvm_bits_dbl(vd)));
                        ->;
                    }
                    default {};
                };
                switch (vt == IDKVM_T_DOUBLE)
                {
                    case (true) {
                        switch (!this.mem_ok(pd0, 8))
                        {
                            case (true) {
                                this.fail(g"VMHeap: out-of-bounds access\0");
                                ->;
                            }
                            default {};
                        };
                        this.mem_wr(pd0, 8, vd);
                        ->;
                    }
                    default {};
                };
                switch (size <= 0 | size > 8)
                {
                    case (true) {
                        this.fail(g"STORE: unsupported byte size\0");
                        ->;
                    }
                    default {};
                };
                switch (!this.mem_ok(pd0, size))
                {
                    case (true) {
                        this.fail(g"VMHeap: out-of-bounds access\0");
                        ->;
                    }
                    default {};
                };
                this.mem_wr(pd0, size, vd);
                ->;
            };

            // ===== INTROSPECTION =====

            // ALIGNOF: largest field of a struct, otherwise the type size
            align_of(byte* name) -> int
            {
                int e = this.layouts.find(name);
                int k, best, f;
                switch (e < 0)
                {
                    case (true) { -> this.type_size(name); }
                    default {};
                };
                best = 1;
                k = 0;
                while (k < this.layouts.scount[e])
                {
                    f = this.layouts.sfirst[e] + k;
                    switch (this.layouts.fsize[f] > best) { case (true) { best = this.layouts.fsize[f]; } default {}; };
                    k++;
                };
                -> best;
            };

            // ===== compiler.io and compiler.idkvm host operations =====

            // errno of the C runtime and its text
            errno_info(int* en) -> byte*
            {
                byte* sym, ep;
                byte* txt = g"\0";
                *en = 0;
#ifdef __WINDOWS__
                sym = idkvm_find_sym(g"_errno\0");
#endif;
#ifdef __LINUX__
                sym = idkvm_find_sym(g"__errno_location\0");
#endif;
                switch (sym != (byte*)0)
                {
                    case (true) {
                        def{}* ef() -> byte* = sym;
                        ep = ef();
                        *en = *(int*)ep;
                    }
                    default {};
                };
                sym = idkvm_find_sym(g"strerror\0");
                switch (sym != (byte*)0)
                {
                    case (true) {
                        def{}* sf(int) -> byte* = sym;
                        txt = sf(*en);
                    }
                    default {};
                };
                -> txt;
            };

            // Fails with the text of an OSError: "<what>[Errno N] <strerror>: '<path>'"
            errno_fail(byte* what, byte* path) -> void
            {
                byte* txt;
                int en;
                txt = this.errno_info(@en);
                this.tmp.clear();
                this.tmp.put_str(what);
                this.tmp.put_str(g"[Errno \0");
                this.tmp.put_int(en);
                this.tmp.put_str(g"] \0");
                this.tmp.put_str(txt);
                switch (path != (byte*)0)
                {
                    case (true) {
                        this.tmp.put_str(g": '\0");
                        this.tmp.put_str(path);
                        this.tmp.put(39);
                    }
                    default {};
                };
                this.fail(this.tmp.mem);
                ->;
            };

            // Fails the way a termios.error prints: "(N, 'strerror')"
            errno_tuple_fail() -> void
            {
                byte* txt;
                int en;
                txt = this.errno_info(@en);
                this.tmp.clear();
                this.tmp.put(40);
                this.tmp.put_int(en);
                this.tmp.put_str(g", '\0");
                this.tmp.put_str(txt);
                this.tmp.put_str(g"')\0");
                this.fail(this.tmp.mem);
                ->;
            };

            // The text of the popped value as a string for a compiler.* call, or null after a failure
            pop_text() -> byte*
            {
                byte* s;
                this.pop_val();
                switch (this.failed) { case (true) { -> (byte*)0; } default {}; };
                s = this.str_of(this.pt, this.pd);
                switch (s == (byte*)0)
                {
                    case (true) {
                        this.fail(g"_read_vm_string: cannot read string from value\0");
                        -> (byte*)0;
                    }
                    default {};
                };
                -> s;
            };

            // Writes a string to the C runtime stderr (file descriptor 2)
            err_print(byte* s) -> void
            {
                byte* sym;
#ifdef __WINDOWS__
                sym = idkvm_find_sym(g"_write\0");
#endif;
#ifdef __LINUX__
                sym = idkvm_find_sym(g"write\0");
#endif;
                switch (sym != (byte*)0)
                {
                    case (true) {
                        def{}* wf(int, byte*, int) -> int = sym;
                        wf(2, s, idkvm_strlen(s));
                    }
                    default {};
                };
                ->;
            };

            // compiler.io.console.input: one line of stdin including its newline, as BYTES
            op_input() -> void
            {
                byte* sym = idkvm_find_sym(g"getchar\0");
                int c;
                switch (sym == (byte*)0)
                {
                    case (true) {
                        this.fail(g"compiler.io.console.input: stdin is not available\0");
                        ->;
                    }
                    default {};
                };
                def{}* gc() -> int = sym;
                this.tmp.clear();
                c = gc();
                while (c >= 0)
                {
                    this.tmp.put(c);
                    switch (c == 10) { case (true) { c = -1; } default { c = gc(); }; };
                };
                this.push_bytes(this.tmp.mem, this.tmp.len);
                ->;
            };

            // compiler.io.readfile: the file as a NUL terminated block in the VM heap
            op_readfile() -> void
            {
                byte* path = this.pop_text();
                void* fh;
                int n, k, got;
                switch (path == (byte*)0) { case (true) { ->; } default {}; };
                path = idkvm_dup(path, idkvm_strlen(path));
                fh = fopen(path, g"rb\0");
                switch (fh == (void*)0)
                {
                    case (true) {
                        this.errno_fail(g"compiler.io.readfile: \0", path);
                        ffree(path);
                        ->;
                    }
                    default {};
                };
                fseek(fh, 0, 2);
                n = ftell(fh);
                fseek(fh, 0, 0);
                switch (n < 0)
                {
                    case (true) {
                        this.errno_fail(g"compiler.io.readfile: \0", path);
                        fclose(fh);
                        ffree(path);
                        ->;
                    }
                    default {};
                };
                k = this.vheap.alloc(n + 1);
                switch (k == 0)
                {
                    case (true) {
                        this.fail(g"VMHeap: invalid size or out of memory\0");
                        fclose(fh);
                        ffree(path);
                        ->;
                    }
                    default {};
                };
                got = fread(this.vheap.mem + k, 1, n, fh);
                fclose(fh);
                ffree(path);
                this.push(IDKVM_T_PTR, (i64)k, 0);
                ->;
            };

            // The fopen mode of a compiler.io.writefile flags string (spaces ignored)
            write_mode(byte* flags) -> byte*
            {
                this.osb.clear();
                int k = 0;
                while (flags[k] != 0)
                {
                    switch (flags[k] != ' ') { case (true) { this.osb.put((int)flags[k]); } default {}; };
                    k++;
                };
                switch (idkvm_streq(this.osb.mem, g"r\0")) { case (true) { -> g"rb\0"; } default {}; };
                switch (idkvm_streq(this.osb.mem, g"rt\0")) { case (true) { -> g"r\0"; } default {}; };
                switch (idkvm_streq(this.osb.mem, g"w\0")) { case (true) { -> g"wb\0"; } default {}; };
                switch (idkvm_streq(this.osb.mem, g"wt\0")) { case (true) { -> g"w\0"; } default {}; };
                switch (idkvm_streq(this.osb.mem, g"a\0")) { case (true) { -> g"ab\0"; } default {}; };
                switch (idkvm_streq(this.osb.mem, g"at\0")) { case (true) { -> g"a\0"; } default {}; };
                switch (idkvm_streq(this.osb.mem, g"rw\0")) { case (true) { -> g"r+b\0"; } default {}; };
                switch (idkvm_streq(this.osb.mem, g"rwt\0")) { case (true) { -> g"r+\0"; } default {}; };
                -> g"wb\0";
            };

            // compiler.io.writefile(path, content, flags)
            op_writefile() -> void
            {
                byte* fl = this.pop_text();
                byte* mode, raw, path;
                void* fh;
                int ct, n, wrote;
                i64 cd, cm;
                switch (fl == (byte*)0) { case (true) { ->; } default {}; };
                mode = this.write_mode(fl);
                this.pop_val();
                switch (this.failed) { case (true) { ->; } default {}; };
                ct = this.pt;
                cd = this.pd;
                cm = this.pm;
                // the content as raw bytes: BYTES carry their length, a PTR is NUL terminated,
                // any other value is its decimal text
                this.tmp.clear();
                switch (ct == IDKVM_T_BYTES | ct == IDKVM_T_PTR)
                {
                    case (true) {
                        raw = this.str_of(ct, cd);
                        switch (raw == (byte*)0)
                        {
                            case (true) {
                                this.fail(g"compiler.io.writefile: invalid content pointer\0");
                                ->;
                            }
                            default {};
                        };
                        switch (ct == IDKVM_T_BYTES) { case (true) { n = cm; } default { n = idkvm_strlen(raw); }; };
                        this.tmp.put_n(raw, n);
                    }
                    default { this.tmp.put_i64(cd); };
                };
                raw = idkvm_dup(this.tmp.mem, this.tmp.len);
                n = this.tmp.len;
                path = this.pop_text();
                switch (path == (byte*)0) { case (true) { ffree(raw); ->; } default {}; };
                fh = fopen(path, mode);
                switch (fh == (void*)0)
                {
                    case (true) {
                        this.errno_fail(g"compiler.io.writefile: \0", path);
                        ffree(raw);
                        ->;
                    }
                    default {};
                };
                wrote = fwrite(raw, 1, n, fh);
                fclose(fh);
                ffree(raw);
                switch (wrote != n)
                {
                    case (true) { this.errno_fail(g"compiler.io.writefile: \0", (byte*)0); }
                    default {};
                };
                ->;
            };

            // compiler.idkvm.loadlib(name, ext): load a shared library into the process so its
            // symbols resolve for later FFI lookups
            op_loadlib() -> void
            {
                byte* ext = this.pop_text();
                byte* name;
                void* h;
                int k;
                switch (ext == (byte*)0) { case (true) { ->; } default {}; };
                ext = idkvm_dup(ext, idkvm_strlen(ext));
                name = this.pop_text();
                switch (name == (byte*)0) { case (true) { ffree(ext); ->; } default {}; };
                name = idkvm_dup(name, idkvm_strlen(name));
                while (ext[0] == '.') { ext = ext + 1; };
                h = (void*)0;
#ifdef __WINDOWS__
                this.tmp.clear();
                this.tmp.put_str(name);
                switch (ext[0] != 0) { case (true) { this.tmp.put(46); this.tmp.put_str(ext); } default {}; };
                h = LoadLibraryA(this.tmp.mem);
                switch (h == (void*)0)
                {
                    case (true) {
                        this.fail(g"compiler.idkvm.loadlib: cannot load '\0");
                        this.errb.put_str(this.tmp.mem);
                        this.errb.put(39);
                    }
                    default {};
                };
#endif;
#ifdef __LINUX__
                // lib<name>.<ext>, <name>.<ext>, lib<name>.so, lib<name>.dylib, <name>
                k = 0;
                while (k < 5 & h == (void*)0)
                {
                    this.tmp.clear();
                    switch (k)
                    {
                        case (0) { switch (ext[0] != 0) { case (true) { this.tmp.put_str(g"lib\0"); this.tmp.put_str(name); this.tmp.put(46); this.tmp.put_str(ext); } default {}; }; }
                        case (1) { switch (ext[0] != 0) { case (true) { this.tmp.put_str(name); this.tmp.put(46); this.tmp.put_str(ext); } default {}; }; }
                        case (2) { this.tmp.put_str(g"lib\0"); this.tmp.put_str(name); this.tmp.put_str(g".so\0"); }
                        case (3) { this.tmp.put_str(g"lib\0"); this.tmp.put_str(name); this.tmp.put_str(g".dylib\0"); }
                        default { this.tmp.put_str(name); };
                    };
                    switch (this.tmp.len > 0 & h == (void*)0)
                    {
                        case (true) { h = dlopen(this.tmp.mem, 258); }
                        default {};
                    };
                    k++;
                };
                switch (h == (void*)0)
                {
                    case (true) {
                        this.fail(g"compiler.idkvm.loadlib: cannot load '\0");
                        this.errb.put_str(name);
                        this.errb.put(39);
                    }
                    default {};
                };
#endif;
                ->;
            };

            // compiler.idkvm.setbp: prints the frame and the stack to stderr, then waits for a key
            op_setbp() -> void
            {
                int fi = this.nframes - 1;
                int i, lim, base, sc, top;
                byte* sym, tio, kb, raw2;
                this.err_print(g"\n[COMPTIME BREAKPOINT]\n\0");
                switch (fi >= 0)
                {
                    case (true) {
                        this.tmp.clear();
                        this.tmp.put_str(g"  func : \0");
                        this.tmp.put_str(this.fr_name[fi]);
                        this.tmp.put_str(g"\n  ip   : \0");
                        this.tmp.put_int(this.fr_ip[fi]);
                        this.tmp.put_str(g"\n  locals:\n\0");
                        this.err_print(this.tmp.mem);
                        base = this.fr_base[fi];
                        i = 0;
                        while (i < this.fr_nloc[fi])
                        {
                            switch (this.lc_set[base + i] != 0)
                            {
                                case (true) {
                                    this.tmp.clear();
                                    this.tmp.put_str(g"    [\0");
                                    this.tmp.put_int(i);
                                    this.tmp.put_str(g"] = \0");
                                    this.repr_val(@this.tmp, this.lc_tag[base + i], this.lc_data[base + i], this.lc_meta[base + i]);
                                    this.tmp.put(10);
                                    this.err_print(this.tmp.mem);
                                }
                                default {};
                            };
                            i++;
                        };
                    }
                    default {};
                };
                this.err_print(g"  stack (top first):\n\0");
                i = 0;
                top = this.sp;
                while (i < top & i < 16)
                {
                    sc = top - 1 - i;
                    this.tmp.clear();
                    this.tmp.put_str(g"    [\0");
                    this.tmp.put_int(i);
                    this.tmp.put_str(g"] \0");
                    this.repr_val(@this.tmp, this.st_tag[sc], this.st_data[sc], this.st_meta[sc]);
                    this.tmp.put(10);
                    this.err_print(this.tmp.mem);
                    i++;
                };
                switch (top > 16)
                {
                    case (true) {
                        this.tmp.clear();
                        this.tmp.put_str(g"    ... (\0");
                        this.tmp.put_int(top - 16);
                        this.tmp.put_str(g" more)\n\0");
                        this.err_print(this.tmp.mem);
                    }
                    default {};
                };
                this.err_print(g"Press any key to continue execution ...\0");
                kb = idkvm_alloc(8);
#ifdef __WINDOWS__
                sym = idkvm_find_sym(g"_getch\0");
                switch (sym != (byte*)0)
                {
                    case (true) {
                        def{}* gk() -> int = sym;
                        gk();
                    }
                    default {};
                };
#endif;
#ifdef __LINUX__
                // raw mode for one key: tcgetattr, cfmakeraw, tcsetattr(TCSADRAIN), read, restore
                tio = idkvm_alloc(256);
                sym = idkvm_find_sym(g"tcgetattr\0");
                switch (sym != (byte*)0 & tio != (byte*)0)
                {
                    case (true) {
                        def{}* tg(int, byte*) -> int = sym;
                        switch (tg(0, tio) != 0)
                        {
                            case (true) { this.errno_tuple_fail(); }
                            default
                            {
                                raw2 = idkvm_alloc(256);
                                idkvm_copy(raw2, tio, 128);
                                sym = idkvm_find_sym(g"cfmakeraw\0");
                                switch (sym != (byte*)0) { case (true) { def{}* cr(byte*) -> void = sym; cr(raw2); } default {}; };
                                sym = idkvm_find_sym(g"tcsetattr\0");
                                switch (sym != (byte*)0)
                                {
                                    case (true) {
                                        def{}* ts(int, int, byte*) -> int = sym;
                                        ts(0, 1, raw2);
                                        sym = idkvm_find_sym(g"read\0");
                                        switch (sym != (byte*)0)
                                        {
                                            case (true) {
                                                def{}* rd1(int, byte*, int) -> int = sym;
                                                rd1(0, kb, 1);
                                            }
                                            default {};
                                        };
                                        ts(0, 1, tio);
                                    }
                                    default {};
                                };
                                ffree(raw2);
                            };
                        };
                    }
                    default {};
                };
                switch (tio != (byte*)0) { case (true) { ffree(tio); } default {}; };
#endif;
                ffree(kb);
                this.err_print(g"\n\0");
                ->;
            };

            // Python repr of a stack value: Val(<tag>, <data>)
            repr_val(FvmBuf* o, int tag, i64 d, i64 m) -> void
            {
                int k;
                o.put_str(g"Val(\0");
                o.put_str(idkvm_ttag_name(tag));
                o.put_str(g", \0");
                switch (tag == IDKVM_T_FLOAT | tag == IDKVM_T_DOUBLE)
                {
                    case (true) {
                        switch (tag == IDKVM_T_FLOAT) { case (true) { idkvm_float2str(o, idkvm_bits_dbl(d)); } default { idkvm_dbl2str(o, idkvm_bits_dbl(d)); }; };
                    }
                    default
                    {
                        switch (tag == IDKVM_T_BOOL)
                        {
                            case (true) {
                                switch (d != (i64)0) { case (true) { o.put_str(g"True\0"); } default { o.put_str(g"False\0"); }; };
                            }
                            default
                            {
                                switch (tag == IDKVM_T_BYTES)
                                {
                                    case (true) {
                                        o.put_str(g"b'\0");
                                        k = 0;
                                        while (k < (int)m)
                                        {
                                            o.put((int)idkvm_i2p(d)[k]);
                                            k++;
                                        };
                                        o.put(39);
                                    }
                                    default { o.put_i64(d); };
                                };
                            };
                        };
                    };
                };
                o.put(41);
                ->;
            };

            // One [VMTRACE] line for the instruction at pc of frame fi
            trace_line(int fi, int pc, int op) -> void
            {
                int i, base, first, n;
                bool any;
                this.tmp.clear();
                this.tmp.put_str(g"[VMTRACE] func=\0");
                this.tmp.put_str(this.fr_name[fi]);
                this.tmp.put_str(g" line=\0");
                this.tmp.put_int(this.code.line[pc]);
                this.tmp.put_str(g" op=\0");
                this.tmp.put_str(idkvm_op_name(op));
                this.tmp.put_str(g" operands=[\0");
                switch (this.is_zero_op(op))
                {
                    case (true) {}
                    default
                    {
                        switch (this.code.s[pc] != (byte*)0)
                        {
                            case (true) {
                                this.tmp.put(39);
                                this.tmp.put_str(this.code.s[pc]);
                                this.tmp.put(39);
                            }
                            default
                            {
                                switch (op == IDKVM_PUSH)
                                {
                                    case (true) { this.repr_val(@this.tmp, (int)this.code.a[pc], this.code.b[pc], this.code.c[pc]); }
                                    default
                                    {
                                        this.tmp.put_i64(this.code.a[pc]);
                                        switch (this.code.b[pc] != (i64)0 | this.code.c[pc] != (i64)0)
                                        {
                                            case (true) { this.tmp.put_str(g", \0"); this.tmp.put_i64(this.code.b[pc]); }
                                            default {};
                                        };
                                        switch (this.code.c[pc] != (i64)0)
                                        {
                                            case (true) { this.tmp.put_str(g", \0"); this.tmp.put_i64(this.code.c[pc]); }
                                            default {};
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
                this.tmp.put_str(g"] locals=[\0");
                base = this.fr_base[fi];
                any = false;
                i = 0;
                while (i < this.fr_nloc[fi])
                {
                    switch (this.lc_set[base + i] != 0)
                    {
                        case (true) {
                            switch (any) { case (true) { this.tmp.put_str(g", \0"); } default {}; };
                            any = true;
                            this.tmp.put(91);
                            this.tmp.put_int(i);
                            this.tmp.put_str(g"]=\0");
                            this.repr_val(@this.tmp, this.lc_tag[base + i], this.lc_data[base + i], this.lc_meta[base + i]);
                        }
                        default {};
                    };
                    i++;
                };
                this.tmp.put_str(g"] stack=[\0");
                first = this.sp - 4;
                switch (first < 0) { case (true) { first = 0; } default {}; };
                i = first;
                while (i < this.sp)
                {
                    switch (i > first) { case (true) { this.tmp.put_str(g", \0"); } default {}; };
                    this.repr_val(@this.tmp, this.st_tag[i], this.st_data[i], this.st_meta[i]);
                    i++;
                };
                this.tmp.put_str(g"]\0");
                standard::io::console::println(this.tmp.mem);
                ->;
            };

            // ===== .ivm text (idkvm.py serialise_idkvm) =====

            // _serialise_val: the text of a PUSH operand
            ser_val(FvmBuf* o, int tag, i64 d, i64 m) -> void
            {
                int k, ch;
                byte* p;
                bool ptr_meta;
                switch (tag == IDKVM_T_BYTES)
                {
                    case (true) {
                        o.put_str(g"bytes:\"\0");
                        p = idkvm_i2p(d);
                        k = 0;
                        while ((i64)k < m)
                        {
                            ch = (int)p[k];
                            switch (ch)
                            {
                                case (92) { o.put_str(g"\\\\\0"); }
                                case (34) { o.put_str(g"\\\"\0"); }
                                case (10) { o.put_str(g"\\n\0"); }
                                case (13) { o.put_str(g"\\r\0"); }
                                case (9) { o.put_str(g"\\t\0"); }
                                case (0) { o.put_str(g"\\0\0"); }
                                default { o.put(ch); };
                            };
                            k++;
                        };
                        o.put(34);
                        ->;
                    }
                    default {};
                };
                switch (tag == IDKVM_T_BOOL)
                {
                    case (true) {
                        switch (d != (i64)0) { case (true) { o.put_str(g"bool:true\0"); } default { o.put_str(g"bool:false\0"); }; };
                        ->;
                    }
                    default {};
                };
                switch (tag == IDKVM_T_FLOAT | tag == IDKVM_T_DOUBLE)
                {
                    case (true) {
                        o.put_str(idkvm_ttag_name(tag));
                        o.put(58);
                        idkvm_put_double(o, idkvm_bits_dbl(d));
                        ->;
                    }
                    default {};
                };
                switch (tag == IDKVM_T_VOID) { case (true) { o.put_str(g"void:0\0"); ->; } default {}; };
                // a PTR with meta: [struct_type=NAME,stack_slot]
                ptr_meta = tag == IDKVM_T_PTR & (m == (i64)IDKVM_META_STACK_SLOT | (m >= (i64)IDKVM_META_TYPE & m - (i64)IDKVM_META_TYPE < (i64)this.tn_n));
                switch (ptr_meta)
                {
                    case (true) {
                        o.put_str(g"ptr:\0");
                        o.put_i64(d);
                        o.put(91);
                        switch (m == (i64)IDKVM_META_STACK_SLOT)
                        {
                            case (true) { o.put_str(g"stack_slot\0"); }
                            default {
                                o.put_str(g"struct_type=\0");
                                o.put_str(this.tn_name[(int)(m - (i64)IDKVM_META_TYPE)]);
                            };
                        };
                        o.put(93);
                        ->;
                    }
                    default {};
                };
                // a runtime value operand read from a binary by a decompile shows as its text
                switch (m == (i64)IDKVM_META_OPAQUE & (tag == IDKVM_T_DATA | tag == IDKVM_T_STRUCT | tag == IDKVM_T_ENUM | tag == IDKVM_T_ARRAY | tag == IDKVM_T_FFI_LIB | tag == IDKVM_T_FFI_SYM | tag == IDKVM_T_FILE))
                {
                    case (true) {
                        o.put_str(idkvm_ttag_name(tag));
                        o.put(58);
                        o.put_str(idkvm_i2p(d));
                        ->;
                    }
                    default {};
                };
                o.put_str(idkvm_ttag_name(tag));
                o.put(58);
                o.put_i64(d);
                ->;
            };

            // _serialise_instr for the instruction at pool index pc. Jump targets are shifted by boff
            // (_rebase_block). An opcode without a case prints its name only, like the base fallback.
            ser_instr(FvmBuf* o, int pc, int boff) -> void
            {
                int op = this.code.ops[pc];
                i64 a = this.code.a[pc];
                i64 b = this.code.b[pc];
                i64 c = this.code.c[pc];
                byte* s = this.code.s[pc];
                int k;
                o.put_str(idkvm_op_name(op));
                switch (op)
                {
                    case (IDKVM_GLOBAL_GET) { o.put(32); o.put_str(s); }
                    case (IDKVM_GLOBAL_SET) { o.put(32); o.put_str(s); }
                    case (IDKVM_EXTERN_DECL)
                    {
                        o.put(32);
                        o.put_str(s);
                        o.put(32);
                        this.ser_upper(o, idkvm_ttag_name((int)a));
                        k = 0;
                        while ((i64)k < b)
                        {
                            o.put(32);
                            this.ser_upper(o, idkvm_ttag_name((int)(((i64*)idkvm_i2p(c))[k])));
                            k++;
                        };
                    }
                    case (IDKVM_PUSH) { o.put(32); this.ser_val(o, (int)a, b, c); }
                    case (IDKVM_CALL_PTR) { o.put(32); o.put_i64(a); }
                    case (IDKVM_JMP) { o.put(32); o.put_i64(a + (i64)boff); }
                    case (IDKVM_JIF) { o.put(32); o.put_i64(a + (i64)boff); }
                    case (IDKVM_JNF) { o.put(32); o.put_i64(a + (i64)boff); }
                    case (IDKVM_JTABLE)
                    {
                        o.put(32);
                        o.put_i64(a + (i64)boff);
                        o.put(32);
                        k = 0;
                        while ((i64)k < b)
                        {
                            switch (k > 0) { case (true) { o.put(32); } default {}; };
                            o.put_i64(((i64*)s)[k] + (i64)boff);
                            k++;
                        };
                    }
                    case (IDKVM_CALL) { o.put(32); o.put_str(s); o.put(32); o.put_i64(a); }
                    case (IDKVM_TAIL_SELF) { o.put(32); o.put_i64(a); }
                    case (IDKVM_LOCAL_GET) { o.put(32); o.put_i64(a); }
                    case (IDKVM_LOCAL_SET) { o.put(32); o.put_i64(a); }
                    case (IDKVM_ROTL) { o.put(32); o.put_i64(a); }
                    case (IDKVM_ROTR) { o.put(32); o.put_i64(a); }
                    case (IDKVM_BITREV) { o.put(32); o.put_i64(a); }
                    case (IDKVM_CLZ) { o.put(32); o.put_i64(a); }
                    case (IDKVM_CTZ) { o.put(32); o.put_i64(a); }
                    case (IDKVM_SIZEOF) { o.put(32); o.put_str(s); }
                    case (IDKVM_ALIGNOF) { o.put(32); o.put_str(s); }
                    case (IDKVM_ENDIANOF) { o.put(32); o.put_str(s); }
                    case (IDKVM_STRUCT_NEW) { o.put(32); o.put_str(s); }
                    case (IDKVM_STRUCT_LOAD) { o.put(32); o.put_str(s); }
                    case (IDKVM_STRUCT_STORE) { o.put(32); o.put_str(s); }
                    case (IDKVM_ENUM_NEW) { o.put(32); o.put_str(s); }
                    case (IDKVM_ARRAY_NEW) { o.put(32); o.put_str(s); o.put(32); o.put_i64(a); }
                    case (IDKVM_LOAD) { o.put(32); o.put_str(idkvm_ttag_name((int)a)); o.put(32); o.put_i64(b); }
                    case (IDKVM_STORE) { o.put(32); o.put_str(idkvm_ttag_name((int)a)); o.put(32); o.put_i64(b); }
                    case (IDKVM_CAST)
                    {
                        o.put(32);
                        o.put_str(idkvm_ttag_name((int)a));
                        switch (s != (byte*)0) { case (true) { o.put(32); o.put_str(s); } default {}; };
                    }
                    case (IDKVM_BITCAST)
                    {
                        o.put(32);
                        o.put_str(idkvm_ttag_name((int)a));
                        switch (s != (byte*)0) { case (true) { o.put(32); o.put_str(s); } default {}; };
                    }
                    case (IDKVM_EMIT_GLOBAL) { o.put(32); o.put_i64(a); }
                    case (IDKVM_FFI_LOAD) { o.put(32); o.put_str(s); }
                    case (IDKVM_FFI_SYM) { o.put(32); o.put_str(s); }
                    case (IDKVM_FFI_CALL) { o.put(32); o.put_i64(a); o.put(32); o.put_str(idkvm_ttag_name((int)b)); }
                    case (IDKVM_EMITIDEKA) { idkvm_put_emitideka(o, s, (FvmVars*)idkvm_i2p(c)); }
                    default {};
                };
                ->;
            };

            // The .name of a TTag member: the upper case of the .value text
            ser_upper(FvmBuf* o, byte* nm) -> void
            {
                int k = 0;
                int ch;
                while (nm[k] != 0)
                {
                    ch = (int)nm[k];
                    switch (ch >= 97 & ch <= 122) { case (true) { ch = ch - 32; } default {}; };
                    o.put(ch);
                    k++;
                };
                ->;
            };

            // Appends a finished block to the dump log and tracks its local count
            log_block(int unit) -> void
            {
                int* nl;
                switch (this.log_n >= this.log_cap)
                {
                    case (true) {
                        nl = (int*)idkvm_grow((byte*)this.log_unit, this.log_cap * 2 * 4);
                        switch (nl == (int*)0) { case (true) { this.fail(g"allocation failed\0"); ->; } default {}; };
                        this.log_unit = nl;
                        this.log_cap = this.log_cap * 2;
                    }
                    default {};
                };
                this.log_unit[this.log_n] = unit;
                this.log_n++;
                ->;
            };

            // True when the last line of o is HALT (after stripping)
            ser_ends_halt(FvmBuf* o) -> bool
            {
                int e = o.len;
                int st;
                while (e > 0 & (o.mem[e - 1] == 10 | o.mem[e - 1] == 32)) { e--; };
                st = e;
                while (st > 0 & o.mem[st - 1] != 10) { st--; };
                while (st < e & o.mem[st] == 32) { st++; };
                -> e - st == 4 & idkvm_eq_n(o.mem + st, 4, g"HALT\0");
            };

            // One instruction of a dump: a text line, or the IDKB binary form
            ser_item(FvmBuf* o, int pc, int boff) -> void
            {
                switch (this.ser_bin)
                {
                    case (true) { this.bin_instr(o, pc, boff); }
                    default
                    {
                        this.ser_instr(o, pc, boff);
                        o.put(10);
                    };
                };
                this.ser_n++;
                this.ser_last = this.code.ops[pc];
                ->;
            };

            // The struct layouts of the text dump
            ser_structs(FvmBuf* o) -> void
            {
                int i, k, f;
                i = 0;
                while (i < this.layouts.n)
                {
                    o.put_str(g"struct \0");
                    o.put_str(this.layouts.sname[i]);
                    o.put(32);
                    o.put_str(this.layouts.sendian[i]);
                    o.put(32);
                    o.put_int(this.layouts.ssize[i]);
                    o.put(32);
                    o.put_int(this.layouts.sbits[i]);
                    o.put(10);
                    k = 0;
                    while (k < this.layouts.scount[i])
                    {
                        f = this.layouts.sfirst[i] + k;
                        o.put_str(g"    field \0");
                        o.put_str(this.layouts.fname[f]);
                        o.put(32);
                        o.put_str(idkvm_ttag_name(this.layouts.ftag[f]));
                        o.put(32);
                        o.put_int(this.layouts.foff[f]);
                        o.put(32);
                        o.put_int(this.layouts.fsize[f]);
                        o.put(10);
                        k++;
                    };
                    o.put_str(g"endstruct\n\n\0");
                    i++;
                };
                ->;
            };

            // Every registered function, as text blocks or as binary records
            ser_funcs(FvmBuf* o) -> void
            {
                int i, k, fu, st, ln;
                i = 0;
                while (i < this.funcs.n)
                {
                    fu = this.funcs.units[i];
                    st = this.code.ustart[fu];
                    ln = this.code.ulen[fu];
                    switch (this.ser_bin)
                    {
                        case (true) {
                            this.bin_str(o, this.funcs.names[i], idkvm_strlen(this.funcs.names[i]));
                            o.put_u32(ln);
                        }
                        default {
                            o.put_str(g"func \0");
                            o.put_str(this.funcs.names[i]);
                            o.put(10);
                        };
                    };
                    k = 0;
                    while (k < ln)
                    {
                        switch (this.ser_bin) { case (true) {} default { o.put_str(g"    \0"); }; };
                        this.ser_item(o, st + k, 0);
                        k++;
                    };
                    switch (this.ser_bin) { case (true) {} default { o.put_str(g"endfunc\n\n\0"); }; };
                    i++;
                };
                ->;
            };

            // The logged blocks and the part of the running block that came before the dump
            // call (_dump_collect), without HALT
            ser_main(FvmBuf* o) -> void
            {
                int i, k, pc, st, ln, off, woff, lim, u0;
                off = 0;
                woff = 0;
                i = 0;
                while (i < this.log_n)
                {
                    u0 = this.log_unit[i];
                    st = this.code.ustart[u0];
                    ln = this.code.ulen[u0];
                    k = 0;
                    while (k < ln)
                    {
                        pc = st + k;
                        switch (this.code.ops[pc] != IDKVM_HALT)
                        {
                            case (true) {
                                this.ser_item(o, pc, off);
                                woff++;
                            }
                            default {};
                        };
                        k++;
                    };
                    off = woff;
                    i++;
                };
                // the running block: instrs[:ip - 2] without HALT
                switch (this.nframes > 0)
                {
                    case (true) {
                        u0 = this.fr_unit[0];
                        st = this.code.ustart[u0];
                        ln = this.code.ulen[u0];
                        lim = this.fr_ip[0] - 2;
                        switch (lim < 0) { case (true) { lim = ln + lim; } default {}; };
                        switch (lim < 0) { case (true) { lim = 0; } default {}; };
                        switch (lim > ln) { case (true) { lim = ln; } default {}; };
                        k = 0;
                        while (k < lim)
                        {
                            pc = st + k;
                            switch (this.code.ops[pc] != IDKVM_HALT)
                            {
                                case (true) { this.ser_item(o, pc, off); }
                                default {};
                            };
                            k++;
                        };
                    }
                    default {};
                };
                ->;
            };

            // serialise_idkvm over the whole history: struct layouts, every function, the logged
            // blocks and the part of the running block that came before the dump call
            ser_all(FvmBuf* o) -> void
            {
                o.put_str(g"# Generated by compiler.idkvm.dump\n\n\0");
                this.ser_bin = false;
                this.ser_structs(o);
                this.ser_funcs(o);
                switch (this.log_locals > 0)
                {
                    case (true) {
                        o.put_str(g"locals \0");
                        o.put_int(this.log_locals);
                        o.put(10);
                    }
                    default {};
                };
                this.ser_main(o);
                switch (!this.ser_ends_halt(o)) { case (true) { o.put_str(g"HALT\n\0"); } default {}; };
                ->;
            };

            // ===== IDKB BINARY DUMP =====

            // A value operand: u8 tag, then the data by tag (_bin_val in idkvm.py)
            bin_val(FvmBuf* o, int tag, i64 d, i64 m) -> void
            {
                int flags;
                o.put(tag);
                switch (tag == IDKVM_T_BYTES)
                {
                    case (true) { this.bin_str(o, idkvm_i2p(d), (int)m); ->; }
                    default {};
                };
                switch (tag == IDKVM_T_BOOL)
                {
                    case (true) {
                        switch (d != (i64)0) { case (true) { o.put(1); } default { o.put(0); }; };
                        ->;
                    }
                    default {};
                };
                switch (tag == IDKVM_T_VOID) { case (true) { ->; } default {}; };
                // a runtime value is written as the text of its data, like the text dump
                switch (tag == IDKVM_T_DATA | tag == IDKVM_T_STRUCT | tag == IDKVM_T_ENUM | tag == IDKVM_T_ARRAY | tag == IDKVM_T_FFI_LIB | tag == IDKVM_T_FFI_SYM | tag == IDKVM_T_FILE)
                {
                    case (true) {
                        this.tmp.clear();
                        this.tmp.put_i64(d);
                        this.bin_str(o, this.tmp.mem, this.tmp.len);
                        ->;
                    }
                    default {};
                };
                // a FLOAT or DOUBLE holds the bits of a double, which is the f64 of the file
                switch (tag == IDKVM_T_FLOAT | tag == IDKVM_T_DOUBLE)
                {
                    case (true) { o.put_le64(d); ->; }
                    default {};
                };
                switch (tag == IDKVM_T_ULONG)
                {
                    case (true) { o.put_uv((u64)d); ->; }
                    default {};
                };
                o.put_iv(d);
                switch (tag != IDKVM_T_PTR) { case (true) { ->; } default {}; };
                flags = 0;
                switch (m == (i64)IDKVM_META_STACK_SLOT) { case (true) { flags = 1; } default {}; };
                switch (m >= (i64)IDKVM_META_TYPE & m - (i64)IDKVM_META_TYPE < (i64)this.tn_n) { case (true) { flags = 2; } default {}; };
                o.put(flags);
                switch (flags == 2)
                {
                    case (true) {
                        this.bin_str(o, this.tn_name[(int)(m - (i64)IDKVM_META_TYPE)], idkvm_strlen(this.tn_name[(int)(m - (i64)IDKVM_META_TYPE)]));
                    }
                    default {};
                };
                ->;
            };

            // _bin_instr for the instruction at pool index pc. Jump targets are shifted by boff.
            bin_instr(FvmBuf* o, int pc, int boff) -> void
            {
                int op = this.code.ops[pc];
                i64 a = this.code.a[pc];
                i64 b = this.code.b[pc];
                i64 c = this.code.c[pc];
                byte* s = this.code.s[pc];
                int k;
                o.put(op);
                switch (idkvm_bin_shape(op))
                {
                    case (IDKVM_BS_I)
                    {
                        switch (op == IDKVM_JMP | op == IDKVM_JIF | op == IDKVM_JNF) { case (true) { a = a + (i64)boff; } default {}; };
                        o.put_iv(a);
                    }
                    case (IDKVM_BS_S) { this.bin_str(o, s, idkvm_strlen(s)); }
                    case (IDKVM_BS_SI) { this.bin_str(o, s, idkvm_strlen(s)); o.put_iv(a); }
                    case (IDKVM_BS_TI) { o.put((int)a); o.put_iv(b); }
                    case (IDKVM_BS_TS)
                    {
                        o.put((int)a);
                        switch (s != (byte*)0)
                        {
                            case (true) { o.put(1); this.bin_str(o, s, idkvm_strlen(s)); }
                            default { o.put(0); };
                        };
                    }
                    case (IDKVM_BS_IT) { o.put_iv(a); o.put((int)b); }
                    case (IDKVM_BS_X)
                    {
                        this.bin_str(o, s, idkvm_strlen(s));
                        o.put((int)a);
                        o.put_u32((int)b);
                        k = 0;
                        while ((i64)k < b)
                        {
                            o.put((int)(((i64*)idkvm_i2p(c))[k]));
                            k++;
                        };
                    }
                    case (IDKVM_BS_J)
                    {
                        o.put_iv(a + (i64)boff);
                        o.put_u32((int)b);
                        k = 0;
                        while ((i64)k < b)
                        {
                            o.put_iv(((i64*)s)[k] + (i64)boff);
                            k++;
                        };
                    }
                    case (IDKVM_BS_V) { this.bin_val(o, (int)a, b, c); }
                    case (IDKVM_BS_A)
                    {
                        // the bootstrapped VM keeps no INLINE_ASM operands: body, constraints,
                        // n_inputs, n_outputs and no output names
                        o.put_u32(0);
                        o.put_u32(0);
                        o.put_iv(0);
                        o.put_iv(0);
                        o.put_u32(0);
                    }
                    case (IDKVM_BS_E)
                    {
                        // the source text, then the name:slot bindings
                        this.bin_str(o, s, idkvm_strlen(s));
                        o.put_u32((int)a);
                        k = 0;
                        while ((i64)k < a)
                        {
                            this.bin_str(o, ((FvmVars*)idkvm_i2p(c)).names[k], idkvm_strlen(((FvmVars*)idkvm_i2p(c)).names[k]));
                            o.put_iv((i64)((FvmVars*)idkvm_i2p(c)).slots[k]);
                            k++;
                        };
                    }
                    default {};
                };
                ->;
            };

            // The struct layouts of the binary dump
            bin_structs(FvmBuf* o) -> void
            {
                int i, k, f;
                o.put_u32(this.layouts.n);
                i = 0;
                while (i < this.layouts.n)
                {
                    this.bin_str(o, this.layouts.sname[i], idkvm_strlen(this.layouts.sname[i]));
                    this.bin_str(o, this.layouts.sendian[i], idkvm_strlen(this.layouts.sendian[i]));
                    o.put_u32(this.layouts.ssize[i]);
                    o.put_u32(this.layouts.sbits[i]);
                    o.put_u32(this.layouts.scount[i]);
                    k = 0;
                    while (k < this.layouts.scount[i])
                    {
                        f = this.layouts.sfirst[i] + k;
                        this.bin_str(o, this.layouts.fname[f], idkvm_strlen(this.layouts.fname[f]));
                        o.put(this.layouts.ftag[f]);
                        o.put_u32(this.layouts.foff[f]);
                        o.put_u32(this.layouts.fsize[f]);
                        k++;
                    };
                    i++;
                };
                ->;
            };

            // serialise_idkvm_bin over the whole history, the same content as ser_all. The main
            // block always ends with HALT.
            // A string of the file: its index in the string table, which is built as strings come
            bin_str(FvmBuf* o, byte* s, int n) -> void
            {
                int i, k;
                bool same;
                byte** ns;
                int* nl;
                i = 0;
                while (i < this.bt_n)
                {
                    same = this.bt_l[i] == n;
                    k = 0;
                    while (same & k < n)
                    {
                        same = this.bt_s[i][k] == s[k];
                        k++;
                    };
                    switch (same) { case (true) { o.put_u32(i); ->; } default {}; };
                    i++;
                };
                switch (this.bt_n >= this.bt_cap)
                {
                    case (true) {
                        ns = (byte**)idkvm_grow((byte*)this.bt_s, this.bt_cap * 2 * 8);
                        nl = (int*)idkvm_grow((byte*)this.bt_l, this.bt_cap * 2 * 4);
                        switch (ns == (byte**)0 | nl == (int*)0) { case (true) { this.fail(g"allocation failed\0"); ->; } default {}; };
                        this.bt_s = ns;
                        this.bt_l = nl;
                        this.bt_cap = this.bt_cap * 2;
                    }
                    default {};
                };
                this.bt_s[this.bt_n] = idkvm_dup(s, n);
                this.bt_l[this.bt_n] = n;
                o.put_u32(this.bt_n);
                this.bt_n++;
                ->;
            };

            // Starts a binary body: the string table is empty
            bin_begin() -> bool
            {
                this.bt_cap = 64;
                this.bt_n = 0;
                this.bt_s = (byte**)idkvm_alloc(this.bt_cap * 8);
                this.bt_l = (int*)idkvm_alloc(this.bt_cap * 4);
                switch (this.bt_s == (byte**)0 | this.bt_l == (int*)0) { case (true) { this.fail(g"allocation failed\0"); -> false; } default {}; };
                this.ser_bin = true;
                -> true;
            };

            // The whole IDKB file from a finished body: header, then the string table and the
            // body, stored compressed when that is smaller (serialise_idkvm_bin in idkvm.py)
            bin_pack(FvmBuf* o, FvmBuf* body) -> void
            {
                FvmBuf raw, comp;
                int i;
                bool packed;
                raw.__init();
                comp.__init();
                raw.put_u32(this.bt_n);
                i = 0;
                while (i < this.bt_n)
                {
                    switch (this.str_out != (FvmBuf*)0) { case (true) { idkvm_put_esc_line(this.str_out, this.bt_s[i], this.bt_l[i]); } default {}; };
                    raw.put_u32(this.bt_l[i]);
                    raw.put_n(this.bt_s[i], this.bt_l[i]);
                    ffree(this.bt_s[i]);
                    i++;
                };
                raw.put_n(body.mem, body.len);
                packed = idkvm_lz_compress(raw.mem, raw.len, @comp) & (comp.len < raw.len);
                o.put_n(g"IDKB\0", 4);
                o.put(2);
                switch (packed) { case (true) { o.put(1); } default { o.put(0); }; };
                o.put_u32(raw.len);
                switch (packed)
                {
                    case (true) { o.put_n(comp.mem, comp.len); }
                    default { o.put_n(raw.mem, raw.len); };
                };
                ffree((byte*)this.bt_s);
                ffree((byte*)this.bt_l);
                this.bt_s = (byte**)0;
                this.bt_l = (int*)0;
                this.bt_n = 0;
                raw.__exit();
                comp.__exit();
                this.ser_bin = false;
                ->;
            };

            bin_all(FvmBuf* o) -> void
            {
                FvmBuf body, mb;
                body.__init();
                mb.__init();
                switch (!this.bin_begin()) { case (true) { ->; } default {}; };
                this.bin_structs(@body);
                body.put_u32(this.funcs.n);
                this.ser_funcs(@body);
                this.ser_n = 0;
                this.ser_last = -1;
                this.ser_main(@mb);
                switch (this.ser_last != IDKVM_HALT)
                {
                    case (true) {
                        mb.put(IDKVM_HALT);
                        this.ser_n++;
                    }
                    default {};
                };
                body.put_u32(this.log_locals);
                body.put_u32(this.ser_n);
                body.put_n(mb.mem, mb.len);
                this.bin_pack(o, @body);
                body.__exit();
                mb.__exit();
                ->;
            };

            // compiler.idkvm.dump(path) and compiler.idkvm.bindump(path)
            dump_file(bool bin) -> void
            {
                byte* path = this.pop_text();
                FvmBuf o;
                void* fh;
                int k, n;
                byte* who;
                switch (path == (byte*)0) { case (true) { ->; } default {}; };
                path = idkvm_dup(path, idkvm_strlen(path));
                k = 0;
                while (path[k] != 0)
                {
                    switch (path[k] == 92) { case (true) { path[k] = 47; } default {}; };
                    k++;
                };
                o.__init();
                who = g"compiler.idkvm.dump: \0";
                switch (bin)
                {
                    case (true) {
                        who = g"compiler.idkvm.bindump: \0";
                        this.bin_all(@o);
                        fh = fopen(path, g"wb\0");
                    }
                    default {
                        this.ser_all(@o);
                        fh = fopen(path, g"w\0");
                    };
                };
                switch (fh == (void*)0)
                {
                    case (true) { this.errno_fail(who, path); }
                    default
                    {
                        n = fwrite(o.mem, 1, o.len, fh);
                        fclose(fh);
                        switch (n != o.len) { case (true) { this.errno_fail(who, (byte*)0); } default {}; };
                    };
                };
                o.__exit();
                ffree(path);
                ->;
            };

            op_dump() -> void
            {
                this.dump_file(false);
                ->;
            };

            op_bindump() -> void
            {
                this.dump_file(true);
                ->;
            };

            // ===== IDKB BINARY LOAD =====

            bin_fail(byte* msg) -> void
            {
                switch (!this.failed)
                {
                    case (true) {
                        this.errb.clear();
                        this.errb.put_str(g".idkb: \0");
                        this.errb.put_str(msg);
                        this.failed = true;
                    }
                    default {};
                };
                ->;
            };

            bin_fail_n(byte* msg, int n) -> void
            {
                switch (!this.failed)
                {
                    case (true) {
                        this.errb.clear();
                        this.errb.put_str(g".idkb: \0");
                        this.errb.put_str(msg);
                        this.errb.put_int(n);
                        this.failed = true;
                    }
                    default {};
                };
                ->;
            };

            // The next n bytes are in the file, false (and a failure) when they are not
            rd_need(int n) -> bool
            {
                switch (this.failed) { case (true) { -> false; } default {}; };
                switch (n < 0 | this.bp + n > this.bl)
                {
                    case (true) {
                        this.bin_fail(g"unexpected end of file\0");
                        -> false;
                    }
                    default {};
                };
                -> true;
            };

            rd_u8() -> int
            {
                int v;
                switch (!this.rd_need(1)) { case (true) { -> 0; } default {}; };
                v = (int)this.bd[this.bp];
                this.bp++;
                -> v;
            };

            // An unsigned varint (LEB128) of up to 64 bits
            rd_uv() -> u64
            {
                u64 v;
                int shift = 0;
                int b;
                while (true)
                {
                    b = this.rd_u8();
                    switch (this.failed) { case (true) { -> 0; } default {}; };
                    v = v `| (((u64)(b `& 127)) << shift);
                    switch ((b `& 128) == 0) { case (true) { -> v; } default {}; };
                    shift = shift + 7;
                    switch (shift > 63) { case (true) { this.bin_fail(g"damaged data\0"); -> 0; } default {}; };
                };
                -> v;
            };

            // A count, size or index
            rd_u32() -> int
            {
                u64 v = this.rd_uv();
                switch (v > (u64)2147483647)
                {
                    case (true) {
                        this.bin_fail(g"damaged data\0");
                        -> 0;
                    }
                    default {};
                };
                -> (int)v;
            };

            // A signed integer (zigzag varint)
            rd_i64() -> i64
            {
                u64 u = this.rd_uv();
                i64 v = (i64)(u >> 1);
                switch ((u `& (u64)1) != (u64)0) { case (true) { v = (i64)0 - v - (i64)1; } default {}; };
                -> v;
            };

            // The raw little endian 8 bytes of a double
            rd_raw64() -> i64
            {
                i64 v;
                int k = 7;
                switch (!this.rd_need(8)) { case (true) { -> 0; } default {}; };
                while (k >= 0)
                {
                    v = (v << (i64)8) `| (i64)this.bd[this.bp + k];
                    k--;
                };
                this.bp = this.bp + 8;
                -> v;
            };

            // A count of records that each take at least one byte
            rd_count() -> int
            {
                int n = this.rd_u32();
                switch (n < 0 | n > this.bl - this.bp)
                {
                    case (true) {
                        this.bin_fail(g"unexpected end of file\0");
                        -> 0;
                    }
                    default {};
                };
                -> n;
            };

            // A string of the file (an index of the string table) copied out as a persistent
            // null terminated string, with its length in *n when n is given
            rd_blob(int* n) -> byte*
            {
                int idx = this.rd_u32();
                byte* r;
                switch (this.failed) { case (true) { -> (byte*)0; } default {}; };
                switch (idx >= this.rt_n)
                {
                    case (true) {
                        this.bin_fail(g"damaged data\0");
                        -> (byte*)0;
                    }
                    default {};
                };
                r = idkvm_dup(this.rt_s[idx], this.rt_l[idx]);
                switch (r == (byte*)0)
                {
                    case (true) {
                        this.fail(g"allocation failed\0");
                        this.failed = true;
                        -> (byte*)0;
                    }
                    default {};
                };
                switch (n != (int*)0) { case (true) { *n = this.rt_l[idx]; } default {}; };
                -> r;
            };

            rd_skip_blob() -> void
            {
                int idx = this.rd_u32();
                switch (!this.failed & idx >= this.rt_n) { case (true) { this.bin_fail(g"damaged data\0"); } default {}; };
                ->;
            };

            rd_ttag() -> int
            {
                int t = this.rd_u8();
                switch (!this.failed & t > IDKVM_T_FILE)
                {
                    case (true) {
                        this.bin_fail_n(g"unknown type tag \0", t);
                        -> 0;
                    }
                    default {};
                };
                -> t;
            };

            // True for the tags of runtime values, which a value operand can not be loaded as
            is_opaque(int tg) -> bool
            {
                -> tg == IDKVM_T_DATA | tg == IDKVM_T_STRUCT | tg == IDKVM_T_ENUM | tg == IDKVM_T_ARRAY | tg == IDKVM_T_FFI_LIB | tg == IDKVM_T_FFI_SYM | tg == IDKVM_T_FILE;
            };

            // A runtime value tag: the text loader refuses it, so does the binary loader
            bin_opaque(int tg) -> bool
            {
                switch (this.is_opaque(tg))
                {
                    case (true) {
                        switch (!this.failed)
                        {
                            case (true) {
                                this.errb.clear();
                                this.errb.put_str(g".idkb: unknown type tag '\0");
                                this.errb.put_str(idkvm_ttag_name(tg));
                                this.errb.put(39);
                                this.failed = true;
                            }
                            default {};
                        };
                        -> true;
                    }
                    default {};
                };
                -> false;
            };

            // A value operand into this.pt, this.pd and this.pm (_BinReader.val)
            rd_val() -> void
            {
                int tg, flags, n;
                byte* nm;
                tg = this.rd_ttag();
                this.pt = tg;
                this.pd = 0;
                this.pm = 0;
                switch (this.failed) { case (true) { ->; } default {}; };
                switch (this.bin_lenient & this.is_opaque(tg))
                {
                    case (true) {
                        nm = this.rd_blob((int*)0);
                        this.pd = idkvm_p2i(nm);
                        this.pm = (i64)IDKVM_META_OPAQUE;
                        ->;
                    }
                    default {};
                };
                switch (this.bin_opaque(tg)) { case (true) { ->; } default {}; };
                switch (tg == IDKVM_T_BYTES)
                {
                    case (true) {
                        nm = this.rd_blob(@n);
                        this.pd = idkvm_p2i(nm);
                        this.pm = (i64)n;
                        ->;
                    }
                    default {};
                };
                switch (tg == IDKVM_T_BOOL)
                {
                    case (true) {
                        switch (this.rd_u8() != 0) { case (true) { this.pd = 1; } default {}; };
                        ->;
                    }
                    default {};
                };
                switch (tg == IDKVM_T_VOID) { case (true) { ->; } default {}; };
                switch (tg == IDKVM_T_FLOAT | tg == IDKVM_T_DOUBLE)
                {
                    case (true) { this.pd = this.rd_raw64(); ->; }
                    default {};
                };
                switch (tg == IDKVM_T_ULONG)
                {
                    case (true) { this.pd = (i64)this.rd_uv(); ->; }
                    default {};
                };
                this.pd = this.rd_i64();
                switch (tg != IDKVM_T_PTR) { case (true) { ->; } default {}; };
                flags = this.rd_u8();
                switch ((flags `& 1) != 0) { case (true) { this.pm = (i64)IDKVM_META_STACK_SLOT; } default {}; };
                switch ((flags `& 2) != 0)
                {
                    case (true) {
                        nm = this.rd_blob((int*)0);
                        switch (nm != (byte*)0)
                        {
                            case (true) {
                                this.pm = this.tn_intern(nm);
                                ffree(nm);
                            }
                            default {};
                        };
                    }
                    default {};
                };
                // field bit offsets, fields and elements are read past: this VM does not hold them
                switch ((flags `& 4) != 0)
                {
                    case (true) {
                        n = this.rd_count();
                        while (n > 0 & !this.failed) { this.rd_skip_blob(); this.rd_i64(); n--; };
                        this.stub_note(g".idkb PTR meta (field offsets, fields, elements)\0");
                    }
                    default {};
                };
                switch ((flags `& 8) != 0)
                {
                    case (true) {
                        n = this.rd_count();
                        while (n > 0 & !this.failed) { this.rd_skip_blob(); this.rd_skip_val(); n--; };
                        this.stub_note(g".idkb PTR meta (field offsets, fields, elements)\0");
                    }
                    default {};
                };
                switch ((flags `& 16) != 0)
                {
                    case (true) {
                        this.rd_skip_blob();
                        this.rd_i64();
                        n = this.rd_count();
                        while (n > 0 & !this.failed) { this.rd_skip_val(); n--; };
                        this.stub_note(g".idkb PTR meta (field offsets, fields, elements)\0");
                    }
                    default {};
                };
                ->;
            };

            // Reads a value operand and drops it
            rd_skip_val() -> void
            {
                int tg, flags, n;
                tg = this.rd_ttag();
                switch (this.failed) { case (true) { ->; } default {}; };
                switch (this.bin_lenient & this.is_opaque(tg)) { case (true) { this.rd_skip_blob(); ->; } default {}; };
                switch (this.bin_opaque(tg)) { case (true) { ->; } default {}; };
                switch (tg == IDKVM_T_BYTES) { case (true) { this.rd_skip_blob(); ->; } default {}; };
                switch (tg == IDKVM_T_BOOL) { case (true) { this.rd_u8(); ->; } default {}; };
                switch (tg == IDKVM_T_VOID) { case (true) { ->; } default {}; };
                switch (tg == IDKVM_T_FLOAT | tg == IDKVM_T_DOUBLE) { case (true) { this.rd_raw64(); } default { this.rd_uv(); }; };
                switch (tg != IDKVM_T_PTR) { case (true) { ->; } default {}; };
                flags = this.rd_u8();
                switch ((flags `& 2) != 0) { case (true) { this.rd_skip_blob(); } default {}; };
                switch ((flags `& 4) != 0)
                {
                    case (true) {
                        n = this.rd_count();
                        while (n > 0 & !this.failed) { this.rd_skip_blob(); this.rd_i64(); n--; };
                    }
                    default {};
                };
                switch ((flags `& 8) != 0)
                {
                    case (true) {
                        n = this.rd_count();
                        while (n > 0 & !this.failed) { this.rd_skip_blob(); this.rd_skip_val(); n--; };
                    }
                    default {};
                };
                switch ((flags `& 16) != 0)
                {
                    case (true) {
                        this.rd_skip_blob();
                        this.rd_i64();
                        n = this.rd_count();
                        while (n > 0 & !this.failed) { this.rd_skip_val(); n--; };
                    }
                    default {};
                };
                ->;
            };

            // One instruction of an IDKB file, appended to the open unit (_BinReader.instr)
            rd_instr() -> void
            {
                int op, t, k, n;
                i64 a, b;
                byte* s1, s2;
                i64* tbl;
                FvmVars* evars;
                op = this.rd_u8();
                switch (this.failed) { case (true) { ->; } default {}; };
                switch (op >= IDKVM_OP_COUNT)
                {
                    case (true) { this.bin_fail_n(g"unknown opcode \0", op); ->; }
                    default {};
                };
                switch (idkvm_bin_shape(op))
                {
                    case (IDKVM_BS_I)
                    {
                        a = this.rd_i64();
                        this.code.add(op, a, 0, 0, (byte*)0, 0);
                    }
                    case (IDKVM_BS_S)
                    {
                        s1 = this.rd_blob((int*)0);
                        this.code.add(op, 0, 0, 0, s1, 0);
                    }
                    case (IDKVM_BS_SI)
                    {
                        s1 = this.rd_blob((int*)0);
                        a = this.rd_i64();
                        this.code.add(op, a, 0, 0, s1, 0);
                    }
                    case (IDKVM_BS_TI)
                    {
                        t = this.rd_ttag();
                        b = this.rd_i64();
                        this.code.add(op, (i64)t, b, 0, (byte*)0, 0);
                    }
                    case (IDKVM_BS_TS)
                    {
                        t = this.rd_ttag();
                        s1 = (byte*)0;
                        switch (this.rd_u8() != 0) { case (true) { s1 = this.rd_blob((int*)0); } default {}; };
                        this.code.add(op, (i64)t, 0, 0, s1, 0);
                    }
                    case (IDKVM_BS_IT)
                    {
                        a = this.rd_i64();
                        t = this.rd_ttag();
                        this.code.add(op, a, (i64)t, 0, (byte*)0, 0);
                    }
                    case (IDKVM_BS_X)
                    {
                        s1 = this.rd_blob((int*)0);
                        t = this.rd_ttag();
                        n = this.rd_count();
                        tbl = (i64*)idkvm_alloc((n + 1) * 8);
                        switch (tbl == (i64*)0) { case (true) { this.fail(g"allocation failed\0"); ->; } default {}; };
                        k = 0;
                        while (k < n & !this.failed)
                        {
                            tbl[k] = (i64)this.rd_ttag();
                            k++;
                        };
                        this.code.add(op, (i64)t, (i64)n, idkvm_p2i((byte*)tbl), s1, 0);
                    }
                    case (IDKVM_BS_J)
                    {
                        a = this.rd_i64();
                        n = this.rd_count();
                        tbl = (i64*)idkvm_alloc((n + 1) * 8);
                        switch (tbl == (i64*)0) { case (true) { this.fail(g"allocation failed\0"); ->; } default {}; };
                        k = 0;
                        while (k < n & !this.failed)
                        {
                            tbl[k] = this.rd_i64();
                            k++;
                        };
                        this.code.add(op, a, (i64)n, 0, (byte*)tbl, 0);
                    }
                    case (IDKVM_BS_V)
                    {
                        this.rd_val();
                        this.code.add(op, (i64)this.pt, this.pd, this.pm, (byte*)0, 0);
                    }
                    case (IDKVM_BS_A)
                    {
                        // body, constraints, n_inputs, n_outputs and the output names are read
                        // past, like the text loader keeps nothing of INLINE_ASM
                        this.rd_skip_blob();
                        this.rd_skip_blob();
                        this.rd_i64();
                        this.rd_i64();
                        n = this.rd_count();
                        while (n > 0 & !this.failed) { this.rd_skip_blob(); n--; };
                        this.code.add(op, 0, 0, 0, (byte*)0, 0);
                    }
                    case (IDKVM_BS_E)
                    {
                        s2 = this.rd_blob((int*)0);
                        n = this.rd_count();
                        evars = idkvm_vars_new(n);
                        switch (evars == (FvmVars*)0) { case (true) { this.fail(g"allocation failed\0"); ->; } default {}; };
                        k = 0;
                        while (k < n & !this.failed)
                        {
                            evars.names[k] = this.rd_blob((int*)0);
                            evars.slots[k] = (int)this.rd_i64();
                            k++;
                        };
                        this.code.add(op, (i64)n, 0, idkvm_p2i((byte*)evars), s2, 0);
                    }
                    default { this.code.add(op, 0, 0, 0, (byte*)0, 0); };
                };
                ->;
            };

            // Writes the loaded main block and functions as .ivm text, the text serialise_idkvm
            // gives for them
            decompile(FvmBuf* o) -> void
            {
                int k, st, ln;
                o.put_str(g"# Generated by compiler.idkvm.dump\n\n\0");
                this.ser_bin = false;
                this.ser_structs(o);
                this.ser_funcs(o);
                switch (this.main_locals > 0)
                {
                    case (true) {
                        o.put_str(g"locals \0");
                        o.put_int(this.main_locals);
                        o.put(10);
                    }
                    default {};
                };
                st = this.code.ustart[this.main_unit];
                ln = this.code.ulen[this.main_unit];
                k = 0;
                while (k < ln)
                {
                    this.ser_item(o, st + k, 0);
                    k++;
                };
                switch (!this.ser_ends_halt(o)) { case (true) { o.put_str(g"HALT\n\0"); } default {}; };
                ->;
            };

            // compile_idkvm_text: writes the loaded structs, functions and main block as an IDKB file,
            // the binary a bindump of the same content gives. The main block ends with HALT.
            compile_loaded(FvmBuf* o) -> void
            {
                int k, st, ln, n;
                bool need_halt;
                FvmBuf body;
                body.__init();
                switch (!this.bin_begin()) { case (true) { ->; } default {}; };
                this.bin_structs(@body);
                body.put_u32(this.funcs.n);
                this.ser_funcs(@body);
                st = this.code.ustart[this.main_unit];
                ln = this.code.ulen[this.main_unit];
                need_halt = ln == 0;
                switch (ln > 0) { case (true) { need_halt = this.code.ops[st + ln - 1] != IDKVM_HALT; } default {}; };
                n = ln;
                switch (need_halt) { case (true) { n++; } default {}; };
                body.put_u32(this.main_locals);
                body.put_u32(n);
                k = 0;
                while (k < ln)
                {
                    this.ser_item(@body, st + k, 0);
                    k++;
                };
                switch (need_halt) { case (true) { body.put(IDKVM_HALT); } default {}; };
                this.bin_pack(o, @body);
                body.__exit();
                ->;
            };

            // strings_idkvm: the string table of an IDKB file, or of the IDKB form of .ivm text, one
            // escaped string per line in order of first use. False with the message in err_text()
            // on a bad file.
            strings_file(byte* image, int len, FvmBuf* o) -> bool
            {
                bool ok;
                FvmBuf scratch;
                scratch.__init();
                this.str_out = o;
                switch (idkvm_is_bin_image(image, len))
                {
                    case (true) {
                        this.bin_lenient = true;
                        ok = this.load_bin(image, len);
                        this.bin_lenient = false;
                    }
                    default
                    {
                        ok = this.load_idkvm(image, len);
                        switch (ok) { case (true) { this.compile_loaded(@scratch); } default {}; };
                    };
                };
                this.str_out = (FvmBuf*)0;
                scratch.__exit();
                -> ok;
            };

            // inspect_idkvm: loads an IDKB file or .ivm text and writes its summary to o. False with
            // the message in err_text() on a bad file.
            inspect_file(byte* image, int len, FvmBuf* o) -> bool
            {
                bool ok;
                bool bin = idkvm_is_bin_image(image, len);
                int i, fu, total;
                switch (bin)
                {
                    case (true) {
                        this.bin_lenient = true;
                        ok = this.load_bin(image, len);
                        this.bin_lenient = false;
                    }
                    default { ok = this.load_idkvm(image, len); };
                };
                switch (!ok) { case (true) { -> false; } default {}; };
                switch (bin)
                {
                    case (true) {
                        o.put_str(g"format: IDKB version \0");
                        o.put_int((int)image[4]);
                        switch ((this.ib_flags `& 1) != 0)
                        {
                            case (true) { o.put_str(g" (compressed)\n\0"); }
                            default { o.put_str(g" (stored)\n\0"); };
                        };
                        o.put_str(g"size: \0");
                        idkvm_put_pl(o, len, g"byte\0");
                        o.put(10);
                        o.put_str(g"payload: \0");
                        idkvm_put_pl(o, this.ib_raw, g"byte\0");
                        o.put(10);
                        o.put_str(g"strings: \0");
                        o.put_int(this.ib_nstr);
                        o.put(10);
                    }
                    default
                    {
                        o.put_str(g"format: IDKVM text\nsize: \0");
                        idkvm_put_pl(o, len, g"byte\0");
                        o.put(10);
                    };
                };
                o.put_str(g"structs: \0");
                o.put_int(this.layouts.n);
                o.put(10);
                i = 0;
                while (i < this.layouts.n)
                {
                    o.put_str(g"  \0");
                    o.put_str(this.layouts.sname[i]);
                    o.put_str(g"  size \0");
                    idkvm_put_pl(o, this.layouts.ssize[i], g"byte\0");
                    o.put_str(g", \0");
                    idkvm_put_pl(o, this.layouts.sbits[i], g"bit\0");
                    o.put_str(g", \0");
                    idkvm_put_pl(o, this.layouts.scount[i], g"field\0");
                    o.put(10);
                    i++;
                };
                o.put_str(g"functions: \0");
                o.put_int(this.funcs.n);
                o.put(10);
                i = 0;
                while (i < this.funcs.n)
                {
                    fu = this.funcs.units[i];
                    o.put_str(g"  \0");
                    o.put_str(this.funcs.names[i]);
                    o.put_str(g"  \0");
                    idkvm_put_pl(o, this.code.ulen[fu], g"instruction\0");
                    o.put(10);
                    total = total + this.code.ulen[fu];
                    i++;
                };
                o.put_str(g"main: \0");
                idkvm_put_pl(o, this.main_locals, g"local\0");
                o.put_str(g", \0");
                idkvm_put_pl(o, this.code.ulen[this.main_unit], g"instruction\0");
                o.put(10);
                total = total + this.code.ulen[this.main_unit];
                o.put_str(g"instructions: \0");
                o.put_int(total);
                o.put(10);
                -> true;
            };

            // decompile_idkvm_bin: an IDKB file to .ivm text in o. Runtime value operands, which a
            // load refuses, show as their text. False with the message in err_text() on a bad file.
            decompile_bin(byte* image, int len, FvmBuf* o) -> bool
            {
                bool ok;
                this.bin_lenient = true;
                ok = this.load_bin(image, len);
                this.bin_lenient = false;
                switch (ok) { case (true) { this.decompile(o); } default {}; };
                -> ok;
            };

            // Loads an IDKB file (parse_idkvm_binary), registers its functions and layouts and
            // prepares the main block. False with the message in err_text() on a bad file.
            load_bin(byte* image, int len) -> bool
            {
                int i, k, n, nf, ni, unit, tg, sz, bits, off, fsz, ver, flags, lerr, rl, plen, tl;
                byte* nm, en, own;
                this.bd = image;
                this.bl = len;
                this.bp = 4;
                switch (len < 4 | !idkvm_eq_n(image, 4, g"IDKB\0"))
                {
                    case (true) { this.bin_fail(g"bad magic\0"); -> false; }
                    default {};
                };
                switch (len < 6) { case (true) { this.bin_fail(g"unexpected end of file\0"); -> false; } default {}; };
                ver = (int)image[4];
                switch (ver != 2) { case (true) { this.bin_fail_n(g"unsupported version \0", ver); -> false; } default {}; };
                flags = (int)image[5];
                this.bp = 6;
                rl = this.rd_u32();
                plen = len - this.bp;
                switch (this.failed) { case (true) { -> false; } default {}; };
                // the payload: stored, or compressed
                switch ((flags `& 1) != 0)
                {
                    case (true) {
                        own = idkvm_lz_decompress(image + this.bp, plen, rl, @lerr);
                        switch (own == (byte*)0)
                        {
                            case (true) {
                                switch (lerr == 1) { case (true) { this.bin_fail(g"unexpected end of file\0"); } default {}; };
                                switch (lerr == 2) { case (true) { this.bin_fail(g"damaged data\0"); } default {}; };
                                switch (lerr == 3) { case (true) { this.fail(g"allocation failed\0"); this.failed = true; } default {}; };
                                -> false;
                            }
                            default {};
                        };
                        this.bd = own;
                        this.bl = rl;
                        this.bp = 0;
                    }
                    default
                    {
                        switch (plen != rl) { case (true) { this.bin_fail(g"damaged data\0"); -> false; } default {}; };
                        this.bd = image + this.bp;
                        this.bl = plen;
                        this.bp = 0;
                    };
                };
                // the string table
                this.rt_n = this.rd_count();
                this.rt_s = (byte**)idkvm_alloc((this.rt_n + 1) * 8);
                this.rt_l = (int*)idkvm_alloc((this.rt_n + 1) * 4);
                switch (this.rt_s == (byte**)0 | this.rt_l == (int*)0) { case (true) { this.fail(g"allocation failed\0"); this.failed = true; } default {}; };
                i = 0;
                while (i < this.rt_n & !this.failed)
                {
                    tl = this.rd_u32();
                    switch (this.rd_need(tl))
                    {
                        case (true) {
                            this.rt_s[i] = this.bd + this.bp;
                            this.rt_l[i] = tl;
                            this.bp = this.bp + tl;
                        }
                        default {};
                    };
                    i++;
                };
                this.ib_flags = flags;
                this.ib_raw = rl;
                this.ib_nstr = this.rt_n;
                i = 0;
                while (i < this.rt_n & this.str_out != (FvmBuf*)0 & !this.failed)
                {
                    idkvm_put_esc_line(this.str_out, this.rt_s[i], this.rt_l[i]);
                    i++;
                };
                n = this.rd_count();
                i = 0;
                while (i < n & !this.failed)
                {
                    nm = this.rd_blob((int*)0);
                    en = this.rd_blob((int*)0);
                    sz = this.rd_u32();
                    bits = this.rd_u32();
                    nf = this.rd_count();
                    switch (!this.failed)
                    {
                        case (true) {
                            switch (nm == (byte*)0 | en == (byte*)0 | !this.layouts.add_struct(nm, en, sz, bits))
                            {
                                case (true) { this.fail(g"struct layout allocation failed\0"); }
                                default {};
                            };
                        }
                        default {};
                    };
                    k = 0;
                    while (k < nf & !this.failed)
                    {
                        nm = this.rd_blob((int*)0);
                        tg = this.rd_ttag();
                        off = this.rd_u32();
                        fsz = this.rd_u32();
                        switch (!this.failed)
                        {
                            case (true) {
                                switch (nm == (byte*)0 | !this.layouts.add_field(nm, tg, off, fsz))
                                {
                                    case (true) { this.fail(g"struct layout allocation failed\0"); }
                                    default {};
                                };
                            }
                            default {};
                        };
                        k++;
                    };
                    i++;
                };
                n = this.rd_count();
                i = 0;
                while (i < n & !this.failed)
                {
                    nm = this.rd_blob((int*)0);
                    ni = this.rd_count();
                    unit = this.code.unit_begin();
                    switch (!this.failed & (nm == (byte*)0 | unit < 0)) { case (true) { this.fail(g"code pool allocation failed\0"); } default {}; };
                    k = 0;
                    while (k < ni & !this.failed)
                    {
                        this.rd_instr();
                        k++;
                    };
                    switch (!this.failed)
                    {
                        case (true) {
                            this.code.unit_end(unit);
                            this.register_function(nm, unit);
                        }
                        default {};
                    };
                    i++;
                };
                this.main_locals = this.rd_u32();
                ni = this.rd_count();
                unit = this.code.unit_begin();
                switch (!this.failed & unit < 0) { case (true) { this.fail(g"code pool allocation failed\0"); } default {}; };
                k = 0;
                while (k < ni & !this.failed)
                {
                    this.rd_instr();
                    k++;
                };
                this.code.unit_end(unit);
                this.main_unit = unit;
                // the strings were copied out; the table and a decompressed payload go
                switch (own != (byte*)0) { case (true) { ffree(own); } default {}; };
                switch (this.rt_s != (byte**)0) { case (true) { ffree((byte*)this.rt_s); } default {}; };
                switch (this.rt_l != (int*)0) { case (true) { ffree((byte*)this.rt_l); } default {}; };
                this.rt_s = (byte**)0;
                this.rt_l = (int*)0;
                this.rt_n = 0;
                this.bd = (byte*)0;
                this.bl = 0;
                -> !this.failed;
            };

            // ===== STRINGS =====

            // Pushes the decimal text of v as BYTES
            push_number_text(i64 v) -> void
            {
                this.tmp.clear();
                this.tmp.put_i64(v);
                this.push_bytes(this.tmp.mem, this.tmp.len);
                ->;
            };

            // Writes a popped value for COMPILER_PRINT and COMPILER_PRINTLN
            print_value(int tag, i64 d, bool newline) -> void
            {
                byte* s = this.str_of(tag, d);
                switch (s != (byte*)0)
                {
                    case (true) { standard::io::console::print(s); }
                    default
                    {
                        this.tmp.clear();
                        this.tmp.put_i64(d);
                        standard::io::console::print(this.tmp.mem);
                    };
                };
                switch (newline)
                {
                    case (true) { standard::io::console::print(g"\n\0"); }
                    default {};
                };
                ->;
            };

            str_op(int op) -> void
            {
                int at, n, an, bn, i, j;
                i64 ad, bd, cd;
                byte* a, b, r;
                bool ok2;
                i64 v;
                switch (op)
                {
                    case (IDKVM_STR_LEN)
                    {
                        this.pop_val();
                        a = this.str_of(this.pt, this.pd);
                        switch (this.failed) { case (true) { ->; } default {}; };
                        switch (a == (byte*)0)
                        {
                            case (true) {
                                this.fail(g"_read_vm_string: cannot read string from value\0");
                                ->;
                            }
                            default {};
                        };
                        this.push(IDKVM_T_UINT, (i64)idkvm_strlen(a), 0);
                    }
                    case (IDKVM_STR_EQ)
                    {
                        this.pop_val();
                        b = this.str_of(this.pt, this.pd);
                        this.pop_val();
                        a = this.str_of(this.pt, this.pd);
                        switch (this.failed) { case (true) { ->; } default {}; };
                        switch (a == (byte*)0 | b == (byte*)0)
                        {
                            case (true) {
                                this.fail(g"_read_vm_string: cannot read string from value\0");
                                ->;
                            }
                            default {};
                        };
                        switch (idkvm_streq(a, b))
                        {
                            case (true) { this.push(IDKVM_T_BOOL, 1, 0); }
                            default { this.push(IDKVM_T_BOOL, 0, 0); };
                        };
                    }
                    case (IDKVM_STR_CAT)
                    {
                        this.pop_val();
                        b = this.str_of(this.pt, this.pd);
                        this.pop_val();
                        a = this.str_of(this.pt, this.pd);
                        switch (this.failed) { case (true) { ->; } default {}; };
                        switch (a == (byte*)0 | b == (byte*)0)
                        {
                            case (true) {
                                this.fail(g"_read_vm_string: cannot read string from value\0");
                                ->;
                            }
                            default {};
                        };
                        an = idkvm_strlen(a);
                        bn = idkvm_strlen(b);
                        r = idkvm_alloc(an + bn + 1);
                        switch (r == (byte*)0)
                        {
                            case (true) {
                                this.fail(g"allocation failed\0");
                                ->;
                            }
                            default {};
                        };
                        i = 0;
                        while (i < an) { r[i] = a[i]; i++; };
                        j = 0;
                        while (j < bn) { r[an + j] = b[j]; j++; };
                        this.push(IDKVM_T_BYTES, idkvm_p2i(r), (i64)(an + bn));
                    }
                    case (IDKVM_STR_SLICE)
                    {
                        this.pop_val();
                        cd = this.pd;
                        this.pop_val();
                        bd = this.pd;
                        this.pop_val();
                        a = this.str_of(this.pt, this.pd);
                        switch (this.failed) { case (true) { ->; } default {}; };
                        switch (a == (byte*)0)
                        {
                            case (true) {
                                this.fail(g"_read_vm_string: cannot read string from value\0");
                                ->;
                            }
                            default {};
                        };
                        an = idkvm_strlen(a);
                        switch (bd < (i64)0) { case (true) { bd = 0; } default {}; };
                        switch (bd > (i64)an) { case (true) { bd = (i64)an; } default {}; };
                        switch (cd < (i64)0) { case (true) { cd = 0; } default {}; };
                        switch (bd + cd > (i64)an) { case (true) { cd = (i64)an - bd; } default {}; };
                        this.push_bytes(a + (int)bd, cd);
                    }
                    case (IDKVM_STR_FIND)
                    {
                        this.pop_val();
                        b = this.str_of(this.pt, this.pd);
                        this.pop_val();
                        a = this.str_of(this.pt, this.pd);
                        switch (this.failed) { case (true) { ->; } default {}; };
                        switch (a == (byte*)0 | b == (byte*)0)
                        {
                            case (true) {
                                this.fail(g"_read_vm_string: cannot read string from value\0");
                                ->;
                            }
                            default {};
                        };
                        an = idkvm_strlen(a);
                        bn = idkvm_strlen(b);
                        n = -1;
                        i = 0;
                        while (i + bn <= an & n < 0)
                        {
                            switch (idkvm_eq_n(a + i, bn, b)) { case (true) { n = i; } default {}; };
                            i++;
                        };
                        this.push(IDKVM_T_INT, (i64)n, 0);
                    }
                    case (IDKVM_INT_TO_STR)
                    {
                        this.pop_val();
                        at = this.pt;
                        ad = this.pd;
                        bd = this.pm;
                        switch (this.failed) { case (true) { ->; } default {}; };
                        switch (at == IDKVM_T_BYTES)
                        {
                            case (true) { this.push(IDKVM_T_BYTES, ad, bd); }
                            default
                            {
                                switch (at == IDKVM_T_PTR)
                                {
                                    case (true) {
                                        a = this.str_of(at, ad);
                                        switch (a == (byte*)0)
                                        {
                                            case (true) {
                                                this.fail(g"_read_vm_string: cannot read string from value\0");
                                                ->;
                                            }
                                            default {};
                                        };
                                        this.push_bytes(a, idkvm_strlen(a));
                                    }
                                    default
                                    {
                                        switch (at == IDKVM_T_CHAR)
                                        {
                                            case (true) {
                                                this.tmp.clear();
                                                this.tmp.put((int)(ad `& (i64)255));
                                                this.push_bytes(this.tmp.mem, 1);
                                            }
                                            default {
                                                switch (idkvm_isf(at, bd))
                                                {
                                                    case (true)
                                                    {
                                                        // the text fstr_append gives a float or a double
                                                        this.tmp.clear();
                                                        switch (at == IDKVM_T_FLOAT)
                                                        {
                                                            case (true) { idkvm_float2str(@this.tmp, idkvm_bits_dbl(ad)); }
                                                            default { idkvm_dbl2str(@this.tmp, idkvm_bits_dbl(ad)); };
                                                        };
                                                        this.push_bytes(this.tmp.mem, this.tmp.len);
                                                    }
                                                    default { this.push_number_text(ad); };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    }
                    default
                    {
                        // STR_TO_INT: int(s.strip(), 0)
                        this.pop_val();
                        a = this.str_of(this.pt, this.pd);
                        switch (this.failed) { case (true) { ->; } default {}; };
                        switch (a == (byte*)0)
                        {
                            case (true) {
                                this.fail(g"_read_vm_string: cannot read string from value\0");
                                ->;
                            }
                            default {};
                        };
                        an = idkvm_strlen(a);
                        i = 0;
                        while (i < an & (a[i] == ' ' | a[i] == 9 | a[i] == 10 | a[i] == 13)) { i++; };
                        while (an > i & (a[an - 1] == ' ' | a[an - 1] == 9 | a[an - 1] == 10 | a[an - 1] == 13)) { an--; };
                        v = idkvm_parse_int(a + i, an - i, @ok2);
                        switch (!ok2)
                        {
                            case (true) {
                                this.fail(g"STR_TO_INT: cannot convert string to integer\0");
                                ->;
                            }
                            default {};
                        };
                        this.push(IDKVM_T_INT, v, 0);
                    };
                };
                ->;
            };

            // ===== ARRAYS (Val ARRAY with elements) =====
            // An array is one block: count, element tag, then count triples of tag, data, meta.
            // The stack value is (ARRAY, block, count). Stores copy the block, as the Python VM
            // builds a new Val for every store.

            arr_free_all() -> void
            {
                int i;
                while (i < this.an)
                {
                    ffree((byte*)this.arrs[i]);
                    i++;
                };
                switch (this.arrs != (i64*)0) { case (true) { ffree((byte*)this.arrs); } default {}; };
                this.an = 0;
                ->;
            };

            arr_make(int count, int etag) -> i64*
            {
                i64* b = (i64*)idkvm_alloc(16 + count * 24);
                i64* na;
                int i;
                switch (b == (i64*)0)
                {
                    case (true) { this.fail(g"array allocation failed\0"); -> b; }
                    default {};
                };
                switch (this.an >= this.acap)
                {
                    case (true)
                    {
                        na = (i64*)idkvm_grow((byte*)this.arrs, this.acap * 2 * 8);
                        switch (na == (i64*)0) { case (true) { this.fail(g"array allocation failed\0"); -> b; } default {}; };
                        this.arrs = na;
                        this.acap = this.acap * 2;
                    }
                    default {};
                };
                this.arrs[this.an] = (i64)b;
                this.an++;
                b[0] = (i64)count;
                b[1] = etag;
                while (i < count)
                {
                    b[2 + i * 3] = etag;
                    i++;
                };
                -> b;
            };

            // _str_to_ttag
            name_ttag(byte* n) -> int
            {
                switch (idkvm_streq(n, g"int\0")) { case (true) { -> IDKVM_T_INT; } default {}; };
                switch (idkvm_streq(n, g"uint\0")) { case (true) { -> IDKVM_T_UINT; } default {}; };
                switch (idkvm_streq(n, g"long\0")) { case (true) { -> IDKVM_T_LONG; } default {}; };
                switch (idkvm_streq(n, g"ulong\0")) { case (true) { -> IDKVM_T_ULONG; } default {}; };
                switch (idkvm_streq(n, g"float\0")) { case (true) { -> IDKVM_T_FLOAT; } default {}; };
                switch (idkvm_streq(n, g"double\0")) { case (true) { -> IDKVM_T_DOUBLE; } default {}; };
                switch (idkvm_streq(n, g"bool\0")) { case (true) { -> IDKVM_T_BOOL; } default {}; };
                switch (idkvm_streq(n, g"byte\0")) { case (true) { -> IDKVM_T_BYTE; } default {}; };
                switch (idkvm_streq(n, g"char\0")) { case (true) { -> IDKVM_T_CHAR; } default {}; };
                switch (idkvm_streq(n, g"data\0")) { case (true) { -> IDKVM_T_DATA; } default {}; };
                switch (idkvm_streq(n, g"void\0")) { case (true) { -> IDKVM_T_VOID; } default {}; };
                -> IDKVM_T_PTR;
            };

            op_array_new(i64 count, byte* tn) -> void
            {
                i64* b = this.arr_make((int)count, this.name_ttag(tn));
                switch (this.failed) { case (true) { ->; } default {}; };
                this.push(IDKVM_T_ARRAY, (i64)b, count);
                ->;
            };

            op_array_len() -> void
            {
                this.pop_val();
                switch (this.failed) { case (true) { ->; } default {}; };
                switch (this.pt == IDKVM_T_ARRAY)
                {
                    case (true) { this.push(IDKVM_T_INT, this.pm, 0); }
                    default { this.push(IDKVM_T_INT, 0, 0); };
                };
                ->;
            };

            // A pointer value that is not on the VM heap: an address past the heap, an unsigned
            // value past it, or one that an extern call or a pinned buffer made known (_ptr_is_os)
            ptr_is_os(i64 addr) -> bool
            {
                int k;
                switch (addr < (i64)0 | addr > (i64)this.vheap.size) { case (true) { -> true; } default {}; };
                while (k < this.osn)
                {
                    switch (this.osp[k] == addr) { case (true) { -> true; } default {}; };
                    k++;
                };
                -> false;
            };

            // _os_ptrs.add
            os_add(i64 addr) -> void
            {
                int k;
                i64* n1;
                while (k < this.osn)
                {
                    switch (this.osp[k] == addr) { case (true) { ->; } default {}; };
                    k++;
                };
                switch (this.osn >= this.oscap)
                {
                    case (true)
                    {
                        n1 = (i64*)idkvm_grow((byte*)this.osp, this.oscap * 2 * 8);
                        switch (n1 == (i64*)0) { case (true) { this.fail(g"allocation failed\0"); ->; } default {}; };
                        this.osp = n1;
                        this.oscap = this.oscap * 2;
                    }
                    default {};
                };
                this.osp[this.osn] = addr;
                this.osn++;
                ->;
            };

            // Little endian unsigned read of sz bytes of OS memory
            os_rd(i64 a, int sz) -> i64
            {
                i64 v = 0;
                int k = sz - 1;
                byte* p = idkvm_i2p(a);
                while (k >= 0)
                {
                    v = (v << 8) `| ((i64)p[k] `& (i64)255);
                    k--;
                };
                -> v;
            };

            os_wr(i64 a, int sz, i64 v) -> void
            {
                int k;
                i64 t = v;
                byte* p = idkvm_i2p(a);
                while (k < sz)
                {
                    p[k] = (byte)(t `& (i64)255);
                    t = t >> 8;
                    k++;
                };
                ->;
            };

            // The memory of a pointer: OS memory is always reachable, the VM heap is bounds checked
            mem_ok(i64 p, int sz) -> bool
            {
                switch (this.ptr_is_os(p)) { case (true) { -> true; } default {}; };
                -> this.vheap.in_bounds(p, sz);
            };

            mem_rd(i64 p, int sz) -> i64
            {
                switch (this.ptr_is_os(p)) { case (true) { -> this.os_rd(p, sz); } default {}; };
                -> this.vheap.rd((int)p, sz);
            };

            mem_wr(i64 p, int sz, i64 v) -> void
            {
                switch (this.ptr_is_os(p)) { case (true) { this.os_wr(p, sz, v); ->; } default {}; };
                this.vheap.wr((int)p, sz, v);
                ->;
            };

            // BYTES + int: the bytes are pinned in native memory (a NUL is added when the last
            // byte is not one) and the pointer is that address, the base is an OS pointer
            pin_bytes(i64 d, i64 len, i64 off) -> i64
            {
                byte* src = idkvm_i2p(d);
                byte* buf;
                int n = (int)len;
                int add = 1;
                switch (n > 0 & src[n - 1] == 0) { case (true) { add = 0; } default {}; };
                buf = idkvm_alloc(n + add + 1);
                switch (buf == (byte*)0) { case (true) { this.fail(g"allocation failed\0"); -> 0; } default {}; };
                idkvm_copy(buf, src, n);
                this.pin_keep(buf);
                this.os_add(idkvm_p2i(buf));
                -> idkvm_p2i(buf) + off;
            };

            // A native buffer that lives until the VM exits (a pointer into it can be handed back)
            pin_keep(byte* buf) -> void
            {
                byte** n1;
                switch (this.pinn >= this.pincap)
                {
                    case (true)
                    {
                        n1 = (byte**)idkvm_grow((byte*)this.pins, this.pincap * 2 * 8);
                        switch (n1 == (byte**)0) { case (true) { this.fail(g"allocation failed\0"); ->; } default {}; };
                        this.pins = n1;
                        this.pincap = this.pincap * 2;
                    }
                    default {};
                };
                this.pins[this.pinn] = buf;
                this.pinn++;
                ->;
            };

            // A tag whose data is an integer address in the Python VM (the native pointer rule)
            tag_has_int_data(int t) -> bool
            {
                -> t == IDKVM_T_INT | t == IDKVM_T_UINT | t == IDKVM_T_LONG | t == IDKVM_T_ULONG | t == IDKVM_T_BYTE | t == IDKVM_T_CHAR | t == IDKVM_T_BOOL | t == IDKVM_T_DATA | t == IDKVM_T_PTR | t == IDKVM_T_ENUM;
            };

            // One byte of the VM heap, as a BYTE value
            heap_byte_push(i64 addr) -> void
            {
                switch (!this.mem_ok(addr, 1))
                {
                    case (true) { this.fail(g"VMHeap: out-of-bounds access\0"); ->; }
                    default {};
                };
                this.push(IDKVM_T_BYTE, this.mem_rd(addr, 1), 0);
                ->;
            };

            // The byte an ARRAY_STORE writes: the low byte of an integer, 0 for anything else
            store_byte_of(int vt, i64 vd) -> i64
            {
                switch (this.tag_has_int_data(vt))
                {
                    case (true) { -> vd `& (i64)255; }
                    default {};
                };
                switch (vt == IDKVM_T_BYTES)
                {
                    case (true) { -> (i64)idkvm_i2p(vd)[0] `& (i64)255; }
                    default {};
                };
                -> 0;
            };

            heap_byte_write(i64 addr, i64 v) -> bool
            {
                switch (!this.mem_ok(addr, 1))
                {
                    case (true) { this.fail(g"VMHeap: out-of-bounds access\0"); -> false; }
                    default {};
                };
                this.mem_wr(addr, 1, v);
                -> true;
            };

            op_array_load() -> void
            {
                i64 idx;
                i64* b;
                int fi = this.nframes - 1;
                int slot, at;
                i64 ad;
                this.pop_val();
                idx = this.pd;
                this.pop_val();
                at = this.pt;
                ad = this.pd;
                switch (this.failed) { case (true) { ->; } default {}; };
                // a PTR: an OS pointer, a slot of this frame (@var), or an address of the VM heap
                switch (at == IDKVM_T_PTR)
                {
                    case (true)
                    {
                        switch (fi >= 0 & ad < (i64)this.fr_nloc[fi])
                        {
                            case (true)
                            {
                                slot = this.fr_base[fi] + (int)ad;
                                switch (this.lc_tag[slot] == IDKVM_T_PTR)
                                {
                                    case (true)
                                    {
                                        this.heap_byte_push(this.lc_data[slot] + idx);
                                        ->;
                                    }
                                    default {};
                                };
                                switch (this.lc_tag[slot] == IDKVM_T_ARRAY)
                                {
                                    case (true) { at = IDKVM_T_ARRAY; ad = this.lc_data[slot]; }
                                    default {};
                                };
                            }
                            default
                            {
                                this.heap_byte_push(ad + idx);
                                ->;
                            };
                        };
                    }
                    default {};
                };
                // a native pointer kept under another tag
                switch (at != IDKVM_T_ARRAY & this.tag_has_int_data(at) & ad != (i64)0 & (ad < (i64)0 | ad > (i64)65535))
                {
                    case (true)
                    {
                        this.heap_byte_push(ad + idx);
                        ->;
                    }
                    default {};
                };
                switch (at != IDKVM_T_ARRAY)
                {
                    case (true) { this.fail(g"ARRAY_LOAD: array has no elements storage\0"); ->; }
                    default {};
                };
                b = (i64*)ad;
                switch (idx < (i64)0 | idx >= b[0])
                {
                    case (true)
                    {
                        this.fail_index(g"ARRAY_LOAD: index \0", idx, b[0]);
                        ->;
                    }
                    default {};
                };
                this.push((int)b[2 + (int)idx * 3], b[3 + (int)idx * 3], b[4 + (int)idx * 3]);
                ->;
            };

            op_array_store() -> void
            {
                i64 vt, vd, vm, idx;
                i64* b, nb;
                int i, n;
                int fi = this.nframes - 1;
                int slot, at;
                i64 ad, am;
                this.pop_val();
                vt = (i64)this.pt;
                vd = this.pd;
                vm = this.pm;
                this.pop_val();
                idx = this.pd;
                this.pop_val();
                at = this.pt;
                ad = this.pd;
                am = this.pm;
                switch (this.failed) { case (true) { ->; } default {}; };
                switch (at == IDKVM_T_PTR)
                {
                    case (true)
                    {
                        switch (fi >= 0 & ad < (i64)this.fr_nloc[fi])
                        {
                            case (true)
                            {
                                slot = this.fr_base[fi] + (int)ad;
                                switch (this.lc_tag[slot] == IDKVM_T_PTR)
                                {
                                    case (true)
                                    {
                                        switch (this.heap_byte_write(this.lc_data[slot] + idx, this.store_byte_of((int)vt, vd)))
                                        {
                                            case (true) { this.push(IDKVM_T_PTR, ad, am); }
                                            default {};
                                        };
                                        ->;
                                    }
                                    default {};
                                };
                                switch (this.lc_tag[slot] == IDKVM_T_ARRAY)
                                {
                                    case (true)
                                    {
                                        b = (i64*)this.lc_data[slot];
                                        switch (idx < (i64)0 | idx >= b[0])
                                        {
                                            case (true) { this.fail(g"ARRAY_STORE: index out of bounds\0"); ->; }
                                            default {};
                                        };
                                        n = (int)b[0];
                                        nb = this.arr_make(n, (int)b[1]);
                                        switch (this.failed) { case (true) { ->; } default {}; };
                                        while (i < n * 3)
                                        {
                                            nb[2 + i] = b[2 + i];
                                            i++;
                                        };
                                        nb[2 + (int)idx * 3] = vt;
                                        nb[3 + (int)idx * 3] = vd;
                                        nb[4 + (int)idx * 3] = vm;
                                        this.lc_data[slot] = (i64)nb;
                                        this.lc_meta[slot] = (i64)n;
                                        this.push(IDKVM_T_PTR, ad, am);
                                        ->;
                                    }
                                    default {};
                                };
                            }
                            default
                            {
                                switch (this.heap_byte_write(ad + idx, this.store_byte_of((int)vt, vd)))
                                {
                                    case (true) { this.push(IDKVM_T_PTR, ad, am); }
                                    default {};
                                };
                                ->;
                            };
                        };
                    }
                    default {};
                };
                switch (at != IDKVM_T_ARRAY & this.tag_has_int_data(at) & ad != (i64)0 & (ad < (i64)0 | ad > (i64)65535))
                {
                    case (true)
                    {
                        switch (this.heap_byte_write(ad + idx, this.store_byte_of((int)vt, vd)))
                        {
                            case (true) { this.push(at, ad, am); }
                            default {};
                        };
                        ->;
                    }
                    default {};
                };
                switch (at != IDKVM_T_ARRAY)
                {
                    case (true) { this.fail(g"ARRAY_STORE: index out of bounds\0"); ->; }
                    default {};
                };
                b = (i64*)ad;
                switch (idx < (i64)0 | idx >= b[0])
                {
                    case (true)
                    {
                        this.fail(g"ARRAY_STORE: index out of bounds\0");
                        ->;
                    }
                    default {};
                };
                n = (int)b[0];
                nb = this.arr_make(n, (int)b[1]);
                switch (this.failed) { case (true) { ->; } default {}; };
                i = 0;
                while (i < n * 3)
                {
                    nb[2 + i] = b[2 + i];
                    i++;
                };
                nb[2 + (int)idx * 3] = vt;
                nb[3 + (int)idx * 3] = vd;
                nb[4 + (int)idx * 3] = vm;
                this.push(IDKVM_T_ARRAY, (i64)nb, (i64)n);
                ->;
            };

            // ===== STRUCTS (Val STRUCT with fields) =====
            // A struct is one block: field count, layout index, then one triple of tag, data, meta
            // per field. The stack value is (STRUCT, block, layout index). Stores copy the block.

            // "<msg><idx> out of bounds (len=<n>)" like the Python VM
            fail_index(byte* msg, i64 idx, i64 n) -> void
            {
                switch (!this.failed)
                {
                    case (true) {
                        this.errb.clear();
                        this.errb.put_str(msg);
                        this.errb.put_i64(idx);
                        this.errb.put_str(g" out of bounds (len=\0");
                        this.errb.put_i64(n);
                        this.errb.put_str(g")\0");
                        this.failed = true;
                    }
                    default {};
                };
                ->;
            };

            // "<msg>, got TTag.<NAME>" like the f-string of the Python VM
            fail_got(byte* msg, int tag) -> void
            {
                byte* nm = idkvm_ttag_name(tag);
                int k;
                byte ch;
                switch (!this.failed)
                {
                    case (true) {
                        this.errb.clear();
                        this.errb.put_str(msg);
                        this.errb.put_str(g", got TTag.\0");
                        while (nm[k] != 0)
                        {
                            ch = nm[k];
                            switch (ch >= 'a' & ch <= 'z') { case (true) { ch = (byte)(ch - 32); } default {}; };
                            this.errb.put(ch);
                            k++;
                        };
                        this.failed = true;
                    }
                    default {};
                };
                ->;
            };

            fail_parts(byte* a, byte* b, byte* c, byte* d) -> void
            {
                switch (!this.failed)
                {
                    case (true) {
                        this.errb.clear();
                        this.errb.put_str(a);
                        this.errb.put_str(b);
                        this.errb.put_str(c);
                        this.errb.put_str(d);
                        this.failed = true;
                    }
                    default {};
                };
                ->;
            };

            // Index within layout li of the field called name, or -1
            field_index(int li, byte* name) -> int
            {
                int k;
                while (k < this.layouts.scount[li])
                {
                    switch (idkvm_streq(this.layouts.fname[this.layouts.sfirst[li] + k], name))
                    {
                        case (true) { -> k; }
                        default {};
                    };
                    k++;
                };
                -> -1;
            };

            // Block of the struct called name with every field at its zero tag, 0 on failure
            struct_make(byte* name) -> i64*
            {
                int li = this.layouts.find(name);
                int n, k;
                i64* b;
                switch (li < 0)
                {
                    case (true)
                    {
                        this.fail_parts(g"Unknown struct/object type: '\0", name, g"'\0", g"\0");
                        -> (i64*)0;
                    }
                    default {};
                };
                n = this.layouts.scount[li];
                b = this.arr_make(n, 0);
                switch (this.failed) { case (true) { -> (i64*)0; } default {}; };
                b[1] = (i64)li;
                while (k < n)
                {
                    b[2 + k * 3] = (i64)this.layouts.ftag[this.layouts.sfirst[li] + k];
                    k++;
                };
                -> b;
            };

            op_struct_new(byte* name) -> void
            {
                i64* b = this.struct_make(name);
                switch (b == (i64*)0) { case (true) { ->; } default {}; };
                this.push(IDKVM_T_STRUCT, (i64)b, b[1]);
                ->;
            };

            // Sets the field called fname of the struct block b
            sf(i64* b, byte* fname, int tag, i64 d, i64 m) -> void
            {
                int li = (int)b[1];
                int k;
                switch (this.failed) { case (true) { ->; } default {}; };
                k = this.field_index(li, fname);
                switch (k < 0)
                {
                    case (true)
                    {
                        this.fail_parts(g"STRUCT_STORE: field '\0", fname, g"' not found in struct '\0", this.layouts.sname[li]);
                        ->;
                    }
                    default {};
                };
                b[2 + k * 3] = (i64)tag;
                b[3 + k * 3] = d;
                b[4 + k * 3] = m;
                ->;
            };

            // Sets a string field to a copy of s (BYTES), null is empty
            sfs(i64* b, byte* fname, byte* s) -> void
            {
                int n;
                byte* p;
                switch (s != (byte*)0) { case (true) { n = idkvm_strlen(s); } default {}; };
                p = idkvm_dup(s, n);
                switch (p == (byte*)0)
                {
                    case (true) { this.fail(g"allocation failed\0"); ->; }
                    default {};
                };
                this.sf(b, fname, IDKVM_T_BYTES, idkvm_p2i(p), (i64)n);
                ->;
            };

            sfi(i64* b, byte* fname, int v) -> void -> this.sf(b, fname, IDKVM_T_INT, (i64)v, 0);

            sfb(i64* b, byte* fname, bool v) -> void
            {
                switch (v)
                {
                    case (true) { this.sf(b, fname, IDKVM_T_BOOL, 1, 0); }
                    default { this.sf(b, fname, IDKVM_T_BOOL, 0, 0); };
                };
                ->;
            };

            // Sets a field to a struct block
            sfst(i64* b, byte* fname, i64* v) -> void
            {
                switch (v == (i64*)0) { case (true) { ->; } default {}; };
                this.sf(b, fname, IDKVM_T_STRUCT, (i64)v, v[1]);
                ->;
            };

            // IDKC_TYPESYS block of t, an all empty one when t is null; 0 on failure
            mk_ts(FvmReflTy* t) -> i64*
            {
                i64* b = this.struct_make(g"IDKC_TYPESYS\0");
                switch (b == (i64*)0) { case (true) { -> b; } default {}; };
                switch (t == (FvmReflTy*)0)
                {
                    case (true)
                    {
                        switch (this.refl_zero == (FvmReflTy*)0)
                        {
                            case (true) { this.refl_zero = (FvmReflTy*)idkvm_alloc(sizeof(FvmReflTy) / 8); }
                            default {};
                        };
                        switch (this.refl_zero == (FvmReflTy*)0)
                        {
                            case (true) { this.fail(g"allocation failed\0"); -> (i64*)0; }
                            default {};
                        };
                        t = this.refl_zero;
                    }
                    default {};
                };
                this.sfs(b, g"base_type\0", t.base_type);
                this.sfs(b, g"custom_typename\0", t.custom);
                this.sfb(b, g"is_signed\0", t.is_signed);
                this.sfb(b, g"is_const\0", t.is_const);
                this.sfb(b, g"is_volatile\0", t.is_volatile);
                this.sfb(b, g"is_tied\0", t.is_tied);
                this.sfb(b, g"is_pointer\0", t.is_pointer);
                this.sfi(b, g"pointer_depth\0", t.pdepth);
                this.sfb(b, g"is_array\0", t.is_array);
                this.sfi(b, g"array_size\0", t.asize);
                this.sfi(b, g"bit_width\0", t.bits);
                this.sfi(b, g"alignment\0", t.align);
                this.sfi(b, g"endianness\0", t.endian);
                this.sfs(b, g"storage_class\0", t.storage);
                this.sfb(b, g"is_dict\0", t.is_dict);
                this.sfs(b, g"dict_key_type\0", t.dkey);
                this.sfs(b, g"dict_value_type\0", t.dval);
                switch (this.failed) { case (true) { -> (i64*)0; } default {}; };
                -> b;
            };

            // IDKC_SYMENTRY block of r, the zeroed entry when r is null; 0 on failure
            mk_entry(FvmRefl* r) -> i64*
            {
                i64* b = this.struct_make(g"IDKC_SYMENTRY\0");
                switch (b == (i64*)0) { case (true) { -> b; } default {}; };
                switch (r == (FvmRefl*)0)
                {
                    case (true)
                    {
                        this.sfs(b, g"name\0", (byte*)0);
                        this.sfs(b, g"kind\0", (byte*)0);
                        this.sfst(b, g"type\0", this.mk_ts((FvmReflTy*)0));
                        this.sfs(b, g"ns\0", (byte*)0);
                    }
                    default
                    {
                        this.sfs(b, g"name\0", r.name);
                        this.sfs(b, g"kind\0", r.kind);
                        this.sfst(b, g"type\0", this.mk_ts(@r.ty));
                        this.sfs(b, g"ns\0", r.ns);
                    };
                };
                switch (this.failed) { case (true) { -> (i64*)0; } default {}; };
                -> b;
            };

            // The kind named by a compiler.symbol_table.<plural> filter, null for an unknown one
            refl_kind(byte* f) -> byte*
            {
                switch (idkvm_streq(f, g"functions\0")) { case (true) { -> g"function\0"; } default {}; };
                switch (idkvm_streq(f, g"structs\0")) { case (true) { -> g"struct\0"; } default {}; };
                switch (idkvm_streq(f, g"objects\0")) { case (true) { -> g"object\0"; } default {}; };
                switch (idkvm_streq(f, g"traits\0")) { case (true) { -> g"trait\0"; } default {}; };
                switch (idkvm_streq(f, g"interfaces\0")) { case (true) { -> g"interface\0"; } default {}; };
                switch (idkvm_streq(f, g"namespaces\0")) { case (true) { -> g"namespace\0"; } default {}; };
                switch (idkvm_streq(f, g"variables\0")) { case (true) { -> g"variable\0"; } default {}; };
                switch (idkvm_streq(f, g"enums\0")) { case (true) { -> g"enum\0"; } default {}; };
                switch (idkvm_streq(f, g"unions\0")) { case (true) { -> g"union\0"; } default {}; };
                switch (idkvm_streq(f, g"effects\0")) { case (true) { -> g"effect\0"; } default {}; };
                switch (idkvm_streq(f, g"constraints\0")) { case (true) { -> g"constraint\0"; } default {}; };
                switch (idkvm_streq(f, g"contracts\0")) { case (true) { -> g"contract\0"; } default {}; };
                -> (byte*)0;
            };

            // Whether q names r, bare or as ns::name
            refl_match(FvmRefl* r, byte* q) -> bool
            {
                int n, k;
                switch (idkvm_streq(r.name, q)) { case (true) { -> true; } default {}; };
                n = idkvm_strlen(r.ns);
                switch (n == 0) { case (true) { -> false; } default {}; };
                while (k < n)
                {
                    switch (q[k] != r.ns[k]) { case (true) { -> false; } default {}; };
                    k++;
                };
                switch (q[n] != ':' | q[n] == 0) { case (true) { -> false; } default {}; };
                switch (q[n + 1] != ':') { case (true) { -> false; } default {}; };
                -> idkvm_streq(@q[n + 2], r.name);
            };

            // The name popped by lookup and funcinfo, empty when it is not a string
            pop_name() -> byte*
            {
                byte* nm;
                this.pop_val();
                switch (this.failed) { case (true) { -> g"\0"; } default {}; };
                nm = this.str_of(this.pt, this.pd);
                switch (nm == (byte*)0) { case (true) { -> g"\0"; } default {}; };
                -> nm;
            };

            // compiler.symbol_table and compiler.symbol_table.<plural>
            op_symtable(byte* filt) -> void
            {
                byte* want;
                int c, i, k;
                i64* arr, st, e;
                FvmRefl* r;
                bool take;
                switch (filt != (byte*)0) { case (true) { want = this.refl_kind(filt); } default {}; };
                switch (this.refl != (PtrVec*)0)
                {
                    case (true)
                    {
                        while (i < this.refl.len)
                        {
                            r = (FvmRefl*)this.refl.items[i];
                            take = want == (byte*)0;
                            switch (!take) { case (true) { take = idkvm_streq(r.kind, want); } default {}; };
                            switch (take) { case (true) { c++; } default {}; };
                            i++;
                        };
                    }
                    default {};
                };
                arr = this.arr_make(c, IDKVM_T_STRUCT);
                switch (this.failed) { case (true) { ->; } default {}; };
                i = 0;
                while (this.refl != (PtrVec*)0 & i < this.refl.len & !this.failed)
                {
                    r = (FvmRefl*)this.refl.items[i];
                    take = want == (byte*)0;
                    switch (!take) { case (true) { take = idkvm_streq(r.kind, want); } default {}; };
                    switch (take)
                    {
                        case (true)
                        {
                            e = this.mk_entry(r);
                            switch (e != (i64*)0)
                            {
                                case (true)
                                {
                                    arr[2 + k * 3] = (i64)IDKVM_T_STRUCT;
                                    arr[3 + k * 3] = (i64)e;
                                    arr[4 + k * 3] = e[1];
                                }
                                default {};
                            };
                            k++;
                        }
                        default {};
                    };
                    i++;
                };
                switch (this.failed) { case (true) { ->; } default {}; };
                st = this.struct_make(g"IDKC_SYMTABLE\0");
                switch (st == (i64*)0) { case (true) { ->; } default {}; };
                this.sfi(st, g"entries\0", c);
                this.sf(st, g"entry\0", IDKVM_T_ARRAY, (i64)arr, (i64)c);
                switch (this.failed) { case (true) { ->; } default {}; };
                this.push(IDKVM_T_STRUCT, (i64)st, st[1]);
                ->;
            };

            // compiler.symbol_table.lookup(name)
            op_symlookup() -> void
            {
                byte* nm = this.pop_name();
                FvmRefl* r, hit;
                i64* e;
                int i;
                switch (this.failed) { case (true) { ->; } default {}; };
                while (this.refl != (PtrVec*)0 & i < this.refl.len & hit == (FvmRefl*)0)
                {
                    r = (FvmRefl*)this.refl.items[i];
                    switch (this.refl_match(r, nm)) { case (true) { hit = r; } default {}; };
                    i++;
                };
                e = this.mk_entry(hit);
                switch (e == (i64*)0) { case (true) { ->; } default {}; };
                this.push(IDKVM_T_STRUCT, (i64)e, e[1]);
                ->;
            };

            // compiler.symbol_table.funcinfo(name): the flags are OR'd over the overloads,
            // the parameters and the return type come from the first one
            op_funcinfo() -> void
            {
                byte* nm = this.pop_name();
                FvmRefl* r;
                FvmReflFn* first, f;
                i64* b, pa, pe, pt;
                int i, k, np;
                bool vr, rc, il, nmg, ef, at;
                switch (this.failed) { case (true) { ->; } default {}; };
                while (this.refl != (PtrVec*)0 & i < this.refl.len)
                {
                    r = (FvmRefl*)this.refl.items[i];
                    switch (idkvm_streq(r.kind, g"function\0") & r.fn != (FvmReflFn*)0)
                    {
                        case (true)
                        {
                            switch (this.refl_match(r, nm))
                            {
                                case (true)
                                {
                                    f = r.fn;
                                    switch (first == (FvmReflFn*)0) { case (true) { first = f; } default {}; };
                                    vr = vr | f.variadic;
                                    rc = rc | f.recursive;
                                    il = il | f.inl;
                                    nmg = nmg | f.nomangle;
                                    ef = ef | f.has_eff;
                                    at = at | f.has_att;
                                }
                                default {};
                            };
                        }
                        default {};
                    };
                    i++;
                };
                switch (first != (FvmReflFn*)0) { case (true) { np = first.nparams; } default {}; };
                pa = this.arr_make(np, IDKVM_T_STRUCT);
                switch (this.failed) { case (true) { ->; } default {}; };
                while (k < np & !this.failed)
                {
                    pe = this.struct_make(g"IDKC_PARAM\0");
                    switch (pe != (i64*)0)
                    {
                        case (true)
                        {
                            this.sfs(pe, g"name\0", first.params[k].name);
                            this.sfst(pe, g"type\0", this.mk_ts(@first.params[k].ty));
                            pa[2 + k * 3] = (i64)IDKVM_T_STRUCT;
                            pa[3 + k * 3] = (i64)pe;
                            pa[4 + k * 3] = pe[1];
                        }
                        default {};
                    };
                    k++;
                };
                switch (this.failed) { case (true) { ->; } default {}; };
                b = this.struct_make(g"IDKC_FUNCINFO\0");
                switch (b == (i64*)0) { case (true) { ->; } default {}; };
                this.sfi(b, g"param_count\0", np);
                this.sf(b, g"params\0", IDKVM_T_ARRAY, (i64)pa, (i64)np);
                switch (first != (FvmReflFn*)0)
                {
                    case (true)
                    {
                        this.sfst(b, g"return_type\0", this.mk_ts(@first.ret));
                        this.sfs(b, g"calling_conv\0", first.cc);
                        this.sfi(b, g"pre_contracts\0", first.pre);
                        this.sfi(b, g"post_contracts\0", first.post);
                    }
                    default
                    {
                        this.sfst(b, g"return_type\0", this.mk_ts((FvmReflTy*)0));
                        this.sfs(b, g"calling_conv\0", (byte*)0);
                        this.sfi(b, g"pre_contracts\0", 0);
                        this.sfi(b, g"post_contracts\0", 0);
                    };
                };
                this.sfb(b, g"is_variadic\0", vr);
                this.sfb(b, g"is_recursive\0", rc);
                this.sfb(b, g"is_inline\0", il);
                this.sfb(b, g"no_mangle\0", nmg);
                this.sfb(b, g"has_effect\0", ef);
                this.sfb(b, g"has_attenuate\0", at);
                switch (this.failed) { case (true) { ->; } default {}; };
                this.push(IDKVM_T_STRUCT, (i64)b, b[1]);
                ->;
            };

            // The preprocessor constant called key, null when it is not defined
            cc_get(byte* key) -> byte*
            {
                int i;
                switch (this.cc_k == (PtrVec*)0) { case (true) { -> (byte*)0; } default {}; };
                while (i < this.cc_k.len)
                {
                    switch (idkvm_streq((byte*)this.cc_k.items[i], key)) { case (true) { -> (byte*)this.cc_v.items[i]; } default {}; };
                    i++;
                };
                -> (byte*)0;
            };

            // int(cc.get(key, dflt)) of idkvm.py, dflt when the constant is absent, empty or not a number
            cc_int(byte* key, int dflt) -> int
            {
                byte* v = this.cc_get(key);
                bool ok;
                i64 n;
                switch (v == (byte*)0) { case (true) { -> dflt; } default {}; };
                switch (v[0] == 0) { case (true) { -> dflt; } default {}; };
                n = idkvm_parse_int(v, idkvm_strlen(v), @ok);
                switch (!ok) { case (true) { -> dflt; } default {}; };
                -> (int)n;
            };

            // compiler.target.<prop>
            op_target(byte* prop) -> void
            {
                byte* triple = this.cc_get(g"__TARGET_TRIPLE__\0");
                byte* arch;
                int k, pw;
                bool x86;
                switch (triple == (byte*)0) { case (true) { triple = idkvm_host_triple(); } default {}; };
                switch (triple[0] == 0) { case (true) { triple = idkvm_host_triple(); } default {}; };
                arch = idkvm_arch_of(triple);
                x86 = idkvm_streq(arch, g"x86_64\0") | idkvm_streq(arch, g"x86\0");
                // has_<feature>: CPUID of the host, x86 only
                switch (idkvm_starts_with(prop, g"has_\0"))
                {
                    case (true)
                    {
                        switch (x86 & idkvm_cpu_has(@prop[4])) { case (true) { this.push(IDKVM_T_BOOL, 1, 0); } default { this.push(IDKVM_T_BOOL, 0, 0); }; };
                        ->;
                    }
                    default {};
                };
                switch (idkvm_streq(prop, g"arch\0")) { case (true) { this.push_bytes(arch, idkvm_strlen(arch)); ->; } default {}; };
                switch (idkvm_streq(prop, g"os\0")) { case (true) { arch = idkvm_os_of(triple); this.push_bytes(arch, idkvm_strlen(arch)); ->; } default {}; };
                switch (idkvm_streq(prop, g"abi\0")) { case (true) { arch = idkvm_abi_of(triple); this.push_bytes(arch, idkvm_strlen(arch)); ->; } default {}; };
                switch (idkvm_streq(prop, g"ptr_width\0"))
                {
                    case (true)
                    {
                        pw = 32;
                        switch (idkvm_streq(arch, g"x86_64\0") | idkvm_streq(arch, g"arm64\0") | idkvm_streq(arch, g"aarch64\0") | idkvm_has_ci(arch, g"64\0")) { case (true) { pw = 64; } default {}; };
                        pw = this.cc_int(g"__SIZEOF_PTR__\0", pw / 8) * 8;
                        this.push(IDKVM_T_INT, pw, 0);
                        ->;
                    }
                    default {};
                };
                switch (idkvm_streq(prop, g"endian\0"))
                {
                    case (true)
                    {
                        switch (this.cc_int(g"__BIG_ENDIAN__\0", 0) != 0) { case (true) { this.push_bytes(g"big\0", 3); } default { this.push_bytes(g"little\0", 6); }; };
                        ->;
                    }
                    default {};
                };
                switch (idkvm_streq(prop, g"cache_line\0")) { case (true) { this.push(IDKVM_T_INT, 64, 0); ->; } default {}; };
                switch (idkvm_streq(prop, g"page_size\0")) { case (true) { this.push(IDKVM_T_INT, (i64)idkvm_page_size(), 0); ->; } default {}; };
                // an unknown property is empty bytes
                this.push_bytes(g"\0", 0);
                ->;
            };

            // STRUCT_LOAD through a PTR that was cast to a struct type
            ptr_field_load(i64 addr, i64 pm, byte* field) -> void
            {
                int li, f;
                switch (pm < (i64)IDKVM_META_TYPE)
                {
                    case (true) { this.fail_got(g"STRUCT_LOAD: expected STRUCT value\0", IDKVM_T_PTR); ->; }
                    default {};
                };
                li = this.ptr_layout(pm);
                switch (this.failed) { case (true) { ->; } default {}; };
                f = this.ptr_field(li, field);
                switch (this.failed) { case (true) { ->; } default {}; };
                this.load_at(this.layouts.ftag[f], this.layouts.fsize[f], addr + (i64)this.layouts.foff[f]);
                ->;
            };

            // STRUCT_STORE through a PTR that was cast to a struct type, the pointer stays on the stack
            ptr_field_store(i64 addr, i64 pm, int vt, i64 vd, i64 vm, byte* field) -> void
            {
                int li, f;
                switch (pm < (i64)IDKVM_META_TYPE)
                {
                    case (true) { this.fail_got(g"STRUCT_STORE: expected STRUCT value\0", IDKVM_T_PTR); ->; }
                    default {};
                };
                li = this.ptr_layout(pm);
                switch (this.failed) { case (true) { ->; } default {}; };
                f = this.ptr_field(li, field);
                switch (this.failed) { case (true) { ->; } default {}; };
                this.store_at(this.layouts.ftag[f], this.layouts.fsize[f], vt, vd, vm, addr + (i64)this.layouts.foff[f]);
                switch (this.failed) { case (true) { ->; } default {}; };
                this.push(IDKVM_T_PTR, addr, pm);
                ->;
            };

            op_struct_load(byte* field) -> void
            {
                i64* b;
                int li, k;
                this.pop_val();
                switch (this.failed) { case (true) { ->; } default {}; };
                switch (this.pt != IDKVM_T_STRUCT)
                {
                    case (true)
                    {
                        switch (this.pt == IDKVM_T_PTR)
                        {
                            case (true) { this.ptr_field_load(this.pd, this.pm, field); }
                            default { this.fail_got(g"STRUCT_LOAD: expected STRUCT value\0", this.pt); };
                        };
                        ->;
                    }
                    default {};
                };
                b = (i64*)this.pd;
                li = (int)b[1];
                k = this.field_index(li, field);
                switch (k < 0)
                {
                    case (true)
                    {
                        this.fail_parts(g"STRUCT_LOAD: field '\0", field, g"' not found in struct '\0", this.layouts.sname[li]);
                        ->;
                    }
                    default {};
                };
                this.push((int)b[2 + k * 3], b[3 + k * 3], b[4 + k * 3]);
                ->;
            };

            op_struct_store(byte* field) -> void
            {
                i64 vt, vd, vm;
                i64* b, nb;
                int li, k, i, n;
                this.pop_val();
                vt = (i64)this.pt;
                vd = this.pd;
                vm = this.pm;
                this.pop_val();
                switch (this.failed) { case (true) { ->; } default {}; };
                switch (this.pt != IDKVM_T_STRUCT)
                {
                    case (true)
                    {
                        switch (this.pt == IDKVM_T_PTR)
                        {
                            case (true) { this.ptr_field_store(this.pd, this.pm, vt, vd, vm, field); }
                            default { this.fail_got(g"STRUCT_STORE: expected STRUCT value\0", this.pt); };
                        };
                        ->;
                    }
                    default {};
                };
                b = (i64*)this.pd;
                li = (int)b[1];
                n = (int)b[0];
                k = this.field_index(li, field);
                nb = this.arr_make(n, 0);
                switch (this.failed) { case (true) { ->; } default {}; };
                nb[1] = (i64)li;
                while (i < n * 3)
                {
                    nb[2 + i] = b[2 + i];
                    i++;
                };
                // a field the layout lacks is an error in both VMs
                switch (k < 0)
                {
                    case (true)
                    {
                        this.fail_parts(g"STRUCT_STORE: field '\0", field, g"' not found in struct '\0", this.layouts.sname[li]);
                        ->;
                    }
                    default {};
                };
                nb[2 + k * 3] = vt;
                nb[3 + k * 3] = vd;
                nb[4 + k * 3] = vm;
                this.push(IDKVM_T_STRUCT, (i64)nb, (i64)li);
                ->;
            };

            // ===== INSTRUCTION DISPATCH =====
            // pc is the index of the instruction in the pool, fi the current frame.

            dispatch(int op, int pc, int fi) -> void
            {
                i64 oa = this.code.a[pc];
                i64 ob = this.code.b[pc];
                i64 oc = this.code.c[pc];
                byte* os = this.code.s[pc];
                int at, k, slot, e, w;
                i64 ad, bd, cd;
                int bt, ct;
                i64 ma, mb, mc;
                i64* tbl;
                byte* sp1;

                switch (op)
                {
                    // Stack
                    case (IDKVM_PUSH) { this.push(oa, ob, oc); }
                    case (IDKVM_POP) { this.pop_val(); }
                    case (IDKVM_DUP)
                    {
                        switch (this.need(1))
                        {
                            case (true) { this.push(this.st_tag[this.sp - 1], this.st_data[this.sp - 1], this.st_meta[this.sp - 1]); }
                            default {};
                        };
                    }
                    case (IDKVM_SWAP)
                    {
                        switch (this.need(2))
                        {
                            case (true) {
                                at = this.st_tag[this.sp - 1];
                                ad = this.st_data[this.sp - 1];
                                bd = this.st_meta[this.sp - 1];
                                this.st_tag[this.sp - 1] = this.st_tag[this.sp - 2];
                                this.st_data[this.sp - 1] = this.st_data[this.sp - 2];
                                this.st_meta[this.sp - 1] = this.st_meta[this.sp - 2];
                                this.st_tag[this.sp - 2] = at;
                                this.st_data[this.sp - 2] = ad;
                                this.st_meta[this.sp - 2] = bd;
                            }
                            default {};
                        };
                    }
                    case (IDKVM_ROT)
                    {
                        // a b c -> b c a
                        switch (this.need(3))
                        {
                            case (true) {
                                this.pop_val();
                                ct = this.pt;
                                cd = this.pd;
                                mc = this.pm;
                                this.pop_val();
                                bt = this.pt;
                                bd = this.pd;
                                mb = this.pm;
                                this.pop_val();
                                at = this.pt;
                                ad = this.pd;
                                ma = this.pm;
                                this.push(bt, bd, mb);
                                this.push(ct, cd, mc);
                                this.push(at, ad, ma);
                            }
                            default {};
                        };
                    }
                    case (IDKVM_OVER)
                    {
                        switch (this.need(2))
                        {
                            case (true) { this.push(this.st_tag[this.sp - 2], this.st_data[this.sp - 2], this.st_meta[this.sp - 2]); }
                            default {};
                        };
                    }

                    // Arithmetic, bitwise and logic
                    case (IDKVM_ADD) { this.binop(op); }
                    case (IDKVM_SUB) { this.binop(op); }
                    case (IDKVM_MUL) { this.binop(op); }
                    case (IDKVM_DIV) { this.binop(op); }
                    case (IDKVM_MOD) { this.binop(op); }
                    case (IDKVM_POW) { this.binop(op); }
                    case (IDKVM_MIN) { this.binop(op); }
                    case (IDKVM_MAX) { this.binop(op); }
                    case (IDKVM_BAND) { this.binop(op); }
                    case (IDKVM_BOR) { this.binop(op); }
                    case (IDKVM_BXOR) { this.binop(op); }
                    case (IDKVM_SHL) { this.binop(op); }
                    case (IDKVM_SHR) { this.binop(op); }
                    case (IDKVM_AND) { this.binop(op); }
                    case (IDKVM_OR) { this.binop(op); }
                    case (IDKVM_NEG) { this.unop(op); }
                    case (IDKVM_ABS) { this.unop(op); }
                    case (IDKVM_BNOT) { this.unop(op); }
                    case (IDKVM_NOT) { this.unop(op); }
                    case (IDKVM_POPCOUNT) { this.unop(op); }
                    case (IDKVM_CLAMP) { this.clamp(); }
                    case (IDKVM_ROTL) { this.bitop(op, oa); }
                    case (IDKVM_ROTR) { this.bitop(op, oa); }
                    case (IDKVM_BITREV) { this.bitop(op, oa); }
                    case (IDKVM_CLZ) { this.bitop(op, oa); }
                    case (IDKVM_CTZ) { this.bitop(op, oa); }

                    // Comparison
                    case (IDKVM_CMP_EQ) { this.cmp(op); }
                    case (IDKVM_CMP_NE) { this.cmp(op); }
                    case (IDKVM_CMP_LT) { this.cmp(op); }
                    case (IDKVM_CMP_LE) { this.cmp(op); }
                    case (IDKVM_CMP_GT) { this.cmp(op); }
                    case (IDKVM_CMP_GE) { this.cmp(op); }

                    // Control flow
                    case (IDKVM_JMP) { this.fr_ip[fi] = oa; }
                    case (IDKVM_JIF)
                    {
                        this.pop_val();
                        switch (this.truthy(this.pt, this.pd, this.pm))
                        {
                            case (true) { this.fr_ip[fi] = oa; }
                            default {};
                        };
                    }
                    case (IDKVM_JNF)
                    {
                        this.pop_val();
                        switch (!this.truthy(this.pt, this.pd, this.pm))
                        {
                            case (true) { this.fr_ip[fi] = oa; }
                            default {};
                        };
                    }
                    case (IDKVM_JTABLE)
                    {
                        this.pop_val();
                        ad = this.pd;
                        tbl = (i64*)os;
                        switch (ad >= (i64)0 & ad < ob)
                        {
                            case (true) { this.fr_ip[fi] = (int)tbl[(int)ad]; }
                            default { this.fr_ip[fi] = oa; };
                        };
                    }
                    case (IDKVM_CALL) { this.do_call(os, oa); }
                    case (IDKVM_CALL_PTR)
                    {
                        this.pop_val();
                        sp1 = this.str_of(this.pt, this.pd);
                        switch (sp1 == (byte*)0)
                        {
                            case (true) { this.fail(g"CALL_PTR: expected a function name\0"); }
                            default { this.do_call(sp1, oa); };
                        };
                    }
                    case (IDKVM_RET) { this.pop_frame(); }
                    case (IDKVM_TAIL_SELF)
                    {
                        this.take_args(fi, oa);
                        this.fr_ip[fi] = 0;
                    }
                    case (IDKVM_HALT)
                    {
                        this.nframes = 0;
                        this.lc_top = 0;
                        this.nh = 0;
                    }

                    // Exceptions
                    case (IDKVM_THROW)
                    {
                        this.pop_val();
                        this.tv_tag = this.pt;
                        this.tv_data = this.pd;
                        this.tv_meta = this.pm;
                        switch (!this.failed) { case (true) { this.throwing = true; } default {}; };
                    }
                    case (IDKVM_TRY_BEGIN)
                    {
                        switch (this.nh >= this.hcap)
                        {
                            case (true) { this.grow_handlers(); }
                            default {};
                        };
                        switch (!this.failed)
                        {
                            case (true) {
                                this.h_frame[this.nh] = fi;
                                this.h_catch[this.nh] = oa;
                                this.h_depth[this.nh] = this.sp;
                                this.nh++;
                            }
                            default {};
                        };
                    }
                    case (IDKVM_TRY_END)
                    {
                        switch (this.nh > 0 & this.h_frame[this.nh - 1] == fi)
                        {
                            case (true) { this.nh--; }
                            default {};
                        };
                    }

                    // Locals and globals
                    case (IDKVM_LOCAL_GET)
                    {
                        switch (oa < (i64)0 | oa >= (i64)this.fr_nloc[fi])
                        {
                            case (true) { this.fail(g"LOCAL_GET: slot out of range\0"); }
                            default
                            {
                                slot = this.fr_base[fi] + (int)oa;
                                this.push(this.lc_tag[slot], this.lc_data[slot], this.lc_meta[slot]);
                            };
                        };
                    }
                    case (IDKVM_LOCAL_SET)
                    {
                        this.pop_val();
                        switch (oa < (i64)0 | oa >= (i64)this.fr_nloc[fi])
                        {
                            case (true) { this.fail(g"LOCAL_SET: slot out of range\0"); }
                            default
                            {
                                slot = this.fr_base[fi] + (int)oa;
                                this.lc_tag[slot] = this.pt;
                                this.lc_set[slot] = 1;
                                this.lc_data[slot] = this.pd;
                                this.lc_meta[slot] = this.pm;
                            };
                        };
                    }
                    case (IDKVM_LOCAL_DEREF)
                    {
                        this.pop_val();
                        at = this.pt;
                        ad = this.pd;
                        switch (at == IDKVM_T_BYTES)
                        {
                            case (true) {
                                // BYTES: the byte at offset 0
                                this.push(IDKVM_T_BYTE, (i64)idkvm_i2p(ad)[0], 0);
                            }
                            default
                            {
                                switch (ad < (i64)0 | ad >= (i64)this.fr_nloc[fi])
                                {
                                    case (true) {
                                        this.heap_byte_push(ad);
                                    }
                                    default
                                    {
                                        slot = this.fr_base[fi] + (int)ad;
                                        this.push(this.lc_tag[slot], this.lc_data[slot], this.lc_meta[slot]);
                                    };
                                };
                            };
                        };
                    }
                    case (IDKVM_LOCAL_DEREF_SET)
                    {
                        this.pop_val();
                        bt = this.pt;
                        bd = this.pd;
                        cd = this.pm;
                        this.pop_val();
                        ad = this.pd;
                        switch (this.failed)
                        {
                            case (true) {}
                            default
                            {
                                switch (ad < (i64)0 | ad >= (i64)this.fr_nloc[fi])
                                {
                                    case (true)
                                    {
                                        this.heap_byte_write(ad, this.store_byte_of((int)bt, bd));
                                    }
                                    default
                                    {
                                        slot = this.fr_base[fi] + (int)ad;
                                        this.lc_tag[slot] = bt;
                                        this.lc_set[slot] = 1;
                                        this.lc_data[slot] = bd;
                                        this.lc_meta[slot] = cd;
                                    };
                                };
                            };
                        };
                    }
                    case (IDKVM_GLOBAL_GET)
                    {
                        e = this.global_find(os);
                        switch (e < 0)
                        {
                            case (true) { this.push(IDKVM_T_INT, 0, 0); }
                            default { this.push(this.g_tag[e], this.g_data[e], this.g_meta[e]); };
                        };
                    }
                    case (IDKVM_GLOBAL_SET)
                    {
                        this.pop_val();
                        switch (!this.failed)
                        {
                            case (true) { this.global_set(os, this.pt, this.pd, this.pm); }
                            default {};
                        };
                    }

                    // Memory
                    case (IDKVM_ALLOC)
                    {
                        this.pop_val();
                        ad = this.pd;
                        switch (this.failed)
                        {
                            case (true) {}
                            default
                            {
                                k = this.vheap.alloc((int)ad);
                                switch (k == 0)
                                {
                                    case (true) { this.fail(g"VMHeap: invalid size or out of memory\0"); }
                                    default { this.push(IDKVM_T_PTR, (i64)k, 0); };
                                };
                            };
                        };
                    }
                    case (IDKVM_FREE)
                    {
                        this.pop_val();
                        switch (this.failed)
                        {
                            case (true) {}
                            default
                            {
                                switch (!this.vheap.free(this.pd))
                                {
                                    case (true) { this.fail(g"VMHeap.free: invalid pointer\0"); }
                                    default {};
                                };
                            };
                        };
                    }
                    case (IDKVM_LOAD) { this.do_load(oa, (int)ob, os); }
                    case (IDKVM_STORE) { this.do_store(oa, (int)ob); }
                    case (IDKVM_OFFSET)
                    {
                        this.pop_val();
                        bd = this.pd;
                        this.pop_val();
                        switch (this.pt == IDKVM_T_BYTES)
                        {
                            case (true) { this.stub(g"OFFSET on BYTES (pinned native buffers)\0"); }
                            default { this.push(IDKVM_T_PTR, this.pd + bd, 0); };
                        };
                    }

                    // Enums
                    case (IDKVM_ENUM_NEW) { this.push(IDKVM_T_ENUM, 0, 0); }
                    case (IDKVM_ENUM_LOAD)
                    {
                        this.pop_val();
                        switch (this.pt != IDKVM_T_ENUM)
                        {
                            case (true) { this.fail_got(g"ENUM_LOAD: expected enum value\0", this.pt); }
                            default { this.push(IDKVM_T_INT, this.pd, 0); };
                        };
                    }
                    case (IDKVM_ENUM_STORE)
                    {
                        this.pop_val();
                        ad = this.pd;
                        this.pop_val();
                        switch (this.pt != IDKVM_T_ENUM)
                        {
                            case (true) { this.fail_got(g"ENUM_STORE: expected enum value\0", this.pt); }
                            default { this.push(IDKVM_T_ENUM, ad, this.pm); };
                        };
                    }

                    // Type introspection
                    case (IDKVM_SIZEOF)
                    {
                        w = this.type_size(os);
                        switch (w < 0)
                        {
                            case (true) { this.fail_name(g"Unknown type size for: \0", os); }
                            default { this.push(IDKVM_T_UINT, (i64)w * (i64)8, 0); };
                        };
                    }
                    case (IDKVM_TYPEOF)
                    {
                        switch (this.need(1))
                        {
                            case (true) {
                                sp1 = idkvm_ttag_name(this.st_tag[this.sp - 1]);
                                this.push_bytes(sp1, idkvm_strlen(sp1));
                            }
                            default {};
                        };
                    }
                    case (IDKVM_ALIGNOF)
                    {
                        w = this.align_of(os);
                        switch (w < 0)
                        {
                            case (true) { this.fail_name(g"Unknown type size for: \0", os); }
                            default { this.push(IDKVM_T_UINT, (i64)w, 0); };
                        };
                    }
                    case (IDKVM_ENDIANOF)
                    {
                        e = this.layouts.find(os);
                        switch (e >= 0)
                        {
                            case (true) { sp1 = this.layouts.sendian[e]; }
                            default
                            {
                                switch (os[0] == 'b' & os[1] == 'e')
                                {
                                    case (true) { sp1 = g"big\0"; }
                                    default { sp1 = g"little\0"; };
                                };
                            };
                        };
                        this.push_bytes(sp1, idkvm_strlen(sp1));
                    }

                    // compiler.io console
                    case (IDKVM_COMPILER_PRINT)
                    {
                        this.pop_val();
                        switch (!this.failed) { case (true) { this.print_value(this.pt, this.pd, false); } default {}; };
                    }
                    case (IDKVM_COMPILER_PRINTLN)
                    {
                        this.pop_val();
                        switch (!this.failed) { case (true) { this.print_value(this.pt, this.pd, true); } default {}; };
                    }
                    case (IDKVM_COMPILER_INPUT) { this.op_input(); }
                    case (IDKVM_COMPILER_READFILE) { this.op_readfile(); }
                    case (IDKVM_COMPILER_IMPORT_STDLIB) { this.host_request(IDKVM_HOST_IMPORT_STDLIB); }
                    case (IDKVM_COMPILER_IMPORT_LOCAL) { this.host_request(IDKVM_HOST_IMPORT_LOCAL); }
                    case (IDKVM_COMPILER_IDKVM_DUMP) { this.op_dump(); }
                    case (IDKVM_COMPILER_IDKVM_BINDUMP) { this.op_bindump(); }
                    case (IDKVM_COMPILER_WRITEFILE) { this.op_writefile(); }
                    case (IDKVM_COMPILER_LOADLIB) { this.op_loadlib(); }
                    case (IDKVM_COMPILER_IDKVM_SETBP) { this.op_setbp(); }
                    case (IDKVM_COMPILER_SYMTABLE) { this.op_symtable((byte*)0); }
                    case (IDKVM_COMPILER_SYMTABLE_FILTERED) { this.op_symtable(os); }
                    case (IDKVM_COMPILER_SYMTABLE_LOOKUP) { this.op_symlookup(); }
                    case (IDKVM_COMPILER_SYMTABLE_FUNCINFO) { this.op_funcinfo(); }
                    case (IDKVM_COMPILER_TARGET_GET) { this.op_target(os); }
                    case (IDKVM_COMPILER_IDKVM_TRACE_BEGIN)
                    {
                        this.trace_on = true;
                        this.trace_left = IDKVM_TRACE_LIMIT;
                    }
                    case (IDKVM_COMPILER_IDKVM_TRACE_END)
                    {
                        this.trace_on = false;
                        this.trace_left = 0;
                    }
                    case (IDKVM_EXTERN_DECL) { this.extern_add(os, oa, (int)ob, (i64*)idkvm_i2p(oc)); }

                    // Strings
                    case (IDKVM_STR_LEN) { this.str_op(op); }
                    case (IDKVM_STR_CAT) { this.str_op(op); }
                    case (IDKVM_STR_SLICE) { this.str_op(op); }
                    case (IDKVM_STR_EQ) { this.str_op(op); }
                    case (IDKVM_STR_FIND) { this.str_op(op); }
                    case (IDKVM_INT_TO_STR) { this.str_op(op); }
                    case (IDKVM_STR_TO_INT) { this.str_op(op); }

                    // Conversion
                    case (IDKVM_CAST)
                    {
                        this.pop_val();
                        at = this.pt;
                        ad = this.pd;
                        bd = this.pm;
                        switch (this.failed)
                        {
                            case (true) {}
                            default
                            {
                                switch (this.cast_f(oa, at, ad, bd))
                                {
                                    case (true) {}
                                    default
                                    {
                                        switch (oa == (i64)IDKVM_T_BOOL)
                                        {
                                            case (true) {
                                                switch (ad != (i64)0) { case (true) { this.push(IDKVM_T_BOOL, 1, 0); } default { this.push(IDKVM_T_BOOL, 0, 0); }; };
                                            }
                                            default
                                            {
                                                switch (os != (byte*)0 & oa == (i64)IDKVM_T_PTR)
                                                {
                                                    case (true) { bd = this.tn_intern(os); }
                                                    default {};
                                                };
                                                this.push(oa, ad, bd);
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    }

                    // Diagnostics
                    case (IDKVM_ASSERT)
                    {
                        this.pop_val();
                        bt = this.pt;
                        bd = this.pd;
                        this.pop_val();
                        switch (!this.failed & this.pd == (i64)0)
                        {
                            case (true) {
                                sp1 = this.str_of(bt, bd);
                                switch (sp1 == (byte*)0)
                                {
                                    case (true) { this.fail(g"comptime assertion failed\0"); }
                                    default { this.fail_name(g"comptime assertion failed: \0", sp1); };
                                };
                            }
                            default {};
                        };
                    }
                    case (IDKVM_WARN)
                    {
                        this.pop_val();
                        sp1 = this.str_of(this.pt, this.pd);
                        switch (!this.failed)
                        {
                            case (true) {
                                standard::io::console::print(g"comptime warning: \0");
                                switch (sp1 != (byte*)0)
                                {
                                    case (true) { standard::io::console::println(sp1); }
                                    default { standard::io::console::print(this.pd); standard::io::console::println(g"\0"); };
                                };
                            }
                            default {};
                        };
                    }
                    case (IDKVM_PANIC)
                    {
                        this.pop_val();
                        sp1 = this.str_of(this.pt, this.pd);
                        switch (!this.failed)
                        {
                            case (true) {
                                switch (sp1 == (byte*)0)
                                {
                                    case (true) { this.fail(g"comptime panic\0"); }
                                    default { this.fail_name(g"comptime panic: \0", sp1); };
                                };
                            }
                            default {};
                        };
                    }

                    // Boundary crossing
                    case (IDKVM_EMIT_CONST)
                    {
                        this.pop_val();
                        switch (!this.failed) { case (true) { this.emit_add(IDKVM_EMIT_K_CONST, this.pt, this.pd, this.pm, (byte*)0); } default {}; };
                    }
                    case (IDKVM_EMIT_TYPE)
                    {
                        this.pop_val();
                        switch (!this.failed) { case (true) { this.emit_add(IDKVM_EMIT_K_TYPE, this.pt, this.pd, this.pm, (byte*)0); } default {}; };
                    }
                    case (IDKVM_EMIT_GLOBAL)
                    {
                        this.pop_val();
                        ad = this.pd;
                        bt = this.pt;
                        bd = this.pm;
                        switch (this.failed)
                        {
                            case (true) {}
                            default
                            {
                                switch (oa < (i64)0 | !this.vheap.in_bounds(ad, oa))
                                {
                                    case (true) { this.fail(g"EMIT_GLOBAL: region out of bounds\0"); }
                                    default
                                    {
                                        sp1 = idkvm_dup(this.vheap.mem + (int)ad, oa);
                                        this.emit_add(IDKVM_EMIT_K_GLOBAL, bt, oa, bd, sp1);
                                    };
                                };
                            };
                        };
                    }
                    case (IDKVM_STRUCT_NEW) { this.op_struct_new(os); }
                    case (IDKVM_STRUCT_LOAD) { this.op_struct_load(os); }
                    case (IDKVM_STRUCT_STORE) { this.op_struct_store(os); }
                    case (IDKVM_ARRAY_NEW) { this.op_array_new(oa, os); }
                    case (IDKVM_ARRAY_LEN) { this.op_array_len(); }
                    case (IDKVM_ARRAY_LOAD) { this.op_array_load(); }
                    case (IDKVM_ARRAY_STORE) { this.op_array_store(); }
                    case (IDKVM_EMITIDEKA) { this.op_emitideka(os, (FvmVars*)idkvm_i2p(oc)); }
                    case (IDKVM_INLINE_ASM)
                    {
                        this.stub(g"INLINE_ASM (needs an own backend, never ported)\0");
                    }
                    default
                    {
                        // Everything else is not ported yet: counted by opcode name
                        this.stub(idkvm_op_name(op));
                    };
                };
                ->;
            };

            // bool(v.data): BYTES are truthy when they have content
            // ---- EMITIDEKA: ~$f"...", ~$i"...":{...} and ~$name expansion (VM._op_emitideka) ----

            // val_to_str of the expansion: bool as true/false, floats as repr, bytes as their
            // text, ulong unsigned, everything else as the decimal of its data
            ef_put_val(FvmBuf* o, int tag, i64 d, i64 m) -> void
            {
                u64 u;
                byte[24] tmp = noinit;
                int n;
                switch (tag)
                {
                    case (IDKVM_T_BOOL)
                    {
                        switch (d != (i64)0)
                        {
                            case (true) { o.put_str(g"true\0"); }
                            default { o.put_str(g"false\0"); };
                        };
                    }
                    case (IDKVM_T_FLOAT) { idkvm_put_double(o, idkvm_dv(tag, d, m)); }
                    case (IDKVM_T_DOUBLE) { idkvm_put_double(o, idkvm_dv(tag, d, m)); }
                    case (IDKVM_T_BYTES) { o.put_n(idkvm_i2p(d), (int)m); }
                    case (IDKVM_T_ULONG)
                    {
                        switch (d < (i64)0)
                        {
                            case (true) {
                                u = (u64)d;
                                while (u != (u64)0)
                                {
                                    tmp[n] = (byte)(48 + (int)(u % (u64)10));
                                    u = u / (u64)10;
                                    n++;
                                };
                                while (n > 0) { n--; o.put((int)tmp[n]); };
                            }
                            default { o.put_i64(d); };
                        };
                    }
                    default { o.put_i64(d); };
                };
                ->;
            };

            // The binding named nm[0..nl), -1 when there is none; the last of equal names wins
            ef_find(FvmVars* v, byte* nm, int nl) -> int
            {
                int i = v.n - 1;
                int k;
                bool same;
                while (i >= 0)
                {
                    same = idkvm_strlen(v.names[i]) == nl;
                    k = 0;
                    while (same & k < nl)
                    {
                        same = v.names[i][k] == nm[k];
                        k++;
                    };
                    switch (same) { case (true) { -> i; } default {}; };
                    i--;
                };
                -> -1;
            };

            // The value of binding bi in the current frame; an unset or missing local reads as int 0
            ef_get(FvmVars* v, int bi, int* tag, i64* d, i64* m) -> void
            {
                int fi = this.nframes - 1;
                int sl;
                *tag = IDKVM_T_INT;
                *d = 0;
                *m = 0;
                switch (bi >= 0)
                {
                    case (true) {
                        sl = v.slots[bi];
                        switch (fi >= 0 & sl >= 0)
                        {
                            case (true) {
                                switch (sl < this.fr_nloc[fi])
                                {
                                    case (true) {
                                        sl = this.fr_base[fi] + sl;
                                        switch (this.lc_set[sl] != 0)
                                        {
                                            case (true) {
                                                *tag = this.lc_tag[sl];
                                                *d = this.lc_data[sl];
                                                *m = this.lc_meta[sl];
                                            }
                                            default {};
                                        };
                                    }
                                    default {};
                                };
                            }
                            default {};
                        };
                    }
                    default {};
                };
                ->;
            };

            // subst.get(name, name)
            ef_subst(FvmBuf* o, FvmVars* v, byte* nm, int nl) -> void
            {
                int bi = this.ef_find(v, nm, nl);
                int t;
                i64 d, m;
                switch (bi >= 0)
                {
                    case (true) {
                        this.ef_get(v, bi, @t, @d, @m);
                        this.ef_put_val(o, t, d, m);
                    }
                    default { o.put_n(nm, nl); };
                };
                ->;
            };

            // One ~$i positional expression: name[idx], a bound name, or the text itself
            ef_expr(FvmBuf* o, FvmVars* v, byte* e, int n) -> void
            {
                int br = -1;
                int k = 0;
                int t, ai, ii, ds;
                i64 d, m, idx;
                i64* blk;
                bool ok2, digits, plain;
                while (k < n)
                {
                    switch (e[k] == '[' & br < 0) { case (true) { br = k; } default {}; };
                    k++;
                };
                switch (br >= 0 & e[n - 1] == ']')
                {
                    case (true) {
                        ds = br + 1;
                        // idx_name.lstrip('-').isdigit()
                        k = ds;
                        while (k < n - 1 & e[k] == '-') { k++; };
                        digits = k < n - 1;
                        while (k < n - 1) { digits = digits & e[k] >= '0' & e[k] <= '9'; k++; };
                        idx = 0;
                        switch (digits)
                        {
                            case (true) {
                                idx = idkvm_parse_int(e + ds, n - 1 - ds, @ok2);
                                switch (!ok2) { case (true) { idx = -1; } default {}; };
                            }
                            default {
                                ii = this.ef_find(v, e + ds, n - 1 - ds);
                                switch (ii >= 0)
                                {
                                    case (true) {
                                        this.ef_get(v, ii, @t, @d, @m);
                                        switch (t == IDKVM_T_FLOAT | t == IDKVM_T_DOUBLE)
                                        {
                                            case (true) { idx = (i64)idkvm_dv(t, d, m); }
                                            default { idx = d; };
                                        };
                                    }
                                    default {};
                                };
                            };
                        };
                        ai = this.ef_find(v, e, br);
                        this.ef_get(v, ai, @t, @d, @m);
                        switch (ai >= 0 & t == IDKVM_T_ARRAY)
                        {
                            case (true) {
                                blk = (i64*)idkvm_i2p(d);
                                switch (idx >= (i64)0 & idx < blk[0])
                                {
                                    case (true) {
                                        k = 2 + (int)idx * 3;
                                        this.ef_put_val(o, (int)blk[k], blk[k + 1], blk[k + 2]);
                                    }
                                    default { o.put(48); };
                                };
                            }
                            default { o.put(48); };
                        };
                        ->;
                    }
                    default {};
                };
                // all(alnum or '_') over a non-empty text
                plain = n > 0;
                k = 0;
                while (k < n)
                {
                    plain = plain & ((e[k] >= 'a' & e[k] <= 'z') | (e[k] >= 'A' & e[k] <= 'Z') | (e[k] >= '0' & e[k] <= '9') | e[k] == '_');
                    k++;
                };
                switch (plain)
                {
                    case (true) { this.ef_subst(o, v, e, n); }
                    default { o.put_n(e, n); };
                };
                ->;
            };

            // The slot-th expression of a ~$i list es[0..el): split on ';', stripped, empties dropped
            ef_nth(byte* es, int el, int slot, int* os, int* ol) -> bool
            {
                int k = 0;
                int st, en, cnt;
                while (k <= el)
                {
                    st = k;
                    while (k < el & es[k] != ';') { k++; };
                    en = k;
                    while (st < en & (es[st] == ' ' | es[st] == 9 | es[st] == 10 | es[st] == 13 | es[st] == 11 | es[st] == 12)) { st++; };
                    while (en > st & (es[en - 1] == ' ' | es[en - 1] == 9 | es[en - 1] == 10 | es[en - 1] == 13 | es[en - 1] == 11 | es[en - 1] == 12)) { en--; };
                    switch (en > st)
                    {
                        case (true) {
                            switch (cnt == slot)
                            {
                                case (true) { *os = st; *ol = en - st; -> true; }
                                default {};
                            };
                            cnt++;
                        }
                        default {};
                    };
                    k++;
                };
                -> false;
            };

            // EMITIDEKA: expands the codification tokens of the source text against the bound
            // locals of the current frame and records the result as IDEKA source for the compiler
            op_emitideka(byte* src, FvmVars* v) -> void
            {
                FvmBuf ob;
                FvmBuf* o = @ob;
                int n = idkvm_strlen(src);
                int i = 0;
                int j, bs, be, k, ns, nb, es, ee, slot, ps, pl, kind;
                byte c;
                bool tok, id, quoted;
                byte* body;
                ob.__init();
                defer ob.__exit();
                switch (!o.ok) { case (true) { this.fail(g"allocation failed\0"); ->; } default {}; };
                while (i < n)
                {
                    tok = false;
                    switch (src[i] == '~' & i + 1 < n & src[i + 1] == '$' & i + 2 < n)
                    {
                        case (true) {
                            kind = (int)src[i + 2];
                            quoted = (kind == 'f' | kind == 'i') & i + 3 < n & src[i + 3] == '"';
                            id = (kind >= 'a' & kind <= 'z') | (kind >= 'A' & kind <= 'Z') | kind == '_';
                            switch (quoted)
                            {
                                case (true) {
                                    j = i + 4;
                                    bs = j;
                                    be = -1;
                                    while (j < n & be < 0)
                                    {
                                        c = src[j];
                                        switch (c == 92) { case (true) { j = j + 2; } default {
                                            switch (c == '"') { case (true) { be = j; j++; } default { j++; }; };
                                        }; };
                                    };
                                    switch (be < 0) { case (true) { be = n; } default {}; };
                                    switch (j > n) { case (true) { j = n; } default {}; };
                                    nb = be - bs;
                                    body = src + bs;
                                    switch (kind == 'f')
                                    {
                                        case (true) {
                                            tok = true;
                                            k = 0;
                                            while (k < nb)
                                            {
                                                switch (body[k] == '{' & k + 1 < nb & body[k + 1] != '{')
                                                {
                                                    case (true) {
                                                        k++;
                                                        ns = k;
                                                        while (k < nb & body[k] != '}') { k++; };
                                                        this.ef_subst(o, v, body + ns, k - ns);
                                                        switch (k < nb) { case (true) { k++; } default {}; };
                                                    }
                                                    default {
                                                        switch (body[k] == '{' & k + 1 < nb & body[k + 1] == '{')
                                                        {
                                                            case (true) { o.put(123); k = k + 2; }
                                                            default { o.put((int)body[k]); k++; };
                                                        };
                                                    };
                                                };
                                            };
                                            i = j;
                                        }
                                        default {
                                            // ~$i: then ':' and '{' (whitespace allowed before each)
                                            k = j;
                                            while (k < n & (src[k] == ' ' | src[k] == 9 | src[k] == 10 | src[k] == 13)) { k++; };
                                            switch (k < n & src[k] == ':')
                                            {
                                                case (true) {
                                                    k++;
                                                    while (k < n & (src[k] == ' ' | src[k] == 9 | src[k] == 10 | src[k] == 13)) { k++; };
                                                    switch (k < n & src[k] == '{')
                                                    {
                                                        case (true) {
                                                            tok = true;
                                                            k++;
                                                            es = k;
                                                            while (k < n & src[k] != '}') { k++; };
                                                            ee = k;
                                                            switch (k < n) { case (true) { k++; } default {}; };
                                                            slot = 0;
                                                            ns = 0;
                                                            while (ns < nb)
                                                            {
                                                                switch (body[ns] == '{' & ns + 1 < nb & body[ns + 1] == '}')
                                                                {
                                                                    case (true) {
                                                                        switch (this.ef_nth(src + es, ee - es, slot, @ps, @pl))
                                                                        {
                                                                            case (true) {
                                                                                this.ef_expr(o, v, src + es + ps, pl);
                                                                                slot++;
                                                                            }
                                                                            default {};
                                                                        };
                                                                        ns = ns + 2;
                                                                    }
                                                                    default { o.put((int)body[ns]); ns++; };
                                                                };
                                                            };
                                                            i = k;
                                                        }
                                                        default {};
                                                    };
                                                }
                                                default {};
                                            };
                                        };
                                    };
                                }
                                default {
                                    switch (id)
                                    {
                                        case (true) {
                                            tok = true;
                                            j = i + 2;
                                            while (j < n & ((src[j] >= 'a' & src[j] <= 'z') | (src[j] >= 'A' & src[j] <= 'Z') | (src[j] >= '0' & src[j] <= '9') | src[j] == '_')) { j++; };
                                            this.ef_subst(o, v, src + i + 2, j - i - 2);
                                            i = j;
                                        }
                                        default {};
                                    };
                                };
                            };
                        }
                        default {};
                    };
                    switch (tok)
                    {
                        case (false) { o.put((int)src[i]); i++; }
                        default {};
                    };
                };
                switch (!o.ok) { case (true) { this.fail(g"allocation failed\0"); ->; } default {}; };
                this.emit_add(IDKVM_EMIT_K_IDEKA, IDKVM_T_BYTES, (i64)o.len, 0, idkvm_dup(o.mem, o.len));
                ->;
            };

            // CAST where a float is the source or the target; false when not a float cast
            cast_f(int target, int at, i64 ad, i64 am) -> bool
            {
                switch (target == IDKVM_T_FLOAT | target == IDKVM_T_DOUBLE)
                {
                    case (true) {
                        switch (target == IDKVM_T_FLOAT)
                        {
                            case (true) { this.push(target, idkvm_dbl_bits(idkvm_f32_dbl(idkvm_dbl_f32(idkvm_dv(at, ad, am)))), 0); }
                            default { this.push(target, idkvm_dbl_bits(idkvm_dv(at, ad, am)), 0); };
                        };
                        -> true;
                    }
                    default {};
                };
                switch (!idkvm_isf(at, am))
                {
                    case (true) { -> false; }
                    default {};
                };
                switch (target == IDKVM_T_BOOL)
                {
                    case (true) {
                        switch (idkvm_bits_dbl(ad) != (double)0.0) { case (true) { this.push(IDKVM_T_BOOL, 1, 0); } default { this.push(IDKVM_T_BOOL, 0, 0); }; };
                        -> true;
                    }
                    default {};
                };
                switch (idkvm_is_intlike(target))
                {
                    case (true) {
                        this.push(target, idkvm_trunc(idkvm_bits_dbl(ad)), 0);
                        -> true;
                    }
                    default {};
                };
                -> false;
            };

            truthy(int tag, i64 d, i64 m) -> bool
            {
                switch (idkvm_isf(tag, m))
                {
                    case (true) { -> idkvm_bits_dbl(d) != (double)0.0; }
                    default {};
                };
                switch (tag == IDKVM_T_BYTES)
                {
                    case (true) { -> m > (i64)0; }
                    default { -> d != (i64)0; };
                };
            };

            grow_handlers() -> void
            {
                int nc = this.hcap * 2;
                int* n1 = (int*)idkvm_grow((byte*)this.h_frame, nc * 4);
                int* n2 = (int*)idkvm_grow((byte*)this.h_catch, nc * 4);
                int* n3 = (int*)idkvm_grow((byte*)this.h_depth, nc * 4);
                switch (n1 == (int*)0 | n2 == (int*)0 | n3 == (int*)0)
                {
                    case (true) {
                        this.fail(g"handler stack allocation failed\0");
                        ->;
                    }
                    default {};
                };
                this.h_frame = n1;
                this.h_catch = n2;
                this.h_depth = n3;
                this.hcap = nc;
                ->;
            };

            // ===== .IDKVM SOURCE PARSER (parse_idkvm_source) =====

            // Failure of the parse, reported as "line N: msg extra"
            parse_fail(int lineno, byte* msg, byte* extra) -> void
            {
                switch (!this.failed)
                {
                    case (true) {
                        this.errb.clear();
                        this.errb.put_str(g"line \0");
                        this.errb.put_int(lineno);
                        this.errb.put_str(g": \0");
                        this.errb.put_str(msg);
                        switch (extra != (byte*)0) { case (true) { this.errb.put_str(extra); } default {}; };
                        this.failed = true;
                        this.parse_line = lineno;
                    }
                    default {};
                };
                ->;
            };

            // Failure naming token k of the line in single quotes
            parse_fail_tok(int lineno, byte* msg, byte* ln, int k) -> void
            {
                byte* t = idkvm_dup(ln + this.tk_s[k], this.tk_e[k] - this.tk_s[k]);
                switch (t == (byte*)0)
                {
                    case (true) { this.parse_fail(lineno, msg, (byte*)0); }
                    default
                    {
                        this.tmp.clear();
                        this.tmp.put(39);
                        this.tmp.put_str(t);
                        this.tmp.put(39);
                        this.parse_fail(lineno, msg, this.tmp.mem);
                        ffree(t);
                    };
                };
                ->;
            };

            tk_add(int s, int e) -> void
            {
                int nc;
                int* n1, n2;
                switch (this.tk_n >= this.tk_cap)
                {
                    case (true) {
                        nc = this.tk_cap * 2;
                        switch (nc < 16) { case (true) { nc = 16; } default {}; };
                        n1 = (int*)idkvm_grow((byte*)this.tk_s, nc * 4);
                        n2 = (int*)idkvm_grow((byte*)this.tk_e, nc * 4);
                        switch (n1 == (int*)0 | n2 == (int*)0)
                        {
                            case (true) {
                                this.fail(g"token buffer allocation failed\0");
                                ->;
                            }
                            default {};
                        };
                        this.tk_s = n1;
                        this.tk_e = n2;
                        this.tk_cap = nc;
                    }
                    default {};
                };
                this.tk_s[this.tk_n] = s;
                this.tk_e[this.tk_n] = e;
                this.tk_n++;
                ->;
            };

            // _idkvm_split: bare words and quoted sections, a quote ends its token
            tokenize(byte* ln, int n) -> void
            {
                int i = 0;
                int j;
                bool inq;
                this.tk_n = 0;
                while (i < n)
                {
                    switch (idkvm_is_space((int)ln[i]))
                    {
                        case (true) { i++; }
                        default
                        {
                            j = i;
                            while (j < n & !idkvm_is_space((int)ln[j]) & ln[j] != '"') { j++; };
                            switch (j < n & ln[j] == '"')
                            {
                                case (true) {
                                    j++;
                                    inq = true;
                                    while (j < n & inq)
                                    {
                                        switch (ln[j] == '\\')
                                        {
                                            case (true) { j = j + 2; }
                                            default
                                            {
                                                switch (ln[j] == '"')
                                                {
                                                    case (true) {
                                                        j++;
                                                        inq = false;
                                                    }
                                                    default { j++; };
                                                };
                                            };
                                        };
                                    };
                                    switch (j > n) { case (true) { j = n; } default {}; };
                                    this.tk_add(i, j);
                                }
                                default
                                {
                                    switch (j > i) { case (true) { this.tk_add(i, j); } default {}; };
                                };
                            };
                            i = j;
                        };
                    };
                };
                ->;
            };

            // TTag index of the lowercase name s[0, n), or -1
            ttag_index(byte* s, int n) -> int
            {
                int t = 0;
                while (t < IDKVM_T_COUNT)
                {
                    switch (idkvm_eq_ci(s, n, idkvm_ttag_name(t))) { case (true) { -> t; } default {}; };
                    t++;
                };
                -> -1;
            };

            // _idkvm_unescape: \n \r \t \0 \\ \" and everything else literally. Result is null terminated.
            unescape(byte* s, int n, int* outlen) -> byte*
            {
                byte* r = idkvm_alloc(n + 1);
                int i = 0;
                int o = 0;
                byte c;
                switch (r == (byte*)0)
                {
                    case (true) { -> r; }
                    default {};
                };
                while (i < n)
                {
                    c = s[i];
                    switch (c == '\\' & i + 1 < n)
                    {
                        case (true) {
                            switch (s[i + 1])
                            {
                                case (110) { r[o] = 10; i = i + 2; }
                                case (114) { r[o] = 13; i = i + 2; }
                                case (116) { r[o] = 9; i = i + 2; }
                                case (48) { r[o] = 0; i = i + 2; }
                                case (92) { r[o] = 92; i = i + 2; }
                                case (34) { r[o] = 34; i = i + 2; }
                                default { r[o] = c; i++; };
                            };
                        }
                        default
                        {
                            r[o] = c;
                            i++;
                        };
                    };
                    o++;
                };
                *outlen = o;
                -> r;
            };

            // EMITIDEKA source text: the escapes of Python's unicode_escape that the serialiser produces
            unescape_text(byte* s, int n) -> byte*
            {
                byte* r = idkvm_alloc(n + 1);
                int i = 0;
                int o = 0;
                switch (r == (byte*)0)
                {
                    case (true) { -> r; }
                    default {};
                };
                while (i < n)
                {
                    switch (s[i] == '\\' & i + 1 < n)
                    {
                        case (true) {
                            switch (s[i + 1])
                            {
                                case (110) { r[o] = 10; i = i + 2; }
                                case (114) { r[o] = 13; i = i + 2; }
                                case (116) { r[o] = 9; i = i + 2; }
                                case (48) { r[o] = 0; i = i + 2; }
                                case (92) { r[o] = 92; i = i + 2; }
                                case (34) { r[o] = 34; i = i + 2; }
                                case (39) { r[o] = 39; i = i + 2; }
                                default
                                {
                                    r[o] = s[i];
                                    i++;
                                };
                            };
                        }
                        default
                        {
                            r[o] = s[i];
                            i++;
                        };
                    };
                    o++;
                };
                -> r;
            };

            // _parse_idkvm_val on s[0, n). Result in this.pt, this.pd, this.pm.
            // Returns an error text, or 0 on success.
            parse_val(byte* s, int n) -> byte*
            {
                int i, c, qpos, bpos, rawn, rn, ulen, tg, ms, me, is_, ie, k;
                byte* rest, ub;
                bool ok2, quoted;
                i64 v;
                this.pt = IDKVM_T_INT;
                this.pd = 0;
                this.pm = 0;
                switch (n >= 2 & s[0] == '"' & s[n - 1] == '"')
                {
                    case (true) {
                        ub = this.unescape(s + 1, n - 2, @ulen);
                        switch (ub == (byte*)0) { case (true) { -> g"allocation failed\0"; } default {}; };
                        this.pt = IDKVM_T_BYTES;
                        this.pd = idkvm_p2i(ub);
                        this.pm = (i64)ulen;
                        -> (byte*)0;
                    }
                    default {};
                };
                c = -1;
                i = 0;
                while (i < n & c < 0)
                {
                    switch (s[i] == ':') { case (true) { c = i; } default {}; };
                    i++;
                };
                switch (c < 0)
                {
                    case (true) { -> g"cannot parse value token (expected type:value)\0"; }
                    default {};
                };
                rest = s + c + 1;
                rn = c;
                rn = n - c - 1;
                qpos = -1;
                bpos = -1;
                i = 0;
                while (i < rn)
                {
                    switch (rest[i] == '"' & qpos < 0) { case (true) { qpos = i; } default {}; };
                    switch (rest[i] == '[' & bpos < 0) { case (true) { bpos = i; } default {}; };
                    i++;
                };
                rawn = rn;
                switch (bpos >= 0 & (qpos < 0 | bpos < qpos))
                {
                    case (true) {
                        rawn = bpos;
                        // items of the bracket, split on ','; only stack_slot is carried
                        ms = bpos + 1;
                        me = rn;
                        while (me > ms & rest[me - 1] == ']') { me--; };
                        is_ = ms;
                        while (is_ <= me)
                        {
                            ie = is_;
                            while (ie < me & rest[ie] != ',') { ie++; };
                            k = ie - is_;
                            switch (k > 0)
                            {
                                case (true) {
                                    switch (idkvm_eq_ci(rest + is_, k, g"stack_slot\0"))
                                    {
                                        case (true) { this.pm = (i64)IDKVM_META_STACK_SLOT; }
                                        default { this.stub_note(g".ivm PTR meta (struct_type, field offsets, elements)\0"); };
                                    };
                                }
                                default {};
                            };
                            is_ = ie + 1;
                        };
                    }
                    default {};
                };
                quoted = rawn >= 2 & rest[0] == '"' & rest[rawn - 1] == '"';
                switch (idkvm_eq_ci(s, c, g"bytes\0"))
                {
                    case (true) {
                        switch (quoted)
                        {
                            case (true) { ub = this.unescape(rest + 1, rawn - 2, @ulen); }
                            default
                            {
                                ub = idkvm_dup(rest, rawn);
                                ulen = rawn;
                            };
                        };
                        switch (ub == (byte*)0) { case (true) { -> g"allocation failed\0"; } default {}; };
                        this.pt = IDKVM_T_BYTES;
                        this.pd = idkvm_p2i(ub);
                        this.pm = (i64)ulen;
                        -> (byte*)0;
                    }
                    default {};
                };
                tg = this.ttag_index(s, c);
                switch (tg < 0 | tg == IDKVM_T_DATA | tg == IDKVM_T_STRUCT | tg == IDKVM_T_ENUM | tg == IDKVM_T_ARRAY | tg == IDKVM_T_FFI_LIB | tg == IDKVM_T_FFI_SYM | tg == IDKVM_T_FILE | tg == IDKVM_T_BYTES)
                {
                    case (true) { -> g"unknown type tag\0"; }
                    default {};
                };
                this.pt = tg;
                switch (tg == IDKVM_T_FLOAT | tg == IDKVM_T_DOUBLE)
                {
                    case (true) {
                        this.pd = idkvm_dbl_bits(idkvm_parse_double(rest, rawn, @ok2));
                        switch (!ok2) { case (true) { -> g"invalid float value\0"; } default {}; };
                        -> (byte*)0;
                    }
                    default {};
                };
                switch (tg == IDKVM_T_VOID)
                {
                    case (true) {
                        this.pd = 0;
                        this.pm = 0;
                        -> (byte*)0;
                    }
                    default {};
                };
                switch (tg == IDKVM_T_BOOL)
                {
                    case (true) {
                        switch (idkvm_eq_ci(rest, rawn, g"true\0") | idkvm_eq_ci(rest, rawn, g"1\0"))
                        {
                            case (true) { this.pd = 1; -> (byte*)0; }
                            default {};
                        };
                        switch (idkvm_eq_ci(rest, rawn, g"false\0") | idkvm_eq_ci(rest, rawn, g"0\0"))
                        {
                            case (true) { this.pd = 0; -> (byte*)0; }
                            default {};
                        };
                        -> g"invalid bool value\0";
                    }
                    default {};
                };
                v = idkvm_parse_int(rest, rawn, @ok2);
                switch (!ok2) { case (true) { -> g"invalid integer value\0"; } default {}; };
                this.pd = v;
                -> (byte*)0;
            };

            // True for opcodes whose operand list is empty in _parse_operands
            is_zero_op(int op) -> bool
            {
                switch (op >= IDKVM_POP & op <= IDKVM_BNOT) { case (true) { -> true; } default {}; };
                switch (op >= IDKVM_SHL & op <= IDKVM_SHR) { case (true) { -> true; } default {}; };
                switch (op >= IDKVM_CMP_EQ & op <= IDKVM_NOT) { case (true) { -> true; } default {}; };
                switch (op == IDKVM_POPCOUNT | op == IDKVM_RET | op == IDKVM_HALT | op == IDKVM_THROW | op == IDKVM_TRY_END) { case (true) { -> true; } default {}; };
                switch (op == IDKVM_LOCAL_DEREF | op == IDKVM_LOCAL_DEREF_SET | op == IDKVM_ALLOC | op == IDKVM_FREE | op == IDKVM_OFFSET) { case (true) { -> true; } default {}; };
                switch (op == IDKVM_ENUM_LOAD | op == IDKVM_ENUM_STORE | op == IDKVM_TYPEOF | op == IDKVM_FFI_FREE) { case (true) { -> true; } default {}; };
                switch (op >= IDKVM_ARRAY_LEN & op <= IDKVM_ARRAY_STORE) { case (true) { -> true; } default {}; };
                switch (op >= IDKVM_IO_OPEN & op <= IDKVM_IO_CLOSE) { case (true) { -> true; } default {}; };
                switch (op >= IDKVM_COMPILER_PRINT & op <= IDKVM_COMPILER_FPM_PACKAGE) { case (true) { -> true; } default {}; };
                switch (op >= IDKVM_STR_LEN & op <= IDKVM_STR_TO_INT) { case (true) { -> true; } default {}; };
                switch (op >= IDKVM_ASSERT & op <= IDKVM_EMIT_CONST) { case (true) { -> true; } default {}; };
                switch (op == IDKVM_EMIT_TYPE | op == IDKVM_COMPILER_IDKVM_BINDUMP) { case (true) { -> true; } default {}; };
                -> false;
            };

            // Integer operand token k, false (and a parse failure) when it is not an integer
            tok_int(byte* ln, int k, int lineno, i64* out) -> bool
            {
                bool ok2;
                i64 v = idkvm_parse_int(ln + this.tk_s[k], this.tk_e[k] - this.tk_s[k], @ok2);
                switch (!ok2)
                {
                    case (true) {
                        this.parse_fail_tok(lineno, g"invalid integer operand \0", ln, k);
                        -> false;
                    }
                    default {};
                };
                *out = v;
                -> true;
            };

            // Bare TTag name operand token k
            tok_ttag(byte* ln, int k, int lineno, int* out) -> bool
            {
                int t = this.ttag_index(ln + this.tk_s[k], this.tk_e[k] - this.tk_s[k]);
                switch (t < 0)
                {
                    case (true) {
                        this.parse_fail_tok(lineno, g"unknown TTag \0", ln, k);
                        -> false;
                    }
                    default {};
                };
                *out = t;
                -> true;
            };

            // Token k copied out as a persistent null terminated string
            tok_str(byte* ln, int k) -> byte*
            {
                -> idkvm_dup(ln + this.tk_s[k], this.tk_e[k] - this.tk_s[k]);
            };

            // _parse_operands: parses the operands of the instruction on this line
            // (tokens 1..) and appends it to unit target
            parse_operands(int op, byte* ln, int lineno) -> bool
            {
                int rc = this.tk_n - 1;
                int t, k, cnt;
                i64 a, b;
                byte* em, s1;
                FvmVars* evars;
                bool ok3;
                int np, pt1;
                i64* ptg;
                byte* ub;
                i64* tbl;
                bool pf;
                switch (this.is_zero_op(op))
                {
                    case (true) {
                        this.code.add(op, 0, 0, 0, (byte*)0, 0);
                        -> true;
                    }
                    default {};
                };
                switch (op)
                {
                    case (IDKVM_PUSH)
                    {
                        switch (rc < 1)
                        {
                            case (true) {
                                this.parse_fail(lineno, g"PUSH requires a value operand\0", (byte*)0);
                                -> false;
                            }
                            default {};
                        };
                        // 'ptr:N struct_type=...' fuses into 'ptr:N[struct_type=...]'
                        pf = idkvm_eq_n(ln + this.tk_s[1], 4, g"ptr:\0") & rc > 1;
                        switch (pf)
                        {
                            case (true) {
                                pf = true;
                                k = this.tk_s[1];
                                while (k < this.tk_e[1])
                                {
                                    switch (ln[k] == '[') { case (true) { pf = false; } default {}; };
                                    k++;
                                };
                            }
                            default {};
                        };
                        switch (pf)
                        {
                            case (true) {
                                this.tmp.clear();
                                this.tmp.put_n(ln + this.tk_s[1], this.tk_e[1] - this.tk_s[1]);
                                this.tmp.put(91);
                                t = 2;
                                while (t < this.tk_n)
                                {
                                    switch (t > 2) { case (true) { this.tmp.put(44); } default {}; };
                                    this.tmp.put_n(ln + this.tk_s[t], this.tk_e[t] - this.tk_s[t]);
                                    t++;
                                };
                                switch (this.tmp.mem[this.tmp.len - 1] != ']') { case (true) { this.tmp.put(93); } default {}; };
                                em = this.parse_val(this.tmp.mem, this.tmp.len);
                            }
                            default { em = this.parse_val(ln + this.tk_s[1], this.tk_e[1] - this.tk_s[1]); };
                        };
                        switch (em != (byte*)0)
                        {
                            case (true) {
                                this.parse_fail(lineno, em, (byte*)0);
                                -> false;
                            }
                            default {};
                        };
                        this.code.add(op, (i64)this.pt, this.pd, this.pm, (byte*)0, 0);
                        -> true;
                    }
                    case (IDKVM_CALL_PTR)
                    {
                        switch (rc < 1)
                        {
                            case (true) {
                                this.parse_fail(lineno, g"CALL_PTR requires an argc operand\0", (byte*)0);
                                -> false;
                            }
                            default {};
                        };
                        switch (!this.tok_int(ln, 1, lineno, @a)) { case (true) { -> false; } default {}; };
                        this.code.add(op, a, 0, 0, (byte*)0, 0);
                        -> true;
                    }
                    default {};
                };
                // Single integer operand (jumps, locals, widths)
                switch (op == IDKVM_JMP | op == IDKVM_JIF | op == IDKVM_JNF | op == IDKVM_LOCAL_GET | op == IDKVM_LOCAL_SET | op == IDKVM_TAIL_SELF | op == IDKVM_EMIT_GLOBAL | op == IDKVM_TRY_BEGIN | op == IDKVM_ROTL | op == IDKVM_ROTR | op == IDKVM_BITREV | op == IDKVM_CLZ | op == IDKVM_CTZ)
                {
                    case (true) {
                        switch (rc < 1)
                        {
                            case (true) {
                                this.parse_fail(lineno, g"missing integer operand for \0", idkvm_op_name(op));
                                -> false;
                            }
                            default {};
                        };
                        switch (!this.tok_int(ln, 1, lineno, @a)) { case (true) { -> false; } default {}; };
                        this.code.add(op, a, 0, 0, (byte*)0, 0);
                        -> true;
                    }
                    default {};
                };
                // Single name operand (type names and globals)
                switch (op == IDKVM_SIZEOF | op == IDKVM_ALIGNOF | op == IDKVM_ENDIANOF | op == IDKVM_STRUCT_NEW | op == IDKVM_STRUCT_LOAD | op == IDKVM_STRUCT_STORE | op == IDKVM_ENUM_NEW | op == IDKVM_GLOBAL_GET | op == IDKVM_GLOBAL_SET | op == IDKVM_FFI_SYM | op == IDKVM_COMPILER_SYMTABLE_FILTERED | op == IDKVM_COMPILER_TARGET_GET)
                {
                    case (true) {
                        switch (rc < 1)
                        {
                            case (true) {
                                this.parse_fail(lineno, g"missing name operand for \0", idkvm_op_name(op));
                                -> false;
                            }
                            default {};
                        };
                        s1 = this.tok_str(ln, 1);
                        switch (s1 == (byte*)0) { case (true) { this.fail(g"allocation failed\0"); -> false; } default {}; };
                        this.code.add(op, 0, 0, 0, s1, 0);
                        -> true;
                    }
                    default {};
                };
                switch (op)
                {
                    case (IDKVM_EXTERN_DECL)
                    {
                        switch (rc < 2)
                        {
                            case (true) {
                                this.parse_fail(lineno, g"EXTERN_DECL requires name and ret_tag\0", (byte*)0);
                                -> false;
                            }
                            default {};
                        };
                        t = this.ttag_index(ln + this.tk_s[2], this.tk_e[2] - this.tk_s[2]);
                        switch (t < 0) { case (true) { t = IDKVM_T_VOID; } default {}; };
                        s1 = this.tok_str(ln, 1);
                        switch (s1 == (byte*)0) { case (true) { this.fail(g"allocation failed\0"); -> false; } default {}; };
                        np = rc - 2;
                        switch (np < 0) { case (true) { np = 0; } default {}; };
                        ptg = (i64*)idkvm_alloc((np + 1) * 8);
                        switch (ptg == (i64*)0) { case (true) { this.fail(g"allocation failed\0"); -> false; } default {}; };
                        k = 0;
                        while (k < np)
                        {
                            pt1 = this.ttag_index(ln + this.tk_s[3 + k], this.tk_e[3 + k] - this.tk_s[3 + k]);
                            switch (pt1 < 0) { case (true) { pt1 = IDKVM_T_VOID; } default {}; };
                            ptg[k] = pt1;
                            k++;
                        };
                        this.code.add(op, (i64)t, (i64)np, idkvm_p2i((byte*)ptg), s1, 0);
                        -> true;
                    }
                    case (IDKVM_ARRAY_NEW)
                    {
                        switch (rc < 2)
                        {
                            case (true) {
                                this.parse_fail(lineno, g"ARRAY_NEW requires type_name and count\0", (byte*)0);
                                -> false;
                            }
                            default {};
                        };
                        switch (!this.tok_int(ln, 2, lineno, @a)) { case (true) { -> false; } default {}; };
                        s1 = this.tok_str(ln, 1);
                        switch (s1 == (byte*)0) { case (true) { this.fail(g"allocation failed\0"); -> false; } default {}; };
                        this.code.add(op, a, 0, 0, s1, 0);
                        -> true;
                    }
                    case (IDKVM_LOAD)
                    {
                        switch (rc < 2)
                        {
                            case (true) {
                                this.parse_fail(lineno, g"LOAD requires ttag and byte_size\0", (byte*)0);
                                -> false;
                            }
                            default {};
                        };
                        switch (!this.tok_ttag(ln, 1, lineno, @t)) { case (true) { -> false; } default {}; };
                        switch (!this.tok_int(ln, 2, lineno, @b)) { case (true) { -> false; } default {}; };
                        this.code.add(op, (i64)t, b, 0, (byte*)0, 0);
                        -> true;
                    }
                    case (IDKVM_STORE)
                    {
                        switch (rc < 2)
                        {
                            case (true) {
                                this.parse_fail(lineno, g"STORE requires ttag and byte_size\0", (byte*)0);
                                -> false;
                            }
                            default {};
                        };
                        switch (!this.tok_ttag(ln, 1, lineno, @t)) { case (true) { -> false; } default {}; };
                        switch (!this.tok_int(ln, 2, lineno, @b)) { case (true) { -> false; } default {}; };
                        this.code.add(op, (i64)t, b, 0, (byte*)0, 0);
                        -> true;
                    }
                    case (IDKVM_CAST)
                    {
                        switch (rc < 1)
                        {
                            case (true) {
                                this.parse_fail(lineno, g"CAST requires a type tag operand\0", (byte*)0);
                                -> false;
                            }
                            default {};
                        };
                        switch (!this.tok_ttag(ln, 1, lineno, @t)) { case (true) { -> false; } default {}; };
                        s1 = (byte*)0;
                        switch (rc > 1) { case (true) { s1 = this.tok_str(ln, 2); } default {}; };
                        this.code.add(op, (i64)t, 0, 0, s1, 0);
                        -> true;
                    }
                    case (IDKVM_BITCAST)
                    {
                        switch (rc < 1)
                        {
                            case (true) {
                                this.parse_fail(lineno, g"BITCAST requires a type tag operand\0", (byte*)0);
                                -> false;
                            }
                            default {};
                        };
                        switch (!this.tok_ttag(ln, 1, lineno, @t)) { case (true) { -> false; } default {}; };
                        s1 = (byte*)0;
                        switch (rc > 1) { case (true) { s1 = this.tok_str(ln, 2); } default {}; };
                        this.code.add(op, (i64)t, 0, 0, s1, 0);
                        -> true;
                    }
                    case (IDKVM_CALL)
                    {
                        switch (rc < 2)
                        {
                            case (true) {
                                this.parse_fail(lineno, g"CALL requires name and argc\0", (byte*)0);
                                -> false;
                            }
                            default {};
                        };
                        switch (!this.tok_int(ln, 2, lineno, @a)) { case (true) { -> false; } default {}; };
                        s1 = this.tok_str(ln, 1);
                        switch (s1 == (byte*)0) { case (true) { this.fail(g"allocation failed\0"); -> false; } default {}; };
                        this.code.add(op, a, 0, 0, s1, 0);
                        -> true;
                    }
                    case (IDKVM_FFI_LOAD)
                    {
                        switch (rc < 1)
                        {
                            case (true) {
                                this.parse_fail(lineno, g"FFI_LOAD requires a library path\0", (byte*)0);
                                -> false;
                            }
                            default {};
                        };
                        s1 = this.tok_str(ln, 1);
                        switch (s1 == (byte*)0) { case (true) { this.fail(g"allocation failed\0"); -> false; } default {}; };
                        this.code.add(op, 0, 0, 0, s1, 0);
                        -> true;
                    }
                    case (IDKVM_FFI_CALL)
                    {
                        switch (rc < 2)
                        {
                            case (true) {
                                this.parse_fail(lineno, g"FFI_CALL requires argc and ret_type_tag\0", (byte*)0);
                                -> false;
                            }
                            default {};
                        };
                        switch (!this.tok_int(ln, 1, lineno, @a)) { case (true) { -> false; } default {}; };
                        switch (!this.tok_ttag(ln, 2, lineno, @t)) { case (true) { -> false; } default {}; };
                        this.code.add(op, a, (i64)t, 0, (byte*)0, 0);
                        -> true;
                    }
                    case (IDKVM_JTABLE)
                    {
                        switch (rc < 1)
                        {
                            case (true) {
                                this.parse_fail(lineno, g"JTABLE requires at least a default address\0", (byte*)0);
                                -> false;
                            }
                            default {};
                        };
                        switch (!this.tok_int(ln, 1, lineno, @a)) { case (true) { -> false; } default {}; };
                        cnt = rc - 1;
                        tbl = (i64*)idkvm_alloc((cnt + 1) * 8);
                        switch (tbl == (i64*)0) { case (true) { this.fail(g"allocation failed\0"); -> false; } default {}; };
                        k = 0;
                        while (k < cnt)
                        {
                            switch (!this.tok_int(ln, k + 2, lineno, @b)) { case (true) { -> false; } default {}; };
                            tbl[k] = b;
                            k++;
                        };
                        this.code.add(op, a, (i64)cnt, 0, (byte*)tbl, 0);
                        -> true;
                    }
                    case (IDKVM_EMITIDEKA)
                    {
                        switch (rc < 1)
                        {
                            case (true) {
                                this.parse_fail(lineno, g"EMITIDEKA requires a source text operand\0", (byte*)0);
                                -> false;
                            }
                            default {};
                        };
                        // strip('"') of the token, then the escapes
                        a = (i64)this.tk_s[1];
                        b = (i64)this.tk_e[1];
                        while (a < b & ln[(int)a] == '"') { a = a + (i64)1; };
                        while (b > a & ln[(int)b - 1] == '"') { b = b - (i64)1; };
                        ub = this.unescape_text(ln + (int)a, (int)(b - a));
                        switch (ub == (byte*)0) { case (true) { this.fail(g"allocation failed\0"); -> false; } default {}; };
                        // name:slot bindings: the tokens that hold a ':', split at the first one
                        cnt = 0;
                        k = 2;
                        while (k < this.tk_n)
                        {
                            a = (i64)this.tk_s[k];
                            while (a < (i64)this.tk_e[k] & ln[(int)a] != ':') { a = a + (i64)1; };
                            switch (a < (i64)this.tk_e[k]) { case (true) { cnt++; } default {}; };
                            k++;
                        };
                        evars = idkvm_vars_new(cnt);
                        switch (evars == (FvmVars*)0) { case (true) { this.fail(g"allocation failed\0"); -> false; } default {}; };
                        cnt = 0;
                        k = 2;
                        while (k < this.tk_n)
                        {
                            a = (i64)this.tk_s[k];
                            while (a < (i64)this.tk_e[k] & ln[(int)a] != ':') { a = a + (i64)1; };
                            switch (a < (i64)this.tk_e[k])
                            {
                                case (true) {
                                    evars.names[cnt] = idkvm_dup(ln + this.tk_s[k], (int)a - this.tk_s[k]);
                                    b = idkvm_parse_int(ln + (int)a + 1, this.tk_e[k] - (int)a - 1, @ok3);
                                    switch (!ok3)
                                    {
                                        case (true) {
                                            this.parse_fail_tok(lineno, g"invalid integer operand \0", ln, k);
                                            -> false;
                                        }
                                        default {};
                                    };
                                    evars.slots[cnt] = (int)b;
                                    cnt++;
                                }
                                default {};
                            };
                            k++;
                        };
                        this.code.add(op, (i64)cnt, 0, idkvm_p2i((byte*)evars), ub, 0);
                        -> true;
                    }
                    case (IDKVM_INLINE_ASM)
                    {
                        switch (rc < 4)
                        {
                            case (true) {
                                this.parse_fail(lineno, g"INLINE_ASM requires body, constraints, n_inputs, n_outputs\0", (byte*)0);
                                -> false;
                            }
                            default {};
                        };
                        this.code.add(op, 0, 0, 0, (byte*)0, 0);
                        -> true;
                    }
                    default {};
                };
                this.parse_fail(lineno, g"unhandled operand encoding for \0", idkvm_op_name(op));
                -> false;
            };

            // One non-empty line of a .ivm file. Pass 0 builds struct layouts and function
            // units, pass 1 builds the main block, so the main instructions stay contiguous
            // even when func blocks sit between them.
            parse_one(byte* ln, int lineno) -> void
            {
                int n0 = this.tk_e[0] - this.tk_s[0];
                byte* t0 = ln + this.tk_s[0];
                int op = -1;
                int i, tg, sz, bits;
                i64 a, b, c, d;
                byte* nm, en;
                bool emit_here;
                switch (idkvm_eq_ci(t0, n0, g"locals\0"))
                {
                    case (true) {
                        switch (this.tk_n != 2)
                        {
                            case (true) {
                                this.parse_fail(lineno, g"'locals' requires exactly one argument\0", (byte*)0);
                                ->;
                            }
                            default {};
                        };
                        switch (!this.p_in_func & this.p_pass == 1)
                        {
                            case (true) {
                                switch (this.tok_int(ln, 1, lineno, @a)) { case (true) { this.main_locals = (int)a; } default {}; };
                            }
                            default {};
                        };
                        ->;
                    }
                    default {};
                };
                switch (idkvm_eq_ci(t0, n0, g"struct\0"))
                {
                    case (true) {
                        switch (this.p_in_struct)
                        {
                            case (true) {
                                this.parse_fail(lineno, g"nested 'struct' is not allowed\0", (byte*)0);
                                ->;
                            }
                            default {};
                        };
                        switch (this.tk_n < 2)
                        {
                            case (true) {
                                this.parse_fail(lineno, g"'struct' requires a name\0", (byte*)0);
                                ->;
                            }
                            default {};
                        };
                        this.p_in_struct = true;
                        switch (this.p_pass == 0)
                        {
                            case (true) {
                                nm = this.tok_str(ln, 1);
                                en = g"little\0";
                                sz = 0;
                                bits = 0;
                                switch (this.tk_n > 2) { case (true) { en = this.tok_str(ln, 2); } default {}; };
                                switch (this.tk_n > 3)
                                {
                                    case (true) {
                                        switch (!this.tok_int(ln, 3, lineno, @a)) { case (true) { ->; } default {}; };
                                        sz = (int)a;
                                    }
                                    default {};
                                };
                                switch (this.tk_n > 4)
                                {
                                    case (true) {
                                        switch (!this.tok_int(ln, 4, lineno, @b)) { case (true) { ->; } default {}; };
                                        bits = (int)b;
                                    }
                                    default {};
                                };
                                switch (nm == (byte*)0 | en == (byte*)0 | !this.layouts.add_struct(nm, en, sz, bits))
                                {
                                    case (true) { this.fail(g"struct layout allocation failed\0"); }
                                    default {};
                                };
                            }
                            default {};
                        };
                        ->;
                    }
                    default {};
                };
                switch (idkvm_eq_ci(t0, n0, g"field\0"))
                {
                    case (true) {
                        switch (!this.p_in_struct)
                        {
                            case (true) {
                                this.parse_fail(lineno, g"'field' outside 'struct' block\0", (byte*)0);
                                ->;
                            }
                            default {};
                        };
                        switch (this.tk_n < 5)
                        {
                            case (true) {
                                this.parse_fail(lineno, g"'field' requires fname ttag byte_offset byte_size\0", (byte*)0);
                                ->;
                            }
                            default {};
                        };
                        switch (this.p_pass == 0)
                        {
                            case (true) {
                                switch (!this.tok_ttag(ln, 2, lineno, @tg)) { case (true) { ->; } default {}; };
                                switch (!this.tok_int(ln, 3, lineno, @c)) { case (true) { ->; } default {}; };
                                switch (!this.tok_int(ln, 4, lineno, @d)) { case (true) { ->; } default {}; };
                                nm = this.tok_str(ln, 1);
                                switch (nm == (byte*)0 | !this.layouts.add_field(nm, tg, (int)c, (int)d))
                                {
                                    case (true) { this.fail(g"struct layout allocation failed\0"); }
                                    default {};
                                };
                            }
                            default {};
                        };
                        ->;
                    }
                    default {};
                };
                switch (idkvm_eq_ci(t0, n0, g"endstruct\0"))
                {
                    case (true) {
                        switch (!this.p_in_struct)
                        {
                            case (true) {
                                this.parse_fail(lineno, g"'endstruct' without matching 'struct'\0", (byte*)0);
                                ->;
                            }
                            default {};
                        };
                        this.p_in_struct = false;
                        ->;
                    }
                    default {};
                };
                switch (idkvm_eq_ci(t0, n0, g"func\0"))
                {
                    case (true) {
                        switch (this.p_in_func)
                        {
                            case (true) {
                                this.parse_fail(lineno, g"nested 'func' is not allowed\0", (byte*)0);
                                ->;
                            }
                            default {};
                        };
                        switch (this.tk_n < 2)
                        {
                            case (true) {
                                this.parse_fail(lineno, g"'func' requires a name\0", (byte*)0);
                                ->;
                            }
                            default {};
                        };
                        this.p_in_func = true;
                        switch (this.p_pass == 0)
                        {
                            case (true) {
                                this.p_fname = this.tok_str(ln, 1);
                                this.p_unit = this.code.unit_begin();
                                switch (this.p_fname == (byte*)0 | this.p_unit < 0) { case (true) { this.fail(g"code pool allocation failed\0"); } default {}; };
                            }
                            default {};
                        };
                        ->;
                    }
                    default {};
                };
                switch (idkvm_eq_ci(t0, n0, g"endfunc\0"))
                {
                    case (true) {
                        switch (!this.p_in_func)
                        {
                            case (true) {
                                this.parse_fail(lineno, g"'endfunc' without matching 'func'\0", (byte*)0);
                                ->;
                            }
                            default {};
                        };
                        this.p_in_func = false;
                        switch (this.p_pass == 0)
                        {
                            case (true) {
                                this.code.unit_end(this.p_unit);
                                this.register_function(this.p_fname, this.p_unit);
                            }
                            default {};
                        };
                        ->;
                    }
                    default {};
                };

                // Instruction line
                i = 0;
                while (i < IDKVM_OP_COUNT & op < 0)
                {
                    switch (idkvm_eq_ci(t0, n0, idkvm_op_name(i))) { case (true) { op = i; } default {}; };
                    i++;
                };
                emit_here = (this.p_pass == 0 & this.p_in_func) | (this.p_pass == 1 & !this.p_in_func);
                switch (!emit_here)
                {
                    case (true) { ->; }
                    default {};
                };
                switch (op < 0)
                {
                    case (true) {
                        this.parse_fail_tok(lineno, g"unknown opcode \0", ln, 0);
                        ->;
                    }
                    default {};
                };
                this.parse_operands(op, ln, lineno);
                ->;
            };

            // Parses .ivm source text (parse_idkvm_source), registers its functions and layouts
            // and prepares the main block. False with the message in err_text() on a parse error.
            load_idkvm(byte* text, int len) -> bool
            {
                int pass = 0;
                int pos, ls, le, cut, a, b, lineno;
                byte* ln;
                while (pass < 2 & !this.failed)
                {
                    this.p_pass = pass;
                    this.p_in_func = false;
                    this.p_in_struct = false;
                    pos = 0;
                    lineno = 0;
                    switch (pass == 1)
                    {
                        case (true) { this.p_main = this.code.unit_begin(); }
                        default {};
                    };
                    while (pos < len & !this.failed)
                    {
                        ls = pos;
                        le = pos;
                        while (le < len & text[le] != '\n') { le++; };
                        pos = le + 1;
                        lineno++;
                        cut = ls;
                        while (cut < le & text[cut] != '#') { cut++; };
                        a = ls;
                        b = cut;
                        while (a < b & idkvm_is_space((int)text[a])) { a++; };
                        while (b > a & idkvm_is_space((int)text[b - 1])) { b--; };
                        switch (b > a)
                        {
                            case (true) {
                                ln = idkvm_dup(text + a, b - a);
                                switch (ln == (byte*)0)
                                {
                                    case (true) { this.fail(g"line buffer allocation failed\0"); }
                                    default
                                    {
                                        this.tokenize(ln, b - a);
                                        switch (this.tk_n > 0 & !this.failed) { case (true) { this.parse_one(ln, lineno); } default {}; };
                                        ffree(ln);
                                    };
                                };
                            }
                            default {};
                        };
                    };
                    switch (!this.failed & pass == 0 & this.p_in_func)
                    {
                        case (true) {
                            this.parse_fail(lineno, g"unterminated 'func' at end of file\0", (byte*)0);
                        }
                        default {};
                    };
                    switch (!this.failed & pass == 0 & this.p_in_struct)
                    {
                        case (true) {
                            this.parse_fail(lineno, g"unterminated 'struct' at end of file\0", (byte*)0);
                        }
                        default {};
                    };
                    switch (pass == 1)
                    {
                        case (true) {
                            this.code.unit_end(this.p_main);
                            this.main_unit = this.p_main;
                        }
                        default {};
                    };
                    pass++;
                };
                -> !this.failed;
            };
        };
    };
};

#endif;
