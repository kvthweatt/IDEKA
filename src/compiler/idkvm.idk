                case (1) { -> g"POP\0"; }
                case (2) { -> g"DUP\0"; }
                case (3) { -> g"SWAP\0"; }
                case (4) { -> g"ROT\0"; }
                case (5) { -> g"OVER\0"; }
                case (6) { -> g"ADD\0"; }
                case (7) { -> g"SUB\0"; }
                case (8) { -> g"MUL\0"; }
                case (9) { -> g"DIV\0"; }
                case (10) { -> g"MOD\0"; }
                case (11) { -> g"NEG\0"; }
                case (12) { -> g"POW\0"; }
                case (13) { -> g"ABS\0"; }
                case (14) { -> g"MIN\0"; }
                case (15) { -> g"MAX\0"; }
                case (16) { -> g"CLAMP\0"; }
                case (17) { -> g"BAND\0"; }
                case (18) { -> g"BOR\0"; }
                case (19) { -> g"BXOR\0"; }
                case (20) { -> g"BNOT\0"; }
                case (21) { -> g"SHL\0"; }
                case (22) { -> g"SHR\0"; }
                case (23) { -> g"ROTL\0"; }
                case (24) { -> g"ROTR\0"; }
                case (25) { -> g"BITREV\0"; }
                case (26) { -> g"POPCOUNT\0"; }
                case (27) { -> g"CLZ\0"; }
                case (28) { -> g"CTZ\0"; }
                case (29) { -> g"CMP_EQ\0"; }
                case (30) { -> g"CMP_NE\0"; }
                case (31) { -> g"CMP_LT\0"; }
                case (32) { -> g"CMP_LE\0"; }
                case (33) { -> g"CMP_GT\0"; }
                case (34) { -> g"CMP_GE\0"; }
                case (35) { -> g"AND\0"; }
                case (36) { -> g"OR\0"; }
                case (37) { -> g"NOT\0"; }
                case (38) { -> g"JMP\0"; }
                case (39) { -> g"JIF\0"; }
                case (40) { -> g"JNF\0"; }
                case (41) { -> g"JTABLE\0"; }
