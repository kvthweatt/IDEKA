// Author: Karac V. Thweatt
//
// iarm64.idk - AArch64 assembly backend (AAPCS64 registers, GNU assembler syntax)
//
// Backend counterpart of ix64.idk. It builds the shared code model (imodel.idk) through the module layer that
// every backend shares (issa_state.idk, issa_module.idk, issa_data.idk), uses the target independent SSA code
// generator (issa.idk) for the optimizations and the register allocator, and defines the instruction set
// specific part: machine instructions, selection, frame and assembly output.
//
// Registers share one number space. 0..30 are x0..x30, 31 is the zero register (the stack pointer where a
// memory operand uses it as base), 32..63 are v0..v31 and 64 and above are virtual registers.
//
// Calling convention: integer and pointer arguments in x0..x7, float and double in v0..v7, the rest in 8 byte
// stack slots. Aggregates are passed by value as stack copies and returned through a hidden pointer in x8,
// like the x86_64 backend does. The variable arguments of a call all go in stack slots and a va_list is a
// pointer to the next one. Callee saved registers are x19..x28 and v8..v15.
//
// Frame: [0, 16) the saved x29 and x30, then the outgoing argument area, the saved registers and the frame
// objects. x29 points to the bottom of the frame and sp equals it unless the function allocates dynamically.
//
// Integers narrower than the register are kept with undefined upper bits; every user that needs them
// extends first.
//
#ifndef IDEKA_STANDARD
#import <standard.idk>;
#endif;

#ifndef IDEKA_AST
#import "iast.idk";
#endif;

#ifndef IDEKA_TYPES
#import "itypesys.idk";
#endif;

#ifndef IDEKA_MODEL
#import "imodel.idk";
#endif;

#ifndef IDEKA_ARM64
#def IDEKA_ARM64 1;

using IDEKA::ast;
using IDEKA::preprocessor;
using IDEKA::types;
using IDEKA::ir;

// ------------------------------------------------------------------
// Machine IR
// ------------------------------------------------------------------

#def AR_VBASE 64;
#def AR_ZR 31;

// Opcodes
#def A_NOP 0;
#def A_MOV 1;       // d = a
#def A_MOVI 2;      // d = imm
#def A_FMOVI 3;     // d = float bits imm
#def A_ADR 4;       // d = address of sym + imm
#def A_ADDFO 5;     // d = address of frame object fo + imm
#def A_ALU 6;       // d = a op b (k), or imm when b is -1, b shifted left by sc
#def A_MADD 7;      // d = c + a * b (k 0) or c - a * b (k 1)
#def A_UN 8;        // d = op a (k)
#def A_EXT 9;       // d = a extended from imm bits, k 1 signed
#def A_CMP 10;      // flags of a - b, or imm when b is -1
#def A_TST 11;      // flags of a and b, or imm when b is -1
#def A_FCMP 12;     // flags of a - b
#def A_CSET 13;     // d = condition cc
#def A_CSEL 14;     // d = cc ? a : b
#def A_FCSEL 15;
#def A_LD 16;       // d = memory of size sz, k 1 sign extends
#def A_ST 17;       // memory = d
#def A_B 18;        // jump to block tgt
#def A_BC 19;       // jump to block tgt when condition cc
#def A_CBZ 20;      // jump to block tgt when a is zero
#def A_CBNZ 21;
#def A_BL 22;       // call sym
#def A_BLR 23;      // call a
#def A_RET 24;
#def A_BRK 25;
#def A_JT 26;       // jump table: a is the index (already range checked), text the block numbers, k their count
#def A_DALLOC 27;  // d = new stack space of a bytes
#def A_MEMCPY 28;
#def A_MEMSET 29;
#def A_MEMMOVE 30;
#def A_FALU 31;     // d = a op b (k)
#def A_FUN 32;      // d = op a (k)
#def A_FCVT 33;     // d (size sz) = a (size cc)
#def A_CVT 34;      // integer and float conversions (k), sz the integer size, cc the float size
#def A_FMOVX 35;    // bit copy between a general and a float register
#def A_SWBIN 36;    // search of sorted case values: a is the value, text the values then the block numbers, k their count
#def A_ASM 37;      // text is written as it is
#def A_FMSUB 38;    // d = c - a * b on floats
#def A_LABEL 39;    // local label number imm

// Kinds of A_ALU
#def L_ADD 1;
#def L_SUB 2;
#def L_AND 3;
#def L_ORR 4;
#def L_EOR 5;
#def L_MUL 6;
#def L_SDIV 7;
#def L_UDIV 8;
#def L_LSL 9;
#def L_LSR 10;
#def L_ASR 11;

// Kinds of A_UN
#def N_NEG 1;
#def N_MVN 2;
#def N_CLZ 3;
#def N_RBIT 4;
#def N_REV 5;
#def N_REV16 6;

// Kinds of A_FALU
#def FA_ADD 1;
#def FA_SUB 2;
#def FA_MUL 3;
#def FA_DIV 4;

// Kinds of A_FUN
#def FU_NEG 1;
#def FU_ABS 2;
#def FU_SQRT 3;
#def FU_RINTZ 4;

// Kinds of A_CVT
#def CV_SCVTF 1;
#def CV_UCVTF 2;
#def CV_FCVTZS 3;
#def CV_FCVTZU 4;

// Condition codes, the encoding of the instruction set
#def CC_EQ 0;
#def CC_NE 1;
#def CC_HS 2;
#def CC_LO 3;
#def CC_MI 4;
#def CC_PL 5;
#def CC_VS 6;
#def CC_VC 7;
#def CC_HI 8;
#def CC_LS 9;
#def CC_GE 10;
#def CC_LT 11;
#def CC_GT 12;
#def CC_LE 13;
#def CC_AL 14;

// Switches of the backend optimizations, 1 on and 0 off
#def A64_OPT_LAZY 1;       // an address or a compare used once by the next instructions is folded into it
#def A64_OPT_CBZ 1;        // a compare with zero that feeds a branch is cbz or cbnz
#def A64_OPT_SPREAD 1;     // spill code reuses a value that was just loaded

namespace IDEKA
{
    namespace arm64
    {
#import "issa_types.idk";

// A frame object (an alloca that stays in memory, a spill slot or an aggregate temporary)
struct AFO
{
    int size, al, off, fix;
};

// Per function state of the AArch64 backend. GF.tg points to it.
struct AGF
{
    PtrVec* fobj;       // AFO*
    int outmax;         // bytes of outgoing argument area
    i64 saved;          // callee saved registers used, one bit each
    int frame;          // size of the frame in bytes
    int csbase;         // offset of the saved registers
    int sretv;          // register holding the hidden result pointer, 0 when there is none
    int vastk;          // bytes of named stack arguments of a vararg function
    bool dyn;           // the function allocates stack space dynamically
    bool vararg;
    bool leaf;          // no calls
};

// A memory operand under construction: base register b (31 is sp), index register i scaled by 1 << sc, displacement,
// a symbol or a frame object fo, ma 1 for the incoming argument area.
struct AM
{
    int b, i, sc, fo, ma;
    i64 imm;
    byte* sym;
};

// One machine instruction. d a b c are register numbers or -1. A memory operand is the base register a
// (31 is sp), the index register b scaled by 1 << sc, the displacement imm and a symbol sym or a frame object fo.
struct AI
{
    int op, sz, cc, k, tgt, d, a, b, c, sc, fo;
    i64 imm;
    byte* sym;
    i64 iu, id, clob;   // registers read, written and destroyed by the instruction, one bit each
    byte* text;
    int ma;             // memory operand kind: 0 normal, 1 incoming argument area
};

object A64Module
{
#import "issa_state.idk";

            // state of the AArch64 backend
            int gfn;
            int bf_sh, bf_w;   // set by the address computation: bit shift and width of a bit packed member, 0 width when none
            byte* arp;         // arena of the machine instructions of one function
            int aru;
            PtrVec* arch;
            GB* scb;           // block receiving instructions
            SI* nxti;
            bool skipn;
            bool hasal;
            Buf eo;            // text of the function being written
            Buf jb;            // jump tables of the function
            int ad_b, ad_i, ad_sc, ad_fo, ad_ma;   // address under construction
            i64 ad_imm;
            byte* ad_sym;
            int fcc2;          // second condition of a float compare, -1 when one is enough
            int nlab;          // local labels
            int rprev;

            __init(byte* name) -> this
            {
                this.s_mod_init(name);
                this.gfn = 0;
                this.bf_sh = 0;
                this.bf_w = 0;
                this.arp = (byte*)0;
                this.aru = 0;
                this.arch = pv_new();
                this.scb = (GB*)0;
                this.nxti = (SI*)0;
                this.skipn = false;
                this.hasal = false;
                this.eo.__init();
                this.jb.__init();
                this.nlab = 0;
                this.fcc2 = 0 - 1;
                -> this;
            };

            __expr() -> A64Module* -> this;

            __exit() -> void
            {
                this.eo.__exit();
                this.jb.__exit();
                pv_free(this.arch);
                -> this.s_mod_free();
            };

#import "issa_module.idk";
#import "issa_data.idk";
#import "issa.idk";

            // ----------------------------------------------------------
            // Target interface, see the list in ix64.idk
            // ----------------------------------------------------------

            a_win() -> bool -> false;

            // Registers the allocator may hand out: x0..x7, x9..x15, x19..x28 and v0..v30 (x8 carries the hidden
            // result pointer, x16 and x17 are scratch, x18 is reserved, v31 is scratch)
            s_allocmask(int cls) -> i64
            {
                if (cls == 1) { -> (i64)(2147483647) << (i64)32; };
                -> (i64)(255 `| (127 << 9) `| (1023 << 19));
            };

            s_npref(int cls) -> int
            {
                if (cls == 1) { -> 31; };
                -> 25;
            };

            // Order in which free registers are taken: the caller saved ones first
            s_pref(int cls, int k) -> int
            {
                if (cls == 1)
                {
                    if (k < 15) { -> 48 + k; };
                    if (k < 23) { -> 32 + k - 15; };
                    -> 40 + k - 23;
                };
                if (k < 7) { -> 9 + k; };
                if (k < 15) { -> k - 7; };
                -> 19 + k - 15;
            };

            // Registers a function must preserve: x19..x28 and v8..v15
            s_csmask() -> i64
            {
                -> (i64)(1023 << 19) `| ((i64)255 << (i64)40);
            };

            s_tgt_free(GF* g) -> void
            {
                AGF* t = (AGF*)g.tg;
                int i = 0;
                if (t != (AGF*)0)
                {
                    if (t.fobj != (PtrVec*)0) { pv_free(t.fobj); };
                    ffree((byte*)t);
                };
                if (g.lpos != (int*)0) { this.s_ifree(g.lpos); };
                if (g.gv != (int*)0) { this.s_ifree(g.gv); };
                ->;
            };

            // The passes that need the instruction set find nothing to do on this target
            s_cntb() -> bool -> false;
            s_runb() -> bool -> false;
            s_strlen() -> bool -> false;
            s_fvec_one(GB* hb) -> bool -> false;
            s_thread() -> bool -> false;

            // ----------------------------------------------------------
            // Per function state
            // ----------------------------------------------------------

            s_gf_new(IRFunc* f) -> GF*
            {
                GF* g = (GF*)fmalloc((u64)(((sizeof(GF) + 7) / 8) * 2));
                AGF* t = (AGF*)fmalloc((u64)(((sizeof(AGF) + 7) / 8) * 2));
                g.tg = (void*)t;
                g.f = f;
                g.bl = pv_new();
                g.rpo = (GB**)0;
                g.nb = 0;
                g.nvr = AR_VBASE;
                g.capvr = 0;
                g.vcls = (int*)0;
                g.vwgt = (int*)0;
                g.vcol = (int*)0;
                g.vslot = (int*)0;
                g.vforb = (i64*)0;
                g.vhint = (int*)0;
                g.vdef = (int*)0;
                g.vglob = (int*)0;
                g.vuse = (int*)0;
                g.nglob = 0;
                g.mlast = 0;
                g.rcap = 0;
                g.nl = 0;
                g.occ = 0;
                g.lpos = (int*)0;
                g.llist = (int*)0;
                g.gv = (int*)0;
                g.gw = (int*)0;
                g.cur = (int*)0;
                t.fobj = pv_new();
                t.outmax = 0;
                t.saved = (i64)0;
                t.frame = 0;
                t.csbase = 0;
                t.sretv = 0;
                t.vastk = 0;
                t.dyn = false;
                t.vararg = false;
                t.leaf = true;
                -> g;
            };

            // Arena for the machine instructions of one function
            s_ar(int n) -> byte*
            {
                byte* p;
                int sz;
                n = (n + 7) / 8 * 8;
                if (this.arp == (byte*)0 | this.aru + n > 1048576)
                {
                    sz = 1048576;
                    if (n > sz) { sz = n; };
                    this.arp = (byte*)fmalloc((u64)sz);
                    this.aru = 0;
                    pv_push(this.arch, (void*)this.arp);
                };
                p = this.arp + this.aru;
                this.aru = this.aru + n;
                -> p;
            };

            s_ar_free() -> void
            {
                int i = 0;
                while (i < this.arch.len) { ffree((byte*)this.arch.items[i]); i++; };
                this.arch.len = 0;
                this.arp = (byte*)0;
                this.aru = 0;
                ->;
            };

            // ----------------------------------------------------------
            // Functions and module
            // ----------------------------------------------------------

            // Compiles f with the SSA code generator. Returns false when the function needs something the
            // code generator cannot do yet.
            s_func(IRFunc* f, Buf* out) -> bool
            {
                bool ok;
                this.gwhy = 0;
                this.gwhys = (byte*)0;
                this.cf = f;
                if (this.a_naked(f))
                {
                    this.s_naked(f, out);
                    -> this.gwhy == 0;
                };
                this.sf = this.s_gf_new(f);
                ok = this.s_cfg();
                if (ok)
                {
                    this.s_prep();
                    this.s_promote();
                    if (SSA_OPT_FOLD == 1) { this.s_opt(); };
                    this.s_prep();
                    ok = this.s_recfg();
                    if (ok & SSA_OPT_MERGE == 1)
                    {
                        if (this.s_merge()) { ok = this.s_recfg(); };
                    };
                    if (ok) { ok = this.s_passes(); };
                    if (ok)
                    {
                        this.s_dce();
                        this.s_loops();
                        if (SSA_OPT_SINK == 1) { this.s_sink(); };
                        ok = this.s_isel();
                    };
                    if (ok) { ok = this.s_edges(); };
                    if (ok) { ok = this.s_ra(); };
                    if (ok)
                    {
                        this.eo.len = 0;
                        this.s_emit(f, @this.eo);
                        if (this.gwhy != 0) { ok = false; };
                        if (ok) { out.put_n(this.eo.mem, this.eo.len); };
                    };
                };
                this.s_ar_free();
                this.s_gf_free(f);
                if (this.gwhy != 0) { ok = false; };
                -> ok;
            };

            a_put_function(Buf* out, IRFunc* f) -> void
            {
                if (f.is_decl) { ->; };
                this.gfn = this.gfn + 1;
                if (this.s_func(f, out)) { ->; };
                // the function needs something the code generator cannot do
                this.nunsup++;
                if (this.gwhys != (byte*)0) { this.a_note(this.a_sym(f.self.text), this.gwhys); }
                else { this.a_note(this.a_sym(f.self.text), g"control flow\0"); };
                out.put_str(g"// unsupported: \0");
                out.put_str(this.a_sym(f.self.text));
                out.put_str(g": \0");
                if (this.gwhys != (byte*)0) { out.put_str(this.gwhys); } else { out.put_str(g"control flow\0"); };
                out.put(10);
                ->;
            };

            a_emit(Buf* out) -> void
            {
                int i;
                out.put_str(g"\t.file \0");
                put_quoted(out, this.mod_name);
                out.put(10);
                this.s_inline_all();
                while (i < this.funcs.len)
                {
                    this.a_put_function(out, (IRFunc*)this.funcs.items[i]);
                    i++;
                };
                i = 0;
                while (i < this.globals.len)
                {
                    this.a_put_global(out, (IRGlobal*)this.globals.items[i]);
                    i++;
                };
                out.put_str(this.cdata.mem);
                if (this.zmax > 0)
                {
                    out.put_str(this.a_rodata());
                    out.put_str(g"\t.p2align 4\n.LZERO:\n\0");
                    this.a_zero(out, this.zmax);
                };
                out.put_str(g"\t.section .note.GNU-stack,\"\",@progbits\n\0");
                ->;
            };

            emit(Buf* out) -> void
            {
                this.a_emit(out);
                ->;
            };

// Author: Karac V. Thweatt
//
// iarm64_isel.idk - instruction selection of the AArch64 backend. Imported inside the object of A64Module.
// Turns the recorded instructions of a function (SI) into machine instructions (AI) on virtual registers.

            // ----------------------------------------------------------
            // Machine instructions
            // ----------------------------------------------------------

            // New instruction at the end of the block being filled
            s_mi(int op, int sz) -> AI*
            {
                AI* m = (AI*)this.s_ar((int)(((sizeof(AI) + 7) / 8) * 2));
                m.op = op;
                m.sz = sz;
                m.cc = 0;
                m.k = 0;
                m.tgt = 0 - 1;
                m.d = 0 - 1;
                m.a = 0 - 1;
                m.b = 0 - 1;
                m.c = 0 - 1;
                m.sc = 0;
                m.fo = 0 - 1;
                m.imm = (i64)0;
                m.sym = (byte*)0;
                m.iu = (i64)0;
                m.id = (i64)0;
                m.clob = (i64)0;
                m.text = (byte*)0;
                m.ma = 0;
                pv_push(this.scb.mi, (void*)m);
                -> m;
            };

            // d = a
            s_mov(int d, int a, int sz) -> void
            {
                AI* m = this.s_mi(A_MOV, sz);
                m.d = d;
                m.a = a;
                ->;
            };

            // New register holding the constant v, sz 4 or 8
            s_movi(i64 v, int sz) -> int
            {
                int d = this.s_nv(0);
                AI* m = this.s_mi(A_MOVI, sz);
                m.d = d;
                m.imm = v;
                -> d;
            };

            // d = a op b, or a op imm when b is -1
            s_alu(int k, int sz, int a, int b, i64 imm) -> int
            {
                int d = this.s_nv(0);
                AI* m = this.s_mi(A_ALU, sz);
                m.k = k;
                m.d = d;
                m.a = a;
                m.b = b;
                m.imm = imm;
                -> d;
            };

            // Operation size of integer arithmetic on type t: values up to 32 bits are computed in 32
            s_isz(IRType* t) -> int
            {
                if (t.kind == LK.INT)
                {
                    if (t.width <= 32) { -> 4; };
                };
                -> 8;
            };

            // Access size in bytes of a scalar type
            s_vsz(IRType* t) -> int
            {
                int s = this.a_size(t);
                if (s > 8) { s = 8; };
                -> s;
            };

            // Width in bits of an integer or pointer type
            s_wid(IRType* t) -> int
            {
                if (t.kind == LK.INT) { -> t.width; };
                -> 64;
            };

            // Register class of values of type t
            s_cls(IRType* t) -> int
            {
                if (t.kind == LK.FLOAT | t.kind == LK.DOUBLE) { -> 1; };
                -> 0;
            };

            // True when t is a type the selector passes in a register
            s_isarg(IRType* t) -> bool
            {
                if (t.kind == LK.PTR) { -> true; };
                if (t.kind == LK.INT) { -> t.width <= 64; };
                if (t.kind == LK.FLOAT | t.kind == LK.DOUBLE) { -> true; };
                -> false;
            };

            // Defines the virtual register of an instruction result
            s_def(IRValue* res, int cls) -> int
            {
                int v = this.s_nv(cls);
                res.vr = v;
                -> v;
            };

            // Copy of r extended from w bits, signed or not, to a register of dsz bytes
            s_ext(int r, int w, bool sgn, int dsz) -> int
            {
                int d;
                AI* m;
                if (w >= dsz * 8) { -> r; };
                d = this.s_nv(0);
                m = this.s_mi(A_EXT, dsz);
                m.d = d;
                m.a = r;
                m.imm = (i64)w;
                if (sgn) { m.k = 1; };
                -> d;
            };

            // Frame object of sz bytes, returns its number plus one
            s_newfo(int sz, int al) -> int
            {
                GF* g = this.sf;
                AFO* o = (AFO*)this.s_ar((int)(((sizeof(AFO) + 7) / 8) * 2));
                if (sz < 1) { sz = 1; };
                if (al < 1) { al = 1; };
                o.size = sz;
                o.al = al;
                o.off = 0;
                o.fix = 0;
                pv_push(((AGF*)g.tg).fobj, (void*)o);
                -> ((AGF*)g.tg).fobj.len;
            };

            // ----------------------------------------------------------
            // Constants and operands
            // ----------------------------------------------------------

            // Register holding the float constant of value v
            s_fconst(IRValue* v) -> int
            {
                int d = this.s_nv(1);
                int sz = this.s_vsz(v.ty);
                AI* m = this.s_mi(A_FMOVI, sz);
                m.d = d;
                m.imm = this.scv;
                -> d;
            };

            // Register holding the value p. Constants and addresses are made in a new register.
            s_vr(IRValue* p) -> int
            {
                IRValue* v = this.s_res(p);
                SI* d;
                AI* m;
                int t;
                if (v.vr >= AR_VBASE) { -> v.vr; };
                if (v.fo > 0)
                {
                    t = this.s_nv(0);
                    m = this.s_mi(A_ADDFO, 8);
                    m.d = t;
                    m.fo = v.fo - 1;
                    -> t;
                };
                if (v.di != (void*)0 & !v.kc)
                {
                    d = (SI*)v.di;
                    if (d.flag & d.op == SO_GEP) { -> this.s_gepreg(d); };
                    if (d.flag & d.op == SO_CMP) { -> this.s_cmpval(d); };
                    this.s_fail(g"value without register\0");
                    -> 0;
                };
                if (this.s_isc(v))
                {
                    if (this.sck == CK_SYM)
                    {
                        t = this.s_nv(0);
                        m = this.s_mi(A_ADR, 8);
                        m.d = t;
                        m.sym = this.scs;
                        m.imm = this.scv;
                        -> t;
                    };
                    if (this.sck == CK_INT)
                    {
                        if (v.ty.kind == LK.INT)
                        {
                            if (v.ty.width <= 32) { -> this.s_movi((i64)this.a_mask((u64)this.scv, 32), 4); };
                        };
                        -> this.s_movi(this.scv, 8);
                    };
                    if (this.sck == CK_FP) { -> this.s_fconst(v); };
                    this.s_fail(g"aggregate constant\0");
                    -> 0;
                };
                if (v.vr == 0 & v.fo == 0) { this.s_fail(g"operand without definition\0"); };
                -> 0;
            };

            // Like s_vr, the zero register for the constant zero
            s_vr0(IRValue* p) -> int
            {
                IRValue* v = this.s_res(p);
                if (v.vr == 0 & v.fo == 0 & (v.di == (void*)0 | v.kc))
                {
                    if (this.s_isc(v))
                    {
                        if (this.sck == CK_INT & this.scv == (i64)0) { -> AR_ZR; };
                        if (this.sck == CK_FP & this.scv == (i64)0) { -> AR_ZR; };
                    };
                };
                -> this.s_vr(p);
            };

            // True when p is an integer constant, its value (masked to the type) is in scv
            s_kint(IRValue* p) -> bool
            {
                IRValue* v = this.s_res(p);
                if (v.vr != 0 | v.fo != 0) { -> false; };
                if (v.di != (void*)0 & !v.kc) { -> false; };
                if (v.ty.kind == LK.PTR)
                {
                    if (!this.s_isc(v)) { -> false; };
                    -> this.sck == CK_INT;
                };
                -> this.s_cint(v);
            };

            // ----------------------------------------------------------
            // Addresses
            // ----------------------------------------------------------

            s_am() -> AM*
            {
                AM* m = (AM*)this.s_ar((int)(((sizeof(AM) + 7) / 8) * 2));
                m.b = 0 - 1;
                m.i = 0 - 1;
                m.sc = 0;
                m.fo = 0 - 1;
                m.ma = 0;
                m.imm = (i64)0;
                m.sym = (byte*)0;
                -> m;
            };

            s_amcopy(AM* s) -> AM*
            {
                AM* m = this.s_am();
                m.b = s.b;
                m.i = s.i;
                m.sc = s.sc;
                m.fo = s.fo;
                m.ma = s.ma;
                m.imm = s.imm;
                m.sym = s.sym;
                -> m;
            };

            // Address of the memory operand m off bytes further
            s_amoff(AM* s, i64 off) -> AM*
            {
                AM* m = this.s_amcopy(s);
                m.imm = m.imm + off;
                -> m;
            };

            // Memory operand of the pointer p, an address of a bit packed member is not a plain address
            s_addr(IRValue* p) -> AM*
            {
                AM* m = this.s_addrb(p);
                if (this.bf_w > 0) { this.s_fail(g"address of a bit packed member\0"); };
                -> m;
            };

            // As s_addr, but bf_sh and bf_w tell when p is the address of a bit packed member
            s_addrb(IRValue* p) -> AM*
            {
                IRValue* v = this.s_res(p);
                this.bf_w = 0;
                SI* d;
                AM* m;
                if (v.fo > 0)
                {
                    m = this.s_am();
                    m.fo = v.fo - 1;
                    -> m;
                };
                if (v.di != (void*)0 & !v.kc)
                {
                    d = (SI*)v.di;
                    if (d.flag & d.op == SO_GEP) { -> this.s_gepaddr(d); };
                };
                m = this.s_am();
                if (v.vr == 0 & (v.di == (void*)0 | v.kc))
                {
                    if (this.s_isc(v))
                    {
                        if (this.sck == CK_SYM)
                        {
                            m.sym = this.scs;
                            m.imm = this.scv;
                            -> m;
                        };
                        if (this.sck == CK_INT)
                        {
                            m.b = this.s_movi(this.scv, 8);
                            -> m;
                        };
                    };
                    this.s_fail(g"address constant\0");
                    -> m;
                };
                m.b = this.s_vr(v);
                -> m;
            };

            // Register holding the whole address m
            s_amreg(AM* m) -> int
            {
                AI* a;
                int d, r;
                if (m.sym != (byte*)0)
                {
                    d = this.s_nv(0);
                    a = this.s_mi(A_ADR, 8);
                    a.d = d;
                    a.sym = m.sym;
                    a.imm = m.imm;
                    -> d;
                };
                if (m.fo >= 0 | m.ma != 0)
                {
                    d = this.s_nv(0);
                    a = this.s_mi(A_ADDFO, 8);
                    a.d = d;
                    a.fo = m.fo;
                    a.ma = m.ma;
                    a.imm = m.imm;
                    -> d;
                };
                r = m.b;
                if (m.i >= 0)
                {
                    a = this.s_mi(A_ALU, 8);
                    d = this.s_nv(0);
                    a.k = L_ADD;
                    a.d = d;
                    a.a = r;
                    a.b = m.i;
                    a.sc = m.sc;
                    r = d;
                };
                if (m.imm != (i64)0)
                {
                    r = this.s_alu(L_ADD, 8, r, 0 - 1, m.imm);
                };
                -> r;
            };

            // The address m made a plain base register plus displacement, so an index can be added
            s_amflat(AM* m) -> void
            {
                int r;
                if (m.sym != (byte*)0 | m.fo >= 0 | m.ma != 0)
                {
                    r = this.s_amreg(m);
                    m.b = r;
                    m.sym = (byte*)0;
                    m.fo = 0 - 1;
                    m.ma = 0;
                    m.imm = (i64)0;
                    ->;
                };
                if (m.i >= 0)
                {
                    r = this.s_nv(0);
                    AI* a = this.s_mi(A_ALU, 8);
                    a.k = L_ADD;
                    a.d = r;
                    a.a = m.b;
                    a.b = m.i;
                    a.sc = m.sc;
                    m.b = r;
                    m.i = 0 - 1;
                    m.sc = 0;
                };
                ->;
            };

            // Adds index register ix (of the signed width w) scaled by esz to the address m
            s_adidx(AM* m, int ix, int w, int esz) -> void
            {
                int r = ix;
                int sh = 0 - 1;
                if (w < 64) { r = this.s_ext(ix, w, true, 8); };
                if (esz == 1) { sh = 0; };
                if (esz == 2) { sh = 1; };
                if (esz == 4) { sh = 2; };
                if (esz == 8) { sh = 3; };
                if (esz == 16) { sh = 4; };
                if (sh < 0)
                {
                    r = this.s_alu(L_MUL, 8, r, this.s_movi((i64)esz, 8), (i64)0);
                    sh = 0;
                };
                if (m.i >= 0 | m.sym != (byte*)0 | m.fo >= 0 | m.ma != 0) { this.s_amflat(m); };
                m.i = r;
                m.sc = sh;
                ->;
            };

            // Address of the getelementptr x
            s_gepaddr(SI* x) -> AM*
            {
                IRValue* p = this.s_res(x.a);
                IRType* cur = p.ty.elem;
                int n = x.n;
                int i, k, bo, w, wbs, wbw;
                int* ir = this.s_iz(n + 1);
                int* ik = this.s_iz(n + 1);
                int* iw = this.s_iz(n + 1);
                i64* ic = this.s_lz(n + 1);
                IRValue* ix;
                AM* m;
                i = 0;
                while (i < n)
                {
                    ix = this.s_res(x.args[i]);
                    w = 64;
                    if (ix.ty.kind == LK.INT) { w = ix.ty.width; };
                    iw[i] = w;
                    if (this.s_kint(ix))
                    {
                        ik[i] = 1;
                        ic[i] = this.s_sx((u64)this.scv, w);
                    }
                    else { ir[i] = this.s_vr(ix); };
                    i++;
                };
                m = this.s_addr(p);
                if (ik[0] == 1) { m.imm = m.imm + ic[0] * (i64)this.a_size(cur); }
                else { this.s_adidx(m, ir[0], iw[0], this.a_size(cur)); };
                i = 1;
                while (i < n)
                {
                    if (cur.kind == LK.STRUCT | cur.kind == LK.ISTRUCT)
                    {
                        if (ik[i] != 1) { this.s_fail(g"struct index\0"); break; };
                        k = (int)ic[i];
                        this.bf_ok = true;
                        m.imm = m.imm + (i64)this.a_foff(cur, k);
                        this.bf_ok = false;
                        if (cur.lbits > 0 & cur.loff != (int*)0)
                        {
                            bo = cur.loff[k] % 8;
                            if (this.a_bitw(cur.items[k]) | bo != 0)
                            {
                                if (cur.items[k].kind == LK.INT & i == n - 1 & cur.items[k].width <= 64)
                                {
                                    wbs = bo;
                                    wbw = cur.items[k].width;
                                }
                                else { this.s_fail(g"member not on a byte boundary\0"); break; };
                            };
                        };
                        cur = cur.items[k];
                    }
                    else
                    {
                        if (cur.kind == LK.ARRAY)
                        {
                            if (ik[i] == 1) { m.imm = m.imm + ic[i] * (i64)this.a_size(cur.elem); }
                            else { this.s_adidx(m, ir[i], iw[i], this.a_size(cur.elem)); };
                            cur = cur.elem;
                        }
                        else
                        {
                            this.s_fail(g"gep type\0");
                            break;
                        };
                    };
                    i++;
                };
                this.s_ifree(ir);
                this.s_ifree(ik);
                this.s_ifree(iw);
                this.s_lfree(ic);
                this.bf_sh = wbs;
                this.bf_w = wbw;
                -> m;
            };

            s_gepreg(SI* x) -> int
            {
                AM* m = this.s_gepaddr(x);
                if (this.gwhy != 0) { -> 0; };
                if (this.bf_w > 0) { this.s_fail(g"address of a bit packed member\0"); -> 0; };
                -> this.s_amreg(m);
            };

            s_isel_gep(SI* x) -> void
            {
                int r, d;
                if (x.flag) { ->; };
                r = this.s_gepreg(x);
                if (this.gwhy != 0) { ->; };
                d = this.s_def(x.res, 0);
                this.s_mov(d, r, 8);
                ->;
            };

            // Memory instruction op (A_LD or A_ST) for register r, size sz, address m
            s_memop(int op, int r, int sz, AM* m) -> AI*
            {
                AI* a = this.s_mi(op, sz);
                a.d = r;
                a.a = m.b;
                a.b = m.i;
                a.sc = m.sc;
                a.fo = m.fo;
                a.ma = m.ma;
                a.imm = m.imm;
                a.sym = m.sym;
                -> a;
            };

            // ----------------------------------------------------------
            // Aggregates
            // ----------------------------------------------------------

            // Memory operand of the aggregate value v
            s_agg_addr(IRValue* v) -> AM*
            {
                AM* m = this.s_am();
                byte* lb;
                if (v.fo > 0)
                {
                    m.fo = v.fo - 1;
                    -> m;
                };
                if (v.vr == 0 & v.di == (void*)0 & v.text != (byte*)0)
                {
                    if (this.a_pre(v.text, g"zeroinitializer\0") | this.a_pre(v.text, g"undef\0")) { lb = this.a_zero_label(this.a_size(v.ty)); }
                    else { lb = this.a_const_agg(v); };
                    m.sym = lb;
                    -> m;
                };
                this.s_fail(g"aggregate value\0");
                -> m;
            };

            // Copies n bytes from memory s to memory d
            s_copy(AM* d, AM* s, int n) -> void
            {
                int off = 0;
                int t, sz, ra, rb;
                AI* m;
                if (n <= 0) { ->; };
                if (n > 128)
                {
                    ra = this.s_amreg(d);
                    rb = this.s_amreg(s);
                    this.s_mov(0, ra, 8);
                    this.s_mov(1, rb, 8);
                    t = this.s_movi((i64)n, 8);
                    this.s_mov(2, t, 8);
                    m = this.s_mi(A_MEMCPY, 8);
                    m.iu = (i64)7;
                    m.id = (i64)15;
                    m.clob = (i64)15;
                    ->;
                };
                while (off < n)
                {
                    sz = 8;
                    if (n - off < 8) { sz = 4; };
                    if (n - off < 4) { sz = 2; };
                    if (n - off < 2) { sz = 1; };
                    t = this.s_nv(0);
                    this.s_memop(A_LD, t, sz, this.s_amoff(s, (i64)off));
                    this.s_memop(A_ST, t, sz, this.s_amoff(d, (i64)off));
                    off = off + sz;
                };
                ->;
            };

            // Zeroes n bytes at memory d
            s_zero(AM* d, int n) -> void
            {
                int off = 0;
                int sz, ra, t;
                AI* m;
                if (n <= 0) { ->; };
                if (n > 128)
                {
                    ra = this.s_amreg(d);
                    this.s_mov(0, ra, 8);
                    this.s_mov(1, AR_ZR, 8);
                    t = this.s_movi((i64)n, 8);
                    this.s_mov(2, t, 8);
                    m = this.s_mi(A_MEMSET, 8);
                    m.iu = (i64)7;
                    m.id = (i64)15;
                    m.clob = (i64)15;
                    ->;
                };
                while (off < n)
                {
                    sz = 8;
                    if (n - off < 8) { sz = 4; };
                    if (n - off < 4) { sz = 2; };
                    if (n - off < 2) { sz = 1; };
                    this.s_memop(A_ST, AR_ZR, sz, this.s_amoff(d, (i64)off));
                    off = off + sz;
                };
                ->;
            };

            // Copies the aggregate value v to memory d
            s_agg_to(IRValue* v, AM* d) -> void
            {
                AM* s = this.s_agg_addr(v);
                if (this.gwhy != 0) { ->; };
                this.s_copy(d, s, this.a_size(v.ty));
                ->;
            };

            s_isel_extract(SI* x) -> void
            {
                IRValue* agg = this.s_res(x.a);
                IRType* et = this.s_elem(agg.ty, x.k);
                AM* base = this.s_agg_addr(agg);
                AM* m;
                int sz, d, fo, ab;
                if (this.gwhy != 0) { ->; };
                ab = this.sel_off;
                m = this.s_amoff(base, (i64)ab);
                if (this.s_isagg(et))
                {
                    sz = this.a_size(et);
                    fo = this.s_newfo(sz, this.a_align(et));
                    m = this.s_amoff(base, (i64)ab);
                    this.s_copy(this.s_fomem(fo - 1), m, sz);
                    x.res.fo = fo;
                    ->;
                };
                if (this.s_isfp(et))
                {
                    sz = this.s_vsz(et);
                    d = this.s_def(x.res, 1);
                    this.s_memop(A_LD, d, sz, m);
                    ->;
                };
                if (et.kind != LK.INT & et.kind != LK.PTR) { this.s_fail(g"extract type\0"); ->; };
                if (et.kind == LK.INT)
                {
                    if (et.width > 64) { this.s_fail(g"wide extract\0"); ->; };
                };
                sz = this.s_vsz(et);
                d = this.s_def(x.res, 0);
                this.s_memop(A_LD, d, sz, m);
                ->;
            };

            // Memory operand of frame object fo
            s_fomem(int fo) -> AM*
            {
                AM* m = this.s_am();
                m.fo = fo;
                -> m;
            };

            s_isel_insert(SI* x) -> void
            {
                IRValue* agg = this.s_res(x.a);
                IRValue* v = this.s_res(x.b);
                IRType* et = this.s_elem(agg.ty, x.k);
                int off = this.sel_off;
                int tsz = this.a_size(agg.ty);
                int fo = this.s_newfo(tsz, this.a_align(agg.ty));
                AM* dst = this.s_amoff(this.s_fomem(fo - 1), (i64)off);
                AM* whole = this.s_fomem(fo - 1);
                AM* src = this.s_agg_addr(agg);
                int sz, r;
                if (this.gwhy != 0) { ->; };
                this.s_copy(whole, src, tsz);
                if (this.s_isagg(et)) { this.s_agg_to(v, dst); x.res.fo = fo; ->; };
                sz = this.s_vsz(et);
                if (this.s_isfp(et))
                {
                    r = this.s_vr0(x.b);
                    this.s_memop(A_ST, r, sz, dst);
                    x.res.fo = fo;
                    ->;
                };
                if (et.kind != LK.INT & et.kind != LK.PTR) { this.s_fail(g"insert type\0"); ->; };
                if (et.kind == LK.INT)
                {
                    if (et.width > 64) { this.s_fail(g"wide insert\0"); ->; };
                };
                r = this.s_vr0(x.b);
                this.s_memop(A_ST, r, sz, dst);
                x.res.fo = fo;
                ->;
            };

            // ----------------------------------------------------------
            // Memory
            // ----------------------------------------------------------

            s_isel_alloca(SI* x) -> void
            {
                x.res.fo = this.s_newfo(this.a_size(x.ty), this.a_align(x.ty));
                ->;
            };

            s_isel_allocan(SI* x) -> void
            {
                IRValue* c = this.s_res(x.a);
                IRType* ct = c.ty;
                int r, d, w, sz;
                AI* m;
                if (ct.kind != LK.INT) { this.s_fail(g"alloca count\0"); ->; };
                r = this.s_vr(c);
                w = ct.width;
                if (w < 64) { r = this.s_ext(r, w, false, 8); };
                sz = this.a_size(x.ty);
                if (sz != 1) { r = this.s_alu(L_MUL, 8, r, this.s_movi((i64)sz, 8), (i64)0); };
                d = this.s_def(x.res, 0);
                m = this.s_mi(A_DALLOC, 8);
                m.d = d;
                m.a = r;
                ((AGF*)this.sf.tg).dyn = true;
                ->;
            };

            s_isel_load(SI* x) -> void
            {
                IRType* t = x.ty;
                AM* m;
                int sz, d, rs;
                if (this.s_isagg(t))
                {
                    sz = this.a_size(t);
                    rs = this.s_newfo(sz, this.a_align(t));
                    m = this.s_addr(x.a);
                    this.s_copy(this.s_fomem(rs - 1), m, sz);
                    x.res.fo = rs;
                    ->;
                };
                if (this.s_isfp(t))
                {
                    sz = this.s_vsz(t);
                    m = this.s_addr(x.a);
                    d = this.s_def(x.res, 1);
                    this.s_memop(A_LD, d, sz, m);
                    ->;
                };
                if (t.kind != LK.INT & t.kind != LK.PTR) { this.s_fail(g"load type\0"); ->; };
                if (t.kind == LK.INT)
                {
                    if (t.width > 64) { this.s_fail(g"wide load\0"); ->; };
                };
                sz = this.s_vsz(t);
                m = this.s_addrb(x.a);
                if (this.bf_w > 0)
                {
                    rs = this.s_bf_read(m, this.bf_sh, this.bf_w);
                    d = this.s_def(x.res, 0);
                    this.s_mov(d, rs, 8);
                    ->;
                };
                d = this.s_def(x.res, 0);
                this.s_memop(A_LD, d, sz, m);
                ->;
            };

            s_isel_store(SI* x) -> void
            {
                IRType* t = x.ty;
                AM* m;
                int sz, r;
                if (this.s_isagg(t))
                {
                    m = this.s_addr(x.b);
                    this.s_agg_to(this.s_res(x.a), m);
                    ->;
                };
                if (this.s_isfp(t))
                {
                    sz = this.s_vsz(t);
                    r = this.s_vr0(x.a);
                    m = this.s_addr(x.b);
                    this.s_memop(A_ST, r, sz, m);
                    ->;
                };
                if (t.kind != LK.INT & t.kind != LK.PTR) { this.s_fail(g"store type\0"); ->; };
                if (t.kind == LK.INT)
                {
                    if (t.width > 64) { this.s_fail(g"wide store\0"); ->; };
                };
                sz = this.s_vsz(t);
                r = this.s_vr0(x.a);
                if (t.kind == LK.INT & t.width < sz * 8 & r != AR_ZR)
                {
                    // the bits above the declared width are undefined, memory holds the value zero extended
                    if (t.width == 1) { r = this.s_alu(L_AND, 4, r, 0 - 1, (i64)1); }
                    elif (t.width != 8 & t.width != 16 & t.width != 32) { r = this.s_ext(r, t.width, false, 8); };
                };
                m = this.s_addrb(x.b);
                if (this.bf_w > 0)
                {
                    this.s_bf_write(m, this.bf_sh, this.bf_w, r);
                    ->;
                };
                this.s_memop(A_ST, r, sz, m);
                ->;
            };

            // Value of the bit field of width w that starts sh bits into the bytes at m. Bit 0 of the bytes is the
            // most significant bit of the first byte, so the n bytes read as one big endian number whose top bits
            // are the field.
            s_bf_read(AM* m, int sh, int w) -> int
            {
                int n = (sh + w + 7) / 8;
                int nn = n;
                int acc, b, k, j;
                if (n > 9) { this.s_fail(g"bit field spans more than 9 bytes\0"); -> 0; };
                if (n == 9) { nn = 8; };
                acc = this.s_bf_be(m, nn);
                if (n == 9)
                {
                    // the ninth byte holds the last bits: the field is the low bits of (first eight bytes, ninth byte) >> k
                    k = 72 - sh - w;
                    b = this.s_nv(0);
                    this.s_memop(A_LD, b, 1, this.s_amoff(m, (i64)8));
                    acc = this.s_alu(L_LSL, 8, acc, 0 - 1, (i64)(8 - k));
                    if (k > 0) { b = this.s_alu(L_LSR, 8, b, 0 - 1, (i64)k); };
                    acc = this.s_alu(L_ORR, 8, acc, b, (i64)0);
                }
                else
                {
                    j = nn * 8 - sh - w;
                    if (j > 0) { acc = this.s_alu(L_LSR, 8, acc, 0 - 1, (i64)j); };
                };
                if (w < 64) { acc = this.s_ext(acc, w, false, 8); };
                -> acc;
            };

            // The nn bytes at m read as one big endian number in a 64 bit register
            s_bf_be(AM* m, int nn) -> int
            {
                int acc, b, j;
                AI* u;
                if (nn == 2 | nn == 4 | nn == 8)
                {
                    acc = this.s_nv(0);
                    this.s_memop(A_LD, acc, nn, m);
                    if (nn == 2)
                    {
                        b = this.s_nv(0);
                        u = this.s_mi(A_UN, 4);
                        u.k = N_REV16;
                        u.d = b;
                        u.a = acc;
                        -> b;
                    };
                    b = this.s_nv(0);
                    u = this.s_mi(A_UN, nn);
                    u.k = N_REV;
                    u.d = b;
                    u.a = acc;
                    -> b;
                };
                acc = this.s_nv(0);
                this.s_memop(A_LD, acc, 1, m);
                j = 1;
                while (j < nn)
                {
                    b = this.s_nv(0);
                    this.s_memop(A_LD, b, 1, this.s_amoff(m, (i64)j));
                    acc = this.s_alu(L_LSL, 8, acc, 0 - 1, (i64)8);
                    acc = this.s_alu(L_ORR, 8, acc, b, (i64)0);
                    j++;
                };
                -> acc;
            };

            // Stores the low w bits of register v into the bit field that starts sh bits into the bytes at m, byte by
            // byte: a whole byte is stored, a partial byte is read, cleared and set.
            s_bf_write(AM* m, int sh, int w, int v) -> void
            {
                int n = (sh + w + 7) / 8;
                int bi, lo, hi, len, kend, ks, t, old;
                AM* mb;
                if (n > 9) { this.s_fail(g"bit field spans more than 9 bytes\0"); ->; };
                bi = 0;
                while (bi < n)
                {
                    lo = sh - 8 * bi;
                    if (lo < 0) { lo = 0; };
                    hi = sh + w - 8 * bi;
                    if (hi > 8) { hi = 8; };
                    len = hi - lo;
                    // the field bits (counted from its first bit) the byte takes
                    kend = 8 * bi + hi - sh;
                    ks = w - kend;
                    t = v;
                    if (ks > 0) { t = this.s_alu(L_LSR, 8, v, 0 - 1, (i64)ks); };
                    mb = this.s_amoff(m, (i64)bi);
                    if (len == 8) { this.s_memop(A_ST, t, 1, mb); }
                    else
                    {
                        t = this.s_alu(L_AND, 8, t, 0 - 1, (i64)((1 << len) - 1));
                        if (8 - hi > 0) { t = this.s_alu(L_LSL, 8, t, 0 - 1, (i64)(8 - hi)); };
                        old = this.s_nv(0);
                        this.s_memop(A_LD, old, 1, mb);
                        old = this.s_alu(L_AND, 8, old, 0 - 1, (i64)(255 `^| (((1 << len) - 1) << (8 - hi))));
                        old = this.s_alu(L_ORR, 8, old, t, (i64)0);
                        this.s_memop(A_ST, old, 1, mb);
                    };
                    bi++;
                };
                ->;
            };

            // Stores of a value over count elements and copies of count elements (SO_FILL and SO_COPY)
            s_isel_fill(SI* x) -> void
            {
                IRValue* cv = this.s_res(x.c);
                int r, ra, rb, t, sh, w, ra2;
                AI* m;
                AM* da = this.s_addr(x.a);
                ra = this.s_amreg(da);
                rb = 0 - 1;
                if (x.op == SO_COPY) { rb = this.s_amreg(this.s_addr(x.b)); };
                r = this.s_vr(cv);
                w = 64;
                if (cv.ty.kind == LK.INT) { w = cv.ty.width; };
                if (w < 64) { r = this.s_ext(r, w, (x.k `& 1) == 1, 8); };
                if ((x.k `& 1) == 1)
                {
                    // a negative count stores nothing
                    t = this.s_alu(L_ASR, 8, r, 0 - 1, (i64)63);
                    m = this.s_mi(A_UN, 8);
                    m.k = N_MVN;
                    ra2 = this.s_nv(0);
                    m.d = ra2;
                    m.a = t;
                    r = this.s_alu(L_AND, 8, r, ra2, (i64)0);
                };
                sh = this.s_pow2((i64)x.sz);
                if (sh > 0) { r = this.s_alu(L_LSL, 8, r, 0 - 1, (i64)sh); }
                elif (x.sz != 1) { r = this.s_alu(L_MUL, 8, r, this.s_movi((i64)x.sz, 8), (i64)0); };
                if (x.op == SO_COPY)
                {
                    this.s_mov(0, ra, 8);
                    this.s_mov(1, rb, 8);
                    this.s_mov(2, r, 8);
                    m = this.s_mi(A_MEMCPY, 8);
                    if (x.k >= 2) { m.k = x.sz; };
                    m.iu = (i64)7;
                    m.id = (i64)15;
                    m.clob = (i64)15;
                    ->;
                };
                this.s_mov(0, ra, 8);
                t = this.s_vr0(x.b);
                this.s_mov(1, t, 8);
                this.s_mov(2, r, 8);
                m = this.s_mi(A_MEMSET, 8);
                m.k = x.sz;
                m.iu = (i64)7;
                m.id = (i64)15;
                m.clob = (i64)15;
                ->;
            };

            // ----------------------------------------------------------
            // Integer operations
            // ----------------------------------------------------------

            s_isel_bin(SI* x) -> void
            {
                IRType* t = x.ty;
                IRValue* a = this.s_res(x.a);
                IRValue* b = this.s_res(x.b);
                int k = x.k;
                int sz, w, ra, rb, d, q, fk;
                i64 r;
                bool sgn;
                AI* m;
                if (this.s_isfp(t))
                {
                    sz = this.s_vsz(t);
                    ra = this.s_vr(a);
                    rb = this.s_vr(b);
                    if (k == SB_FREM)
                    {
                        q = this.s_nv(1);
                        m = this.s_mi(A_FALU, sz);
                        m.k = FA_DIV;
                        m.d = q;
                        m.a = ra;
                        m.b = rb;
                        d = this.s_nv(1);
                        m = this.s_mi(A_FUN, sz);
                        m.k = FU_RINTZ;
                        m.d = d;
                        m.a = q;
                        q = this.s_def(x.res, 1);
                        m = this.s_mi(A_FMSUB, sz);
                        m.d = q;
                        m.a = d;
                        m.b = rb;
                        m.c = ra;
                        ->;
                    };
                    fk = 0;
                    if (k == SB_FADD) { fk = FA_ADD; };
                    if (k == SB_FSUB) { fk = FA_SUB; };
                    if (k == SB_FMUL) { fk = FA_MUL; };
                    if (k == SB_FDIV) { fk = FA_DIV; };
                    if (fk == 0) { this.s_fail(g"float operation\0"); ->; };
                    d = this.s_def(x.res, 1);
                    m = this.s_mi(A_FALU, sz);
                    m.k = fk;
                    m.d = d;
                    m.a = ra;
                    m.b = rb;
                    ->;
                };
                if (t.kind != LK.INT & t.kind != LK.PTR) { this.s_fail(g"binary operation type\0"); ->; };
                w = this.s_wid(t);
                if (w > 64) { this.s_fail(g"wide arithmetic\0"); ->; };
                sz = this.s_isz(t);
                if (k == SB_SDIV | k == SB_UDIV | k == SB_SREM | k == SB_UREM)
                {
                    sgn = k == SB_SDIV | k == SB_SREM;
                    ra = this.s_vr(a);
                    rb = this.s_vr(b);
                    if (w != 32 & w != 64)
                    {
                        ra = this.s_ext(ra, w, sgn, sz);
                        rb = this.s_ext(rb, w, sgn, sz);
                    };
                    if (sgn) { q = this.s_alu(L_SDIV, sz, ra, rb, (i64)0); }
                    else { q = this.s_alu(L_UDIV, sz, ra, rb, (i64)0); };
                    d = this.s_def(x.res, 0);
                    if (k == SB_SDIV | k == SB_UDIV)
                    {
                        this.s_mov(d, q, sz);
                        ->;
                    };
                    m = this.s_mi(A_MADD, sz);
                    m.k = 1;
                    m.d = d;
                    m.a = q;
                    m.b = rb;
                    m.c = ra;
                    ->;
                };
                if (k == SB_LSHR | k == SB_ASHR)
                {
                    ra = this.s_vr(a);
                    if (w != 32 & w != 64) { ra = this.s_ext(ra, w, k == SB_ASHR, sz); };
                    if (this.s_kint(b))
                    {
                        d = this.s_def(x.res, 0);
                        m = this.s_mi(A_ALU, sz);
                        if (k == SB_LSHR) { m.k = L_LSR; } else { m.k = L_ASR; };
                        m.d = d;
                        m.a = ra;
                        m.imm = this.scv;
                        ->;
                    };
                    rb = this.s_vr(b);
                    d = this.s_def(x.res, 0);
                    m = this.s_mi(A_ALU, sz);
                    if (k == SB_LSHR) { m.k = L_LSR; } else { m.k = L_ASR; };
                    m.d = d;
                    m.a = ra;
                    m.b = rb;
                    ->;
                };
                fk = 0;
                if (k == SB_ADD) { fk = L_ADD; };
                if (k == SB_SUB) { fk = L_SUB; };
                if (k == SB_MUL) { fk = L_MUL; };
                if (k == SB_AND) { fk = L_AND; };
                if (k == SB_OR) { fk = L_ORR; };
                if (k == SB_XOR) { fk = L_EOR; };
                if (k == SB_SHL) { fk = L_LSL; };
                if (fk == 0) { this.s_fail(g"integer operation\0"); ->; };
                if (this.s_kint(b) & fk != L_MUL)
                {
                    ra = this.s_vr(a);
                    d = this.s_def(x.res, 0);
                    m = this.s_mi(A_ALU, sz);
                    m.k = fk;
                    m.d = d;
                    m.a = ra;
                    m.imm = this.scv;
                    ->;
                };
                if (this.s_kint(a) & fk != L_MUL & fk != L_SUB & fk != L_LSL)
                {
                    // a constant on the left of a commutative operation
                    r = this.scv;
                    rb = this.s_vr(b);
                    d = this.s_def(x.res, 0);
                    m = this.s_mi(A_ALU, sz);
                    m.k = fk;
                    m.d = d;
                    m.a = rb;
                    m.imm = r;
                    ->;
                };
                ra = this.s_vr0(a);
                rb = this.s_vr0(b);
                d = this.s_def(x.res, 0);
                m = this.s_mi(A_ALU, sz);
                m.k = fk;
                m.d = d;
                m.a = ra;
                m.b = rb;
                ->;
            };

            // ----------------------------------------------------------
            // Compares and conditions
            // ----------------------------------------------------------

            // Condition code of integer predicate p
            s_icc(int p) -> int
            {
                if (p == SP_EQ) { -> CC_EQ; };
                if (p == SP_NE) { -> CC_NE; };
                if (p == SP_ULT) { -> CC_LO; };
                if (p == SP_ULE) { -> CC_LS; };
                if (p == SP_UGT) { -> CC_HI; };
                if (p == SP_UGE) { -> CC_HS; };
                if (p == SP_SLT) { -> CC_LT; };
                if (p == SP_SLE) { -> CC_LE; };
                if (p == SP_SGT) { -> CC_GT; };
                -> CC_GE;
            };

            // Conditions of float predicate p: the result is the first, fcc2 the second or -1 when the first
            // alone decides. 0 - 2 is returned for the constant predicates.
            s_fcc(int p) -> int
            {
                this.fcc2 = 0 - 1;
                if (p == SP_OEQ) { -> CC_EQ; };
                if (p == SP_ONE) { this.fcc2 = CC_GT; -> CC_MI; };
                if (p == SP_OGT) { -> CC_GT; };
                if (p == SP_OGE) { -> CC_GE; };
                if (p == SP_OLT) { -> CC_MI; };
                if (p == SP_OLE) { -> CC_LS; };
                if (p == SP_ORD) { -> CC_VC; };
                if (p == SP_UNO) { -> CC_VS; };
                if (p == SP_UEQ) { this.fcc2 = CC_VS; -> CC_EQ; };
                if (p == SP_UNE) { -> CC_NE; };
                if (p == SP_UGT_F) { -> CC_HI; };
                if (p == SP_UGE_F) { -> CC_PL; };
                if (p == SP_ULT_F) { -> CC_LT; };
                if (p == SP_ULE_F) { -> CC_LE; };
                if (p == SP_FALSE | p == SP_TRUE) { -> 0 - 2; };
                this.s_fail(g"float predicate\0");
                -> CC_EQ;
            };

            // True when the compare x is decided by one condition
            s_csingle(SI* x) -> bool
            {
                int c;
                if (x.n == 0) { -> true; };
                c = this.s_fcc(x.k);
                -> c >= 0 & this.fcc2 < 0;
            };

            // Emits the compare x and returns the condition under which it holds
            s_cmpflags(SI* x) -> int
            {
                IRValue* a = this.s_res(x.a);
                IRValue* b = this.s_res(x.b);
                IRType* t = a.ty;
                int p = x.k;
                int w, sz, ra, rb, cc;
                bool sgn;
                AI* m;
                this.fcc2 = 0 - 1;
                if (x.n == 1)
                {
                    cc = this.s_fcc(p);
                    if (cc < 0) { -> cc; };
                    sz = this.s_vsz(t);
                    ra = this.s_vr(a);
                    rb = this.s_vr(b);
                    m = this.s_mi(A_FCMP, sz);
                    m.a = ra;
                    m.b = rb;
                    -> cc;
                };
                if (t.kind != LK.INT & t.kind != LK.PTR) { this.s_fail(g"compare type\0"); -> CC_EQ; };
                w = this.s_wid(t);
                if (w > 64) { this.s_fail(g"wide compare\0"); -> CC_EQ; };
                sz = this.s_isz(t);
                sgn = p == SP_SLT | p == SP_SLE | p == SP_SGT | p == SP_SGE;
                ra = this.s_vr(a);
                if (w != 32 & w != 64) { ra = this.s_ext(ra, w, sgn, sz); };
                if (this.s_kint(b))
                {
                    m = this.s_mi(A_CMP, sz);
                    m.a = ra;
                    m.imm = this.scv;
                    if (sgn) { m.imm = this.s_sx((u64)this.scv, w); };
                    -> this.s_icc(p);
                };
                rb = this.s_vr(b);
                if (w != 32 & w != 64) { rb = this.s_ext(rb, w, sgn, sz); };
                m = this.s_mi(A_CMP, sz);
                m.a = ra;
                m.b = rb;
                -> this.s_icc(p);
            };

            // Register with the 0 or 1 result of the compare x
            s_cmpval(SI* x) -> int
            {
                int cc, d, t1, t2;
                AI* m;
                cc = this.s_cmpflags(x);
                if (this.gwhy != 0) { -> 0; };
                if (cc == 0 - 2)
                {
                    if (x.k == SP_TRUE) { -> this.s_movi((i64)1, 4); };
                    -> this.s_movi((i64)0, 4);
                };
                d = this.s_nv(0);
                m = this.s_mi(A_CSET, 4);
                m.d = d;
                m.cc = cc;
                if (this.fcc2 >= 0)
                {
                    t1 = this.s_nv(0);
                    m = this.s_mi(A_CSET, 4);
                    m.d = t1;
                    m.cc = this.fcc2;
                    t2 = this.s_alu(L_ORR, 4, d, t1, (i64)0);
                    -> t2;
                };
                -> d;
            };

            s_isel_cmp(SI* x) -> void
            {
                int r, d;
                if (x.flag) { ->; };
                r = this.s_cmpval(x);
                if (this.gwhy != 0) { ->; };
                d = this.s_def(x.res, 0);
                this.s_mov(d, r, 4);
                ->;
            };

            // Condition under which the i1 value c holds, after emitting the instruction that sets the flags
            s_cond(IRValue* c) -> int
            {
                IRValue* v = this.s_res(c);
                SI* d;
                int r;
                AI* m;
                if (v.di != (void*)0 & !v.kc)
                {
                    d = (SI*)v.di;
                    if (d.flag & d.op == SO_CMP) { -> this.s_cmpflags(d); };
                };
                r = this.s_vr(v);
                m = this.s_mi(A_TST, 4);
                m.a = r;
                m.imm = (i64)1;
                this.fcc2 = 0 - 1;
                -> CC_NE;
            };

            s_isel_br(SI* x) -> void
            {
                AI* m = this.s_mi(A_B, 0);
                m.tgt = x.t.id;
                ->;
            };

            s_isel_cbr(SI* x) -> void
            {
                IRValue* c = this.s_res(x.a);
                SI* d;
                AI* m;
                int cc, c2, tt, ff, w, r, sz;
                IRValue* b;
                tt = x.t.id;
                ff = x.f.id;
                if (x.k == 1)
                {
                    tt = x.f.id;
                    ff = x.t.id;
                };
                if (A64_OPT_CBZ == 1 & c.di != (void*)0 & !c.kc)
                {
                    d = (SI*)c.di;
                    if (d.flag & d.op == SO_CMP & d.n == 0 & (d.k == SP_EQ | d.k == SP_NE))
                    {
                        b = this.s_res(d.b);
                        if (this.s_kint(b) & this.scv == (i64)0)
                        {
                            w = this.s_wid(this.s_res(d.a).ty);
                            sz = this.s_isz(this.s_res(d.a).ty);
                            r = this.s_vr(d.a);
                            if (w != 32 & w != 64) { r = this.s_ext(r, w, false, sz); };
                            if (d.k == SP_EQ) { m = this.s_mi(A_CBZ, sz); } else { m = this.s_mi(A_CBNZ, sz); };
                            m.a = r;
                            m.tgt = tt;
                            m = this.s_mi(A_B, 0);
                            m.tgt = ff;
                            ->;
                        };
                    };
                };
                cc = this.s_cond(c);
                if (this.gwhy != 0) { ->; };
                c2 = this.fcc2;
                if (cc == 0 - 2)
                {
                    // constant predicate
                    d = (SI*)c.di;
                    m = this.s_mi(A_B, 0);
                    if (d.k == SP_TRUE) { m.tgt = tt; } else { m.tgt = ff; };
                    ->;
                };
                m = this.s_mi(A_BC, 0);
                m.cc = cc;
                m.tgt = tt;
                if (c2 >= 0)
                {
                    m = this.s_mi(A_BC, 0);
                    m.cc = c2;
                    m.tgt = tt;
                };
                m = this.s_mi(A_B, 0);
                m.tgt = ff;
                ->;
            };

            s_isel_select(SI* x) -> void
            {
                IRType* t = x.ty;
                IRValue* c = this.s_res(x.a);
                int ra, rb, d, cc, c2, cls, sz, t1;
                AI* m;
                bool fp = this.s_isfp(t);
                if (!fp & t.kind != LK.INT & t.kind != LK.PTR) { this.s_fail(g"select type\0"); ->; };
                if (t.kind == LK.INT)
                {
                    if (t.width > 64) { this.s_fail(g"wide select\0"); ->; };
                };
                ra = this.s_vr0(x.b);
                rb = this.s_vr0(x.c);
                cc = this.s_cond(c);
                if (this.gwhy != 0) { ->; };
                c2 = this.fcc2;
                if (cc == 0 - 2)
                {
                    this.s_fail(g"constant select\0");
                    ->;
                };
                cls = 0;
                sz = this.s_isz(t);
                if (fp)
                {
                    cls = 1;
                    sz = this.s_vsz(t);
                    if (ra == AR_ZR) { ra = this.s_fconst(this.s_res(x.b)); };
                    if (rb == AR_ZR) { rb = this.s_fconst(this.s_res(x.c)); };
                };
                d = this.s_def(x.res, cls);
                if (fp) { m = this.s_mi(A_FCSEL, sz); } else { m = this.s_mi(A_CSEL, sz); };
                m.d = d;
                m.a = ra;
                m.b = rb;
                m.cc = cc;
                if (c2 >= 0)
                {
                    // a second condition also selects the first value
                    t1 = this.s_nv(cls);
                    if (fp) { m = this.s_mi(A_FCSEL, sz); } else { m = this.s_mi(A_CSEL, sz); };
                    m.d = t1;
                    m.a = ra;
                    m.b = d;
                    m.cc = c2;
                    this.s_mov(d, t1, sz);
                };
                ->;
            };

            // ----------------------------------------------------------
            // Casts
            // ----------------------------------------------------------

            s_isel_cast(SI* x) -> void
            {
                IRValue* v = this.s_res(x.a);
                IRType* fty = v.ty;
                IRType* to = x.ty;
                int k = x.k;
                int wf, wt, r, d, sz;
                AI* m;
                if (k == SK_BITCAST | k == SK_PTRTOINT | k == SK_INTTOPTR | k == SK_TRUNC | k == SK_ZEXT | k == SK_SEXT)
                {
                    if (this.s_isagg(fty) | this.s_isagg(to)) { this.s_fail(g"aggregate cast\0"); ->; };
                    if (this.s_isfp(fty) & this.s_isfp(to))
                    {
                        // a bitcast between float types of one size
                        r = this.s_vr(v);
                        d = this.s_def(x.res, 1);
                        this.s_mov(d, r, this.s_vsz(to));
                        ->;
                    };
                    if (this.s_isfp(fty) | this.s_isfp(to))
                    {
                        sz = this.s_vsz(fty);
                        if (this.s_isfp(to)) { sz = this.s_vsz(to); };
                        r = this.s_vr0(v);
                        if (r == AR_ZR)
                        {
                            r = this.s_movi((i64)0, 8);
                        };
                        d = this.s_def(x.res, this.s_cls(to));
                        m = this.s_mi(A_FMOVX, sz);
                        m.d = d;
                        m.a = r;
                        ->;
                    };
                    wf = this.s_wid(fty);
                    wt = this.s_wid(to);
                    if (wf > 64 | wt > 64) { this.s_fail(g"wide cast\0"); ->; };
                    r = this.s_vr(v);
                    if (k == SK_ZEXT | k == SK_SEXT | k == SK_INTTOPTR)
                    {
                        sz = 8;
                        if (wt <= 32) { sz = 4; };
                        d = this.s_ext(r, wf, k == SK_SEXT, sz);
                        if (d == r)
                        {
                            d = this.s_def(x.res, 0);
                            this.s_mov(d, r, sz);
                            ->;
                        };
                        x.res.vr = d;
                        ->;
                    };
                    d = this.s_def(x.res, 0);
                    sz = 8;
                    if (wt <= 32) { sz = 4; };
                    this.s_mov(d, r, sz);
                    ->;
                };
                if (k == SK_FPEXT | k == SK_FPTRUNC)
                {
                    r = this.s_vr(v);
                    d = this.s_def(x.res, 1);
                    m = this.s_mi(A_FCVT, this.s_vsz(to));
                    m.d = d;
                    m.a = r;
                    m.cc = this.s_vsz(fty);
                    ->;
                };
                if (k == SK_SITOFP | k == SK_UITOFP)
                {
                    wf = this.s_wid(fty);
                    if (wf > 64) { this.s_fail(g"wide conversion\0"); ->; };
                    sz = 8;
                    if (wf <= 32) { sz = 4; };
                    r = this.s_vr(v);
                    r = this.s_ext(r, wf, k == SK_SITOFP, sz);
                    d = this.s_def(x.res, 1);
                    m = this.s_mi(A_CVT, sz);
                    if (k == SK_SITOFP) { m.k = CV_SCVTF; } else { m.k = CV_UCVTF; };
                    m.d = d;
                    m.a = r;
                    m.cc = this.s_vsz(to);
                    ->;
                };
                if (k == SK_FPTOSI | k == SK_FPTOUI)
                {
                    wt = this.s_wid(to);
                    if (wt > 64) { this.s_fail(g"wide conversion\0"); ->; };
                    sz = 8;
                    if (wt <= 32) { sz = 4; };
                    r = this.s_vr(v);
                    d = this.s_def(x.res, 0);
                    m = this.s_mi(A_CVT, sz);
                    if (k == SK_FPTOSI) { m.k = CV_FCVTZS; } else { m.k = CV_FCVTZU; };
                    m.d = d;
                    m.a = r;
                    m.cc = this.s_vsz(fty);
                    ->;
                };
                this.s_fail(g"cast\0");
                ->;
            };

            // ----------------------------------------------------------
            // Calls
            // ----------------------------------------------------------

            // The llvm intrinsics that become instructions
            s_intrin(SI* x, byte* sym) -> void
            {
                IRType* t;
                int r, d, k, w, sz, ra, rb, rc;
                AI* m;
                AM* ml;
                k = 0;
                if (this.a_pre(sym, g"llvm.trap\0") | this.a_pre(sym, g"llvm.debugtrap\0"))
                {
                    this.s_mi(A_BRK, 0);
                    ->;
                };
                if (this.a_pre(sym, g"llvm.bswap.i\0"))
                {
                    t = x.ty;
                    if (t.kind != LK.INT | x.n != 1) { this.s_fail(sym); ->; };
                    if (t.width != 16 & t.width != 32 & t.width != 64) { this.s_fail(sym); ->; };
                    r = this.s_vr(x.args[0]);
                    d = this.s_def(x.res, 0);
                    sz = 4;
                    if (t.width == 64) { sz = 8; };
                    m = this.s_mi(A_UN, sz);
                    m.k = N_REV;
                    if (t.width == 16) { m.k = N_REV16; };
                    m.d = d;
                    m.a = r;
                    ->;
                };
                if (this.a_pre(sym, g"llvm.bitreverse.i\0"))
                {
                    t = x.ty;
                    if (t.kind != LK.INT | x.n != 1) { this.s_fail(sym); ->; };
                    if (t.width != 8 & t.width != 16 & t.width != 32 & t.width != 64) { this.s_fail(sym); ->; };
                    r = this.s_vr(x.args[0]);
                    sz = 4;
                    if (t.width == 64) { sz = 8; };
                    k = this.s_nv(0);
                    m = this.s_mi(A_UN, sz);
                    m.k = N_RBIT;
                    m.d = k;
                    m.a = r;
                    if (t.width < 32) { k = this.s_alu(L_LSR, 4, k, 0 - 1, (i64)(32 - t.width)); };
                    d = this.s_def(x.res, 0);
                    this.s_mov(d, k, sz);
                    ->;
                };
                if (this.a_pre(sym, g"llvm.va_start\0"))
                {
                    r = this.s_vr(x.args[0]);
                    d = this.s_nv(0);
                    m = this.s_mi(A_ADDFO, 8);
                    m.d = d;
                    m.ma = 1;
                    m.imm = (i64)((AGF*)this.sf.tg).vastk;
                    ml = this.s_am();
                    ml.b = r;
                    this.s_memop(A_ST, d, 8, ml);
                    ->;
                };
                if (this.a_pre(sym, g"llvm.va_end\0")) { ->; };
                if (this.a_pre(sym, g"llvm.va_copy\0"))
                {
                    ra = this.s_vr(x.args[0]);
                    rb = this.s_vr(x.args[1]);
                    rc = this.s_nv(0);
                    ml = this.s_am();
                    ml.b = rb;
                    this.s_memop(A_LD, rc, 8, ml);
                    ml = this.s_am();
                    ml.b = ra;
                    this.s_memop(A_ST, rc, 8, ml);
                    ->;
                };
                if (this.a_pre(sym, g"llvm.memset.\0")) { k = 1; };
                if (this.a_pre(sym, g"llvm.memcpy.\0")) { k = 2; };
                if (this.a_pre(sym, g"llvm.memmove.\0")) { k = 3; };
                if (k == 0 | x.n < 3) { this.s_fail(sym); ->; };
                ra = this.s_vr(x.args[0]);
                rb = this.s_vr0(x.args[1]);
                rc = this.s_vr(x.args[2]);
                w = this.s_wid(this.s_res(x.args[2]).ty);
                if (w < 64) { rc = this.s_ext(rc, w, false, 8); };
                this.s_mov(0, ra, 8);
                this.s_mov(1, rb, 8);
                this.s_mov(2, rc, 8);
                if (k == 1) { m = this.s_mi(A_MEMSET, 8); }
                elif (k == 2) { m = this.s_mi(A_MEMCPY, 8); }
                else { m = this.s_mi(A_MEMMOVE, 8); };
                m.iu = (i64)7;
                m.id = (i64)15;
                m.clob = (i64)15;
                ->;
            };

            // Registers a call destroys: x0..x15, x18, x30, v0..v7 and v16..v31
            s_clob() -> i64
            {
                -> (i64)(65535 `| 262144 `| (1 << 30)) `| ((i64)255 << (i64)32) `| ((i64)65535 << (i64)48);
            };

            s_isel_call(SI* x) -> void
            {
                IRValue* callee = this.s_res(x.a);
                IRType* fty = callee.ty.elem;
                IRType* rt = x.ty;
                IRValue* a;
                int* src;
                int* loc;
                int* off;
                int* kind;
                byte* sym;
                int i, r, sz, d, ints, fps, stk, rfo, nm, afo;
                i64 mask;
                bool direct = false;
                bool fp, vsl;
                AI* m;
                AM* am;
                sym = (byte*)0;
                if (this.a_pre(callee.text, g"asm\0")) { this.s_inline(x, callee); ->; };
                if (fty.kind != LK.FUNC) { this.s_fail(g"callee type\0"); ->; };
                if (rt.kind != LK.VOID & !this.s_isarg(rt) & !this.s_isagg(rt)) { this.s_fail(g"call result type\0"); ->; };
                if (callee.vr == 0 & callee.di == (void*)0)
                {
                    if (this.s_isc(callee))
                    {
                        if (this.sck == CK_SYM & this.scv == (i64)0)
                        {
                            direct = true;
                            sym = this.scs;
                        };
                    };
                };
                if (this.gwhy != 0) { ->; };
                if (direct)
                {
                    if (this.a_pre(sym, g"llvm.\0") | this.a_pre(sym, g"ideka.\0")) { this.s_intrin(x, sym); ->; };
                };
                i = 0;
                while (i < x.n)
                {
                    a = this.s_res(x.args[i]);
                    if (!this.s_isarg(a.ty) & !this.s_isagg(a.ty)) { this.s_fail(g"call argument type\0"); ->; };
                    i++;
                };
                ((AGF*)this.sf.tg).leaf = false;
                src = this.s_iz(x.n + 1);
                loc = this.s_iz(x.n + 1);
                off = this.s_iz(x.n + 1);
                nm = fty.nitems;
                ints = 0;
                fps = 0;
                stk = 0;
                rfo = 0;
                if (this.s_isagg(rt)) { rfo = this.s_newfo(this.a_size(rt), this.a_align(rt)); };
                // operands first: they may need instructions of their own
                i = 0;
                while (i < x.n)
                {
                    a = this.s_res(x.args[i]);
                    vsl = fty.vararg & i >= nm;
                    if (this.s_isagg(a.ty))
                    {
                        src[i] = 0 - 1;
                        loc[i] = 0 - 1;
                        off[i] = stk;
                        stk = stk + (this.a_size(a.ty) + 7) / 8 * 8;
                    }
                    else
                    {
                        fp = this.s_isfp(a.ty);
                        src[i] = this.s_vr0(a);
                        if (fp & src[i] == AR_ZR) { src[i] = this.s_fconst(a); };
                        loc[i] = 0 - 1;
                        if (!vsl)
                        {
                            if (fp & fps < 8) { loc[i] = 32 + fps; fps++; }
                            elif (!fp & ints < 8) { loc[i] = ints; ints++; };
                        };
                        if (loc[i] < 0)
                        {
                            off[i] = stk;
                            stk = stk + 8;
                        };
                    };
                    i++;
                };
                r = 0 - 1;
                if (!direct) { r = this.s_vr(callee); };
                if (this.gwhy != 0) { this.s_ifree(src); this.s_ifree(loc); this.s_ifree(off); ->; };
                if (stk > ((AGF*)this.sf.tg).outmax) { ((AGF*)this.sf.tg).outmax = stk; };
                // stack arguments
                i = 0;
                while (i < x.n)
                {
                    a = this.s_res(x.args[i]);
                    if (loc[i] < 0)
                    {
                        am = this.s_am();
                        am.b = 31;
                        am.imm = (i64)off[i];
                        if (this.s_isagg(a.ty)) { this.s_agg_to(a, am); }
                        else
                        {
                            sz = 8;
                            if (this.s_isfp(a.ty)) { sz = this.s_vsz(a.ty); };
                            this.s_memop(A_ST, src[i], sz, am);
                        };
                    };
                    i++;
                };
                // register arguments
                mask = (i64)0;
                i = 0;
                while (i < x.n)
                {
                    if (loc[i] >= 0)
                    {
                        a = this.s_res(x.args[i]);
                        sz = 8;
                        if (this.s_isfp(a.ty)) { sz = this.s_vsz(a.ty); };
                        this.s_mov(loc[i], src[i], sz);
                        mask = mask `| ((i64)1 << (i64)loc[i]);
                    };
                    i++;
                };
                if (rfo > 0)
                {
                    d = this.s_nv(0);
                    m = this.s_mi(A_ADDFO, 8);
                    m.d = d;
                    m.fo = rfo - 1;
                    this.s_mov(8, d, 8);
                    mask = mask `| ((i64)1 << (i64)8);
                };
                if (direct)
                {
                    m = this.s_mi(A_BL, 0);
                    m.sym = sym;
                }
                else
                {
                    m = this.s_mi(A_BLR, 0);
                    m.a = r;
                };
                m.iu = mask;
                m.clob = this.s_clob();
                m.id = m.clob;
                if (rfo > 0) { x.res.fo = rfo; };
                if (rt.kind != LK.VOID & rfo == 0)
                {
                    sz = this.s_vsz(rt);
                    if (this.s_isfp(rt))
                    {
                        d = this.s_def(x.res, 1);
                        this.s_mov(d, 32, sz);
                    }
                    else
                    {
                        d = this.s_def(x.res, 0);
                        if (sz < 4) { sz = 4; };
                        this.s_mov(d, 0, sz);
                    };
                };
                this.s_ifree(src);
                this.s_ifree(loc);
                this.s_ifree(off);
                ->;
            };

            // Inline assembly
            // Hardware register number named by a constraint item such as x8 or w0, -1 for anything else
            a_regidx(byte* nm) -> int
            {
                int i = 1;
                int n = 0;
                int nd = 0;
                if (nm[0] != 'x' & nm[0] != 'w') { -> 0 - 1; };
                while (nm[i] >= 48 & nm[i] <= 57)
                {
                    n = n * 10 + ((int)nm[i] - 48);
                    nd++;
                    i++;
                };
                if (nd == 0 | nm[i] != 0 | n > 30) { -> 0 - 1; };
                -> n;
            };

            // A register for an operand that names none: x9 to x15, then x0 to x7, not in used
            a_pick(i64 used) -> int
            {
                int r = 9;
                while (r < 16)
                {
                    if ((used `& ((i64)1 << (i64)r)) == (i64)0) { -> r; };
                    r++;
                };
                r = 0;
                while (r < 8)
                {
                    if ((used `& ((i64)1 << (i64)r)) == (i64)0) { -> r; };
                    r++;
                };
                this.s_fail(g"inline asm registers\0");
                -> 9;
            };

            // Inline assembly. Every operand is pinned to a hardware register: inputs are copied there first, the
            // text names the registers, outputs are copied out afterwards.
            s_inline(SI* x, IRValue* callee) -> void
            {
                byte* t = callee.text;
                IRType* fty = callee.ty.elem;
                IRType* rt = fty.elem;
                IRValue* a;
                AI* m;
                byte* body;
                int len, i, j, bs, ce, qs, bodyend, no, ni, nop, cb, ce2, k, c, r, sz, d, bl;
                i64 used, imask, omask;
                bool brace;
                int modc;
                int[24] opreg = noinit;
                int[24] opkind = noinit;
                int[24] opty = noinit;
                int[24] opsrc = noinit;
                len = 0;
                while (t[len] != 0) { len++; };
                while (len > 0 & t[len - 1] != 34) { len--; };
                ce = len - 1;
                qs = ce - 1;
                while (qs > 0 & t[qs] != 34) { qs--; };
                bodyend = qs - 3;
                bs = 0;
                while (t[bs] != 34) { bs++; };
                bs++;
                i = qs + 1;
                nop = 0;
                no = 0;
                ni = 0;
                used = (i64)0;
                while (i < ce)
                {
                    cb = i;
                    while (i < ce & t[i] != ',') { i++; };
                    ce2 = i;
                    if (t[cb] == '~')
                    {
                        this.tb.clear();
                        j = cb + 2;
                        while (j < ce2 & t[j] != '}') { this.tb.put((int)t[j]); j++; };
                        r = this.a_regidx(this.tb.mem);
                        if (r >= 0) { used = used `| ((i64)1 << (i64)r); };
                        // a vector register v0 to v31 (or its d, q and s views) is register 32 + n
                        if (r < 0 & (this.tb.mem[0] == 'v' | this.tb.mem[0] == 'd' | this.tb.mem[0] == 'q' | this.tb.mem[0] == 's'))
                        {
                            r = 0;
                            k = 1;
                            while (this.tb.mem[k] >= 48 & this.tb.mem[k] <= 57)
                            {
                                r = r * 10 + ((int)this.tb.mem[k] - 48);
                                k++;
                            };
                            if (k > 1 & this.tb.mem[k] == 0 & r < 32) { used = used `| ((i64)1 << (i64)(32 + r)); };
                        };
                    }
                    elif (t[cb] == '=')
                    {
                        if (nop >= 24) { this.s_fail(g"inline asm operands\0"); ->; };
                        opkind[nop] = 1;
                        opreg[nop] = 0 - 1;
                        j = cb + 1;
                        while (j < ce2)
                        {
                            if (t[j] == '{')
                            {
                                this.tb.clear();
                                j++;
                                while (j < ce2 & t[j] != '}') { this.tb.put((int)t[j]); j++; };
                                r = this.a_regidx(this.tb.mem);
                                if (r < 0) { this.s_fail(g"inline asm register\0"); ->; };
                                opreg[nop] = r;
                                used = used `| ((i64)1 << (i64)r);
                            };
                            if (t[j] == 'm' | t[j] == 'w') { this.s_fail(g"inline asm output kind\0"); ->; };
                            j++;
                        };
                        nop++;
                        no++;
                    }
                    else
                    {
                        if (nop >= 24) { this.s_fail(g"inline asm operands\0"); ->; };
                        opkind[nop] = 2;
                        opreg[nop] = 0 - 1;
                        if (t[cb] == 'm' | t[cb] == 'w') { this.s_fail(g"inline asm input kind\0"); ->; };
                        if (t[cb] == '{')
                        {
                            this.tb.clear();
                            j = cb + 1;
                            while (j < ce2 & t[j] != '}') { this.tb.put((int)t[j]); j++; };
                            r = this.a_regidx(this.tb.mem);
                            if (r < 0) { this.s_fail(g"inline asm register\0"); ->; };
                            opreg[nop] = r;
                            used = used `| ((i64)1 << (i64)r);
                        };
                        if (t[cb] >= 48 & t[cb] <= 57)
                        {
                            opkind[nop] = 4;
                            opreg[nop] = (int)t[cb] - 48;
                        };
                        if (t[cb] == 'i' | t[cb] == 'n') { opkind[nop] = 5; };
                        nop++;
                        ni++;
                    };
                    i = ce2 + 1;
                };
                if (no > 1) { this.s_fail(g"inline asm outputs\0"); ->; };
                if (x.n != ni) { this.s_fail(g"inline asm operands\0"); ->; };
                if (no == 1)
                {
                    if (!this.s_isarg(rt) | this.s_isfp(rt)) { this.s_fail(g"inline asm result\0"); ->; };
                    opty[0] = this.s_vsz(rt);
                };
                i = 0;
                while (i < ni)
                {
                    a = this.s_res(x.args[i]);
                    if (opkind[no + i] != 5)
                    {
                        if (!this.s_isarg(a.ty) | this.s_isfp(a.ty)) { this.s_fail(g"inline asm operand type\0"); ->; };
                    };
                    opty[no + i] = this.s_vsz(a.ty);
                    i++;
                };
                // outputs without a register, then inputs without one
                i = 0;
                while (i < no)
                {
                    if (opreg[i] < 0)
                    {
                        r = this.a_pick(used);
                        opreg[i] = r;
                        used = used `| ((i64)1 << (i64)r);
                    };
                    i++;
                };
                i = no;
                while (i < nop)
                {
                    if (opkind[i] == 4)
                    {
                        k = opreg[i];
                        if (k >= no) { this.s_fail(g"inline asm tied operand\0"); ->; };
                        opreg[i] = opreg[k];
                    }
                    elif (opkind[i] == 2 & opreg[i] < 0)
                    {
                        r = this.a_pick(used);
                        opreg[i] = r;
                        used = used `| ((i64)1 << (i64)r);
                    };
                    i++;
                };
                if (this.gwhy != 0) { ->; };
                // operands first: they may need instructions of their own
                i = 0;
                while (i < ni)
                {
                    a = this.s_res(x.args[i]);
                    opsrc[no + i] = 0 - 1;
                    if (opkind[no + i] == 5)
                    {
                        if (!this.s_kint(a)) { this.s_fail(g"inline asm constant\0"); ->; };
                    }
                    else
                    {
                        r = this.s_vr(a);
                        if (opty[no + i] < 4) { r = this.s_ext(r, opty[no + i] * 8, false, 4); };
                        opsrc[no + i] = r;
                    };
                    i++;
                };
                if (this.gwhy != 0) { ->; };
                imask = (i64)0;
                i = no;
                while (i < nop)
                {
                    if (opkind[i] != 5)
                    {
                        sz = 8;
                        this.s_mov(opreg[i], opsrc[i], sz);
                        imask = imask `| ((i64)1 << (i64)opreg[i]);
                    };
                    i++;
                };
                // body text, one tab indented line per source line
                this.mb.clear();
                this.mb.put(9);
                i = bs;
                while (i < bodyend)
                {
                    c = (int)t[i];
                    if (c == '$')
                    {
                        if (t[i + 1] == '$') { this.mb.put(36); i = i + 2; }
                        else
                        {
                            i++;
                            brace = false;
                            modc = 0;
                            if (t[i] == '{') { brace = true; i++; };
                            k = 0;
                            while (t[i] >= 48 & t[i] <= 57) { k = k * 10 + ((int)t[i] - 48); i++; };
                            if (brace)
                            {
                                if (t[i] == ':') { i++; modc = (int)t[i]; i++; };
                                if (t[i] == '}') { i++; };
                            };
                            if (k >= nop) { this.s_fail(g"inline asm operand number\0"); ->; };
                            sz = opty[k];
                            if (modc == 'x') { sz = 8; };
                            if (modc == 'w') { sz = 4; };
                            if (opkind[k] == 5)
                            {
                                this.s_kint(x.args[k - no]);
                                put_i64(@this.mb, this.scv);
                            }
                            else { this.e_r(@this.mb, opreg[k], sz); };
                        };
                    }
                    else
                    {
                        if (c == 10) { this.mb.put(10); this.mb.put(9); }
                        else { this.mb.put(c); };
                        i++;
                    };
                };
                bl = this.mb.len;
                body = this.s_ar(bl + 1);
                i = 0;
                while (i < bl) { body[i] = this.mb.mem[i]; i++; };
                body[bl] = 0;
                // registers the asm writes: outputs and everything it names
                omask = used;
                m = this.s_mi(A_ASM, 8);
                m.text = body;
                m.iu = imask;
                m.clob = omask;
                ((AGF*)this.sf.tg).leaf = false;
                if (no == 1)
                {
                    sz = opty[0];
                    d = this.s_def(x.res, 0);
                    this.s_mov(d, opreg[0], sz);
                };
                ->;
            };

            // @->: the link register is saved at [x29, #8], so the function gets a frame even when it is a leaf
            s_isel_retaddr(SI* x) -> void
            {
                int d = this.s_def(x.res, 0);
                AI* m = this.s_mi(A_ADDFO, 8);
                ((AGF*)this.sf.tg).leaf = false;
                m.d = d;
                m.k = 1;
                ->;
            };

            s_isel_vaarg(SI* x) -> void
            {
                IRType* t = x.ty;
                int r, p, d, n, sz, cls;
                AM* ml;
                AM* mv;
                if (this.s_isagg(t)) { this.s_fail(g"va_arg of an aggregate\0"); ->; };
                if (!this.s_isarg(t)) { this.s_fail(g"va_arg type\0"); ->; };
                r = this.s_vr(x.a);
                ml = this.s_am();
                ml.b = r;
                p = this.s_nv(0);
                this.s_memop(A_LD, p, 8, ml);
                mv = this.s_am();
                mv.b = p;
                sz = this.s_vsz(t);
                cls = this.s_cls(t);
                d = this.s_def(x.res, cls);
                this.s_memop(A_LD, d, sz, mv);
                n = this.s_alu(L_ADD, 8, p, 0 - 1, (i64)8);
                ml = this.s_am();
                ml.b = r;
                this.s_memop(A_ST, n, 8, ml);
                ->;
            };

            // ----------------------------------------------------------
            // Returns and parameters
            // ----------------------------------------------------------

            s_isel_ret(SI* x) -> void
            {
                IRType* t = x.ty;
                int r, sz;
                AI* m;
                AM* am;
                if (!this.s_isarg(t) & !this.s_isagg(t)) { this.s_fail(g"return type\0"); ->; };
                if (this.s_isagg(t))
                {
                    am = this.s_am();
                    am.b = ((AGF*)this.sf.tg).sretv;
                    this.s_agg_to(this.s_res(x.a), am);
                    this.s_mov(0, ((AGF*)this.sf.tg).sretv, 8);
                    m = this.s_mi(A_RET, 0);
                    m.iu = (i64)1;
                    ->;
                };
                sz = this.s_vsz(t);
                if (this.s_isfp(t))
                {
                    r = this.s_vr(x.a);
                    this.s_mov(32, r, sz);
                    m = this.s_mi(A_RET, 0);
                    m.iu = (i64)1 << (i64)32;
                    ->;
                };
                r = this.s_vr0(x.a);
                if (sz < 4) { sz = 4; };
                this.s_mov(0, r, sz);
                m = this.s_mi(A_RET, 0);
                m.iu = (i64)1;
                ->;
            };

            s_isel_entry() -> void
            {
                GF* g = this.sf;
                IRFunc* f = g.f;
                IRType* t;
                IRValue* a;
                int i, d, sz, ints, fps, stk, fo;
                AM* am;
                AGF* tg = (AGF*)g.tg;
                AFO* o;
                ints = 0;
                fps = 0;
                stk = 0;
                if (f.ftype.vararg) { tg.vararg = true; };
                if (this.s_isagg(f.ftype.elem))
                {
                    tg.sretv = this.s_nv(0);
                    this.s_mov(tg.sretv, 8, 8);
                };
                i = 0;
                while (i < f.nargs)
                {
                    a = f.args[i];
                    t = a.ty;
                    if (this.s_isagg(t))
                    {
                        fo = this.s_newfo(this.a_size(t), 8);
                        o = (AFO*)tg.fobj.items[fo - 1];
                        o.fix = 1;
                        o.off = stk;
                        a.fo = fo;
                        stk = stk + (this.a_size(t) + 7) / 8 * 8;
                        i++;
                        continue;
                    };
                    if (!this.s_isarg(t)) { this.s_fail(g"parameter type\0"); ->; };
                    sz = this.s_vsz(t);
                    if (sz < 4 & !this.s_isfp(t)) { sz = 4; };
                    if (this.s_isfp(t))
                    {
                        d = this.s_def(a, 1);
                        if (fps < 8)
                        {
                            this.s_mov(d, 32 + fps, sz);
                            fps++;
                        }
                        else
                        {
                            am = this.s_am();
                            am.ma = 1;
                            am.imm = (i64)stk;
                            this.s_memop(A_LD, d, sz, am);
                            stk = stk + 8;
                        };
                    }
                    else
                    {
                        d = this.s_def(a, 0);
                        if (ints < 8)
                        {
                            this.s_mov(d, ints, sz);
                            ints++;
                        }
                        else
                        {
                            am = this.s_am();
                            am.ma = 1;
                            am.imm = (i64)stk;
                            this.s_memop(A_LD, d, sz, am);
                            stk = stk + 8;
                        };
                    };
                    i++;
                };
                tg.vastk = stk;
                ->;
            };

            // ----------------------------------------------------------
            // Switch
            // ----------------------------------------------------------

            s_isel_switch(SI* x) -> void
            {
                IRType* t = x.a.ty;
                int w, r, i, j, k, cnt, n;
                AI* m;
                IRValue* cv;
                u64 lo, hi, c, tv;
                int* tab;
                int tb;
                int ti;
                if (t.kind != LK.INT | t.width > 64) { this.s_fail(g"switch type\0"); ->; };
                if (x.n < 1)
                {
                    m = this.s_mi(A_B, 0);
                    m.tgt = x.f.id;
                    ->;
                };
                w = t.width;
                r = this.s_vr(x.a);
                if (w < 64) { r = this.s_ext(r, w, false, 8); };
                lo = (u64)0;
                hi = (u64)0;
                i = 0;
                while (i < x.n)
                {
                    cv = this.s_res(x.args[i]);
                    if (!this.s_cint(cv)) { this.s_fail(g"switch case\0"); ->; };
                    c = this.a_mask((u64)this.scv, w);
                    if (i == 0 | c < lo) { lo = c; };
                    if (i == 0 | c > hi) { hi = c; };
                    i++;
                };
                if (x.n <= 4)
                {
                    i = 0;
                    while (i < x.n)
                    {
                        cv = this.s_res(x.args[i]);
                        this.s_cint(cv);
                        m = this.s_mi(A_CMP, 8);
                        m.a = r;
                        m.imm = this.scv;
                        m = this.s_mi(A_BC, 0);
                        m.cc = CC_EQ;
                        m.tgt = x.blks[i].id;
                        i++;
                    };
                    m = this.s_mi(A_B, 0);
                    m.tgt = x.f.id;
                    ->;
                };
                if (hi - lo < (u64)65536 & (hi - lo) / (u64)8 < (u64)x.n + (u64)8)
                {
                    cnt = (int)(hi - lo) + 1;
                    tab = (int*)this.s_ar(4 * (cnt + 1));
                    k = 0;
                    while (k < cnt) { tab[k] = x.f.id; k++; };
                    i = x.n - 1;
                    while (i >= 0)
                    {
                        cv = this.s_res(x.args[i]);
                        this.s_cint(cv);
                        c = this.a_mask((u64)this.scv, w);
                        tab[(int)(c - lo)] = x.blks[i].id;
                        i--;
                    };
                    if (lo != (u64)0) { r = this.s_alu(L_SUB, 8, r, 0 - 1, (i64)lo); };
                    m = this.s_mi(A_CMP, 8);
                    m.a = r;
                    m.imm = (i64)(cnt - 1);
                    m = this.s_mi(A_BC, 0);
                    m.cc = CC_HI;
                    m.tgt = x.f.id;
                    m = this.s_mi(A_JT, 0);
                    m.a = r;
                    m.text = (byte*)tab;
                    m.k = cnt;
                    m.tgt = x.f.id;
                    ->;
                };
                // sparse values: a search over the sorted case values
                n = x.n;
                tab = (int*)this.s_ar(16 * n + 16);
                i = 0;
                while (i < n)
                {
                    cv = this.s_res(x.args[i]);
                    this.s_cint(cv);
                    tv = this.a_mask((u64)this.scv, w);
                    j = i;
                    while (j > 0)
                    {
                        if (((u64*)tab)[j - 1] <= tv) { break; };
                        ((u64*)tab)[j] = ((u64*)tab)[j - 1];
                        tab[2 * n + j] = tab[2 * n + j - 1];
                        j--;
                    };
                    ((u64*)tab)[j] = tv;
                    tab[2 * n + j] = x.blks[i].id;
                    i++;
                };
                m = this.s_mi(A_SWBIN, 8);
                m.a = r;
                m.text = (byte*)tab;
                m.k = n;
                m.tgt = x.f.id;
                ->;
            };

            // ----------------------------------------------------------
            // Phis and the driver
            // ----------------------------------------------------------

            s_isel_phis(GB* gb) -> void
            {
                int i, j, k;
                SI* x;
                GP* gp;
                GB* pg;
                IRType* t;
                int* used;
                if (gb.ib.insts == (PtrVec*)0) { ->; };
                i = 0;
                while (i < gb.ib.insts.len)
                {
                    x = (SI*)gb.ib.insts.items[i];
                    if (x.op == SO_PHI)
                    {
                        t = x.ty;
                        if (!this.s_isarg(t)) { this.s_fail(g"phi type\0"); ->; };
                        gp = (GP*)this.s_ar((int)(((sizeof(GP) + 7) / 8) * 2));
                        gp.res = x.res;
                        gp.dst = this.s_def(x.res, this.s_cls(t));
                        gp.preds = pv_new();
                        gp.vals = pv_new();
                        gp.ops = pv_new();
                        used = this.s_iz(x.n + 1);
                        j = 0;
                        while (j < gb.preds.len)
                        {
                            pg = (GB*)gb.preds.items[j];
                            k = 0;
                            while (k < x.n)
                            {
                                if (x.blks[k] == pg.ib & used[k] == 0) { break; };
                                k++;
                            };
                            if (k >= x.n)
                            {
                                // a duplicate edge reuses the first entry of that block
                                k = 0;
                                while (k < x.n)
                                {
                                    if (x.blks[k] == pg.ib) { break; };
                                    k++;
                                };
                            };
                            if (k >= x.n)
                            {
                                this.s_fail(g"phi without incoming value\0");
                                this.s_ifree(used);
                                ->;
                            };
                            used[k] = 1;
                            pv_push(gp.preds, (void*)pg);
                            pv_push(gp.vals, (void*)this.s_res(x.args[k]));
                            j++;
                        };
                        this.s_ifree(used);
                        pv_push(gb.phis, (void*)gp);
                    };
                    i++;
                };
                ->;
            };

            // Marks the compares and addresses used once by the next instructions as folded into their user
            s_lazy() -> void
            {
                GF* g = this.sf;
                int i, j;
                GB* gb;
                SI* x;
                SI* u;
                if (A64_OPT_LAZY != 1) { ->; };
                i = 0;
                while (i < g.nb)
                {
                    gb = (GB*)g.bl.items[i];
                    if (gb.ib.insts != (PtrVec*)0)
                    {
                        j = 0;
                        while (j < gb.ib.insts.len)
                        {
                            x = (SI*)gb.ib.insts.items[j];
                            if (x.res != (IRValue*)0)
                            {
                                if (x.res.nu == 1 & x.res.ui != (void*)0)
                                {
                                    u = (SI*)x.res.ui;
                                    if (u.bi == x.bi)
                                    {
                                        if (x.op == SO_CMP)
                                        {
                                            if ((u.op == SO_CBR | u.op == SO_SELECT) & u.a == x.res)
                                            {
                                                if (this.s_csingle(x) | u.op == SO_CBR) { x.flag = true; };
                                            };
                                        };
                                        if (x.op == SO_GEP)
                                        {
                                            if (u.op == SO_LOAD & u.a == x.res) { x.flag = true; };
                                            if (u.op == SO_GEP & u.a == x.res) { x.flag = true; };
                                            if (u.op == SO_STORE & u.b == x.res & u.a != x.res) { x.flag = true; };
                                        };
                                    };
                                };
                            };
                            j++;
                        };
                    };
                    i++;
                };
                ->;
            };

            s_isel_inst(SI* x) -> void
            {
                int o = x.op;
                AI* m;
                if (o == SO_PHI) { ->; };
                if (o == SO_BIN) { this.s_isel_bin(x); ->; };
                if (o == SO_CMP) { this.s_isel_cmp(x); ->; };
                if (o == SO_CAST) { this.s_isel_cast(x); ->; };
                if (o == SO_ALLOCAN) { this.s_isel_allocan(x); ->; };
                if (o == SO_ALLOCA) { this.s_isel_alloca(x); ->; };
                if (o == SO_LOAD) { this.s_isel_load(x); ->; };
                if (o == SO_STORE) { this.s_isel_store(x); ->; };
                if (o == SO_FILL) { this.s_isel_fill(x); ->; };
                if (o == SO_COPY) { this.s_isel_fill(x); ->; };
                if (o == SO_GEP) { this.s_isel_gep(x); ->; };
                if (o == SO_CALL) { this.s_isel_call(x); ->; };
                if (o == SO_SELECT) { this.s_isel_select(x); ->; };
                if (o == SO_BR) { this.s_isel_br(x); ->; };
                if (o == SO_CBR) { this.s_isel_cbr(x); ->; };
                if (o == SO_SWITCH) { this.s_isel_switch(x); ->; };
                if (o == SO_VAARG) { this.s_isel_vaarg(x); ->; };
                if (o == SO_RETADDR) { this.s_isel_retaddr(x); ->; };
                if (o == SO_EXTRACT) { this.s_isel_extract(x); ->; };
                if (o == SO_INSERT) { this.s_isel_insert(x); ->; };
                if (o == SO_RET) { this.s_isel_ret(x); ->; };
                if (o == SO_RETV)
                {
                    this.s_mi(A_RET, 0);
                    ->;
                };
                if (o == SO_UNREACH)
                {
                    this.s_mi(A_BRK, 0);
                    ->;
                };
                this.s_fail(g"instruction\0");
                ->;
            };

            s_isel() -> bool
            {
                GF* g = this.sf;
                IRFunc* f = g.f;
                int i, j, k;
                GB* gb;
                SI* x;
                IRType* rt = f.ftype.elem;
                if (rt.kind != LK.VOID & !this.s_isarg(rt) & !this.s_isagg(rt)) { this.s_fail(g"function return type\0"); -> false; };
                // the per register arrays exist even when the function needs no virtual register
                k = this.s_nv(0);
                g.nvr = k;
                this.s_users();
                this.s_lazy();
                i = 0;
                while (i < g.nb)
                {
                    gb = g.rpo[i];
                    this.scb = gb;
                    this.s_isel_phis(gb);
                    i++;
                };
                i = 0;
                while (i < g.nb)
                {
                    gb = g.rpo[i];
                    this.scb = gb;
                    if (i == 0) { this.s_isel_entry(); };
                    if (gb.ib.insts != (PtrVec*)0)
                    {
                        j = 0;
                        while (j < gb.ib.insts.len)
                        {
                            x = (SI*)gb.ib.insts.items[j];
                            this.s_isel_inst(x);
                            if (this.gwhy != 0) { -> false; };
                            j++;
                        };
                    };
                    i++;
                };
                -> this.gwhy == 0;
            };
// Author: Karac V. Thweatt
//
// iarm64_ra.idk - register scanning, liveness, interference, spilling and the copies of phis for the AArch64
// backend. Imported inside the object of A64Module. The colouring itself (s_color) and the liveness
// (s_liveness) are target independent and live in issa.idk.

            // ----------------------------------------------------------
            // Registers read and written by a machine instruction
            // ----------------------------------------------------------

            // True for the registers the allocator never sees: the zero register, the scratch registers x16 and
            // x17, the platform register, the frame pointer, the link register and the scratch float register
            s_hidden(int r) -> bool
            {
                if (r < 0) { -> true; };
                if (r == 31 | r == 16 | r == 17 | r == 18 | r == 29 | r == 30 | r == 63) { -> true; };
                -> false;
            };

            s_addu(int r) -> void
            {
                if (this.s_hidden(r)) { ->; };
                if (r >= AR_VBASE)
                {
                    if (this.sf.vcol[r] == 0 - 1) { ->; };
                };
                if (this.nub >= this.bcap) { this.s_bgrow(); };
                this.ubuf[this.nub] = r;
                this.nub++;
                ->;
            };

            s_addd(int r) -> void
            {
                if (this.s_hidden(r)) { ->; };
                if (r >= AR_VBASE)
                {
                    if (this.sf.vcol[r] == 0 - 1) { ->; };
                };
                if (this.ndb >= this.bcap) { this.s_bgrow(); };
                this.dbuf[this.ndb] = r;
                this.ndb++;
                ->;
            };

            // Role of register field slot (0 d, 1 a, 2 b, 3 c) of an instruction: 1 read, 2 written, 0 none
            s_arole(int op, int slot) -> int
            {
                if (slot > 0) { -> 1; };
                if (op == A_ST) { -> 1; };
                if (op == A_MOV | op == A_MOVI | op == A_FMOVI | op == A_ADR | op == A_ADDFO | op == A_ALU | op == A_MADD | op == A_UN | op == A_EXT | op == A_CSET | op == A_CSEL | op == A_FCSEL | op == A_LD | op == A_DALLOC | op == A_FALU | op == A_FUN | op == A_FCVT | op == A_CVT | op == A_FMOVX | op == A_FMSUB) { -> 2; };
                -> 0;
            };

            // Fills ubuf and dbuf with the registers m reads and writes
            s_scan(AI* m) -> void
            {
                int op = m.op;
                int i, r;
                this.nub = 0;
                this.ndb = 0;
                r = m.d;
                if (r >= 0)
                {
                    i = this.s_arole(op, 0);
                    if (i == 2) { this.s_addd(r); };
                    if (i == 1) { this.s_addu(r); };
                };
                this.s_addu(m.a);
                this.s_addu(m.b);
                this.s_addu(m.c);
                if ((m.iu `| m.id `| m.clob) == (i64)0) { ->; };
                i = 0;
                while (i < 64)
                {
                    if ((m.iu `& ((i64)1 << (i64)i)) != (i64)0) { this.s_addu(i); };
                    if (((m.id `| m.clob) `& ((i64)1 << (i64)i)) != (i64)0) { this.s_addd(i); };
                    i++;
                };
                ->;
            };

            // ==========================================================
            // liveness, interference graph, coloring in definition order and spilling.
            // ==========================================================

            s_globals() -> void
            {
                GF* g = this.sf;
                int n = g.nb;
                int nv = g.nvr;
                int i, j, k, v, ng, cu, cd;
                GB* gb;
                AI* mi;
                int* defs = this.s_iz(nv);
                int* usedm = this.s_iz(nv);
                int* defl = this.s_iz(nv);
                int* tu;
                int* td;
                i = 0;
                while (i < nv) { g.vglob[i] = 0 - 1; i++; };
                ng = 0;
                i = 0;
                while (i < n)
                {
                    gb = g.rpo[i];
                    j = 0;
                    while (j < gb.mi.len)
                    {
                        mi = (AI*)gb.mi.items[j];
                        this.s_scan(mi);
                        k = 0;
                        while (k < this.nub)
                        {
                            v = this.ubuf[k];
                            if (v >= AR_VBASE)
                            {
                                if (defs[v] != i + 1 & g.vglob[v] < 0) { g.vglob[v] = ng; ng++; };
                            };
                            k++;
                        };
                        k = 0;
                        while (k < this.ndb)
                        {
                            v = this.dbuf[k];
                            if (v >= AR_VBASE) { defs[v] = i + 1; };
                            k++;
                        };
                        j++;
                    };
                    i++;
                };
                g.nglob = ng;
                if (g.gv != (int*)0) { this.s_ifree(g.gv); };
                g.gv = this.s_iz(ng + 1);
                i = 0;
                while (i < nv)
                {
                    if (g.vglob[i] >= 0) { g.gv[g.vglob[i]] = i; };
                    defs[i] = 0;
                    i++;
                };
                tu = this.s_iz(ng + 2);
                td = this.s_iz(ng + 2);
                i = 0;
                while (i < n)
                {
                    gb = g.rpo[i];
                    cu = 0;
                    cd = 0;
                    j = 0;
                    while (j < gb.mi.len)
                    {
                        mi = (AI*)gb.mi.items[j];
                        this.s_scan(mi);
                        k = 0;
                        while (k < this.nub)
                        {
                            v = this.ubuf[k];
                            if (v >= AR_VBASE)
                            {
                                if (g.vglob[v] >= 0 & defs[v] != i + 1 & usedm[v] != i + 1)
                                {
                                    usedm[v] = i + 1;
                                    tu[cu] = g.vglob[v];
                                    cu++;
                                };
                            };
                            k++;
                        };
                        k = 0;
                        while (k < this.ndb)
                        {
                            v = this.dbuf[k];
                            if (v >= AR_VBASE)
                            {
                                defs[v] = i + 1;
                                if (g.vglob[v] >= 0 & defl[v] != i + 1)
                                {
                                    defl[v] = i + 1;
                                    td[cd] = g.vglob[v];
                                    cd++;
                                };
                            };
                            k++;
                        };
                        j++;
                    };
                    if (gb.guse != (int*)0) { this.s_ifree(gb.guse); this.s_ifree(gb.gdef); };
                    gb.guse = this.s_iz(cu + 1);
                    gb.gdef = this.s_iz(cd + 1);
                    gb.guse[0] = cu;
                    gb.gdef[0] = cd;
                    k = 0;
                    while (k < cu) { gb.guse[k + 1] = tu[k]; k++; };
                    k = 0;
                    while (k < cd) { gb.gdef[k + 1] = td[k]; k++; };
                    i++;
                };
                this.s_ifree(defs); this.s_ifree(usedm); this.s_ifree(defl); this.s_ifree(tu); this.s_ifree(td);
                ->;
            };

            s_graph() -> void
            {
                GF* g = this.sf;
                int n = g.nb;
                int nv = g.nvr;
                int nw = (g.nglob + 31) / 32;
                int i, j, k, v, d, u, w, op, e, p, src;
                GB* gb;
                GB* sg;
                AI* mi;
                bool copy;
                i64 lp;
                int* deg;
                int* fill;
                int* seen;
                if (nw < 1) { nw = 1; };
                this.ne = 0;
                if (g.lpos != (int*)0) { this.s_ifree(g.lpos); };
                g.lpos = this.s_iz(nv);
                i = 0;
                while (i < nv)
                {
                    g.lpos[i] = 0 - 1;
                    g.vforb[i] = (i64)0;
                    g.vhint[i] = 0 - 1;
                    if (g.vwgt[i] < 1500000000) { g.vwgt[i] = 0; };
                    i++;
                };
                g.nl = 0;
                i = 0;
                while (i < n)
                {
                    gb = g.rpo[i];
                    // live out registers
                    g.nl = 0;
                    j = 0;
                    while (j < g.nglob)
                    {
                        if (this.s_bit(gb.liveout, j))
                        {
                            v = g.gv[j];
                            if (g.vcol[v] != 0 - 1) { this.s_lpush(v); };
                        };
                        j++;
                    };
                    lp = (i64)0;
                    j = gb.mi.len - 1;
                    while (j >= 0)
                    {
                        mi = (AI*)gb.mi.items[j];
                        op = mi.op;
                        this.s_scan(mi);
                        copy = false;
                        src = 0 - 1;
                        if (op == A_MOV)
                        {
                            if (mi.d >= 0 & mi.a >= 0 & mi.a != AR_ZR & mi.d != AR_ZR)
                            {
                                copy = true;
                                src = mi.a;
                            };
                        };
                        // definitions
                        k = 0;
                        while (k < this.ndb)
                        {
                            d = this.dbuf[k];
                            if (d >= AR_VBASE)
                            {
                                u = 0;
                                while (u < g.nl)
                                {
                                    v = g.llist[u];
                                    if (v != d & g.vcls[v] == g.vcls[d])
                                    {
                                        if (!(copy & v == src)) { this.s_epush(d, v); };
                                    };
                                    u++;
                                };
                                g.vforb[d] = g.vforb[d] `| lp;
                                this.s_wadd(d, gb.lw);
                            }
                            else
                            {
                                u = 0;
                                while (u < g.nl)
                                {
                                    v = g.llist[u];
                                    g.vforb[v] = g.vforb[v] `| ((i64)1 << (i64)d);
                                    u++;
                                };
                            };
                            k++;
                        };
                        k = 0;
                        while (k < this.ndb)
                        {
                            d = this.dbuf[k];
                            if (d >= AR_VBASE) { this.s_lpop(d); } else { lp = lp `& (`!((i64)1 << (i64)d)); };
                            k++;
                        };
                        // uses
                        k = 0;
                        while (k < this.nub)
                        {
                            u = this.ubuf[k];
                            if (u >= AR_VBASE)
                            {
                                this.s_lpush(u);
                                this.s_wadd(u, gb.lw);
                            }
                            else { lp = lp `| ((i64)1 << (i64)u); };
                            k++;
                        };
                        // hints
                        if (copy)
                        {
                            d = mi.d;
                            if (d >= AR_VBASE & src >= AR_VBASE)
                            {
                                if (g.vhint[d] == 0 - 1) { g.vhint[d] = 0 - (src + 1); };
                                if (g.vhint[src] == 0 - 1) { g.vhint[src] = 0 - (d + 1); };
                            };
                            if (d >= AR_VBASE & src < AR_VBASE)
                            {
                                if (g.vhint[d] == 0 - 1) { g.vhint[d] = src; };
                            };
                            if (d < AR_VBASE & src >= AR_VBASE)
                            {
                                if (g.vhint[src] == 0 - 1) { g.vhint[src] = d; };
                            };
                        };
                        j--;
                    };
                    // drop the live set
                    u = 0;
                    while (u < g.nl) { g.lpos[g.llist[u]] = 0 - 1; u++; };
                    g.nl = 0;
                    i++;
                };
                // order of definition: the phi registers of a block first, then its instructions
                if (this.ord != (int*)0) { this.s_ifree(this.ord); };
                this.ord = this.s_iz(nv + 1);
                this.nord = 0;
                seen = this.s_iz(nv);
                i = 0;
                while (i < n)
                {
                    gb = g.rpo[i];
                    k = 0;
                    while (k < gb.phis.len)
                    {
                        d = ((GP*)gb.phis.items[k]).dst;
                        if (g.vcol[d] != 0 - 1 & seen[d] == 0) { seen[d] = 1; this.ord[this.nord] = d; this.nord++; };
                        k++;
                    };
                    j = 0;
                    while (j < gb.mi.len)
                    {
                        mi = (AI*)gb.mi.items[j];
                        this.s_scan(mi);
                        k = 0;
                        while (k < this.ndb)
                        {
                            d = this.dbuf[k];
                            if (d >= AR_VBASE)
                            {
                                if (seen[d] == 0) { seen[d] = 1; this.ord[this.nord] = d; this.nord++; };
                            };
                            k++;
                        };
                        j++;
                    };
                    i++;
                };
                this.s_ifree(seen);
                // adjacency lists
                deg = this.s_iz(nv + 1);
                if (this.adjo != (int*)0) { this.s_ifree(this.adjo); this.s_ifree(this.adj); };
                this.adjo = this.s_iz(nv + 2);
                e = 0;
                while (e < this.ne)
                {
                    deg[this.ea[e]] = deg[this.ea[e]] + 1;
                    deg[this.eb[e]] = deg[this.eb[e]] + 1;
                    e++;
                };
                this.adjo[0] = 0;
                i = 0;
                while (i < nv)
                {
                    this.adjo[i + 1] = this.adjo[i] + deg[i];
                    i++;
                };
                this.adj = this.s_iz(this.adjo[nv] + 1);
                fill = this.s_iz(nv + 1);
                e = 0;
                while (e < this.ne)
                {
                    u = this.ea[e];
                    v = this.eb[e];
                    this.adj[this.adjo[u] + fill[u]] = v;
                    fill[u] = fill[u] + 1;
                    this.adj[this.adjo[v] + fill[v]] = u;
                    fill[v] = fill[v] + 1;
                    e++;
                };
                this.s_ifree(deg);
                this.s_ifree(fill);
                ->;
            };

            // ----------------------------------------------------------
            // Spilling
            // ----------------------------------------------------------

            // The registers s_color gave up on (spl) live in frame slots: every use is preceded by a load into a new
            // register and every definition is followed by a store from one
            s_spill() -> void
            {
                GF* g = this.sf;
                int nv = g.nvr;
                int i, j, k, r, t, slot, nt;
                int* sp = this.s_iz(nv + 1);
                int* fr = this.s_iz(4);
                int* ft = this.s_iz(4);
                GB* gb;
                AI* m;
                AI* l;
                PtrVec* old;
                i = 0;
                while (i < this.nspl)
                {
                    sp[this.spl[i]] = 1;
                    g.vslot[this.spl[i]] = this.s_newfo(8, 8);
                    i++;
                };
                i = 0;
                while (i < g.nb)
                {
                    gb = g.rpo[i];
                    old = gb.mi;
                    gb.mi = pv_new();
                    this.scb = gb;
                    j = 0;
                    while (j < old.len)
                    {
                        m = (AI*)old.items[j];
                        nt = 0;
                        slot = 0;
                        while (slot < 4)
                        {
                            r = this.s_afield(m, slot);
                            if (r >= AR_VBASE)
                            {
                                if (sp[r] == 1 & this.s_arole(m.op, slot) == 1 & (slot > 0 | m.op == A_ST))
                                {
                                    t = 0 - 1;
                                    k = 0;
                                    while (k < nt)
                                    {
                                        if (fr[k] == r) { t = ft[k]; };
                                        k++;
                                    };
                                    if (t < 0)
                                    {
                                        t = this.s_nv(g.vcls[r]);
                                        g.vwgt[t] = 2000000000;
                                        l = this.s_mi(A_LD, 8);
                                        l.d = t;
                                        l.fo = g.vslot[r] - 1;
                                        if (nt < 4) { fr[nt] = r; ft[nt] = t; nt++; };
                                    };
                                    this.s_setafield(m, slot, t);
                                };
                            };
                            slot++;
                        };
                        pv_push(gb.mi, (void*)m);
                        r = m.d;
                        if (r >= AR_VBASE)
                        {
                            if (sp[r] == 1 & this.s_arole(m.op, 0) == 2)
                            {
                                t = this.s_nv(g.vcls[r]);
                                g.vwgt[t] = 2000000000;
                                m.d = t;
                                l = this.s_mi(A_ST, 8);
                                l.d = t;
                                l.fo = g.vslot[r] - 1;
                            };
                        };
                        j++;
                    };
                    pv_free(old);
                    i++;
                };
                i = 0;
                while (i < this.nspl)
                {
                    g.vcol[this.spl[i]] = 0 - 1;
                    i++;
                };
                this.s_ifree(sp);
                this.s_ifree(fr);
                this.s_ifree(ft);
                ->;
            };

            s_afield(AI* m, int slot) -> int
            {
                if (slot == 0) { -> m.d; };
                if (slot == 1) { -> m.a; };
                if (slot == 2) { -> m.b; };
                -> m.c;
            };

            s_setafield(AI* m, int slot, int r) -> void
            {
                if (slot == 0) { m.d = r; ->; };
                if (slot == 1) { m.a = r; ->; };
                if (slot == 2) { m.b = r; ->; };
                m.c = r;
                ->;
            };

            // Allocates registers for the selected code
            s_ra() -> bool
            {
                GF* g = this.sf;
                int rounds = 0;
                int r, i;
                i64 cs, b;
                cs = this.s_csmask();
                while (true)
                {
                    rounds++;
                    if (rounds > 80) { this.s_fail(g"register allocation rounds\0"); -> false; };
                    this.s_globals();
                    this.s_liveness();
                    this.s_graph();
                    r = this.s_color();
                    if (r < 0) { this.s_fail(g"register allocation\0"); -> false; };
                    if (r == 0) { break; };
                    this.s_spill();
                };
                ((AGF*)g.tg).saved = (i64)0;
                i = AR_VBASE;
                while (i < g.nvr)
                {
                    if (g.vcol[i] >= 0)
                    {
                        b = (i64)1 << (i64)g.vcol[i];
                        if ((cs `& b) != (i64)0) { ((AGF*)g.tg).saved = ((AGF*)g.tg).saved `| b; };
                    };
                    i++;
                };
                -> true;
            };

            // Hardware register of register number r after allocation
            s_phys(int r) -> int
            {
                if (r >= AR_VBASE) { -> this.sf.vcol[r]; };
                -> r;
            };

            // ----------------------------------------------------------
            // Phis: the copies on the edges
            // ----------------------------------------------------------

            // Copies the incoming values of the phis of s along edge pidx, at the end of the block being filled.
            // The copies behave as one parallel copy: a source that is also the target of another phi is saved
            // in a new register first.
            s_phimoves(GB* s, int pidx) -> void
            {
                int n = s.phis.len;
                int k, j, r, t;
                GP* gp;
                GP* gq;
                IRValue* v;
                int* sr = this.s_iz(n + 1);
                k = 0;
                while (k < n)
                {
                    gp = (GP*)s.phis.items[k];
                    v = this.s_res((IRValue*)gp.vals.items[pidx]);
                    if (this.s_cls(v.ty) == 1) { sr[k] = this.s_vr(v); } else { sr[k] = this.s_vr0(v); };
                    k++;
                };
                k = 0;
                while (k < n)
                {
                    r = sr[k];
                    j = 0;
                    while (j < n)
                    {
                        gq = (GP*)s.phis.items[j];
                        if (j != k & gq.dst == r)
                        {
                            gp = (GP*)s.phis.items[k];
                            t = this.s_nv(this.sf.vcls[gp.dst]);
                            this.s_mov(t, r, 8);
                            sr[k] = t;
                            break;
                        };
                        j++;
                    };
                    k++;
                };
                k = 0;
                while (k < n)
                {
                    gp = (GP*)s.phis.items[k];
                    if (sr[k] != gp.dst) { this.s_mov(gp.dst, sr[k], 8); };
                    k++;
                };
                this.s_ifree(sr);
                ->;
            };

            // Retargets the jumps of block p that reach block id from to block id to
            s_retarget(GB* p, int oldid, int to) -> void
            {
                int k, n;
                AI* t;
                k = p.mi.len - 1;
                while (k >= 0)
                {
                    t = (AI*)p.mi.items[k];
                    if (t.op == A_B | t.op == A_BC | t.op == A_CBZ | t.op == A_CBNZ)
                    {
                        if (t.tgt == oldid) { t.tgt = to; };
                    };
                    if (t.op == A_JT)
                    {
                        if (t.tgt == oldid) { t.tgt = to; };
                        n = 0;
                        while (n < t.k)
                        {
                            if (((int*)t.text)[n] == oldid) { ((int*)t.text)[n] = to; };
                            n++;
                        };
                    };
                    if (t.op == A_SWBIN)
                    {
                        if (t.tgt == oldid) { t.tgt = to; };
                        n = 0;
                        while (n < t.k)
                        {
                            if (((int*)t.text)[2 * t.k + n] == oldid) { ((int*)t.text)[2 * t.k + n] = to; };
                            n++;
                        };
                    };
                    k--;
                };
                ->;
            };

            // Puts the copies of the phis on the edges. An edge from a block with one successor gets them at the
            // end of that block, any other edge gets a block of its own.
            s_edges() -> bool
            {
                GF* g = this.sf;
                int i, j, k, n, pidx;
                GB* p;
                GB* s;
                GB* e;
                AI* m;
                AI* t;
                PtrVec* lay = pv_new();
                bool seen;
                n = g.nb;
                i = 0;
                while (i < n)
                {
                    p = g.rpo[i];
                    pv_push(lay, (void*)p);
                    j = 0;
                    while (j < p.succs.len)
                    {
                        s = (GB*)p.succs.items[j];
                        seen = false;
                        k = 0;
                        while (k < j)
                        {
                            if ((GB*)p.succs.items[k] == s) { seen = true; };
                            k++;
                        };
                        if (!seen & s.phis.len > 0)
                        {
                            pidx = 0;
                            while (pidx < s.preds.len)
                            {
                                if ((GB*)s.preds.items[pidx] == p) { break; };
                                pidx++;
                            };
                            if (p.succs.len == 1)
                            {
                                // before the final jump
                                t = (AI*)p.mi.items[p.mi.len - 1];
                                if (t.op != A_B) { this.s_fail(g"block end\0"); pv_free(lay); -> false; };
                                p.mi.len = p.mi.len - 1;
                                this.scb = p;
                                this.s_phimoves(s, pidx);
                                pv_push(p.mi, (void*)t);
                            }
                            else
                            {
                                e = (GB*)fmalloc((u64)(((sizeof(GB) + 7) / 8) * 2));
                                e.ib = (IRBlock*)0;
                                this.lab++;
                                e.id = this.lab;
                                e.rpo = 0;
                                e.idom = 0 - 1;
                                e.lbl = e.id;
                                e.depth = p.depth + 1;
                                e.nexti = 0;
                                e.lw = p.lw;
                                e.preds = pv_new();
                                e.succs = pv_new();
                                e.kids = pv_new();
                                e.df = pv_new();
                                e.phis = pv_new();
                                e.mi = pv_new();
                                e.livein = (int*)0;
                                e.liveout = (int*)0;
                                e.guse = (int*)0;
                                e.gdef = (int*)0;
                                pv_push(e.preds, (void*)p);
                                pv_push(e.succs, (void*)s);
                                this.scb = e;
                                this.s_phimoves(s, pidx);
                                m = this.s_mi(A_B, 0);
                                m.tgt = s.id;
                                this.s_retarget(p, s.id, e.id);
                                k = 0;
                                while (k < p.succs.len)
                                {
                                    if ((GB*)p.succs.items[k] == s) { p.succs.items[k] = (void*)e; };
                                    k++;
                                };
                                k = 0;
                                while (k < s.preds.len)
                                {
                                    if ((GB*)s.preds.items[k] == p) { s.preds.items[k] = (void*)e; };
                                    k++;
                                };
                                e.rpo = g.bl.len;
                                pv_push(g.bl, (void*)e);
                                pv_push(lay, (void*)e);
                            };
                        };
                        j++;
                    };
                    i++;
                };
                // the layout becomes the new block order
                ffree((byte*)g.rpo);
                g.nb = lay.len;
                g.rpo = (GB**)fmalloc((u64)(8 * (lay.len + 1)));
                i = 0;
                while (i < lay.len)
                {
                    g.rpo[i] = (GB*)lay.items[i];
                    ((GB*)lay.items[i]).rpo = i;
                    i++;
                };
                pv_free(lay);
                -> true;
            };
// Author: Karac V. Thweatt
//
// iarm64_emit.idk - frame layout and assembly output of the AArch64 backend. Imported inside the object of
// A64Module.

            // ----------------------------------------------------------
            // Register names
            // ----------------------------------------------------------

            // Writes the name of hardware register r for an access of sz bytes
            e_r(Buf* o, int r, int sz) -> void
            {
                if (r >= 32)
                {
                    if (sz == 4) { o.put(115); }
                    elif (sz == 16) { o.put(113); }
                    else { o.put(100); };
                    o.put_int(r - 32);
                    ->;
                };
                if (r == 31)
                {
                    if (sz == 8) { o.put_str(g"xzr\0"); } else { o.put_str(g"wzr\0"); };
                    ->;
                };
                if (sz == 8) { o.put(120); } else { o.put(119); };
                o.put_int(r);
                ->;
            };

            // A base register: sp for 31
            e_b(Buf* o, int r) -> void
            {
                if (r == 31) { o.put_str(g"sp\0"); ->; };
                o.put(120);
                o.put_int(r);
                ->;
            };

            // Register field r of an instruction (a virtual register is replaced by its colour)
            e_pr(Buf* o, int r, int sz) -> void
            {
                this.e_r(o, this.s_phys(r), sz);
                ->;
            };

            // Condition code name
            e_cc(Buf* o, int cc) -> void
            {
                if (cc == CC_EQ) { o.put_str(g"eq\0"); ->; };
                if (cc == CC_NE) { o.put_str(g"ne\0"); ->; };
                if (cc == CC_HS) { o.put_str(g"hs\0"); ->; };
                if (cc == CC_LO) { o.put_str(g"lo\0"); ->; };
                if (cc == CC_MI) { o.put_str(g"mi\0"); ->; };
                if (cc == CC_PL) { o.put_str(g"pl\0"); ->; };
                if (cc == CC_VS) { o.put_str(g"vs\0"); ->; };
                if (cc == CC_VC) { o.put_str(g"vc\0"); ->; };
                if (cc == CC_HI) { o.put_str(g"hi\0"); ->; };
                if (cc == CC_LS) { o.put_str(g"ls\0"); ->; };
                if (cc == CC_GE) { o.put_str(g"ge\0"); ->; };
                if (cc == CC_LT) { o.put_str(g"lt\0"); ->; };
                if (cc == CC_GT) { o.put_str(g"gt\0"); ->; };
                if (cc == CC_LE) { o.put_str(g"le\0"); ->; };
                o.put_str(g"al\0");
                ->;
            };

            // ----------------------------------------------------------
            // Constants
            // ----------------------------------------------------------

            // True when v (sz 4 or 8 bytes) is a rotated run of ones replicated across the register, so a logical
            // instruction takes it as an immediate
            e_bitmask(u64 v, int sz) -> bool
            {
                int e, h, pc;
                u64 mask, emask, x, r, y;
                if (sz == 4)
                {
                    v = v `& (u64)4294967295;
                    v = v `| (v << (u64)32);
                };
                if (v == (u64)0 | v == `!((u64)0)) { -> false; };
                e = 64;
                while (e > 2)
                {
                    h = e / 2;
                    mask = ((u64)1 << (u64)h) - (u64)1;
                    if ((v `& mask) != ((v >> (u64)h) `& mask)) { break; };
                    e = h;
                };
                emask = `!((u64)0);
                if (e < 64) { emask = ((u64)1 << (u64)e) - (u64)1; };
                x = v `& emask;
                r = ((x >> (u64)1) `| ((x `& (u64)1) << (u64)(e - 1))) `& emask;
                y = x `^| r;
                pc = 0;
                while (y != (u64)0)
                {
                    pc = pc + (int)(y `& (u64)1);
                    y = y >> (u64)1;
                };
                -> pc == 2;
            };

            // Loads the constant v into register r (a hardware register number)
            e_movi(Buf* o, int r, i64 v, int sz) -> void
            {
                u64 u = (u64)v;
                u64 c;
                int nh = 4;
                int i, zeros, ones, first;
                bool neg;
                if (sz == 4)
                {
                    u = u `& (u64)4294967295;
                    nh = 2;
                };
                zeros = 0;
                ones = 0;
                i = 0;
                while (i < nh)
                {
                    c = (u >> (u64)(16 * i)) `& (u64)65535;
                    if (c == (u64)0) { zeros++; };
                    if (c == (u64)65535) { ones++; };
                    i++;
                };
                if (zeros == nh)
                {
                    o.put_str(g"\tmovz \0");
                    this.e_r(o, r, sz);
                    o.put_str(g", #0\n\0");
                    ->;
                };
                if (nh - zeros > 1 & this.e_bitmask(u, sz))
                {
                    o.put_str(g"\torr \0");
                    this.e_r(o, r, sz);
                    o.put_str(g", \0");
                    this.e_r(o, AR_ZR, sz);
                    o.put_str(g", #\0");
                    put_u64(o, u);
                    o.put(10);
                    ->;
                };
                neg = ones > zeros;
                first = 1;
                i = 0;
                while (i < nh)
                {
                    c = (u >> (u64)(16 * i)) `& (u64)65535;
                    if (neg)
                    {
                        if (c != (u64)65535)
                        {
                            if (first == 1)
                            {
                                o.put_str(g"\tmovn \0");
                                this.e_r(o, r, sz);
                                o.put_str(g", #\0");
                                put_u64(o, (c `^| (u64)65535));
                                first = 0;
                            }
                            else
                            {
                                o.put_str(g"\tmovk \0");
                                this.e_r(o, r, sz);
                                o.put_str(g", #\0");
                                put_u64(o, c);
                            };
                            if (i > 0) { o.put_str(g", lsl #\0"); o.put_int(16 * i); };
                            o.put(10);
                        };
                    }
                    else
                    {
                        if (c != (u64)0)
                        {
                            if (first == 1)
                            {
                                o.put_str(g"\tmovz \0");
                                first = 0;
                            }
                            else { o.put_str(g"\tmovk \0"); };
                            this.e_r(o, r, sz);
                            o.put_str(g", #\0");
                            put_u64(o, c);
                            if (i > 0) { o.put_str(g", lsl #\0"); o.put_int(16 * i); };
                            o.put(10);
                        };
                    };
                    i++;
                };
                if (neg & first == 1)
                {
                    o.put_str(g"\tmovn \0");
                    this.e_r(o, r, sz);
                    o.put_str(g", #0\n\0");
                };
                ->;
            };

            // dst = base + v, with x17 as scratch for constants that do not fit an immediate
            e_addimm(Buf* o, int dst, int base, i64 v) -> void
            {
                i64 a = v;
                bool sub = false;
                if (v == (i64)0 & dst == base) { ->; };
                if (v < (i64)0)
                {
                    sub = true;
                    a = (i64)0 - v;
                };
                if (a <= (i64)4095)
                {
                    if (sub) { o.put_str(g"\tsub \0"); } else { o.put_str(g"\tadd \0"); };
                    this.e_b(o, dst);
                    o.put_str(g", \0");
                    this.e_b(o, base);
                    o.put_str(g", #\0");
                    put_i64(o, a);
                    o.put(10);
                    ->;
                };
                if ((a `& (i64)4095) == (i64)0 & (a >> (i64)12) <= (i64)4095)
                {
                    if (sub) { o.put_str(g"\tsub \0"); } else { o.put_str(g"\tadd \0"); };
                    this.e_b(o, dst);
                    o.put_str(g", \0");
                    this.e_b(o, base);
                    o.put_str(g", #\0");
                    put_i64(o, a >> (i64)12);
                    o.put_str(g", lsl #12\n\0");
                    ->;
                };
                this.e_movi(o, 17, a, 8);
                if (sub) { o.put_str(g"\tsub \0"); } else { o.put_str(g"\tadd \0"); };
                this.e_b(o, dst);
                o.put_str(g", \0");
                this.e_b(o, base);
                o.put_str(g", x17\n\0");
                ->;
            };

            // ----------------------------------------------------------
            // Frame
            // ----------------------------------------------------------

            // Offsets of the saved registers and the frame objects, and the size of the frame
            e_layout() -> void
            {
                GF* g = this.sf;
                AGF* t = (AGF*)g.tg;
                int off, i, n, al, nfo;
                AFO* o;
                int out16 = (t.outmax + 15) / 16 * 16;
                off = 16 + out16;
                t.csbase = off;
                n = 0;
                i = 0;
                while (i < 64)
                {
                    if ((t.saved `& ((i64)1 << (i64)i)) != (i64)0) { n++; };
                    i++;
                };
                off = off + 8 * n;
                nfo = 0;
                i = 0;
                while (i < t.fobj.len)
                {
                    o = (AFO*)t.fobj.items[i];
                    if (o.fix == 0)
                    {
                        al = o.al;
                        if (al > 16) { al = 16; };
                        off = (off + al - 1) / al * al;
                        o.off = off;
                        off = off + o.size;
                        nfo++;
                    };
                    i++;
                };
                t.frame = (off + 15) / 16 * 16;
                if (t.leaf & n == 0 & nfo == 0 & t.outmax == 0 & !t.dyn) { t.frame = 0; };
                ->;
            };

            // Offset from the frame base of memory operand m's frame object
            e_fooff(AI* m) -> i64
            {
                AGF* t = (AGF*)this.sf.tg;
                AFO* o;
                if (m.fo >= 0)
                {
                    o = (AFO*)t.fobj.items[m.fo];
                    if (o.fix == 1) { -> (i64)(t.frame + o.off); };
                    -> (i64)o.off;
                };
                -> (i64)t.frame;
            };

            // Base register of the frame: x29, or sp when the function has no frame
            e_fbase() -> int
            {
                if (((AGF*)this.sf.tg).frame == 0) { -> 31; };
                -> 29;
            };

            e_prologue(Buf* o) -> void
            {
                GF* g = this.sf;
                AGF* t = (AGF*)g.tg;
                int i, k;
                if (t.frame == 0) { ->; };
                this.e_addimm(o, 31, 31, (i64)0 - (i64)t.frame);
                o.put_str(g"\tstp x29, x30, [sp]\n\tmov x29, sp\n\0");
                k = 0;
                i = 0;
                while (i < 64)
                {
                    if ((t.saved `& ((i64)1 << (i64)i)) != (i64)0)
                    {
                        this.e_slot(o, g"str\0", i, t.csbase + 8 * k);
                        k++;
                    };
                    i++;
                };
                ->;
            };

            // Store or load of saved register i at offset off from x29
            e_slot(Buf* o, byte* mn, int i, int off) -> void
            {
                if (off <= 32760)
                {
                    o.put_str(g"\t\0");
                    o.put_str(mn);
                    o.put(32);
                    this.e_r(o, i, 8);
                    o.put_str(g", [x29, #\0");
                    o.put_int(off);
                    o.put_str(g"]\n\0");
                    ->;
                };
                this.e_movi(o, 16, (i64)off, 8);
                o.put_str(g"\t\0");
                o.put_str(mn);
                o.put(32);
                this.e_r(o, i, 8);
                o.put_str(g", [x29, x16]\n\0");
                ->;
            };

            e_epilogue(Buf* o) -> void
            {
                GF* g = this.sf;
                AGF* t = (AGF*)g.tg;
                int i, k;
                if (t.frame != 0)
                {
                    k = 0;
                    i = 0;
                    while (i < 64)
                    {
                        if ((t.saved `& ((i64)1 << (i64)i)) != (i64)0)
                        {
                            this.e_slot(o, g"ldr\0", i, t.csbase + 8 * k);
                            k++;
                        };
                        i++;
                    };
                    if (t.dyn) { o.put_str(g"\tmov sp, x29\n\0"); };
                    o.put_str(g"\tldp x29, x30, [sp]\n\0");
                    this.e_addimm(o, 31, 31, (i64)t.frame);
                };
                o.put_str(g"\tret\n\0");
                ->;
            };

            // ----------------------------------------------------------
            // Memory operands
            // ----------------------------------------------------------

            // Writes the instructions the memory operand of m needs first and leaves its text in tb
            e_maddr(Buf* o, AI* m, int sz) -> void
            {
                int b = 0 - 1;
                int ix, sc;
                i64 off = m.imm;
                bool legal;
                this.tb.clear();
                if (m.sym != (byte*)0)
                {
                    o.put_str(g"\tadrp x17, \0");
                    o.put_str(m.sym);
                    if (off > (i64)0) { o.put(43); put_i64(o, off); };
                    if (off < (i64)0) { put_i64(o, off); };
                    o.put_str(g"\n\tadd x17, x17, :lo12:\0");
                    o.put_str(m.sym);
                    if (off > (i64)0) { o.put(43); put_i64(o, off); };
                    if (off < (i64)0) { put_i64(o, off); };
                    o.put(10);
                    b = 17;
                    off = (i64)0;
                }
                elif (m.fo >= 0 | m.ma == 1)
                {
                    b = this.e_fbase();
                    off = off + this.e_fooff(m);
                }
                else { b = this.s_phys(m.a); };
                if (m.b >= 0)
                {
                    ix = this.s_phys(m.b);
                    sc = m.sc;
                    if (off == (i64)0 & (sc == 0 | (1 << sc) == sz))
                    {
                        this.tb.put_str(g"[\0");
                        this.eb_name(b);
                        this.tb.put_str(g", x\0");
                        this.tb.put_int(ix);
                        if (sc > 0) { this.tb.put_str(g", lsl #\0"); this.tb.put_int(sc); };
                        this.tb.put(93);
                        ->;
                    };
                    o.put_str(g"\tadd x17, \0");
                    this.e_b(o, b);
                    o.put_str(g", x\0");
                    o.put_int(ix);
                    if (sc > 0) { o.put_str(g", lsl #\0"); o.put_int(sc); };
                    o.put(10);
                    b = 17;
                };
                legal = false;
                if (off >= (i64)0 & off % (i64)sz == (i64)0 & off / (i64)sz < (i64)4096) { legal = true; };
                if (off >= (i64)-256 & off <= (i64)255) { legal = true; };
                this.tb.put_str(g"[\0");
                this.eb_name(b);
                if (legal)
                {
                    if (off != (i64)0) { this.tb.put_str(g", #\0"); put_i64(@this.tb, off); };
                    this.tb.put(93);
                    ->;
                };
                this.e_movi(o, 16, off, 8);
                this.tb.put_str(g", x16]\0");
                ->;
            };

            // Name of base register b in the memory text
            eb_name(int b) -> void
            {
                if (b == 31) { this.tb.put_str(g"sp\0"); ->; };
                this.tb.put(120);
                this.tb.put_int(b);
                ->;
            };

            // ----------------------------------------------------------
            // Instructions
            // ----------------------------------------------------------

            // Mnemonic of an A_ALU kind
            e_aluname(int k) -> byte*
            {
                if (k == L_ADD) { -> g"add\0"; };
                if (k == L_SUB) { -> g"sub\0"; };
                if (k == L_AND) { -> g"and\0"; };
                if (k == L_ORR) { -> g"orr\0"; };
                if (k == L_EOR) { -> g"eor\0"; };
                if (k == L_MUL) { -> g"mul\0"; };
                if (k == L_SDIV) { -> g"sdiv\0"; };
                if (k == L_UDIV) { -> g"udiv\0"; };
                if (k == L_LSL) { -> g"lsl\0"; };
                if (k == L_LSR) { -> g"lsr\0"; };
                -> g"asr\0";
            };

            e_alu(Buf* o, AI* m) -> void
            {
                int sz = m.sz;
                int d = this.s_phys(m.d);
                int a = this.s_phys(m.a);
                int k = m.k;
                i64 v = m.imm;
                i64 av;
                bool imm = m.b < 0;
                bool sub;
                if (imm)
                {
                    if (sz == 4) { v = (i64)((int)v); };
                    if (k == L_LSL | k == L_LSR | k == L_ASR)
                    {
                        o.put_str(g"\t\0");
                        o.put_str(this.e_aluname(k));
                        o.put(32);
                        this.e_r(o, d, sz);
                        o.put_str(g", \0");
                        this.e_r(o, a, sz);
                        o.put_str(g", #\0");
                        put_i64(o, v `& (i64)(sz * 8 - 1));
                        o.put(10);
                        ->;
                    };
                    if (k == L_ADD | k == L_SUB)
                    {
                        sub = k == L_SUB;
                        av = v;
                        if (v < (i64)0) { av = (i64)0 - v; sub = !sub; };
                        if (sz == 4 & av > (i64)2147483648) { av = (i64)0 - av; };
                        if (a != 31 & av >= (i64)0 & (av <= (i64)4095 | ((av `& (i64)4095) == (i64)0 & (av >> (i64)12) <= (i64)4095)))
                        {
                            if (sub) { o.put_str(g"\tsub \0"); } else { o.put_str(g"\tadd \0"); };
                            this.e_r(o, d, sz);
                            o.put_str(g", \0");
                            this.e_r(o, a, sz);
                            o.put_str(g", #\0");
                            if (av <= (i64)4095) { put_i64(o, av); }
                            else { put_i64(o, av >> (i64)12); o.put_str(g", lsl #12\0"); };
                            o.put(10);
                            ->;
                        };
                    };
                    if (k == L_AND | k == L_ORR | k == L_EOR)
                    {
                        if (this.e_bitmask((u64)v, sz))
                        {
                            o.put_str(g"\t\0");
                            o.put_str(this.e_aluname(k));
                            o.put(32);
                            this.e_r(o, d, sz);
                            o.put_str(g", \0");
                            this.e_r(o, a, sz);
                            o.put_str(g", #\0");
                            put_u64(o, (u64)v);
                            o.put(10);
                            ->;
                        };
                    };
                    // the constant does not fit the instruction: it goes through x17
                    this.e_movi(o, 17, v, sz);
                    o.put_str(g"\t\0");
                    o.put_str(this.e_aluname(k));
                    o.put(32);
                    this.e_r(o, d, sz);
                    o.put_str(g", \0");
                    this.e_r(o, a, sz);
                    o.put_str(g", \0");
                    this.e_r(o, 17, sz);
                    o.put(10);
                    ->;
                };
                o.put_str(g"\t\0");
                o.put_str(this.e_aluname(k));
                o.put(32);
                this.e_r(o, d, sz);
                o.put_str(g", \0");
                this.e_r(o, a, sz);
                o.put_str(g", \0");
                this.e_pr(o, m.b, sz);
                if (m.sc > 0)
                {
                    o.put_str(g", lsl #\0");
                    o.put_int(m.sc);
                };
                o.put(10);
                ->;
            };

            // Compare of a with b or with the constant of m, op is "cmp" or "tst"
            e_cmp(Buf* o, AI* m) -> void
            {
                int sz = m.sz;
                int a = this.s_phys(m.a);
                i64 v = m.imm;
                i64 av;
                if (m.b >= 0)
                {
                    if (m.op == A_TST) { o.put_str(g"\ttst \0"); } else { o.put_str(g"\tcmp \0"); };
                    this.e_r(o, a, sz);
                    o.put_str(g", \0");
                    this.e_pr(o, m.b, sz);
                    o.put(10);
                    ->;
                };
                if (sz == 4) { v = (i64)((int)v); };
                if (m.op == A_TST)
                {
                    if (this.e_bitmask((u64)v, sz))
                    {
                        o.put_str(g"\ttst \0");
                        this.e_r(o, a, sz);
                        o.put_str(g", #\0");
                        put_u64(o, (u64)v);
                        o.put(10);
                        ->;
                    };
                    this.e_movi(o, 17, v, sz);
                    o.put_str(g"\ttst \0");
                    this.e_r(o, a, sz);
                    o.put_str(g", \0");
                    this.e_r(o, 17, sz);
                    o.put(10);
                    ->;
                };
                if (a != 31)
                {
                    if (v >= (i64)0 & v <= (i64)4095)
                    {
                        o.put_str(g"\tcmp \0");
                        this.e_r(o, a, sz);
                        o.put_str(g", #\0");
                        put_i64(o, v);
                        o.put(10);
                        ->;
                    };
                    if (v < (i64)0 & v >= (i64)-4095)
                    {
                        av = (i64)0 - v;
                        o.put_str(g"\tcmn \0");
                        this.e_r(o, a, sz);
                        o.put_str(g", #\0");
                        put_i64(o, av);
                        o.put(10);
                        ->;
                    };
                    if (v > (i64)0 & (v `& (i64)4095) == (i64)0 & (v >> (i64)12) <= (i64)4095)
                    {
                        o.put_str(g"\tcmp \0");
                        this.e_r(o, a, sz);
                        o.put_str(g", #\0");
                        put_i64(o, v >> (i64)12);
                        o.put_str(g", lsl #12\n\0");
                        ->;
                    };
                };
                this.e_movi(o, 17, v, sz);
                o.put_str(g"\tcmp \0");
                this.e_r(o, a, sz);
                o.put_str(g", \0");
                this.e_r(o, 17, sz);
                o.put(10);
                ->;
            };

            e_label(Buf* o, int id) -> void
            {
                o.put_str(g".LB\0");
                o.put_int(id);
                ->;
            };

            // Local label number n
            e_ll(Buf* o, int n) -> void
            {
                o.put_str(g".LM\0");
                o.put_int(n);
                ->;
            };

            // Table of 32 bit offsets of jump table m, written after the function
            e_jtable(AI* m, int n) -> void
            {
                int i = 0;
                this.jb.put_str(g"\t.p2align 2\n.LJ\0");
                this.jb.put_int(n);
                this.jb.put_str(g":\n\0");
                while (i < m.k)
                {
                    this.jb.put_str(g"\t.word .LB\0");
                    this.jb.put_int(((int*)m.text)[i]);
                    this.jb.put_str(g" - .LJ\0");
                    this.jb.put_int(n);
                    this.jb.put(10);
                    i++;
                };
                ->;
            };

            // Binary search over the sorted case values of m between lo and hi (exclusive), x0 holds the value
            e_search(Buf* o, AI* m, int lo, int hi, int r) -> void
            {
                int n = m.k;
                int i, mid, l1;
                u64 val;
                if (hi - lo <= 3)
                {
                    i = lo;
                    while (i < hi)
                    {
                        val = ((u64*)m.text)[i];
                        this.e_movi(o, 17, (i64)val, 8);
                        o.put_str(g"\tcmp \0");
                        this.e_r(o, r, 8);
                        o.put_str(g", x17\n\tb.eq \0");
                        this.e_label(o, ((int*)m.text)[2 * n + i]);
                        o.put(10);
                        i++;
                    };
                    o.put_str(g"\tb \0");
                    this.e_label(o, m.tgt);
                    o.put(10);
                    ->;
                };
                mid = (lo + hi) / 2;
                val = ((u64*)m.text)[mid];
                this.e_movi(o, 17, (i64)val, 8);
                o.put_str(g"\tcmp \0");
                this.e_r(o, r, 8);
                o.put_str(g", x17\n\tb.eq \0");
                this.e_label(o, ((int*)m.text)[2 * n + mid]);
                o.put(10);
                this.nlab++;
                l1 = this.nlab;
                o.put_str(g"\tb.lo \0");
                this.e_ll(o, l1);
                o.put(10);
                this.e_search(o, m, mid + 1, hi, r);
                this.e_ll(o, l1);
                o.put_str(g":\n\0");
                this.e_search(o, m, lo, mid, r);
                ->;
            };

            // Block copy and fill loops over x0 (destination), x1 (source or byte), x2 (bytes), x3 scratch
            e_mem(Buf* o, AI* m) -> void
            {
                int l1, l2, l3, l4, l5;
                int sz;
                this.nlab++; l1 = this.nlab;
                this.nlab++; l2 = this.nlab;
                this.nlab++; l3 = this.nlab;
                this.nlab++; l4 = this.nlab;
                this.nlab++; l5 = this.nlab;
                if (m.op == A_MEMSET)
                {
                    o.put_str(g"\tand x1, x1, #255\n\tmovz x16, #257\n\tmovk x16, #257, lsl #16\n\tmovk x16, #257, lsl #32\n\tmovk x16, #257, lsl #48\n\tmul x1, x1, x16\n\0");
                    o.put_str(g"\tcmp x2, #8\n\tb.lo \0");
                    this.e_ll(o, l2);
                    o.put_str(g"\n\0");
                    this.e_ll(o, l1);
                    o.put_str(g":\n\tstr x1, [x0], #8\n\tsub x2, x2, #8\n\tcmp x2, #8\n\tb.hs \0");
                    this.e_ll(o, l1);
                    o.put_str(g"\n\0");
                    this.e_ll(o, l2);
                    o.put_str(g":\n\tcbz x2, \0");
                    this.e_ll(o, l3);
                    o.put_str(g"\n\0");
                    this.e_ll(o, l4);
                    o.put_str(g":\n\tstrb w1, [x0], #1\n\tsubs x2, x2, #1\n\tb.ne \0");
                    this.e_ll(o, l4);
                    o.put(10);
                    this.e_ll(o, l3);
                    o.put_str(g":\n\0");
                    ->;
                };
                if (m.op == A_MEMCPY & m.k != 0)
                {
                    // elements of size k copied in reverse order: the last source element goes first
                    sz = m.k;
                    o.put_str(g"\tadd x3, x1, x2\n\0");
                    this.e_ll(o, l1);
                    o.put_str(g":\n\tcbz x2, \0");
                    this.e_ll(o, l3);
                    o.put_str(g"\n\tsub x3, x3, #\0");
                    o.put_int(sz);
                    o.put_str(g"\n\0");
                    if (sz == 8) { o.put_str(g"\tldr x16, [x3]\n\tstr x16, [x0], #8\n\0"); };
                    if (sz == 4) { o.put_str(g"\tldr w16, [x3]\n\tstr w16, [x0], #4\n\0"); };
                    if (sz == 2) { o.put_str(g"\tldrh w16, [x3]\n\tstrh w16, [x0], #2\n\0"); };
                    if (sz == 1) { o.put_str(g"\tldrb w16, [x3]\n\tstrb w16, [x0], #1\n\0"); };
                    o.put_str(g"\tsub x2, x2, #\0");
                    o.put_int(sz);
                    o.put_str(g"\n\tb \0");
                    this.e_ll(o, l1);
                    o.put(10);
                    this.e_ll(o, l3);
                    o.put_str(g":\n\0");
                    ->;
                };
                if (m.op == A_MEMMOVE)
                {
                    // forward when the destination is below the source or beyond its end, else backward
                    o.put_str(g"\tcmp x0, x1\n\tb.ls \0");
                    this.e_ll(o, l1);
                    o.put_str(g"\n\tadd x16, x1, x2\n\tcmp x0, x16\n\tb.lo \0");
                    this.e_ll(o, l5);
                    o.put_str(g"\n\0");
                    this.e_ll(o, l1);
                    o.put_str(g":\n\tcbz x2, \0");
                    this.e_ll(o, l3);
                    o.put_str(g"\n\tldrb w16, [x1], #1\n\tstrb w16, [x0], #1\n\tsub x2, x2, #1\n\tb \0");
                    this.e_ll(o, l1);
                    o.put(10);
                    this.e_ll(o, l5);
                    o.put_str(g":\n\tadd x0, x0, x2\n\tadd x1, x1, x2\n\0");
                    this.e_ll(o, l4);
                    o.put_str(g":\n\tcbz x2, \0");
                    this.e_ll(o, l3);
                    o.put_str(g"\n\tldrb w16, [x1, #-1]!\n\tstrb w16, [x0, #-1]!\n\tsub x2, x2, #1\n\tb \0");
                    this.e_ll(o, l4);
                    o.put(10);
                    this.e_ll(o, l3);
                    o.put_str(g":\n\0");
                    ->;
                };
                // forward copy: eight bytes at a time, then the tail
                o.put_str(g"\tcmp x2, #8\n\tb.lo \0");
                this.e_ll(o, l2);
                o.put(10);
                this.e_ll(o, l1);
                o.put_str(g":\n\tldr x16, [x1], #8\n\tstr x16, [x0], #8\n\tsub x2, x2, #8\n\tcmp x2, #8\n\tb.hs \0");
                this.e_ll(o, l1);
                o.put(10);
                this.e_ll(o, l2);
                o.put_str(g":\n\tcbz x2, \0");
                this.e_ll(o, l3);
                o.put_str(g"\n\0");
                this.e_ll(o, l4);
                o.put_str(g":\n\tldrb w16, [x1], #1\n\tstrb w16, [x0], #1\n\tsubs x2, x2, #1\n\tb.ne \0");
                this.e_ll(o, l4);
                o.put(10);
                this.e_ll(o, l3);
                o.put_str(g":\n\0");
                ->;
            };

            // True when a float register number is meant
            e_isfp(int r) -> bool
            {
                -> r >= 32;
            };

            e_mi(Buf* o, GB* gb, int j, int nxid) -> int
            {
                AI* m = (AI*)gb.mi.items[j];
                AI* n2;
                int op = m.op;
                int sz = m.sz;
                int d, a, b, c, tn, cc;
                AGF* t = (AGF*)this.sf.tg;
                byte* mn;
                if (op == A_NOP) { -> 0; };
                if (op == A_MOV)
                {
                    d = this.s_phys(m.d);
                    a = this.s_phys(m.a);
                    if (d == a) { -> 0; };
                    if (d >= 32)
                    {
                        o.put_str(g"\tfmov \0");
                        this.e_r(o, d, sz);
                        o.put_str(g", \0");
                        this.e_r(o, a, sz);
                        o.put(10);
                        -> 0;
                    };
                    o.put_str(g"\tmov \0");
                    this.e_r(o, d, sz);
                    o.put_str(g", \0");
                    this.e_r(o, a, sz);
                    o.put(10);
                    -> 0;
                };
                if (op == A_MOVI)
                {
                    this.e_movi(o, this.s_phys(m.d), m.imm, sz);
                    -> 0;
                };
                if (op == A_FMOVI)
                {
                    d = this.s_phys(m.d);
                    if (m.imm == (i64)0)
                    {
                        o.put_str(g"\tfmov \0");
                        this.e_r(o, d, sz);
                        o.put_str(g", \0");
                        this.e_r(o, AR_ZR, sz);
                        o.put(10);
                        -> 0;
                    };
                    this.e_movi(o, 17, m.imm, sz);
                    o.put_str(g"\tfmov \0");
                    this.e_r(o, d, sz);
                    o.put_str(g", \0");
                    this.e_r(o, 17, sz);
                    o.put(10);
                    -> 0;
                };
                if (op == A_ADR)
                {
                    d = this.s_phys(m.d);
                    o.put_str(g"\tadrp \0");
                    this.e_r(o, d, 8);
                    o.put_str(g", \0");
                    o.put_str(m.sym);
                    if (m.imm > (i64)0) { o.put(43); put_i64(o, m.imm); };
                    if (m.imm < (i64)0) { put_i64(o, m.imm); };
                    o.put_str(g"\n\tadd \0");
                    this.e_r(o, d, 8);
                    o.put_str(g", \0");
                    this.e_r(o, d, 8);
                    o.put_str(g", :lo12:\0");
                    o.put_str(m.sym);
                    if (m.imm > (i64)0) { o.put(43); put_i64(o, m.imm); };
                    if (m.imm < (i64)0) { put_i64(o, m.imm); };
                    o.put(10);
                    -> 0;
                };
                if (op == A_ADDFO)
                {
                    if (m.k == 1)
                    {
                        // the frame record: x29 holds the saved x29, the link register follows
                        this.e_addimm(o, this.s_phys(m.d), 29, (i64)8);
                        -> 0;
                    };
                    this.e_addimm(o, this.s_phys(m.d), this.e_fbase(), this.e_fooff(m) + m.imm);
                    -> 0;
                };
                if (op == A_ALU) { this.e_alu(o, m); -> 0; };
                if (op == A_MADD)
                {
                    if (m.k == 0) { o.put_str(g"\tmadd \0"); } else { o.put_str(g"\tmsub \0"); };
                    this.e_pr(o, m.d, sz);
                    o.put_str(g", \0");
                    this.e_pr(o, m.a, sz);
                    o.put_str(g", \0");
                    this.e_pr(o, m.b, sz);
                    o.put_str(g", \0");
                    this.e_pr(o, m.c, sz);
                    o.put(10);
                    -> 0;
                };
                if (op == A_UN)
                {
                    if (m.k == N_NEG) { o.put_str(g"\tneg \0"); };
                    if (m.k == N_MVN) { o.put_str(g"\tmvn \0"); };
                    if (m.k == N_CLZ) { o.put_str(g"\tclz \0"); };
                    if (m.k == N_RBIT) { o.put_str(g"\trbit \0"); };
                    if (m.k == N_REV) { o.put_str(g"\trev \0"); };
                    if (m.k == N_REV16) { o.put_str(g"\trev16 \0"); };
                    this.e_pr(o, m.d, sz);
                    o.put_str(g", \0");
                    this.e_pr(o, m.a, sz);
                    o.put(10);
                    -> 0;
                };
                if (op == A_EXT)
                {
                    c = (int)m.imm;
                    if (m.k == 1 & c == 8) { o.put_str(g"\tsxtb \0"); this.e_pr(o, m.d, sz); o.put_str(g", \0"); this.e_pr(o, m.a, 4); o.put(10); -> 0; };
                    if (m.k == 1 & c == 16) { o.put_str(g"\tsxth \0"); this.e_pr(o, m.d, sz); o.put_str(g", \0"); this.e_pr(o, m.a, 4); o.put(10); -> 0; };
                    if (m.k == 1 & c == 32) { o.put_str(g"\tsxtw \0"); this.e_pr(o, m.d, 8); o.put_str(g", \0"); this.e_pr(o, m.a, 4); o.put(10); -> 0; };
                    if (m.k == 0 & c == 8) { o.put_str(g"\tuxtb \0"); this.e_pr(o, m.d, 4); o.put_str(g", \0"); this.e_pr(o, m.a, 4); o.put(10); -> 0; };
                    if (m.k == 0 & c == 16) { o.put_str(g"\tuxth \0"); this.e_pr(o, m.d, 4); o.put_str(g", \0"); this.e_pr(o, m.a, 4); o.put(10); -> 0; };
                    if (m.k == 0 & c == 32) { o.put_str(g"\tmov \0"); this.e_pr(o, m.d, 4); o.put_str(g", \0"); this.e_pr(o, m.a, 4); o.put(10); -> 0; };
                    if (m.k == 1) { o.put_str(g"\tsbfx \0"); } else { o.put_str(g"\tubfx \0"); };
                    this.e_pr(o, m.d, sz);
                    o.put_str(g", \0");
                    this.e_pr(o, m.a, sz);
                    o.put_str(g", #0, #\0");
                    o.put_int(c);
                    o.put(10);
                    -> 0;
                };
                if (op == A_CMP | op == A_TST) { this.e_cmp(o, m); -> 0; };
                if (op == A_FCMP)
                {
                    o.put_str(g"\tfcmp \0");
                    this.e_pr(o, m.a, sz);
                    o.put_str(g", \0");
                    this.e_pr(o, m.b, sz);
                    o.put(10);
                    -> 0;
                };
                if (op == A_CSET)
                {
                    o.put_str(g"\tcset \0");
                    this.e_pr(o, m.d, 4);
                    o.put_str(g", \0");
                    this.e_cc(o, m.cc);
                    o.put(10);
                    -> 0;
                };
                if (op == A_CSEL | op == A_FCSEL)
                {
                    if (op == A_CSEL) { o.put_str(g"\tcsel \0"); } else { o.put_str(g"\tfcsel \0"); };
                    this.e_pr(o, m.d, sz);
                    o.put_str(g", \0");
                    this.e_pr(o, m.a, sz);
                    o.put_str(g", \0");
                    this.e_pr(o, m.b, sz);
                    o.put_str(g", \0");
                    this.e_cc(o, m.cc);
                    o.put(10);
                    -> 0;
                };
                if (op == A_LD | op == A_ST)
                {
                    this.e_maddr(o, m, sz);
                    d = this.s_phys(m.d);
                    if (op == A_LD) { mn = g"ldr\0"; } else { mn = g"str\0"; };
                    if (op == A_LD & m.k == 1 & d < 32)
                    {
                        if (sz == 1) { mn = g"ldrsb\0"; };
                        if (sz == 2) { mn = g"ldrsh\0"; };
                        if (sz == 4) { mn = g"ldrsw\0"; };
                    };
                    o.put(9);
                    o.put_str(mn);
                    if (d < 32 & m.k == 0)
                    {
                        if (sz == 1) { o.put(98); };
                        if (sz == 2) { o.put(104); };
                    };
                    o.put(32);
                    if (m.k == 1 & d < 32) { this.e_r(o, d, 8); }
                    else { this.e_r(o, d, sz); };
                    o.put_str(g", \0");
                    o.put_str(this.tb.mem);
                    o.put(10);
                    -> 0;
                };
                if (op == A_B)
                {
                    if (m.tgt == nxid) { -> 0; };
                    o.put_str(g"\tb \0");
                    this.e_label(o, m.tgt);
                    o.put(10);
                    -> 0;
                };
                if (op == A_BC)
                {
                    if (j + 1 < gb.mi.len & m.tgt == nxid)
                    {
                        n2 = (AI*)gb.mi.items[j + 1];
                        if (n2.op == A_B)
                        {
                            if (n2.tgt != nxid)
                            {
                                o.put_str(g"\tb.\0");
                                this.e_cc(o, m.cc `^| 1);
                                o.put(32);
                                this.e_label(o, n2.tgt);
                                o.put(10);
                            };
                            -> 1;
                        };
                    };
                    o.put_str(g"\tb.\0");
                    this.e_cc(o, m.cc);
                    o.put(32);
                    this.e_label(o, m.tgt);
                    o.put(10);
                    -> 0;
                };
                if (op == A_CBZ | op == A_CBNZ)
                {
                    if (j + 1 < gb.mi.len & m.tgt == nxid)
                    {
                        n2 = (AI*)gb.mi.items[j + 1];
                        if (n2.op == A_B)
                        {
                            if (n2.tgt != nxid)
                            {
                                if (op == A_CBZ) { o.put_str(g"\tcbnz \0"); } else { o.put_str(g"\tcbz \0"); };
                                this.e_pr(o, m.a, sz);
                                o.put_str(g", \0");
                                this.e_label(o, n2.tgt);
                                o.put(10);
                            };
                            -> 1;
                        };
                    };
                    if (op == A_CBZ) { o.put_str(g"\tcbz \0"); } else { o.put_str(g"\tcbnz \0"); };
                    this.e_pr(o, m.a, sz);
                    o.put_str(g", \0");
                    this.e_label(o, m.tgt);
                    o.put(10);
                    -> 0;
                };
                if (op == A_BL)
                {
                    o.put_str(g"\tbl \0");
                    o.put_str(m.sym);
                    o.put(10);
                    -> 0;
                };
                if (op == A_BLR)
                {
                    o.put_str(g"\tblr \0");
                    this.e_pr(o, m.a, 8);
                    o.put(10);
                    -> 0;
                };
                if (op == A_RET) { this.e_epilogue(o); -> 0; };
                if (op == A_BRK) { o.put_str(g"\tbrk #1\n\0"); -> 0; };
                if (op == A_JT)
                {
                    this.nlab++;
                    tn = this.nlab;
                    this.e_jtable(m, tn);
                    o.put_str(g"\tadr x17, .LJ\0");
                    o.put_int(tn);
                    o.put_str(g"\n\tldrsw x16, [x17, \0");
                    this.e_pr(o, m.a, 8);
                    o.put_str(g", lsl #2]\n\tadd x17, x17, x16\n\tbr x17\n\0");
                    -> 0;
                };
                if (op == A_SWBIN)
                {
                    this.e_search(o, m, 0, m.k, this.s_phys(m.a));
                    -> 0;
                };
                if (op == A_DALLOC)
                {
                    a = this.s_phys(m.a);
                    o.put_str(g"\tadd x17, \0");
                    this.e_r(o, a, 8);
                    o.put_str(g", #15\n\tand x17, x17, #-16\n\tsub sp, sp, x17\n\0");
                    this.e_addimm(o, this.s_phys(m.d), 31, (i64)((t.outmax + 15) / 16 * 16));
                    -> 0;
                };
                if (op == A_MEMCPY | op == A_MEMSET | op == A_MEMMOVE) { this.e_mem(o, m); -> 0; };
                if (op == A_FALU)
                {
                    if (m.k == FA_ADD) { o.put_str(g"\tfadd \0"); };
                    if (m.k == FA_SUB) { o.put_str(g"\tfsub \0"); };
                    if (m.k == FA_MUL) { o.put_str(g"\tfmul \0"); };
                    if (m.k == FA_DIV) { o.put_str(g"\tfdiv \0"); };
                    this.e_pr(o, m.d, sz);
                    o.put_str(g", \0");
                    this.e_pr(o, m.a, sz);
                    o.put_str(g", \0");
                    this.e_pr(o, m.b, sz);
                    o.put(10);
                    -> 0;
                };
                if (op == A_FUN)
                {
                    if (m.k == FU_NEG) { o.put_str(g"\tfneg \0"); };
                    if (m.k == FU_ABS) { o.put_str(g"\tfabs \0"); };
                    if (m.k == FU_SQRT) { o.put_str(g"\tfsqrt \0"); };
                    if (m.k == FU_RINTZ) { o.put_str(g"\tfrintz \0"); };
                    this.e_pr(o, m.d, sz);
                    o.put_str(g", \0");
                    this.e_pr(o, m.a, sz);
                    o.put(10);
                    -> 0;
                };
                if (op == A_FCVT)
                {
                    o.put_str(g"\tfcvt \0");
                    this.e_pr(o, m.d, sz);
                    o.put_str(g", \0");
                    this.e_pr(o, m.a, m.cc);
                    o.put(10);
                    -> 0;
                };
                if (op == A_CVT)
                {
                    if (m.k == CV_SCVTF | m.k == CV_UCVTF)
                    {
                        if (m.k == CV_SCVTF) { o.put_str(g"\tscvtf \0"); } else { o.put_str(g"\tucvtf \0"); };
                        this.e_pr(o, m.d, m.cc);
                        o.put_str(g", \0");
                        this.e_pr(o, m.a, sz);
                        o.put(10);
                        -> 0;
                    };
                    if (m.k == CV_FCVTZS) { o.put_str(g"\tfcvtzs \0"); } else { o.put_str(g"\tfcvtzu \0"); };
                    this.e_pr(o, m.d, sz);
                    o.put_str(g", \0");
                    this.e_pr(o, m.a, m.cc);
                    o.put(10);
                    -> 0;
                };
                if (op == A_FMOVX)
                {
                    o.put_str(g"\tfmov \0");
                    this.e_pr(o, m.d, sz);
                    o.put_str(g", \0");
                    this.e_pr(o, m.a, sz);
                    o.put(10);
                    -> 0;
                };
                if (op == A_FMSUB)
                {
                    o.put_str(g"\tfmsub \0");
                    this.e_pr(o, m.d, sz);
                    o.put_str(g", \0");
                    this.e_pr(o, m.a, sz);
                    o.put_str(g", \0");
                    this.e_pr(o, m.b, sz);
                    o.put_str(g", \0");
                    this.e_pr(o, m.c, sz);
                    o.put(10);
                    -> 0;
                };
                if (op == A_ASM)
                {
                    o.put_str(m.text);
                    o.put(10);
                    -> 0;
                };
                this.s_fail(g"machine instruction\0");
                -> 0;
            };

            // ----------------------------------------------------------
            // Function
            // ----------------------------------------------------------

            // Directives and label that start function f
            e_head(IRFunc* f, Buf* out) -> void
            {
                byte* nm = this.a_sym(f.self.text);
                bool islocal = false;
                bool weak = false;
                if (f.linkage != (byte*)0)
                {
                    if (this.a_seq(f.linkage, g"internal\0") | this.a_seq(f.linkage, g"private\0")) { islocal = true; };
                    if (this.a_pre(f.linkage, g"linkonce\0") | this.a_pre(f.linkage, g"weak\0")) { weak = true; };
                };
                out.put_str(g"\t.text\n\0");
                if (!islocal)
                {
                    if (weak) { out.put_str(g"\t.weak \0"); } else { out.put_str(g"\t.globl \0"); };
                    out.put_str(nm);
                    out.put(10);
                };
                out.put_str(g"\t.p2align 2\n\t.type \0");
                out.put_str(nm);
                out.put_str(g",@function\n\0");
                out.put_str(nm);
                out.put_str(g":\n\0");
                ->;
            };

            // The body of a naked function: the inline asm of its blocks exactly as written, no prologue
            s_naked(IRFunc* f, Buf* out) -> void
            {
                IRBlock* bl;
                SI* x;
                IRValue* callee;
                byte* t;
                int j, k, i, len, bs, bodyend, qs, ce, ls, le, c;
                byte* nm = this.a_sym(f.self.text);
                this.e_head(f, out);
                j = 0;
                while (j < f.blocks.len)
                {
                    bl = (IRBlock*)f.blocks.items[j];
                    out.put_str(g".LB\0");
                    out.put_int(bl.id);
                    out.put_str(g":\n\0");
                    k = 0;
                    while (bl.insts != (PtrVec*)0 & k < bl.insts.len)
                    {
                        x = (SI*)bl.insts.items[k];
                        k++;
                        if (x.op == SO_RETV) { out.put_str(g"\tret\n\0"); }
                        elif (x.op == SO_UNREACH) { out.put_str(g"\tbrk #1\n\0"); }
                        elif (x.op == SO_BR)
                        {
                            out.put_str(g"\tb .LB\0");
                            out.put_int(x.t.id);
                            out.put(10);
                        }
                        else
                        {
                            callee = x.a;
                            if (x.op != SO_CALL | callee == (IRValue*)0) { this.s_fail(g"naked body\0"); ->; };
                            if (!this.a_pre(callee.text, g"asm\0")) { this.s_fail(g"naked body\0"); ->; };
                            t = callee.text;
                            len = 0;
                            while (t[len] != 0) { len++; };
                            while (len > 0 & t[len - 1] != 34) { len--; };
                            ce = len - 1;
                            qs = ce - 1;
                            while (qs > 0 & t[qs] != 34) { qs--; };
                            bodyend = qs - 3;
                            bs = 0;
                            while (t[bs] != 34) { bs++; };
                            bs++;
                            this.mb.clear();
                            i = bs;
                            while (i < bodyend)
                            {
                                c = (int)t[i];
                                if (c == '$')
                                {
                                    if (t[i + 1] != '$') { this.s_fail(g"naked operand\0"); ->; };
                                    this.mb.put(36);
                                    i = i + 2;
                                }
                                else { this.mb.put(c); i++; };
                            };
                            i = 0;
                            while (i <= this.mb.len)
                            {
                                ls = i;
                                while (i < this.mb.len & this.mb.mem[i] != 10) { i++; };
                                le = i;
                                while (ls < le & (this.mb.mem[ls] == ' ' | this.mb.mem[ls] == 9 | this.mb.mem[ls] == 13)) { ls++; };
                                while (le > ls & (this.mb.mem[le - 1] == ' ' | this.mb.mem[le - 1] == 9 | this.mb.mem[le - 1] == 13)) { le--; };
                                if (le > ls)
                                {
                                    out.put(9);
                                    out.put_n(this.mb.mem + ls, le - ls);
                                    out.put(10);
                                };
                                i++;
                            };
                        };
                    };
                    j++;
                };
                out.put_str(g"\t.size \0");
                out.put_str(nm);
                out.put_str(g", .-\0");
                out.put_str(nm);
                out.put(10);
                ->;
            };

            s_emit(IRFunc* f, Buf* out) -> void
            {
                GF* g = this.sf;
                byte* nm = this.a_sym(f.self.text);
                int i, j, nxid, skip;
                GB* gb;
                this.jb.len = 0;
                this.jb.mem[0] = 0;
                this.e_layout();
                this.e_head(f, out);
                this.e_prologue(out);
                i = 0;
                while (i < g.nb)
                {
                    gb = g.rpo[i];
                    nxid = 0 - 1;
                    if (i + 1 < g.nb) { nxid = g.rpo[i + 1].id; };
                    out.put_str(g".LB\0");
                    out.put_int(gb.id);
                    out.put_str(g":\n\0");
                    j = 0;
                    while (j < gb.mi.len)
                    {
                        skip = this.e_mi(out, gb, j, nxid);
                        j = j + 1 + skip;
                    };
                    i++;
                };
                out.put_str(g"\t.size \0");
                out.put_str(nm);
                out.put_str(g", .-\0");
                out.put_str(nm);
                out.put(10);
                if (this.jb.len > 0) { out.put_str(this.jb.mem); };
                ->;
            };
        };
    };
};

#endif;
