// Author: Karac V. Thweatt
//
// issa.idk - SSA code generator of the x86_64 backend. Imported inside object X64Module (ix64.idk), every
// method here is a member. Records the instructions the front end builds, turns the function into SSA form,
// selects machine instructions over virtual registers, allocates registers on the interference graph and
// writes AT&T assembly.

#ifndef IDEKA_SSA
#def IDEKA_SSA 1;

// Switches of the optimizations, 1 on and 0 off. Each can be turned off alone to find which one changes the speed of a program.
#def SSA_OPT_EQCHAIN 1;    // a chain of tests of one value against constants becomes range checks and bit tests
#def SSA_OPT_FILLG 1;      // a fill or copy loop runs as one only when the count is large enough to repay the start up of rep
#def SSA_OPT_FILLX 1;      // fill and copy loops may start anywhere and run to an inclusive bound
#def SSA_OPT_FILL 1;       // loops that store one value over an array become a single block fill
#def SSA_OPT_FOLD 1;       // constant folding, identities, trivial phis, common subexpressions
#def SSA_OPT_IFCONV 1;     // integer branches merged into cmov
#def SSA_OPT_BMIX 1;       // andn, blsr, blsi, bzhi and rorx for the matching bit expressions
#def SSA_OPT_BMI 1;        // needs BMI2: variable shifts use shlx, shrx and sarx
#def SSA_OPT_ABSIDX 1;     // indexed access to a global array uses an absolute 32 bit address (Linux, non-PIE)
#def SSA_OPT_HOISTCSE 1;   // hoisted loads are matched against earlier loads of the same address
#def SSA_OPT_LAZYMULTI 1;  // a constant offset address used by several accesses is folded into each
#def SSA_OPT_SWCOPY 1;     // a callee saved register copied from an argument register outside the frame takes that register
#def SSA_OPT_THRPHI 1;     // a branch on a phi is also taken by the blocks that supply constants when its targets have phis
#def SSA_OPT_RETTHR 1;     // a block that returns a phi is replaced by returns in the blocks that jump to it
#def SSA_OPT_TAILDUP 1;    // a jump to a block that only returns is replaced by the return
#def SSA_OPT_SINK 1;       // a value only one successor uses is computed there
#def SSA_OPT_DOMLD 0;      // load CSE continues from a join block to its immediate dominator when nothing between can write the address
#def SSA_OPT_ALIAS 1;      // loads and stores to different objects, tied parameters, unescaped stack objects: no interference
#def SSA_OPT_SPILLFWD 1;  // a spilled value just loaded or stored is reused by the next uses nearby
#def SSA_OPT_MDCE 1;      // instructions whose register is never read are dropped
#def SSA_OPT_IDXOFF 1;    // index plus constant becomes a displacement
#def SSA_OPT_SR 1;         // a counter that indexes elements of an odd size is replaced by a stepping pointer
#def SSA_OPT_IVW 1;       // a 32 bit counter that indexes memory and is bounded by a signed compare is kept as a 64 bit counter
#def SSA_OPT_DIVC 1;      // division and remainder by a constant use a multiply
#def SSA_OPT_TAILCALL 0;   // a call whose result is returned unchanged becomes a jump (Linux)
#def SSA_OPT_CALLBOOL 1;   // bool call results feeding only a branch skip the zero extension
#def SSA_OPT_SHRINK 1;     // the frame is set up only in the blocks that need it
#def SSA_OPT_MULSEL 1;    // a product with a truth value becomes a select
#def SSA_OPT_DOMCOND 1;    // comparisons repeated below a branch on them fold to constants
#def SSA_OPT_LDHOIST 1;    // loads of loop invariant addresses leave loops that write no memory
#def SSA_OPT_LICM 0;       // loop invariant code motion
#def SSA_OPT_NOFP 1;       // leaf functions without a frame pointer
#def SSA_OPT_SWCHAIN 1;    // switches of up to four cases as compare and branch
#def SSA_OPT_MERGE 1;      // a block absorbs the block it jumps to when nothing else reaches that one
#def SSA_OPT_ROTATE 1;     // a jump back to a plain compare and branch repeats the test in place
#def SSA_OPT_LAYOUT 1;     // blocks are placed so the likely successor follows
#def SSA_OPT_STMERGE 1;    // stores of constant bytes to neighbouring addresses become wider stores
#def SSA_OPT_JTHREAD 1;    // a branch to a block that only jumps goes to the final target
#def SSA_OPT_THREAD 1;     // a branch on a phi of truth values is taken by the blocks that supply them
#def SSA_OPT_TESTELIM 1;   // a test of a register the previous instruction computed is dropped
#def SSA_OPT_VRED 1;       // sums of counted loops are split over four accumulators
#def SSA_OPT_UNROLL 1;     // short counted loops are written out once per trip
#def SSA_OPT_ZEXT 1;       // drop a zero extend of an already zero extended register

            // ==========================================================
            // recording, constants, control flow graph, dominators, promotion of stack
            // slots to SSA values.
            // ==========================================================

            // ----------------------------------------------------------
            // Small helpers
            // ----------------------------------------------------------

            // Zero filled int array of n entries
            s_iz(int n) -> int*
            {
                int* p;
                int i = 0;
                if (n < 1) { n = 1; };
                p = (int*)fmalloc((u64)(4 * n));
                while (i < n) { p[i] = 0; i++; };
                -> p;
            };

            s_ifree(int* p) -> void
            {
                ffree((byte*)p);
                ->;
            };

            // Records why the SSA path gave up on the current function
            s_fail(byte* why) -> void
            {
                if (this.gwhy == 0) { this.gwhys = why; };
                this.gwhy = 1;
                ->;
            };

            s_dead() -> bool
            {
                if (this.cb == (IRBlock*)0) { -> true; };
                -> this.cb.terminated;
            };

            // New recorded instruction with every field set
            s_new(int op) -> SI*
            {
                int sb = ((((int)sizeof(SI) + 7) / 8) * 2 + 15) / 16 * 16;
                if (this.cf.sall == (PtrVec*)0) { this.cf.sall = pv_new(); this.cf.sarr = pv_new(); };
                // Recorded instructions are carved out of shared blocks owned by the function
                if (this.cf.sleft < sb)
                {
                    this.cf.sp = (byte*)fmalloc((u64)4096);
                    pv_push(this.cf.sall, (void*)this.cf.sp);
                    this.cf.sleft = 4096;
                };
                SI* x = (SI*)this.cf.sp;
                this.cf.sp = this.cf.sp + sb;
                this.cf.sleft = this.cf.sleft - sb;
                x.op = op;
                x.n = 0;
                x.k = 0;
                x.sz = 0;
                x.bi = 0;
                x.ty = (IRType*)0;
                x.res = (IRValue*)0;
                x.a = (IRValue*)0;
                x.b = (IRValue*)0;
                x.c = (IRValue*)0;
                x.args = (IRValue**)0;
                x.blks = (IRBlock**)0;
                x.t = (IRBlock*)0;
                x.f = (IRBlock*)0;
                x.vol = false;
                x.flag = false;
                x.pos = 0;
                -> x;
            };

            // Appends x to the block being built and makes it the definition of its result
            s_push(SI* x) -> void
            {
                if (this.cb.insts == (PtrVec*)0) { this.cb.insts = pv_new(); };
                pv_push(this.cb.insts, (void*)x);
                if (x.res != (IRValue*)0)
                {
                    x.res.di = (void*)x;
                    x.res.db = 0;
                };
                ->;
            };

            // Operand array space of nb bytes, carved out of shared blocks owned by the function
            s_arr(int nb) -> byte*
            {
                int need = (nb + 15) / 16 * 16;
                byte* r;
                if (need > 1024)
                {
                    r = (byte*)fmalloc((u64)nb);
                    pv_push(this.cf.sarr, (void*)r);
                    -> r;
                };
                if (this.cf.aleft < need)
                {
                    this.cf.ap = (byte*)fmalloc((u64)4096);
                    pv_push(this.cf.sarr, (void*)this.cf.ap);
                    this.cf.aleft = 4096;
                };
                r = this.cf.ap;
                this.cf.ap = this.cf.ap + need;
                this.cf.aleft = this.cf.aleft - need;
                -> r;
            };

            // Copy of an operand array that lives as long as the recorded instruction
            s_cpv(IRValue** src, int n) -> IRValue**
            {
                IRValue** p = (IRValue**)this.s_arr(8 * (n + 1));
                int i = 0;
                while (i < n) { p[i] = src[i]; i++; };
                -> p;
            };

            s_cpb(IRBlock** src, int n) -> IRBlock**
            {
                IRBlock** p = (IRBlock**)this.s_arr(8 * (n + 1));
                int i = 0;
                while (i < n) { p[i] = src[i]; i++; };
                -> p;
            };

            // ----------------------------------------------------------
            // Names to codes
            // ----------------------------------------------------------

            s_bk(byte* op) -> int
            {
                if (this.a_pre(op, g"fadd\0")) { -> SB_FADD; };
                if (this.a_pre(op, g"fsub\0")) { -> SB_FSUB; };
                if (this.a_pre(op, g"fmul\0")) { -> SB_FMUL; };
                if (this.a_pre(op, g"fdiv\0")) { -> SB_FDIV; };
                if (this.a_pre(op, g"frem\0")) { -> SB_FREM; };
                if (this.a_pre(op, g"add\0")) { -> SB_ADD; };
                if (this.a_pre(op, g"sub\0")) { -> SB_SUB; };
                if (this.a_pre(op, g"mul\0")) { -> SB_MUL; };
                if (this.a_pre(op, g"sdiv\0")) { -> SB_SDIV; };
                if (this.a_pre(op, g"udiv\0")) { -> SB_UDIV; };
                if (this.a_pre(op, g"srem\0")) { -> SB_SREM; };
                if (this.a_pre(op, g"urem\0")) { -> SB_UREM; };
                if (this.a_pre(op, g"and\0")) { -> SB_AND; };
                if (this.a_pre(op, g"or\0")) { -> SB_OR; };
                if (this.a_pre(op, g"xor\0")) { -> SB_XOR; };
                if (this.a_pre(op, g"shl\0")) { -> SB_SHL; };
                if (this.a_pre(op, g"lshr\0")) { -> SB_LSHR; };
                if (this.a_pre(op, g"ashr\0")) { -> SB_ASHR; };
                -> 0;
            };

            s_ck_of(byte* op) -> int
            {
                if (this.a_pre(op, g"trunc\0")) { -> SK_TRUNC; };
                if (this.a_pre(op, g"zext\0")) { -> SK_ZEXT; };
                if (this.a_pre(op, g"sext\0")) { -> SK_SEXT; };
                if (this.a_pre(op, g"bitcast\0")) { -> SK_BITCAST; };
                if (this.a_pre(op, g"ptrtoint\0")) { -> SK_PTRTOINT; };
                if (this.a_pre(op, g"inttoptr\0")) { -> SK_INTTOPTR; };
                if (this.a_pre(op, g"fpext\0")) { -> SK_FPEXT; };
                if (this.a_pre(op, g"fptrunc\0")) { -> SK_FPTRUNC; };
                if (this.a_pre(op, g"sitofp\0")) { -> SK_SITOFP; };
                if (this.a_pre(op, g"uitofp\0")) { -> SK_UITOFP; };
                if (this.a_pre(op, g"fptosi\0")) { -> SK_FPTOSI; };
                if (this.a_pre(op, g"fptoui\0")) { -> SK_FPTOUI; };
                -> 0;
            };

            s_pk(byte* p, bool fl) -> int
            {
                if (!fl)
                {
                    if (this.a_seq(p, g"eq\0")) { -> SP_EQ; };
                    if (this.a_seq(p, g"ne\0")) { -> SP_NE; };
                    if (this.a_seq(p, g"ult\0")) { -> SP_ULT; };
                    if (this.a_seq(p, g"ule\0")) { -> SP_ULE; };
                    if (this.a_seq(p, g"ugt\0")) { -> SP_UGT; };
                    if (this.a_seq(p, g"uge\0")) { -> SP_UGE; };
                    if (this.a_seq(p, g"slt\0")) { -> SP_SLT; };
                    if (this.a_seq(p, g"sle\0")) { -> SP_SLE; };
                    if (this.a_seq(p, g"sgt\0")) { -> SP_SGT; };
                    if (this.a_seq(p, g"sge\0")) { -> SP_SGE; };
                    -> 0;
                };
                if (this.a_seq(p, g"false\0")) { -> SP_FALSE; };
                if (this.a_seq(p, g"true\0")) { -> SP_TRUE; };
                if (this.a_seq(p, g"ord\0")) { -> SP_ORD; };
                if (this.a_seq(p, g"uno\0")) { -> SP_UNO; };
                if (this.a_seq(p, g"oeq\0")) { -> SP_OEQ; };
                if (this.a_seq(p, g"one\0")) { -> SP_ONE; };
                if (this.a_seq(p, g"ueq\0")) { -> SP_UEQ; };
                if (this.a_seq(p, g"une\0")) { -> SP_UNE; };
                if (this.a_seq(p, g"ogt\0")) { -> SP_OGT; };
                if (this.a_seq(p, g"oge\0")) { -> SP_OGE; };
                if (this.a_seq(p, g"olt\0")) { -> SP_OLT; };
                if (this.a_seq(p, g"ole\0")) { -> SP_OLE; };
                if (this.a_seq(p, g"ugt\0")) { -> SP_UGT_F; };
                if (this.a_seq(p, g"uge\0")) { -> SP_UGE_F; };
                if (this.a_seq(p, g"ult\0")) { -> SP_ULT_F; };
                if (this.a_seq(p, g"ule\0")) { -> SP_ULE_F; };
                -> 0;
            };

            // ----------------------------------------------------------
            // Recording, called by the builder methods after the text path
            // ----------------------------------------------------------

            s_r_bin(byte* op, IRValue* a, IRValue* b, IRValue* r) -> void
            {
                SI* x = this.s_new(SO_BIN);
                x.k = this.s_bk(op);
                x.a = a;
                x.b = b;
                x.res = r;
                x.ty = r.ty;
                if (x.k == 0) { this.s_fail(g"binary operation\0"); };
                this.s_push(x);
                ->;
            };

            s_r_cmp(byte* kind, byte* pred, IRValue* a, IRValue* b, IRValue* r) -> void
            {
                SI* x = this.s_new(SO_CMP);
                x.n = 0;
                if (kind[0] == 'f') { x.n = 1; };
                x.k = this.s_pk(pred, x.n == 1);
                x.a = a;
                x.b = b;
                x.res = r;
                x.ty = a.ty;
                if (x.k == 0) { this.s_fail(g"compare predicate\0"); };
                this.s_push(x);
                ->;
            };

            s_r_cast(byte* op, IRValue* v, IRType* to, IRValue* r) -> void
            {
                SI* x = this.s_new(SO_CAST);
                x.k = this.s_ck_of(op);
                x.a = v;
                x.res = r;
                x.ty = to;
                if (x.k == 0) { this.s_fail(g"cast kind\0"); };
                this.s_push(x);
                ->;
            };

            s_r_alloca(IRType* ty, IRValue* r) -> void
            {
                SI* x = this.s_new(SO_ALLOCA);
                x.ty = ty;
                x.res = r;
                this.s_push(x);
                ->;
            };

            s_r_allocan(IRType* ty, IRValue* count, IRValue* r) -> void
            {
                SI* x = this.s_new(SO_ALLOCAN);
                x.ty = ty;
                x.a = count;
                x.res = r;
                this.s_push(x);
                ->;
            };

            s_r_load(IRValue* p, IRValue* r) -> void
            {
                SI* x = this.s_new(SO_LOAD);
                x.a = p;
                x.res = r;
                x.ty = r.ty;
                this.s_push(x);
                ->;
            };

            s_r_store(IRValue* v, IRValue* p, bool vol) -> void
            {
                SI* x = this.s_new(SO_STORE);
                x.a = v;
                x.b = p;
                x.vol = vol;
                x.ty = v.ty;
                this.s_push(x);
                ->;
            };

            s_r_gep(IRValue* p, IRValue** idx, int n, IRValue* r) -> void
            {
                SI* x = this.s_new(SO_GEP);
                x.a = p;
                x.n = n;
                x.args = this.s_cpv(idx, n);
                x.res = r;
                x.ty = r.ty;
                this.s_push(x);
                ->;
            };

            s_r_call(IRValue* callee, IRValue** args, int n, IRValue* r, bool tail) -> void
            {
                SI* x = this.s_new(SO_CALL);
                x.a = callee;
                x.n = n;
                x.args = this.s_cpv(args, n);
                x.res = r;
                x.ty = callee.ty.elem.elem;
                x.flag = tail;
                if (x.ty.kind == LK.VOID) { x.res = (IRValue*)0; };
                this.s_push(x);
                ->;
            };

            s_r_phi(IRType* ty, IRValue** vals, IRBlock** blocks, int n, IRValue* r) -> void
            {
                SI* x = this.s_new(SO_PHI);
                x.n = n;
                x.args = this.s_cpv(vals, n);
                x.blks = this.s_cpb(blocks, n);
                x.res = r;
                x.ty = ty;
                this.s_push(x);
                ->;
            };

            s_r_select(IRValue* c, IRValue* a, IRValue* b, IRValue* r) -> void
            {
                SI* x = this.s_new(SO_SELECT);
                x.a = c;
                x.b = a;
                x.c = b;
                x.res = r;
                x.ty = r.ty;
                this.s_push(x);
                ->;
            };

            s_r_vaarg(IRValue* list, IRType* ty, IRValue* r) -> void
            {
                SI* x = this.s_new(SO_VAARG);
                x.a = list;
                x.res = r;
                x.ty = ty;
                this.s_push(x);
                ->;
            };

            s_r_extract(IRValue* agg, int i, IRValue* r) -> void
            {
                SI* x = this.s_new(SO_EXTRACT);
                x.a = agg;
                x.k = i;
                x.res = r;
                x.ty = r.ty;
                this.s_push(x);
                ->;
            };

            s_r_insert(IRValue* agg, IRValue* v, int i, IRValue* r) -> void
            {
                SI* x = this.s_new(SO_INSERT);
                x.a = agg;
                x.b = v;
                x.k = i;
                x.res = r;
                x.ty = r.ty;
                this.s_push(x);
                ->;
            };

            s_r_br(IRBlock* t) -> void
            {
                SI* x = this.s_new(SO_BR);
                x.t = t;
                this.s_push(x);
                ->;
            };

            s_r_cbr(IRValue* c, IRBlock* t, IRBlock* f) -> void
            {
                SI* x = this.s_new(SO_CBR);
                x.a = c;
                x.t = t;
                x.f = f;
                this.s_push(x);
                ->;
            };

            s_r_ret(IRValue* v) -> void
            {
                SI* x = this.s_new(SO_RET);
                x.a = v;
                x.ty = v.ty;
                this.s_push(x);
                ->;
            };

            s_r_retv() -> void
            {
                SI* x = this.s_new(SO_RETV);
                this.s_push(x);
                ->;
            };

            s_r_unreach() -> void
            {
                SI* x = this.s_new(SO_UNREACH);
                this.s_push(x);
                ->;
            };

            s_r_switch(IRValue* v, IRBlock* dflt, IRValue** vals, IRBlock** blocks, int n) -> void
            {
                SI* x = this.s_new(SO_SWITCH);
                x.a = v;
                x.f = dflt;
                x.n = n;
                x.args = this.s_cpv(vals, n);
                x.blks = this.s_cpb(blocks, n);
                this.s_push(x);
                ->;
            };

            // ----------------------------------------------------------
            // Operands
            // ----------------------------------------------------------

            // The value after promotion replaced it
            s_res(IRValue* v) -> IRValue*
            {
                while (v.fwd != (IRValue*)0) { v = v.fwd; };
                -> v;
            };

            // Number of value operands of x
            s_nops(SI* x) -> int
            {
                int o = x.op;
                if (o == SO_BIN | o == SO_CMP | o == SO_STORE | o == SO_INSERT) { -> 2; };
                if (o == SO_CAST | o == SO_ALLOCAN | o == SO_LOAD | o == SO_VAARG | o == SO_EXTRACT | o == SO_CBR | o == SO_RET | o == SO_SWITCH) { -> 1; };
                if (o == SO_SELECT | o == SO_FILL | o == SO_COPY) { -> 3; };
                if (o == SO_GEP | o == SO_CALL) { -> 1 + x.n; };
                if (o == SO_PHI) { -> x.n; };
                -> 0;
            };

            s_op(SI* x, int i) -> IRValue*
            {
                int o = x.op;
                if (o == SO_PHI) { -> x.args[i]; };
                if (o == SO_GEP | o == SO_CALL)
                {
                    if (i == 0) { -> x.a; };
                    -> x.args[i - 1];
                };
                if (i == 0) { -> x.a; };
                if (i == 1) { -> x.b; };
                -> x.c;
            };

            s_sop(SI* x, int i, IRValue* v) -> void
            {
                int o = x.op;
                if (o == SO_PHI) { x.args[i] = v; ->; };
                if (o == SO_GEP | o == SO_CALL)
                {
                    if (i == 0) { x.a = v; ->; };
                    x.args[i - 1] = v;
                    ->;
                };
                if (i == 0) { x.a = v; ->; };
                if (i == 1) { x.b = v; ->; };
                x.c = v;
                ->;
            };

            // Rewrites every operand of x through the forwarding chain
            s_fixops(SI* x) -> void
            {
                int i = 0;
                int n = this.s_nops(x);
                IRValue* v;
                while (i < n)
                {
                    v = this.s_op(x, i);
                    if (v != (IRValue*)0)
                    {
                        if (v.fwd != (IRValue*)0) { this.s_sop(x, i, this.s_res(v)); };
                    };
                    i++;
                };
                ->;
            };

            // ----------------------------------------------------------
            // Constants
            // ----------------------------------------------------------

            // Classifies the constant text of v. The payload is left in scv and scs.
            s_ck(IRValue* v) -> int
            {
                byte* t = v.text;
                int c, p;
                u64 bits;
                this.scv = (i64)0;
                this.scs = (byte*)0;
                if (v.kc)
                {
                    this.scv = v.kv;
                    -> CK_INT;
                };
                while (t[0] == ' ') { t = t + 1; };
                c = (int)t[0];
                if (c == 37) { -> CK_NO; };
                if (c == 64)
                {
                    this.scs = this.a_sym(t);
                    -> CK_SYM;
                };
                if (this.a_isnum(t))
                {
                    bits = this.a_num(t);
                    if (v.ty.kind == LK.FLOAT)
                    {
                        if (t[0] == '0' & t[1] == 'x') { bits = this.a_f32bits(bits); };
                        this.scv = (i64)bits;
                        -> CK_FP;
                    };
                    if (v.ty.kind == LK.DOUBLE)
                    {
                        this.scv = (i64)bits;
                        -> CK_FP;
                    };
                    if (v.ty.kind == LK.INT) { bits = this.a_mask(bits, v.ty.width); };
                    this.scv = (i64)bits;
                    -> CK_INT;
                };
                if (this.a_pre(t, g"true\0")) { this.scv = (i64)1; -> CK_INT; };
                if (this.a_pre(t, g"false\0") | this.a_pre(t, g"null\0"))
                {
                    -> CK_INT;
                };
                if (this.a_pre(t, g"zeroinitializer\0") | this.a_pre(t, g"undef\0") | this.a_pre(t, g"poison\0"))
                {
                    if (v.ty.kind == LK.FLOAT | v.ty.kind == LK.DOUBLE) { -> CK_FP; };
                    if (v.ty.kind == LK.INT | v.ty.kind == LK.PTR) { -> CK_INT; };
                    -> CK_ZERO;
                };
                if (this.a_pre(t, g"getelementptr\0") | this.a_pre(t, g"bitcast\0") | this.a_pre(t, g"inttoptr\0") | this.a_pre(t, g"ptrtoint\0"))
                {
                    p = 0;
                    if (this.a_cx(t, @p))
                    {
                        this.scv = this.cx_off;
                        if (this.cx_sym == (byte*)0) { -> CK_INT; };
                        this.scs = this.cx_sym;
                        -> CK_SYM;
                    };
                };
                -> CK_BAD;
            };

            // ----------------------------------------------------------
            // Control flow graph
            // ----------------------------------------------------------

            // Successor blocks of the terminator x, returns how many are written to out
            s_succ(SI* x, IRBlock** out) -> int
            {
                int i, n;
                if (x.op == SO_BR) { out[0] = x.t; -> 1; };
                if (x.op == SO_CBR) { out[0] = x.t; out[1] = x.f; -> 2; };
                if (x.op == SO_SWITCH)
                {
                    out[0] = x.f;
                    n = 1;
                    i = 0;
                    while (i < x.n) { out[n] = x.blks[i]; n++; i++; };
                    -> n;
                };
                -> 0;
            };

            s_isterm(SI* x) -> bool
            {
                int o = x.op;
                -> o == SO_BR | o == SO_CBR | o == SO_RET | o == SO_RETV | o == SO_UNREACH | o == SO_SWITCH;
            };

            s_term(IRBlock* b) -> SI*
            {
                SI* x;
                if (b.insts == (PtrVec*)0) { -> (SI*)0; };
                if (b.insts.len == 0) { -> (SI*)0; };
                x = (SI*)b.insts.items[b.insts.len - 1];
                if (!this.s_isterm(x)) { -> (SI*)0; };
                -> x;
            };

            s_gb(IRBlock* b) -> GB*
            {
                GF* g = this.sf;
                if (b.gi < 0) { -> (GB*)0; };
                -> (GB*)g.bl.items[b.gi];
            };

            // Builds the reachable blocks, edges, reverse post order, dominators and frontiers
            s_cfg() -> bool
            {
                GF* g = this.sf;
                IRFunc* f = g.f;
                int nall = f.blocks.len;
                int i, j, k, n, top, ns, changed, a, b, fa, fb, idx;
                IRBlock* ib;
                IRBlock* sb;
                IRBlock** sv;
                SI* t;
                GB* gb;
                GB* sg;
                GB* pg;
                int* seen = this.s_iz(nall);
                int* stk = this.s_iz(nall + 1);
                int* pos = this.s_iz(nall + 1);
                int* order = this.s_iz(nall + 1);
                int* num = this.s_iz(nall + 1);
                i = 0;
                while (i < nall)
                {
                    ((IRBlock*)f.blocks.items[i]).gi = i;
                    i++;
                };
                // reachable blocks by depth first search from the entry, keeping source order afterwards
                top = 0;
                stk[0] = 0;
                seen[0] = 1;
                top = 1;
                n = 0;
                while (top > 0)
                {
                    i = stk[top - 1];
                    ib = (IRBlock*)f.blocks.items[i];
                    t = this.s_term(ib);
                    if (t == (SI*)0)
                    {
                        this.s_fail(g"block without terminator\0");
                        this.s_ifree(seen); this.s_ifree(stk); this.s_ifree(pos); this.s_ifree(order); this.s_ifree(num);
                        -> false;
                    };
                    sv = this.sbuf(t.n + 2);
                    ns = this.s_succ(t, sv);
                    if (pos[top - 1] < ns)
                    {
                        sb = sv[pos[top - 1]];
                        pos[top - 1] = pos[top - 1] + 1;
                        j = sb.gi;
                        if (seen[j] == 0)
                        {
                            seen[j] = 1;
                            stk[top] = j;
                            pos[top] = 0;
                            top++;
                        };
                    }
                    else
                    {
                        top--;
                    };
                };
                i = 0;
                while (i < nall)
                {
                    ib = (IRBlock*)f.blocks.items[i];
                    if (seen[i] == 0) { ib.gi = 0 - 1; };
                    if (seen[i] == 1)
                    {
                        gb = (GB*)fmalloc((u64)(((sizeof(GB) + 7) / 8) * 2));
                        gb.ib = ib;
                        gb.id = ib.id;
                        gb.rpo = 0;
                        gb.idom = 0 - 1;
                        gb.lbl = ib.id;
                        gb.depth = 0;
                        gb.nexti = 0;
                        gb.lw = 1;
                        gb.hd = 0;
                        gb.preds = pv_new();
                        gb.succs = pv_new();
                        gb.kids = pv_new();
                        gb.df = pv_new();
                        gb.phis = pv_new();
                        gb.mi = pv_new();
                        gb.livein = (int*)0;
                        gb.liveout = (int*)0;
                        gb.guse = (int*)0;
                        gb.gdef = (int*)0;
                        ib.gi = g.bl.len;
                        pv_push(g.bl, (void*)gb);
                    };
                    i++;
                };
                n = g.bl.len;
                g.nb = n;
                // edges
                i = 0;
                while (i < n)
                {
                    gb = (GB*)g.bl.items[i];
                    t = this.s_term(gb.ib);
                    sv = this.sbuf(t.n + 2);
                    ns = this.s_succ(t, sv);
                    j = 0;
                    while (j < ns)
                    {
                        sg = this.s_gb(sv[j]);
                        pv_push(gb.succs, (void*)sg);
                        pv_push(sg.preds, (void*)gb);
                        j++;
                    };
                    i++;
                };
                // reverse post order of the graph from the entry
                g.rpo = (GB**)fmalloc((u64)(8 * (n + 1)));
                i = 0;
                while (i < n) { seen[i] = 0; pos[i] = 0; i++; };
                top = 1;
                stk[0] = 0;
                seen[0] = 1;
                k = 0;
                while (top > 0)
                {
                    gb = (GB*)g.bl.items[stk[top - 1]];
                    if (pos[top - 1] < gb.succs.len)
                    {
                        sg = (GB*)gb.succs.items[pos[top - 1]];
                        pos[top - 1] = pos[top - 1] + 1;
                        j = sg.ib.gi;
                        if (seen[j] == 0)
                        {
                            seen[j] = 1;
                            stk[top] = j;
                            pos[top] = 0;
                            top++;
                        };
                    }
                    else
                    {
                        order[k] = stk[top - 1];
                        k++;
                        top--;
                    };
                };
                i = 0;
                while (i < n)
                {
                    j = order[n - 1 - i];
                    gb = (GB*)g.bl.items[j];
                    gb.rpo = i;
                    g.rpo[i] = gb;
                    i++;
                };
                // dominators (Cooper, Harvey, Kennedy) on reverse post order numbers
                ((GB*)g.rpo[0]).idom = 0;
                changed = 1;
                while (changed != 0)
                {
                    changed = 0;
                    i = 1;
                    while (i < n)
                    {
                        gb = g.rpo[i];
                        idx = 0 - 1;
                        j = 0;
                        while (j < gb.preds.len)
                        {
                            pg = (GB*)gb.preds.items[j];
                            if (pg.idom >= 0)
                            {
                                if (idx < 0) { idx = pg.rpo; }
                                else
                                {
                                    fa = pg.rpo;
                                    fb = idx;
                                    while (fa != fb)
                                    {
                                        while (fa > fb) { fa = ((GB*)g.rpo[fa]).idom; };
                                        while (fb > fa) { fb = ((GB*)g.rpo[fb]).idom; };
                                    };
                                    idx = fa;
                                };
                            };
                            j++;
                        };
                        if (idx != gb.idom)
                        {
                            gb.idom = idx;
                            changed = 1;
                        };
                        i++;
                    };
                };
                i = 1;
                while (i < n)
                {
                    gb = g.rpo[i];
                    sg = g.rpo[gb.idom];
                    pv_push(sg.kids, (void*)gb);
                    gb.depth = sg.depth + 1;
                    i++;
                };
                // dominance frontiers
                i = 0;
                while (i < n)
                {
                    gb = g.rpo[i];
                    if (gb.preds.len >= 2)
                    {
                        j = 0;
                        while (j < gb.preds.len)
                        {
                            pg = (GB*)gb.preds.items[j];
                            sg = pg;
                            while (sg.rpo != gb.idom)
                            {
                                if (!this.s_inlist(sg.df, gb)) { pv_push(sg.df, (void*)gb); };
                                sg = g.rpo[sg.idom];
                            };
                            j++;
                        };
                    };
                    i++;
                };
                this.s_ifree(seen); this.s_ifree(stk); this.s_ifree(pos); this.s_ifree(order); this.s_ifree(num);
                -> true;
            };

            s_inlist(PtrVec* v, GB* x) -> bool
            {
                int i = 0;
                while (i < v.len)
                {
                    if ((GB*)v.items[i] == x) { -> true; };
                    i++;
                };
                -> false;
            };

            // Scratch array for successor lists
            sbuf(int n) -> IRBlock**
            {
                if (n > this.sbn)
                {
                    if (this.sbp != (IRBlock**)0) { ffree((byte*)this.sbp); };
                    this.sbp = (IRBlock**)fmalloc((u64)(8 * (n + 8)));
                    this.sbn = n + 8;
                };
                -> this.sbp;
            };

            // ==========================================================
            // promotion of stack slots to SSA values (minimal SSA with iterated dominance
            // frontiers, then renaming over the dominator tree) and removal of dead values.
            // ==========================================================

            // Branches with a constant or identical target become plain jumps
            s_prep() -> void
            {
                IRFunc* f = this.sf.f;
                int i = 0;
                IRBlock* ib;
                SI* t;
                int ck;
                while (i < f.blocks.len)
                {
                    ib = (IRBlock*)f.blocks.items[i];
                    t = this.s_term(ib);
                    if (t != (SI*)0)
                    {
                        if (t.op == SO_CBR)
                        {
                            if (t.t == t.f)
                            {
                                t.op = SO_BR;
                            }
                            else
                            {
                                ck = this.s_ck(t.a);
                                if (ck == CK_INT)
                                {
                                    if ((this.scv != (i64)0) != (t.k == 1)) { t.f = t.t; } else { t.t = t.f; };
                                    t.op = SO_BR;
                                };
                            };
                        };
                    };
                    i++;
                };
                ->;
            };

            // True when type t is a scalar a register can hold
            s_scalar(IRType* t) -> bool
            {
                if (t.kind == LK.INT) { -> t.width <= 64; };
                -> t.kind == LK.PTR | t.kind == LK.FLOAT | t.kind == LK.DOUBLE;
            };

            // The candidate number (plus one) of the alloca v, 0 when it is not a candidate
            s_cand(IRValue* v) -> int
            {
                -> v.db;
            };

            s_promote() -> void
            {
                GF* g = this.sf;
                int nb = g.nb;
                int i, j, k, n, ncand, nst, nphi, top, mark, logn, ci;
                GB* gb;
                GB* sg;
                GB* kid;
                SI* x;
                SI* ph;
                IRValue* v;
                IRValue* av;
                PtrVec* cands = pv_new();
                PtrVec* work = pv_new();
                PtrVec** newph = (PtrVec**)fmalloc((u64)(8 * (nb + 1)));
                int* defmark = this.s_iz(nb);
                int* hasphi = this.s_iz(nb);
                int* stkb;
                int* stkc;
                int* stkm;
                int* logk;
                IRValue** logv;
                IRValue** cur;
                int gen;
                // candidates
                i = 0;
                while (i < nb)
                {
                    newph[i] = (PtrVec*)0;
                    gb = (GB*)g.bl.items[i];
                    if (gb.ib.insts != (PtrVec*)0)
                    {
                        j = 0;
                        while (j < gb.ib.insts.len)
                        {
                            x = (SI*)gb.ib.insts.items[j];
                            if (x.op == SO_ALLOCA)
                            {
                                if (this.s_scalar(x.ty))
                                {
                                    pv_push(cands, (void*)x);
                                    x.res.db = cands.len;
                                    x.res.nu = 0;
                                };
                            };
                            j++;
                        };
                    };
                    i++;
                };
                ncand = cands.len;
                if (ncand == 0)
                {
                    pv_free(cands); pv_free(work); ffree((byte*)newph); this.s_ifree(defmark); this.s_ifree(hasphi);
                    ->;
                };
                // uses that keep a slot in memory
                nst = 0;
                i = 0;
                while (i < nb)
                {
                    gb = (GB*)g.bl.items[i];
                    if (gb.ib.insts != (PtrVec*)0)
                    {
                        j = 0;
                        while (j < gb.ib.insts.len)
                        {
                            x = (SI*)gb.ib.insts.items[j];
                            n = this.s_nops(x);
                            k = 0;
                            while (k < n)
                            {
                                v = this.s_op(x, k);
                                if (v.db > 0)
                                {
                                    if (x.op == SO_LOAD & k == 0)
                                    {
                                        if (x.vol) { v.nu++; };
                                    }
                                    else
                                    {
                                        if (x.op == SO_STORE & k == 1)
                                        {
                                            if (x.vol) { v.nu++; };
                                            if (x.a.db > 0) { x.a.nu++; };
                                        }
                                        else { v.nu++; };
                                    };
                                };
                                k++;
                            };
                            if (x.op == SO_STORE)
                            {
                                if (x.b.db > 0) { nst++; };
                            };
                            j++;
                        };
                    };
                    i++;
                };
                // phi placement
                nphi = 0;
                ci = 0;
                while (ci < ncand)
                {
                    x = (SI*)cands.items[ci];
                    if (x.res.nu == 0)
                    {
                        gen = ci + 1;
                        work.len = 0;
                        i = 0;
                        while (i < nb)
                        {
                            gb = (GB*)g.bl.items[i];
                            if (gb.ib.insts != (PtrVec*)0)
                            {
                                j = 0;
                                while (j < gb.ib.insts.len)
                                {
                                    ph = (SI*)gb.ib.insts.items[j];
                                    if (ph.op == SO_STORE)
                                    {
                                        if (ph.b == x.res)
                                        {
                                            if (defmark[i] != gen)
                                            {
                                                defmark[i] = gen;
                                                pv_push(work, (void*)gb);
                                            };
                                        };
                                    };
                                    j++;
                                };
                            };
                            i++;
                        };
                        while (work.len > 0)
                        {
                            work.len = work.len - 1;
                            gb = (GB*)work.items[work.len];
                            j = 0;
                            while (j < gb.df.len)
                            {
                                sg = (GB*)gb.df.items[j];
                                k = sg.ib.gi;
                                if (hasphi[k] != gen)
                                {
                                    hasphi[k] = gen;
                                    ph = this.s_new(SO_PHI);
                                    ph.ty = x.ty;
                                    ph.k = ci;
                                    ph.flag = true;
                                    ph.n = 0;
                                    ph.args = (IRValue**)fmalloc((u64)(8 * (sg.preds.len + 1)));
                                    ph.blks = (IRBlock**)fmalloc((u64)(8 * (sg.preds.len + 1)));
                                    pv_push(this.cf.sarr, (void*)ph.args);
                                    pv_push(this.cf.sarr, (void*)ph.blks);
                                    ph.res = this.new_value(x.ty, g"%ssa\0");
                                    ph.res.di = (void*)ph;
                                    ph.res.db = 0;
                                    if (newph[k] == (PtrVec*)0) { newph[k] = pv_new(); };
                                    pv_push(newph[k], (void*)ph);
                                    nphi++;
                                    if (defmark[k] != gen)
                                    {
                                        defmark[k] = gen;
                                        pv_push(work, (void*)sg);
                                    };
                                };
                                j++;
                            };
                        };
                    };
                    ci++;
                };
                // new phis go in front of the block
                i = 0;
                while (i < nb)
                {
                    if (newph[i] != (PtrVec*)0)
                    {
                        gb = (GB*)g.bl.items[i];
                        if (gb.ib.insts == (PtrVec*)0) { gb.ib.insts = pv_new(); };
                        j = 0;
                        while (j < gb.ib.insts.len) { pv_push(newph[i], gb.ib.insts.items[j]); j++; };
                        pv_free(gb.ib.insts);
                        gb.ib.insts = newph[i];
                    };
                    i++;
                };
                // renaming over the dominator tree
                cur = (IRValue**)fmalloc((u64)(8 * (ncand + 1)));
                i = 0;
                while (i < ncand) { cur[i] = (IRValue*)0; i++; };
                logn = 0;
                logk = this.s_iz(nst + nphi + 8);
                logv = (IRValue**)fmalloc((u64)(8 * (nst + nphi + 8)));
                stkb = this.s_iz(nb + 1);
                stkc = this.s_iz(nb + 1);
                stkm = this.s_iz(nb + 1);
                top = 0;
                stkb[0] = 0;
                stkc[0] = 0 - 1;
                stkm[0] = 0;
                top = 1;
                while (top > 0)
                {
                    gb = (GB*)g.bl.items[stkb[top - 1]];
                    if (stkc[top - 1] < 0)
                    {
                        // entering the block
                        stkc[top - 1] = 0;
                        stkm[top - 1] = logn;
                        if (gb.ib.insts != (PtrVec*)0)
                        {
                            j = 0;
                            while (j < gb.ib.insts.len)
                            {
                                x = (SI*)gb.ib.insts.items[j];
                                if (x.op == SO_PHI & x.flag)
                                {
                                    logk[logn] = x.k;
                                    logv[logn] = cur[x.k];
                                    logn++;
                                    cur[x.k] = x.res;
                                };
                                if (x.op == SO_LOAD)
                                {
                                    av = x.a;
                                    if (av.db > 0)
                                    {
                                        ph = (SI*)cands.items[av.db - 1];
                                        if (ph.res.nu == 0)
                                        {
                                            v = cur[av.db - 1];
                                            if (v == (IRValue*)0) { v = this.c_undef(ph.ty); };
                                            x.res.fwd = this.s_res(v);
                                            x.op = 0;
                                        };
                                    };
                                };
                                if (x.op == SO_STORE)
                                {
                                    av = x.b;
                                    if (av.db > 0)
                                    {
                                        ph = (SI*)cands.items[av.db - 1];
                                        if (ph.res.nu == 0)
                                        {
                                            logk[logn] = av.db - 1;
                                            logv[logn] = cur[av.db - 1];
                                            logn++;
                                            cur[av.db - 1] = this.s_res(x.a);
                                            x.op = 0;
                                        };
                                    };
                                };
                                j++;
                            };
                        };
                        // incoming values of the phis of the successors
                        j = 0;
                        while (j < gb.succs.len)
                        {
                            sg = (GB*)gb.succs.items[j];
                            if (sg.ib.insts != (PtrVec*)0)
                            {
                                k = 0;
                                while (k < sg.ib.insts.len)
                                {
                                    x = (SI*)sg.ib.insts.items[k];
                                    if (x.op == SO_PHI & x.flag)
                                    {
                                        ph = (SI*)cands.items[x.k];
                                        v = cur[x.k];
                                        if (v == (IRValue*)0) { v = this.c_undef(ph.ty); };
                                        x.args[x.n] = this.s_res(v);
                                        x.blks[x.n] = gb.ib;
                                        x.n++;
                                    };
                                    k++;
                                };
                            };
                            j++;
                        };
                    };
                    if (stkc[top - 1] < gb.kids.len)
                    {
                        kid = (GB*)gb.kids.items[stkc[top - 1]];
                        stkc[top - 1] = stkc[top - 1] + 1;
                        stkb[top] = kid.ib.gi;
                        stkc[top] = 0 - 1;
                        top++;
                    }
                    else
                    {
                        // leaving the block
                        mark = stkm[top - 1];
                        while (logn > mark)
                        {
                            logn--;
                            cur[logk[logn]] = logv[logn];
                        };
                        top--;
                    };
                };
                // drop the replaced instructions, rewrite operands
                i = 0;
                while (i < nb)
                {
                    gb = (GB*)g.bl.items[i];
                    if (gb.ib.insts != (PtrVec*)0)
                    {
                        n = 0;
                        j = 0;
                        while (j < gb.ib.insts.len)
                        {
                            x = (SI*)gb.ib.insts.items[j];
                            if (x.op != 0)
                            {
                                this.s_fixops(x);
                                gb.ib.insts.items[n] = (void*)x;
                                n++;
                            };
                            j++;
                        };
                        gb.ib.insts.len = n;
                    };
                    i++;
                };
                ci = 0;
                while (ci < ncand)
                {
                    x = (SI*)cands.items[ci];
                    x.res.db = 0;
                    ci++;
                };
                pv_free(cands);
                pv_free(work);
                ffree((byte*)newph);
                ffree((byte*)cur);
                ffree((byte*)logv);
                this.s_ifree(defmark); this.s_ifree(hasphi); this.s_ifree(logk);
                this.s_ifree(stkb); this.s_ifree(stkc); this.s_ifree(stkm);
                ->;
            };

            // Counts the uses of every value, then deletes the pure instructions nobody uses
            s_dce() -> void
            {
                GF* g = this.sf;
                IRFunc* f = g.f;
                int nb = g.nb;
                int i, j, k, n, o;
                bool again = true;
                GB* gb;
                SI* x;
                IRValue* v;
                // reset
                i = 0;
                while (i < f.nargs) { f.args[i].nu = 0; i++; };
                i = 0;
                while (i < nb)
                {
                    gb = (GB*)g.bl.items[i];
                    if (gb.ib.insts != (PtrVec*)0)
                    {
                        j = 0;
                        while (j < gb.ib.insts.len)
                        {
                            x = (SI*)gb.ib.insts.items[j];
                            if (x.res != (IRValue*)0) { x.res.nu = 0; };
                            j++;
                        };
                    };
                    i++;
                };
                i = 0;
                while (i < nb)
                {
                    gb = (GB*)g.bl.items[i];
                    if (gb.ib.insts != (PtrVec*)0)
                    {
                        j = 0;
                        while (j < gb.ib.insts.len)
                        {
                            x = (SI*)gb.ib.insts.items[j];
                            n = this.s_nops(x);
                            k = 0;
                            while (k < n)
                            {
                                v = this.s_op(x, k);
                                v.nu++;
                                k++;
                            };
                            j++;
                        };
                    };
                    i++;
                };
                while (again)
                {
                    again = false;
                    i = nb - 1;
                    while (i >= 0)
                    {
                        gb = (GB*)g.bl.items[i];
                        if (gb.ib.insts != (PtrVec*)0)
                        {
                            j = gb.ib.insts.len - 1;
                            while (j >= 0)
                            {
                                x = (SI*)gb.ib.insts.items[j];
                                o = x.op;
                                if (x.res != (IRValue*)0)
                                {
                                    if (x.res.nu == 0)
                                    {
                                        if (o == SO_BIN | o == SO_CMP | o == SO_CAST | o == SO_GEP | o == SO_SELECT | o == SO_PHI | o == SO_EXTRACT | o == SO_INSERT | o == SO_ALLOCA | (o == SO_LOAD & !x.vol))
                                        {
                                            n = this.s_nops(x);
                                            k = 0;
                                            while (k < n)
                                            {
                                                v = this.s_op(x, k);
                                                v.nu--;
                                                k++;
                                            };
                                            x.op = 0;
                                            again = true;
                                        };
                                    };
                                };
                                j--;
                            };
                            n = 0;
                            j = 0;
                            while (j < gb.ib.insts.len)
                            {
                                x = (SI*)gb.ib.insts.items[j];
                                if (x.op != 0)
                                {
                                    gb.ib.insts.items[n] = (void*)x;
                                    n++;
                                };
                                j++;
                            };
                            gb.ib.insts.len = n;
                        };
                        i--;
                    };
                };
                ->;
            };


            // ==========================================================
            // Optimizer over the SSA form. Only pure integer work is rewritten: constants fold with
            // wraparound, identities and trivial phis and selects are replaced by the value they
            // equal, and an identical pure instruction in the same block reuses the earlier result.
            // Loads, stores, calls, inline asm, volatile accesses and every operation whose result
            // would depend on undefined behavior (division by zero, signed overflow of a division,
            // a shift by the width or more) are left exactly as the programmer wrote them.
            // ==========================================================

            // Sign extends the low w bits of v
            s_sx(u64 v, int w) -> i64
            {
                u64 m;
                if (w >= 64) { -> (i64)v; };
                m = (u64)1 << (u64)(w - 1);
                v = this.a_mask(v, w);
                if ((v `& m) != (u64)0) { v = v `| ((u64)0 - ((u64)1 << (u64)w)); };
                -> (i64)v;
            };

            // True when v is an integer constant (a plain integer type of at most 64 bits). Payload in scv.
            s_cint(IRValue* v) -> bool
            {
                if (v.ty.kind != LK.INT) { -> false; };
                if (v.ty.width > 64) { -> false; };
                if (this.s_ck(v) != CK_INT) { -> false; };
                this.scv = (i64)this.a_mask((u64)this.scv, v.ty.width);
                -> true;
            };

            // The constant n of type t
            s_kint(IRType* t, u64 n) -> IRValue*
            {
                IRValue* r;
                n = this.a_mask(n, t.width);
                r = this.c_int(t, (i64)n);
                r.kc = true;
                r.kv = (i64)n;
                -> r;
            };

            // True when a and b are the same value (the same definition, or equal integer constants)
            s_same(IRValue* a, IRValue* b) -> bool
            {
                i64 av;
                if (a == b) { -> true; };
                if (a.ty.kind != LK.INT | b.ty.kind != LK.INT) { -> false; };
                if (a.ty.width != b.ty.width) { -> false; };
                if (!this.s_cint(a)) { -> false; };
                av = this.scv;
                if (!this.s_cint(b)) { -> false; };
                -> av == this.scv;
            };

            // Value an integer binary operation equals, or null when it does not simplify
            s_simp_bin(SI* x) -> IRValue*
            {
                IRValue* a = x.a;
                IRValue* b = x.b;
                IRType* t = x.res.ty;
                int w, k;
                bool ca, cb;
                u64 ua, ub, r, ones, lm;
                SI* d;
                i64 sa, sb;
                if (t.kind != LK.INT) { -> (IRValue*)0; };
                if (t.width > 64) { -> (IRValue*)0; };
                w = t.width;
                k = x.k;
                if (k > SB_ASHR) { -> (IRValue*)0; };
                ones = this.a_mask((u64)0 - (u64)1, w);
                ca = this.s_cint(a);
                ua = (u64)this.scv;
                cb = this.s_cint(b);
                ub = (u64)this.scv;
                if (ca & cb)
                {
                    sa = this.s_sx(ua, w);
                    sb = this.s_sx(ub, w);
                    if (k == SB_ADD) { -> this.s_kint(t, ua + ub); };
                    if (k == SB_SUB) { -> this.s_kint(t, ua - ub); };
                    if (k == SB_MUL) { -> this.s_kint(t, ua * ub); };
                    if (k == SB_AND) { -> this.s_kint(t, ua `& ub); };
                    if (k == SB_OR) { -> this.s_kint(t, ua `| ub); };
                    if (k == SB_XOR) { -> this.s_kint(t, ua `^| ub); };
                    if (k == SB_SHL | k == SB_LSHR | k == SB_ASHR)
                    {
                        if (ub >= (u64)w) { -> (IRValue*)0; };
                        if (k == SB_SHL) { -> this.s_kint(t, ua << ub); };
                        if (k == SB_LSHR) { -> this.s_kint(t, ua >> ub); };
                        if (sa < (i64)0) { -> this.s_kint(t, ((u64)0 - (u64)1) `^| ((((u64)0 - (u64)1) `^| (u64)sa) >> ub)); };
                        -> this.s_kint(t, (u64)sa >> ub);
                    };
                    if (k == SB_UDIV | k == SB_UREM)
                    {
                        if (ub == (u64)0) { -> (IRValue*)0; };
                        if (k == SB_UDIV) { -> this.s_kint(t, ua / ub); };
                        -> this.s_kint(t, ua % ub);
                    };
                    if (k == SB_SDIV | k == SB_SREM)
                    {
                        if (sb == (i64)0) { -> (IRValue*)0; };
                        if (sb == (i64)0 - (i64)1) { -> (IRValue*)0; };
                        if (k == SB_SDIV) { -> this.s_kint(t, (u64)(sa / sb)); };
                        -> this.s_kint(t, (u64)(sa % sb));
                    };
                    -> (IRValue*)0;
                };
                if (cb)
                {
                    if (ub == (u64)0 & (k == SB_ADD | k == SB_SUB | k == SB_OR | k == SB_XOR | k == SB_SHL | k == SB_LSHR | k == SB_ASHR)) { -> a; };
                    if (ub == (u64)0 & (k == SB_MUL | k == SB_AND)) { -> this.s_kint(t, (u64)0); };
                    if (ub == (u64)1 & (k == SB_MUL | k == SB_SDIV | k == SB_UDIV)) { -> a; };
                    if (ub == ones & k == SB_AND & (w == 1 | w == 8 | w == 16 | w == 32 | w == 64)) { -> a; };
                    if (ub == ones & k == SB_OR) { -> this.s_kint(t, ones); };
                    // a mask that keeps every bit of a zero extended value changes nothing
                    if (k == SB_AND & a.di != (void*)0 & !a.kc)
                    {
                        d = (SI*)a.di;
                        if (d.op == SO_CAST & d.k == SK_ZEXT)
                        {
                            if (d.a.ty.kind == LK.INT & (d.a.ty.width == 1 | d.a.ty.width == 8 | d.a.ty.width == 16 | d.a.ty.width == 32))
                            {
                                lm = this.a_mask((u64)0 - (u64)1, d.a.ty.width);
                                if ((ub `& lm) == lm) { -> a; };
                            };
                        };
                    };
                    // a value that is only ever 0 or 1 passes a mask that keeps bit 0
                    if (k == SB_AND & (ub `& (u64)1) == (u64)1)
                    {
                        if (this.s_bit01(a, 0)) { -> a; };
                    };
                    -> (IRValue*)0;
                };
                if (ca)
                {
                    if (ua == (u64)0 & (k == SB_ADD | k == SB_OR | k == SB_XOR)) { -> b; };
                    if (ua == (u64)0 & (k == SB_MUL | k == SB_AND)) { -> this.s_kint(t, (u64)0); };
                    if (ua == (u64)1 & k == SB_MUL) { -> b; };
                    if (ua == ones & k == SB_AND & (w == 1 | w == 8 | w == 16 | w == 32 | w == 64)) { -> b; };
                    if (ua == ones & k == SB_OR) { -> this.s_kint(t, ones); };
                    if (k == SB_AND & (ua `& (u64)1) == (u64)1)
                    {
                        if (this.s_bit01(b, 0)) { -> b; };
                    };
                    -> (IRValue*)0;
                };
                if (a == b)
                {
                    if (k == SB_SUB | k == SB_XOR) { -> this.s_kint(t, (u64)0); };
                    if (k == SB_AND | k == SB_OR) { -> a; };
                };
                -> (IRValue*)0;
            };

            // Value an integer or pointer comparison equals, or null
            s_simp_cmp(SI* x) -> IRValue*
            {
                IRValue* a = x.a;
                IRValue* b = x.b;
                IRType* t = x.res.ty;
                int k = x.k;
                int w;
                u64 ua, ub;
                i64 sa, sb;
                bool r;
                SI* d;
                if (x.n != 0) { -> (IRValue*)0; };
                if (t.kind != LK.INT) { -> (IRValue*)0; };
                if (a == b)
                {
                    r = k == SP_EQ | k == SP_ULE | k == SP_UGE | k == SP_SLE | k == SP_SGE;
                    if (k == SP_EQ | k == SP_NE | k == SP_ULT | k == SP_ULE | k == SP_UGT | k == SP_UGE | k == SP_SLT | k == SP_SLE | k == SP_SGT | k == SP_SGE)
                    {
                        if (r) { -> this.s_kint(t, (u64)1); };
                        -> this.s_kint(t, (u64)0);
                    };
                    -> (IRValue*)0;
                };
                if (!this.s_cint(a) & (k == SP_NE | k == SP_EQ) & a.ty.kind == LK.INT & a.ty.width > 1 & a.di != (void*)0)
                {
                    // a truth value widened and compared with zero is the truth value or its negation
                    if (this.s_cint(b))
                    {
                        if (this.scv == (i64)0)
                        {
                            d = (SI*)a.di;
                            if (d.op == SO_CAST & d.res == a & d.k == SK_ZEXT)
                            {
                                if (d.a.ty.kind == LK.INT & d.a.ty.width == 1)
                                {
                                    if (k == SP_NE) { -> d.a; };
                                    x.a = d.a;
                                    x.b = this.s_kint(d.a.ty, (u64)0);
                                    -> (IRValue*)0;
                                };
                            };
                        };
                    };
                };
                if (!this.s_cint(a)) { -> (IRValue*)0; };
                ua = (u64)this.scv;
                if (!this.s_cint(b)) { -> (IRValue*)0; };
                ub = (u64)this.scv;
                if (a.ty.width != b.ty.width) { -> (IRValue*)0; };
                w = a.ty.width;
                sa = this.s_sx(ua, w);
                sb = this.s_sx(ub, w);
                r = false;
                if (k == SP_EQ) { r = ua == ub; }
                elif (k == SP_NE) { r = ua != ub; }
                elif (k == SP_ULT) { r = ua < ub; }
                elif (k == SP_ULE) { r = ua <= ub; }
                elif (k == SP_UGT) { r = ua > ub; }
                elif (k == SP_UGE) { r = ua >= ub; }
                elif (k == SP_SLT) { r = sa < sb; }
                elif (k == SP_SLE) { r = sa <= sb; }
                elif (k == SP_SGT) { r = sa > sb; }
                elif (k == SP_SGE) { r = sa >= sb; }
                else { -> (IRValue*)0; };
                if (r) { -> this.s_kint(t, (u64)1); };
                -> this.s_kint(t, (u64)0);
            };

            // Value a cast of an integer constant equals, or null
            s_simp_cast(SI* x) -> IRValue*
            {
                SI* d;
                IRValue* a = x.a;
                IRType* t = x.res.ty;
                int fw;
                u64 u;
                if (t.kind != LK.INT) { -> (IRValue*)0; };
                if (t.width > 64) { -> (IRValue*)0; };
                if (x.k != SK_TRUNC & x.k != SK_ZEXT & x.k != SK_SEXT) { -> (IRValue*)0; };
                if (x.k == SK_TRUNC & a.di != (void*)0 & !a.kc)
                {
                    // a truncation back to the width a zero or sign extension came from
                    d = (SI*)a.di;
                    if (d.op == SO_CAST & d.res == a & (d.k == SK_ZEXT | d.k == SK_SEXT))
                    {
                        if (d.a.ty.kind == LK.INT & d.a.ty.width == t.width) { -> d.a; };
                    };
                };
                if (!this.s_cint(a)) { -> (IRValue*)0; };
                fw = a.ty.width;
                u = (u64)this.scv;
                if (x.k == SK_SEXT) { u = (u64)this.s_sx(u, fw); };
                -> this.s_kint(t, u);
            };

            // Value a select equals, or null
            s_simp_sel(SI* x) -> IRValue*
            {
                if (this.s_same(x.b, x.c)) { -> x.b; };
                if (this.s_cint(x.a))
                {
                    if (this.scv != (i64)0) { -> x.b; };
                    -> x.c;
                };
                -> (IRValue*)0;
            };

            // Value a phi equals when all its incoming values but itself are one value, or null
            s_simp_phi(SI* x) -> IRValue*
            {
                IRValue* one = (IRValue*)0;
                IRValue* v;
                int i = 0;
                while (i < x.n)
                {
                    v = x.args[i];
                    if (v != x.res)
                    {
                        if (one == (IRValue*)0) { one = v; }
                        else
                        {
                            if (!this.s_same(one, v)) { -> (IRValue*)0; };
                        };
                    };
                    i++;
                };
                -> one;
            };

            // True when the pure instructions x and y compute the same value
            s_same_inst(SI* x, SI* y) -> bool
            {
                int i;
                if (x.op != y.op | x.k != y.k | x.n != y.n | x.flag != y.flag) { -> false; };
                if (x.op == SO_GEP & x.n >= 2 & !this.s_gep_plain(x))
                {
                    // member addresses of a struct that carry layout state only match when built from the same types
                    if (x.ty != y.ty | x.res.ty != y.res.ty) { -> false; };
                }
                elif (!this.s_samety(x.ty, y.ty) | !this.s_samety(x.res.ty, y.res.ty)) { -> false; };
                if (!this.s_sameop(x.a, y.a) | !this.s_sameop(x.b, y.b) | !this.s_sameop(x.c, y.c)) { -> false; };
                if (x.op == SO_GEP)
                {
                    i = 0;
                    while (i < x.n)
                    {
                        if (!this.s_sameop(x.args[i], y.args[i])) { -> false; };
                        i++;
                    };
                };
                -> true;
            };

            // Types that are the same, structurally for the scalar and pointer types
            s_samety(IRType* a, IRType* b) -> bool
            {
                if (a == b) { -> true; };
                if (a == (IRType*)0 | b == (IRType*)0) { -> false; };
                if (a.kind != b.kind) { -> false; };
                if (a.kind == LK.INT) { -> a.width == b.width; };
                if (a.kind == LK.FLOAT | a.kind == LK.DOUBLE) { -> true; };
                if (a.kind == LK.PTR) { -> this.s_samety(a.elem, b.elem); };
                -> false;
            };

            // Operands that are the same value, or integer constants of one type and one value
            s_sameop(IRValue* a, IRValue* b) -> bool
            {
                i64 va;
                if (a == b) { -> true; };
                if (a == (IRValue*)0 | b == (IRValue*)0) { -> false; };
                if (a.ty.kind != LK.INT | b.ty.kind != LK.INT) { -> false; };
                if (a.ty.width != b.ty.width) { -> false; };
                if (!this.s_cint(a)) { -> false; };
                va = this.scv;
                if (!this.s_cint(b)) { -> false; };
                -> va == this.scv;
            };


            // The instruction xor v, true when v is the negation of a one bit value, else null
            s_notof(IRValue* v) -> SI*
            {
                SI* d;
                if (v.ty.kind != LK.INT) { -> (SI*)0; };
                if (v.ty.width != 1) { -> (SI*)0; };
                if (v.di == (void*)0) { -> (SI*)0; };
                d = (SI*)v.di;
                if (d.op == SO_CMP & d.res == v & d.n == 0 & d.k == SP_EQ)
                {
                    // a compare of a truth value with false
                    if (d.a.ty.kind == LK.INT & d.a.ty.width == 1 & this.s_cint(d.b))
                    {
                        if (this.scv == (i64)0) { -> d; };
                    };
                    -> (SI*)0;
                };
                if (d.op != SO_BIN | d.k != SB_XOR) { -> (SI*)0; };
                if (d.res != v) { -> (SI*)0; };
                if (!this.s_cint(d.b)) { -> (SI*)0; };
                if (this.scv != (i64)1) { -> (SI*)0; };
                if (d.a.ty.kind != LK.INT) { -> (SI*)0; };
                if (d.a.ty.width != 1) { -> (SI*)0; };
                -> d;
            };

            s_opt() -> void
            {
                GF* g = this.sf;
                this.escok = false;
                IRFunc* f = g.f;
                int nb = g.nb;
                int i, j, k, n, o, rounds, back, lim;
                bool changed = true;
                GB* gb;
                SI* x;
                SI* y;
                IRValue* r;
                IRValue* gv;
                rounds = 0;
                while (changed & rounds < 12)
                {
                    changed = false;
                    rounds++;
                    i = 0;
                    while (i < nb)
                    {
                        gb = (GB*)g.bl.items[i];
                        if (gb.ib.insts != (PtrVec*)0)
                        {
                            j = 0;
                            while (j < gb.ib.insts.len)
                            {
                                x = (SI*)gb.ib.insts.items[j];
                                if (x.op != 0)
                                {
                                    this.s_fixops(x);
                                    o = x.op;
                                    r = (IRValue*)0;
                                    if (o == SO_CBR | o == SO_SELECT)
                                    {
                                        // a branch or select on the negation of a truth value tests the value and swaps its arms
                                        y = this.s_notof(x.a);
                                        if (y != (SI*)0)
                                        {
                                            x.a = this.s_res(y.a);
                                            if (o == SO_CBR)
                                            {
                                                // k is 1 when the branch is taken for a false condition
                                                x.k = 1 - x.k;
                                            }
                                            else
                                            {
                                                gv = x.b;
                                                x.b = x.c;
                                                x.c = gv;
                                            };
                                            changed = true;
                                        };
                                    };
                                    if (o == SO_SWITCH & x.n == 1)
                                    {
                                        // a one case switch on a truth value is a conditional branch
                                        gv = x.a;
                                        if (gv.ty.kind == LK.INT & gv.ty.width > 1 & gv.di != (void*)0)
                                        {
                                            y = (SI*)gv.di;
                                            if (y.op == SO_CAST & y.res == gv & y.k == SK_ZEXT)
                                            {
                                                if (y.a.ty.kind == LK.INT & y.a.ty.width == 1) { gv = y.a; };
                                            };
                                        };
                                        if (gv.ty.kind == LK.INT & gv.ty.width == 1 & x.blks[0] != x.f)
                                        {
                                            if (this.s_cint(this.s_res(x.args[0])))
                                            {
                                                if (this.scv == (i64)1 | this.scv == (i64)0)
                                                {
                                                    x.k = 0;
                                                    if (this.scv == (i64)0) { x.k = 1; };
                                                    x.a = gv;
                                                    x.t = x.blks[0];
                                                    x.op = SO_CBR;
                                                    x.n = 0;
                                                    changed = true;
                                                };
                                            };
                                        };
                                    };
                                    if (o == SO_BIN & x.res != (IRValue*)0 & SSA_OPT_MULSEL == 1)
                                    {
                                        if (this.s_mulsel(x)) { o = SO_SELECT; };
                                    };
                                    if (x.res != (IRValue*)0)
                                    {
                                        if (o == SO_BIN) { r = this.s_simp_bin(x); }
                                        elif (o == SO_CMP) { r = this.s_simp_cmp(x); }
                                        elif (o == SO_CAST) { r = this.s_simp_cast(x); }
                                        elif (o == SO_SELECT) { r = this.s_simp_sel(x); }
                                        elif (o == SO_PHI) { r = this.s_simp_phi(x); };
                                    };
                                    if (r != (IRValue*)0)
                                    {
                                        if (r.ty == x.res.ty | (r.ty.kind == x.res.ty.kind & r.ty.kind == LK.INT & r.ty.width == x.res.ty.width) | (r.ty.kind == LK.PTR & x.res.ty.kind == LK.PTR))
                                        {
                                            x.res.fwd = this.s_res(r);
                                            x.op = 0;
                                            changed = true;
                                        };
                                    }
                                    elif (x.res != (IRValue*)0 & (o == SO_BIN | o == SO_CMP | o == SO_CAST | o == SO_GEP | o == SO_SELECT) & !x.vol)
                                    {
                                        // an identical pure instruction earlier in this block
                                        lim = j - 48;
                                        if (lim < 0) { lim = 0; };
                                        back = j - 1;
                                        while (back >= lim)
                                        {
                                            y = (SI*)gb.ib.insts.items[back];
                                            if (y.op == o & y.res != (IRValue*)0)
                                            {
                                                if (this.s_same_inst(x, y))
                                                {
                                                    x.res.fwd = y.res;
                                                    x.op = 0;
                                                    changed = true;
                                                    back = 0 - 1;
                                                };
                                            };
                                            back--;
                                        };
                                    };
                                    if (x.op != 0 & x.res != (IRValue*)0 & (o == SO_BIN | o == SO_CMP | o == SO_CAST | o == SO_GEP | o == SO_SELECT) & !x.vol)
                                    {
                                        // the same pure instruction in the blocks that must run before this one
                                        y = this.s_pure_cse(gb, j, x);
                                        if (y != (SI*)0)
                                        {
                                            x.res.fwd = y.res;
                                            x.op = 0;
                                            changed = true;
                                        };
                                    };
                                    if (x.op == SO_LOAD & !x.vol & x.res != (IRValue*)0)
                                    {
                                        // the same address was read earlier on the only way here, with nothing written between
                                        y = this.s_load_cse(gb, j, x);
                                        if (y != (SI*)0)
                                        {
                                            if (y.op == SO_STORE) { x.res.fwd = this.s_res(y.a); } else { x.res.fwd = y.res; };
                                            x.op = 0;
                                            changed = true;
                                        };
                                    };
                                };
                                j++;
                            };
                            n = 0;
                            j = 0;
                            while (j < gb.ib.insts.len)
                            {
                                x = (SI*)gb.ib.insts.items[j];
                                if (x.op != 0)
                                {
                                    gb.ib.insts.items[n] = (void*)x;
                                    n++;
                                };
                                j++;
                            };
                            gb.ib.insts.len = n;
                        };
                        i++;
                    };
                };
                // every operand now reads the final value
                i = 0;
                while (i < nb)
                {
                    gb = (GB*)g.bl.items[i];
                    if (gb.ib.insts != (PtrVec*)0)
                    {
                        j = 0;
                        while (j < gb.ib.insts.len)
                        {
                            this.s_fixops((SI*)gb.ib.insts.items[j]);
                            j++;
                        };
                    };
                    i++;
                };
                ->;
            };


            // Rebuilds the control flow graph of the function from the recorded instructions, dropping the
            // blocks nothing reaches any more
            s_recfg() -> bool
            {
                GF* g = this.sf;
                int i = 0;
                GB* gb;
                while (i < g.bl.len)
                {
                    gb = (GB*)g.bl.items[i];
                    pv_free(gb.preds); pv_free(gb.succs); pv_free(gb.kids); pv_free(gb.df); pv_free(gb.phis); pv_free(gb.mi);
                    ffree((byte*)gb);
                    i++;
                };
                pv_free(g.bl);
                g.bl = pv_new();
                if (g.rpo != (GB**)0) { ffree((byte*)g.rpo); };
                g.rpo = (GB**)0;
                g.nb = 0;
                if (!this.s_cfg()) { -> false; };
                this.s_prunephi();
                -> true;
            };

            // Drops the incoming values of phis that name a block that no longer jumps to the phi's block
            // (a branch folded to a jump leaves such entries behind)
            s_prunephi() -> void
            {
                GF* g = this.sf;
                int i, j, k, n, q;
                bool isp;
                GB* gb;
                SI* x;
                i = 0;
                while (i < g.nb)
                {
                    gb = (GB*)g.bl.items[i];
                    if (gb.ib.insts != (PtrVec*)0)
                    {
                        j = 0;
                        while (j < gb.ib.insts.len)
                        {
                            x = (SI*)gb.ib.insts.items[j];
                            if (x.op != SO_PHI) { break; };
                            n = 0;
                            k = 0;
                            while (k < x.n)
                            {
                                isp = false;
                                q = 0;
                                while (q < gb.preds.len)
                                {
                                    if (((GB*)gb.preds.items[q]).ib == x.blks[k]) { isp = true; };
                                    q++;
                                };
                                if (isp)
                                {
                                    x.args[n] = x.args[k];
                                    x.blks[n] = x.blks[k];
                                    n++;
                                };
                                k++;
                            };
                            x.n = n;
                            j++;
                        };
                    };
                    i++;
                };
                ->;
            };

            // True when executing x on a path that did not run it before cannot trap, write memory or
            // change anything but its own result
            s_spec_ok(SI* x) -> bool
            {
                int o = x.op;
                int k;
                if (x.vol) { -> false; };
                if (x.res == (IRValue*)0) { -> false; };
                if (!this.s_scalar(x.res.ty)) { -> false; };
                // float selects are branches in the end, merging float paths gains nothing
                if (this.s_isfp(x.res.ty)) { -> false; };
                if (o == SO_CMP | o == SO_CAST | o == SO_GEP | o == SO_SELECT) { -> true; };
                if (o == SO_BIN)
                {
                    k = x.k;
                    if (k == SB_SDIV | k == SB_UDIV | k == SB_SREM | k == SB_UREM)
                    {
                        if (!this.s_cint(x.b)) { -> false; };
                        if (this.scv == (i64)0) { -> false; };
                        if (k == SB_SDIV | k == SB_SREM)
                        {
                            if (this.scv == (i64)0 - (i64)1) { -> false; };
                            if (this.a_mask((u64)this.scv, x.b.ty.width) == this.a_mask((u64)0 - (u64)1, x.b.ty.width)) { -> false; };
                        };
                    };
                    -> true;
                };
                -> false;
            };

            // Number of instructions block a would add to its predecessor when it only computes speculable
            // values and jumps to m, or -1 when it cannot be merged
            s_arm_ok(IRBlock* a, IRBlock* m) -> int
            {
                SI* t;
                SI* x;
                int j = 0;
                if (a.insts == (PtrVec*)0) { -> 0 - 1; };
                t = this.s_term(a);
                if (t == (SI*)0) { -> 0 - 1; };
                if (t.op != SO_BR | t.t != m) { -> 0 - 1; };
                while (j < a.insts.len - 1)
                {
                    x = (SI*)a.insts.items[j];
                    if (!this.s_spec_ok(x)) { -> 0 - 1; };
                    j++;
                };
                if (a.insts.len - 1 > 3) { -> 0 - 1; };
                -> a.insts.len - 1;
            };

            // The phi x also receives v along the edge from block b
            s_phi_add(SI* x, IRValue* v, IRBlock* b) -> void
            {
                IRValue** tv = (IRValue**)fmalloc((u64)(8 * (x.n + 2)));
                IRBlock** tb = (IRBlock**)fmalloc((u64)(8 * (x.n + 2)));
                int i = 0;
                while (i < x.n)
                {
                    tv[i] = x.args[i];
                    tb[i] = x.blks[i];
                    i++;
                };
                tv[x.n] = v;
                tb[x.n] = b;
                x.args = this.s_cpv(tv, x.n + 1);
                x.blks = this.s_cpb(tb, x.n + 1);
                x.n = x.n + 1;
                ffree((byte*)tv);
                ffree((byte*)tb);
                ->;
            };

            // Value phi x receives along the edge from block b, or null
            s_phi_from(SI* x, IRBlock* b) -> IRValue*
            {
                int i = 0;
                while (i < x.n)
                {
                    if (x.blks[i] == b) { -> x.args[i]; };
                    i++;
                };
                -> (IRValue*)0;
            };

            // Turns the branches around small side-effect free computations into selects: the computations move
            // into the branching block, the phis that merged the two paths become selects of their values.
            // Returns true when something changed.
            s_ifconv() -> bool
            {
                GF* g = this.sf;
                bool any = false;
                bool again = true;
                int rounds = 0;
                int i, j, k, nphi, na;
                GB* gp;
                GB* gt;
                GB* gf;
                GB* gm;
                IRBlock* tb;
                IRBlock* fb;
                IRBlock* mb;
                IRBlock* ea;
                IRBlock* eb;
                SI* t;
                SI* tt;
                SI* x;
                IRValue* c;
                IRValue* va;
                IRValue* vb;
                bool dia, trit, trif, ok;
                int* mark;
                while (again & rounds < 16)
                {
                    again = false;
                    rounds++;
                    mark = this.s_iz(g.nb + 1);
                    i = 0;
                    while (i < g.nb)
                    {
                        gp = (GB*)g.bl.items[i];
                        t = this.s_term(gp.ib);
                        if (t != (SI*)0 & mark[i] == 0)
                        {
                            if (t.op == SO_CBR & t.t != t.f)
                            {
                                tb = t.t;
                                fb = t.f;
                                gt = this.s_gb(tb);
                                gf = this.s_gb(fb);
                                dia = false;
                                trit = false;
                                trif = false;
                                mb = (IRBlock*)0;
                                tt = this.s_term(tb);
                                if (tt != (SI*)0)
                                {
                                    if (tt.op == SO_BR & gt.preds.len == 1)
                                    {
                                        if (tt.t == fb & gf.preds.len == 2) { trit = true; mb = fb; };
                                    };
                                };
                                tt = this.s_term(fb);
                                if (tt != (SI*)0 & !trit)
                                {
                                    if (tt.op == SO_BR & gf.preds.len == 1)
                                    {
                                        if (tt.t == tb & gt.preds.len == 2) { trif = true; mb = tb; };
                                    };
                                };
                                if (!trit & !trif)
                                {
                                    tt = this.s_term(tb);
                                    if (tt != (SI*)0 & this.s_term(fb) != (SI*)0)
                                    {
                                        if (tt.op == SO_BR & this.s_term(fb).op == SO_BR & gt.preds.len == 1 & gf.preds.len == 1)
                                        {
                                            if (tt.t == this.s_term(fb).t) { dia = true; mb = tt.t; };
                                        };
                                    };
                                };
                                if (mb != (IRBlock*)0)
                                {
                                    gm = this.s_gb(mb);
                                    ok = mb != gp.ib & mb != tb & mb != fb & gm.preds.len == 2;
                                    // the blocks involved must not have been rewritten in this round
                                    if (ok)
                                    {
                                        if (mark[gt.ib.gi] != 0 | mark[gf.ib.gi] != 0 | mark[gm.ib.gi] != 0) { ok = false; };
                                    };
                                    // the edge blocks of the two sides of the branch
                                    ea = gp.ib;
                                    eb = gp.ib;
                                    na = 0;
                                    if (ok)
                                    {
                                        ea = tb;
                                        eb = fb;
                                        if (trit) { ea = tb; eb = gp.ib; };
                                        if (trif) { ea = gp.ib; eb = fb; };
                                        if (ea != gp.ib) { k = this.s_arm_ok(ea, mb); if (k < 0) { ok = false; } else { na = na + k; }; };
                                        if (eb != gp.ib) { k = this.s_arm_ok(eb, mb); if (k < 0) { ok = false; } else { na = na + k; }; };
                                        if (na > 4) { ok = false; };
                                    };
                                    // every phi of the merge block must be a scalar with a value from each side
                                    nphi = 0;
                                    if (ok)
                                    {
                                        if (mb.insts == (PtrVec*)0) { ok = false; };
                                    };
                                    if (ok)
                                    {
                                        j = 0;
                                        while (j < mb.insts.len)
                                        {
                                            x = (SI*)mb.insts.items[j];
                                            if (x.op != SO_PHI) { break; };
                                            if (!this.s_scalar(x.ty) | this.s_isfp(x.ty)) { ok = false; };
                                            if (this.s_phi_from(x, ea) == (IRValue*)0 | this.s_phi_from(x, eb) == (IRValue*)0) { ok = false; };
                                            nphi++;
                                            j++;
                                        };
                                        if (nphi > 4) { ok = false; };
                                    };
                                    if (ok)
                                    {
                                        c = this.s_res(t.a);
                                        // move the computations of the arms into this block, before its branch
                                        gp.ib.insts.len = gp.ib.insts.len - 1;
                                        if (ea != gp.ib)
                                        {
                                            j = 0;
                                            while (j < ea.insts.len - 1) { pv_push(gp.ib.insts, ea.insts.items[j]); j++; };
                                            ea.insts.len = 0;
                                        };
                                        if (eb != gp.ib)
                                        {
                                            j = 0;
                                            while (j < eb.insts.len - 1) { pv_push(gp.ib.insts, eb.insts.items[j]); j++; };
                                            eb.insts.len = 0;
                                        };
                                        // the phis choose by the condition
                                        j = 0;
                                        while (j < nphi)
                                        {
                                            x = (SI*)mb.insts.items[j];
                                            va = this.s_phi_from(x, ea);
                                            vb = this.s_phi_from(x, eb);
                                            x.op = SO_SELECT;
                                            x.a = c;
                                            x.b = va;
                                            x.c = vb;
                                            if (t.k == 1)
                                            {
                                                x.b = vb;
                                                x.c = va;
                                            };
                                            x.n = 0;
                                            x.flag = false;
                                            j++;
                                        };
                                        t.op = SO_BR;
                                        t.k = 0;
                                        t.t = mb;
                                        t.f = (IRBlock*)0;
                                        pv_push(gp.ib.insts, (void*)t);
                                        mark[i] = 1;
                                        mark[gt.ib.gi] = 1;
                                        mark[gf.ib.gi] = 1;
                                        mark[gm.ib.gi] = 1;
                                        any = true;
                                        again = true;
                                    };
                                };
                            };
                        };
                        i++;
                    };
                    this.s_ifree(mark);
                    if (again)
                    {
                        if (!this.s_recfg()) { -> any; };
                    };
                };
                -> any;
            };


            // Number of operands equal to v in the whole function
            s_nuse(IRValue* v) -> int
            {
                GF* g = this.sf;
                int i, j, k, n;
                int c = 0;
                GB* gb;
                SI* x;
                i = 0;
                while (i < g.nb)
                {
                    gb = (GB*)g.bl.items[i];
                    if (gb.ib.insts != (PtrVec*)0)
                    {
                        j = 0;
                        while (j < gb.ib.insts.len)
                        {
                            x = (SI*)gb.ib.insts.items[j];
                            n = this.s_nops(x);
                            k = 0;
                            while (k < n)
                            {
                                if (this.s_res(this.s_op(x, k)) == v) { c++; };
                                k++;
                            };
                            j++;
                        };
                    };
                    i++;
                };
                -> c;
            };

            // True when an instruction of block a or block b defines v
            s_defin(IRValue* v, IRBlock* a, IRBlock* b) -> bool
            {
                int j;
                SI* x;
                j = 0;
                while (a.insts != (PtrVec*)0 & j < a.insts.len)
                {
                    x = (SI*)a.insts.items[j];
                    if (x.res != (IRValue*)0) { if (this.s_res(x.res) == v) { -> true; }; };
                    j++;
                };
                j = 0;
                while (b.insts != (PtrVec*)0 & j < b.insts.len)
                {
                    x = (SI*)b.insts.items[j];
                    if (x.res != (IRValue*)0) { if (this.s_res(x.res) == v) { -> true; }; };
                    j++;
                };
                -> false;
            };

            // The loop whose header is hb, when it counts an index from zero up to a bound and stores one
            // value to each element of an array, becomes one SO_FILL in the block in front of it:
            //     i = 0; while (i < n) { p[i] = c; i++; }
            // The index must have no other use. Returns true when the loop was replaced.
            s_fill_one(GB* hb) -> bool
            {
                SI* ph; SI* cm; SI* cb; SI* x; SI* gep; SI* gep2; SI* st; SI* ld; SI* ad; SI* pt; SI* fl;
                int nb;
                bool iscopy, incl, zs, guard;
                IRValue* big; IRBlock* fb; IRBlock* pb2; SI* ph2;
                int thr, jj;
                GB* bb; GB* pr; GB* p0; GB* p1;
                IRValue* iv; IRValue* n; IRValue* a0; IRValue* a1; IRValue* nx; IRValue* val;
                IRValue* cnt; IRValue* aw; IRValue* nw; IRValue* dp; IRValue* sp; IRValue* ix;
                IRValue** gi;
                IRType* t64;
                IRBlock* eb;
                int ip, il, j, w, sz, sgn;
                if (hb.preds.len != 2) { -> false; };
                if (hb.ib.insts == (PtrVec*)0) { -> false; };
                if (hb.ib.insts.len != 3) { -> false; };
                ph = (SI*)hb.ib.insts.items[0];
                cm = (SI*)hb.ib.insts.items[1];
                cb = (SI*)hb.ib.insts.items[2];
                if (ph.op != SO_PHI | cm.op != SO_CMP | cb.op != SO_CBR) { -> false; };
                if (ph.n != 2 | cm.n != 0 | cb.k != 0) { -> false; };
                iv = ph.res;
                if (iv.ty.kind != LK.INT) { -> false; };
                w = iv.ty.width;
                if (w != 32 & w != 64) { -> false; };
                if (this.s_res(cb.a) != cm.res) { -> false; };
                // the compare is index < bound
                n = (IRValue*)0;
                sgn = 0;
                incl = false;
                if (this.s_res(cm.a) == iv)
                {
                    n = this.s_res(cm.b);
                    if (cm.k == SP_SLT) { sgn = 1; }
                    elif (cm.k == SP_SLE & SSA_OPT_FILLX == 1) { sgn = 1; incl = true; }
                    elif (cm.k != SP_ULT | w != 64) { -> false; };
                }
                elif (this.s_res(cm.b) == iv)
                {
                    n = this.s_res(cm.a);
                    if (cm.k == SP_SGT) { sgn = 1; }
                    elif (cm.k == SP_SGE & SSA_OPT_FILLX == 1) { sgn = 1; incl = true; }
                    elif (cm.k != SP_UGT | w != 64) { -> false; };
                };
                if (n == (IRValue*)0) { -> false; };
                if (n.ty.kind != LK.INT | n.ty.width != w) { -> false; };
                p0 = (GB*)hb.preds.items[0];
                p1 = (GB*)hb.preds.items[1];
                bb = p1;
                pr = p0;
                if (p0.preds.len == 1 & p0.succs.len == 1)
                {
                    if ((GB*)p0.preds.items[0] == hb) { bb = p0; pr = p1; };
                };
                if (bb.preds.len != 1 | bb.succs.len != 1) { -> false; };
                if ((GB*)bb.preds.items[0] != hb | (GB*)bb.succs.items[0] != hb) { -> false; };
                if (pr.succs.len != 1 | pr == hb | pr == bb) { -> false; };
                // a loop already guarded by a run time count test stays a loop
                if (pr.ib.name != (byte*)0)
                {
                    // the names carry a number behind them
                    if (pr.ib.name[0] == (byte)102 & pr.ib.name[1] == (byte)105 & pr.ib.name[2] == (byte)108 & pr.ib.name[3] == (byte)108 & pr.ib.name[4] == (byte)46 & pr.ib.name[5] == (byte)112 & pr.ib.name[6] == (byte)114 & pr.ib.name[7] == (byte)101) { -> false; };
                };
                if (cb.t != bb.ib) { -> false; };
                eb = cb.f;
                if (eb == hb.ib | eb == bb.ib) { -> false; };
                ip = 0;
                il = 1;
                if (ph.blks[0] == bb.ib) { ip = 1; il = 0; };
                if (ph.blks[ip] != pr.ib | ph.blks[il] != bb.ib) { -> false; };
                a0 = this.s_res(ph.args[ip]);
                zs = false;
                if (this.s_cint(a0)) { if (this.scv == (i64)0) { zs = true; }; };
                if (!zs)
                {
                    // another start is handled with signed compares only
                    if (SSA_OPT_FILLX != 1 | sgn == 0) { -> false; };
                    if (a0.ty.kind != LK.INT | a0.ty.width != w) { -> false; };
                };
                nx = this.s_res(ph.args[il]);
                if (this.s_defin(n, hb.ib, bb.ib)) { -> false; };
                // the body: the address, the store and the increment
                if (bb.ib.insts == (PtrVec*)0) { -> false; };
                nb = bb.ib.insts.len;
                if (nb != 4 & nb != 6) { -> false; };
                gep = (SI*)0;
                gep2 = (SI*)0;
                st = (SI*)0;
                ld = (SI*)0;
                ad = (SI*)0;
                j = 0;
                while (j < nb - 1)
                {
                    x = (SI*)bb.ib.insts.items[j];
                    if (x.op == SO_GEP & gep == (SI*)0) { gep = x; }
                    elif (x.op == SO_GEP & gep2 == (SI*)0) { gep2 = x; }
                    elif (x.op == SO_STORE & st == (SI*)0) { st = x; }
                    elif (x.op == SO_LOAD & ld == (SI*)0) { ld = x; }
                    elif (x.op == SO_BIN & ad == (SI*)0) { ad = x; }
                    else { -> false; };
                    j++;
                };
                pt = (SI*)bb.ib.insts.items[nb - 1];
                if (pt.op != SO_BR | pt.t != hb.ib) { -> false; };
                if (gep == (SI*)0 | st == (SI*)0 | ad == (SI*)0) { -> false; };
                iscopy = nb == 6;
                if (iscopy & (gep2 == (SI*)0 | ld == (SI*)0)) { -> false; };
                if (!iscopy & (gep2 != (SI*)0 | ld != (SI*)0)) { -> false; };
                if (ad.res == (IRValue*)0 | gep.res == (IRValue*)0) { -> false; };
                if (this.s_res(ad.res) != nx | ad.k != SB_ADD) { -> false; };
                if (this.s_res(ad.a) != iv) { -> false; };
                if (!this.s_cint(this.s_res(ad.b))) { -> false; };
                if (this.scv != (i64)1) { -> false; };
                if (st.vol | st.ty.kind != LK.INT) { -> false; };
                sz = this.a_size(st.ty);
                if (sz != 1 & sz != 2 & sz != 4 & sz != 8) { -> false; };
                if (iscopy)
                {
                    // the source address feeds the load, the other one the store
                    if (this.s_res(ld.a) == this.s_res(gep2.res)) { x = gep; gep = gep2; gep2 = x; };
                    if (this.s_res(ld.a) != this.s_res(gep.res) | this.s_res(st.b) != this.s_res(gep2.res)) { -> false; };
                    if (this.s_res(st.a) != this.s_res(ld.res) | ld.vol | ld.ty.kind != LK.INT) { -> false; };
                    if (this.a_size(ld.ty) != sz) { -> false; };
                    if (gep2.n != 1 | this.s_res(gep2.args[0]) != iv | gep2.res == (IRValue*)0) { -> false; };
                    if (this.s_res(gep2.a).ty.kind != LK.PTR) { -> false; };
                    if (this.s_defin(this.s_res(gep2.a), hb.ib, bb.ib)) { -> false; };
                    if (this.a_size(this.s_res(gep2.a).ty.elem) != sz) { -> false; };
                    if (this.s_nuse(this.s_res(gep2.res)) != 1 | this.s_nuse(this.s_res(ld.res)) != 1) { -> false; };
                    val = this.s_res(gep2.a);
                }
                else
                {
                    if (this.s_res(st.b) != this.s_res(gep.res)) { -> false; };
                    val = this.s_res(st.a);
                    if (this.s_defin(val, hb.ib, bb.ib)) { -> false; };
                    if (sz > 1)
                    {
                        if (!this.s_cint(val)) { -> false; };
                        if (this.scv != (i64)0) { -> false; };
                    };
                };
                if (gep.n != 1 | this.s_res(gep.args[0]) != iv) { -> false; };
                if (this.s_res(gep.a).ty.kind != LK.PTR) { -> false; };
                if (this.s_defin(this.s_res(gep.a), hb.ib, bb.ib)) { -> false; };
                if (this.a_size(this.s_res(gep.a).ty.elem) != sz) { -> false; };
                // nothing else reads the index or the address
                nb = 3;
                if (iscopy) { nb = 4; };
                if (this.s_nuse(iv) != nb | this.s_nuse(nx) != 1 | this.s_nuse(this.s_res(gep.res)) != 1) { -> false; };
                // a short run is faster as the loop, rep has a start up cost: a constant count below the limit stays a loop,
                // any other count is tested at run time
                thr = 32;
                if (sz > 1) { thr = 64; };
                thr = (thr + sz - 1) / sz;
                guard = SSA_OPT_FILLG == 1;
                if (guard & zs & !incl & this.s_cint(n))
                {
                    if (this.scv < (i64)thr) { -> false; };
                    guard = false;
                };
                // fill in front of the loop and skip it
                pr.ib.insts.len = pr.ib.insts.len - 1;
                pt = (SI*)pr.ib.insts.items[pr.ib.insts.len];
                if (pt.op != SO_BR | pt.t != hb.ib) { pv_push(pr.ib.insts, (void*)pt); -> false; };
                cnt = n;
                dp = val;
                sp = this.s_res(gep.a);
                if (!zs | incl)
                {
                    // the count and the first element are computed wide, so a bound near the limit of the index type
                    // cannot wrap
                    t64 = this.t_int(64);
                    this.cb = pr.ib;
                    if (w == 32)
                    {
                        if (this.s_cint(a0)) { aw = this.s_kint(t64, (u64)this.s_usx((u64)this.scv, 32)); }
                        else { aw = this.new_value(t64, g"%vr\0"); this.s_r_castk(SK_SEXT, a0, t64, aw); };
                        if (this.s_cint(n)) { nw = this.s_kint(t64, (u64)this.s_usx((u64)this.scv, 32)); }
                        else { nw = this.new_value(t64, g"%vr\0"); this.s_r_castk(SK_SEXT, n, t64, nw); };
                    }
                    else
                    {
                        aw = a0;
                        nw = n;
                    };
                    if (zs) { cnt = nw; } else { cnt = this.s_ubin(SB_SUB, nw, aw); };
                    if (incl) { cnt = this.s_ubin(SB_ADD, cnt, this.s_kint(t64, (u64)1)); };
                    if (!zs)
                    {
                        gi = (IRValue**)fmalloc((u64)16);
                        gi[0] = aw;
                        ix = this.new_value(sp.ty, g"%vr\0");
                        this.s_r_gep(sp, gi, 1, ix);
                        sp = ix;
                        if (iscopy)
                        {
                            ix = this.new_value(dp.ty, g"%vr\0");
                            this.s_r_gep(dp, gi, 1, ix);
                            dp = ix;
                        };
                        ffree((byte*)gi);
                    };
                };
                fl = this.s_new(SO_FILL);
                fl.a = sp;
                fl.b = val;
                if (iscopy)
                {
                    // destination is the stored array, source the loaded one
                    fl.op = SO_COPY;
                    fl.a = dp;
                    fl.b = sp;
                };
                fl.c = cnt;
                fl.k = sgn;
                fl.sz = sz;
                fl.ty = st.ty;
                if (guard)
                {
                    this.cb = pr.ib;
                    big = this.s_ucmp(SP_SGE, cnt, this.s_kint(cnt.ty, (u64)thr), cm.res.ty);
                    fb = this.append_block(this.cf, g"fill.blk\0");
                    pb2 = this.append_block(this.cf, g"fill.pre\0");
                    this.s_r_cbr(big, fb, pb2);
                    // the loop keeps a plain jump in front of it, the other loop passes look for one
                    this.cb = pb2;
                    this.s_r_br(hb.ib);
                    this.s_rephi(this.s_term(pb2), pr.ib, pb2);
                    this.cb = fb;
                    this.s_push(fl);
                    this.s_r_br(eb);
                    // the phis behind the loop take the same values from the fill block
                    if (eb.insts != (PtrVec*)0)
                    {
                        jj = 0;
                        while (jj < eb.insts.len)
                        {
                            ph2 = (SI*)eb.insts.items[jj];
                            if (ph2.op != SO_PHI) { break; };
                            val = this.s_phi_from(ph2, hb.ib);
                            if (val != (IRValue*)0) { this.s_phi_add(ph2, val, fb); };
                            jj++;
                        };
                    };
                    -> true;
                };
                pv_push(pr.ib.insts, (void*)fl);
                pt.t = eb;
                pv_push(pr.ib.insts, (void*)pt);
                this.s_rephi(pt, hb.ib, pr.ib);
                -> true;
            };

            // The constant and the other operand of the integer compare cm when exactly one operand is a constant
            // (the other one in this.eqx, the constant in this.eqv, false for anything else)
            s_eqc_key(SI* cm) -> bool
            {
                IRValue* a;
                IRValue* b;
                if (cm.op != SO_CMP | cm.n != 0 | cm.k != SP_EQ) { -> false; };
                a = this.s_res(cm.a);
                b = this.s_res(cm.b);
                if (a.ty.kind != LK.INT) { -> false; };
                if (a.ty.width < 8 | a.ty.width > 64) { -> false; };
                if (this.s_cint(b) & !this.s_cint(a))
                {
                    this.eqx = a;
                    this.s_cint(b);
                    this.eqv = this.a_mask((u64)this.scv, a.ty.width);
                    -> true;
                };
                if (this.s_cint(a) & !this.s_cint(b))
                {
                    this.eqx = b;
                    this.s_cint(a);
                    this.eqv = this.a_mask((u64)this.scv, a.ty.width);
                    -> true;
                };
                -> false;
            };

            // A chain of blocks that each compare one value with a constant and leave for the same block when equal,
            //     if (c == 46 | c == 44 | c == 59 | ...)
            // becomes one membership test: windows of up to 64 consecutive values, each a range check and a bit of a
            // mask. Returns true when a chain was replaced.
            s_eqchain_one(GB* b1) -> bool
            {
                PtrVec* ms;
                u64* keys;
                u64* wk; u64* wm; u64* ws;
                GB* g;
                GB* last;
                SI* cm; SI* tm; SI* c2; SI* t2; SI* ph; SI* lc;
                IRValue* x; IRValue* m; IRValue* win; IRValue* tv; IRValue* sh; IRValue* bit; IRValue* inr;
                IRType* xt; IRType* t64; IRType* t1;
                IRBlock* T; IRBlock* F; IRBlock* zb; IRBlock* nxb; IRBlock* bb; IRBlock** wb;
                PtrVec* hits; PtrVec* pvals; PtrVec* pflag;
                int nb, nk, i, j, k, q, nw, w, np, ne, pj;
                bool shA, ok, cont;
                u64 kmin, mask, span, tmp;
                if (b1.ib.insts == (PtrVec*)0) { -> false; };
                nb = b1.ib.insts.len;
                if (nb < 2) { -> false; };
                cm = (SI*)b1.ib.insts.items[nb - 2];
                tm = (SI*)b1.ib.insts.items[nb - 1];
                if (tm.op != SO_CBR | tm.k != 0) { -> false; };
                if (!this.s_eqc_key(cm)) { -> false; };
                if (this.s_res(tm.a) != cm.res) { -> false; };
                if (this.s_nuse(cm.res) != 1) { -> false; };
                x = this.eqx;
                xt = x.ty;
                w = xt.width;
                T = tm.t;
                if (T == tm.f) { -> false; };
                ms = pv_new();
                keys = (u64*)fmalloc((u64)(8 * 66));
                pv_push(ms, (void*)b1);
                keys[0] = this.eqv;
                nk = 1;
                shA = false;
                last = b1;
                lc = cm;
                cont = true;
                while (cont & nk < 64)
                {
                    cont = false;
                    t2 = (SI*)last.ib.insts.items[last.ib.insts.len - 1];
                    if (t2.op != SO_CBR) { break; };
                    g = this.s_gb(t2.f);
                    if (g == (GB*)0) { break; };
                    if (g == b1 | g.preds.len != 1) { break; };
                    if (g.ib.insts == (PtrVec*)0) { break; };
                    if (g.ib.insts.len != 2) { break; };
                    c2 = (SI*)g.ib.insts.items[0];
                    t2 = (SI*)g.ib.insts.items[1];
                    if (!this.s_eqc_key(c2)) { break; };
                    if (this.eqx != x) { break; };
                    if (this.s_nuse(c2.res) != 1) { break; };
                    if (t2.op == SO_CBR)
                    {
                        if (t2.k != 0 | t2.t != T | this.s_res(t2.a) != c2.res | t2.f == T) { break; };
                        keys[nk] = this.eqv;
                        nk++;
                        pv_push(ms, (void*)g);
                        last = g;
                        lc = c2;
                        cont = true;
                    }
                    elif (t2.op == SO_BR)
                    {
                        if (t2.t != T) { break; };
                        keys[nk] = this.eqv;
                        nk++;
                        pv_push(ms, (void*)g);
                        last = g;
                        lc = c2;
                        shA = true;
                    };
                };
                if (nk < 4) { pv_free(ms); ffree((byte*)keys); -> false; };
                // windows of consecutive values
                i = 1;
                while (i < nk)
                {
                    tmp = keys[i];
                    j = i - 1;
                    while (j >= 0)
                    {
                        if (keys[j] <= tmp) { break; };
                        keys[j + 1] = keys[j];
                        j--;
                    };
                    keys[j + 1] = tmp;
                    i++;
                };
                wk = (u64*)fmalloc((u64)(8 * 66));
                wm = (u64*)fmalloc((u64)(8 * 66));
                ws = (u64*)fmalloc((u64)(8 * 66));
                nw = 0;
                i = 0;
                while (i < nk)
                {
                    kmin = keys[i];
                    mask = (u64)0;
                    span = (u64)1;
                    j = i;
                    while (j < nk)
                    {
                        if (keys[j] - kmin >= (u64)64) { break; };
                        mask = mask | ((u64)1 << (keys[j] - kmin));
                        span = keys[j] - kmin + (u64)1;
                        j++;
                    };
                    wk[nw] = kmin;
                    wm[nw] = mask;
                    ws[nw] = span;
                    nw++;
                    i = j;
                };
                ok = nw <= 3 & nk >= 3 * nw + 1;
                // the phis behind the chain: shape of the incoming values
                ne = 0;
                pvals = pv_new();
                pflag = pv_new();
                if (ok)
                {
                    j = 0;
                    while (j < T.insts.len & ok)
                    {
                        ph = (SI*)T.insts.items[j];
                        j++;
                        if (ph.op != SO_PHI) { break; };
                        i = 0;
                        while (i < ms.len & ok)
                        {
                            g = (GB*)ms.items[i];
                            m = this.s_phi_from(ph, g.ib);
                            if (m == (IRValue*)0) { ok = false; };
                            i++;
                        };
                        if (!ok) { break; };
                        // values from the members: all one value, or true from all but the last and its compare from the last
                        tv = this.s_res(this.s_phi_from(ph, ((GB*)ms.items[0]).ib));
                        q = 0;
                        i = 1;
                        while (i < ms.len)
                        {
                            m = this.s_res(this.s_phi_from(ph, ((GB*)ms.items[i]).ib));
                            if (!this.s_sameop(m, tv) & m != tv) { q = 1; };
                            i++;
                        };
                        pv_push(pvals, (void*)tv);
                        pv_push(pflag, (void*)q);
                        if (q == 1)
                        {
                            // the last member hands over its compare, every other one a true
                            if (!shA) { ok = false; };
                            if (ok)
                            {
                                if (this.s_res(this.s_phi_from(ph, last.ib)) != this.s_res(lc.res)) { ok = false; };
                                i = 0;
                                while (i < ms.len - 1 & ok)
                                {
                                    m = this.s_res(this.s_phi_from(ph, ((GB*)ms.items[i]).ib));
                                    if (!this.s_cint(m)) { ok = false; }
                                    elif (this.scv != (i64)1) { ok = false; };
                                    i++;
                                };
                            };
                            ne = ne + 1;
                        };
                    };
                };
                if (ok & shA)
                {
                    // the compare of the last member must reach the phi only through that phi
                    if (this.s_nuse(lc.res) != 1) { ok = false; };
                };
                if (!ok) { pv_free(pvals); pv_free(pflag); pv_free(ms); ffree((byte*)keys); ffree((byte*)wk); ffree((byte*)wm); ffree((byte*)ws); -> false; };
                // rewrite: one test block per window, the first one is the head of the chain
                t64 = this.t_int(64);
                t1 = cm.res.ty;
                F = (IRBlock*)0;
                if (!shA)
                {
                    t2 = (SI*)last.ib.insts.items[last.ib.insts.len - 1];
                    F = t2.f;
                };
                hits = pv_new();
                wb = (IRBlock**)fmalloc((u64)(8 * 4));
                wb[0] = b1.ib;
                i = 1;
                while (i < nw)
                {
                    wb[i] = this.append_block(this.cf, g"eq.win\0");
                    i++;
                };
                zb = this.append_block(this.cf, g"eq.miss\0");
                b1.ib.insts.len = b1.ib.insts.len - 2;
                i = 0;
                while (i < nw)
                {
                    this.cb = wb[i];
                    mask = wm[i];
                    span = ws[i];
                    nxb = zb;
                    if (i + 1 < nw) { nxb = wb[i + 1]; };
                    if (span == (u64)1)
                    {
                        win = this.s_ucmp(SP_EQ, x, this.s_kint(xt, wk[i]), t1);
                        this.s_r_cbr(win, T, nxb);
                        pv_push(hits, (void*)wb[i]);
                    }
                    else
                    {
                        tv = x;
                        if (wk[i] != (u64)0) { tv = this.s_ubin(SB_SUB, x, this.s_kint(xt, wk[i])); };
                        inr = this.s_ucmp(SP_ULT, tv, this.s_kint(xt, span), t1);
                        if (mask == this.a_mask((u64)0 - (u64)1, (int)span))
                        {
                            this.s_r_cbr(inr, T, nxb);
                            pv_push(hits, (void*)wb[i]);
                        }
                        else
                        {
                            bb = this.append_block(this.cf, g"eq.bit\0");
                            this.s_r_cbr(inr, bb, nxb);
                            this.cb = bb;
                            sh = tv;
                            if (w < 64)
                            {
                                sh = this.new_value(t64, g"%vr\0");
                                this.s_r_castk(SK_ZEXT, tv, t64, sh);
                            };
                            bit = this.s_ubin(SB_LSHR, this.s_kint(t64, mask), sh);
                            bit = this.s_ubin(SB_AND, bit, this.s_kint(t64, (u64)1));
                            bit = this.s_ucmp(SP_NE, bit, this.s_kint(t64, (u64)0), t1);
                            this.s_r_cbr(bit, T, nxb);
                            pv_push(hits, (void*)bb);
                        };
                    };
                    i++;
                };
                this.cb = zb;
                if (shA) { this.s_r_br(T); } else { this.s_r_br(F); };
                // phis of the target: the entries of the chain are replaced by one per block that leaves for it
                j = 0;
                pj = 0;
                while (j < T.insts.len)
                {
                    ph = (SI*)T.insts.items[j];
                    j++;
                    if (ph.op != SO_PHI) { break; };
                    np = 0;
                    k = 0;
                    while (k < ph.n)
                    {
                        q = 0;
                        i = 0;
                        while (i < ms.len)
                        {
                            if (ph.blks[k] == ((GB*)ms.items[i]).ib) { q = 1; };
                            i++;
                        };
                        if (q == 0)
                        {
                            ph.args[np] = ph.args[k];
                            ph.blks[np] = ph.blks[k];
                            np++;
                        };
                        k++;
                    };
                    ph.n = np;
                    tv = (IRValue*)pvals.items[pj];
                    q = (int)pflag.items[pj];
                    pj++;
                    i = 0;
                    while (i < hits.len)
                    {
                        if (q == 1) { this.s_phi_add(ph, this.s_kint(t1, (u64)1), (IRBlock*)hits.items[i]); }
                        else { this.s_phi_add(ph, tv, (IRBlock*)hits.items[i]); };
                        i++;
                    };
                    if (shA)
                    {
                        if (q == 1) { this.s_phi_add(ph, this.s_kint(t1, (u64)0), zb); }
                        else { this.s_phi_add(ph, tv, zb); };
                    };
                };
                if (!shA)
                {
                    // the phis of the exit block come from the miss block now
                    j = 0;
                    while (j < F.insts.len)
                    {
                        ph = (SI*)F.insts.items[j];
                        j++;
                        if (ph.op != SO_PHI) { break; };
                        k = 0;
                        while (k < ph.n)
                        {
                            if (ph.blks[k] == last.ib) { ph.blks[k] = zb; };
                            k++;
                        };
                    };
                };
                pv_free(hits);
                ffree((byte*)wb);
                pv_free(pvals);
                pv_free(pflag);
                pv_free(ms);
                ffree((byte*)keys);
                ffree((byte*)wk);
                ffree((byte*)wm);
                ffree((byte*)ws);
                -> true;
            };

            // Replaces the compare chains of the function. Returns true when a chain was replaced.
            s_eqchain() -> bool
            {
                GF* g = this.sf;
                bool any = false;
                bool again = true;
                int i;
                GB* gb;
                while (again)
                {
                    again = false;
                    i = 0;
                    while (i < g.nb)
                    {
                        gb = (GB*)g.bl.items[i];
                        if (this.s_eqchain_one(gb))
                        {
                            any = true;
                            again = true;
                            if (!this.s_recfg()) { -> any; };
                            break;
                        };
                        i++;
                    };
                };
                -> any;
            };

            // Replaces the fill loops of the function. Returns true when a loop was replaced.
            s_fill() -> bool
            {
                GF* g = this.sf;
                bool any = false;
                bool again = true;
                int i;
                GB* gb;
                while (again)
                {
                    again = false;
                    i = 1;
                    while (i < g.nb)
                    {
                        gb = (GB*)g.bl.items[i];
                        if (this.s_fill_one(gb))
                        {
                            any = true;
                            again = true;
                            if (!this.s_recfg()) { -> any; };
                            break;
                        };
                        i++;
                    };
                };
                -> any;
            };


            // True when no instruction after position j of the block reads the flags set before the next one that sets them
            s_flag_dead(GB* gb, int j) -> bool
            {
                MI* m;
                int op;
                j++;
                while (j < gb.mi.len)
                {
                    m = (MI*)gb.mi.items[j];
                    op = m.op;
                    if (op == M_JCC | op == M_SETCC | op == M_CMOV | op == M_FSEL | op == M_ASM | op == M_TEXT | op == M_PCOPY) { -> false; };
                    if (op == M_CMP | op == M_TEST | op == M_FCMP | op == M_CALL | op == M_DIV | op == M_RMW | op == M_REPMOVS | op == M_REPSTOS) { -> true; };
                    if (op == M_ALU) { -> true; };
                    if (op == M_SHIFT & m.tgt != 77) { -> true; };
                    j++;
                };
                -> true;
            };

            // Removes the instructions that only compute a register nothing reads (an index plus a constant that
            // became a displacement, for one). Only moves of registers and constants, address computations and
            // extensions are touched: they have no effect but the register.
            s_mdce() -> void
            {
                GF* g = this.sf;
                int n = g.nb;
                int i, j, k, r, op, rounds, nd;
                bool changed;
                GB* gb;
                MI* m;
                int* cnt = this.s_iz(g.nvr + R_VBASE + 2);
                rounds = 0;
                changed = true;
                while (changed & rounds < 6)
                {
                    changed = false;
                    rounds++;
                    k = 0;
                    while (k < g.nvr + R_VBASE + 2) { cnt[k] = 0; k++; };
                    i = 0;
                    while (i < n)
                    {
                        gb = g.rpo[i];
                        j = 0;
                        while (j < gb.mi.len)
                        {
                            m = (MI*)gb.mi.items[j];
                            this.s_scan(m);
                            k = 0;
                            while (k < this.nub)
                            {
                                r = this.ubuf[k];
                                if (r >= R_VBASE & r < g.nvr + R_VBASE + 2) { cnt[r] = cnt[r] + 1; };
                                k++;
                            };
                            j++;
                        };
                        i++;
                    };
                    i = 0;
                    while (i < n)
                    {
                        gb = g.rpo[i];
                        j = 0;
                        while (j < gb.mi.len)
                        {
                            m = (MI*)gb.mi.items[j];
                            op = m.op;
                            if (op == M_LEA | op == M_MOVSX | op == M_MOVZX | op == M_MOV | op == M_ALU | op == M_SHIFT | op == M_UN)
                            {
                                if (op == M_MOV & m.o0 != (MO*)0)
                                {
                                    if (m.o0.k == MK_MEM) { j++; continue; };
                                };
                                if (op == M_ALU | op == M_SHIFT)
                                {
                                    if (m.o2 == (MO*)0) { j++; continue; };
                                    if (m.o2.k != MK_REG) { j++; continue; };
                                    if (!this.s_flag_dead(gb, j)) { j++; continue; };
                                }
                                elif (op == M_UN)
                                {
                                    if (m.o1 == (MO*)0) { j++; continue; };
                                    if (m.o1.k != MK_REG | m.o0.k != MK_REG) { j++; continue; };
                                    if (!this.s_flag_dead(gb, j)) { j++; continue; };
                                }
                                elif (op != M_LEA)
                                {
                                    if (m.o1 == (MO*)0) { j++; continue; };
                                    if (m.o1.k != MK_REG) { j++; continue; };
                                };
                                this.s_scan(m);
                                if (this.ndb == 1)
                                {
                                    r = this.dbuf[0];
                                    if (r >= R_VBASE & r < g.nvr + R_VBASE + 2)
                                    {
                                        if (cnt[r] == 0)
                                        {
                                            k = j;
                                            while (k < gb.mi.len - 1) { gb.mi.items[k] = gb.mi.items[k + 1]; k++; };
                                            gb.mi.len = gb.mi.len - 1;
                                            changed = true;
                                            continue;
                                        };
                                    };
                                };
                            };
                            j++;
                        };
                        i++;
                    };
                };
                this.s_ifree(cnt);
                ->;
            };

            // Removes x from the instruction list v
            s_ivw_del(PtrVec* v, SI* x) -> void
            {
                int i = 0;
                int j;
                while (i < v.len)
                {
                    if ((SI*)v.items[i] == x)
                    {
                        j = i;
                        while (j < v.len - 1) { v.items[j] = v.items[j + 1]; j++; };
                        v.len = v.len - 1;
                        ->;
                    };
                    i++;
                };
                ->;
            };

            // A loop that tests i < n at its header with 32 bit signed operands cannot wrap when it steps i by one,
            // so the 64 bit value of i is the same counter widened. When i only feeds that compare, the step and
            // the indexes of address computations, the loop keeps the wide counter instead and the sign
            // extension of every index goes away. Returns true when a loop was changed.
            s_ivw() -> bool
            {
                GF* g = this.sf;
                int n = g.nb;
                bool any = false;
                bool found, ok, ivleft;
                int h, i, j, k, m, top, nout, np, ip, il, nuse, nidx, nb;
                GB* hb; GB* b; GB* x; GB* pg; GB* pre;
                SI* cm; SI* cb; SI* ph; SI* ad; SI* ins; SI* pt; SI* nph; SI* nad;
                IRValue* iv; IRValue* nx; IRValue* nv; IRValue* a0; IRValue* i64a; IRValue* n64; IRValue* o;
                IRBlock* lbk;
                IRType* t64;
                PtrVec* ul;
                int* body = this.s_iz(n + 1);
                int* stk = this.s_iz(n + 1);
                t64 = this.t_int(64);
                h = n - 1;
                while (h >= 0)
                {
                    hb = g.rpo[h];
                    h--;
                    if (hb.preds.len != 2 | hb.ib.insts == (PtrVec*)0) { continue; };
                    nb = hb.ib.insts.len;
                    if (nb < 3) { continue; };
                    cm = (SI*)hb.ib.insts.items[nb - 2];
                    cb = (SI*)hb.ib.insts.items[nb - 1];
                    if (cm.op != SO_CMP | cb.op != SO_CBR) { continue; };
                    if (cm.n != 0 | cb.k != 0) { continue; };
                    if (this.s_res(cb.a) != cm.res) { continue; };
                    if (this.s_nuse(cm.res) != 1) { continue; };
                    // natural loop
                    i = 0;
                    while (i < n) { body[i] = 0; i++; };
                    found = false;
                    k = 0;
                    while (k < hb.preds.len)
                    {
                        pg = (GB*)hb.preds.items[k];
                        if (this.s_dominates(hb, pg))
                        {
                            found = true;
                            body[hb.rpo] = 1;
                            if (body[pg.rpo] == 0)
                            {
                                body[pg.rpo] = 1;
                                stk[0] = pg.rpo;
                                top = 1;
                                while (top > 0)
                                {
                                    top--;
                                    x = g.rpo[stk[top]];
                                    m = 0;
                                    while (m < x.preds.len)
                                    {
                                        b = (GB*)x.preds.items[m];
                                        if (body[b.rpo] == 0)
                                        {
                                            body[b.rpo] = 1;
                                            stk[top] = b.rpo;
                                            top++;
                                        };
                                        m++;
                                    };
                                };
                            };
                        };
                        k++;
                    };
                    if (!found) { continue; };
                    nout = 0;
                    pre = (GB*)0;
                    k = 0;
                    while (k < hb.preds.len)
                    {
                        pg = (GB*)hb.preds.items[k];
                        if (body[pg.rpo] == 0) { nout++; pre = pg; };
                        k++;
                    };
                    if (nout != 1) { continue; };
                    pt = this.s_term(pre.ib);
                    if (pt == (SI*)0) { continue; };
                    if (pt.op != SO_BR | pre.succs.len != 1) { continue; };
                    // the true edge enters the loop, the false edge leaves it
                    if (cb.t == (IRBlock*)0 | cb.f == (IRBlock*)0) { continue; };
                    if (body[((GB*)g.bl.items[cb.t.gi]).rpo] == 0 | body[((GB*)g.bl.items[cb.f.gi]).rpo] == 1) { continue; };
                    // values defined inside the loop
                    i = 0;
                    while (i < n)
                    {
                        if (body[i] == 1)
                        {
                            b = g.rpo[i];
                            if (b.ib.insts != (PtrVec*)0)
                            {
                                j = 0;
                                while (j < b.ib.insts.len)
                                {
                                    ins = (SI*)b.ib.insts.items[j];
                                    if (ins.res != (IRValue*)0) { ins.res.db = 1; };
                                    j++;
                                };
                            };
                        };
                        i++;
                    };
                    np = nb - 2;
                    ph = (SI*)0;
                    ad = (SI*)0;
                    ip = 0;
                    il = 1;
                    i = 0;
                    while (i < np & ph == (SI*)0)
                    {
                        ins = (SI*)hb.ib.insts.items[i];
                        i++;
                        if (ins.op != SO_PHI | ins.n != 2) { continue; };
                        iv = this.s_res(ins.res);
                        if (iv.ty.kind != LK.INT | iv.ty.width != 32) { continue; };
                        // the compare is iv < n or n > iv, signed
                        ivleft = this.s_res(cm.a) == iv;
                        if (ivleft) { if (cm.k != SP_SLT) { continue; }; n64 = this.s_res(cm.b); }
                        elif (this.s_res(cm.b) == iv) { if (cm.k != SP_SGT) { continue; }; n64 = this.s_res(cm.a); }
                        else { continue; };
                        if (n64.ty.kind != LK.INT | n64.ty.width != 32 | n64.db == 1) { continue; };
                        ip = 0;
                        il = 1;
                        if (ins.blks[0] != pre.ib) { ip = 1; il = 0; };
                        if (ins.blks[ip] != pre.ib) { continue; };
                        nx = this.s_res(ins.args[il]);
                        if (nx.di == (void*)0) { continue; };
                        ad = (SI*)nx.di;
                        if (ad.op != SO_BIN | ad.k != SB_ADD | this.s_res(ad.a) != iv) { ad = (SI*)0; continue; };
                        if (!this.s_cint(this.s_res(ad.b))) { ad = (SI*)0; continue; };
                        if (this.scv != (i64)1) { ad = (SI*)0; continue; };
                        if (nx.db != 1 | this.s_nuse(nx) != 1) { ad = (SI*)0; continue; };
                        // every use of the counter is the compare, the step or an index
                        ok = true;
                        nidx = 0;
                        ul = pv_new();
                        j = 0;
                        while (j < g.nb & ok)
                        {
                            b = g.rpo[j];
                            j++;
                            if (b.ib.insts == (PtrVec*)0) { continue; };
                            k = 0;
                            while (k < b.ib.insts.len & ok)
                            {
                                                                pt = (SI*)b.ib.insts.items[k];
                                k++;
                                nuse = this.s_nops(pt);
                                m = 0;
                                while (m < nuse)
                                {
                                    o = this.s_op(pt, m);
                                    if (o != (IRValue*)0)
                                    {
                                        if (this.s_res(o) == iv)
                                        {
                                            if (pt == cm | pt == ad) { }
                                            elif (pt.op == SO_GEP & m >= 1) { nidx++; pv_push(ul, (void*)pt); }
                                            elif (pt.op == SO_CAST & pt.k == SK_SEXT & pt.ty.kind == LK.INT & pt.ty.width == 64) { nidx++; pv_push(ul, (void*)pt); }
                                            else { ok = false; };
                                        };
                                    };
                                    m++;
                                };
                            };
                        };
                        if (!ok | nidx == 0) { pv_free(ul); ad = (SI*)0; continue; };
                        ph = ins;
                        pt = this.s_term(pre.ib);
                    };
                    if (ph == (SI*)0 | ad == (SI*)0) { continue; };
                    // build the wide counter
                    iv = this.s_res(ph.res);
                    if (this.s_res(cm.a) == iv) { n64 = this.s_res(cm.b); } else { n64 = this.s_res(cm.a); };
                    ivleft = this.s_res(cm.a) == iv;
                    a0 = this.s_res(ph.args[ip]);
                    pre.ib.insts.len = pre.ib.insts.len - 1;
                    this.cb = pre.ib;
                    if (this.s_cint(a0))
                    {
                        i64a = this.s_kint(t64, (u64)this.s_usx((u64)this.scv, 32));
                    }
                    else
                    {
                        i64a = this.new_value(t64, g"%vr\0");
                        this.s_r_castk(SK_SEXT, a0, t64, i64a);
                    };
                    if (this.s_cint(n64))
                    {
                        n64 = this.s_kint(t64, (u64)this.s_usx((u64)this.scv, 32));
                    }
                    else
                    {
                        nv = this.new_value(t64, g"%vr\0");
                        this.s_r_castk(SK_SEXT, n64, t64, nv);
                        n64 = nv;
                    };
                    pv_push(pre.ib.insts, (void*)pt);
                    lbk = ph.blks[il];
                    this.cb = hb.ib;
                    nph = this.s_uphi(t64, i64a, pre.ib, lbk);
                    hb.ib.insts.len = hb.ib.insts.len - 1;
                    this.s_vins(hb.ib.insts, np, (void*)nph);
                    // the step goes in front of the branch of the latch
                    pt = this.s_term(lbk);
                    lbk.insts.len = lbk.insts.len - 1;
                    this.cb = lbk;
                    nv = this.s_ubin(SB_ADD, nph.res, this.s_kint(t64, (u64)1));
                    pv_push(lbk.insts, (void*)pt);
                    nph.args[1] = nv;
                    // uses
                    if (ivleft) { cm.a = nph.res; cm.b = n64; } else { cm.b = nph.res; cm.a = n64; };
                    cm.ty = t64;
                    i = 0;
                    while (i < ul.len)
                    {
                        ins = (SI*)ul.items[i];
                        i++;
                        if (ins.op == SO_CAST)
                        {
                            this.s_res(ins.res).fwd = nph.res;
                            continue;
                        };
                        m = 1;
                        while (m <= ins.n)
                        {
                            if (this.s_res(this.s_op(ins, m)) == iv) { this.s_sop(ins, m, nph.res); };
                            m++;
                        };
                    };
                    this.s_ivw_del(hb.ib.insts, ph);
                    j = 0;
                    while (j < g.nb)
                    {
                        b = g.rpo[j];
                        j++;
                        if (b.ib.insts != (PtrVec*)0) { this.s_ivw_del(b.ib.insts, ad); };
                    };
                    pv_free(ul);
                    any = true;
                };
                this.s_ifree(body);
                this.s_ifree(stk);
                -> any;
            };

            // A 64 bit counter that steps by a constant and indexes an array whose elements are not 1, 2, 4 or 8 bytes
            // wide pays a multiply and an add for every address. The loop keeps a pointer that steps by the constant
            // instead and the address computations start from it with a zero index.
            s_sr() -> bool
            {
                GF* g = this.sf;
                int n = g.nb;
                bool any = false;
                bool found, ok;
                int h, i, j, k, m, top, nout, np, ip, il, nphi, pi, made;
                int stride;
                GB* hb; GB* b; GB* x; GB* pg; GB* pre;
                SI* ph; SI* ad; SI* ins; SI* pt; SI* nph; SI* lt;
                IRValue* iv; IRValue* nx; IRValue* base; IRValue* a0; IRValue* p0; IRValue* pn;
                IRValue** idx;
                IRBlock* lbk;
                IRType* t64;
                PtrVec* ul;
                int* body = this.s_iz(n + 1);
                int* stk = this.s_iz(n + 1);
                t64 = this.t_int(64);
                idx = (IRValue**)fmalloc((u64)16);
                h = n - 1;
                while (h >= 0)
                {
                    hb = g.rpo[h];
                    h--;
                    if (hb.preds.len != 2 | hb.ib.insts == (PtrVec*)0) { continue; };
                    // natural loop
                    i = 0;
                    while (i < n) { body[i] = 0; i++; };
                    found = false;
                    k = 0;
                    while (k < hb.preds.len)
                    {
                        pg = (GB*)hb.preds.items[k];
                        if (this.s_dominates(hb, pg))
                        {
                            found = true;
                            body[hb.rpo] = 1;
                            if (body[pg.rpo] == 0)
                            {
                                body[pg.rpo] = 1;
                                stk[0] = pg.rpo;
                                top = 1;
                                while (top > 0)
                                {
                                    top--;
                                    x = g.rpo[stk[top]];
                                    m = 0;
                                    while (m < x.preds.len)
                                    {
                                        b = (GB*)x.preds.items[m];
                                        if (body[b.rpo] == 0)
                                        {
                                            body[b.rpo] = 1;
                                            stk[top] = b.rpo;
                                            top++;
                                        };
                                        m++;
                                    };
                                };
                            };
                        };
                        k++;
                    };
                    if (!found) { continue; };
                    nout = 0;
                    pre = (GB*)0;
                    k = 0;
                    while (k < hb.preds.len)
                    {
                        pg = (GB*)hb.preds.items[k];
                        if (body[pg.rpo] == 0) { nout++; pre = pg; };
                        k++;
                    };
                    if (nout != 1) { continue; };
                    pt = this.s_term(pre.ib);
                    if (pt == (SI*)0) { continue; };
                    if (pt.op != SO_BR | pre.succs.len != 1) { continue; };
                    // values defined inside the loop
                    i = 0;
                    while (i < n)
                    {
                        if (body[i] == 1)
                        {
                            b = g.rpo[i];
                            if (b.ib.insts != (PtrVec*)0)
                            {
                                j = 0;
                                while (j < b.ib.insts.len)
                                {
                                    ins = (SI*)b.ib.insts.items[j];
                                    if (ins.res != (IRValue*)0) { ins.res.db = 1; };
                                    j++;
                                };
                            };
                        };
                        i++;
                    };
                    nphi = 0;
                    while (nphi < hb.ib.insts.len)
                    {
                        if (((SI*)hb.ib.insts.items[nphi]).op != SO_PHI) { break; };
                        nphi++;
                    };
                    made = 0;
                    pi = 0;
                    while (pi < nphi & made < 2)
                    {
                        ph = (SI*)hb.ib.insts.items[pi];
                        pi++;
                        if (ph.n != 2) { continue; };
                        iv = this.s_res(ph.res);
                        if (iv.ty.kind != LK.INT | iv.ty.width != 64) { continue; };
                        ip = 0;
                        il = 1;
                        if (ph.blks[0] != pre.ib) { ip = 1; il = 0; };
                        if (ph.blks[ip] != pre.ib) { continue; };
                        nx = this.s_res(ph.args[il]);
                        if (nx.di == (void*)0 | nx.db != 1) { continue; };
                        ad = (SI*)nx.di;
                        if (ad.op != SO_BIN | ad.k != SB_ADD | this.s_res(ad.a) != iv) { continue; };
                        if (!this.s_cint(this.s_res(ad.b))) { continue; };
                        // the first address computation that indexes by the counter
                        base = (IRValue*)0;
                        stride = 0;
                        ul = pv_new();
                        i = 0;
                        while (i < n)
                        {
                            if (body[i] == 1)
                            {
                                b = g.rpo[i];
                                if (b.ib.insts != (PtrVec*)0)
                                {
                                    j = 0;
                                    while (j < b.ib.insts.len)
                                    {
                                        ins = (SI*)b.ib.insts.items[j];
                                        j++;
                                        if (ins.op != SO_GEP | ins.n < 1) { continue; };
                                        if (this.s_res(ins.args[0]) != iv) { continue; };
                                        pn = this.s_res(ins.a);
                                        if (pn.db != 0 | pn.ty.kind != LK.PTR) { continue; };
                                        if (base == (IRValue*)0)
                                        {
                                            stride = this.a_size(pn.ty.elem);
                                            if (stride == 1 | stride == 2 | stride == 4 | stride == 8 | stride <= 0) { continue; };
                                            base = pn;
                                        };
                                        if (pn == base) { pv_push(ul, (void*)ins); };
                                    };
                                };
                            };
                            i++;
                        };
                        if (base == (IRValue*)0 | ul.len == 0) { pv_free(ul); continue; };
                        // the step in elements and the start
                        this.s_cint(this.s_res(ad.b));
                        idx[0] = this.s_kint(t64, (u64)this.scv);
                        a0 = this.s_res(ph.args[ip]);
                        pt = this.s_term(pre.ib);
                        pre.ib.insts.len = pre.ib.insts.len - 1;
                        this.cb = pre.ib;
                        if (this.s_cint(a0) & this.scv == (i64)0)
                        {
                            p0 = base;
                        }
                        else
                        {
                            p0 = this.new_value(base.ty, g"%vr\0");
                            idx[1] = a0;
                            this.s_r_gep(base, @idx[1], 1, p0);
                        };
                        pv_push(pre.ib.insts, (void*)pt);
                        lbk = ph.blks[il];
                        this.cb = hb.ib;
                        nph = this.s_uphi(base.ty, p0, pre.ib, lbk);
                        hb.ib.insts.len = hb.ib.insts.len - 1;
                        this.s_vins(hb.ib.insts, nphi, (void*)nph);
                        nphi++;
                        lt = this.s_term(lbk);
                        lbk.insts.len = lbk.insts.len - 1;
                        this.cb = lbk;
                        pn = this.new_value(base.ty, g"%vr\0");
                        this.s_r_gep(nph.res, @idx[0], 1, pn);
                        pv_push(lbk.insts, (void*)lt);
                        nph.args[1] = pn;
                        i = 0;
                        while (i < ul.len)
                        {
                            ins = (SI*)ul.items[i];
                            i++;
                            ins.a = nph.res;
                            ins.args[0] = this.s_kint(t64, (u64)0);
                        };
                        pv_free(ul);
                        made++;
                        any = true;
                    };
                    // forget the marks
                    i = 0;
                    while (i < n)
                    {
                        if (body[i] == 1)
                        {
                            b = g.rpo[i];
                            if (b.ib.insts != (PtrVec*)0)
                            {
                                j = 0;
                                while (j < b.ib.insts.len)
                                {
                                    ins = (SI*)b.ib.insts.items[j];
                                    if (ins.res != (IRValue*)0) { ins.res.db = 0; };
                                    j++;
                                };
                            };
                        };
                        i++;
                    };
                };
                ffree((byte*)idx);
                this.s_ifree(body);
                this.s_ifree(stk);
                -> any;
            };

            // Value of a at the width w as a signed number
            s_usx(u64 a, int w) -> i64
            {
                if (w >= 64) { -> (i64)a; };
                if (((a >> (u64)(w - 1)) `& (u64)1) != (u64)0) { -> (i64)(a | ((u64)0 - ((u64)1 << (u64)w))); };
                -> (i64)a;
            };

            // Integer compare predicate p over two values of width w
            s_upred(int p, u64 a, u64 b, int w) -> bool
            {
                i64 sa = this.s_usx(a, w);
                i64 sb = this.s_usx(b, w);
                if (p == SP_EQ) { -> a == b; };
                if (p == SP_NE) { -> a != b; };
                if (p == SP_ULT) { -> a < b; };
                if (p == SP_ULE) { -> a <= b; };
                if (p == SP_UGT) { -> a > b; };
                if (p == SP_UGE) { -> a >= b; };
                if (p == SP_SLT) { -> sa < sb; };
                if (p == SP_SLE) { -> sa <= sb; };
                if (p == SP_SGT) { -> sa > sb; };
                if (p == SP_SGE) { -> sa >= sb; };
                -> false;
            };

            // Operand v seen from the iteration being copied
            s_umap(IRValue* v) -> IRValue*
            {
                IRValue* r;
                if (v == (IRValue*)0) { -> v; };
                r = this.s_res(v);
                if (r.cl != (void*)0) { -> (IRValue*)r.cl; };
                -> r;
            };

            // A loop that counts an index by a constant from a constant start to a constant bound, whose body is one
            // block, and that runs a few times, is written out once per trip in the block in front of it:
            //     for (j = 0; j < 8; j++) { body }  becomes  body(0) body(1) ... body(7)
            // The header holds only phis, the compare and the branch. Returns true when a loop was replaced.
            s_unroll_one(GB* hb) -> bool
            {
                SI* ph; SI* cm; SI* cb; SI* x; SI* y; SI* ad; SI* pt; SI* ivp;
                GB* bb; GB* pr; GB* p0; GB* p1;
                IRValue* iv; IRValue* nx; IRValue* v; IRValue* nv; IRValue* bndv;
                IRBlock* eb;
                IRValue** cur; IRValue** nxt; IRValue** tv;
                PtrVec* touched;
                SI** phs;
                int np, nb, i, j, k, t, w, ip, il, trip, pred;
                u64 c0, step, ivv, bnd, lhs, rhs;
                bool ivleft, cont;
                if (hb.preds.len != 2) { -> false; };
                if (hb.ib.insts == (PtrVec*)0) { -> false; };
                nb = hb.ib.insts.len;
                if (nb < 3) { -> false; };
                cm = (SI*)hb.ib.insts.items[nb - 2];
                cb = (SI*)hb.ib.insts.items[nb - 1];
                if (cm.op != SO_CMP | cb.op != SO_CBR) { -> false; };
                if (cm.n != 0 | cb.k != 0) { -> false; };
                np = nb - 2;
                i = 0;
                while (i < np)
                {
                    ph = (SI*)hb.ib.insts.items[i];
                    if (ph.op != SO_PHI | ph.n != 2) { -> false; };
                    i++;
                };
                if (this.s_res(cb.a) != cm.res) { -> false; };
                if (this.s_nuse(cm.res) != 1) { -> false; };
                p0 = (GB*)hb.preds.items[0];
                p1 = (GB*)hb.preds.items[1];
                bb = p1;
                pr = p0;
                if (p0.preds.len == 1 & p0.succs.len == 1)
                {
                    if ((GB*)p0.preds.items[0] == hb) { bb = p0; pr = p1; };
                };
                if (bb.preds.len != 1 | bb.succs.len != 1) { -> false; };
                if ((GB*)bb.preds.items[0] != hb | (GB*)bb.succs.items[0] != hb) { -> false; };
                if (pr.succs.len != 1 | pr == hb | pr == bb) { -> false; };
                if (cb.t == bb.ib) { eb = cb.f; cont = true; }
                elif (cb.f == bb.ib) { eb = cb.t; cont = false; }
                else { -> false; };
                if (eb == hb.ib | eb == bb.ib) { -> false; };
                if (bb.ib.insts == (PtrVec*)0) { -> false; };
                // the index: a phi compared with a constant
                iv = (IRValue*)0;
                bndv = (IRValue*)0;
                ivleft = true;
                i = 0;
                while (i < np)
                {
                    ph = (SI*)hb.ib.insts.items[i];
                    if (this.s_res(cm.a) == ph.res) { iv = ph.res; ivp = ph; bndv = this.s_res(cm.b); ivleft = true; }
                    elif (this.s_res(cm.b) == ph.res) { iv = ph.res; ivp = ph; bndv = this.s_res(cm.a); ivleft = false; };
                    i++;
                };
                if (iv == (IRValue*)0) { -> false; };
                if (iv.ty.kind != LK.INT) { -> false; };
                w = iv.ty.width;
                if (w < 8 | w > 64) { -> false; };
                if (!this.s_cint(bndv)) { -> false; };
                bnd = (u64)this.scv;
                pred = cm.k;
                if (pred < SP_EQ | pred > SP_SGE) { -> false; };
                ip = 0;
                il = 1;
                if (ivp.blks[0] == bb.ib) { ip = 1; il = 0; };
                if (ivp.blks[ip] != pr.ib | ivp.blks[il] != bb.ib) { -> false; };
                if (!this.s_cint(this.s_res(ivp.args[ip]))) { -> false; };
                c0 = (u64)this.scv;
                nx = this.s_res(ivp.args[il]);
                // the increment: iv plus or minus a constant, in the body
                ad = (SI*)0;
                j = 0;
                while (j < bb.ib.insts.len)
                {
                    x = (SI*)bb.ib.insts.items[j];
                    if (x.res != (IRValue*)0) { if (this.s_res(x.res) == nx) { ad = x; }; };
                    j++;
                };
                if (ad == (SI*)0) { -> false; };
                if (ad.op != SO_BIN) { -> false; };
                if (ad.k != SB_ADD & ad.k != SB_SUB) { -> false; };
                if (this.s_res(ad.a) != iv) { -> false; };
                if (!this.s_cint(this.s_res(ad.b))) { -> false; };
                step = (u64)this.scv;
                if (ad.k == SB_SUB) { step = this.a_mask((u64)0 - step, w); };
                // how many times the body runs
                ivv = c0;
                trip = 0;
                while (trip <= 16)
                {
                    lhs = ivv;
                    rhs = bnd;
                    if (!ivleft) { lhs = bnd; rhs = ivv; };
                    if (this.s_upred(pred, lhs, rhs, w) != cont) { break; };
                    trip++;
                    ivv = this.a_mask(ivv + step, w);
                };
                if (trip < 1 | trip > 16) { -> false; };
                // the body: no phis, no allocations, ends in the jump back
                nb = bb.ib.insts.len;
                pt = (SI*)bb.ib.insts.items[nb - 1];
                if (pt.op != SO_BR | pt.t != hb.ib) { -> false; };
                j = 0;
                while (j < nb - 1)
                {
                    x = (SI*)bb.ib.insts.items[j];
                    if (x.op == SO_PHI | x.op == SO_ALLOCA | x.op == SO_ALLOCAN | x.op == SO_VAARG) { -> false; };
                    if (this.s_isterm(x)) { -> false; };
                    j++;
                };
                if (trip * (nb - 1) > 160) { -> false; };
                pt = (SI*)pr.ib.insts.items[pr.ib.insts.len - 1];
                if (pt.op != SO_BR | pt.t != hb.ib) { -> false; };
                // write the copies at the end of the block in front of the loop
                phs = (SI**)fmalloc((u64)(8 * (np + 1)));
                cur = (IRValue**)fmalloc((u64)(8 * (np + 1)));
                nxt = (IRValue**)fmalloc((u64)(8 * (np + 1)));
                i = 0;
                while (i < np)
                {
                    ph = (SI*)hb.ib.insts.items[i];
                    phs[i] = ph;
                    k = 0;
                    if (ph.blks[0] == bb.ib) { k = 1; };
                    cur[i] = this.s_res(ph.args[k]);
                    i++;
                };
                pr.ib.insts.len = pr.ib.insts.len - 1;
                this.cb = pr.ib;
                touched = pv_new();
                t = 0;
                while (t < trip)
                {
                    i = 0;
                    while (i < np)
                    {
                        v = this.s_res(phs[i].res);
                        v.cl = (void*)cur[i];
                        pv_push(touched, (void*)v);
                        i++;
                    };
                    j = 0;
                    while (j < nb - 1)
                    {
                        x = (SI*)bb.ib.insts.items[j];
                        if (x.res != (IRValue*)0)
                        {
                            v = this.s_res(x.res);
                            nv = this.new_value(v.ty, v.text);
                            nv.flags = v.flags;
                            nv.spec = v.spec;
                            nv.espec = v.espec;
                            nv.is_const = v.is_const;
                            v.cl = (void*)nv;
                            pv_push(touched, (void*)v);
                        };
                        j++;
                    };
                    j = 0;
                    while (j < nb - 1)
                    {
                        x = (SI*)bb.ib.insts.items[j];
                        y = this.s_new(x.op);
                        y.k = x.k;
                        y.n = x.n;
                        y.sz = x.sz;
                        y.bi = x.bi;
                        y.ty = x.ty;
                        y.vol = x.vol;
                        y.flag = x.flag;
                        y.pos = x.pos;
                        if (x.op == SO_CALL) { y.flag = false; };
                        y.res = this.s_umap(x.res);
                        y.a = this.s_umap(x.a);
                        y.b = this.s_umap(x.b);
                        y.c = this.s_umap(x.c);
                        if (x.op == SO_GEP | x.op == SO_CALL)
                        {
                            tv = (IRValue**)fmalloc((u64)(8 * (x.n + 1)));
                            k = 0;
                            while (k < x.n) { tv[k] = this.s_umap(x.args[k]); k++; };
                            y.args = this.s_cpv(tv, x.n);
                            ffree((byte*)tv);
                        };
                        this.s_push(y);
                        j++;
                    };
                    i = 0;
                    while (i < np)
                    {
                        k = 1;
                        if (phs[i].blks[0] == bb.ib) { k = 0; };
                        nxt[i] = this.s_umap(phs[i].args[k]);
                        i++;
                    };
                    i = 0;
                    while (i < touched.len)
                    {
                        ((IRValue*)touched.items[i]).cl = (void*)0;
                        i++;
                    };
                    touched.len = 0;
                    i = 0;
                    while (i < np) { cur[i] = nxt[i]; i++; };
                    t++;
                };
                pv_free(touched);
                // after the last trip the phis stand for the values that came out of it
                i = 0;
                while (i < np)
                {
                    v = this.s_res(phs[i].res);
                    if (cur[i] != v) { v.fwd = cur[i]; };
                    i++;
                };
                pt.t = eb;
                pv_push(pr.ib.insts, (void*)pt);
                this.s_rephi(pt, hb.ib, pr.ib);
                ffree((byte*)phs);
                ffree((byte*)cur);
                ffree((byte*)nxt);
                -> true;
            };

            // Writes out the short counted loops of the function. Returns true when a loop was replaced.
            s_unroll() -> bool
            {
                GF* g = this.sf;
                bool any = false;
                bool again = true;
                int i;
                GB* gb;
                while (again)
                {
                    again = false;
                    i = 1;
                    while (i < g.nb)
                    {
                        gb = (GB*)g.bl.items[i];
                        if (this.s_unroll_one(gb))
                        {
                            any = true;
                            again = true;
                            if (!this.s_recfg()) { -> any; };
                            break;
                        };
                        i++;
                    };
                };
                -> any;
            };


            // A new binary instruction of kind k in the block being written
            s_ubin(int k, IRValue* a, IRValue* b) -> IRValue*
            {
                SI* y = this.s_new(SO_BIN);
                IRValue* r = this.new_value(a.ty, g"%vr\0");
                y.k = k;
                y.a = a;
                y.b = b;
                y.ty = a.ty;
                y.res = r;
                this.s_push(y);
                -> r;
            };

            // A new cast of kind k (SK_*) of v to the type to, its result r, in the block being written
            s_r_castk(int k, IRValue* v, IRType* to, IRValue* r) -> void
            {
                SI* x = this.s_new(SO_CAST);
                x.k = k;
                x.a = v;
                x.res = r;
                x.ty = to;
                this.s_push(x);
                ->;
            };

            // A new integer compare with the predicate p, its result of type rt
            s_ucmp(int p, IRValue* a, IRValue* b, IRType* rt) -> IRValue*
            {
                SI* y = this.s_new(SO_CMP);
                IRValue* r = this.new_value(rt, g"%vr\0");
                y.n = 0;
                y.k = p;
                y.a = a;
                y.b = b;
                y.ty = a.ty;
                y.res = r;
                this.s_push(y);
                -> r;
            };

            // A phi of two incoming values, the second one is filled in later
            s_uphi(IRType* ty, IRValue* v0, IRBlock* b0, IRBlock* b1) -> SI*
            {
                SI* y = this.s_new(SO_PHI);
                IRValue** tv = (IRValue**)fmalloc((u64)(8 * 3));
                IRBlock** tb = (IRBlock**)fmalloc((u64)(8 * 3));
                tv[0] = v0;
                tv[1] = v0;
                tb[0] = b0;
                tb[1] = b1;
                y.n = 2;
                y.args = this.s_cpv(tv, 2);
                y.blks = this.s_cpb(tb, 2);
                y.ty = ty;
                y.res = this.new_value(ty, g"%vr\0");
                this.s_push(y);
                ffree((byte*)tv);
                ffree((byte*)tb);
                -> y;
            };

            // Number of operand uses of v by the instructions of block b
            s_usesin(IRBlock* b, IRValue* v) -> int
            {
                int j, k;
                int c = 0;
                SI* x;
                j = 0;
                while (j < b.insts.len)
                {
                    x = (SI*)b.insts.items[j];
                    if (x.op != 0)
                    {
                        if (x.a != (IRValue*)0) { if (this.s_res(x.a) == v) { c++; }; };
                        if (x.b != (IRValue*)0) { if (this.s_res(x.b) == v) { c++; }; };
                        if (x.c != (IRValue*)0) { if (this.s_res(x.c) == v) { c++; }; };
                        if (x.op == SO_GEP | x.op == SO_CALL | x.op == SO_PHI)
                        {
                            k = 0;
                            while (k < x.n) { if (this.s_res(x.args[k]) == v) { c++; }; k++; };
                        };
                    };
                    j++;
                };
                -> c;
            };

            // Copies the first cnt instructions of block src except skip to the block being written, with the
            // operand mapping the cl fields of the values give. Values listed in touched get their cl cleared by
            // the caller.
            s_ubody(IRBlock* src, int cnt, SI* skip, PtrVec* touched) -> void
            {
                SI* x;
                SI* y;
                IRValue* v;
                IRValue* nv;
                IRValue** tv;
                int j, k;
                j = 0;
                while (j < cnt)
                {
                    x = (SI*)src.insts.items[j];
                    if (x != skip & x.res != (IRValue*)0)
                    {
                        v = this.s_res(x.res);
                        nv = this.new_value(v.ty, v.text);
                        nv.flags = v.flags;
                        nv.spec = v.spec;
                        nv.espec = v.espec;
                        nv.is_const = v.is_const;
                        v.cl = (void*)nv;
                        pv_push(touched, (void*)v);
                    };
                    j++;
                };
                j = 0;
                while (j < cnt)
                {
                    x = (SI*)src.insts.items[j];
                    if (x != skip)
                    {
                        y = this.s_new(x.op);
                        y.k = x.k;
                        y.n = x.n;
                        y.sz = x.sz;
                        y.bi = x.bi;
                        y.ty = x.ty;
                        y.vol = x.vol;
                        y.flag = x.flag;
                        y.pos = x.pos;
                        y.res = this.s_umap(x.res);
                        y.a = this.s_umap(x.a);
                        y.b = this.s_umap(x.b);
                        y.c = this.s_umap(x.c);
                        if (x.op == SO_GEP)
                        {
                            tv = (IRValue**)fmalloc((u64)(8 * (x.n + 1)));
                            k = 0;
                            while (k < x.n) { tv[k] = this.s_umap(x.args[k]); k++; };
                            y.args = this.s_cpv(tv, x.n);
                            ffree((byte*)tv);
                        };
                        this.s_push(y);
                    };
                    j++;
                };
                ->;
            };

            // A counted loop  for (i = s; i < n; i++) { body }  whose loop carried values besides the index are sums
            // (acc = acc + e, also or / xor) runs four trips per round in front of the original loop, which then
            // only handles the last few. The sum of each trip goes to its own accumulator, so the additions of
            // consecutive trips no longer wait for each other; the accumulators meet when the rounds are done.
            // The body keeps its order of loads and stores. Returns true when a loop was changed.
            s_vred_one(GB* hb) -> bool
            {
                SI* ph; SI* cm; SI* cb; SI* x; SI* ad; SI* pt; SI* ivp; SI* u; SI* kph; SI* ivph;
                SI** rph; SI** radd;
                GB* bb; GB* pr; GB* p0; GB* p1;
                IRValue* iv; IRValue* nx; IRValue* n; IRValue* s0; IRValue* zero; IRValue* c1; IRValue* v; IRValue* lt;
                IRValue* diff; IRValue* rem; IRValue* k0; IRValue* knz; IRValue* ivn; IRValue* k1; IRValue* t1; IRValue* t2;
                IRValue* tot; IRValue* nr; IRValue* ivt; IRValue* four;
                IRValue** nacc;
                IRBlock* eb; IRBlock* uh; IRBlock* ub; IRBlock* ux;
                PtrVec* touched;
                SI** aph;
                int np, nr_, nb, i, j, k, t, w, ip, il, ci, gcnt, mm;
                bool wide;
                IRType* t64;
                IRValue* s0w; IRValue* ivtr;
                if (hb.preds.len != 2) { -> false; };
                if (hb.ib.insts == (PtrVec*)0) { -> false; };
                nb = hb.ib.insts.len;
                if (nb < 3) { -> false; };
                cm = (SI*)hb.ib.insts.items[nb - 2];
                cb = (SI*)hb.ib.insts.items[nb - 1];
                if (cm.op != SO_CMP | cb.op != SO_CBR) { -> false; };
                if (cm.n != 0 | cb.k != 0) { -> false; };
                if (cm.k != SP_ULT & cm.k != SP_SLT) { -> false; };
                np = nb - 2;
                i = 0;
                while (i < np)
                {
                    ph = (SI*)hb.ib.insts.items[i];
                    if (ph.op != SO_PHI | ph.n != 2) { -> false; };
                    if (ph.res.ty.kind != LK.INT) { -> false; };
                    i++;
                };
                if (this.s_res(cb.a) != cm.res) { -> false; };
                if (this.s_nuse(cm.res) != 1) { -> false; };
                p0 = (GB*)hb.preds.items[0];
                p1 = (GB*)hb.preds.items[1];
                bb = p1;
                pr = p0;
                if (p0.preds.len == 1 & p0.succs.len == 1)
                {
                    if ((GB*)p0.preds.items[0] == hb) { bb = p0; pr = p1; };
                };
                if (bb.preds.len != 1 | bb.succs.len != 1) { -> false; };
                if ((GB*)bb.preds.items[0] != hb | (GB*)bb.succs.items[0] != hb) { -> false; };
                if (pr.succs.len != 1 | pr == hb | pr == bb) { -> false; };
                if (cb.t != bb.ib) { -> false; };
                eb = cb.f;
                if (eb == hb.ib | eb == bb.ib) { -> false; };
                if (bb.ib.insts == (PtrVec*)0) { -> false; };
                nr_ = bb.ib.insts.len;
                if (nr_ < 2 | nr_ > 25) { -> false; };
                // the index: iv < n, n from outside the loop
                ivp = (SI*)0;
                i = 0;
                while (i < np)
                {
                    ph = (SI*)hb.ib.insts.items[i];
                    if (this.s_res(cm.a) == ph.res) { ivp = ph; };
                    i++;
                };
                if (ivp == (SI*)0) { -> false; };
                iv = ivp.res;
                w = iv.ty.width;
                if (w != 32 & w != 64) { -> false; };
                n = this.s_res(cm.b);
                if (n.ty.kind != LK.INT | n.ty.width != w) { -> false; };
                if (this.s_defin(n, hb.ib, bb.ib)) { -> false; };
                ip = 0;
                il = 1;
                if (ivp.blks[0] == bb.ib) { ip = 1; il = 0; };
                if (ivp.blks[ip] != pr.ib | ivp.blks[il] != bb.ib) { -> false; };
                s0 = this.s_res(ivp.args[ip]);
                nx = this.s_res(ivp.args[il]);
                ad = (SI*)0;
                j = 0;
                while (j < nr_)
                {
                    x = (SI*)bb.ib.insts.items[j];
                    if (x.res != (IRValue*)0) { if (this.s_res(x.res) == nx) { ad = x; }; };
                    j++;
                };
                if (ad == (SI*)0) { -> false; };
                if (ad.op != SO_BIN | ad.k != SB_ADD) { -> false; };
                if (this.s_res(ad.a) != iv) { -> false; };
                if (!this.s_cint(this.s_res(ad.b))) { -> false; };
                if (this.scv != (i64)1) { -> false; };
                if (this.s_nuse(nx) != 1) { -> false; };
                // the body: straight line, no calls
                pt = (SI*)bb.ib.insts.items[nr_ - 1];
                if (pt.op != SO_BR | pt.t != hb.ib) { -> false; };
                j = 0;
                while (j < nr_ - 1)
                {
                    x = (SI*)bb.ib.insts.items[j];
                    if (x.op == SO_PHI | x.op == SO_ALLOCA | x.op == SO_ALLOCAN | x.op == SO_VAARG | x.op == SO_CALL) { -> false; };
                    if (this.s_isterm(x)) { -> false; };
                    j++;
                };
                // every other phi is a sum
                rph = (SI**)fmalloc((u64)(8 * (np + 1)));
                radd = (SI**)fmalloc((u64)(8 * (np + 1)));
                nacc = (IRValue**)fmalloc((u64)(8 * (np * 4 + 1)));
                aph = (SI**)fmalloc((u64)(8 * (np * 4 + 1)));
                ci = 0;
                i = 0;
                while (i < np)
                {
                    ph = (SI*)hb.ib.insts.items[i];
                    if (ph != ivp)
                    {
                        k = 1;
                        if (ph.blks[0] == bb.ib) { k = 0; };
                        if (ph.blks[1 - k] != pr.ib | ph.blks[k] != bb.ib) { ffree((byte*)rph); ffree((byte*)radd); ffree((byte*)nacc); ffree((byte*)aph); -> false; };
                        nr = this.s_res(ph.args[k]);
                        u = (SI*)0;
                        j = 0;
                        while (j < nr_)
                        {
                            x = (SI*)bb.ib.insts.items[j];
                            if (x.res != (IRValue*)0) { if (this.s_res(x.res) == nr) { u = x; }; };
                            j++;
                        };
                        if (u == (SI*)0) { ffree((byte*)rph); ffree((byte*)radd); ffree((byte*)nacc); ffree((byte*)aph); -> false; };
                        if (u.op != SO_BIN | (u.k != SB_ADD & u.k != SB_OR & u.k != SB_XOR)) { ffree((byte*)rph); ffree((byte*)radd); ffree((byte*)nacc); ffree((byte*)aph); -> false; };
                        if (this.s_res(u.a) != ph.res & this.s_res(u.b) != ph.res) { ffree((byte*)rph); ffree((byte*)radd); ffree((byte*)nacc); ffree((byte*)aph); -> false; };
                        if (this.s_res(u.a) == ph.res & this.s_res(u.b) == ph.res) { ffree((byte*)rph); ffree((byte*)radd); ffree((byte*)nacc); ffree((byte*)aph); -> false; };
                        if (this.s_usesin(bb.ib, ph.res) != 1 | this.s_nuse(nr) != 1) { ffree((byte*)rph); ffree((byte*)radd); ffree((byte*)nacc); ffree((byte*)aph); -> false; };
                        rph[ci] = ph;
                        radd[ci] = u;
                        ci++;
                    };
                    i++;
                };
                // when the index only addresses memory it is kept as a 64 bit value: the rounds cannot wrap it
                wide = false;
                if (SSA_OPT_IVW == 1 & w == 32 & cm.k == SP_SLT)
                {
                    gcnt = 0;
                    j = 0;
                    while (j < nr_ - 1)
                    {
                        x = (SI*)bb.ib.insts.items[j];
                        if (x.op == SO_GEP)
                        {
                            mm = 0;
                            while (mm < x.n) { if (this.s_res(x.args[mm]) == iv) { gcnt++; }; mm++; };
                        };
                        j++;
                    };
                    if (gcnt > 0 & this.s_nuse(iv) == gcnt + 2) { wide = true; };
                };
                // the code in front: how many rounds of four fit
                pt = (SI*)pr.ib.insts.items[pr.ib.insts.len - 1];
                if (pt.op != SO_BR | pt.t != hb.ib) { ffree((byte*)rph); ffree((byte*)radd); ffree((byte*)nacc); ffree((byte*)aph); -> false; };
                pr.ib.insts.len = pr.ib.insts.len - 1;
                this.cb = pr.ib;
                zero = this.s_kint(iv.ty, (u64)0);
                lt = this.s_ucmp(cm.k, s0, n, cm.res.ty);
                diff = this.s_ubin(SB_SUB, n, s0);
                rem = this.new_value(iv.ty, g"%vr\0");
                u = this.s_new(SO_SELECT);
                u.a = lt;
                u.b = diff;
                u.c = zero;
                u.ty = iv.ty;
                u.res = rem;
                this.s_push(u);
                k0 = this.s_ubin(SB_LSHR, rem, this.s_kint(iv.ty, (u64)2));
                t64 = this.t_int(64);
                s0w = s0;
                if (wide)
                {
                    if (this.s_cint(s0)) { s0w = this.s_kint(t64, (u64)this.s_usx((u64)this.scv, 32)); }
                    else
                    {
                        s0w = this.new_value(t64, g"%vr\0");
                        this.s_r_castk(SK_SEXT, s0, t64, s0w);
                    };
                };
                uh = this.append_block(this.cf, g"vr.head\0");
                ub = this.append_block(this.cf, g"vr.body\0");
                ux = this.append_block(this.cf, g"vr.exit\0");
                pt.t = uh;
                pv_push(pr.ib.insts, (void*)pt);
                // the head of the rounds: rounds left, index, four accumulators per sum
                this.cb = uh;
                kph = this.s_uphi(iv.ty, k0, pr.ib, ub);
                if (wide) { ivph = this.s_uphi(t64, s0w, pr.ib, ub); }
                else { ivph = this.s_uphi(iv.ty, s0, pr.ib, ub); };
                i = 0;
                while (i < ci)
                {
                    k = 1;
                    if (rph[i].blks[0] == bb.ib) { k = 0; };
                    v = this.s_res(rph[i].args[1 - k]);
                    aph[i * 4] = this.s_uphi(iv.ty, v, pr.ib, ub);
                    j = 1;
                    while (j < 4) { aph[i * 4 + j] = this.s_uphi(iv.ty, zero, pr.ib, ub); j++; };
                    i++;
                };
                knz = this.s_ucmp(SP_NE, kph.res, zero, cm.res.ty);
                this.s_r_cbr(knz, ub, ux);
                // four trips of the body
                this.cb = ub;
                touched = pv_new();
                t = 0;
                while (t < 4)
                {
                    ivt = ivph.res;
                    if (t > 0)
                    {
                        if (wide) { ivt = this.s_ubin(SB_ADD, ivph.res, this.s_kint(t64, (u64)t)); }
                        else { ivt = this.s_ubin(SB_ADD, ivph.res, this.s_kint(iv.ty, (u64)t)); };
                    };
                    v = this.s_res(iv);
                    v.cl = (void*)ivt;
                    pv_push(touched, (void*)v);
                    i = 0;
                    while (i < ci)
                    {
                        v = this.s_res(rph[i].res);
                        v.cl = (void*)aph[i * 4 + t].res;
                        pv_push(touched, (void*)v);
                        i++;
                    };
                    this.s_ubody(bb.ib, nr_ - 1, ad, touched);
                    i = 0;
                    while (i < ci)
                    {
                        k = 1;
                        if (rph[i].blks[0] == bb.ib) { k = 0; };
                        nacc[i * 4 + t] = this.s_umap(rph[i].args[k]);
                        i++;
                    };
                    i = 0;
                    while (i < touched.len) { ((IRValue*)touched.items[i]).cl = (void*)0; i++; };
                    touched.len = 0;
                    t++;
                };
                pv_free(touched);
                if (wide) { four = this.s_kint(t64, (u64)4); } else { four = this.s_kint(iv.ty, (u64)4); };
                ivn = this.s_ubin(SB_ADD, ivph.res, four);
                k1 = this.s_ubin(SB_SUB, kph.res, this.s_kint(iv.ty, (u64)1));
                this.s_r_br(uh);
                kph.args[1] = k1;
                ivph.args[1] = ivn;
                i = 0;
                while (i < ci)
                {
                    j = 0;
                    while (j < 4) { aph[i * 4 + j].args[1] = nacc[i * 4 + j]; j++; };
                    i++;
                };
                // when the rounds are done the sums meet and the original loop takes over
                this.cb = ux;
                i = 0;
                while (i < ci)
                {
                    k = radd[i].k;
                    t1 = this.s_ubin(k, aph[i * 4].res, aph[i * 4 + 1].res);
                    t2 = this.s_ubin(k, aph[i * 4 + 2].res, aph[i * 4 + 3].res);
                    tot = this.s_ubin(k, t1, t2);
                    k = 1;
                    if (rph[i].blks[0] == bb.ib) { k = 0; };
                    rph[i].blks[1 - k] = ux;
                    rph[i].args[1 - k] = tot;
                    i++;
                };
                ivp.blks[ip] = ux;
                if (wide)
                {
                    ivtr = this.new_value(iv.ty, g"%vr\0");
                    this.s_r_castk(SK_TRUNC, ivph.res, iv.ty, ivtr);
                    ivp.args[ip] = ivtr;
                }
                else { ivp.args[ip] = ivph.res; };
                this.s_r_br(hb.ib);
                ffree((byte*)rph);
                ffree((byte*)radd);
                ffree((byte*)nacc);
                ffree((byte*)aph);
                -> true;
            };

            // Runs s_vred_one over the loops of the function. Returns true when a loop was changed.
            s_vred() -> bool
            {
                GF* g = this.sf;
                bool any = false;
                int i, n0;
                GB* gb;
                n0 = g.nb;
                i = 1;
                while (i < n0)
                {
                    gb = (GB*)g.bl.items[i];
                    if (this.s_vred_one(gb)) { any = true; };
                    i++;
                };
                -> any;
            };

            // Block fill of an array: the value over count elements
            s_isel_fill(SI* x) -> void
            {
                IRValue* cv = this.s_res(x.c);
                MO* a0;
                MO* a1;
                int r, t1, t2, t3, sh;
                MI* m;
                a0 = this.s_src(x.a);
                if (x.op == SO_COPY | x.sz == 1) { a1 = this.s_src(x.b); } else { a1 = this.s_mo_i((i64)0); };
                r = this.s_reg(cv);
                if (cv.ty.width < 64) { r = this.s_ext(r, 4, x.k == 1, 8); };
                if (x.k == 1)
                {
                    // a negative count stores nothing
                    t1 = this.s_nv(0);
                    this.s_mi3c(M_SHIFT, 8, this.s_mo_r(r, 8), this.s_mo_i((i64)63), this.s_mo_r(t1, 8), S_SAR);
                    t2 = this.s_nv(0);
                    m = this.s_mi2(M_UN, 8, this.s_mo_r(t1, 8), this.s_mo_r(t2, 8));
                    m.cc = U_NOT;
                    t3 = this.s_nv(0);
                    this.s_mi3c(M_ALU, 8, this.s_mo_r(r, 8), this.s_mo_r(t2, 8), this.s_mo_r(t3, 8), A_AND);
                    r = t3;
                };
                sh = this.s_pow2((i64)x.sz);
                if (sh > 0)
                {
                    t1 = this.s_nv(0);
                    this.s_mi3c(M_SHIFT, 8, this.s_mo_r(r, 8), this.s_mo_i((i64)sh), this.s_mo_r(t1, 8), S_SHL);
                    r = t1;
                };
                if (x.op == SO_COPY)
                {
                    this.s_mov(a0, 7, 8);
                    this.s_mov(a1, 6, 8);
                    this.s_mov(this.s_mo_r(r, 8), 1, 8);
                    m = this.s_mi(M_REPMOVS, 1);
                    m.iu = 194;
                    m.id = 194;
                    ->;
                };
                this.s_mov(a0, 7, 8);
                this.s_mov(this.s_mo_r(r, 8), 1, 8);
                this.s_mov(a1, 0, 4);
                m = this.s_mi(M_REPSTOS, 1);
                m.iu = 131;
                m.id = 131;
                ->;
            };


            // Loop invariant code motion. A computation that is free of side effects and cannot trap, and whose operands
            // are all defined outside the loop (or already moved out), runs once in the block in front of the loop
            // instead of in every iteration. Only loops entered from one block that ends in a plain jump to the header
            // are handled, and at most eight computations leave a loop to keep register pressure in check.
            s_licm() -> bool
            {
                GF* g = this.sf;
                int n = g.nb;
                bool any = false;
                bool changed, found;
                int h, i, j, k, m, top, nout, outi, moved, nld;
                bool loopro, isld;
                GB* hb;
                GB* b;
                GB* x;
                GB* pg;
                GB* pre;
                SI* t;
                SI* ins;
                IRValue* v;
                int* body = this.s_iz(n + 1);
                int* stk = this.s_iz(n + 1);
                h = n - 1;
                while (h >= 0)
                {
                    hb = g.rpo[h];
                    // natural loop of the back edges into hb
                    i = 0;
                    while (i < n) { body[i] = 0; i++; };
                    found = false;
                    k = 0;
                    while (k < hb.preds.len)
                    {
                        pg = (GB*)hb.preds.items[k];
                        if (this.s_dominates(hb, pg))
                        {
                            found = true;
                            body[hb.rpo] = 1;
                            if (body[pg.rpo] == 0)
                            {
                                body[pg.rpo] = 1;
                                stk[0] = pg.rpo;
                                top = 1;
                                while (top > 0)
                                {
                                    top--;
                                    x = g.rpo[stk[top]];
                                    m = 0;
                                    while (m < x.preds.len)
                                    {
                                        b = (GB*)x.preds.items[m];
                                        if (body[b.rpo] == 0)
                                        {
                                            body[b.rpo] = 1;
                                            stk[top] = b.rpo;
                                            top++;
                                        };
                                        m++;
                                    };
                                };
                            };
                        };
                        k++;
                    };
                    if (found)
                    {
                        // the one block outside the loop that jumps to the header
                        nout = 0;
                        pre = (GB*)0;
                        k = 0;
                        while (k < hb.preds.len)
                        {
                            pg = (GB*)hb.preds.items[k];
                            if (body[pg.rpo] == 0) { nout++; pre = pg; };
                            k++;
                        };
                        if (nout == 1)
                        {
                            t = this.s_term(pre.ib);
                            if (t != (SI*)0)
                            {
                                if (t.op == SO_BR & pre.succs.len == 1)
                                {
                                    // values defined inside the loop
                                    i = 0;
                                    while (i < n)
                                    {
                                        if (body[i] == 1)
                                        {
                                            b = g.rpo[i];
                                            if (b.ib.insts != (PtrVec*)0)
                                            {
                                                j = 0;
                                                while (j < b.ib.insts.len)
                                                {
                                                    ins = (SI*)b.ib.insts.items[j];
                                                    if (ins.res != (IRValue*)0) { ins.res.db = 1; };
                                                    j++;
                                                };
                                            };
                                        };
                                        i++;
                                    };
                                    // a loop that writes no memory and calls nothing reads the same bytes every trip
                                    loopro = SSA_OPT_LDHOIST == 1;
                                    i = 0;
                                    while (i < n & loopro)
                                    {
                                        if (body[i] == 1)
                                        {
                                            b = g.rpo[i];
                                            if (b.ib.insts != (PtrVec*)0)
                                            {
                                                j = 0;
                                                while (j < b.ib.insts.len)
                                                {
                                                    ins = (SI*)b.ib.insts.items[j];
                                                    if (ins.op == SO_STORE | ins.op == SO_CALL | ins.op == SO_COPY | ins.op == SO_FILL | ins.op == SO_VAARG) { loopro = false; };
                                                    j++;
                                                };
                                            };
                                        };
                                        i++;
                                    };
                                    nld = 0;
                                    moved = 0;
                                    changed = true;
                                    while (changed & moved < 8)
                                    {
                                        changed = false;
                                        i = 0;
                                        while (i < n & moved < 8)
                                        {
                                            if (body[i] == 1)
                                            {
                                                b = g.rpo[i];
                                                if (b.ib.insts != (PtrVec*)0)
                                                {
                                                    j = 0;
                                                    while (j < b.ib.insts.len - 1 & moved < 8)
                                                    {
                                                        ins = (SI*)b.ib.insts.items[j];
                                                        isld = false;
                                                        if (loopro & ins.op == SO_LOAD & nld < 4 & ins.res != (IRValue*)0 & !ins.vol)
                                                        {
                                                            // only loads of the header qualify, those already run on every entry, a load from deeper in the body would be a net loss for loops that rarely repeat
                                                            if (this.s_scalar(ins.res.ty))
                                                            {
                                                                v = this.s_res(ins.a);
                                                                if (b == hb) { isld = true; };
                                                            };
                                                        };
                                                        if (isld | (SSA_OPT_LICM == 1 & this.s_spec_ok(ins) & ins.op != SO_SELECT & ins.op != SO_GEP))
                                                        {
                                                            found = true;
                                                            m = 0;
                                                            k = this.s_nops(ins);
                                                            while (m < k)
                                                            {
                                                                v = this.s_res(this.s_op(ins, m));
                                                                if (v.db != 0) { found = false; };
                                                                m++;
                                                            };
                                                            if (found)
                                                            {
                                                                // move it in front of the jump into the loop
                                                                ins.res.db = 0;
                                                                if (isld) { nld++; };
                                                                m = j;
                                                                while (m < b.ib.insts.len - 1)
                                                                {
                                                                    b.ib.insts.items[m] = b.ib.insts.items[m + 1];
                                                                    m++;
                                                                };
                                                                b.ib.insts.len = b.ib.insts.len - 1;
                                                                pre.ib.insts.len = pre.ib.insts.len - 1;
                                                                pv_push(pre.ib.insts, (void*)ins);
                                                                pv_push(pre.ib.insts, (void*)t);
                                                                moved++;
                                                                changed = true;
                                                                any = true;
                                                                j--;
                                                            };
                                                        };
                                                        j++;
                                                    };
                                                };
                                            };
                                            i++;
                                        };
                                    };
                                    // forget the marks
                                    i = 0;
                                    while (i < n)
                                    {
                                        if (body[i] == 1)
                                        {
                                            b = g.rpo[i];
                                            if (b.ib.insts != (PtrVec*)0)
                                            {
                                                j = 0;
                                                while (j < b.ib.insts.len)
                                                {
                                                    ins = (SI*)b.ib.insts.items[j];
                                                    if (ins.res != (IRValue*)0) { ins.res.db = 0; };
                                                    j++;
                                                };
                                            };
                                        };
                                        i++;
                                    };
                                };
                            };
                        };
                    };
                    h--;
                };
                this.s_ifree(body);
                this.s_ifree(stk);
                -> any;
            };


            // The phis of the successors of the terminator t that came in from block oldb now come in from block newb
            s_rephi(SI* t, IRBlock* oldb, IRBlock* newb) -> void
            {
                IRBlock** sv = this.sbuf(t.n + 2);
                int ns = this.s_succ(t, sv);
                int i, j, k;
                IRBlock* sb;
                SI* x;
                i = 0;
                while (i < ns)
                {
                    sb = sv[i];
                    if (sb.insts != (PtrVec*)0)
                    {
                        j = 0;
                        while (j < sb.insts.len)
                        {
                            x = (SI*)sb.insts.items[j];
                            if (x.op != SO_PHI) { break; };
                            k = 0;
                            while (k < x.n)
                            {
                                if (x.blks[k] == oldb) { x.blks[k] = newb; };
                                k++;
                            };
                            j++;
                        };
                    };
                    i++;
                };
                ->;
            };

            // A block that ends in a jump to a block nothing else reaches absorbs it. Longer blocks let the
            // selection fuse a compare with the branch or select that reads it, and drop the jump.
            // Returns true when something changed.
            s_merge() -> bool
            {
                GF* g = this.sf;
                bool any = false;
                int i, j;
                GB* gp;
                GB* gm;
                IRBlock* mb;
                SI* t;
                SI* mt;
                SI* first;
                i = 0;
                while (i < g.nb)
                {
                    gp = (GB*)g.bl.items[i];
                    t = this.s_term(gp.ib);
                    while (t != (SI*)0)
                    {
                        if (t.op != SO_BR) { break; };
                        mb = t.t;
                        if (mb.gi < 1 | mb == gp.ib) { break; };
                        gm = this.s_gb(mb);
                        if (gm == (GB*)0) { break; };
                        if (gm.preds.len != 1) { break; };
                        if (mb.insts == (PtrVec*)0) { break; };
                        if (mb.insts.len == 0) { break; };
                        first = (SI*)mb.insts.items[0];
                        if (first.op == SO_PHI) { break; };
                        mt = this.s_term(mb);
                        if (mt == (SI*)0) { break; };
                        // phis after the merged block that named it now name the block that absorbed it
                        this.s_rephi(mt, mb, gp.ib);
                        gp.ib.insts.len = gp.ib.insts.len - 1;
                        j = 0;
                        while (j < mb.insts.len) { pv_push(gp.ib.insts, mb.insts.items[j]); j++; };
                        mb.insts.len = 0;
                        // the absorbed block's own successors are now reached from this block
                        gm.preds.len = 0;
                        any = true;
                        t = mt;
                    };
                    i++;
                };
                -> any;
            };


            // Number of operands of instructions other than a and b that read v
            s_nuse(IRValue* v, SI* a, SI* b) -> int
            {
                GF* g = this.sf;
                int i, j, k, n, cnt;
                GB* gb;
                SI* x;
                cnt = 0;
                i = 0;
                while (i < g.nb)
                {
                    gb = (GB*)g.bl.items[i];
                    if (gb.ib.insts != (PtrVec*)0)
                    {
                        j = 0;
                        while (j < gb.ib.insts.len)
                        {
                            x = (SI*)gb.ib.insts.items[j];
                            if (x != a & x != b)
                            {
                                n = this.s_nops(x);
                                k = 0;
                                while (k < n)
                                {
                                    if (this.s_res(this.s_op(x, k)) == v) { cnt++; };
                                    k++;
                                };
                            };
                            j++;
                        };
                    };
                    i++;
                };
                -> cnt;
            };

            // Relation sets of an integer predicate over (less, equal, greater): bit 1, 2, 4
            s_prel(int k) -> int
            {
                if (k == SP_EQ) { -> 2; };
                if (k == SP_NE) { -> 5; };
                if (k == SP_ULT | k == SP_SLT) { -> 1; };
                if (k == SP_ULE | k == SP_SLE) { -> 3; };
                if (k == SP_UGT | k == SP_SGT) { -> 4; };
                -> 6;
            };

            // 1 for an unsigned order, 2 for a signed one, 0 for equality tests
            s_pdom(int k) -> int
            {
                if (k >= SP_ULT & k <= SP_UGE) { -> 1; };
                if (k >= SP_SLT & k <= SP_SGE) { -> 2; };
                -> 0;
            };

            // The predicate with its operands exchanged
            s_pswp(int k) -> int
            {
                if (k == SP_ULT) { -> SP_UGT; };
                if (k == SP_ULE) { -> SP_UGE; };
                if (k == SP_UGT) { -> SP_ULT; };
                if (k == SP_UGE) { -> SP_ULE; };
                if (k == SP_SLT) { -> SP_SGT; };
                if (k == SP_SLE) { -> SP_SGE; };
                if (k == SP_SGT) { -> SP_SLT; };
                if (k == SP_SGE) { -> SP_SLE; };
                -> k;
            };

            // True when v can only be 0 or 1: a zero extended truth value, or and, or, xor of such values
            s_bit01(IRValue* v, int depth) -> bool
            {
                SI* d;
                v = this.s_res(v);
                if (v.kc) { -> v.kv == (i64)0 | v.kv == (i64)1; };
                if (v.di == (void*)0 | depth > 4) { -> false; };
                d = (SI*)v.di;
                if (d.res != v) { -> false; };
                if (d.op == SO_CAST)
                {
                    if (d.k == SK_ZEXT & d.a.ty.kind == LK.INT & d.a.ty.width == 1) { -> true; };
                    -> false;
                };
                if (d.op == SO_BIN)
                {
                    if (d.k == SB_AND | d.k == SB_OR | d.k == SB_XOR)
                    {
                        -> this.s_bit01(d.a, depth + 1) & this.s_bit01(d.b, depth + 1);
                    };
                };
                -> false;
            };

            // The truth value i1 under a zero extension, or null
            s_zx1(IRValue* v) -> IRValue*
            {
                SI* d;
                v = this.s_res(v);
                if (v.di == (void*)0) { -> (IRValue*)0; };
                d = (SI*)v.di;
                if (d.op != SO_CAST | d.res != v | d.k != SK_ZEXT) { -> (IRValue*)0; };
                if (d.a.ty.kind != LK.INT | d.a.ty.width != 1) { -> (IRValue*)0; };
                -> this.s_res(d.a);
            };

            // x * zext(c) is c ? x : 0, which a conditional move does without the multiply
            s_mulsel(SI* x) -> bool
            {
                IRValue* c;
                IRValue* o;
                if (x.k != SB_MUL | x.res.ty.kind != LK.INT) { -> false; };
                c = this.s_zx1(x.b);
                o = this.s_res(x.a);
                if (c == (IRValue*)0)
                {
                    c = this.s_zx1(x.a);
                    o = this.s_res(x.b);
                };
                if (c == (IRValue*)0) { -> false; };
                x.op = SO_SELECT;
                x.a = c;
                x.b = o;
                x.c = this.s_kint(x.res.ty, (u64)0);
                x.n = 0;
                x.flag = false;
                -> true;
            };

            // The value under pointer to integer and integer to pointer casts, which keep every bit
            s_unptr(IRValue* v) -> IRValue*
            {
                SI* d;
                v = this.s_res(v);
                while (v.di != (void*)0)
                {
                    d = (SI*)v.di;
                    if (d.op != SO_CAST | d.res != v) { break; };
                    if (d.k != SK_PTRTOINT & d.k != SK_INTTOPTR) { break; };
                    v = this.s_res(d.a);
                };
                -> v;
            };

            // True when u and v are the same value, or constants of the same bits, seen through pointer casts
            s_veq(IRValue* u, IRValue* v) -> bool
            {
                i64 uv;
                u = this.s_unptr(u);
                v = this.s_unptr(v);
                if (u == v) { -> true; };
                if (this.s_ck(u) != CK_INT) { -> false; };
                uv = this.scv;
                if (this.s_ck(v) != CK_INT) { -> false; };
                -> uv == this.scv;
            };

            // A comparison of the same two values as a branch condition is known on the arms of that branch: in
            // every block below an arm that only that branch enters, it is replaced by its constant result.
            s_domcond() -> bool
            {
                GF* g = this.sf;
                bool any = false;
                int i, arm, j, sp, pd, qk, qd, sq, val, top;
                bool truth, hit;
                GB* gb;
                GB* tg;
                GB* xb;
                IRBlock* tt;
                SI* cb;
                SI* cm;
                SI* y;
                IRValue* cv;
                IRValue* ya;
                IRValue* yb;
                IRValue* ca;
                IRValue* cbv;
                GB** stk;
                if (g.nb > 4000) { -> false; };
                stk = (GB**)fmalloc((u64)((g.nb + 1) * 8));
                i = 0;
                while (i < g.nb)
                {
                    gb = g.rpo[i];
                    i++;
                    cb = this.s_term(gb.ib);
                    if (cb == (SI*)0) { continue; };
                    if (cb.op != SO_CBR | cb.t == cb.f) { continue; };
                    cv = this.s_res(cb.a);
                    cm = (SI*)cv.di;
                    if (cm == (SI*)0) { continue; };
                    if (cm.op != SO_CMP | cm.n != 0 | cm.res != cv) { continue; };
                    if (cm.k < SP_EQ | cm.k > SP_SGE) { continue; };
                    ca = this.s_res(cm.a);
                    cbv = this.s_res(cm.b);
                    arm = 0;
                    while (arm < 2)
                    {
                        if (arm == 0) { tt = cb.t; } else { tt = cb.f; };
                        truth = (arm == 0) == (cb.k == 0);
                        arm++;
                        tg = this.s_gb(tt);
                        if (tg == (GB*)0) { continue; };
                        if (tg == gb | tg.preds.len != 1) { continue; };
                        pd = this.s_pdom(cm.k);
                        sp = this.s_prel(cm.k);
                        if (!truth) { sp = 7 - sp; };
                        top = 0;
                        stk[top] = tg;
                        top++;
                        while (top > 0)
                        {
                            top--;
                            xb = stk[top];
                            j = 0;
                            while (j < xb.kids.len) { stk[top] = (GB*)xb.kids.items[j]; top++; j++; };
                            if (xb.ib.insts == (PtrVec*)0) { continue; };
                            j = 0;
                            while (j < xb.ib.insts.len)
                            {
                                y = (SI*)xb.ib.insts.items[j];
                                j++;
                                if (y.op == SO_CBR & y != cb)
                                {
                                    // a branch on the very same condition
                                    if (this.s_res(y.a) == cv)
                                    {
                                        if (truth) { y.a = this.s_kint(cv.ty, (u64)1); } else { y.a = this.s_kint(cv.ty, (u64)0); };
                                        any = true;
                                    };
                                    continue;
                                };
                                if (y.op != SO_CMP | y.n != 0 | y == cm | y.res == (IRValue*)0) { continue; };
                                if (y.res.fwd != (IRValue*)0) { continue; };
                                if (y.k < SP_EQ | y.k > SP_SGE) { continue; };
                                ya = this.s_res(y.a);
                                yb = this.s_res(y.b);
                                qk = y.k;
                                hit = false;
                                if (this.s_veq(ya, ca) & this.s_veq(yb, cbv)) { hit = true; }
                                elif (this.s_veq(ya, cbv) & this.s_veq(yb, ca)) { hit = true; qk = this.s_pswp(y.k); };
                                if (!hit) { continue; };
                                qd = this.s_pdom(qk);
                                if (qd != 0 & pd != 0 & qd != pd) { continue; };
                                sq = this.s_prel(qk);
                                val = 0 - 1;
                                if ((sp `& (7 - sq)) == 0) { val = 1; }
                                elif ((sp `& sq) == 0) { val = 0; };
                                if (val < 0) { continue; };
                                y.res.fwd = this.s_kint(y.res.ty, (u64)val);
                                any = true;
                            };
                        };
                    };
                };
                ffree((byte*)stk);
                -> any;
            };

            // True when the edge from tb to the block t may be replaced by an edge from q: the phis of t that take
            // a value from tb must be able to take one from q
            s_thr_ok(IRBlock* t, IRBlock* tb, IRBlock* q, IRValue* pv, SI* cm) -> bool
            {
                int k, m, e;
                SI* x;
                IRValue* u;
                k = 0;
                while (k < t.insts.len)
                {
                    x = (SI*)t.insts.items[k];
                    k++;
                    if (x.op != SO_PHI) { break; };
                    m = 0 - 1;
                    e = 0;
                    while (e < x.n)
                    {
                        if (x.blks[e] == q) { -> false; };
                        if (x.blks[e] == tb) { m = e; };
                        e++;
                    };
                    if (m < 0) { -> false; };
                    u = this.s_res(x.args[m]);
                    if (cm != (SI*)0) { if (u == cm.res) { -> false; }; };
                };
                -> true;
            };

            // Gives the phis of t an incoming value from q, the one they take from tb (v when that is the phi pv)
            s_thr_apply(IRBlock* t, IRBlock* tb, IRBlock* q, IRValue* pv, IRValue* v) -> void
            {
                int k, m, e;
                SI* x;
                IRValue* u;
                IRValue** na;
                IRBlock** nb;
                k = 0;
                while (k < t.insts.len)
                {
                    x = (SI*)t.insts.items[k];
                    k++;
                    if (x.op != SO_PHI) { break; };
                    m = 0;
                    e = 0;
                    while (e < x.n) { if (x.blks[e] == tb) { m = e; }; e++; };
                    u = this.s_res(x.args[m]);
                    if (u == pv) { u = v; };
                    na = this.s_cpv(x.args, x.n);
                    nb = this.s_cpb(x.blks, x.n);
                    na[x.n] = u;
                    nb[x.n] = q;
                    x.args = na;
                    x.blks = nb;
                    x.n = x.n + 1;
                };
                ->;
            };

            // A block that only returns a phi: the blocks that jump to it return their value themselves
            s_retthr() -> bool
            {
                GF* g = this.sf;
                bool any = false;
                int i, p, cnt, ni;
                GB* gb;
                IRBlock* tb;
                IRBlock* q;
                SI* ph;
                SI* cs;
                SI* rt;
                SI* qt;
                IRValue* v;
                i = 1;
                while (i < g.nb)
                {
                    gb = (GB*)g.bl.items[i];
                    tb = gb.ib;
                    i++;
                    if (tb.insts == (PtrVec*)0) { continue; };
                    ni = tb.insts.len;
                    if (ni != 2 & ni != 3) { continue; };
                    ph = (SI*)tb.insts.items[0];
                    cs = (SI*)0;
                    rt = (SI*)tb.insts.items[ni - 1];
                    if (ph.op != SO_PHI | rt.op != SO_RET) { continue; };
                    if (ni == 3)
                    {
                        cs = (SI*)tb.insts.items[1];
                        if (cs.op != SO_CAST) { continue; };
                        if (cs.k != SK_ZEXT & cs.k != SK_TRUNC) { continue; };
                        if (this.s_res(cs.a) != ph.res) { continue; };
                        if (this.s_res(rt.a) != cs.res) { continue; };
                        if (cs.res.ty.kind != LK.INT | cs.res.ty.width > 64) { continue; };
                    }
                    else
                    {
                        if (this.s_res(rt.a) != ph.res) { continue; };
                    };
                    cnt = 0;
                    p = 0;
                    while (p < ph.n & cnt < 6)
                    {
                        q = ph.blks[p];
                        v = this.s_res(ph.args[p]);
                        p++;
                        if (q == tb) { continue; };
                        qt = this.s_term(q);
                        if (qt == (SI*)0) { continue; };
                        if (qt.op != SO_BR | qt.t != tb) { continue; };
                        if (cs != (SI*)0)
                        {
                            if (!this.s_cint(v)) { continue; };
                            v = this.s_kint(cs.res.ty, (u64)this.scv);
                        };
                        qt.op = SO_RET;
                        qt.a = v;
                        qt.ty = rt.ty;
                        qt.k = rt.k;
                        cnt++;
                        any = true;
                    };
                };
                -> any;
            };

            // A block that only branches on a phi: each predecessor that supplies a constant, or a widened truth
            // value, branches to the final targets itself. Returns true when an edge was moved.
            s_thread() -> bool
            {
                GF* g = this.sf;
                bool any = false;
                int i, p, np, ni, w;
                GB* gb;
                IRBlock* tb;
                IRBlock* q;
                SI* ph;
                SI* cm;
                SI* cb;
                SI* qt;
                SI* d;
                IRValue* pv;
                IRValue* v;
                IRBlock* tt;
                IRBlock* ff;
                IRBlock* a;
                IRBlock* b;
                bool flip, nz, tphi;
                i = 1;
                while (i < g.nb)
                {
                    gb = (GB*)g.bl.items[i];
                    tb = gb.ib;
                    i++;
                    if (tb.insts == (PtrVec*)0) { continue; };
                    ni = tb.insts.len;
                    if (ni != 2 & ni != 3) { continue; };
                    ph = (SI*)tb.insts.items[0];
                    cb = (SI*)tb.insts.items[ni - 1];
                    if (ph.op != SO_PHI | cb.op != SO_CBR) { continue; };
                    if (ph.res.ty.kind != LK.INT) { continue; };
                    pv = ph.res;
                    cm = (SI*)0;
                    flip = false;
                    if (ni == 3)
                    {
                        cm = (SI*)tb.insts.items[1];
                        if (cm.op != SO_CMP | cm.n != 0) { continue; };
                        if (cm.k != SP_NE & cm.k != SP_EQ) { continue; };
                        if (this.s_res(cm.a) != pv) { continue; };
                        if (!this.s_cint(this.s_res(cm.b))) { continue; };
                        if (this.scv != (i64)0) { continue; };
                        if (this.s_res(cb.a) != cm.res) { continue; };
                        if (cm.k == SP_EQ) { flip = true; };
                        if (this.s_nuse(cm.res, cb, (SI*)0) != 0) { continue; };
                    }
                    else
                    {
                        if (pv.ty.width != 1) { continue; };
                        if (this.s_res(cb.a) != pv) { continue; };
                    };
                    if (this.s_nuse(pv, cm, cb) != 0) { continue; };
                    if (cb.t == tb | cb.f == tb) { continue; };
                    // the final targets must not take values from this block
                    a = cb.t;
                    b = cb.f;
                    if (a.insts == (PtrVec*)0 | b.insts == (PtrVec*)0) { continue; };
                    if (a.insts.len == 0 | b.insts.len == 0) { continue; };
                    tphi = ((SI*)a.insts.items[0]).op == SO_PHI | ((SI*)b.insts.items[0]).op == SO_PHI;
                    if (tphi & (SSA_OPT_THRPHI != 1 | a == b)) { continue; };
                    // the block reached when the phi is nonzero, then when it is zero
                    if ((cb.k == 1) != flip) { tt = b; ff = a; } else { tt = a; ff = b; };
                    p = 0;
                    while (p < ph.n)
                    {
                        q = ph.blks[p];
                        v = this.s_res(ph.args[p]);
                        p++;
                        if (q == tb) { continue; };
                        qt = this.s_term(q);
                        if (qt == (SI*)0) { continue; };
                        if (qt.op == SO_CBR)
                        {
                            // one arm of a conditional branch goes to this block
                            if (qt.t == qt.f) { continue; };
                            if (this.s_cint(v))
                            {
                                nz = this.scv != (i64)0;
                                a = ff;
                                if (nz) { a = tt; };
                                if (tphi)
                                {
                                    if (!this.s_thr_ok(a, tb, q, pv, cm)) { continue; };
                                    this.s_thr_apply(a, tb, q, pv, v);
                                };
                                if (qt.t == tb) { qt.t = a; } elif (qt.f == tb) { qt.f = a; };
                                any = true;
                            };
                            continue;
                        };
                        if (qt.op != SO_BR) { continue; };
                        if (qt.t != tb) { continue; };
                        if (this.s_cint(v))
                        {
                            nz = this.scv != (i64)0;
                            a = ff;
                            if (nz) { a = tt; };
                            if (tphi)
                            {
                                if (!this.s_thr_ok(a, tb, q, pv, cm)) { continue; };
                                this.s_thr_apply(a, tb, q, pv, v);
                            };
                            qt.t = a;
                            any = true;
                            continue;
                        };
                        w = v.ty.width;
                        if (tphi & w == 1 & v.ty.kind == LK.INT & tt != ff)
                        {
                            if (this.s_thr_ok(tt, tb, q, pv, cm) & this.s_thr_ok(ff, tb, q, pv, cm))
                            {
                                this.s_thr_apply(tt, tb, q, pv, this.s_kint(pv.ty, (u64)1));
                                this.s_thr_apply(ff, tb, q, pv, this.s_kint(pv.ty, (u64)0));
                                qt.op = SO_CBR;
                                qt.a = v;
                                qt.t = tt;
                                qt.f = ff;
                                qt.k = 0;
                                any = true;
                            };
                            continue;
                        };
                        if (tphi) { continue; };
                        if (w == 1 & v.ty.kind == LK.INT)
                        {
                            qt.op = SO_CBR;
                            qt.a = v;
                            qt.t = tt;
                            qt.f = ff;
                            qt.k = 0;
                            any = true;
                            continue;
                        };
                        if (v.di != (void*)0)
                        {
                            d = (SI*)v.di;
                            if (d.op == SO_CAST & d.res == v & d.k == SK_ZEXT)
                            {
                                if (d.a.ty.kind == LK.INT & d.a.ty.width == 1)
                                {
                                    qt.op = SO_CBR;
                                    qt.a = d.a;
                                    qt.t = tt;
                                    qt.f = ff;
                                    qt.k = 0;
                                    any = true;
                                };
                            };
                        };
                    };
                };
                if (SSA_OPT_RETTHR == 1) { if (this.s_retthr()) { any = true; }; };
                -> any;
            };

            // ==========================================================
            // arena, machine operands, virtual registers, operand and address selection.
            // ==========================================================

            // ----------------------------------------------------------
            // Arena for the machine instructions of one function
            // ----------------------------------------------------------

            s_ar(int n) -> byte*
            {
                byte* p;
                int sz;
                n = (n + 7) / 8 * 8;
                if (this.arp == (byte*)0 | this.aru + n > 1048576)
                {
                    sz = 1048576;
                    if (n > sz) { sz = n; };
                    this.arp = (byte*)fmalloc((u64)sz);
                    this.aru = 0;
                    pv_push(this.arch, (void*)this.arp);
                };
                p = this.arp + this.aru;
                this.aru = this.aru + n;
                -> p;
            };

            s_ar_free() -> void
            {
                int i = 0;
                while (i < this.arch.len) { ffree((byte*)this.arch.items[i]); i++; };
                this.arch.len = 0;
                this.arp = (byte*)0;
                this.aru = 0;
                ->;
            };

            // ----------------------------------------------------------
            // Machine operands and instructions
            // ----------------------------------------------------------

            s_mo(int k) -> MO*
            {
                MO* o = (MO*)this.s_ar((int)(((sizeof(MO) + 7) / 8) * 2));
                o.k = k;
                o.r = 0 - 1;
                o.r2 = 0 - 1;
                o.sc = 1;
                o.sz = 8;
                o.fo = 0 - 1;
                o.imm = (i64)0;
                o.sym = (byte*)0;
                -> o;
            };

            s_mo_r(int r, int sz) -> MO*
            {
                MO* o = this.s_mo(MK_REG);
                o.r = r;
                o.sz = sz;
                -> o;
            };

            s_mo_i(i64 v) -> MO*
            {
                MO* o = this.s_mo(MK_IMM);
                o.imm = v;
                -> o;
            };

            s_mo_sym(byte* s) -> MO*
            {
                MO* o = this.s_mo(MK_SYM);
                o.sym = s;
                -> o;
            };

            s_mo_blk(int id) -> MO*
            {
                MO* o = this.s_mo(MK_BLK);
                o.imm = (i64)id;
                -> o;
            };

            // Memory operand: base register (-1 none), index register (-1 none) times sc, displacement,
            // symbol (rip relative) or frame object (-1 none)
            s_mo_mem(int base, int idx, int sc, i64 disp, byte* sym, int fo) -> MO*
            {
                MO* o = this.s_mo(MK_MEM);
                o.r = base;
                o.r2 = idx;
                o.sc = sc;
                o.imm = disp;
                o.sym = sym;
                o.fo = fo;
                -> o;
            };

            s_mo_copy(MO* s) -> MO*
            {
                MO* o = this.s_mo(s.k);
                o.r = s.r;
                o.r2 = s.r2;
                o.sc = s.sc;
                o.sz = s.sz;
                o.fo = s.fo;
                o.imm = s.imm;
                o.sym = s.sym;
                -> o;
            };

            s_mi(int op, int sz) -> MI*
            {
                MI* m = (MI*)this.s_ar((int)(((sizeof(MI) + 7) / 8) * 2));
                m.op = op;
                m.sz = sz;
                m.cc = 0;
                m.iu = 0;
                m.id = 0;
                m.clob = 0;
                m.dying = 0;
                m.ddead = 0;
                m.tgt = 0 - 1;
                m.o0 = (MO*)0;
                m.o1 = (MO*)0;
                m.o2 = (MO*)0;
                m.text = (byte*)0;
                pv_push(this.scb.mi, (void*)m);
                -> m;
            };

            s_mi1(int op, int sz, MO* a) -> MI*
            {
                MI* m = this.s_mi(op, sz);
                m.o0 = a;
                -> m;
            };

            s_mi2(int op, int sz, MO* a, MO* b) -> MI*
            {
                MI* m = this.s_mi(op, sz);
                m.o0 = a;
                m.o1 = b;
                -> m;
            };

            s_mi3(int op, int sz, MO* a, MO* b, MO* c) -> MI*
            {
                MI* m = this.s_mi(op, sz);
                m.o0 = a;
                m.o1 = b;
                m.o2 = c;
                -> m;
            };

            // Three operand instruction with its kind or condition in cc
            s_mi3c(int op, int sz, MO* a, MO* b, MO* c, int cc) -> MI*
            {
                MI* m = this.s_mi3(op, sz, a, b, c);
                m.cc = cc;
                -> m;
            };

            // ----------------------------------------------------------
            // Virtual registers
            // ----------------------------------------------------------

            // New virtual register of class cls (0 general, 1 xmm)
            s_nv(int cls) -> int
            {
                GF* g = this.sf;
                int nc, i;
                int* t;
                if (g.nvr >= g.capvr)
                {
                    nc = g.capvr * 2;
                    if (nc < 256) { nc = 256; };
                    t = this.s_iz(nc); i = 0; while (i < g.capvr) { t[i] = g.vcls[i]; i++; }; if (g.capvr > 0) { this.s_ifree(g.vcls); }; g.vcls = t;
                    t = this.s_iz(nc); i = 0; while (i < g.capvr) { t[i] = g.vwgt[i]; i++; }; if (g.capvr > 0) { this.s_ifree(g.vwgt); }; g.vwgt = t;
                    t = this.s_iz(nc); i = 0; while (i < g.capvr) { t[i] = g.vcol[i]; i++; }; if (g.capvr > 0) { this.s_ifree(g.vcol); }; g.vcol = t;
                    t = this.s_iz(nc); i = 0; while (i < g.capvr) { t[i] = g.vslot[i]; i++; }; if (g.capvr > 0) { this.s_ifree(g.vslot); }; g.vslot = t;
                    t = this.s_iz(nc); i = 0; while (i < g.capvr) { t[i] = g.vforb[i]; i++; }; if (g.capvr > 0) { this.s_ifree(g.vforb); }; g.vforb = t;
                    t = this.s_iz(nc); i = 0; while (i < g.capvr) { t[i] = g.vhint[i]; i++; }; if (g.capvr > 0) { this.s_ifree(g.vhint); }; g.vhint = t;
                    t = this.s_iz(nc); i = 0; while (i < g.capvr) { t[i] = g.vdef[i]; i++; }; if (g.capvr > 0) { this.s_ifree(g.vdef); }; g.vdef = t;
                    t = this.s_iz(nc); i = 0; while (i < g.capvr) { t[i] = g.vglob[i]; i++; }; if (g.capvr > 0) { this.s_ifree(g.vglob); }; g.vglob = t;
                    t = this.s_iz(nc); i = 0; while (i < g.capvr) { t[i] = g.vuse[i]; i++; }; if (g.capvr > 0) { this.s_ifree(g.vuse); }; g.vuse = t;
                    g.capvr = nc;
                };
                i = g.nvr;
                g.vcls[i] = cls;
                g.vwgt[i] = 0;
                g.vcol[i] = 0 - 2;
                g.vslot[i] = 0;
                g.vforb[i] = 0;
                g.vhint[i] = 0 - 1;
                g.vdef[i] = 0 - 1;
                g.vglob[i] = 0 - 1;
                g.vuse[i] = 0;
                g.nvr = i + 1;
                -> i;
            };

            // Register class of values of type t
            s_cls(IRType* t) -> int
            {
                if (t.kind == LK.FLOAT | t.kind == LK.DOUBLE) { -> 1; };
                -> 0;
            };

            // Access size in bytes of a scalar type
            s_vsz(IRType* t) -> int
            {
                int s = this.a_size(t);
                if (s > 8) { s = 8; };
                -> s;
            };

            // Operation size for integer arithmetic: values narrower than 32 bits are computed in 32
            s_asz(IRType* t) -> int
            {
                int s = this.s_vsz(t);
                if (s < 4) { -> 4; };
                -> s;
            };

            // Defines the virtual register of an instruction result
            s_def(IRValue* res, int cls) -> int
            {
                int v = this.s_nv(cls);
                res.vr = v;
                -> v;
            };

            // ----------------------------------------------------------
            // Moves and constants
            // ----------------------------------------------------------

            // Register to register or immediate to register move of sz bytes
            s_mov(MO* src, int dst, int sz) -> void
            {
                MI* m;
                if (src.k == MK_IMM)
                {
                    if (src.imm >= (i64)-2147483648 & src.imm <= (i64)4294967295 & sz <= 4)
                    {
                        this.s_mi2(M_MOV, 4, src, this.s_mo_r(dst, 4));
                        ->;
                    };
                    if (src.imm >= (i64)-2147483648 & src.imm <= (i64)2147483647)
                    {
                        this.s_mi2(M_MOV, 8, src, this.s_mo_r(dst, 8));
                        ->;
                    };
                    this.s_mi2(M_MOVABS, 8, src, this.s_mo_r(dst, 8));
                    ->;
                };
                m = this.s_mi2(M_MOV, sz, src, this.s_mo_r(dst, sz));
                ->;
            };

            // Virtual register holding the 64 bit constant v
            s_imm(i64 v) -> int
            {
                int d = this.s_nv(0);
                this.s_mov(this.s_mo_i(v), d, 8);
                -> d;
            };

            // New register holding register r of sz bytes extended to to bytes (4 or 8)
            s_ext(int r, int sz, bool sgn, int to) -> int
            {
                int d;
                MI* m;
                if (sz >= 8) { -> r; };
                d = this.s_nv(0);
                if (sgn)
                {
                    if (sz == 4)
                    {
                        m = this.s_mi2(M_MOVSX, 4, this.s_mo_r(r, 4), this.s_mo_r(d, 8));
                        m.cc = 8;
                        -> d;
                    };
                    m = this.s_mi2(M_MOVSX, sz, this.s_mo_r(r, sz), this.s_mo_r(d, to));
                    m.cc = to;
                    -> d;
                };
                if (sz == 4)
                {
                    this.s_mov(this.s_mo_r(r, 4), d, 4);
                    -> d;
                };
                this.s_mi2(M_MOVZX, sz, this.s_mo_r(r, sz), this.s_mo_r(d, 4));
                -> d;
            };

            // ----------------------------------------------------------
            // Operands
            // ----------------------------------------------------------

            // True when v is a constant the selector can read, with its payload in sck, scv, scs
            s_isc(IRValue* v) -> bool
            {
                int k;
                if (v.vr != 0 | v.fo != 0) { -> false; };
                if (v.di != (void*)0 & !v.kc) { -> false; };
                k = this.s_ck(v);
                this.sck = k;
                if (k == CK_INT | k == CK_SYM | k == CK_FP | k == CK_ZERO) { -> true; };
                if (k == CK_BAD) { this.s_fail(g"unsupported constant\0"); };
                -> false;
            };

            // Operand for the value v: a register, or an immediate that fits 32 bits
            s_src(IRValue* p) -> MO*
            {
                IRValue* v = this.s_res(p);
                SI* d;
                int r;
                if (v.vr >= R_VBASE) { -> this.s_mo_r(v.vr, this.s_vsz(v.ty)); };
                if (v.fo > 0) { -> this.s_mo_r(this.s_lea(this.s_mo_mem(0 - 1, 0 - 1, 1, (i64)0, (byte*)0, v.fo - 1)), 8); };
                if (v.di != (void*)0 & !v.kc)
                {
                    d = (SI*)v.di;
                    if (d.flag & d.op == SO_GEP)
                    {
                        r = this.s_lea(this.s_gepmem(d));
                        if (this.bf_w > 0) { this.s_fail(g"address of a bit packed member\0"); };
                        -> this.s_mo_r(r, 8);
                    };
                    if (d.flag & d.op == SO_CMP)
                    {
                        -> this.s_mo_r(this.s_cmpval(d), 1);
                    };
                    this.s_fail(g"value without register\0");
                    -> this.s_mo_i((i64)0);
                };
                if (this.s_isc(v))
                {
                    if (this.sck == CK_SYM)
                    {
                        if (this.scv == (i64)0) { -> this.s_mo_r(this.s_lea(this.s_mo_mem(0 - 1, 0 - 1, 1, (i64)0, this.scs, 0 - 1)), 8); };
                        -> this.s_mo_r(this.s_lea(this.s_mo_mem(0 - 1, 0 - 1, 1, this.scv, this.scs, 0 - 1)), 8);
                    };
                    if (this.sck == CK_INT)
                    {
                        if (this.scv >= (i64)-2147483648 & this.scv <= (i64)2147483647) { -> this.s_mo_i(this.scv); };
                        -> this.s_mo_r(this.s_imm(this.scv), 8);
                    };
                    if (this.sck == CK_FP) { -> this.s_fconst(v); };
                    this.s_fail(g"aggregate constant\0");
                    -> this.s_mo_i((i64)0);
                };
                if (v.vr == 0 & v.fo == 0) { this.s_fail(g"operand without definition\0"); };
                -> this.s_mo_i((i64)0);
            };

            // Operand that must be a register
            s_reg(IRValue* v) -> int
            {
                MO* o = this.s_src(v);
                if (o.k == MK_REG) { -> o.r; };
                -> this.s_imm(o.imm);
            };

            // Register for operand o, immediates are moved into a new one
            s_oreg(MO* o) -> int
            {
                if (o.k == MK_REG) { -> o.r; };
                -> this.s_imm(o.imm);
            };

            // Address of memory operand m in a new register
            s_lea(MO* m) -> int
            {
                int d = this.s_nv(0);
                this.s_mi2(M_LEA, 8, this.s_mo_copy(m), this.s_mo_r(d, 8));
                -> d;
            };

            // ----------------------------------------------------------
            // Addresses
            // ----------------------------------------------------------

            // Memory operand of the pointer p
            s_addr(IRValue* p) -> MO*
            {
                IRValue* v = this.s_res(p);
                SI* d;
                if (v.fo > 0) { -> this.s_mo_mem(0 - 1, 0 - 1, 1, (i64)0, (byte*)0, v.fo - 1); };
                if (v.di != (void*)0 & !v.kc)
                {
                    d = (SI*)v.di;
                    if (d.flag & d.op == SO_GEP) { -> this.s_gepmem(d); };
                };
                if (v.vr == 0 & (v.di == (void*)0 | v.kc))
                {
                    if (this.s_isc(v))
                    {
                        if (this.sck == CK_SYM) { -> this.s_mo_mem(0 - 1, 0 - 1, 1, this.scv, this.scs, 0 - 1); };
                        if (this.sck == CK_INT)
                        {
                            if (this.scv >= (i64)-2147483648 & this.scv <= (i64)2147483647) { -> this.s_mo_mem(0 - 1, 0 - 1, 1, this.scv, (byte*)0, 0 - 1); };
                            -> this.s_mo_mem(this.s_imm(this.scv), 0 - 1, 1, (i64)0, (byte*)0, 0 - 1);
                        };
                    };
                    this.s_fail(g"address constant\0");
                    -> this.s_mo_mem(0 - 1, 0 - 1, 1, (i64)0, (byte*)0, 0 - 1);
                };
                -> this.s_mo_mem(this.s_reg(v), 0 - 1, 1, (i64)0, (byte*)0, 0 - 1);
            };

            // Adds a scaled index register to the address in m. The scale is applied by lea when it is 1 2 4 8.
            s_addidx(MO* m, IRValue* ix, int esz) -> void
            {
                IRValue* v = this.s_res(ix);
                int w, r, t;
                bool sgn = true;
                int sc;
                MI* mi;
                w = 64;
                if (v.ty.kind == LK.INT) { w = v.ty.width; };
                if (this.s_isc(v))
                {
                    if (this.sck == CK_INT)
                    {
                        // sign extend a narrow constant from its width
                        t = (int)this.scv;
                        if (w == 32) { m.imm = m.imm + (i64)t * (i64)esz; }
                        else
                        {
                            if (w < 32)
                            {
                                if (w == 8 & t >= 128) { t = t - 256; };
                                if (w == 16 & t >= 32768) { t = t - 65536; };
                                if (w == 1) { };
                                m.imm = m.imm + (i64)t * (i64)esz;
                            }
                            else { m.imm = m.imm + this.scv * (i64)esz; };
                        };
                        ->;
                    };
                    this.s_fail(g"index constant\0");
                    ->;
                };
                if (SSA_OPT_IDXOFF == 1 & w == 64 & v.di != (void*)0 & m.r2 < 0 & (esz == 1 | esz == 2 | esz == 4 | esz == 8))
                {
                    // an index plus a constant becomes a displacement
                    SI* dd = (SI*)v.di;
                    if (dd.op == SO_BIN & dd.k == SB_ADD & dd.res != (IRValue*)0)
                    {
                        if (this.s_cint(this.s_res(dd.b)) & !this.s_isc(this.s_res(dd.a)) & this.scv > (i64)0 - (i64)65536 & this.scv < (i64)65536)
                        {
                            m.imm = m.imm + this.scv * (i64)esz;
                            this.s_addidx(m, dd.a, esz);
                            ->;
                        };
                    };
                };
                if (m.sym != (byte*)0 & !(SSA_OPT_ABSIDX == 1 & !this.a_win() & m.r2 < 0 & (esz == 1 | esz == 2 | esz == 4 | esz == 8)))
                {
                    // a symbol is addressed relative to rip, it cannot take an index
                    t = this.s_lea(m);
                    m.r = t;
                    m.sym = (byte*)0;
                    m.imm = (i64)0;
                };
                // the index is a signed integer of its own width
                if (w < 64)
                {
                    if (this.ec_v == v) { r = this.ec_r; }
                    else
                    {
                        r = this.s_ext(this.s_reg(v), this.s_vsz(v.ty), true, 8);
                        this.ec_v = v;
                        this.ec_r = r;
                    };
                }
                else { r = this.s_reg(v); };
                if (m.r2 >= 0)
                {
                    // already an index: fold into the base
                    t = this.s_lea(m);
                    m.r = t;
                    m.r2 = 0 - 1;
                    m.sc = 1;
                    m.fo = 0 - 1;
                    m.sym = (byte*)0;
                    m.imm = (i64)0;
                };
                if (esz == 1 | esz == 2 | esz == 4 | esz == 8)
                {
                    m.r2 = r;
                    m.sc = esz;
                    ->;
                };
                t = this.s_nv(0);
                sc = this.s_pow2((i64)esz);
                if (sc > 0) { this.s_mi3c(M_SHIFT, 8, this.s_mo_r(r, 8), this.s_mo_i((i64)sc), this.s_mo_r(t, 8), S_SHL); }
                else
                {
                    mi = this.s_mi3(M_ALU, 8, this.s_mo_r(r, 8), this.s_mo_i((i64)esz), this.s_mo_r(t, 8));
                    mi.cc = A_IMUL;
                };
                m.r2 = t;
                m.sc = 1;
                ->;
            };

            // Memory operand for the address a GEP computes
            s_gepmem(SI* x) -> MO*
            {
                IRValue* p = this.s_res(x.a);
                IRType* cur = p.ty.elem;
                this.bf_w = 0;
                MO* m = this.s_addr(p);
                int i, k;
                IRValue* ix;
                IRValue* rx;
                int bo;
                if (this.bf_w > 0) { this.s_fail(g"address of a bit packed member\0"); -> m; };
                // first index steps over whole pointees
                this.s_addidx(m, x.args[0], this.a_size(cur));
                i = 1;
                while (i < x.n)
                {
                    ix = x.args[i];
                    if (cur.kind == LK.STRUCT | cur.kind == LK.ISTRUCT)
                    {
                        rx = this.s_res(ix);
                        if (!this.s_isc(rx)) { this.s_fail(g"struct index\0"); ->m; };
                        k = (int)this.scv;
                        this.bf_ok = true;
                        m.imm = m.imm + (i64)this.a_foff(cur, k);
                        this.bf_ok = false;
                        if (cur.lbits > 0 & cur.loff != (int*)0)
                        {
                            bo = cur.loff[k] % 8;
                            if (this.a_bitw(cur.items[k]) | bo != 0)
                            {
                                if (cur.items[k].kind == LK.INT & i == x.n - 1 & cur.items[k].width <= 64)
                                {
                                    this.bf_sh = bo;
                                    this.bf_w = cur.items[k].width;
                                }
                                else { this.s_fail(g"member not on a byte boundary\0"); };
                            };
                        };
                        cur = cur.items[k];
                    }
                    else
                    {
                        if (cur.kind == LK.ARRAY)
                        {
                            this.s_addidx(m, ix, this.a_size(cur.elem));
                            cur = cur.elem;
                        }
                        else
                        {
                            this.s_fail(g"gep type\0");
                            -> m;
                        };
                    };
                    i++;
                };
                -> m;
            };

            // ==========================================================
            // instruction selection of the integer and pointer operations.
            // ==========================================================

            // Condition code of integer predicate p
            s_cc(int p) -> int
            {
                if (p == SP_EQ) { -> C_E; };
                if (p == SP_NE) { -> C_NE; };
                if (p == SP_ULT) { -> C_B; };
                if (p == SP_ULE) { -> C_BE; };
                if (p == SP_UGT) { -> C_A; };
                if (p == SP_UGE) { -> C_AE; };
                if (p == SP_SLT) { -> C_L; };
                if (p == SP_SLE) { -> C_LE; };
                if (p == SP_SGT) { -> C_G; };
                -> C_GE;
            };

            // Predicate with its operands swapped
            s_swapp(int p) -> int
            {
                if (p == SP_ULT) { -> SP_UGT; };
                if (p == SP_ULE) { -> SP_UGE; };
                if (p == SP_UGT) { -> SP_ULT; };
                if (p == SP_UGE) { -> SP_ULE; };
                if (p == SP_SLT) { -> SP_SGT; };
                if (p == SP_SLE) { -> SP_SGE; };
                if (p == SP_SGT) { -> SP_SLT; };
                if (p == SP_SGE) { -> SP_SLE; };
                -> p;
            };

            // Condition code with the opposite meaning
            s_invcc(int c) -> int
            {
                if (c == C_E) { -> C_NE; };
                if (c == C_NE) { -> C_E; };
                if (c == C_B) { -> C_AE; };
                if (c == C_AE) { -> C_B; };
                if (c == C_BE) { -> C_A; };
                if (c == C_A) { -> C_BE; };
                if (c == C_L) { -> C_GE; };
                if (c == C_GE) { -> C_L; };
                if (c == C_LE) { -> C_G; };
                if (c == C_G) { -> C_LE; };
                if (c == C_P) { -> C_NP; };
                if (c == C_NP) { -> C_P; };
                if (c == C_S) { -> C_NS; };
                -> C_S;
            };

            // Operand for v used with an operation of sz bytes: an immediate when it fits the instruction
            s_srci(IRValue* p, int sz) -> MO*
            {
                IRValue* v = this.s_res(p);
                if (v.vr == 0 & v.fo == 0 & (v.di == (void*)0 | v.kc))
                {
                    if (this.s_isc(v))
                    {
                        if (this.sck == CK_INT)
                        {
                            if (sz < 8)
                            {
                                if (this.scv >= (i64)-2147483648 & this.scv <= (i64)4294967295) { -> this.s_mo_i(this.scv); };
                            }
                            else
                            {
                                if (this.scv >= (i64)-2147483648 & this.scv <= (i64)2147483647) { -> this.s_mo_i(this.scv); };
                            };
                            -> this.s_mo_r(this.s_imm(this.scv), 8);
                        };
                    };
                };
                -> this.s_src(p);
            };

            // True when v is an integer constant, its value in scv
            s_isint(IRValue* p) -> bool
            {
                IRValue* v = this.s_res(p);
                if (v.vr != 0 | v.fo != 0 | (v.di != (void*)0 & !v.kc)) { -> false; };
                if (!this.s_isc(v)) { -> false; };
                -> this.sck == CK_INT;
            };

            // Base two logarithm when v is a power of two above one, else -1
            s_pow2(i64 v) -> int
            {
                int k = 0;
                if (v <= (i64)1) { -> 0 - 1; };
                while (k < 62)
                {
                    if (v == ((i64)1 << (i64)k)) { -> k; };
                    k++;
                };
                -> 0 - 1;
            };

            // ----------------------------------------------------------
            // Comparisons
            // ----------------------------------------------------------

            // Emits the flag setting instruction of the integer compare x and returns the condition code
            // that holds when the compare is true
            s_cmpflags(SI* x) -> int
            {
                IRValue* a = this.s_res(x.a);
                IRValue* b = this.s_res(x.b);
                int p = x.k;
                int sz = this.s_vsz(a.ty);
                MO* sa;
                MO* sb;
                int ra;
                bool ia, ib;
                MI* m;
                if (x.n != 0) { -> this.s_fcmpflags(x); };
                if (a.ty.kind == LK.INT)
                {
                    if (a.ty.width > 64) { this.s_fail(g"wide compare\0"); -> C_E; };
                };
                if (a.ty.kind != LK.INT & a.ty.kind != LK.PTR) { this.s_fail(g"compare type\0"); -> C_E; };
                ia = this.s_isint(a);
                ib = this.s_isint(b);
                if (ia & !ib)
                {
                    // constant on the left: swap
                    a = this.s_res(x.b);
                    b = this.s_res(x.a);
                    p = this.s_swapp(p);
                    ia = false;
                    ib = true;
                };
                sa = this.s_srci(a, sz);
                if (sa.k == MK_IMM) { sa = this.s_mo_r(this.s_imm(sa.imm), 8); };
                ra = sa.r;
                sb = this.s_srci(b, sz);
                if (sb.k == MK_IMM)
                {
                    if (sb.imm == (i64)0 & (p == SP_EQ | p == SP_NE))
                    {
                        this.s_mi2(M_TEST, sz, this.s_mo_r(ra, sz), this.s_mo_r(ra, sz));
                        -> this.s_cc(p);
                    };
                    if (sb.imm == (i64)0 & (p == SP_SLT | p == SP_SGE))
                    {
                        this.s_mi2(M_TEST, sz, this.s_mo_r(ra, sz), this.s_mo_r(ra, sz));
                        if (p == SP_SLT) { -> C_S; };
                        -> C_NS;
                    };
                };
                this.s_mi2(M_CMP, sz, this.s_mo_r(ra, sz), sb);
                -> this.s_cc(p);
            };

            // Register holding the 0 or 1 result of the compare x
            s_cmpval(SI* x) -> int
            {
                int cc = this.s_cmpflags(x);
                int d = this.s_nv(0);
                MI* m;
                m = this.s_mi1(M_SETCC, 1, this.s_mo_r(d, 1));
                m.cc = cc;
                this.s_mi2(M_MOVZX, 1, this.s_mo_r(d, 1), this.s_mo_r(d, 4));
                -> d;
            };

            // Condition code that holds when the boolean c is true, emitting the flag setting instruction
            s_cond(IRValue* c) -> int
            {
                IRValue* v = this.s_res(c);
                SI* d;
                int r;
                if (v.di != (void*)0)
                {
                    d = (SI*)v.di;
                    if (d.flag & d.op == SO_CMP) { -> this.s_cmpflags(d); };
                };
                r = this.s_reg(v);
                this.s_mi2(M_TEST, 1, this.s_mo_r(r, 1), this.s_mo_r(r, 1));
                -> C_NE;
            };

            s_isel_cmp(SI* x) -> void
            {
                int d;
                if (x.flag) { ->; };
                if (x.n != 0)
                {
                    d = this.s_fcmpval(x);
                    x.res.vr = d;
                    ->;
                };
                d = this.s_cmpval(x);
                x.res.vr = d;
                ->;
            };

            // ----------------------------------------------------------
            // Arithmetic
            // ----------------------------------------------------------

            s_isel_bin(SI* x) -> void
            {
                IRType* t = x.ty;
                int sz, k, d, ra, rb, w, sh;
                IRValue* a = this.s_res(x.a);
                IRValue* b = this.s_res(x.b);
                IRValue* tv;
                MI* m;
                MO* sb;
                bool sgn;
                i64 cv;
                k = x.k;
                if (k >= SB_FADD) { this.s_fp_bin(x); ->; };
                if (x.flag & SSA_OPT_BMIX == 1) { ->; };
                if (SSA_OPT_BMIX == 1)
                {
                    sh = this.s_bmi(x);
                    if (sh != 0)
                    {
                        sz = this.s_asz(t);
                        if (sh == 1)
                        {
                            ra = this.s_reg(this.bm_a);
                            rb = this.s_reg(this.bm_b);
                            d = this.s_def(x.res, 0);
                            m = this.s_mi3(M_ALU, sz, this.s_mo_r(ra, sz), this.s_mo_r(rb, sz), this.s_mo_r(d, sz));
                            m.cc = A_AND;
                            m.tgt = 78;
                        };
                        if (sh == 2 | sh == 3)
                        {
                            ra = this.s_reg(this.bm_a);
                            d = this.s_def(x.res, 0);
                            m = this.s_mi2(M_UN, sz, this.s_mo_r(ra, sz), this.s_mo_r(d, sz));
                            if (sh == 2) { m.cc = U_BLSR; } else { m.cc = U_BLSI; };
                        };
                        if (sh == 4)
                        {
                            ra = this.s_reg(this.bm_a);
                            rb = this.s_reg(this.bm_b);
                            d = this.s_def(x.res, 0);
                            m = this.s_mi3(M_ALU, sz, this.s_mo_r(ra, sz), this.s_mo_r(rb, sz), this.s_mo_r(d, sz));
                            m.cc = A_AND;
                            m.tgt = 79;
                        };
                        if (sh == 5)
                        {
                            ra = this.s_reg(this.bm_a);
                            d = this.s_def(x.res, 0);
                            m = this.s_mi3(M_SHIFT, sz, this.s_mo_r(ra, sz), this.s_mo_i((i64)this.bm_n), this.s_mo_r(d, sz));
                            m.cc = S_ROR;
                            m.tgt = 77;
                        };
                        ->;
                    };
                };
                if (t.kind != LK.INT & t.kind != LK.PTR) { this.s_fail(g"arithmetic type\0"); ->; };
                if (t.kind == LK.INT)
                {
                    if (t.width > 64) { this.s_fail(g"wide arithmetic\0"); ->; };
                };
                w = 64;
                if (t.kind == LK.INT) { w = t.width; };
                sz = this.s_asz(t);
                // a constant first operand of a commutative operation goes second
                if (k == SB_ADD | k == SB_MUL | k == SB_AND | k == SB_OR | k == SB_XOR)
                {
                    if (this.s_isint(a) & !this.s_isint(b))
                    {
                        tv = a;
                        a = b;
                        b = tv;
                    };
                };
                if (k == SB_ADD | k == SB_SUB | k == SB_MUL | k == SB_AND | k == SB_OR | k == SB_XOR)
                {
                    if (k == SB_MUL & this.s_isint(b))
                    {
                        sh = this.s_pow2(this.scv);
                        if (sh >= 0)
                        {
                            ra = this.s_reg(a);
                            d = this.s_def(x.res, 0);
                            this.s_mi3c(M_SHIFT, sz, this.s_mo_r(ra, sz), this.s_mo_i((i64)sh), this.s_mo_r(d, sz), S_SHL);
                            ->;
                        };
                    };
                    ra = this.s_reg(a);
                    sb = this.s_srci(b, sz);
                    d = this.s_def(x.res, 0);
                    m = this.s_mi3(M_ALU, sz, this.s_mo_r(ra, sz), sb, this.s_mo_r(d, sz));
                    if (k == SB_ADD) { m.cc = A_ADD; };
                    if (k == SB_SUB) { m.cc = A_SUB; };
                    if (k == SB_MUL) { m.cc = A_IMUL; };
                    if (k == SB_AND) { m.cc = A_AND; };
                    if (k == SB_OR) { m.cc = A_OR; };
                    if (k == SB_XOR) { m.cc = A_XOR; };
                    if (w == 1 & (k == SB_ADD | k == SB_SUB | k == SB_MUL))
                    {
                        this.s_mi3c(M_ALU, 4, this.s_mo_r(d, 4), this.s_mo_i((i64)1), this.s_mo_r(d, 4), A_AND);
                    };
                    ->;
                };
                if (k == SB_SHL | k == SB_LSHR | k == SB_ASHR)
                {
                    ra = this.s_reg(a);
                    sgn = k == SB_ASHR;
                    if (k != SB_SHL & w < 32)
                    {
                        ra = this.s_ext(ra, this.s_vsz(t), sgn, 4);
                    };
                    d = this.s_def(x.res, 0);
                    if (this.s_isint(b))
                    {
                        cv = this.scv;
                        m = this.s_mi3(M_SHIFT, sz, this.s_mo_r(ra, sz), this.s_mo_i(cv), this.s_mo_r(d, sz));
                    }
                    else
                    {
                        rb = this.s_reg(b);
                        if (SSA_OPT_BMI == 1 & (sz == 4 | sz == 8))
                        {
                            // shlx, shrx and sarx take the count in any register and leave the flags alone
                            m = this.s_mi3(M_SHIFT, sz, this.s_mo_r(ra, sz), this.s_mo_r(rb, sz), this.s_mo_r(d, sz));
                            m.tgt = 77;
                        }
                        else
                        {
                            this.s_mov(this.s_mo_r(rb, 4), 1, 4);
                            m = this.s_mi3(M_SHIFT, sz, this.s_mo_r(ra, sz), this.s_mo_r(1, 1), this.s_mo_r(d, sz));
                        };
                    };
                    if (k == SB_SHL) { m.cc = S_SHL; };
                    if (k == SB_LSHR) { m.cc = S_SHR; };
                    if (k == SB_ASHR) { m.cc = S_SAR; };
                    if (w == 1) { this.s_mi3c(M_ALU, 4, this.s_mo_r(d, 4), this.s_mo_i((i64)1), this.s_mo_r(d, 4), A_AND); };
                    ->;
                };
                // division and remainder
                sgn = k == SB_SDIV | k == SB_SREM;
                if (!sgn & this.s_isint(b))
                {
                    sh = this.s_pow2(this.scv);
                    if (sh >= 0)
                    {
                        ra = this.s_reg(a);
                        if (w < 32) { ra = this.s_ext(ra, this.s_vsz(t), false, 4); };
                        d = this.s_def(x.res, 0);
                        if (k == SB_UDIV)
                        {
                            m = this.s_mi3(M_SHIFT, sz, this.s_mo_r(ra, sz), this.s_mo_i((i64)sh), this.s_mo_r(d, sz));
                            m.cc = S_SHR;
                        }
                        else
                        {
                            cv = (i64)1 << (i64)sh;
                            cv = cv - (i64)1;
                            if (cv > (i64)2147483647) { sb = this.s_mo_r(this.s_imm(cv), 8); } else { sb = this.s_mo_i(cv); };
                            m = this.s_mi3(M_ALU, sz, this.s_mo_r(ra, sz), sb, this.s_mo_r(d, sz));
                            m.cc = A_AND;
                        };
                        ->;
                    };
                };
                if (SSA_OPT_DIVC == 1 & w >= 8 & w <= 32 & this.s_isint(b))
                {
                    if (this.s_divc(x, k, w, t, sgn)) { ->; };
                };
                if (SSA_OPT_DIVC == 1 & w == 64 & this.s_isint(b))
                {
                    if (this.s_divc64(x, k, sgn)) { ->; };
                };
                ra = this.s_reg(a);
                rb = this.s_reg(b);
                if (w < 32)
                {
                    ra = this.s_ext(ra, this.s_vsz(t), sgn, 4);
                    rb = this.s_ext(rb, this.s_vsz(t), sgn, 4);
                };
                this.s_mov(this.s_mo_r(ra, sz), 0, sz);
                if (sgn)
                {
                    m = this.s_mi(M_CQO, sz);
                    m.iu = 1;
                    m.id = 4;
                }
                else
                {
                    this.s_mov(this.s_mo_i((i64)0), 2, 4);
                };
                m = this.s_mi1(M_DIV, sz, this.s_mo_r(rb, sz));
                if (sgn) { m.cc = 1; } else { m.cc = 0; };
                m.iu = 5;
                m.id = 5;
                d = this.s_def(x.res, 0);
                if (k == SB_SDIV | k == SB_UDIV) { this.s_mov(this.s_mo_r(0, sz), d, sz); }
                else { this.s_mov(this.s_mo_r(2, sz), d, sz); };
                ->;
            };

            // ----------------------------------------------------------
            // Conversions
            // ----------------------------------------------------------

            // Division or remainder of a value of at most 32 bits by a constant, as a multiply by its reciprocal.
            // Returns false when the divisor has no cheap form.
            s_divc(SI* x, int k, int w, IRType* t, bool sgn) -> bool
            {
                IRValue* a = this.s_res(x.a);
                IRValue* b = this.s_res(x.b);
                i64 dv, lim, mg, ee, one, kk;
                int l, sh, ra, xr, x64, tq, tt, u, d, q, qd, mr;
                bool rem = k == SB_UREM | k == SB_SREM;
                bool fix;
                MI* m;
                if (!this.s_isint(b)) { -> false; };
                one = (i64)1;
                dv = this.scv;
                lim = one << (i64)w;
                dv = dv `& (lim - one);
                if (sgn & dv >= (lim >> one)) { dv = dv - lim; };
                if (dv < (i64)2 | dv >= (i64)1073741824) { -> false; };
                l = 0;
                while ((one << (i64)l) < dv) { l++; };
                sh = this.s_pow2(dv);
                ra = this.s_reg(a);
                if (w < 32) { ra = this.s_ext(ra, this.s_vsz(t), sgn, 4); };
                xr = ra;
                if (sgn)
                {
                    if (sh >= 0)
                    {
                        // round toward zero: add (d - 1) to a negative dividend
                        tt = this.s_nv(0);
                        this.s_mi3c(M_SHIFT, 4, this.s_mo_r(xr, 4), this.s_mo_i((i64)31), this.s_mo_r(tt, 4), S_SAR);
                        if (sh > 1) { this.s_mi3c(M_SHIFT, 4, this.s_mo_r(tt, 4), this.s_mo_i((i64)(32 - sh)), this.s_mo_r(tt, 4), S_SHR); }
                        else { this.s_mi3c(M_SHIFT, 4, this.s_mo_r(xr, 4), this.s_mo_i((i64)31), this.s_mo_r(tt, 4), S_SHR); };
                        u = this.s_nv(0);
                        this.s_mi3c(M_ALU, 4, this.s_mo_r(xr, 4), this.s_mo_r(tt, 4), this.s_mo_r(u, 4), A_ADD);
                        q = this.s_nv(0);
                        this.s_mi3c(M_SHIFT, 4, this.s_mo_r(u, 4), this.s_mo_i((i64)sh), this.s_mo_r(q, 4), S_SAR);
                    }
                    else
                    {
                        x64 = this.s_ext(xr, 4, true, 8);
                        kk = (i64)(31 + l);
                        mg = (one << kk) + dv - one;
                        mg = mg / dv;
                        tt = this.s_nv(0);
                        if (mg > (i64)2147483647) { mr = this.s_imm(mg); this.s_mi3c(M_ALU, 8, this.s_mo_r(x64, 8), this.s_mo_r(mr, 8), this.s_mo_r(tt, 8), A_IMUL); }
                        else { this.s_mi3c(M_ALU, 8, this.s_mo_r(x64, 8), this.s_mo_i(mg), this.s_mo_r(tt, 8), A_IMUL); };
                        u = this.s_nv(0);
                        this.s_mi3c(M_SHIFT, 8, this.s_mo_r(tt, 8), this.s_mo_i(kk), this.s_mo_r(u, 8), S_SAR);
                        tq = this.s_nv(0);
                        this.s_mi3c(M_SHIFT, 8, this.s_mo_r(x64, 8), this.s_mo_i((i64)63), this.s_mo_r(tq, 8), S_SHR);
                        q = this.s_nv(0);
                        this.s_mi3c(M_ALU, 4, this.s_mo_r(u, 4), this.s_mo_r(tq, 4), this.s_mo_r(q, 4), A_ADD);
                    };
                }
                else
                {
                    x64 = this.s_nv(0);
                    this.s_mov(this.s_mo_r(xr, 4), x64, 4);
                    // the smallest shift whose multiplier fits 32 bits and is exact over 32 bit dividends
                    fix = true;
                    kk = (i64)32;
                    mg = (i64)0;
                    sh = 0;
                    while (sh <= l)
                    {
                        ee = (one << (i64)(32 + sh));
                        mg = (ee + dv - one) / dv;
                        if (mg * dv - ee <= (one << (i64)sh) & mg < (one << (i64)32)) { fix = false; kk = (i64)(32 + sh); break; };
                        sh++;
                    };
                    tt = this.s_nv(0);
                    if (!fix)
                    {
                        if (mg > (i64)2147483647) { mr = this.s_imm(mg); this.s_mi3c(M_ALU, 8, this.s_mo_r(x64, 8), this.s_mo_r(mr, 8), this.s_mo_r(tt, 8), A_IMUL); }
                        else { this.s_mi3c(M_ALU, 8, this.s_mo_r(x64, 8), this.s_mo_i(mg), this.s_mo_r(tt, 8), A_IMUL); };
                        q = this.s_nv(0);
                        this.s_mi3c(M_SHIFT, 8, this.s_mo_r(tt, 8), this.s_mo_i(kk), this.s_mo_r(q, 8), S_SHR);
                    }
                    else
                    {
                        // a 33 bit multiplier: t = (x * m) >> 32, q = (t + ((x - t) >> 1)) >> (l - 1)
                        mg = ((one << (i64)32) * ((one << (i64)l) - dv)) / dv + one;
                        mr = this.s_imm(mg);
                        u = this.s_nv(0);
                        this.s_mi3c(M_ALU, 8, this.s_mo_r(x64, 8), this.s_mo_r(mr, 8), this.s_mo_r(u, 8), A_IMUL);
                        this.s_mi3c(M_SHIFT, 8, this.s_mo_r(u, 8), this.s_mo_i((i64)32), this.s_mo_r(tt, 8), S_SHR);
                        u = this.s_nv(0);
                        this.s_mi3c(M_ALU, 8, this.s_mo_r(x64, 8), this.s_mo_r(tt, 8), this.s_mo_r(u, 8), A_SUB);
                        tq = this.s_nv(0);
                        this.s_mi3c(M_SHIFT, 8, this.s_mo_r(u, 8), this.s_mo_i((i64)1), this.s_mo_r(tq, 8), S_SHR);
                        u = this.s_nv(0);
                        this.s_mi3c(M_ALU, 8, this.s_mo_r(tq, 8), this.s_mo_r(tt, 8), this.s_mo_r(u, 8), A_ADD);
                        q = this.s_nv(0);
                        if (l > 1) { this.s_mi3c(M_SHIFT, 8, this.s_mo_r(u, 8), this.s_mo_i((i64)(l - 1)), this.s_mo_r(q, 8), S_SHR); }
                        else { this.s_mov(this.s_mo_r(u, 8), q, 8); };
                    };
                };
                d = this.s_def(x.res, 0);
                if (!rem)
                {
                    this.s_mov(this.s_mo_r(q, 4), d, 4);
                    -> true;
                };
                qd = this.s_nv(0);
                this.s_mi3c(M_ALU, 4, this.s_mo_r(q, 4), this.s_mo_i(dv), this.s_mo_r(qd, 4), A_IMUL);
                this.s_mi3c(M_ALU, 4, this.s_mo_r(xr, 4), this.s_mo_r(qd, 4), this.s_mo_r(d, 4), A_SUB);
                -> true;
            };

            // High half of the 128 bit product of the 64 bit register xr and the constant mg
            s_mulh(int xr, u64 mg, bool sgn) -> int
            {
                MI* m;
                int mr, r;
                this.s_mov(this.s_mo_r(xr, 8), 0, 8);
                mr = this.s_imm((i64)mg);
                m = this.s_mi1(M_DIV, 8, this.s_mo_r(mr, 8));
                if (sgn) { m.cc = 3; } else { m.cc = 2; };
                m.iu = 1;
                m.id = 5;
                r = this.s_nv(0);
                this.s_mov(this.s_mo_r(2, 8), r, 8);
                -> r;
            };

            // 64 bit division or remainder by a constant (see s_divc)
            s_divc64(SI* x, int k, bool sgn) -> bool
            {
                IRValue* a = this.s_res(x.a);
                IRValue* b = this.s_res(x.b);
                u64 dv, two, mk, nc, q1, r1, q2, r2, delta, ad, anc, tu, mg;
                u64 one;
                int p, sh, xr, tt, u, q, tq, d, qd, mr, sa;
                bool rem = k == SB_UREM | k == SB_SREM;
                bool add, more;
                if (!this.s_isint(b)) { -> false; };
                one = (u64)1;
                two = one << (u64)63;
                dv = (u64)this.scv;
                if (dv < (u64)3) { -> false; };
                if (sgn & dv >= (one << (u64)62)) { -> false; };
                if (!sgn & dv >= two) { -> false; };
                sh = this.s_pow2((i64)dv);
                xr = this.s_reg(a);
                if (sgn)
                {
                    if (sh >= 0)
                    {
                        tt = this.s_nv(0);
                        if (sh > 1)
                        {
                            this.s_mi3c(M_SHIFT, 8, this.s_mo_r(xr, 8), this.s_mo_i((i64)63), this.s_mo_r(tt, 8), S_SAR);
                            this.s_mi3c(M_SHIFT, 8, this.s_mo_r(tt, 8), this.s_mo_i((i64)(64 - sh)), this.s_mo_r(tt, 8), S_SHR);
                        }
                        else { this.s_mi3c(M_SHIFT, 8, this.s_mo_r(xr, 8), this.s_mo_i((i64)63), this.s_mo_r(tt, 8), S_SHR); };
                        u = this.s_nv(0);
                        this.s_mi3c(M_ALU, 8, this.s_mo_r(xr, 8), this.s_mo_r(tt, 8), this.s_mo_r(u, 8), A_ADD);
                        q = this.s_nv(0);
                        this.s_mi3c(M_SHIFT, 8, this.s_mo_r(u, 8), this.s_mo_i((i64)sh), this.s_mo_r(q, 8), S_SAR);
                    }
                    else
                    {
                        mk = (u64)0 - one;
                        ad = dv;
                        tu = two;
                        anc = tu - one - (tu % ad);
                        p = 63;
                        q1 = two / anc; r1 = two - q1 * anc;
                        q2 = two / ad; r2 = two - q2 * ad;
                        more = true;
                        while (more)
                        {
                            p++;
                            q1 = q1 * (u64)2; r1 = r1 * (u64)2;
                            if (r1 >= anc) { q1 = q1 + one; r1 = r1 - anc; };
                            q2 = q2 * (u64)2; r2 = r2 * (u64)2;
                            if (r2 >= ad) { q2 = q2 + one; r2 = r2 - ad; };
                            delta = ad - r2;
                            more = q1 < delta | (q1 == delta & r1 == (u64)0);
                        };
                        mg = q2 + one;
                        sa = p - 64;
                        tt = this.s_mulh(xr, mg, true);
                        if (mg >= two)
                        {
                            u = this.s_nv(0);
                            this.s_mi3c(M_ALU, 8, this.s_mo_r(tt, 8), this.s_mo_r(xr, 8), this.s_mo_r(u, 8), A_ADD);
                            tt = u;
                        };
                        if (sa > 0)
                        {
                            u = this.s_nv(0);
                            this.s_mi3c(M_SHIFT, 8, this.s_mo_r(tt, 8), this.s_mo_i((i64)sa), this.s_mo_r(u, 8), S_SAR);
                            tt = u;
                        };
                        tq = this.s_nv(0);
                        this.s_mi3c(M_SHIFT, 8, this.s_mo_r(tt, 8), this.s_mo_i((i64)63), this.s_mo_r(tq, 8), S_SHR);
                        q = this.s_nv(0);
                        this.s_mi3c(M_ALU, 8, this.s_mo_r(tt, 8), this.s_mo_r(tq, 8), this.s_mo_r(q, 8), A_ADD);
                    };
                }
                else
                {
                    if (sh >= 0) { -> false; };
                    mk = (u64)0 - one;
                    nc = mk - (((u64)0 - dv) % dv);
                    p = 63;
                    q1 = two / nc; r1 = two - q1 * nc;
                    q2 = (two - one) / dv; r2 = (two - one) - q2 * dv;
                    add = false;
                    more = true;
                    while (more)
                    {
                        p++;
                        if (r1 >= nc - r1) { q1 = q1 * (u64)2 + one; r1 = r1 * (u64)2 - nc; }
                        else { q1 = q1 * (u64)2; r1 = r1 * (u64)2; };
                        if (r2 + one >= dv - r2)
                        {
                            if (q2 >= two - one) { add = true; };
                            q2 = q2 * (u64)2 + one; r2 = r2 * (u64)2 + one - dv;
                        }
                        else
                        {
                            if (q2 >= two) { add = true; };
                            q2 = q2 * (u64)2; r2 = r2 * (u64)2 + one;
                        };
                        delta = dv - one - r2;
                        more = p < 128 & (q1 < delta | (q1 == delta & r1 == (u64)0));
                    };
                    mg = q2 + one;
                    sa = p - 64;
                    tt = this.s_mulh(xr, mg, false);
                    if (!add)
                    {
                        if (sa > 0)
                        {
                            q = this.s_nv(0);
                            this.s_mi3c(M_SHIFT, 8, this.s_mo_r(tt, 8), this.s_mo_i((i64)sa), this.s_mo_r(q, 8), S_SHR);
                        }
                        else { q = tt; };
                    }
                    else
                    {
                        u = this.s_nv(0);
                        this.s_mi3c(M_ALU, 8, this.s_mo_r(xr, 8), this.s_mo_r(tt, 8), this.s_mo_r(u, 8), A_SUB);
                        tq = this.s_nv(0);
                        this.s_mi3c(M_SHIFT, 8, this.s_mo_r(u, 8), this.s_mo_i((i64)1), this.s_mo_r(tq, 8), S_SHR);
                        u = this.s_nv(0);
                        this.s_mi3c(M_ALU, 8, this.s_mo_r(tq, 8), this.s_mo_r(tt, 8), this.s_mo_r(u, 8), A_ADD);
                        if (sa > 1)
                        {
                            q = this.s_nv(0);
                            this.s_mi3c(M_SHIFT, 8, this.s_mo_r(u, 8), this.s_mo_i((i64)(sa - 1)), this.s_mo_r(q, 8), S_SHR);
                        }
                        else { q = u; };
                    };
                };
                d = this.s_def(x.res, 0);
                if (!rem)
                {
                    this.s_mov(this.s_mo_r(q, 8), d, 8);
                    -> true;
                };
                qd = this.s_nv(0);
                if (dv > (u64)2147483647) { mr = this.s_imm((i64)dv); this.s_mi3c(M_ALU, 8, this.s_mo_r(q, 8), this.s_mo_r(mr, 8), this.s_mo_r(qd, 8), A_IMUL); }
                else { this.s_mi3c(M_ALU, 8, this.s_mo_r(q, 8), this.s_mo_i((i64)dv), this.s_mo_r(qd, 8), A_IMUL); };
                this.s_mi3c(M_ALU, 8, this.s_mo_r(xr, 8), this.s_mo_r(qd, 8), this.s_mo_r(d, 8), A_SUB);
                -> true;
            };

            s_isel_cast(SI* x) -> void
            {
                IRValue* a = this.s_res(x.a);
                IRType* ft = a.ty;
                IRType* tt = x.ty;
                int k = x.k;
                int fsz, tsz, fw, tw, r, d;
                bool odd;
                MI* m;
                MO* s;
                if (this.s_isfp(ft) | this.s_isfp(tt)) { this.s_fp_cast(x); ->; };
                if (k >= SK_FPEXT) { this.s_fail(g"float cast\0"); ->; };
                if (ft.kind != LK.INT & ft.kind != LK.PTR) { this.s_fail(g"cast source type\0"); ->; };
                if (tt.kind != LK.INT & tt.kind != LK.PTR) { this.s_fail(g"cast result type\0"); ->; };
                fw = 64;
                tw = 64;
                if (ft.kind == LK.INT) { fw = ft.width; };
                if (tt.kind == LK.INT) { tw = tt.width; };
                if (fw > 64 | tw > 64) { this.s_fail(g"wide cast\0"); ->; };
                fsz = this.s_vsz(ft);
                tsz = this.s_vsz(tt);
                if (this.s_isint(a))
                {
                    // constant operand: fold
                    this.s_cast_const(x, a);
                    ->;
                };
                s = this.s_src(a);
                r = this.s_oreg(s);
                d = this.s_def(x.res, 0);
                odd = fw != 1 & fw != 8 & fw != 16 & fw != 32 & fw != 64;
                if (odd & (k == SK_ZEXT | k == SK_SEXT) & ft.kind == LK.INT)
                {
                    // a width that is not a machine size is only known in its low bits, the bits above are cleared or
                    // filled here
                    this.s_mov(this.s_mo_r(r, 8), d, 8);
                    if (k == SK_ZEXT)
                    {
                        this.s_mi3c(M_ALU, 8, this.s_mo_r(d, 8), this.s_mask(((i64)1 << (i64)fw) - (i64)1), this.s_mo_r(d, 8), A_AND);
                        ->;
                    };
                    this.s_mi3c(M_SHIFT, 8, this.s_mo_r(d, 8), this.s_mo_i((i64)(64 - fw)), this.s_mo_r(d, 8), S_SHL);
                    this.s_mi3c(M_SHIFT, 8, this.s_mo_r(d, 8), this.s_mo_i((i64)(64 - fw)), this.s_mo_r(d, 8), S_SAR);
                    ->;
                };
                if (k == SK_ZEXT | k == SK_INTTOPTR)
                {
                    if (fsz >= 8) { this.s_mov(this.s_mo_r(r, 8), d, 8); ->; };
                    if (fsz == 4) { this.s_mov(this.s_mo_r(r, 4), d, 4); ->; };
                    if (fw == 1)
                    {
                        this.s_mov(this.s_mo_r(r, 4), d, 4);
                        ->;
                    };
                    this.s_mi2(M_MOVZX, fsz, this.s_mo_r(r, fsz), this.s_mo_r(d, 4));
                    ->;
                };
                if (k == SK_SEXT)
                {
                    if (fw == 1)
                    {
                        this.s_mov(this.s_mo_r(r, 4), d, 4);
                        m = this.s_mi2(M_UN, this.s_asz(tt), this.s_mo_r(d, this.s_asz(tt)), this.s_mo_r(d, this.s_asz(tt)));
                        m.cc = U_NEG;
                        ->;
                    };
                    if (tsz == 8)
                    {
                        if (fsz == 4)
                        {
                            m = this.s_mi2(M_MOVSX, 4, this.s_mo_r(r, 4), this.s_mo_r(d, 8));
                            m.cc = 8;
                            ->;
                        };
                        m = this.s_mi2(M_MOVSX, fsz, this.s_mo_r(r, fsz), this.s_mo_r(d, 8));
                        m.cc = 8;
                        ->;
                    };
                    if (fsz >= 4) { this.s_mov(this.s_mo_r(r, 4), d, 4); ->; };
                    m = this.s_mi2(M_MOVSX, fsz, this.s_mo_r(r, fsz), this.s_mo_r(d, 4));
                    m.cc = 4;
                    ->;
                };
                // trunc, ptrtoint, bitcast
                if (tw == 1 & fw > 1)
                {
                    this.s_mi3c(M_ALU, 4, this.s_mo_r(r, 4), this.s_mo_i((i64)1), this.s_mo_r(d, 4), A_AND);
                    ->;
                };
                if (tsz == 8 & fsz == 8) { this.s_mov(this.s_mo_r(r, 8), d, 8); ->; };
                if (tsz == 8 & fsz < 8)
                {
                    // widening bitcast: zero extend
                    if (fsz == 4) { this.s_mov(this.s_mo_r(r, 4), d, 4); ->; };
                    this.s_mi2(M_MOVZX, fsz, this.s_mo_r(r, fsz), this.s_mo_r(d, 4));
                    ->;
                };
                this.s_mov(this.s_mo_r(r, 4), d, 4);
                ->;
            };

            // Cast of an integer constant, the result becomes a constant move
            s_cast_const(SI* x, IRValue* a) -> void
            {
                IRType* ft = a.ty;
                IRType* tt = x.ty;
                i64 v = this.scv;
                int fw = 64;
                int tw = 64;
                int d;
                u64 u;
                if (ft.kind == LK.INT) { fw = ft.width; };
                if (tt.kind == LK.INT) { tw = tt.width; };
                if (x.k == SK_SEXT & fw < 64)
                {
                    u = (u64)v;
                    if (((u >> (u64)(fw - 1)) `& (u64)1) != (u64)0) { u = u `| ((u64)0 - ((u64)1 << (u64)fw)); };
                    v = (i64)u;
                };
                if (tw < 64) { v = (i64)this.a_mask((u64)v, tw); };
                // the result is the constant itself, uses read it as an immediate
                x.res.kc = true;
                x.res.kv = v;
                ->;
            };

            // ----------------------------------------------------------
            // Memory
            // ----------------------------------------------------------

            // New frame object of sz bytes, returns its number plus one
            s_newfo(int sz, int al) -> int
            {
                GF* g = this.sf;
                XFO* o = (XFO*)this.s_ar((int)(((sizeof(XFO) + 7) / 8) * 2));
                if (sz < 1) { sz = 1; };
                if (al < 1) { al = 1; };
                o.size = sz;
                o.al = al;
                o.off = 0;
                o.fix = 0;
                pv_push(g.fobj, (void*)o);
                -> g.fobj.len;
            };

            // Stack allocation of count elements: the size rounded to 16 is taken off rsp, the new bytes sit just
            // above the outgoing argument area
            s_isel_allocan(SI* x) -> void
            {
                int r = this.s_reg(this.s_res(x.a));
                int t1 = this.s_nv(0);
                int t2 = this.s_nv(0);
                int t3 = this.s_nv(0);
                int d;
                this.s_mi3c(M_ALU, 8, this.s_mo_r(r, 8), this.s_mo_i((i64)this.a_size(x.ty)), this.s_mo_r(t1, 8), A_IMUL);
                this.s_mi3c(M_ALU, 8, this.s_mo_r(t1, 8), this.s_mo_i((i64)15), this.s_mo_r(t2, 8), A_ADD);
                this.s_mi3c(M_ALU, 8, this.s_mo_r(t2, 8), this.s_mo_i((i64)-16), this.s_mo_r(t3, 8), A_AND);
                d = this.s_def(x.res, 0);
                this.s_mi2(M_DALLOC, 8, this.s_mo_r(t3, 8), this.s_mo_r(d, 8));
                ->;
            };

            s_isel_alloca(SI* x) -> void
            {
                x.res.fo = this.s_newfo(this.a_size(x.ty), this.a_align(x.ty));
                ->;
            };

            s_isagg(IRType* t) -> bool
            {
                -> t.kind == LK.ARRAY | t.kind == LK.STRUCT | t.kind == LK.ISTRUCT;
            };

            // Memory operand n bytes past m
            s_mo_off(MO* m, int n) -> MO*
            {
                MO* c = this.s_mo_copy(m);
                c.imm = c.imm + (i64)n;
                -> c;
            };

            // Copies n bytes from memory s to memory d
            s_copy(MO* d, MO* s, int n) -> void
            {
                MI* m;
                int rs, rd;
                if (n <= 128)
                {
                    this.s_mi2(M_COPY, n, d, s);
                    ->;
                };
                rs = this.s_lea(s);
                rd = this.s_lea(d);
                this.s_mov(this.s_mo_r(rs, 8), 6, 8);
                this.s_mov(this.s_mo_r(rd, 8), 7, 8);
                this.s_mov(this.s_mo_i((i64)n), 1, 8);
                m = this.s_mi(M_REPMOVS, 1);
                m.iu = 194;
                m.id = 194;
                ->;
            };

            // Stores zero over n bytes at d
            s_zero(MO* d, int n) -> void
            {
                int off = 0;
                MI* m;
                if (n > 128)
                {
                    this.s_mov(this.s_mo_r(this.s_lea(d), 8), 7, 8);
                    this.s_mov(this.s_mo_i((i64)n), 1, 8);
                    this.s_mov(this.s_mo_i((i64)0), 0, 4);
                    m = this.s_mi(M_REPSTOS, 1);
                    m.iu = 131;
                    m.id = 131;
                    ->;
                };
                while (n - off >= 8)
                {
                    this.s_mi2(M_MOV, 8, this.s_mo_i((i64)0), this.s_mo_off(d, off));
                    off = off + 8;
                };
                while (n - off >= 4)
                {
                    this.s_mi2(M_MOV, 4, this.s_mo_i((i64)0), this.s_mo_off(d, off));
                    off = off + 4;
                };
                while (n - off >= 1)
                {
                    this.s_mi2(M_MOV, 1, this.s_mo_i((i64)0), this.s_mo_off(d, off));
                    off = off + 1;
                };
                ->;
            };

            // Memory operand of the bytes of the aggregate value v
            s_agg_addr(IRValue* v) -> MO*
            {
                byte* lb;
                if (v.fo > 0) { -> this.s_mo_mem(0 - 1, 0 - 1, 1, (i64)0, (byte*)0, v.fo - 1); };
                if (v.vr == 0 & v.di == (void*)0 & v.text != (byte*)0)
                {
                    if (this.a_pre(v.text, g"zeroinitializer\0") | this.a_pre(v.text, g"undef\0"))
                    {
                        lb = this.a_zero_label(this.a_size(v.ty));
                    }
                    else { lb = this.a_const_agg(v); };
                    -> this.s_mo_mem(0 - 1, 0 - 1, 1, (i64)0, lb, 0 - 1);
                };
                this.s_fail(g"aggregate value\0");
                -> this.s_mo_mem(0 - 1, 0 - 1, 1, (i64)0, (byte*)0, 0 - 1);
            };

            // Copies the aggregate value v to memory d
            s_agg_to(IRValue* v, MO* d) -> void
            {
                int sz = this.a_size(v.ty);
                MO* s = this.s_agg_addr(v);
                if (this.gwhy != 0) { ->; };
                this.s_copy(d, s, sz);
                ->;
            };

            // Byte offset and type of element i of the aggregate type t
            s_elem(IRType* t, int i) -> IRType*
            {
                if (t.kind == LK.ARRAY)
                {
                    this.sel_off = i * this.a_size(t.elem);
                    -> t.elem;
                };
                this.sel_off = this.a_foff(t, i);
                -> (IRType*)t.items[i];
            };

            s_isel_extract(SI* x) -> void
            {
                IRValue* agg = this.s_res(x.a);
                IRType* et = this.s_elem(agg.ty, x.k);
                MO* base = this.s_agg_addr(agg);
                MO* m;
                int sz, d, fo;
                if (this.gwhy != 0) { ->; };
                m = this.s_mo_off(base, this.sel_off);
                if (this.s_isagg(et))
                {
                    sz = this.a_size(et);
                    fo = this.s_newfo(sz, this.a_align(et));
                    this.s_copy(this.s_mo_mem(0 - 1, 0 - 1, 1, (i64)0, (byte*)0, fo - 1), m, sz);
                    x.res.fo = fo;
                    ->;
                };
                if (this.s_isfp(et))
                {
                    sz = this.s_vsz(et);
                    d = this.s_def(x.res, 1);
                    this.s_mi2(M_XMOV, sz, m, this.s_mo_r(d, sz));
                    ->;
                };
                if (et.kind != LK.INT & et.kind != LK.PTR) { this.s_fail(g"extract type\0"); ->; };
                if (et.kind == LK.INT)
                {
                    if (et.width > 64) { this.s_fail(g"wide extract\0"); ->; };
                };
                sz = this.s_vsz(et);
                d = this.s_def(x.res, 0);
                if (sz < 4) { this.s_mi2(M_MOVZX, sz, m, this.s_mo_r(d, 4)); ->; };
                this.s_mi2(M_MOV, sz, m, this.s_mo_r(d, sz));
                ->;
            };

            s_isel_insert(SI* x) -> void
            {
                IRValue* agg = this.s_res(x.a);
                IRValue* v = this.s_res(x.b);
                IRType* et = this.s_elem(agg.ty, x.k);
                int off = this.sel_off;
                int tsz = this.a_size(agg.ty);
                int fo = this.s_newfo(tsz, this.a_align(agg.ty));
                MO* dst = this.s_mo_mem(0 - 1, 0 - 1, 1, (i64)off, (byte*)0, fo - 1);
                MO* whole = this.s_mo_mem(0 - 1, 0 - 1, 1, (i64)0, (byte*)0, fo - 1);
                MO* src = this.s_agg_addr(agg);
                int sz, r;
                if (this.gwhy != 0) { ->; };
                this.s_copy(whole, src, tsz);
                if (this.s_isagg(et)) { this.s_agg_to(v, dst); x.res.fo = fo; ->; };
                sz = this.s_vsz(et);
                if (this.s_isfp(et))
                {
                    r = this.s_freg(v);
                    this.s_mi2(M_XMOV, sz, this.s_mo_r(r, sz), dst);
                    x.res.fo = fo;
                    ->;
                };
                if (et.kind != LK.INT & et.kind != LK.PTR) { this.s_fail(g"insert type\0"); ->; };
                if (et.kind == LK.INT)
                {
                    if (et.width > 64) { this.s_fail(g"wide insert\0"); ->; };
                };
                this.s_mi2(M_MOV, sz, this.s_srci(x.b, sz), dst);
                x.res.fo = fo;
                ->;
            };

            s_agg_load(SI* x) -> void
            {
                int sz = this.a_size(x.ty);
                int fo = this.s_newfo(sz, this.a_align(x.ty));
                MO* src = this.s_addr(x.a);
                this.s_copy(this.s_mo_mem(0 - 1, 0 - 1, 1, (i64)0, (byte*)0, fo - 1), src, sz);
                x.res.fo = fo;
                ->;
            };

            s_agg_store(SI* x) -> void
            {
                this.s_agg_to(this.s_res(x.a), this.s_addr(x.b));
                ->;
            };

            // Loads sz bytes at m zero extended into register d
            s_ldz(MO* m, int sz, int d) -> void
            {
                if (sz < 4) { this.s_mi2(M_MOVZX, sz, this.s_mo_copy(m), this.s_mo_r(d, 4)); ->; };
                this.s_mi2(M_MOV, sz, this.s_mo_copy(m), this.s_mo_r(d, sz));
                ->;
            };

            // Register holding the n bytes at m (n from 1 to 8) as one zero extended value, every
            // byte is read exactly once or twice and none outside the n
            s_bf_raw(MO* m, int n) -> int
            {
                int p = n;
                int d = this.s_nv(0);
                int hi;
                if (n == 3) { p = 2; };
                if (n == 5 | n == 6 | n == 7) { p = 4; };
                this.s_ldz(m, p, d);
                if (p != n)
                {
                    hi = this.s_nv(0);
                    this.s_ldz(this.s_mo_off(m, n - p), p, hi);
                    this.s_mi3c(M_SHIFT, 8, this.s_mo_r(hi, 8), this.s_mo_i((i64)(8 * (n - p))), this.s_mo_r(hi, 8), S_SHL);
                    this.s_mi3c(M_ALU, 8, this.s_mo_r(d, 8), this.s_mo_r(hi, 8), this.s_mo_r(d, 8), A_OR);
                };
                -> d;
            };

            // Operand for a 64 bit mask
            s_mask(i64 v) -> MO*
            {
                if (v >= (i64)-2147483648 & v <= (i64)2147483647) { -> this.s_mo_i(v); };
                -> this.s_mo_r(this.s_imm(v), 8);
            };

            // The 64 bits that start sh bits (1 to 7) into the 9 bytes at m, as one number
            s_bf_win(MO* m, int sh) -> int
            {
                int a = this.s_bswap64(this.s_bf_raw(m, 8));
                int b = this.s_nv(0);
                this.s_mi3c(M_SHIFT, 8, this.s_mo_r(a, 8), this.s_mo_i((i64)sh), this.s_mo_r(a, 8), S_SHL);
                this.s_ldz(this.s_mo_off(m, 8), 1, b);
                this.s_mi3c(M_SHIFT, 8, this.s_mo_r(b, 8), this.s_mo_i((i64)(8 - sh)), this.s_mo_r(b, 8), S_SHR);
                this.s_mi3c(M_ALU, 8, this.s_mo_r(a, 8), this.s_mo_r(b, 8), this.s_mo_r(a, 8), A_OR);
                -> a;
            };

            // Bit field of width w that starts sh bits (1 to 7) into 9 bytes: the first 8 bytes and the last
            s_bf_write9(MO* m, int sh, int w, int v) -> void
            {
                int win, t, a, b, c;
                i64 fm = (i64)0 - (i64)1;
                win = this.s_bf_win(m, sh);
                t = this.s_nv(0);
                this.s_mov(this.s_mo_r(v, 8), t, 8);
                if (w < 64)
                {
                    fm = ((i64)1 << (i64)w) - (i64)1;
                    this.s_mi3c(M_ALU, 8, this.s_mo_r(t, 8), this.s_mask(fm), this.s_mo_r(t, 8), A_AND);
                    this.s_mi3c(M_SHIFT, 8, this.s_mo_r(t, 8), this.s_mo_i((i64)(64 - w)), this.s_mo_r(t, 8), S_SHL);
                    fm = fm << (i64)(64 - w);
                };
                fm = (i64)0 - (i64)1 - fm;
                this.s_mi3c(M_ALU, 8, this.s_mo_r(win, 8), this.s_mask(fm), this.s_mo_r(win, 8), A_AND);
                this.s_mi3c(M_ALU, 8, this.s_mo_r(win, 8), this.s_mo_r(t, 8), this.s_mo_r(win, 8), A_OR);
                // first 8 bytes: keep the top sh bits, the rest comes from the high part of win
                a = this.s_bswap64(this.s_bf_raw(m, 8));
                this.s_mi3c(M_SHIFT, 8, this.s_mo_r(a, 8), this.s_mo_i((i64)(64 - sh)), this.s_mo_r(a, 8), S_SHR);
                this.s_mi3c(M_SHIFT, 8, this.s_mo_r(a, 8), this.s_mo_i((i64)(64 - sh)), this.s_mo_r(a, 8), S_SHL);
                t = this.s_nv(0);
                this.s_mi3c(M_SHIFT, 8, this.s_mo_r(win, 8), this.s_mo_i((i64)sh), this.s_mo_r(t, 8), S_SHR);
                this.s_mi3c(M_ALU, 8, this.s_mo_r(a, 8), this.s_mo_r(t, 8), this.s_mo_r(a, 8), A_OR);
                c = this.s_bswap64(a);
                this.s_mi2(M_MOV, 8, this.s_mo_r(c, 8), this.s_mo_copy(m));
                // last byte: keep its low 8 - sh bits, the top sh bits come from the low bits of win
                b = this.s_nv(0);
                this.s_ldz(this.s_mo_off(m, 8), 1, b);
                this.s_mi3c(M_ALU, 8, this.s_mo_r(b, 8), this.s_mo_i((i64)((1 << (8 - sh)) - 1)), this.s_mo_r(b, 8), A_AND);
                t = this.s_nv(0);
                this.s_mi3c(M_SHIFT, 8, this.s_mo_r(win, 8), this.s_mo_i((i64)(8 - sh)), this.s_mo_r(t, 8), S_SHL);
                this.s_mi3c(M_ALU, 8, this.s_mo_r(t, 8), this.s_mo_i((i64)255), this.s_mo_r(t, 8), A_AND);
                this.s_mi3c(M_ALU, 8, this.s_mo_r(b, 8), this.s_mo_r(t, 8), this.s_mo_r(b, 8), A_OR);
                this.s_mi2(M_MOV, 1, this.s_mo_r(b, 1), this.s_mo_off(m, 8));
                ->;
            };

            // Byte reverse of the 64 bit register r into a new register
            s_bswap64(int r) -> int
            {
                int d = this.s_nv(0);
                MI* m = this.s_mi2(M_UN, 8, this.s_mo_r(r, 8), this.s_mo_r(d, 8));
                m.cc = U_BSWAP;
                -> d;
            };

            // Value of the bit field of width w that starts sh bits into the bytes at m. Bit 0 of the
            // bytes is the most significant bit of the first byte, so the n bytes read as one big endian
            // number whose top bits are the field.
            s_bf_read_top(MO* m, int sh, int w) -> int
            {
                int n = (sh + w + 7) / 8;
                int d, b;
                if (n > 9) { this.s_fail(g"bit field spans more than 9 bytes\0"); -> this.s_nv(0); };
                if (n == 9)
                {
                    b = this.s_bf_win(m, sh);
                    if (w < 64) { this.s_mi3c(M_SHIFT, 8, this.s_mo_r(b, 8), this.s_mo_i((i64)(64 - w)), this.s_mo_r(b, 8), S_SHR); };
                    -> b;
                };
                d = this.s_bf_raw(m, n);
                b = this.s_bswap64(d);
                this.s_mi3c(M_SHIFT, 8, this.s_mo_r(b, 8), this.s_mo_i((i64)(64 - sh - w)), this.s_mo_r(b, 8), S_SHR);
                if (w < 64) { this.s_mi3c(M_ALU, 8, this.s_mo_r(b, 8), this.s_mask(((i64)1 << (i64)w) - (i64)1), this.s_mo_r(b, 8), A_AND); };
                -> b;
            };

            // Bit field write through the left aligned 64 bit window, for fields that span 3, 5, 6 or 7 bytes
            s_bf_write_top(MO* m, int sh, int w, int v) -> void
            {
                int n = (sh + w + 7) / 8;
                int p = n;
                int o, t, hi, lo;
                i64 fm = (i64)0 - (i64)1;
                if (n > 9) { this.s_fail(g"bit field spans more than 9 bytes\0"); ->; };
                if (n == 9) { this.s_bf_write9(m, sh, w, v); ->; };
                if (w < 64) { fm = ((i64)1 << (i64)w) - (i64)1; };
                o = this.s_bswap64(this.s_bf_raw(m, n));
                t = this.s_nv(0);
                this.s_mov(this.s_mo_r(v, 8), t, 8);
                if (w < 64) { this.s_mi3c(M_ALU, 8, this.s_mo_r(t, 8), this.s_mask(fm), this.s_mo_r(t, 8), A_AND); };
                if (sh + w < 64)
                {
                    this.s_mi3c(M_SHIFT, 8, this.s_mo_r(t, 8), this.s_mo_i((i64)(64 - sh - w)), this.s_mo_r(t, 8), S_SHL);
                    fm = fm << (i64)(64 - sh - w);
                };
                fm = (i64)0 - (i64)1 - fm;
                this.s_mi3c(M_ALU, 8, this.s_mo_r(o, 8), this.s_mask(fm), this.s_mo_r(o, 8), A_AND);
                this.s_mi3c(M_ALU, 8, this.s_mo_r(o, 8), this.s_mo_r(t, 8), this.s_mo_r(o, 8), A_OR);
                lo = this.s_bswap64(o);
                if (n == 3) { p = 2; };
                if (n == 5 | n == 6 | n == 7) { p = 4; };
                this.s_mi2(M_MOV, p, this.s_mo_r(lo, p), this.s_mo_copy(m));
                if (p != n)
                {
                    hi = this.s_nv(0);
                    this.s_mi3c(M_SHIFT, 8, this.s_mo_r(lo, 8), this.s_mo_i((i64)(8 * (n - p))), this.s_mo_r(hi, 8), S_SHR);
                    this.s_mi2(M_MOV, p, this.s_mo_r(hi, p), this.s_mo_off(m, n - p));
                };
                ->;
            };

            // Byte sized read modify write of memory: m = m op src
            s_rmw(MO* src, MO* m, int op) -> void
            {
                MI* u = this.s_mi2(M_RMW, 1, src, m);
                u.cc = op;
                ->;
            };

            // The n bytes at m (1 to 8) as one big endian number. Right aligned in the register when n is 1, 2, 4 or 8
            // (bf_bits is 8n), else left aligned in 64 bits (bf_bits is 64).
            s_bf_be(MO* m, int n) -> int
            {
                int d = this.s_nv(0);
                MI* u;
                this.bf_bits = 64;
                if (n == 1)
                {
                    this.s_ldz(m, 1, d);
                    this.bf_bits = 8;
                    -> d;
                };
                if (n == 2)
                {
                    this.s_ldz(m, 2, d);
                    u = this.s_mi2(M_UN, 2, this.s_mo_r(d, 2), this.s_mo_r(d, 2));
                    u.cc = U_BSWAP;
                    this.bf_bits = 16;
                    -> d;
                };
                if (n == 4 | n == 8)
                {
                    this.bf_bits = 8 * n;
                    if ((this.feat `& XF_MOVBE) != 0)
                    {
                        u = this.s_mi2(M_UN, n, this.s_mo_copy(m), this.s_mo_r(d, n));
                        u.cc = U_MOVBE;
                        -> d;
                    };
                    this.s_ldz(m, n, d);
                    u = this.s_mi2(M_UN, n, this.s_mo_r(d, n), this.s_mo_r(d, n));
                    u.cc = U_BSWAP;
                    -> d;
                };
                -> this.s_bswap64(this.s_bf_raw(m, n));
            };

            // Stores the n bytes (1, 2, 4 or 8) of register r as a big endian number at m
            s_bf_put(MO* m, int n, int r) -> void
            {
                int t;
                MI* u;
                if (n == 1)
                {
                    this.s_mi2(M_MOV, 1, this.s_mo_r(r, 1), this.s_mo_copy(m));
                    ->;
                };
                if (n >= 4 | n == 2)
                {
                    if ((this.feat `& XF_MOVBE) != 0)
                    {
                        u = this.s_mi2(M_UN, n, this.s_mo_r(r, n), this.s_mo_copy(m));
                        u.cc = U_MOVBE;
                        ->;
                    };
                };
                t = this.s_nv(0);
                this.s_mov(this.s_mo_r(r, 8), t, 8);
                u = this.s_mi2(M_UN, n, this.s_mo_r(t, n), this.s_mo_r(t, n));
                u.cc = U_BSWAP;
                this.s_mi2(M_MOV, n, this.s_mo_r(t, n), this.s_mo_copy(m));
                ->;
            };

            // Keeps the low w bits of register r, zero extended
            s_bf_trunc(int r, int w) -> void
            {
                MI* mv;
                if (w >= 64) { ->; };
                if (w == 8) { this.s_mi2(M_MOVZX, 1, this.s_mo_r(r, 1), this.s_mo_r(r, 4)); ->; };
                if (w == 16) { this.s_mi2(M_MOVZX, 2, this.s_mo_r(r, 2), this.s_mo_r(r, 4)); ->; };
                if (w == 32)
                {
                    // a move of a register onto itself is dropped unless it is marked to clear the upper half
                    mv = this.s_mi2(M_MOV, 4, this.s_mo_r(r, 4), this.s_mo_r(r, 4));
                    mv.cc = 1;
                    ->;
                };
                this.s_mi3c(M_ALU, 8, this.s_mo_r(r, 8), this.s_mask(((i64)1 << (i64)w) - (i64)1), this.s_mo_r(r, 8), A_AND);
                ->;
            };

            // Value of the bit field of width w that starts sh bits into the bytes at m. Bit 0 of the
            // bytes is the most significant bit of the first byte, so the n bytes read as one big endian
            // number whose top bits are the field.
            s_bf_read(MO* m, int sh, int w) -> int
            {
                int n = (sh + w + 7) / 8;
                int b, down;
                if (n > 9) { this.s_fail(g"bit field spans more than 9 bytes\0"); -> this.s_nv(0); };
                if (n == 9) { -> this.s_bf_read_top(m, sh, w); };
                b = this.s_bf_be(m, n);
                down = this.bf_bits - sh - w;
                if (down > 0) { this.s_mi3c(M_SHIFT, 8, this.s_mo_r(b, 8), this.s_mo_i((i64)down), this.s_mo_r(b, 8), S_SHR); };
                // the bits in front of the field are only there when it does not start at the first bit
                if (sh > 0) { this.s_bf_trunc(b, w); };
                -> b;
            };

            // Stores the constant val (low w bits) into the bit field that starts sh bits into the bytes at m, byte by byte:
            // a whole byte is stored, a partial byte is cleared and set in memory.
            s_bf_write_c(MO* m, int sh, int w, i64 val) -> void
            {
                int n = (sh + w + 7) / 8;
                int bi, lo, hi, len, kend, r, j, bm;
                i64 fv, bv, run;
                bool ok;
                if (w < 64) { val = val `& (((i64)1 << (i64)w) - (i64)1); };
                bi = 0;
                while (bi < n)
                {
                    lo = sh - 8 * bi;
                    if (lo < 0) { lo = 0; };
                    hi = sh + w - 8 * bi;
                    if (hi > 8) { hi = 8; };
                    len = hi - lo;
                    // the field bits (counted from its first bit) the byte takes
                    kend = 8 * bi + hi - sh;
                    fv = val >> (i64)(w - kend);
                    if (len < 64) { fv = fv `& (((i64)1 << (i64)len) - (i64)1); };
                    bv = fv << (i64)(8 - hi);
                    bm = (((1 << len) - 1) << (8 - hi));
                    if (len == 8)
                    {
                        // a run of whole bytes goes out in one store
                        r = 1;
                        run = bv;
                        if (bi + 3 < n & n - bi >= 4)
                        {
                            ok = true;
                            j = 1;
                            while (j < 4)
                            {
                                if (sh > 8 * (bi + j) | sh + w < 8 * (bi + j + 1)) { ok = false; };
                                j++;
                            };
                            if (ok) { r = 4; };
                        };
                        if (r == 1 & bi + 1 < n)
                        {
                            if (sh <= 8 * (bi + 1) & sh + w >= 8 * (bi + 2)) { r = 2; };
                        };
                        if (r > 1)
                        {
                            run = (i64)0;
                            j = 0;
                            while (j < r)
                            {
                                kend = 8 * (bi + j) + 8 - sh;
                                fv = (val >> (i64)(w - kend)) `& (i64)255;
                                run = run `| (fv << (i64)(8 * j));
                                j++;
                            };
                            // the first byte is the lowest address, so it is the lowest byte of the number
                            this.s_mi2(M_MOV, r, this.s_mo_i(run), this.s_mo_off(m, bi));
                            bi = bi + r;
                            continue;
                        };
                        this.s_mi2(M_MOV, 1, this.s_mo_i(bv), this.s_mo_off(m, bi));
                        bi++;
                        continue;
                    };
                    if (fv == (i64)0)
                    {
                        this.s_rmw(this.s_mo_i((i64)(255 - bm)), this.s_mo_off(m, bi), A_AND);
                    }
                    else
                    {
                        if (fv != (((i64)1 << (i64)len) - (i64)1))
                        {
                            this.s_rmw(this.s_mo_i((i64)(255 - bm)), this.s_mo_off(m, bi), A_AND);
                        };
                        this.s_rmw(this.s_mo_i(bv), this.s_mo_off(m, bi), A_OR);
                    };
                    bi++;
                };
                ->;
            };

            // Stores the low w bits of register v into the bit field that starts sh bits into the bytes at m,
            // the other bits of those bytes are kept
            s_bf_write(MO* m, int sh, int w, int v) -> void
            {
                int n = (sh + w + 7) / 8;
                int t, o, bits, up;
                i64 fm = (i64)0 - (i64)1;
                int sz;
                if (n > 9) { this.s_fail(g"bit field spans more than 9 bytes\0"); ->; };
                if (n == 9 | n == 3 | n == 5 | n == 6 | n == 7) { this.s_bf_write_top(m, sh, w, v); ->; };
                // a field that fills its bytes is stored as it is
                if (sh == 0 & w == 8 * n)
                {
                    this.s_bf_put(m, n, v);
                    ->;
                };
                if (w < 64) { fm = ((i64)1 << (i64)w) - (i64)1; };
                t = this.s_nv(0);
                this.s_mov(this.s_mo_r(v, 8), t, 8);
                if (n == 1)
                {
                    // inside one byte: clear the field in memory and or the new bits in
                    up = 8 - sh - w;
                    this.s_mi3c(M_ALU, 4, this.s_mo_r(t, 4), this.s_mo_i(fm), this.s_mo_r(t, 4), A_AND);
                    if (up > 0) { this.s_mi3c(M_SHIFT, 4, this.s_mo_r(t, 4), this.s_mo_i((i64)up), this.s_mo_r(t, 4), S_SHL); };
                    this.s_rmw(this.s_mo_i((i64)(255 - (((1 << w) - 1) << up))), this.s_mo_copy(m), A_AND);
                    this.s_rmw(this.s_mo_r(t, 1), this.s_mo_copy(m), A_OR);
                    ->;
                };
                // 2, 4 or 8 bytes: the big endian number, field replaced, stored back
                o = this.s_bf_be(m, n);
                bits = this.bf_bits;
                sz = 8;
                if (bits < 64) { sz = 4; };
                up = bits - sh - w;
                if (w < 64) { this.s_mi3c(M_ALU, sz, this.s_mo_r(t, sz), this.s_mask(fm), this.s_mo_r(t, sz), A_AND); };
                if (up > 0)
                {
                    this.s_mi3c(M_SHIFT, sz, this.s_mo_r(t, sz), this.s_mo_i((i64)up), this.s_mo_r(t, sz), S_SHL);
                    fm = fm << (i64)up;
                };
                fm = (i64)0 - (i64)1 - fm;
                if (bits < 64) { fm = fm `& (((i64)1 << (i64)bits) - (i64)1); };
                this.s_mi3c(M_ALU, sz, this.s_mo_r(o, sz), this.s_mask(fm), this.s_mo_r(o, sz), A_AND);
                this.s_mi3c(M_ALU, sz, this.s_mo_r(o, sz), this.s_mo_r(t, sz), this.s_mo_r(o, sz), A_OR);
                this.s_bf_put(m, n, o);
                ->;
            };

            s_isel_load(SI* x) -> void
            {
                IRType* t = x.ty;
                MO* m;
                int sz, d, r;
                if (this.s_isfp(t)) { this.s_fp_load(x); ->; };
                if (this.s_isagg(t)) { this.s_agg_load(x); ->; };
                if (t.kind != LK.INT & t.kind != LK.PTR) { this.s_fail(g"load type\0"); ->; };
                if (t.kind == LK.INT)
                {
                    if (t.width > 64) { this.s_fail(g"wide load\0"); ->; };
                };
                sz = this.s_vsz(t);
                this.bf_w = 0;
                m = this.s_addr(x.a);
                if (this.bf_w > 0)
                {
                    r = this.s_bf_read(m, this.bf_sh, this.bf_w);
                    d = this.s_def(x.res, 0);
                    this.s_mov(this.s_mo_r(r, 8), d, 8);
                    ->;
                };
                d = this.s_def(x.res, 0);
                if (sz < 4) { this.s_mi2(M_MOVZX, sz, m, this.s_mo_r(d, 4)); ->; };
                this.s_mi2(M_MOV, sz, m, this.s_mo_r(d, sz));
                ->;
            };

            s_isel_store(SI* x) -> void
            {
                IRType* t = x.ty;
                MO* m;
                MO* s;
                int sz, r;
                if (this.s_isfp(t)) { this.s_fp_store(x); ->; };
                if (this.s_isagg(t)) { this.s_agg_store(x); ->; };
                if (t.kind != LK.INT & t.kind != LK.PTR) { this.s_fail(g"store type\0"); ->; };
                if (t.kind == LK.INT)
                {
                    if (t.width > 64) { this.s_fail(g"wide store\0"); ->; };
                };
                sz = this.s_vsz(t);
                this.bf_w = 0;
                if (x.b.vr == 0 & x.b.di != (void*)0)
                {
                    // a folded address may name a bit packed member
                    m = this.s_addr(x.b);
                    if (this.bf_w > 0)
                    {
                        if (this.s_isint(x.a) & this.bf_w + this.bf_sh <= 64)
                        {
                            this.s_bf_write_c(m, this.bf_sh, this.bf_w, this.scv);
                            ->;
                        };
                        r = this.s_reg(x.a);
                        this.s_bf_write(m, this.bf_sh, this.bf_w, r);
                        ->;
                    };
                    s = this.s_srci(x.a, sz);
                    this.s_mi2(M_MOV, sz, s, m);
                    ->;
                };
                s = this.s_srci(x.a, sz);
                m = this.s_addr(x.b);
                this.s_mi2(M_MOV, sz, s, m);
                ->;
            };

            s_isel_gep(SI* x) -> void
            {
                MO* m;
                int d;
                if (x.flag) { ->; };
                m = this.s_gepmem(x);
                if (this.bf_w > 0) { this.s_fail(g"address of a bit packed member\0"); ->; };
                if (m.r2 < 0 & m.fo < 0 & m.sym == (byte*)0 & m.imm == (i64)0 & m.r >= 0)
                {
                    // the address is the base register
                    d = this.s_def(x.res, 0);
                    this.s_mov(this.s_mo_r(m.r, 8), d, 8);
                    ->;
                };
                d = this.s_def(x.res, 0);
                this.s_mi2(M_LEA, 8, m, this.s_mo_r(d, 8));
                ->;
            };

            s_isel_select(SI* x) -> void
            {
                IRType* t = x.ty;
                int sz, ra, rb, d, cc;
                MI* m;
                IRValue* c = this.s_res(x.a);
                if (this.s_isfp(t)) { this.s_fp_select(x); ->; };
                if (t.kind != LK.INT & t.kind != LK.PTR) { this.s_fail(g"select type\0"); ->; };
                if (t.kind == LK.INT)
                {
                    if (t.width > 64) { this.s_fail(g"wide select\0"); ->; };
                };
                sz = this.s_asz(t);
                if (this.s_isint(c))
                {
                    d = this.s_def(x.res, 0);
                    if (this.scv != (i64)0) { this.s_mov(this.s_src(x.b), d, sz); } else { this.s_mov(this.s_src(x.c), d, sz); };
                    ->;
                };
                ra = this.s_reg(x.b);
                rb = this.s_reg(x.c);
                cc = this.s_cond(c);
                d = this.s_def(x.res, 0);
                m = this.s_mi3(M_CMOV, sz, this.s_mo_r(ra, sz), this.s_mo_r(rb, sz), this.s_mo_r(d, sz));
                m.cc = cc;
                ->;
            };

            // ==========================================================
            // calls, returns, branches, phis, parameters and the selection driver over
            // the blocks of a function.
            // ==========================================================

            // ----------------------------------------------------------
            // Calling convention
            // ----------------------------------------------------------

            // Hardware register of integer argument position i, or -1
            s_argreg(int i) -> int
            {
                if (this.a_win())
                {
                    if (i == 0) { -> 1; };
                    if (i == 1) { -> 2; };
                    if (i == 2) { -> 8; };
                    if (i == 3) { -> 9; };
                    -> 0 - 1;
                };
                if (i == 0) { -> 7; };
                if (i == 1) { -> 6; };
                if (i == 2) { -> 2; };
                if (i == 3) { -> 1; };
                if (i == 4) { -> 8; };
                if (i == 5) { -> 9; };
                -> 0 - 1;
            };

            // Registers a call may overwrite
            s_clob() -> int
            {
                if (this.a_win()) { -> 1 `| 2 `| 4 `| 256 `| 512 `| 1024 `| 2048 `| (63 << 16); };
                -> 1 `| 2 `| 4 `| 64 `| 128 `| 256 `| 512 `| 1024 `| 2048 `| (65535 << 16);
            };

            // True when t is passed or returned in memory: the arguments sit in the outgoing area, the result is
            // written through a hidden pointer in rdi
            s_isag(IRType* t) -> bool
            {
                -> this.s_isagg(t);
            };

            // True when t is a type the selector passes in an integer register
            s_isarg(IRType* t) -> bool
            {
                if (t.kind == LK.PTR) { -> true; };
                if (t.kind == LK.INT) { -> t.width <= 64; };
                if (t.kind == LK.FLOAT | t.kind == LK.DOUBLE) { -> true; };
                -> false;
            };

            // Place of argument i: a register, or 0 - 1 for the stack with its offset in splo. st holds the
            // integer registers used, the xmm registers used and the stack bytes used so far.
            s_place(int i, bool fp, int* st) -> int
            {
                int r;
                if (this.a_win())
                {
                    this.splo = 8 * i;
                    if (i >= 4) { -> 0 - 1; };
                    if (fp) { -> 16 + i; };
                    -> this.s_argreg(i);
                };
                if (fp)
                {
                    if (st[1] < 8)
                    {
                        r = 16 + st[1];
                        st[1] = st[1] + 1;
                        -> r;
                    };
                }
                else
                {
                    r = this.s_argreg(st[0]);
                    if (r >= 0)
                    {
                        st[0] = st[0] + 1;
                        -> r;
                    };
                };
                this.splo = st[2];
                st[2] = st[2] + 8;
                -> 0 - 1;
            };

            // ----------------------------------------------------------
            // Uses and lazy values
            // ----------------------------------------------------------

            // Block number of every instruction and the single user of the values with one use
            s_users() -> void
            {
                GF* g = this.sf;
                int i, j, k, n, pos;
                GB* gb;
                SI* x;
                IRValue* v;
                pos = 0;
                i = 0;
                while (i < g.nb)
                {
                    gb = (GB*)g.bl.items[i];
                    if (gb.ib.insts != (PtrVec*)0)
                    {
                        j = 0;
                        while (j < gb.ib.insts.len)
                        {
                            x = (SI*)gb.ib.insts.items[j];
                            x.bi = i;
                            x.pos = pos;
                            pos++;
                            n = this.s_nops(x);
                            k = 0;
                            while (k < n)
                            {
                                v = this.s_op(x, k);
                                if (v.nu == 1) { v.ui = (void*)x; };
                                k++;
                            };
                            j++;
                        };
                    };
                    i++;
                };
                ->;
            };

            // The single use instruction that defines v, when it is an integer operation of u's block whose only user is u
            s_innr(IRValue* v, SI* u) -> SI*
            {
                IRValue* r = this.s_res(v);
                SI* d;
                if (r.di == (void*)0) { -> (SI*)0; };
                d = (SI*)r.di;
                if (d.op != SO_BIN | d.vol) { -> (SI*)0; };
                if (r.nu != 1 | r.ui != (void*)u | d.bi != u.bi) { -> (SI*)0; };
                if (d.k >= SB_FADD) { -> (SI*)0; };
                -> d;
            };

            // True when v is the constant c at the width w
            s_isk(IRValue* v, i64 c, int w) -> bool
            {
                if (!this.s_cint(v)) { -> false; };
                -> this.a_mask((u64)this.scv, w) == this.a_mask((u64)c, w);
            };

            // Recognizes the bit expressions that have one BMI instruction. Returns 0 for none, else
            //   1 a & ~b    andn: bm_a is b, bm_b is a
            //   2 x & (x - 1)    blsr: bm_a is x
            //   3 x & -x    blsi: bm_a is x
            //   4 x & ((1 << n) - 1)    bzhi: bm_a is x, bm_b is n
            //   5 (x << c) | (x >> (w - c))    rorx: bm_a is x, bm_n the right rotation
            // bm_s1 and bm_s2 are the instructions that fold into u.
            s_bmi(SI* u) -> int
            {
                IRType* t = u.ty;
                IRValue* a;
                IRValue* b;
                IRValue* p;
                IRValue* q;
                IRValue* y;
                IRValue* z;
                SI* d;
                SI* e;
                SI* d2;
                int w, r, k;
                i64 c1, c2;
                this.bm_s1 = (SI*)0;
                this.bm_s2 = (SI*)0;
                if (u.op != SO_BIN | u.vol | u.res == (IRValue*)0) { -> 0; };
                if (t.kind != LK.INT) { -> 0; };
                w = t.width;
                if (w != 32 & w != 64) { -> 0; };
                k = u.k;
                a = this.s_res(u.a);
                b = this.s_res(u.b);
                if (k == SB_AND)
                {
                    p = a;
                    q = b;
                    r = 0;
                    while (r < 2)
                    {
                        r++;
                        d = this.s_innr(q, u);
                        if (d != (SI*)0)
                        {
                            if (d.k == SB_XOR)
                            {
                                y = (IRValue*)0;
                                if (this.s_isk(d.b, (i64)0 - (i64)1, w)) { y = this.s_res(d.a); }
                                elif (this.s_isk(d.a, (i64)0 - (i64)1, w)) { y = this.s_res(d.b); };
                                if (y != (IRValue*)0)
                                {
                                    if (!this.s_cint(y))
                                    {
                                        this.bm_s1 = d;
                                        this.bm_a = y;
                                        this.bm_b = p;
                                        -> 1;
                                    };
                                };
                            };
                            if (d.k == SB_ADD | d.k == SB_SUB)
                            {
                                y = (IRValue*)0;
                                z = (IRValue*)0;
                                if (d.k == SB_ADD)
                                {
                                    if (this.s_isk(d.b, (i64)0 - (i64)1, w)) { y = this.s_res(d.a); }
                                    elif (this.s_isk(d.a, (i64)0 - (i64)1, w)) { y = this.s_res(d.b); };
                                }
                                else
                                {
                                    if (this.s_isk(d.b, (i64)1, w)) { y = this.s_res(d.a); };
                                    if (this.s_isk(d.a, (i64)0, w)) { z = this.s_res(d.b); };
                                };
                                if (z == p & !this.s_cint(p))
                                {
                                    this.bm_s1 = d;
                                    this.bm_a = p;
                                    -> 3;
                                };
                                if (y != (IRValue*)0)
                                {
                                    if (y == p & !this.s_cint(p))
                                    {
                                        this.bm_s1 = d;
                                        this.bm_a = p;
                                        -> 2;
                                    };
                                    e = this.s_innr(y, d);
                                    if (e != (SI*)0)
                                    {
                                        if (e.k == SB_SHL & this.s_isk(e.a, (i64)1, w) & !this.s_cint(e.b))
                                        {
                                            z = this.s_res(e.b);
                                            if (z.ty.kind == LK.INT)
                                            {
                                                if (z.ty.width == w)
                                                {
                                                    this.bm_s1 = d;
                                                    this.bm_s2 = e;
                                                    this.bm_a = p;
                                                    this.bm_b = z;
                                                    -> 4;
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                        p = b;
                        q = a;
                    };
                    -> 0;
                };
                if (k == SB_OR | k == SB_XOR | k == SB_ADD)
                {
                    d = this.s_innr(a, u);
                    e = this.s_innr(b, u);
                    if (d == (SI*)0 | e == (SI*)0) { -> 0; };
                    if (d.k == SB_LSHR & e.k == SB_SHL) { d2 = d; d = e; e = d2; };
                    if (d.k != SB_SHL | e.k != SB_LSHR) { -> 0; };
                    if (this.s_res(d.a) != this.s_res(e.a)) { -> 0; };
                    if (this.s_cint(this.s_res(d.a))) { -> 0; };
                    if (!this.s_cint(d.b)) { -> 0; };
                    c1 = this.scv;
                    if (!this.s_cint(e.b)) { -> 0; };
                    c2 = this.scv;
                    if (c1 <= (i64)0 | c2 <= (i64)0 | c1 + c2 != (i64)w) { -> 0; };
                    this.bm_s1 = d;
                    this.bm_s2 = e;
                    this.bm_a = this.s_res(d.a);
                    this.bm_n = (int)c2;
                    -> 5;
                };
                -> 0;
            };

            // Marks the compares and address computations that are folded into their only user
            s_lazy() -> void
            {
                GF* g = this.sf;
                int i, j;
                GB* gb;
                SI* x;
                SI* u;
                i = 0;
                while (i < g.nb)
                {
                    gb = (GB*)g.bl.items[i];
                    if (gb.ib.insts != (PtrVec*)0)
                    {
                        j = 0;
                        while (j < gb.ib.insts.len)
                        {
                            x = (SI*)gb.ib.insts.items[j];
                            if (SSA_OPT_BMIX == 1 & x.op == SO_BIN)
                            {
                                if (this.s_bmi(x) != 0)
                                {
                                    this.bm_s1.flag = true;
                                    if (this.bm_s2 != (SI*)0) { this.bm_s2.flag = true; };
                                };
                            };
                            if (x.res != (IRValue*)0)
                            {
                                if (x.res.nu == 1 & x.res.ui != (void*)0)
                                {
                                    u = (SI*)x.res.ui;
                                    if (u.bi == x.bi)
                                    {
                                        if (x.op == SO_CMP & (x.n == 0 | this.s_fsingle(x)))
                                        {
                                            if ((u.op == SO_CBR | u.op == SO_SELECT) & u.a == x.res) { x.flag = true; };
                                        };
                                        if (x.op == SO_GEP)
                                        {
                                            if (u.op == SO_LOAD & u.a == x.res) { x.flag = true; };
                                            if (u.op == SO_GEP & u.a == x.res) { x.flag = true; };
                                            if (u.op == SO_STORE & u.b == x.res & u.a != x.res) { x.flag = true; };
                                        };
                                    };
                                };
                            };
                            j++;
                        };
                    };
                    i++;
                };
                ->;
            };

            // True when every index of the address computation x is a constant
            s_gepk(SI* x) -> bool
            {
                int i = 0;
                while (i < x.n)
                {
                    if (!this.s_isc(this.s_res(x.args[i]))) { -> false; };
                    i++;
                };
                -> true;
            };

            // An address with constant indices that several loads and stores of its own block use is folded
            // into each of them, rather than computed once into a register
            s_lazymulti() -> void
            {
                GF* g = this.sf;
                int i, j, k, n;
                GB* gb;
                SI* x;
                SI* d;
                IRValue* v;
                bool ok;
                i = 0;
                while (i < g.nb)
                {
                    gb = (GB*)g.bl.items[i];
                    if (gb.ib.insts != (PtrVec*)0)
                    {
                        j = 0;
                        while (j < gb.ib.insts.len)
                        {
                            x = (SI*)gb.ib.insts.items[j];
                            if (x.op == SO_GEP & x.res != (IRValue*)0) { if (x.res.nu > 1) { x.res.ui = (void*)0; }; };
                            j++;
                        };
                    };
                    i++;
                };
                i = 0;
                while (i < g.nb)
                {
                    gb = (GB*)g.bl.items[i];
                    if (gb.ib.insts != (PtrVec*)0)
                    {
                        j = 0;
                        while (j < gb.ib.insts.len)
                        {
                            x = (SI*)gb.ib.insts.items[j];
                            n = this.s_nops(x);
                            k = 0;
                            while (k < n)
                            {
                                v = this.s_op(x, k);
                                if (v.nu > 1 & v.di != (void*)0)
                                {
                                    d = (SI*)v.di;
                                    if (d.op == SO_GEP & d.res == v)
                                    {
                                        ok = true;
                                        if (ok) { ok = x.op == SO_LOAD | (x.op == SO_STORE & x.a != v) | x.op == SO_GEP; };
                                        if (ok) { if (x.op == SO_GEP) { ok = x.a == v & k == 0; } elif (x.op == SO_LOAD) { ok = x.a == v; } else { ok = x.b == v; }; };
                                        if (ok) { ok = !x.vol | x.op == SO_GEP; };
                                        if (!ok) { v.ui = (void*)1; };
                                    };
                                };
                                k++;
                            };
                            j++;
                        };
                    };
                    i++;
                };
                i = 0;
                while (i < g.nb)
                {
                    gb = (GB*)g.bl.items[i];
                    if (gb.ib.insts != (PtrVec*)0)
                    {
                        j = 0;
                        while (j < gb.ib.insts.len)
                        {
                            x = (SI*)gb.ib.insts.items[j];
                            if (x.op == SO_GEP & x.res != (IRValue*)0)
                            {
                                if (x.res.nu > 1 & x.res.ui == (void*)0)
                                {
                                    if (this.s_gepk(x)) { x.flag = true; };
                                };
                            };
                            j++;
                        };
                    };
                    i++;
                };
                ->;
            };

            // ----------------------------------------------------------
            // Calls and returns
            // ----------------------------------------------------------

            // The llvm intrinsics that become instructions
            s_intrin(SI* x, byte* sym) -> void
            {
                MI* m;
                IRType* t;
                int r, sz;
                int k = 0;
                if (this.a_pre(sym, g"llvm.trap\0")) { this.s_mi(M_UD2, 1); ->; };
                if (this.a_pre(sym, g"llvm.bswap.i\0"))
                {
                    t = x.ty;
                    if (t.kind != LK.INT | x.n != 1) { this.s_fail(sym); ->; };
                    if (t.width != 16 & t.width != 32 & t.width != 64) { this.s_fail(sym); ->; };
                    sz = t.width / 8;
                    r = this.s_reg(this.s_res(x.args[0]));
                    k = this.s_def(x.res, 0);
                    m = this.s_mi2(M_UN, sz, this.s_mo_r(r, sz), this.s_mo_r(k, sz));
                    m.cc = U_BSWAP;
                    ->;
                };
                if (this.a_pre(sym, g"llvm.bitreverse.i\0"))
                {
                    t = x.ty;
                    if (t.kind != LK.INT | x.n != 1) { this.s_fail(sym); ->; };
                    if (t.width != 8 & t.width != 16 & t.width != 32 & t.width != 64) { this.s_fail(sym); ->; };
                    sz = t.width / 8;
                    r = this.s_reg(this.s_res(x.args[0]));
                    k = this.s_def(x.res, 0);
                    this.s_mi2(M_BREV, sz, this.s_mo_r(r, sz), this.s_mo_r(k, sz));
                    ->;
                };
                if (this.a_pre(sym, g"llvm.va_start\0"))
                {
                    r = this.s_reg(this.s_res(x.args[0]));
                    this.s_mi1(M_VASTART, 8, this.s_mo_r(r, 8));
                    ->;
                };
                if (this.a_pre(sym, g"llvm.va_end\0")) { ->; };
                if (this.a_pre(sym, g"llvm.va_copy\0"))
                {
                    r = this.s_reg(this.s_res(x.args[0]));
                    k = this.s_reg(this.s_res(x.args[1]));
                    sz = 24;
                    if (this.a_win()) { sz = 8; };
                    this.s_copy(this.s_mo_mem(r, 0 - 1, 1, (i64)0, (byte*)0, 0 - 1), this.s_mo_mem(k, 0 - 1, 1, (i64)0, (byte*)0, 0 - 1), sz);
                    ->;
                };
                if (this.a_pre(sym, g"llvm.debugtrap\0")) { this.s_mi(M_INT3, 1); ->; };
                if (this.a_pre(sym, g"llvm.memset.\0")) { k = 1; };
                if (this.a_pre(sym, g"llvm.memcpy.\0")) { k = 2; };
                if (this.a_pre(sym, g"llvm.memmove.\0")) { k = 3; };
                if (k == 0 | x.n < 3) { this.s_fail(sym); ->; };
                MO* a0 = this.s_src(x.args[0]);
                MO* a1 = this.s_src(x.args[1]);
                MO* a2 = this.s_src(x.args[2]);
                this.s_mov(a0, 7, 8);
                if (k == 1)
                {
                    this.s_mov(a1, 0, 4);
                    this.s_mov(a2, 1, 8);
                    m = this.s_mi(M_REPSTOS, 1);
                    m.iu = 131;
                    m.id = 131;
                    ->;
                };
                this.s_mov(a1, 6, 8);
                this.s_mov(a2, 1, 8);
                if (k == 2) { m = this.s_mi(M_REPMOVS, 1); }
                else { m = this.s_mi(M_MEMMOVE, 1); };
                m.iu = 194;
                m.id = 194;
                ->;
            };

            s_isel_call(SI* x) -> void
            {
                IRValue* callee = this.s_res(x.a);
                IRType* fty = callee.ty.elem;
                IRType* rt = x.ty;
                IRValue* a;
                MO** sv;
                MO* s;
                MI* m;
                MO* tgt;
                byte* sym;
                int* ploc;
                int* poff;
                int* st;
                int i, p, r, sz, d, stk, mask, nf, rfo, wsh, afo;
                bool direct = false;
                bool fp, tail;
                sym = (byte*)0;
                wsh = 0;
                if (this.a_pre(callee.text, g"asm\0")) { this.s_inline(x, callee); ->; };
                if (fty.kind != LK.FUNC) { this.s_fail(g"callee type\0"); ->; };
                if (rt.kind != LK.VOID & !this.s_isarg(rt) & !this.s_isag(rt)) { this.s_fail(g"call result type\0"); ->; };
                if (rt.kind == LK.INT)
                {
                    if (rt.width > 64) { this.s_fail(g"wide call result\0"); ->; };
                };
                if (callee.vr == 0 & callee.di == (void*)0)
                {
                    if (this.s_isc(callee))
                    {
                        if (this.sck == CK_SYM & this.scv == (i64)0)
                        {
                            direct = true;
                            sym = this.scs;
                        };
                    };
                };
                if (this.gwhy != 0) { ->; };
                if (direct)
                {
                    if (this.a_pre(sym, g"llvm.\0")) { this.s_intrin(x, sym); ->; };
                };
                i = 0;
                while (i < x.n)
                {
                    a = this.s_res(x.args[i]);
                    if (!this.s_isarg(a.ty) & !this.s_isag(a.ty)) { this.s_fail(g"call argument type\0"); ->; };
                    i++;
                };
                // operands first: they may need instructions of their own
                sv = (MO**)this.s_ar(8 * (x.n + 1));
                ploc = this.s_iz(x.n + 1);
                poff = this.s_iz(x.n + 1);
                st = this.s_iz(4);
                nf = 0;
                rfo = 0;
                if (this.s_isag(rt))
                {
                    // the hidden result pointer is the first integer argument: rdi on System V, rcx on Win64
                    if (this.a_win()) { wsh = 1; } else { st[0] = 1; };
                    rfo = this.s_newfo(this.a_size(rt), this.a_align(rt));
                };
                i = 0;
                while (i < x.n)
                {
                    a = this.s_res(x.args[i]);
                    if (this.s_isagg(a.ty) & !this.a_win())
                    {
                        sv[i] = (MO*)0;
                        ploc[i] = 0 - 1;
                        poff[i] = st[2];
                        st[2] = st[2] + (this.a_size(a.ty) + 7) / 8 * 8;
                    }
                    else
                    {
                        if (this.s_isagg(a.ty))
                        {
                            // Win64: the caller makes a copy and passes its address
                            afo = this.s_newfo(this.a_size(a.ty), 8);
                            this.s_agg_to(a, this.s_mo_mem(0 - 1, 0 - 1, 1, (i64)0, (byte*)0, afo - 1));
                            d = this.s_nv(0);
                            this.s_mi2(M_LEA, 8, this.s_mo_mem(0 - 1, 0 - 1, 1, (i64)0, (byte*)0, afo - 1), this.s_mo_r(d, 8));
                            sv[i] = this.s_mo_r(d, 8);
                            ploc[i] = this.s_place(i + wsh, false, st);
                            poff[i] = this.splo;
                            i++;
                            continue;
                        };
                        fp = this.s_isfp(a.ty);
                        s = this.s_src(a);
                        sz = this.s_vsz(a.ty);
                        if (s.k == MK_REG & sz < 4 & !fp) { s = this.s_mo_r(this.s_ext(s.r, sz, false, 4), 4); };
                        sv[i] = s;
                        ploc[i] = this.s_place(i + wsh, fp, st);
                        poff[i] = this.splo;
                        if (fp & ploc[i] >= 0) { nf++; };
                    };
                    i++;
                };
                tgt = (MO*)0;
                if (!direct) { tgt = this.s_mo_r(this.s_reg(callee), 8); };
                if (this.gwhy != 0) { this.s_ifree(ploc); this.s_ifree(poff); this.s_ifree(st); ->; };
                // stack arguments
                stk = st[2];
                if (this.a_win()) { stk = 32; };
                i = 0;
                while (i < x.n)
                {
                    if (ploc[i] < 0)
                    {
                        a = this.s_res(x.args[i]);
                        s = sv[i];
                        if (this.s_isagg(a.ty) & !this.a_win()) { this.s_agg_to(a, this.s_mo_mem(4, 0 - 1, 1, (i64)poff[i], (byte*)0, 0 - 1)); }
                        else
                        {
                            if (s.k == MK_REG) { s = this.s_mo_copy(s); s.sz = 8; };
                            if (this.s_isfp(a.ty)) { this.s_mi2(M_XMOV, this.s_vsz(a.ty), s, this.s_mo_mem(4, 0 - 1, 1, (i64)poff[i], (byte*)0, 0 - 1)); }
                            else { this.s_mi2(M_MOV, 8, s, this.s_mo_mem(4, 0 - 1, 1, (i64)poff[i], (byte*)0, 0 - 1)); };
                        };
                    };
                    i++;
                };
                if (this.a_win())
                {
                    if (x.n + wsh > 4) { stk = 8 * (x.n + wsh); };
                };
                if (stk > this.sf.outmax) { this.sf.outmax = stk; };
                // register arguments
                mask = 0;
                i = 0;
                while (i < x.n)
                {
                    p = ploc[i];
                    if (p >= 0)
                    {
                        a = this.s_res(x.args[i]);
                        s = sv[i];
                        if (s.k == MK_REG) { s = this.s_mo_copy(s); s.sz = 8; };
                        if (this.s_isfp(a.ty))
                        {
                            this.s_mi2(M_XMOV, this.s_vsz(a.ty), s, this.s_mo_r(p, 8));
                            // a variable argument list reads floats from the integer registers on Win64
                            if (this.a_win() & fty.vararg)
                            {
                                this.s_mi2(M_GX, 8, this.s_mo_r(p, 8), this.s_mo_r(this.s_argreg(i + wsh), 8));
                                mask = mask `| (1 << this.s_argreg(i + wsh));
                            };
                        }
                        else { this.s_mov(s, p, 8); };
                        mask = mask `| (1 << p);
                    };
                    i++;
                };
                if (rfo > 0)
                {
                    if (this.a_win())
                    {
                        this.s_mi2(M_LEA, 8, this.s_mo_mem(0 - 1, 0 - 1, 1, (i64)0, (byte*)0, rfo - 1), this.s_mo_r(1, 8));
                        mask = mask `| 2;
                    }
                    else
                    {
                        this.s_mi2(M_LEA, 8, this.s_mo_mem(0 - 1, 0 - 1, 1, (i64)0, (byte*)0, rfo - 1), this.s_mo_r(7, 8));
                        mask = mask `| 128;
                    };
                };
                if (fty.vararg)
                {
                    if (this.a_win()) { this.s_mov(this.s_mo_i((i64)0), 0, 4); }
                    else { this.s_mov(this.s_mo_i((i64)nf), 0, 4); };
                    mask = mask `| 1;
                };
                m = this.s_mi(M_CALL, 8);
                if (direct) { m.o0 = this.s_mo_sym(sym); } else { m.o0 = tgt; };
                m.iu = mask;
                m.clob = this.s_clob();
                tail = false;
                if (SSA_OPT_TAILCALL == 1 & direct & !this.a_win() & stk == 0 & rfo == 0 & !this.hasal & !this.sf.dyn & this.nxti != (SI*)0)
                {
                    if (this.sf.vafo == 0 & this.sf.vagp == 0 & this.sf.vafp == 0 & this.sf.vastk == 0)
                    {
                        if (rt.kind == LK.VOID)
                        {
                            if (this.nxti.op == SO_RETV) { tail = true; };
                        }
                        else
                        {
                            if (this.nxti.op == SO_RET & x.res.nu == 1 & !this.s_isag(rt) & (rt.kind != LK.INT | rt.width >= 32))
                            {
                                if (this.s_res(this.nxti.a) == x.res) { tail = true; };
                            };
                        };
                    };
                };
                if (tail)
                {
                    // the call and the return that follows it become one jump
                    m.tgt = 77;
                    m = this.s_mi(M_RET, 0);
                    m.iu = 1;
                    if (rt.kind == LK.FLOAT | rt.kind == LK.DOUBLE) { m.iu = 1 << 16; };
                    this.skipn = true;
                    this.s_ifree(ploc);
                    this.s_ifree(poff);
                    this.s_ifree(st);
                    ->;
                };
                if (rfo > 0) { x.res.fo = rfo; };
                if (rt.kind != LK.VOID & rfo == 0)
                {
                    sz = this.s_vsz(rt);
                    if (this.s_isfp(rt))
                    {
                        d = this.s_def(x.res, 1);
                        this.s_mi2(M_XMOV, sz, this.s_mo_r(16, 8), this.s_mo_r(d, sz));
                    }
                    else
                    {
                        d = this.s_def(x.res, 0);
                        if (sz == 1 & SSA_OPT_CALLBOOL == 1 & x.res.nu == 1 & x.res.ui != (void*)0 & ((SI*)x.res.ui).op == SO_CBR) { this.s_mov(this.s_mo_r(0, sz), d, sz); }
                        else if (sz < 4) { this.s_mi2(M_MOVZX, sz, this.s_mo_r(0, sz), this.s_mo_r(d, 4)); }
                        else { this.s_mov(this.s_mo_r(0, sz), d, sz); };
                    };
                };
                this.s_ifree(ploc);
                this.s_ifree(poff);
                this.s_ifree(st);
                ->;
            };

            s_isel_vaarg(SI* x) -> void
            {
                IRType* t = x.ty;
                MI* m;
                int r, d, sz;
                if (this.s_isagg(t)) { this.s_fail(g"va_arg of an aggregate\0"); ->; };
                if (!this.s_isarg(t)) { this.s_fail(g"va_arg type\0"); ->; };
                r = this.s_reg(this.s_res(x.a));
                sz = this.s_vsz(t);
                if (this.s_isfp(t))
                {
                    d = this.s_def(x.res, 1);
                    m = this.s_mi2(M_VAARG, sz, this.s_mo_r(r, 8), this.s_mo_r(d, sz));
                    m.cc = 1;
                    ->;
                };
                d = this.s_def(x.res, 0);
                m = this.s_mi2(M_VAARG, sz, this.s_mo_r(r, 8), this.s_mo_r(d, sz));
                m.cc = 0;
                ->;
            };

            s_isel_ret(SI* x) -> void
            {
                IRType* t = x.ty;
                MO* s;
                MI* m;
                int sz;
                if (!this.s_isarg(t) & !this.s_isag(t)) { this.s_fail(g"return type\0"); ->; };
                if (this.s_isagg(t))
                {
                    this.s_agg_to(this.s_res(x.a), this.s_mo_mem(this.sf.sretv, 0 - 1, 1, (i64)0, (byte*)0, 0 - 1));
                    this.s_mov(this.s_mo_r(this.sf.sretv, 8), 0, 8);
                    m = this.s_mi(M_RET, 0);
                    m.iu = 1;
                    ->;
                };
                sz = this.s_vsz(t);
                if (this.s_isfp(t))
                {
                    s = this.s_src(x.a);
                    s = this.s_mo_copy(s);
                    s.sz = 8;
                    this.s_mi2(M_XMOV, sz, s, this.s_mo_r(16, 8));
                    m = this.s_mi(M_RET, 0);
                    m.iu = 1 << 16;
                    ->;
                };
                s = this.s_src(x.a);
                if (s.k == MK_REG & sz < 4) { s = this.s_mo_r(this.s_ext(s.r, sz, false, 4), 4); sz = 4; };
                if (s.k == MK_REG) { s = this.s_mo_copy(s); s.sz = sz; };
                this.s_mov(s, 0, sz);
                m = this.s_mi(M_RET, 0);
                m.iu = 1;
                ->;
            };

            // ----------------------------------------------------------
            // Branches
            // ----------------------------------------------------------

            s_isel_br(SI* x) -> void
            {
                this.s_mi1(M_JMP, 0, this.s_mo_blk(x.t.id));
                ->;
            };

            s_isel_cbr(SI* x) -> void
            {
                MI* m;
                int cc = this.s_cond(x.a);
                if (x.k == 1) { cc = this.s_invcc(cc); };
                m = this.s_mi1(M_JCC, 0, this.s_mo_blk(x.t.id));
                m.cc = cc;
                this.s_mi1(M_JMP, 0, this.s_mo_blk(x.f.id));
                ->;
            };

            // A switch of up to four cases compares in order, any other is a jump table over the range of its case values, the holes go to the default
            s_isel_switch(SI* x) -> void
            {
                IRType* t = x.a.ty;
                int sz, r, i, k, cnt;
                MI* m;
                IRValue* cv;
                u64 lo, hi, c;
                i64 sv;
                bool ok;
                int* tab;
                if (t.kind != LK.INT | t.width > 64) { this.s_fail(g"switch type\0"); ->; };
                if (x.n < 1) { this.s_mi1(M_JMP, 0, this.s_mo_blk(x.f.id)); ->; };
                sz = this.s_vsz(t);
                lo = (u64)0;
                hi = (u64)0;
                i = 0;
                while (i < x.n)
                {
                    cv = this.s_res(x.args[i]);
                    if (!this.s_isc(cv)) { this.s_fail(g"switch case\0"); ->; };
                    c = this.a_mask((u64)this.scv, t.width);
                    if (i == 0 | c < lo) { lo = c; };
                    if (i == 0 | c > hi) { hi = c; };
                    i++;
                };
                if (SSA_OPT_SWCHAIN == 1 & x.n <= 4 & (t.width == 8 | t.width == 16 | t.width == 32 | t.width == 64))
                {
                    // few cases: compare and branch in order, the first equal case wins
                    ok = true;
                    i = 0;
                    while (i < x.n)
                    {
                        cv = this.s_res(x.args[i]);
                        this.s_isc(cv);
                        sv = this.s_sx((u64)this.scv, t.width);
                        if (sv < (i64)0 - (i64)2147483648 | sv > (i64)2147483647) { ok = false; };
                        i++;
                    };
                    if (ok)
                    {
                        r = this.s_reg(x.a);
                        i = 0;
                        while (i < x.n)
                        {
                            cv = this.s_res(x.args[i]);
                            this.s_isc(cv);
                            sv = this.s_sx((u64)this.scv, t.width);
                            if (sv == (i64)0)
                            {
                                this.s_mi2(M_TEST, sz, this.s_mo_r(r, sz), this.s_mo_r(r, sz));
                            }
                            else
                            {
                                this.s_mi2(M_CMP, sz, this.s_mo_r(r, sz), this.s_mo_i(sv));
                            };
                            m = this.s_mi1(M_JCC, 0, this.s_mo_blk(x.blks[i].id));
                            m.cc = C_E;
                            i++;
                        };
                        this.s_mi1(M_JMP, 0, this.s_mo_blk(x.f.id));
                        ->;
                    };
                };
                if (t.width <= 8)
                {
                    // the table covers every value of the type, so no value can leave it
                    lo = (u64)0;
                    hi = ((u64)1 << (u64)t.width) - (u64)1;
                };
                if (hi - lo >= (u64)16777216)
                {
                    // sparse values: nested tables indexed by one byte of the value at a time
                    tab = (int*)this.s_ar(16 * x.n + 16);
                    i = 0;
                    while (i < x.n)
                    {
                        cv = this.s_res(x.args[i]);
                        this.s_isc(cv);
                        ((u64*)tab)[i] = this.a_mask((u64)this.scv, t.width);
                        tab[2 * x.n + i] = x.blks[i].id;
                        i++;
                    };
                    r = this.s_reg(x.a);
                    m = this.s_mi1(M_JTAB2, sz, this.s_mo_r(r, 8));
                    m.o2 = this.s_mo_blk(x.f.id);
                    m.cc = x.n;
                    m.text = (byte*)tab;
                    ->;
                };
                cnt = (int)(hi - lo) + 1;
                tab = (int*)this.s_ar(4 * (cnt + 1));
                k = 0;
                while (k < cnt) { tab[k] = x.f.id; k++; };
                i = x.n - 1;
                while (i >= 0)
                {
                    cv = this.s_res(x.args[i]);
                    this.s_isc(cv);
                    c = this.a_mask((u64)this.scv, t.width);
                    tab[(int)(c - lo)] = x.blks[i].id;
                    i--;
                };
                r = this.s_reg(x.a);
                if (sz < 4) { r = this.s_ext(r, sz, false, 4); };
                m = this.s_mi1(M_JTAB, sz, this.s_mo_r(r, 8));
                m.o1 = this.s_mo_i((i64)lo);
                m.o2 = this.s_mo_blk(x.f.id);
                m.cc = cnt;
                m.text = (byte*)tab;
                ->;
            };

            // ----------------------------------------------------------
            // Phis
            // ----------------------------------------------------------

            s_isel_phis(GB* gb) -> void
            {
                int i, j, k, n;
                SI* x;
                GP* gp;
                GB* pg;
                IRType* t;
                int* used;
                if (gb.ib.insts == (PtrVec*)0) { ->; };
                i = 0;
                while (i < gb.ib.insts.len)
                {
                    x = (SI*)gb.ib.insts.items[i];
                    if (x.op == SO_PHI)
                    {
                        t = x.ty;
                        if (!this.s_isarg(t)) { this.s_fail(g"phi type\0"); ->; };
                        gp = (GP*)this.s_ar((int)(((sizeof(GP) + 7) / 8) * 2));
                        gp.res = x.res;
                        gp.dst = this.s_def(x.res, this.s_cls(t));
                        gp.preds = pv_new();
                        gp.vals = pv_new();
                        gp.ops = pv_new();
                        used = this.s_iz(x.n + 1);
                        j = 0;
                        while (j < gb.preds.len)
                        {
                            pg = (GB*)gb.preds.items[j];
                            k = 0;
                            while (k < x.n)
                            {
                                if (x.blks[k] == pg.ib & used[k] == 0) { break; };
                                k++;
                            };
                            if (k >= x.n)
                            {
                                // a duplicate edge reuses the first entry of that block
                                k = 0;
                                while (k < x.n)
                                {
                                    if (x.blks[k] == pg.ib) { break; };
                                    k++;
                                };
                            };
                            if (k >= x.n)
                            {
                                this.s_fail(g"phi without incoming value\0");
                                this.s_ifree(used);
                                ->;
                            };
                            used[k] = 1;
                            pv_push(gp.preds, (void*)pg);
                            pv_push(gp.vals, (void*)this.s_res(x.args[k]));
                            j++;
                        };
                        this.s_ifree(used);
                        pv_push(gb.phis, (void*)gp);
                    };
                    i++;
                };
                ->;
            };

            // ----------------------------------------------------------
            // Parameters
            // ----------------------------------------------------------

            s_isel_entry() -> void
            {
                GF* g = this.sf;
                IRFunc* f = g.f;
                IRType* t;
                int i, p, d, sz, wsh, ac, afo;
                int* st = this.s_iz(4);
                int* apv = this.s_iz(f.nargs + 1);
                int* afs = this.s_iz(f.nargs + 1);
                MO* src;
                XFO* xo;
                bool fp;
                wsh = 0;
                if (f.ftype.vararg) { this.s_vasave(); };
                if (this.s_isag(f.ftype.elem))
                {
                    g.sretv = this.s_nv(0);
                    if (this.a_win())
                    {
                        // the hidden result pointer arrives in rcx
                        this.s_mov(this.s_mo_r(1, 8), g.sretv, 8);
                        g.vhint[g.sretv] = 1;
                        wsh = 1;
                    }
                    else
                    {
                        this.s_mov(this.s_mo_r(7, 8), g.sretv, 8);
                        g.vhint[g.sretv] = 7;
                        st[0] = 1;
                    };
                };
                i = 0;
                while (i < f.nargs)
                {
                    t = f.ftype.items[i];
                    if (this.s_isagg(t) & this.a_win() & this.gwhy == 0)
                    {
                        // Win64: a pointer to the caller's copy arrives; the value is copied into a frame object once
                        // every argument register has been read
                        p = this.s_place(i + wsh, false, st);
                        d = this.s_nv(0);
                        if (p >= 0)
                        {
                            this.s_mov(this.s_mo_r(p, 8), d, 8);
                            g.vhint[d] = p;
                        }
                        else
                        {
                            src = this.s_mo_mem(5, 0 - 1, 1, (i64)(16 + this.splo), (byte*)0, 0 - 1);
                            this.s_mi2(M_MOV, 8, src, this.s_mo_r(d, 8));
                        };
                        apv[i] = d;
                        afo = this.s_newfo(this.a_size(t), 8);
                        afs[i] = afo;
                        f.args[i].fo = afo;
                        i++;
                        continue;
                    };
                    if (this.s_isagg(t) & this.gwhy == 0)
                    {
                        // the argument stays where the caller put it
                        sz = this.a_size(t);
                        xo = (XFO*)this.s_ar((int)(((sizeof(XFO) + 7) / 8) * 2));
                        xo.size = sz;
                        xo.al = 8;
                        xo.fix = 1;
                        xo.off = 16 + st[2];
                        st[2] = st[2] + (sz + 7) / 8 * 8;
                        pv_push(g.fobj, (void*)xo);
                        f.args[i].fo = g.fobj.len;
                        i++;
                        continue;
                    };
                    if (!this.s_isarg(t) & !this.s_isag(t)) { this.s_fail(g"parameter type\0"); this.s_ifree(st); ->; };
                    fp = this.s_isfp(t);
                    sz = this.s_vsz(t);
                    if (sz < 8 & !fp) { sz = 4; };
                    p = this.s_place(i + wsh, fp, st);
                    if (fp)
                    {
                        d = this.s_def(f.args[i], 1);
                        if (p >= 0)
                        {
                            this.s_mi2(M_XMOV, sz, this.s_mo_r(p, 8), this.s_mo_r(d, sz));
                            g.vhint[d] = p;
                        }
                        else
                        {
                            src = this.s_mo_mem(5, 0 - 1, 1, (i64)(16 + this.splo), (byte*)0, 0 - 1);
                            this.s_mi2(M_XMOV, sz, src, this.s_mo_r(d, sz));
                        };
                    }
                    else
                    {
                        d = this.s_def(f.args[i], 0);
                        if (p >= 0)
                        {
                            this.s_mov(this.s_mo_r(p, sz), d, sz);
                            g.vhint[d] = p;
                        }
                        else
                        {
                            src = this.s_mo_mem(5, 0 - 1, 1, (i64)(16 + this.splo), (byte*)0, 0 - 1);
                            this.s_mi2(M_MOV, sz, src, this.s_mo_r(d, sz));
                        };
                    };
                    i++;
                };
                i = 0;
                while (i < f.nargs)
                {
                    if (afs[i] > 0)
                    {
                        this.s_copy(this.s_mo_mem(0 - 1, 0 - 1, 1, (i64)0, (byte*)0, afs[i] - 1), this.s_mo_mem(apv[i], 0 - 1, 1, (i64)0, (byte*)0, 0 - 1), this.a_size(f.ftype.items[i]));
                    };
                    i++;
                };
                if (f.ftype.vararg)
                {
                    if (this.a_win()) { g.vagp = i + wsh; }
                    else { g.vagp = st[0]; };
                    g.vafp = st[1];
                    g.vastk = 16 + st[2];
                };
                this.s_ifree(st);
                this.s_ifree(apv);
                this.s_ifree(afs);
                ->;
            };

            // Register save area of a vararg function, written before the argument registers are touched
            s_vasave() -> void
            {
                GF* g = this.sf;
                MI* m;
                if (this.a_win())
                {
                    m = this.s_mi(M_SAVEVA, 8);
                    m.iu = 2 `| 4 `| 256 `| 512;
                    m.tgt = 0 - 1;
                    ->;
                };
                g.vafo = this.s_newfo(176, 16);
                m = this.s_mi(M_SAVEVA, 8);
                m.iu = 2 `| 4 `| 64 `| 128 `| 256 `| 512 `| (255 << 16);
                m.tgt = g.vafo - 1;
                ->;
            };

            // ----------------------------------------------------------
            // Driver
            // ----------------------------------------------------------

            s_isel_inst(SI* x) -> void
            {
                int o = x.op;
                if (o == SO_PHI) { ->; };
                if (o == SO_BIN) { this.s_isel_bin(x); ->; };
                if (o == SO_CMP) { this.s_isel_cmp(x); ->; };
                if (o == SO_CAST) { this.s_isel_cast(x); ->; };
                if (o == SO_ALLOCAN) { this.s_isel_allocan(x); ->; };
                if (o == SO_ALLOCA) { this.s_isel_alloca(x); ->; };
                if (o == SO_LOAD) { this.s_isel_load(x); ->; };
                if (o == SO_STORE) { this.s_isel_store(x); ->; };
                if (o == SO_FILL) { this.s_isel_fill(x); ->; };
                if (o == SO_COPY) { this.s_isel_fill(x); ->; };
                if (o == SO_GEP) { this.s_isel_gep(x); ->; };
                if (o == SO_CALL) { this.s_isel_call(x); ->; };
                if (o == SO_SELECT) { this.s_isel_select(x); ->; };
                if (o == SO_BR) { this.s_isel_br(x); ->; };
                if (o == SO_CBR) { this.s_isel_cbr(x); ->; };
                if (o == SO_SWITCH) { this.s_isel_switch(x); ->; };
                if (o == SO_VAARG) { this.s_isel_vaarg(x); ->; };
                if (o == SO_EXTRACT) { this.s_isel_extract(x); ->; };
                if (o == SO_INSERT) { this.s_isel_insert(x); ->; };
                if (o == SO_RET) { this.s_isel_ret(x); ->; };
                if (o == SO_RETV)
                {
                    this.s_mi(M_RET, 0);
                    ->;
                };
                if (o == SO_UNREACH)
                {
                    this.s_mi(M_UD2, 0);
                    ->;
                };
                this.s_fail(g"instruction\0");
                ->;
            };

            // Inserts item at position idx of v
            s_vins(PtrVec* v, int idx, void* item) -> void
            {
                int i;
                pv_push(v, item);
                i = v.len - 1;
                while (i > idx)
                {
                    v.items[i] = v.items[i - 1];
                    i--;
                };
                v.items[idx] = item;
                ->;
            };

            s_isel() -> bool
            {
                GF* g = this.sf;
                IRFunc* f = g.f;
                int i, j, k;
                GB* gb;
                SI* x;
                IRType* rt = f.ftype.elem;
                if (rt.kind != LK.VOID & !this.s_isarg(rt) & !this.s_isag(rt)) { this.s_fail(g"function return type\0"); -> false; };
                
                // the per register arrays exist even when the function needs no virtual register
                k = this.s_nv(0);
                g.nvr = k;
                this.s_users();
                this.s_lazy();
                if (SSA_OPT_LAZYMULTI == 1) { this.s_lazymulti(); };
                this.hasal = false;
                i = 0;
                while (i < g.nb)
                {
                    gb = g.rpo[i];
                    if (gb.ib.insts != (PtrVec*)0)
                    {
                        j = 0;
                        while (j < gb.ib.insts.len)
                        {
                            x = (SI*)gb.ib.insts.items[j];
                            if (x.op == SO_ALLOCA | x.op == SO_ALLOCAN | x.op == SO_VAARG) { this.hasal = true; };
                            j++;
                        };
                    };
                    i++;
                };
                i = 0;
                while (i < g.nb)
                {
                    gb = g.rpo[i];
                    this.scb = gb;
                    this.s_isel_phis(gb);
                    i++;
                };
                i = 0;
                while (i < g.nb)
                {
                    gb = g.rpo[i];
                    this.scb = gb;
                    // the extended index of the block that is the only way in is still in its register
                    if (i == 0) { this.ec_v = (IRValue*)0; }
                    elif (gb.preds.len != 1) { this.ec_v = (IRValue*)0; }
                    elif (gb.preds.items[0] != (void*)g.rpo[i - 1]) { this.ec_v = (IRValue*)0; };
                    if (i == 0) { this.s_isel_entry(); };
                    if (gb.ib.insts != (PtrVec*)0)
                    {
                        j = 0;
                        while (j < gb.ib.insts.len)
                        {
                            x = (SI*)gb.ib.insts.items[j];
                            if (this.skipn) { this.skipn = false; j++; continue; };
                            this.nxti = (SI*)0;
                            if (j + 1 < gb.ib.insts.len) { this.nxti = (SI*)gb.ib.insts.items[j + 1]; };
                            this.s_isel_inst(x);
                            if (this.gwhy != 0) { -> false; };
                            j++;
                        };
                    };
                    i++;
                };
                -> this.gwhy == 0;
            };

            // The operand o with the registers in from replaced by the ones in to
            s_td_mo(MO* o, int* fr_, int* tr_, int n) -> MO*
            {
                MO* c;
                int k;
                if (o == (MO*)0 | n == 0) { -> o; };
                if (o.k != MK_REG & o.k != MK_MEM) { -> o; };
                c = this.s_mo_copy(o);
                k = 0;
                while (k < n)
                {
                    if (c.r == fr_[k]) { c.r = tr_[k]; };
                    k++;
                };
                if (c.k == MK_MEM)
                {
                    k = 0;
                    while (k < n)
                    {
                        if (c.r2 == fr_[k]) { c.r2 = tr_[k]; };
                        k++;
                    };
                };
                -> c;
            };

            // A block that ends in a jump to a short block that only returns takes a copy of that block instead
            s_taildup() -> void
            {
                GF* g = this.sf;
                int i, j, k, q, n, cnt, nmap, nc;
                GB** cand;
                int* mf;
                int* mt;
                bool ok;
                GB* b;
                GB* l;
                MI* t;
                MI* m;
                MI* c;
                nc = 0;
                cand = (GB**)this.s_arr(8 * (g.nb + 1));
                i = 0;
                while (i < g.nb)
                {
                    b = g.rpo[i];
                    i++;
                    if (b.mi.len >= 1 & b.mi.len <= 4)
                    {
                        t = (MI*)b.mi.items[b.mi.len - 1];
                        if (t.op == M_RET) { cand[nc] = b; nc++; };
                    };
                };
                if (nc == 0) { ->; };
                i = 0;
                while (i < g.nb)
                {
                    b = g.rpo[i];
                    i++;
                    if (b.mi.len < 1) { continue; };
                    t = (MI*)b.mi.items[b.mi.len - 1];
                    if (t.op != M_JMP) { continue; };
                    l = (GB*)0;
                    j = 0;
                    while (j < nc)
                    {
                        if (cand[j].id == (int)t.o0.imm) { l = cand[j]; };
                        j++;
                    };
                    if (l == (GB*)0 | l == b) { continue; };
                    if (l.mi.len < 1 | l.mi.len > 4) { continue; };
                    m = (MI*)l.mi.items[l.mi.len - 1];
                    if (m.op != M_RET) { continue; };
                    ok = true;
                    j = 0;
                    while (j < l.mi.len - 1)
                    {
                        m = (MI*)l.mi.items[j];
                        if (m.op != M_MOV & m.op != M_MOVZX & m.op != M_MOVSX & m.op != M_XMOV) { ok = false; };
                        j++;
                    };
                    if (!ok) { continue; };
                    // the successors: b no longer reaches l
                    if (b.succs.len != 1) { continue; };
                    if ((GB*)b.succs.items[0] != l) { continue; };
                    b.mi.len = b.mi.len - 1;
                    this.scb = b;
                    // the registers l defines itself get fresh ones in the copy
                    mf = this.s_iz(8);
                    mt = this.s_iz(8);
                    nmap = 0;
                    j = 0;
                    while (j < l.mi.len)
                    {
                        this.s_scan((MI*)l.mi.items[j]);
                        k = 0;
                        while (k < this.ndb)
                        {
                            if (this.dbuf[k] >= R_VBASE & nmap < 8)
                            {
                                mf[nmap] = this.dbuf[k];
                                mt[nmap] = this.s_nv(g.vcls[this.dbuf[k]]);
                                nmap++;
                            };
                            k++;
                        };
                        j++;
                    };
                    this.scb = b;
                    j = 0;
                    while (j < l.mi.len)
                    {
                        m = (MI*)l.mi.items[j];
                        c = this.s_mi(m.op, m.sz);
                        c.cc = m.cc; c.iu = m.iu; c.id = m.id; c.clob = m.clob; c.tgt = m.tgt;
                        c.o0 = this.s_td_mo(m.o0, mf, mt, nmap); c.o1 = this.s_td_mo(m.o1, mf, mt, nmap); c.o2 = this.s_td_mo(m.o2, mf, mt, nmap); c.text = m.text;
                        j++;
                    };
                    this.s_ifree(mf);
                    this.s_ifree(mt);
                    b.succs.len = 0;
                    q = 0;
                    n = 0;
                    while (q < l.preds.len)
                    {
                        if ((GB*)l.preds.items[q] != b) { l.preds.items[n] = l.preds.items[q]; n++; };
                        q++;
                    };
                    l.preds.len = n;
                };
                // the copied blocks that nothing reaches any more leave the layout
                n = 0;
                i = 0;
                while (i < g.nb)
                {
                    b = g.rpo[i];
                    if (i == 0 | b.preds.len > 0)
                    {
                        g.rpo[n] = b;
                        b.rpo = n;
                        n++;
                    };
                    i++;
                };
                g.nb = n;
                ->;
            };

            // Edge blocks for the phis: copies go at the end of a block with one successor, otherwise the
            // edge gets a block of its own. The blocks end up in the layout after their predecessor.
            s_edges() -> bool
            {
                GF* g = this.sf;
                int i, j, k, n, pidx, nrpo;
                GB* p;
                GB* s;
                GB* e;
                MI* m;
                MI* t;
                MO* o;
                PtrVec* lay = pv_new();
                bool seen;
                n = g.nb;
                i = 0;
                while (i < n)
                {
                    p = g.rpo[i];
                    pv_push(lay, (void*)p);
                    j = 0;
                    while (j < p.succs.len)
                    {
                        s = (GB*)p.succs.items[j];
                        seen = false;
                        k = 0;
                        while (k < j)
                        {
                            if ((GB*)p.succs.items[k] == s) { seen = true; };
                            k++;
                        };
                        if (!seen & s.phis.len > 0)
                        {
                            this.scb = p;
                            pidx = 0;
                            while (pidx < s.preds.len)
                            {
                                if ((GB*)s.preds.items[pidx] == p) { break; };
                                pidx++;
                            };
                            if (p.succs.len == 1)
                            {
                                // before the final jump
                                t = (MI*)p.mi.items[p.mi.len - 1];
                                if (t.op != M_JMP) { this.s_fail(g"block end\0"); pv_free(lay); -> false; };
                                m = this.s_mi(M_PCOPY, 8);
                                p.mi.len = p.mi.len - 1;
                                p.mi.len = p.mi.len - 1;
                                pv_push(p.mi, (void*)m);
                                pv_push(p.mi, (void*)t);
                                m.tgt = s.ib.gi;
                                m.cc = pidx;
                            }
                            else
                            {
                                e = (GB*)fmalloc((u64)(((sizeof(GB) + 7) / 8) * 2));
                                e.ib = (IRBlock*)0;
                                this.lab++;
                                e.id = this.lab;
                                e.rpo = 0;
                                e.idom = 0 - 1;
                                e.lbl = e.id;
                                e.depth = p.depth + 1;
                                e.nexti = 0;
                                e.lw = p.lw;
                                e.preds = pv_new();
                                e.succs = pv_new();
                                e.kids = pv_new();
                                e.df = pv_new();
                                e.phis = pv_new();
                                e.mi = pv_new();
                                e.livein = (int*)0;
                                e.liveout = (int*)0;
                                e.guse = (int*)0;
                                e.gdef = (int*)0;
                                pv_push(e.preds, (void*)p);
                                pv_push(e.succs, (void*)s);
                                this.scb = e;
                                m = this.s_mi(M_PCOPY, 8);
                                m.tgt = s.ib.gi;
                                m.cc = pidx;
                                this.s_mi1(M_JMP, 0, this.s_mo_blk(s.id));
                                // the jumps of p that reach s now reach the edge block
                                k = p.mi.len - 1;
                                while (k >= 0)
                                {
                                    t = (MI*)p.mi.items[k];
                                    if (t.op == M_JCC | t.op == M_JMP)
                                    {
                                        if (t.o0.imm == (i64)s.id) { t.o0 = this.s_mo_blk(e.id); };
                                    };
                                    if (t.op == M_JTAB2)
                                    {
                                        if (t.o2.imm == (i64)s.id) { t.o2 = this.s_mo_blk(e.id); };
                                        n = 0;
                                        while (n < t.cc)
                                        {
                                            if (((int*)t.text)[2 * t.cc + n] == s.id) { ((int*)t.text)[2 * t.cc + n] = e.id; };
                                            n++;
                                        };
                                    };
                                    if (t.op == M_JTAB)
                                    {
                                        if (t.o2.imm == (i64)s.id) { t.o2 = this.s_mo_blk(e.id); };
                                        n = 0;
                                        while (n < t.cc)
                                        {
                                            if (((int*)t.text)[n] == s.id) { ((int*)t.text)[n] = e.id; };
                                            n++;
                                        };
                                    };
                                    k--;
                                };
                                k = 0;
                                while (k < p.succs.len)
                                {
                                    if ((GB*)p.succs.items[k] == s) { p.succs.items[k] = (void*)e; };
                                    k++;
                                };
                                k = 0;
                                while (k < s.preds.len)
                                {
                                    if ((GB*)s.preds.items[k] == p) { s.preds.items[k] = (void*)e; };
                                    k++;
                                };
                                e.rpo = g.bl.len;
                                pv_push(g.bl, (void*)e);
                                pv_push(lay, (void*)e);
                            };
                        };
                        j++;
                    };
                    i++;
                };
                // the layout becomes the new block order
                ffree((byte*)g.rpo);
                g.nb = lay.len;
                g.rpo = (GB**)fmalloc((u64)(8 * (lay.len + 1)));
                i = 0;
                while (i < lay.len)
                {
                    g.rpo[i] = (GB*)lay.items[i];
                    ((GB*)lay.items[i]).rpo = i;
                    i++;
                };
                pv_free(lay);
                -> true;
            };

            // ==========================================================
            // loop weights, register scanning, liveness and register allocation on the
            // interference graph of the SSA values (colored in definition order, spilling by weight).
            // ==========================================================

            // ----------------------------------------------------------
            // Registers read and written by a machine instruction
            // ----------------------------------------------------------

            // True for the registers the allocator never sees: rsp, rbp and the scratch registers
            s_hidden(int r) -> bool
            {
                if (r < 0) { -> true; };
                if (r == 4 | r == 5 | r == 10 | r == 11 | r == 31) { -> true; };
                -> false;
            };

            // Doubles the scan buffers
            s_bgrow() -> void
            {
                int* a = this.s_iz(this.bcap * 2);
                int* b = this.s_iz(this.bcap * 2);
                int i = 0;
                while (i < this.nub) { a[i] = this.ubuf[i]; i++; };
                i = 0;
                while (i < this.ndb) { b[i] = this.dbuf[i]; i++; };
                this.s_ifree(this.ubuf);
                this.s_ifree(this.dbuf);
                this.ubuf = a;
                this.dbuf = b;
                this.bcap = this.bcap * 2;
                ->;
            };

            s_addu(int r) -> void
            {
                if (this.s_hidden(r)) { ->; };
                if (r >= R_VBASE)
                {
                    if (this.sf.vcol[r] == 0 - 1) { ->; };
                };
                if (this.nub >= this.bcap) { this.s_bgrow(); };
                this.ubuf[this.nub] = r;
                this.nub++;
                ->;
            };

            s_addd(int r) -> void
            {
                if (this.s_hidden(r)) { ->; };
                if (r >= R_VBASE)
                {
                    if (this.sf.vcol[r] == 0 - 1) { ->; };
                };
                if (this.ndb >= this.bcap) { this.s_bgrow(); };
                this.dbuf[this.ndb] = r;
                this.ndb++;
                ->;
            };

            // Role of operand k of an instruction: 1 its register is read, 2 written, 0 none. Registers inside a
            // memory operand are always read.
            s_role(int op, int k, MO* o) -> int
            {
                if (op == M_MOV | op == M_BREV | op == M_DALLOC | op == M_VAARG | op == M_MOVZX | op == M_MOVSX | op == M_LEA | op == M_MOVABS | op == M_GX | op == M_XMOV | op == M_CVT | op == M_FUN)
                {
                    if (k == 0) { -> 1; };
                    if (k == 1)
                    {
                        if (o.k == MK_REG) { -> 2; };
                        -> 1;
                    };
                    -> 0;
                };
                if (op == M_ALU | op == M_SHIFT | op == M_FALU | op == M_CMOV | op == M_FSEL | op == M_FREM)
                {
                    if (k < 2) { -> 1; };
                    -> 2;
                };
                if (op == M_UN)
                {
                    if (k == 0) { -> 1; };
                    if (o != (MO*)0)
                    {
                        if (o.k != MK_REG) { -> 1; };
                    };
                    -> 2;
                };
                if (op == M_RMW) { -> 1; };
                if (op == M_CMP | op == M_TEST | op == M_FCMP)
                {
                    if (k < 2) { -> 1; };
                    -> 0;
                };
                if (op == M_SETCC)
                {
                    if (k == 0) { -> 2; };
                    -> 0;
                };
                if (op == M_CALL | op == M_DIV | op == M_JTAB | op == M_JTAB2 | op == M_VASTART)
                {
                    if (k == 0) { -> 1; };
                    -> 0;
                };
                -> 0;
            };

            s_scano(MO* o, int role) -> void
            {
                if (o == (MO*)0) { ->; };
                if (o.k == MK_REG)
                {
                    if (role == 2) { this.s_addd(o.r); };
                    if (role == 1) { this.s_addu(o.r); };
                    ->;
                };
                if (o.k == MK_MEM)
                {
                    this.s_addu(o.r);
                    this.s_addu(o.r2);
                };
                ->;
            };

            // Fills ubuf and dbuf with the registers m reads and writes
            s_scan(MI* m) -> void
            {
                int op = m.op;
                int b, i;
                this.nub = 0;
                this.ndb = 0;
                if (op == M_PCOPY)
                {
                    this.s_scan_pc(m);
                    ->;
                };
                this.s_scano(m.o0, this.s_role(op, 0, m.o0));
                this.s_scano(m.o1, this.s_role(op, 1, m.o1));
                this.s_scano(m.o2, this.s_role(op, 2, m.o2));
                // implicit registers
                i = 0;
                while (i < 32)
                {
                    b = 1 << i;
                    if ((m.iu `& b) != 0) { this.s_addu(i); };
                    if (((m.id `| m.clob) `& b) != 0) { this.s_addd(i); };
                    i++;
                };
                ->;
            };

            // ----------------------------------------------------------
            // Loops
            // ----------------------------------------------------------

            s_dominates(GB* a, GB* b) -> bool
            {
                GF* g = this.sf;
                GB* x = b;
                while (true)
                {
                    if (x == a) { -> true; };
                    if (x.idom == x.rpo | x.idom < 0) { -> false; };
                    x = g.rpo[x.idom];
                };
                -> false;
            };

            // True for the instructions that may move to a block that runs less often
            s_sinkable(SI* x) -> bool
            {
                int o = x.op;
                if (x.res == (IRValue*)0) { -> false; };
                if (o == SO_BIN | o == SO_CAST | o == SO_GEP | o == SO_CMP | o == SO_SELECT | o == SO_EXTRACT) { -> !x.vol; };
                if (o == SO_LOAD) { -> !x.vol; };
                -> false;
            };

            // A value that only one successor of its block uses is computed there instead, so the other path
            // does not run it. A load moves only when nothing in the rest of its block can write memory.
            s_sink() -> bool
            {
                GF* g = this.sf;
                bool any = false;
                int i, j, k, n, bi, pos, e, round;
                GB* gb;
                GB* tg;
                SI* x;
                SI* y;
                SI* u;
                IRValue* v;
                bool ok, wr;
                void* utg;
                round = 0;
                while (round < 2)
                {
                    round++;
                    // the one block that holds all the uses of each value (1 when several or a phi)
                    i = 0;
                    while (i < g.nb)
                    {
                        gb = g.rpo[i];
                        if (gb.ib.insts != (PtrVec*)0)
                        {
                            j = 0;
                            while (j < gb.ib.insts.len)
                            {
                                x = (SI*)gb.ib.insts.items[j];
                                if (x.res != (IRValue*)0) { x.res.ui = (void*)0; };
                                j++;
                            };
                        };
                        i++;
                    };
                    i = 0;
                    while (i < g.nb)
                    {
                        gb = g.rpo[i];
                        if (gb.ib.insts != (PtrVec*)0)
                        {
                            j = 0;
                            while (j < gb.ib.insts.len)
                            {
                                u = (SI*)gb.ib.insts.items[j];
                                n = this.s_nops(u);
                                k = 0;
                                while (k < n)
                                {
                                    v = this.s_op(u, k);
                                    if (v.di != (void*)0)
                                    {
                                        if (u.op == SO_PHI) { v.ui = (void*)1; }
                                        elif (v.ui == (void*)0) { v.ui = (void*)gb; }
                                        elif (v.ui != (void*)gb) { v.ui = (void*)1; };
                                    };
                                    k++;
                                };
                                j++;
                            };
                        };
                        i++;
                    };
                    i = g.nb - 1;
                    while (i >= 0)
                    {
                        gb = g.rpo[i];
                        i--;
                        if (gb.ib.insts == (PtrVec*)0) { continue; };
                        if (gb.succs.len != 2) { continue; };
                        j = gb.ib.insts.len - 2;
                        wr = false;
                        while (j >= 0)
                        {
                            x = (SI*)gb.ib.insts.items[j];
                            if (x.op == SO_STORE | x.op == SO_CALL | x.op == SO_COPY | x.op == SO_FILL | x.op == SO_VAARG | x.op == SO_PHI) { wr = true; }
                            elif (x.op == SO_LOAD & x.vol) { wr = true; };
                            if (x.op != 0 & this.s_sinkable(x) & !(x.op == SO_LOAD & wr))
                            {
                                utg = x.res.ui;
                                if (utg != (void*)0 & utg != (void*)1)
                                {
                                    tg = (GB*)utg;
                                    if (tg != gb & tg.preds.len == 1 & tg.lw <= gb.lw)
                                    {
                                        if ((GB*)tg.preds.items[0] == gb & ((GB*)gb.succs.items[0] == tg | (GB*)gb.succs.items[1] == tg))
                                        {
                                            // after the phis of the target
                                            pos = 0;
                                            while (pos < tg.ib.insts.len)
                                            {
                                                y = (SI*)tg.ib.insts.items[pos];
                                                if (y.op != SO_PHI) { break; };
                                                pos++;
                                            };
                                            this.s_vins(tg.ib.insts, pos, (void*)x);
                                            e = j;
                                            while (e + 1 < gb.ib.insts.len) { gb.ib.insts.items[e] = gb.ib.insts.items[e + 1]; e++; };
                                            gb.ib.insts.len = gb.ib.insts.len - 1;
                                            any = true;
                                        };
                                    };
                                };
                            };
                            j--;
                        };
                    };
                };
                -> any;
            };

            // Weight of each block: ten times more for every loop that contains it
            s_loops() -> void
            {
                GF* g = this.sf;
                int n = g.nb;
                int i, j, k, top, stamp, w;
                GB* b;
                GB* s;
                GB* x;
                GB* pg;
                int* cnt = this.s_iz(n);
                int* vis = this.s_iz(n);
                int* stk = this.s_iz(n + 1);
                stamp = 0;
                i = 0;
                while (i < n)
                {
                    b = g.rpo[i];
                    j = 0;
                    while (j < b.succs.len)
                    {
                        s = (GB*)b.succs.items[j];
                        if (this.s_dominates(s, b))
                        {
                            stamp++;
                            vis[s.rpo] = stamp;
                            cnt[s.rpo] = cnt[s.rpo] + 1;
                            top = 0;
                            if (vis[b.rpo] != stamp)
                            {
                                vis[b.rpo] = stamp;
                                cnt[b.rpo] = cnt[b.rpo] + 1;
                                stk[0] = b.rpo;
                                top = 1;
                            };
                            while (top > 0)
                            {
                                top--;
                                x = g.rpo[stk[top]];
                                k = 0;
                                while (k < x.preds.len)
                                {
                                    pg = (GB*)x.preds.items[k];
                                    if (vis[pg.rpo] != stamp)
                                    {
                                        vis[pg.rpo] = stamp;
                                        cnt[pg.rpo] = cnt[pg.rpo] + 1;
                                        stk[top] = pg.rpo;
                                        top++;
                                    };
                                    k++;
                                };
                            };
                        };
                        j++;
                    };
                    i++;
                };
                i = 0;
                while (i < n)
                {
                    b = g.rpo[i];
                    w = 1;
                    k = cnt[i];
                    if (k > 4) { k = 4; };
                    while (k > 0) { w = w * 10; k--; };
                    b.lw = w;
                    i++;
                };
                this.s_ifree(cnt);
                this.s_ifree(vis);
                this.s_ifree(stk);
                ->;
            };

            // ----------------------------------------------------------
            // Sets and graph helpers
            // ----------------------------------------------------------

            s_bit(int* s, int i) -> bool
            {
                -> ((s[i >> 5] >> (i `& 31)) `& 1) != 0;
            };

            s_setbit(int* s, int i) -> void
            {
                s[i >> 5] = s[i >> 5] `| (1 << (i `& 31));
                ->;
            };

            s_clrbit(int* s, int i) -> void
            {
                s[i >> 5] = s[i >> 5] `& (`!(1 << (i `& 31)));
                ->;
            };

            // Interference edge list, grown on demand
            s_epush(int a, int b) -> void
            {
                int* t;
                int i, nc;
                if (this.ne >= this.ecap)
                {
                    nc = this.ecap * 2;
                    if (nc < 4096) { nc = 4096; };
                    t = this.s_iz(nc);
                    i = 0;
                    while (i < this.ne) { t[i] = this.ea[i]; i++; };
                    if (this.ecap > 0) { this.s_ifree(this.ea); };
                    this.ea = t;
                    t = this.s_iz(nc);
                    i = 0;
                    while (i < this.ne) { t[i] = this.eb[i]; i++; };
                    if (this.ecap > 0) { this.s_ifree(this.eb); };
                    this.eb = t;
                    this.ecap = nc;
                };
                this.ea[this.ne] = a;
                this.eb[this.ne] = b;
                this.ne++;
                ->;
            };

            // ----------------------------------------------------------
            // Live sets while walking a block backwards
            // ----------------------------------------------------------

            s_lpush(int v) -> void
            {
                GF* g = this.sf;
                int* t;
                int i, nc;
                if (g.lpos[v] >= 0) { ->; };
                if (g.nl >= g.rcap)
                {
                    nc = g.rcap * 2;
                    if (nc < 256) { nc = 256; };
                    t = this.s_iz(nc);
                    i = 0;
                    while (i < g.nl) { t[i] = g.llist[i]; i++; };
                    if (g.rcap > 0) { this.s_ifree(g.llist); };
                    g.llist = t;
                    g.rcap = nc;
                };
                g.llist[g.nl] = v;
                g.lpos[v] = g.nl;
                g.nl++;
                ->;
            };

            s_lpop(int v) -> void
            {
                GF* g = this.sf;
                int p = g.lpos[v];
                int last;
                if (p < 0) { ->; };
                last = g.llist[g.nl - 1];
                g.llist[p] = last;
                g.lpos[last] = p;
                g.lpos[v] = 0 - 1;
                g.nl--;
                ->;
            };

            // ----------------------------------------------------------
            // Register allocation
            // ----------------------------------------------------------

            // Registers the allocator may hand out
            s_allocmask(int cls) -> int
            {
                if (cls == 1)
                {
                    if (this.a_win()) { -> 63 << 16; };
                    -> 16383 << 16;
                };
                // rax rcx rdx rbx rsi rdi r8 r9 r12 r13 r14 r15
                -> 1 `| 2 `| 4 `| 8 `| 64 `| 128 `| 256 `| 512 `| 4096 `| 8192 `| 16384 `| 32768;
            };

            // Registers a function must preserve
            s_csmask() -> int
            {
                if (this.a_win()) { -> 8 `| 64 `| 128 `| 4096 `| 8192 `| 16384 `| 32768 `| (1023 << 22); };
                -> 8 `| 4096 `| 8192 `| 16384 `| 32768;
            };

            // Order in which free registers are taken
            s_pref(int cls, int k) -> int
            {
                if (cls == 1) { -> 16 + k; };
                if (k == 0) { -> 0; };
                if (k == 1) { -> 1; };
                if (k == 2) { -> 2; };
                if (k == 3) { -> 6; };
                if (k == 4) { -> 7; };
                if (k == 5) { -> 8; };
                if (k == 6) { -> 9; };
                if (k == 7) { -> 3; };
                if (k == 8) { -> 12; };
                if (k == 9) { -> 13; };
                if (k == 10) { -> 14; };
                -> 15;
            };

            // Source register of phi gp along edge idx, or -1 when the incoming value is not in a register
            s_pcsrc(GP* gp, int idx) -> int
            {
                IRValue* v = this.s_res((IRValue*)gp.vals.items[idx]);
                if (v.vr >= R_VBASE) { -> v.vr; };
                -> 0 - 1;
            };

            // A parallel copy reads the incoming values and writes the phi registers of its target block
            s_scan_pc(MI* m) -> void
            {
                GB* sg = (GB*)this.sf.bl.items[m.tgt];
                GP* gp;
                int k = 0;
                int v;
                while (k < sg.phis.len)
                {
                    gp = (GP*)sg.phis.items[k];
                    v = this.s_pcsrc(gp, m.cc);
                    if (v >= 0) { this.s_addu(v); };
                    this.s_addd(gp.dst);
                    k++;
                };
                ->;
            };

            // ==========================================================
            // liveness, interference graph, coloring in definition order and spilling.
            // ==========================================================

            // Numbers the registers that live across blocks and records, for every block, the globals it
            // reads before writing (guse) and the ones it writes (gdef). Each list starts with its length.
            s_globals() -> void
            {
                GF* g = this.sf;
                int n = g.nb;
                int nv = g.nvr;
                int i, j, k, v, ng, cu, cd;
                GB* gb;
                MI* mi;
                int* defs = this.s_iz(nv);
                int* usedm = this.s_iz(nv);
                int* defl = this.s_iz(nv);
                int* tu;
                int* td;
                i = 0;
                while (i < nv) { g.vglob[i] = 0 - 1; i++; };
                ng = 0;
                i = 0;
                while (i < n)
                {
                    gb = g.rpo[i];
                    j = 0;
                    while (j < gb.mi.len)
                    {
                        mi = (MI*)gb.mi.items[j];
                        this.s_scan(mi);
                        k = 0;
                        while (k < this.nub)
                        {
                            v = this.ubuf[k];
                            if (v >= R_VBASE)
                            {
                                if (defs[v] != i + 1 & g.vglob[v] < 0) { g.vglob[v] = ng; ng++; };
                            };
                            k++;
                        };
                        k = 0;
                        while (k < this.ndb)
                        {
                            v = this.dbuf[k];
                            if (v >= R_VBASE) { defs[v] = i + 1; };
                            k++;
                        };
                        j++;
                    };
                    i++;
                };
                g.nglob = ng;
                if (g.gv != (int*)0) { this.s_ifree(g.gv); };
                g.gv = this.s_iz(ng + 1);
                i = 0;
                while (i < nv)
                {
                    if (g.vglob[i] >= 0) { g.gv[g.vglob[i]] = i; };
                    defs[i] = 0;
                    i++;
                };
                tu = this.s_iz(ng + 2);
                td = this.s_iz(ng + 2);
                i = 0;
                while (i < n)
                {
                    gb = g.rpo[i];
                    cu = 0;
                    cd = 0;
                    j = 0;
                    while (j < gb.mi.len)
                    {
                        mi = (MI*)gb.mi.items[j];
                        this.s_scan(mi);
                        k = 0;
                        while (k < this.nub)
                        {
                            v = this.ubuf[k];
                            if (v >= R_VBASE)
                            {
                                if (g.vglob[v] >= 0 & defs[v] != i + 1 & usedm[v] != i + 1)
                                {
                                    usedm[v] = i + 1;
                                    tu[cu] = g.vglob[v];
                                    cu++;
                                };
                            };
                            k++;
                        };
                        k = 0;
                        while (k < this.ndb)
                        {
                            v = this.dbuf[k];
                            if (v >= R_VBASE)
                            {
                                defs[v] = i + 1;
                                if (g.vglob[v] >= 0 & defl[v] != i + 1)
                                {
                                    defl[v] = i + 1;
                                    td[cd] = g.vglob[v];
                                    cd++;
                                };
                            };
                            k++;
                        };
                        j++;
                    };
                    if (gb.guse != (int*)0) { this.s_ifree(gb.guse); this.s_ifree(gb.gdef); };
                    gb.guse = this.s_iz(cu + 1);
                    gb.gdef = this.s_iz(cd + 1);
                    gb.guse[0] = cu;
                    gb.gdef[0] = cd;
                    k = 0;
                    while (k < cu) { gb.guse[k + 1] = tu[k]; k++; };
                    k = 0;
                    while (k < cd) { gb.gdef[k + 1] = td[k]; k++; };
                    i++;
                };
                this.s_ifree(defs); this.s_ifree(usedm); this.s_ifree(defl); this.s_ifree(tu); this.s_ifree(td);
                ->;
            };

            // Live-in and live-out sets of the global registers of every block
            s_liveness() -> void
            {
                GF* g = this.sf;
                int n = g.nb;
                int nw = (g.nglob + 31) / 32;
                int i, j, k, w, changed, v;
                GB* gb;
                GB* sg;
                int* tmp;
                if (nw < 1) { nw = 1; };
                tmp = this.s_iz(nw);
                i = 0;
                while (i < n)
                {
                    gb = g.rpo[i];
                    if (gb.livein != (int*)0) { this.s_ifree(gb.livein); this.s_ifree(gb.liveout); };
                    gb.livein = this.s_iz(nw);
                    gb.liveout = this.s_iz(nw);
                    i++;
                };
                changed = 1;
                while (changed != 0)
                {
                    changed = 0;
                    i = n - 1;
                    while (i >= 0)
                    {
                        gb = g.rpo[i];
                        j = 0;
                        while (j < nw) { gb.liveout[j] = 0; j++; };
                        j = 0;
                        while (j < gb.succs.len)
                        {
                            sg = (GB*)gb.succs.items[j];
                            k = 0;
                            while (k < nw) { gb.liveout[k] = gb.liveout[k] `| sg.livein[k]; k++; };
                            j++;
                        };
                        k = 0;
                        while (k < nw) { tmp[k] = gb.liveout[k]; k++; };
                        k = 0;
                        while (k < gb.gdef[0]) { this.s_clrbit(tmp, gb.gdef[k + 1]); k++; };
                        k = 0;
                        while (k < gb.guse[0]) { this.s_setbit(tmp, gb.guse[k + 1]); k++; };
                        k = 0;
                        while (k < nw)
                        {
                            if (tmp[k] != gb.livein[k])
                            {
                                gb.livein[k] = tmp[k];
                                changed = 1;
                            };
                            k++;
                        };
                        i--;
                    };
                };
                this.s_ifree(tmp);
                ->;
            };

            // Interference between the registers, forbidden registers, hints, weights and the order of definition
            s_graph() -> void
            {
                GF* g = this.sf;
                int n = g.nb;
                int nv = g.nvr;
                int nw = (g.nglob + 31) / 32;
                int i, j, k, v, d, u, w, lp, op, bit, e, p, src;
                GB* gb;
                GB* sg;
                MI* mi;
                MO* o0;
                MO* o1;
                bool copy;
                int* deg;
                int* fill;
                int* seen;
                if (nw < 1) { nw = 1; };
                this.ne = 0;
                if (g.lpos != (int*)0) { this.s_ifree(g.lpos); };
                g.lpos = this.s_iz(nv);
                i = 0;
                while (i < nv)
                {
                    g.lpos[i] = 0 - 1;
                    g.vforb[i] = 0;
                    g.vhint[i] = 0 - 1;
                    if (g.vwgt[i] < 1500000000) { g.vwgt[i] = 0; };
                    i++;
                };
                g.nl = 0;
                i = 0;
                while (i < n)
                {
                    gb = g.rpo[i];
                    // live out registers
                    g.nl = 0;
                    j = 0;
                    while (j < g.nglob)
                    {
                        if (this.s_bit(gb.liveout, j))
                        {
                            v = g.gv[j];
                            if (g.vcol[v] != 0 - 1) { this.s_lpush(v); };
                        };
                        j++;
                    };
                    lp = 0;
                    j = gb.mi.len - 1;
                    while (j >= 0)
                    {
                        mi = (MI*)gb.mi.items[j];
                        op = mi.op;
                        this.s_scan(mi);
                        copy = false;
                        src = 0 - 1;
                        if (op == M_MOV)
                        {
                            if (mi.o0.k == MK_REG & mi.o1.k == MK_REG)
                            {
                                copy = true;
                                src = mi.o0.r;
                            };
                        };
                        // definitions
                        k = 0;
                        while (k < this.ndb)
                        {
                            d = this.dbuf[k];
                            if (d >= R_VBASE)
                            {
                                u = 0;
                                while (u < g.nl)
                                {
                                    v = g.llist[u];
                                    if (v != d & g.vcls[v] == g.vcls[d])
                                    {
                                        if (!(copy & v == src)) { this.s_epush(d, v); };
                                    };
                                    u++;
                                };
                                g.vforb[d] = g.vforb[d] `| lp;
                                if (op == M_SHIFT)
                                {
                                    u = 0;
                                    while (u < this.nub)
                                    {
                                        if (this.ubuf[u] < R_VBASE) { g.vforb[d] = g.vforb[d] `| (1 << this.ubuf[u]); };
                                        u++;
                                    };
                                };
                                this.s_wadd(d, gb.lw);
                            }
                            else
                            {
                                bit = 1 << d;
                                u = 0;
                                while (u < g.nl)
                                {
                                    v = g.llist[u];
                                    g.vforb[v] = g.vforb[v] `| bit;
                                    u++;
                                };
                            };
                            k++;
                        };
                        k = 0;
                        while (k < this.ndb)
                        {
                            d = this.dbuf[k];
                            if (d >= R_VBASE) { this.s_lpop(d); } else { lp = lp `& (`!(1 << d)); };
                            k++;
                        };
                        // uses
                        k = 0;
                        while (k < this.nub)
                        {
                            u = this.ubuf[k];
                            if (u >= R_VBASE)
                            {
                                this.s_lpush(u);
                                this.s_wadd(u, gb.lw);
                            }
                            else { lp = lp `| (1 << u); };
                            k++;
                        };
                        // hints
                        if (copy)
                        {
                            d = mi.o1.r;
                            if (d >= R_VBASE & src >= R_VBASE)
                            {
                                if (g.vhint[d] == 0 - 1) { g.vhint[d] = 0 - (src + 1); };
                                if (g.vhint[src] == 0 - 1) { g.vhint[src] = 0 - (d + 1); };
                            };
                            if (d >= R_VBASE & src < R_VBASE)
                            {
                                if (g.vhint[d] == 0 - 1) { g.vhint[d] = src; };
                            };
                            if (d < R_VBASE & src >= R_VBASE)
                            {
                                if (g.vhint[src] == 0 - 1) { g.vhint[src] = d; };
                            };
                        };
                        if (op == M_ALU | op == M_SHIFT)
                        {
                            if (mi.o0.k == MK_REG & mi.o2.k == MK_REG)
                            {
                                if (mi.o0.r >= R_VBASE & mi.o2.r >= R_VBASE)
                                {
                                    if (g.vhint[mi.o2.r] == 0 - 1) { g.vhint[mi.o2.r] = 0 - (mi.o0.r + 1); };
                                };
                            };
                        };
                        if (op == M_CMOV)
                        {
                            if (mi.o1.k == MK_REG & mi.o2.k == MK_REG)
                            {
                                if (mi.o1.r >= R_VBASE & mi.o2.r >= R_VBASE)
                                {
                                    if (g.vhint[mi.o2.r] == 0 - 1) { g.vhint[mi.o2.r] = 0 - (mi.o1.r + 1); };
                                };
                            };
                        };
                        if (op == M_PCOPY)
                        {
                            sg = (GB*)g.bl.items[mi.tgt];
                            k = 0;
                            while (k < sg.phis.len)
                            {
                                d = ((GP*)sg.phis.items[k]).dst;
                                src = this.s_pcsrc((GP*)sg.phis.items[k], mi.cc);
                                if (src >= R_VBASE & d >= R_VBASE & g.vcol[d] != 0 - 1 & g.vcol[src] != 0 - 1)
                                {
                                    if (g.vhint[d] == 0 - 1) { g.vhint[d] = 0 - (src + 1); };
                                    if (g.vhint[src] == 0 - 1) { g.vhint[src] = 0 - (d + 1); };
                                };
                                k++;
                            };
                        };
                        j--;
                    };
                    // drop the live set
                    u = 0;
                    while (u < g.nl) { g.lpos[g.llist[u]] = 0 - 1; u++; };
                    g.nl = 0;
                    i++;
                };
                // order of definition: the phi registers of a block first, then its instructions
                if (this.ord != (int*)0) { this.s_ifree(this.ord); };
                this.ord = this.s_iz(nv + 1);
                this.nord = 0;
                seen = this.s_iz(nv);
                i = 0;
                while (i < n)
                {
                    gb = g.rpo[i];
                    k = 0;
                    while (k < gb.phis.len)
                    {
                        d = ((GP*)gb.phis.items[k]).dst;
                        if (g.vcol[d] != 0 - 1 & seen[d] == 0) { seen[d] = 1; this.ord[this.nord] = d; this.nord++; };
                        k++;
                    };
                    j = 0;
                    while (j < gb.mi.len)
                    {
                        mi = (MI*)gb.mi.items[j];
                        this.s_scan(mi);
                        k = 0;
                        while (k < this.ndb)
                        {
                            d = this.dbuf[k];
                            if (d >= R_VBASE)
                            {
                                if (seen[d] == 0) { seen[d] = 1; this.ord[this.nord] = d; this.nord++; };
                            };
                            k++;
                        };
                        j++;
                    };
                    i++;
                };
                this.s_ifree(seen);
                // adjacency lists
                deg = this.s_iz(nv + 1);
                if (this.adjo != (int*)0) { this.s_ifree(this.adjo); this.s_ifree(this.adj); };
                this.adjo = this.s_iz(nv + 2);
                e = 0;
                while (e < this.ne)
                {
                    deg[this.ea[e]] = deg[this.ea[e]] + 1;
                    deg[this.eb[e]] = deg[this.eb[e]] + 1;
                    e++;
                };
                this.adjo[0] = 0;
                i = 0;
                while (i < nv)
                {
                    this.adjo[i + 1] = this.adjo[i] + deg[i];
                    i++;
                };
                this.adj = this.s_iz(this.adjo[nv] + 1);
                fill = this.s_iz(nv + 1);
                e = 0;
                while (e < this.ne)
                {
                    u = this.ea[e];
                    v = this.eb[e];
                    this.adj[this.adjo[u] + fill[u]] = v;
                    fill[u] = fill[u] + 1;
                    this.adj[this.adjo[v] + fill[v]] = u;
                    fill[v] = fill[v] + 1;
                    e++;
                };
                this.s_ifree(deg);
                this.s_ifree(fill);
                ->;
            };

            s_wadd(int v, int w) -> void
            {
                GF* g = this.sf;
                if (g.vwgt[v] < 900000000) { g.vwgt[v] = g.vwgt[v] + w; };
                ->;
            };

            // Colors the registers in definition order. A register that finds no free register makes the cheapest
            // of itself and its neighbors a spill. Returns the number of spilled registers, or -1 when a register
            // that cannot be spilled finds no color.
            s_color() -> int
            {
                GF* g = this.sf;
                int nv = g.nvr;
                int i, j, k, v, u, c, h, nsp, cls, pick, best, bestw, cnt, free, mask, e0, e1;
                int* tcnt = this.s_iz(32);
                nsp = 0;
                if (this.spl != (int*)0) { this.s_ifree(this.spl); };
                this.spl = this.s_iz(nv + 1);
                this.nspl = 0;
                i = 0;
                while (i < nv)
                {
                    if (g.vcol[i] != 0 - 1) { g.vcol[i] = 0 - 2; };
                    i++;
                };
                k = 0;
                while (k < this.nord)
                {
                    v = this.ord[k];
                    k++;
                    if (g.vcol[v] == 0 - 1) { continue; };
                    cls = g.vcls[v];
                    mask = this.s_allocmask(cls) `& (`!g.vforb[v]);
                    free = mask;
                    e0 = this.adjo[v];
                    e1 = this.adjo[v + 1];
                    j = e0;
                    while (j < e1)
                    {
                        c = g.vcol[this.adj[j]];
                        if (c >= 0) { free = free `& (`!(1 << c)); };
                        j++;
                    };
                    pick = 0 - 1;
                    h = g.vhint[v];
                    if (h >= 0)
                    {
                        if ((free `& (1 << h)) != 0) { pick = h; };
                    };
                    if (h < 0 & h != 0 - 1)
                    {
                        u = 0 - h - 1;
                        c = g.vcol[u];
                        if (c >= 0)
                        {
                            if ((free `& (1 << c)) != 0) { pick = c; };
                        };
                    };
                    if (pick < 0)
                    {
                        j = 0;
                        while (j < 16)
                        {
                            c = this.s_pref(cls, j);
                            if ((free `& (1 << c)) != 0) { pick = c; break; };
                            j++;
                        };
                    };
                    if (pick >= 0)
                    {
                        g.vcol[v] = pick;
                        continue;
                    };
                    // no register is free
                    best = 0 - 1;
                    bestw = 2000000000;
                    if (g.vwgt[v] < 1500000000)
                    {
                        best = v;
                        bestw = g.vwgt[v];
                    };
                    j = 0;
                    while (j < 32) { tcnt[j] = 0; j++; };
                    j = e0;
                    while (j < e1)
                    {
                        c = g.vcol[this.adj[j]];
                        if (c >= 0) { tcnt[c] = tcnt[c] + 1; };
                        j++;
                    };
                    j = e0;
                    while (j < e1)
                    {
                        u = this.adj[j];
                        c = g.vcol[u];
                        if (c >= 0)
                        {
                            if (g.vwgt[u] < 1500000000 & g.vwgt[u] < bestw & tcnt[c] == 1 & (mask `& (1 << c)) != 0)
                            {
                                best = u;
                                bestw = g.vwgt[u];
                            };
                        };
                        j++;
                    };
                    if (best < 0)
                    {
                        this.s_ifree(tcnt);
                        -> 0 - 1;
                    };
                    if (best == v)
                    {
                        g.vcol[v] = 0 - 1;
                    }
                    else
                    {
                        c = g.vcol[best];
                        g.vcol[best] = 0 - 1;
                        g.vcol[v] = c;
                    };
                    this.spl[this.nspl] = best;
                    this.nspl++;
                    nsp++;
                };
                this.s_ifree(tcnt);
                -> nsp;
            };

            // Reload of virtual register t from the spill slot of v, or the store when store is set
            s_spillmi(bool store, int t, int v) -> void
            {
                GF* g = this.sf;
                MO* mem = this.s_mo_mem(0 - 1, 0 - 1, 1, (i64)0, (byte*)0, g.vslot[v] - 1);
                int op = M_MOV;
                if (g.vcls[v] == 1) { op = M_XMOV; };
                if (store) { this.s_mi2(op, 8, this.s_mo_r(t, 8), mem); }
                else { this.s_mi2(op, 8, mem, this.s_mo_r(t, 8)); };
                ->;
            };

            // Rewrites the code so that the registers in spl live in memory: every use reloads into a short
            // register and every definition stores from one
            s_spill() -> void
            {
                GF* g = this.sf;
                int nv = g.nvr;
                int i, j, k, v, t, role, op;
                GB* gb;
                MI* m;
                MO* o;
                XFO* fo;
                PtrVec* old;
                bool any;
                int* sp = this.s_iz(nv + 1);
                int* held = this.s_iz(nv + 1);
                int* hpos = this.s_iz(nv + 1);
                int hv;
                MO* mem;
                i = 0;
                while (i < this.nspl)
                {
                    v = this.spl[i];
                    sp[v] = 1;
                    fo = (XFO*)this.s_ar((int)(((sizeof(XFO) + 7) / 8) * 2));
                    fo.size = 8;
                    fo.al = 8;
                    fo.off = 0;
                    fo.fix = 0;
                    pv_push(g.fobj, (void*)fo);
                    g.vslot[v] = g.fobj.len;
                    i++;
                };
                i = 0;
                while (i < g.nb)
                {
                    gb = g.rpo[i];
                    old = gb.mi;
                    gb.mi = pv_new();
                    this.scb = gb;
                    k = 0;
                    while (k < this.nspl) { held[this.spl[k]] = 0; k++; };
                    j = 0;
                    while (j < old.len)
                    {
                        m = (MI*)old.items[j];
                        j++;
                        if (m.op == M_CALL | m.op == M_ASM | m.op == M_PCOPY | m.op == M_DALLOC | m.op == M_TEXT)
                        {
                            k = 0;
                            while (k < this.nspl) { held[this.spl[k]] = 0; k++; };
                        };
                        if (m.op == M_PCOPY) { pv_push(gb.mi, (void*)m); continue; };
                        any = false;
                        k = 0;
                        while (k < 3)
                        {
                            o = this.s_opnd(m, k);
                            if (o != (MO*)0)
                            {
                                if (o.k == MK_REG) { if (o.r >= R_VBASE) { if (sp[o.r] == 1) { any = true; }; }; };
                                if (o.k == MK_MEM)
                                {
                                    if (o.r >= R_VBASE) { if (sp[o.r] == 1) { any = true; }; };
                                    if (o.r2 >= R_VBASE) { if (sp[o.r2] == 1) { any = true; }; };
                                };
                            };
                            k++;
                        };
                        if (!any) { pv_push(gb.mi, (void*)m); continue; };
                        // plain moves go straight to and from the slot
                        if (m.op == M_MOV & m.o0.k == MK_REG & m.o1.k == MK_REG)
                        {
                            if (m.o0.r >= R_VBASE & m.o1.r >= R_VBASE)
                            {
                                if (sp[m.o0.r] == 1 & sp[m.o1.r] == 0 & g.vcls[m.o0.r] == 0)
                                {
                                    m.o0 = this.s_mo_mem(0 - 1, 0 - 1, 1, (i64)0, (byte*)0, g.vslot[m.o0.r] - 1);
                                    pv_push(gb.mi, (void*)m);
                                    continue;
                                };
                                if (sp[m.o1.r] == 1 & sp[m.o0.r] == 0 & m.sz == 8 & g.vcls[m.o1.r] == 0)
                                {
                                    held[m.o1.r] = 0;
                                    m.o1 = this.s_mo_mem(0 - 1, 0 - 1, 1, (i64)0, (byte*)0, g.vslot[m.o1.r] - 1);
                                    pv_push(gb.mi, (void*)m);
                                    continue;
                                };
                            };
                        };
                        // reloads in front, stores behind
                        k = 0;
                        while (k < 3)
                        {
                            o = this.s_opnd(m, k);
                            if (o != (MO*)0)
                            {
                                role = this.s_role(m.op, k, o);
                                o = this.s_mo_copy(o);
                                if (k == 0) { m.o0 = o; };
                                if (k == 1) { m.o1 = o; };
                                if (k == 2) { m.o2 = o; };
                                if (o.k == MK_MEM)
                                {
                                    if (o.r >= R_VBASE)
                                    {
                                        if (sp[o.r] == 1)
                                        {
                                            hv = o.r;
                                            if (SSA_OPT_SPILLFWD == 1 & held[hv] != 0 & gb.mi.len - hpos[hv] <= 6) { t = held[hv]; }
                                            else
                                            {
                                                t = this.s_nv(g.vcls[hv]);
                                                g.vwgt[t] = 2000000000;
                                                this.s_spillmi(false, t, hv);
                                                held[hv] = t;
                                                hpos[hv] = gb.mi.len;
                                            };
                                            o.r = t;
                                        };
                                    };
                                    if (o.r2 >= R_VBASE)
                                    {
                                        if (sp[o.r2] == 1)
                                        {
                                            hv = o.r2;
                                            if (SSA_OPT_SPILLFWD == 1 & held[hv] != 0 & gb.mi.len - hpos[hv] <= 6) { t = held[hv]; }
                                            else
                                            {
                                                t = this.s_nv(g.vcls[hv]);
                                                g.vwgt[t] = 2000000000;
                                                this.s_spillmi(false, t, hv);
                                                held[hv] = t;
                                                hpos[hv] = gb.mi.len;
                                            };
                                            o.r2 = t;
                                        };
                                    };
                                };
                                if (o.k == MK_REG)
                                {
                                    if (o.r >= R_VBASE)
                                    {
                                        if (sp[o.r] == 1 & role == 1)
                                        {
                                            hv = o.r;
                                            if (SSA_OPT_SPILLFWD == 1 & held[hv] != 0 & gb.mi.len - hpos[hv] <= 6) { t = held[hv]; }
                                            else
                                            {
                                                t = this.s_nv(g.vcls[hv]);
                                                g.vwgt[t] = 2000000000;
                                                this.s_spillmi(false, t, hv);
                                                held[hv] = t;
                                                hpos[hv] = gb.mi.len;
                                            };
                                            o.r = t;
                                        };
                                    };
                                };
                            };
                            k++;
                        };
                        pv_push(gb.mi, (void*)m);
                        k = 0;
                        while (k < 3)
                        {
                            o = this.s_opnd(m, k);
                            if (o != (MO*)0)
                            {
                                if (o.k == MK_REG)
                                {
                                    role = this.s_role(m.op, k, o);
                                    if (o.r >= R_VBASE & role == 2)
                                    {
                                        if (sp[o.r] == 1)
                                        {
                                            t = this.s_nv(g.vcls[o.r]);
                                            g.vwgt[t] = 2000000000;
                                            v = o.r;
                                            o.r = t;
                                            this.s_spillmi(true, t, v);
                                            held[v] = t;
                                            hpos[v] = gb.mi.len;
                                        };
                                    };
                                };
                            };
                            k++;
                        };
                    };
                    pv_free(old);
                    i++;
                };
                i = 0;
                while (i < this.nspl)
                {
                    g.vcol[this.spl[i]] = 0 - 1;
                    i++;
                };
                this.s_ifree(sp);
                this.s_ifree(held);
                this.s_ifree(hpos);
                ->;
            };

            s_opnd(MI* m, int k) -> MO*
            {
                if (k == 0) { -> m.o0; };
                if (k == 1) { -> m.o1; };
                -> m.o2;
            };

            // Allocates registers for the selected code
            s_ra() -> bool
            {
                GF* g = this.sf;
                int rounds = 0;
                int r, i, b, cs, j, k;
                GB* gb;
                cs = this.s_csmask();
                while (true)
                {
                    rounds++;
                    if (rounds > 80) { this.s_fail(g"register allocation rounds\0"); -> false; };
                    this.s_globals();
                    this.s_liveness();
                    this.s_graph();
                    r = this.s_color();
                    if (r < 0) { this.s_fail(g"register allocation\0"); -> false; };
                    if (r == 0) { break; };
                    this.s_spill();
                };
                g.saved = g.asmsv `& cs;
                i = R_VBASE;
                while (i < g.nvr)
                {
                    if (g.vcol[i] >= 0)
                    {
                        b = 1 << g.vcol[i];
                        if ((cs `& b) != 0) { g.saved = g.saved `| b; };
                    };
                    i++;
                };
                // callee saved registers written by name (the string moves use rsi and rdi) are saved too
                i = 0;
                while (i < g.nb)
                {
                    gb = g.rpo[i];
                    j = 0;
                    while (j < gb.mi.len)
                    {
                        this.s_scan((MI*)gb.mi.items[j]);
                        k = 0;
                        while (k < this.ndb)
                        {
                            r = this.dbuf[k];
                            if (r < 16)
                            {
                                b = 1 << r;
                                if ((cs `& b) != 0) { g.saved = g.saved `| b; };
                            };
                            k++;
                        };
                        j++;
                    };
                    i++;
                };
                -> true;
            };

            // ==========================================================
            // frame layout, lowering of the machine instructions to AT&T assembly text,
            // parallel copies and the function writer.
            // ==========================================================

            // ----------------------------------------------------------
            // Register names
            // ----------------------------------------------------------

            s_rnames() -> void
            {
                byte** t;
                if (this.rn != (byte**)0) { ->; };
                t = (byte**)fmalloc((u64)(8 * 80));
                t[0] = g"rax\0"; t[1] = g"rcx\0"; t[2] = g"rdx\0"; t[3] = g"rbx\0"; t[4] = g"rsp\0"; t[5] = g"rbp\0"; t[6] = g"rsi\0"; t[7] = g"rdi\0";
                t[8] = g"r8\0"; t[9] = g"r9\0"; t[10] = g"r10\0"; t[11] = g"r11\0"; t[12] = g"r12\0"; t[13] = g"r13\0"; t[14] = g"r14\0"; t[15] = g"r15\0";
                t[16] = g"eax\0"; t[17] = g"ecx\0"; t[18] = g"edx\0"; t[19] = g"ebx\0"; t[20] = g"esp\0"; t[21] = g"ebp\0"; t[22] = g"esi\0"; t[23] = g"edi\0";
                t[24] = g"r8d\0"; t[25] = g"r9d\0"; t[26] = g"r10d\0"; t[27] = g"r11d\0"; t[28] = g"r12d\0"; t[29] = g"r13d\0"; t[30] = g"r14d\0"; t[31] = g"r15d\0";
                t[32] = g"ax\0"; t[33] = g"cx\0"; t[34] = g"dx\0"; t[35] = g"bx\0"; t[36] = g"sp\0"; t[37] = g"bp\0"; t[38] = g"si\0"; t[39] = g"di\0";
                t[40] = g"r8w\0"; t[41] = g"r9w\0"; t[42] = g"r10w\0"; t[43] = g"r11w\0"; t[44] = g"r12w\0"; t[45] = g"r13w\0"; t[46] = g"r14w\0"; t[47] = g"r15w\0";
                t[48] = g"al\0"; t[49] = g"cl\0"; t[50] = g"dl\0"; t[51] = g"bl\0"; t[52] = g"spl\0"; t[53] = g"bpl\0"; t[54] = g"sil\0"; t[55] = g"dil\0";
                t[56] = g"r8b\0"; t[57] = g"r9b\0"; t[58] = g"r10b\0"; t[59] = g"r11b\0"; t[60] = g"r12b\0"; t[61] = g"r13b\0"; t[62] = g"r14b\0"; t[63] = g"r15b\0";
                this.rn = t;
                ->;
            };

            // Hardware register of register number r after allocation
            s_phys(int r) -> int
            {
                if (r >= R_VBASE) { -> this.sf.vcol[r]; };
                -> r;
            };

            // Writes the name of hardware register r for an access of sz bytes
            e_reg(Buf* o, int r, int sz) -> void
            {
                int k;
                o.put(37);
                if (r >= 16)
                {
                    o.put_str(g"xmm\0");
                    o.put_int(r - 16);
                    ->;
                };
                k = 0;
                if (sz == 4) { k = 1; };
                if (sz == 2) { k = 2; };
                if (sz == 1) { k = 3; };
                o.put_str(this.rn[k * 16 + r]);
                ->;
            };

            // Memory operand text
            e_mem(Buf* o, MO* m) -> void
            {
                i64 disp = m.imm;
                int base = m.r;
                if (m.fo >= 0)
                {
                    disp = disp + (i64)((XFO*)this.sf.fobj.items[m.fo]).off;
                    base = 5;
                };
                if (base == 5 & this.sf.nofp)
                {
                    // no frame pointer: rbp + disp is rsp + disp + frame - 8
                    disp = disp + (i64)(this.sf.frame - 8);
                    base = 4;
                };
                if (m.sym != (byte*)0)
                {
                    o.put_str(m.sym);
                    if (disp > (i64)0) { o.put(43); put_i64(o, disp); };
                    if (disp < (i64)0) { put_i64(o, disp); };
                    if (m.r2 >= 0)
                    {
                        o.put_str(g"(,\0");
                        this.e_reg(o, this.s_phys(m.r2), 8);
                        o.put(44);
                        o.put_int(m.sc);
                        o.put(41);
                        ->;
                    };
                    o.put_str(g"(%rip)\0");
                    ->;
                };
                if (disp != (i64)0) { put_i64(o, disp); };
                if (base >= 0 | m.r2 >= 0)
                {
                    o.put(40);
                    if (base >= 0) { this.e_reg(o, this.s_phys(base), 8); };
                    if (m.r2 >= 0)
                    {
                        o.put(44);
                        this.e_reg(o, this.s_phys(m.r2), 8);
                        o.put(44);
                        o.put_int(m.sc);
                    };
                    o.put(41);
                    ->;
                };
                if (disp == (i64)0) { o.put(48); };
                ->;
            };

            // Operand text for an access of sz bytes
            e_op(Buf* o, MO* m, int sz) -> void
            {
                if (m.k == MK_REG) { this.e_reg(o, this.s_phys(m.r), sz); ->; };
                if (m.k == MK_IMM) { o.put(36); put_i64(o, m.imm); ->; };
                if (m.k == MK_MEM) { this.e_mem(o, m); ->; };
                if (m.k == MK_SYM) { o.put_str(m.sym); ->; };
                ->;
            };

            // Size letter of the mnemonic
            e_sfx(Buf* o, int sz) -> void
            {
                if (sz == 8) { o.put(113); ->; };
                if (sz == 4) { o.put(108); ->; };
                if (sz == 2) { o.put(119); ->; };
                o.put(98);
                ->;
            };

            // Condition code suffix
            e_cc(Buf* o, int cc) -> void
            {
                if (cc == C_E) { o.put_str(g"e\0"); ->; };
                if (cc == C_NE) { o.put_str(g"ne\0"); ->; };
                if (cc == C_B) { o.put_str(g"b\0"); ->; };
                if (cc == C_AE) { o.put_str(g"ae\0"); ->; };
                if (cc == C_BE) { o.put_str(g"be\0"); ->; };
                if (cc == C_A) { o.put_str(g"a\0"); ->; };
                if (cc == C_L) { o.put_str(g"l\0"); ->; };
                if (cc == C_GE) { o.put_str(g"ge\0"); ->; };
                if (cc == C_LE) { o.put_str(g"le\0"); ->; };
                if (cc == C_G) { o.put_str(g"g\0"); ->; };
                if (cc == C_P) { o.put_str(g"p\0"); ->; };
                if (cc == C_NP) { o.put_str(g"np\0"); ->; };
                if (cc == C_S) { o.put_str(g"s\0"); ->; };
                o.put_str(g"ns\0");
                ->;
            };

            // ----------------------------------------------------------
            // Frame layout
            // ----------------------------------------------------------

            s_layout() -> void
            {
                GF* g = this.sf;
                int i, k, run, al, sz, cs;
                XFO* fo;
                cs = 0;
                k = 0;
                while (k < 16)
                {
                    if ((g.saved `& (1 << k)) != 0) { cs++; };
                    k++;
                };
                run = cs * 8;
                i = 0;
                while (i < g.fobj.len)
                {
                    fo = (XFO*)g.fobj.items[i];
                    if (fo.fix == 0)
                    {
                        al = fo.al;
                        if (al > 16) { al = 16; };
                        if (al < 1) { al = 1; };
                        run = run + fo.size;
                        run = (run + al - 1) / al * al;
                        fo.off = 0 - run;
                    };
                    i++;
                };
                g.frame = (run + g.outmax + 15) / 16 * 16;
                ->;
            };

            // ----------------------------------------------------------
            // Lowering
            // ----------------------------------------------------------

            // True when a later instruction of the block reads the flags before another one writes them
            s_flags_live(GB* gb, int idx) -> bool
            {
                int j = idx + 1;
                MI* m;
                int op;
                while (j < gb.mi.len)
                {
                    m = (MI*)gb.mi.items[j];
                    op = m.op;
                    if (op == M_JCC | op == M_SETCC | op == M_CMOV | op == M_FSEL) { -> true; };
                    if (op == M_CMP | op == M_TEST | op == M_FCMP | op == M_CVT | op == M_FREM | op == M_ALU | op == M_SHIFT | op == M_UN | op == M_RMW | op == M_BREV | op == M_DIV | op == M_CALL | op == M_ASM | op == M_DALLOC | op == M_JMP | op == M_RET) { -> false; };
                    j++;
                };
                -> false;
            };

            // True when every instruction that reads the flags after idx looks only at the zero and sign flags
            s_flags_zs(GB* gb, int idx) -> bool
            {
                int j = idx + 1;
                MI* m;
                int op;
                while (j < gb.mi.len)
                {
                    m = (MI*)gb.mi.items[j];
                    op = m.op;
                    if (op == M_JCC | op == M_SETCC | op == M_CMOV)
                    {
                        if (m.cc != C_E & m.cc != C_NE & m.cc != C_S & m.cc != C_NS) { -> false; };
                    };
                    if (op == M_FSEL) { -> false; };
                    if (op == M_CMP | op == M_TEST | op == M_FCMP | op == M_CVT | op == M_FREM | op == M_ALU | op == M_SHIFT | op == M_UN | op == M_RMW | op == M_BREV | op == M_DIV | op == M_CALL | op == M_ASM | op == M_DALLOC | op == M_JMP | op == M_RET) { -> true; };
                    j++;
                };
                -> true;
            };

            e_ln(Buf* o, byte* s) -> void
            {
                o.put(9);
                o.put_str(s);
                o.put(10);
                ->;
            };

            // Writes "mnemonic suffix src, dst" for a two operand instruction
            e_two(Buf* o, byte* mn, int sz, MO* a, MO* b, int asz, int bsz) -> void
            {
                o.put(9);
                o.put_str(mn);
                if (sz > 0) { this.e_sfx(o, sz); };
                o.put(32);
                this.e_op(o, a, asz);
                o.put_str(g", \0");
                this.e_op(o, b, bsz);
                o.put(10);
                ->;
            };

            // Moves of sz bytes between register, memory and immediate operands
            e_mov(Buf* o, MO* a, MO* b, int sz, bool zero, bool flags) -> void
            {
                int pa, pb;
                if (a.k == MK_REG & b.k == MK_REG)
                {
                    pa = this.s_phys(a.r);
                    pb = this.s_phys(b.r);
                    if (pa == pb)
                    {
                        if (!(sz == 4 & zero)) { ->; };
                    };
                    if (pa >= 16 | pb >= 16)
                    {
                        this.s_fail(g"xmm move\0");
                        ->;
                    };
                    if (sz < 4) { sz = 4; };
                    this.e_two(o, g"mov\0", sz, a, b, sz, sz);
                    ->;
                };
                if (a.k == MK_IMM & b.k == MK_REG)
                {
                    if (a.imm == (i64)0 & !flags)
                    {
                        pb = this.s_phys(b.r);
                        o.put(9);
                        o.put_str(g"xorl \0");
                        this.e_reg(o, pb, 4);
                        o.put_str(g", \0");
                        this.e_reg(o, pb, 4);
                        o.put(10);
                        ->;
                    };
                    if (sz < 4) { sz = 4; };
                    this.e_two(o, g"mov\0", sz, a, b, sz, sz);
                    ->;
                };
                this.e_two(o, g"mov\0", sz, a, b, sz, sz);
                ->;
            };

            s_ccinv(int cc) -> int
            {
                -> this.s_invcc(cc);
            };

            // Lowers instruction idx of block gb
            e_mi(Buf* o, GB* gb, int idx, GB* next) -> void
            {
                MI* m = (MI*)gb.mi.items[idx];
                int op = m.op;
                int sz = m.sz;
                int pa, pb, pd, k, cc, nid, j2, k2;
                bool ok2;
                MO* a;
                MO* b;
                MO* d;
                MI* m2;
                bool sw;
                if (op == M_LABEL) { ->; };
                if (op == M_MOV)
                {
                    this.e_mov(o, m.o0, m.o1, sz, m.cc == 1, this.s_flags_live(gb, idx));
                    ->;
                };
                if (op == M_MOVABS)
                {
                    o.put(9);
                    o.put_str(g"movabsq $\0");
                    put_i64(o, m.o0.imm);
                    o.put_str(g", \0");
                    this.e_op(o, m.o1, 8);
                    o.put(10);
                    ->;
                };
                if (op == M_MOVZX)
                {
                    // extending a register that the previous instruction already zero extended from the same or a smaller size
                    if (SSA_OPT_ZEXT == 1 & idx > 0 & m.o0.k == MK_REG & m.o1.k == MK_REG)
                    {
                        if (this.s_phys(m.o0.r) == this.s_phys(m.o1.r))
                        {
                            m2 = (MI*)gb.mi.items[idx - 1];
                            if (m2.op == M_MOVZX & m2.sz <= sz & m2.o1.k == MK_REG)
                            {
                                if (this.s_phys(m2.o1.r) == this.s_phys(m.o1.r)) { ->; };
                            };
                            if (m2.op == M_PCOPY)
                            {
                                if (this.s_pc_zx(m2, this.s_phys(m.o0.r), sz)) { ->; };
                            };
                            if (m2.op == M_MOV & (m2.sz == 4 | m2.sz == 8) & m2.o0.k == MK_IMM & m2.o1.k == MK_REG)
                            {
                                if (this.s_phys(m2.o1.r) == this.s_phys(m.o1.r) & m2.o0.imm >= (i64)0 & m2.o0.imm < (i64)(1 << (8 * sz))) { ->; };
                            };
                        };
                    };
                    o.put(9);
                    if (sz == 1) { o.put_str(g"movzbl \0"); } else { o.put_str(g"movzwl \0"); };
                    this.e_op(o, m.o0, sz);
                    o.put_str(g", \0");
                    this.e_op(o, m.o1, 4);
                    o.put(10);
                    ->;
                };
                if (op == M_MOVSX)
                {
                    o.put(9);
                    if (sz == 4) { o.put_str(g"movslq \0"); }
                    else
                    {
                        if (sz == 1 & m.cc == 4) { o.put_str(g"movsbl \0"); };
                        if (sz == 1 & m.cc == 8) { o.put_str(g"movsbq \0"); };
                        if (sz == 2 & m.cc == 4) { o.put_str(g"movswl \0"); };
                        if (sz == 2 & m.cc == 8) { o.put_str(g"movswq \0"); };
                    };
                    this.e_op(o, m.o0, sz);
                    o.put_str(g", \0");
                    this.e_op(o, m.o1, m.cc);
                    o.put(10);
                    ->;
                };
                if (op == M_LEA)
                {
                    o.put(9);
                    o.put_str(g"leaq \0");
                    this.e_mem(o, m.o0);
                    o.put_str(g", \0");
                    this.e_op(o, m.o1, 8);
                    o.put(10);
                    ->;
                };
                if (op == M_ALU)
                {
                    // a mask that keeps what the previous instruction already left in the same register
                    if (SSA_OPT_ZEXT == 1 & idx > 0 & m.cc == A_AND & m.o1.k == MK_IMM & m.o0.k == MK_REG & m.o2.k == MK_REG)
                    {
                        j2 = idx - 1;
                        m2 = (MI*)gb.mi.items[j2];
                        // register moves the allocator made into no-ops do not count
                        while (j2 > 0 & m2.op == M_MOV)
                        {
                            if (m2.o0.k != MK_REG | m2.o1.k != MK_REG) { break; };
                            if (this.s_phys(m2.o0.r) != this.s_phys(m2.o1.r) | m2.cc == 1) { break; };
                            j2--;
                            m2 = (MI*)gb.mi.items[j2];
                        };
                        if (m2.op == M_ALU & m2.cc == A_AND & m2.o1.k == MK_IMM & m2.o2.k == MK_REG & m2.o0.k == MK_REG)
                        {
                            if (this.s_phys(m2.o2.r) == this.s_phys(m.o0.r) & this.s_phys(m.o0.r) == this.s_phys(m.o2.r) & m.sz >= m2.sz)
                            {
                                if (m2.o1.imm >= (i64)0 & m.o1.imm >= (i64)0)
                                {
                                    if ((m2.o1.imm `& (m.o1.imm `^| (i64)-1)) == (i64)0)
                                    {
                                        if (!this.s_flags_live(gb, idx))
                                        {
                                            // a test of the result right behind relies on these flags
                                            ok2 = true;
                                            if (idx + 1 < gb.mi.len) { if (((MI*)gb.mi.items[idx + 1]).op == M_TEST) { ok2 = false; }; };
                                            if (ok2) { ->; };
                                        };
                                    };
                                };
                            };
                        };
                    };
                    this.e_alu(o, m);
                    ->;
                };
                if (op == M_SHIFT)
                {
                    a = m.o0;
                    d = m.o2;
                    pa = this.s_phys(a.r);
                    pd = this.s_phys(d.r);
                    if (m.tgt == 77)
                    {
                        o.put(9);
                        if (m.cc == S_SHL) { o.put_str(g"shlx \0"); };
                        if (m.cc == S_SHR) { o.put_str(g"shrx \0"); };
                        if (m.cc == S_SAR) { o.put_str(g"sarx \0"); };
                        if (m.cc == S_ROR) { o.put_str(g"rorx \0"); };
                        this.e_op(o, m.o1, sz);
                        o.put_str(g", \0");
                        this.e_op(o, a, sz);
                        o.put_str(g", \0");
                        this.e_op(o, d, sz);
                        o.put(10);
                        ->;
                    };
                    if (pa != pd) { this.e_two(o, g"mov\0", sz, a, d, sz, sz); };
                    o.put(9);
                    if (m.cc == S_SHL) { o.put_str(g"shl\0"); };
                    if (m.cc == S_SHR) { o.put_str(g"shr\0"); };
                    if (m.cc == S_SAR) { o.put_str(g"sar\0"); };
                    this.e_sfx(o, sz);
                    o.put(32);
                    if (m.o1.k == MK_IMM) { o.put(36); put_i64(o, m.o1.imm); } else { o.put_str(g"%cl\0"); };
                    o.put_str(g", \0");
                    this.e_op(o, d, sz);
                    o.put(10);
                    ->;
                };
                if (op == M_BREV)
                {
                    this.e_brev(o, m);
                    ->;
                };
                if (op == M_RMW)
                {
                    if (m.cc == A_AND) { this.e_two(o, g"and\0", sz, m.o0, m.o1, sz, sz); ->; };
                    if (m.cc == A_OR) { this.e_two(o, g"or\0", sz, m.o0, m.o1, sz, sz); ->; };
                    this.e_two(o, g"xor\0", sz, m.o0, m.o1, sz, sz);
                    ->;
                };
                if (op == M_UN)
                {
                    a = m.o0;
                    d = m.o1;
                    if (m.cc == U_MOVBE)
                    {
                        this.e_two(o, g"movbe\0", sz, a, d, sz, sz);
                        ->;
                    };
                    if (m.cc == U_POPCNT | m.cc == U_LZCNT | m.cc == U_TZCNT)
                    {
                        if (m.cc == U_POPCNT) { this.e_two(o, g"popcnt\0", sz, a, d, sz, sz); };
                        if (m.cc == U_LZCNT) { this.e_two(o, g"lzcnt\0", sz, a, d, sz, sz); };
                        if (m.cc == U_TZCNT) { this.e_two(o, g"tzcnt\0", sz, a, d, sz, sz); };
                        ->;
                    };
                    if (m.cc == U_BLSR | m.cc == U_BLSI)
                    {
                        if (m.cc == U_BLSR) { this.e_two(o, g"blsr\0", 0, a, d, sz, sz); } else { this.e_two(o, g"blsi\0", 0, a, d, sz, sz); };
                        ->;
                    };
                    if (this.s_phys(a.r) != this.s_phys(d.r)) { this.e_two(o, g"mov\0", sz, a, d, sz, sz); };
                    o.put(9);
                    if (m.cc == U_BSWAP)
                    {
                        if (sz == 2) { o.put_str(g"rolw $8, \0"); this.e_op(o, d, 2); o.put(10); ->; };
                        if (sz == 4) { o.put_str(g"bswapl \0"); } else { o.put_str(g"bswapq \0"); };
                        this.e_op(o, d, sz);
                        o.put(10);
                        ->;
                    };
                    if (m.cc == U_NEG) { o.put_str(g"neg\0"); } else { o.put_str(g"not\0"); };
                    this.e_sfx(o, sz);
                    o.put(32);
                    this.e_op(o, d, sz);
                    o.put(10);
                    ->;
                };
                if (op == M_CMP) { this.e_two(o, g"cmp\0", sz, m.o1, m.o0, sz, sz); ->; };
                if (op == M_TEST)
                {
                    // testing a register the previous instruction just computed in place: its flags already
                    // describe the result when only the zero and sign conditions are looked at
                    if (SSA_OPT_TESTELIM == 1 & (idx > 0 | this.rprev != (MI*)0) & m.o0.k == MK_REG & m.o1.k == MK_REG)
                    {
                        if (this.s_phys(m.o0.r) == this.s_phys(m.o1.r))
                        {
                            if (idx > 0)
                            {
                                k2 = idx - 1;
                                m2 = (MI*)gb.mi.items[k2];
                                // a move of a register onto itself prints nothing
                                while (k2 > 0 & this.s_noop_mi(m2))
                                {
                                    k2--;
                                    m2 = (MI*)gb.mi.items[k2];
                                };
                            }
                            else { m2 = this.rprev; };
                            if (m2.op != M_ALU) { m2 = (MI*)0; };
                            if (m2 != (MI*)0)
                            {
                                if (m2.sz != sz | m2.o0 == (MO*)0 | m2.o2 == (MO*)0) { m2 = (MI*)0; };
                            };
                            if (m2 != (MI*)0)
                            {
                                if (m2.o0.k != MK_REG | m2.o2.k != MK_REG) { m2 = (MI*)0; };
                            };
                            if (m2 != (MI*)0)
                            {
                                if (m2.cc == A_ADD | m2.cc == A_SUB | m2.cc == A_OR | m2.cc == A_XOR | m2.cc == A_AND)
                                {
                                    if (this.s_phys(m2.o0.r) == this.s_phys(m2.o2.r) & this.s_phys(m2.o2.r) == this.s_phys(m.o0.r))
                                    {
                                        if (this.s_flags_zs(gb, idx)) { ->; };
                                    };
                                };
                            };
                        };
                    };
                    this.e_two(o, g"test\0", sz, m.o1, m.o0, sz, sz);
                    ->;
                };
                if (op == M_SETCC)
                {
                    o.put(9);
                    o.put_str(g"set\0");
                    this.e_cc(o, m.cc);
                    o.put(32);
                    this.e_op(o, m.o0, 1);
                    o.put(10);
                    ->;
                };
                if (op == M_CMOV)
                {
                    a = m.o0;
                    b = m.o1;
                    d = m.o2;
                    cc = m.cc;
                    pa = this.s_phys(a.r);
                    pb = this.s_phys(b.r);
                    pd = this.s_phys(d.r);
                    if (pd == pb)
                    {
                    }
                    else
                    {
                        if (pd == pa)
                        {
                            // d already holds the value for the true case: move the other one in when the condition is false
                            a = m.o1;
                            cc = this.s_invcc(cc);
                        }
                        else
                        {
                            this.e_two(o, g"mov\0", sz, b, d, sz, sz);
                        };
                    };
                    o.put(9);
                    o.put_str(g"cmov\0");
                    this.e_cc(o, cc);
                    o.put(32);
                    this.e_op(o, a, sz);
                    o.put_str(g", \0");
                    this.e_op(o, d, sz);
                    o.put(10);
                    ->;
                };
                if (op == M_JCC | op == M_JMP)
                {
                    this.e_jump(o, gb, idx, next);
                    ->;
                };
                if (op == M_CALL)
                {
                    if (m.tgt == 77 & m.o0.k == MK_SYM)
                    {
                        // a call whose result is returned as it is: restore the frame and jump
                        k2 = idx + 1;
                        ok2 = true;
                        while (k2 < gb.mi.len & ok2)
                        {
                            m2 = (MI*)gb.mi.items[k2];
                            if (m2.op == M_RET) { break; };
                            if (m2.op == M_MOV & m2.o0.k == MK_REG & m2.o1.k == MK_REG)
                            {
                                if (this.s_phys(m2.o0.r) != this.s_phys(m2.o1.r)) { ok2 = false; };
                            }
                            else { ok2 = false; };
                            k2++;
                        };
                        if (ok2 & k2 == gb.mi.len - 1)
                        {
                            this.e_epilogue2(o, true);
                            o.put(9);
                            o.put_str(g"jmp \0");
                            o.put_str(m.o0.sym);
                            o.put(10);
                            m2.op = M_LABEL;
                            ->;
                        };
                    };
                    o.put(9);
                    o.put_str(g"callq \0");
                    if (m.o0.k == MK_SYM) { o.put_str(m.o0.sym); }
                    else
                    {
                        o.put(42);
                        this.e_op(o, m.o0, 8);
                    };
                    o.put(10);
                    ->;
                };
                if (op == M_RET) { this.e_epilogue(o); ->; };
                if (op == M_CQO)
                {
                    if (sz == 8) { this.e_ln(o, g"cqto\0"); } else { this.e_ln(o, g"cltd\0"); };
                    ->;
                };
                if (op == M_DIV)
                {
                    o.put(9);
                    if (m.cc == 1) { o.put_str(g"idiv\0"); }
                    elif (m.cc == 2) { o.put_str(g"mul\0"); }
                    elif (m.cc == 3) { o.put_str(g"imul\0"); }
                    else { o.put_str(g"div\0"); };
                    this.e_sfx(o, sz);
                    o.put(32);
                    this.e_op(o, m.o0, sz);
                    o.put(10);
                    ->;
                };
                if (op == M_UD2) { this.e_ln(o, g"ud2\0"); ->; };
                if (op == M_FALU) { this.e_falu(o, m); ->; };
                if (op == M_FCMP) { this.e_fcmp(o, m); ->; };
                if (op == M_CVT) { this.e_cvt(o, m); ->; };
                if (op == M_GX) { this.e_gx(o, m); ->; };
                if (op == M_XMOV) { this.e_xmov(o, m); ->; };
                if (op == M_FSEL) { this.e_fsel(o, m); ->; };
                if (op == M_FREM) { this.e_frem(o, m); ->; };
                if (op == M_JTAB) { this.e_jtab(o, m); ->; };
                if (op == M_JTAB2) { this.e_radix(o, m); ->; };
                if (op == M_PCOPY) { this.e_pcopy(o, m); ->; };
                if (op == M_COPY) { this.e_copy(o, m); ->; };
                if (op == M_DALLOC)
                {
                    o.put_str(g"\tsubq \0");
                    this.e_op(o, m.o0, 8);
                    o.put_str(g", %rsp\n\tleaq \0");
                    if (this.sf.outmax > 0) { o.put_int(this.sf.outmax); };
                    o.put_str(g"(%rsp), \0");
                    this.e_op(o, m.o1, 8);
                    o.put(10);
                    ->;
                };
                if (op == M_VAARG) { this.e_vaarg(o, m); ->; };
                if (op == M_VASTART) { this.e_vastart(o, m); ->; };
                if (op == M_SAVEVA) { this.e_saveva(o, m); ->; };
                if (op == M_ASM) { o.put_str(m.text); ->; };
                if (op == M_INT3) { this.e_ln(o, g"int3\0"); ->; };
                if (op == M_MEMMOVE) { this.e_memmove(o); ->; };
                if (op == M_REPSTOS) { this.e_ln(o, g"rep stosb\0"); ->; };
                if (op == M_REPMOVS) { this.e_ln(o, g"rep movsb\0"); ->; };
                this.s_fail(g"emit instruction\0");
                ->;
            };

            // Overlap safe copy: forwards when the destination is below the source, backwards otherwise
            e_memmove(Buf* o) -> void
            {
                int l1, l2;
                this.lab++;
                l1 = this.lab;
                this.lab++;
                l2 = this.lab;
                this.e_ln(o, g"cmpq %rsi, %rdi\0");
                this.e_ln(o, f"jbe .LM{l1}\0");
                this.e_ln(o, g"leaq -1(%rsi,%rcx), %rsi\0");
                this.e_ln(o, g"leaq -1(%rdi,%rcx), %rdi\0");
                this.e_ln(o, g"std\0");
                this.e_ln(o, g"rep movsb\0");
                this.e_ln(o, g"cld\0");
                this.e_ln(o, f"jmp .LM{l2}\0");
                o.put_str(f".LM{l1}:\n\0");
                this.e_ln(o, g"rep movsb\0");
                o.put_str(f".LM{l2}:\n\0");
                ->;
            };

            // Writes "text(%list)" style lines for the va_list at register r
            e_lst(Buf* o, int r, int disp) -> void
            {
                if (disp != 0) { o.put_int(disp); };
                o.put(40);
                this.e_reg(o, r, 8);
                o.put(41);
                ->;
            };

            e_saveva(Buf* o, MI* m) -> void
            {
                int i;
                i64 off;
                if (m.tgt < 0)
                {
                    this.e_ln(o, g"movq %rcx, 16(%rbp)\0");
                    this.e_ln(o, g"movq %rdx, 24(%rbp)\0");
                    this.e_ln(o, g"movq %r8, 32(%rbp)\0");
                    this.e_ln(o, g"movq %r9, 40(%rbp)\0");
                    ->;
                };
                off = (i64)((XFO*)this.sf.fobj.items[m.tgt]).off;
                i = 0;
                while (i < 6)
                {
                    o.put_str(g"\tmovq \0");
                    if (i == 0) { o.put_str(g"%rdi\0"); };
                    if (i == 1) { o.put_str(g"%rsi\0"); };
                    if (i == 2) { o.put_str(g"%rdx\0"); };
                    if (i == 3) { o.put_str(g"%rcx\0"); };
                    if (i == 4) { o.put_str(g"%r8\0"); };
                    if (i == 5) { o.put_str(g"%r9\0"); };
                    o.put_str(g", \0");
                    put_i64(o, off + (i64)(8 * i));
                    o.put_str(g"(%rbp)\n\0");
                    i++;
                };
                i = 0;
                while (i < 8)
                {
                    o.put_str(g"\tmovaps %xmm\0");
                    o.put_int(i);
                    o.put_str(g", \0");
                    put_i64(o, off + (i64)(48 + 16 * i));
                    o.put_str(g"(%rbp)\n\0");
                    i++;
                };
                ->;
            };

            e_vastart(Buf* o, MI* m) -> void
            {
                GF* g = this.sf;
                int r = this.s_phys(m.o0.r);
                if (this.a_win())
                {
                    o.put_str(g"\tleaq \0");
                    o.put_int(16 + 8 * g.vagp);
                    o.put_str(g"(%rbp), %r10\n\tmovq %r10, (\0");
                    this.e_reg(o, r, 8);
                    o.put_str(g")\n\0");
                    ->;
                };
                o.put_str(g"\tmovl $\0");
                o.put_int(g.vagp * 8);
                o.put_str(g", (\0");
                this.e_reg(o, r, 8);
                o.put_str(g")\n\tmovl $\0");
                o.put_int(48 + g.vafp * 16);
                o.put_str(g", 4(\0");
                this.e_reg(o, r, 8);
                o.put_str(g")\n\tleaq \0");
                o.put_int(g.vastk);
                o.put_str(g"(%rbp), %r10\n\tmovq %r10, 8(\0");
                this.e_reg(o, r, 8);
                o.put_str(g")\n\tleaq \0");
                put_i64(o, (i64)((XFO*)g.fobj.items[g.vafo - 1]).off);
                o.put_str(g"(%rbp), %r10\n\tmovq %r10, 16(\0");
                this.e_reg(o, r, 8);
                o.put_str(g")\n\0");
                ->;
            };

            e_vaarg(Buf* o, MI* m) -> void
            {
                int r = this.s_phys(m.o0.r);
                int sz = m.sz;
                int l1, l2;
                bool fp = m.cc == 1;
                if (this.a_win())
                {
                    o.put_str(g"\tmovq (\0");
                    this.e_reg(o, r, 8);
                    o.put_str(g"), %r10\n\tleaq 8(%r10), %r11\n\tmovq %r11, (\0");
                    this.e_reg(o, r, 8);
                    o.put_str(g")\n\0");
                    o.put_str(g"\tmov\0");
                }
                else
                {
                    this.lab++;
                    l1 = this.lab;
                    this.lab++;
                    l2 = this.lab;
                    if (fp) { o.put_str(g"\tmovl 4(\0"); } else { o.put_str(g"\tmovl (\0"); };
                    this.e_reg(o, r, 8);
                    o.put_str(g"), %r10d\n\0");
                    if (fp) { o.put_str(g"\tcmpl $160, %r10d\n\0"); } else { o.put_str(g"\tcmpl $40, %r10d\n\0"); };
                    o.put_str(f"\tja .LV{l1}\n\tmovq 16(\0");
                    this.e_reg(o, r, 8);
                    o.put_str(g"), %r11\n\taddq %r10, %r11\n\0");
                    if (fp) { o.put_str(g"\taddl $16, 4(\0"); } else { o.put_str(g"\taddl $8, (\0"); };
                    this.e_reg(o, r, 8);
                    o.put_str(f")\n\tjmp .LV{l2}\n.LV{l1}:\n\tmovq 8(\0");
                    this.e_reg(o, r, 8);
                    o.put_str(g"), %r11\n\tleaq 8(%r11), %r10\n\tmovq %r10, 8(\0");
                    this.e_reg(o, r, 8);
                    o.put_str(f")\n.LV{l2}:\n\tmov\0");
                };
                // the argument sits at (%r10) on Win64 and at (%r11) on System V
                if (fp)
                {
                    if (sz == 4) { o.put_str(g"ss \0"); } else { o.put_str(g"sd \0"); };
                }
                else
                {
                    if (sz == 1) { o.put_str(g"zbl \0"); };
                    if (sz == 2) { o.put_str(g"zwl \0"); };
                    if (sz == 4) { o.put_str(g"l \0"); };
                    if (sz == 8) { o.put_str(g"q \0"); };
                };
                if (this.a_win()) { o.put_str(g"(%r10), \0"); } else { o.put_str(g"(%r11), \0"); };
                if (fp) { this.e_op(o, m.o1, sz); }
                else
                {
                    if (sz < 4) { this.e_op(o, m.o1, 4); } else { this.e_op(o, m.o1, sz); };
                };
                o.put(10);
                ->;
            };

            // Memory operand text n bytes past m
            e_memo(Buf* o, MO* m, int n) -> void
            {
                i64 sv = m.imm;
                m.imm = sv + (i64)n;
                this.e_mem(o, m);
                m.imm = sv;
                ->;
            };

            // Copy of m.sz bytes through xmm15 and r10
            e_copy(Buf* o, MI* m) -> void
            {
                int n = m.sz;
                int off = 0;
                int c;
                while (off < n)
                {
                    c = 8;
                    if (n - off >= 16) { c = 16; }
                    else
                    {
                        if (n - off < 8) { c = 4; };
                        if (n - off < 4) { c = 2; };
                        if (n - off < 2) { c = 1; };
                        if (n - off >= 8) { c = 8; };
                    };
                    if (c == 16) { o.put_str(g"\tmovups \0"); }
                    else { o.put_str(g"\tmov\0"); this.e_sfx(o, c); o.put(32); };
                    this.e_memo(o, m.o1, off);
                    if (c == 16) { o.put_str(g", %xmm15\n\tmovups %xmm15, \0"); }
                    else
                    {
                        o.put_str(g", \0");
                        this.e_reg(o, 10, c);
                        o.put_str(g"\n\tmov\0");
                        this.e_sfx(o, c);
                        o.put(32);
                        this.e_reg(o, 10, c);
                        o.put_str(g", \0");
                    };
                    this.e_memo(o, m.o0, off);
                    o.put(10);
                    off = off + c;
                };
                ->;
            };

            // Three operand arithmetic written in two operand form
            // Bit reverse of the sz bytes of register o0 into o1. The baseline reverses the bytes and then swaps
            // the nibbles, bit pairs and bits of every byte. Galois field hardware does the bits of all bytes in one
            // instruction, the bytes still need reversing.
            e_brev(Buf* o, MI* m) -> void
            {
                int sz = m.sz;
                int pa = this.s_phys(m.o0.r);
                int pd = this.s_phys(m.o1.r);
                int rs = sz;
                int rd = 0;
                i64 mk;
                if (rs < 4) { rs = 4; };
                if ((this.feat `& XF_GFNI) != 0)
                {
                    o.put_str(g"\tmovq \0");
                    this.e_reg(o, pa, 8);
                    o.put_str(g", %xmm15\n\tmovabsq $0x8040201008040201, %r10\n\tmovq %r10, %xmm14\n\tgf2p8affineqb $0, %xmm14, %xmm15\n\tmovq %xmm15, \0");
                    this.e_reg(o, pd, 8);
                    o.put(10);
                }
                else
                {
                    if (pa != pd)
                    {
                        o.put_str(g"\tmov\0");
                        this.e_sfx(o, rs);
                        o.put(32);
                        this.e_reg(o, pa, rs);
                        o.put_str(g", \0");
                        this.e_reg(o, pd, rs);
                        o.put(10);
                    };
                    rd = 1;
                };
                if (sz == 2)
                {
                    o.put_str(g"\trolw $8, \0");
                    this.e_reg(o, pd, 2);
                    o.put(10);
                };
                if (sz == 4 | sz == 8)
                {
                    o.put_str(g"\tbswap\0");
                    if (sz == 4) { o.put(108); } else { o.put(113); };
                    o.put(32);
                    this.e_reg(o, pd, sz);
                    o.put(10);
                };
                if (rd == 0) { ->; };
                // swap the halves of every byte, then pairs, then bits
                this.e_brev_round(o, pd, rs, 4, (i64)0x0F0F0F0F0F0F0F0F);
                this.e_brev_round(o, pd, rs, 2, (i64)0x3333333333333333);
                this.e_brev_round(o, pd, rs, 1, (i64)0x5555555555555555);
                ->;
            };

            // d = ((d >> s) & mask) | ((d & mask) << s), through r10 and r11
            e_brev_round(Buf* o, int pd, int rs, int s, i64 mk) -> void
            {
                if (rs == 8)
                {
                    o.put_str(g"\tmovabsq $\0");
                    put_i64(o, mk);
                    o.put_str(g", %r11\n\0");
                }
                else
                {
                    o.put_str(g"\tmovl $\0");
                    put_i64(o, mk `& (i64)4294967295);
                    o.put_str(g", %r11d\n\0");
                };
                o.put_str(g"\tmov\0");
                this.e_sfx(o, rs);
                o.put(32);
                this.e_reg(o, pd, rs);
                o.put_str(g", \0");
                this.e_reg(o, 10, rs);
                o.put(10);
                o.put_str(g"\tshr\0");
                this.e_sfx(o, rs);
                o.put_str(g" $\0");
                put_i64(o, (i64)s);
                o.put_str(g", \0");
                this.e_reg(o, 10, rs);
                o.put(10);
                o.put_str(g"\tand\0");
                this.e_sfx(o, rs);
                o.put(32);
                this.e_reg(o, 11, rs);
                o.put_str(g", \0");
                this.e_reg(o, 10, rs);
                o.put(10);
                o.put_str(g"\tand\0");
                this.e_sfx(o, rs);
                o.put(32);
                this.e_reg(o, 11, rs);
                o.put_str(g", \0");
                this.e_reg(o, pd, rs);
                o.put(10);
                o.put_str(g"\tshl\0");
                this.e_sfx(o, rs);
                o.put_str(g" $\0");
                put_i64(o, (i64)s);
                o.put_str(g", \0");
                this.e_reg(o, pd, rs);
                o.put(10);
                o.put_str(g"\tor\0");
                this.e_sfx(o, rs);
                o.put(32);
                this.e_reg(o, 10, rs);
                o.put_str(g", \0");
                this.e_reg(o, pd, rs);
                o.put(10);
                ->;
            };

            e_alu(Buf* o, MI* m) -> void
            {
                int sz = m.sz;
                int k = m.cc;
                MO* a = m.o0;
                MO* b = m.o1;
                MO* d = m.o2;
                int pa = this.s_phys(a.r);
                int pd = this.s_phys(d.r);
                int pb = 0 - 1;
                bool comm = k == A_ADD | k == A_AND | k == A_OR | k == A_XOR | k == A_IMUL;
                byte* mn;
                if (m.tgt == 78 | m.tgt == 79)
                {
                    // andn: d = ~a & b, bzhi: d = a with the bits from the count in b up cleared
                    o.put(9);
                    if (m.tgt == 78) { o.put_str(g"andn \0"); } else { o.put_str(g"bzhi \0"); };
                    this.e_op(o, b, sz);
                    o.put_str(g", \0");
                    this.e_op(o, a, sz);
                    o.put_str(g", \0");
                    this.e_op(o, d, sz);
                    o.put(10);
                    ->;
                };
                if (b.k == MK_REG) { pb = this.s_phys(b.r); };
                if (k == A_ADD) { mn = g"add\0"; };
                if (k == A_SUB) { mn = g"sub\0"; };
                if (k == A_AND) { mn = g"and\0"; };
                if (k == A_OR) { mn = g"or\0"; };
                if (k == A_XOR) { mn = g"xor\0"; };
                if (k == A_IMUL) { mn = g"imul\0"; };
                if (k == A_IMUL & b.k == MK_IMM)
                {
                    o.put(9);
                    o.put_str(g"imul\0");
                    this.e_sfx(o, sz);
                    o.put(32);
                    this.e_op(o, b, sz);
                    o.put_str(g", \0");
                    this.e_op(o, a, sz);
                    o.put_str(g", \0");
                    this.e_op(o, d, sz);
                    o.put(10);
                    ->;
                };
                if (pa == pd)
                {
                    if ((k == A_ADD | k == A_SUB) & b.k == MK_IMM)
                    {
                        if (b.imm == (i64)1 | b.imm == (i64)0 - (i64)1)
                        {
                            o.put(9);
                            if ((k == A_ADD) == (b.imm == (i64)1)) { o.put_str(g"inc\0"); } else { o.put_str(g"dec\0"); };
                            this.e_sfx(o, sz);
                            o.put(32);
                            this.e_op(o, d, sz);
                            o.put(10);
                            ->;
                        };
                    };
                    this.e_two(o, mn, sz, b, d, sz, sz);
                    ->;
                };
                if (b.k == MK_REG & pb == pd)
                {
                    if (comm)
                    {
                        this.e_two(o, mn, sz, a, d, sz, sz);
                        ->;
                    };
                    // d = a - d
                    o.put(9);
                    o.put_str(g"neg\0");
                    this.e_sfx(o, sz);
                    o.put(32);
                    this.e_op(o, d, sz);
                    o.put(10);
                    this.e_two(o, g"add\0", sz, a, d, sz, sz);
                    ->;
                };
                if (k == A_ADD & b.k == MK_REG)
                {
                    o.put(9);
                    o.put_str(g"lea\0");
                    this.e_sfx(o, sz);
                    o.put_str(g" (\0");
                    this.e_reg(o, pa, 8);
                    o.put(44);
                    this.e_reg(o, pb, 8);
                    o.put_str(g"), \0");
                    this.e_op(o, d, sz);
                    o.put(10);
                    ->;
                };
                if ((k == A_ADD | k == A_SUB) & b.k == MK_IMM)
                {
                    o.put(9);
                    o.put_str(g"lea\0");
                    this.e_sfx(o, sz);
                    o.put(32);
                    if (k == A_ADD) { put_i64(o, b.imm); } else { put_i64(o, (i64)0 - b.imm); };
                    o.put(40);
                    this.e_reg(o, pa, 8);
                    o.put_str(g"), \0");
                    this.e_op(o, d, sz);
                    o.put(10);
                    ->;
                };
                this.e_two(o, g"mov\0", sz, a, d, sz, sz);
                this.e_two(o, mn, sz, b, d, sz, sz);
                ->;
            };


            // A jump back to a loop test that is only a compare and a conditional jump repeats the test in place:
            // the loop then needs one jump per iteration, not two. Returns true when the test was written.
            e_rotate(Buf* o, GB* gb, MI* m, int nid) -> bool
            {
                GF* g = this.sf;
                GB* h = (GB*)0;
                MI* c;
                MI* j;
                MI* k;
                int i = gb.rpo - 1;
                int lim = gb.rpo - 64;
                int tid, fid;
                if (lim < 0) { lim = 0; };
                while (i >= lim)
                {
                    if (g.rpo[i].id == (int)m.o0.imm) { h = g.rpo[i]; break; };
                    i--;
                };
                if (h == (GB*)0) { -> false; };
                if (h.mi.len != 3) { -> false; };
                c = (MI*)h.mi.items[0];
                j = (MI*)h.mi.items[1];
                k = (MI*)h.mi.items[2];
                if (c.op != M_CMP & c.op != M_TEST) { -> false; };
                if (j.op != M_JCC | k.op != M_JMP) { -> false; };
                // k.cc == 99 only records that the header's own emission folded this jump into its inverted branch
                tid = (int)j.o0.imm;
                fid = (int)k.o0.imm;
                // the instruction in front of the repeated test is the last one of this block
                this.rprev = (MI*)0;
                i = gb.mi.len - 1;
                while (i >= 0)
                {
                    if ((MI*)gb.mi.items[i] == m) { break; };
                    i--;
                };
                i--;
                while (i >= 0)
                {
                    k = (MI*)gb.mi.items[i];
                    if (this.s_noop_mi(k)) { i--; continue; };
                    this.rprev = k;
                    break;
                };
                this.e_mi(o, h, 0, gb);
                this.rprev = (MI*)0;
                if (tid == nid)
                {
                    o.put(9);
                    o.put(106);
                    this.e_cc(o, this.s_invcc(j.cc));
                    o.put_str(g" .LB\0");
                    o.put_int(fid);
                    o.put(10);
                    -> true;
                };
                o.put(9);
                o.put(106);
                this.e_cc(o, j.cc);
                o.put_str(g" .LB\0");
                o.put_int(tid);
                o.put(10);
                if (fid != nid)
                {
                    o.put_str(g"\tjmp .LB\0");
                    o.put_int(fid);
                    o.put(10);
                };
                -> true;
            };


            // Orders the blocks for emission after allocation. The block that follows another is the one it most
            // likely goes to: a block of the same or an inner loop before a loop exit, anything before a block that
            // ends in ud2. A block no chain reaches starts a new chain in its old position.
            s_blocksort() -> void
            {
                GF* g = this.sf;
                int n = g.nb;
                int i, j, k, best, bs, sc;
                GB* cur;
                GB* b;
                GB* s;
                MI* m;
                int* placed = this.s_iz(n + 1);
                int* cold = this.s_iz(n + 1);
                GB** outv = (GB**)fmalloc((u64)(8 * (n + 1)));
                int cnt = 0;
                // blocks that end in ud2
                i = 0;
                while (i < n)
                {
                    b = g.rpo[i];
                    j = 0;
                    while (j < b.mi.len)
                    {
                        m = (MI*)b.mi.items[j];
                        if (m.op == M_UD2) { cold[i] = 1; };
                        j++;
                    };
                    i++;
                };
                // the entry block stays first; chains grow from the last placed block
                cur = g.rpo[0];
                while (cur != (GB*)0)
                {
                    placed[cur.rpo] = 1;
                    outv[cnt] = cur;
                    cnt++;
                    best = 0 - 1;
                    bs = 0 - 1000000000;
                    k = 0;
                    while (k < cur.succs.len)
                    {
                        s = (GB*)cur.succs.items[k];
                        if (placed[s.rpo] == 0 & cold[s.rpo] == 0)
                        {
                            sc = s.lw;
                            if (best < 0 | sc > bs | (sc == bs & s.rpo < best))
                            {
                                best = s.rpo;
                                bs = sc;
                            };
                        };
                        k++;
                    };
                    if (best >= 0)
                    {
                        cur = g.rpo[best];
                    }
                    else
                    {
                        // a new chain starts at the first block left, in the old order, cold blocks last
                        cur = (GB*)0;
                        i = 0;
                        while (i < n)
                        {
                            if (placed[i] == 0 & cold[i] == 0) { cur = g.rpo[i]; break; };
                            i++;
                        };
                        if (cur == (GB*)0)
                        {
                            i = 0;
                            while (i < n)
                            {
                                if (placed[i] == 0) { cur = g.rpo[i]; break; };
                                i++;
                            };
                        };
                    };
                };
                i = 0;
                while (i < n)
                {
                    g.rpo[i] = outv[i];
                    i++;
                };
                i = 0;
                while (i < n)
                {
                    g.rpo[i].rpo = i;
                    i++;
                };
                ffree((byte*)outv);
                this.s_ifree(placed);
                this.s_ifree(cold);
                ->;
            };

            // Jumps with the fall through to the next block left out
            e_jump(Buf* o, GB* gb, int idx, GB* next) -> void
            {
                MI* m = (MI*)gb.mi.items[idx];
                MI* m2;
                int nid = 0 - 1;
                int cc;
                if (next != (GB*)0) { nid = next.id; };
                if (m.op == M_JMP)
                {
                    if (m.cc == 99) { ->; };
                    if ((int)m.o0.imm == nid) { ->; };
                    if (SSA_OPT_ROTATE == 1)
                    {
                        if (this.e_rotate(o, gb, m, nid)) { ->; };
                    };
                    o.put(9);
                    o.put_str(g"jmp .LB\0");
                    o.put_int((int)m.o0.imm);
                    o.put(10);
                    ->;
                };
                // a conditional jump followed by the jump for the other case
                cc = m.cc;
                if (idx + 1 < gb.mi.len)
                {
                    m2 = (MI*)gb.mi.items[idx + 1];
                    if (m2.op == M_JMP)
                    {
                        if ((int)m.o0.imm == nid)
                        {
                            // the taken case is next: jump on the opposite condition to the other target
                            o.put(9);
                            o.put(106);
                            this.e_cc(o, this.s_invcc(cc));
                            o.put_str(g" .LB\0");
                            o.put_int((int)m2.o0.imm);
                            o.put(10);
                            m2.cc = 99;
                            ->;
                        };
                    };
                };
                o.put(9);
                o.put(106);
                this.e_cc(o, cc);
                o.put_str(g" .LB\0");
                o.put_int((int)m.o0.imm);
                o.put(10);
                ->;
            };

            // Bounds check and indirect jump through the table of the switch, the table follows the function
            e_jtab(Buf* o, MI* m) -> void
            {
                int id;
                i64 lo = m.o1.imm;
                this.lab++;
                id = this.lab;
                bool whole = m.cc == 256 & m.sz == 1 & lo == (i64)0;
                if (!whole)
                {
                    o.put_str(g"\tmovq \0");
                    this.e_op(o, m.o0, 8);
                    o.put_str(g", %r11\n\0");
                };
                if (lo != (i64)0)
                {
                    if (lo > (i64)0 & lo <= (i64)2147483647)
                    {
                        o.put_str(g"\tsubq $\0");
                        put_i64(o, lo);
                        o.put_str(g", %r11\n\0");
                    }
                    else
                    {
                        o.put_str(g"\tmovabsq $\0");
                        put_i64(o, lo);
                        o.put_str(g", %r10\n\tsubq %r10, %r11\n\0");
                    };
                };
                // a table over every value of a byte cannot be left, so it needs no range check
                if (!whole)
                {
                    o.put_str(g"\tcmpq $\0");
                    o.put_int(m.cc - 1);
                    o.put_str(g", %r11\n\tja .LB\0");
                    o.put_int((int)m.o2.imm);
                    o.put(10);
                };
                o.put_str(g"\tleaq .LJT\0");
                o.put_int(id);
                if (whole)
                {
                    o.put_str(g"(%rip), %r10\n\tjmpq *(%r10,\0");
                    this.e_op(o, m.o0, 8);
                    o.put_str(g",8)\n\0");
                }
                else { o.put_str(g"(%rip), %r10\n\tjmpq *(%r10,%r11,8)\n\0"); };
                m.tgt = id;
                pv_push(this.jts, (void*)m);
                ->;
            };

            // Dispatch on byte level of a sparse switch: the byte of the value selects an entry of table nid
            e_rdisp(Buf* o, int reg, int shift, int nid) -> void
            {
                o.put_str(g"\tmovq \0");
                this.e_reg(o, reg, 8);
                o.put_str(g", %r11\n\0");
                if (shift > 0)
                {
                    o.put_str(g"\tshrq $\0");
                    o.put_int(shift);
                    o.put_str(g", %r11\n\0");
                };
                o.put_str(g"\tmovzbl %r11b, %r11d\n\tleaq .LJT\0");
                o.put_int(nid);
                o.put_str(g"(%rip), %r10\n\tjmpq *(%r10,%r11,8)\n\0");
                ->;
            };

            // Builds the table of one level for the cases listed in sel, returns its number. The table and the
            // code that reaches the next level are written to jb.
            e_rnode(MI* m, int reg, int* sel, int nsel, int level, int w) -> int
            {
                int* vals = (int*)m.text;
                int* ids = ((int*)m.text) + 2 * m.cc;
                int* ent = this.s_iz(256);
                int* sub = this.s_iz(nsel + 1);
                int nid, b, i, ns, shift, c;
                u64 v;
                Buf* jb = @this.jb;
                this.lab++;
                nid = this.lab;
                shift = 8 * (w - 1 - level);
                b = 0;
                while (b < 256)
                {
                    ns = 0;
                    i = 0;
                    while (i < nsel)
                    {
                        v = ((u64*)vals)[sel[i]];
                        if ((int)((v >> (u64)shift) `& (u64)255) == b) { sub[ns] = sel[i]; ns++; };
                        i++;
                    };
                    ent[b] = (int)m.o2.imm * 2;
                    if (ns > 0)
                    {
                        if (level == w - 1) { ent[b] = ids[sub[0]] * 2; }
                        else
                        {
                            c = this.e_rnode(m, reg, sub, ns, level + 1, w);
                            ent[b] = c * 2 + 1;
                        };
                    };
                    b++;
                };
                if (level > 0)
                {
                    jb.put_str(g".LT\0");
                    jb.put_int(nid);
                    jb.put_str(g":\n\0");
                    this.e_rdisp(jb, reg, shift, nid);
                };
                jb.put_str(g"\t.section .rodata\n\t.p2align 3\n.LJT\0");
                jb.put_int(nid);
                jb.put_str(g":\n\0");
                b = 0;
                while (b < 256)
                {
                    if ((ent[b] `& 1) != 0) { jb.put_str(g"\t.quad .LT\0"); } else { jb.put_str(g"\t.quad .LB\0"); };
                    jb.put_int(ent[b] >> 1);
                    jb.put(10);
                    b++;
                };
                jb.put_str(g"\t.text\n\0");
                this.s_ifree(ent);
                this.s_ifree(sub);
                -> nid;
            };

            // Sparse switch: levels of 256 entry tables, one byte of the value per level, most significant first
            e_radix(Buf* o, MI* m) -> void
            {
                int w = m.sz;
                int* sel = this.s_iz(m.cc + 1);
                int i, nid;
                int reg = this.s_phys(m.o0.r);
                if (w < 4) { w = 4; };
                i = 0;
                while (i < m.cc) { sel[i] = i; i++; };
                nid = this.e_rnode(m, reg, sel, m.cc, 0, w);
                this.e_rdisp(o, reg, 8 * (w - 1), nid);
                this.s_ifree(sel);
                ->;
            };

            // The tables of the function just written
            e_tables(Buf* o) -> void
            {
                int i, k;
                MI* m;
                if (this.jb.len > 0)
                {
                    o.put_n(this.jb.mem, this.jb.len);
                    this.jb.len = 0;
                };
                if (this.jts.len == 0) { ->; };
                o.put_str(g"\t.section .rodata\n\t.p2align 3\n\0");
                i = 0;
                while (i < this.jts.len)
                {
                    m = (MI*)this.jts.items[i];
                    o.put_str(g".LJT\0");
                    o.put_int(m.tgt);
                    o.put_str(g":\n\0");
                    k = 0;
                    while (k < m.cc)
                    {
                        o.put_str(g"\t.quad .LB\0");
                        o.put_int(((int*)m.text)[k]);
                        o.put(10);
                        k++;
                    };
                    i++;
                };
                o.put_str(g"\t.text\n\0");
                this.jts.len = 0;
                ->;
            };

            // Restores the callee saved registers and returns
            e_epilogue(Buf* o) -> void
            {
                this.e_epilogue2(o, false);
                ->;
            };

            // The restore of the frame; the final ret is left out for a tail jump
            e_epilogue2(Buf* o, bool tail) -> void
            {
                GF* g = this.sf;
                int k = 0;
                int n = 0;
                if (g.sw & !this.efr)
                {
                    // this path never set the frame up
                    if (!tail) { this.e_ln(o, g"ret\0"); };
                    ->;
                };
                while (k < 16)
                {
                    if ((g.saved `& (1 << k)) != 0)
                    {
                        n++;
                        o.put(9);
                        o.put_str(g"movq \0");
                        this.e_fpm(o, (i64)(0 - 8 * n));
                        o.put_str(g", \0");
                        this.e_reg(o, k, 8);
                        o.put(10);
                    };
                    k++;
                };
                if (g.nofp)
                {
                    if (g.frame > 0)
                    {
                        o.put_str(g"\taddq $\0");
                        o.put_int(g.frame);
                        o.put_str(g", %rsp\n\0");
                    };
                }
                else { this.e_ln(o, g"leave\0"); };
                if (!tail) { this.e_ln(o, g"ret\0"); };
                ->;
            };

            // ==========================================================
            // parallel copies and the writer of a whole function.
            // ==========================================================

            // Location of register number r after allocation: a hardware register, or 100 + slot when spilled
            s_loc(int r) -> int
            {
                GF* g = this.sf;
                if (r < R_VBASE) { -> r; };
                if (g.vcol[r] >= 0) { -> g.vcol[r]; };
                -> 100 + g.vslot[r] - 1;
            };

            // Writes the memory operand at offset off from the frame pointer, from rsp when the function has none
            e_fpm(Buf* o, i64 off) -> void
            {
                if (this.sf.nofp)
                {
                    put_i64(o, off + (i64)(this.sf.frame - 8));
                    o.put_str(g"(%rsp)\0");
                    ->;
                };
                put_i64(o, off);
                o.put_str(g"(%rbp)\0");
                ->;
            };

            s_has(byte* h, byte* n) -> bool
            {
                int i = 0;
                int j;
                while (h[i] != 0)
                {
                    j = 0;
                    while (n[j] != 0)
                    {
                        if (h[i + j] != n[j]) { break; };
                        j++;
                    };
                    if (n[j] == 0) { -> true; };
                    i++;
                };
                -> false;
            };

            // True when the text of an inline asm touches neither the stack pointer nor the frame pointer nor makes calls
            s_asm_nostack(byte* t) -> bool
            {
                if (t == (byte*)0) { -> false; };
                if (this.s_has(t, g"sp\0") | this.s_has(t, g"bp\0") | this.s_has(t, g"push\0") | this.s_has(t, g"pop\0")) { -> false; };
                if (this.s_has(t, g"call\0") | this.s_has(t, g"leave\0") | this.s_has(t, g"enter\0") | this.s_has(t, g"ret\0")) { -> false; };
                if (this.s_has(t, g"jmp\0") | this.s_has(t, g"syscall\0") | this.s_has(t, g"int\0")) { -> false; };
                -> true;
            };

            // True when no instruction of the function needs rbp as a frame: it makes no calls, has no dynamic
            // allocation, no inline asm, no variable argument handling and no x87 remainder (which uses rsp)
            s_nofp_ok() -> bool
            {
                GF* g = this.sf;
                int i, j, op;
                GB* gb;
                MI* m;
                if (g.dyn) { -> false; };
                if (g.vafo != 0 | g.vagp != 0 | g.vafp != 0 | g.vastk != 0) { -> false; };
                if (this.a_win() & g.frame >= 4096) { -> false; };
                i = 0;
                while (i < g.nb)
                {
                    gb = g.rpo[i];
                    j = 0;
                    while (j < gb.mi.len)
                    {
                        m = (MI*)gb.mi.items[j];
                        op = m.op;
                        if (op == M_CALL & m.tgt == 77) { j++; continue; };
                        if (op == M_CALL | op == M_DALLOC | op == M_VASTART | op == M_VAARG | op == M_SAVEVA | op == M_FREM | op == M_TEXT) { -> false; };
                        if (op == M_ASM) { if (!this.s_asm_nostack(m.text)) { -> false; }; };
                        j++;
                    };
                    i++;
                };
                -> true;
            };

            // Text of the stack slot of location l
            e_slot(Buf* o, int l) -> void
            {
                XFO* fo = (XFO*)this.sf.fobj.items[l - 100];
                this.e_fpm(o, (i64)fo.off);
                ->;
            };

            e_locop(Buf* o, int l) -> void
            {
                if (l >= 100) { this.e_slot(o, l); ->; };
                this.e_reg(o, l, 8);
                ->;
            };

            // Moves 8 bytes from location s to location d
            e_mvloc(Buf* o, int d, int s) -> void
            {
                if (d == s) { ->; };
                if (d >= 100 & s >= 100)
                {
                    o.put_str(g"\tmovq \0");
                    this.e_slot(o, s);
                    o.put_str(g", %r10\n\tmovq %r10, \0");
                    this.e_slot(o, d);
                    o.put(10);
                    ->;
                };
                if (d < 100 & s < 100 & d >= 16 & s >= 16)
                {
                    o.put_str(g"\tmovaps \0");
                    this.e_locop(o, s);
                    o.put_str(g", \0");
                    this.e_locop(o, d);
                    o.put(10);
                    ->;
                };
                if ((d >= 16 & d < 100) | (s >= 16 & s < 100))
                {
                    if (d >= 100 | s >= 100) { o.put_str(g"\tmovsd \0"); } else { o.put_str(g"\tmovq \0"); };
                    this.e_locop(o, s);
                    o.put_str(g", \0");
                    this.e_locop(o, d);
                    o.put(10);
                    ->;
                };
                o.put_str(g"\tmovq \0");
                this.e_locop(o, s);
                o.put_str(g", \0");
                this.e_locop(o, d);
                o.put(10);
                ->;
            };

            // Loads the constant v into location d
            e_ldconst(Buf* o, int d, IRValue* v) -> void
            {
                int k;
                i64 c;
                byte* sy;
                int tr = d;
                if (d >= 100) { tr = 10; };
                if (v.fo > 0 & v.vr == 0)
                {
                    // the address of a frame object
                    o.put_str(g"\tleaq \0");
                    this.e_fpm(o, (i64)((XFO*)this.sf.fobj.items[v.fo - 1]).off);
                    o.put_str(g", \0");
                    this.e_reg(o, tr, 8);
                    o.put(10);
                    if (d >= 100)
                    {
                        o.put_str(g"\tmovq %r10, \0");
                        this.e_slot(o, d);
                        o.put(10);
                    };
                    ->;
                };
                k = this.s_ck(v);
                c = this.scv;
                sy = this.scs;
                if (k == CK_FP)
                {
                    if (d >= 16 & d < 100 & c == (i64)0)
                    {
                        o.put_str(g"\txorps \0");
                        this.e_reg(o, d, 8);
                        o.put_str(g", \0");
                        this.e_reg(o, d, 8);
                        o.put(10);
                        ->;
                    };
                    o.put_str(g"\tmovabsq $\0");
                    put_i64(o, c);
                    o.put_str(g", %r10\n\0");
                    if (d >= 16 & d < 100)
                    {
                        o.put_str(g"\tmovq %r10, \0");
                        this.e_reg(o, d, 8);
                        o.put(10);
                    }
                    else
                    {
                        o.put_str(g"\tmovq %r10, \0");
                        this.e_slot(o, d);
                        o.put(10);
                    };
                    ->;
                };
                if (k == CK_SYM)
                {
                    o.put_str(g"\tleaq \0");
                    o.put_str(sy);
                    if (c > (i64)0) { o.put(43); put_i64(o, c); };
                    if (c < (i64)0) { put_i64(o, c); };
                    o.put_str(g"(%rip), \0");
                    this.e_reg(o, tr, 8);
                    o.put(10);
                }
                else
                {
                    if (k != CK_INT & k != CK_ZERO) { this.s_fail(g"phi constant\0"); ->; };
                    if (k == CK_ZERO) { c = (i64)0; };
                    if (c >= (i64)0 & c <= (i64)4294967295)
                    {
                        o.put_str(g"\tmovl $\0");
                        put_i64(o, c);
                        o.put_str(g", \0");
                        this.e_reg(o, tr, 4);
                        o.put(10);
                    }
                    else
                    {
                        if (c >= (i64)-2147483648 & c < (i64)0)
                        {
                            o.put_str(g"\tmovq $\0");
                            put_i64(o, c);
                            o.put_str(g", \0");
                            this.e_reg(o, tr, 8);
                            o.put(10);
                        }
                        else
                        {
                            o.put_str(g"\tmovabsq $\0");
                            put_i64(o, c);
                            o.put_str(g", \0");
                            this.e_reg(o, tr, 8);
                            o.put(10);
                        };
                    };
                };
                if (d >= 100)
                {
                    o.put_str(g"\tmovq %r10, \0");
                    this.e_slot(o, d);
                    o.put(10);
                };
                ->;
            };

            // Parallel copy of the phi values of the edge: the moves are ordered so that no source is overwritten
            // before it is read, a cycle is broken through r11
            // True when the instruction prints nothing: a move of a register onto itself, or a phi copy whose
            // values already sit where the phis are
            s_noop_mi(MI* m) -> bool
            {
                GB* sg;
                GP* gp;
                IRValue* v;
                int i;
                if (m.op == M_MOV)
                {
                    if (m.o0.k != MK_REG | m.o1.k != MK_REG) { -> false; };
                    -> this.s_phys(m.o0.r) == this.s_phys(m.o1.r);
                };
                if (m.op == M_PCOPY)
                {
                    sg = (GB*)this.sf.bl.items[m.tgt];
                    i = 0;
                    while (i < sg.phis.len)
                    {
                        gp = (GP*)sg.phis.items[i];
                        v = this.s_res((IRValue*)gp.vals.items[m.cc]);
                        if (v.vr < R_VBASE) { -> false; };
                        if (this.s_loc(gp.dst) != this.s_loc(v.vr)) { -> false; };
                        i++;
                    };
                    -> true;
                };
                -> false;
            };

            e_pcopy(Buf* o, MI* m) -> void
            {
                GB* sg = (GB*)this.sf.bl.items[m.tgt];
                int n = sg.phis.len;
                int* dl = this.s_iz(n + 1);
                int* sl = this.s_iz(n + 1);
                int* dn = this.s_iz(n + 1);
                PtrVec* cv = pv_new();
                GP* gp;
                IRValue* v;
                int i, j, left, prog, c;
                bool rd;
                i = 0;
                while (i < n)
                {
                    gp = (GP*)sg.phis.items[i];
                    v = this.s_res((IRValue*)gp.vals.items[m.cc]);
                    dl[i] = this.s_loc(gp.dst);
                    if (v.vr >= R_VBASE) { sl[i] = this.s_loc(v.vr); }
                    else { sl[i] = 0 - 1; };
                    pv_push(cv, (void*)v);
                    if (sl[i] == dl[i]) { dn[i] = 1; };
                    i++;
                };
                left = 0;
                i = 0;
                while (i < n)
                {
                    if (dn[i] == 0) { left++; };
                    i++;
                };
                while (left > 0)
                {
                    prog = 0;
                    i = 0;
                    while (i < n)
                    {
                        if (dn[i] == 0)
                        {
                            rd = false;
                            j = 0;
                            while (j < n)
                            {
                                if (j != i & dn[j] == 0 & sl[j] == dl[i]) { rd = true; };
                                j++;
                            };
                            if (!rd)
                            {
                                if (sl[i] >= 0) { this.e_mvloc(o, dl[i], sl[i]); }
                                else { this.e_ldconst(o, dl[i], (IRValue*)cv.items[i]); };
                                dn[i] = 1;
                                left--;
                                prog = 1;
                            };
                        };
                        i++;
                    };
                    if (prog == 0)
                    {
                        // only cycles are left: park one destination in r11 and redirect its readers
                        i = 0;
                        while (dn[i] != 0) { i++; };
                        c = dl[i];
                        this.e_mvloc(o, 11, c);
                        j = 0;
                        while (j < n)
                        {
                            if (dn[j] == 0 & sl[j] == c) { sl[j] = 11; };
                            j++;
                        };
                    };
                };
                pv_free(cv);
                this.s_ifree(dl);
                this.s_ifree(sl);
                this.s_ifree(dn);
                ->;
            };

            // ----------------------------------------------------------
            // Function writer
            // ----------------------------------------------------------

            // Directives and label that start the function f
            s_head(IRFunc* f, Buf* out) -> void
            {
                byte* nm = this.a_sym(f.self.text);
                bool islocal = false;
                bool weak = false;
                if (f.linkage != (byte*)0)
                {
                    if (this.a_seq(f.linkage, g"internal\0") | this.a_seq(f.linkage, g"private\0")) { islocal = true; };
                    if (this.a_pre(f.linkage, g"linkonce\0") | this.a_pre(f.linkage, g"weak\0")) { weak = true; };
                };
                out.put_str(g"\t.text\n\0");
                if (weak)
                {
                    out.put_str(g"\t.weak \0");
                    out.put_str(nm);
                    out.put(10);
                }
                else
                {
                    if (!islocal)
                    {
                        out.put_str(g"\t.globl \0");
                        out.put_str(nm);
                        out.put(10);
                    };
                };
                if (this.a_win())
                {
                    out.put_str(g"\t.def \0");
                    out.put_str(nm);
                    if (islocal) { out.put_str(g";\n\t.scl 3;\n\t.type 32;\n\t.endef\n\0"); }
                    else { out.put_str(g";\n\t.scl 2;\n\t.type 32;\n\t.endef\n\0"); };
                }
                else
                {
                    out.put_str(g"\t.type \0");
                    out.put_str(nm);
                    out.put_str(g",@function\n\0");
                };
                out.put_str(nm);
                out.put_str(g":\n\0");
                ->;
            };




            // True when the instruction is the address of a member of a struct that is a whole machine word at a byte
            // offset, so that the address can be used away from the access
            s_gep_plain(SI* x) -> bool
            {
                IRType* t;
                int f;
                if (x.n != 2) { -> false; };
                t = this.s_res(x.a).ty;
                if (t.kind != LK.PTR) { -> false; };
                t = t.elem;
                if (t.kind != LK.STRUCT & t.kind != LK.ISTRUCT) { -> false; };
                if (!this.s_cint(this.s_res(x.args[0]))) { -> false; };
                if (this.scv != (i64)0) { -> false; };
                if (!this.s_cint(this.s_res(x.args[1]))) { -> false; };
                f = (int)this.scv;
                if (f < 0 | f >= t.nitems) { -> false; };
                if (this.a_bitw(t.items[f])) { -> false; };
                if (t.lbits > 0 & t.loff != (int*)0)
                {
                    if (t.loff[f] % 8 != 0) { -> false; };
                };
                -> true;
            };

            // An earlier identical pure instruction in the predecessors that are the only way into this block
            s_pure_cse(GB* gb0, int j0, SI* x) -> SI*
            {
                GB* cur = gb0;
                GB* pg;
                int k = 0 - 1;
                int steps = 0;
                SI* y;
                if (x.op == SO_GEP & x.n >= 2)
                {
                    if (!this.s_gep_plain(x)) { -> (SI*)0; };
                };
                while (steps < 96)
                {
                    if (k < 0)
                    {
                        if (cur.preds.len != 1) { -> (SI*)0; };
                        pg = (GB*)cur.preds.items[0];
                        if (pg == cur | pg == gb0) { -> (SI*)0; };
                        if (pg.ib.insts == (PtrVec*)0) { -> (SI*)0; };
                        if (pg.ib.insts.len < 2) { -> (SI*)0; };
                        cur = pg;
                        k = pg.ib.insts.len - 2;
                        steps++;
                        continue;
                    };
                    y = (SI*)cur.ib.insts.items[k];
                    k--;
                    steps++;
                    if (y.op == x.op & y.res != (IRValue*)0)
                    {
                        this.s_fixops(y);
                        if (this.s_same_inst(x, y)) { -> y; };
                    };
                };
                -> (SI*)0;
            };

            // True when the zero ended texts a and b are equal
            s_texteq(byte* a, byte* b) -> bool
            {
                int i = 0;
                if (a == (byte*)0 | b == (byte*)0) { -> false; };
                while (a[i] == b[i])
                {
                    if (a[i] == (byte)0) { -> true; };
                    i++;
                };
                -> false;
            };

            // The object a pointer is derived from, through pointer arithmetic with any indices and pointer
            // casts. A pointer that comes from anywhere else is its own root.
            s_root(IRValue* p) -> IRValue*
            {
                IRValue* r = this.s_res(p);
                SI* d;
                int steps = 0;
                while (steps < 16)
                {
                    steps++;
                    if (r.di == (void*)0) { -> r; };
                    d = (SI*)r.di;
                    if (d.res == (IRValue*)0) { -> r; };
                    if (d.op == SO_GEP)
                    {
                        if (d.res.ty.kind != LK.PTR) { -> r; };
                        r = this.s_res(d.a);
                    }
                    elif (d.op == SO_CAST & d.k == SK_BITCAST)
                    {
                        if (d.a.ty.kind != LK.PTR | d.res.ty.kind != LK.PTR) { -> r; };
                        r = this.s_res(d.a);
                    }
                    else { -> r; };
                };
                -> r;
            };

            // Marks every stack object whose address is only ever used to read or write through (a.slot 1) and
            // every one that has escaped (a.slot 2): the pointer stored, passed to a call, merged by a phi, turned
            // into an integer or returned. One pass over the function.
            s_escscan() -> void
            {
                GF* g = this.sf;
                int i, j, k, n;
                GB* gb;
                SI* x;
                IRValue* o;
                IRValue* r;
                bool ok;
                i = 0;
                while (i < g.bl.len)
                {
                    gb = (GB*)g.bl.items[i];
                    i++;
                    if (gb.ib.insts == (PtrVec*)0) { continue; };
                    j = 0;
                    while (j < gb.ib.insts.len)
                    {
                        x = (SI*)gb.ib.insts.items[j];
                        j++;
                        if (x.op == SO_ALLOCA & x.res != (IRValue*)0) { this.s_res(x.res).slot = 1; };
                    };
                };
                i = 0;
                while (i < g.bl.len)
                {
                    gb = (GB*)g.bl.items[i];
                    i++;
                    if (gb.ib.insts == (PtrVec*)0) { continue; };
                    j = 0;
                    while (j < gb.ib.insts.len)
                    {
                        x = (SI*)gb.ib.insts.items[j];
                        j++;
                        if (x.op == 0) { continue; };
                        n = this.s_nops(x);
                        k = 0;
                        while (k < n)
                        {
                            o = this.s_op(x, k);
                            k++;
                            if (o == (IRValue*)0) { continue; };
                            if (o.ty.kind != LK.PTR) { continue; };
                            r = this.s_root(o);
                            if (r.di == (void*)0) { continue; };
                            if (((SI*)r.di).op != SO_ALLOCA) { continue; };
                            ok = false;
                            if (x.op == SO_LOAD | x.op == SO_CMP) { ok = true; };
                            if (x.op == SO_STORE & k - 1 == 1) { ok = true; };
                            if ((x.op == SO_COPY | x.op == SO_FILL) & k - 1 < 2) { ok = true; };
                            if (x.op == SO_GEP & k - 1 == 0) { ok = true; };
                            if (x.op == SO_CAST & x.k == SK_BITCAST) { ok = true; };
                            if (!ok) { r.slot = 2; };
                        };
                    };
                };
                this.escok = true;
                ->;
            };

            // True when nothing but loads and stores through the pointers derived from the stack object a can
            // reach it
            s_nonesc(IRValue* a) -> bool
            {
                if (a.di == (void*)0) { -> false; };
                if (((SI*)a.di).op != SO_ALLOCA) { -> false; };
                if (!this.escok) { this.s_escscan(); };
                -> a.slot == 1;
            };

            // True when no write through a pointer derived from root r1 can reach what a pointer derived from
            // root r2 addresses, and the other way round
            s_noalias(IRValue* r1, IRValue* r2) -> bool
            {
                bool a1, a2, g1, g2, n1, n2;
                if (r1 == r2) { -> false; };
                a1 = r1.di != (void*)0;
                if (a1) { a1 = ((SI*)r1.di).op == SO_ALLOCA; };
                a2 = r2.di != (void*)0;
                if (a2) { a2 = ((SI*)r2.di).op == SO_ALLOCA; };
                if (a1 & a2) { -> true; };
                g1 = (r1.flags `& VF_GLOBAL) != 0;
                g2 = (r2.flags `& VF_GLOBAL) != 0;
                if (g1 & g2) { -> !this.s_texteq(r1.text, r2.text); };
                if ((a1 & g2) | (g1 & a2)) { -> true; };
                // a stack object nothing else can name
                if (a1) { if (this.s_nonesc(r1)) { -> true; }; };
                if (a2) { if (this.s_nonesc(r2)) { -> true; }; };
                // a tied parameter owns what it points to
                n1 = (r1.flags `& VF_NOALIAS) != 0 & r1.di == (void*)0;
                n2 = (r2.flags `& VF_NOALIAS) != 0 & r2.di == (void*)0;
                if (n1 | n2) { -> true; };
                -> false;
            };

            // True when the instruction y may write the bytes of type t at address ad
            s_mclob(SI* y, IRValue* ad, IRType* t) -> bool
            {
                IRValue* sa;
                IRValue* b1;
                IRValue* b2;
                i64 o1, o2, s1, s2;
                if (y.op == 0) { -> false; };
                if (y.op == SO_LOAD) { -> y.vol; };
                if (y.op == SO_STORE)
                {
                    if (y.vol) { -> true; };
                    sa = this.s_res(y.b);
                    if (sa == ad) { -> true; };
                    b1 = this.s_addr(sa, @o1);
                    b2 = this.s_addr(ad, @o2);
                    if (b1 != b2)
                    {
                        if (SSA_OPT_ALIAS == 1) { if (this.s_noalias(this.s_root(sa), this.s_root(ad))) { -> false; }; };
                        -> true;
                    };
                    s1 = (i64)this.a_size(this.s_res(y.a).ty);
                    s2 = (i64)this.a_size(t);
                    if (o1 + s1 <= o2 | o2 + s2 <= o1) { -> false; };
                    -> true;
                };
                if (SSA_OPT_ALIAS == 1)
                {
                    if (y.op == SO_CALL) { -> !this.s_nonesc(this.s_root(ad)); };
                    if (y.op == SO_COPY | y.op == SO_FILL) { -> !this.s_noalias(this.s_root(y.a), this.s_root(ad)); };
                };
                if (y.op == SO_CALL | y.op == SO_COPY | y.op == SO_FILL | y.op == SO_VAARG) { -> true; };
                -> false;
            };

            // True when no path from the end of block dg to the start of block cur can write the bytes of type t at
            // address ad: every block that can reach cur without passing dg is searched
            s_region_ok(GB* dg, GB* cur, IRValue* ad, IRType* t) -> bool
            {
                GF* g = this.sf;
                GB* b;
                GB* pg;
                int top, i, j, cnt, ninst;
                if (this.rgn < g.nb + 1)
                {
                    if (this.rgm != (int*)0) { ffree((byte*)this.rgm); ffree((byte*)this.rgk); };
                    this.rgn = g.nb + 64;
                    this.rgm = this.s_iz(this.rgn);
                    this.rgk = this.s_iz(this.rgn);
                    this.rgs = 0;
                };
                this.rgs++;
                this.rgm[dg.rpo] = this.rgs;
                top = 0;
                cnt = 0;
                ninst = 0;
                i = 0;
                while (i < cur.preds.len)
                {
                    pg = (GB*)cur.preds.items[i];
                    i++;
                    if (this.rgm[pg.rpo] != this.rgs)
                    {
                        this.rgm[pg.rpo] = this.rgs;
                        this.rgk[top] = pg.rpo;
                        top++;
                    };
                };
                while (top > 0)
                {
                    top--;
                    b = g.rpo[this.rgk[top]];
                    cnt++;
                    if (cnt > 8) { -> false; };
                    if (b.ib.insts != (PtrVec*)0)
                    {
                        ninst = ninst + b.ib.insts.len;
                        if (ninst > 100) { -> false; };
                        j = 0;
                        while (j < b.ib.insts.len)
                        {
                            if (this.s_mclob((SI*)b.ib.insts.items[j], ad, t)) { -> false; };
                            j++;
                        };
                    };
                    i = 0;
                    while (i < b.preds.len)
                    {
                        pg = (GB*)b.preds.items[i];
                        i++;
                        if (this.rgm[pg.rpo] != this.rgs)
                        {
                            this.rgm[pg.rpo] = this.rgs;
                            this.rgk[top] = pg.rpo;
                            top++;
                        };
                    };
                };
                -> true;
            };

            // The earlier load that already read the address of the load x, or null. The search goes back through
            // the block and through predecessors that are the only way into their successor, and stops at any
            // store, call or fill.
            s_load_cse(GB* gb0, int j0, SI* x) -> SI*
            {
                GB* cur = gb0;
                GB* pg;
                int k = j0 - 1;
                int steps = 0;
                SI* y;
                IRValue* ad = this.s_res(x.a);
                IRType* t = x.res.ty;
                IRType* u;
                IRValue* sa;
                IRValue* sv;
                IRValue* b1;
                IRValue* b2;
                i64 o1, o2, s1, s2;
                bool same;
                while (steps < 96)
                {
                    if (k < 0)
                    {
                        if (cur.preds.len != 1)
                        {
                            if (SSA_OPT_DOMLD != 1 | cur.preds.len == 0) { -> (SI*)0; };
                            if (cur.idom < 0 | cur.idom == cur.rpo) { -> (SI*)0; };
                            pg = this.sf.rpo[cur.idom];
                            if (pg == gb0 | pg.ib.insts == (PtrVec*)0) { -> (SI*)0; };
                            if (pg.ib.insts.len < 2) { -> (SI*)0; };
                            if (!this.s_region_ok(pg, cur, ad, t)) { -> (SI*)0; };
                            cur = pg;
                            k = pg.ib.insts.len - 2;
                            steps++;
                            continue;
                        };
                        pg = (GB*)cur.preds.items[0];
                        if (pg == cur | pg == gb0) { -> (SI*)0; };
                        if (pg.ib.insts == (PtrVec*)0) { -> (SI*)0; };
                        if (pg.ib.insts.len < 2) { -> (SI*)0; };
                        cur = pg;
                        k = pg.ib.insts.len - 2;
                        steps++;
                        continue;
                    };
                    y = (SI*)cur.ib.insts.items[k];
                    k--;
                    steps++;
                    if (y.op == 0) { continue; };
                    if (y.op == SO_LOAD)
                    {
                        if (y.vol) { -> (SI*)0; };
                        if (this.s_res(y.a) == ad & y.res != (IRValue*)0)
                        {
                            u = y.res.ty;
                            if (u == t) { -> y; };
                            if (u.kind == t.kind)
                            {
                                if (t.kind == LK.INT & u.width == t.width) { -> y; };
                                if (t.kind == LK.PTR | t.kind == LK.FLOAT | t.kind == LK.DOUBLE) { -> y; };
                            };
                        };
                        continue;
                    };
                    if (y.op == SO_STORE)
                    {
                        // a store to the same address hands its value to the load, a store that cannot touch
                        // the bytes read is stepped over, anything else ends the search
                        if (y.vol) { -> (SI*)0; };
                        sa = this.s_res(y.b);
                        sv = this.s_res(y.a);
                        u = sv.ty;
                        same = u == t;
                        if (!same & u.kind == t.kind)
                        {
                            if (t.kind == LK.INT & u.width == t.width) { same = true; };
                            if (t.kind == LK.PTR | t.kind == LK.FLOAT | t.kind == LK.DOUBLE) { same = true; };
                        };
                        if (sa == ad)
                        {
                            if (same) { -> y; };
                            -> (SI*)0;
                        };
                        b1 = this.s_addr(sa, @o1);
                        b2 = this.s_addr(ad, @o2);
                        if (b1 != b2)
                        {
                            if (SSA_OPT_ALIAS == 1) { if (this.s_noalias(this.s_root(sa), this.s_root(ad))) { continue; }; };
                            -> (SI*)0;
                        };
                        s1 = (i64)this.a_size(u);
                        s2 = (i64)this.a_size(t);
                        if (o1 == o2 & s1 == s2)
                        {
                            if (same) { -> y; };
                            -> (SI*)0;
                        };
                        if (o1 + s1 <= o2 | o2 + s2 <= o1) { continue; };
                        -> (SI*)0;
                    };
                    if (SSA_OPT_ALIAS == 1)
                    {
                        // a call reaches only what has escaped; a block copy or fill only the bytes it names
                        if (y.op == SO_CALL)
                        {
                            if (this.s_nonesc(this.s_root(ad))) { continue; };
                            -> (SI*)0;
                        };
                        if (y.op == SO_COPY | y.op == SO_FILL)
                        {
                            if (this.s_noalias(this.s_root(y.a), this.s_root(ad))) { continue; };
                            -> (SI*)0;
                        };
                    };
                    if (y.op == SO_CALL | y.op == SO_COPY | y.op == SO_FILL | y.op == SO_VAARG) { -> (SI*)0; };
                };
                -> (SI*)0;
            };

            // The base of an address and its constant byte offset from it, through pointer arithmetic with
            // constant indices
            s_addr(IRValue* p, i64* off) -> IRValue*
            {
                IRValue* r = this.s_res(p);
                SI* d;
                IRValue* ix;
                int steps = 0;
                *off = (i64)0;
                while (steps < 8)
                {
                    steps++;
                    if (r.di == (void*)0) { -> r; };
                    d = (SI*)r.di;
                    if (d.op != SO_GEP | d.n != 1) { -> r; };
                    if (d.res == (IRValue*)0) { -> r; };
                    if (d.res.ty.kind != LK.PTR) { -> r; };
                    ix = this.s_res(d.args[0]);
                    if (!this.s_cint(ix)) { -> r; };
                    *off = *off + this.s_usx((u64)this.scv, ix.ty.width) * (i64)this.a_size(d.res.ty.elem);
                    r = this.s_res(d.a);
                };
                -> r;
            };


            // Records block id t in the open addressing set of referenced blocks
            s_jt_ref(int* rk, int cap, int t) -> void
            {
                int h = t % cap;
                while (rk[h] != 0)
                {
                    if (rk[h] == t + 1) { ->; };
                    h = (h + 1) % cap;
                };
                rk[h] = t + 1;
                ->;
            };

            // A block that only jumps to another block is skipped by every branch that reaches it
            s_jthread() -> void
            {
                GF* g = this.sf;
                int nb = g.nb;
                int cap = 16;
                int i, j, h, t, st, cnt, n;
                GB* gb;
                MI* m;
                int* hk;
                int* hv;
                int* rk;
                bool found, jt, keep;
                while (cap < 2 * nb + 2) { cap = cap * 2; };
                hk = this.s_iz(cap);
                hv = this.s_iz(cap);
                cnt = 0;
                i = 0;
                while (i < nb)
                {
                    gb = g.rpo[i];
                    i++;
                    if (gb.mi.len != 1) { continue; };
                    m = (MI*)gb.mi.items[0];
                    if (m.op != M_JMP) { continue; };
                    if (m.o0 == (MO*)0) { continue; };
                    if (m.o0.k != MK_BLK) { continue; };
                    if ((int)m.o0.imm == gb.id) { continue; };
                    h = gb.id % cap;
                    while (hk[h] != 0) { h = (h + 1) % cap; };
                    hk[h] = gb.id + 1;
                    hv[h] = (int)m.o0.imm;
                    cnt++;
                };
                if (cnt > 0)
                {
                    i = 0;
                    while (i < nb)
                    {
                        gb = g.rpo[i];
                        i++;
                        j = 0;
                        while (j < gb.mi.len)
                        {
                            m = (MI*)gb.mi.items[j];
                            j++;
                            if (m.op != M_JMP & m.op != M_JCC) { continue; };
                            if (m.o0 == (MO*)0) { continue; };
                            if (m.o0.k != MK_BLK) { continue; };
                            t = (int)m.o0.imm;
                            st = 0;
                            while (st < 8)
                            {
                                h = t % cap;
                                found = false;
                                while (hk[h] != 0)
                                {
                                    if (hk[h] == t + 1) { found = true; break; };
                                    h = (h + 1) % cap;
                                };
                                if (!found) { break; };
                                t = hv[h];
                                st++;
                            };
                            m.o0.imm = (i64)t;
                        };
                    };
                };
                if (cnt > 0)
                {
                    // forwarders that no branch reaches any more are dropped, unless a jump table may name them
                    jt = false;
                    rk = this.s_iz(cap);
                    i = 0;
                    while (i < nb)
                    {
                        gb = g.rpo[i];
                        i++;
                        j = 0;
                        while (j < gb.mi.len)
                        {
                            m = (MI*)gb.mi.items[j];
                            j++;
                            if (m.op == M_JTAB | m.op == M_JTAB2)
                            {
                                // the default and every table entry are references too
                                this.s_jt_ref(rk, cap, (int)m.o2.imm);
                                n = 0;
                                while (n < m.cc)
                                {
                                    if (m.op == M_JTAB) { this.s_jt_ref(rk, cap, ((int*)m.text)[n]); }
                                    else { this.s_jt_ref(rk, cap, ((int*)m.text)[2 * m.cc + n]); };
                                    n++;
                                };
                                continue;
                            };
                            if (m.op != M_JMP & m.op != M_JCC) { continue; };
                            if (m.o0 == (MO*)0) { continue; };
                            if (m.o0.k != MK_BLK) { continue; };
                            this.s_jt_ref(rk, cap, (int)m.o0.imm);
                        };
                    };
                    if (true)
                    {
                        j = 1;
                        i = 1;
                        while (i < nb)
                        {
                            gb = g.rpo[i];
                            i++;
                            keep = true;
                            if (gb.mi.len == 1)
                            {
                                m = (MI*)gb.mi.items[0];
                                if (m.op == M_JMP)
                                {
                                    h = gb.id % cap;
                                    found = false;
                                    while (rk[h] != 0)
                                    {
                                        if (rk[h] == gb.id + 1) { found = true; break; };
                                        h = (h + 1) % cap;
                                    };
                                    if (!found) { keep = false; };
                                };
                            };
                            if (keep) { g.rpo[j] = gb; j++; };
                        };
                        g.nb = j;
                    };
                    this.s_ifree(rk);
                };
                this.s_ifree(hk);
                this.s_ifree(hv);
                ->;
            };


            // Stores of constant bytes to neighbouring addresses of one object become stores of 4, 2 and 1 bytes
            s_stmerge() -> void
            {
                GF* g = this.sf;
                int i, j, n, run, k, w, c;
                GB* gb;
                MI* m;
                MI* q;
                MO* a;
                u64 v;
                i64 sv;
                PtrVec* nv;
                i = 0;
                while (i < g.nb)
                {
                    gb = g.rpo[i];
                    i++;
                    nv = pv_new();
                    j = 0;
                    while (j < gb.mi.len)
                    {
                        m = (MI*)gb.mi.items[j];
                        run = 1;
                        if (this.s_stm_ok(m))
                        {
                            while (j + run < gb.mi.len)
                            {
                                q = (MI*)gb.mi.items[j + run];
                                if (!this.s_stm_ok(q)) { break; };
                                if (q.o1.r != m.o1.r | q.o1.fo != m.o1.fo | q.o1.sc != m.o1.sc | q.o1.r2 != m.o1.r2) { break; };
                                if (q.o1.imm != m.o1.imm + (i64)run) { break; };
                                run++;
                            };
                        };
                        if (run < 2)
                        {
                            pv_push(nv, (void*)m);
                            j++;
                            continue;
                        };
                        k = 0;
                        while (k < run)
                        {
                            w = 1;
                            if (run - k >= 4) { w = 4; } elif (run - k >= 2) { w = 2; };
                            q = (MI*)gb.mi.items[j + k];
                            if (w > 1)
                            {
                                v = (u64)0;
                                c = 0;
                                while (c < w)
                                {
                                    v = v | (((u64)((MI*)gb.mi.items[j + k + c]).o0.imm & (u64)255) << (u64)(8 * c));
                                    c++;
                                };
                                sv = (i64)v;
                                if (w == 4) { sv = (i64)(i32)(u32)v; };
                                if (w == 2) { sv = (i64)(i16)(u16)v; };
                                q.sz = w;
                                q.o0 = this.s_mo_i(sv);
                            };
                            pv_push(nv, (void*)q);
                            k = k + w;
                        };
                        j = j + run;
                    };
                    pv_free(gb.mi);
                    gb.mi = nv;
                };
                ->;
            };

            s_stm_ok(MI* m) -> bool
            {
                if (m.op != M_MOV | m.sz != 1) { -> false; };
                if (m.o0 == (MO*)0 | m.o1 == (MO*)0) { -> false; };
                if (m.o0.k != MK_IMM | m.o1.k != MK_MEM) { -> false; };
                if (m.o1.sym != (byte*)0 | m.o1.r2 >= 0) { -> false; };
                -> true;
            };

            // ==========================================================
            // shrink wrapping: the frame is set up only in the blocks that need it. Calls, stack slots and the
            // frame pointer need the frame. A path that never reaches such a block returns without the saves.
            // ==========================================================

            // Position of the block with label id, or -1
            s_sw_find(int* hk, int* hv, int cap, int id) -> int
            {
                int h = id % cap;
                if (h < 0) { h = h + cap; };
                while (hk[h] != 0)
                {
                    if (hk[h] == id + 1) { -> hv[h]; };
                    h = (h + 1) % cap;
                };
                -> 0 - 1;
            };

            // The blocks that block i continues to are put in sb and counted, -1 when its jumps are not understood
            s_sw_succ(GB* gb, int i, int n, int* hk, int* hv, int cap, int* sb) -> int
            {
                int c = 0;
                int j, t;
                bool term = false;
                MI* m;
                j = 0;
                while (j < gb.mi.len)
                {
                    m = (MI*)gb.mi.items[j];
                    j++;
                    if (m.op == M_JMP | m.op == M_JCC)
                    {
                        if (m.o0 == (MO*)0) { -> 0 - 1; };
                        if (m.o0.k != MK_BLK) { -> 0 - 1; };
                        t = this.s_sw_find(hk, hv, cap, (int)m.o0.imm);
                        if (t < 0 | c >= 60) { -> 0 - 1; };
                        sb[c] = t;
                        c++;
                        if (m.op == M_JMP) { term = true; };
                    };
                    if (m.op == M_RET | m.op == M_UD2) { term = true; };
                };
                if (!term)
                {
                    if (i + 1 >= n) { -> 0 - 1; };
                    sb[c] = i + 1;
                    c++;
                };
                -> c;
            };

            // True when the operand names rsp or rbp or a frame object
            s_sw_opstk(MO* o) -> bool
            {
                int r;
                if (o == (MO*)0) { -> false; };
                if (o.k == MK_REG)
                {
                    r = this.s_phys(o.r);
                    -> r == 4 | r == 5;
                };
                if (o.k == MK_MEM)
                {
                    if (o.fo >= 0) { -> true; };
                    if (o.r >= 0) { r = this.s_phys(o.r); if (r == 4 | r == 5) { -> true; }; };
                    if (o.r2 >= 0) { r = this.s_phys(o.r2); if (r == 4 | r == 5) { -> true; }; };
                };
                -> false;
            };

            // True for the instructions whose lowering touches the stack in ways this pass does not follow
            s_sw_bad(int op) -> bool
            {
                if (op == M_DALLOC | op == M_VAARG | op == M_VASTART | op == M_SAVEVA | op == M_FREM | op == M_TEXT) { -> true; };
                if (op == M_JTAB | op == M_JTAB2 | op == M_SPILL | op == M_RELOAD) { -> true; };
                if (op == M_COPY | op == M_REPMOVS | op == M_REPSTOS | op == M_MEMMOVE | op == M_BREV) { -> true; };
                -> false;
            };

            // True when the parallel copy of a phi edge touches a spilled register or the address of a frame object
            // True when the parallel copy m puts a constant that fits sz bytes into the physical register r
            s_pc_zx(MI* m, int r, int sz) -> bool
            {
                GB* sg = (GB*)this.sf.bl.items[m.tgt];
                GP* gp;
                IRValue* v;
                int k = 0;
                while (k < sg.phis.len)
                {
                    gp = (GP*)sg.phis.items[k];
                    k++;
                    if (this.s_loc(gp.dst) == r)
                    {
                        v = this.s_res((IRValue*)gp.vals.items[m.cc]);
                        if (!this.s_cint(v)) { -> false; };
                        if (this.scv < (i64)0 | this.scv >= (i64)(1 << (8 * sz))) { -> false; };
                        -> true;
                    };
                };
                -> false;
            };

            s_sw_pcneeds(MI* m) -> bool
            {
                GB* sg = (GB*)this.sf.bl.items[m.tgt];
                GP* gp;
                IRValue* v;
                int k = 0;
                while (k < sg.phis.len)
                {
                    gp = (GP*)sg.phis.items[k];
                    k++;
                    if (this.s_loc(gp.dst) >= 100) { -> true; };
                    v = this.s_res((IRValue*)gp.vals.items[m.cc]);
                    if (v.vr >= R_VBASE) { if (this.s_loc(v.vr) >= 100) { -> true; }; }
                    elif (v.fo > 0) { -> true; };
                };
                -> false;
            };

            // The callee saved registers an inline asm text may name (a loose match, a name inside another word counts)
            s_sw_asmcs(byte* t) -> int
            {
                int r = 0;
                if (t == (byte*)0) { -> 0; };
                if (this.s_has(t, g"bx\0") | this.s_has(t, g"bl\0")) { r = r `| 8; };
                if (this.s_has(t, g"r12\0")) { r = r `| 4096; };
                if (this.s_has(t, g"r13\0")) { r = r `| 8192; };
                if (this.s_has(t, g"r14\0")) { r = r `| 16384; };
                if (this.s_has(t, g"r15\0")) { r = r `| 32768; };
                -> r;
            };

            s_sw_needs(MI* m) -> bool
            {
                if (m.op == M_CALL) { -> m.tgt != 77; };
                if (m.op == M_PCOPY) { -> this.s_sw_pcneeds(m); };
                if (this.s_sw_opstk(m.o0) | this.s_sw_opstk(m.o1) | this.s_sw_opstk(m.o2)) { -> true; };
                if (((m.iu `| m.id `| m.clob) `& 48) != 0) { -> true; };
                -> false;
            };

            // The general registers m reads (um) and writes (dm), as masks; kill is set when the write replaces the whole register
            s_sw_ud(MI* m, int* um, int* dm, bool* kill) -> void
            {
                int i, r;
                this.s_scan(m);
                um[0] = 0;
                dm[0] = 0;
                i = 0;
                while (i < this.nub)
                {
                    r = this.s_phys(this.ubuf[i]);
                    if (r >= 0 & r < 16) { um[0] = um[0] `| (1 << r); };
                    i++;
                };
                i = 0;
                while (i < this.ndb)
                {
                    r = this.s_phys(this.dbuf[i]);
                    if (r >= 0 & r < 16) { dm[0] = dm[0] `| (1 << r); };
                    i++;
                };
                // a tail call never returns, so it writes nothing the code after it could see
                if (m.op == M_CALL & m.tgt == 77) { dm[0] = 0; };
                kill[0] = m.sz == 4 | m.sz == 8 | m.op == M_CALL | m.op == M_LEA;
                ->;
            };

            // Rewrites the registers of the operand named in the map tm (register to register, -1 for none)
            s_sw_mo(MO* o, int* tm) -> MO*
            {
                MO* c;
                int r;
                if (o == (MO*)0) { -> o; };
                if (o.k == MK_REG)
                {
                    r = this.s_phys(o.r);
                    if (r >= 0 & r < 16)
                    {
                        if (tm[r] >= 0)
                        {
                            c = this.s_mo_copy(o);
                            c.r = tm[r];
                            -> c;
                        };
                    };
                    -> o;
                };
                if (o.k == MK_MEM)
                {
                    c = o;
                    if (o.r >= 0)
                    {
                        r = this.s_phys(o.r);
                        if (r >= 0 & r < 16)
                        {
                            if (tm[r] >= 0) { c = this.s_mo_copy(o); c.r = tm[r]; };
                        };
                    };
                    if (o.r2 >= 0)
                    {
                        r = this.s_phys(o.r2);
                        if (r >= 0 & r < 16)
                        {
                            if (tm[r] >= 0)
                            {
                                if (c == o) { c = this.s_mo_copy(o); };
                                c.r2 = tm[r];
                            };
                        };
                    };
                    -> c;
                };
                -> o;
            };

            s_shrink() -> void
            {
                GF* g = this.sf;
                int n = g.nb;
                int i, j, k, c, e, t, r, h, cap, ne, top, cnt, nh, a, b, nw, p, q, ref, imp, rmask, um, dm;
                bool ok, changed, kill, anyret;
                GB* gb;
                MI* m;
                MO* o;
                int* hk; int* hv; int* sb; int* sc; int* ss; int* sd; int* ps; int* pd;
                int* pon; int* pol; int* rp; int* idom; int* need; int* hdv; int* fr; int* stk; int* epos; int* seen;
                int* ub; int* db; int* lin; int* lout; int* tm; int* xneed; int* bimp; int* rid;
                bool clo;
                int tries;
                bool retry;
                g.sw = false;
                if (SSA_OPT_SHRINK != 1 | n < 3 | g.nofp | this.a_win() | g.dyn) { ->; };
                if (g.vafo != 0 | g.vagp != 0 | g.vafp != 0 | g.vastk != 0) { ->; };
                cap = 16;
                while (cap < 2 * n + 2) { cap = cap * 2; };
                hk = this.s_iz(cap); hv = this.s_iz(cap);
                sb = this.s_iz(64); sc = this.s_iz(n + 1); ss = this.s_iz(n + 2); ps = this.s_iz(n + 2);
                pon = this.s_iz(n); pol = this.s_iz(n); rp = this.s_iz(n); idom = this.s_iz(n); need = this.s_iz(n);
                hdv = this.s_iz(n); fr = this.s_iz(n); stk = this.s_iz(n + 1); epos = this.s_iz(n + 1); seen = this.s_iz(n);
                ub = this.s_iz(n); db = this.s_iz(n); lin = this.s_iz(n); lout = this.s_iz(n);
                tm = this.s_iz(16); xneed = this.s_iz(n); bimp = this.s_iz(n); rid = this.s_iz(n);
                ref = 0; imp = 0; um = 0; dm = 0;
                sd = (int*)0; pd = (int*)0;
                ok = true;
                tries = 0;
                while (tries < 8)
                {
                tries++;
                retry = false;
                i = 0;
                while (i < n)
                {
                    need[i] = 0; hdv[i] = 0; fr[i] = 0; ub[i] = 0; db[i] = 0; lin[i] = 0; lout[i] = 0; bimp[i] = 0; sc[i] = 0; ss[i] = 0; ps[i] = 0; seen[i] = 0; rid[i] = 0;
                    i++;
                };
                ref = 0; imp = 0;
                ss[n] = 0; ss[n + 1] = 0; ps[n] = 0; ps[n + 1] = 0;
                i = 0;
                while (i < cap) { hk[i] = 0; hv[i] = 0; i++; };
                if (sd != (int*)0) { this.s_ifree(sd); sd = (int*)0; };
                if (pd != (int*)0) { this.s_ifree(pd); pd = (int*)0; };
                while (true)
                {
                    // blocks by label, and the instructions that rule the pass out
                    i = 0;
                    while (i < n)
                    {
                        gb = g.rpo[i];
                        h = gb.id % cap;
                        while (hk[h] != 0) { h = (h + 1) % cap; };
                        hk[h] = gb.id + 1;
                        hv[h] = i;
                        j = 0;
                        while (j < gb.mi.len)
                        {
                            m = (MI*)gb.mi.items[j];
                            if (this.s_sw_bad(m.op)) { ok = false; };
                            if (m.op == M_ASM) { if (!this.s_asm_nostack(m.text)) { ok = false; }; };
                            if (this.s_sw_needs(m)) { need[i] = 1; };
                            j++;
                        };
                        if (xneed[i] == 1) { need[i] = 1; };
                        i++;
                    };
                    if (!ok) { break; };
                    if (need[0] == 1) { break; };
                    // edges
                    ne = 0;
                    i = 0;
                    while (i < n)
                    {
                        c = this.s_sw_succ(g.rpo[i], i, n, hk, hv, cap, sb);
                        if (c < 0) { ok = false; break; };
                        sc[i] = c;
                        ne = ne + c;
                        i++;
                    };
                    if (!ok) { break; };
                    sd = this.s_iz(ne + 1);
                    pd = this.s_iz(ne + 1);
                    i = 0;
                    while (i < n) { ss[i + 1] = ss[i] + sc[i]; i++; };
                    i = 0;
                    while (i < n)
                    {
                        c = this.s_sw_succ(g.rpo[i], i, n, hk, hv, cap, sb);
                        j = 0;
                        while (j < c) { sd[ss[i] + j] = sb[j]; ps[sb[j] + 1] = ps[sb[j] + 1] + 1; j++; };
                        i++;
                    };
                    i = 0;
                    while (i < n) { ps[i + 1] = ps[i + 1] + ps[i]; i++; };
                    // the fill position of each block's predecessor list is kept in seen
                    i = 0;
                    while (i < n) { seen[i] = ps[i]; i++; };
                    i = 0;
                    while (i < n)
                    {
                        j = ss[i];
                        while (j < ss[i + 1]) { pd[seen[sd[j]]] = i; seen[sd[j]] = seen[sd[j]] + 1; j++; };
                        i++;
                    };
                    // post order from the entry
                    i = 0;
                    while (i < n) { seen[i] = 0; i++; };
                    top = 0;
                    cnt = 0;
                    stk[0] = 0; epos[0] = ss[0]; seen[0] = 1; top = 1;
                    while (top > 0)
                    {
                        a = stk[top - 1];
                        if (epos[top - 1] < ss[a + 1])
                        {
                            b = sd[epos[top - 1]];
                            epos[top - 1] = epos[top - 1] + 1;
                            if (seen[b] == 0)
                            {
                                seen[b] = 1;
                                stk[top] = b;
                                epos[top] = ss[b];
                                top++;
                            };
                        }
                        else
                        {
                            pon[a] = cnt;
                            pol[cnt] = a;
                            cnt++;
                            top--;
                        };
                    };
                    if (cnt != n) { ok = false; break; };
                    i = 0;
                    while (i < n) { rp[i] = pol[n - 1 - i]; i++; };
                    // dominators
                    i = 0;
                    while (i < n) { idom[i] = 0 - 1; i++; };
                    idom[0] = 0;
                    changed = true;
                    while (changed)
                    {
                        changed = false;
                        k = 1;
                        while (k < n)
                        {
                            b = rp[k];
                            k++;
                            nw = 0 - 1;
                            j = ps[b];
                            while (j < ps[b + 1])
                            {
                                p = pd[j];
                                j++;
                                if (idom[p] < 0) { continue; };
                                if (nw < 0) { nw = p; continue; };
                                a = p;
                                q = nw;
                                while (a != q)
                                {
                                    while (pon[a] < pon[q]) { a = idom[a]; };
                                    while (pon[q] < pon[a]) { q = idom[q]; };
                                };
                                nw = a;
                            };
                            if (idom[b] != nw) { idom[b] = nw; changed = true; };
                        };
                    };
                    // blocks that need the frame: the first of each dominator subtree opens it
                    i = 0;
                    while (i < n)
                    {
                        if (need[i] == 1) { hdv[i] = 1; };
                        i++;
                    };
                    changed = true;
                    while (changed)
                    {
                        changed = false;
                        // frame state in dominator order
                        k = 0;
                        while (k < n)
                        {
                            b = rp[k];
                            k++;
                            if (b == 0) { fr[b] = 0; continue; };
                            if (fr[idom[b]] != 0) { fr[b] = 2; continue; };
                            fr[b] = 0;
                            if (hdv[b] == 1) { fr[b] = 1; };
                        };
                        // the region below a head is closed: a path that leaves it joins at the common dominator
                        k = 0;
                        while (k < n)
                        {
                            b = rp[k];
                            k++;
                            if (fr[b] == 1) { rid[b] = b; }
                            elif (fr[b] == 2) { rid[b] = rid[idom[b]]; }
                            else { rid[b] = 0 - 1; };
                        };
                        clo = false;
                        i = 0;
                        while (i < n & !clo)
                        {
                            if (fr[i] != 0)
                            {
                                e = ss[i];
                                while (e < ss[i + 1])
                                {
                                    b = sd[e];
                                    e++;
                                    if (rid[b] != rid[i])
                                    {
                                        a = rid[i];
                                        q = b;
                                        while (a != q)
                                        {
                                            while (pon[a] < pon[q]) { a = idom[a]; };
                                            while (pon[q] < pon[a]) { q = idom[q]; };
                                        };
                                        if (a == 0) { ok = false; };
                                        hdv[a] = 1;
                                        clo = true;
                                        changed = true;
                                        break;
                                    };
                                };
                            };
                            i++;
                        };
                        if (!ok) { break; };
                        if (clo) { continue; };
                        // a head on a cycle would save again with the registers changed: it moves up
                        i = 1;
                        while (i < n)
                        {
                            if (fr[i] == 1)
                            {
                                // is i reachable from itself
                                j = 0;
                                while (j < n) { seen[j] = 0; j++; };
                                top = 0;
                                cnt = 0;
                                e = ss[i];
                                while (e < ss[i + 1])
                                {
                                    b = sd[e];
                                    e++;
                                    if (seen[b] == 0) { seen[b] = 1; stk[top] = b; top++; };
                                };
                                while (top > 0)
                                {
                                    top--;
                                    a = stk[top];
                                    e = ss[a];
                                    while (e < ss[a + 1])
                                    {
                                        b = sd[e];
                                        e++;
                                        if (seen[b] == 0) { seen[b] = 1; stk[top] = b; top++; };
                                    };
                                };
                                if (seen[i] == 1)
                                {
                                    hdv[i] = 0;
                                    hdv[idom[i]] = 1;
                                    changed = true;
                                    if (idom[i] == 0) { ok = false; };
                                    break;
                                };
                            };
                            i++;
                        };
                        if (!ok) { break; };
                    };
                    if (!ok) { break; };
                    nh = 0;
                    anyret = false;
                    i = 0;
                    while (i < n)
                    {
                        if (fr[i] == 1) { nh++; };
                        if (fr[i] == 0)
                        {
                            gb = g.rpo[i];
                            j = 0;
                            while (j < gb.mi.len) { if (((MI*)gb.mi.items[j]).op == M_RET) { anyret = true; }; j++; };
                        };
                        i++;
                    };
                    if (nh == 0 | nh > 8 | !anyret) { ok = false; break; };
                    // no path may leave the framed blocks, and the frame is entered only at a head
                    i = 0;
                    while (i < n)
                    {
                        e = ss[i];
                        while (e < ss[i + 1])
                        {
                            b = sd[e];
                            e++;
                            if (fr[i] != 0 & fr[b] == 0) { ok = false; };
                            if (fr[i] == 0 & fr[b] == 2) { ok = false; };
                        };
                        i++;
                    };
                    if (!ok) { break; };
                    // registers read and written by the blocks outside the frame, and the liveness of all blocks
                    i = 0;
                    while (i < n)
                    {
                        gb = g.rpo[i];
                        j = 0;
                        while (j < gb.mi.len)
                        {
                            m = (MI*)gb.mi.items[j];
                            this.s_sw_ud(m, @um, @dm, @kill);
                            ub[i] = ub[i] `| (um `& (65535 `^| db[i]));
                            if (!kill) { ub[i] = ub[i] `| (dm `& (65535 `^| db[i])); };
                            if (kill) { db[i] = db[i] `| dm; };
                            if (fr[i] == 0)
                            {
                                ref = ref `| um `| dm;
                                if (m.op == M_CALL & m.tgt == 77)
                                {
                                    imp = imp `| m.iu;
                                    bimp[i] = bimp[i] `| m.iu;
                                }
                                else
                                {
                                    imp = imp `| (m.iu `| m.id `| m.clob);
                                    bimp[i] = bimp[i] `| (m.iu `| m.id `| m.clob);
                                };
                                if (m.op == M_PCOPY) { imp = imp `| um `| dm; bimp[i] = bimp[i] `| um `| dm; };
                                if (m.op == M_ASM) { imp = imp `| this.s_sw_asmcs(m.text); bimp[i] = bimp[i] `| this.s_sw_asmcs(m.text); };
                            };
                            j++;
                        };
                        i++;
                    };
                    changed = true;
                    while (changed)
                    {
                        changed = false;
                        k = 0;
                        while (k < n)
                        {
                            b = pol[k];
                            k++;
                            nw = 0;
                            e = ss[b];
                            while (e < ss[b + 1]) { nw = nw `| lin[sd[e]]; e++; };
                            lout[b] = nw;
                            nw = ub[b] `| (nw `& (65535 `^| db[b]));
                            if (nw != lin[b]) { lin[b] = nw; changed = true; };
                        };
                    };
                    // callee saved registers touched outside the frame move to free scratch registers there
                    rmask = ref `& g.saved `& 65535;
                    if (((imp `& rmask) `& 65535) != 0)
                    {
                        // the registers cannot be renamed in these blocks: they get the frame
                        i = 0;
                        while (i < n)
                        {
                            if (fr[i] == 0 & ((bimp[i] `& rmask) `& 65535) != 0) { xneed[i] = 1; retry = true; };
                            i++;
                        };
                        ok = false;
                        break;
                    };
                    i = 0;
                    while (i < 16) { tm[i] = 0 - 1; i++; };
                    r = 0;
                    while (r < 16)
                    {
                        if ((rmask `& (1 << r)) != 0)
                        {
                            t = 0 - 1;
                            k = 6;
                            if (SSA_OPT_SWCOPY == 1)
                            {
                                t = this.s_sw_srck(r, fr, n);
                                if (t >= 0) { k = 10; };
                            };
                            while (k < 10)
                            {
                                if ((ref `& (1 << k)) == 0)
                                {
                                    ok = true;
                                    i = 0;
                                    while (i < n) { if (fr[i] == 1 & (lin[i] `& (1 << k)) != 0) { ok = false; }; i++; };
                                    i = 0;
                                    while (i < 16) { if (tm[i] == k) { ok = false; }; i++; };
                                    if (ok) { t = k; break; };
                                };
                                k++;
                            };
                            ok = true;
                            if (t < 0) { ok = false; break; };
                            tm[r] = t;
                        };
                        r++;
                    };
                    if (!ok) { break; };
                    // apply
                    i = 0;
                    while (i < n)
                    {
                        gb = g.rpo[i];
                        if (fr[i] == 0 & rmask != 0)
                        {
                            j = 0;
                            while (j < gb.mi.len)
                            {
                                m = (MI*)gb.mi.items[j];
                                m.o0 = this.s_sw_mo(m.o0, tm);
                                m.o1 = this.s_sw_mo(m.o1, tm);
                                m.o2 = this.s_sw_mo(m.o2, tm);
                                j++;
                            };
                        };
                        if (fr[i] == 1)
                        {
                            r = 15;
                            while (r >= 0)
                            {
                                if (tm[r] >= 0 & (lin[i] `& (1 << r)) != 0)
                                {
                                    this.scb = gb;
                                    m = this.s_mi(M_MOV, 8);
                                    m.o0 = this.s_mo_r(tm[r], 8);
                                    m.o1 = this.s_mo_r(r, 8);
                                    gb.mi.len = gb.mi.len - 1;
                                    this.s_vins(gb.mi, 0, (void*)m);
                                };
                                r--;
                            };
                        };
                        gb.hd = fr[i];
                        i++;
                    };
                    g.sw = true;
                    break;
                };
                if (!retry) { break; };
                ok = true;
                };
                if (sd != (int*)0) { this.s_ifree(sd); };
                if (pd != (int*)0) { this.s_ifree(pd); };
                this.s_ifree(hk); this.s_ifree(hv); this.s_ifree(sb); this.s_ifree(sc); this.s_ifree(ss); this.s_ifree(ps);
                this.s_ifree(pon); this.s_ifree(pol); this.s_ifree(rp); this.s_ifree(idom); this.s_ifree(need);
                this.s_ifree(hdv); this.s_ifree(fr); this.s_ifree(stk); this.s_ifree(epos); this.s_ifree(seen);
                this.s_ifree(ub); this.s_ifree(db); this.s_ifree(lin); this.s_ifree(lout);
                this.s_ifree(tm); this.s_ifree(xneed); this.s_ifree(rid); this.s_ifree(bimp);
                ->;
            };

            // The register r outside the frame only ever receives a plain copy of one register k that is not
            // written outside the frame: r can be renamed to k, and the copy disappears. Returns k, or -1.
            s_sw_srck(int r, int* fr, int n) -> int
            {
                GF* g = this.sf;
                int i, j, k, src, um, dm;
                bool kill;
                GB* gb;
                MI* m;
                k = 0 - 1;
                um = 0; dm = 0; kill = false;
                i = 0;
                while (i < n)
                {
                    if (fr[i] == 0)
                    {
                        gb = g.rpo[i];
                        j = 0;
                        while (j < gb.mi.len)
                        {
                            m = (MI*)gb.mi.items[j];
                            this.s_sw_ud(m, @um, @dm, @kill);
                            if ((dm `& (1 << r)) != 0)
                            {
                                if (m.op != M_MOV | m.sz != 8) { -> 0 - 1; };
                                if (m.o0.k != MK_REG | m.o1.k != MK_REG) { -> 0 - 1; };
                                if (this.s_phys(m.o1.r) != r) { -> 0 - 1; };
                                src = this.s_phys(m.o0.r);
                                if (src < 0 | src >= 16) { -> 0 - 1; };
                                if (src == r) { j++; continue; };
                                if (k >= 0 & k != src) { -> 0 - 1; };
                                k = src;
                            };
                            j++;
                        };
                    };
                    i++;
                };
                if (k < 0 | k == 4 | k == 5 | k == 10 | k == 11) { -> 0 - 1; };
                if ((g.saved `& (1 << k)) != 0) { -> 0 - 1; };
                i = 0;
                while (i < n)
                {
                    if (fr[i] == 0)
                    {
                        gb = g.rpo[i];
                        j = 0;
                        while (j < gb.mi.len)
                        {
                            m = (MI*)gb.mi.items[j];
                            this.s_sw_ud(m, @um, @dm, @kill);
                            if ((dm `& (1 << k)) != 0) { -> 0 - 1; };
                            if (m.op == M_CALL | m.op == M_ASM) { -> 0 - 1; };
                            j++;
                        };
                    };
                    i++;
                };
                -> k;
            };

            // Sets up the frame and saves the callee saved registers
            e_prologue(Buf* o) -> void
            {
                GF* g = this.sf;
                int n, k;
                if (!g.nofp) { o.put_str(g"\tpushq %rbp\n\tmovq %rsp, %rbp\n\0"); };
                if (this.a_win() & g.frame >= 4096)
                {
                    o.put_str(g"\tmovl $\0");
                    o.put_int(g.frame);
                    o.put_str(g", %eax\n\tcallq __chkstk\n\tsubq %rax, %rsp\n\0");
                }
                else
                {
                    if (g.frame > 0)
                    {
                        o.put_str(g"\tsubq $\0");
                        o.put_int(g.frame);
                        o.put_str(g", %rsp\n\0");
                    };
                };
                n = 0;
                k = 0;
                while (k < 16)
                {
                    if ((g.saved `& (1 << k)) != 0)
                    {
                        n++;
                        o.put_str(g"\tmovq \0");
                        this.e_reg(o, k, 8);
                        o.put_str(g", \0");
                        this.e_fpm(o, (i64)(0 - 8 * n));
                        o.put(10);
                    };
                    k++;
                };
                ->;
            };

            s_emit(IRFunc* f, Buf* out) -> void
            {
                GF* g = this.sf;
                byte* nm = this.a_sym(f.self.text);
                bool islocal = false;
                bool weak = false;
                int i, j, k, n;
                GB* gb;
                GB* nx;
                if (f.linkage != (byte*)0)
                {
                    if (this.a_seq(f.linkage, g"internal\0") | this.a_seq(f.linkage, g"private\0")) { islocal = true; };
                    if (this.a_pre(f.linkage, g"linkonce\0") | this.a_pre(f.linkage, g"weak\0")) { weak = true; };
                };
                this.s_rnames();
                this.jts.len = 0;
                this.jb.len = 0;
                this.s_layout();
                if (SSA_OPT_LAYOUT == 1) { this.s_blocksort(); };
                if (SSA_OPT_JTHREAD == 1) { this.s_jthread(); };
                this.s_head(f, out);
                g.nofp = false;
                if (SSA_OPT_NOFP == 1) { g.nofp = this.s_nofp_ok(); };
                this.s_shrink();
                this.efr = true;
                if (!g.sw) { this.e_prologue(out); };
                i = 0;
                while (i < g.nb)
                {
                    gb = g.rpo[i];
                    nx = (GB*)0;
                    if (i + 1 < g.nb) { nx = g.rpo[i + 1]; };
                    out.put_str(g".LB\0");
                    out.put_int(gb.id);
                    out.put_str(g":\n\0");
                    if (g.sw)
                    {
                        this.efr = gb.hd != 0;
                        if (gb.hd == 1) { this.e_prologue(out); };
                    };
                    j = 0;
                    while (j < gb.mi.len)
                    {
                        this.e_mi(out, gb, j, nx);
                        j++;
                    };
                    i++;
                };
                if (!this.a_win())
                {
                    out.put_str(g"\t.size \0");
                    out.put_str(nm);
                    out.put_str(g", .-\0");
                    out.put_str(nm);
                    out.put(10);
                };
                this.e_tables(out);
                ->;
            };

            // ==========================================================
            // floating point: selection of the scalar float operations on xmm registers and their
            // lowering to assembly.
            // ==========================================================

            // ----------------------------------------------------------
            // Selection
            // ----------------------------------------------------------

            s_isfp(IRType* t) -> bool
            {
                -> t.kind == LK.FLOAT | t.kind == LK.DOUBLE;
            };

            // Zero and nonzero constants are made in an xmm register straight from their bits
            s_fconst(IRValue* v) -> MO*
            {
                int d = this.s_nv(1);
                int sz = this.s_vsz(v.ty);
                MI* m = this.s_mi2(M_GX, sz, this.s_mo_i(this.scv), this.s_mo_r(d, sz));
                -> this.s_mo_r(d, sz);
            };

            // Operand register of the float value v
            s_freg(IRValue* v) -> int
            {
                MO* o = this.s_src(v);
                if (o.k != MK_REG) { this.s_fail(g"float operand\0"); -> 0; };
                -> o.r;
            };

            // Condition code of a float compare that one flag test decides. The result is 0 - 1 when two flag tests
            // are needed, 0 - 2 for the constant predicates. sfs is set when the operands are swapped.
            s_fcc(int p) -> int
            {
                this.sfs = 0;
                if (p == SP_OGT) { -> C_A; };
                if (p == SP_OGE) { -> C_AE; };
                if (p == SP_OLT) { this.sfs = 1; -> C_A; };
                if (p == SP_OLE) { this.sfs = 1; -> C_AE; };
                if (p == SP_ULT_F) { -> C_B; };
                if (p == SP_ULE_F) { -> C_BE; };
                if (p == SP_UGT_F) { this.sfs = 1; -> C_B; };
                if (p == SP_UGE_F) { this.sfs = 1; -> C_BE; };
                if (p == SP_ORD) { -> C_NP; };
                if (p == SP_UNO) { -> C_P; };
                if (p == SP_FALSE | p == SP_TRUE) { -> 0 - 2; };
                -> 0 - 1;
            };

            // True when the float compare x is decided by one condition code
            s_fsingle(SI* x) -> bool
            {
                int c = this.s_fcc(x.k);
                -> c >= 0;
            };

            // Emits the compare of a float compare decided by one flag test, returns its condition code
            s_fcmpflags(SI* x) -> int
            {
                IRValue* a = this.s_res(x.a);
                IRValue* b = this.s_res(x.b);
                int cc = this.s_fcc(x.k);
                int sw = this.sfs;
                int ra, rb, sz;
                sz = this.s_vsz(a.ty);
                ra = this.s_freg(a);
                rb = this.s_freg(b);
                if (sw == 1) { this.s_mi2(M_FCMP, sz, this.s_mo_r(rb, sz), this.s_mo_r(ra, sz)); }
                else { this.s_mi2(M_FCMP, sz, this.s_mo_r(ra, sz), this.s_mo_r(rb, sz)); };
                -> cc;
            };

            // Register with the 0 or 1 result of the float compare x
            s_fcmpval(SI* x) -> int
            {
                IRValue* a;
                IRValue* b;
                int p = x.k;
                int cc, d, t, ra, rb, sz;
                MI* m;
                d = this.s_nv(0);
                cc = this.s_fcc(p);
                if (cc == 0 - 2)
                {
                    if (p == SP_TRUE) { this.s_mov(this.s_mo_i((i64)1), d, 4); } else { this.s_mov(this.s_mo_i((i64)0), d, 4); };
                    -> d;
                };
                if (cc >= 0)
                {
                    cc = this.s_fcmpflags(x);
                    m = this.s_mi1(M_SETCC, 1, this.s_mo_r(d, 1));
                    m.cc = cc;
                    this.s_mi2(M_MOVZX, 1, this.s_mo_r(d, 1), this.s_mo_r(d, 4));
                    -> d;
                };
                a = this.s_res(x.a);
                b = this.s_res(x.b);
                sz = this.s_vsz(a.ty);
                ra = this.s_freg(a);
                rb = this.s_freg(b);
                this.s_mi2(M_FCMP, sz, this.s_mo_r(ra, sz), this.s_mo_r(rb, sz));
                t = this.s_nv(0);
                m = this.s_mi1(M_SETCC, 1, this.s_mo_r(d, 1));
                if (p == SP_OEQ | p == SP_UEQ) { m.cc = C_E; } else { m.cc = C_NE; };
                this.s_mi2(M_MOVZX, 1, this.s_mo_r(d, 1), this.s_mo_r(d, 4));
                m = this.s_mi1(M_SETCC, 1, this.s_mo_r(t, 1));
                if (p == SP_OEQ | p == SP_ONE) { m.cc = C_NP; } else { m.cc = C_P; };
                this.s_mi2(M_MOVZX, 1, this.s_mo_r(t, 1), this.s_mo_r(t, 4));
                if (p == SP_OEQ | p == SP_ONE) { this.s_mi3c(M_ALU, 4, this.s_mo_r(d, 4), this.s_mo_r(t, 4), this.s_mo_r(d, 4), A_AND); }
                else { this.s_mi3c(M_ALU, 4, this.s_mo_r(d, 4), this.s_mo_r(t, 4), this.s_mo_r(d, 4), A_OR); };
                -> d;
            };

            s_fp_bin(SI* x) -> void
            {
                IRValue* a = this.s_res(x.a);
                IRValue* b = this.s_res(x.b);
                int sz = this.s_vsz(x.ty);
                int ra = this.s_freg(a);
                int rb = this.s_freg(b);
                int d = this.s_def(x.res, 1);
                MI* m;
                if (x.k == SB_FREM)
                {
                    m = this.s_mi3(M_FREM, sz, this.s_mo_r(ra, sz), this.s_mo_r(rb, sz), this.s_mo_r(d, sz));
                    m.clob = 1;
                    ->;
                };
                m = this.s_mi3(M_FALU, sz, this.s_mo_r(ra, sz), this.s_mo_r(rb, sz), this.s_mo_r(d, sz));
                m.cc = x.k;
                ->;
            };

            s_fp_cast(SI* x) -> void
            {
                IRValue* a = this.s_res(x.a);
                IRType* ft = a.ty;
                IRType* tt = x.ty;
                int k = x.k;
                int r, d, fsz, tsz, fw, tw;
                MI* m;
                fw = 64;
                tw = 64;
                if (ft.kind == LK.INT) { fw = ft.width; };
                if (tt.kind == LK.INT) { tw = tt.width; };
                if (fw > 64 | tw > 64) { this.s_fail(g"wide float cast\0"); ->; };
                fsz = this.s_vsz(ft);
                tsz = this.s_vsz(tt);
                if (k == SK_BITCAST)
                {
                    if (this.s_isfp(ft) == this.s_isfp(tt))
                    {
                        if (fsz != tsz) { this.s_fail(g"bitcast size\0"); ->; };
                        r = this.s_reg(a);
                        d = this.s_def(x.res, this.s_cls(tt));
                        if (this.s_isfp(tt)) { this.s_mi2(M_XMOV, tsz, this.s_mo_r(r, tsz), this.s_mo_r(d, tsz)); }
                        else { this.s_mov(this.s_mo_r(r, tsz), d, tsz); };
                        ->;
                    };
                    if (this.s_isfp(ft))
                    {
                        // float bits into an integer register
                        if (tsz != fsz) { this.s_fail(g"bitcast size\0"); ->; };
                        r = this.s_freg(a);
                        d = this.s_def(x.res, 0);
                        this.s_mi2(M_GX, fsz, this.s_mo_r(r, fsz), this.s_mo_r(d, fsz));
                        ->;
                    };
                    if (tsz != fsz) { this.s_fail(g"bitcast size\0"); ->; };
                    r = this.s_reg(a);
                    d = this.s_def(x.res, 1);
                    this.s_mi2(M_GX, tsz, this.s_mo_r(r, tsz), this.s_mo_r(d, tsz));
                    ->;
                };
                if (k == SK_FPEXT | k == SK_FPTRUNC)
                {
                    r = this.s_freg(a);
                    d = this.s_def(x.res, 1);
                    m = this.s_mi2(M_CVT, tsz, this.s_mo_r(r, fsz), this.s_mo_r(d, tsz));
                    if (k == SK_FPEXT) { m.cc = 1; } else { m.cc = 2; };
                    ->;
                };
                if (k == SK_SITOFP | k == SK_UITOFP)
                {
                    if (k == SK_SITOFP & fw == 1) { this.s_fail(g"i1 sitofp\0"); ->; };
                    r = this.s_reg(a);
                    if (k == SK_SITOFP)
                    {
                        if (fsz < 8) { r = this.s_ext(r, fsz, true, 8); };
                    }
                    else
                    {
                        if (fsz < 4) { r = this.s_ext(r, fsz, false, 4); };
                    };
                    d = this.s_def(x.res, 1);
                    m = this.s_mi2(M_CVT, tsz, this.s_mo_r(r, 8), this.s_mo_r(d, tsz));
                    m.cc = 3;
                    if (k == SK_UITOFP & fw == 64) { m.cc = 4; };
                    ->;
                };
                if (k == SK_FPTOSI | k == SK_FPTOUI)
                {
                    r = this.s_freg(a);
                    d = this.s_def(x.res, 0);
                    m = this.s_mi2(M_CVT, fsz, this.s_mo_r(r, fsz), this.s_mo_r(d, 8));
                    m.cc = 5;
                    if (k == SK_FPTOUI & tw == 64) { m.cc = 6; };
                    if (tw < 64)
                    {
                        m = this.s_mi2(M_MOV, 4, this.s_mo_r(d, 4), this.s_mo_r(d, 4));
                        m.cc = 1;
                        if (tw == 1) { this.s_mi3c(M_ALU, 4, this.s_mo_r(d, 4), this.s_mo_i((i64)1), this.s_mo_r(d, 4), A_AND); };
                    };
                    ->;
                };
                this.s_fail(g"float cast\0");
                ->;
            };

            s_fp_load(SI* x) -> void
            {
                int sz = this.s_vsz(x.ty);
                MO* m = this.s_addr(x.a);
                int d = this.s_def(x.res, 1);
                this.s_mi2(M_XMOV, sz, m, this.s_mo_r(d, sz));
                ->;
            };

            s_fp_store(SI* x) -> void
            {
                int sz = this.s_vsz(x.ty);
                int r = this.s_freg(x.a);
                MO* m = this.s_addr(x.b);
                this.s_mi2(M_XMOV, sz, this.s_mo_r(r, sz), m);
                ->;
            };

            s_fp_select(SI* x) -> void
            {
                IRValue* c = this.s_res(x.a);
                int sz = this.s_vsz(x.ty);
                int ra, rb, d, cc;
                MI* m;
                if (this.s_isint(c))
                {
                    if (this.scv != (i64)0) { ra = this.s_freg(x.b); } else { ra = this.s_freg(x.c); };
                    d = this.s_def(x.res, 1);
                    this.s_mi2(M_XMOV, sz, this.s_mo_r(ra, sz), this.s_mo_r(d, sz));
                    ->;
                };
                ra = this.s_freg(x.b);
                rb = this.s_freg(x.c);
                cc = this.s_cond(c);
                d = this.s_def(x.res, 1);
                m = this.s_mi3(M_FSEL, sz, this.s_mo_r(ra, sz), this.s_mo_r(rb, sz), this.s_mo_r(d, sz));
                m.cc = cc;
                ->;
            };

            // ----------------------------------------------------------
            // Lowering
            // ----------------------------------------------------------

            // Single or double suffix of an SSE mnemonic
            e_fs(Buf* o, int sz) -> void
            {
                if (sz == 4) { o.put_str(g"ss \0"); } else { o.put_str(g"sd \0"); };
                ->;
            };

            e_ps(Buf* o, MO* a, MO* d) -> void
            {
                int pa = this.s_phys(a.r);
                int pd = this.s_phys(d.r);
                if (pa == pd) { ->; };
                o.put_str(g"\tmovaps \0");
                this.e_reg(o, pa, 8);
                o.put_str(g", \0");
                this.e_reg(o, pd, 8);
                o.put(10);
                ->;
            };

            e_falu(Buf* o, MI* m) -> void
            {
                int sz = m.sz;
                int k = m.cc;
                MO* a = m.o0;
                MO* b = m.o1;
                MO* d = m.o2;
                int pa = this.s_phys(a.r);
                int pb = this.s_phys(b.r);
                int pd = this.s_phys(d.r);
                byte* mn;
                if (k == SB_FADD) { mn = g"add\0"; };
                if (k == SB_FSUB) { mn = g"sub\0"; };
                if (k == SB_FMUL) { mn = g"mul\0"; };
                if (k == SB_FDIV) { mn = g"div\0"; };
                if (pd == pb & pd != pa)
                {
                    if (k == SB_FADD | k == SB_FMUL)
                    {
                        o.put(9);
                        o.put_str(mn);
                        this.e_fs(o, sz);
                        this.e_reg(o, pa, 8);
                        o.put_str(g", \0");
                        this.e_reg(o, pd, 8);
                        o.put(10);
                        ->;
                    };
                    o.put_str(g"\tmovaps \0");
                    this.e_reg(o, pb, 8);
                    o.put_str(g", %xmm15\n\0");
                    this.e_ps(o, a, d);
                    o.put(9);
                    o.put_str(mn);
                    this.e_fs(o, sz);
                    o.put_str(g"%xmm15, \0");
                    this.e_reg(o, pd, 8);
                    o.put(10);
                    ->;
                };
                this.e_ps(o, a, d);
                o.put(9);
                o.put_str(mn);
                this.e_fs(o, sz);
                this.e_reg(o, pb, 8);
                o.put_str(g", \0");
                this.e_reg(o, pd, 8);
                o.put(10);
                ->;
            };

            e_fcmp(Buf* o, MI* m) -> void
            {
                o.put_str(g"\tucomis\0");
                if (m.sz == 4) { o.put_str(g"s \0"); } else { o.put_str(g"d \0"); };
                this.e_reg(o, this.s_phys(m.o1.r), 8);
                o.put_str(g", \0");
                this.e_reg(o, this.s_phys(m.o0.r), 8);
                o.put(10);
                ->;
            };

            e_xmov(Buf* o, MI* m) -> void
            {
                MO* a = m.o0;
                MO* b = m.o1;
                if (a.k == MK_REG & b.k == MK_REG) { this.e_ps(o, a, b); ->; };
                o.put(9);
                if (m.sz == 4) { o.put_str(g"movss \0"); } else { o.put_str(g"movsd \0"); };
                this.e_op(o, a, 8);
                o.put_str(g", \0");
                this.e_op(o, b, 8);
                o.put(10);
                ->;
            };

            e_gx(Buf* o, MI* m) -> void
            {
                MO* a = m.o0;
                MO* b = m.o1;
                int pb;
                int sz = m.sz;
                if (a.k == MK_IMM)
                {
                    pb = this.s_phys(b.r);
                    if (a.imm == (i64)0)
                    {
                        o.put_str(g"\txorps \0");
                        this.e_reg(o, pb, 8);
                        o.put_str(g", \0");
                        this.e_reg(o, pb, 8);
                        o.put(10);
                        ->;
                    };
                    o.put_str(g"\tmovabsq $\0");
                    put_i64(o, a.imm);
                    o.put_str(g", %r10\n\tmovq %r10, \0");
                    this.e_reg(o, pb, 8);
                    o.put(10);
                    ->;
                };
                o.put(9);
                if (sz == 4) { o.put_str(g"movd \0"); } else { o.put_str(g"movq \0"); };
                this.e_reg(o, this.s_phys(a.r), sz);
                o.put_str(g", \0");
                this.e_reg(o, this.s_phys(b.r), sz);
                o.put(10);
                ->;
            };

            e_fsel(Buf* o, MI* m) -> void
            {
                int sz = m.sz;
                MO* a = m.o0;
                MO* b = m.o1;
                MO* d = m.o2;
                int pa = this.s_phys(a.r);
                int pb = this.s_phys(b.r);
                int pd = this.s_phys(d.r);
                int cc = m.cc;
                int n;
                this.lab++;
                n = this.lab;
                if (pd == pa)
                {
                    // d holds the value for the true case: replace it when the condition is false
                    o.put_str(g"\tj\0");
                    this.e_cc(o, cc);
                    o.put_str(g" .LF\0");
                    o.put_int(n);
                    o.put(10);
                    this.e_ps(o, b, d);
                }
                else
                {
                    if (pd != pb) { this.e_ps(o, b, d); };
                    o.put_str(g"\tj\0");
                    this.e_cc(o, this.s_invcc(cc));
                    o.put_str(g" .LF\0");
                    o.put_int(n);
                    o.put(10);
                    this.e_ps(o, a, d);
                };
                o.put_str(g".LF\0");
                o.put_int(n);
                o.put_str(g":\n\0");
                ->;
            };

            // Remainder with the x87 unit, fprem is repeated until the reduction is complete
            e_frem(Buf* o, MI* m) -> void
            {
                int sz = m.sz;
                int pa = this.s_phys(m.o0.r);
                int pb = this.s_phys(m.o1.r);
                int pd = this.s_phys(m.o2.r);
                int n;
                this.lab++;
                n = this.lab;
                o.put_str(g"\tsubq $8, %rsp\n\0");
                o.put(9);
                if (sz == 4) { o.put_str(g"movss \0"); } else { o.put_str(g"movsd \0"); };
                this.e_reg(o, pb, 8);
                o.put_str(g", (%rsp)\n\0");
                if (sz == 4) { o.put_str(g"\tflds (%rsp)\n\0"); } else { o.put_str(g"\tfldl (%rsp)\n\0"); };
                o.put(9);
                if (sz == 4) { o.put_str(g"movss \0"); } else { o.put_str(g"movsd \0"); };
                this.e_reg(o, pa, 8);
                o.put_str(g", (%rsp)\n\0");
                if (sz == 4) { o.put_str(g"\tflds (%rsp)\n\0"); } else { o.put_str(g"\tfldl (%rsp)\n\0"); };
                o.put_str(g".LF\0");
                o.put_int(n);
                o.put_str(g":\n\tfprem\n\tfnstsw %ax\n\ttestb $4, %ah\n\tjne .LF\0");
                o.put_int(n);
                o.put_str(g"\n\tfstp %st(1)\n\0");
                if (sz == 4) { o.put_str(g"\tfstps (%rsp)\n\tmovss (%rsp), \0"); } else { o.put_str(g"\tfstpl (%rsp)\n\tmovsd (%rsp), \0"); };
                this.e_reg(o, pd, 8);
                o.put_str(g"\n\taddq $8, %rsp\n\0");
                ->;
            };

            // Conversions, the labels are numbered from the module counter
            e_cvt(Buf* o, MI* m) -> void
            {
                int k = m.cc;
                int sz = m.sz;
                MO* a = m.o0;
                MO* d = m.o1;
                int pa = this.s_phys(a.r);
                int pd = this.s_phys(d.r);
                int l1, l2;
                if (k == 1 | k == 2)
                {
                    o.put_str(g"\tcvt\0");
                    if (k == 1) { o.put_str(g"ss2sd \0"); } else { o.put_str(g"sd2ss \0"); };
                    this.e_reg(o, pa, 8);
                    o.put_str(g", \0");
                    this.e_reg(o, pd, 8);
                    o.put(10);
                    ->;
                };
                if (k == 3)
                {
                    o.put_str(g"\txorps \0");
                    this.e_reg(o, pd, 8);
                    o.put_str(g", \0");
                    this.e_reg(o, pd, 8);
                    o.put_str(g"\n\tcvtsi2\0");
                    if (sz == 4) { o.put_str(g"ssq \0"); } else { o.put_str(g"sdq \0"); };
                    this.e_reg(o, pa, 8);
                    o.put_str(g", \0");
                    this.e_reg(o, pd, 8);
                    o.put(10);
                    ->;
                };
                this.lab++;
                l1 = this.lab;
                this.lab++;
                l2 = this.lab;
                if (k == 4)
                {
                    // unsigned 64 bit value: halve it with the low bit kept when the top bit is set
                    o.put_str(g"\txorps \0");
                    this.e_reg(o, pd, 8);
                    o.put_str(g", \0");
                    this.e_reg(o, pd, 8);
                    o.put_str(g"\n\ttestq \0");
                    this.e_reg(o, pa, 8);
                    o.put_str(g", \0");
                    this.e_reg(o, pa, 8);
                    o.put_str(g"\n\tjs .LU\0");
                    o.put_int(l1);
                    o.put_str(g"\n\tcvtsi2\0");
                    if (sz == 4) { o.put_str(g"ssq \0"); } else { o.put_str(g"sdq \0"); };
                    this.e_reg(o, pa, 8);
                    o.put_str(g", \0");
                    this.e_reg(o, pd, 8);
                    o.put_str(g"\n\tjmp .LU\0");
                    o.put_int(l2);
                    o.put_str(g"\n.LU\0");
                    o.put_int(l1);
                    o.put_str(g":\n\tmovq \0");
                    this.e_reg(o, pa, 8);
                    o.put_str(g", %r10\n\tshrq %r10\n\tmovq \0");
                    this.e_reg(o, pa, 8);
                    o.put_str(g", %r11\n\tandl $1, %r11d\n\torq %r11, %r10\n\tcvtsi2\0");
                    if (sz == 4) { o.put_str(g"ssq %r10, \0"); } else { o.put_str(g"sdq %r10, \0"); };
                    this.e_reg(o, pd, 8);
                    o.put_str(g"\n\tadd\0");
                    if (sz == 4) { o.put_str(g"ss \0"); } else { o.put_str(g"sd \0"); };
                    this.e_reg(o, pd, 8);
                    o.put_str(g", \0");
                    this.e_reg(o, pd, 8);
                    o.put_str(g"\n.LU\0");
                    o.put_int(l2);
                    o.put_str(g":\n\0");
                    ->;
                };
                if (k == 5)
                {
                    o.put_str(g"\tcvtt\0");
                    if (sz == 4) { o.put_str(g"ss2siq \0"); } else { o.put_str(g"sd2siq \0"); };
                    this.e_reg(o, pa, 8);
                    o.put_str(g", \0");
                    this.e_reg(o, pd, 8);
                    o.put(10);
                    ->;
                };
                // unsigned 64 bit result: values from 2^63 up are converted after subtracting 2^63
                if (sz == 4) { o.put_str(g"\tmovl $0x5f000000, %r10d\n\tmovd %r10d, %xmm15\n\tucomiss %xmm15, \0"); }
                else { o.put_str(g"\tmovabsq $0x43e0000000000000, %r10\n\tmovq %r10, %xmm15\n\tucomisd %xmm15, \0"); };
                this.e_reg(o, pa, 8);
                o.put_str(g"\n\tjae .LU\0");
                o.put_int(l1);
                o.put_str(g"\n\tcvtt\0");
                if (sz == 4) { o.put_str(g"ss2siq \0"); } else { o.put_str(g"sd2siq \0"); };
                this.e_reg(o, pa, 8);
                o.put_str(g", \0");
                this.e_reg(o, pd, 8);
                o.put_str(g"\n\tjmp .LU\0");
                o.put_int(l2);
                o.put_str(g"\n.LU\0");
                o.put_int(l1);
                o.put_str(g":\n\tmovaps \0");
                this.e_reg(o, pa, 8);
                o.put_str(g", %xmm14\n\tsub\0");
                if (sz == 4) { o.put_str(g"ss %xmm15, %xmm14\n\tcvttss2siq %xmm14, \0"); } else { o.put_str(g"sd %xmm15, %xmm14\n\tcvttsd2siq %xmm14, \0"); };
                this.e_reg(o, pd, 8);
                o.put_str(g"\n\tmovabsq $0x8000000000000000, %r10\n\txorq %r10, \0");
                this.e_reg(o, pd, 8);
                o.put_str(g"\n.LU\0");
                o.put_int(l2);
                o.put_str(g":\n\0");
                ->;
            };

            // ==========================================================
            // SSA code generator: inline asm. Operands are bound to hardware registers the way the text emitter binds
            // them, the registers are pinned through the implicit register masks of the instruction.
            // ==========================================================

            // Hardware register number of the register index r of the text emitter's register table
            s_ahw(int r) -> int
            {
                if (r <= 2) { -> r; };
                if (r == 3) { -> 6; };
                if (r == 4) { -> 7; };
                if (r >= 5 & r <= 8) { -> r + 3; };
                if (r == 9) { -> 3; };
                -> r + 2;
            };

            // Mask of hardware registers for a mask of register indices
            s_amask(int used) -> int
            {
                int r = 0;
                int m = 0;
                while (r < 14)
                {
                    if ((used `& (1 << r)) != 0) { m = m `| (1 << this.s_ahw(r)); };
                    r++;
                };
                -> m;
            };

            s_inline(SI* x, IRValue* callee) -> void
            {
                byte* t = callee.text;
                IRType* fty = callee.ty.elem;
                IRType* rt = fty.elem;
                GF* g = this.sf;
                MI* m;
                MO* s;
                MO** sv;
                IRValue* a;
                byte* body;
                int len, i, j, bs, ce, qs, bodyend, no, ni, nop, used, cb, ce2, k, c, r, sz, d;
                int imask, omask, ln0, ln1, bl;
                int[40] opreg = noinit;
                int[40] opkind = noinit;
                int[40] opty = noinit;
                int[40] opx = noinit;
                int[40] opmem = noinit;
                int nxr, fo;
                IRType* ot;
                bool brace;
                int modc;
                len = 0;
                while (t[len] != 0) { len++; };
                while (len > 0 & t[len - 1] != 34) { len--; };
                ce = len - 1;
                qs = ce - 1;
                while (qs > 0 & t[qs] != 34) { qs--; };
                bodyend = qs - 3;
                bs = 0;
                while (t[bs] != 34) { bs++; };
                bs++;
                i = qs + 1;
                nop = 0;
                no = 0;
                ni = 0;
                used = 0;
                while (i < ce)
                {
                    cb = i;
                    while (i < ce & t[i] != ',') { i++; };
                    ce2 = i;
                    if (t[cb] == '~')
                    {
                        this.mb.clear();
                        j = cb + 2;
                        while (j < ce2 & t[j] != '}') { this.mb.put((int)t[j]); j++; };
                        r = this.a_regidx(this.mb.mem);
                        if (r >= 0) { used = used `| (1 << r); };
                    }
                    else
                    {
                        if (t[cb] == '=')
                        {
                            opkind[nop] = 1;
                            opreg[nop] = -1;
                            opx[nop] = -1;
                            opmem[nop] = 0;
                            if (t[ce2 - 1] == 'x') { opkind[nop] = 10; opx[nop] = -2; };
                            if (t[cb + 1] == '{' & t[cb + 2] == 'x' & t[cb + 3] == 'm') { opkind[nop] = 10; opx[nop] = (int)t[cb + 6] - 48; };
                            j = cb + 1;
                            while (j < ce2)
                            {
                                if (t[j] == '{')
                                {
                                    this.mb.clear();
                                    j++;
                                    while (j < ce2 & t[j] != '}') { this.mb.put((int)t[j]); j++; };
                                    r = this.a_regidx(this.mb.mem);
                                    opreg[nop] = r;
                                    if (r >= 0) { used = used `| (1 << r); };
                                };
                                if (t[j] == '&') { opkind[nop] = 3; };
                                j++;
                            };
                            nop++;
                            no++;
                        }
                        else
                        {
                            opkind[nop] = 2;
                            opreg[nop] = -1;
                            opx[nop] = -1;
                            opmem[nop] = 0;
                            if (t[cb] == 'm') { opmem[nop] = 1; };
                            if (t[ce2 - 1] == 'x') { opkind[nop] = 9; opx[nop] = -2; };
                            if (t[cb] == '{' & t[cb + 1] == 'x' & t[cb + 2] == 'm') { opkind[nop] = 9; opx[nop] = (int)t[cb + 5] - 48; };
                            if (t[cb] == '{' & opkind[nop] == 2)
                            {
                                this.mb.clear();
                                j = cb + 1;
                                while (j < ce2 & t[j] != '}') { this.mb.put((int)t[j]); j++; };
                                r = this.a_regidx(this.mb.mem);
                                opreg[nop] = r;
                                if (r >= 0) { used = used `| (1 << r); };
                            };
                            if (t[cb] >= 48 & t[cb] <= 57)
                            {
                                opkind[nop] = 4;
                                opreg[nop] = (int)t[cb] - 48;
                            };
                            if (t[cb] == 'i' | t[cb] == 'n') { opkind[nop] = 5; };
                            nop++;
                            ni++;
                        };
                    };
                    i = ce2 + 1;
                };
                if (x.n != ni) { this.s_fail(g"inline asm operands\0"); ->; };
                i = 0;
                while (i < no)
                {
                    if (no == 1) { opty[i] = this.a_size(rt); }
                    else { opty[i] = this.a_size(rt.items[i]); };
                    i++;
                };
                i = 0;
                while (i < ni)
                {
                    opty[no + i] = this.a_size(this.s_res(x.args[i]).ty);
                    i++;
                };
                nxr = 0;
                i = 0;
                while (i < nop)
                {
                    if (opx[i] == -2) { opx[i] = nxr; nxr++; };
                    i++;
                };
                i = no;
                while (i < nop)
                {
                    if (opkind[i] == 2 & opreg[i] < 0)
                    {
                        r = this.a_pick(used);
                        opreg[i] = r;
                        used = used `| (1 << r);
                    };
                    i++;
                };
                i = no;
                while (i < nop)
                {
                    if (opkind[i] == 4)
                    {
                        k = opreg[i];
                        if (opreg[k] < 0)
                        {
                            r = this.a_pick(used);
                            opreg[k] = r;
                            used = used `| (1 << r);
                        };
                        opreg[i] = opreg[k];
                    };
                    i++;
                };
                i = 0;
                while (i < no)
                {
                    if (opreg[i] < 0 & opkind[i] != 10)
                    {
                        r = -1;
                        if (opkind[i] != 3)
                        {
                            j = no;
                            while (j < nop & r < 0)
                            {
                                if (opkind[j] == 2 & opreg[j] >= 0 & !this.a_tied(@opreg[0], @opkind[0], no, nop, opreg[j]))
                                {
                                    r = opreg[j];
                                    opkind[j] = 6;
                                };
                                j++;
                            };
                        };
                        if (r < 0)
                        {
                            r = this.a_pick(used);
                            used = used `| (1 << r);
                        };
                        opreg[i] = r;
                    };
                    i++;
                };
                // operands first: they may need instructions of their own
                sv = (MO**)this.s_ar(8 * (ni + 1));
                i = 0;
                while (i < ni)
                {
                    a = this.s_res(x.args[i]);
                    k = opkind[no + i];
                    sv[i] = (MO*)0;
                    if (k == 5)
                    {
                        if (!this.s_isint(a)) { this.s_fail(g"inline asm constant\0"); ->; };
                    }
                    else
                    {
                        s = this.s_src(a);
                        sz = this.s_vsz(a.ty);
                        if (s.k == MK_REG & sz < 4 & !this.s_isfp(a.ty) & k != 9) { s = this.s_mo_r(this.s_ext(s.r, sz, false, 4), 4); };
                        sv[i] = s;
                    };
                    i++;
                };
                if (this.gwhy != 0) { ->; };
                // inputs go to their registers
                imask = 0;
                i = no;
                while (i < nop)
                {
                    s = sv[i - no];
                    k = opkind[i];
                    if (k == 2 | k == 6 | k == 4)
                    {
                        if (s.k == MK_REG) { s = this.s_mo_copy(s); s.sz = 8; };
                        this.s_mov(s, this.s_ahw(opreg[i]), 8);
                        imask = imask `| (1 << this.s_ahw(opreg[i]));
                    };
                    if (k == 9)
                    {
                        this.s_mi2(M_XMOV, this.s_vsz(this.s_res(x.args[i - no]).ty), s, this.s_mo_r(16 + opx[i], 8));
                        imask = imask `| (1 << (16 + opx[i]));
                    };
                    i++;
                };
                // body text, one tab indented line per source line
                this.mb.clear();
                this.mb.put(9);
                i = bs;
                while (i < bodyend)
                {
                    c = (int)t[i];
                    if (c == '$')
                    {
                        if (t[i + 1] == '$') { this.mb.put(36); i = i + 2; }
                        else
                        {
                            i++;
                            brace = false;
                            modc = 0;
                            if (t[i] == '{') { brace = true; i++; };
                            k = 0;
                            while (t[i] >= 48 & t[i] <= 57) { k = k * 10 + ((int)t[i] - 48); i++; };
                            if (brace)
                            {
                                if (t[i] == ':') { i++; modc = (int)t[i]; i++; };
                                if (t[i] == '}') { i++; };
                            };
                            sz = opty[k];
                            if (modc == 'q') { sz = 8; };
                            if (modc == 'k') { sz = 4; };
                            if (modc == 'w') { sz = 2; };
                            if (modc == 'b') { sz = 1; };
                            if (opkind[k] == 5)
                            {
                                this.s_isint(x.args[k - no]);
                                put_i64(@this.mb, this.scv);
                            }
                            else
                            {
                                if (opkind[k] == 9 | opkind[k] == 10)
                                {
                                    this.mb.put_str(g"%xmm\0");
                                    this.mb.put_int(opx[k]);
                                }
                                else
                                {
                                    if (opmem[k] == 1)
                                    {
                                        this.mb.put(40);
                                        this.e_reg(@this.mb, this.s_ahw(opreg[k]), 8);
                                        this.mb.put(41);
                                    }
                                    else { this.e_reg(@this.mb, this.s_ahw(opreg[k]), sz); };
                                };
                            };
                        };
                    }
                    else
                    {
                        if (c == 10) { this.mb.put(10); this.mb.put(9); }
                        else { this.mb.put(c); };
                        i++;
                    };
                };
                this.mb.put(10);
                bl = this.mb.len;
                body = this.s_ar(bl + 1);
                i = 0;
                while (i < bl) { body[i] = this.mb.mem[i]; i++; };
                body[bl] = 0;
                // registers the asm writes: outputs and everything it names
                omask = this.s_amask(used);
                i = 0;
                while (i < no)
                {
                    if (opkind[i] == 10) { omask = omask `| (1 << (16 + opx[i])); }
                    else { omask = omask `| (1 << this.s_ahw(opreg[i])); };
                    i++;
                };
                i = 0;
                while (i < ni)
                {
                    if (opkind[no + i] == 9) { omask = omask `| (1 << (16 + opx[no + i])); };
                    i++;
                };
                m = this.s_mi(M_ASM, 8);
                m.text = body;
                m.iu = imask;
                m.clob = omask;
                g.asmsv = g.asmsv `| omask;
                if (no > 1)
                {
                    // several outputs make a struct result, written field by field into a frame object
                    fo = this.s_newfo(this.a_size(rt), this.a_align(rt));
                    i = 0;
                    while (i < no)
                    {
                        ot = (IRType*)rt.items[i];
                        sz = this.s_vsz(ot);
                        s = this.s_mo_mem(0 - 1, 0 - 1, 1, (i64)this.a_foff(rt, i), (byte*)0, fo - 1);
                        if (opkind[i] == 10) { this.s_mi2(M_XMOV, sz, this.s_mo_r(16 + opx[i], 8), s); }
                        else { this.s_mi2(M_MOV, sz, this.s_mo_r(this.s_ahw(opreg[i]), sz), s); };
                        i++;
                    };
                    x.res.fo = fo;
                    ->;
                };
                i = 0;
                while (i < no)
                {
                    sz = this.s_vsz(rt);
                    if (opkind[i] == 10)
                    {
                        d = this.s_def(x.res, 1);
                        this.s_mi2(M_XMOV, sz, this.s_mo_r(16 + opx[i], 8), this.s_mo_r(d, sz));
                    }
                    else
                    {
                        d = this.s_def(x.res, 0);
                        if (sz < 4) { this.s_mi2(M_MOVZX, sz, this.s_mo_r(this.s_ahw(opreg[i]), sz), this.s_mo_r(d, 4)); }
                        else { this.s_mov(this.s_mo_r(this.s_ahw(opreg[i]), sz), d, sz); };
                    };
                    i++;
                };
                ->;
            };

            // The body of a naked function: the inline asm of its blocks exactly as written, no prologue
            s_naked(IRFunc* f, Buf* out) -> void
            {
                IRBlock* bl;
                SI* x;
                IRValue* callee;
                byte* t;
                int j, k, i, len, bs, bodyend, qs, ce, ls, le, c;
                byte* nm = this.a_sym(f.self.text);
                this.s_head(f, out);
                j = 0;
                while (j < f.blocks.len)
                {
                    bl = (IRBlock*)f.blocks.items[j];
                    out.put_str(g".LB\0");
                    out.put_int(bl.id);
                    out.put_str(g":\n\0");
                    k = 0;
                    while (bl.insts != (PtrVec*)0 & k < bl.insts.len)
                    {
                        x = (SI*)bl.insts.items[k];
                        k++;
                        if (x.op == SO_RETV) { out.put_str(g"\tleave\n\tret\n\0"); }
                        else
                        {
                            if (x.op == SO_UNREACH) { out.put_str(g"\tud2\n\0"); }
                            else
                            {
                                if (x.op == SO_BR)
                                {
                                    out.put_str(g"\tjmp .LB\0");
                                    out.put_int(x.t.id);
                                    out.put(10);
                                }
                                else
                                {
                                    callee = x.a;
                                    if (x.op != SO_CALL | callee == (IRValue*)0) { this.s_fail(g"naked body\0"); ->; };
                                    if (!this.a_pre(callee.text, g"asm\0")) { this.s_fail(g"naked body\0"); ->; };
                                    t = callee.text;
                                    len = 0;
                                    while (t[len] != 0) { len++; };
                                    while (len > 0 & t[len - 1] != 34) { len--; };
                                    ce = len - 1;
                                    qs = ce - 1;
                                    while (qs > 0 & t[qs] != 34) { qs--; };
                                    bodyend = qs - 3;
                                    bs = 0;
                                    while (t[bs] != 34) { bs++; };
                                    bs++;
                                    this.mb.clear();
                                    i = bs;
                                    while (i < bodyend)
                                    {
                                        c = (int)t[i];
                                        if (c == '$')
                                        {
                                            if (t[i + 1] != '$') { this.s_fail(g"naked operand\0"); ->; };
                                            this.mb.put(36);
                                            i = i + 2;
                                        }
                                        else { this.mb.put(c); i++; };
                                    };
                                    // one trimmed line at a time
                                    i = 0;
                                    while (i <= this.mb.len)
                                    {
                                        ls = i;
                                        while (i < this.mb.len & this.mb.mem[i] != 10) { i++; };
                                        le = i;
                                        while (ls < le & (this.mb.mem[ls] == ' ' | this.mb.mem[ls] == 9 | this.mb.mem[ls] == 13)) { ls++; };
                                        while (le > ls & (this.mb.mem[le - 1] == ' ' | this.mb.mem[le - 1] == 9 | this.mb.mem[le - 1] == 13)) { le--; };
                                        if (le > ls)
                                        {
                                            out.put(9);
                                            out.put_n(this.mb.mem + ls, le - ls);
                                            out.put(10);
                                        };
                                        i++;
                                    };
                                };
                            };
                        };
                    };
                    j++;
                };
                if (!this.a_win())
                {
                    out.put_str(g"\t.size \0");
                    out.put_str(nm);
                    out.put_str(g", .-\0");
                    out.put_str(nm);
                    out.put(10);
                };
                ->;
            };

            // ==========================================================
            // SSA code generator: the values the builder calls hand back to the front end. The instructions
            // themselves are recorded by the issa_a mappers, nothing is emitted while the front end runs.
            // ==========================================================

            // A new value of type t named after a counter
            n_val(IRType* t) -> IRValue*
            {
                this.tb.clear();
                this.tb.put_str(g"%v\0");
                this.tb.put_int(this.lab);
                this.lab++;
                -> this.new_value(t, this.tb.mem);
            };

            n_alloca(IRType* ty) -> IRValue*
            {
                IRValue* av;
                this.tb.clear();
                this.tb.put_str(g"%a\0");
                this.tb.put_int(this.lab);
                this.lab++;
                av = this.new_value(this.t_ptr(ty), this.tb.mem);
                av.flags = VF_ALLOCA;
                -> av;
            };

            // Result type of a gep: the pointee type after the indices past the first
            n_gep(IRValue* p, IRValue** idx, int n) -> IRValue*
            {
                IRType* cur = p.ty.elem;
                int i = 1;
                while (i < n)
                {
                    if (cur.kind == LK.STRUCT | cur.kind == LK.ISTRUCT) { cur = cur.items[(int)this.const_val(idx[i])]; }
                    else { cur = cur.elem; };
                    i++;
                };
                -> this.n_val(this.t_ptr(cur));
            };

            // Result of a call: nothing for void
            n_call(IRValue* callee) -> IRValue*
            {
                IRType* rt = callee.ty.elem.elem;
                if (rt.kind == LK.VOID) { -> (IRValue*)0; };
                -> this.n_val(rt);
            };

            n_extract(IRValue* agg, int i) -> IRValue*
            {
                -> this.n_val(this.index_type(agg.ty, this.c_int(this.t_int(32), (i64)i)));
            };

            // ==========================================================
            // driver: one function from the recorded instructions to assembly text.
            // ==========================================================

            // Makes the per function state
            s_gf_new(IRFunc* f) -> GF*
            {
                GF* g = (GF*)fmalloc((u64)(((sizeof(GF) + 7) / 8) * 2));
                g.f = f;
                g.bl = pv_new();
                g.rpo = (GB**)0;
                g.nb = 0;
                g.nvr = R_VBASE;
                g.capvr = 0;
                g.vcls = (int*)0;
                g.vwgt = (int*)0;
                g.vcol = (int*)0;
                g.vslot = (int*)0;
                g.vforb = (int*)0;
                g.vhint = (int*)0;
                g.vdef = (int*)0;
                g.vglob = (int*)0;
                g.vuse = (int*)0;
                g.nglob = 0;
                g.outmax = 0;
                g.fobj = pv_new();
                g.saved = 0;
                g.asmsv = 0;
                g.sretv = 0;
                g.vagp = 0;
                g.vafp = 0;
                g.vastk = 0;
                g.vafo = 0;
                g.frame = 0;
                g.csbase = 0;
                g.dyn = false;
                g.nofp = false;
                g.sw = false;
                g.mlast = 0;
                g.rcap = 0;
                g.nl = 0;
                g.occ = 0;
                g.csbase2 = 0;
                g.lpos = (int*)0;
                g.llist = (int*)0;
                g.gv = (int*)0;
                g.gw = (int*)0;
                g.cur = (int*)0;
                g.csoff = (int*)0;
                -> g;
            };


            // ----------------------------------------------------------
            // Inlining of the functions declared inline
            // ----------------------------------------------------------

            s_inl_attr(IRFunc* g, byte* name) -> bool
            {
                int i = 0;
                while (i < g.attrs.len)
                {
                    if (this.a_seq((byte*)g.attrs.items[i], name)) { -> true; };
                    i++;
                };
                -> false;
            };

            s_inl_scalar(IRType* t) -> bool
            {
                -> t.kind == LK.INT | t.kind == LK.FLOAT | t.kind == LK.DOUBLE | t.kind == LK.PTR;
            };

            // Whether the calls of g are replaced by its body
            s_inl_ok(IRFunc* g) -> bool
            {
                int i, j, nret, tot;
                IRBlock* b;
                SI* x;
                if (!this.s_inl_attr(g, g"alwaysinline\0")) { -> false; };
                if (this.s_inl_attr(g, g"noinline\0") | this.s_inl_attr(g, g"naked\0")) { -> false; };
                if (g.is_decl | g.ftype.vararg | g.blocks.len == 0) { -> false; };
                if (g.ftype.elem.kind != LK.VOID & !this.s_inl_scalar(g.ftype.elem)) { -> false; };
                i = 0;
                while (i < g.nargs)
                {
                    if (!this.s_inl_scalar(g.ftype.items[i])) { -> false; };
                    i++;
                };
                nret = 0;
                tot = 0;
                i = 0;
                while (i < g.blocks.len)
                {
                    b = (IRBlock*)g.blocks.items[i];
                    if (b.insts == (PtrVec*)0) { -> false; };
                    if (b.insts.len == 0) { -> false; };
                    if (!this.s_isterm((SI*)b.insts.items[b.insts.len - 1])) { -> false; };
                    j = 0;
                    while (j < b.insts.len)
                    {
                        x = (SI*)b.insts.items[j];
                        if (x.op == SO_ALLOCAN | x.op == SO_VAARG) { -> false; };
                        if (x.op == SO_CALL) { if (x.a == g.self) { -> false; }; };
                        if (x.op == SO_RET | x.op == SO_RETV) { nret++; };
                        tot++;
                        j++;
                    };
                    i++;
                };
                if (nret == 0 | tot > 4000) { -> false; };
                -> true;
            };

            s_inl_map(IRValue* v) -> IRValue*
            {
                if (v == (IRValue*)0) { -> v; };
                if (v.cl != (void*)0) { -> (IRValue*)v.cl; };
                -> v;
            };

            s_inl_blk(IRFunc* g, IRBlock** cb, IRBlock* b) -> IRBlock*
            {
                int i = 0;
                if (b == (IRBlock*)0) { -> b; };
                while (i < g.blocks.len)
                {
                    if (g.blocks.items[i] == (void*)b) { -> cb[i]; };
                    i++;
                };
                -> b;
            };

            // Replaces the call at index j of block bb of f by the body of g
            s_inl_expand(IRFunc* f, IRBlock* bb, int j, IRFunc* g) -> void
            {
                SI* call = (SI*)bb.insts.items[j];
                SI* x;
                SI* y;
                IRBlock* post;
                IRBlock* ob;
                IRBlock* nb;
                IRBlock** cb;
                IRBlock** rb;
                IRValue** rv;
                IRValue** tv;
                IRBlock** tb;
                PtrVec* touched;
                PtrVec* tail;
                IRValue* v;
                SI* t;
                SI* ps;
                IRBlock** sv;
                int i, k, m, nr, ns;
                this.cf = f;
                // the instructions after the call move to a new block
                post = this.append_block(f, g"inl.post\0");
                tail = pv_new();
                k = j + 1;
                while (k < bb.insts.len) { pv_push(tail, bb.insts.items[k]); k++; };
                bb.insts.len = j;
                // phi operands that named bb as predecessor name the new block
                t = (SI*)tail.items[tail.len - 1];
                sv = (IRBlock**)fmalloc((u64)(8 * (t.n + 3)));
                ns = this.s_succ(t, sv);
                i = 0;
                while (i < ns)
                {
                    ob = sv[i];
                    if (ob.insts != (PtrVec*)0)
                    {
                        k = 0;
                        while (k < ob.insts.len)
                        {
                            ps = (SI*)ob.insts.items[k];
                            if (ps.op == SO_PHI)
                            {
                                m = 0;
                                while (m < ps.n) { if (ps.blks[m] == bb) { ps.blks[m] = post; }; m++; };
                            };
                            k++;
                        };
                    };
                    i++;
                };
                ffree((byte*)sv);
                // copies of the blocks and of every value the body defines
                cb = (IRBlock**)fmalloc((u64)(8 * (g.blocks.len + 1)));
                i = 0;
                while (i < g.blocks.len)
                {
                    ob = (IRBlock*)g.blocks.items[i];
                    cb[i] = this.append_block(f, ob.name);
                    i++;
                };
                touched = pv_new();
                i = 0;
                while (i < g.nargs)
                {
                    g.args[i].cl = (void*)call.args[i];
                    pv_push(touched, (void*)g.args[i]);
                    i++;
                };
                i = 0;
                while (i < g.blocks.len)
                {
                    ob = (IRBlock*)g.blocks.items[i];
                    k = 0;
                    while (k < ob.insts.len)
                    {
                        x = (SI*)ob.insts.items[k];
                        if (x.res != (IRValue*)0)
                        {
                            v = this.new_value(x.res.ty, x.res.text);
                            v.flags = x.res.flags;
                            v.spec = x.res.spec;
                            v.espec = x.res.espec;
                            v.is_const = x.res.is_const;
                            x.res.cl = (void*)v;
                            pv_push(touched, (void*)x.res);
                        };
                        k++;
                    };
                    i++;
                };
                rv = (IRValue**)fmalloc((u64)(8 * (g.blocks.len + 1)));
                rb = (IRBlock**)fmalloc((u64)(8 * (g.blocks.len + 1)));
                nr = 0;
                i = 0;
                while (i < g.blocks.len)
                {
                    ob = (IRBlock*)g.blocks.items[i];
                    nb = cb[i];
                    this.cb = nb;
                    k = 0;
                    while (k < ob.insts.len)
                    {
                        x = (SI*)ob.insts.items[k];
                        if (x.op == SO_RET | x.op == SO_RETV)
                        {
                            if (x.op == SO_RET)
                            {
                                rv[nr] = this.s_inl_map(x.a);
                                rb[nr] = nb;
                                nr++;
                            };
                            this.s_r_br(post);
                            k++;
                            continue;
                        };
                        y = this.s_new(x.op);
                        y.k = x.k;
                        y.n = x.n;
                        y.sz = x.sz;
                        y.bi = x.bi;
                        y.ty = x.ty;
                        y.vol = x.vol;
                        y.flag = x.flag;
                        y.pos = x.pos;
                        if (x.op == SO_CALL) { y.flag = false; };
                        y.res = this.s_inl_map(x.res);
                        y.a = this.s_inl_map(x.a);
                        y.b = this.s_inl_map(x.b);
                        y.c = this.s_inl_map(x.c);
                        if (x.op == SO_GEP | x.op == SO_CALL | x.op == SO_PHI | x.op == SO_SWITCH)
                        {
                            tv = (IRValue**)fmalloc((u64)(8 * (x.n + 1)));
                            m = 0;
                            while (m < x.n) { tv[m] = this.s_inl_map(x.args[m]); m++; };
                            y.args = this.s_cpv(tv, x.n);
                            ffree((byte*)tv);
                        };
                        if (x.op == SO_PHI | x.op == SO_SWITCH)
                        {
                            tb = (IRBlock**)fmalloc((u64)(8 * (x.n + 1)));
                            m = 0;
                            while (m < x.n) { tb[m] = this.s_inl_blk(g, cb, x.blks[m]); m++; };
                            y.blks = this.s_cpb(tb, x.n);
                            ffree((byte*)tb);
                        };
                        y.t = this.s_inl_blk(g, cb, x.t);
                        y.f = this.s_inl_blk(g, cb, x.f);
                        this.s_push(y);
                        k++;
                    };
                    i++;
                };
                i = 0;
                while (i < touched.len)
                {
                    ((IRValue*)touched.items[i]).cl = (void*)0;
                    i++;
                };
                pv_free(touched);
                // the new block starts with the result of the call, then the instructions that followed it
                if (post.insts == (PtrVec*)0) { post.insts = pv_new(); };
                this.cb = post;
                if (call.res != (IRValue*)0) { this.s_r_phi(call.res.ty, rv, rb, nr, call.res); };
                k = 0;
                while (k < tail.len)
                {
                    pv_push(post.insts, tail.items[k]);
                    k++;
                };
                pv_free(tail);
                ffree((byte*)rv);
                ffree((byte*)rb);
                nb = cb[0];
                ffree((byte*)cb);
                this.cb = bb;
                this.s_r_br(nb);
                ->;
            };

            // Expands the calls of f to inline functions, the new blocks are looked at in turn
            s_inl_func(IRFunc* f, PtrVec* cands) -> void
            {
                int bi, j, c, budget;
                IRBlock* b;
                SI* x;
                bool hit;
                budget = 200;
                bi = 0;
                while (bi < f.blocks.len)
                {
                    b = (IRBlock*)f.blocks.items[bi];
                    j = 0;
                    hit = false;
                    while (b.insts != (PtrVec*)0 & j < b.insts.len & !hit)
                    {
                        x = (SI*)b.insts.items[j];
                        if (x.op == SO_CALL & budget > 0)
                        {
                            c = 0;
                            while (c < cands.len)
                            {
                                if (((IRFunc*)cands.items[c]).self == x.a)
                                {
                                    if (cands.items[c] != (void*)f & x.n == ((IRFunc*)cands.items[c]).nargs)
                                    {
                                        this.s_inl_expand(f, b, j, (IRFunc*)cands.items[c]);
                                        budget--;
                                        hit = true;
                                    };
                                    c = cands.len;
                                };
                                c++;
                            };
                        };
                        j++;
                    };
                    bi++;
                };
                ->;
            };

            s_inline_all() -> void
            {
                PtrVec* cands = pv_new();
                IRFunc* f;
                int i = 0;
                while (i < this.funcs.len)
                {
                    f = (IRFunc*)this.funcs.items[i];
                    if (this.s_inl_ok(f)) { pv_push(cands, (void*)f); };
                    i++;
                };
                if (cands.len > 0)
                {
                    i = 0;
                    while (i < this.funcs.len)
                    {
                        f = (IRFunc*)this.funcs.items[i];
                        if (!f.is_decl & !this.a_naked(f)) { this.s_inl_func(f, cands); };
                        i++;
                    };
                };
                pv_free(cands);
                ->;
            };

            // Releases the recorded instructions of f and the state of the code generator
            s_gf_free(IRFunc* f) -> void
            {
                GF* g = this.sf;
                int i;
                GB* gb;
                if (g != (GF*)0)
                {
                    i = 0;
                    while (i < g.bl.len)
                    {
                        gb = (GB*)g.bl.items[i];
                        pv_free(gb.preds); pv_free(gb.succs); pv_free(gb.kids); pv_free(gb.df); pv_free(gb.phis); pv_free(gb.mi);
                        ffree((byte*)gb);
                        i++;
                    };
                    pv_free(g.bl);
                    pv_free(g.fobj);
                    if (g.rpo != (GB**)0) { ffree((byte*)g.rpo); };
                    ffree((byte*)g);
                    this.sf = (GF*)0;
                };
                if (f.sall != (PtrVec*)0)
                {
                    i = 0;
                    while (i < f.sall.len) { ffree((byte*)f.sall.items[i]); i++; };
                    pv_free(f.sall);
                    f.sall = (PtrVec*)0;
                    f.sleft = 0;
                };
                if (f.sarr != (PtrVec*)0)
                {
                    i = 0;
                    while (i < f.sarr.len) { ffree((byte*)f.sarr.items[i]); i++; };
                    pv_free(f.sarr);
                    f.sarr = (PtrVec*)0;
                    f.aleft = 0;
                };
                i = 0;
                while (i < f.blocks.len)
                {
                    gb = (GB*)0;
                    if (((IRBlock*)f.blocks.items[i]).insts != (PtrVec*)0)
                    {
                        pv_free(((IRBlock*)f.blocks.items[i]).insts);
                        ((IRBlock*)f.blocks.items[i]).insts = (PtrVec*)0;
                    };
                    i++;
                };
                ->;
            };

            // Compiles f with the SSA code generator. Returns false when the function needs something the
            // code generator cannot do yet, the caller then keeps the text the builder wrote.
            s_func(IRFunc* f, Buf* out) -> bool
            {
                bool ok;
                this.gwhy = 0;
                this.gwhys = (byte*)0;
                this.cf = f;
                // the register names are needed from selection on (inline asm operands), not only when writing
                this.s_rnames();
                if (this.a_naked(f))
                {
                    this.s_naked(f, out);
                    -> this.gwhy == 0;
                };
                this.sf = this.s_gf_new(f);
                ok = this.s_cfg();
                if (ok)
                {
                    this.s_prep();
                    this.s_promote();
                    if (SSA_OPT_FOLD == 1) { this.s_opt(); };
                    this.s_prep();
                    ok = this.s_recfg();
                    if (ok & SSA_OPT_MERGE == 1)
                    {
                        if (this.s_merge()) { ok = this.s_recfg(); };
                    };
                    if (ok & SSA_OPT_DOMCOND == 1)
                    {
                        if (this.s_domcond())
                        {
                            this.s_opt();
                            this.s_prep();
                            ok = this.s_recfg();
                            if (ok & SSA_OPT_MERGE == 1)
                            {
                                if (this.s_merge()) { ok = this.s_recfg(); };
                            };
                        };
                    };
                    if (ok & SSA_OPT_THREAD == 1)
                    {
                        if (this.s_thread())
                        {
                            this.s_opt();
                            this.s_prep();
                            ok = this.s_recfg();
                            if (ok & SSA_OPT_MERGE == 1)
                            {
                                if (this.s_merge()) { ok = this.s_recfg(); };
                            };
                        };
                    };
                    if (ok & SSA_OPT_EQCHAIN == 1)
                    {
                        if (this.s_eqchain())
                        {
                            this.s_opt();
                            this.s_prep();
                            ok = this.s_recfg();
                            if (ok & SSA_OPT_MERGE == 1)
                            {
                                if (this.s_merge()) { ok = this.s_recfg(); };
                            };
                        };
                    };
                    if (ok)
                    {
                        if (SSA_OPT_IFCONV == 1 & this.s_ifconv())
                        {
                            this.s_opt();
                            this.s_prep();
                            ok = this.s_recfg();
                            if (ok & SSA_OPT_MERGE == 1)
                            {
                                if (this.s_merge()) { ok = this.s_recfg(); };
                            };
                        };
                    };
                    if (ok)
                    {
                        if (SSA_OPT_FILL == 1)
                        {
                            if (this.s_fill()) { ok = this.s_recfg(); };
                        };
                        if (SSA_OPT_UNROLL == 1 & ok)
                        {
                            if (this.s_unroll())
                            {
                                this.s_opt();
                                this.s_prep();
                                ok = this.s_recfg();
                                if (ok & SSA_OPT_MERGE == 1)
                                {
                                    if (this.s_merge()) { ok = this.s_recfg(); };
                                };
                            };
                        };
                        if (SSA_OPT_VRED == 1 & ok)
                        {
                            if (this.s_vred())
                            {
                                this.s_opt();
                                this.s_prep();
                                ok = this.s_recfg();
                                if (ok & SSA_OPT_MERGE == 1)
                                {
                                    if (this.s_merge()) { ok = this.s_recfg(); };
                                };
                            };
                        };
                        if (SSA_OPT_LICM == 1 | SSA_OPT_LDHOIST == 1)
                        {
                            if (this.s_licm() & SSA_OPT_HOISTCSE == 1)
                            {
                                this.s_opt();
                                this.s_prep();
                                ok = this.s_recfg();
                            };
                        };
                        if (SSA_OPT_IVW == 1 & ok)
                        {
                            if (this.s_ivw())
                            {
                                this.s_opt();
                                this.s_prep();
                                ok = this.s_recfg();
                            };
                        };
                        if (SSA_OPT_SR == 1 & ok)
                        {
                            if (this.s_sr())
                            {
                                this.s_opt();
                                this.s_prep();
                                ok = this.s_recfg();
                            };
                        };
                        this.s_dce();
                        this.s_loops();
                        if (SSA_OPT_SINK == 1) { this.s_sink(); };
                        ok = this.s_isel();
                        if (ok & SSA_OPT_STMERGE == 1) { this.s_stmerge(); };
                    };
                    if (ok) { ok = this.s_edges(); };
                    if (ok & SSA_OPT_TAILDUP == 1) { this.s_taildup(); };
                    if (ok & SSA_OPT_MDCE == 1) { this.s_mdce(); };
                    if (ok) { ok = this.s_ra(); };
                    if (ok)
                    {
                        this.eo.len = 0;
                        this.s_emit(f, @this.eo);
                        if (this.gwhy != 0) { ok = false; };
                        if (ok) { out.put_n(this.eo.mem, this.eo.len); };
                    };
                };
                this.s_ar_free();
                this.s_gf_free(f);
                if (this.gwhy != 0) { ok = false; };
                -> ok;
            };

#endif;
