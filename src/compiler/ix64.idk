// Author: Karac V. Thweatt
//
// ix64.idk - x86_64 assembly backend (System V, AT&T syntax)
//
// Backend counterpart of the LLVM IR text builder (i_llvmir.idk). It has no dependency on
// LLVM IR. It builds the shared code model (imodel.idk) and its builder methods select
// x86_64 instructions and write assembly directly.
//
// Model: every SSA value lives in an 8 byte frame slot (aggregates in a slot of their own
// size). Integers are kept zero extended to 64 bits, floats as raw bits. Each instruction
// loads its operands into scratch registers, computes and stores the result. A register
// allocator can replace this later without changing the builder interface.
//
// Registers: 0 rax 1 rcx 2 rdx 3 rsi 4 rdi 5 r8 6 r9 7 r10 8 r11 9 rbx 10 r12 11 r13 12 r14 13 r15
//
// Aggregates (structs and arrays) are passed by value as stack copies and returned through a
// hidden pointer in rdi, like the System V ABI does for memory class values.
//
// Ownership: every IRType, IRValue, string and block made through an X64Module
// belongs to that module and is released by X64Module.__exit.
//
#ifndef IDEKA_STANDARD
#import <standard.idk>;
#endif;

#ifndef IDEKA_AST
#import "iast.idk";
#endif;

#ifndef IDEKA_TYPES
#import "itypesys.idk";
#endif;

#ifndef IDEKA_MODEL
#import "imodel.idk";
#endif;

#ifndef IDEKA_X64
#def IDEKA_X64 1;

using IDEKA::ast;
using IDEKA::preprocessor;
using IDEKA::types;
using IDEKA::ir;

namespace IDEKA
{
    namespace x64
    {
#import "issa_types.idk";


        // ------------------------------------------------------------------
        // CPU features. The code is made for the processor the compiler runs on unless the
        // baseline x86_64 is asked for.
        // ------------------------------------------------------------------

        int x64_march = 0;      // 0 native, 1 baseline

        x64_set_march(int m) -> void
        {
            x64_march = m;
            ->;
        };

        // Bit mask of the XF_ features the processor has
        x64_detect() -> int
        {
            ulong eax, ebx, ecx, edx, mx, ex;
            int f = 0;
            if (x64_march == 1) { -> 0; };
            volatile asm
            {
                xorq %rax, %rax
                cpuid
                movq %rax, $0
            } : "=r"(mx) :
              : "rax","rbx","rcx","rdx","memory";
            volatile asm
            {
                movq $$0x80000000, %rax
                cpuid
                movq %rax, $0
            } : "=r"(ex) :
              : "rax","rbx","rcx","rdx","memory";
            if (mx >= 1ul)
            {
                volatile asm
                {
                    movq $$1, %rax
                    xorq %rcx, %rcx
                    cpuid
                    movq %rcx, $0
                } : "=r"(ecx) :
                  : "rax","rbx","rcx","rdx","memory";
                if (((ecx >> 23) `& 1ul) != 0ul) { f = f `| XF_POPCNT; };
                if (((ecx >> 22) `& 1ul) != 0ul) { f = f `| XF_MOVBE; };
            };
            if (mx >= 7ul)
            {
                volatile asm
                {
                    movq $$7, %rax
                    xorq %rcx, %rcx
                    cpuid
                    movq %rbx, $0
                    movq %rcx, $1
                } : "=r"(ebx), "=r"(ecx) :
                  : "rax","rbx","rcx","rdx","memory";
                if (((ebx >> 3) `& 1ul) != 0ul) { f = f `| XF_BMI1; };
                if (((ebx >> 8) `& 1ul) != 0ul) { f = f `| XF_BMI2; };
                if (((ebx >> 9) `& 1ul) != 0ul) { f = f `| XF_ERMS; };
                if (((ecx >> 8) `& 1ul) != 0ul) { f = f `| XF_GFNI; };
            };
            if (ex >= 0x80000001ul)
            {
                volatile asm
                {
                    movq $$0x80000001, %rax
                    xorq %rcx, %rcx
                    cpuid
                    movq %rcx, $0
                } : "=r"(ecx) :
                  : "rax","rbx","rcx","rdx","memory";
                if (((ecx >> 5) `& 1ul) != 0ul) { f = f `| XF_LZCNT; };
            };
            -> f;
        };

        // ------------------------------------------------------------------
        // Module
        // ------------------------------------------------------------------

        object X64Module
        {
            byte* mod_name, triple, layout;
            PtrVec* types;      // IRType* made here
            PtrVec* values;     // IRValue* made here
            byte* vp;           // free space left in the newest block of values
            int vleft;
            PtrVec* strs;       // byte* made here
            PtrVec* blobs;      // raw allocations (item arrays, blocks)
            PtrVec* named;      // identified struct types in creation order
            PtrVec* globals;    // IRGlobal*
            PtrVec* funcs;      // IRFunc*
            NameMap* gnames;    // global and function names in use
            NameMap* fmap;      // function name to IRFunc*
            NameMap* gmap;      // global name to IRGlobal*
            Buf tb;             // text scratch
            IRFunc* cf;         // function being built
            IRBlock* cb;        // insertion block
            IRBlock* entry_b;   // entry block of cf
            IRValue** ia;       // small operand scratch
            IRType* nul;        // elem of types that have none, so elem.kind is always readable
            bool a_handled;
            int abi;            // 0 System V, 1 Win64
            int feat;           // XF_ features the code may use
            bool must_tail;     // set by the code generator before a tail call
            int lab, nunsup, zmax;
            byte** rtab;
            byte* cx_sym;
            i64 cx_off;
            Buf ab, mb, cdata;
            GF* sf;             // SSA code generator state of the function being compiled
            int gfn, gwhy;
            byte* gwhys;
            PtrVec* ulog;       // one text per unsupported construct: where and why
            byte* cur_item;     // the global whose initializer is being written
            int sck;
            int sel_off;
            bool bf_ok;         // the caller of a_foff handles members that are not byte addressable
            int bf_bits;        // width of the number s_bf_be returned
            int bf_sh, bf_w;    // set by the address computation: bit shift and width of a bit packed member, 0 width when none
            i64 scv;
            byte* scs;
            IRBlock** sbp;
            int sbn;
            byte* arp;          // arena of the machine instructions of one function
            int aru;
            PtrVec* arch;
            GB* scb;            // block being selected
            IRValue* ec_v;      // last index value sign extended in this block
            int ec_r;           // register holding it extended, valid while ec_v is set
            int* ubuf;          // registers read by the instruction last scanned
            int* dbuf;          // registers written by the instruction last scanned
            int nub, ndb, bcap;
            bool escok;         // stack object escape marks are current
            int* rgm;           // stamps of the blocks visited by the clobber scan
            int* rgk;           // work list of the clobber scan
            int rgn;            // capacity of rgm and rgk
            int rgs;            // current stamp
            SI* bm_s1;          // the instructions a BMI match folds into its user
            SI* bm_s2;
            IRValue* bm_a;      // operands of the match
            IRValue* bm_b;
            int bm_n;           // rotate count
            IRValue* eqx;       // value and constant of the last compare chain test
            u64 eqv;
            MI* rprev;          // the instruction in front of a loop test repeated by e_rotate
            bool efr;           // the block being written runs with the frame set up
            SI* nxti;           // instruction after the one being selected in its block
            bool hasal;         // the function has stack allocations
            bool skipn;         // the instruction after the one being selected is already done
            int* ea;
            int* eb;
            int ne, ecap;
            int* adjo;
            int* adj;
            int* ord;
            int nord;
            int* spl;
            int nspl;
            byte** rn;
            int sfs;            // operands of the float compare were swapped
            int splo;           // stack offset of the argument last placed
            Buf jb;             // code and tables of sparse switches of the function being written
            PtrVec* jts;        // jump tables of the function being written
            Buf eo;             // text of the function being written

            __init(byte* name) -> this
            {
                this.mod_name = ts_dup(name);
                this.feat = x64_detect();
                this.triple = (byte*)0;
                this.layout = (byte*)0;
                this.nul = (IRType*)0;
                this.types = pv_new();
                this.values = pv_new();
                this.vp = (byte*)0;
                this.vleft = 0;
                this.strs = pv_new();
                this.blobs = pv_new();
                this.named = pv_new();
                this.globals = pv_new();
                this.funcs = pv_new();
                this.gnames = nm_new();
                this.fmap = nm_new();
                this.gmap = nm_new();
                this.tb.__init();
                this.ab.__init();
                this.mb.__init();
                this.cdata.__init();
                this.a_handled = false;
                this.lab = 0;
                this.nunsup = 0;
                this.ulog = pv_new();
                this.cur_item = (byte*)0;
                this.zmax = 0;
                this.cf = (IRFunc*)0;
                this.cb = (IRBlock*)0;
                this.entry_b = (IRBlock*)0;
                this.ia = (IRValue**)fmalloc((u64)8 * (u64)((sizeof(IRValue*) + 7) / 8));
                this.nul = this.new_type(LK.VOID);
                this.nul.elem = this.nul;
                this.must_tail = false;
                this.sf = (GF*)0;
                this.gfn = 0;
                this.gwhy = 0;
                this.sbp = (IRBlock**)0;
                this.sbn = 0;
                this.arp = (byte*)0;
                this.aru = 0;
                this.arch = pv_new();
                this.scb = (GB*)0;
                this.rprev = (MI*)0;
                this.escok = false;
                this.rgm = (int*)0;
                this.rgk = (int*)0;
                this.rgn = 0;
                this.rgs = 0;
                this.bm_s1 = (SI*)0;
                this.bm_s2 = (SI*)0;
                this.bm_a = (IRValue*)0;
                this.bm_b = (IRValue*)0;
                this.bm_n = 0;
                this.eqx = (IRValue*)0;
                this.eqv = (u64)0;
                this.ubuf = this.s_iz(64);
                this.dbuf = this.s_iz(64);
                this.bcap = 64;
                this.nub = 0;
                this.ndb = 0;
                this.ea = (int*)0;
                this.eb = (int*)0;
                this.ne = 0;
                this.ecap = 0;
                this.adjo = (int*)0;
                this.adj = (int*)0;
                this.ord = (int*)0;
                this.nord = 0;
                this.spl = (int*)0;
                this.nspl = 0;
                this.rn = (byte**)0;
                this.sfs = 0;
                this.splo = 0;
                this.jts = pv_new();
                this.jb.__init();
                this.eo.__init();
                this.a_init();
                -> this;
            };

            __expr() -> X64Module* -> this;

            __exit() -> void
            {
                int i, j;
                IRFunc* f;
                IRBlock* bl;
                while (i < this.types.len)
                {
                    ffree((byte*)this.types.items[i]);
                    i++;
                };
                i = 0;
                while (i < this.strs.len)
                {
                    ffree((byte*)this.strs.items[i]);
                    i++;
                };
                i = 0;
                while (i < this.blobs.len)
                {
                    ffree((byte*)this.blobs.items[i]);
                    i++;
                };
                i = 0;
                while (i < this.funcs.len)
                {
                    f = (IRFunc*)this.funcs.items[i];
                    j = 0;
                    while (j < f.blocks.len)
                    {
                        bl = (IRBlock*)f.blocks.items[j];
                        pv_free(bl.lines);
                        ffree((byte*)bl);
                        j++;
                    };
                    pv_free(f.blocks);
                    pv_free(f.attrs);
                    nm_free(f.names);
                    ffree((byte*)f.args);
                    ffree((byte*)f);
                    i++;
                };
                i = 0;
                while (i < this.globals.len)
                {
                    ffree((byte*)this.globals.items[i]);
                    i++;
                };
                pv_free(this.types);
                pv_free(this.values);
                pv_free(this.strs);
                pv_free(this.blobs);
                pv_free(this.named);
                pv_free(this.globals);
                pv_free(this.funcs);
                nm_free(this.gnames);
                nm_free(this.fmap);
                nm_free(this.gmap);
                ffree(this.mod_name);
                switch (this.triple != (byte*)0)
                {
                    case (true) { ffree(this.triple); }
                    default {};
                };
                switch (this.layout != (byte*)0)
                {
                    case (true) { ffree(this.layout); }
                    default {};
                };
                this.tb.__exit();
                this.ab.__exit();
                this.mb.__exit();
                this.cdata.__exit();
                -> ffree((byte*)this.ia);
            };

            set_target(byte* triple, byte* layout) -> void
            {
                this.triple = ts_dup(triple);
                this.layout = ts_dup(layout);
                ->;
            };

            // Owned copy of s
            // Records an unsupported construct: the function or global it is in, and why
            a_note(byte* where, byte* why) -> void
            {
                Buf t;
                t.__init();
                if (where == (byte*)0) { where = g"<unnamed>\0"; };
                t.put_str(where);
                t.put_str(g": \0");
                t.put_str(why);
                t.put(0);
                pv_push(this.ulog, (void*)this.own(t.mem));
                t.__exit();
                ->;
            };

            own(byte* s) -> byte*
            {
                byte* r = ts_dup(s);
                pv_push(this.strs, (void*)r);
                -> r;
            };

            alloc_items(int n) -> IRType**
            {
                IRType** p = (IRType**)fmalloc((u64)(n + 1) * (u64)((sizeof(IRType*) + 7) / 8));
                pv_push(this.blobs, (void*)p);
                -> p;
            };

            new_type(int kind) -> IRType*
            {
                IRType* t = (IRType*)fmalloc((u64)((sizeof(IRType) + 7) / 8));
                t.kind = kind;
                t.width = 0;
                t.count = 0;
                t.elem = this.nul;
                t.items = (IRType**)0;
                t.nitems = 0;
                t.name = (byte*)0;
                t.vararg = false;
                t.defined = true;
                t.lbits = 0;
                t.loff = (int*)0;
                pv_push(this.types, (void*)t);
                -> t;
            };

            t_void() -> IRType* -> this.new_type(LK.VOID);
            t_float() -> IRType* -> this.new_type(LK.FLOAT);
            t_double() -> IRType* -> this.new_type(LK.DOUBLE);

            t_int(int width) -> IRType*
            {
                IRType* t = this.new_type(LK.INT);
                t.width = width;
                -> t;
            };

            t_ptr(IRType* elem) -> IRType*
            {
                IRType* t = this.new_type(LK.PTR);
                t.elem = elem;
                -> t;
            };

            t_array(IRType* elem, int count) -> IRType*
            {
                IRType* t = this.new_type(LK.ARRAY);
                t.elem = elem;
                t.count = count;
                -> t;
            };

            // Literal struct over the first n entries of items (copied)
            t_struct(IRType** items, int n) -> IRType*
            {
                int i;
                IRType* t = this.new_type(LK.STRUCT);
                t.items = this.alloc_items(n);
                while (i < n)
                {
                    t.items[i] = items[i];
                    i++;
                };
                t.nitems = n;
                -> t;
            };

            t_func(IRType* ret, IRType** params, int n, bool vararg) -> IRType*
            {
                int i;
                IRType* t = this.new_type(LK.FUNC);
                t.elem = ret;
                t.items = this.alloc_items(n);
                while (i < n)
                {
                    t.items[i] = params[i];
                    i++;
                };
                t.nitems = n;
                t.vararg = vararg;
                -> t;
            };

            // Identified struct, body set later with set_body. Returns the existing one
            // when the name is already in use.
            t_named(byte* name) -> IRType*
            {
                int i;
                IRType* t;
                while (i < this.named.len)
                {
                    t = (IRType*)this.named.items[i];
                    switch (cstr_eq(t.name, name))
                    {
                        case (true) { -> t; }
                        default
                        {
                            i++;
                        };
                    };
                };
                t = this.new_type(LK.ISTRUCT);
                t.name = this.own(name);
                t.defined = false;
                pv_push(this.named, (void*)t);
                -> t;
            };

            set_body(IRType* t, IRType** items, int n) -> void
            {
                int i;
                t.items = this.alloc_items(n);
                while (i < n)
                {
                    t.items[i] = items[i];
                    i++;
                };
                t.nitems = n;
                t.defined = true;
                ->;
            };

            type_str(IRType* t) -> byte*
            {
                this.tb.clear();
                lt_text(@this.tb, t);
                -> this.own(this.tb.mem);
            };

            // ----------------------------------------------------------
            // Values
            // ----------------------------------------------------------

            new_value(IRType* ty, byte* text) -> IRValue*
            {
                int vb = ((((int)sizeof(IRValue) + 7) / 8) * 2 + 15) / 16 * 16;
                // Values live until the module is released, so they are carved out of shared blocks
                // kept in blobs; one allocation then serves many values
                switch (this.vleft < vb)
                {
                    case (true) {
                        this.vp = (byte*)fmalloc((u64)4096);
                        pv_push(this.blobs, (void*)this.vp);
                        this.vleft = 4096;
                    }
                    default {};
                };
                IRValue* v = (IRValue*)this.vp;
                this.vp = this.vp + vb;
                this.vleft = this.vleft - vb;
                v.ty = ty;
                v.text = this.own(text);
                v.spec = (TypeSpec*)0;
                v.espec = (TypeSpec*)0;
                v.flags = 0;
                v.slot = 0;
                v.vr = 0;
                v.fo = 0;
                v.fwd = (IRValue*)0;
                v.nu = 0;
                v.di = (void*)0;
                v.db = 0;
                v.ui = (void*)0;
                v.kc = false;
                v.kv = (i64)0;
                v.cl = (void*)0;
                v.is_const = false;
                -> v;
            };

            c_int(IRType* ty, i64 val) -> IRValue*
            {
                IRValue* v;
                this.tb.clear();
                switch (ty.width)
                {
                    case (1)
                    {
                        switch (val != (i64)0)
                        {
                            case (true) { this.tb.put_str(g"true\0"); }
                            default { this.tb.put_str(g"false\0"); };
                        };
                    }
                    default { put_i64(@this.tb, val); };
                };
                v = this.new_value(ty, this.tb.mem);
                v.is_const = true;
                -> v;
            };

            // Unsigned 64 bit constant: a Python int above INT64_MAX prints as is
            c_u64(IRType* ty, u64 val) -> IRValue*
            {
                IRValue* v;
                this.tb.clear();
                put_u64(@this.tb, val);
                v = this.new_value(ty, this.tb.mem);
                v.is_const = true;
                -> v;
            };

            c_null(IRType* ty) -> IRValue*
            {
                IRValue* v;
                switch (ty.kind)
                {
                    case (LK.PTR) { v = this.new_value(ty, g"null\0"); }
                    case (LK.INT)
                    {
                        v = this.c_int(ty, 0);
                        // llvmlite formats Constant(i1, 0) as 0, only a Python bool prints false
                        switch (ty.width == 1)
                        {
                            case (true) { v.text = g"0\0"; }
                            default {};
                        };
                        -> v;
                    }
                    default
                    {
                        switch (ty.kind == LK.FLOAT | ty.kind == LK.DOUBLE)
                        {
                            case (true) {
                            v = this.c_fp(ty, 0.0);
                            -> v;
                        }
                            default { v = this.new_value(ty, g"zeroinitializer\0"); };
                        };
                    };
                };
                v.is_const = true;
                -> v;
            };

            c_undef(IRType* ty) -> IRValue*
            {
                IRValue* v = this.new_value(ty, g"undef\0");
                v.is_const = true;
                -> v;
            };

            // Floating point constant. llvmlite prints the double bit pattern for both
            // float and double.
            c_fp(IRType* ty, double d) -> IRValue*
            {
                IRValue* v;
                float f;
                double dd = d;
                u64 bits;
                u64* bp;
                switch (ty.kind == LK.FLOAT)
                {
                    case (true) {
                    f = (float)d;
                    dd = (double)f;
                }
                    default {};
                };
                bp = (u64*)@dd;
                bits = *bp;
                this.tb.clear();
                put_hex64(@this.tb, bits);
                v = this.new_value(ty, this.tb.mem);
                v.is_const = true;
                -> v;
            };

            // Constant array literal [ty v, ty v, ...] as llvmlite prints it
            c_array(IRType* ty, IRValue** elems, int n) -> IRValue*
            {
                IRValue* v;
                int i;
                this.tb.clear();
                this.tb.put(91);
                while (i < n)
                {
                    switch (i > 0) { case (true) { this.tb.put_str(g", \0"); } default {}; };
                    lt_text(@this.tb, elems[i].ty);
                    this.tb.put(32);
                    this.tb.put_str(elems[i].text);
                    i++;
                };
                this.tb.put(93);
                v = this.new_value(ty, this.tb.mem);
                v.is_const = true;
                -> v;
            };

            // c"..." constant over n bytes
            c_bytes(IRType* ty, byte* bytes_in, int n) -> IRValue*
            {
                IRValue* v;
                int i, c;
                this.tb.clear();
                this.tb.put_str(g"c\"\0");
                while (i < n)
                {
                    c = (int)bytes_in[i];
                    switch (c < 32 | c > 126 | c == 34 | c == 92)
                    {
                        case (true) {
                        this.tb.put(92);
                        this.tb.put(hexdig(c / 16));
                        this.tb.put(hexdig(c % 16));
                    }
                        default { this.tb.put(c); };
                    };
                    i++;
                };
                this.tb.put(34);
                v = this.new_value(ty, this.tb.mem);
                v.is_const = true;
                -> v;
            };

            // Operand text "type value"
            unique_global(byte* name) -> byte*
            {
                int n = 1;
                byte* cand;
                switch (!nm_has(this.gnames, name))
                {
                    case (true) { -> this.own(name); }
                    default
                    {
                        while (true)
                        {
                            this.tb.clear();
                            this.tb.put_str(name);
                            this.tb.put(46);
                            this.tb.put_int(n);
                            cand = this.tb.mem;
                            switch (!nm_has(this.gnames, cand))
                            {
                                case (true) { -> this.own(cand); }
                                default
                                {
                                    n++;
                                };
                            };
                        };
                        -> this.own(name);
                    };
                };
            };

            // Global variable of type ty. init is the initializer operand text or null.
            add_global(IRType* ty, byte* name, byte* init) -> IRGlobal*
            {
                IRGlobal* g = (IRGlobal*)fmalloc((u64)((sizeof(IRGlobal) + 7) / 8));
                g.name = this.unique_global(name);
                nm_put(this.gnames, g.name, (void*)g);
                nm_put(this.gmap, g.name, (void*)g);
                g.ty = ty;
                g.init = (byte*)0;
                switch (init != (byte*)0)
                {
                    case (true) { g.init = this.own(init); }
                    default {};
                };
                g.linkage = (byte*)0;
                g.constant = false;
                this.tb.clear();
                this.tb.put(64);
                put_quoted(@this.tb, g.name);
                g.self = this.new_value(this.t_ptr(ty), this.tb.mem);
                g.self.flags = VF_GLOBAL;
                pv_push(this.globals, (void*)g);
                -> g;
            };

            find_global(byte* name) -> IRGlobal* -> (IRGlobal*)nm_get(this.gmap, name);

            // Function with the given type. A function becomes a declaration until a
            // block is appended to it.
            add_function(IRType* ftype, byte* name) -> IRFunc*
            {
                int i;
                IRFunc* f = (IRFunc*)fmalloc((u64)(((sizeof(IRFunc) + 7) / 8) * 2));
                f.name = this.unique_global(name);
                nm_put(this.gnames, f.name, (void*)f);
                nm_put(this.fmap, f.name, (void*)f);
                f.ftype = ftype;
                f.nargs = ftype.nitems;
                f.args = (IRValue**)fmalloc((u64)(f.nargs + 1) * (u64)((sizeof(IRValue*) + 7) / 8));
                f.blocks = pv_new();
                f.attrs = pv_new();
                f.names = nm_new();
                f.counter = 0;
                f.cconv = (byte*)0;
                f.linkage = (byte*)0;
                f.is_decl = true;
                f.sall = (PtrVec*)0;
                f.sarr = (PtrVec*)0;
                f.sp = (byte*)0;
                f.sleft = 0;
                f.ap = (byte*)0;
                f.aleft = 0;
                f.frame = 0;
                f.sret_slot = 0;
                f.cs_mask = 0;
                f.cs = (int*)0;
                while (i < f.nargs)
                {
                    f.counter = f.counter + 1;
                    this.tb.clear();
                    this.tb.put(37);
                    this.tb.put_str(f"\".{f.counter}\0");
                    this.tb.put(34);
                    f.args[i] = this.new_value(ftype.items[i], this.tb.mem);
                    i++;
                };
                this.tb.clear();
                this.tb.put(64);
                put_quoted(@this.tb, f.name);
                f.counter = f.counter + 1;
                f.self = this.new_value(this.t_ptr(ftype), this.tb.mem);
                pv_push(this.funcs, (void*)f);
                -> f;
            };

            find_function(byte* name) -> IRFunc* -> (IRFunc*)nm_get(this.fmap, name);

            // Names parameter i (llvmlite Argument.name = ...)
            name_arg(IRFunc* f, int i, byte* name) -> void
            {
                this.tb.clear();
                this.tb.put(37);
                put_quoted(@this.tb, name);
                f.args[i].text = this.own(this.tb.mem);
                -> nm_put(f.names, name, (void*)f);
            };

            // Gives parameter i a new name, kept unique inside f
            rename_arg(IRFunc* f, int i, byte* name) -> void
            {
                byte* nm = this.fresh_name(f, name);
                f.args[i].text = this.result_text(nm);
                ->;
            };

            // A name unique inside f: base when free, else base.N
            fresh_name(IRFunc* f, byte* base) -> byte*
            {
                int n = 1;
                byte* cand;
                switch (base == (byte*)0)
                {
                    case (true) {
                    f.counter = f.counter + 1;
                    this.tb.clear();
                    this.tb.put(46);
                    this.tb.put_int(f.counter);
                    -> this.own(this.tb.mem);
                }
                    default
                    {
                        switch (base[0] == 0)
                        {
                            case (true) {
                            f.counter = f.counter + 1;
                            this.tb.clear();
                            this.tb.put(46);
                            this.tb.put_int(f.counter);
                            -> this.own(this.tb.mem);
                        }
                            default
                            {
                                switch (!nm_has(f.names, base))
                                {
                                    case (true) {
                                    nm_put(f.names, base, (void*)f);
                                    -> this.own(base);
                                }
                                    default
                                    {
                                        while (true)
                                        {
                                            this.tb.clear();
                                            this.tb.put_str(base);
                                            this.tb.put(46);
                                            this.tb.put_int(n);
                                            cand = this.tb.mem;
                                            switch (!nm_has(f.names, cand))
                                            {
                                                case (true) {
                                                nm_put(f.names, cand, (void*)f);
                                                -> this.own(cand);
                                            }
                                                default
                                                {
                                                    n++;
                                                };
                                            };
                                        };
                                        -> this.own(base);
                                    };
                                };
                            };
                        };
                    };
                };
            };

            append_block(IRFunc* f, byte* name) -> IRBlock*
            {
                IRBlock* bl = (IRBlock*)fmalloc((u64)(((sizeof(IRBlock) + 7) / 8) * 2));
                bl.name = this.fresh_name(f, name);
                bl.lines = pv_new();
                bl.terminated = false;
                bl.term_at = 0;
                bl.id = 0;
                bl.insts = (PtrVec*)0;
                bl.popsi = (void*)0;
                bl.gi = 0;
                // the label counter holds the last number handed out, like at every other place that numbers labels
                this.lab++;
                bl.id = this.lab;
                pv_push(f.blocks, (void*)bl);
                f.is_decl = false;
                -> bl;
            };

            // ----------------------------------------------------------
            // Instruction builder
            // ----------------------------------------------------------

            position(IRFunc* f, IRBlock* b) -> void
            {
                this.cf = f;
                this.cb = b;
                ->;
            };

            set_entry(IRBlock* b) -> void
            {
                this.entry_b = b;
                ->;
            };

            is_terminated() -> bool
            {
                switch (this.cb == (IRBlock*)0)
                {
                    case (true) { -> true; }
                    default
                    {
                        -> this.cb.terminated;
                    };
                };
            };

            const_val(IRValue* v) -> i64
            {
                int i;
                bool neg = false;
                i64 r;
                switch (v.text[0] == 45)
                {
                    case (true) { neg = true; i = 1; }
                    default {};
                };
                while (v.text[i] >= 48 & v.text[i] <= 57)
                {
                    r = r * (i64)10 + (i64)((int)v.text[i] - 48);
                    i++;
                };
                switch (neg)
                {
                    case (true) { -> (i64)0 - r; }
                    default
                    {
                        -> r;
                    };
                };
            };

            // Operand text "%name" for a fresh result
            result_text(byte* name) -> byte*
            {
                this.tb.clear();
                this.tb.put(37);
                put_quoted(@this.tb, name);
                -> this.own(this.tb.mem);
            };

            // Ends the instruction held in ib. A typed result gets a name (hint, or the
            // next .N); a void one still takes the next .N.
            binop(byte* op, IRValue* a, IRValue* b, byte* hint) -> IRValue*
            {
                bool dead = this.s_dead();
                IRValue* r = this.n_val(a.ty);
                if (!dead) { this.s_r_bin(op, a, b, r); };
                -> r;
            };

            cmp(byte* kind, byte* pred, IRValue* a, IRValue* b, byte* hint) -> IRValue*
            {
                bool dead = this.s_dead();
                IRValue* r = this.n_val(this.t_int(1));
                if (!dead) { this.s_r_cmp(kind, pred, a, b, r); };
                -> r;
            };

            icmp(byte* pred, IRValue* a, IRValue* b, byte* hint) -> IRValue* -> this.cmp(g"icmp\0", pred, a, b, hint);

            fcmp(byte* pred, IRValue* a, IRValue* b, byte* hint) -> IRValue* -> this.cmp(g"fcmp\0", pred, a, b, hint);

            cast(byte* op, IRValue* v, IRType* to, byte* hint) -> IRValue*
            {
                bool dead;
                IRValue* r;
                switch (lt_eq(v.ty, to))
                {
                    case (true) { -> v; }
                    default
                    {
                        dead = this.s_dead();
                        r = this.n_val(to);
                        if (!dead) { this.s_r_cast(op, v, to, r); };
                        -> r;
                    };
                };
            };

            alloca(IRType* ty, byte* name) -> IRValue*
            {
                bool dead = this.s_dead();
                IRValue* r = this.n_alloca(ty);
                if (!dead) { this.s_r_alloca(ty, r); };
                -> r;
            };

            alloca_here(IRType* ty, byte* name) -> IRValue*
            {
                bool dead = this.s_dead();
                IRValue* r = this.n_alloca(ty);
                if (!dead) { this.s_r_alloca(ty, r); };
                -> r;
            };

            alloca_count(IRType* ty, IRValue* count, byte* name) -> IRValue*
            {
                bool dead = this.s_dead();
                IRValue* r = this.n_val(this.t_ptr(ty));
                if (!dead) { this.s_r_allocan(ty, count, r); };
                -> r;
            };

            load(IRValue* p, byte* hint) -> IRValue*
            {
                bool dead = this.s_dead();
                IRValue* r = this.n_val(p.ty.elem);
                if (!dead) { this.s_r_load(p, r); };
                -> r;
            };

            store_ex(IRValue* v, IRValue* p, bool vol) -> void
            {
                bool dead = this.s_dead();
                if (!dead) { this.s_r_store(v, p, vol); };
                ->;
            };

            store(IRValue* v, IRValue* p) -> void -> this.store_ex(v, p, false);

            // Type reached by indexing t with idx (struct needs a constant)
            index_type(IRType* t, IRValue* idx) -> IRType*
            {
                switch (t.kind == LK.ARRAY)
                {
                    case (true) { -> t.elem; }
                    default
                    {
                        switch (t.kind == LK.PTR)
                        {
                            case (true) { -> t.elem; }
                            default
                            {
                                -> t.items[(int)this.const_val(idx)];
                            };
                        };
                    };
                };
            };

            struct_items(IRType* t) -> IRType** -> t.items;

            gep(IRValue* p, IRValue** idx, int n, bool inbounds, byte* hint) -> IRValue*
            {
                bool dead = this.s_dead();
                IRValue* r = this.n_gep(p, idx, n);
                if (!dead) { this.s_r_gep(p, idx, n, r); };
                -> r;
            };

            struct_body_item(IRType* t, int i) -> IRType* -> t.items[i];

            // gep p, 0, i  (struct field address)
            gep_field(IRValue* p, int i, bool inbounds, byte* hint) -> IRValue*
            {
                this.ia[0] = this.c_int(this.t_int(32), 0);
                this.ia[1] = this.c_int(this.t_int(32), (i64)i);
                -> this.gep(p, this.ia, 2, inbounds, hint);
            };

            // gep p, i  (pointer arithmetic)
            gep_ptr(IRValue* p, IRValue* i, bool inbounds, byte* hint) -> IRValue*
            {
                this.ia[0] = i;
                -> this.gep(p, this.ia, 1, inbounds, hint);
            };

            call_ex(IRValue* callee, IRValue** args, int n, byte* hint, byte* cconv, bool tail) -> IRValue*
            {
                bool dead = this.s_dead();
                IRValue* r = this.n_call(callee);
                if (!dead) { this.s_r_call(callee, args, n, r, tail); };
                -> r;
            };

            call(IRValue* callee, IRValue** args, int n, byte* hint) -> IRValue* -> this.call_ex(callee, args, n, hint, (byte*)0, false);

            phi(IRType* ty, IRValue** vals, IRBlock** blocks, int n, byte* hint) -> IRValue*
            {
                bool dead = this.s_dead();
                IRValue* r = this.n_val(ty);
                if (!dead) { this.s_r_phi(ty, vals, blocks, n, r); };
                -> r;
            };

            va_arg(IRValue* list, IRType* ty, byte* hint) -> IRValue*
            {
                bool dead = this.s_dead();
                IRValue* r = this.n_val(ty);
                if (!dead) { this.s_r_vaarg(list, ty, r); };
                -> r;
            };

            select(IRValue* c, IRValue* a, IRValue* b, byte* hint) -> IRValue*
            {
                bool dead = this.s_dead();
                IRValue* r = this.n_val(a.ty);
                if (!dead) { this.s_r_select(c, a, b, r); };
                -> r;
            };

            extractvalue(IRValue* agg, int i, byte* hint) -> IRValue*
            {
                bool dead = this.s_dead();
                IRValue* r = this.n_extract(agg, i);
                if (!dead) { this.s_r_extract(agg, i, r); };
                -> r;
            };

            insertvalue(IRValue* agg, IRValue* v, int i, byte* hint) -> IRValue*
            {
                bool dead = this.s_dead();
                IRValue* r = this.n_val(agg.ty);
                if (!dead) { this.s_r_insert(agg, v, i, r); };
                -> r;
            };

            br(IRBlock* target) -> void
            {
                bool dead = this.s_dead();
                this.cb.terminated = true;
                if (!dead) { this.s_r_br(target); };
                ->;
            };

            cbr(IRValue* c, IRBlock* t, IRBlock* f) -> void
            {
                bool dead = this.s_dead();
                this.cb.terminated = true;
                if (!dead) { this.s_r_cbr(c, t, f); };
                ->;
            };

            ret(IRValue* v) -> void
            {
                bool dead = this.s_dead();
                this.cb.terminated = true;
                if (!dead) { this.s_r_ret(v); };
                ->;
            };

            ret_void() -> void
            {
                bool dead = this.s_dead();
                this.cb.terminated = true;
                if (!dead) { this.s_r_retv(); };
                ->;
            };

            unreachable() -> void
            {
                bool dead = this.s_dead();
                this.cb.terminated = true;
                if (!dead) { this.s_r_unreach(); };
                ->;
            };

            switch_to(IRValue* v, IRBlock* dflt, IRValue** vals, IRBlock** blocks, int n) -> void
            {
                bool dead = this.s_dead();
                this.cb.terminated = true;
                if (!dead) { this.s_r_switch(v, dflt, vals, blocks, n); };
                ->;
            };

            a_init() -> void
            {
                int r, k;
                byte* base;
                this.rtab = (byte**)fmalloc((u64)(14 * 4 * 8));
                while (r < 14)
                {
                    k = 0;
                    while (k < 4)
                    {
                        this.tb.clear();
                        this.tb.put(37);
                        switch (r)
                        {
                            case (0) { this.a_rn(k, g"ax\0", g"al\0"); }
                            case (1) { this.a_rn(k, g"cx\0", g"cl\0"); }
                            case (2) { this.a_rn(k, g"dx\0", g"dl\0"); }
                            case (3) { this.a_rn(k, g"si\0", g"sil\0"); }
                            case (4) { this.a_rn(k, g"di\0", g"dil\0"); }
                            case (9) { this.a_rn(k, g"bx\0", g"bl\0"); }
                            default
                            {
                                this.tb.put(114);
                                switch (r)
                                {
                                    case (5) { this.tb.put_int(8); }
                                    case (6) { this.tb.put_int(9); }
                                    case (7) { this.tb.put_int(10); }
                                    case (8) { this.tb.put_int(11); }
                                    default { this.tb.put_int(r + 2); };
                                };
                                switch (k)
                                {
                                    case (1) { this.tb.put(100); }
                                    case (2) { this.tb.put(119); }
                                    case (3) { this.tb.put(98); }
                                    default {};
                                };
                            };
                        };
                        this.rtab[r * 4 + k] = this.own(this.tb.mem);
                        k++;
                    };
                    r++;
                };
                ->;
            };

            // Appends the name of a legacy register for size index k (0 q, 1 d, 2 w, 3 b)
            a_rn(int k, byte* w, byte* b) -> void
            {
                switch (k)
                {
                    case (0) { this.tb.put(114); this.tb.put_str(w); }
                    case (1) { this.tb.put(101); this.tb.put_str(w); }
                    case (2) { this.tb.put_str(w); }
                    default { this.tb.put_str(b); };
                };
                ->;
            };

            a_seq(byte* a, byte* b) -> bool
            {
                int i;
                while (a[i] != 0 & b[i] != 0)
                {
                    if (a[i] != b[i]) { -> false; };
                    i++;
                };
                -> a[i] == b[i];
            };

            // True when s starts with p
            a_pre(byte* s, byte* p) -> bool
            {
                int i;
                while (p[i] != 0)
                {
                    if (s[i] != p[i]) { -> false; };
                    i++;
                };
                -> true;
            };

            // ----------------------------------------------------------
            // Type layout
            // ----------------------------------------------------------

            a_size(IRType* t) -> int
            {
                int k = t.kind;
                int i, off, a, al;
                if (k == LK.INT)
                {
                    if (t.width <= 8) { -> 1; };
                    if (t.width <= 16) { -> 2; };
                    if (t.width <= 32) { -> 4; };
                    if (t.width <= 64) { -> 8; };
                    -> 16;
                };
                if (k == LK.PTR | k == LK.DOUBLE | k == LK.FUNC) { -> 8; };
                if (k == LK.FLOAT) { -> 4; };
                if (k == LK.ARRAY) { -> t.count * this.a_size(t.elem); };
                if (k == LK.STRUCT | k == LK.ISTRUCT)
                {
                    if (t.lbits > 0 & t.loff != (int*)0) { -> (t.lbits + 7) / 8; };
                    al = 1;
                    while (i < t.nitems)
                    {
                        a = this.a_align(t.items[i]);
                        if (a > al) { al = a; };
                        off = (off + a - 1) / a * a;
                        off = off + this.a_size(t.items[i]);
                        i++;
                    };
                    -> (off + al - 1) / al * al;
                };
                -> 0;
            };

            a_align(IRType* t) -> int
            {
                int k = t.kind;
                int i, a, al;
                if (k == LK.ARRAY) { -> this.a_align(t.elem); };
                if (k == LK.STRUCT | k == LK.ISTRUCT)
                {
                    al = 1;
                    while (i < t.nitems)
                    {
                        a = this.a_align(t.items[i]);
                        if (a > al) { al = a; };
                        i++;
                    };
                    -> al;
                };
                a = this.a_size(t);
                if (a < 1) { a = 1; };
                if (a > 16) { a = 16; };
                -> a;
            };

            // True when a member of this type is accessed as a bit field: its width is not a whole machine word
            a_bitw(IRType* t) -> bool
            {
                if (t.kind != LK.INT) { -> false; };
                if (t.width == 8 | t.width == 16 | t.width == 32 | t.width == 64) { -> false; };
                -> true;
            };

            // Byte offset of member i of a struct
            a_foff(IRType* t, int n) -> int
            {
                int i, a, off;
                if (t.lbits > 0 & t.loff != (int*)0)
                {
                    if (!this.bf_ok)
                    {
                        if (t.loff[n] % 8 != 0 | this.a_bitw(t.items[n]))
                        {
                            this.nunsup++;
                            this.a_note(this.cur_item, g"bit packed member used as a whole value\0");
                        };
                    };
                    -> t.loff[n] / 8;
                };
                while (i < n)
                {
                    a = this.a_align(t.items[i]);
                    off = (off + a - 1) / a * a;
                    off = off + this.a_size(t.items[i]);
                    i++;
                };
                a = this.a_align(t.items[n]);
                -> (off + a - 1) / a * a;
            };

            // ----------------------------------------------------------
            // Frame slots and values
            // ----------------------------------------------------------

            // Symbol name of an operand text @"name"
            a_sym(byte* t) -> byte*
            {
                int i = 1;
                int c;
                bool plain = true;
                this.mb.clear();
                if (t[1] == '"') { i = 2; };
                while (t[i] != 0)
                {
                    c = (int)t[i];
                    if (c == 34 & t[1] == '"') { break; };
                    this.mb.put(c);
                    if (!((c >= 48 & c <= 57) | (c >= 65 & c <= 90) | (c >= 97 & c <= 122) | c == 95 | c == 46 | c == 36)) { plain = false; };
                    i++;
                };
                if (plain) { -> this.own(this.mb.mem); };
                this.tb.clear();
                this.tb.put(34);
                this.tb.put_str(this.mb.mem);
                this.tb.put(34);
                -> this.own(this.tb.mem);
            };

            a_isnum(byte* t) -> bool
            {
                int c = (int)t[0];
                -> (c >= 48 & c <= 57) | (c == 45 & t[1] >= 48 & t[1] <= 57);
            };

            // Integer text to its 64 bit pattern. Handles the hex float patterns too.
            a_num(byte* t) -> u64
            {
                int i;
                bool neg = false;
                u64 r;
                int c;
                if (t[0] == '0' & (t[1] == 'x' | t[1] == 'X'))
                {
                    i = 2;
                    while (t[i] != 0)
                    {
                        c = (int)t[i];
                        if (c >= 48 & c <= 57) { r = (r << (u64)4) `| (u64)(c - 48); }
                        else
                        {
                            if (c >= 97 & c <= 102) { r = (r << (u64)4) `| (u64)(c - 87); }
                            else
                            {
                                if (c >= 65 & c <= 70) { r = (r << (u64)4) `| (u64)(c - 55); }
                                else { break; };
                            };
                        };
                        i++;
                    };
                    -> r;
                };
                if (t[0] == '-') { neg = true; i = 1; };
                while (t[i] >= 48 & t[i] <= 57)
                {
                    r = r * (u64)10 + (u64)((int)t[i] - 48);
                    i++;
                };
                if (neg) { -> (u64)0 - r; };
                -> r;
            };

            // Bits of a float constant as 32 bit float (the text holds the double pattern)
            a_f32bits(u64 dbits) -> u64
            {
                double d;
                float f;
                u64* dp = (u64*)@d;
                u32* fp = (u32*)@f;
                *dp = dbits;
                f = (float)d;
                -> (u64)*fp;
            };

            // Mask of the low w bits
            a_mask(u64 v, int w) -> u64
            {
                if (w >= 64) { -> v; };
                -> v `& (((u64)1 << (u64)w) - (u64)1);
            };

            // Skips one type in constant text, leaving p on the first character after it
            a_skiptype(byte* s, int* p) -> void
            {
                int d;
                int c;
                while (s[*p] != 0)
                {
                    c = (int)s[*p];
                    if (c == 91 | c == 123 | c == 40) { d++; };
                    if (c == 93 | c == 125 | c == 41)
                    {
                        if (d == 0) { break; };
                        d--;
                    };
                    if (d == 0 & (c == 32 | c == 44)) { break; };
                    *p = *p + 1;
                };
                ->;
            };

            // Parses a constant address expression. sym is the symbol (null for a plain number),
            // off the byte offset.
            a_cx(byte* s, int* p) -> bool
            {
                int c, k, n;
                int q;
                i64 idx;
                IRGlobal* g;
                IRType* t;
                byte* nm;
                bool first = true;
                while (s[*p] == ' ') { *p = *p + 1; };
                c = (int)s[*p];
                if (c == 64)
                {
                    q = *p;
                    this.mb.clear();
                    nm = (byte*)0;
                    if (s[q + 1] == '"')
                    {
                        q = q + 2;
                        while (s[q] != 34 & s[q] != 0) { this.mb.put((int)s[q]); q++; };
                        q++;
                    }
                    else
                    {
                        q++;
                        while (s[q] != 0 & s[q] != ',' & s[q] != ')' & s[q] != ' ') { this.mb.put((int)s[q]); q++; };
                    };
                    this.tb.clear();
                    this.tb.put(64);
                    this.tb.put(34);
                    this.tb.put_str(this.mb.mem);
                    this.tb.put(34);
                    this.cx_sym = this.a_sym(this.tb.mem);
                    this.cx_off = 0;
                    *p = q;
                    -> true;
                };
                if (this.a_pre(s + *p, g"null\0")) { this.cx_sym = (byte*)0; this.cx_off = 0; *p = *p + 4; -> true; };
                if (this.a_isnum(s + *p))
                {
                    this.cx_sym = (byte*)0;
                    this.cx_off = (i64)this.a_num(s + *p);
                    if (s[*p] == '-') { *p = *p + 1; };
                    while (s[*p] >= 48 & s[*p] <= 57) { *p = *p + 1; };
                    -> true;
                };
                if (this.a_pre(s + *p, g"bitcast\0") | this.a_pre(s + *p, g"inttoptr\0") | this.a_pre(s + *p, g"ptrtoint\0"))
                {
                    while (s[*p] != '(' & s[*p] != 0) { *p = *p + 1; };
                    *p = *p + 1;
                    this.a_skiptype(s, p);
                    while (s[*p] == ' ') { *p = *p + 1; };
                    if (!this.a_cx(s, p)) { -> false; };
                    while (s[*p] != ')' & s[*p] != 0) { *p = *p + 1; };
                    *p = *p + 1;
                    -> true;
                };
                if (this.a_pre(s + *p, g"getelementptr\0"))
                {
                    *p = *p + 13;
                    while (s[*p] == ' ') { *p = *p + 1; };
                    if (this.a_pre(s + *p, g"inbounds\0")) { *p = *p + 8; };
                    while (s[*p] == ' ') { *p = *p + 1; };
                    *p = *p + 1;
                    this.a_skiptype(s, p);
                    while (s[*p] == ',' | s[*p] == ' ') { *p = *p + 1; };
                    this.a_skiptype(s, p);
                    while (s[*p] == ' ') { *p = *p + 1; };
                    if (!this.a_cx(s, p)) { -> false; };
                    g = (IRGlobal*)0;
                    if (this.cx_sym != (byte*)0)
                    {
                        this.tb.clear();
                        this.tb.put_str(this.cx_sym);
                        g = this.find_global(this.tb.mem);
                        if (g == (IRGlobal*)0 & this.cx_sym[0] == '"')
                        {
                            this.tb.clear();
                            k = 1;
                            while (this.cx_sym[k] != 34 & this.cx_sym[k] != 0) { this.tb.put((int)this.cx_sym[k]); k++; };
                            g = this.find_global(this.tb.mem);
                        };
                    };
                    t = this.nul;
                    if (g != (IRGlobal*)0) { t = g.ty; };
                    first = true;
                    while (s[*p] == ',')
                    {
                        *p = *p + 1;
                        while (s[*p] == ' ') { *p = *p + 1; };
                        this.a_skiptype(s, p);
                        while (s[*p] == ' ') { *p = *p + 1; };
                        idx = (i64)this.a_num(s + *p);
                        if (s[*p] == '-') { *p = *p + 1; };
                        while (s[*p] >= 48 & s[*p] <= 57) { *p = *p + 1; };
                        if (first)
                        {
                            this.cx_off = this.cx_off + idx * (i64)this.a_size(t);
                            first = false;
                        }
                        else
                        {
                            if (t.kind == LK.ARRAY)
                            {
                                this.cx_off = this.cx_off + idx * (i64)this.a_size(t.elem);
                                t = t.elem;
                            }
                            else
                            {
                                if (t.kind == LK.STRUCT | t.kind == LK.ISTRUCT)
                                {
                                    this.cx_off = this.cx_off + (i64)this.a_foff(t, (int)idx);
                                    t = t.items[(int)idx];
                                };
                            };
                        };
                    };
                    while (s[*p] != ')' & s[*p] != 0) { *p = *p + 1; };
                    *p = *p + 1;
                    -> true;
                };
                -> false;
            };

            // Directive that starts the read-only data section (ELF .rodata, COFF .rdata)
            a_rodata() -> byte*
            {
                if (this.a_win()) { -> g"\t.section .rdata,\"dr\"\n\0"; };
                -> g"\t.section .rodata\n\0";
            };

            // Label of a read-only copy of an aggregate constant
            a_const_agg(IRValue* v) -> byte*
            {
                int n = this.lab;
                int p;
                this.lab++;
                this.cdata.put_str(this.a_rodata());
                this.cdata.put_str(g"\t.p2align 4\n\0");
                this.cdata.put_str(f".LC{n}:\n\0");
                this.a_dat(v.ty, v.text, @p, @this.cdata);
                this.tb.clear();
                this.tb.put_str(g".LC\0");
                this.tb.put_int(n);
                -> this.own(this.tb.mem);
            };

            // ----------------------------------------------------------
            // Memory operands and copies
            // ----------------------------------------------------------

            // Label of a zero filled block of at least sz bytes
            a_zero_label(int sz) -> byte*
            {
                if (sz > this.zmax) { this.zmax = sz; };
                -> g".LZERO\0";
            };

            // ----------------------------------------------------------
            // Builder hooks
            // ----------------------------------------------------------

            // Win64 passes the first four arguments in rcx, rdx, r8, r9 and reserves 32 bytes of shadow space
            a_win() -> bool -> this.abi == 1;

            // Register index of a name such as rax, eax, ax, al, r10d, or -1
            a_regidx(byte* nm) -> int
            {
                int r, k;
                while (r < 14)
                {
                    k = 0;
                    while (k < 4)
                    {
                        if (this.a_seq(nm, this.rtab[r * 4 + k] + 1)) { -> r; };
                        k++;
                    };
                    r++;
                };
                -> -1;
            };

            // True when a tied input points at register reg
            a_tied(int* opreg, int* opkind, int no, int nop, int reg) -> bool
            {
                int i = no;
                while (i < nop)
                {
                    if (opkind[i] == 4 & opreg[i] == reg) { -> true; };
                    i++;
                };
                -> false;
            };

            // First register not in used, caller saved ones first
            a_pick(int used) -> int
            {
                int r;
                while (r < 14)
                {
                    if ((used `& (1 << r)) == 0) { -> r; };
                    r++;
                };
                -> 13;
            };

            a_emit_int(Buf* o, int sz, u64 bits) -> void
            {
                switch (sz)
                {
                    case (1) { o.put_str(g"\t.byte \0"); }
                    case (2) { o.put_str(g"\t.short \0"); }
                    case (4) { o.put_str(g"\t.long \0"); }
                    default { o.put_str(g"\t.quad \0"); };
                };
                put_u64(o, this.a_mask(bits, sz * 8));
                o.put(10);
                ->;
            };

            a_zero(Buf* o, int n) -> void
            {
                if (n > 0)
                {
                    o.put_str(g"\t.zero \0");
                    o.put_int(n);
                    o.put(10);
                };
                ->;
            };

            // Emits the initializer text s (at p, without its type) for type t
            a_dat(IRType* t, byte* s, int* p, Buf* o) -> void
            {
                int k = t.kind;
                int sz = this.a_size(t);
                int i, off, a, c, cnt, hi, lo;
                u64 bits;
                byte* sym;
                i64 so;
                while (s[*p] == ' ') { *p = *p + 1; };
                if (this.a_pre(s + *p, g"zeroinitializer\0"))
                {
                    *p = *p + 15;
                    this.a_zero(o, sz);
                    ->;
                };
                if (this.a_pre(s + *p, g"undef\0"))
                {
                    *p = *p + 5;
                    this.a_zero(o, sz);
                    ->;
                };
                if (k == LK.INT)
                {
                    if (this.a_pre(s + *p, g"true\0")) { bits = (u64)1; *p = *p + 4; }
                    else
                    {
                        if (this.a_pre(s + *p, g"false\0")) { bits = (u64)0; *p = *p + 5; }
                        else
                        {
                            bits = this.a_num(s + *p);
                            if (s[*p] == '-') { *p = *p + 1; };
                            while (s[*p] >= 48 & s[*p] <= 57) { *p = *p + 1; };
                        };
                    };
                    this.a_emit_int(o, sz, bits);
                    ->;
                };
                if (k == LK.FLOAT | k == LK.DOUBLE)
                {
                    bits = this.a_num(s + *p);
                    if (s[*p] == '0' & s[*p + 1] == 'x')
                    {
                        *p = *p + 2;
                        while ((s[*p] >= 48 & s[*p] <= 57) | (s[*p] >= 97 & s[*p] <= 102) | (s[*p] >= 65 & s[*p] <= 70)) { *p = *p + 1; };
                        if (k == LK.FLOAT) { bits = this.a_f32bits(bits); };
                    }
                    else
                    {
                        if (s[*p] == '-') { *p = *p + 1; };
                        while ((s[*p] >= 48 & s[*p] <= 57) | s[*p] == '.') { *p = *p + 1; };
                    };
                    this.a_emit_int(o, sz, bits);
                    ->;
                };
                if (k == LK.PTR | k == LK.FUNC)
                {
                    if (this.a_cx(s, p))
                    {
                        sym = this.cx_sym;
                        so = this.cx_off;
                        o.put_str(g"\t.quad \0");
                        if (sym != (byte*)0)
                        {
                            o.put_str(sym);
                            if (so != (i64)0) { o.put(43); put_i64(o, so); };
                        }
                        else { put_i64(o, so); };
                        o.put(10);
                    }
                    else
                    {
                        o.put_str(g"\t.quad 0 # unsupported pointer constant\n\0");
                        this.nunsup++;
                        this.a_note(this.cur_item, g"initializer: unsupported pointer constant\0");
                    };
                    ->;
                };
                if (k == LK.ARRAY)
                {
                    if (s[*p] == 'c' & s[*p + 1] == '"')
                    {
                        *p = *p + 2;
                        cnt = 0;
                        while (s[*p] != 34 & s[*p] != 0)
                        {
                            c = (int)s[*p];
                            if (c == 92)
                            {
                                hi = (int)s[*p + 1];
                                lo = (int)s[*p + 2];
                                if (hi >= 97) { hi = hi - 87; } else { if (hi >= 65) { hi = hi - 55; } else { hi = hi - 48; }; };
                                if (lo >= 97) { lo = lo - 87; } else { if (lo >= 65) { lo = lo - 55; } else { lo = lo - 48; }; };
                                c = hi * 16 + lo;
                                *p = *p + 3;
                            }
                            else { *p = *p + 1; };
                            if (cnt % 16 == 0) { o.put_str(g"\t.byte \0"); }
                            else { o.put_str(g", \0"); };
                            o.put_int(c);
                            cnt++;
                            if (cnt % 16 == 0) { o.put(10); };
                        };
                        if (cnt % 16 != 0) { o.put(10); };
                        *p = *p + 1;
                        ->;
                    };
                    *p = *p + 1;
                    i = 0;
                    while (i < t.count)
                    {
                        while (s[*p] == ' ') { *p = *p + 1; };
                        this.a_skiptype(s, p);
                        this.a_dat(t.elem, s, p, o);
                        while (s[*p] == ',' | s[*p] == ' ') { *p = *p + 1; };
                        i++;
                    };
                    if (s[*p] == ']') { *p = *p + 1; };
                    ->;
                };
                if (k == LK.STRUCT | k == LK.ISTRUCT)
                {
                    *p = *p + 1;
                    i = 0;
                    while (i < t.nitems)
                    {
                        a = this.a_foff(t, i);
                        this.a_zero(o, a - off);
                        off = a;
                        while (s[*p] == ' ') { *p = *p + 1; };
                        this.a_skiptype(s, p);
                        this.a_dat(t.items[i], s, p, o);
                        off = off + this.a_size(t.items[i]);
                        while (s[*p] == ',' | s[*p] == ' ') { *p = *p + 1; };
                        i++;
                    };
                    this.a_zero(o, sz - off);
                    if (s[*p] == '}') { *p = *p + 1; };
                    ->;
                };
                this.a_zero(o, sz);
                this.nunsup++;
                this.a_note(this.cur_item, g"initializer: constant form not supported\0");
                ->;
            };

            a_log2(int a) -> int
            {
                int n;
                while ((1 << n) < a) { n++; };
                -> n;
            };

            a_put_global(Buf* out, IRGlobal* g) -> void
            {
                int sz = this.a_size(g.ty);
                int al = this.a_align(g.ty);
                int p;
                byte* nm;
                bool zero;
                bool islocal = false;
                if (g.linkage != (byte*)0)
                {
                    if (this.a_seq(g.linkage, g"internal\0") | this.a_seq(g.linkage, g"private\0")) { islocal = true; };
                    if (this.a_seq(g.linkage, g"external\0") & g.init == (byte*)0) { ->; };
                };
                nm = this.a_sym(g.self.text);
                this.cur_item = nm;
                zero = g.init == (byte*)0;
                if (!zero)
                {
                    if (this.a_pre(g.init, g"zeroinitializer\0") | this.a_pre(g.init, g"null\0") | this.a_pre(g.init, g"false\0")) { zero = true; };
                    if (g.init[0] == '0' & g.init[1] == 0) { zero = true; };
                };
                if (g.constant & !zero) { out.put_str(this.a_rodata()); }
                else
                {
                    if (zero) { out.put_str(g"\t.bss\n\0"); }
                    else { out.put_str(g"\t.data\n\0"); };
                };
                if (al < 8 & sz >= 8) { al = 8; };
                if (sz >= 16 & al < 16) { al = 16; };
                out.put_str(g"\t.p2align \0");
                out.put_int(this.a_log2(al));
                out.put(10);
                if (!islocal)
                {
                    out.put_str(g"\t.globl \0");
                    out.put_str(nm);
                    out.put(10);
                };
                if (!this.a_win())
                {
                    out.put_str(g"\t.type \0");
                    out.put_str(nm);
                    out.put_str(g",@object\n\t.size \0");
                    out.put_str(nm);
                    out.put_str(g", \0");
                    out.put_int(sz);
                    out.put(10);
                };
                out.put_str(nm);
                out.put_str(g":\n\0");
                if (zero) { this.a_zero(out, sz); }
                else { this.a_dat(g.ty, g.init, @p, out); };
                ->;
            };

            // ----------------------------------------------------------
            // Functions and module
            // ----------------------------------------------------------

            // a naked function has no prologue, epilogue or spilled arguments
            a_naked(IRFunc* f) -> bool
            {
                int i = 0;
                while (i < f.attrs.len)
                {
                    if (this.a_seq((byte*)f.attrs.items[i], g"naked\0")) { -> true; };
                    i++;
                };
                -> false;
            };

            a_put_function(Buf* out, IRFunc* f) -> void
            {
                if (f.is_decl) { ->; };
                this.gfn = this.gfn + 1;
                if (this.s_func(f, out)) { ->; };
                // the function needs something the code generator cannot do: the output is not assembled
                this.nunsup++;
                if (this.gwhys != (byte*)0) { this.a_note(this.a_sym(f.self.text), this.gwhys); }
                else { this.a_note(this.a_sym(f.self.text), g"control flow\0"); };
                out.put_str(g"# unsupported: \0");
                out.put_str(this.a_sym(f.self.text));
                out.put_str(g": \0");
                if (this.gwhys != (byte*)0) { out.put_str(this.gwhys); } else { out.put_str(g"control flow\0"); };
                out.put(10);
                ->;
            };

            a_emit(Buf* out) -> void
            {
                int i;
                out.put_str(g"\t.file \0");
                put_quoted(out, this.mod_name);
                out.put(10);
                this.s_inline_all();
                while (i < this.funcs.len)
                {
                    this.a_put_function(out, (IRFunc*)this.funcs.items[i]);
                    i++;
                };
                i = 0;
                while (i < this.globals.len)
                {
                    this.a_put_global(out, (IRGlobal*)this.globals.items[i]);
                    i++;
                };
                out.put_str(this.cdata.mem);
                if (this.zmax > 0)
                {
                    out.put_str(this.a_rodata());
                    out.put_str(g"\t.p2align 4\n.LZERO:\n\0");
                    this.a_zero(out, this.zmax);
                };
                if (!this.a_win()) { out.put_str(g"\t.section .note.GNU-stack,\"\",@progbits\n\0"); };
                ->;
            };

            // ----------------------------------------------------------
            // Printing
            // ----------------------------------------------------------

            emit(Buf* out) -> void
            {
                this.a_emit(out);
                ->;
            };

#import "issa.idk";

        };

    };
};

#endif;
