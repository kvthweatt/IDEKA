// Author: Karac V. Thweatt
//
// ix64.idk - x86_64 assembly backend (System V, AT&T syntax)
//
// Backend counterpart of the LLVM IR text builder (i_llvmir.idk). It has no dependency on
// LLVM IR. It builds the shared code model (imodel.idk) and its builder methods select
// x86_64 instructions and write assembly directly.
//
// Model: every SSA value lives in an 8 byte frame slot (aggregates in a slot of their own
// size). Integers are kept zero extended to 64 bits, floats as raw bits. Each instruction
// loads its operands into scratch registers, computes and stores the result. A register
// allocator can replace this later without changing the builder interface.
//
// Registers: 0 rax 1 rcx 2 rdx 3 rsi 4 rdi 5 r8 6 r9 7 r10 8 r11 9 rbx 10 r12 11 r13 12 r14 13 r15
//
// Aggregates (structs and arrays) are passed by value as stack copies and returned through a
// hidden pointer in rdi, like the System V ABI does for memory class values.
//
// Ownership: every IRType, IRValue, string and block made through an X64Module
// belongs to that module and is released by X64Module.__exit.
//
#ifndef IDEKA_STANDARD
#import <standard.idk>;
#endif;

#ifndef IDEKA_AST
#import "iast.idk";
#endif;

#ifndef IDEKA_TYPES
#import "itypesys.idk";
#endif;

#ifndef IDEKA_MODEL
#import "imodel.idk";
#endif;

#ifndef IDEKA_X64
#def IDEKA_X64 1;

using IDEKA::ast;
using IDEKA::preprocessor;
using IDEKA::types;
using IDEKA::ir;

namespace IDEKA
{
    namespace x64
    {
#import "issa_types.idk";

// A frame object (an alloca that stays in memory, or an aggregate temporary)
struct XFO
{
    int size, al, off, fix;
};

// Per function state of the x86_64 backend: the argument registers a vararg function names, the frame and the
// registers it saves. GF.tg points to it.
struct XGF
{
    int asmsv;  // registers named by inline asm
    int vagp, vafp, vastk, vafo;  // named register arguments, stack bytes, save area of a vararg function
    int sretv;  // register holding the hidden result pointer, 0 when there is none
    int outmax;  // bytes of outgoing argument area
    PtrVec* fobj;  // frame objects: XFO*
    int saved;  // callee saved registers used
    bool sw;  // the frame is set up in the blocks marked hd instead of at the entry
    int frame;
    int csbase;
    bool dyn;  // the function has a dynamic stack allocation
    bool ncl;  // the function without a frame pointer makes calls: its frame keeps rsp 16 byte aligned there
    bool nofp;  // leaf function without a frame pointer: frame objects are addressed from rsp
    int csbase2;
    int* csoff;
};


// CPU features of the machine the code is made for
#def XF_POPCNT 1;     // CPU features of the machine the code is made for
#def XF_LZCNT 2;
#def XF_BMI1 4;
#def XF_BMI2 8;
#def XF_MOVBE 16;
#def XF_GFNI 32;
#def XF_ERMS 64;
#def XF_SSSE3 128;      // pshufb, palignr, pabs
#def XF_SSE42 256;      // pcmpistri, pcmpestri, crc32
#def XF_AVX 512;        // and the operating system keeps the ymm state
#def XF_AVX2 1024;
#def XF_AVX512F 2048;   // and the operating system keeps the zmm and mask state
#def XF_AVX512BW 4096;
#def XF_AVX512VL 8192;  // the 128 and 256 bit forms of the AVX-512 instructions, vpternlog among them
#def XF_AVX512DQ 16384;
#def XF_AVX512VBMI 32768;   // vpermb, vpmultishiftqb
#def XF_ADX 65536;      // adcx, adox
#def XF_PCLMUL 131072;  // pclmulqdq
#def XF_VPOPCNT 262144; // vpopcntd and vpopcntq
#def XF_BITALG 524288;  // vpopcntb, vpopcntw, vpshufbitqmb
#def XF_FMA 1048576;
#def XF_FSRM 2097152;   // short rep movsb is fast

// ------------------------------------------------------------------
// Machine IR
// ------------------------------------------------------------------
//
// Registers share one number space. 0..15 are the hardware general registers in encoding
// order (0 rax 1 rcx 2 rdx 3 rbx 4 rsp 5 rbp 6 rsi 7 rdi 8..15 r8..r15), 16..31 are
// xmm0..xmm15 and 32 and above are virtual registers.
#def R_VBASE 32;

#def MK_NONE 0;
#def MK_REG 1;      // r register, sz access size
#def MK_IMM 2;      // imm
#def MK_MEM 3;      // base r (-1 none), index r2 (-1 none) scaled by sc, disp imm, sym (rip) or frame object fo
#def MK_SYM 4;      // sym text
#def MK_BLK 5;      // block number in imm

struct MO
{
    int k, r, r2, sc, sz, fo;
    i64 imm;
    byte* sym;
};

#def M_MOV 1;       // o0 source, o1 destination
#def M_MOVZX 2;     // o0 source of size sz, o1 destination, zero extended to 32 bits
#def M_MOVSX 3;     // o0 source of size sz, o1 destination, sign extended to cc bytes
#def M_LEA 4;       // o0 memory, o1 destination
#def M_ALU 5;       // o2 = o0 kind o1, cc is the kind
#def M_SHIFT 6;     // o2 = o0 shifted by o1 (immediate, or the preg rcx)
#def M_UN 7;        // o1 = kind o0
#def M_CMP 8;       // flags of o0 against o1
#def M_TEST 9;      // flags of o0 and o1
#def M_SETCC 10;    // o0 = condition cc as 0 or 1
#def M_JCC 11;      // jump to block imm of o0 when cc
#def M_JMP 12;      // jump to block imm of o0
#def M_CMOV 13;     // o2 = cc ? o0 : o1
#def M_CALL 14;     // o0 target, clob the clobbered registers, iu the registers read
#def M_RET 15;      // iu the registers read
#def M_DIV 16;      // o0 divisor, cc 0 unsigned 1 signed, rax and rdx implicit
#def M_CQO 17;      // sign extends rax into rdx, size sz
#def M_REPMOVS 18;  // rep movsb
#def M_REPSTOS 19;  // rep stosb
#def M_UD2 20;
#def M_FALU 21;     // o2 = o0 kind o1 on scalar floats of size sz
#def M_FCMP 22;     // ucomis of o0 against o1
#def M_CVT 23;      // conversion between registers, cc kind
#def M_GX 24;       // move between general and xmm register, o0 source o1 destination
#def M_XMOV 25;     // xmm move of size sz, o0 source o1 destination
#def M_TEXT 26;     // raw text in text
#def M_LABEL 27;    // local label number in imm of o0
#def M_MOVABS 28;   // o0 immediate of 64 bits, o1 destination
#def M_FUN 29;      // o1 = unary float operation kind cc of o0
#def M_PCOPY 31;    // parallel copy of the phis of the target block along the edge
#def M_SPILL 32;    // store of register o0 into the spill slot of o1 (inserted by the allocator)
#def M_JTAB 34;     // jump table: o0 index register, o1 lowest case value, o2 default block, cc entries, text the block ids
#def M_JTAB2 35;    // sparse switch as nested byte tables: o0 index register, o2 default block, cc cases, text u64 values then int block ids
#def M_FSEL 36;     // float select: o0 value when cc holds, o1 otherwise, o2 destination
#def M_COPY 38;     // memory copy of sz bytes: o0 destination, o1 source (both memory operands)
#def M_REPMOVS 39;  // rep movsb with rsi, rdi, rcx set up
#def M_REPSTOS 40;  // rep stosb of zero with rdi, rcx and eax set up
#def M_MEMMOVE 41;  // overlap safe copy with rsi, rdi, rcx set up
#def M_INT3 42;     // breakpoint trap
#def M_ASM 43;      // inline asm: text is the body, iu the registers it reads, clob the ones it writes
#def M_VAARG 44;    // va_arg: o0 the list pointer, o1 the result, cc 1 for a float
#def M_VASTART 45;  // va_start: o0 the list pointer
#def M_SAVEVA 46;   // saves the argument registers into the register save area tgt
#def M_DALLOC 47;   // dynamic stack allocation: o0 the size in bytes, o1 the result
#def M_RETADDR 57;  // o0 receives the address of the slot that holds the return address (frame pointer + 8)
#def M_FMA 55;      // fused multiply add on scalar floats of size sz: o2 = o0 * o1 + o3 (cc 0), o0 * o1 - o3 (1), o3 - o0 * o1 (2)
#def M_FMAP 56;     // element-wise float loop over whole vectors: rdi dst, rsi and rdx the sources, rcx the count, r8 and r9 the invariants, o0 the program, rax = elements done
#def M_VZERO 52;    // zeroes the sz bytes at memory o0 with vector stores, uses xmm15
#def M_RUNB 54;     // rax = the leading bytes of the rsi bytes at rdi that obey the rule cc (byte, mode in bits 8 and up), rdx the second array
#def M_CNTB 53;     // rax = bytes consumed << 32 | bytes equal to cc counted, in whole 32 byte blocks of rsi bytes at rdi while the count stays below rdx
#def M_STRLEN 51;   // o1 = length of the zero terminated string at register o0 (8 bytes), clobbers rax rcx rdx xmm0
#def M_BT 50;       // CF = bit o0 of o1, both registers of sz bytes
#def M_BREV 49;     // bit reverse of the sz bytes of register o0 into register o1
#def M_RMW 48;      // memory destination ALU operation: o0 register or immediate, o1 memory, cc the operation
#def M_FREM 37;     // float remainder o2 = o0 rem o1 (x87), clobbers rax
#def M_RELOAD 33;   // load of register o1 from the spill slot of o0 (inserted by the allocator)

// ALU kinds
#def A_ADD 1;
#def A_SUB 2;
#def A_AND 3;
#def A_OR 4;
#def A_XOR 5;
#def A_IMUL 6;
#def S_SHL 1;
#def S_SHR 2;
#def S_SAR 3;
#def S_ROR 4;         // rorx, only with tgt 77
#def U_NEG 1;
#def U_NOT 2;
#def U_BSWAP 3;
#def U_MOVBE 4;      // big endian load (memory source) or store (memory destination)
#def U_POPCNT 5;
#def U_LZCNT 6;
#def U_TZCNT 7;
#def U_BLSR 8;       // x & (x - 1)
#def U_BLSI 9;       // x & -x
#def U_BLSMSK 10;    // x ^ (x - 1)

// Condition codes
#def C_E 0;
#def C_NE 1;
#def C_B 2;
#def C_AE 3;
#def C_BE 4;
#def C_A 5;
#def C_L 6;
#def C_GE 7;
#def C_LE 8;
#def C_G 9;
#def C_P 10;
#def C_NP 11;
#def C_S 12;
#def C_NS 13;

struct MI
{
    int op, sz, cc, iu, id, clob, dying, ddead, tgt;
    MO* o0;
    MO* o1;
    MO* o2;
    MO* o3;             // fourth operand, only the fused multiply add has one
    byte* text;
};

// Switches of the x86_64 optimizations, 1 on and 0 off
#def SSA_OPT_KEEPARG 1;    // a function with calls brings the arguments it still needs after the first call back in their registers, so callers keep values there across the call
#def SSA_OPT_SCHED 1;     // after allocation the instructions of a block are ordered so that a result is not wanted before its latency has passed
#def SSA_OPT_FVEC 1;      // element-wise float loops run in whole AVX vectors first, the loop itself finishes the rest
#def SSA_OPT_FMA 1;       // a float multiply whose only user is an add or subtract of its block becomes one fused multiply add (needs the FMA feature)
#def SSA_OPT_BMIX 1;       // andn, blsr, blsi, bzhi and rorx for the matching bit expressions
#def SSA_OPT_BMI 1;        // needs BMI2: variable shifts use shlx, shrx and sarx
#def SSA_OPT_ABSIDX 1;     // indexed access to a global array uses an absolute 32 bit address (Linux, non-PIE)
#def SSA_OPT_LAZYMULTI 1;  // a constant offset address used by several accesses is folded into each
#def SSA_OPT_SWCOPY 1;     // a callee saved register copied from an argument register outside the frame takes that register
#def SSA_OPT_THRPHI 1;     // a branch on a phi is also taken by the blocks that supply constants when its targets have phis
#def SSA_OPT_RETTHR 1;     // a block that returns a phi is replaced by returns in the blocks that jump to it
#def SSA_OPT_TAILDUP 1;    // a jump to a block that only returns is replaced by the return
#def SSA_OPT_SPILLFWD 1;  // a spilled value just loaded or stored is reused by the next uses nearby
#def SSA_OPT_MDCE 1;      // instructions whose register is never read are dropped
#def SSA_OPT_IDXOFF 1;    // index plus constant becomes a displacement
#def SSA_OPT_DIVC 1;      // division and remainder by a constant use a multiply
#def SSA_OPT_TAILCALL 1;   // a call whose result is returned unchanged becomes a jump (Linux)
#def SSA_OPT_CALLBOOL 1;   // bool call results feeding only a branch skip the zero extension
#def SSA_OPT_SHRINK 1;     // the frame is set up only in the blocks that need it
#def SSA_OPT_NOFP 1;       // leaf functions without a frame pointer
#def SSA_OPT_SWCHAIN 1;    // switches of up to four cases as compare and branch
#def SSA_OPT_ROTATE 1;     // a jump back to a plain compare and branch repeats the test in place
#def SSA_OPT_LAYOUT 1;     // blocks are placed so the likely successor follows
#def SSA_OPT_STMERGE 1;    // stores of constant bytes to neighbouring addresses become wider stores
#def SSA_OPT_JTHREAD 1;    // a branch to a block that only jumps goes to the final target
#def SSA_OPT_TESTELIM 1;   // a test of a register the previous instruction computed is dropped
#def SSA_OPT_CMPZ 1;       // a compare of a register with zero is a test
#def SSA_OPT_PUSHPAD 1;    // eight bytes of frame are taken with a push
#def SSA_OPT_MOVL 1;       // a constant that fits 32 bits is loaded with movl
#def SSA_OPT_NOFPC 1;      // a function with calls and no shrink wrapping has no frame pointer
#def SSA_OPT_REMP2 1;      // a signed remainder by a power of two clears the low bits of the biased value
#def SSA_OPT_CMPMEM 1;     // a load used only by a compare with a constant becomes the memory operand of the compare
#def SSA_OPT_VZERO 1;      // runs of zero stores become vector stores
#def SSA_OPT_XP 1;         // the machine instruction pass
#def SSA_OPT_PEEP 1;       // stack slot stores and loads the allocator leaves behind are dropped from the text
#def SSA_OPT_LDOP 1;       // a load read by one nearby arithmetic or compare instruction becomes its memory operand
#def SSA_OPT_SETZ 1;       // a compare result widened by setcc and movzx is zeroed in front of the compare instead
#def SSA_OPT_ADC 1;        // a compare result added to or subtracted from a value becomes adc or sbb
#def SSA_OPT_EXO 1;        // shift and mask byte reversal, bit reversal and parallel population count become bswap, gf2p8affineqb and popcnt
#def SSA_OPT_LEAMUL 1;     // a product with 3, 5 or 9 is one lea
#def SSA_OPT_LEASTRIDE 1;  // a stride of 3, 5 or 9 times a scale is one lea and a scaled address
#def SSA_OPT_SLOTIMM 1;    // a constant for a spilled phi is stored to its slot directly
#def SSA_OPT_ZIDIOM 1;     // a zero loaded for a phi is an xor when the flags are not read after it
#def SSA_OPT_ZEXT 1;       // drop a zero extend of an already zero extended register


        // ------------------------------------------------------------------
        // CPU features. The code is made for the processor the compiler runs on unless the
        // baseline x86_64 is asked for.
        // ------------------------------------------------------------------

        int x64_march = 0;      // 0 native, 1 baseline

        x64_set_march(int m) -> void
        {
            x64_march = m;
            ->;
        };

        // The most the code may use: 2, 3 and 4 are the x86-64 microarchitecture levels, 0 is whatever the processor has
        int x64_level = 0;

        x64_set_level(int l) -> void
        {
            x64_level = l;
            ->;
        };

        x64_level_mask() -> int
        {
            int m = XF_POPCNT `| XF_SSSE3 `| XF_SSE42 `| XF_PCLMUL;
            if (x64_level == 0) { -> 0 - 1; };
            if (x64_level >= 3) { m = m `| XF_AVX `| XF_AVX2 `| XF_BMI1 `| XF_BMI2 `| XF_LZCNT `| XF_MOVBE `| XF_FMA; };
            if (x64_level >= 4) { m = m `| XF_AVX512F `| XF_AVX512BW `| XF_AVX512VL `| XF_AVX512DQ; };
            -> m;
        };

        // Bit mask of the XF_ features the processor has
#ifdef __ARCH_X86_64__
        x64_detect() -> int
        {
            ulong eax, ebx, ecx, edx, mx, ex, xs;
            bool zmm = false;
            int f = 0;
            if (x64_march == 1) { -> 0; };
            volatile asm
            {
                xorq %rax, %rax
                cpuid
                movq %rax, $0
            } : "=r"(mx) :
              : "rax","rbx","rcx","rdx","memory";
            volatile asm
            {
                movq $$0x80000000, %rax
                cpuid
                movq %rax, $0
            } : "=r"(ex) :
              : "rax","rbx","rcx","rdx","memory";
            if (mx >= 1ul)
            {
                volatile asm
                {
                    movq $$1, %rax
                    xorq %rcx, %rcx
                    cpuid
                    movq %rcx, $0
                } : "=r"(ecx) :
                  : "rax","rbx","rcx","rdx","memory";
                if (((ecx >> 23) `& 1ul) != 0ul) { f = f `| XF_POPCNT; };
                if (((ecx >> 22) `& 1ul) != 0ul) { f = f `| XF_MOVBE; };
                if (((ecx >> 9) `& 1ul) != 0ul) { f = f `| XF_SSSE3; };
                if (((ecx >> 20) `& 1ul) != 0ul) { f = f `| XF_SSE42; };
                if (((ecx >> 1) `& 1ul) != 0ul) { f = f `| XF_PCLMUL; };
                // the vector state bits are only usable when the operating system saves them
                if (((ecx >> 27) `& 1ul) != 0ul & ((ecx >> 28) `& 1ul) != 0ul)
                {
                    volatile asm
                    {
                        xorq %rcx, %rcx
                        xgetbv
                        movq %rax, $0
                    } : "=r"(xs) :
                      : "rax","rbx","rcx","rdx","memory";
                    if ((xs `& 6ul) == 6ul)
                    {
                        f = f `| XF_AVX;
                        if (((ecx >> 12) `& 1ul) != 0ul) { f = f `| XF_FMA; };
                        if ((xs `& 224ul) == 224ul) { zmm = true; };
                    };
                };
            };
            if (mx >= 7ul)
            {
                volatile asm
                {
                    movq $$7, %rax
                    xorq %rcx, %rcx
                    cpuid
                    movq %rbx, $0
                    movq %rcx, $1
                    movq %rdx, $2
                } : "=r"(ebx), "=r"(ecx), "=r"(edx) :
                  : "rax","rbx","rcx","rdx","memory";
                if (((edx >> 4) `& 1ul) != 0ul) { f = f `| XF_FSRM; };
                if (((ebx >> 3) `& 1ul) != 0ul) { f = f `| XF_BMI1; };
                if (((ebx >> 8) `& 1ul) != 0ul) { f = f `| XF_BMI2; };
                if (((ebx >> 9) `& 1ul) != 0ul) { f = f `| XF_ERMS; };
                if (((ecx >> 8) `& 1ul) != 0ul) { f = f `| XF_GFNI; };
                if (((ebx >> 19) `& 1ul) != 0ul) { f = f `| XF_ADX; };
                if ((f `& XF_AVX) != 0)
                {
                    if (((ebx >> 5) `& 1ul) != 0ul) { f = f `| XF_AVX2; };
                    if (zmm)
                    {
                        if (((ebx >> 16) `& 1ul) != 0ul) { f = f `| XF_AVX512F; };
                        if (((ebx >> 17) `& 1ul) != 0ul) { f = f `| XF_AVX512DQ; };
                        if (((ebx >> 30) `& 1ul) != 0ul) { f = f `| XF_AVX512BW; };
                        if (((ebx >> 31) `& 1ul) != 0ul) { f = f `| XF_AVX512VL; };
                        if (((ecx >> 1) `& 1ul) != 0ul) { f = f `| XF_AVX512VBMI; };
                        if (((ecx >> 14) `& 1ul) != 0ul) { f = f `| XF_VPOPCNT; };
                        if (((ecx >> 12) `& 1ul) != 0ul) { f = f `| XF_BITALG; };
                    };
                };
            };
            if (ex >= 0x80000001ul)
            {
                volatile asm
                {
                    movq $$0x80000001, %rax
                    xorq %rcx, %rcx
                    cpuid
                    movq %rcx, $0
                } : "=r"(ecx) :
                  : "rax","rbx","rcx","rdx","memory";
                if (((ecx >> 5) `& 1ul) != 0ul) { f = f `| XF_LZCNT; };
            };
            -> f `& x64_level_mask();
        };
#else
        // the processor the compiler runs on is not an x86 one: the baseline features only
        x64_detect() -> int
        {
            -> 0;
        };
#endif;

        // ------------------------------------------------------------------
        // Module
        // ------------------------------------------------------------------

        object X64Module
        {
            // state shared with the other backends
#import "issa_state.idk";

            // state of the x86_64 backend
            bool a_handled;
            int abi;  // 0 System V, 1 Win64
            bool ssreg;  // r15 belongs to the shadow stack runtime and is never allocated
            int feat;  // XF_ features the code may use
            byte** rtab;
            Buf ab;
            int gfn;
            int bf_bits;  // width of the number s_bf_be returned
            int bf_sh, bf_w;  // set by the address computation: bit shift and width of a bit packed member, 0 width when none
            byte* arp;  // arena of the machine instructions of one function
            int aru;
            PtrVec* arch;
            GB* scb;  // block being selected
            IRValue* ec_v;  // last index value sign extended in this block
            int ec_r;  // register holding it extended, valid while ec_v is set
            IRValue* cn_v;  // the counting loop test: the counter, the bound, 1 when signed, the exit block
            IRValue* cn_n;
            int cn_s;
            int cn_w;
            IRBlock* cn_e;
            SI* bm_s1;  // the instructions a BMI match folds into its user
            SI* bm_s2;
            IRValue* bm_a;  // operands of the match
            IRValue* bm_b;
            int bm_n;  // rotate count
            int* exm;  // bit source maps of the idiom matcher, 64 entries per slot
            PtrVec* exl;  // the tree nodes the idiom matcher visited
            IRValue* ex_x;  // the value an idiom is a function of
            int ex_n;  // nodes visited
            int rs_nl;  // leaves of the tree
            NameMap* ipmap;  // function value text to IRFunc*
            int ipc;  // registers the calls of the function being compiled clobber
            int ipsv;  // callee saved registers the function being compiled saves
            int kpm;  // argument registers the function being compiled restores before every return
            int kpn;  // arguments kept
            int* kpv;  // virtual register that holds each kept argument
            int* kpp;  // argument register it came in
            int* kpu;  // last position of each argument in the body
            int kpc;  // position of the first call in the body
            bool kpok;  // the function may keep arguments
            i64 fvp;  // program of the element-wise loop being matched, four bits per operation
            int fvn, fvd, fvm, fvk;  // operations, stack depth, deepest stack, element kind (LK.FLOAT or LK.DOUBLE)
            PtrVec* fvbs;  // base pointers of the arrays: the destination first
            PtrVec* fvis;  // invariant operands
            PtrVec* fvseen;  // body instructions the expression used
            MI* rprev;  // the instruction in front of a loop test repeated by e_rotate
            bool efr;  // the block being written runs with the frame set up
            SI* nxti;  // instruction after the one being selected in its block
            bool hasal;  // the function has stack allocations
            bool hasra;  // the function takes the address of its return address
            bool skipn;  // the instruction after the one being selected is already done
            byte** rn;
            int sfs;  // operands of the float compare were swapped
            int splo;  // stack offset of the argument last placed
            Buf jb;  // code and tables of sparse switches of the function being written
            PtrVec* jts;  // jump tables of the function being written
            Buf eo;  // text of the function being written


            __init(byte* name) -> this
            {
                this.s_mod_init(name);
                this.feat = x64_detect();
                this.ab.__init();
                this.a_handled = false;
                this.gfn = 0;
                this.arp = (byte*)0;
                this.aru = 0;
                this.arch = pv_new();
                this.scb = (GB*)0;
                this.rprev = (MI*)0;
                this.bm_s1 = (SI*)0;
                this.bm_s2 = (SI*)0;
                this.bm_a = (IRValue*)0;
                this.bm_b = (IRValue*)0;
                this.bm_n = 0;
                this.exm = (int*)0;
                this.exl = (PtrVec*)0;
                this.ex_x = (IRValue*)0;
                this.ex_n = 0;
                this.rs_nl = 0;
                this.ipmap = nm_new();
                this.ipc = 0;
                this.ipsv = 0;
                this.kpm = 0;
                this.kpn = 0;
                this.kpv = this.s_iz(16);
                this.kpp = this.s_iz(16);
                this.kpu = this.s_iz(16);
                this.rn = (byte**)0;
                this.sfs = 0;
                this.splo = 0;
                this.jts = pv_new();
                this.jb.__init();
                this.eo.__init();
                this.a_init();
                -> this;
            };

            __expr() -> X64Module* -> this;

            __exit() -> void
            {
                nm_free(this.ipmap);
                if (this.exm != (int*)0) { ffree((byte*)this.exm); };
                if (this.exl != (PtrVec*)0) { pv_free(this.exl); };
                this.ab.__exit();
                -> this.s_mod_free();
            };

#import "issa_module.idk";
#import "issa_data.idk";

            a_init() -> void
            {
                int r, k;
                byte* base;
                this.rtab = (byte**)fmalloc((u64)(14 * 4 * 8));
                while (r < 14)
                {
                    k = 0;
                    while (k < 4)
                    {
                        this.tb.clear();
                        this.tb.put(37);
                        switch (r)
                        {
                            case (0) { this.a_rn(k, g"ax\0", g"al\0"); }
                            case (1) { this.a_rn(k, g"cx\0", g"cl\0"); }
                            case (2) { this.a_rn(k, g"dx\0", g"dl\0"); }
                            case (3) { this.a_rn(k, g"si\0", g"sil\0"); }
                            case (4) { this.a_rn(k, g"di\0", g"dil\0"); }
                            case (9) { this.a_rn(k, g"bx\0", g"bl\0"); }
                            default
                            {
                                this.tb.put(114);
                                switch (r)
                                {
                                    case (5) { this.tb.put_int(8); }
                                    case (6) { this.tb.put_int(9); }
                                    case (7) { this.tb.put_int(10); }
                                    case (8) { this.tb.put_int(11); }
                                    default { this.tb.put_int(r + 2); };
                                };
                                switch (k)
                                {
                                    case (1) { this.tb.put(100); }
                                    case (2) { this.tb.put(119); }
                                    case (3) { this.tb.put(98); }
                                    default {};
                                };
                            };
                        };
                        this.rtab[r * 4 + k] = this.own(this.tb.mem);
                        k++;
                    };
                    r++;
                };
                ->;
            };

            // Appends the name of a legacy register for size index k (0 q, 1 d, 2 w, 3 b)
            a_rn(int k, byte* w, byte* b) -> void
            {
                switch (k)
                {
                    case (0) { this.tb.put(114); this.tb.put_str(w); }
                    case (1) { this.tb.put(101); this.tb.put_str(w); }
                    case (2) { this.tb.put_str(w); }
                    default { this.tb.put_str(b); };
                };
                ->;
            };

            // ----------------------------------------------------------
            // Builder hooks
            // ----------------------------------------------------------

            // Win64 passes the first four arguments in rcx, rdx, r8, r9 and reserves 32 bytes of shadow space
            a_win() -> bool -> this.abi == 1;

            // Register index of a name such as rax, eax, ax, al, r10d, or -1
            a_regidx(byte* nm) -> int
            {
                int r, k;
                while (r < 14)
                {
                    k = 0;
                    while (k < 4)
                    {
                        if (this.a_seq(nm, this.rtab[r * 4 + k] + 1)) { -> r; };
                        k++;
                    };
                    r++;
                };
                -> -1;
            };

            // True when a tied input points at register reg
            a_tied(int* opreg, int* opkind, int no, int nop, int reg) -> bool
            {
                int i = no;
                while (i < nop)
                {
                    if (opkind[i] == 4 & opreg[i] == reg) { -> true; };
                    i++;
                };
                -> false;
            };

            // First register not in used, caller saved ones first
            a_pick(int used) -> int
            {
                int r;
                while (r < 14)
                {
                    if ((used `& (1 << r)) == 0) { -> r; };
                    r++;
                };
                -> 13;
            };

            a_put_function(Buf* out, IRFunc* f) -> void
            {
                int st;
                if (f.is_decl) { ->; };
                this.gfn = this.gfn + 1;
                st = out.len;
                this.ipc = 0;
                this.ipsv = 0;
                this.kpm = 0;
                this.kpn = 0;
                if (this.s_func(f, out))
                {
                    this.s_ip_record(f, out, st);
                    ->;
                };
                // the function needs something the code generator cannot do: the output is not assembled
                this.nunsup++;
                if (this.gwhys != (byte*)0) { this.a_note(this.a_sym(f.self.text), this.gwhys); }
                else { this.a_note(this.a_sym(f.self.text), g"control flow\0"); };
                out.put_str(g"# unsupported: \0");
                out.put_str(this.a_sym(f.self.text));
                out.put_str(g": \0");
                if (this.gwhys != (byte*)0) { out.put_str(this.gwhys); } else { out.put_str(g"control flow\0"); };
                out.put(10);
                ->;
            };

            a_emit(Buf* out) -> void
            {
                int i;
                PtrVec* ord;
                out.put_str(g"\t.file \0");
                put_quoted(out, this.mod_name);
                out.put(10);
                this.s_inline_all();
                if (this.s_ip_on())
                {
                    ord = pv_new();
                    this.s_ip_order(ord);
                    while (i < ord.len)
                    {
                        this.a_put_function(out, (IRFunc*)ord.items[i]);
                        i++;
                    };
                    pv_free(ord);
                }
                else
                {
                    while (i < this.funcs.len)
                    {
                        this.a_put_function(out, (IRFunc*)this.funcs.items[i]);
                        i++;
                    };
                };
                i = 0;
                while (i < this.globals.len)
                {
                    this.a_put_global(out, (IRGlobal*)this.globals.items[i]);
                    i++;
                };
                out.put_str(this.cdata.mem);
                if (this.zmax > 0)
                {
                    out.put_str(this.a_rodata());
                    out.put_str(g"\t.p2align 4\n.LZERO:\n\0");
                    this.a_zero(out, this.zmax);
                };
                if (!this.a_win()) { out.put_str(g"\t.section .note.GNU-stack,\"\",@progbits\n\0"); };
                ->;
            };

            // ----------------------------------------------------------
            // Printing
            // ----------------------------------------------------------

            emit(Buf* out) -> void
            {
                this.a_emit(out);
                ->;
            };

#import "issa.idk";

            // ----------------------------------------------------------
            // Target interface. issa.idk (target independent) calls these methods by name; a backend for
            // another instruction set defines the same names. The a_ methods give the data layout, s_allocmask,
            // s_npref and s_pref describe the register file to the allocator (registers 0..63 of a class, one bit
            // each in the 64 bit sets), s_tgt_free releases GF.tg, the state of the backend, and s_fvec_one,
            // s_strlen, s_runb, s_cntb and s_thread are the passes that need the instruction set, listed in the
            // pass table of issa.idk.
            //   a_foff(IRType* t, int n) -> int
            //   a_naked(IRFunc* f) -> bool
            //   a_size(IRType* t) -> int
            //   a_sym(byte* t) -> byte*
            //   s_allocmask(int cls) -> i64
            //   s_cntb() -> bool
            //   s_fvec_one(GB* hb) -> bool
            //   s_npref(int cls) -> int
            //   s_pref(int cls, int k) -> int
            //   s_runb() -> bool
            //   s_strlen() -> bool
            //   s_tgt_free(GF* g) -> void
            //   s_thread() -> bool
            // ----------------------------------------------------------

            // ----------------------------------------------------------
            // x86_64 code generator: machine instructions, selection, scheduling, allocation, frame and AT&T output
            // ----------------------------------------------------------


            // ==========================================================
            // arena, machine operands, virtual registers, operand and address selection.
            // ==========================================================

            // ----------------------------------------------------------
            // Arena for the machine instructions of one function
            // ----------------------------------------------------------

            s_ar(int n) -> byte*
            {
                byte* p;
                int sz;
                n = (n + 7) / 8 * 8;
                if (this.arp == (byte*)0 | this.aru + n > 1048576)
                {
                    sz = 1048576;
                    if (n > sz) { sz = n; };
                    this.arp = (byte*)fmalloc((u64)sz);
                    this.aru = 0;
                    pv_push(this.arch, (void*)this.arp);
                };
                p = this.arp + this.aru;
                this.aru = this.aru + n;
                -> p;
            };

            s_ar_free() -> void
            {
                int i = 0;
                while (i < this.arch.len) { ffree((byte*)this.arch.items[i]); i++; };
                this.arch.len = 0;
                this.arp = (byte*)0;
                this.aru = 0;
                ->;
            };

            // Register class of values of type t
            s_cls(IRType* t) -> int
            {
                if (t.kind == LK.FLOAT | t.kind == LK.DOUBLE) { -> 1; };
                -> 0;
            };

            // Access size in bytes of a scalar type
            s_vsz(IRType* t) -> int
            {
                int s = this.a_size(t);
                if (s > 8) { s = 8; };
                -> s;
            };

            // Operation size for integer arithmetic: values narrower than 32 bits are computed in 32
            s_asz(IRType* t) -> int
            {
                int s = this.s_vsz(t);
                if (s < 4) { -> 4; };
                -> s;
            };

            // Defines the virtual register of an instruction result
            s_def(IRValue* res, int cls) -> int
            {
                int v = this.s_nv(cls);
                res.vr = v;
                -> v;
            };

            // ----------------------------------------------------------
            // Addresses
            // ----------------------------------------------------------

            // Memory operand of the pointer p
            s_addr(IRValue* p) -> MO*
            {
                IRValue* v = this.s_res(p);
                SI* d;
                if (v.fo > 0) { -> this.s_mo_mem(0 - 1, 0 - 1, 1, (i64)0, (byte*)0, v.fo - 1); };
                if (v.di != (void*)0 & !v.kc)
                {
                    d = (SI*)v.di;
                    if (d.flag & d.op == SO_GEP) { -> this.s_gepmem(d); };
                };
                if (v.vr == 0 & (v.di == (void*)0 | v.kc))
                {
                    if (this.s_isc(v))
                    {
                        if (this.sck == CK_SYM) { -> this.s_mo_mem(0 - 1, 0 - 1, 1, this.scv, this.scs, 0 - 1); };
                        if (this.sck == CK_INT)
                        {
                            if (this.scv >= (i64)-2147483648 & this.scv <= (i64)2147483647) { -> this.s_mo_mem(0 - 1, 0 - 1, 1, this.scv, (byte*)0, 0 - 1); };
                            -> this.s_mo_mem(this.s_imm(this.scv), 0 - 1, 1, (i64)0, (byte*)0, 0 - 1);
                        };
                    };
                    this.s_fail(g"address constant\0");
                    -> this.s_mo_mem(0 - 1, 0 - 1, 1, (i64)0, (byte*)0, 0 - 1);
                };
                -> this.s_mo_mem(this.s_reg(v), 0 - 1, 1, (i64)0, (byte*)0, 0 - 1);
            };

            // ----------------------------------------------------------
            // Memory
            // ----------------------------------------------------------

            // New frame object of sz bytes, returns its number plus one
            s_newfo(int sz, int al) -> int
            {
                GF* g = this.sf;
                XFO* o = (XFO*)this.s_ar((int)(((sizeof(XFO) + 7) / 8) * 2));
                if (sz < 1) { sz = 1; };
                if (al < 1) { al = 1; };
                o.size = sz;
                o.al = al;
                o.off = 0;
                o.fix = 0;
                pv_push(((XGF*)g.tg).fobj, (void*)o);
                -> ((XGF*)g.tg).fobj.len;
            };

            s_isel_alloca(SI* x) -> void
            {
                x.res.fo = this.s_newfo(this.a_size(x.ty), this.a_align(x.ty));
                ->;
            };

            // ==========================================================
            // calls, returns, branches, phis, parameters and the selection driver over
            // the blocks of a function.
            // ==========================================================

            // ----------------------------------------------------------
            // Calling convention
            // ----------------------------------------------------------

            // Hardware register of integer argument position i, or -1
            s_argreg(int i) -> int
            {
                if (this.a_win())
                {
                    if (i == 0) { -> 1; };
                    if (i == 1) { -> 2; };
                    if (i == 2) { -> 8; };
                    if (i == 3) { -> 9; };
                    -> 0 - 1;
                };
                if (i == 0) { -> 7; };
                if (i == 1) { -> 6; };
                if (i == 2) { -> 2; };
                if (i == 3) { -> 1; };
                if (i == 4) { -> 8; };
                if (i == 5) { -> 9; };
                -> 0 - 1;
            };

            // Registers a call may overwrite
            // ----------------------------------------------------------
            // Interprocedural register allocation
            // ----------------------------------------------------------

            s_ip_on() -> bool
            {
                if (SSA_OPT_IPRA == 1 & !this.a_win()) { -> true; };
                -> false;
            };

            // Visits the callees of f first so their clobbered registers are known when f is compiled
            s_ip_visit(IRFunc* f, PtrVec* ord) -> void
            {
                int bi, j;
                IRBlock* b;
                SI* x;
                IRFunc* c;
                f.ipst = 1;
                bi = 0;
                while (bi < f.blocks.len)
                {
                    b = (IRBlock*)f.blocks.items[bi];
                    j = 0;
                    while (b.insts != (PtrVec*)0 & j < b.insts.len)
                    {
                        x = (SI*)b.insts.items[j];
                        if (x.op == SO_CALL)
                        {
                            c = (IRFunc*)nm_get(this.ipmap, x.a.text);
                            if (c != (IRFunc*)0)
                            {
                                if (c.ipst == 0 & !c.is_decl) { this.s_ip_visit(c, ord); };
                            };
                        };
                        j++;
                    };
                    bi++;
                };
                f.ipst = 2;
                pv_push(ord, (void*)f);
                ->;
            };

            s_ip_order(PtrVec* ord) -> void
            {
                int i = 0;
                IRFunc* f;
                while (i < this.funcs.len)
                {
                    f = (IRFunc*)this.funcs.items[i];
                    nm_put(this.ipmap, f.self.text, (void*)f);
                    i++;
                };
                i = 0;
                while (i < this.funcs.len)
                {
                    f = (IRFunc*)this.funcs.items[i];
                    if (f.ipst == 0)
                    {
                        if (f.is_decl) { f.ipst = 2; pv_push(ord, (void*)f); }
                        else { this.s_ip_visit(f, ord); };
                    };
                    i++;
                };
                ->;
            };

            // Register number of the name p[0..n), a register the allocator does not hand out gives 0 - 1
            s_ip_base(int a, int b) -> int
            {
                if (a == 97 & b == 120) { -> 0; };
                if (a == 99 & b == 120) { -> 1; };
                if (a == 100 & b == 120) { -> 2; };
                if (a == 98 & b == 120) { -> 3; };
                if (a == 115 & b == 112) { -> 4; };
                if (a == 98 & b == 112) { -> 5; };
                if (a == 115 & b == 105) { -> 6; };
                if (a == 100 & b == 105) { -> 7; };
                -> 0 - 1;
            };

            s_ip_reg(byte* p, int n) -> int
            {
                int a, b, c, v;
                if (n < 2) { -> 0 - 1; };
                a = (int)p[0];
                b = (int)p[1];
                c = 0;
                if (n > 2) { c = (int)p[2]; };
                if (n >= 4 & b == 109 & c == 109)
                {
                    if (a == 120 | a == 121 | a == 122)
                    {
                        v = (int)p[3] - 48;
                        if (n == 5) { v = v * 10 + (int)p[4] - 48; };
                        if (v >= 0 & v < 16) { -> 16 + v; };
                        -> 0 - 1;
                    };
                };
                if (a == 114 & b >= 48 & b <= 57)
                {
                    v = b - 48;
                    if (n > 2 & c >= 48 & c <= 57) { v = v * 10 + c - 48; };
                    if (v >= 8 & v <= 15) { -> v; };
                    -> 0 - 1;
                };
                if (n == 3)
                {
                    if (a == 114 | a == 101) { -> this.s_ip_base(b, c); };
                    if (a == 115 & b == 105 & c == 108) { -> 6; };
                    if (a == 100 & b == 105 & c == 108) { -> 7; };
                    if (a == 115 & b == 112 & c == 108) { -> 4; };
                    if (a == 98 & b == 112 & c == 108) { -> 5; };
                    -> 0 - 1;
                };
                if (n == 2)
                {
                    v = this.s_ip_base(a, b);
                    if (v >= 0) { -> v; };
                    if (b == 108 | b == 104)
                    {
                        if (a == 97) { -> 0; };
                        if (a == 99) { -> 1; };
                        if (a == 100) { -> 2; };
                        if (a == 98) { -> 3; };
                    };
                };
                -> 0 - 1;
            };

            // Registers a mnemonic uses without naming them. A call through a plain call mnemonic or anything
            // unknown that transfers control gives every caller saved register.
            s_ip_impl(byte* t) -> int
            {
                int c0 = (int)t[0];
                // most mnemonics start with a letter that no implicit register instruction starts with
                if (c0 == 97 | c0 == 98 | c0 == 101 | c0 == 102 | c0 == 103 | c0 == 104 | c0 == 106 | c0 == 107 | c0 == 110 | c0 == 111 | c0 == 116 | c0 == 117 | c0 == 119 | c0 == 121 | c0 == 122) { -> 0; };
                if (c0 == 109 & t[1] == 111)
                {
                    if (!(t[2] == 118 & t[3] == 115 & t[4] != 0 & t[5] == 0)) { -> 0; };
                };
                if (this.a_pre(t, g"rep\0")) { -> 1 `| 2 `| 64 `| 128; };
                if (this.a_pre(t, g"idiv\0") | this.a_pre(t, g"cqo\0") | this.a_pre(t, g"cltd\0") | this.a_pre(t, g"cwtd\0")) { -> 1 `| 4; };
                if (this.a_pre(t, g"div\0"))
                {
                    if (t[3] == 115 | t[3] == 112) { -> 0; };
                    -> 1 `| 4;
                };
                if (this.a_pre(t, g"mul\0"))
                {
                    if (t[3] == 0 | t[3] == 113 | t[3] == 108 | t[3] == 119 | t[3] == 98) { -> 1 `| 4; };
                    -> 0;
                };
                if (this.a_pre(t, g"cltq\0") | this.a_pre(t, g"cwtl\0") | this.a_pre(t, g"cbtw\0") | this.a_pre(t, g"cdqe\0")) { -> 1; };
                if (this.a_pre(t, g"lahf\0") | this.a_pre(t, g"sahf\0") | this.a_pre(t, g"xlat\0")) { -> 1; };
                if (this.a_pre(t, g"syscall\0")) { -> 1 `| 2 `| 2048; };
                if (this.a_pre(t, g"cpuid\0")) { -> 1 `| 2 `| 4 `| 8; };
                if (this.a_pre(t, g"rdtsc\0") | this.a_pre(t, g"xgetbv\0")) { -> 1 `| 2 `| 4; };
                if (this.a_pre(t, g"cmpxchg\0")) { -> 1 `| 4; };
                if (this.a_pre(t, g"pcmpistri\0") | this.a_pre(t, g"vpcmpistri\0")) { -> 2; };
                if (this.a_pre(t, g"pcmpestri\0") | this.a_pre(t, g"vpcmpestri\0")) { -> 1 `| 2 `| 4; };
                if (this.a_pre(t, g"pcmpistrm\0") | this.a_pre(t, g"pcmpestrm\0")) { -> 1 `| 2 `| 4 `| 65536; };
                if (this.a_pre(t, g"loop\0")) { -> 2; };
                if (this.a_pre(t, g"movs\0") | this.a_pre(t, g"stos\0") | this.a_pre(t, g"scas\0") | this.a_pre(t, g"cmps\0") | this.a_pre(t, g"lods\0"))
                {
                    if (t[4] != 0 & t[5] == 0)
                    {
                        if (t[4] == 98 | t[4] == 119 | t[4] == 108 | t[4] == 113) { -> 1 `| 2 `| 64 `| 128; };
                    };
                };
                if (this.a_pre(t, g"call\0"))
                {
                    if (!this.a_seq(t, g"callq\0")) { -> this.s_clob(); };
                };
                -> 0;
            };

            // True when the last operand of the mnemonic is only read
            s_ip_ro(byte* t) -> bool
            {
                int c0 = (int)t[0];
                if (c0 == 109 | c0 == 97 | c0 == 108 | c0 == 115 | c0 == 120 | c0 == 111 | c0 == 105) { -> false; };
                if (this.a_pre(t, g"cmp\0") | this.a_pre(t, g"test\0") | this.a_pre(t, g"push\0") | this.a_pre(t, g"ucomis\0")) { -> true; };
                if (this.a_pre(t, g"comis\0") | this.a_pre(t, g"vucomis\0") | this.a_pre(t, g"vcomis\0") | this.a_pre(t, g"ptest\0") | this.a_pre(t, g"vptest\0")) { -> true; };
                if (this.a_pre(t, g"prefetch\0") | this.a_pre(t, g"jmp\0") | this.a_pre(t, g"call\0") | this.a_pre(t, g"ret\0")) { -> true; };
                if (t[0] == 106) { -> true; };
                if (t[0] == 98 & t[1] == 116)
                {
                    if (t[2] == 0 | t[2] == 113 | t[2] == 108 | t[2] == 119) { -> true; };
                };
                -> false;
            };

            // The registers the assembly text s[0..n) writes, read only operands are not counted but every register
            // named in a destination position is
            s_ip_scan(byte* s, int n) -> int
            {
                int i, m, le, k, a, tl, j, e, r, ostart, depth, lastb, lastl, firstb, firstl, cnt, ib, il, c;
                bool ro, both;
                byte[32] tok = noinit;
                m = 0;
                i = 0;
                while (i < n)
                {
                    le = i;
                    while (le < n & s[le] != 10) { le++; };
                    k = i;
                    while (k < le & (s[k] == 9 | s[k] == 32)) { k++; };
                    a = k;
                    while (k < le & s[k] != 9 & s[k] != 32) { k++; };
                    tl = k - a;
                    if (tl > 0 & tl < 31 & s[a] != 46 & s[a] != 35 & s[k - 1] != 58)
                    {
                        j = 0;
                        while (j < tl) { tok[j] = s[a + j]; j++; };
                        tok[tl] = 0;
                        m = m `| this.s_ip_impl(@tok[0]);
                        ro = this.s_ip_ro(@tok[0]);
                        both = this.a_pre(@tok[0], g"xchg\0") | this.a_pre(@tok[0], g"xadd\0") | this.a_pre(@tok[0], g"mulx\0");
                        // operands
                        cnt = 0;
                        depth = 0;
                        ostart = k;
                        ib = 0 - 1;
                        il = 0;
                        lastb = 0 - 1;
                        lastl = 0;
                        firstb = 0 - 1;
                        firstl = 0;
                        j = k;
                        while (j <= le)
                        {
                            c = 44;
                            if (j < le) { c = (int)s[j]; };
                            if (c == 40 | c == 123) { depth++; };
                            if (c == 41 | c == 125) { depth--; };
                            if (c == 35 & depth == 0) { c = 44; j = le; };
                            if ((c == 44 & depth == 0) | j == le)
                            {
                                // operand [ostart, j): a bare register?
                                e = ostart;
                                while (e < j & (s[e] == 32 | s[e] == 9)) { e++; };
                                if (e < j)
                                {
                                    if (s[e] == 37)
                                    {
                                        r = e + 1;
                                        while (r < j & ((s[r] >= 48 & s[r] <= 57) | (s[r] >= 97 & s[r] <= 122))) { r++; };
                                        if (r >= j | s[r] == 123 | s[r] == 32 | s[r] == 9) { ib = this.s_ip_reg(@s[e + 1], r - e - 1); } else { ib = 0 - 1; };
                                    }
                                    else { ib = 0 - 1; };
                                    cnt++;
                                    if (cnt == 1) { firstb = ib; };
                                    if (both & ib >= 0) { m = m `| (1 << ib); };
                                    lastb = ib;
                                };
                                ostart = j + 1;
                            };
                            j++;
                        };
                        if (!ro & lastb >= 0) { m = m `| (1 << lastb); };
                    };
                    i = le + 1;
                };
                -> m;
            };

            // Called after f is compiled: remembers the registers a call to f can clobber
            s_ip_record(IRFunc* f, Buf* out, int st) -> void
            {
                int m;
                bool ok;
                if (!this.s_ip_on()) { ->; };
                ok = !this.a_naked(f);
                if (f.linkage != (byte*)0)
                {
                    if (this.a_pre(f.linkage, g"linkonce\0") | this.a_pre(f.linkage, g"weak\0")) { ok = false; };
                };
                if (!ok) { ->; };
                m = this.s_ip_scan(out.mem + st, out.len - st);
                m = (m `| this.ipc) `& (`!this.ipsv) `& (`!48) `& (`!this.kpm);
                f.ipm = m;
                f.ipok = true;
                ->;
            };

            s_clob() -> int
            {
                if (this.a_win()) { -> 1 `| 2 `| 4 `| 256 `| 512 `| 1024 `| 2048 `| (63 << 16); };
                -> 1 `| 2 `| 4 `| 64 `| 128 `| 256 `| 512 `| 1024 `| 2048 `| (65535 << 16);
            };

            // True when t is passed or returned in memory: the arguments sit in the outgoing area, the result is
            // written through a hidden pointer in rdi
            s_isag(IRType* t) -> bool
            {
                -> this.s_isagg(t);
            };

            // True when t is a type the selector passes in an integer register
            s_isarg(IRType* t) -> bool
            {
                if (t.kind == LK.PTR) { -> true; };
                if (t.kind == LK.INT) { -> t.width <= 64; };
                if (t.kind == LK.FLOAT | t.kind == LK.DOUBLE) { -> true; };
                -> false;
            };

            // Place of argument i: a register, or 0 - 1 for the stack with its offset in splo. st holds the
            // integer registers used, the xmm registers used and the stack bytes used so far.
            s_place(int i, bool fp, int* st) -> int
            {
                int r;
                if (this.a_win())
                {
                    this.splo = 8 * i;
                    if (i >= 4) { -> 0 - 1; };
                    if (fp) { -> 16 + i; };
                    -> this.s_argreg(i);
                };
                if (fp)
                {
                    if (st[1] < 8)
                    {
                        r = 16 + st[1];
                        st[1] = st[1] + 1;
                        -> r;
                    };
                }
                else
                {
                    r = this.s_argreg(st[0]);
                    if (r >= 0)
                    {
                        st[0] = st[0] + 1;
                        -> r;
                    };
                };
                this.splo = st[2];
                st[2] = st[2] + 8;
                -> 0 - 1;
            };

            // x | (1 << n), x ^ (1 << n) and x & ~(1 << n) with b the mask side: bts 8, btr 9, btc 10. bm_a is x,
            // bm_b is n. The shifts fold into u.
            s_bitop(SI* u, int k, IRValue* a, IRValue* b, int w) -> int
            {
                SI* d;
                SI* e;
                IRValue* y;
                d = this.s_innr(b, u);
                if (d == (SI*)0) { -> 0; };
                if (k != SB_AND)
                {
                    if (d.k != SB_SHL) { -> 0; };
                    if (!this.s_isk(d.a, (i64)1, w) | this.s_cint(d.b)) { -> 0; };
                    if (this.s_res(d.b).ty.kind != LK.INT | this.s_res(d.b).ty.width != w) { -> 0; };
                    this.bm_s1 = d;
                    this.bm_a = a;
                    this.bm_b = this.s_res(d.b);
                    if (k == SB_OR) { -> 8; };
                    -> 10;
                };
                if (d.k != SB_XOR) { -> 0; };
                y = (IRValue*)0;
                if (this.s_isk(d.b, (i64)0 - (i64)1, w)) { y = d.a; }
                elif (this.s_isk(d.a, (i64)0 - (i64)1, w)) { y = d.b; };
                if (y == (IRValue*)0) { -> 0; };
                e = this.s_innr(y, d);
                if (e == (SI*)0) { -> 0; };
                if (e.k != SB_SHL) { -> 0; };
                if (!this.s_isk(e.a, (i64)1, w) | this.s_cint(e.b)) { -> 0; };
                if (this.s_res(e.b).ty.kind != LK.INT | this.s_res(e.b).ty.width != w) { -> 0; };
                this.bm_s1 = d;
                this.bm_s2 = e;
                this.bm_a = a;
                this.bm_b = this.s_res(e.b);
                -> 9;
            };

            s_bmi_raw(SI* u) -> int
            {
                IRType* t = u.ty;
                IRValue* a;
                IRValue* b;
                IRValue* p;
                IRValue* q;
                IRValue* y;
                IRValue* z;
                SI* d;
                SI* e;
                SI* d2;
                int w, r, k;
                i64 c1, c2;
                this.bm_s1 = (SI*)0;
                this.bm_s2 = (SI*)0;
                if (u.op != SO_BIN | u.vol | u.res == (IRValue*)0) { -> 0; };
                if (t.kind != LK.INT) { -> 0; };
                w = t.width;
                if (w != 32 & w != 64) { -> 0; };
                k = u.k;
                a = this.s_res(u.a);
                b = this.s_res(u.b);
                if (k == SB_OR | k == SB_XOR | k == SB_AND)
                {
                    r = this.s_bitop(u, k, a, b, w);
                    if (r != 0) { -> r; };
                    r = this.s_bitop(u, k, b, a, w);
                    if (r != 0) { -> r; };
                };
                if (k == SB_AND)
                {
                    p = a;
                    q = b;
                    r = 0;
                    while (r < 2)
                    {
                        r++;
                        d = this.s_innr(q, u);
                        if (d != (SI*)0)
                        {
                            if (d.k == SB_XOR)
                            {
                                y = (IRValue*)0;
                                if (this.s_isk(d.b, (i64)0 - (i64)1, w)) { y = this.s_res(d.a); }
                                elif (this.s_isk(d.a, (i64)0 - (i64)1, w)) { y = this.s_res(d.b); };
                                if (y != (IRValue*)0)
                                {
                                    if (!this.s_cint(y))
                                    {
                                        this.bm_s1 = d;
                                        this.bm_a = y;
                                        this.bm_b = p;
                                        -> 1;
                                    };
                                };
                            };
                            if (d.k == SB_ADD | d.k == SB_SUB)
                            {
                                y = (IRValue*)0;
                                z = (IRValue*)0;
                                if (d.k == SB_ADD)
                                {
                                    if (this.s_isk(d.b, (i64)0 - (i64)1, w)) { y = this.s_res(d.a); }
                                    elif (this.s_isk(d.a, (i64)0 - (i64)1, w)) { y = this.s_res(d.b); };
                                }
                                else
                                {
                                    if (this.s_isk(d.b, (i64)1, w)) { y = this.s_res(d.a); };
                                    if (this.s_isk(d.a, (i64)0, w)) { z = this.s_res(d.b); };
                                };
                                if (z == p & !this.s_cint(p))
                                {
                                    this.bm_s1 = d;
                                    this.bm_a = p;
                                    -> 3;
                                };
                                if (y != (IRValue*)0)
                                {
                                    if (y == p & !this.s_cint(p))
                                    {
                                        this.bm_s1 = d;
                                        this.bm_a = p;
                                        -> 2;
                                    };
                                    e = this.s_innr(y, d);
                                    if (e != (SI*)0)
                                    {
                                        if (e.k == SB_SHL & this.s_isk(e.a, (i64)1, w) & !this.s_cint(e.b))
                                        {
                                            z = this.s_res(e.b);
                                            if (z.ty.kind == LK.INT)
                                            {
                                                if (z.ty.width == w)
                                                {
                                                    this.bm_s1 = d;
                                                    this.bm_s2 = e;
                                                    this.bm_a = p;
                                                    this.bm_b = z;
                                                    -> 4;
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                        p = b;
                        q = a;
                    };
                    -> 0;
                };
                if (k == SB_XOR)
                {
                    // x ^ (x - 1): every bit up to the lowest set one
                    p = a;
                    q = b;
                    r = 0;
                    while (r < 2)
                    {
                        r++;
                        d = this.s_innr(q, u);
                        if (d != (SI*)0)
                        {
                            y = (IRValue*)0;
                            if (d.k == SB_ADD)
                            {
                                if (this.s_isk(d.b, (i64)0 - (i64)1, w)) { y = this.s_res(d.a); }
                                elif (this.s_isk(d.a, (i64)0 - (i64)1, w)) { y = this.s_res(d.b); };
                            };
                            if (d.k == SB_SUB)
                            {
                                if (this.s_isk(d.b, (i64)1, w)) { y = this.s_res(d.a); };
                            };
                            if (y == p & !this.s_cint(p))
                            {
                                this.bm_s1 = d;
                                this.bm_a = p;
                                -> 7;
                            };
                        };
                        p = b;
                        q = a;
                    };
                };
                if (k == SB_OR | k == SB_XOR | k == SB_ADD)
                {
                    d = this.s_innr(a, u);
                    e = this.s_innr(b, u);
                    if (d == (SI*)0 | e == (SI*)0) { -> 0; };
                    if (d.k == SB_LSHR & e.k == SB_SHL) { d2 = d; d = e; e = d2; };
                    if (d.k != SB_SHL | e.k != SB_LSHR) { -> 0; };
                    if (this.s_res(d.a) != this.s_res(e.a) & SSA_OPT_SHLD == 1 & k != SB_ADD)
                    {
                        // two values: the shifted out bits of one enter the other
                        if (this.s_cint(this.s_res(d.a)) | this.s_cint(this.s_res(e.a))) { -> 0; };
                        if (!this.s_cint(d.b)) { -> 0; };
                        c1 = this.scv;
                        if (!this.s_cint(e.b)) { -> 0; };
                        c2 = this.scv;
                        if (c1 <= (i64)0 | c2 <= (i64)0 | c1 + c2 != (i64)w) { -> 0; };
                        this.bm_s1 = d;
                        this.bm_s2 = e;
                        this.bm_a = this.s_res(d.a);
                        this.bm_b = this.s_res(e.a);
                        this.bm_n = (int)c1;
                        -> 6;
                    };
                    if (this.s_res(d.a) != this.s_res(e.a)) { -> 0; };
                    if (this.s_cint(this.s_res(d.a))) { -> 0; };
                    if (!this.s_cint(d.b)) { -> 0; };
                    c1 = this.scv;
                    if (!this.s_cint(e.b)) { -> 0; };
                    c2 = this.scv;
                    if (c1 <= (i64)0 | c2 <= (i64)0 | c1 + c2 != (i64)w) { -> 0; };
                    this.bm_s1 = d;
                    this.bm_s2 = e;
                    this.bm_a = this.s_res(d.a);
                    this.bm_n = (int)c2;
                    -> 5;
                };
                -> 0;
            };

            // The loop test of a block of one compare and a branch: when the loop goes on, the value cmp_v (a phi of the
            // header) is below the value cmp_n, which the loop does not change. cmp_s is 1 for a signed compare and cmp_e
            // is the exit block. cmp_c is the block the loop goes on to. Returns false for any other shape.
            s_cntchk(IRBlock* b, IRBlock* hb, IRBlock* sb, IRBlock* bb, int skip) -> bool
            {
                SI* t = this.s_term(b);
                SI* c;
                IRValue* cv;
                IRValue* a;
                IRValue* r;
                int p;
                IRBlock* go;
                IRBlock* ex;
                if (t == (SI*)0) { -> false; };
                if (t.op != SO_CBR) { -> false; };
                if (b.insts.len != skip + 2) { -> false; };
                cv = this.s_res(t.a);
                if (cv.di == (void*)0) { -> false; };
                c = (SI*)cv.di;
                if (c.op != SO_CMP | c.res != cv | cv.nu != 1 | c.vol | c.n != 0) { -> false; };
                if (this.s_defin(cv, b) == false) { -> false; };
                p = c.k;
                go = t.t;
                ex = t.f;
                if (t.k == 1) { go = t.f; ex = t.t; };
                if (go != sb & go != bb) { -> false; };
                if (go == b | ex == b | ex == bb | ex == sb) { -> false; };
                if (go == sb) { if (b != hb) { -> false; }; };
                if (go == bb) { if (b != hb & b != sb) { -> false; }; };
                // the compare says to go on when it holds, unless the branch is the other way round
                if (go == t.f) { p = this.s_pinv(p); };
                a = this.s_res(c.a);
                r = this.s_res(c.b);
                if (p == SP_SGT) { p = SP_SLT; a = this.s_res(c.b); r = this.s_res(c.a); }
                elif (p == SP_UGT) { p = SP_ULT; a = this.s_res(c.b); r = this.s_res(c.a); };
                if (p != SP_SLT & p != SP_ULT) { -> false; };
                if (a.ty.kind != LK.INT) { -> false; };
                if (a.ty.width != 32 & a.ty.width != 64) { -> false; };
                this.cn_w = a.ty.width;
                this.cn_v = a;
                this.cn_n = r;
                this.cn_s = 0;
                if (p == SP_SLT) { this.cn_s = 1; };
                this.cn_e = ex;
                -> true;
            };

            // Finds the loops that run while the bytes obey a rule,
            //   while (i < n & s[i] == c) { i++; }      while (i < n & s[i] != c) { i++; }
            //   while (i < n) { if (a[i] != b[i]) { exit } i++; }
            // Whole 32 byte blocks that obey it, and the bytes of the first block before the one that does not, are
            // consumed by one search before the loop, which then ends at the byte that breaks the rule.
            // True when block b already holds a call of the intrinsic named p, a loop in front of which one stands has been through that pass
            s_prevcall(IRBlock* b, byte* p) -> bool
            {
                int i = 0;
                int gw = this.gwhy;
                SI* x;
                IRValue* c;
                if (b.insts == (PtrVec*)0) { -> false; };
                while (i < b.insts.len)
                {
                    x = (SI*)b.insts.items[i];
                    i++;
                    if (x.op != SO_CALL) { continue; };
                    c = this.s_res(x.a);
                    if (c.vr != 0 | c.di != (void*)0) { continue; };
                    if (!this.s_isc(c)) { this.gwhy = gw; continue; };
                    if (this.sck == CK_SYM & this.scv == (i64)0)
                    {
                        if (this.a_pre(this.scs, p)) { this.gwhy = gw; -> true; };
                    };
                };
                -> false;
            };

            // Finds the loops  while (s[i] != 0) { i++; }  and  while (*p != 0) { p++; }  and turns each one into a
            // search for the zero byte with 16 bytes at a time. The loop is a header block with one phi, a load of a byte,
            // a compare with zero and a branch, and a latch that steps by one.
            s_strlen() -> bool
            {
                GF* g = this.sf;
                bool any = false;
                int i, j, nphi, ix;
                GB* h;
                GB* pg;
                GB* lg;
                IRBlock* hb;
                IRBlock* lb;
                IRBlock* pb;
                IRBlock* eb;
                SI* t;
                SI* ph;
                SI* x;
                SI* d;
                SI* ld;
                SI* gp;
                SI* st;
                SI* tp;
                IRValue* cv;
                IRValue* vx;
                IRValue* addr;
                IRValue* base;
                IRValue* idx;
                IRValue* n0;
                IRValue* n1;
                IRValue* sp;
                IRValue* len;
                IRValue* fin;
                IRValue* callee;
                IRValue* iv;
                IRValue** av;
                IRType** pt;
                IRType* ft;
                IRType* t64;
                bool formp, ok, trueloop;
                if (SSA_OPT_STRLEN != 1) { -> false; };
                this.s_dce();
                i = 0;
                while (i < g.nb)
                {
                    h = (GB*)g.bl.items[i];
                    i++;
                    hb = h.ib;
                    if (h.preds.len != 2 | hb.insts == (PtrVec*)0) { continue; };
                    t = this.s_term(hb);
                    if (t == (SI*)0) { continue; };
                    if (t.op != SO_CBR) { continue; };
                    // the latch is the predecessor that has only the header as predecessor
                    lg = (GB*)h.preds.items[0];
                    pg = (GB*)h.preds.items[1];
                    if (lg.preds.len != 1) { lg = (GB*)h.preds.items[1]; pg = (GB*)h.preds.items[0]; };
                    if (lg.preds.len != 1 | lg.preds.items[0] != (void*)h | lg == h | pg == h) { continue; };
                    lb = lg.ib;
                    pb = pg.ib;
                    if (lb.insts == (PtrVec*)0 | lb.insts.len != 2) { continue; };
                    tp = this.s_term(pb);
                    if (tp == (SI*)0) { continue; };
                    if (tp.op != SO_BR) { continue; };
                    if (this.s_term(lb) == (SI*)0) { continue; };
                    if (this.s_term(lb).op != SO_BR) { continue; };
                    // the header: one phi, then only the chain of the load
                    nphi = 0;
                    ph = (SI*)0;
                    j = 0;
                    while (j < hb.insts.len)
                    {
                        x = (SI*)hb.insts.items[j];
                        if (x.op != SO_PHI) { break; };
                        ph = x;
                        nphi++;
                        j++;
                    };
                    if (nphi != 1 | ph.n != 2) { continue; };
                    ok = true;
                    while (j < hb.insts.len - 1)
                    {
                        x = (SI*)hb.insts.items[j];
                        if (x.op != SO_CAST & x.op != SO_GEP & x.op != SO_LOAD & x.op != SO_CMP) { ok = false; };
                        j++;
                    };
                    if (!ok) { continue; };
                    n0 = this.s_phi_from(ph, pb);
                    n1 = this.s_phi_from(ph, lb);
                    if (n0 == (IRValue*)0 | n1 == (IRValue*)0) { continue; };
                    n0 = this.s_res(n0);
                    n1 = this.s_res(n1);
                    iv = this.s_res(ph.res);
                    // the condition: byte != 0 continues the loop
                    cv = this.s_res(t.a);
                    if (cv.di == (void*)0) { continue; };
                    d = (SI*)cv.di;
                    if (d.op != SO_CMP | d.res != cv | cv.nu != 1) { continue; };
                    if (d.k != SP_EQ & d.k != SP_NE) { continue; };
                    if (!this.s_cint(this.s_res(d.b))) { continue; };
                    if (this.scv != (i64)0) { continue; };
                    vx = this.s_res(d.a);
                    if (vx.di == (void*)0) { continue; };
                    st = (SI*)vx.di;
                    if (st.op == SO_CAST & st.res == vx)
                    {
                        if (vx.nu != 1 | (st.k != SK_ZEXT & st.k != SK_SEXT)) { continue; };
                        vx = this.s_res(st.a);
                        if (vx.di == (void*)0) { continue; };
                    };
                    ld = (SI*)vx.di;
                    if (ld.op != SO_LOAD | ld.res != vx | vx.nu != 1 | ld.vol) { continue; };
                    if (vx.ty.kind != LK.INT) { continue; };
                    if (vx.ty.width != 8) { continue; };
                    // which way the branch goes
                    trueloop = t.t == lb;
                    if (t.k == 1) { trueloop = t.f == lb; };
                    if (d.k == SP_EQ) { trueloop = !trueloop; };
                    // trueloop now says that the branch condition true continues the loop for NE, so check the exits
                    eb = t.t;
                    if (t.t == lb) { eb = t.f; };
                    if (t.t != lb & t.f != lb) { continue; };
                    if (eb == hb | eb == lb) { continue; };
                    // continuing must happen exactly when the byte is not zero
                    ok = true;
                    if (t.k == 1)
                    {
                        // true goes to f
                        if (d.k == SP_NE) { ok = t.f == lb; } else { ok = t.t == lb; };
                    }
                    else
                    {
                        if (d.k == SP_NE) { ok = t.t == lb; } else { ok = t.f == lb; };
                    };
                    if (!ok) { continue; };
                    // the address
                    addr = this.s_res(ld.a);
                    formp = false;
                    base = (IRValue*)0;
                    idx = (IRValue*)0;
                    if (addr == iv)
                    {
                        formp = true;
                    }
                    else
                    {
                        if (addr.di == (void*)0) { continue; };
                        gp = (SI*)addr.di;
                        if (gp.op != SO_GEP | gp.res != addr | addr.nu != 1 | gp.n != 1) { continue; };
                        base = this.s_res(gp.a);
                        if (base.ty.kind != LK.PTR) { continue; };
                        if (this.a_size(base.ty.elem) != 1) { continue; };
                        if (this.s_defin(base, hb) | this.s_defin(base, lb)) { continue; };
                        idx = this.s_res(gp.args[0]);
                        if (idx != iv)
                        {
                            if (idx.di == (void*)0) { continue; };
                            st = (SI*)idx.di;
                            if (st.op != SO_CAST | st.res != idx | idx.nu != 1 | (st.k != SK_ZEXT & st.k != SK_SEXT)) { continue; };
                            if (this.s_res(st.a) != iv) { continue; };
                        };
                    };
                    // the latch steps by one
                    if (n1.di == (void*)0) { continue; };
                    x = (SI*)n1.di;
                    if (x.res != n1 | n1.nu != 1) { continue; };
                    if (!this.s_defin(n1, lb)) { continue; };
                    if (formp)
                    {
                        if (x.op != SO_GEP | x.n != 1 | this.s_res(x.a) != iv) { continue; };
                        if (iv.ty.kind != LK.PTR) { continue; };
                        if (this.a_size(iv.ty.elem) != 1) { continue; };
                        if (!this.s_cint(this.s_res(x.args[0]))) { continue; };
                        if (this.scv != (i64)1) { continue; };
                    }
                    else
                    {
                        if (x.op != SO_BIN | x.k != SB_ADD | this.s_res(x.a) != iv) { continue; };
                        if (iv.ty.kind != LK.INT) { continue; };
                        if (iv.ty.width != 32 & iv.ty.width != 64) { continue; };
                        if (!this.s_cint(this.s_res(x.b))) { continue; };
                        if (this.scv != (i64)1) { continue; };
                    };
                    // rewrite: the search goes before the branch of the predecessor
                    t64 = this.t_int(64);
                    this.cb = pb;
                    pb.insts.len = pb.insts.len - 1;
                    if (formp)
                    {
                        sp = n0;
                    }
                    else
                    {
                        sp = base;
                        ok = this.s_cint(n0);
                        if (!(ok & this.scv == (i64)0))
                        {
                            idx = n0;
                            if (n0.ty.width < 64)
                            {
                                idx = this.new_value(t64, g"%vr\0");
                                this.s_r_castk(SK_SEXT, n0, t64, idx);
                            };
                            sp = this.new_value(base.ty, g"%vr\0");
                            av = (IRValue**)this.s_ar(8);
                            av[0] = idx;
                            this.s_r_gep(base, av, 1, sp);
                        };
                    };
                    pt = (IRType**)this.s_ar(8);
                    pt[0] = sp.ty;
                    ft = this.t_func(t64, pt, 1, false);
                    callee = this.new_value(this.t_ptr(ft), g"@\"llvm.ideka.strlen\"\0");
                    len = this.new_value(t64, g"%vr\0");
                    av = (IRValue**)this.s_ar(8);
                    av[0] = sp;
                    this.s_r_call(callee, av, 1, len, false);
                    if (formp)
                    {
                        fin = this.new_value(sp.ty, g"%vr\0");
                        av = (IRValue**)this.s_ar(8);
                        av[0] = len;
                        this.s_r_gep(sp, av, 1, fin);
                    }
                    else
                    {
                        fin = len;
                        if (iv.ty.width < 64)
                        {
                            fin = this.new_value(iv.ty, g"%vr\0");
                            this.s_r_castk(SK_TRUNC, len, iv.ty, fin);
                        };
                        ok = this.s_cint(n0);
                        if (!(ok & this.scv == (i64)0)) { fin = this.s_ubin(SB_ADD, n0, fin); };
                    };
                    pv_push(pb.insts, (void*)tp);
                    // the header leaves the loop at once and the phi is the result of the search
                    fin = this.s_res(fin);
                    iv.fwd = fin;
                    j = 0;
                    while (j < g.nb)
                    {
                        pg = (GB*)g.bl.items[j];
                        if (pg.ib.insts != (PtrVec*)0)
                        {
                            ix = 0;
                            while (ix < pg.ib.insts.len)
                            {
                                x = (SI*)pg.ib.insts.items[ix];
                                st = (SI*)0;
                                nphi = this.s_nops(x);
                                if (x != ph)
                                {
                                    while (nphi > 0)
                                    {
                                        nphi--;
                                        if (this.s_op(x, nphi) == iv) { this.s_sop(x, nphi, fin); };
                                    };
                                };
                                ix++;
                            };
                        };
                        j++;
                    };
                    ph.op = 0;
                    t.op = SO_BR;
                    t.k = 0;
                    t.t = eb;
                    t.f = (IRBlock*)0;
                    any = true;
                };
                -> any;
            };

            // Recognizes the compare of a single bit with zero,  ((m >> i) & 1) != 0  or  == 0, which is one bt.
            // bm_s1 is the and, bm_s2 the shift, bm_b is m and bm_a is the bit number i. Returns false for no match.
            s_btm(SI* c) -> bool
            {
                IRValue* a;
                IRValue* b;
                IRValue* o;
                SI* d;
                SI* e;
                int w;
                if (SSA_OPT_BT != 1) { -> false; };
                if (c.op != SO_CMP | c.n != 0 | c.vol) { -> false; };
                if (c.k != SP_EQ & c.k != SP_NE) { -> false; };
                a = this.s_res(c.a);
                b = this.s_res(c.b);
                if (a.ty.kind != LK.INT) { -> false; };
                w = a.ty.width;
                if (w != 32 & w != 64) { -> false; };
                if (!this.s_isk(b, (i64)0, w)) { -> false; };
                d = this.s_innr(a, c);
                if (d == (SI*)0) { -> false; };
                if (d.k != SB_AND) { -> false; };
                // (1 << n) & m
                e = this.s_innr(d.a, d);
                if (e != (SI*)0)
                {
                    if (e.k == SB_SHL & this.s_isk(e.a, (i64)1, w) & !this.s_cint(e.b))
                    {
                        if (this.s_res(e.b).ty.kind == LK.INT & this.s_res(e.b).ty.width == w)
                        {
                            this.bm_s1 = d;
                            this.bm_s2 = e;
                            this.bm_b = this.s_res(d.b);
                            this.bm_a = this.s_res(e.b);
                            -> true;
                        };
                    };
                };
                e = this.s_innr(d.b, d);
                if (e != (SI*)0)
                {
                    if (e.k == SB_SHL & this.s_isk(e.a, (i64)1, w) & !this.s_cint(e.b))
                    {
                        if (this.s_res(e.b).ty.kind == LK.INT & this.s_res(e.b).ty.width == w)
                        {
                            this.bm_s1 = d;
                            this.bm_s2 = e;
                            this.bm_b = this.s_res(d.a);
                            this.bm_a = this.s_res(e.b);
                            -> true;
                        };
                    };
                };
                if (this.s_isk(d.b, (i64)1, w)) { o = this.s_res(d.a); }
                elif (this.s_isk(d.a, (i64)1, w)) { o = this.s_res(d.b); }
                else { -> false; };
                e = this.s_innr(o, d);
                if (e == (SI*)0) { -> false; };
                if (e.k != SB_LSHR) { -> false; };
                if (this.s_cint(this.s_res(e.b))) { -> false; };
                this.bm_s1 = d;
                this.bm_s2 = e;
                this.bm_b = this.s_res(e.a);
                this.bm_a = this.s_res(e.b);
                -> true;
            };

            // Marks the compares and address computations that are folded into their only user
            // True when the load x at index j of block gb, used only by the integer compare u of the same block against a
            // constant, can be folded into the compare as a memory operand: nothing between them writes memory
            s_cmpmem(GB* gb, int j, SI* x, SI* u) -> bool
            {
                int k;
                SI* y;
                IRValue* b;
                if (u.n != 0 | u.a != x.res) { -> false; };
                if (x.ty.kind != LK.INT) { -> false; };
                if (x.ty.width != 8 & x.ty.width != 16 & x.ty.width != 32 & x.ty.width != 64) { -> false; };
                b = this.s_res(u.b);
                if (!this.s_cint(b)) { -> false; };
                if (x.ty.width == 64)
                {
                    if (this.scv < (i64)0 - (i64)2147483648 | this.scv > (i64)2147483647) { -> false; };
                };
                // the compare must follow the load with nothing that writes memory in between
                k = j + 1;
                while (k < gb.ib.insts.len)
                {
                    y = (SI*)gb.ib.insts.items[k];
                    if (y == u) { -> true; };
                    if (y.op == SO_STORE | y.op == SO_CALL | y.op == SO_FILL | y.op == SO_COPY | y.op == SO_VAARG) { -> false; };
                    k++;
                };
                -> false;
            };


            // ==========================================================
            // idioms: bit expressions that are one instruction.
            //   A tree of and, or, xor, add and constant shifts over a single value is a map from the bits of the
            //   result to the bits of that value. A byte reversal written with shifts and masks has the map of
            //   bswap, a bit reversal the map of the Galois field affine instruction, and the SWAR population count
            //   is popcnt. The inner nodes fold into the root.
            // ==========================================================

            // The defining instruction of v when it is a tree node of the block of root, else null
            s_exin(IRValue* v, SI* root) -> SI*
            {
                IRValue* r = this.s_res(v);
                SI* d;
                if (r.di == (void*)0) { -> (SI*)0; };
                d = (SI*)r.di;
                if (d.op != SO_BIN | d.vol | d.bi != root.bi) { -> (SI*)0; };
                if (d.k != SB_AND & d.k != SB_OR & d.k != SB_XOR & d.k != SB_ADD & d.k != SB_SUB & d.k != SB_MUL & d.k != SB_SHL & d.k != SB_LSHR) { -> (SI*)0; };
                if (d.ty.kind != LK.INT) { -> (SI*)0; };
                -> d;
            };

            // The byte b repeated over w bits
            s_exrep(u64 b, int w) -> u64
            {
                u64 k = b;
                int i = 8;
                while (i < w) { k = k `| (k << (u64)i); i = i + 8; };
                -> k;
            };

            // True when v is the constant c repeated over w bits
            s_exk(IRValue* v, u64 c, int w) -> bool
            {
                if (!this.s_cint(v)) { -> false; };
                -> this.a_mask((u64)this.scv, w) == this.a_mask(c, w);
            };

            s_expush(SI* d) -> void
            {
                if (this.exl == (PtrVec*)0) { this.exl = pv_new(); };
                pv_push(this.exl, (void*)d);
                this.ex_n = this.ex_n + 1;
            };

            // Evaluates node d into slot sl of exm: entry i is the bit of the value that result bit i copies,
            // or -1 for a zero. Returns false when the tree is not such a map.
            s_exmap(SI* d, int sl, int w, int depth) -> bool
            {
                int i, cn, ba, base;
                if (depth > 30 | this.ex_n > 40 | sl > 120) { -> false; };
                if (d.ty.width != w) { -> false; };
                base = sl * 64;
                // a node read twice is evaluated once
                i = 0;
                while (i < this.exl.len)
                {
                    if (this.exl.items[i] == (void*)d)
                    {
                        ba = (128 + i) * 64;
                        cn = 0;
                        while (cn < w) { this.exm[base + cn] = this.exm[ba + cn]; cn++; };
                        -> true;
                    };
                    i++;
                };
                if (!this.s_exeval(d, sl, w, depth)) { -> false; };
                // remember the map beside the node
                this.s_expush(d);
                ba = (128 + this.exl.len - 1) * 64;
                cn = 0;
                while (cn < w) { this.exm[ba + cn] = this.exm[base + cn]; cn++; };
                -> true;
            };

            s_exeval(SI* d, int sl, int w, int depth) -> bool
            {
                IRValue* a = this.s_res(d.a);
                IRValue* b = this.s_res(d.b);
                IRValue* o;
                int k = d.k;
                int i, cn, s0, s1, base, ba, bb;
                u64 mask;
                base = sl * 64;
                if (k == SB_SHL | k == SB_LSHR)
                {
                    if (!this.s_cint(b)) { -> false; };
                    cn = (int)this.scv;
                    if (cn <= 0 | cn >= w) { -> false; };
                    if (!this.s_exval(a, d, sl + 1, w, depth)) { -> false; };
                    ba = (sl + 1) * 64;
                    i = 0;
                    while (i < w)
                    {
                        if (k == SB_SHL)
                        {
                            if (i >= cn) { this.exm[base + i] = this.exm[ba + i - cn]; } else { this.exm[base + i] = 0 - 1; };
                        }
                        else
                        {
                            if (i + cn < w) { this.exm[base + i] = this.exm[ba + i + cn]; } else { this.exm[base + i] = 0 - 1; };
                        };
                        i++;
                    };
                    -> true;
                };
                if (k == SB_AND)
                {
                    o = a;
                    if (this.s_cint(a)) { o = b; mask = this.a_mask((u64)this.scv, w); }
                    elif (this.s_cint(b)) { mask = this.a_mask((u64)this.scv, w); }
                    else { -> false; };
                    if (!this.s_exval(o, d, sl + 1, w, depth)) { -> false; };
                    ba = (sl + 1) * 64;
                    i = 0;
                    while (i < w)
                    {
                        if (((mask >> (u64)i) `& (u64)1) != (u64)0) { this.exm[base + i] = this.exm[ba + i]; } else { this.exm[base + i] = 0 - 1; };
                        i++;
                    };
                    -> true;
                };
                if (k == SB_OR | k == SB_XOR | k == SB_ADD)
                {
                    if (!this.s_exval(a, d, sl + 1, w, depth)) { -> false; };
                    if (!this.s_exval(b, d, sl + 2, w, depth)) { -> false; };
                    ba = (sl + 1) * 64;
                    bb = (sl + 2) * 64;
                    i = 0;
                    while (i < w)
                    {
                        s0 = this.exm[ba + i];
                        s1 = this.exm[bb + i];
                        // both sides driving one bit would make a carry or a cancel, not a copy
                        if (s0 >= 0 & s1 >= 0) { -> false; };
                        if (s0 >= 0) { this.exm[base + i] = s0; } else { this.exm[base + i] = s1; };
                        i++;
                    };
                    -> true;
                };
                -> false;
            };

            // Operand v of a tree node: a tree node of its own, or the value the idiom is a function of
            s_exval(IRValue* v, SI* par, int sl, int w, int depth) -> bool
            {
                IRValue* r = this.s_res(v);
                SI* c;
                int i;
                if (this.s_cint(r)) { -> false; };
                c = this.s_exin(r, par);
                if (c != (SI*)0)
                {
                    if (c.k == SB_AND | c.k == SB_OR | c.k == SB_XOR | c.k == SB_ADD | c.k == SB_SHL | c.k == SB_LSHR)
                    {
                        -> this.s_exmap(c, sl, w, depth + 1);
                    };
                };
                if (r.ty.kind != LK.INT) { -> false; };
                if (r.ty.width != w) { -> false; };
                if (this.ex_x == (IRValue*)0) { this.ex_x = r; };
                if (this.ex_x != r) { -> false; };
                i = 0;
                while (i < w) { this.exm[sl * 64 + i] = i; i++; };
                -> true;
            };

            // True when entry j of the visited list is its first occurrence
            s_exfirst(int j) -> bool
            {
                int q = 0;
                while (q < j)
                {
                    if (this.exl.items[q] == this.exl.items[j]) { -> false; };
                    q++;
                };
                -> true;
            };

            // True when every node the walk visited has all its uses inside the tree
            s_exuses() -> bool
            {
                int i, j, cnt;
                SI* d;
                SI* e;
                i = 0;
                while (i < this.exl.len)
                {
                    d = (SI*)this.exl.items[i];
                    cnt = 0;
                    j = 0;
                    while (j < this.exl.len)
                    {
                        e = (SI*)this.exl.items[j];
                        // each distinct parent counts once per operand that reads the node
                        if (this.s_exfirst(j))
                        {
                            if (this.s_res(e.a) == d.res) { cnt = cnt + 1; };
                            if (this.s_res(e.b) == d.res) { cnt = cnt + 1; };
                        };
                        j++;
                    };
                    if (d.res.nu != cnt & i < this.exl.len - 1) { -> false; };
                    i++;
                };
                -> true;
            };

            // The population count by parallel sums: the multiplication by 0x0101.. gathers the byte counts
            s_expopc(SI* u, int w) -> bool
            {
                SI* m;
                SI* t;
                SI* h;
                SI* l4;
                SI* s2;
                SI* v;
                SI* lo;
                SI* hi;
                SI* l2;
                SI* l1;
                SI* an;
                IRValue* tv;
                IRValue* sv;
                IRValue* xv;
                IRValue* vv;
                if (!this.s_cint(u.b)) { -> false; };
                if ((int)this.scv != w - 8) { -> false; };
                m = this.s_exin(u.a, u);
                if (m == (SI*)0) { -> false; };
                if (m.k != SB_MUL) { -> false; };
                if (this.s_exk(m.b, this.s_exrep((u64)1, w), w)) { tv = this.s_res(m.a); }
                elif (this.s_exk(m.a, this.s_exrep((u64)1, w), w)) { tv = this.s_res(m.b); }
                else { -> false; };
                // (h + (h >> 4)) & 0x0F..
                t = this.s_exin(tv, m);
                if (t == (SI*)0) { -> false; };
                if (t.k != SB_AND) { -> false; };
                if (this.s_exk(t.b, this.s_exrep((u64)15, w), w)) { sv = this.s_res(t.a); }
                elif (this.s_exk(t.a, this.s_exrep((u64)15, w), w)) { sv = this.s_res(t.b); }
                else { -> false; };
                h = this.s_exin(sv, t);
                if (h == (SI*)0) { -> false; };
                if (h.k != SB_ADD) { -> false; };
                l4 = this.s_exin(h.b, h);
                s2 = this.s_exin(h.a, h);
                if (l4 != (SI*)0 & s2 != (SI*)0)
                {
                    if (l4.k != SB_LSHR) { an = l4; l4 = s2; s2 = an; };
                };
                if (l4 == (SI*)0 | s2 == (SI*)0) { -> false; };
                if (l4.k != SB_LSHR) { -> false; };
                if (!this.s_cint(l4.b)) { -> false; };
                if (this.scv != (i64)4) { -> false; };
                vv = this.s_res(l4.a);
                if (this.s_res(s2.res) != vv) { -> false; };
                // (v & 0x33..) + ((v >> 2) & 0x33..)
                if (s2.k != SB_ADD) { -> false; };
                lo = this.s_exin(s2.a, s2);
                hi = this.s_exin(s2.b, s2);
                if (lo == (SI*)0 | hi == (SI*)0) { -> false; };
                if (lo.k != SB_AND | hi.k != SB_AND) { -> false; };
                if (!this.s_exk(lo.b, this.s_exrep((u64)51, w), w) | !this.s_exk(hi.b, this.s_exrep((u64)51, w), w)) { -> false; };
                l2 = this.s_exin(hi.a, hi);
                if (l2 == (SI*)0) { an = lo; lo = hi; hi = an; l2 = this.s_exin(hi.a, hi); };
                if (l2 == (SI*)0) { -> false; };
                if (l2.k != SB_LSHR) { -> false; };
                if (!this.s_cint(l2.b)) { -> false; };
                if (this.scv != (i64)2) { -> false; };
                vv = this.s_res(lo.a);
                if (this.s_res(l2.a) != vv) { -> false; };
                // x - ((x >> 1) & 0x55..)
                v = this.s_exin(vv, lo);
                if (v == (SI*)0) { -> false; };
                if (v.k != SB_SUB) { -> false; };
                an = this.s_exin(v.b, v);
                if (an == (SI*)0) { -> false; };
                if (an.k != SB_AND) { -> false; };
                if (!this.s_exk(an.b, this.s_exrep((u64)85, w), w)) { -> false; };
                l1 = this.s_exin(an.a, an);
                if (l1 == (SI*)0) { -> false; };
                if (l1.k != SB_LSHR) { -> false; };
                if (!this.s_cint(l1.b)) { -> false; };
                if (this.scv != (i64)1) { -> false; };
                xv = this.s_res(v.a);
                if (this.s_res(l1.a) != xv) { -> false; };
                if (this.s_cint(xv)) { -> false; };
                if (xv.ty.kind != LK.INT) { -> false; };
                if (xv.ty.width != w) { -> false; };
                // every inner node has the one use the walk saw, except the sums that read the value twice
                if (m.res.nu != 1 | t.res.nu != 1 | h.res.nu != 1 | l4.res.nu != 1 | an.res.nu != 1 | l1.res.nu != 1) { -> false; };
                if (s2.res.nu != 2 | v.res.nu != 2 | lo.res.nu != 1 | hi.res.nu != 1 | l2.res.nu != 1) { -> false; };
                this.ex_x = xv;
                this.exl.len = 0;
                pv_push(this.exl, (void*)m);
                pv_push(this.exl, (void*)t);
                pv_push(this.exl, (void*)h);
                pv_push(this.exl, (void*)l4);
                pv_push(this.exl, (void*)s2);
                pv_push(this.exl, (void*)lo);
                pv_push(this.exl, (void*)hi);
                pv_push(this.exl, (void*)l2);
                pv_push(this.exl, (void*)v);
                pv_push(this.exl, (void*)an);
                pv_push(this.exl, (void*)l1);
                -> true;
            };

            // An address with constant indices that several loads and stores of its own block use is folded
            // into each of them, rather than computed once into a register
            s_lazymulti() -> void
            {
                GF* g = this.sf;
                int i, j, k, n;
                GB* gb;
                SI* x;
                SI* d;
                IRValue* v;
                bool ok;
                i = 0;
                while (i < g.nb)
                {
                    gb = (GB*)g.bl.items[i];
                    if (gb.ib.insts != (PtrVec*)0)
                    {
                        j = 0;
                        while (j < gb.ib.insts.len)
                        {
                            x = (SI*)gb.ib.insts.items[j];
                            if (x.op == SO_GEP & x.res != (IRValue*)0) { if (x.res.nu > 1) { x.res.ui = (void*)0; }; };
                            j++;
                        };
                    };
                    i++;
                };
                i = 0;
                while (i < g.nb)
                {
                    gb = (GB*)g.bl.items[i];
                    if (gb.ib.insts != (PtrVec*)0)
                    {
                        j = 0;
                        while (j < gb.ib.insts.len)
                        {
                            x = (SI*)gb.ib.insts.items[j];
                            n = this.s_nops(x);
                            k = 0;
                            while (k < n)
                            {
                                v = this.s_op(x, k);
                                if (v.nu > 1 & v.di != (void*)0)
                                {
                                    d = (SI*)v.di;
                                    if (d.op == SO_GEP & d.res == v)
                                    {
                                        ok = true;
                                        if (ok) { ok = x.op == SO_LOAD | (x.op == SO_STORE & x.a != v) | x.op == SO_GEP; };
                                        if (ok) { if (x.op == SO_GEP) { ok = x.a == v & k == 0; } elif (x.op == SO_LOAD) { ok = x.a == v; } else { ok = x.b == v; }; };
                                        if (ok) { ok = !x.vol | x.op == SO_GEP; };
                                        if (!ok) { v.ui = (void*)1; };
                                    };
                                };
                                k++;
                            };
                            j++;
                        };
                    };
                    i++;
                };
                i = 0;
                while (i < g.nb)
                {
                    gb = (GB*)g.bl.items[i];
                    if (gb.ib.insts != (PtrVec*)0)
                    {
                        j = 0;
                        while (j < gb.ib.insts.len)
                        {
                            x = (SI*)gb.ib.insts.items[j];
                            if (x.op == SO_GEP & x.res != (IRValue*)0)
                            {
                                if (x.res.nu > 1 & x.res.ui == (void*)0)
                                {
                                    if (this.s_gepk(x)) { x.flag = true; };
                                };
                            };
                            j++;
                        };
                    };
                    i++;
                };
                ->;
            };

            // Position of the first call of the body and the last position each argument is used at, in kpc and kpu. An
            // argument still used after the first call sits in a safe register across the calls anyway, so the function
            // can afford to bring it back in its register (see s_isel_ret) and its callers can then keep their own
            // values there across the call.
            s_kpscan() -> void
            {
                GF* g = this.sf;
                IRFunc* f = g.f;
                int i, j, k, n, pos, q, gw;
                GB* gb;
                SI* x;
                IRValue* c;
                i = 0;
                while (i < 16) { this.kpu[i] = 0 - 1; i++; };
                this.kpc = 0 - 1;
                pos = 0;
                i = 0;
                while (i < g.nb)
                {
                    gb = g.rpo[i];
                    i++;
                    if (gb.ib.insts == (PtrVec*)0) { continue; };
                    j = 0;
                    while (j < gb.ib.insts.len)
                    {
                        x = (SI*)gb.ib.insts.items[j];
                        j++;
                        pos++;
                        if (x.op == SO_CALL & this.kpc < 0)
                        {
                            this.kpc = pos;
                            c = this.s_res(x.a);
                            if (c.vr == 0 & c.di == (void*)0)
                            {
                                gw = this.gwhy;
                                if (this.s_isc(c))
                                {
                                    if (this.sck == CK_SYM & this.scv == (i64)0)
                                    {
                                        if (this.a_pre(this.scs, g"llvm.\0") | this.a_pre(this.scs, g"ideka.\0")) { this.kpc = 0 - 1; };
                                    };
                                };
                                this.gwhy = gw;
                            };
                        };
                        n = this.s_nops(x);
                        k = 0;
                        while (k < n)
                        {
                            c = this.s_op(x, k);
                            if (c != (IRValue*)0)
                            {
                                c = this.s_res(c);
                                q = 0;
                                while (q < f.nargs & q < 6)
                                {
                                    if (this.s_res(f.args[q]) == c) { this.kpu[q] = pos; };
                                    q++;
                                };
                            };
                            k++;
                        };
                    };
                };
                ->;
            };

            // True when every path from the entry to a return passes a call. A function with a path of its own without
            // calls (a fast case) would pay for bringing its arguments back on that path.
            s_kpall() -> bool
            {
                GF* g = this.sf;
                int i, j, top, n;
                int* seen = this.s_iz(g.nb + 1);
                int* stk = this.s_iz(g.nb + 1);
                GB* gb;
                GB* sb;
                SI* x;
                bool hascall, ok;
                ok = true;
                top = 0;
                stk[0] = g.rpo[0].rpo;
                seen[g.rpo[0].rpo] = 1;
                top = 1;
                while (top > 0 & ok)
                {
                    top--;
                    gb = g.rpo[stk[top]];
                    hascall = false;
                    if (gb.ib.insts != (PtrVec*)0)
                    {
                        j = 0;
                        while (j < gb.ib.insts.len)
                        {
                            x = (SI*)gb.ib.insts.items[j];
                            if (x.op == SO_CALL) { hascall = true; };
                            j++;
                        };
                    };
                    if (hascall) { continue; };
                    if (gb.succs.len == 0) { ok = false; break; };
                    j = 0;
                    while (j < gb.succs.len)
                    {
                        sb = (GB*)gb.succs.items[j];
                        if (seen[sb.rpo] == 0)
                        {
                            seen[sb.rpo] = 1;
                            stk[top] = sb.rpo;
                            top++;
                        };
                        j++;
                    };
                };
                this.s_ifree(seen);
                this.s_ifree(stk);
                -> ok;
            };

            // ----------------------------------------------------------
            // Phis
            // ----------------------------------------------------------

            s_isel_phis(GB* gb) -> void
            {
                int i, j, k, n;
                SI* x;
                GP* gp;
                GB* pg;
                IRType* t;
                int* used;
                if (gb.ib.insts == (PtrVec*)0) { ->; };
                i = 0;
                while (i < gb.ib.insts.len)
                {
                    x = (SI*)gb.ib.insts.items[i];
                    if (x.op == SO_PHI)
                    {
                        t = x.ty;
                        if (!this.s_isarg(t)) { this.s_fail(g"phi type\0"); ->; };
                        gp = (GP*)this.s_ar((int)(((sizeof(GP) + 7) / 8) * 2));
                        gp.res = x.res;
                        gp.dst = this.s_def(x.res, this.s_cls(t));
                        gp.preds = pv_new();
                        gp.vals = pv_new();
                        gp.ops = pv_new();
                        used = this.s_iz(x.n + 1);
                        j = 0;
                        while (j < gb.preds.len)
                        {
                            pg = (GB*)gb.preds.items[j];
                            k = 0;
                            while (k < x.n)
                            {
                                if (x.blks[k] == pg.ib & used[k] == 0) { break; };
                                k++;
                            };
                            if (k >= x.n)
                            {
                                // a duplicate edge reuses the first entry of that block
                                k = 0;
                                while (k < x.n)
                                {
                                    if (x.blks[k] == pg.ib) { break; };
                                    k++;
                                };
                            };
                            if (k >= x.n)
                            {
                                this.s_fail(g"phi without incoming value\0");
                                this.s_ifree(used);
                                ->;
                            };
                            used[k] = 1;
                            pv_push(gp.preds, (void*)pg);
                            pv_push(gp.vals, (void*)this.s_res(x.args[k]));
                            j++;
                        };
                        this.s_ifree(used);
                        pv_push(gb.phis, (void*)gp);
                    };
                    i++;
                };
                ->;
            };

            // ==========================================================
            // loop weights, register scanning, liveness and register allocation on the
            // interference graph of the SSA values (colored in definition order, spilling by weight).
            // ==========================================================

            // ----------------------------------------------------------
            // Registers read and written by a machine instruction
            // ----------------------------------------------------------

            // True for the registers the allocator never sees: rsp, rbp and the scratch registers
            s_hidden(int r) -> bool
            {
                if (r < 0) { -> true; };
                if (r == 4 | r == 5 | r == 10 | r == 11 | r == 31) { -> true; };
                -> false;
            };

            // ----------------------------------------------------------
            // Register allocation
            // ----------------------------------------------------------

            // Registers the allocator may hand out
            s_allocmask(int cls) -> i64
            {
                if (cls == 1)
                {
                    if (this.a_win()) { -> (i64)(63 << 16); };
                    -> (i64)(16383 << 16);
                };
                // rax rcx rdx rbx rsi rdi r8 r9 r12 r13 r14 r15
                if (this.ssreg) { -> (i64)(1 `| 2 `| 4 `| 8 `| 64 `| 128 `| 256 `| 512 `| 4096 `| 8192 `| 16384); };
                -> (i64)(1 `| 2 `| 4 `| 8 `| 64 `| 128 `| 256 `| 512 `| 4096 `| 8192 `| 16384 `| 32768);
            };

            // Number of registers of class cls that s_pref lists, most preferred first
            s_npref(int cls) -> int
            {
                if (cls == 1) { -> 16; };
                -> 16;
            };

            // Registers a function must preserve
            s_csmask() -> int
            {
                // the shadow stack register is neither saved nor restored: a function that sets it sets it for its caller
                if (this.a_win())
                {
                    if (this.ssreg) { -> 8 `| 64 `| 128 `| 4096 `| 8192 `| 16384 `| (1023 << 22); };
                    -> 8 `| 64 `| 128 `| 4096 `| 8192 `| 16384 `| 32768 `| (1023 << 22);
                };
                if (this.ssreg) { -> 8 `| 4096 `| 8192 `| 16384; };
                -> 8 `| 4096 `| 8192 `| 16384 `| 32768;
            };

            // Order in which free registers are taken
            s_pref(int cls, int k) -> int
            {
                if (cls == 1) { -> 16 + k; };
                if (k == 0) { -> 0; };
                if (k == 1) { -> 1; };
                if (k == 2) { -> 2; };
                if (k == 3) { -> 6; };
                if (k == 4) { -> 7; };
                if (k == 5) { -> 8; };
                if (k == 6) { -> 9; };
                if (k == 7) { -> 3; };
                if (k == 8) { -> 12; };
                if (k == 9) { -> 13; };
                if (k == 10) { -> 14; };
                -> 15;
            };

            // ==========================================================
            // frame layout, lowering of the machine instructions to AT&T assembly text,
            // parallel copies and the function writer.
            // ==========================================================

            // ----------------------------------------------------------
            // Register names
            // ----------------------------------------------------------

            s_rnames() -> void
            {
                byte** t;
                if (this.rn != (byte**)0) { ->; };
                t = (byte**)fmalloc((u64)(8 * 80));
                t[0] = g"rax\0"; t[1] = g"rcx\0"; t[2] = g"rdx\0"; t[3] = g"rbx\0"; t[4] = g"rsp\0"; t[5] = g"rbp\0"; t[6] = g"rsi\0"; t[7] = g"rdi\0";
                t[8] = g"r8\0"; t[9] = g"r9\0"; t[10] = g"r10\0"; t[11] = g"r11\0"; t[12] = g"r12\0"; t[13] = g"r13\0"; t[14] = g"r14\0"; t[15] = g"r15\0";
                t[16] = g"eax\0"; t[17] = g"ecx\0"; t[18] = g"edx\0"; t[19] = g"ebx\0"; t[20] = g"esp\0"; t[21] = g"ebp\0"; t[22] = g"esi\0"; t[23] = g"edi\0";
                t[24] = g"r8d\0"; t[25] = g"r9d\0"; t[26] = g"r10d\0"; t[27] = g"r11d\0"; t[28] = g"r12d\0"; t[29] = g"r13d\0"; t[30] = g"r14d\0"; t[31] = g"r15d\0";
                t[32] = g"ax\0"; t[33] = g"cx\0"; t[34] = g"dx\0"; t[35] = g"bx\0"; t[36] = g"sp\0"; t[37] = g"bp\0"; t[38] = g"si\0"; t[39] = g"di\0";
                t[40] = g"r8w\0"; t[41] = g"r9w\0"; t[42] = g"r10w\0"; t[43] = g"r11w\0"; t[44] = g"r12w\0"; t[45] = g"r13w\0"; t[46] = g"r14w\0"; t[47] = g"r15w\0";
                t[48] = g"al\0"; t[49] = g"cl\0"; t[50] = g"dl\0"; t[51] = g"bl\0"; t[52] = g"spl\0"; t[53] = g"bpl\0"; t[54] = g"sil\0"; t[55] = g"dil\0";
                t[56] = g"r8b\0"; t[57] = g"r9b\0"; t[58] = g"r10b\0"; t[59] = g"r11b\0"; t[60] = g"r12b\0"; t[61] = g"r13b\0"; t[62] = g"r14b\0"; t[63] = g"r15b\0";
                this.rn = t;
                ->;
            };

            // ----------------------------------------------------------
            // Frame layout
            // ----------------------------------------------------------

            s_layout() -> void
            {
                GF* g = this.sf;
                int i, k, run, al, sz, cs, r0, need;
                XFO* fo;
                cs = 0;
                k = 0;
                while (k < 16)
                {
                    if ((((XGF*)g.tg).saved `& (1 << k)) != 0) { cs++; };
                    k++;
                };
                run = cs * 8;
                // without a frame pointer the registers are pushed below the return address, the first one lands where
                // the saved frame pointer would have been
                if (this.s_nfpn())
                {
                    run = 0;
                    if (cs > 0) { run = (cs - 1) * 8; };
                };
                r0 = run;
                i = 0;
                while (i < ((XGF*)g.tg).fobj.len)
                {
                    fo = (XFO*)((XGF*)g.tg).fobj.items[i];
                    if (fo.fix == 0)
                    {
                        al = fo.al;
                        if (al > 16) { al = 16; };
                        if (al < 1) { al = 1; };
                        run = run + fo.size;
                        run = (run + al - 1) / al * al;
                        fo.off = 0 - run;
                    };
                    i++;
                };
                ((XGF*)g.tg).frame = (run + ((XGF*)g.tg).outmax + 15) / 16 * 16;
                if (this.s_nfpn())
                {
                    need = cs * 8;
                    if (run != r0 | ((XGF*)g.tg).outmax > 0) { need = run + 8 + ((XGF*)g.tg).outmax; };
                    if (need < cs * 8) { need = cs * 8; };
                    if (((XGF*)g.tg).ncl) { ((XGF*)g.tg).frame = (need - 8 + 15) / 16 * 16 + 8; if (need < 8) { ((XGF*)g.tg).frame = 8; }; }
                    else { ((XGF*)g.tg).frame = (need + 15) / 16 * 16; };
                };
                ->;
            };

            // Parses the line [a, e) of the emitted text when it is a mov of a register to or from a stack slot.
            // o holds the size letter, then the first operand range and the second operand range. Returns 1 for a
            // store, 2 for a load and 0 for anything else.
            pp_parse(byte* s, int a, int e, int* o) -> int
            {
                int c, k, x0, x1, y0, y1;
                bool xm, ym;
                if (e - a < 12) { -> 0; };
                if (s[a] != 9 | s[a + 1] != 'm' | s[a + 2] != 'o' | s[a + 3] != 'v' | s[a + 5] != 32 | s[e - 1] != 10) { -> 0; };
                c = (int)s[a + 4];
                if (c != 'q' & c != 'l' & c != 'w' & c != 'b') { -> 0; };
                x0 = a + 6;
                k = x0;
                while (k < e - 1 & s[k] != ',') { k++; };
                if (k >= e - 3 | s[k + 1] != 32) { -> 0; };
                x1 = k;
                y0 = k + 2;
                y1 = e - 1;
                if (y1 <= y0 | x1 <= x0) { -> 0; };
                xm = s[x1 - 1] == ')' & s[x1 - 2] == 'p' & s[x1 - 3] == 's' & s[x1 - 4] == 'r' & s[x1 - 5] == '%' & s[x1 - 6] == '(';
                ym = s[y1 - 1] == ')' & s[y1 - 2] == 'p' & s[y1 - 3] == 's' & s[y1 - 4] == 'r' & s[y1 - 5] == '%' & s[y1 - 6] == '(';
                o[0] = c;
                o[1] = x0;
                o[2] = x1;
                o[3] = y0;
                o[4] = y1;
                if (s[x0] == '%' & ym)
                {
                    k = x0;
                    while (k < x1) { if (s[k] == '(') { -> 0; }; k++; };
                    -> 1;
                };
                if (xm & s[y0] == '%')
                {
                    k = y0;
                    while (k < y1) { if (s[k] == '(') { -> 0; }; k++; };
                    -> 2;
                };
                -> 0;
            };

            pp_eq(byte* s, int a0, int a1, int b0, int b1) -> bool
            {
                int k;
                if (a1 - a0 != b1 - b0) { -> false; };
                k = 0;
                while (a0 + k < a1) { if (s[a0 + k] != s[b0 + k]) { -> false; }; k++; };
                -> true;
            };

            // True when the line [a, e) only reads and writes registers (and flags), none of them the stack pointer
            pp_pure(byte* s, int a, int e) -> bool
            {
                int k, c0, c1, c2, c3;
                bool sp;
                if (e - a < 6 | s[a] != 9) { -> false; };
                k = a + 1;
                sp = false;
                while (k < e)
                {
                    if (s[k] == '(' | s[k] == '.' | s[k] == ':' | s[k] == '$' & false) { -> false; };
                    if (k + 1 < e) { if (s[k] == 's' & s[k + 1] == 'p') { -> false; }; };
                    if (s[k] == 32) { sp = true; };
                    k++;
                };
                if (!sp) { -> false; };
                c0 = (int)s[a + 1];
                c1 = (int)s[a + 2];
                c2 = (int)s[a + 3];
                c3 = (int)s[a + 4];
                if (c0 == 'm' & c1 == 'o' & c2 == 'v') { if (c3 == 'z' | c3 == 's' | c3 == 'l' | c3 == 'q' | c3 == 'w' | c3 == 'b') { -> true; }; -> false; };
                if (c0 == 'x' & c1 == 'o' & c2 == 'r') { -> true; };
                if (c0 == 'a' & c1 == 'n' & c2 == 'd') { -> true; };
                if (c0 == 'o' & c1 == 'r' & c2 == 32) { -> true; };
                if (c0 == 'a' & c1 == 'd' & c2 == 'd') { -> true; };
                if (c0 == 's' & c1 == 'u' & c2 == 'b') { -> true; };
                if (c0 == 't' & c1 == 'e' & c2 == 's') { -> true; };
                if (c0 == 'c' & c1 == 'm' & c2 == 'p') { -> true; };
                if (c0 == 's' & c1 == 'e' & c2 == 't') { -> true; };
                if (c0 == 's' & c1 == 'h' & (c2 == 'l' | c2 == 'r')) { -> true; };
                if (c0 == 's' & c1 == 'a' & c2 == 'r') { -> true; };
                if (c0 == 'n' & c1 == 'e' & c2 == 'g') { -> true; };
                if (c0 == 'n' & c1 == 'o' & c2 == 't') { -> true; };
                -> false;
            };

            // The register of the line [a, e) when it is test r, r: o[0] and o[1] bound its text. False for any other line.
            pp_testreg(byte* s, int a, int e, int* o) -> bool
            {
                int k, x0, x1, y0, y1;
                if (e - a < 14) { -> false; };
                if (s[a] != 9 | s[a + 1] != 't' | s[a + 2] != 'e' | s[a + 3] != 's' | s[a + 4] != 't' | s[a + 6] != 32 | s[e - 1] != 10) { -> false; };
                if (s[a + 7] != '%') { -> false; };
                x0 = a + 7;
                k = x0;
                while (k < e - 1 & s[k] != ',') { k++; };
                if (k >= e - 3 | s[k + 1] != 32) { -> false; };
                x1 = k;
                y0 = k + 2;
                y1 = e - 1;
                if (!this.pp_eq(s, x0, x1, y0, y1)) { -> false; };
                o[0] = x0;
                o[1] = x1;
                -> true;
            };

            // The class of the instruction [a, e) that wrote the register [r0, r1) as its last operand: 1 when its
            // flags are those of a test of the result (and, or, xor), 2 when its zero and sign flags are (add, sub,
            // neg, inc, dec), else 0
            pp_flagop(byte* s, int a, int e, int r0, int r1) -> int
            {
                int k, l, c0, c1, c2, wl;
                if (e - a < 8 | s[a] != 9) { -> 0; };
                k = a + 1;
                while (k < e & s[k] != 32) { k++; };
                wl = k - (a + 1);
                if (wl < 3 | wl > 4) { -> 0; };
                // the last operand
                l = e - 2;
                while (l > k & s[l] != ',' & s[l] != 32) { l--; };
                if (!this.pp_eq(s, l + 1, e - 1, r0, r1)) { -> 0; };
                c0 = (int)s[a + 1];
                c1 = (int)s[a + 2];
                c2 = (int)s[a + 3];
                if (wl == 3 & c0 == 'o' & c1 == 'r') { -> 1; };
                if (wl == 4 & c0 == 'a' & c1 == 'n' & c2 == 'd') { -> 1; };
                if (wl == 4 & c0 == 'x' & c1 == 'o' & c2 == 'r') { -> 1; };
                if (wl == 4 & c0 == 'a' & c1 == 'd' & c2 == 'd') { -> 2; };
                if (wl == 4 & c0 == 's' & c1 == 'u' & c2 == 'b') { -> 2; };
                if (wl == 4 & c0 == 'n' & c1 == 'e' & c2 == 'g') { -> 2; };
                if (wl == 4 & c0 == 'i' & c1 == 'n' & c2 == 'c') { -> 2; };
                if (wl == 4 & c0 == 'd' & c1 == 'e' & c2 == 'c') { -> 2; };
                -> 0;
            };

            // The line at position i of the input when it is a conditional jump: 1 for any condition, 2 for the
            // conditions that read only the zero and sign flags, 0 for anything else
            pp_jcc(byte* s, int i, int n) -> int
            {
                int k = i + 2;
                if (i + 4 > n) { -> 0; };
                if (s[i] != 9 | s[i + 1] != 'j') { -> 0; };
                if (s[i + 2] == 'm' & s[i + 3] == 'p') { -> 0; };
                while (k < n & s[k] != 32 & s[k] != 10) { k++; };
                if (k - (i + 2) == 1 & (s[i + 2] == 'e' | s[i + 2] == 'z' | s[i + 2] == 's')) { -> 2; };
                if (k - (i + 2) == 2 & s[i + 2] == 'n' & (s[i + 3] == 'e' | s[i + 3] == 'z' | s[i + 3] == 's')) { -> 2; };
                -> 1;
            };

            // A pass over the text of a function. Stack slot traffic the allocator leaves behind:
            //   store r to m, load m to r      the load is dropped
            //   load m to r, store r to m      the store is dropped
            //   the same store twice           the second is dropped
            //   store to m, instruction on registers, store to m      the first store is dropped
            s_peep(Buf* b) -> void
            {
                byte* s = b.mem;
                int n = b.len;
                int i = 0;
                int w = 0;
                int e, ls, k, kn, kp, kq, p1, p2, l2;
                bool drop;
                int* fa = (int*)fmalloc((u64)64);
                int* fb = (int*)fmalloc((u64)64);
                p1 = 0 - 1;
                p2 = 0 - 1;
                while (i < n)
                {
                    e = i;
                    while (e < n & s[e] != 10) { e++; };
                    if (e < n) { e++; };
                    ls = w;
                    k = i;
                    while (k < e) { s[w] = s[k]; w++; k++; };
                    i = e;
                    drop = false;
                    kn = this.pp_parse(s, ls, w, fa);
                    if (kn != 0 & p1 >= 0)
                    {
                        kp = this.pp_parse(s, p1, ls, fb);
                        if (kp != 0 & fa[0] == fb[0])
                        {
                            if (kp == 1 & kn == 2) { if (this.pp_eq(s, fa[1], fa[2], fb[3], fb[4]) & this.pp_eq(s, fa[3], fa[4], fb[1], fb[2])) { drop = true; }; };
                            if (kp == 2 & kn == 1) { if (this.pp_eq(s, fa[1], fa[2], fb[3], fb[4]) & this.pp_eq(s, fa[3], fa[4], fb[1], fb[2])) { drop = true; }; };
                            if (kp == 1 & kn == 1) { if (this.pp_eq(s, fa[1], fa[2], fb[1], fb[2]) & this.pp_eq(s, fa[3], fa[4], fb[3], fb[4])) { drop = true; }; };
                        };
                        if (!drop & kn == 1 & p2 >= 0)
                        {
                            // a store, then registers only, then a store of the same size to the same slot
                            kq = this.pp_parse(s, p2, p1, fb);
                            if (kq == 1 & fa[0] == fb[0])
                            {
                                if (this.pp_eq(s, fa[3], fa[4], fb[3], fb[4]) & this.pp_pure(s, p1, ls))
                                {
                                    l2 = p1 - p2;
                                    k = p1;
                                    while (k < w) { s[k - l2] = s[k]; k++; };
                                    w = w - l2;
                                    p1 = ls - l2;
                                    continue;
                                };
                            };
                        };
                    };
                    if (!drop & p1 >= 0 & kn == 0)
                    {
                        // a test of the register the previous instruction just wrote: its flags already say it
                        if (this.pp_testreg(s, ls, w, fa))
                        {
                            kq = this.pp_flagop(s, p1, ls, fa[0], fa[1]);
                            if (kq != 0)
                            {
                                k = this.pp_jcc(s, i, n);
                                if (k == 1 & kq == 1) { drop = true; };
                                if (k == 2)
                                {
                                    // the flags must not be read again behind the jump
                                    e = i;
                                    while (e < n & s[e] != 10) { e++; };
                                    e++;
                                    if (kq == 1) { drop = true; }
                                    elif (e + 3 < n)
                                    {
                                        if (s[e] == 9 & s[e + 1] != 'j' & !(s[e + 1] == 's' & s[e + 2] == 'e' & s[e + 3] == 't') & !(s[e + 1] == 'c' & s[e + 2] == 'm' & s[e + 3] == 'o')) { drop = true; };
                                    };
                                };
                            };
                        };
                    };
                    if (drop) { w = ls; continue; };
                    p2 = p1;
                    p1 = ls;
                };
                b.len = w;
                ffree((byte*)fa);
                ffree((byte*)fb);
                ->;
            };

            // True when the function has no frame pointer and keeps its registers with push and pop
            s_nfpn() -> bool
            {
                if (((XGF*)this.sf.tg).nofp & !this.a_win() & SSA_OPT_PUSHCSR == 1) { -> true; };
                -> false;
            };

            s_has(byte* h, byte* n) -> bool
            {
                int i = 0;
                int j;
                while (h[i] != 0)
                {
                    j = 0;
                    while (n[j] != 0)
                    {
                        if (h[i + j] != n[j]) { break; };
                        j++;
                    };
                    if (n[j] == 0) { -> true; };
                    i++;
                };
                -> false;
            };

            // True when the text of an inline asm touches neither the stack pointer nor the frame pointer nor makes calls
            s_asm_nostack(byte* t) -> bool
            {
                if (t == (byte*)0) { -> false; };
                if (this.s_has(t, g"sp\0") | this.s_has(t, g"bp\0") | this.s_has(t, g"push\0") | this.s_has(t, g"pop\0")) { -> false; };
                if (this.s_has(t, g"call\0") | this.s_has(t, g"leave\0") | this.s_has(t, g"enter\0") | this.s_has(t, g"ret\0")) { -> false; };
                if (this.s_has(t, g"jmp\0") | this.s_has(t, g"syscall\0") | this.s_has(t, g"int\0")) { -> false; };
                -> true;
            };


            // Records block id t in the open addressing set of referenced blocks
            s_jt_ref(int* rk, int cap, int t) -> void
            {
                int h = t % cap;
                while (rk[h] != 0)
                {
                    if (rk[h] == t + 1) { ->; };
                    h = (h + 1) % cap;
                };
                rk[h] = t + 1;
                ->;
            };

            // ==========================================================
            // shrink wrapping: the frame is set up only in the blocks that need it. Calls, stack slots and the
            // frame pointer need the frame. A path that never reaches such a block returns without the saves.
            // ==========================================================

            // Position of the block with label id, or -1
            s_sw_find(int* hk, int* hv, int cap, int id) -> int
            {
                int h = id % cap;
                if (h < 0) { h = h + cap; };
                while (hk[h] != 0)
                {
                    if (hk[h] == id + 1) { -> hv[h]; };
                    h = (h + 1) % cap;
                };
                -> 0 - 1;
            };

            // The callee saved registers an inline asm text may name (a loose match, a name inside another word counts)
            s_sw_asmcs(byte* t) -> int
            {
                int r = 0;
                if (t == (byte*)0) { -> 0; };
                if (this.s_has(t, g"bx\0") | this.s_has(t, g"bl\0")) { r = r `| 8; };
                if (this.s_has(t, g"r12\0")) { r = r `| 4096; };
                if (this.s_has(t, g"r13\0")) { r = r `| 8192; };
                if (this.s_has(t, g"r14\0")) { r = r `| 16384; };
                if (this.s_has(t, g"r15\0")) { r = r `| 32768; };
                -> r;
            };

            // The multiply that feeds the add or subtract u when the two become one fused multiply add: a float multiply of
            // u's block whose only user is u
            s_fmad(IRValue* v, SI* u) -> IRValue*
            {
                IRValue* r = this.s_res(v);
                SI* d;
                if (r.di == (void*)0) { -> (IRValue*)0; };
                d = (SI*)r.di;
                if (d.op != SO_BIN | d.vol | d.k != SB_FMUL) { -> (IRValue*)0; };
                if (r.nu != 1 | r.ui != (void*)u | d.bi != u.bi) { -> (IRValue*)0; };
                if (this.s_vsz(d.ty) != this.s_vsz(u.ty)) { -> (IRValue*)0; };
                -> r;
            };

            // True when v is a running sum that u's result t feeds back into: a phi that takes t, or an add or subtract
            // (up to depth steps) of one. The add of such a sum stays the cheap add of the chain a loop carries, because a
            // fused multiply add there would put the longer latency of the fused operation on every iteration.
            s_facc(IRValue* v, IRValue* t, int depth) -> bool
            {
                IRValue* r = this.s_res(v);
                SI* d;
                int i;
                if (r.di == (void*)0) { -> false; };
                d = (SI*)r.di;
                if (d.op == SO_PHI)
                {
                    i = 0;
                    while (i < d.n)
                    {
                        if (this.s_res(d.args[i]) == this.s_res(t)) { -> true; };
                        i++;
                    };
                    -> false;
                };
                if (depth <= 0 | d.op != SO_BIN) { -> false; };
                if (d.k != SB_FADD & d.k != SB_FSUB) { -> false; };
                if (this.s_facc(d.a, t, depth - 1)) { -> true; };
                -> this.s_facc(d.b, t, depth - 1);
            };

            // ==========================================================
            // SSA code generator: inline asm. Operands are bound to hardware registers the way the text emitter binds
            // them, the registers are pinned through the implicit register masks of the instruction.
            // ==========================================================

            // Hardware register number of the register index r of the text emitter's register table
            s_ahw(int r) -> int
            {
                if (r <= 2) { -> r; };
                if (r == 3) { -> 6; };
                if (r == 4) { -> 7; };
                if (r >= 5 & r <= 8) { -> r + 3; };
                if (r == 9) { -> 3; };
                -> r + 2;
            };

            // Mask of hardware registers for a mask of register indices
            s_amask(int used) -> int
            {
                int r = 0;
                int m = 0;
                while (r < 14)
                {
                    if ((used `& (1 << r)) != 0) { m = m `| (1 << this.s_ahw(r)); };
                    r++;
                };
                -> m;
            };


            // ----------------------------------------------------------
            // Element-wise float loops
            // ----------------------------------------------------------

            s_fvput(int op) -> bool
            {
                if (this.fvn >= 14) { -> false; };
                this.fvp = this.fvp `| ((i64)op << (this.fvn * 4));
                this.fvn++;
                -> true;
            };

            // Depth of the operand stack after an operation changed it by dd
            s_fvdep(int dd) -> bool
            {
                this.fvd = this.fvd + dd;
                if (this.fvd > this.fvm) { this.fvm = this.fvd; };
                -> this.fvd <= 4;
            };

            s_fvmark(SI* x) -> void
            {
                if (!this.s_pvhas(this.fvseen, (void*)x)) { pv_push(this.fvseen, (void*)x); };
                ->;
            };

            // The slot of v among the entries of a list, added when it is not there yet
            s_fvslot(PtrVec* l, IRValue* v) -> int
            {
                int i = 0;
                while (i < l.len)
                {
                    if ((IRValue*)l.items[i] == v) { -> i; };
                    i++;
                };
                pv_push(l, (void*)v);
                -> l.len - 1;
            };

            // The multiply the add or subtract u absorbs, decided as the selection of u decides it, but from the uses
            // counted now: the vector form of a loop must fuse where the loop it leaves the rest to does
            s_fvpick(SI* u) -> IRValue*
            {
                IRValue* p;
                IRValue* q;
                SI* d;
                if (SSA_OPT_FMA != 1) { -> (IRValue*)0; };
                if ((this.feat `& XF_FMA) == 0) { -> (IRValue*)0; };
                if (u.k != SB_FADD & u.k != SB_FSUB) { -> (IRValue*)0; };
                p = this.s_res(u.a);
                q = this.s_res(u.b);
                if (this.s_fvmul(p, u, q)) { -> p; };
                if (this.s_fvmul(q, u, p)) { -> q; };
                -> (IRValue*)0;
            };

            s_fvmul(IRValue* r, SI* u, IRValue* other) -> bool
            {
                SI* d;
                if (r.di == (void*)0) { -> false; };
                d = (SI*)r.di;
                if (d.op != SO_BIN | d.vol | d.k != SB_FMUL) { -> false; };
                if (d.bi != u.bi) { -> false; };
                if (this.s_vsz(d.ty) != this.s_vsz(u.ty)) { -> false; };
                if (this.s_nuse(r) != 1) { -> false; };
                -> true;
            };

            // Appends the program of the expression v of the loop body bb with index iv. False when it has a part the
            // vector form does not do.
            s_fvex(IRValue* v, IRBlock* bb, IRValue* iv) -> bool
            {
                IRValue* r = this.s_res(v);
                IRValue* base;
                IRValue* p;
                IRValue* c;
                IRValue* ix;
                SI* d;
                SI* g;
                SI* ci;
                SI* fm;
                int slot, op;
                d = this.s_bdef(bb, r);
                if (d == (SI*)0)
                {
                    // a value computed before the loop
                    if (r.ty.kind != this.fvk) { -> false; };
                    slot = this.s_fvslot(this.fvis, r);
                    if (slot > 1) { -> false; };
                    if (!this.s_fvput(4 + slot)) { -> false; };
                    -> this.s_fvdep(1);
                };
                if (d.op == SO_LOAD)
                {
                    if (d.vol | d.ty.kind != this.fvk) { -> false; };
                    g = this.s_bdef(bb, this.s_res(d.a));
                    if (g == (SI*)0) { -> false; };
                    if (g.op != SO_GEP | g.n != 1) { -> false; };
                    ix = this.s_res(g.args[0]);
                    if (ix != iv)
                    {
                        ci = this.s_bdef(bb, ix);
                        if (ci == (SI*)0) { -> false; };
                        if (ci.op != SO_CAST) { -> false; };
                        if (ci.k != SK_SEXT & ci.k != SK_ZEXT) { -> false; };
                        if (this.s_res(ci.a) != iv) { -> false; };
                        this.s_fvmark(ci);
                    };
                    base = this.s_res(g.a);
                    if (this.s_bdef(bb, base) != (SI*)0) { -> false; };
                    if (base.ty.kind != LK.PTR) { -> false; };
                    if (base.ty.elem.kind != this.fvk) { -> false; };
                    slot = this.s_fvslot(this.fvbs, base);
                    if (slot > 2) { -> false; };
                    this.s_fvmark(g);
                    this.s_fvmark(d);
                    op = slot;
                    if (slot == 0) { op = 3; };
                    if (!this.s_fvput(op)) { -> false; };
                    -> this.s_fvdep(1);
                };
                if (d.op == SO_BIN & (d.k == SB_FADD | d.k == SB_FSUB | d.k == SB_FMUL))
                {
                    if (d.ty.kind != this.fvk | d.vol) { -> false; };
                    this.s_fvmark(d);
                    if (d.k != SB_FMUL)
                    {
                        p = this.s_fvpick(d);
                        if (p != (IRValue*)0)
                        {
                            fm = (SI*)p.di;
                            this.s_fvmark(fm);
                            if (!this.s_fvex(fm.a, bb, iv)) { -> false; };
                            if (!this.s_fvex(fm.b, bb, iv)) { -> false; };
                            if (this.s_res(d.a) == p) { c = d.b; } else { c = d.a; };
                            if (!this.s_fvex(c, bb, iv)) { -> false; };
                            op = 9;
                            if (d.k == SB_FSUB)
                            {
                                if (this.s_res(d.a) == p) { op = 10; } else { op = 11; };
                            };
                            if (!this.s_fvput(op)) { -> false; };
                            -> this.s_fvdep(0 - 2);
                        };
                    };
                    if (!this.s_fvex(d.a, bb, iv)) { -> false; };
                    if (!this.s_fvex(d.b, bb, iv)) { -> false; };
                    op = 6;
                    if (d.k == SB_FSUB) { op = 7; };
                    if (d.k == SB_FMUL) { op = 8; };
                    if (!this.s_fvput(op)) { -> false; };
                    -> this.s_fvdep(0 - 1);
                };
                -> false;
            };

            // A loop that stores an expression of float elements and invariant values into an array, element by element,
            //     while (i < n) { y[i] = y[i] + k * x[i]; i++; }
            // runs whole AVX vectors first. The call is made in front of the loop and returns the elements it did, a
            // multiple of the vector length; the loop starts there. The vector form only runs when the arrays are
            // placed so that doing a vector at a time reads what the element at a time loop would read.
            s_fvec_one(GB* hb) -> bool
            {
                SI* ph; SI* cm; SI* cb; SI* x; SI* st; SI* dg; SI* pt; SI* ad; SI* tp; SI* ci;
                GB* bb; GB* pr; GB* p0; GB* p1;
                IRValue* iv; IRValue* n; IRValue* a0; IRValue* nx; IRValue* v; IRValue* dst; IRValue* ix; IRValue* sa; IRValue* sb; IRValue* i0;
                IRValue* nn; IRValue* res; IRValue* callee; IRValue* b0; IRValue* b1; IRValue* z;
                IRValue** av;
                IRType** ptv;
                IRType* ft; IRType* t64; IRType* t32;
                IRBlock* eb;
                int i, j, w, ip, il, nb, esz;
                bool ok;
                i64 prog;
                if (SSA_OPT_FVEC != 1) { -> false; };
                if ((this.feat `& XF_AVX2) == 0) { -> false; };
                if (hb.preds.len != 2) { -> false; };
                if (hb.ib.insts == (PtrVec*)0) { -> false; };
                if (hb.ib.insts.len != 3) { -> false; };
                ph = (SI*)hb.ib.insts.items[0];
                cm = (SI*)hb.ib.insts.items[1];
                cb = (SI*)hb.ib.insts.items[2];
                if (ph.op != SO_PHI | cm.op != SO_CMP | cb.op != SO_CBR) { -> false; };
                if (ph.n != 2 | cm.n != 0 | cb.k != 0) { -> false; };
                iv = ph.res;
                if (iv.ty.kind != LK.INT) { -> false; };
                w = iv.ty.width;
                if (w != 32 & w != 64) { -> false; };
                if (this.s_res(cb.a) != cm.res) { -> false; };
                if (this.s_res(cm.a) != iv | cm.k != SP_SLT) { -> false; };
                n = this.s_res(cm.b);
                if (n.ty.kind != LK.INT | n.ty.width != w) { -> false; };
                p0 = (GB*)hb.preds.items[0];
                p1 = (GB*)hb.preds.items[1];
                bb = p1;
                pr = p0;
                if (p0.preds.len == 1 & p0.succs.len == 1)
                {
                    if ((GB*)p0.preds.items[0] == hb) { bb = p0; pr = p1; };
                };
                if (bb.preds.len != 1 | bb.succs.len != 1) { -> false; };
                if ((GB*)bb.preds.items[0] != hb | (GB*)bb.succs.items[0] != hb) { -> false; };
                if (pr.succs.len != 1 | pr == hb | pr == bb) { -> false; };
                if (cb.t != bb.ib) { -> false; };
                eb = cb.f;
                if (eb == hb.ib | eb == bb.ib) { -> false; };
                ip = 0;
                il = 1;
                if (ph.blks[0] == bb.ib) { ip = 1; il = 0; };
                if (ph.blks[ip] != pr.ib | ph.blks[il] != bb.ib) { -> false; };
                a0 = this.s_res(ph.args[ip]);
                if (!this.s_cint(a0)) { -> false; };
                if (this.scv != (i64)0) { -> false; };
                nx = this.s_res(ph.args[il]);
                if (this.s_defin(n, hb.ib, bb.ib)) { -> false; };
                if (bb.ib.insts == (PtrVec*)0) { -> false; };
                nb = bb.ib.insts.len;
                if (nb < 6 | nb > 24) { -> false; };
                pt = (SI*)bb.ib.insts.items[nb - 1];
                if (pt.op != SO_BR | pt.t != hb.ib) { -> false; };
                if (this.s_prevcall(pr.ib, g"ideka.fmap\0")) { -> false; };
                tp = this.s_term(pr.ib);
                if (tp == (SI*)0) { -> false; };
                if (tp.op != SO_BR) { -> false; };
                // the one store, its destination and the value stored
                st = (SI*)0;
                j = 0;
                while (j < nb - 1)
                {
                    x = (SI*)bb.ib.insts.items[j];
                    if (x.op == SO_STORE)
                    {
                        if (st != (SI*)0) { -> false; };
                        st = x;
                    };
                    j++;
                };
                if (st == (SI*)0) { -> false; };
                if (st.vol) { -> false; };
                v = this.s_res(st.a);
                if (v.ty.kind != LK.FLOAT & v.ty.kind != LK.DOUBLE) { -> false; };
                dg = this.s_bdef(bb.ib, this.s_res(st.b));
                if (dg == (SI*)0) { -> false; };
                if (dg.op != SO_GEP | dg.n != 1) { -> false; };
                ix = this.s_res(dg.args[0]);
                ci = (SI*)0;
                if (ix != iv)
                {
                    ci = this.s_bdef(bb.ib, ix);
                    if (ci == (SI*)0) { -> false; };
                    if (ci.op != SO_CAST) { -> false; };
                    if (ci.k != SK_SEXT & ci.k != SK_ZEXT) { -> false; };
                    if (this.s_res(ci.a) != iv) { -> false; };
                };
                dst = this.s_res(dg.a);
                if (this.s_bdef(bb.ib, dst) != (SI*)0) { -> false; };
                if (dst.ty.kind != LK.PTR) { -> false; };
                if (dst.ty.elem.kind != v.ty.kind) { -> false; };
                // the expression
                this.fvk = v.ty.kind;
                this.fvp = (i64)0;
                this.fvn = 0;
                this.fvd = 0;
                this.fvm = 0;
                this.fvbs = pv_new();
                this.fvis = pv_new();
                this.fvseen = pv_new();
                pv_push(this.fvbs, (void*)dst);
                this.s_fvmark(st);
                this.s_fvmark(dg);
                if (ci != (SI*)0) { this.s_fvmark(ci); };
                ok = this.s_fvex(v, bb.ib, iv);
                if (ok & (this.fvd != 1 | this.fvn < 3)) { ok = false; };
                // everything else in the body is the step of the index
                ad = (SI*)0;
                if (ok)
                {
                    j = 0;
                    while (j < nb - 1)
                    {
                        x = (SI*)bb.ib.insts.items[j];
                        j++;
                        if (this.s_pvhas(this.fvseen, (void*)x)) { continue; };
                        if (x.op == SO_BIN & x.res != (IRValue*)0)
                        {
                            if (this.s_res(x.res) == nx) { ad = x; continue; };
                        };
                        ok = false;
                    };
                };
                if (ok & ad == (SI*)0) { ok = false; };
                if (ok)
                {
                    if (ad.k != SB_ADD | this.s_res(ad.a) != iv) { ok = false; }
                    elif (!this.s_cint(this.s_res(ad.b))) { ok = false; }
                    elif (this.scv != (i64)1) { ok = false; };
                };
                // nothing computed in the body is used behind it but the next index
                if (ok)
                {
                    j = 0;
                    while (j < nb - 1)
                    {
                        x = (SI*)bb.ib.insts.items[j];
                        j++;
                        if (x.res == (IRValue*)0) { continue; };
                        z = this.s_res(x.res);
                        if (z == nx) { continue; };
                        if (this.s_nuse(z) != this.s_buse(bb.ib, z)) { ok = false; };
                    };
                };
                if (!ok)
                {
                    pv_free(this.fvbs);
                    pv_free(this.fvis);
                    pv_free(this.fvseen);
                    -> false;
                };
                esz = 4;
                prog = this.fvp;
                if (this.fvk == LK.DOUBLE) { esz = 8; prog = prog `| ((i64)1 << 60); };
                // rewrite: the call goes before the branch of the predecessor
                t64 = this.t_int(64);
                t32 = this.t_int(32);
                this.cb = pr.ib;
                pr.ib.insts.len = pr.ib.insts.len - 1;
                nn = n;
                if (w == 32)
                {
                    nn = this.new_value(t64, g"%vr\0");
                    this.s_r_castk(SK_SEXT, n, t64, nn);
                };
                sa = dst;
                sb = dst;
                if (this.fvbs.len > 1) { sa = (IRValue*)this.fvbs.items[1]; };
                if (this.fvbs.len > 2) { sb = (IRValue*)this.fvbs.items[2]; };
                b0 = this.s_kint(t64, (u64)0);
                b1 = this.s_kint(t64, (u64)0);
                i = 0;
                while (i < this.fvis.len)
                {
                    v = (IRValue*)this.fvis.items[i];
                    z = v;
                    if (esz == 4)
                    {
                        z = this.new_value(t32, g"%vr\0");
                        this.s_r_castk(SK_BITCAST, v, t32, z);
                        v = this.new_value(t64, g"%vr\0");
                        this.s_r_castk(SK_ZEXT, z, t64, v);
                    }
                    else
                    {
                        v = this.new_value(t64, g"%vr\0");
                        this.s_r_castk(SK_BITCAST, z, t64, v);
                    };
                    if (i == 0) { b0 = v; } else { b1 = v; };
                    i++;
                };
                ptv = (IRType**)this.s_ar(56);
                ptv[0] = dst.ty;
                ptv[1] = sa.ty;
                ptv[2] = sb.ty;
                ptv[3] = t64;
                ptv[4] = t64;
                ptv[5] = t64;
                ptv[6] = t64;
                ft = this.t_func(t64, ptv, 7, false);
                callee = this.new_value(this.t_ptr(ft), g"@\"ideka.fmap\"\0");
                res = this.new_value(t64, g"%vr\0");
                av = (IRValue**)this.s_ar(56);
                av[0] = dst;
                av[1] = sa;
                av[2] = sb;
                av[3] = nn;
                av[4] = this.s_kint(t64, (u64)prog);
                av[5] = b0;
                av[6] = b1;
                this.s_r_call(callee, av, 7, res, false);
                i0 = res;
                if (w == 32)
                {
                    i0 = this.new_value(t32, g"%vr\0");
                    this.s_r_castk(SK_TRUNC, res, t32, i0);
                };
                pv_push(pr.ib.insts, (void*)tp);
                ph.args[ip] = i0;
                pv_free(this.fvbs);
                pv_free(this.fvis);
                pv_free(this.fvseen);
                -> true;
            };

            // ----------------------------------------------------------
            // Scheduling
            // ----------------------------------------------------------

            // True for the instructions the scheduler may move: they work on registers, the flags and plain memory
            // operands, and their emission keeps nothing in a scratch register across instructions
            s_sk_ok(MI* m) -> bool
            {
                int op = m.op;
                if (m.tgt >= 0) { -> false; };
                if (op == M_MOV | op == M_MOVZX | op == M_MOVSX | op == M_LEA | op == M_ALU | op == M_SHIFT | op == M_UN) { -> true; };
                if (op == M_CMP | op == M_TEST | op == M_SETCC | op == M_CMOV | op == M_FALU | op == M_FMA | op == M_FCMP) { -> true; };
                if (op == M_CVT | op == M_GX | op == M_XMOV | op == M_MOVABS | op == M_FSEL | op == M_BT) { -> true; };
                -> false;
            };

            // Cycles from the start of m to its result
            s_sk_lat(MI* m) -> int
            {
                int op = m.op;
                bool ld = false;
                if (m.o0 != (MO*)0) { if (m.o0.k == MK_MEM) { ld = true; }; };
                if (op == M_MOV | op == M_XMOV | op == M_MOVZX | op == M_MOVSX)
                {
                    if (ld) { -> 5; };
                    -> 1;
                };
                if (m.o1 != (MO*)0) { if (m.o1.k == MK_MEM & op != M_LEA) { ld = true; }; };
                if (op == M_ALU)
                {
                    if (m.cc == A_IMUL) { -> 3; };
                    if (ld) { -> 6; };
                    -> 1;
                };
                if (op == M_FALU | op == M_FMA)
                {
                    if (op == M_FALU & m.cc == SB_FDIV) { -> 13; };
                    if (ld) { -> 9; };
                    -> 4;
                };
                if (op == M_CVT) { -> 5; };
                if (op == M_GX | op == M_FCMP | op == M_FSEL) { -> 3; };
                if (op == M_UN)
                {
                    if (m.cc == U_POPCNT | m.cc == U_LZCNT | m.cc == U_TZCNT) { -> 3; };
                    -> 1;
                };
                if (ld) { -> 6; };
                -> 1;
            };

            // True when m accesses memory (a load, store or read modify write) other than computing an address
            s_sk_mem(MI* m) -> bool
            {
                if (m.op == M_LEA) { -> false; };
                if (m.o0 != (MO*)0) { if (m.o0.k == MK_MEM) { -> true; }; };
                if (m.o1 != (MO*)0) { if (m.o1.k == MK_MEM) { -> true; }; };
                if (m.o2 != (MO*)0) { if (m.o2.k == MK_MEM) { -> true; }; };
                -> false;
            };

            s_sk_wflags(MI* m) -> bool
            {
                int op = m.op;
                if (op == M_ALU | op == M_SHIFT | op == M_UN | op == M_CMP | op == M_TEST | op == M_FCMP | op == M_BT) { -> true; };
                -> false;
            };

            s_sk_rflags(MI* m) -> bool
            {
                int op = m.op;
                if (op == M_SETCC | op == M_CMOV | op == M_FSEL | op == M_JCC) { -> true; };
                -> false;
            };

            // Orders the n instructions at items[lo..] by list scheduling: of the ones whose operands are ready the one
            // with the longest chain of latencies behind it goes first. The order is kept only when it finishes sooner
            // than the one the instructions came in.
            s_sched_run(PtrVec* v, int lo, int n, bool pinjcc) -> bool
            {
                int* rd = this.s_iz(n * 10);
                int* wr = this.s_iz(n * 10);
                int* nr = this.s_iz(n);
                int* nw = this.s_iz(n);
                int* lat = this.s_iz(n);
                int* mm = this.s_iz(n);
                int* dep = this.s_iz(n * n);
                int* prio = this.s_iz(n);
                int* left = this.s_iz(n);
                int* earl = this.s_iz(n);
                int* done = this.s_iz(n);
                int* ord = this.s_iz(n);
                int* nsu = this.s_iz(n);
                int* issue = this.s_iz(n);
                void** items = (void**)v.items;
                void** keep = (void**)fmalloc((u64)(8 * n));
                MI* m;
                int i, j, k, q, a, b, t, slots, cnt, best, fin1, fin2, pin, lastw;
                bool ok, ready, mem, anydep;
                ok = true;
                i = 0;
                while (i < n)
                {
                    m = (MI*)items[lo + i];
                    this.s_scan(m);
                    if (this.nub > 8 | this.ndb > 8) { ok = false; };
                    if (ok)
                    {
                        k = 0;
                        while (k < this.nub) { rd[i * 10 + k] = this.s_phys(this.ubuf[k]); k++; };
                        nr[i] = this.nub;
                        k = 0;
                        while (k < this.ndb) { wr[i * 10 + k] = this.s_phys(this.dbuf[k]); k++; };
                        nw[i] = this.ndb;
                        if (this.s_sk_rflags(m)) { rd[i * 10 + nr[i]] = 32; nr[i]++; };
                        if (this.s_sk_wflags(m)) { wr[i * 10 + nw[i]] = 32; nw[i]++; };
                        lat[i] = this.s_sk_lat(m);
                        if (this.s_sk_mem(m)) { mm[i] = 1; };
                    };
                    i++;
                };
                if (ok)
                {
                    // dependences: dep[a * n + b] is the cycles b waits for a, or -1
                    a = 0;
                    while (a < n * n) { dep[a] = 0 - 1; a++; };
                    a = 0;
                    while (a < n)
                    {
                        b = a + 1;
                        while (b < n)
                        {
                            q = 0 - 1;
                            i = 0;
                            while (i < nw[a])
                            {
                                j = 0;
                                while (j < nr[b]) { if (wr[a * 10 + i] == rd[b * 10 + j]) { if (lat[a] > q) { q = lat[a]; }; }; j++; };
                                j = 0;
                                while (j < nw[b]) { if (wr[a * 10 + i] == wr[b * 10 + j]) { if (q < 0) { q = 0; }; }; j++; };
                                i++;
                            };
                            i = 0;
                            while (i < nr[a])
                            {
                                j = 0;
                                while (j < nw[b]) { if (rd[a * 10 + i] == wr[b * 10 + j]) { if (q < 0) { q = 0; }; }; j++; };
                                i++;
                            };
                            if (mm[a] == 1 & mm[b] == 1) { if (q < 0) { q = 0; }; };
                            dep[a * n + b] = q;
                            b++;
                        };
                        a++;
                    };
                    // the compare in front of the branch ending the block stays last, so the two fuse
                    pin = 0 - 1;
                    if (pinjcc)
                    {
                        lastw = 0 - 1;
                        i = 0;
                        while (i < n) { if (this.s_sk_wflags((MI*)items[lo + i])) { lastw = i; }; i++; };
                        if (lastw >= 0)
                        {
                            anydep = false;
                            j = lastw + 1;
                            while (j < n) { if (dep[lastw * n + j] >= 0) { anydep = true; }; j++; };
                            if (!anydep) { pin = lastw; };
                        };
                    };
                    // the longest chain behind each instruction
                    a = n - 1;
                    while (a >= 0)
                    {
                        prio[a] = lat[a];
                        b = a + 1;
                        while (b < n)
                        {
                            if (dep[a * n + b] >= 0) { if (dep[a * n + b] + prio[b] > prio[a]) { prio[a] = dep[a * n + b] + prio[b]; }; };
                            b++;
                        };
                        a--;
                    };
                    // what the order the instructions have now takes
                    fin1 = 0;
                    t = 0;
                    slots = 0;
                    a = 0;
                    while (a < n) { earl[a] = 0; a++; };
                    a = 0;
                    while (a < n)
                    {
                        if (earl[a] > t) { t = earl[a]; slots = 0; };
                        issue[a] = t;
                        if (t + lat[a] > fin1) { fin1 = t + lat[a]; };
                        b = a + 1;
                        while (b < n)
                        {
                            if (dep[a * n + b] >= 0) { if (t + dep[a * n + b] > earl[b]) { earl[b] = t + dep[a * n + b]; }; };
                            b++;
                        };
                        slots++;
                        if (slots >= 4) { t++; slots = 0; };
                        a++;
                    };
                    // list scheduling
                    a = 0;
                    while (a < n) { earl[a] = 0; left[a] = 0; done[a] = 0; a++; };
                    a = 0;
                    while (a < n)
                    {
                        b = a + 1;
                        while (b < n) { if (dep[a * n + b] >= 0) { left[b]++; }; b++; };
                        a++;
                    };
                    t = 0;
                    slots = 0;
                    cnt = 0;
                    fin2 = 0;
                    while (cnt < n)
                    {
                        best = 0 - 1;
                        // an instruction whose operands are ready now, the one with the longest chain first
                        a = 0;
                        while (a < n)
                        {
                            if (done[a] == 0 & left[a] == 0 & earl[a] <= t)
                            {
                                if (a != pin | cnt == n - 1)
                                {
                                    if (best < 0) { best = a; }
                                    elif (prio[a] > prio[best]) { best = a; };
                                };
                            };
                            a++;
                        };
                        if (best < 0)
                        {
                            // nothing is ready yet: wait for the soonest
                            q = 0 - 1;
                            a = 0;
                            while (a < n)
                            {
                                if (done[a] == 0 & left[a] == 0)
                                {
                                    if (a != pin | cnt == n - 1)
                                    {
                                        if (q < 0) { q = a; }
                                        elif (earl[a] < earl[q]) { q = a; };
                                    };
                                };
                                a++;
                            };
                            t = earl[q];
                            slots = 0;
                            best = q;
                        };
                        done[best] = 1;
                        ord[cnt] = best;
                        cnt++;
                        if (t + lat[best] > fin2) { fin2 = t + lat[best]; };
                        b = best + 1;
                        while (b < n)
                        {
                            if (dep[best * n + b] >= 0)
                            {
                                left[b]--;
                                if (t + dep[best * n + b] > earl[b]) { earl[b] = t + dep[best * n + b]; };
                            };
                            b++;
                        };
                        slots++;
                        if (slots >= 4) { t++; slots = 0; };
                    };
                    if (fin2 < fin1)
                    {
                        i = 0;
                        while (i < n) { keep[i] = items[lo + i]; i++; };
                        i = 0;
                        while (i < n) { items[lo + i] = keep[ord[i]]; i++; };
                    }
                    else { ok = false; };
                };
                ffree((byte*)keep);
                this.s_ifree(rd); this.s_ifree(wr); this.s_ifree(nr); this.s_ifree(nw); this.s_ifree(lat); this.s_ifree(mm);
                this.s_ifree(dep); this.s_ifree(prio); this.s_ifree(left); this.s_ifree(earl); this.s_ifree(done); this.s_ifree(ord);
                this.s_ifree(nsu); this.s_ifree(issue);
                -> ok;
            };

            // Schedules the runs of movable instructions of every block
            s_sched() -> void
            {
                GF* g = this.sf;
                int i, j, lo, n;
                GB* gb;
                MI* m;
                bool pin;
                i = 0;
                while (i < g.nb)
                {
                    gb = g.rpo[i];
                    i++;
                    if (gb.mi == (PtrVec*)0) { continue; };
                    j = 0;
                    lo = 0 - 1;
                    while (j <= gb.mi.len)
                    {
                        m = (MI*)0;
                        if (j < gb.mi.len) { m = (MI*)gb.mi.items[j]; };
                        if (m != (MI*)0 & lo >= 0 & j - lo < 48)
                        {
                            if (this.s_sk_ok(m)) { j++; continue; };
                        };
                        if (m != (MI*)0 & lo < 0)
                        {
                            if (this.s_sk_ok(m)) { lo = j; j++; continue; };
                        };
                        // the run lo..j-1 ends here
                        if (lo >= 0)
                        {
                            n = j - lo;
                            if (n >= 3)
                            {
                                pin = false;
                                if (m != (MI*)0) { if (m.op == M_JCC) { pin = true; }; };
                                this.s_sched_run(gb.mi, lo, n, pin);
                            };
                            lo = 0 - 1;
                            if (m != (MI*)0) { if (this.s_sk_ok(m)) { lo = j; }; };
                        };
                        j++;
                    };
                };
                ->;
            };


            // True when no instruction after position j of the block reads the flags set before the next one that sets them
            s_flag_dead(GB* gb, int j) -> bool
            {
                MI* m;
                int op;
                j++;
                while (j < gb.mi.len)
                {
                    m = (MI*)gb.mi.items[j];
                    op = m.op;
                    if (op == M_JCC | op == M_SETCC | op == M_CMOV | op == M_FSEL | op == M_ASM | op == M_TEXT | op == M_PCOPY) { -> false; };
                    if (op == M_CMP | op == M_TEST | op == M_BT | op == M_FCMP | op == M_CALL | op == M_DIV | op == M_RMW | op == M_REPMOVS | op == M_REPSTOS | op == M_CNTB | op == M_RUNB | op == M_FMAP) { -> true; };
                    if (op == M_ALU) { -> true; };
                    if (op == M_SHIFT & m.tgt != 77) { -> true; };
                    j++;
                };
                -> true;
            };

            // Removes the instructions that only compute a register nothing reads (an index plus a constant that
            // became a displacement, for one). Only moves of registers and constants, address computations and
            // extensions are touched: they have no effect but the register.
            s_mdce() -> void
            {
                GF* g = this.sf;
                int n = g.nb;
                int i, j, k, r, op, rounds, nd;
                bool changed;
                GB* gb;
                MI* m;
                int* cnt = this.s_iz(g.nvr + R_VBASE + 2);
                rounds = 0;
                changed = true;
                while (changed & rounds < 6)
                {
                    changed = false;
                    rounds++;
                    k = 0;
                    while (k < g.nvr + R_VBASE + 2) { cnt[k] = 0; k++; };
                    i = 0;
                    while (i < n)
                    {
                        gb = g.rpo[i];
                        j = 0;
                        while (j < gb.mi.len)
                        {
                            m = (MI*)gb.mi.items[j];
                            this.s_scan(m);
                            k = 0;
                            while (k < this.nub)
                            {
                                r = this.ubuf[k];
                                if (r >= R_VBASE & r < g.nvr + R_VBASE + 2) { cnt[r] = cnt[r] + 1; };
                                k++;
                            };
                            j++;
                        };
                        i++;
                    };
                    i = 0;
                    while (i < n)
                    {
                        gb = g.rpo[i];
                        j = 0;
                        while (j < gb.mi.len)
                        {
                            m = (MI*)gb.mi.items[j];
                            op = m.op;
                            if (op == M_LEA | op == M_MOVSX | op == M_MOVZX | op == M_MOV | op == M_ALU | op == M_SHIFT | op == M_UN)
                            {
                                if (op == M_MOV & m.o0 != (MO*)0)
                                {
                                    if (m.o0.k == MK_MEM) { j++; continue; };
                                };
                                if (op == M_ALU | op == M_SHIFT)
                                {
                                    if (m.o2 == (MO*)0) { j++; continue; };
                                    if (m.o2.k != MK_REG) { j++; continue; };
                                    if (!this.s_flag_dead(gb, j)) { j++; continue; };
                                }
                                elif (op == M_UN)
                                {
                                    if (m.o1 == (MO*)0) { j++; continue; };
                                    if (m.o1.k != MK_REG | m.o0.k != MK_REG) { j++; continue; };
                                    if (!this.s_flag_dead(gb, j)) { j++; continue; };
                                }
                                elif (op != M_LEA)
                                {
                                    if (m.o1 == (MO*)0) { j++; continue; };
                                    if (m.o1.k != MK_REG) { j++; continue; };
                                };
                                this.s_scan(m);
                                if (this.ndb == 1)
                                {
                                    r = this.dbuf[0];
                                    if (r >= R_VBASE & r < g.nvr + R_VBASE + 2)
                                    {
                                        if (cnt[r] == 0)
                                        {
                                            k = j;
                                            while (k < gb.mi.len - 1) { gb.mi.items[k] = gb.mi.items[k + 1]; k++; };
                                            gb.mi.len = gb.mi.len - 1;
                                            changed = true;
                                            continue;
                                        };
                                    };
                                };
                            };
                            j++;
                        };
                        i++;
                    };
                };
                this.s_ifree(cnt);
                ->;
            };


            // ==========================================================
            // The machine instruction pass. It looks at the instructions the selection made, not at the program they
            // came from, and rewrites runs of them that one instruction does. Each rule needs the registers it removes
            // to have no other reader, which the use counts of the virtual registers tell.
            //   load, then sign or zero extension of the loaded register: one extending load
            //   load, then a test of the loaded register against itself: a compare of memory with zero
            // ==========================================================
            // A store of zero to memory addressed by a register and a displacement
            // 0 when the stored immediate is zero, 1 when every bit is set, else minus one
            s_vz_v(MI* m) -> int
            {
                u64 x = this.a_mask((u64)m.o0.imm, 8 * m.sz);
                if (x == (u64)0) { -> 0; };
                if (x == this.a_mask((u64)0 - (u64)1, 8 * m.sz)) { -> 1; };
                -> 0 - 1;
            };

            s_vz_ok(MI* m) -> bool
            {
                if (m.op != M_MOV) { -> false; };
                if (m.o0 == (MO*)0 | m.o1 == (MO*)0) { -> false; };
                if (m.o0.k != MK_IMM | m.o1.k != MK_MEM) { -> false; };
                if (m.o1.sym != (byte*)0 | m.o1.r2 >= 0) { -> false; };
                if (m.sz != 1 & m.sz != 2 & m.sz != 4 & m.sz != 8) { -> false; };
                -> this.s_vz_v(m) >= 0;
            };

            // True when the instruction x can run between a load and its use without changing what the load reads: it
            // writes no memory and no register of the address, and does not read the loaded register r1
            s_ldop_ok(MI* x, MO* mem, int r1) -> bool
            {
                int op = x.op;
                int k;
                if (op != M_MOV & op != M_MOVZX & op != M_MOVSX & op != M_LEA & op != M_ALU & op != M_SHIFT & op != M_CMP & op != M_TEST & op != M_SETCC) { -> false; };
                if (op == M_MOV | op == M_MOVZX | op == M_MOVSX | op == M_LEA) { if (x.o1 == (MO*)0) { -> false; }; if (x.o1.k != MK_REG) { -> false; }; };
                if (op == M_ALU | op == M_SHIFT) { if (x.o2 == (MO*)0) { -> false; }; if (x.o2.k != MK_REG) { -> false; }; };
                this.s_scan(x);
                k = 0;
                while (k < this.nub) { if (this.ubuf[k] == r1) { -> false; }; k++; };
                k = 0;
                while (k < this.ndb)
                {
                    if (this.dbuf[k] == mem.r | this.dbuf[k] == mem.r2) { -> false; };
                    k++;
                };
                -> true;
            };

            s_xp() -> bool
            {
                GF* g = this.sf;
                int n = g.nb;
                int i, j, k, r, q, r1, run, tot, nrem, tt;
                MI* mc;
                bool any, dup;
                GB* gb;
                MI* m;
                MI* m2;
                MI* m3;
                MI* m4;
                MI* mp;
                MO* z;
                int* cnt = this.s_iz(g.nvr + R_VBASE + 2);
                any = false;
                i = 0;
                while (i < n)
                {
                    gb = g.rpo[i];
                    j = 0;
                    while (j < gb.mi.len)
                    {
                        m = (MI*)gb.mi.items[j];
                        this.s_scan(m);
                        k = 0;
                        while (k < this.nub)
                        {
                            r = this.ubuf[k];
                            dup = false;
                            q = 0;
                            while (q < k) { if (this.ubuf[q] == r) { dup = true; }; q++; };
                            if (r >= R_VBASE & r < g.nvr + R_VBASE + 2 & !dup) { cnt[r] = cnt[r] + 1; };
                            k++;
                        };
                        j++;
                    };
                    i++;
                };
                i = 0;
                while (i < n)
                {
                    gb = g.rpo[i];
                    j = 0;
                    while (j + 1 < gb.mi.len)
                    {
                        m = (MI*)gb.mi.items[j];
                        m2 = (MI*)gb.mi.items[j + 1];
                        if (SSA_OPT_VZERO == 1 & this.s_vz_ok(m))
                        {
                            // a run of zero stores to consecutive addresses
                            run = 1;
                            tot = m.sz;
                            while (j + run < gb.mi.len)
                            {
                                m3 = (MI*)gb.mi.items[j + run];
                                if (!this.s_vz_ok(m3)) { break; };
                                if (this.s_vz_v(m3) != this.s_vz_v(m)) { break; };
                                if (m3.o1.r != m.o1.r | m3.o1.fo != m.o1.fo | m3.o1.sc != m.o1.sc | m3.o1.r2 != m.o1.r2) { break; };
                                if (m3.o1.imm != m.o1.imm + (i64)tot) { break; };
                                tot = tot + m3.sz;
                                run++;
                            };
                            if (tot >= 16 & run > this.s_vz_cost(tot))
                            {
                                m3 = this.s_mi_raw(M_VZERO, tot);
                                m3.o0 = m.o1;
                                m3.tgt = this.s_vz_v(m);
                                gb.mi.items[j] = (void*)m3;
                                k = j + 1;
                                while (k + run - 1 < gb.mi.len) { gb.mi.items[k] = gb.mi.items[k + run - 1]; k++; };
                                gb.mi.len = gb.mi.len - (run - 1);
                                any = true;
                                j++;
                                continue;
                            };
                        };
                        if (SSA_OPT_ADC == 1 & j >= 1 & j + 3 < gb.mi.len & m.op == M_SETCC & (m.cc == C_B | m.cc == C_AE))
                        {
                            // cmp, setcc, movzx, maybe a widening copy, then add or sub of the 0 or 1: the carry flag goes
                            // straight into adc or sbb
                            r1 = m.o0.r;
                            nrem = 2;
                            r = r1;
                            m3 = (MI*)gb.mi.items[j + 2];
                            mp = (MI*)gb.mi.items[j - 1];
                            if (j + 3 < gb.mi.len & (m3.op == M_MOV | m3.op == M_MOVZX) & m3.o0 != (MO*)0 & m3.o1 != (MO*)0)
                            {
                                if (m3.o0.k == MK_REG & m3.o1.k == MK_REG & m3.o0.r == r1 & m3.o1.r != r1 & m3.o1.r >= R_VBASE)
                                {
                                    if (cnt[m3.o1.r] == 1)
                                    {
                                        r = m3.o1.r;
                                        nrem = 3;
                                        m3 = (MI*)gb.mi.items[j + 3];
                                    };
                                };
                            };
                            if (mp.op == M_CMP & m2.op == M_MOVZX & m3.op == M_ALU & r1 >= R_VBASE)
                            {
                                q = 2;
                                if (nrem == 3) { q = 2; };
                                if (m2.o0.k == MK_REG & m2.o1.k == MK_REG & m2.o0.r == r1 & m2.o1.r == r1 & m3.tgt < 0 & (m3.sz == 4 | m3.sz == 8) & cnt[r1] == 2)
                                {
                                    z = (MO*)0;
                                    if (m3.o0.k == MK_REG & m3.o1.k == MK_REG & m3.o2.k == MK_REG)
                                    {
                                        if (m3.cc == A_ADD & m3.o1.r == r & m3.o0.r != r) { z = m3.o0; }
                                        elif (m3.cc == A_ADD & m3.o0.r == r & m3.o1.r != r) { z = m3.o1; }
                                        elif (m3.cc == A_SUB & m3.o1.r == r & m3.o0.r != r) { z = m3.o0; };
                                    };
                                    if (z != (MO*)0)
                                    {
                                        m4 = this.s_mi_raw(M_ALU, m3.sz);
                                        m4.cc = m3.cc;
                                        m4.o0 = z;
                                        m4.o1 = this.s_mo_i((i64)0);
                                        m4.o2 = m3.o2;
                                        if (m3.cc == A_ADD) { if (m.cc == C_B) { m4.tgt = 93; } else { m4.tgt = 95; }; }
                                        else { if (m.cc == C_B) { m4.tgt = 94; } else { m4.tgt = 96; }; };
                                        gb.mi.items[j] = (void*)m4;
                                        k = j + 1;
                                        while (k + nrem - 1 < gb.mi.len) { gb.mi.items[k] = gb.mi.items[k + nrem]; k++; };
                                        gb.mi.len = gb.mi.len - nrem;
                                        any = true;
                                        j++;
                                        continue;
                                    };
                                };
                            };
                        };
                        if (SSA_OPT_SETZ == 1 & j >= 1 & m.op == M_SETCC & m.o1 == (MO*)0 & m2.op == M_MOVZX)
                        {
                            // cmp, setcc, movzx: the register is zeroed before the compare instead, which takes the
                            // extension off the dependency chain
                            mp = (MI*)gb.mi.items[j - 1];
                            r1 = m.o0.r;
                            if ((mp.op == M_CMP | mp.op == M_TEST) & r1 >= R_VBASE & m2.o0.k == MK_REG & m2.o1.k == MK_REG & m2.o0.r == r1 & m2.o1.r == r1 & m2.sz == 1)
                            {
                                m3 = this.s_mi_raw(M_MOV, 4);
                                m3.o0 = this.s_mo_i((i64)0);
                                m3.o1 = this.s_mo_r(r1, 4);
                                m.o1 = this.s_mo_r(r1, 4);
                                pv_push(gb.mi, (void*)m3);
                                k = gb.mi.len - 1;
                                while (k > j - 1) { gb.mi.items[k] = gb.mi.items[k - 1]; k--; };
                                gb.mi.items[j - 1] = (void*)m3;
                                k = j + 2;
                                while (k < gb.mi.len - 1) { gb.mi.items[k] = gb.mi.items[k + 1]; k++; };
                                gb.mi.len = gb.mi.len - 1;
                                if (j + 2 < gb.mi.len)
                                {
                                    // a further byte extension of the same register has nothing left to clear
                                    m4 = (MI*)gb.mi.items[j + 2];
                                    if (m4.op == M_MOVZX & m4.sz == 1 & m4.o0 != (MO*)0 & m4.o1 != (MO*)0)
                                    {
                                        if (m4.o0.k == MK_REG & m4.o1.k == MK_REG & m4.o0.r == r1 & m4.o1.sz == 4)
                                        {
                                            m4.op = M_MOV;
                                            m4.sz = 4;
                                            m4.o0 = this.s_mo_r(r1, 4);
                                        };
                                    };
                                };
                                any = true;
                                j = j + 2;
                                continue;
                            };
                        };
                        if (SSA_OPT_LDOP == 1 & m.op == M_MOV & m.o0 != (MO*)0 & m.o1 != (MO*)0 & (m.sz == 4 | m.sz == 8))
                        {
                            // a load read once by a nearby add, sub, and, or, xor, imul or compare: the instruction reads
                            // memory itself
                            if (m.o0.k == MK_MEM & m.o1.k == MK_REG & m.cc != 1 & m.o1.r >= R_VBASE)
                            {
                                r1 = m.o1.r;
                                if (cnt[r1] == 1 & m.o0.sym == (byte*)0)
                                {
                                    tt = 1;
                                    mc = (MI*)0;
                                    while (tt <= 4 & j + tt < gb.mi.len)
                                    {
                                        m3 = (MI*)gb.mi.items[j + tt];
                                        if (m3.sz == m.sz & m3.o0 != (MO*)0 & m3.o1 != (MO*)0)
                                        {
                                            if (m3.op == M_ALU & m3.tgt < 0 & m3.o2 != (MO*)0 & (m3.cc == A_ADD | m3.cc == A_SUB | m3.cc == A_AND | m3.cc == A_OR | m3.cc == A_XOR | m3.cc == A_IMUL))
                                            {
                                                if (m3.o0.k == MK_REG & m3.o1.k == MK_REG & m3.o2.k == MK_REG & m3.o2.r != r1)
                                                {
                                                    if (m3.o1.r == r1 & m3.o0.r != r1) { mc = m3; }
                                                    elif (m3.cc != A_SUB & m3.o0.r == r1 & m3.o1.r != r1) { mc = m3; z = m3.o0; m3.o0 = m3.o1; m3.o1 = z; };
                                                };
                                            };
                                            if (m3.op == M_CMP & mc == (MI*)0)
                                            {
                                                if (m3.o0.k == MK_REG & m3.o1.k == MK_REG & m3.o1.r == r1 & m3.o0.r != r1) { mc = m3; };
                                            };
                                        };
                                        if (mc != (MI*)0) { break; };
                                        if (!this.s_ldop_ok(m3, m.o0, r1)) { break; };
                                        tt++;
                                    };
                                    if (mc != (MI*)0)
                                    {
                                        mc.o1 = m.o0;
                                        k = j;
                                        while (k < gb.mi.len - 1) { gb.mi.items[k] = gb.mi.items[k + 1]; k++; };
                                        gb.mi.len = gb.mi.len - 1;
                                        any = true;
                                        continue;
                                    };
                                };
                            };
                        };
                        if (m.op == M_MOVZX & m.sz == 1 & m.o0 != (MO*)0 & m.o1 != (MO*)0)
                        {
                            // a zero extending byte load only tested: compare the byte in memory with zero
                            if (m.o0.k == MK_MEM & m.o1.k == MK_REG & m.cc != 1 & m2.op == M_TEST & m2.sz == 1 & m2.o0 != (MO*)0 & m2.o1 != (MO*)0)
                            {
                                r1 = m.o1.r;
                                if (r1 >= R_VBASE & cnt[r1] == 1 & m2.o0.k == MK_REG & m2.o1.k == MK_REG & m2.o0.r == r1 & m2.o1.r == r1)
                                {
                                    z = this.s_mo_i((i64)0);
                                    m2.op = M_CMP;
                                    m2.o0 = m.o0;
                                    m2.o1 = z;
                                    k = j;
                                    while (k < gb.mi.len - 1) { gb.mi.items[k] = gb.mi.items[k + 1]; k++; };
                                    gb.mi.len = gb.mi.len - 1;
                                    any = true;
                                    continue;
                                };
                            };
                        };
                        if (m.op == M_MOV & m.o0 != (MO*)0 & m.o1 != (MO*)0)
                        {
                            if (m.o0.k == MK_MEM & m.o1.k == MK_REG & m.cc != 1)
                            {
                                r1 = m.o1.r;
                                if (r1 >= R_VBASE & cnt[r1] == 1)
                                {
                                    // the loaded register is read by the extension only
                                    if ((m2.op == M_MOVSX | m2.op == M_MOVZX) & m2.sz == m.sz & m2.o0 != (MO*)0)
                                    {
                                        if (m2.o0.k == MK_REG & m2.o0.r == r1 & (m.sz == 1 | m.sz == 2 | m.sz == 4))
                                        {
                                            m2.o0 = m.o0;
                                            k = j;
                                            while (k < gb.mi.len - 1) { gb.mi.items[k] = gb.mi.items[k + 1]; k++; };
                                            gb.mi.len = gb.mi.len - 1;
                                            any = true;
                                            continue;
                                        };
                                    };
                                    if (m2.op == M_TEST & m2.sz == m.sz & m2.o0 != (MO*)0 & m2.o1 != (MO*)0 & (m.sz == 1 | m.sz == 4 | m.sz == 8))
                                    {
                                        if (m2.o0.k == MK_REG & m2.o1.k == MK_REG & m2.o0.r == r1 & m2.o1.r == r1)
                                        {
                                            z = this.s_mo_i((i64)0);
                                            m2.op = M_CMP;
                                            m2.o0 = m.o0;
                                            m2.o1 = z;
                                            k = j;
                                            while (k < gb.mi.len - 1) { gb.mi.items[k] = gb.mi.items[k + 1]; k++; };
                                            gb.mi.len = gb.mi.len - 1;
                                            any = true;
                                            continue;
                                        };
                                    };
                                };
                            };
                        };
                        j++;
                    };
                    i++;
                };
                this.s_ifree(cnt);
                -> any;
            };

            // Block fill of an array: the value over count elements
            s_isel_fill(SI* x) -> void
            {
                IRValue* cv = this.s_res(x.c);
                MO* a0;
                MO* a1;
                int r, t1, t2, t3, sh;
                MI* m;
                a0 = this.s_src(x.a);
                if (x.op == SO_COPY | x.sz == 1) { a1 = this.s_src(x.b); } else { a1 = this.s_mo_i((i64)0); };
                r = this.s_reg(cv);
                if (cv.ty.width < 64) { r = this.s_ext(r, 4, (x.k `& 1) == 1, 8); };
                if ((x.k `& 1) == 1)
                {
                    // a negative count stores nothing
                    t1 = this.s_nv(0);
                    this.s_mi3c(M_SHIFT, 8, this.s_mo_r(r, 8), this.s_mo_i((i64)63), this.s_mo_r(t1, 8), S_SAR);
                    t2 = this.s_nv(0);
                    m = this.s_mi2(M_UN, 8, this.s_mo_r(t1, 8), this.s_mo_r(t2, 8));
                    m.cc = U_NOT;
                    t3 = this.s_nv(0);
                    this.s_mi3c(M_ALU, 8, this.s_mo_r(r, 8), this.s_mo_r(t2, 8), this.s_mo_r(t3, 8), A_AND);
                    r = t3;
                };
                sh = this.s_pow2((i64)x.sz);
                if (sh > 0)
                {
                    t1 = this.s_nv(0);
                    this.s_mi3c(M_SHIFT, 8, this.s_mo_r(r, 8), this.s_mo_i((i64)sh), this.s_mo_r(t1, 8), S_SHL);
                    r = t1;
                };
                if (x.op == SO_COPY)
                {
                    this.s_mov(a0, 7, 8);
                    this.s_mov(a1, 6, 8);
                    this.s_mov(this.s_mo_r(r, 8), 1, 8);
                    m = this.s_mi(M_REPMOVS, 1);
                    m.iu = 194;
                    m.id = 194;
                    if (x.k >= 2)
                    {
                        // reversed element order: rax and rdx are scratch as well
                        m.cc = 7;
                        m.tgt = x.sz;
                        m.iu = 199;
                        m.id = 199;
                    };
                    ->;
                };
                this.s_mov(a0, 7, 8);
                this.s_mov(this.s_mo_r(r, 8), 1, 8);
                this.s_mov(a1, 0, 4);
                m = this.s_mi(M_REPSTOS, 1);
                m.iu = 131;
                m.id = 131;
                ->;
            };

            // A block that only branches on a phi: each predecessor that supplies a constant, or a widened truth
            // value, branches to the final targets itself. Returns true when an edge was moved.
            s_thread() -> bool
            {
                GF* g = this.sf;
                bool any = false;
                int i, p, np, ni, w;
                GB* gb;
                IRBlock* tb;
                IRBlock* q;
                SI* ph;
                SI* cm;
                SI* cb;
                SI* qt;
                SI* d;
                IRValue* pv;
                IRValue* v;
                IRBlock* tt;
                IRBlock* ff;
                IRBlock* a;
                IRBlock* b;
                bool flip, nz, tphi;
                i = 1;
                while (i < g.nb)
                {
                    gb = (GB*)g.bl.items[i];
                    tb = gb.ib;
                    i++;
                    if (tb.insts == (PtrVec*)0) { continue; };
                    ni = tb.insts.len;
                    if (ni != 2 & ni != 3) { continue; };
                    ph = (SI*)tb.insts.items[0];
                    cb = (SI*)tb.insts.items[ni - 1];
                    if (ph.op != SO_PHI | cb.op != SO_CBR) { continue; };
                    if (ph.res.ty.kind != LK.INT) { continue; };
                    pv = ph.res;
                    cm = (SI*)0;
                    flip = false;
                    if (ni == 3)
                    {
                        cm = (SI*)tb.insts.items[1];
                        if (cm.op != SO_CMP | cm.n != 0) { continue; };
                        if (cm.k != SP_NE & cm.k != SP_EQ) { continue; };
                        if (this.s_res(cm.a) != pv) { continue; };
                        if (!this.s_cint(this.s_res(cm.b))) { continue; };
                        if (this.scv != (i64)0) { continue; };
                        if (this.s_res(cb.a) != cm.res) { continue; };
                        if (cm.k == SP_EQ) { flip = true; };
                        if (this.s_nuse(cm.res, cb, (SI*)0) != 0) { continue; };
                    }
                    else
                    {
                        if (pv.ty.width != 1) { continue; };
                        if (this.s_res(cb.a) != pv) { continue; };
                    };
                    if (this.s_nuse(pv, cm, cb) != 0) { continue; };
                    if (cb.t == tb | cb.f == tb) { continue; };
                    // the final targets must not take values from this block
                    a = cb.t;
                    b = cb.f;
                    if (a.insts == (PtrVec*)0 | b.insts == (PtrVec*)0) { continue; };
                    if (a.insts.len == 0 | b.insts.len == 0) { continue; };
                    tphi = ((SI*)a.insts.items[0]).op == SO_PHI | ((SI*)b.insts.items[0]).op == SO_PHI;
                    if (tphi & (SSA_OPT_THRPHI != 1 | a == b)) { continue; };
                    // the block reached when the phi is nonzero, then when it is zero
                    if ((cb.k == 1) != flip) { tt = b; ff = a; } else { tt = a; ff = b; };
                    p = 0;
                    while (p < ph.n)
                    {
                        q = ph.blks[p];
                        v = this.s_res(ph.args[p]);
                        p++;
                        if (q == tb) { continue; };
                        qt = this.s_term(q);
                        if (qt == (SI*)0) { continue; };
                        if (qt.op == SO_CBR)
                        {
                            // one arm of a conditional branch goes to this block
                            if (qt.t == qt.f) { continue; };
                            if (this.s_cint(v))
                            {
                                nz = this.scv != (i64)0;
                                a = ff;
                                if (nz) { a = tt; };
                                if (tphi)
                                {
                                    if (!this.s_thr_ok(a, tb, q, pv, cm)) { continue; };
                                    this.s_thr_apply(a, tb, q, pv, v);
                                };
                                if (qt.t == tb) { qt.t = a; } elif (qt.f == tb) { qt.f = a; };
                                any = true;
                            };
                            continue;
                        };
                        if (qt.op != SO_BR) { continue; };
                        if (qt.t != tb) { continue; };
                        if (this.s_cint(v))
                        {
                            nz = this.scv != (i64)0;
                            a = ff;
                            if (nz) { a = tt; };
                            if (tphi)
                            {
                                if (!this.s_thr_ok(a, tb, q, pv, cm)) { continue; };
                                this.s_thr_apply(a, tb, q, pv, v);
                            };
                            qt.t = a;
                            any = true;
                            continue;
                        };
                        w = v.ty.width;
                        if (tphi & w == 1 & v.ty.kind == LK.INT & tt != ff)
                        {
                            if (this.s_thr_ok(tt, tb, q, pv, cm) & this.s_thr_ok(ff, tb, q, pv, cm))
                            {
                                this.s_thr_apply(tt, tb, q, pv, this.s_kint(pv.ty, (u64)1));
                                this.s_thr_apply(ff, tb, q, pv, this.s_kint(pv.ty, (u64)0));
                                qt.op = SO_CBR;
                                qt.a = v;
                                qt.t = tt;
                                qt.f = ff;
                                qt.k = 0;
                                any = true;
                            };
                            continue;
                        };
                        if (tphi) { continue; };
                        if (w == 1 & v.ty.kind == LK.INT)
                        {
                            qt.op = SO_CBR;
                            qt.a = v;
                            qt.t = tt;
                            qt.f = ff;
                            qt.k = 0;
                            any = true;
                            continue;
                        };
                        if (v.di != (void*)0)
                        {
                            d = (SI*)v.di;
                            if (d.op == SO_CAST & d.res == v & d.k == SK_ZEXT)
                            {
                                if (d.a.ty.kind == LK.INT & d.a.ty.width == 1)
                                {
                                    qt.op = SO_CBR;
                                    qt.a = d.a;
                                    qt.t = tt;
                                    qt.f = ff;
                                    qt.k = 0;
                                    any = true;
                                };
                            };
                        };
                    };
                };
                if (SSA_OPT_RETTHR == 1) { if (this.s_retthr()) { any = true; }; };
                -> any;
            };

            // ----------------------------------------------------------
            // Machine operands and instructions
            // ----------------------------------------------------------

            s_mo(int k) -> MO*
            {
                MO* o = (MO*)this.s_ar((int)(((sizeof(MO) + 7) / 8) * 2));
                o.k = k;
                o.r = 0 - 1;
                o.r2 = 0 - 1;
                o.sc = 1;
                o.sz = 8;
                o.fo = 0 - 1;
                o.imm = (i64)0;
                o.sym = (byte*)0;
                -> o;
            };

            s_mo_r(int r, int sz) -> MO*
            {
                MO* o = this.s_mo(MK_REG);
                o.r = r;
                o.sz = sz;
                -> o;
            };

            s_mo_i(i64 v) -> MO*
            {
                MO* o = this.s_mo(MK_IMM);
                o.imm = v;
                -> o;
            };

            s_mo_sym(byte* s) -> MO*
            {
                MO* o = this.s_mo(MK_SYM);
                o.sym = s;
                -> o;
            };

            s_mo_blk(int id) -> MO*
            {
                MO* o = this.s_mo(MK_BLK);
                o.imm = (i64)id;
                -> o;
            };

            // Memory operand: base register (-1 none), index register (-1 none) times sc, displacement,
            // symbol (rip relative) or frame object (-1 none)
            s_mo_mem(int base, int idx, int sc, i64 disp, byte* sym, int fo) -> MO*
            {
                MO* o = this.s_mo(MK_MEM);
                o.r = base;
                o.r2 = idx;
                o.sc = sc;
                o.imm = disp;
                o.sym = sym;
                o.fo = fo;
                -> o;
            };

            s_mo_copy(MO* s) -> MO*
            {
                MO* o = this.s_mo(s.k);
                o.r = s.r;
                o.r2 = s.r2;
                o.sc = s.sc;
                o.sz = s.sz;
                o.fo = s.fo;
                o.imm = s.imm;
                o.sym = s.sym;
                -> o;
            };

            s_mi(int op, int sz) -> MI*
            {
                MI* m = (MI*)this.s_ar((int)(((sizeof(MI) + 7) / 8) * 2));
                m.op = op;
                m.sz = sz;
                m.cc = 0;
                m.iu = 0;
                m.id = 0;
                m.clob = 0;
                m.dying = 0;
                m.ddead = 0;
                m.tgt = 0 - 1;
                m.o0 = (MO*)0;
                m.o1 = (MO*)0;
                m.o2 = (MO*)0;
                m.o3 = (MO*)0;
                m.text = (byte*)0;
                pv_push(this.scb.mi, (void*)m);
                -> m;
            };

            // An instruction that is in no list yet
            s_mi_raw(int op, int sz) -> MI*
            {
                MI* m = (MI*)this.s_ar((int)(((sizeof(MI) + 7) / 8) * 2));
                m.op = op;
                m.sz = sz;
                m.cc = 0;
                m.iu = 0;
                m.id = 0;
                m.clob = 0;
                m.dying = 0;
                m.ddead = 0;
                m.tgt = 0 - 1;
                m.o0 = (MO*)0;
                m.o1 = (MO*)0;
                m.o2 = (MO*)0;
                m.o3 = (MO*)0;
                m.text = (byte*)0;
                -> m;
            };

            s_mi1(int op, int sz, MO* a) -> MI*
            {
                MI* m = this.s_mi(op, sz);
                m.o0 = a;
                -> m;
            };

            s_mi2(int op, int sz, MO* a, MO* b) -> MI*
            {
                MI* m = this.s_mi(op, sz);
                m.o0 = a;
                m.o1 = b;
                -> m;
            };

            s_mi3(int op, int sz, MO* a, MO* b, MO* c) -> MI*
            {
                MI* m = this.s_mi(op, sz);
                m.o0 = a;
                m.o1 = b;
                m.o2 = c;
                -> m;
            };

            // Three operand instruction with its kind or condition in cc
            s_mi3c(int op, int sz, MO* a, MO* b, MO* c, int cc) -> MI*
            {
                MI* m = this.s_mi3(op, sz, a, b, c);
                m.cc = cc;
                -> m;
            };

            // ----------------------------------------------------------
            // Moves and constants
            // ----------------------------------------------------------

            // Register to register or immediate to register move of sz bytes
            s_mov(MO* src, int dst, int sz) -> void
            {
                MI* m;
                if (src.k == MK_IMM)
                {
                    if (src.imm >= (i64)-2147483648 & src.imm <= (i64)4294967295 & sz <= 4)
                    {
                        this.s_mi2(M_MOV, 4, src, this.s_mo_r(dst, 4));
                        ->;
                    };
                    if (src.imm >= (i64)-2147483648 & src.imm <= (i64)2147483647)
                    {
                        this.s_mi2(M_MOV, 8, src, this.s_mo_r(dst, 8));
                        ->;
                    };
                    this.s_mi2(M_MOVABS, 8, src, this.s_mo_r(dst, 8));
                    ->;
                };
                m = this.s_mi2(M_MOV, sz, src, this.s_mo_r(dst, sz));
                ->;
            };

            // Virtual register holding the 64 bit constant v
            s_imm(i64 v) -> int
            {
                int d = this.s_nv(0);
                this.s_mov(this.s_mo_i(v), d, 8);
                -> d;
            };

            // New register holding register r of sz bytes extended to to bytes (4 or 8)
            s_ext(int r, int sz, bool sgn, int to) -> int
            {
                int d;
                MI* m;
                if (sz >= 8) { -> r; };
                d = this.s_nv(0);
                if (sgn)
                {
                    if (sz == 4)
                    {
                        m = this.s_mi2(M_MOVSX, 4, this.s_mo_r(r, 4), this.s_mo_r(d, 8));
                        m.cc = 8;
                        -> d;
                    };
                    m = this.s_mi2(M_MOVSX, sz, this.s_mo_r(r, sz), this.s_mo_r(d, to));
                    m.cc = to;
                    -> d;
                };
                if (sz == 4)
                {
                    this.s_mov(this.s_mo_r(r, 4), d, 4);
                    -> d;
                };
                this.s_mi2(M_MOVZX, sz, this.s_mo_r(r, sz), this.s_mo_r(d, 4));
                -> d;
            };

            // Operand for the value v: a register, or an immediate that fits 32 bits
            s_src(IRValue* p) -> MO*
            {
                IRValue* v = this.s_res(p);
                SI* d;
                int r;
                if (v.vr >= R_VBASE) { -> this.s_mo_r(v.vr, this.s_vsz(v.ty)); };
                if (v.fo > 0) { -> this.s_mo_r(this.s_lea(this.s_mo_mem(0 - 1, 0 - 1, 1, (i64)0, (byte*)0, v.fo - 1)), 8); };
                if (v.di != (void*)0 & !v.kc)
                {
                    d = (SI*)v.di;
                    if (d.flag & d.op == SO_GEP)
                    {
                        r = this.s_lea(this.s_gepmem(d));
                        if (this.bf_w > 0) { this.s_fail(g"address of a bit packed member\0"); };
                        -> this.s_mo_r(r, 8);
                    };
                    if (d.flag & d.op == SO_CMP)
                    {
                        -> this.s_mo_r(this.s_cmpval(d), 1);
                    };
                    this.s_fail(g"value without register\0");
                    -> this.s_mo_i((i64)0);
                };
                if (this.s_isc(v))
                {
                    if (this.sck == CK_SYM)
                    {
                        if (this.scv == (i64)0) { -> this.s_mo_r(this.s_lea(this.s_mo_mem(0 - 1, 0 - 1, 1, (i64)0, this.scs, 0 - 1)), 8); };
                        -> this.s_mo_r(this.s_lea(this.s_mo_mem(0 - 1, 0 - 1, 1, this.scv, this.scs, 0 - 1)), 8);
                    };
                    if (this.sck == CK_INT)
                    {
                        if (this.scv >= (i64)-2147483648 & this.scv <= (i64)2147483647) { -> this.s_mo_i(this.scv); };
                        -> this.s_mo_r(this.s_imm(this.scv), 8);
                    };
                    if (this.sck == CK_FP) { -> this.s_fconst(v); };
                    this.s_fail(g"aggregate constant\0");
                    -> this.s_mo_i((i64)0);
                };
                if (v.vr == 0 & v.fo == 0) { this.s_fail(g"operand without definition\0"); };
                -> this.s_mo_i((i64)0);
            };

            // Operand that must be a register
            s_reg(IRValue* v) -> int
            {
                MO* o = this.s_src(v);
                if (o.k == MK_REG) { -> o.r; };
                -> this.s_imm(o.imm);
            };

            // Register for operand o, immediates are moved into a new one
            s_oreg(MO* o) -> int
            {
                if (o.k == MK_REG) { -> o.r; };
                -> this.s_imm(o.imm);
            };

            // Address of memory operand m in a new register
            s_lea(MO* m) -> int
            {
                int d = this.s_nv(0);
                this.s_mi2(M_LEA, 8, this.s_mo_copy(m), this.s_mo_r(d, 8));
                -> d;
            };

            // Adds a scaled index register to the address in m. The scale is applied by lea when it is 1 2 4 8.
            s_addidx(MO* m, IRValue* ix, int esz) -> void
            {
                IRValue* v = this.s_res(ix);
                int w, r, t;
                bool sgn = true;
                int sc;
                MI* mi;
                w = 64;
                if (v.ty.kind == LK.INT) { w = v.ty.width; };
                if (this.s_isc(v))
                {
                    if (this.sck == CK_INT)
                    {
                        // sign extend a narrow constant from its width
                        t = (int)this.scv;
                        if (w == 32) { m.imm = m.imm + (i64)t * (i64)esz; }
                        else
                        {
                            if (w < 32)
                            {
                                if (w == 8 & t >= 128) { t = t - 256; };
                                if (w == 16 & t >= 32768) { t = t - 65536; };
                                if (w == 1) { };
                                m.imm = m.imm + (i64)t * (i64)esz;
                            }
                            else { m.imm = m.imm + this.scv * (i64)esz; };
                        };
                        ->;
                    };
                    this.s_fail(g"index constant\0");
                    ->;
                };
                if (SSA_OPT_IDXOFF == 1 & w == 64 & v.di != (void*)0 & m.r2 < 0 & (esz == 1 | esz == 2 | esz == 4 | esz == 8))
                {
                    // an index plus a constant becomes a displacement
                    SI* dd = (SI*)v.di;
                    if (dd.op == SO_BIN & dd.k == SB_ADD & dd.res != (IRValue*)0)
                    {
                        if (this.s_cint(this.s_res(dd.b)) & !this.s_isc(this.s_res(dd.a)) & this.scv > (i64)0 - (i64)65536 & this.scv < (i64)65536)
                        {
                            m.imm = m.imm + this.scv * (i64)esz;
                            this.s_addidx(m, dd.a, esz);
                            ->;
                        };
                    };
                };
                if (m.sym != (byte*)0 & !(SSA_OPT_ABSIDX == 1 & !this.a_win() & m.r2 < 0 & (esz == 1 | esz == 2 | esz == 4 | esz == 8)))
                {
                    // a symbol is addressed relative to rip, it cannot take an index
                    t = this.s_lea(m);
                    m.r = t;
                    m.sym = (byte*)0;
                    m.imm = (i64)0;
                };
                // the index is a signed integer of its own width
                if (w < 64)
                {
                    if (this.ec_v == v) { r = this.ec_r; }
                    else
                    {
                        r = this.s_ext(this.s_reg(v), this.s_vsz(v.ty), true, 8);
                        this.ec_v = v;
                        this.ec_r = r;
                    };
                }
                else { r = this.s_reg(v); };
                if (m.r2 >= 0)
                {
                    // already an index: fold into the base
                    t = this.s_lea(m);
                    m.r = t;
                    m.r2 = 0 - 1;
                    m.sc = 1;
                    m.fo = 0 - 1;
                    m.sym = (byte*)0;
                    m.imm = (i64)0;
                };
                if (esz == 1 | esz == 2 | esz == 4 | esz == 8)
                {
                    m.r2 = r;
                    m.sc = esz;
                    ->;
                };
                if (SSA_OPT_LEASTRIDE == 1)
                {
                    // a stride of 3, 5 or 9 times 1, 2, 4 or 8: one lea makes the index times 3, 5 or 9 and the address takes the rest
                    sc = 0;
                    if (esz % 8 == 0) { sc = 8; } elif (esz % 4 == 0) { sc = 4; } elif (esz % 2 == 0) { sc = 2; } else { sc = 1; };
                    t = esz / sc;
                    if (t == 3 | t == 5 | t == 9)
                    {
                        sc = this.s_lea(this.s_mo_mem(r, r, t - 1, (i64)0, (byte*)0, 0 - 1));
                        m.r2 = sc;
                        m.sc = esz / t;
                        ->;
                    };
                };
                t = this.s_nv(0);
                sc = this.s_pow2((i64)esz);
                if (sc > 0) { this.s_mi3c(M_SHIFT, 8, this.s_mo_r(r, 8), this.s_mo_i((i64)sc), this.s_mo_r(t, 8), S_SHL); }
                else
                {
                    mi = this.s_mi3(M_ALU, 8, this.s_mo_r(r, 8), this.s_mo_i((i64)esz), this.s_mo_r(t, 8));
                    mi.cc = A_IMUL;
                };
                m.r2 = t;
                m.sc = 1;
                ->;
            };

            // Memory operand for the address a GEP computes
            s_gepmem(SI* x) -> MO*
            {
                IRValue* p = this.s_res(x.a);
                IRType* cur = p.ty.elem;
                this.bf_w = 0;
                MO* m = this.s_addr(p);
                int i, k;
                IRValue* ix;
                IRValue* rx;
                int bo;
                if (this.bf_w > 0) { this.s_fail(g"address of a bit packed member\0"); -> m; };
                // first index steps over whole pointees
                this.s_addidx(m, x.args[0], this.a_size(cur));
                i = 1;
                while (i < x.n)
                {
                    ix = x.args[i];
                    if (cur.kind == LK.STRUCT | cur.kind == LK.ISTRUCT)
                    {
                        rx = this.s_res(ix);
                        if (!this.s_isc(rx)) { this.s_fail(g"struct index\0"); ->m; };
                        k = (int)this.scv;
                        this.bf_ok = true;
                        m.imm = m.imm + (i64)this.a_foff(cur, k);
                        this.bf_ok = false;
                        if (cur.lbits > 0 & cur.loff != (int*)0)
                        {
                            bo = cur.loff[k] % 8;
                            if (this.a_bitw(cur.items[k]) | bo != 0)
                            {
                                if (cur.items[k].kind == LK.INT & i == x.n - 1 & cur.items[k].width <= 64)
                                {
                                    this.bf_sh = bo;
                                    this.bf_w = cur.items[k].width;
                                }
                                else { this.s_fail(g"member not on a byte boundary\0"); };
                            };
                        };
                        cur = cur.items[k];
                    }
                    else
                    {
                        if (cur.kind == LK.ARRAY)
                        {
                            this.s_addidx(m, ix, this.a_size(cur.elem));
                            cur = cur.elem;
                        }
                        else
                        {
                            this.s_fail(g"gep type\0");
                            -> m;
                        };
                    };
                    i++;
                };
                -> m;
            };

            // ==========================================================
            // instruction selection of the integer and pointer operations.
            // ==========================================================

            // Condition code of integer predicate p
            s_cc(int p) -> int
            {
                if (p == SP_EQ) { -> C_E; };
                if (p == SP_NE) { -> C_NE; };
                if (p == SP_ULT) { -> C_B; };
                if (p == SP_ULE) { -> C_BE; };
                if (p == SP_UGT) { -> C_A; };
                if (p == SP_UGE) { -> C_AE; };
                if (p == SP_SLT) { -> C_L; };
                if (p == SP_SLE) { -> C_LE; };
                if (p == SP_SGT) { -> C_G; };
                -> C_GE;
            };

            // Condition code with the opposite meaning
            s_invcc(int c) -> int
            {
                if (c == C_E) { -> C_NE; };
                if (c == C_NE) { -> C_E; };
                if (c == C_B) { -> C_AE; };
                if (c == C_AE) { -> C_B; };
                if (c == C_BE) { -> C_A; };
                if (c == C_A) { -> C_BE; };
                if (c == C_L) { -> C_GE; };
                if (c == C_GE) { -> C_L; };
                if (c == C_LE) { -> C_G; };
                if (c == C_G) { -> C_LE; };
                if (c == C_P) { -> C_NP; };
                if (c == C_NP) { -> C_P; };
                if (c == C_S) { -> C_NS; };
                -> C_S;
            };

            // Operand for v used with an operation of sz bytes: an immediate when it fits the instruction
            s_srci(IRValue* p, int sz) -> MO*
            {
                IRValue* v = this.s_res(p);
                if (v.vr == 0 & v.fo == 0 & (v.di == (void*)0 | v.kc))
                {
                    if (this.s_isc(v))
                    {
                        if (this.sck == CK_INT)
                        {
                            if (sz < 8)
                            {
                                if (this.scv >= (i64)-2147483648 & this.scv <= (i64)4294967295) { -> this.s_mo_i(this.scv); };
                            }
                            else
                            {
                                if (this.scv >= (i64)-2147483648 & this.scv <= (i64)2147483647) { -> this.s_mo_i(this.scv); };
                            };
                            -> this.s_mo_r(this.s_imm(this.scv), 8);
                        };
                    };
                };
                -> this.s_src(p);
            };

            // ----------------------------------------------------------
            // Comparisons
            // ----------------------------------------------------------

            // Emits the flag setting instruction of the integer compare x and returns the condition code
            // that holds when the compare is true
            s_cmpflags(SI* x) -> int
            {
                IRValue* a = this.s_res(x.a);
                IRValue* b = this.s_res(x.b);
                int p = x.k;
                int sz = this.s_vsz(a.ty);
                MO* sa;
                MO* sb;
                MO* mm;
                SI* ld;
                int ra;
                bool ia, ib;
                MI* m;
                if (x.n != 0) { -> this.s_fcmpflags(x); };
                if (true)
                {
                    if (this.s_btm(x))
                    {
                        sz = 8;
                        if (a.ty.width == 32) { sz = 4; };
                        sa = this.s_srci(this.bm_b, sz);
                        if (sa.k == MK_IMM) { sa = this.s_mo_r(this.s_imm(sa.imm), 8); };
                        sb = this.s_srci(this.bm_a, sz);
                        this.s_mi2(M_BT, sz, this.s_mo_r(sb.r, sz), this.s_mo_r(sa.r, sz));
                        if (p == SP_NE) { -> C_B; };
                        -> C_AE;
                    };
                };
                if (a.ty.kind == LK.INT)
                {
                    if (a.ty.width > 64) { this.s_fail(g"wide compare\0"); -> C_E; };
                };
                if (a.ty.kind != LK.INT & a.ty.kind != LK.PTR) { this.s_fail(g"compare type\0"); -> C_E; };
                ia = this.s_isint(a);
                ib = this.s_isint(b);
                if (ia & !ib)
                {
                    // constant on the left: swap
                    a = this.s_res(x.b);
                    b = this.s_res(x.a);
                    p = this.s_swapp(p);
                    ia = false;
                    ib = true;
                };
                if (a.di != (void*)0 & SSA_OPT_CMPMEM == 1)
                {
                    ld = (SI*)a.di;
                    if (ld.op == SO_LOAD & ld.flag & ld.res == a)
                    {
                        // the load was folded into this compare
                        this.bf_w = 0;
                        mm = this.s_addr(ld.a);
                        if (this.bf_w > 0)
                        {
                            // a bit packed member is read into a register first
                            ra = this.s_bf_read(mm, this.bf_sh, this.bf_w);
                            sb = this.s_srci(b, sz);
                            this.s_mi2(M_CMP, sz, this.s_mo_r(ra, sz), sb);
                            -> this.s_cc(p);
                        };
                        sb = this.s_srci(b, sz);
                        if (sb.k == MK_IMM | sb.k == MK_REG)
                        {
                            this.s_mi2(M_CMP, sz, mm, sb);
                            -> this.s_cc(p);
                        };
                        this.s_fail(g"folded load\0");
                        -> C_E;
                    };
                };
                sa = this.s_srci(a, sz);
                if (sa.k == MK_IMM) { sa = this.s_mo_r(this.s_imm(sa.imm), 8); };
                ra = sa.r;
                sb = this.s_srci(b, sz);
                if (sb.k == MK_IMM)
                {
                    if (sb.imm == (i64)0 & (p == SP_EQ | p == SP_NE))
                    {
                        this.s_mi2(M_TEST, sz, this.s_mo_r(ra, sz), this.s_mo_r(ra, sz));
                        -> this.s_cc(p);
                    };
                    if (sb.imm == (i64)0 & (p == SP_SLT | p == SP_SGE))
                    {
                        this.s_mi2(M_TEST, sz, this.s_mo_r(ra, sz), this.s_mo_r(ra, sz));
                        if (p == SP_SLT) { -> C_S; };
                        -> C_NS;
                    };
                };
                this.s_mi2(M_CMP, sz, this.s_mo_r(ra, sz), sb);
                -> this.s_cc(p);
            };

            // Register holding the 0 or 1 result of the compare x
            s_cmpval(SI* x) -> int
            {
                int cc = this.s_cmpflags(x);
                int d = this.s_nv(0);
                MI* m;
                m = this.s_mi1(M_SETCC, 1, this.s_mo_r(d, 1));
                m.cc = cc;
                this.s_mi2(M_MOVZX, 1, this.s_mo_r(d, 1), this.s_mo_r(d, 4));
                -> d;
            };

            // Condition code that holds when the boolean c is true, emitting the flag setting instruction
            s_cond(IRValue* c) -> int
            {
                IRValue* v = this.s_res(c);
                SI* d;
                int r;
                if (v.di != (void*)0)
                {
                    d = (SI*)v.di;
                    if (d.flag & d.op == SO_CMP) { -> this.s_cmpflags(d); };
                };
                r = this.s_reg(v);
                this.s_mi2(M_TEST, 1, this.s_mo_r(r, 1), this.s_mo_r(r, 1));
                -> C_NE;
            };

            s_isel_cmp(SI* x) -> void
            {
                int d;
                if (x.flag) { ->; };
                if (x.n != 0)
                {
                    d = this.s_fcmpval(x);
                    x.res.vr = d;
                    ->;
                };
                d = this.s_cmpval(x);
                x.res.vr = d;
                ->;
            };

            // ----------------------------------------------------------
            // Arithmetic
            // ----------------------------------------------------------

            s_isel_bin(SI* x) -> void
            {
                IRType* t = x.ty;
                int sz, k, d, ra, rb, w, sh;
                IRValue* a = this.s_res(x.a);
                IRValue* b = this.s_res(x.b);
                IRValue* tv;
                MI* m;
                MO* sb;
                bool sgn;
                i64 cv;
                k = x.k;
                if (k >= SB_FADD) { this.s_fp_bin(x); ->; };
                if (x.flag & SSA_OPT_BMIX == 1) { ->; };
                if (SSA_OPT_EXO == 1)
                {
                    {
                        sh = this.s_exo(x);
                        if (sh != 0)
                        {
                            sz = this.s_asz(t);
                            ra = this.s_reg(this.ex_x);
                            d = this.s_def(x.res, 0);
                            if (sh == 1)
                            {
                                m = this.s_mi2(M_UN, sz, this.s_mo_r(ra, sz), this.s_mo_r(d, sz));
                                m.cc = U_BSWAP;
                            };
                            if (sh == 2) { this.s_mi2(M_BREV, sz, this.s_mo_r(ra, sz), this.s_mo_r(d, sz)); };
                            if (sh == 3)
                            {
                                m = this.s_mi2(M_UN, sz, this.s_mo_r(ra, sz), this.s_mo_r(d, sz));
                                m.cc = U_POPCNT;
                            };
                            ->;
                        };
                    };
                };
                if (SSA_OPT_BMIX == 1)
                {
                    sh = this.s_bmi(x);
                    if (sh != 0)
                    {
                        sz = this.s_asz(t);
                        if (sh == 1)
                        {
                            ra = this.s_reg(this.bm_a);
                            rb = this.s_reg(this.bm_b);
                            d = this.s_def(x.res, 0);
                            m = this.s_mi3(M_ALU, sz, this.s_mo_r(ra, sz), this.s_mo_r(rb, sz), this.s_mo_r(d, sz));
                            m.cc = A_AND;
                            m.tgt = 78;
                        };
                        if (sh == 2 | sh == 3 | sh == 7)
                        {
                            ra = this.s_reg(this.bm_a);
                            d = this.s_def(x.res, 0);
                            m = this.s_mi2(M_UN, sz, this.s_mo_r(ra, sz), this.s_mo_r(d, sz));
                            if (sh == 2) { m.cc = U_BLSR; };
                            if (sh == 3) { m.cc = U_BLSI; };
                            if (sh == 7) { m.cc = U_BLSMSK; };
                        };
                        if (sh == 8 | sh == 9 | sh == 10)
                        {
                            // bts, btr and btc: the bit number is the shift count
                            ra = this.s_reg(this.bm_a);
                            rb = this.s_reg(this.bm_b);
                            d = this.s_def(x.res, 0);
                            m = this.s_mi3(M_ALU, sz, this.s_mo_r(ra, sz), this.s_mo_r(rb, sz), this.s_mo_r(d, sz));
                            m.cc = A_OR;
                            m.tgt = 82 + sh;
                        };
                        if (sh == 6)
                        {
                            // a double shift: (a << n) | (b >> (w - n)) is one shld
                            ra = this.s_reg(this.bm_a);
                            rb = this.s_reg(this.bm_b);
                            d = this.s_def(x.res, 0);
                            m = this.s_mi3(M_ALU, sz, this.s_mo_r(ra, sz), this.s_mo_r(rb, sz), this.s_mo_r(d, sz));
                            m.cc = A_OR;
                            m.tgt = 100 + this.bm_n;
                        };
                        if (sh == 4)
                        {
                            ra = this.s_reg(this.bm_a);
                            rb = this.s_reg(this.bm_b);
                            d = this.s_def(x.res, 0);
                            m = this.s_mi3(M_ALU, sz, this.s_mo_r(ra, sz), this.s_mo_r(rb, sz), this.s_mo_r(d, sz));
                            m.cc = A_AND;
                            m.tgt = 79;
                        };
                        if (sh == 5)
                        {
                            ra = this.s_reg(this.bm_a);
                            d = this.s_def(x.res, 0);
                            m = this.s_mi3(M_SHIFT, sz, this.s_mo_r(ra, sz), this.s_mo_i((i64)this.bm_n), this.s_mo_r(d, sz));
                            m.cc = S_ROR;
                            if ((this.feat `& XF_BMI2) != 0) { m.tgt = 77; };
                        };
                        ->;
                    };
                };
                if (t.kind != LK.INT & t.kind != LK.PTR) { this.s_fail(g"arithmetic type\0"); ->; };
                if (t.kind == LK.INT)
                {
                    if (t.width > 64) { this.s_fail(g"wide arithmetic\0"); ->; };
                };
                w = 64;
                if (t.kind == LK.INT) { w = t.width; };
                sz = this.s_asz(t);
                // a constant first operand of a commutative operation goes second
                if (k == SB_ADD | k == SB_MUL | k == SB_AND | k == SB_OR | k == SB_XOR)
                {
                    if (this.s_isint(a) & !this.s_isint(b))
                    {
                        tv = a;
                        a = b;
                        b = tv;
                    };
                };
                if (k == SB_ADD | k == SB_SUB | k == SB_MUL | k == SB_AND | k == SB_OR | k == SB_XOR)
                {
                    if (k == SB_MUL & this.s_isint(b))
                    {
                        sh = this.s_pow2(this.scv);
                        if (sh >= 0)
                        {
                            ra = this.s_reg(a);
                            d = this.s_def(x.res, 0);
                            this.s_mi3c(M_SHIFT, sz, this.s_mo_r(ra, sz), this.s_mo_i((i64)sh), this.s_mo_r(d, sz), S_SHL);
                            ->;
                        };
                    };
                    if (SSA_OPT_LEAMUL == 1 & k == SB_MUL & this.s_isint(b) & (sz == 4 | sz == 8) & w >= 32)
                    {
                        cv = this.scv;
                        if (cv == (i64)3 | cv == (i64)5 | cv == (i64)9)
                        {
                            // x * 3, 5 or 9 is one lea with a scaled index: one cycle instead of three
                            ra = this.s_reg(a);
                            d = this.s_def(x.res, 0);
                            m = this.s_mi2(M_LEA, sz, this.s_mo_mem(ra, ra, (int)cv - 1, (i64)0, (byte*)0, 0 - 1), this.s_mo_r(d, sz));
                            ->;
                        };
                    };
                    ra = this.s_reg(a);
                    sb = this.s_srci(b, sz);
                    d = this.s_def(x.res, 0);
                    m = this.s_mi3(M_ALU, sz, this.s_mo_r(ra, sz), sb, this.s_mo_r(d, sz));
                    if (k == SB_ADD) { m.cc = A_ADD; };
                    if (k == SB_SUB) { m.cc = A_SUB; };
                    if (k == SB_MUL) { m.cc = A_IMUL; };
                    if (k == SB_AND) { m.cc = A_AND; };
                    if (k == SB_OR) { m.cc = A_OR; };
                    if (k == SB_XOR) { m.cc = A_XOR; };
                    if (w == 1 & (k == SB_ADD | k == SB_SUB | k == SB_MUL))
                    {
                        this.s_mi3c(M_ALU, 4, this.s_mo_r(d, 4), this.s_mo_i((i64)1), this.s_mo_r(d, 4), A_AND);
                    };
                    ->;
                };
                if (k == SB_SHL | k == SB_LSHR | k == SB_ASHR)
                {
                    ra = this.s_reg(a);
                    sgn = k == SB_ASHR;
                    if (k != SB_SHL & w < 32)
                    {
                        ra = this.s_ext(ra, this.s_vsz(t), sgn, 4);
                    };
                    d = this.s_def(x.res, 0);
                    if (this.s_isint(b))
                    {
                        cv = this.scv;
                        m = this.s_mi3(M_SHIFT, sz, this.s_mo_r(ra, sz), this.s_mo_i(cv), this.s_mo_r(d, sz));
                    }
                    else
                    {
                        rb = this.s_reg(b);
                        if (SSA_OPT_BMI == 1 & (sz == 4 | sz == 8) & (this.feat `& XF_BMI2) != 0)
                        {
                            // shlx, shrx and sarx take the count in any register and leave the flags alone
                            m = this.s_mi3(M_SHIFT, sz, this.s_mo_r(ra, sz), this.s_mo_r(rb, sz), this.s_mo_r(d, sz));
                            m.tgt = 77;
                        }
                        else
                        {
                            this.s_mov(this.s_mo_r(rb, 4), 1, 4);
                            m = this.s_mi3(M_SHIFT, sz, this.s_mo_r(ra, sz), this.s_mo_r(1, 1), this.s_mo_r(d, sz));
                        };
                    };
                    if (k == SB_SHL) { m.cc = S_SHL; };
                    if (k == SB_LSHR) { m.cc = S_SHR; };
                    if (k == SB_ASHR) { m.cc = S_SAR; };
                    if (w == 1) { this.s_mi3c(M_ALU, 4, this.s_mo_r(d, 4), this.s_mo_i((i64)1), this.s_mo_r(d, 4), A_AND); };
                    ->;
                };
                // division and remainder
                sgn = k == SB_SDIV | k == SB_SREM;
                if (!sgn & this.s_isint(b))
                {
                    sh = this.s_pow2(this.scv);
                    if (sh >= 0)
                    {
                        ra = this.s_reg(a);
                        if (w < 32) { ra = this.s_ext(ra, this.s_vsz(t), false, 4); };
                        d = this.s_def(x.res, 0);
                        if (k == SB_UDIV)
                        {
                            m = this.s_mi3(M_SHIFT, sz, this.s_mo_r(ra, sz), this.s_mo_i((i64)sh), this.s_mo_r(d, sz));
                            m.cc = S_SHR;
                        }
                        else
                        {
                            cv = (i64)1 << (i64)sh;
                            cv = cv - (i64)1;
                            if (cv > (i64)2147483647) { sb = this.s_mo_r(this.s_imm(cv), 8); } else { sb = this.s_mo_i(cv); };
                            m = this.s_mi3(M_ALU, sz, this.s_mo_r(ra, sz), sb, this.s_mo_r(d, sz));
                            m.cc = A_AND;
                        };
                        ->;
                    };
                };
                if (SSA_OPT_DIVC == 1 & w >= 8 & w <= 32 & this.s_isint(b))
                {
                    if (this.s_divc(x, k, w, t, sgn)) { ->; };
                };
                if (SSA_OPT_DIVC == 1 & w == 64 & this.s_isint(b))
                {
                    if (this.s_divc64(x, k, sgn)) { ->; };
                };
                ra = this.s_reg(a);
                rb = this.s_reg(b);
                if (w < 32)
                {
                    ra = this.s_ext(ra, this.s_vsz(t), sgn, 4);
                    rb = this.s_ext(rb, this.s_vsz(t), sgn, 4);
                };
                this.s_mov(this.s_mo_r(ra, sz), 0, sz);
                if (sgn)
                {
                    m = this.s_mi(M_CQO, sz);
                    m.iu = 1;
                    m.id = 4;
                }
                else
                {
                    this.s_mov(this.s_mo_i((i64)0), 2, 4);
                };
                m = this.s_mi1(M_DIV, sz, this.s_mo_r(rb, sz));
                if (sgn) { m.cc = 1; } else { m.cc = 0; };
                m.iu = 5;
                m.id = 5;
                d = this.s_def(x.res, 0);
                if (k == SB_SDIV | k == SB_UDIV) { this.s_mov(this.s_mo_r(0, sz), d, sz); }
                else { this.s_mov(this.s_mo_r(2, sz), d, sz); };
                ->;
            };

            // ----------------------------------------------------------
            // Conversions
            // ----------------------------------------------------------

            // Division or remainder of a value of at most 32 bits by a constant, as a multiply by its reciprocal.
            // Returns false when the divisor has no cheap form.
            s_divc(SI* x, int k, int w, IRType* t, bool sgn) -> bool
            {
                IRValue* a = this.s_res(x.a);
                IRValue* b = this.s_res(x.b);
                i64 dv, lim, mg, ee, one, kk;
                int l, sh, ra, xr, x64, tq, tt, u, d, q, qd, mr;
                bool rem = k == SB_UREM | k == SB_SREM;
                bool fix;
                MI* m;
                if (!this.s_isint(b)) { -> false; };
                one = (i64)1;
                dv = this.scv;
                lim = one << (i64)w;
                dv = dv `& (lim - one);
                if (sgn & dv >= (lim >> one)) { dv = dv - lim; };
                if (dv < (i64)2 | dv >= (i64)1073741824) { -> false; };
                l = 0;
                while ((one << (i64)l) < dv) { l++; };
                sh = this.s_pow2(dv);
                ra = this.s_reg(a);
                if (w < 32) { ra = this.s_ext(ra, this.s_vsz(t), sgn, 4); };
                xr = ra;
                if (sgn)
                {
                    if (sh >= 0)
                    {
                        // round toward zero: add (d - 1) to a negative dividend
                        tt = this.s_nv(0);
                        this.s_mi3c(M_SHIFT, 4, this.s_mo_r(xr, 4), this.s_mo_i((i64)31), this.s_mo_r(tt, 4), S_SAR);
                        if (sh > 1) { this.s_mi3c(M_SHIFT, 4, this.s_mo_r(tt, 4), this.s_mo_i((i64)(32 - sh)), this.s_mo_r(tt, 4), S_SHR); }
                        else { this.s_mi3c(M_SHIFT, 4, this.s_mo_r(xr, 4), this.s_mo_i((i64)31), this.s_mo_r(tt, 4), S_SHR); };
                        u = this.s_nv(0);
                        this.s_mi3c(M_ALU, 4, this.s_mo_r(xr, 4), this.s_mo_r(tt, 4), this.s_mo_r(u, 4), A_ADD);
                        if (rem & SSA_OPT_REMP2 == 1)
                        {
                            // x rem 2^k is x minus the biased x with its low k bits cleared
                            qd = this.s_nv(0);
                            this.s_mi3c(M_ALU, 4, this.s_mo_r(u, 4), this.s_mo_i((i64)0 - dv), this.s_mo_r(qd, 4), A_AND);
                            d = this.s_def(x.res, 0);
                            this.s_mi3c(M_ALU, 4, this.s_mo_r(xr, 4), this.s_mo_r(qd, 4), this.s_mo_r(d, 4), A_SUB);
                            -> true;
                        };
                        q = this.s_nv(0);
                        this.s_mi3c(M_SHIFT, 4, this.s_mo_r(u, 4), this.s_mo_i((i64)sh), this.s_mo_r(q, 4), S_SAR);
                    }
                    else
                    {
                        x64 = this.s_ext(xr, 4, true, 8);
                        kk = (i64)(31 + l);
                        mg = (one << kk) + dv - one;
                        mg = mg / dv;
                        tt = this.s_nv(0);
                        if (mg > (i64)2147483647) { mr = this.s_imm(mg); this.s_mi3c(M_ALU, 8, this.s_mo_r(x64, 8), this.s_mo_r(mr, 8), this.s_mo_r(tt, 8), A_IMUL); }
                        else { this.s_mi3c(M_ALU, 8, this.s_mo_r(x64, 8), this.s_mo_i(mg), this.s_mo_r(tt, 8), A_IMUL); };
                        u = this.s_nv(0);
                        this.s_mi3c(M_SHIFT, 8, this.s_mo_r(tt, 8), this.s_mo_i(kk), this.s_mo_r(u, 8), S_SAR);
                        tq = this.s_nv(0);
                        this.s_mi3c(M_SHIFT, 8, this.s_mo_r(x64, 8), this.s_mo_i((i64)63), this.s_mo_r(tq, 8), S_SHR);
                        q = this.s_nv(0);
                        this.s_mi3c(M_ALU, 4, this.s_mo_r(u, 4), this.s_mo_r(tq, 4), this.s_mo_r(q, 4), A_ADD);
                    };
                }
                else
                {
                    x64 = this.s_nv(0);
                    this.s_mov(this.s_mo_r(xr, 4), x64, 4);
                    // the smallest shift whose multiplier fits 32 bits and is exact over 32 bit dividends
                    fix = true;
                    kk = (i64)32;
                    mg = (i64)0;
                    sh = 0;
                    while (sh <= l)
                    {
                        ee = (one << (i64)(32 + sh));
                        mg = (ee + dv - one) / dv;
                        if (mg * dv - ee <= (one << (i64)sh) & mg < (one << (i64)32)) { fix = false; kk = (i64)(32 + sh); break; };
                        sh++;
                    };
                    tt = this.s_nv(0);
                    if (!fix)
                    {
                        if (mg > (i64)2147483647) { mr = this.s_imm(mg); this.s_mi3c(M_ALU, 8, this.s_mo_r(x64, 8), this.s_mo_r(mr, 8), this.s_mo_r(tt, 8), A_IMUL); }
                        else { this.s_mi3c(M_ALU, 8, this.s_mo_r(x64, 8), this.s_mo_i(mg), this.s_mo_r(tt, 8), A_IMUL); };
                        q = this.s_nv(0);
                        this.s_mi3c(M_SHIFT, 8, this.s_mo_r(tt, 8), this.s_mo_i(kk), this.s_mo_r(q, 8), S_SHR);
                    }
                    else
                    {
                        // a 33 bit multiplier: t = (x * m) >> 32, q = (t + ((x - t) >> 1)) >> (l - 1)
                        mg = ((one << (i64)32) * ((one << (i64)l) - dv)) / dv + one;
                        mr = this.s_imm(mg);
                        u = this.s_nv(0);
                        this.s_mi3c(M_ALU, 8, this.s_mo_r(x64, 8), this.s_mo_r(mr, 8), this.s_mo_r(u, 8), A_IMUL);
                        this.s_mi3c(M_SHIFT, 8, this.s_mo_r(u, 8), this.s_mo_i((i64)32), this.s_mo_r(tt, 8), S_SHR);
                        u = this.s_nv(0);
                        this.s_mi3c(M_ALU, 8, this.s_mo_r(x64, 8), this.s_mo_r(tt, 8), this.s_mo_r(u, 8), A_SUB);
                        tq = this.s_nv(0);
                        this.s_mi3c(M_SHIFT, 8, this.s_mo_r(u, 8), this.s_mo_i((i64)1), this.s_mo_r(tq, 8), S_SHR);
                        u = this.s_nv(0);
                        this.s_mi3c(M_ALU, 8, this.s_mo_r(tq, 8), this.s_mo_r(tt, 8), this.s_mo_r(u, 8), A_ADD);
                        q = this.s_nv(0);
                        if (l > 1) { this.s_mi3c(M_SHIFT, 8, this.s_mo_r(u, 8), this.s_mo_i((i64)(l - 1)), this.s_mo_r(q, 8), S_SHR); }
                        else { this.s_mov(this.s_mo_r(u, 8), q, 8); };
                    };
                };
                d = this.s_def(x.res, 0);
                if (!rem)
                {
                    this.s_mov(this.s_mo_r(q, 4), d, 4);
                    -> true;
                };
                qd = this.s_nv(0);
                this.s_mi3c(M_ALU, 4, this.s_mo_r(q, 4), this.s_mo_i(dv), this.s_mo_r(qd, 4), A_IMUL);
                this.s_mi3c(M_ALU, 4, this.s_mo_r(xr, 4), this.s_mo_r(qd, 4), this.s_mo_r(d, 4), A_SUB);
                -> true;
            };

            // High half of the 128 bit product of the 64 bit register xr and the constant mg
            s_mulh(int xr, u64 mg, bool sgn) -> int
            {
                MI* m;
                int mr, r;
                this.s_mov(this.s_mo_r(xr, 8), 0, 8);
                mr = this.s_imm((i64)mg);
                m = this.s_mi1(M_DIV, 8, this.s_mo_r(mr, 8));
                if (sgn) { m.cc = 3; } else { m.cc = 2; };
                m.iu = 1;
                m.id = 5;
                r = this.s_nv(0);
                this.s_mov(this.s_mo_r(2, 8), r, 8);
                -> r;
            };

            // 64 bit division or remainder by a constant (see s_divc)
            s_divc64(SI* x, int k, bool sgn) -> bool
            {
                IRValue* a = this.s_res(x.a);
                IRValue* b = this.s_res(x.b);
                u64 dv, two, mk, nc, q1, r1, q2, r2, delta, ad, anc, tu, mg;
                u64 one;
                int p, sh, xr, tt, u, q, tq, d, qd, mr, sa;
                bool rem = k == SB_UREM | k == SB_SREM;
                bool add, more;
                if (!this.s_isint(b)) { -> false; };
                one = (u64)1;
                two = one << (u64)63;
                dv = (u64)this.scv;
                if (dv < (u64)3) { -> false; };
                if (sgn & dv >= (one << (u64)62)) { -> false; };
                if (!sgn & dv >= two) { -> false; };
                sh = this.s_pow2((i64)dv);
                xr = this.s_reg(a);
                if (sgn)
                {
                    if (sh >= 0)
                    {
                        tt = this.s_nv(0);
                        if (sh > 1)
                        {
                            this.s_mi3c(M_SHIFT, 8, this.s_mo_r(xr, 8), this.s_mo_i((i64)63), this.s_mo_r(tt, 8), S_SAR);
                            this.s_mi3c(M_SHIFT, 8, this.s_mo_r(tt, 8), this.s_mo_i((i64)(64 - sh)), this.s_mo_r(tt, 8), S_SHR);
                        }
                        else { this.s_mi3c(M_SHIFT, 8, this.s_mo_r(xr, 8), this.s_mo_i((i64)63), this.s_mo_r(tt, 8), S_SHR); };
                        u = this.s_nv(0);
                        this.s_mi3c(M_ALU, 8, this.s_mo_r(xr, 8), this.s_mo_r(tt, 8), this.s_mo_r(u, 8), A_ADD);
                        q = this.s_nv(0);
                        this.s_mi3c(M_SHIFT, 8, this.s_mo_r(u, 8), this.s_mo_i((i64)sh), this.s_mo_r(q, 8), S_SAR);
                    }
                    else
                    {
                        mk = (u64)0 - one;
                        ad = dv;
                        tu = two;
                        anc = tu - one - (tu % ad);
                        p = 63;
                        q1 = two / anc; r1 = two - q1 * anc;
                        q2 = two / ad; r2 = two - q2 * ad;
                        more = true;
                        while (more)
                        {
                            p++;
                            q1 = q1 * (u64)2; r1 = r1 * (u64)2;
                            if (r1 >= anc) { q1 = q1 + one; r1 = r1 - anc; };
                            q2 = q2 * (u64)2; r2 = r2 * (u64)2;
                            if (r2 >= ad) { q2 = q2 + one; r2 = r2 - ad; };
                            delta = ad - r2;
                            more = q1 < delta | (q1 == delta & r1 == (u64)0);
                        };
                        mg = q2 + one;
                        sa = p - 64;
                        tt = this.s_mulh(xr, mg, true);
                        if (mg >= two)
                        {
                            u = this.s_nv(0);
                            this.s_mi3c(M_ALU, 8, this.s_mo_r(tt, 8), this.s_mo_r(xr, 8), this.s_mo_r(u, 8), A_ADD);
                            tt = u;
                        };
                        if (sa > 0)
                        {
                            u = this.s_nv(0);
                            this.s_mi3c(M_SHIFT, 8, this.s_mo_r(tt, 8), this.s_mo_i((i64)sa), this.s_mo_r(u, 8), S_SAR);
                            tt = u;
                        };
                        tq = this.s_nv(0);
                        this.s_mi3c(M_SHIFT, 8, this.s_mo_r(tt, 8), this.s_mo_i((i64)63), this.s_mo_r(tq, 8), S_SHR);
                        q = this.s_nv(0);
                        this.s_mi3c(M_ALU, 8, this.s_mo_r(tt, 8), this.s_mo_r(tq, 8), this.s_mo_r(q, 8), A_ADD);
                    };
                }
                else
                {
                    if (sh >= 0) { -> false; };
                    mk = (u64)0 - one;
                    nc = mk - (((u64)0 - dv) % dv);
                    p = 63;
                    q1 = two / nc; r1 = two - q1 * nc;
                    q2 = (two - one) / dv; r2 = (two - one) - q2 * dv;
                    add = false;
                    more = true;
                    while (more)
                    {
                        p++;
                        if (r1 >= nc - r1) { q1 = q1 * (u64)2 + one; r1 = r1 * (u64)2 - nc; }
                        else { q1 = q1 * (u64)2; r1 = r1 * (u64)2; };
                        if (r2 + one >= dv - r2)
                        {
                            if (q2 >= two - one) { add = true; };
                            q2 = q2 * (u64)2 + one; r2 = r2 * (u64)2 + one - dv;
                        }
                        else
                        {
                            if (q2 >= two) { add = true; };
                            q2 = q2 * (u64)2; r2 = r2 * (u64)2 + one;
                        };
                        delta = dv - one - r2;
                        more = p < 128 & (q1 < delta | (q1 == delta & r1 == (u64)0));
                    };
                    mg = q2 + one;
                    sa = p - 64;
                    tt = this.s_mulh(xr, mg, false);
                    if (!add)
                    {
                        if (sa > 0)
                        {
                            q = this.s_nv(0);
                            this.s_mi3c(M_SHIFT, 8, this.s_mo_r(tt, 8), this.s_mo_i((i64)sa), this.s_mo_r(q, 8), S_SHR);
                        }
                        else { q = tt; };
                    }
                    else
                    {
                        u = this.s_nv(0);
                        this.s_mi3c(M_ALU, 8, this.s_mo_r(xr, 8), this.s_mo_r(tt, 8), this.s_mo_r(u, 8), A_SUB);
                        tq = this.s_nv(0);
                        this.s_mi3c(M_SHIFT, 8, this.s_mo_r(u, 8), this.s_mo_i((i64)1), this.s_mo_r(tq, 8), S_SHR);
                        u = this.s_nv(0);
                        this.s_mi3c(M_ALU, 8, this.s_mo_r(tq, 8), this.s_mo_r(tt, 8), this.s_mo_r(u, 8), A_ADD);
                        if (sa > 1)
                        {
                            q = this.s_nv(0);
                            this.s_mi3c(M_SHIFT, 8, this.s_mo_r(u, 8), this.s_mo_i((i64)(sa - 1)), this.s_mo_r(q, 8), S_SHR);
                        }
                        else { q = u; };
                    };
                };
                d = this.s_def(x.res, 0);
                if (!rem)
                {
                    this.s_mov(this.s_mo_r(q, 8), d, 8);
                    -> true;
                };
                qd = this.s_nv(0);
                if (dv > (u64)2147483647) { mr = this.s_imm((i64)dv); this.s_mi3c(M_ALU, 8, this.s_mo_r(q, 8), this.s_mo_r(mr, 8), this.s_mo_r(qd, 8), A_IMUL); }
                else { this.s_mi3c(M_ALU, 8, this.s_mo_r(q, 8), this.s_mo_i((i64)dv), this.s_mo_r(qd, 8), A_IMUL); };
                this.s_mi3c(M_ALU, 8, this.s_mo_r(xr, 8), this.s_mo_r(qd, 8), this.s_mo_r(d, 8), A_SUB);
                -> true;
            };

            s_isel_cast(SI* x) -> void
            {
                IRValue* a = this.s_res(x.a);
                IRType* ft = a.ty;
                IRType* tt = x.ty;
                int k = x.k;
                int fsz, tsz, fw, tw, r, d;
                bool odd;
                MI* m;
                MO* s;
                if (this.s_isfp(ft) | this.s_isfp(tt)) { this.s_fp_cast(x); ->; };
                if (k >= SK_FPEXT) { this.s_fail(g"float cast\0"); ->; };
                if (ft.kind != LK.INT & ft.kind != LK.PTR) { this.s_fail(g"cast source type\0"); ->; };
                if (tt.kind != LK.INT & tt.kind != LK.PTR) { this.s_fail(g"cast result type\0"); ->; };
                fw = 64;
                tw = 64;
                if (ft.kind == LK.INT) { fw = ft.width; };
                if (tt.kind == LK.INT) { tw = tt.width; };
                if (fw > 64 | tw > 64) { this.s_fail(g"wide cast\0"); ->; };
                fsz = this.s_vsz(ft);
                tsz = this.s_vsz(tt);
                if (this.s_isint(a))
                {
                    // constant operand: fold
                    this.s_cast_const(x, a);
                    ->;
                };
                s = this.s_src(a);
                r = this.s_oreg(s);
                d = this.s_def(x.res, 0);
                odd = fw != 1 & fw != 8 & fw != 16 & fw != 32 & fw != 64;
                if (odd & (k == SK_ZEXT | k == SK_SEXT) & ft.kind == LK.INT)
                {
                    // a width that is not a machine size is only known in its low bits, the bits above are cleared or
                    // filled here
                    this.s_mov(this.s_mo_r(r, 8), d, 8);
                    if (k == SK_ZEXT)
                    {
                        this.s_mi3c(M_ALU, 8, this.s_mo_r(d, 8), this.s_mask(((i64)1 << (i64)fw) - (i64)1), this.s_mo_r(d, 8), A_AND);
                        ->;
                    };
                    this.s_mi3c(M_SHIFT, 8, this.s_mo_r(d, 8), this.s_mo_i((i64)(64 - fw)), this.s_mo_r(d, 8), S_SHL);
                    this.s_mi3c(M_SHIFT, 8, this.s_mo_r(d, 8), this.s_mo_i((i64)(64 - fw)), this.s_mo_r(d, 8), S_SAR);
                    ->;
                };
                if (k == SK_ZEXT | k == SK_INTTOPTR)
                {
                    if (fsz >= 8) { this.s_mov(this.s_mo_r(r, 8), d, 8); ->; };
                    if (fsz == 4) { this.s_mov(this.s_mo_r(r, 4), d, 4); ->; };
                    if (fw == 1)
                    {
                        this.s_mov(this.s_mo_r(r, 4), d, 4);
                        ->;
                    };
                    this.s_mi2(M_MOVZX, fsz, this.s_mo_r(r, fsz), this.s_mo_r(d, 4));
                    ->;
                };
                if (k == SK_SEXT)
                {
                    if (fw == 1)
                    {
                        this.s_mov(this.s_mo_r(r, 4), d, 4);
                        m = this.s_mi2(M_UN, this.s_asz(tt), this.s_mo_r(d, this.s_asz(tt)), this.s_mo_r(d, this.s_asz(tt)));
                        m.cc = U_NEG;
                        ->;
                    };
                    if (tsz == 8)
                    {
                        if (fsz == 4)
                        {
                            m = this.s_mi2(M_MOVSX, 4, this.s_mo_r(r, 4), this.s_mo_r(d, 8));
                            m.cc = 8;
                            ->;
                        };
                        m = this.s_mi2(M_MOVSX, fsz, this.s_mo_r(r, fsz), this.s_mo_r(d, 8));
                        m.cc = 8;
                        ->;
                    };
                    if (fsz >= 4) { this.s_mov(this.s_mo_r(r, 4), d, 4); ->; };
                    m = this.s_mi2(M_MOVSX, fsz, this.s_mo_r(r, fsz), this.s_mo_r(d, 4));
                    m.cc = 4;
                    ->;
                };
                // trunc, ptrtoint, bitcast
                if (tw == 1 & fw > 1)
                {
                    this.s_mi3c(M_ALU, 4, this.s_mo_r(r, 4), this.s_mo_i((i64)1), this.s_mo_r(d, 4), A_AND);
                    ->;
                };
                if (tsz == 8 & fsz == 8) { this.s_mov(this.s_mo_r(r, 8), d, 8); ->; };
                if (tsz == 8 & fsz < 8)
                {
                    // widening bitcast: zero extend
                    if (fsz == 4) { this.s_mov(this.s_mo_r(r, 4), d, 4); ->; };
                    this.s_mi2(M_MOVZX, fsz, this.s_mo_r(r, fsz), this.s_mo_r(d, 4));
                    ->;
                };
                this.s_mov(this.s_mo_r(r, 4), d, 4);
                ->;
            };

            // Stack allocation of count elements: the size rounded to 16 is taken off rsp, the new bytes sit just
            // above the outgoing argument area
            s_isel_allocan(SI* x) -> void
            {
                int r = this.s_reg(this.s_res(x.a));
                int t1 = this.s_nv(0);
                int t2 = this.s_nv(0);
                int t3 = this.s_nv(0);
                int d;
                this.s_mi3c(M_ALU, 8, this.s_mo_r(r, 8), this.s_mo_i((i64)this.a_size(x.ty)), this.s_mo_r(t1, 8), A_IMUL);
                this.s_mi3c(M_ALU, 8, this.s_mo_r(t1, 8), this.s_mo_i((i64)15), this.s_mo_r(t2, 8), A_ADD);
                this.s_mi3c(M_ALU, 8, this.s_mo_r(t2, 8), this.s_mo_i((i64)-16), this.s_mo_r(t3, 8), A_AND);
                d = this.s_def(x.res, 0);
                this.s_mi2(M_DALLOC, 8, this.s_mo_r(t3, 8), this.s_mo_r(d, 8));
                ->;
            };

            // Memory operand n bytes past m
            s_mo_off(MO* m, int n) -> MO*
            {
                MO* c = this.s_mo_copy(m);
                c.imm = c.imm + (i64)n;
                -> c;
            };

            // Copies n bytes from memory s to memory d
            s_copy(MO* d, MO* s, int n) -> void
            {
                MI* m;
                int rs, rd;
                if (n <= 128)
                {
                    this.s_mi2(M_COPY, n, d, s);
                    ->;
                };
                rs = this.s_lea(s);
                rd = this.s_lea(d);
                this.s_mov(this.s_mo_r(rs, 8), 6, 8);
                this.s_mov(this.s_mo_r(rd, 8), 7, 8);
                this.s_mov(this.s_mo_i((i64)n), 1, 8);
                m = this.s_mi(M_REPMOVS, 1);
                m.iu = 194;
                m.id = 194;
                ->;
            };

            // Stores zero over n bytes at d
            s_zero(MO* d, int n) -> void
            {
                int off = 0;
                MI* m;
                if (n > 128)
                {
                    this.s_mov(this.s_mo_r(this.s_lea(d), 8), 7, 8);
                    this.s_mov(this.s_mo_i((i64)n), 1, 8);
                    this.s_mov(this.s_mo_i((i64)0), 0, 4);
                    m = this.s_mi(M_REPSTOS, 1);
                    m.iu = 131;
                    m.id = 131;
                    ->;
                };
                while (n - off >= 8)
                {
                    this.s_mi2(M_MOV, 8, this.s_mo_i((i64)0), this.s_mo_off(d, off));
                    off = off + 8;
                };
                while (n - off >= 4)
                {
                    this.s_mi2(M_MOV, 4, this.s_mo_i((i64)0), this.s_mo_off(d, off));
                    off = off + 4;
                };
                while (n - off >= 1)
                {
                    this.s_mi2(M_MOV, 1, this.s_mo_i((i64)0), this.s_mo_off(d, off));
                    off = off + 1;
                };
                ->;
            };

            // Memory operand of the bytes of the aggregate value v
            s_agg_addr(IRValue* v) -> MO*
            {
                byte* lb;
                if (v.fo > 0) { -> this.s_mo_mem(0 - 1, 0 - 1, 1, (i64)0, (byte*)0, v.fo - 1); };
                if (v.vr == 0 & v.di == (void*)0 & v.text != (byte*)0)
                {
                    if (this.a_pre(v.text, g"zeroinitializer\0") | this.a_pre(v.text, g"undef\0"))
                    {
                        lb = this.a_zero_label(this.a_size(v.ty));
                    }
                    else { lb = this.a_const_agg(v); };
                    -> this.s_mo_mem(0 - 1, 0 - 1, 1, (i64)0, lb, 0 - 1);
                };
                this.s_fail(g"aggregate value\0");
                -> this.s_mo_mem(0 - 1, 0 - 1, 1, (i64)0, (byte*)0, 0 - 1);
            };

            // Copies the aggregate value v to memory d
            s_agg_to(IRValue* v, MO* d) -> void
            {
                int sz = this.a_size(v.ty);
                MO* s = this.s_agg_addr(v);
                if (this.gwhy != 0) { ->; };
                this.s_copy(d, s, sz);
                ->;
            };

            s_isel_extract(SI* x) -> void
            {
                IRValue* agg = this.s_res(x.a);
                IRType* et = this.s_elem(agg.ty, x.k);
                MO* base = this.s_agg_addr(agg);
                MO* m;
                int sz, d, fo;
                if (this.gwhy != 0) { ->; };
                m = this.s_mo_off(base, this.sel_off);
                if (this.s_isagg(et))
                {
                    sz = this.a_size(et);
                    fo = this.s_newfo(sz, this.a_align(et));
                    this.s_copy(this.s_mo_mem(0 - 1, 0 - 1, 1, (i64)0, (byte*)0, fo - 1), m, sz);
                    x.res.fo = fo;
                    ->;
                };
                if (this.s_isfp(et))
                {
                    sz = this.s_vsz(et);
                    d = this.s_def(x.res, 1);
                    this.s_mi2(M_XMOV, sz, m, this.s_mo_r(d, sz));
                    ->;
                };
                if (et.kind != LK.INT & et.kind != LK.PTR) { this.s_fail(g"extract type\0"); ->; };
                if (et.kind == LK.INT)
                {
                    if (et.width > 64) { this.s_fail(g"wide extract\0"); ->; };
                };
                sz = this.s_vsz(et);
                d = this.s_def(x.res, 0);
                if (sz < 4) { this.s_mi2(M_MOVZX, sz, m, this.s_mo_r(d, 4)); ->; };
                this.s_mi2(M_MOV, sz, m, this.s_mo_r(d, sz));
                ->;
            };

            s_isel_insert(SI* x) -> void
            {
                IRValue* agg = this.s_res(x.a);
                IRValue* v = this.s_res(x.b);
                IRType* et = this.s_elem(agg.ty, x.k);
                int off = this.sel_off;
                int tsz = this.a_size(agg.ty);
                int fo = this.s_newfo(tsz, this.a_align(agg.ty));
                MO* dst = this.s_mo_mem(0 - 1, 0 - 1, 1, (i64)off, (byte*)0, fo - 1);
                MO* whole = this.s_mo_mem(0 - 1, 0 - 1, 1, (i64)0, (byte*)0, fo - 1);
                MO* src = this.s_agg_addr(agg);
                int sz, r;
                if (this.gwhy != 0) { ->; };
                this.s_copy(whole, src, tsz);
                if (this.s_isagg(et)) { this.s_agg_to(v, dst); x.res.fo = fo; ->; };
                sz = this.s_vsz(et);
                if (this.s_isfp(et))
                {
                    r = this.s_freg(v);
                    this.s_mi2(M_XMOV, sz, this.s_mo_r(r, sz), dst);
                    x.res.fo = fo;
                    ->;
                };
                if (et.kind != LK.INT & et.kind != LK.PTR) { this.s_fail(g"insert type\0"); ->; };
                if (et.kind == LK.INT)
                {
                    if (et.width > 64) { this.s_fail(g"wide insert\0"); ->; };
                };
                this.s_mi2(M_MOV, sz, this.s_srci(x.b, sz), dst);
                x.res.fo = fo;
                ->;
            };

            s_agg_load(SI* x) -> void
            {
                int sz = this.a_size(x.ty);
                int fo = this.s_newfo(sz, this.a_align(x.ty));
                MO* src = this.s_addr(x.a);
                this.s_copy(this.s_mo_mem(0 - 1, 0 - 1, 1, (i64)0, (byte*)0, fo - 1), src, sz);
                x.res.fo = fo;
                ->;
            };

            s_agg_store(SI* x) -> void
            {
                this.s_agg_to(this.s_res(x.a), this.s_addr(x.b));
                ->;
            };

            // Loads sz bytes at m zero extended into register d
            s_ldz(MO* m, int sz, int d) -> void
            {
                if (sz < 4) { this.s_mi2(M_MOVZX, sz, this.s_mo_copy(m), this.s_mo_r(d, 4)); ->; };
                this.s_mi2(M_MOV, sz, this.s_mo_copy(m), this.s_mo_r(d, sz));
                ->;
            };

            // Register holding the n bytes at m (n from 1 to 8) as one zero extended value, every
            // byte is read exactly once or twice and none outside the n
            s_bf_raw(MO* m, int n) -> int
            {
                int p = n;
                int d = this.s_nv(0);
                int hi;
                if (n == 3) { p = 2; };
                if (n == 5 | n == 6 | n == 7) { p = 4; };
                this.s_ldz(m, p, d);
                if (p != n)
                {
                    hi = this.s_nv(0);
                    this.s_ldz(this.s_mo_off(m, n - p), p, hi);
                    this.s_mi3c(M_SHIFT, 8, this.s_mo_r(hi, 8), this.s_mo_i((i64)(8 * (n - p))), this.s_mo_r(hi, 8), S_SHL);
                    this.s_mi3c(M_ALU, 8, this.s_mo_r(d, 8), this.s_mo_r(hi, 8), this.s_mo_r(d, 8), A_OR);
                };
                -> d;
            };

            // Operand for a 64 bit mask
            s_mask(i64 v) -> MO*
            {
                if (v >= (i64)-2147483648 & v <= (i64)2147483647) { -> this.s_mo_i(v); };
                -> this.s_mo_r(this.s_imm(v), 8);
            };

            // The 64 bits that start sh bits (1 to 7) into the 9 bytes at m, as one number
            s_bf_win(MO* m, int sh) -> int
            {
                int a = this.s_bswap64(this.s_bf_raw(m, 8));
                int b = this.s_nv(0);
                this.s_mi3c(M_SHIFT, 8, this.s_mo_r(a, 8), this.s_mo_i((i64)sh), this.s_mo_r(a, 8), S_SHL);
                this.s_ldz(this.s_mo_off(m, 8), 1, b);
                this.s_mi3c(M_SHIFT, 8, this.s_mo_r(b, 8), this.s_mo_i((i64)(8 - sh)), this.s_mo_r(b, 8), S_SHR);
                this.s_mi3c(M_ALU, 8, this.s_mo_r(a, 8), this.s_mo_r(b, 8), this.s_mo_r(a, 8), A_OR);
                -> a;
            };

            // Bit field of width w that starts sh bits (1 to 7) into 9 bytes: the first 8 bytes and the last
            s_bf_write9(MO* m, int sh, int w, int v) -> void
            {
                int win, t, a, b, c;
                i64 fm = (i64)0 - (i64)1;
                win = this.s_bf_win(m, sh);
                t = this.s_nv(0);
                this.s_mov(this.s_mo_r(v, 8), t, 8);
                if (w < 64)
                {
                    fm = ((i64)1 << (i64)w) - (i64)1;
                    this.s_mi3c(M_ALU, 8, this.s_mo_r(t, 8), this.s_mask(fm), this.s_mo_r(t, 8), A_AND);
                    this.s_mi3c(M_SHIFT, 8, this.s_mo_r(t, 8), this.s_mo_i((i64)(64 - w)), this.s_mo_r(t, 8), S_SHL);
                    fm = fm << (i64)(64 - w);
                };
                fm = (i64)0 - (i64)1 - fm;
                this.s_mi3c(M_ALU, 8, this.s_mo_r(win, 8), this.s_mask(fm), this.s_mo_r(win, 8), A_AND);
                this.s_mi3c(M_ALU, 8, this.s_mo_r(win, 8), this.s_mo_r(t, 8), this.s_mo_r(win, 8), A_OR);
                // first 8 bytes: keep the top sh bits, the rest comes from the high part of win
                a = this.s_bswap64(this.s_bf_raw(m, 8));
                this.s_mi3c(M_SHIFT, 8, this.s_mo_r(a, 8), this.s_mo_i((i64)(64 - sh)), this.s_mo_r(a, 8), S_SHR);
                this.s_mi3c(M_SHIFT, 8, this.s_mo_r(a, 8), this.s_mo_i((i64)(64 - sh)), this.s_mo_r(a, 8), S_SHL);
                t = this.s_nv(0);
                this.s_mi3c(M_SHIFT, 8, this.s_mo_r(win, 8), this.s_mo_i((i64)sh), this.s_mo_r(t, 8), S_SHR);
                this.s_mi3c(M_ALU, 8, this.s_mo_r(a, 8), this.s_mo_r(t, 8), this.s_mo_r(a, 8), A_OR);
                c = this.s_bswap64(a);
                this.s_mi2(M_MOV, 8, this.s_mo_r(c, 8), this.s_mo_copy(m));
                // last byte: keep its low 8 - sh bits, the top sh bits come from the low bits of win
                b = this.s_nv(0);
                this.s_ldz(this.s_mo_off(m, 8), 1, b);
                this.s_mi3c(M_ALU, 8, this.s_mo_r(b, 8), this.s_mo_i((i64)((1 << (8 - sh)) - 1)), this.s_mo_r(b, 8), A_AND);
                t = this.s_nv(0);
                this.s_mi3c(M_SHIFT, 8, this.s_mo_r(win, 8), this.s_mo_i((i64)(8 - sh)), this.s_mo_r(t, 8), S_SHL);
                this.s_mi3c(M_ALU, 8, this.s_mo_r(t, 8), this.s_mo_i((i64)255), this.s_mo_r(t, 8), A_AND);
                this.s_mi3c(M_ALU, 8, this.s_mo_r(b, 8), this.s_mo_r(t, 8), this.s_mo_r(b, 8), A_OR);
                this.s_mi2(M_MOV, 1, this.s_mo_r(b, 1), this.s_mo_off(m, 8));
                ->;
            };

            // Byte reverse of the 64 bit register r into a new register
            s_bswap64(int r) -> int
            {
                int d = this.s_nv(0);
                MI* m = this.s_mi2(M_UN, 8, this.s_mo_r(r, 8), this.s_mo_r(d, 8));
                m.cc = U_BSWAP;
                -> d;
            };

            // Value of the bit field of width w that starts sh bits into the bytes at m. Bit 0 of the
            // bytes is the most significant bit of the first byte, so the n bytes read as one big endian
            // number whose top bits are the field.
            s_bf_read_top(MO* m, int sh, int w) -> int
            {
                int n = (sh + w + 7) / 8;
                int d, b;
                if (n > 9) { this.s_fail(g"bit field spans more than 9 bytes\0"); -> this.s_nv(0); };
                if (n == 9)
                {
                    b = this.s_bf_win(m, sh);
                    if (w < 64) { this.s_mi3c(M_SHIFT, 8, this.s_mo_r(b, 8), this.s_mo_i((i64)(64 - w)), this.s_mo_r(b, 8), S_SHR); };
                    -> b;
                };
                d = this.s_bf_raw(m, n);
                b = this.s_bswap64(d);
                this.s_mi3c(M_SHIFT, 8, this.s_mo_r(b, 8), this.s_mo_i((i64)(64 - sh - w)), this.s_mo_r(b, 8), S_SHR);
                if (w < 64) { this.s_mi3c(M_ALU, 8, this.s_mo_r(b, 8), this.s_mask(((i64)1 << (i64)w) - (i64)1), this.s_mo_r(b, 8), A_AND); };
                -> b;
            };

            // Bit field write through the left aligned 64 bit window, for fields that span 3, 5, 6 or 7 bytes
            s_bf_write_top(MO* m, int sh, int w, int v) -> void
            {
                int n = (sh + w + 7) / 8;
                int p = n;
                int o, t, hi, lo;
                i64 fm = (i64)0 - (i64)1;
                if (n > 9) { this.s_fail(g"bit field spans more than 9 bytes\0"); ->; };
                if (n == 9) { this.s_bf_write9(m, sh, w, v); ->; };
                if (w < 64) { fm = ((i64)1 << (i64)w) - (i64)1; };
                o = this.s_bswap64(this.s_bf_raw(m, n));
                t = this.s_nv(0);
                this.s_mov(this.s_mo_r(v, 8), t, 8);
                if (w < 64) { this.s_mi3c(M_ALU, 8, this.s_mo_r(t, 8), this.s_mask(fm), this.s_mo_r(t, 8), A_AND); };
                if (sh + w < 64)
                {
                    this.s_mi3c(M_SHIFT, 8, this.s_mo_r(t, 8), this.s_mo_i((i64)(64 - sh - w)), this.s_mo_r(t, 8), S_SHL);
                    fm = fm << (i64)(64 - sh - w);
                };
                fm = (i64)0 - (i64)1 - fm;
                this.s_mi3c(M_ALU, 8, this.s_mo_r(o, 8), this.s_mask(fm), this.s_mo_r(o, 8), A_AND);
                this.s_mi3c(M_ALU, 8, this.s_mo_r(o, 8), this.s_mo_r(t, 8), this.s_mo_r(o, 8), A_OR);
                lo = this.s_bswap64(o);
                if (n == 3) { p = 2; };
                if (n == 5 | n == 6 | n == 7) { p = 4; };
                this.s_mi2(M_MOV, p, this.s_mo_r(lo, p), this.s_mo_copy(m));
                if (p != n)
                {
                    hi = this.s_nv(0);
                    this.s_mi3c(M_SHIFT, 8, this.s_mo_r(lo, 8), this.s_mo_i((i64)(8 * (n - p))), this.s_mo_r(hi, 8), S_SHR);
                    this.s_mi2(M_MOV, p, this.s_mo_r(hi, p), this.s_mo_off(m, n - p));
                };
                ->;
            };

            // Byte sized read modify write of memory: m = m op src
            s_rmw(MO* src, MO* m, int op) -> void
            {
                MI* u = this.s_mi2(M_RMW, 1, src, m);
                u.cc = op;
                ->;
            };

            // The n bytes at m (1 to 8) as one big endian number. Right aligned in the register when n is 1, 2, 4 or 8
            // (bf_bits is 8n), else left aligned in 64 bits (bf_bits is 64).
            s_bf_be(MO* m, int n) -> int
            {
                int d = this.s_nv(0);
                MI* u;
                this.bf_bits = 64;
                if (n == 1)
                {
                    this.s_ldz(m, 1, d);
                    this.bf_bits = 8;
                    -> d;
                };
                if (n == 2)
                {
                    this.s_ldz(m, 2, d);
                    u = this.s_mi2(M_UN, 2, this.s_mo_r(d, 2), this.s_mo_r(d, 2));
                    u.cc = U_BSWAP;
                    this.bf_bits = 16;
                    -> d;
                };
                if (n == 4 | n == 8)
                {
                    this.bf_bits = 8 * n;
                    if ((this.feat `& XF_MOVBE) != 0)
                    {
                        u = this.s_mi2(M_UN, n, this.s_mo_copy(m), this.s_mo_r(d, n));
                        u.cc = U_MOVBE;
                        -> d;
                    };
                    this.s_ldz(m, n, d);
                    u = this.s_mi2(M_UN, n, this.s_mo_r(d, n), this.s_mo_r(d, n));
                    u.cc = U_BSWAP;
                    -> d;
                };
                -> this.s_bswap64(this.s_bf_raw(m, n));
            };

            // Stores the n bytes (1, 2, 4 or 8) of register r as a big endian number at m
            s_bf_put(MO* m, int n, int r) -> void
            {
                int t;
                MI* u;
                if (n == 1)
                {
                    this.s_mi2(M_MOV, 1, this.s_mo_r(r, 1), this.s_mo_copy(m));
                    ->;
                };
                if (n >= 4 | n == 2)
                {
                    if ((this.feat `& XF_MOVBE) != 0)
                    {
                        u = this.s_mi2(M_UN, n, this.s_mo_r(r, n), this.s_mo_copy(m));
                        u.cc = U_MOVBE;
                        ->;
                    };
                };
                t = this.s_nv(0);
                this.s_mov(this.s_mo_r(r, 8), t, 8);
                u = this.s_mi2(M_UN, n, this.s_mo_r(t, n), this.s_mo_r(t, n));
                u.cc = U_BSWAP;
                this.s_mi2(M_MOV, n, this.s_mo_r(t, n), this.s_mo_copy(m));
                ->;
            };

            // Keeps the low w bits of register r, zero extended
            s_bf_trunc(int r, int w) -> void
            {
                MI* mv;
                if (w >= 64) { ->; };
                if (w == 8) { this.s_mi2(M_MOVZX, 1, this.s_mo_r(r, 1), this.s_mo_r(r, 4)); ->; };
                if (w == 16) { this.s_mi2(M_MOVZX, 2, this.s_mo_r(r, 2), this.s_mo_r(r, 4)); ->; };
                if (w == 32)
                {
                    // a move of a register onto itself is dropped unless it is marked to clear the upper half
                    mv = this.s_mi2(M_MOV, 4, this.s_mo_r(r, 4), this.s_mo_r(r, 4));
                    mv.cc = 1;
                    ->;
                };
                this.s_mi3c(M_ALU, 8, this.s_mo_r(r, 8), this.s_mask(((i64)1 << (i64)w) - (i64)1), this.s_mo_r(r, 8), A_AND);
                ->;
            };

            // Value of the bit field of width w that starts sh bits into the bytes at m. Bit 0 of the
            // bytes is the most significant bit of the first byte, so the n bytes read as one big endian
            // number whose top bits are the field.
            s_bf_read(MO* m, int sh, int w) -> int
            {
                int n = (sh + w + 7) / 8;
                int b, down;
                if (n > 9) { this.s_fail(g"bit field spans more than 9 bytes\0"); -> this.s_nv(0); };
                if (n == 9) { -> this.s_bf_read_top(m, sh, w); };
                b = this.s_bf_be(m, n);
                down = this.bf_bits - sh - w;
                if (down > 0) { this.s_mi3c(M_SHIFT, 8, this.s_mo_r(b, 8), this.s_mo_i((i64)down), this.s_mo_r(b, 8), S_SHR); };
                // the bits in front of the field are only there when it does not start at the first bit
                if (sh > 0) { this.s_bf_trunc(b, w); };
                -> b;
            };

            // Stores the constant val (low w bits) into the bit field that starts sh bits into the bytes at m, byte by byte:
            // a whole byte is stored, a partial byte is cleared and set in memory.
            s_bf_write_c(MO* m, int sh, int w, i64 val) -> void
            {
                int n = (sh + w + 7) / 8;
                int bi, lo, hi, len, kend, r, j, bm;
                i64 fv, bv, run;
                bool ok;
                if (w < 64) { val = val `& (((i64)1 << (i64)w) - (i64)1); };
                bi = 0;
                while (bi < n)
                {
                    lo = sh - 8 * bi;
                    if (lo < 0) { lo = 0; };
                    hi = sh + w - 8 * bi;
                    if (hi > 8) { hi = 8; };
                    len = hi - lo;
                    // the field bits (counted from its first bit) the byte takes
                    kend = 8 * bi + hi - sh;
                    fv = val >> (i64)(w - kend);
                    if (len < 64) { fv = fv `& (((i64)1 << (i64)len) - (i64)1); };
                    bv = fv << (i64)(8 - hi);
                    bm = (((1 << len) - 1) << (8 - hi));
                    if (len == 8)
                    {
                        // a run of whole bytes goes out in one store
                        r = 1;
                        run = bv;
                        if (bi + 3 < n & n - bi >= 4)
                        {
                            ok = true;
                            j = 1;
                            while (j < 4)
                            {
                                if (sh > 8 * (bi + j) | sh + w < 8 * (bi + j + 1)) { ok = false; };
                                j++;
                            };
                            if (ok) { r = 4; };
                        };
                        if (r == 1 & bi + 1 < n)
                        {
                            if (sh <= 8 * (bi + 1) & sh + w >= 8 * (bi + 2)) { r = 2; };
                        };
                        if (r > 1)
                        {
                            run = (i64)0;
                            j = 0;
                            while (j < r)
                            {
                                kend = 8 * (bi + j) + 8 - sh;
                                fv = (val >> (i64)(w - kend)) `& (i64)255;
                                run = run `| (fv << (i64)(8 * j));
                                j++;
                            };
                            // the first byte is the lowest address, so it is the lowest byte of the number
                            this.s_mi2(M_MOV, r, this.s_mo_i(run), this.s_mo_off(m, bi));
                            bi = bi + r;
                            continue;
                        };
                        this.s_mi2(M_MOV, 1, this.s_mo_i(bv), this.s_mo_off(m, bi));
                        bi++;
                        continue;
                    };
                    if (fv == (i64)0)
                    {
                        this.s_rmw(this.s_mo_i((i64)(255 - bm)), this.s_mo_off(m, bi), A_AND);
                    }
                    else
                    {
                        if (fv != (((i64)1 << (i64)len) - (i64)1))
                        {
                            this.s_rmw(this.s_mo_i((i64)(255 - bm)), this.s_mo_off(m, bi), A_AND);
                        };
                        this.s_rmw(this.s_mo_i(bv), this.s_mo_off(m, bi), A_OR);
                    };
                    bi++;
                };
                ->;
            };

            // Stores the low w bits of register v into the bit field that starts sh bits into the bytes at m,
            // the other bits of those bytes are kept
            s_bf_write(MO* m, int sh, int w, int v) -> void
            {
                int n = (sh + w + 7) / 8;
                int t, o, bits, up;
                i64 fm = (i64)0 - (i64)1;
                int sz;
                if (n > 9) { this.s_fail(g"bit field spans more than 9 bytes\0"); ->; };
                if (n == 9 | n == 3 | n == 5 | n == 6 | n == 7) { this.s_bf_write_top(m, sh, w, v); ->; };
                // a field that fills its bytes is stored as it is
                if (sh == 0 & w == 8 * n)
                {
                    this.s_bf_put(m, n, v);
                    ->;
                };
                if (w < 64) { fm = ((i64)1 << (i64)w) - (i64)1; };
                t = this.s_nv(0);
                this.s_mov(this.s_mo_r(v, 8), t, 8);
                if (n == 1)
                {
                    // inside one byte: clear the field in memory and or the new bits in
                    up = 8 - sh - w;
                    this.s_mi3c(M_ALU, 4, this.s_mo_r(t, 4), this.s_mo_i(fm), this.s_mo_r(t, 4), A_AND);
                    if (up > 0) { this.s_mi3c(M_SHIFT, 4, this.s_mo_r(t, 4), this.s_mo_i((i64)up), this.s_mo_r(t, 4), S_SHL); };
                    this.s_rmw(this.s_mo_i((i64)(255 - (((1 << w) - 1) << up))), this.s_mo_copy(m), A_AND);
                    this.s_rmw(this.s_mo_r(t, 1), this.s_mo_copy(m), A_OR);
                    ->;
                };
                // 2, 4 or 8 bytes: the big endian number, field replaced, stored back
                o = this.s_bf_be(m, n);
                bits = this.bf_bits;
                sz = 8;
                if (bits < 64) { sz = 4; };
                up = bits - sh - w;
                if (w < 64) { this.s_mi3c(M_ALU, sz, this.s_mo_r(t, sz), this.s_mask(fm), this.s_mo_r(t, sz), A_AND); };
                if (up > 0)
                {
                    this.s_mi3c(M_SHIFT, sz, this.s_mo_r(t, sz), this.s_mo_i((i64)up), this.s_mo_r(t, sz), S_SHL);
                    fm = fm << (i64)up;
                };
                fm = (i64)0 - (i64)1 - fm;
                if (bits < 64) { fm = fm `& (((i64)1 << (i64)bits) - (i64)1); };
                this.s_mi3c(M_ALU, sz, this.s_mo_r(o, sz), this.s_mask(fm), this.s_mo_r(o, sz), A_AND);
                this.s_mi3c(M_ALU, sz, this.s_mo_r(o, sz), this.s_mo_r(t, sz), this.s_mo_r(o, sz), A_OR);
                this.s_bf_put(m, n, o);
                ->;
            };

            s_isel_load(SI* x) -> void
            {
                IRType* t = x.ty;
                MO* m;
                int sz, d, r;
                if (x.flag & SSA_OPT_CMPMEM == 1) { ->; };
                if (this.s_isfp(t)) { this.s_fp_load(x); ->; };
                if (this.s_isagg(t)) { this.s_agg_load(x); ->; };
                if (t.kind != LK.INT & t.kind != LK.PTR) { this.s_fail(g"load type\0"); ->; };
                if (t.kind == LK.INT)
                {
                    if (t.width > 64) { this.s_fail(g"wide load\0"); ->; };
                };
                sz = this.s_vsz(t);
                this.bf_w = 0;
                m = this.s_addr(x.a);
                if (this.bf_w > 0)
                {
                    r = this.s_bf_read(m, this.bf_sh, this.bf_w);
                    d = this.s_def(x.res, 0);
                    this.s_mov(this.s_mo_r(r, 8), d, 8);
                    ->;
                };
                d = this.s_def(x.res, 0);
                if (sz < 4) { this.s_mi2(M_MOVZX, sz, m, this.s_mo_r(d, 4)); ->; };
                this.s_mi2(M_MOV, sz, m, this.s_mo_r(d, sz));
                ->;
            };

            s_isel_store(SI* x) -> void
            {
                IRType* t = x.ty;
                MO* m;
                MO* s;
                int sz, r;
                if (this.s_isfp(t)) { this.s_fp_store(x); ->; };
                if (this.s_isagg(t)) { this.s_agg_store(x); ->; };
                if (t.kind != LK.INT & t.kind != LK.PTR) { this.s_fail(g"store type\0"); ->; };
                if (t.kind == LK.INT)
                {
                    if (t.width > 64) { this.s_fail(g"wide store\0"); ->; };
                };
                sz = this.s_vsz(t);
                this.bf_w = 0;
                if (x.b.vr == 0 & x.b.di != (void*)0)
                {
                    // a folded address may name a bit packed member
                    m = this.s_addr(x.b);
                    if (this.bf_w > 0)
                    {
                        if (this.s_isint(x.a) & this.bf_w + this.bf_sh <= 64)
                        {
                            this.s_bf_write_c(m, this.bf_sh, this.bf_w, this.scv);
                            ->;
                        };
                        r = this.s_reg(x.a);
                        this.s_bf_write(m, this.bf_sh, this.bf_w, r);
                        ->;
                    };
                    s = this.s_srci(x.a, sz);
                    this.s_mi2(M_MOV, sz, s, m);
                    ->;
                };
                s = this.s_srci(x.a, sz);
                m = this.s_addr(x.b);
                this.s_mi2(M_MOV, sz, s, m);
                ->;
            };

            s_isel_gep(SI* x) -> void
            {
                MO* m;
                int d;
                if (x.flag) { ->; };
                m = this.s_gepmem(x);
                if (this.bf_w > 0) { this.s_fail(g"address of a bit packed member\0"); ->; };
                if (m.r2 < 0 & m.fo < 0 & m.sym == (byte*)0 & m.imm == (i64)0 & m.r >= 0)
                {
                    // the address is the base register
                    d = this.s_def(x.res, 0);
                    this.s_mov(this.s_mo_r(m.r, 8), d, 8);
                    ->;
                };
                d = this.s_def(x.res, 0);
                this.s_mi2(M_LEA, 8, m, this.s_mo_r(d, 8));
                ->;
            };

            s_isel_select(SI* x) -> void
            {
                IRType* t = x.ty;
                int sz, ra, rb, d, cc;
                MI* m;
                IRValue* c = this.s_res(x.a);
                if (this.s_isfp(t)) { this.s_fp_select(x); ->; };
                if (t.kind != LK.INT & t.kind != LK.PTR) { this.s_fail(g"select type\0"); ->; };
                if (t.kind == LK.INT)
                {
                    if (t.width > 64) { this.s_fail(g"wide select\0"); ->; };
                };
                sz = this.s_asz(t);
                if (this.s_isint(c))
                {
                    d = this.s_def(x.res, 0);
                    if (this.scv != (i64)0) { this.s_mov(this.s_src(x.b), d, sz); } else { this.s_mov(this.s_src(x.c), d, sz); };
                    ->;
                };
                ra = this.s_reg(x.b);
                rb = this.s_reg(x.c);
                cc = this.s_cond(c);
                d = this.s_def(x.res, 0);
                m = this.s_mi3(M_CMOV, sz, this.s_mo_r(ra, sz), this.s_mo_r(rb, sz), this.s_mo_r(d, sz));
                m.cc = cc;
                ->;
            };

            // Recognizes the bit expressions that have one BMI instruction. Returns 0 for none, else
            //   1 a & ~b    andn: bm_a is b, bm_b is a
            //   2 x & (x - 1)    blsr: bm_a is x
            //   3 x & -x    blsi: bm_a is x
            //   4 x & ((1 << n) - 1)    bzhi: bm_a is x, bm_b is n
            //   5 (x << c) | (x >> (w - c))    rorx: bm_a is x, bm_n the right rotation
            // bm_s1 and bm_s2 are the instructions that fold into u.
            // The match of s_bmi when the processor has the instruction for it
            s_bmi(SI* u) -> int
            {
                int r = this.s_bmi_raw(u);
                if (r == 1 | r == 2 | r == 3 | r == 7) { if ((this.feat `& XF_BMI1) == 0) { r = 0; }; };
                if (r == 4) { if ((this.feat `& XF_BMI2) == 0) { r = 0; }; };
                -> r;
            };

            s_runb() -> bool
            {
                GF* g = this.sf;
                bool any = false;
                int i, j, nphi, mode, cst, w, sg;
                GB* h;
                GB* pg;
                GB* lg;
                GB* sg2;
                IRBlock* hb;
                IRBlock* sb;
                IRBlock* lb;
                IRBlock* pb;
                IRBlock* xb;
                SI* t;
                SI* ph;
                SI* x;
                SI* tp;
                SI* st;
                SI* ld1;
                SI* ld2;
                SI* gp1;
                SI* gp2;
                SI* cm;
                SI* ad;
                IRValue* iv;
                IRValue* nn;
                IRValue* idx;
                IRValue* base1;
                IRValue* base2;
                IRValue* i0;
                IRValue* a;
                IRValue* b;
                IRValue* len;
                IRValue* p0;
                IRValue* q0;
                IRValue* res;
                IRValue* callee;
                IRValue** av;
                IRType** pt;
                IRType* ft;
                IRType* t64;
                IRType* t32;
                bool ok, cont;
                if (SSA_OPT_RUNB != 1) { -> false; };
                if ((this.feat `& XF_AVX2) == 0) { -> false; };
                this.s_dce();
                i = 0;
                while (i < g.nb)
                {
                    h = (GB*)g.bl.items[i];
                    i++;
                    hb = h.ib;
                    if (h.preds.len != 2 | hb.insts == (PtrVec*)0) { continue; };
                    t = this.s_term(hb);
                    if (t == (SI*)0) { continue; };
                    if (t.op != SO_CBR) { continue; };
                    nphi = 0;
                    ph = (SI*)0;
                    j = 0;
                    while (j < hb.insts.len)
                    {
                        x = (SI*)hb.insts.items[j];
                        if (x.op != SO_PHI) { break; };
                        ph = x;
                        nphi++;
                        j++;
                    };
                    if (nphi != 1 | ph.n != 2) { continue; };
                    if (ph.res.ty.kind != LK.INT) { continue; };
                    if (ph.res.ty.width != 32 & ph.res.ty.width != 64) { continue; };
                    // the test block after the header
                    sb = t.t;
                    if (t.k == 1) { sb = t.f; };
                    if (sb == hb) { continue; };
                    if (!this.s_cntchk(hb, hb, sb, sb, 1)) { continue; };
                    iv = this.cn_v;
                    nn = this.cn_n;
                    sg = this.cn_s;
                    if (iv != this.s_res(ph.res)) { continue; };
                    sg2 = (GB*)0;
                    j = 0;
                    while (j < g.nb) { if (((GB*)g.bl.items[j]).ib == sb) { sg2 = (GB*)g.bl.items[j]; }; j++; };
                    if (sg2 == (GB*)0) { continue; };
                    if (sg2.preds.len != 1 | sg2.ib.insts == (PtrVec*)0) { continue; };
                    if (((GB*)sg2.preds.items[0]).ib != hb) { continue; };
                    st = this.s_term(sb);
                    if (st == (SI*)0) { continue; };
                    if (st.op != SO_CBR) { continue; };
                    // the latch is the successor that steps the index and goes back to the header
                    lb = st.t;
                    xb = st.f;
                    lg = (GB*)0;
                    j = 0;
                    while (j < 2)
                    {
                        pg = (GB*)0;
                        w = 0;
                        while (w < g.nb) { if (((GB*)g.bl.items[w]).ib == lb) { pg = (GB*)g.bl.items[w]; }; w++; };
                        if (pg != (GB*)0)
                        {
                            if (pg.preds.len == 1 & pg.ib.insts != (PtrVec*)0)
                            {
                                if (pg.ib.insts.len == 2 & ((GB*)pg.preds.items[0]).ib == sb)
                                {
                                    tp = this.s_term(lb);
                                    if (tp != (SI*)0) { if (tp.op == SO_BR) { if (tp.t == hb) { lg = pg; }; }; };
                                };
                            };
                        };
                        if (lg != (GB*)0) { break; };
                        lb = st.f;
                        xb = st.t;
                        j++;
                    };
                    if (lg == (GB*)0) { continue; };
                    lb = lg.ib;
                    if (xb == hb | xb == sb | xb == lb) { continue; };
                    // the latch steps the index by one
                    ad = (SI*)lb.insts.items[0];
                    if (ad.op != SO_BIN | ad.k != SB_ADD | this.s_res(ad.a) != iv) { continue; };
                    if (!this.s_cint(this.s_res(ad.b))) { continue; };
                    if (this.scv != (i64)1) { continue; };
                    a = this.s_phi_from(ph, lb);
                    if (a == (IRValue*)0) { continue; };
                    if (this.s_res(a) != this.s_res(ad.res)) { continue; };
                    pg = (GB*)h.preds.items[0];
                    if (pg.ib == lb) { pg = (GB*)h.preds.items[1]; };
                    pb = pg.ib;
                    tp = this.s_term(pb);
                    if (tp == (SI*)0) { continue; };
                    if (tp.op != SO_BR) { continue; };
                    if (this.s_prevcall(pb, g"ideka.runb\0")) { continue; };
                    // the test block: loads, casts, one compare, the branch
                    ld1 = (SI*)0;
                    ld2 = (SI*)0;
                    gp1 = (SI*)0;
                    gp2 = (SI*)0;
                    cm = (SI*)0;
                    ok = true;
                    j = 0;
                    while (j < sb.insts.len - 1)
                    {
                        x = (SI*)sb.insts.items[j];
                        j++;
                        if (x.op == SO_GEP) { if (gp1 == (SI*)0) { gp1 = x; } elif (gp2 == (SI*)0) { gp2 = x; } else { ok = false; }; }
                        elif (x.op == SO_LOAD) { if (ld1 == (SI*)0) { ld1 = x; } elif (ld2 == (SI*)0) { ld2 = x; } else { ok = false; }; }
                        elif (x.op == SO_CMP) { if (cm != (SI*)0) { ok = false; }; cm = x; }
                        elif (x.op == SO_CAST) { }
                        else { ok = false; };
                    };
                    if (!ok | gp1 == (SI*)0 | ld1 == (SI*)0 | cm == (SI*)0) { continue; };
                    if (ld1.vol | ld1.ty.kind != LK.INT | ld1.ty.width != 8) { continue; };
                    if (cm.n != 0 | cm.vol | (cm.k != SP_EQ & cm.k != SP_NE)) { continue; };
                    if (this.s_res(cm.res).nu != 1) { continue; };
                    if (this.s_res(st.a) != this.s_res(cm.res)) { continue; };
                    // the loop goes on to lb when the compare holds or when it does not
                    cont = st.t == lb;
                    if (st.k == 1) { cont = st.f == lb; };
                    if (cm.k == SP_NE) { cont = !cont; };
                    // cont: the loop goes on exactly when the two sides of the compare are equal
                    mode = 0;
                    cst = 0;
                    if (ld2 == (SI*)0)
                    {
                        if (gp2 != (SI*)0) { continue; };
                        if (this.s_res(cm.a) != this.s_res(ld1.res)) { continue; };
                        if (!this.s_cint(this.s_res(cm.b))) { continue; };
                        cst = (int)this.scv;
                        if (cst < 0 | cst > 255) { continue; };
                        if (!cont) { mode = 1; };
                    }
                    else
                    {
                        if (gp2 == (SI*)0 | ld2.vol | ld2.ty.kind != LK.INT | ld2.ty.width != 8) { continue; };
                        if (!cont) { continue; };
                        mode = 2;
                        if (!((this.s_res(cm.a) == this.s_res(ld1.res) & this.s_res(cm.b) == this.s_res(ld2.res)) | (this.s_res(cm.b) == this.s_res(ld1.res) & this.s_res(cm.a) == this.s_res(ld2.res)))) { continue; };
                        if (this.s_res(ld2.a) != this.s_res(gp2.res)) { continue; };
                    };
                    if (this.s_res(ld1.a) != this.s_res(gp1.res)) { continue; };
                    // the addresses are base + i
                    if (gp1.n != 1 | gp1.res.nu != 1) { continue; };
                    base1 = this.s_res(gp1.a);
                    if (base1.ty.kind != LK.PTR) { continue; };
                    if (this.a_size(base1.ty.elem) != 1) { continue; };
                    if (this.s_defin(base1, hb) | this.s_defin(base1, sb) | this.s_defin(base1, lb)) { continue; };
                    idx = this.s_res(gp1.args[0]);
                    if (idx != iv)
                    {
                        if (idx.di == (void*)0) { continue; };
                        x = (SI*)idx.di;
                        if (x.op != SO_CAST | x.res != idx | idx.nu != 1 | (x.k != SK_ZEXT & x.k != SK_SEXT)) { continue; };
                        if (this.s_res(x.a) != iv) { continue; };
                    };
                    base2 = (IRValue*)0;
                    if (mode == 2)
                    {
                        if (gp2.n != 1 | gp2.res.nu != 1) { continue; };
                        base2 = this.s_res(gp2.a);
                        if (base2.ty.kind != LK.PTR) { continue; };
                        if (this.a_size(base2.ty.elem) != 1) { continue; };
                        if (this.s_defin(base2, hb) | this.s_defin(base2, sb) | this.s_defin(base2, lb)) { continue; };
                        idx = this.s_res(gp2.args[0]);
                        if (idx != iv)
                        {
                            if (idx.di == (void*)0) { continue; };
                            x = (SI*)idx.di;
                            if (x.op != SO_CAST | x.res != idx | idx.nu != 1 | (x.k != SK_ZEXT & x.k != SK_SEXT)) { continue; };
                            if (this.s_res(x.a) != iv) { continue; };
                        };
                    };
                    if (!this.s_cint(nn)) { if (this.s_defin(nn, hb) | this.s_defin(nn, sb) | this.s_defin(nn, lb)) { continue; }; };
                    i0 = this.s_phi_from(ph, pb);
                    if (i0 == (IRValue*)0) { continue; };
                    i0 = this.s_res(i0);
                    // rewrite: the search goes before the branch of the predecessor
                    t64 = this.t_int(64);
                    t32 = this.t_int(32);
                    this.cb = pb;
                    tp = this.s_term(pb);
                    pb.insts.len = pb.insts.len - 1;
                    a = nn;
                    b = i0;
                    if (ph.res.ty.width == 32)
                    {
                        a = this.new_value(t64, g"%vr\0");
                        if (sg == 1) { this.s_r_castk(SK_SEXT, nn, t64, a); } else { this.s_r_castk(SK_ZEXT, nn, t64, a); };
                        b = this.new_value(t64, g"%vr\0");
                        if (sg == 1) { this.s_r_castk(SK_SEXT, i0, t64, b); } else { this.s_r_castk(SK_ZEXT, i0, t64, b); };
                    };
                    len = this.s_ubin(SB_SUB, a, b);
                    idx = (IRValue*)0;
                    p0 = base1;
                    q0 = base1;
                    if (!(this.s_cint(i0) & this.scv == (i64)0))
                    {
                        idx = i0;
                        if (ph.res.ty.width == 32)
                        {
                            idx = this.new_value(t64, g"%vr\0");
                            if (sg == 1) { this.s_r_castk(SK_SEXT, i0, t64, idx); } else { this.s_r_castk(SK_ZEXT, i0, t64, idx); };
                        };
                        p0 = this.new_value(base1.ty, g"%vr\0");
                        av = (IRValue**)this.s_ar(8);
                        av[0] = idx;
                        this.s_r_gep(base1, av, 1, p0);
                    };
                    if (mode == 2)
                    {
                        q0 = base2;
                        if (idx != (IRValue*)0)
                        {
                            q0 = this.new_value(base2.ty, g"%vr\0");
                            av = (IRValue**)this.s_ar(8);
                            av[0] = idx;
                            this.s_r_gep(base2, av, 1, q0);
                        };
                    };
                    pt = (IRType**)this.s_ar(32);
                    pt[0] = p0.ty;
                    pt[1] = t64;
                    pt[2] = q0.ty;
                    pt[3] = t64;
                    ft = this.t_func(t64, pt, 4, false);
                    callee = this.new_value(this.t_ptr(ft), g"@\"ideka.runb\"\0");
                    res = this.new_value(t64, g"%vr\0");
                    av = (IRValue**)this.s_ar(32);
                    av[0] = p0;
                    av[1] = len;
                    av[2] = q0;
                    av[3] = this.s_kint(t64, (u64)(cst + mode * 256));
                    this.s_r_call(callee, av, 4, res, false);
                    a = res;
                    if (ph.res.ty.width == 32)
                    {
                        a = this.new_value(t32, g"%vr\0");
                        this.s_r_castk(SK_TRUNC, res, t32, a);
                    };
                    b = this.s_ubin(SB_ADD, i0, a);
                    pv_push(pb.insts, (void*)tp);
                    j = 0;
                    while (j < ph.n) { if (ph.blks[j] == pb) { ph.args[j] = b; }; j++; };
                    any = true;
                };
                -> any;
            };

            // Finds the loops that count the bytes equal to a constant,
            //   while (i < n & cur < limit) { if (s[i] == c) { cur++; } i++; }
            // with or without the test of cur. Whole 32 byte blocks that cannot end the loop are consumed by one search
            // before the loop, which then runs for the rest.
            s_cntb() -> bool
            {
                GF* g = this.sf;
                bool any = false;
                int i, j, nphi, w, sg1, sg2, k;
                GB* h;
                GB* pg;
                GB* lg;
                IRBlock* hb;
                IRBlock* sb;
                IRBlock* bb;
                IRBlock* pb;
                IRBlock* eb;
                SI* t;
                SI* ph1;
                SI* ph2;
                SI* iph;
                SI* cph;
                SI* x;
                SI* ld;
                SI* gp;
                SI* cmpb;
                SI* sel;
                SI* ad;
                SI* ai;
                SI* tp;
                IRValue* iv;
                IRValue* cv;
                IRValue* nn;
                IRValue* ll;
                IRValue* base;
                IRValue* idx;
                IRValue* i0;
                IRValue* c0;
                IRValue* a;
                IRValue* b;
                IRValue* p0;
                IRValue* len;
                IRValue* bud;
                IRValue* res;
                IRValue* callee;
                IRValue* bytev;
                IRValue** av;
                IRType** pt;
                IRType* ft;
                IRType* t64;
                IRType* t32;
                bool ok, haslim;
                if (SSA_OPT_CNTB != 1) { -> false; };
                if ((this.feat `& XF_AVX2) == 0 | (this.feat `& XF_POPCNT) == 0) { -> false; };
                this.s_dce();
                i = 0;
                while (i < g.nb)
                {
                    h = (GB*)g.bl.items[i];
                    i++;
                    hb = h.ib;
                    if (h.preds.len != 2 | hb.insts == (PtrVec*)0) { continue; };
                    t = this.s_term(hb);
                    if (t == (SI*)0) { continue; };
                    if (t.op != SO_CBR) { continue; };
                    // two phis, one compare and the branch
                    nphi = 0;
                    ph1 = (SI*)0;
                    ph2 = (SI*)0;
                    j = 0;
                    while (j < hb.insts.len)
                    {
                        x = (SI*)hb.insts.items[j];
                        if (x.op != SO_PHI) { break; };
                        if (nphi == 0) { ph1 = x; };
                        if (nphi == 1) { ph2 = x; };
                        nphi++;
                        j++;
                    };
                    if (nphi != 2 | ph1.n != 2 | ph2.n != 2) { continue; };
                    // the block the loop goes on to from the header
                    sb = t.t;
                    if (t.k == 1) { sb = t.f; };
                    bb = sb;
                    haslim = false;
                    if (sb == hb) { continue; };
                    // with a second test the body is the block after it
                    x = this.s_term(sb);
                    if (x == (SI*)0) { continue; };
                    if (x.op == SO_CBR) { haslim = true; };
                    if (haslim)
                    {
                        bb = x.t;
                        if (x.k == 1) { bb = x.f; };
                    };
                    if (bb == hb | bb == sb & haslim) { continue; };
                    // the header test, and the second test when there is one
                    if (!this.s_cntchk(hb, hb, sb, bb, 2)) { continue; };
                    if (this.cn_w != 32) { continue; };
                    iv = this.cn_v;
                    nn = this.cn_n;
                    sg1 = this.cn_s;
                    eb = this.cn_e;
                    cv = (IRValue*)0;
                    ll = (IRValue*)0;
                    sg2 = 0;
                    if (haslim)
                    {
                        if (!this.s_cntchk(sb, hb, sb, bb, 0)) { continue; };
                        if (this.cn_w != 32) { continue; };
                        if (this.cn_e != eb) { continue; };
                        cv = this.cn_v;
                        ll = this.cn_n;
                        sg2 = this.cn_s;
                    };
                    // the body block has the header or the test block as its only predecessor and goes back to the header
                    lg = (GB*)0;
                    pg = (GB*)0;
                    if (((GB*)h.preds.items[0]).ib == bb) { lg = (GB*)h.preds.items[0]; pg = (GB*)h.preds.items[1]; }
                    elif (((GB*)h.preds.items[1]).ib == bb) { lg = (GB*)h.preds.items[1]; pg = (GB*)h.preds.items[0]; };
                    if (lg == (GB*)0) { continue; };
                    if (lg.preds.len != 1 | pg == h | lg == h) { continue; };
                    if (haslim) { if (((GB*)lg.preds.items[0]).ib != sb) { continue; }; }
                    else { if (((GB*)lg.preds.items[0]).ib != hb) { continue; }; };
                    pb = pg.ib;
                    tp = this.s_term(pb);
                    if (tp == (SI*)0) { continue; };
                    if (tp.op != SO_BR) { continue; };
                    if (this.s_prevcall(pb, g"ideka.cntstop\0")) { continue; };
                    tp = this.s_term(bb);
                    if (tp == (SI*)0) { continue; };
                    if (tp.op != SO_BR) { continue; };
                    if (tp.t != hb) { continue; };
                    // the body: gep, load, compare, add, select, add, branch
                    gp = (SI*)0;
                    ld = (SI*)0;
                    cmpb = (SI*)0;
                    sel = (SI*)0;
                    ad = (SI*)0;
                    ai = (SI*)0;
                    ok = true;
                    j = 0;
                    while (j < bb.insts.len - 1)
                    {
                        x = (SI*)bb.insts.items[j];
                        j++;
                        if (x.op == SO_GEP) { if (gp != (SI*)0) { ok = false; }; gp = x; }
                        elif (x.op == SO_LOAD) { if (ld != (SI*)0) { ok = false; }; ld = x; }
                        elif (x.op == SO_CMP) { if (cmpb != (SI*)0) { ok = false; }; cmpb = x; }
                        elif (x.op == SO_SELECT) { if (sel != (SI*)0) { ok = false; }; sel = x; }
                        elif (x.op == SO_CAST) { }
                        elif (x.op == SO_BIN)
                        {
                            if (x.k != SB_ADD) { ok = false; }
                            elif (this.s_res(x.a) != this.s_res(ph1.res) & this.s_res(x.a) != this.s_res(ph2.res)) { ok = false; }
                            elif (ad == (SI*)0) { ad = x; }
                            elif (ai == (SI*)0) { ai = x; }
                            else { ok = false; };
                        }
                        else { ok = false; };
                    };
                    if (!ok | gp == (SI*)0 | ld == (SI*)0 | cmpb == (SI*)0 | sel == (SI*)0 | ad == (SI*)0 | ai == (SI*)0) { continue; };
                    if (ld.vol | ld.ty.kind != LK.INT | ld.ty.width != 8) { continue; };
                    // the add the select uses steps the counter, the other steps the index
                    if (this.s_res(sel.b) == this.s_res(ai.res) | this.s_res(sel.c) == this.s_res(ai.res)) { x = ad; ad = ai; ai = x; };
                    if (this.s_res(sel.b) != this.s_res(ad.res) & this.s_res(sel.c) != this.s_res(ad.res)) { continue; };
                    iph = ph1;
                    cph = ph2;
                    if (this.s_res(ad.a) == this.s_res(ph1.res)) { iph = ph2; cph = ph1; };
                    if (this.s_res(ai.a) != this.s_res(iph.res) | this.s_res(ad.a) != this.s_res(cph.res)) { continue; };
                    // the tests: the index has a bound, the counter a limit when there is one
                    if (this.s_res(iph.res) == iv) { }
                    elif (haslim & this.s_res(iph.res) == cv)
                    {
                        // the limit test came first
                        a = iv;
                        iv = cv;
                        cv = a;
                        a = nn;
                        nn = ll;
                        ll = a;
                        k = sg1;
                        sg1 = sg2;
                        sg2 = k;
                    }
                    else { continue; };
                    if (!this.s_cint(this.s_res(ad.b))) { continue; };
                    if (this.scv != (i64)1) { continue; };
                    if (!this.s_cint(this.s_res(ai.b))) { continue; };
                    if (this.scv != (i64)1) { continue; };
                    // the address is base + i
                    if (this.s_res(gp.res) != this.s_res(ld.a)) { continue; };
                    if (gp.n != 1 | gp.res.nu != 1) { continue; };
                    base = this.s_res(gp.a);
                    if (base.ty.kind != LK.PTR) { continue; };
                    if (this.a_size(base.ty.elem) != 1) { continue; };
                    if (this.s_defin(base, hb) | this.s_defin(base, bb) | this.s_defin(base, sb)) { continue; };
                    idx = this.s_res(gp.args[0]);
                    if (idx != iv)
                    {
                        if (idx.di == (void*)0) { continue; };
                        x = (SI*)idx.di;
                        if (x.op != SO_CAST | x.res != idx | idx.nu != 1 | (x.k != SK_ZEXT & x.k != SK_SEXT)) { continue; };
                        if (this.s_res(x.a) != iv) { continue; };
                    };
                    // the compare of the byte with a constant and the select that counts
                    if (cmpb.n != 0 | cmpb.vol | this.s_res(cmpb.a) != this.s_res(ld.res)) { continue; };
                    if (this.s_res(ld.res).nu != 1) { continue; };
                    if (!this.s_cint(this.s_res(cmpb.b))) { continue; };
                    k = (int)this.scv;
                    if (k < 0 | k > 255) { continue; };
                    if (this.s_res(sel.a) != this.s_res(cmpb.res)) { continue; };
                    if (cmpb.res.nu != 1) { continue; };
                    if (cmpb.k == SP_EQ)
                    {
                        if (this.s_res(sel.b) != this.s_res(ad.res) | this.s_res(sel.c) != this.s_res(cph.res)) { continue; };
                    }
                    elif (cmpb.k == SP_NE)
                    {
                        if (this.s_res(sel.c) != this.s_res(ad.res) | this.s_res(sel.b) != this.s_res(cph.res)) { continue; };
                    }
                    else { continue; };
                    if (ad.res.nu != 1) { continue; };
                    // the latch values
                    a = this.s_phi_from(iph, bb);
                    b = this.s_phi_from(cph, bb);
                    if (a == (IRValue*)0 | b == (IRValue*)0) { continue; };
                    if (this.s_res(a) != this.s_res(ai.res) | this.s_res(b) != this.s_res(sel.res)) { continue; };
                    if (cph.res.ty.kind != LK.INT | cph.res.ty.width != 32) { continue; };
                    // what the loop does not change
                    if (!this.s_cint(nn)) { if (this.s_defin(nn, hb) | this.s_defin(nn, sb) | this.s_defin(nn, bb)) { continue; }; };
                    if (haslim) { if (!this.s_cint(ll)) { if (this.s_defin(ll, hb) | this.s_defin(ll, sb) | this.s_defin(ll, bb)) { continue; }; }; };
                    i0 = this.s_phi_from(iph, pb);
                    c0 = this.s_phi_from(cph, pb);
                    if (i0 == (IRValue*)0 | c0 == (IRValue*)0) { continue; };
                    i0 = this.s_res(i0);
                    c0 = this.s_res(c0);
                    // rewrite: the search goes before the branch of the predecessor
                    t64 = this.t_int(64);
                    t32 = this.t_int(32);
                    this.cb = pb;
                    tp = this.s_term(pb);
                    pb.insts.len = pb.insts.len - 1;
                    // len = n - i0 and budget = limit - cur0 in 64 bits
                    a = this.new_value(t64, g"%vr\0");
                    if (sg1 == 1) { this.s_r_castk(SK_SEXT, nn, t64, a); } else { this.s_r_castk(SK_ZEXT, nn, t64, a); };
                    b = this.new_value(t64, g"%vr\0");
                    if (sg1 == 1) { this.s_r_castk(SK_SEXT, i0, t64, b); } else { this.s_r_castk(SK_ZEXT, i0, t64, b); };
                    len = this.s_ubin(SB_SUB, a, b);
                    if (haslim)
                    {
                        a = this.new_value(t64, g"%vr\0");
                        if (sg2 == 1) { this.s_r_castk(SK_SEXT, ll, t64, a); } else { this.s_r_castk(SK_ZEXT, ll, t64, a); };
                        b = this.new_value(t64, g"%vr\0");
                        if (sg2 == 1) { this.s_r_castk(SK_SEXT, c0, t64, b); } else { this.s_r_castk(SK_ZEXT, c0, t64, b); };
                        bud = this.s_ubin(SB_SUB, a, b);
                    }
                    else
                    {
                        bud = this.s_kint(t64, (u64)4611686018427387904);
                    };
                    // the first byte to look at
                    p0 = base;
                    if (!(this.s_cint(i0) & this.scv == (i64)0))
                    {
                        idx = this.new_value(t64, g"%vr\0");
                        if (sg1 == 1) { this.s_r_castk(SK_SEXT, i0, t64, idx); } else { this.s_r_castk(SK_ZEXT, i0, t64, idx); };
                        p0 = this.new_value(base.ty, g"%vr\0");
                        av = (IRValue**)this.s_ar(8);
                        av[0] = idx;
                        this.s_r_gep(base, av, 1, p0);
                    };
                    pt = (IRType**)this.s_ar(32);
                    pt[0] = p0.ty;
                    pt[1] = t64;
                    pt[2] = t64;
                    pt[3] = t64;
                    ft = this.t_func(t64, pt, 4, false);
                    callee = this.new_value(this.t_ptr(ft), g"@\"ideka.cntstop\"\0");
                    res = this.new_value(t64, g"%vr\0");
                    av = (IRValue**)this.s_ar(32);
                    av[0] = p0;
                    av[1] = len;
                    av[2] = bud;
                    av[3] = this.s_kint(t64, (u64)k);
                    this.s_r_call(callee, av, 4, res, false);
                    // bytes consumed in the high half, bytes counted in the low half
                    a = this.s_ubin(SB_LSHR, res, this.s_kint(t64, (u64)32));
                    b = this.new_value(t32, g"%vr\0");
                    this.s_r_castk(SK_TRUNC, a, t32, b);
                    a = this.new_value(t32, g"%vr\0");
                    this.s_r_castk(SK_TRUNC, res, t32, a);
                    b = this.s_ubin(SB_ADD, i0, b);
                    a = this.s_ubin(SB_ADD, c0, a);
                    pv_push(pb.insts, (void*)tp);
                    j = 0;
                    while (j < iph.n) { if (iph.blks[j] == pb) { iph.args[j] = b; }; j++; };
                    j = 0;
                    while (j < cph.n) { if (cph.blks[j] == pb) { cph.args[j] = a; }; j++; };
                    any = true;
                };
                -> any;
            };

            // Recognizes the root u. Returns 0 for none, 1 bswap, 2 bit reversal, 3 popcnt. ex_x is the operand.
            s_exo(SI* u) -> int
            {
                IRType* t = u.ty;
                int w, i, kind;
                bool bs, br;
                if (u.op != SO_BIN | u.vol | u.res == (IRValue*)0) { -> 0; };
                if (t.kind != LK.INT) { -> 0; };
                w = t.width;
                if (w != 16 & w != 32 & w != 64) { -> 0; };
                this.ex_x = (IRValue*)0;
                this.ex_n = 0;
                if (this.exm == (int*)0) { this.exm = this.s_iz(64 * 180); };
                if (this.exl == (PtrVec*)0) { this.exl = pv_new(); };
                this.exl.len = 0;
                if (u.k == SB_LSHR & w >= 32 & (this.feat `& XF_POPCNT) != 0) { if (this.s_expopc(u, w)) { -> 3; }; };
                this.exl.len = 0;
                this.ex_n = 0;
                this.ex_x = (IRValue*)0;
                if (u.k != SB_OR & u.k != SB_XOR & u.k != SB_ADD) { -> 0; };
                if (!this.s_exmap(u, 0, w, 0)) { -> 0; };
                if (this.ex_x == (IRValue*)0 | this.ex_n < 3) { -> 0; };
                if (!this.s_exuses()) { -> 0; };
                bs = true;
                br = true;
                i = 0;
                while (i < w)
                {
                    if (this.exm[i] != (w - 8 - 8 * (i / 8)) + (i `& 7)) { bs = false; };
                    if (this.exm[i] != w - 1 - i) { br = false; };
                    i++;
                };
                if (bs) { -> 1; };
                if (br) { -> 2; };
                -> 0;
            };

            s_lazy() -> void
            {
                GF* g = this.sf;
                int i, j, k;
                GB* gb;
                SI* x;
                SI* u;
                i = 0;
                while (i < g.nb)
                {
                    gb = (GB*)g.bl.items[i];
                    if (gb.ib.insts != (PtrVec*)0)
                    {
                        j = 0;
                        while (j < gb.ib.insts.len)
                        {
                            x = (SI*)gb.ib.insts.items[j];
                            if (SSA_OPT_BMIX == 1 & x.op == SO_BIN)
                            {
                                if (this.s_bmi(x) != 0)
                                {
                                    this.bm_s1.flag = true;
                                    if (this.bm_s2 != (SI*)0) { this.bm_s2.flag = true; };
                                };
                            };
                            if (SSA_OPT_EXO == 1 & x.op == SO_BIN & !x.flag)
                            {
                                if (this.s_exo(x) != 0)
                                {
                                    k = 0;
                                    while (k < this.exl.len)
                                    {
                                        u = (SI*)this.exl.items[k];
                                        if (u != x) { u.flag = true; };
                                        k++;
                                    };
                                };
                            };
                            if (x.op == SO_CMP)
                            {
                                if (this.s_btm(x))
                                {
                                    this.bm_s1.flag = true;
                                    this.bm_s2.flag = true;
                                };
                            };
                            if (x.res != (IRValue*)0)
                            {
                                if (x.res.nu == 1 & x.res.ui != (void*)0)
                                {
                                    u = (SI*)x.res.ui;
                                    if (u.bi == x.bi)
                                    {
                                        if (SSA_OPT_CMPMEM == 1 & x.op == SO_LOAD & !x.vol & u.op == SO_CMP)
                                        {
                                            if (this.s_cmpmem(gb, j, x, u)) { x.flag = true; };
                                        };
                                        if (x.op == SO_CMP & (x.n == 0 | this.s_fsingle(x)))
                                        {
                                            if ((u.op == SO_CBR | u.op == SO_SELECT) & u.a == x.res) { x.flag = true; };
                                        };
                                        if (x.op == SO_GEP)
                                        {
                                            if (u.op == SO_LOAD & u.a == x.res) { x.flag = true; };
                                            if (u.op == SO_GEP & u.a == x.res) { x.flag = true; };
                                            if (u.op == SO_STORE & u.b == x.res & u.a != x.res) { x.flag = true; };
                                        };
                                    };
                                };
                            };
                            j++;
                        };
                    };
                    i++;
                };
                ->;
            };

            // ----------------------------------------------------------
            // Calls and returns
            // ----------------------------------------------------------

            // The llvm intrinsics that become instructions
            s_intrin(SI* x, byte* sym) -> void
            {
                MI* m;
                IRType* t;
                int r, sz;
                int k = 0;
                if (this.a_pre(sym, g"llvm.trap\0")) { this.s_mi(M_UD2, 1); ->; };
                if (this.a_pre(sym, g"llvm.bswap.i\0"))
                {
                    t = x.ty;
                    if (t.kind != LK.INT | x.n != 1) { this.s_fail(sym); ->; };
                    if (t.width != 16 & t.width != 32 & t.width != 64) { this.s_fail(sym); ->; };
                    sz = t.width / 8;
                    r = this.s_reg(this.s_res(x.args[0]));
                    k = this.s_def(x.res, 0);
                    m = this.s_mi2(M_UN, sz, this.s_mo_r(r, sz), this.s_mo_r(k, sz));
                    m.cc = U_BSWAP;
                    ->;
                };
                if (this.a_pre(sym, g"llvm.ideka.strlen\0"))
                {
                    r = this.s_reg(this.s_res(x.args[0]));
                    k = this.s_def(x.res, 0);
                    m = this.s_mi2(M_STRLEN, 8, this.s_mo_r(r, 8), this.s_mo_r(k, 8));
                    m.clob = 1 `| 2 `| 4 `| 65536;
                    ->;
                };
                if (this.a_pre(sym, g"ideka.cntstop\0"))
                {
                    MO* c0 = this.s_src(x.args[0]);
                    MO* c1 = this.s_src(x.args[1]);
                    MO* c2 = this.s_src(x.args[2]);
                    if (!this.s_cint(this.s_res(x.args[3]))) { this.s_fail(sym); ->; };
                    this.s_mov(c0, 7, 8);
                    this.s_mov(c1, 6, 8);
                    this.s_mov(c2, 2, 8);
                    m = this.s_mi(M_CNTB, 8);
                    m.cc = (int)this.scv;
                    m.iu = 196;
                    m.id = 3;
                    m.clob = 3;
                    k = this.s_def(x.res, 0);
                    this.s_mov(this.s_mo_r(0, 8), k, 8);
                    ->;
                };
                if (this.a_pre(sym, g"ideka.fmap\0"))
                {
                    MO* f0 = this.s_src(x.args[0]);
                    MO* f1 = this.s_src(x.args[1]);
                    MO* f2 = this.s_src(x.args[2]);
                    MO* f3 = this.s_src(x.args[3]);
                    MO* f5 = this.s_src(x.args[5]);
                    MO* f6 = this.s_src(x.args[6]);
                    if (!this.s_cint(this.s_res(x.args[4]))) { this.s_fail(sym); ->; };
                    this.s_mov(f0, 7, 8);
                    this.s_mov(f1, 6, 8);
                    this.s_mov(f2, 2, 8);
                    this.s_mov(f3, 1, 8);
                    this.s_mov(f5, 8, 8);
                    this.s_mov(f6, 9, 8);
                    m = this.s_mi(M_FMAP, 8);
                    m.o0 = this.s_mo_i(this.scv);
                    m.iu = 2 `| 4 `| 64 `| 128 `| 256 `| 512;
                    m.id = 1;
                    m.clob = 1 `| 1024 `| 2048 `| (63 << 16);
                    k = this.s_def(x.res, 0);
                    this.s_mov(this.s_mo_r(0, 8), k, 8);
                    ->;
                };
                if (this.a_pre(sym, g"ideka.runb\0"))
                {
                    MO* r0 = this.s_src(x.args[0]);
                    MO* r1 = this.s_src(x.args[1]);
                    MO* r2 = this.s_src(x.args[2]);
                    if (!this.s_cint(this.s_res(x.args[3]))) { this.s_fail(sym); ->; };
                    this.s_mov(r0, 7, 8);
                    this.s_mov(r1, 6, 8);
                    this.s_mov(r2, 2, 8);
                    m = this.s_mi(M_RUNB, 8);
                    m.cc = (int)this.scv;
                    m.iu = 196;
                    m.id = 1;
                    m.clob = 1;
                    k = this.s_def(x.res, 0);
                    this.s_mov(this.s_mo_r(0, 8), k, 8);
                    ->;
                };
                if (this.a_pre(sym, g"llvm.bitreverse.i\0"))
                {
                    t = x.ty;
                    if (t.kind != LK.INT | x.n != 1) { this.s_fail(sym); ->; };
                    if (t.width != 8 & t.width != 16 & t.width != 32 & t.width != 64) { this.s_fail(sym); ->; };
                    sz = t.width / 8;
                    r = this.s_reg(this.s_res(x.args[0]));
                    k = this.s_def(x.res, 0);
                    this.s_mi2(M_BREV, sz, this.s_mo_r(r, sz), this.s_mo_r(k, sz));
                    ->;
                };
                if (this.a_pre(sym, g"llvm.va_start\0"))
                {
                    r = this.s_reg(this.s_res(x.args[0]));
                    this.s_mi1(M_VASTART, 8, this.s_mo_r(r, 8));
                    ->;
                };
                if (this.a_pre(sym, g"llvm.va_end\0")) { ->; };
                if (this.a_pre(sym, g"llvm.va_copy\0"))
                {
                    r = this.s_reg(this.s_res(x.args[0]));
                    k = this.s_reg(this.s_res(x.args[1]));
                    sz = 24;
                    if (this.a_win()) { sz = 8; };
                    this.s_copy(this.s_mo_mem(r, 0 - 1, 1, (i64)0, (byte*)0, 0 - 1), this.s_mo_mem(k, 0 - 1, 1, (i64)0, (byte*)0, 0 - 1), sz);
                    ->;
                };
                if (this.a_pre(sym, g"llvm.debugtrap\0")) { this.s_mi(M_INT3, 1); ->; };
                if (this.a_pre(sym, g"llvm.memset.\0")) { k = 1; };
                if (this.a_pre(sym, g"llvm.memcpy.\0")) { k = 2; };
                if (this.a_pre(sym, g"llvm.memmove.\0")) { k = 3; };
                if (k == 0 | x.n < 3) { this.s_fail(sym); ->; };
                MO* a0 = this.s_src(x.args[0]);
                MO* a1 = this.s_src(x.args[1]);
                MO* a2 = this.s_src(x.args[2]);
                this.s_mov(a0, 7, 8);
                if (k == 1)
                {
                    this.s_mov(a1, 0, 4);
                    this.s_mov(a2, 1, 8);
                    m = this.s_mi(M_REPSTOS, 1);
                    m.iu = 131;
                    m.id = 131;
                    ->;
                };
                this.s_mov(a1, 6, 8);
                this.s_mov(a2, 1, 8);
                if (k == 2) { m = this.s_mi(M_REPMOVS, 1); }
                else { m = this.s_mi(M_MEMMOVE, 1); };
                m.iu = 194;
                m.id = 194;
                ->;
            };

            s_isel_call(SI* x) -> void
            {
                IRValue* callee = this.s_res(x.a);
                IRType* fty = callee.ty.elem;
                IRType* rt = x.ty;
                IRValue* a;
                MO** sv;
                MO* s;
                MI* m;
                MO* tgt;
                byte* sym;
                int* ploc;
                int* poff;
                int* st;
                int i, p, r, sz, d, stk, mask, nf, rfo, wsh, afo;
                bool direct = false;
                bool fp, tail;
                IRFunc* cf = (IRFunc*)0;
                sym = (byte*)0;
                wsh = 0;
                if (this.a_pre(callee.text, g"asm\0")) { this.s_inline(x, callee); ->; };
                if (fty.kind != LK.FUNC) { this.s_fail(g"callee type\0"); ->; };
                if (rt.kind != LK.VOID & !this.s_isarg(rt) & !this.s_isag(rt)) { this.s_fail(g"call result type\0"); ->; };
                if (rt.kind == LK.INT)
                {
                    if (rt.width > 64) { this.s_fail(g"wide call result\0"); ->; };
                };
                if (callee.vr == 0 & callee.di == (void*)0)
                {
                    if (this.s_isc(callee))
                    {
                        if (this.sck == CK_SYM & this.scv == (i64)0)
                        {
                            direct = true;
                            sym = this.scs;
                        };
                    };
                };
                if (this.gwhy != 0) { ->; };
                if (direct)
                {
                    if (this.a_pre(sym, g"llvm.\0") | this.a_pre(sym, g"ideka.\0")) { this.s_intrin(x, sym); ->; };
                };
                i = 0;
                while (i < x.n)
                {
                    a = this.s_res(x.args[i]);
                    if (!this.s_isarg(a.ty) & !this.s_isag(a.ty)) { this.s_fail(g"call argument type\0"); ->; };
                    i++;
                };
                // operands first: they may need instructions of their own
                sv = (MO**)this.s_ar(8 * (x.n + 1));
                ploc = this.s_iz(x.n + 1);
                poff = this.s_iz(x.n + 1);
                st = this.s_iz(4);
                nf = 0;
                rfo = 0;
                if (this.s_isag(rt))
                {
                    // the hidden result pointer is the first integer argument: rdi on System V, rcx on Win64
                    if (this.a_win()) { wsh = 1; } else { st[0] = 1; };
                    rfo = this.s_newfo(this.a_size(rt), this.a_align(rt));
                };
                i = 0;
                while (i < x.n)
                {
                    a = this.s_res(x.args[i]);
                    if (this.s_isagg(a.ty) & !this.a_win())
                    {
                        sv[i] = (MO*)0;
                        ploc[i] = 0 - 1;
                        poff[i] = st[2];
                        st[2] = st[2] + (this.a_size(a.ty) + 7) / 8 * 8;
                    }
                    else
                    {
                        if (this.s_isagg(a.ty))
                        {
                            // Win64: the caller makes a copy and passes its address
                            afo = this.s_newfo(this.a_size(a.ty), 8);
                            this.s_agg_to(a, this.s_mo_mem(0 - 1, 0 - 1, 1, (i64)0, (byte*)0, afo - 1));
                            d = this.s_nv(0);
                            this.s_mi2(M_LEA, 8, this.s_mo_mem(0 - 1, 0 - 1, 1, (i64)0, (byte*)0, afo - 1), this.s_mo_r(d, 8));
                            sv[i] = this.s_mo_r(d, 8);
                            ploc[i] = this.s_place(i + wsh, false, st);
                            poff[i] = this.splo;
                            i++;
                            continue;
                        };
                        fp = this.s_isfp(a.ty);
                        s = this.s_src(a);
                        sz = this.s_vsz(a.ty);
                        if (s.k == MK_REG & sz < 4 & !fp) { s = this.s_mo_r(this.s_ext(s.r, sz, false, 4), 4); };
                        sv[i] = s;
                        ploc[i] = this.s_place(i + wsh, fp, st);
                        poff[i] = this.splo;
                        if (fp & ploc[i] >= 0) { nf++; };
                    };
                    i++;
                };
                tgt = (MO*)0;
                if (!direct) { tgt = this.s_mo_r(this.s_reg(callee), 8); };
                if (this.gwhy != 0) { this.s_ifree(ploc); this.s_ifree(poff); this.s_ifree(st); ->; };
                // stack arguments
                stk = st[2];
                if (this.a_win()) { stk = 32; };
                i = 0;
                while (i < x.n)
                {
                    if (ploc[i] < 0)
                    {
                        a = this.s_res(x.args[i]);
                        s = sv[i];
                        if (this.s_isagg(a.ty) & !this.a_win()) { this.s_agg_to(a, this.s_mo_mem(4, 0 - 1, 1, (i64)poff[i], (byte*)0, 0 - 1)); }
                        else
                        {
                            if (s.k == MK_REG) { s = this.s_mo_copy(s); s.sz = 8; };
                            if (this.s_isfp(a.ty)) { this.s_mi2(M_XMOV, this.s_vsz(a.ty), s, this.s_mo_mem(4, 0 - 1, 1, (i64)poff[i], (byte*)0, 0 - 1)); }
                            else { this.s_mi2(M_MOV, 8, s, this.s_mo_mem(4, 0 - 1, 1, (i64)poff[i], (byte*)0, 0 - 1)); };
                        };
                    };
                    i++;
                };
                if (this.a_win())
                {
                    if (x.n + wsh > 4) { stk = 8 * (x.n + wsh); };
                };
                if (stk > ((XGF*)this.sf.tg).outmax) { ((XGF*)this.sf.tg).outmax = stk; };
                // register arguments
                mask = 0;
                i = 0;
                while (i < x.n)
                {
                    p = ploc[i];
                    if (p >= 0)
                    {
                        a = this.s_res(x.args[i]);
                        s = sv[i];
                        if (s.k == MK_REG) { s = this.s_mo_copy(s); s.sz = 8; };
                        if (this.s_isfp(a.ty))
                        {
                            this.s_mi2(M_XMOV, this.s_vsz(a.ty), s, this.s_mo_r(p, 8));
                            // a variable argument list reads floats from the integer registers on Win64
                            if (this.a_win() & fty.vararg)
                            {
                                this.s_mi2(M_GX, 8, this.s_mo_r(p, 8), this.s_mo_r(this.s_argreg(i + wsh), 8));
                                mask = mask `| (1 << this.s_argreg(i + wsh));
                            };
                        }
                        else { this.s_mov(s, p, 8); };
                        mask = mask `| (1 << p);
                    };
                    i++;
                };
                if (rfo > 0)
                {
                    if (this.a_win())
                    {
                        this.s_mi2(M_LEA, 8, this.s_mo_mem(0 - 1, 0 - 1, 1, (i64)0, (byte*)0, rfo - 1), this.s_mo_r(1, 8));
                        mask = mask `| 2;
                    }
                    else
                    {
                        this.s_mi2(M_LEA, 8, this.s_mo_mem(0 - 1, 0 - 1, 1, (i64)0, (byte*)0, rfo - 1), this.s_mo_r(7, 8));
                        mask = mask `| 128;
                    };
                };
                if (fty.vararg)
                {
                    if (this.a_win()) { this.s_mov(this.s_mo_i((i64)0), 0, 4); }
                    else { this.s_mov(this.s_mo_i((i64)nf), 0, 4); };
                    mask = mask `| 1;
                };
                m = this.s_mi(M_CALL, 8);
                if (direct) { m.o0 = this.s_mo_sym(sym); } else { m.o0 = tgt; };
                m.iu = mask;
                m.clob = this.s_clob();
                if (this.s_ip_on() & direct)
                {
                    cf = (IRFunc*)nm_get(this.ipmap, callee.text);
                    if (cf != (IRFunc*)0)
                    {
                        if (cf.ipok) { m.clob = cf.ipm; };
                    };
                };
                this.ipc = this.ipc `| m.clob;
                tail = false;
                if (SSA_OPT_TAILCALL == 1 & direct & !this.a_win() & stk == 0 & rfo == 0 & !this.hasal & !this.hasra & !((XGF*)this.sf.tg).dyn & this.nxti != (SI*)0 & this.kpm == 0)
                {
                    if (((XGF*)this.sf.tg).vafo == 0 & ((XGF*)this.sf.tg).vagp == 0 & ((XGF*)this.sf.tg).vafp == 0 & ((XGF*)this.sf.tg).vastk == 0)
                    {
                        if (rt.kind == LK.VOID)
                        {
                            if (this.nxti.op == SO_RETV) { tail = true; };
                        }
                        else
                        {
                            if (this.nxti.op == SO_RET & x.res.nu == 1 & !this.s_isag(rt) & (rt.kind != LK.INT | rt.width >= 32))
                            {
                                if (this.s_res(this.nxti.a) == x.res) { tail = true; };
                            };
                        };
                    };
                };
                if (tail)
                {
                    // the call and the return that follows it become one jump
                    m.tgt = 77;
                    m = this.s_mi(M_RET, 0);
                    m.iu = 1;
                    if (rt.kind == LK.FLOAT | rt.kind == LK.DOUBLE) { m.iu = 1 << 16; };
                    this.skipn = true;
                    this.s_ifree(ploc);
                    this.s_ifree(poff);
                    this.s_ifree(st);
                    ->;
                };
                if (rfo > 0) { x.res.fo = rfo; };
                if (rt.kind != LK.VOID & rfo == 0)
                {
                    sz = this.s_vsz(rt);
                    if (this.s_isfp(rt))
                    {
                        d = this.s_def(x.res, 1);
                        this.s_mi2(M_XMOV, sz, this.s_mo_r(16, 8), this.s_mo_r(d, sz));
                    }
                    else
                    {
                        d = this.s_def(x.res, 0);
                        if (sz == 1 & SSA_OPT_CALLBOOL == 1 & x.res.nu == 1 & x.res.ui != (void*)0 & ((SI*)x.res.ui).op == SO_CBR) { this.s_mov(this.s_mo_r(0, sz), d, sz); }
                        else if (sz < 4) { this.s_mi2(M_MOVZX, sz, this.s_mo_r(0, sz), this.s_mo_r(d, 4)); }
                        else { this.s_mov(this.s_mo_r(0, sz), d, sz); };
                    };
                };
                this.s_ifree(ploc);
                this.s_ifree(poff);
                this.s_ifree(st);
                ->;
            };

            // @->: the return address sits right above the saved frame pointer, so the function keeps its frame pointer
            s_isel_retaddr(SI* x) -> void
            {
                int d = this.s_def(x.res, 0);
                this.s_mi1(M_RETADDR, 8, this.s_mo_r(d, 8));
                ->;
            };

            s_isel_vaarg(SI* x) -> void
            {
                IRType* t = x.ty;
                MI* m;
                int r, d, sz;
                if (this.s_isagg(t)) { this.s_fail(g"va_arg of an aggregate\0"); ->; };
                if (!this.s_isarg(t)) { this.s_fail(g"va_arg type\0"); ->; };
                r = this.s_reg(this.s_res(x.a));
                sz = this.s_vsz(t);
                if (this.s_isfp(t))
                {
                    d = this.s_def(x.res, 1);
                    m = this.s_mi2(M_VAARG, sz, this.s_mo_r(r, 8), this.s_mo_r(d, sz));
                    m.cc = 1;
                    ->;
                };
                d = this.s_def(x.res, 0);
                m = this.s_mi2(M_VAARG, sz, this.s_mo_r(r, 8), this.s_mo_r(d, sz));
                m.cc = 0;
                ->;
            };

            // Brings the kept arguments back into their registers
            s_kprestore() -> int
            {
                int i = 0;
                int mask = 0;
                while (i < this.kpn)
                {
                    this.s_mov(this.s_mo_r(this.kpv[i], 8), this.kpp[i], 8);
                    mask = mask `| (1 << this.kpp[i]);
                    i++;
                };
                -> mask;
            };

            s_isel_ret(SI* x) -> void
            {
                IRType* t = x.ty;
                MO* s;
                MI* m;
                int sz, k;
                if (!this.s_isarg(t) & !this.s_isag(t)) { this.s_fail(g"return type\0"); ->; };
                if (this.s_isagg(t))
                {
                    this.s_agg_to(this.s_res(x.a), this.s_mo_mem(((XGF*)this.sf.tg).sretv, 0 - 1, 1, (i64)0, (byte*)0, 0 - 1));
                    this.s_mov(this.s_mo_r(((XGF*)this.sf.tg).sretv, 8), 0, 8);
                    m = this.s_mi(M_RET, 0);
                    m.iu = 1;
                    ->;
                };
                sz = this.s_vsz(t);
                if (this.s_isfp(t))
                {
                    s = this.s_src(x.a);
                    s = this.s_mo_copy(s);
                    s.sz = 8;
                    this.s_mi2(M_XMOV, sz, s, this.s_mo_r(16, 8));
                    k = this.s_kprestore();
                    m = this.s_mi(M_RET, 0);
                    m.iu = (1 << 16) `| k;
                    ->;
                };
                s = this.s_src(x.a);
                if (s.k == MK_REG & sz < 4) { s = this.s_mo_r(this.s_ext(s.r, sz, false, 4), 4); sz = 4; };
                if (s.k == MK_REG) { s = this.s_mo_copy(s); s.sz = sz; };
                this.s_mov(s, 0, sz);
                k = this.s_kprestore();
                m = this.s_mi(M_RET, 0);
                m.iu = 1 `| k;
                ->;
            };

            // ----------------------------------------------------------
            // Branches
            // ----------------------------------------------------------

            s_isel_br(SI* x) -> void
            {
                this.s_mi1(M_JMP, 0, this.s_mo_blk(x.t.id));
                ->;
            };

            s_isel_cbr(SI* x) -> void
            {
                MI* m;
                int cc = this.s_cond(x.a);
                if (x.k == 1) { cc = this.s_invcc(cc); };
                m = this.s_mi1(M_JCC, 0, this.s_mo_blk(x.t.id));
                m.cc = cc;
                this.s_mi1(M_JMP, 0, this.s_mo_blk(x.f.id));
                ->;
            };

            // A switch of up to four cases compares in order, any other is a jump table over the range of its case values, the holes go to the default
            s_isel_switch(SI* x) -> void
            {
                IRType* t = x.a.ty;
                int sz, r, i, k, cnt;
                MI* m;
                IRValue* cv;
                u64 lo, hi, c;
                i64 sv;
                bool ok;
                int* tab;
                if (t.kind != LK.INT | t.width > 64) { this.s_fail(g"switch type\0"); ->; };
                if (x.n < 1) { this.s_mi1(M_JMP, 0, this.s_mo_blk(x.f.id)); ->; };
                sz = this.s_vsz(t);
                lo = (u64)0;
                hi = (u64)0;
                i = 0;
                while (i < x.n)
                {
                    cv = this.s_res(x.args[i]);
                    if (!this.s_isc(cv)) { this.s_fail(g"switch case\0"); ->; };
                    c = this.a_mask((u64)this.scv, t.width);
                    if (i == 0 | c < lo) { lo = c; };
                    if (i == 0 | c > hi) { hi = c; };
                    i++;
                };
                if (SSA_OPT_SWCHAIN == 1 & x.n <= 4 & (t.width == 8 | t.width == 16 | t.width == 32 | t.width == 64))
                {
                    // few cases: compare and branch in order, the first equal case wins
                    ok = true;
                    i = 0;
                    while (i < x.n)
                    {
                        cv = this.s_res(x.args[i]);
                        this.s_isc(cv);
                        sv = this.s_sx((u64)this.scv, t.width);
                        if (sv < (i64)0 - (i64)2147483648 | sv > (i64)2147483647) { ok = false; };
                        i++;
                    };
                    if (ok)
                    {
                        r = this.s_reg(x.a);
                        i = 0;
                        while (i < x.n)
                        {
                            cv = this.s_res(x.args[i]);
                            this.s_isc(cv);
                            sv = this.s_sx((u64)this.scv, t.width);
                            if (sv == (i64)0)
                            {
                                this.s_mi2(M_TEST, sz, this.s_mo_r(r, sz), this.s_mo_r(r, sz));
                            }
                            else
                            {
                                this.s_mi2(M_CMP, sz, this.s_mo_r(r, sz), this.s_mo_i(sv));
                            };
                            m = this.s_mi1(M_JCC, 0, this.s_mo_blk(x.blks[i].id));
                            m.cc = C_E;
                            i++;
                        };
                        this.s_mi1(M_JMP, 0, this.s_mo_blk(x.f.id));
                        ->;
                    };
                };
                if (t.width <= 8)
                {
                    // the table covers every value of the type, so no value can leave it
                    lo = (u64)0;
                    hi = ((u64)1 << (u64)t.width) - (u64)1;
                };
                if (hi - lo >= (u64)16777216)
                {
                    // sparse values: nested tables indexed by one byte of the value at a time
                    tab = (int*)this.s_ar(16 * x.n + 16);
                    i = 0;
                    while (i < x.n)
                    {
                        cv = this.s_res(x.args[i]);
                        this.s_isc(cv);
                        ((u64*)tab)[i] = this.a_mask((u64)this.scv, t.width);
                        tab[2 * x.n + i] = x.blks[i].id;
                        i++;
                    };
                    r = this.s_reg(x.a);
                    m = this.s_mi1(M_JTAB2, sz, this.s_mo_r(r, 8));
                    m.o2 = this.s_mo_blk(x.f.id);
                    m.cc = x.n;
                    m.text = (byte*)tab;
                    ->;
                };
                cnt = (int)(hi - lo) + 1;
                tab = (int*)this.s_ar(4 * (cnt + 1));
                k = 0;
                while (k < cnt) { tab[k] = x.f.id; k++; };
                i = x.n - 1;
                while (i >= 0)
                {
                    cv = this.s_res(x.args[i]);
                    this.s_isc(cv);
                    c = this.a_mask((u64)this.scv, t.width);
                    tab[(int)(c - lo)] = x.blks[i].id;
                    i--;
                };
                r = this.s_reg(x.a);
                if (sz < 4) { r = this.s_ext(r, sz, false, 4); };
                m = this.s_mi1(M_JTAB, sz, this.s_mo_r(r, 8));
                m.o1 = this.s_mo_i((i64)lo);
                m.o2 = this.s_mo_blk(x.f.id);
                m.cc = cnt;
                m.text = (byte*)tab;
                ->;
            };

            // ----------------------------------------------------------
            // Parameters
            // ----------------------------------------------------------

            s_isel_entry() -> void
            {
                GF* g = this.sf;
                IRFunc* f = g.f;
                IRType* t;
                int i, p, d, sz, wsh, ac, afo;
                int* st = this.s_iz(4);
                int* apv = this.s_iz(f.nargs + 1);
                int* afs = this.s_iz(f.nargs + 1);
                MO* src;
                XFO* xo;
                bool fp;
                wsh = 0;
                this.kpok = !f.ftype.vararg & !this.a_win() & !this.s_isag(f.ftype.elem) & !this.a_naked(f);
                if (this.kpok) { this.s_kpscan(); };
                if (this.kpok) { this.kpok = this.s_kpall(); };
                if (f.ftype.vararg) { this.s_vasave(); };
                if (this.s_isag(f.ftype.elem))
                {
                    ((XGF*)g.tg).sretv = this.s_nv(0);
                    if (this.a_win())
                    {
                        // the hidden result pointer arrives in rcx
                        this.s_mov(this.s_mo_r(1, 8), ((XGF*)g.tg).sretv, 8);
                        g.vhint[((XGF*)g.tg).sretv] = 1;
                        wsh = 1;
                    }
                    else
                    {
                        this.s_mov(this.s_mo_r(7, 8), ((XGF*)g.tg).sretv, 8);
                        g.vhint[((XGF*)g.tg).sretv] = 7;
                        st[0] = 1;
                    };
                };
                i = 0;
                while (i < f.nargs)
                {
                    t = f.ftype.items[i];
                    if (this.s_isagg(t) & this.a_win() & this.gwhy == 0)
                    {
                        // Win64: a pointer to the caller's copy arrives; the value is copied into a frame object once
                        // every argument register has been read
                        p = this.s_place(i + wsh, false, st);
                        d = this.s_nv(0);
                        if (p >= 0)
                        {
                            this.s_mov(this.s_mo_r(p, 8), d, 8);
                            g.vhint[d] = p;
                        }
                        else
                        {
                            src = this.s_mo_mem(5, 0 - 1, 1, (i64)(16 + this.splo), (byte*)0, 0 - 1);
                            this.s_mi2(M_MOV, 8, src, this.s_mo_r(d, 8));
                        };
                        apv[i] = d;
                        afo = this.s_newfo(this.a_size(t), 8);
                        afs[i] = afo;
                        f.args[i].fo = afo;
                        i++;
                        continue;
                    };
                    if (this.s_isagg(t) & this.gwhy == 0)
                    {
                        // the argument stays where the caller put it
                        sz = this.a_size(t);
                        xo = (XFO*)this.s_ar((int)(((sizeof(XFO) + 7) / 8) * 2));
                        xo.size = sz;
                        xo.al = 8;
                        xo.fix = 1;
                        xo.off = 16 + st[2];
                        st[2] = st[2] + (sz + 7) / 8 * 8;
                        pv_push(((XGF*)g.tg).fobj, (void*)xo);
                        f.args[i].fo = ((XGF*)g.tg).fobj.len;
                        i++;
                        continue;
                    };
                    if (!this.s_isarg(t) & !this.s_isag(t)) { this.s_fail(g"parameter type\0"); this.s_ifree(st); ->; };
                    fp = this.s_isfp(t);
                    sz = this.s_vsz(t);
                    if (sz < 8 & !fp) { sz = 4; };
                    p = this.s_place(i + wsh, fp, st);
                    if (fp)
                    {
                        d = this.s_def(f.args[i], 1);
                        if (p >= 0)
                        {
                            this.s_mi2(M_XMOV, sz, this.s_mo_r(p, 8), this.s_mo_r(d, sz));
                            g.vhint[d] = p;
                        }
                        else
                        {
                            src = this.s_mo_mem(5, 0 - 1, 1, (i64)(16 + this.splo), (byte*)0, 0 - 1);
                            this.s_mi2(M_XMOV, sz, src, this.s_mo_r(d, sz));
                        };
                    }
                    else
                    {
                        d = this.s_def(f.args[i], 0);
                        if (p >= 0)
                        {
                            this.s_mov(this.s_mo_r(p, sz), d, sz);
                            g.vhint[d] = p;
                            if (SSA_OPT_KEEPARG == 1 & i < 6 & this.kpok & this.kpc >= 0)
                            {
                                if (this.kpu[i] > this.kpc & sz == 8)
                                {
                                    this.kpv[this.kpn] = d;
                                    this.kpp[this.kpn] = p;
                                    this.kpn++;
                                    this.kpm = this.kpm `| (1 << p);
                                };
                            };
                        }
                        else
                        {
                            src = this.s_mo_mem(5, 0 - 1, 1, (i64)(16 + this.splo), (byte*)0, 0 - 1);
                            this.s_mi2(M_MOV, sz, src, this.s_mo_r(d, sz));
                        };
                    };
                    i++;
                };
                i = 0;
                while (i < f.nargs)
                {
                    if (afs[i] > 0)
                    {
                        this.s_copy(this.s_mo_mem(0 - 1, 0 - 1, 1, (i64)0, (byte*)0, afs[i] - 1), this.s_mo_mem(apv[i], 0 - 1, 1, (i64)0, (byte*)0, 0 - 1), this.a_size(f.ftype.items[i]));
                    };
                    i++;
                };
                if (f.ftype.vararg)
                {
                    if (this.a_win()) { ((XGF*)g.tg).vagp = i + wsh; }
                    else { ((XGF*)g.tg).vagp = st[0]; };
                    ((XGF*)g.tg).vafp = st[1];
                    ((XGF*)g.tg).vastk = 16 + st[2];
                };
                this.s_ifree(st);
                this.s_ifree(apv);
                this.s_ifree(afs);
                ->;
            };

            // Register save area of a vararg function, written before the argument registers are touched
            s_vasave() -> void
            {
                GF* g = this.sf;
                MI* m;
                if (this.a_win())
                {
                    m = this.s_mi(M_SAVEVA, 8);
                    m.iu = 2 `| 4 `| 256 `| 512;
                    m.tgt = 0 - 1;
                    ->;
                };
                ((XGF*)g.tg).vafo = this.s_newfo(176, 16);
                m = this.s_mi(M_SAVEVA, 8);
                m.iu = 2 `| 4 `| 64 `| 128 `| 256 `| 512 `| (255 << 16);
                m.tgt = ((XGF*)g.tg).vafo - 1;
                ->;
            };

            // ----------------------------------------------------------
            // Driver
            // ----------------------------------------------------------

            s_isel_inst(SI* x) -> void
            {
                int o = x.op;
                int k;
                MI* m;
                if (o == SO_PHI) { ->; };
                if (o == SO_BIN) { this.s_isel_bin(x); ->; };
                if (o == SO_CMP) { this.s_isel_cmp(x); ->; };
                if (o == SO_CAST) { this.s_isel_cast(x); ->; };
                if (o == SO_ALLOCAN) { this.s_isel_allocan(x); ->; };
                if (o == SO_ALLOCA) { this.s_isel_alloca(x); ->; };
                if (o == SO_LOAD) { this.s_isel_load(x); ->; };
                if (o == SO_STORE) { this.s_isel_store(x); ->; };
                if (o == SO_FILL) { this.s_isel_fill(x); ->; };
                if (o == SO_COPY) { this.s_isel_fill(x); ->; };
                if (o == SO_GEP) { this.s_isel_gep(x); ->; };
                if (o == SO_CALL) { this.s_isel_call(x); ->; };
                if (o == SO_SELECT) { this.s_isel_select(x); ->; };
                if (o == SO_BR) { this.s_isel_br(x); ->; };
                if (o == SO_CBR) { this.s_isel_cbr(x); ->; };
                if (o == SO_SWITCH) { this.s_isel_switch(x); ->; };
                if (o == SO_VAARG) { this.s_isel_vaarg(x); ->; };
                if (o == SO_RETADDR) { this.s_isel_retaddr(x); ->; };
                if (o == SO_EXTRACT) { this.s_isel_extract(x); ->; };
                if (o == SO_INSERT) { this.s_isel_insert(x); ->; };
                if (o == SO_RET) { this.s_isel_ret(x); ->; };
                if (o == SO_RETV)
                {
                    k = this.s_kprestore();
                    m = this.s_mi(M_RET, 0);
                    m.iu = k;
                    ->;
                };
                if (o == SO_UNREACH)
                {
                    this.s_mi(M_UD2, 0);
                    ->;
                };
                this.s_fail(g"instruction\0");
                ->;
            };

            s_isel() -> bool
            {
                GF* g = this.sf;
                IRFunc* f = g.f;
                int i, j, k;
                GB* gb;
                SI* x;
                IRType* rt = f.ftype.elem;
                if (rt.kind != LK.VOID & !this.s_isarg(rt) & !this.s_isag(rt)) { this.s_fail(g"function return type\0"); -> false; };
                
                // the per register arrays exist even when the function needs no virtual register
                k = this.s_nv(0);
                g.nvr = k;
                this.s_users();
                this.s_lazy();
                if (SSA_OPT_LAZYMULTI == 1) { this.s_lazymulti(); };
                this.hasal = false;
                this.hasra = false;
                i = 0;
                while (i < g.nb)
                {
                    gb = g.rpo[i];
                    if (gb.ib.insts != (PtrVec*)0)
                    {
                        j = 0;
                        while (j < gb.ib.insts.len)
                        {
                            x = (SI*)gb.ib.insts.items[j];
                            if (x.op == SO_ALLOCA | x.op == SO_ALLOCAN | x.op == SO_VAARG) { this.hasal = true; };
                            if (x.op == SO_RETADDR) { this.hasra = true; };
                            j++;
                        };
                    };
                    i++;
                };
                i = 0;
                while (i < g.nb)
                {
                    gb = g.rpo[i];
                    this.scb = gb;
                    this.s_isel_phis(gb);
                    i++;
                };
                i = 0;
                while (i < g.nb)
                {
                    gb = g.rpo[i];
                    this.scb = gb;
                    // the extended index of the block that is the only way in is still in its register
                    if (i == 0) { this.ec_v = (IRValue*)0; }
                    elif (gb.preds.len != 1) { this.ec_v = (IRValue*)0; }
                    elif (gb.preds.items[0] != (void*)g.rpo[i - 1]) { this.ec_v = (IRValue*)0; };
                    if (i == 0) { this.s_isel_entry(); };
                    if (gb.ib.insts != (PtrVec*)0)
                    {
                        j = 0;
                        while (j < gb.ib.insts.len)
                        {
                            x = (SI*)gb.ib.insts.items[j];
                            if (this.skipn) { this.skipn = false; j++; continue; };
                            this.nxti = (SI*)0;
                            if (j + 1 < gb.ib.insts.len) { this.nxti = (SI*)gb.ib.insts.items[j + 1]; };
                            this.s_isel_inst(x);
                            if (this.gwhy != 0) { -> false; };
                            j++;
                        };
                    };
                    i++;
                };
                -> this.gwhy == 0;
            };

            // The operand o with the registers in from replaced by the ones in to
            s_td_mo(MO* o, int* fr_, int* tr_, int n) -> MO*
            {
                MO* c;
                int k;
                if (o == (MO*)0 | n == 0) { -> o; };
                if (o.k != MK_REG & o.k != MK_MEM) { -> o; };
                c = this.s_mo_copy(o);
                k = 0;
                while (k < n)
                {
                    if (c.r == fr_[k]) { c.r = tr_[k]; };
                    k++;
                };
                if (c.k == MK_MEM)
                {
                    k = 0;
                    while (k < n)
                    {
                        if (c.r2 == fr_[k]) { c.r2 = tr_[k]; };
                        k++;
                    };
                };
                -> c;
            };

            // A block that ends in a jump to a short block that only returns takes a copy of that block instead
            s_taildup() -> void
            {
                GF* g = this.sf;
                int i, j, k, q, n, cnt, nmap, nc;
                GB** cand;
                int* mf;
                int* mt;
                bool ok;
                GB* b;
                GB* l;
                MI* t;
                MI* m;
                MI* c;
                nc = 0;
                cand = (GB**)this.s_arr(8 * (g.nb + 1));
                i = 0;
                while (i < g.nb)
                {
                    b = g.rpo[i];
                    i++;
                    if (b.mi.len >= 1 & b.mi.len <= 4)
                    {
                        t = (MI*)b.mi.items[b.mi.len - 1];
                        if (t.op == M_RET) { cand[nc] = b; nc++; };
                    };
                };
                if (nc == 0) { ->; };
                i = 0;
                while (i < g.nb)
                {
                    b = g.rpo[i];
                    i++;
                    if (b.mi.len < 1) { continue; };
                    t = (MI*)b.mi.items[b.mi.len - 1];
                    if (t.op != M_JMP) { continue; };
                    l = (GB*)0;
                    j = 0;
                    while (j < nc)
                    {
                        if (cand[j].id == (int)t.o0.imm) { l = cand[j]; };
                        j++;
                    };
                    if (l == (GB*)0 | l == b) { continue; };
                    if (l.mi.len < 1 | l.mi.len > 4) { continue; };
                    m = (MI*)l.mi.items[l.mi.len - 1];
                    if (m.op != M_RET) { continue; };
                    ok = true;
                    j = 0;
                    while (j < l.mi.len - 1)
                    {
                        m = (MI*)l.mi.items[j];
                        if (m.op != M_MOV & m.op != M_MOVZX & m.op != M_MOVSX & m.op != M_XMOV) { ok = false; };
                        j++;
                    };
                    if (!ok) { continue; };
                    // the successors: b no longer reaches l
                    if (b.succs.len != 1) { continue; };
                    if ((GB*)b.succs.items[0] != l) { continue; };
                    b.mi.len = b.mi.len - 1;
                    this.scb = b;
                    // the registers l defines itself get fresh ones in the copy
                    mf = this.s_iz(8);
                    mt = this.s_iz(8);
                    nmap = 0;
                    j = 0;
                    while (j < l.mi.len)
                    {
                        this.s_scan((MI*)l.mi.items[j]);
                        k = 0;
                        while (k < this.ndb)
                        {
                            if (this.dbuf[k] >= R_VBASE & nmap < 8)
                            {
                                mf[nmap] = this.dbuf[k];
                                mt[nmap] = this.s_nv(g.vcls[this.dbuf[k]]);
                                nmap++;
                            };
                            k++;
                        };
                        j++;
                    };
                    this.scb = b;
                    j = 0;
                    while (j < l.mi.len)
                    {
                        m = (MI*)l.mi.items[j];
                        c = this.s_mi(m.op, m.sz);
                        c.cc = m.cc; c.iu = m.iu; c.id = m.id; c.clob = m.clob; c.tgt = m.tgt;
                        c.o0 = this.s_td_mo(m.o0, mf, mt, nmap); c.o1 = this.s_td_mo(m.o1, mf, mt, nmap); c.o2 = this.s_td_mo(m.o2, mf, mt, nmap); c.text = m.text;
                        j++;
                    };
                    this.s_ifree(mf);
                    this.s_ifree(mt);
                    b.succs.len = 0;
                    q = 0;
                    n = 0;
                    while (q < l.preds.len)
                    {
                        if ((GB*)l.preds.items[q] != b) { l.preds.items[n] = l.preds.items[q]; n++; };
                        q++;
                    };
                    l.preds.len = n;
                };
                // the copied blocks that nothing reaches any more leave the layout
                n = 0;
                i = 0;
                while (i < g.nb)
                {
                    b = g.rpo[i];
                    if (i == 0 | b.preds.len > 0)
                    {
                        g.rpo[n] = b;
                        b.rpo = n;
                        n++;
                    };
                    i++;
                };
                g.nb = n;
                ->;
            };

            // Edge blocks for the phis: copies go at the end of a block with one successor, otherwise the
            // edge gets a block of its own. The blocks end up in the layout after their predecessor.
            s_edges() -> bool
            {
                GF* g = this.sf;
                int i, j, k, n, pidx, nrpo;
                GB* p;
                GB* s;
                GB* e;
                MI* m;
                MI* t;
                MO* o;
                PtrVec* lay = pv_new();
                bool seen;
                n = g.nb;
                i = 0;
                while (i < n)
                {
                    p = g.rpo[i];
                    pv_push(lay, (void*)p);
                    j = 0;
                    while (j < p.succs.len)
                    {
                        s = (GB*)p.succs.items[j];
                        seen = false;
                        k = 0;
                        while (k < j)
                        {
                            if ((GB*)p.succs.items[k] == s) { seen = true; };
                            k++;
                        };
                        if (!seen & s.phis.len > 0)
                        {
                            this.scb = p;
                            pidx = 0;
                            while (pidx < s.preds.len)
                            {
                                if ((GB*)s.preds.items[pidx] == p) { break; };
                                pidx++;
                            };
                            if (p.succs.len == 1)
                            {
                                // before the final jump
                                t = (MI*)p.mi.items[p.mi.len - 1];
                                if (t.op != M_JMP) { this.s_fail(g"block end\0"); pv_free(lay); -> false; };
                                m = this.s_mi(M_PCOPY, 8);
                                p.mi.len = p.mi.len - 1;
                                p.mi.len = p.mi.len - 1;
                                pv_push(p.mi, (void*)m);
                                pv_push(p.mi, (void*)t);
                                m.tgt = s.ib.gi;
                                m.cc = pidx;
                            }
                            else
                            {
                                e = (GB*)fmalloc((u64)(((sizeof(GB) + 7) / 8) * 2));
                                e.ib = (IRBlock*)0;
                                this.lab++;
                                e.id = this.lab;
                                e.rpo = 0;
                                e.idom = 0 - 1;
                                e.lbl = e.id;
                                e.depth = p.depth + 1;
                                e.nexti = 0;
                                e.lw = p.lw;
                                e.preds = pv_new();
                                e.succs = pv_new();
                                e.kids = pv_new();
                                e.df = pv_new();
                                e.phis = pv_new();
                                e.mi = pv_new();
                                e.livein = (int*)0;
                                e.liveout = (int*)0;
                                e.guse = (int*)0;
                                e.gdef = (int*)0;
                                pv_push(e.preds, (void*)p);
                                pv_push(e.succs, (void*)s);
                                this.scb = e;
                                m = this.s_mi(M_PCOPY, 8);
                                m.tgt = s.ib.gi;
                                m.cc = pidx;
                                this.s_mi1(M_JMP, 0, this.s_mo_blk(s.id));
                                // the jumps of p that reach s now reach the edge block
                                k = p.mi.len - 1;
                                while (k >= 0)
                                {
                                    t = (MI*)p.mi.items[k];
                                    if (t.op == M_JCC | t.op == M_JMP)
                                    {
                                        if (t.o0.imm == (i64)s.id) { t.o0 = this.s_mo_blk(e.id); };
                                    };
                                    if (t.op == M_JTAB2)
                                    {
                                        if (t.o2.imm == (i64)s.id) { t.o2 = this.s_mo_blk(e.id); };
                                        n = 0;
                                        while (n < t.cc)
                                        {
                                            if (((int*)t.text)[2 * t.cc + n] == s.id) { ((int*)t.text)[2 * t.cc + n] = e.id; };
                                            n++;
                                        };
                                    };
                                    if (t.op == M_JTAB)
                                    {
                                        if (t.o2.imm == (i64)s.id) { t.o2 = this.s_mo_blk(e.id); };
                                        n = 0;
                                        while (n < t.cc)
                                        {
                                            if (((int*)t.text)[n] == s.id) { ((int*)t.text)[n] = e.id; };
                                            n++;
                                        };
                                    };
                                    k--;
                                };
                                k = 0;
                                while (k < p.succs.len)
                                {
                                    if ((GB*)p.succs.items[k] == s) { p.succs.items[k] = (void*)e; };
                                    k++;
                                };
                                k = 0;
                                while (k < s.preds.len)
                                {
                                    if ((GB*)s.preds.items[k] == p) { s.preds.items[k] = (void*)e; };
                                    k++;
                                };
                                e.rpo = g.bl.len;
                                pv_push(g.bl, (void*)e);
                                pv_push(lay, (void*)e);
                            };
                        };
                        j++;
                    };
                    i++;
                };
                // the layout becomes the new block order
                ffree((byte*)g.rpo);
                g.nb = lay.len;
                g.rpo = (GB**)fmalloc((u64)(8 * (lay.len + 1)));
                i = 0;
                while (i < lay.len)
                {
                    g.rpo[i] = (GB*)lay.items[i];
                    ((GB*)lay.items[i]).rpo = i;
                    i++;
                };
                pv_free(lay);
                -> true;
            };

            s_addu(int r) -> void
            {
                if (this.s_hidden(r)) { ->; };
                if (r >= R_VBASE)
                {
                    if (this.sf.vcol[r] == 0 - 1) { ->; };
                };
                if (this.nub >= this.bcap) { this.s_bgrow(); };
                this.ubuf[this.nub] = r;
                this.nub++;
                ->;
            };

            s_addd(int r) -> void
            {
                if (this.s_hidden(r)) { ->; };
                if (r >= R_VBASE)
                {
                    if (this.sf.vcol[r] == 0 - 1) { ->; };
                };
                if (this.ndb >= this.bcap) { this.s_bgrow(); };
                this.dbuf[this.ndb] = r;
                this.ndb++;
                ->;
            };

            // Role of operand k of an instruction: 1 its register is read, 2 written, 0 none. Registers inside a
            // memory operand are always read.
            s_role(int op, int k, MO* o) -> int
            {
                if (op == M_MOV | op == M_BREV | op == M_STRLEN | op == M_DALLOC | op == M_VAARG | op == M_MOVZX | op == M_MOVSX | op == M_LEA | op == M_MOVABS | op == M_GX | op == M_XMOV | op == M_CVT | op == M_FUN)
                {
                    if (k == 0) { -> 1; };
                    if (k == 1)
                    {
                        if (o.k == MK_REG) { -> 2; };
                        -> 1;
                    };
                    -> 0;
                };
                if (op == M_ALU | op == M_SHIFT | op == M_FALU | op == M_CMOV | op == M_FSEL | op == M_FREM)
                {
                    if (k < 2) { -> 1; };
                    -> 2;
                };
                if (op == M_FMA)
                {
                    if (k == 2) { -> 2; };
                    -> 1;
                };
                if (op == M_UN)
                {
                    if (k == 0) { -> 1; };
                    if (o != (MO*)0)
                    {
                        if (o.k != MK_REG) { -> 1; };
                    };
                    -> 2;
                };
                if (op == M_RMW) { -> 1; };
                if (op == M_CMP | op == M_TEST | op == M_BT | op == M_FCMP)
                {
                    if (k < 2) { -> 1; };
                    -> 0;
                };
                if (op == M_SETCC)
                {
                    if (k == 0) { -> 2; };
                    // the register already holds zero before the compare: the byte store keeps the rest
                    if (k == 1 & o != (MO*)0) { if (o.k == MK_REG) { -> 1; }; };
                    -> 0;
                };
                if (op == M_CALL | op == M_DIV | op == M_JTAB | op == M_JTAB2 | op == M_VASTART)
                {
                    if (k == 0) { -> 1; };
                    -> 0;
                };
                if (op == M_RETADDR)
                {
                    if (k == 0) { -> 2; };
                    -> 0;
                };
                -> 0;
            };

            s_scano(MO* o, int role) -> void
            {
                if (o == (MO*)0) { ->; };
                if (o.k == MK_REG)
                {
                    if (role == 2) { this.s_addd(o.r); };
                    if (role == 1) { this.s_addu(o.r); };
                    ->;
                };
                if (o.k == MK_MEM)
                {
                    this.s_addu(o.r);
                    this.s_addu(o.r2);
                };
                ->;
            };

            // Fills ubuf and dbuf with the registers m reads and writes
            s_scan(MI* m) -> void
            {
                int op = m.op;
                int b, i;
                this.nub = 0;
                this.ndb = 0;
                if (op == M_PCOPY)
                {
                    this.s_scan_pc(m);
                    ->;
                };
                this.s_scano(m.o0, this.s_role(op, 0, m.o0));
                this.s_scano(m.o1, this.s_role(op, 1, m.o1));
                this.s_scano(m.o2, this.s_role(op, 2, m.o2));
                this.s_scano(m.o3, this.s_role(op, 3, m.o3));
                // implicit registers: most instructions have none
                if ((m.iu `| m.id `| m.clob) == 0) { ->; };
                i = 0;
                while (i < 32)
                {
                    b = 1 << i;
                    if ((m.iu `& b) != 0) { this.s_addu(i); };
                    if (((m.id `| m.clob) `& b) != 0) { this.s_addd(i); };
                    i++;
                };
                ->;
            };

            // Source register of phi gp along edge idx, or -1 when the incoming value is not in a register
            s_pcsrc(GP* gp, int idx) -> int
            {
                IRValue* v = this.s_res((IRValue*)gp.vals.items[idx]);
                if (v.vr >= R_VBASE) { -> v.vr; };
                -> 0 - 1;
            };

            // A parallel copy reads the incoming values and writes the phi registers of its target block
            s_scan_pc(MI* m) -> void
            {
                GB* sg = (GB*)this.sf.bl.items[m.tgt];
                GP* gp;
                int k = 0;
                int v;
                while (k < sg.phis.len)
                {
                    gp = (GP*)sg.phis.items[k];
                    v = this.s_pcsrc(gp, m.cc);
                    if (v >= 0) { this.s_addu(v); };
                    this.s_addd(gp.dst);
                    k++;
                };
                ->;
            };

            // ==========================================================
            // liveness, interference graph, coloring in definition order and spilling.
            // ==========================================================

            // Numbers the registers that live across blocks and records, for every block, the globals it
            // reads before writing (guse) and the ones it writes (gdef). Each list starts with its length.
            s_globals() -> void
            {
                GF* g = this.sf;
                int n = g.nb;
                int nv = g.nvr;
                int i, j, k, v, ng, cu, cd;
                GB* gb;
                MI* mi;
                int* defs = this.s_iz(nv);
                int* usedm = this.s_iz(nv);
                int* defl = this.s_iz(nv);
                int* tu;
                int* td;
                i = 0;
                while (i < nv) { g.vglob[i] = 0 - 1; i++; };
                ng = 0;
                i = 0;
                while (i < n)
                {
                    gb = g.rpo[i];
                    j = 0;
                    while (j < gb.mi.len)
                    {
                        mi = (MI*)gb.mi.items[j];
                        this.s_scan(mi);
                        k = 0;
                        while (k < this.nub)
                        {
                            v = this.ubuf[k];
                            if (v >= R_VBASE)
                            {
                                if (defs[v] != i + 1 & g.vglob[v] < 0) { g.vglob[v] = ng; ng++; };
                            };
                            k++;
                        };
                        k = 0;
                        while (k < this.ndb)
                        {
                            v = this.dbuf[k];
                            if (v >= R_VBASE) { defs[v] = i + 1; };
                            k++;
                        };
                        j++;
                    };
                    i++;
                };
                g.nglob = ng;
                if (g.gv != (int*)0) { this.s_ifree(g.gv); };
                g.gv = this.s_iz(ng + 1);
                i = 0;
                while (i < nv)
                {
                    if (g.vglob[i] >= 0) { g.gv[g.vglob[i]] = i; };
                    defs[i] = 0;
                    i++;
                };
                tu = this.s_iz(ng + 2);
                td = this.s_iz(ng + 2);
                i = 0;
                while (i < n)
                {
                    gb = g.rpo[i];
                    cu = 0;
                    cd = 0;
                    j = 0;
                    while (j < gb.mi.len)
                    {
                        mi = (MI*)gb.mi.items[j];
                        this.s_scan(mi);
                        k = 0;
                        while (k < this.nub)
                        {
                            v = this.ubuf[k];
                            if (v >= R_VBASE)
                            {
                                if (g.vglob[v] >= 0 & defs[v] != i + 1 & usedm[v] != i + 1)
                                {
                                    usedm[v] = i + 1;
                                    tu[cu] = g.vglob[v];
                                    cu++;
                                };
                            };
                            k++;
                        };
                        k = 0;
                        while (k < this.ndb)
                        {
                            v = this.dbuf[k];
                            if (v >= R_VBASE)
                            {
                                defs[v] = i + 1;
                                if (g.vglob[v] >= 0 & defl[v] != i + 1)
                                {
                                    defl[v] = i + 1;
                                    td[cd] = g.vglob[v];
                                    cd++;
                                };
                            };
                            k++;
                        };
                        j++;
                    };
                    if (gb.guse != (int*)0) { this.s_ifree(gb.guse); this.s_ifree(gb.gdef); };
                    gb.guse = this.s_iz(cu + 1);
                    gb.gdef = this.s_iz(cd + 1);
                    gb.guse[0] = cu;
                    gb.gdef[0] = cd;
                    k = 0;
                    while (k < cu) { gb.guse[k + 1] = tu[k]; k++; };
                    k = 0;
                    while (k < cd) { gb.gdef[k + 1] = td[k]; k++; };
                    i++;
                };
                this.s_ifree(defs); this.s_ifree(usedm); this.s_ifree(defl); this.s_ifree(tu); this.s_ifree(td);
                ->;
            };

            // Interference between the registers, forbidden registers, hints, weights and the order of definition
            s_graph() -> void
            {
                GF* g = this.sf;
                int n = g.nb;
                int nv = g.nvr;
                int nw = (g.nglob + 31) / 32;
                int i, j, k, v, d, u, w, lp, op, bit, e, p, src;
                GB* gb;
                GB* sg;
                MI* mi;
                MO* o0;
                MO* o1;
                bool copy;
                int* deg;
                int* fill;
                int* seen;
                if (nw < 1) { nw = 1; };
                this.ne = 0;
                if (g.lpos != (int*)0) { this.s_ifree(g.lpos); };
                g.lpos = this.s_iz(nv);
                i = 0;
                while (i < nv)
                {
                    g.lpos[i] = 0 - 1;
                    g.vforb[i] = (i64)0;
                    g.vhint[i] = 0 - 1;
                    if (g.vwgt[i] < 1500000000) { g.vwgt[i] = 0; };
                    i++;
                };
                g.nl = 0;
                i = 0;
                while (i < n)
                {
                    gb = g.rpo[i];
                    // live out registers
                    g.nl = 0;
                    j = 0;
                    while (j < g.nglob)
                    {
                        if (this.s_bit(gb.liveout, j))
                        {
                            v = g.gv[j];
                            if (g.vcol[v] != 0 - 1) { this.s_lpush(v); };
                        };
                        j++;
                    };
                    lp = 0;
                    j = gb.mi.len - 1;
                    while (j >= 0)
                    {
                        mi = (MI*)gb.mi.items[j];
                        op = mi.op;
                        this.s_scan(mi);
                        copy = false;
                        src = 0 - 1;
                        if (op == M_MOV)
                        {
                            if (mi.o0.k == MK_REG & mi.o1.k == MK_REG)
                            {
                                copy = true;
                                src = mi.o0.r;
                            };
                        };
                        // definitions
                        k = 0;
                        while (k < this.ndb)
                        {
                            d = this.dbuf[k];
                            if (d >= R_VBASE)
                            {
                                u = 0;
                                while (u < g.nl)
                                {
                                    v = g.llist[u];
                                    if (v != d & g.vcls[v] == g.vcls[d])
                                    {
                                        if (!(copy & v == src)) { this.s_epush(d, v); };
                                    };
                                    u++;
                                };
                                g.vforb[d] = g.vforb[d] `| (i64)lp;
                                if (op == M_SHIFT)
                                {
                                    u = 0;
                                    while (u < this.nub)
                                    {
                                        if (this.ubuf[u] < R_VBASE) { g.vforb[d] = g.vforb[d] `| ((i64)1 << (i64)this.ubuf[u]); };
                                        u++;
                                    };
                                };
                                this.s_wadd(d, gb.lw);
                            }
                            else
                            {
                                bit = 1 << d;
                                u = 0;
                                while (u < g.nl)
                                {
                                    v = g.llist[u];
                                    g.vforb[v] = g.vforb[v] `| (i64)bit;
                                    u++;
                                };
                            };
                            k++;
                        };
                        k = 0;
                        while (k < this.ndb)
                        {
                            d = this.dbuf[k];
                            if (d >= R_VBASE) { this.s_lpop(d); } else { lp = lp `& (`!(1 << d)); };
                            k++;
                        };
                        // uses
                        k = 0;
                        while (k < this.nub)
                        {
                            u = this.ubuf[k];
                            if (u >= R_VBASE)
                            {
                                this.s_lpush(u);
                                this.s_wadd(u, gb.lw);
                            }
                            else { lp = lp `| (1 << u); };
                            k++;
                        };
                        // hints
                        if (copy)
                        {
                            d = mi.o1.r;
                            if (d >= R_VBASE & src >= R_VBASE)
                            {
                                if (g.vhint[d] == 0 - 1) { g.vhint[d] = 0 - (src + 1); };
                                if (g.vhint[src] == 0 - 1) { g.vhint[src] = 0 - (d + 1); };
                            };
                            if (d >= R_VBASE & src < R_VBASE)
                            {
                                if (g.vhint[d] == 0 - 1) { g.vhint[d] = src; };
                            };
                            if (d < R_VBASE & src >= R_VBASE)
                            {
                                if (g.vhint[src] == 0 - 1) { g.vhint[src] = d; };
                            };
                        };
                        if (op == M_ALU | op == M_SHIFT)
                        {
                            if (mi.o0.k == MK_REG & mi.o2.k == MK_REG)
                            {
                                if (mi.o0.r >= R_VBASE & mi.o2.r >= R_VBASE)
                                {
                                    if (g.vhint[mi.o2.r] == 0 - 1) { g.vhint[mi.o2.r] = 0 - (mi.o0.r + 1); };
                                };
                            };
                        };
                        if (op == M_CMOV)
                        {
                            if (mi.o1.k == MK_REG & mi.o2.k == MK_REG)
                            {
                                if (mi.o1.r >= R_VBASE & mi.o2.r >= R_VBASE)
                                {
                                    if (g.vhint[mi.o2.r] == 0 - 1) { g.vhint[mi.o2.r] = 0 - (mi.o1.r + 1); };
                                };
                            };
                        };
                        if (op == M_PCOPY)
                        {
                            sg = (GB*)g.bl.items[mi.tgt];
                            k = 0;
                            while (k < sg.phis.len)
                            {
                                d = ((GP*)sg.phis.items[k]).dst;
                                src = this.s_pcsrc((GP*)sg.phis.items[k], mi.cc);
                                if (src >= R_VBASE & d >= R_VBASE & g.vcol[d] != 0 - 1 & g.vcol[src] != 0 - 1)
                                {
                                    if (g.vhint[d] == 0 - 1) { g.vhint[d] = 0 - (src + 1); };
                                    if (g.vhint[src] == 0 - 1) { g.vhint[src] = 0 - (d + 1); };
                                };
                                k++;
                            };
                        };
                        j--;
                    };
                    // drop the live set
                    u = 0;
                    while (u < g.nl) { g.lpos[g.llist[u]] = 0 - 1; u++; };
                    g.nl = 0;
                    i++;
                };
                // order of definition: the phi registers of a block first, then its instructions
                if (this.ord != (int*)0) { this.s_ifree(this.ord); };
                this.ord = this.s_iz(nv + 1);
                this.nord = 0;
                seen = this.s_iz(nv);
                i = 0;
                while (i < n)
                {
                    gb = g.rpo[i];
                    k = 0;
                    while (k < gb.phis.len)
                    {
                        d = ((GP*)gb.phis.items[k]).dst;
                        if (g.vcol[d] != 0 - 1 & seen[d] == 0) { seen[d] = 1; this.ord[this.nord] = d; this.nord++; };
                        k++;
                    };
                    j = 0;
                    while (j < gb.mi.len)
                    {
                        mi = (MI*)gb.mi.items[j];
                        this.s_scan(mi);
                        k = 0;
                        while (k < this.ndb)
                        {
                            d = this.dbuf[k];
                            if (d >= R_VBASE)
                            {
                                if (seen[d] == 0) { seen[d] = 1; this.ord[this.nord] = d; this.nord++; };
                            };
                            k++;
                        };
                        j++;
                    };
                    i++;
                };
                this.s_ifree(seen);
                // adjacency lists
                deg = this.s_iz(nv + 1);
                if (this.adjo != (int*)0) { this.s_ifree(this.adjo); this.s_ifree(this.adj); };
                this.adjo = this.s_iz(nv + 2);
                e = 0;
                while (e < this.ne)
                {
                    deg[this.ea[e]] = deg[this.ea[e]] + 1;
                    deg[this.eb[e]] = deg[this.eb[e]] + 1;
                    e++;
                };
                this.adjo[0] = 0;
                i = 0;
                while (i < nv)
                {
                    this.adjo[i + 1] = this.adjo[i] + deg[i];
                    i++;
                };
                this.adj = this.s_iz(this.adjo[nv] + 1);
                fill = this.s_iz(nv + 1);
                e = 0;
                while (e < this.ne)
                {
                    u = this.ea[e];
                    v = this.eb[e];
                    this.adj[this.adjo[u] + fill[u]] = v;
                    fill[u] = fill[u] + 1;
                    this.adj[this.adjo[v] + fill[v]] = u;
                    fill[v] = fill[v] + 1;
                    e++;
                };
                this.s_ifree(deg);
                this.s_ifree(fill);
                ->;
            };

            // Reload of virtual register t from the spill slot of v, or the store when store is set
            s_spillmi(bool store, int t, int v) -> void
            {
                GF* g = this.sf;
                MO* mem = this.s_mo_mem(0 - 1, 0 - 1, 1, (i64)0, (byte*)0, g.vslot[v] - 1);
                int op = M_MOV;
                if (g.vcls[v] == 1) { op = M_XMOV; };
                if (store) { this.s_mi2(op, 8, this.s_mo_r(t, 8), mem); }
                else { this.s_mi2(op, 8, mem, this.s_mo_r(t, 8)); };
                ->;
            };

            // Rewrites the code so that the registers in spl live in memory: every use reloads into a short
            // register and every definition stores from one
            s_spill() -> void
            {
                GF* g = this.sf;
                int nv = g.nvr;
                int i, j, k, v, t, role, op;
                GB* gb;
                MI* m;
                MO* o;
                XFO* fo;
                PtrVec* old;
                bool any;
                int* sp = this.s_iz(nv + 1);
                int* held = this.s_iz(nv + 1);
                int* hpos = this.s_iz(nv + 1);
                int hv;
                MO* mem;
                i = 0;
                while (i < this.nspl)
                {
                    v = this.spl[i];
                    sp[v] = 1;
                    fo = (XFO*)this.s_ar((int)(((sizeof(XFO) + 7) / 8) * 2));
                    fo.size = 8;
                    fo.al = 8;
                    fo.off = 0;
                    fo.fix = 0;
                    pv_push(((XGF*)g.tg).fobj, (void*)fo);
                    g.vslot[v] = ((XGF*)g.tg).fobj.len;
                    i++;
                };
                i = 0;
                while (i < g.nb)
                {
                    gb = g.rpo[i];
                    old = gb.mi;
                    gb.mi = pv_new();
                    this.scb = gb;
                    k = 0;
                    while (k < this.nspl) { held[this.spl[k]] = 0; k++; };
                    j = 0;
                    while (j < old.len)
                    {
                        m = (MI*)old.items[j];
                        j++;
                        if (m.op == M_CALL | m.op == M_ASM | m.op == M_PCOPY | m.op == M_DALLOC | m.op == M_TEXT)
                        {
                            k = 0;
                            while (k < this.nspl) { held[this.spl[k]] = 0; k++; };
                        };
                        if (m.op == M_PCOPY) { pv_push(gb.mi, (void*)m); continue; };
                        any = false;
                        k = 0;
                        while (k < 4)
                        {
                            o = this.s_opnd(m, k);
                            if (o != (MO*)0)
                            {
                                if (o.k == MK_REG) { if (o.r >= R_VBASE) { if (sp[o.r] == 1) { any = true; }; }; };
                                if (o.k == MK_MEM)
                                {
                                    if (o.r >= R_VBASE) { if (sp[o.r] == 1) { any = true; }; };
                                    if (o.r2 >= R_VBASE) { if (sp[o.r2] == 1) { any = true; }; };
                                };
                            };
                            k++;
                        };
                        if (!any) { pv_push(gb.mi, (void*)m); continue; };
                        // plain moves go straight to and from the slot
                        if (m.op == M_MOV & m.o0.k == MK_REG & m.o1.k == MK_REG)
                        {
                            if (m.o0.r >= R_VBASE & m.o1.r >= R_VBASE)
                            {
                                if (sp[m.o0.r] == 1 & sp[m.o1.r] == 0 & g.vcls[m.o0.r] == 0)
                                {
                                    m.o0 = this.s_mo_mem(0 - 1, 0 - 1, 1, (i64)0, (byte*)0, g.vslot[m.o0.r] - 1);
                                    pv_push(gb.mi, (void*)m);
                                    continue;
                                };
                                if (sp[m.o1.r] == 1 & sp[m.o0.r] == 0 & m.sz == 8 & g.vcls[m.o1.r] == 0)
                                {
                                    held[m.o1.r] = 0;
                                    m.o1 = this.s_mo_mem(0 - 1, 0 - 1, 1, (i64)0, (byte*)0, g.vslot[m.o1.r] - 1);
                                    pv_push(gb.mi, (void*)m);
                                    continue;
                                };
                            };
                        };
                        // reloads in front, stores behind
                        k = 0;
                        while (k < 4)
                        {
                            o = this.s_opnd(m, k);
                            if (o != (MO*)0)
                            {
                                role = this.s_role(m.op, k, o);
                                o = this.s_mo_copy(o);
                                if (k == 0) { m.o0 = o; };
                                if (k == 1) { m.o1 = o; };
                                if (k == 2) { m.o2 = o; };
                                if (k == 3) { m.o3 = o; };
                                if (o.k == MK_MEM)
                                {
                                    if (o.r >= R_VBASE)
                                    {
                                        if (sp[o.r] == 1)
                                        {
                                            hv = o.r;
                                            if (SSA_OPT_SPILLFWD == 1 & held[hv] != 0 & gb.mi.len - hpos[hv] <= 6) { t = held[hv]; }
                                            else
                                            {
                                                t = this.s_nv(g.vcls[hv]);
                                                g.vwgt[t] = 2000000000;
                                                this.s_spillmi(false, t, hv);
                                                held[hv] = t;
                                                hpos[hv] = gb.mi.len;
                                            };
                                            o.r = t;
                                        };
                                    };
                                    if (o.r2 >= R_VBASE)
                                    {
                                        if (sp[o.r2] == 1)
                                        {
                                            hv = o.r2;
                                            if (SSA_OPT_SPILLFWD == 1 & held[hv] != 0 & gb.mi.len - hpos[hv] <= 6) { t = held[hv]; }
                                            else
                                            {
                                                t = this.s_nv(g.vcls[hv]);
                                                g.vwgt[t] = 2000000000;
                                                this.s_spillmi(false, t, hv);
                                                held[hv] = t;
                                                hpos[hv] = gb.mi.len;
                                            };
                                            o.r2 = t;
                                        };
                                    };
                                };
                                if (o.k == MK_REG)
                                {
                                    if (o.r >= R_VBASE)
                                    {
                                        if (sp[o.r] == 1 & role == 1)
                                        {
                                            hv = o.r;
                                            if (SSA_OPT_SPILLFWD == 1 & held[hv] != 0 & gb.mi.len - hpos[hv] <= 6) { t = held[hv]; }
                                            else
                                            {
                                                t = this.s_nv(g.vcls[hv]);
                                                g.vwgt[t] = 2000000000;
                                                this.s_spillmi(false, t, hv);
                                                held[hv] = t;
                                                hpos[hv] = gb.mi.len;
                                            };
                                            o.r = t;
                                        };
                                    };
                                };
                            };
                            k++;
                        };
                        pv_push(gb.mi, (void*)m);
                        k = 0;
                        while (k < 4)
                        {
                            o = this.s_opnd(m, k);
                            if (o != (MO*)0)
                            {
                                if (o.k == MK_REG)
                                {
                                    role = this.s_role(m.op, k, o);
                                    if (o.r >= R_VBASE & role == 2)
                                    {
                                        if (sp[o.r] == 1)
                                        {
                                            t = this.s_nv(g.vcls[o.r]);
                                            g.vwgt[t] = 2000000000;
                                            v = o.r;
                                            o.r = t;
                                            this.s_spillmi(true, t, v);
                                            held[v] = t;
                                            hpos[v] = gb.mi.len;
                                        };
                                    };
                                };
                            };
                            k++;
                        };
                    };
                    pv_free(old);
                    i++;
                };
                i = 0;
                while (i < this.nspl)
                {
                    g.vcol[this.spl[i]] = 0 - 1;
                    i++;
                };
                this.s_ifree(sp);
                this.s_ifree(held);
                this.s_ifree(hpos);
                ->;
            };

            s_opnd(MI* m, int k) -> MO*
            {
                if (k == 0) { -> m.o0; };
                if (k == 1) { -> m.o1; };
                if (k == 3) { -> m.o3; };
                -> m.o2;
            };

            // Allocates registers for the selected code
            s_ra() -> bool
            {
                GF* g = this.sf;
                int rounds = 0;
                int r, i, b, cs, j, k;
                GB* gb;
                cs = this.s_csmask();
                while (true)
                {
                    rounds++;
                    if (rounds > 80) { this.s_fail(g"register allocation rounds\0"); -> false; };
                    this.s_globals();
                    this.s_liveness();
                    this.s_graph();
                    r = this.s_color();
                    if (r < 0) { this.s_fail(g"register allocation\0"); -> false; };
                    if (r == 0) { break; };
                    this.s_spill();
                };
                ((XGF*)g.tg).saved = ((XGF*)g.tg).asmsv `& cs;
                i = R_VBASE;
                while (i < g.nvr)
                {
                    if (g.vcol[i] >= 0)
                    {
                        b = 1 << g.vcol[i];
                        if ((cs `& b) != 0) { ((XGF*)g.tg).saved = ((XGF*)g.tg).saved `| b; };
                    };
                    i++;
                };
                // callee saved registers written by name (the string moves use rsi and rdi) are saved too
                i = 0;
                while (i < g.nb)
                {
                    gb = g.rpo[i];
                    j = 0;
                    while (j < gb.mi.len)
                    {
                        this.s_scan((MI*)gb.mi.items[j]);
                        k = 0;
                        while (k < this.ndb)
                        {
                            r = this.dbuf[k];
                            if (r < 16)
                            {
                                b = 1 << r;
                                if ((cs `& b) != 0) { ((XGF*)g.tg).saved = ((XGF*)g.tg).saved `| b; };
                            };
                            k++;
                        };
                        j++;
                    };
                    i++;
                };
                -> true;
            };

            // Hardware register of register number r after allocation
            s_phys(int r) -> int
            {
                if (r >= R_VBASE) { -> this.sf.vcol[r]; };
                -> r;
            };

            // Writes the name of hardware register r for an access of sz bytes
            e_reg(Buf* o, int r, int sz) -> void
            {
                int k;
                o.put(37);
                if (r >= 16)
                {
                    o.put_str(g"xmm\0");
                    o.put_int(r - 16);
                    ->;
                };
                k = 0;
                if (sz == 4) { k = 1; };
                if (sz == 2) { k = 2; };
                if (sz == 1) { k = 3; };
                o.put_str(this.rn[k * 16 + r]);
                ->;
            };

            // Memory operand text
            e_mem(Buf* o, MO* m) -> void
            {
                i64 disp = m.imm;
                int base = m.r;
                if (m.fo >= 0)
                {
                    disp = disp + (i64)((XFO*)((XGF*)this.sf.tg).fobj.items[m.fo]).off;
                    base = 5;
                };
                if (base == 5 & ((XGF*)this.sf.tg).nofp)
                {
                    // no frame pointer: rbp + disp is rsp + disp + frame - 8
                    disp = disp + (i64)(((XGF*)this.sf.tg).frame - 8);
                    base = 4;
                };
                if (m.sym != (byte*)0)
                {
                    o.put_str(m.sym);
                    if (disp > (i64)0) { o.put(43); put_i64(o, disp); };
                    if (disp < (i64)0) { put_i64(o, disp); };
                    if (m.r2 >= 0)
                    {
                        o.put_str(g"(,\0");
                        this.e_reg(o, this.s_phys(m.r2), 8);
                        o.put(44);
                        o.put_int(m.sc);
                        o.put(41);
                        ->;
                    };
                    o.put_str(g"(%rip)\0");
                    ->;
                };
                if (disp != (i64)0) { put_i64(o, disp); };
                if (base >= 0 | m.r2 >= 0)
                {
                    o.put(40);
                    if (base >= 0) { this.e_reg(o, this.s_phys(base), 8); };
                    if (m.r2 >= 0)
                    {
                        o.put(44);
                        this.e_reg(o, this.s_phys(m.r2), 8);
                        o.put(44);
                        o.put_int(m.sc);
                    };
                    o.put(41);
                    ->;
                };
                if (disp == (i64)0) { o.put(48); };
                ->;
            };

            // Operand text for an access of sz bytes
            e_op(Buf* o, MO* m, int sz) -> void
            {
                if (m.k == MK_REG) { this.e_reg(o, this.s_phys(m.r), sz); ->; };
                if (m.k == MK_IMM) { o.put(36); put_i64(o, m.imm); ->; };
                if (m.k == MK_MEM) { this.e_mem(o, m); ->; };
                if (m.k == MK_SYM) { o.put_str(m.sym); ->; };
                ->;
            };

            // Size letter of the mnemonic
            e_sfx(Buf* o, int sz) -> void
            {
                if (sz == 8) { o.put(113); ->; };
                if (sz == 4) { o.put(108); ->; };
                if (sz == 2) { o.put(119); ->; };
                o.put(98);
                ->;
            };

            // Condition code suffix
            e_cc(Buf* o, int cc) -> void
            {
                if (cc == C_E) { o.put_str(g"e\0"); ->; };
                if (cc == C_NE) { o.put_str(g"ne\0"); ->; };
                if (cc == C_B) { o.put_str(g"b\0"); ->; };
                if (cc == C_AE) { o.put_str(g"ae\0"); ->; };
                if (cc == C_BE) { o.put_str(g"be\0"); ->; };
                if (cc == C_A) { o.put_str(g"a\0"); ->; };
                if (cc == C_L) { o.put_str(g"l\0"); ->; };
                if (cc == C_GE) { o.put_str(g"ge\0"); ->; };
                if (cc == C_LE) { o.put_str(g"le\0"); ->; };
                if (cc == C_G) { o.put_str(g"g\0"); ->; };
                if (cc == C_P) { o.put_str(g"p\0"); ->; };
                if (cc == C_NP) { o.put_str(g"np\0"); ->; };
                if (cc == C_S) { o.put_str(g"s\0"); ->; };
                o.put_str(g"ns\0");
                ->;
            };

            // ----------------------------------------------------------
            // Lowering
            // ----------------------------------------------------------

            // True when a later instruction of the block reads the flags before another one writes them
            s_flags_live(GB* gb, int idx) -> bool
            {
                int j = idx + 1;
                MI* m;
                int op;
                while (j < gb.mi.len)
                {
                    m = (MI*)gb.mi.items[j];
                    op = m.op;
                    if (op == M_JCC | op == M_SETCC | op == M_CMOV | op == M_FSEL) { -> true; };
                    if (op == M_CMP | op == M_TEST | op == M_BT | op == M_FCMP | op == M_CVT | op == M_FREM | op == M_ALU | op == M_SHIFT | op == M_UN | op == M_RMW | op == M_BREV | op == M_STRLEN | op == M_CNTB | op == M_RUNB | op == M_FMAP | op == M_DIV | op == M_CALL | op == M_ASM | op == M_DALLOC | op == M_JMP | op == M_RET) { -> false; };
                    j++;
                };
                -> false;
            };

            // True when every instruction that reads the flags after idx looks only at the zero and sign flags
            s_flags_zs(GB* gb, int idx) -> bool
            {
                int j = idx + 1;
                MI* m;
                int op;
                while (j < gb.mi.len)
                {
                    m = (MI*)gb.mi.items[j];
                    op = m.op;
                    if (op == M_JCC | op == M_SETCC | op == M_CMOV)
                    {
                        if (m.cc != C_E & m.cc != C_NE & m.cc != C_S & m.cc != C_NS) { -> false; };
                    };
                    if (op == M_FSEL) { -> false; };
                    if (op == M_CMP | op == M_TEST | op == M_BT | op == M_FCMP | op == M_CVT | op == M_FREM | op == M_ALU | op == M_SHIFT | op == M_UN | op == M_RMW | op == M_BREV | op == M_STRLEN | op == M_CNTB | op == M_RUNB | op == M_FMAP | op == M_DIV | op == M_CALL | op == M_ASM | op == M_DALLOC | op == M_JMP | op == M_RET) { -> true; };
                    j++;
                };
                -> true;
            };

            e_ln(Buf* o, byte* s) -> void
            {
                o.put(9);
                o.put_str(s);
                o.put(10);
                ->;
            };

            // Writes "mnemonic suffix src, dst" for a two operand instruction
            e_two(Buf* o, byte* mn, int sz, MO* a, MO* b, int asz, int bsz) -> void
            {
                o.put(9);
                o.put_str(mn);
                if (sz > 0) { this.e_sfx(o, sz); };
                o.put(32);
                this.e_op(o, a, asz);
                o.put_str(g", \0");
                this.e_op(o, b, bsz);
                o.put(10);
                ->;
            };

            // Moves of sz bytes between register, memory and immediate operands
            e_mov(Buf* o, MO* a, MO* b, int sz, bool zero, bool flags) -> void
            {
                int pa, pb;
                if (a.k == MK_REG & b.k == MK_REG)
                {
                    pa = this.s_phys(a.r);
                    pb = this.s_phys(b.r);
                    if (pa == pb)
                    {
                        if (!(sz == 4 & zero)) { ->; };
                    };
                    if (pa >= 16 | pb >= 16)
                    {
                        this.s_fail(g"xmm move\0");
                        ->;
                    };
                    if (sz < 4) { sz = 4; };
                    this.e_two(o, g"mov\0", sz, a, b, sz, sz);
                    ->;
                };
                if (a.k == MK_IMM & b.k == MK_REG)
                {
                    if (a.imm == (i64)0 & !flags)
                    {
                        pb = this.s_phys(b.r);
                        o.put(9);
                        o.put_str(g"xorl \0");
                        this.e_reg(o, pb, 4);
                        o.put_str(g", \0");
                        this.e_reg(o, pb, 4);
                        o.put(10);
                        ->;
                    };
                    if (sz < 4) { sz = 4; };
                    // a movl of a constant that fits 32 bits clears the upper half and is shorter than the movq
                    if (sz == 8 & SSA_OPT_MOVL == 1)
                    {
                        if (a.imm >= (i64)0 & a.imm <= (i64)4294967295) { sz = 4; };
                    };
                    this.e_two(o, g"mov\0", sz, a, b, sz, sz);
                    ->;
                };
                this.e_two(o, g"mov\0", sz, a, b, sz, sz);
                ->;
            };

            s_ccinv(int cc) -> int
            {
                -> this.s_invcc(cc);
            };

            // Lowers instruction idx of block gb
            e_mi(Buf* o, GB* gb, int idx, GB* next) -> void
            {
                MI* m = (MI*)gb.mi.items[idx];
                int op = m.op;
                int sz = m.sz;
                int pa, pb, pd, k, cc, nid, j2, k2;
                bool ok2;
                MO* a;
                MO* b;
                MO* d;
                MI* m2;
                bool sw;
                if (op == M_LABEL) { ->; };
                if (op == M_MOV)
                {
                    this.e_mov(o, m.o0, m.o1, sz, m.cc == 1, this.s_flags_live(gb, idx));
                    ->;
                };
                if (op == M_MOVABS)
                {
                    o.put(9);
                    o.put_str(g"movabsq $\0");
                    put_i64(o, m.o0.imm);
                    o.put_str(g", \0");
                    this.e_op(o, m.o1, 8);
                    o.put(10);
                    ->;
                };
                if (op == M_MOVZX)
                {
                    // extending a register that the previous instruction already zero extended from the same or a smaller size
                    if (SSA_OPT_ZEXT == 1 & idx > 0 & m.o0.k == MK_REG & m.o1.k == MK_REG)
                    {
                        if (this.s_phys(m.o0.r) == this.s_phys(m.o1.r))
                        {
                            m2 = (MI*)gb.mi.items[idx - 1];
                            if (m2.op == M_MOVZX & m2.sz <= sz & m2.o1.k == MK_REG)
                            {
                                if (this.s_phys(m2.o1.r) == this.s_phys(m.o1.r)) { ->; };
                            };
                            if (m2.op == M_PCOPY)
                            {
                                if (this.s_pc_zx(m2, this.s_phys(m.o0.r), sz)) { ->; };
                            };
                            if (m2.op == M_MOV & (m2.sz == 4 | m2.sz == 8) & m2.o0.k == MK_IMM & m2.o1.k == MK_REG)
                            {
                                if (this.s_phys(m2.o1.r) == this.s_phys(m.o1.r) & m2.o0.imm >= (i64)0 & m2.o0.imm < (i64)(1 << (8 * sz))) { ->; };
                            };
                        };
                    };
                    o.put(9);
                    if (sz == 1) { o.put_str(g"movzbl \0"); } else { o.put_str(g"movzwl \0"); };
                    this.e_op(o, m.o0, sz);
                    o.put_str(g", \0");
                    this.e_op(o, m.o1, 4);
                    o.put(10);
                    ->;
                };
                if (op == M_MOVSX)
                {
                    o.put(9);
                    if (sz == 4) { o.put_str(g"movslq \0"); }
                    else
                    {
                        if (sz == 1 & m.cc == 4) { o.put_str(g"movsbl \0"); };
                        if (sz == 1 & m.cc == 8) { o.put_str(g"movsbq \0"); };
                        if (sz == 2 & m.cc == 4) { o.put_str(g"movswl \0"); };
                        if (sz == 2 & m.cc == 8) { o.put_str(g"movswq \0"); };
                    };
                    this.e_op(o, m.o0, sz);
                    o.put_str(g", \0");
                    this.e_op(o, m.o1, m.cc);
                    o.put(10);
                    ->;
                };
                if (op == M_LEA)
                {
                    o.put(9);
                    if (m.sz == 4) { o.put_str(g"leal \0"); } else { o.put_str(g"leaq \0"); };
                    this.e_mem(o, m.o0);
                    o.put_str(g", \0");
                    this.e_op(o, m.o1, m.sz);
                    o.put(10);
                    ->;
                };
                if (op == M_ALU)
                {
                    // a mask that keeps what the previous instruction already left in the same register
                    if (SSA_OPT_ZEXT == 1 & idx > 0 & m.cc == A_AND & m.o1.k == MK_IMM & m.o0.k == MK_REG & m.o2.k == MK_REG)
                    {
                        j2 = idx - 1;
                        m2 = (MI*)gb.mi.items[j2];
                        // register moves the allocator made into no-ops do not count
                        while (j2 > 0 & m2.op == M_MOV)
                        {
                            if (m2.o0.k != MK_REG | m2.o1.k != MK_REG) { break; };
                            if (this.s_phys(m2.o0.r) != this.s_phys(m2.o1.r) | m2.cc == 1) { break; };
                            j2--;
                            m2 = (MI*)gb.mi.items[j2];
                        };
                        if (m2.op == M_ALU & m2.cc == A_AND & m2.o1.k == MK_IMM & m2.o2.k == MK_REG & m2.o0.k == MK_REG)
                        {
                            if (this.s_phys(m2.o2.r) == this.s_phys(m.o0.r) & this.s_phys(m.o0.r) == this.s_phys(m.o2.r) & m.sz >= m2.sz)
                            {
                                if (m2.o1.imm >= (i64)0 & m.o1.imm >= (i64)0)
                                {
                                    if ((m2.o1.imm `& (m.o1.imm `^| (i64)-1)) == (i64)0)
                                    {
                                        if (!this.s_flags_live(gb, idx))
                                        {
                                            // a test of the result right behind relies on these flags
                                            ok2 = true;
                                            if (idx + 1 < gb.mi.len) { if (((MI*)gb.mi.items[idx + 1]).op == M_TEST) { ok2 = false; }; };
                                            if (ok2) { ->; };
                                        };
                                    };
                                };
                            };
                        };
                    };
                    this.e_alu(o, m);
                    ->;
                };
                if (op == M_SHIFT)
                {
                    a = m.o0;
                    d = m.o2;
                    pa = this.s_phys(a.r);
                    pd = this.s_phys(d.r);
                    if (m.tgt == 77)
                    {
                        o.put(9);
                        if (m.cc == S_SHL) { o.put_str(g"shlx \0"); };
                        if (m.cc == S_SHR) { o.put_str(g"shrx \0"); };
                        if (m.cc == S_SAR) { o.put_str(g"sarx \0"); };
                        if (m.cc == S_ROR) { o.put_str(g"rorx \0"); };
                        this.e_op(o, m.o1, sz);
                        o.put_str(g", \0");
                        this.e_op(o, a, sz);
                        o.put_str(g", \0");
                        this.e_op(o, d, sz);
                        o.put(10);
                        ->;
                    };
                    if (pa != pd) { this.e_two(o, g"mov\0", sz, a, d, sz, sz); };
                    o.put(9);
                    if (m.cc == S_SHL) { o.put_str(g"shl\0"); };
                    if (m.cc == S_SHR) { o.put_str(g"shr\0"); };
                    if (m.cc == S_SAR) { o.put_str(g"sar\0"); };
                    if (m.cc == S_ROR) { o.put_str(g"ror\0"); };
                    this.e_sfx(o, sz);
                    o.put(32);
                    if (m.o1.k == MK_IMM) { o.put(36); put_i64(o, m.o1.imm); } else { o.put_str(g"%cl\0"); };
                    o.put_str(g", \0");
                    this.e_op(o, d, sz);
                    o.put(10);
                    ->;
                };
                if (op == M_BREV)
                {
                    this.e_brev(o, m);
                    ->;
                };
                if (op == M_STRLEN)
                {
                    this.e_strlen(o, m);
                    ->;
                };
                if (op == M_CNTB)
                {
                    this.e_cntb(o, m);
                    ->;
                };
                if (op == M_RUNB)
                {
                    this.e_runb(o, m);
                    ->;
                };
                if (op == M_FMAP)
                {
                    this.e_fmap(o, m);
                    ->;
                };
                if (op == M_RMW)
                {
                    if (m.cc == A_AND) { this.e_two(o, g"and\0", sz, m.o0, m.o1, sz, sz); ->; };
                    if (m.cc == A_OR) { this.e_two(o, g"or\0", sz, m.o0, m.o1, sz, sz); ->; };
                    this.e_two(o, g"xor\0", sz, m.o0, m.o1, sz, sz);
                    ->;
                };
                if (op == M_UN)
                {
                    a = m.o0;
                    d = m.o1;
                    if (m.cc == U_MOVBE)
                    {
                        this.e_two(o, g"movbe\0", sz, a, d, sz, sz);
                        ->;
                    };
                    if (m.cc == U_POPCNT | m.cc == U_LZCNT | m.cc == U_TZCNT)
                    {
                        if (m.cc == U_POPCNT) { this.e_two(o, g"popcnt\0", sz, a, d, sz, sz); };
                        if (m.cc == U_LZCNT) { this.e_two(o, g"lzcnt\0", sz, a, d, sz, sz); };
                        if (m.cc == U_TZCNT) { this.e_two(o, g"tzcnt\0", sz, a, d, sz, sz); };
                        ->;
                    };
                    if (m.cc == U_BLSR | m.cc == U_BLSI | m.cc == U_BLSMSK)
                    {
                        if (m.cc == U_BLSR) { this.e_two(o, g"blsr\0", 0, a, d, sz, sz); };
                        if (m.cc == U_BLSI) { this.e_two(o, g"blsi\0", 0, a, d, sz, sz); };
                        if (m.cc == U_BLSMSK) { this.e_two(o, g"blsmsk\0", 0, a, d, sz, sz); };
                        ->;
                    };
                    if (this.s_phys(a.r) != this.s_phys(d.r)) { this.e_two(o, g"mov\0", sz, a, d, sz, sz); };
                    o.put(9);
                    if (m.cc == U_BSWAP)
                    {
                        if (sz == 2) { o.put_str(g"rolw $8, \0"); this.e_op(o, d, 2); o.put(10); ->; };
                        if (sz == 4) { o.put_str(g"bswapl \0"); } else { o.put_str(g"bswapq \0"); };
                        this.e_op(o, d, sz);
                        o.put(10);
                        ->;
                    };
                    if (m.cc == U_NEG) { o.put_str(g"neg\0"); } else { o.put_str(g"not\0"); };
                    this.e_sfx(o, sz);
                    o.put(32);
                    this.e_op(o, d, sz);
                    o.put(10);
                    ->;
                };
                if (op == M_CMP)
                {
                    // comparing a register with zero: test sets the same flags a compare with zero does, in fewer bytes
                    if (SSA_OPT_CMPZ == 1 & m.o0.k == MK_REG & m.o1.k == MK_IMM)
                    {
                        if (m.o1.imm == (i64)0)
                        {
                            this.e_two(o, g"test\0", sz, m.o0, m.o0, sz, sz);
                            ->;
                        };
                    };
                    this.e_two(o, g"cmp\0", sz, m.o1, m.o0, sz, sz);
                    ->;
                };
                if (op == M_BT) { this.e_two(o, g"bt\0", sz, m.o0, m.o1, sz, sz); ->; };
                if (op == M_TEST)
                {
                    // testing a register the previous instruction just computed in place: its flags already
                    // describe the result when only the zero and sign conditions are looked at
                    if (SSA_OPT_TESTELIM == 1 & (idx > 0 | this.rprev != (MI*)0) & m.o0.k == MK_REG & m.o1.k == MK_REG)
                    {
                        if (this.s_phys(m.o0.r) == this.s_phys(m.o1.r))
                        {
                            if (idx > 0)
                            {
                                k2 = idx - 1;
                                m2 = (MI*)gb.mi.items[k2];
                                // a move of a register onto itself prints nothing
                                while (k2 > 0 & this.s_noop_mi(m2))
                                {
                                    k2--;
                                    m2 = (MI*)gb.mi.items[k2];
                                };
                            }
                            else { m2 = this.rprev; };
                            if (m2.op != M_ALU) { m2 = (MI*)0; };
                            if (m2 != (MI*)0)
                            {
                                if (m2.sz != sz | m2.o0 == (MO*)0 | m2.o2 == (MO*)0) { m2 = (MI*)0; };
                            };
                            if (m2 != (MI*)0)
                            {
                                if (m2.o0.k != MK_REG | m2.o2.k != MK_REG) { m2 = (MI*)0; };
                            };
                            if (m2 != (MI*)0)
                            {
                                if (m2.cc == A_ADD | m2.cc == A_SUB | m2.cc == A_OR | m2.cc == A_XOR | m2.cc == A_AND)
                                {
                                    if (this.s_phys(m2.o0.r) == this.s_phys(m2.o2.r) & this.s_phys(m2.o2.r) == this.s_phys(m.o0.r))
                                    {
                                        if (this.s_flags_zs(gb, idx)) { ->; };
                                    };
                                };
                            };
                        };
                    };
                    this.e_two(o, g"test\0", sz, m.o1, m.o0, sz, sz);
                    ->;
                };
                if (op == M_SETCC)
                {
                    o.put(9);
                    o.put_str(g"set\0");
                    this.e_cc(o, m.cc);
                    o.put(32);
                    this.e_op(o, m.o0, 1);
                    o.put(10);
                    ->;
                };
                if (op == M_CMOV)
                {
                    a = m.o0;
                    b = m.o1;
                    d = m.o2;
                    cc = m.cc;
                    pa = this.s_phys(a.r);
                    pb = this.s_phys(b.r);
                    pd = this.s_phys(d.r);
                    if (pd == pb)
                    {
                    }
                    else
                    {
                        if (pd == pa)
                        {
                            // d already holds the value for the true case: move the other one in when the condition is false
                            a = m.o1;
                            cc = this.s_invcc(cc);
                        }
                        else
                        {
                            this.e_two(o, g"mov\0", sz, b, d, sz, sz);
                        };
                    };
                    o.put(9);
                    o.put_str(g"cmov\0");
                    this.e_cc(o, cc);
                    o.put(32);
                    this.e_op(o, a, sz);
                    o.put_str(g", \0");
                    this.e_op(o, d, sz);
                    o.put(10);
                    ->;
                };
                if (op == M_JCC | op == M_JMP)
                {
                    this.e_jump(o, gb, idx, next);
                    ->;
                };
                if (op == M_CALL)
                {
                    if (m.tgt == 77 & m.o0.k == MK_SYM)
                    {
                        // a call whose result is returned as it is: restore the frame and jump
                        k2 = idx + 1;
                        ok2 = true;
                        while (k2 < gb.mi.len & ok2)
                        {
                            m2 = (MI*)gb.mi.items[k2];
                            if (m2.op == M_RET) { break; };
                            if (m2.op == M_MOV & m2.o0.k == MK_REG & m2.o1.k == MK_REG)
                            {
                                if (this.s_phys(m2.o0.r) != this.s_phys(m2.o1.r)) { ok2 = false; };
                            }
                            else { ok2 = false; };
                            k2++;
                        };
                        if (ok2 & k2 == gb.mi.len - 1)
                        {
                            this.e_epilogue2(o, true);
                            o.put(9);
                            o.put_str(g"jmp \0");
                            o.put_str(m.o0.sym);
                            o.put(10);
                            m2.op = M_LABEL;
                            ->;
                        };
                    };
                    o.put(9);
                    o.put_str(g"callq \0");
                    if (m.o0.k == MK_SYM) { o.put_str(m.o0.sym); }
                    else
                    {
                        o.put(42);
                        this.e_op(o, m.o0, 8);
                    };
                    o.put(10);
                    ->;
                };
                if (op == M_RET) { this.e_epilogue(o); ->; };
                if (op == M_CQO)
                {
                    if (sz == 8) { this.e_ln(o, g"cqto\0"); } else { this.e_ln(o, g"cltd\0"); };
                    ->;
                };
                if (op == M_DIV)
                {
                    o.put(9);
                    if (m.cc == 1) { o.put_str(g"idiv\0"); }
                    elif (m.cc == 2) { o.put_str(g"mul\0"); }
                    elif (m.cc == 3) { o.put_str(g"imul\0"); }
                    else { o.put_str(g"div\0"); };
                    this.e_sfx(o, sz);
                    o.put(32);
                    this.e_op(o, m.o0, sz);
                    o.put(10);
                    ->;
                };
                if (op == M_UD2) { this.e_ln(o, g"ud2\0"); ->; };
                if (op == M_FALU) { this.e_falu(o, m); ->; };
                if (op == M_FMA) { this.e_fma(o, m); ->; };
                if (op == M_FCMP) { this.e_fcmp(o, m); ->; };
                if (op == M_CVT) { this.e_cvt(o, m); ->; };
                if (op == M_GX) { this.e_gx(o, m); ->; };
                if (op == M_XMOV) { this.e_xmov(o, m); ->; };
                if (op == M_FSEL) { this.e_fsel(o, m); ->; };
                if (op == M_FREM) { this.e_frem(o, m); ->; };
                if (op == M_JTAB) { this.e_jtab(o, m); ->; };
                if (op == M_JTAB2) { this.e_radix(o, m); ->; };
                if (op == M_PCOPY) { this.e_pcopy(o, m, this.s_flags_live(gb, idx)); ->; };
                if (op == M_COPY) { this.e_copy(o, m); ->; };
                if (op == M_DALLOC)
                {
                    o.put_str(g"\tsubq \0");
                    this.e_op(o, m.o0, 8);
                    o.put_str(g", %rsp\n\tleaq \0");
                    if (((XGF*)this.sf.tg).outmax > 0) { o.put_int(((XGF*)this.sf.tg).outmax); };
                    o.put_str(g"(%rsp), \0");
                    this.e_op(o, m.o1, 8);
                    o.put(10);
                    ->;
                };
                if (op == M_VAARG) { this.e_vaarg(o, m); ->; };
                if (op == M_VASTART) { this.e_vastart(o, m); ->; };
                if (op == M_RETADDR)
                {
                    o.put_str(g"\tleaq 8(%rbp), \0");
                    this.e_reg(o, this.s_phys(m.o0.r), 8);
                    o.put(10);
                    ->;
                };
                if (op == M_SAVEVA) { this.e_saveva(o, m); ->; };
                if (op == M_ASM) { o.put_str(m.text); ->; };
                if (op == M_INT3) { this.e_ln(o, g"int3\0"); ->; };
                if (op == M_MEMMOVE) { this.e_memmove(o); ->; };
                if (op == M_VZERO) { this.e_vzero(o, m); ->; };
                if (op == M_REPSTOS) { this.e_ln(o, g"rep stosb\0"); ->; };
                if (op == M_REPMOVS) { if (m.cc == 7) { this.e_revcp(o, m); ->; }; this.e_ln(o, g"rep movsb\0"); ->; };
                this.s_fail(g"emit instruction\0");
                ->;
            };

            // Overlap safe copy: forwards when the destination is below the source, backwards otherwise
            e_memmove(Buf* o) -> void
            {
                int l1, l2;
                this.lab++;
                l1 = this.lab;
                this.lab++;
                l2 = this.lab;
                this.e_ln(o, g"cmpq %rsi, %rdi\0");
                this.e_ln(o, f"jbe .LM{l1}\0");
                this.e_ln(o, g"leaq -1(%rsi,%rcx), %rsi\0");
                this.e_ln(o, g"leaq -1(%rdi,%rcx), %rdi\0");
                this.e_ln(o, g"std\0");
                this.e_ln(o, g"rep movsb\0");
                this.e_ln(o, g"cld\0");
                this.e_ln(o, f"jmp .LM{l2}\0");
                o.put_str(f".LM{l1}:\n\0");
                this.e_ln(o, g"rep movsb\0");
                o.put_str(f".LM{l2}:\n\0");
                ->;
            };

            // Writes "text(%list)" style lines for the va_list at register r
            e_lst(Buf* o, int r, int disp) -> void
            {
                if (disp != 0) { o.put_int(disp); };
                o.put(40);
                this.e_reg(o, r, 8);
                o.put(41);
                ->;
            };

            e_saveva(Buf* o, MI* m) -> void
            {
                int i;
                i64 off;
                if (m.tgt < 0)
                {
                    this.e_ln(o, g"movq %rcx, 16(%rbp)\0");
                    this.e_ln(o, g"movq %rdx, 24(%rbp)\0");
                    this.e_ln(o, g"movq %r8, 32(%rbp)\0");
                    this.e_ln(o, g"movq %r9, 40(%rbp)\0");
                    ->;
                };
                off = (i64)((XFO*)((XGF*)this.sf.tg).fobj.items[m.tgt]).off;
                i = 0;
                while (i < 6)
                {
                    o.put_str(g"\tmovq \0");
                    if (i == 0) { o.put_str(g"%rdi\0"); };
                    if (i == 1) { o.put_str(g"%rsi\0"); };
                    if (i == 2) { o.put_str(g"%rdx\0"); };
                    if (i == 3) { o.put_str(g"%rcx\0"); };
                    if (i == 4) { o.put_str(g"%r8\0"); };
                    if (i == 5) { o.put_str(g"%r9\0"); };
                    o.put_str(g", \0");
                    put_i64(o, off + (i64)(8 * i));
                    o.put_str(g"(%rbp)\n\0");
                    i++;
                };
                i = 0;
                while (i < 8)
                {
                    o.put_str(g"\tmovaps %xmm\0");
                    o.put_int(i);
                    o.put_str(g", \0");
                    put_i64(o, off + (i64)(48 + 16 * i));
                    o.put_str(g"(%rbp)\n\0");
                    i++;
                };
                ->;
            };

            e_vastart(Buf* o, MI* m) -> void
            {
                GF* g = this.sf;
                int r = this.s_phys(m.o0.r);
                if (this.a_win())
                {
                    o.put_str(g"\tleaq \0");
                    o.put_int(16 + 8 * ((XGF*)g.tg).vagp);
                    o.put_str(g"(%rbp), %r10\n\tmovq %r10, (\0");
                    this.e_reg(o, r, 8);
                    o.put_str(g")\n\0");
                    ->;
                };
                o.put_str(g"\tmovl $\0");
                o.put_int(((XGF*)g.tg).vagp * 8);
                o.put_str(g", (\0");
                this.e_reg(o, r, 8);
                o.put_str(g")\n\tmovl $\0");
                o.put_int(48 + ((XGF*)g.tg).vafp * 16);
                o.put_str(g", 4(\0");
                this.e_reg(o, r, 8);
                o.put_str(g")\n\tleaq \0");
                o.put_int(((XGF*)g.tg).vastk);
                o.put_str(g"(%rbp), %r10\n\tmovq %r10, 8(\0");
                this.e_reg(o, r, 8);
                o.put_str(g")\n\tleaq \0");
                put_i64(o, (i64)((XFO*)((XGF*)g.tg).fobj.items[((XGF*)g.tg).vafo - 1]).off);
                o.put_str(g"(%rbp), %r10\n\tmovq %r10, 16(\0");
                this.e_reg(o, r, 8);
                o.put_str(g")\n\0");
                ->;
            };

            e_vaarg(Buf* o, MI* m) -> void
            {
                int r = this.s_phys(m.o0.r);
                int sz = m.sz;
                int l1, l2;
                bool fp = m.cc == 1;
                if (this.a_win())
                {
                    o.put_str(g"\tmovq (\0");
                    this.e_reg(o, r, 8);
                    o.put_str(g"), %r10\n\tleaq 8(%r10), %r11\n\tmovq %r11, (\0");
                    this.e_reg(o, r, 8);
                    o.put_str(g")\n\0");
                    o.put_str(g"\tmov\0");
                }
                else
                {
                    this.lab++;
                    l1 = this.lab;
                    this.lab++;
                    l2 = this.lab;
                    if (fp) { o.put_str(g"\tmovl 4(\0"); } else { o.put_str(g"\tmovl (\0"); };
                    this.e_reg(o, r, 8);
                    o.put_str(g"), %r10d\n\0");
                    if (fp) { o.put_str(g"\tcmpl $160, %r10d\n\0"); } else { o.put_str(g"\tcmpl $40, %r10d\n\0"); };
                    o.put_str(f"\tja .LV{l1}\n\tmovq 16(\0");
                    this.e_reg(o, r, 8);
                    o.put_str(g"), %r11\n\taddq %r10, %r11\n\0");
                    if (fp) { o.put_str(g"\taddl $16, 4(\0"); } else { o.put_str(g"\taddl $8, (\0"); };
                    this.e_reg(o, r, 8);
                    o.put_str(f")\n\tjmp .LV{l2}\n.LV{l1}:\n\tmovq 8(\0");
                    this.e_reg(o, r, 8);
                    o.put_str(g"), %r11\n\tleaq 8(%r11), %r10\n\tmovq %r10, 8(\0");
                    this.e_reg(o, r, 8);
                    o.put_str(f")\n.LV{l2}:\n\tmov\0");
                };
                // the argument sits at (%r10) on Win64 and at (%r11) on System V
                if (fp)
                {
                    if (sz == 4) { o.put_str(g"ss \0"); } else { o.put_str(g"sd \0"); };
                }
                else
                {
                    if (sz == 1) { o.put_str(g"zbl \0"); };
                    if (sz == 2) { o.put_str(g"zwl \0"); };
                    if (sz == 4) { o.put_str(g"l \0"); };
                    if (sz == 8) { o.put_str(g"q \0"); };
                };
                if (this.a_win()) { o.put_str(g"(%r10), \0"); } else { o.put_str(g"(%r11), \0"); };
                if (fp) { this.e_op(o, m.o1, sz); }
                else
                {
                    if (sz < 4) { this.e_op(o, m.o1, 4); } else { this.e_op(o, m.o1, sz); };
                };
                o.put(10);
                ->;
            };

            // Memory operand text n bytes past m
            e_memo(Buf* o, MO* m, int n) -> void
            {
                i64 sv = m.imm;
                m.imm = sv + (i64)n;
                this.e_mem(o, m);
                m.imm = sv;
                ->;
            };

            // Copy of m.sz bytes through xmm15 and r10

            // Width in bytes of the vector stores that zero t bytes: the widest the processor has that fits
            s_vz_w(int t) -> int
            {
                if (t >= 64 & (this.feat `& XF_AVX512F) != 0) { -> 64; };
                if (t >= 32 & (this.feat `& XF_AVX) != 0) { -> 32; };
                -> 16;
            };

            // Instructions the vector zeroing of t bytes takes
            s_vz_cost(int t) -> int
            {
                int w = this.s_vz_w(t);
                int c = 1 + (t + w - 1) / w;
                if (w > 16) { c = c + 1; };
                -> c;
            };

            // Zeroes sz bytes with overlapping vector stores: the last store ends where the range does
            e_vzero(Buf* o, MI* m) -> void
            {
                int t = m.sz;
                int w = this.s_vz_w(t);
                int off = 0;
                bool v = (this.feat `& XF_AVX) != 0;
                if (m.tgt == 1)
                {
                    // every bit set: ternary logic with the truth table 0xff on 512 bits, else a true compare
                    if (w == 64) { o.put_str(g"\tvpternlogd $0xff, %zmm15, %zmm15, %zmm15\n\0"); }
                    elif (w == 32) { o.put_str(g"\tvcmpps $15, %ymm15, %ymm15, %ymm15\n\0"); }
                    elif (v) { o.put_str(g"\tvpcmpeqd %xmm15, %xmm15, %xmm15\n\0"); }
                    else { o.put_str(g"\tpcmpeqd %xmm15, %xmm15\n\0"); };
                }
                else
                {
                    if (v) { o.put_str(g"\tvpxor %xmm15, %xmm15, %xmm15\n\0"); } else { o.put_str(g"\tpxor %xmm15, %xmm15\n\0"); };
                };
                while (off < t)
                {
                    if (off + w > t) { off = t - w; };
                    if (w == 64) { o.put_str(g"\tvmovdqu64 %zmm15, \0"); }
                    elif (w == 32) { o.put_str(g"\tvmovdqu %ymm15, \0"); }
                    elif (v) { o.put_str(g"\tvmovdqu %xmm15, \0"); }
                    else { o.put_str(g"\tmovups %xmm15, \0"); };
                    this.e_memo(o, m.o0, off);
                    o.put(10);
                    off = off + w;
                };
                if (w > 16) { o.put_str(g"\tvzeroupper\n\0"); };
                ->;
            };

            // Copies rcx bytes of elements of m.tgt bytes from rsi to rdi in reverse element order: the last
            // element of the source is the first of the destination. Whole 16 byte blocks go through pshufb when the
            // arrays do not overlap, the rest (and every overlapping copy, which has to see its own stores) one
            // element at a time. Uses rax rcx rdx rsi rdi xmm14 and xmm15.
            e_revcp(Buf* o, MI* m) -> void
            {
                int e = m.tgt;
                int n, k, j, t, b;
                i64 lo = (i64)0;
                i64 hi = (i64)0;
                bool v = (this.feat `& XF_SSSE3) != 0;
                this.lab++;
                n = this.lab;
                o.put_str(g"\tleaq (%rsi,%rcx), %rdx\n\0");
                if (v)
                {
                    k = 0;
                    while (k < 16)
                    {
                        j = k / e;
                        t = k - j * e;
                        b = (16 / e - 1 - j) * e + t;
                        if (k < 8) { lo = lo `| ((i64)b << (8 * k)); } else { hi = hi `| ((i64)b << (8 * (k - 8))); };
                        k++;
                    };
                    o.put_str(g"\tcmpq $16, %rcx\n\tjb .LR\0");
                    o.put_int(n);
                    o.put_str(g"s\n\tmovq %rdi, %rax\n\tsubq %rsi, %rax\n\tcmpq %rcx, %rax\n\tjb .LR\0");
                    o.put_int(n);
                    o.put_str(g"s\n\tmovq %rsi, %rax\n\tsubq %rdi, %rax\n\tcmpq %rcx, %rax\n\tjb .LR\0");
                    o.put_int(n);
                    o.put_str(g"s\n\tmovabsq $\0");
                    put_i64(o, lo);
                    o.put_str(g", %rax\n\tmovq %rax, %xmm15\n\tmovabsq $\0");
                    put_i64(o, hi);
                    o.put_str(g", %rax\n\tmovq %rax, %xmm14\n\tpunpcklqdq %xmm14, %xmm15\n.LR\0");
                    o.put_int(n);
                    o.put_str(g"v:\n\tmovdqu -16(%rdx), %xmm14\n\tpshufb %xmm15, %xmm14\n\tmovdqu %xmm14, (%rdi)\n\tsubq $16, %rdx\n\taddq $16, %rdi\n\tsubq $16, %rcx\n\tcmpq $16, %rcx\n\tjae .LR\0");
                    o.put_int(n);
                    o.put_str(g"v\n\0");
                };
                o.put_str(g".LR\0");
                o.put_int(n);
                o.put_str(g"s:\n\ttestq %rcx, %rcx\n\tje .LR\0");
                o.put_int(n);
                o.put_str(g"d\n\tsubq $\0");
                o.put_int(e);
                o.put_str(g", %rdx\n\tmov\0");
                this.e_sfx(o, e);
                o.put_str(g" (%rdx), \0");
                this.e_reg(o, 0, e);
                o.put_str(g"\n\tmov\0");
                this.e_sfx(o, e);
                o.put(32);
                this.e_reg(o, 0, e);
                o.put_str(g", (%rdi)\n\taddq $\0");
                o.put_int(e);
                o.put_str(g", %rdi\n\tsubq $\0");
                o.put_int(e);
                o.put_str(g", %rcx\n\tjmp .LR\0");
                o.put_int(n);
                o.put_str(g"s\n.LR\0");
                o.put_int(n);
                o.put_str(g"d:\n\0");
                ->;
            };

            e_copy(Buf* o, MI* m) -> void
            {
                int n = m.sz;
                int off = 0;
                int c;
                bool wide = false;
                while (off < n)
                {
                    c = 8;
                    if (n - off >= 64 & (this.feat `& XF_AVX512F) != 0)
                    {
                        wide = true;
                        o.put_str(g"\tvmovdqu64 \0");
                        this.e_memo(o, m.o1, off);
                        o.put_str(g", %zmm15\n\tvmovdqu64 %zmm15, \0");
                        this.e_memo(o, m.o0, off);
                        o.put(10);
                        off = off + 64;
                        continue;
                    };
                    if (n - off >= 32 & (this.feat `& XF_AVX) != 0)
                    {
                        wide = true;
                        o.put_str(g"\tvmovdqu \0");
                        this.e_memo(o, m.o1, off);
                        o.put_str(g", %ymm15\n\tvmovdqu %ymm15, \0");
                        this.e_memo(o, m.o0, off);
                        o.put(10);
                        off = off + 32;
                        continue;
                    };
                    if (n - off >= 16) { c = 16; }
                    else
                    {
                        if (n - off < 8) { c = 4; };
                        if (n - off < 4) { c = 2; };
                        if (n - off < 2) { c = 1; };
                        if (n - off >= 8) { c = 8; };
                    };
                    if (c == 16) { o.put_str(g"\tmovups \0"); }
                    else { o.put_str(g"\tmov\0"); this.e_sfx(o, c); o.put(32); };
                    this.e_memo(o, m.o1, off);
                    if (c == 16) { o.put_str(g", %xmm15\n\tmovups %xmm15, \0"); }
                    else
                    {
                        o.put_str(g", \0");
                        this.e_reg(o, 10, c);
                        o.put_str(g"\n\tmov\0");
                        this.e_sfx(o, c);
                        o.put(32);
                        this.e_reg(o, 10, c);
                        o.put_str(g", \0");
                    };
                    this.e_memo(o, m.o0, off);
                    o.put(10);
                    off = off + c;
                };
                if (wide) { o.put_str(g"\tvzeroupper\n\0"); };
                ->;
            };

            // The number of leading bytes of the len bytes at rdi that obey the rule cc (bits 0 to 7 the byte, bits 8 and up
            // the mode: 0 equal to the byte, 1 not equal, 2 equal to the byte at the same place from rdx), found 32 at a
            // time. The result is in rax.
            e_runb(Buf* o, MI* m) -> void
            {
                int n;
                int mode = m.cc / 256;
                this.lab++;
                n = this.lab;
                o.put_str(g"\txorl %eax, %eax\n\tcmpq $32, %rsi\n\tjl .LR\0");
                o.put_int(n);
                o.put_str(g"d\n\0");
                if (mode != 2)
                {
                    o.put_str(g"\tmovl $\0");
                    o.put_int(m.cc `& 255);
                    o.put_str(g", %r10d\n\tvmovd %r10d, %xmm14\n\tvpbroadcastb %xmm14, %ymm14\n\0");
                };
                o.put_str(g".LR\0");
                o.put_int(n);
                o.put_str(g"l:\n\tleaq 32(%rax), %r11\n\tcmpq %rsi, %r11\n\tjg .LR\0");
                o.put_int(n);
                o.put_str(g"e\n\0");
                if (mode == 2)
                {
                    o.put_str(g"\tvmovdqu (%rdi,%rax), %ymm15\n\tvpcmpeqb (%rdx,%rax), %ymm15, %ymm15\n\tvpmovmskb %ymm15, %r10d\n\tnotl %r10d\n\0");
                }
                else
                {
                    o.put_str(g"\tvpcmpeqb (%rdi,%rax), %ymm14, %ymm15\n\tvpmovmskb %ymm15, %r10d\n\0");
                    if (mode == 0) { o.put_str(g"\tnotl %r10d\n\0"); };
                };
                o.put_str(g"\ttestl %r10d, %r10d\n\tjne .LR\0");
                o.put_int(n);
                o.put_str(g"f\n\tmovq %r11, %rax\n\tjmp .LR\0");
                o.put_int(n);
                o.put_str(g"l\n.LR\0");
                o.put_int(n);
                o.put_str(g"f:\n\t\0");
                if ((this.feat `& XF_BMI1) != 0) { o.put_str(g"tzcntl %r10d, %r10d\n\0"); } else { o.put_str(g"bsfl %r10d, %r10d\n\0"); };
                o.put_str(g"\taddq %r10, %rax\n.LR\0");
                o.put_int(n);
                o.put_str(g"e:\n\tvzeroupper\n.LR\0");
                o.put_int(n);
                o.put_str(g"d:\n\0");
                ->;
            };

            // Counts the bytes equal to the byte cc in whole 32 byte blocks of the len bytes at rdi (rsi) while the count
            // stays below the budget in rdx. Returns the bytes consumed in the high half of rax and the count in the low.
            e_cntb(Buf* o, MI* m) -> void
            {
                int n;
                this.lab++;
                n = this.lab;
                o.put_str(g"\txorl %eax, %eax\n\txorl %ecx, %ecx\n\tcmpq $32, %rsi\n\tjl .LC\0");
                o.put_int(n);
                o.put_str(g"d\n\tmovl $\0");
                o.put_int(m.cc);
                o.put_str(g", %r10d\n\tvmovd %r10d, %xmm14\n\tvpbroadcastb %xmm14, %ymm14\n.LC\0");
                o.put_int(n);
                o.put_str(g"l:\n\tleaq 32(%rcx), %r11\n\tcmpq %rsi, %r11\n\tjg .LC\0");
                o.put_int(n);
                o.put_str(g"e\n\tvpcmpeqb (%rdi,%rcx), %ymm14, %ymm15\n\tvpmovmskb %ymm15, %r10d\n\tpopcntl %r10d, %r10d\n\taddq %rax, %r10\n\tcmpq %rdx, %r10\n\tjge .LC\0");
                o.put_int(n);
                o.put_str(g"e\n\tmovq %r10, %rax\n\tmovq %r11, %rcx\n\tjmp .LC\0");
                o.put_int(n);
                o.put_str(g"l\n.LC\0");
                o.put_int(n);
                o.put_str(g"e:\n\tvzeroupper\n.LC\0");
                o.put_int(n);
                o.put_str(g"d:\n\tshlq $32, %rcx\n\torq %rcx, %rax\n\0");
                ->;
            };

            // Three operand arithmetic written in two operand form
            // Bit reverse of the sz bytes of register o0 into o1. The baseline reverses the bytes and then swaps
            // the nibbles, bit pairs and bits of every byte. Galois field hardware does the bits of all bytes in one
            // instruction, the bytes still need reversing.
            // Length of the zero terminated string at o0 into o1: aligned 16 byte blocks never cross a page, so
            // reading the whole block that holds the first byte cannot fault. Uses rax rcx rdx and xmm0.
            // Element-wise float loop over whole vectors, see s_fvec_one. The program is in o0: four bits per operation,
            // 1 2 3 load the next vector of the array at rsi, rdx or rdi, 4 5 the invariants, 6 7 8 add subtract multiply,
            // 9 10 11 fused x * y + c, x * y - c, c - x * y, bit 60 set for doubles. The stack lives in ymm0..ymm3, the
            // invariants in ymm4 and ymm5.
            e_fmap(Buf* o, MI* m) -> void
            {
                i64 prog = m.o0.imm;
                bool dbl = ((prog >> 60) `& (i64)1) != (i64)0;
                int n, i, op, sp, lanes;
                bool usea, useb;
                this.lab++;
                n = this.lab;
                lanes = 8;
                if (dbl) { lanes = 4; };
                usea = false;
                useb = false;
                i = 0;
                while (i < 14)
                {
                    op = (int)((prog >> (i * 4)) `& (i64)15);
                    if (op == 0) { break; };
                    if (op == 1) { usea = true; };
                    if (op == 2) { useb = true; };
                    i++;
                };
                o.put_str(g"\txorl %eax, %eax\n\tcmpq $\0");
                o.put_int(lanes);
                o.put_str(g", %rcx\n\tjl .LM\0");
                o.put_int(n);
                o.put_str(g"e\n\0");
                if (usea)
                {
                    o.put_str(g"\tmovq %rsi, %r10\n\tsubq %rdi, %r10\n\tjns .LM\0");
                    o.put_int(n);
                    o.put_str(g"a\n\tcmpq $-32, %r10\n\tjg .LM\0");
                    o.put_int(n);
                    o.put_str(g"e\n.LM\0");
                    o.put_int(n);
                    o.put_str(g"a:\n\0");
                };
                if (useb)
                {
                    o.put_str(g"\tmovq %rdx, %r10\n\tsubq %rdi, %r10\n\tjns .LM\0");
                    o.put_int(n);
                    o.put_str(g"b\n\tcmpq $-32, %r10\n\tjg .LM\0");
                    o.put_int(n);
                    o.put_str(g"e\n.LM\0");
                    o.put_int(n);
                    o.put_str(g"b:\n\0");
                };
                if (dbl) { o.put_str(g"\tvmovq %r8, %xmm4\n\tvbroadcastsd %xmm4, %ymm4\n\tvmovq %r9, %xmm5\n\tvbroadcastsd %xmm5, %ymm5\n\tmovq %rcx, %r10\n\tshrq $2, %r10\n\0"); }
                else { o.put_str(g"\tvmovd %r8d, %xmm4\n\tvbroadcastss %xmm4, %ymm4\n\tvmovd %r9d, %xmm5\n\tvbroadcastss %xmm5, %ymm5\n\tmovq %rcx, %r10\n\tshrq $3, %r10\n\0"); };
                o.put_str(g"\txorl %r11d, %r11d\n.LM\0");
                o.put_int(n);
                o.put_str(g"l:\n\0");
                sp = 0;
                i = 0;
                while (i < 14)
                {
                    op = (int)((prog >> (i * 4)) `& (i64)15);
                    if (op == 0) { break; };
                    i++;
                    if (op <= 3)
                    {
                        o.put_str(g"\tvmovups (%\0");
                        if (op == 1) { o.put_str(g"rsi\0"); };
                        if (op == 2) { o.put_str(g"rdx\0"); };
                        if (op == 3) { o.put_str(g"rdi\0"); };
                        o.put_str(g",%r11), %ymm\0");
                        o.put_int(sp);
                        o.put(10);
                        sp++;
                        continue;
                    };
                    if (op <= 5)
                    {
                        o.put_str(g"\tvmovaps %ymm\0");
                        o.put_int(op);
                        o.put_str(g", %ymm\0");
                        o.put_int(sp);
                        o.put(10);
                        sp++;
                        continue;
                    };
                    if (op <= 8)
                    {
                        o.put_str(g"\tv\0");
                        if (op == 6) { o.put_str(g"add\0"); };
                        if (op == 7) { o.put_str(g"sub\0"); };
                        if (op == 8) { o.put_str(g"mul\0"); };
                        if (dbl) { o.put_str(g"pd %ymm\0"); } else { o.put_str(g"ps %ymm\0"); };
                        o.put_int(sp - 1);
                        o.put_str(g", %ymm\0");
                        o.put_int(sp - 2);
                        o.put_str(g", %ymm\0");
                        o.put_int(sp - 2);
                        o.put(10);
                        sp--;
                        continue;
                    };
                    o.put_str(g"\tv\0");
                    if (op == 9) { o.put_str(g"fmadd213\0"); };
                    if (op == 10) { o.put_str(g"fmsub213\0"); };
                    if (op == 11) { o.put_str(g"fnmadd213\0"); };
                    if (dbl) { o.put_str(g"pd %ymm\0"); } else { o.put_str(g"ps %ymm\0"); };
                    o.put_int(sp - 1);
                    o.put_str(g", %ymm\0");
                    o.put_int(sp - 2);
                    o.put_str(g", %ymm\0");
                    o.put_int(sp - 3);
                    o.put(10);
                    sp = sp - 2;
                };
                o.put_str(g"\tvmovups %ymm0, (%rdi,%r11)\n\taddq $32, %r11\n\tdecq %r10\n\tjne .LM\0");
                o.put_int(n);
                o.put_str(g"l\n\tmovq %rcx, %rax\n\tandq $-\0");
                o.put_int(lanes);
                o.put_str(g", %rax\n.LM\0");
                o.put_int(n);
                o.put_str(g"e:\n\tvzeroupper\n\0");
                ->;
            };

            e_strlen(Buf* o, MI* m) -> void
            {
                int pa = this.s_phys(m.o0.r);
                int pd = this.s_phys(m.o1.r);
                int n;
                this.lab++;
                n = this.lab;
                if ((this.feat `& XF_AVX2) != 0)
                {
                    // 32 byte blocks: aligned blocks never cross a page. Uses rax rcx rdx xmm0 and xmm15.
                    o.put_str(g"\tmovq \0");
                    this.e_reg(o, pa, 8);
                    o.put_str(g", %rax\n\tmovl %eax, %ecx\n\tmovq %rax, %rdx\n\tandq $-32, %rdx\n\tvpxor %xmm15, %xmm15, %xmm15\n\tvpcmpeqb (%rdx), %ymm15, %ymm0\n\tvpmovmskb %ymm0, \0");
                    this.e_reg(o, pd, 4);
                    o.put_str(g"\n\tshrl %cl, \0");
                    this.e_reg(o, pd, 4);
                    o.put_str(g"\n\ttestl \0");
                    this.e_reg(o, pd, 4);
                    o.put_str(g", \0");
                    this.e_reg(o, pd, 4);
                    o.put_str(g"\n\tjne .LS\0");
                    o.put_int(n);
                    o.put_str(g"f\n.LS\0");
                    o.put_int(n);
                    o.put_str(g"l:\n\taddq $32, %rdx\n\tvpcmpeqb (%rdx), %ymm15, %ymm0\n\tvpmovmskb %ymm0, \0");
                    this.e_reg(o, pd, 4);
                    o.put_str(g"\n\ttestl \0");
                    this.e_reg(o, pd, 4);
                    o.put_str(g", \0");
                    this.e_reg(o, pd, 4);
                    o.put_str(g"\n\tje .LS\0");
                    o.put_int(n);
                    o.put_str(g"l\n\t\0");
                    if ((this.feat `& XF_BMI1) != 0) { o.put_str(g"tzcntl \0"); } else { o.put_str(g"bsfl \0"); };
                    this.e_reg(o, pd, 4);
                    o.put_str(g", \0");
                    this.e_reg(o, pd, 4);
                    o.put_str(g"\n\taddq %rdx, \0");
                    this.e_reg(o, pd, 8);
                    o.put_str(g"\n\tsubq %rax, \0");
                    this.e_reg(o, pd, 8);
                    o.put_str(g"\n\tjmp .LS\0");
                    o.put_int(n);
                    o.put_str(g"d\n.LS\0");
                    o.put_int(n);
                    o.put_str(g"f:\n\t\0");
                    if ((this.feat `& XF_BMI1) != 0) { o.put_str(g"tzcntl \0"); } else { o.put_str(g"bsfl \0"); };
                    this.e_reg(o, pd, 4);
                    o.put_str(g", \0");
                    this.e_reg(o, pd, 4);
                    o.put_str(g"\n.LS\0");
                    o.put_int(n);
                    o.put_str(g"d:\n\tvzeroupper\n\0");
                    ->;
                };
                o.put_str(g"\tmovq \0");
                this.e_reg(o, pa, 8);
                o.put_str(g", %rax\n\tmovl %eax, %ecx\n\tmovq %rax, %rdx\n\tandq $-16, %rdx\n\tandl $15, %ecx\n\tpxor %xmm0, %xmm0\n\tpcmpeqb (%rdx), %xmm0\n\tpmovmskb %xmm0, \0");
                this.e_reg(o, pd, 4);
                o.put_str(g"\n\tshrl %cl, \0");
                this.e_reg(o, pd, 4);
                o.put_str(g"\n\ttestl \0");
                this.e_reg(o, pd, 4);
                o.put_str(g", \0");
                this.e_reg(o, pd, 4);
                o.put_str(g"\n\tjne .LS\0");
                o.put_int(n);
                o.put_str(g"f\n.LS\0");
                o.put_int(n);
                o.put_str(g"l:\n\taddq $16, %rdx\n\tpxor %xmm0, %xmm0\n\tpcmpeqb (%rdx), %xmm0\n\tpmovmskb %xmm0, \0");
                this.e_reg(o, pd, 4);
                o.put_str(g"\n\ttestl \0");
                this.e_reg(o, pd, 4);
                o.put_str(g", \0");
                this.e_reg(o, pd, 4);
                o.put_str(g"\n\tje .LS\0");
                o.put_int(n);
                o.put_str(g"l\n\t\0");
                if ((this.feat `& XF_BMI1) != 0) { o.put_str(g"tzcntl \0"); } else { o.put_str(g"bsfl \0"); };
                this.e_reg(o, pd, 4);
                o.put_str(g", \0");
                this.e_reg(o, pd, 4);
                o.put_str(g"\n\taddq %rdx, \0");
                this.e_reg(o, pd, 8);
                o.put_str(g"\n\tsubq %rax, \0");
                this.e_reg(o, pd, 8);
                o.put_str(g"\n\tjmp .LS\0");
                o.put_int(n);
                o.put_str(g"d\n.LS\0");
                o.put_int(n);
                o.put_str(g"f:\n\t\0");
                if ((this.feat `& XF_BMI1) != 0) { o.put_str(g"tzcntl \0"); } else { o.put_str(g"bsfl \0"); };
                this.e_reg(o, pd, 4);
                o.put_str(g", \0");
                this.e_reg(o, pd, 4);
                o.put_str(g"\n.LS\0");
                o.put_int(n);
                o.put_str(g"d:\n\0");
                ->;
            };

            e_brev(Buf* o, MI* m) -> void
            {
                int sz = m.sz;
                int pa = this.s_phys(m.o0.r);
                int pd = this.s_phys(m.o1.r);
                int rs = sz;
                int rd = 0;
                i64 mk;
                if (rs < 4) { rs = 4; };
                if ((this.feat `& XF_GFNI) != 0)
                {
                    o.put_str(g"\tmovq \0");
                    this.e_reg(o, pa, 8);
                    o.put_str(g", %xmm15\n\tmovabsq $0x8040201008040201, %r10\n\tmovq %r10, %xmm14\n\tgf2p8affineqb $0, %xmm14, %xmm15\n\tmovq %xmm15, \0");
                    this.e_reg(o, pd, 8);
                    o.put(10);
                }
                else
                {
                    if (pa != pd)
                    {
                        o.put_str(g"\tmov\0");
                        this.e_sfx(o, rs);
                        o.put(32);
                        this.e_reg(o, pa, rs);
                        o.put_str(g", \0");
                        this.e_reg(o, pd, rs);
                        o.put(10);
                    };
                    rd = 1;
                };
                if (sz == 2)
                {
                    o.put_str(g"\trolw $8, \0");
                    this.e_reg(o, pd, 2);
                    o.put(10);
                };
                if (sz == 4 | sz == 8)
                {
                    o.put_str(g"\tbswap\0");
                    if (sz == 4) { o.put(108); } else { o.put(113); };
                    o.put(32);
                    this.e_reg(o, pd, sz);
                    o.put(10);
                };
                if (rd == 0) { ->; };
                // swap the halves of every byte, then pairs, then bits
                this.e_brev_round(o, pd, rs, 4, (i64)0x0F0F0F0F0F0F0F0F);
                this.e_brev_round(o, pd, rs, 2, (i64)0x3333333333333333);
                this.e_brev_round(o, pd, rs, 1, (i64)0x5555555555555555);
                ->;
            };

            // d = ((d >> s) & mask) | ((d & mask) << s), through r10 and r11
            e_brev_round(Buf* o, int pd, int rs, int s, i64 mk) -> void
            {
                if (rs == 8)
                {
                    o.put_str(g"\tmovabsq $\0");
                    put_i64(o, mk);
                    o.put_str(g", %r11\n\0");
                }
                else
                {
                    o.put_str(g"\tmovl $\0");
                    put_i64(o, mk `& (i64)4294967295);
                    o.put_str(g", %r11d\n\0");
                };
                o.put_str(g"\tmov\0");
                this.e_sfx(o, rs);
                o.put(32);
                this.e_reg(o, pd, rs);
                o.put_str(g", \0");
                this.e_reg(o, 10, rs);
                o.put(10);
                o.put_str(g"\tshr\0");
                this.e_sfx(o, rs);
                o.put_str(g" $\0");
                put_i64(o, (i64)s);
                o.put_str(g", \0");
                this.e_reg(o, 10, rs);
                o.put(10);
                o.put_str(g"\tand\0");
                this.e_sfx(o, rs);
                o.put(32);
                this.e_reg(o, 11, rs);
                o.put_str(g", \0");
                this.e_reg(o, 10, rs);
                o.put(10);
                o.put_str(g"\tand\0");
                this.e_sfx(o, rs);
                o.put(32);
                this.e_reg(o, 11, rs);
                o.put_str(g", \0");
                this.e_reg(o, pd, rs);
                o.put(10);
                o.put_str(g"\tshl\0");
                this.e_sfx(o, rs);
                o.put_str(g" $\0");
                put_i64(o, (i64)s);
                o.put_str(g", \0");
                this.e_reg(o, pd, rs);
                o.put(10);
                o.put_str(g"\tor\0");
                this.e_sfx(o, rs);
                o.put(32);
                this.e_reg(o, 10, rs);
                o.put_str(g", \0");
                this.e_reg(o, pd, rs);
                o.put(10);
                ->;
            };

            e_alu(Buf* o, MI* m) -> void
            {
                int sz = m.sz;
                int k = m.cc;
                MO* a = m.o0;
                MO* b = m.o1;
                MO* d = m.o2;
                int pa = this.s_phys(a.r);
                int pd = this.s_phys(d.r);
                int pb = 0 - 1;
                bool comm = k == A_ADD | k == A_AND | k == A_OR | k == A_XOR | k == A_IMUL;
                byte* mn;
                int nn;
                if (m.tgt > 100)
                {
                    pb = this.s_phys(b.r);
                    // d = (a << n) | (b >> (w - n)): shld on a copy of a, or shrd on a copy of b when d is b
                    nn = m.tgt - 100;
                    if (pa != pd & pb == pd)
                    {
                        o.put(9);
                        if (sz == 4) { o.put_str(g"shrdl $\0"); } else { o.put_str(g"shrdq $\0"); };
                        put_i64(o, (i64)(8 * sz - nn));
                        o.put_str(g", \0");
                        this.e_op(o, a, sz);
                        o.put_str(g", \0");
                        this.e_op(o, d, sz);
                        o.put(10);
                        ->;
                    };
                    if (pa != pd) { this.e_two(o, g"mov\0", sz, a, d, sz, sz); };
                    o.put(9);
                    if (sz == 4) { o.put_str(g"shldl $\0"); } else { o.put_str(g"shldq $\0"); };
                    put_i64(o, (i64)nn);
                    o.put_str(g", \0");
                    this.e_op(o, b, sz);
                    o.put_str(g", \0");
                    this.e_op(o, d, sz);
                    o.put(10);
                    ->;
                };
                if (m.tgt >= 93 & m.tgt <= 96)
                {
                    // d = a plus or minus the carry flag, for a compare that was just made: the mov keeps the flags
                    if (pa != pd) { this.e_two(o, g"mov\0", sz, a, d, sz, sz); };
                    o.put(9);
                    if (m.tgt == 93 | m.tgt == 96) { o.put_str(g"adc\0"); } else { o.put_str(g"sbb\0"); };
                    this.e_sfx(o, sz);
                    o.put_str(g" $\0");
                    if (m.tgt == 93 | m.tgt == 94) { o.put_str(g"0, \0"); } else { o.put_str(g"-1, \0"); };
                    this.e_op(o, d, sz);
                    o.put(10);
                    ->;
                };
                if (m.tgt >= 90 & m.tgt <= 92)
                {
                    // d = a with the bit numbered by b set, cleared or flipped
                    pb = this.s_phys(b.r);
                    if (pa != pd & pb == pd)
                    {
                        this.e_two(o, g"mov\0", sz, a, this.s_mo_r(10, sz), sz, sz);
                        o.put(9);
                        if (m.tgt == 90) { o.put_str(g"bts\0"); };
                        if (m.tgt == 91) { o.put_str(g"btr\0"); };
                        if (m.tgt == 92) { o.put_str(g"btc\0"); };
                        this.e_sfx(o, sz);
                        o.put(32);
                        this.e_op(o, b, sz);
                        o.put_str(g", \0");
                        this.e_reg(o, 10, sz);
                        o.put(10);
                        o.put_str(g"\tmov\0");
                        this.e_sfx(o, sz);
                        o.put(32);
                        this.e_reg(o, 10, sz);
                        o.put_str(g", \0");
                        this.e_op(o, d, sz);
                        o.put(10);
                        ->;
                    };
                    if (pa != pd) { this.e_two(o, g"mov\0", sz, a, d, sz, sz); };
                    o.put(9);
                    if (m.tgt == 90) { o.put_str(g"bts\0"); };
                    if (m.tgt == 91) { o.put_str(g"btr\0"); };
                    if (m.tgt == 92) { o.put_str(g"btc\0"); };
                    this.e_sfx(o, sz);
                    o.put(32);
                    this.e_op(o, b, sz);
                    o.put_str(g", \0");
                    this.e_op(o, d, sz);
                    o.put(10);
                    ->;
                };
                if (m.tgt == 78 | m.tgt == 79)
                {
                    // andn: d = ~a & b, bzhi: d = a with the bits from the count in b up cleared
                    o.put(9);
                    if (m.tgt == 78) { o.put_str(g"andn \0"); } else { o.put_str(g"bzhi \0"); };
                    this.e_op(o, b, sz);
                    o.put_str(g", \0");
                    this.e_op(o, a, sz);
                    o.put_str(g", \0");
                    this.e_op(o, d, sz);
                    o.put(10);
                    ->;
                };
                if (b.k == MK_REG) { pb = this.s_phys(b.r); };
                if (k == A_ADD) { mn = g"add\0"; };
                if (k == A_SUB) { mn = g"sub\0"; };
                if (k == A_AND) { mn = g"and\0"; };
                if (k == A_OR) { mn = g"or\0"; };
                if (k == A_XOR) { mn = g"xor\0"; };
                if (k == A_IMUL) { mn = g"imul\0"; };
                if (k == A_IMUL & b.k == MK_IMM)
                {
                    o.put(9);
                    o.put_str(g"imul\0");
                    this.e_sfx(o, sz);
                    o.put(32);
                    this.e_op(o, b, sz);
                    o.put_str(g", \0");
                    this.e_op(o, a, sz);
                    o.put_str(g", \0");
                    this.e_op(o, d, sz);
                    o.put(10);
                    ->;
                };
                if (pa == pd)
                {
                    if ((k == A_ADD | k == A_SUB) & b.k == MK_IMM)
                    {
                        if (b.imm == (i64)1 | b.imm == (i64)0 - (i64)1)
                        {
                            o.put(9);
                            if ((k == A_ADD) == (b.imm == (i64)1)) { o.put_str(g"inc\0"); } else { o.put_str(g"dec\0"); };
                            this.e_sfx(o, sz);
                            o.put(32);
                            this.e_op(o, d, sz);
                            o.put(10);
                            ->;
                        };
                    };
                    this.e_two(o, mn, sz, b, d, sz, sz);
                    ->;
                };
                if (b.k == MK_REG & pb == pd)
                {
                    if (comm)
                    {
                        this.e_two(o, mn, sz, a, d, sz, sz);
                        ->;
                    };
                    // d = a - d
                    o.put(9);
                    o.put_str(g"neg\0");
                    this.e_sfx(o, sz);
                    o.put(32);
                    this.e_op(o, d, sz);
                    o.put(10);
                    this.e_two(o, g"add\0", sz, a, d, sz, sz);
                    ->;
                };
                if (k == A_ADD & b.k == MK_REG)
                {
                    o.put(9);
                    o.put_str(g"lea\0");
                    this.e_sfx(o, sz);
                    o.put_str(g" (\0");
                    this.e_reg(o, pa, 8);
                    o.put(44);
                    this.e_reg(o, pb, 8);
                    o.put_str(g"), \0");
                    this.e_op(o, d, sz);
                    o.put(10);
                    ->;
                };
                if ((k == A_ADD | k == A_SUB) & b.k == MK_IMM)
                {
                    o.put(9);
                    o.put_str(g"lea\0");
                    this.e_sfx(o, sz);
                    o.put(32);
                    if (k == A_ADD) { put_i64(o, b.imm); } else { put_i64(o, (i64)0 - b.imm); };
                    o.put(40);
                    this.e_reg(o, pa, 8);
                    o.put_str(g"), \0");
                    this.e_op(o, d, sz);
                    o.put(10);
                    ->;
                };
                if (b.k == MK_MEM)
                {
                    if (this.s_phys(b.r) == pd | (b.r2 >= 0 & this.s_phys(b.r2) == pd))
                    {
                        // the destination holds part of the address: work in the scratch register
                        this.e_two(o, g"mov\0", sz, a, this.s_mo_r(10, sz), sz, sz);
                        this.e_two(o, mn, sz, b, this.s_mo_r(10, sz), sz, sz);
                        this.e_two(o, g"mov\0", sz, this.s_mo_r(10, sz), d, sz, sz);
                        ->;
                    };
                };
                this.e_two(o, g"mov\0", sz, a, d, sz, sz);
                this.e_two(o, mn, sz, b, d, sz, sz);
                ->;
            };


            // A jump back to a loop test that is only a compare and a conditional jump repeats the test in place:
            // the loop then needs one jump per iteration, not two. Returns true when the test was written.
            e_rotate(Buf* o, GB* gb, MI* m, int nid) -> bool
            {
                GF* g = this.sf;
                GB* h = (GB*)0;
                MI* c;
                MI* j;
                MI* k;
                int i = gb.rpo - 1;
                int lim = gb.rpo - 64;
                int tid, fid;
                if (lim < 0) { lim = 0; };
                while (i >= lim)
                {
                    if (g.rpo[i].id == (int)m.o0.imm) { h = g.rpo[i]; break; };
                    i--;
                };
                if (h == (GB*)0) { -> false; };
                if (h.mi.len != 3) { -> false; };
                c = (MI*)h.mi.items[0];
                j = (MI*)h.mi.items[1];
                k = (MI*)h.mi.items[2];
                if (c.op != M_CMP & c.op != M_TEST) { -> false; };
                if (j.op != M_JCC | k.op != M_JMP) { -> false; };
                // k.cc == 99 only records that the header's own emission folded this jump into its inverted branch
                tid = (int)j.o0.imm;
                fid = (int)k.o0.imm;
                // the instruction in front of the repeated test is the last one of this block
                this.rprev = (MI*)0;
                i = gb.mi.len - 1;
                while (i >= 0)
                {
                    if ((MI*)gb.mi.items[i] == m) { break; };
                    i--;
                };
                i--;
                while (i >= 0)
                {
                    k = (MI*)gb.mi.items[i];
                    if (this.s_noop_mi(k)) { i--; continue; };
                    this.rprev = k;
                    break;
                };
                this.e_mi(o, h, 0, gb);
                this.rprev = (MI*)0;
                if (tid == nid)
                {
                    o.put(9);
                    o.put(106);
                    this.e_cc(o, this.s_invcc(j.cc));
                    o.put_str(g" .LB\0");
                    o.put_int(fid);
                    o.put(10);
                    -> true;
                };
                o.put(9);
                o.put(106);
                this.e_cc(o, j.cc);
                o.put_str(g" .LB\0");
                o.put_int(tid);
                o.put(10);
                if (fid != nid)
                {
                    o.put_str(g"\tjmp .LB\0");
                    o.put_int(fid);
                    o.put(10);
                };
                -> true;
            };


            // Orders the blocks for emission after allocation. The block that follows another is the one it most
            // likely goes to: a block of the same or an inner loop before a loop exit, anything before a block that
            // ends in ud2. A block no chain reaches starts a new chain in its old position.
            s_blocksort() -> void
            {
                GF* g = this.sf;
                int n = g.nb;
                int i, j, k, best, bs, sc;
                GB* cur;
                GB* b;
                GB* s;
                MI* m;
                int* placed = this.s_iz(n + 1);
                int* cold = this.s_iz(n + 1);
                GB** outv = (GB**)fmalloc((u64)(8 * (n + 1)));
                int cnt = 0;
                // blocks that end in ud2
                i = 0;
                while (i < n)
                {
                    b = g.rpo[i];
                    j = 0;
                    while (j < b.mi.len)
                    {
                        m = (MI*)b.mi.items[j];
                        if (m.op == M_UD2) { cold[i] = 1; };
                        j++;
                    };
                    i++;
                };
                // the entry block stays first; chains grow from the last placed block
                cur = g.rpo[0];
                while (cur != (GB*)0)
                {
                    placed[cur.rpo] = 1;
                    outv[cnt] = cur;
                    cnt++;
                    best = 0 - 1;
                    bs = 0 - 1000000000;
                    k = 0;
                    while (k < cur.succs.len)
                    {
                        s = (GB*)cur.succs.items[k];
                        if (placed[s.rpo] == 0 & cold[s.rpo] == 0)
                        {
                            sc = s.lw;
                            if (best < 0 | sc > bs | (sc == bs & s.rpo < best))
                            {
                                best = s.rpo;
                                bs = sc;
                            };
                        };
                        k++;
                    };
                    if (best >= 0)
                    {
                        cur = g.rpo[best];
                    }
                    else
                    {
                        // a new chain starts at the first block left, in the old order, cold blocks last
                        cur = (GB*)0;
                        i = 0;
                        while (i < n)
                        {
                            if (placed[i] == 0 & cold[i] == 0) { cur = g.rpo[i]; break; };
                            i++;
                        };
                        if (cur == (GB*)0)
                        {
                            i = 0;
                            while (i < n)
                            {
                                if (placed[i] == 0) { cur = g.rpo[i]; break; };
                                i++;
                            };
                        };
                    };
                };
                i = 0;
                while (i < n)
                {
                    g.rpo[i] = outv[i];
                    i++;
                };
                i = 0;
                while (i < n)
                {
                    g.rpo[i].rpo = i;
                    i++;
                };
                ffree((byte*)outv);
                this.s_ifree(placed);
                this.s_ifree(cold);
                ->;
            };

            // Jumps with the fall through to the next block left out
            e_jump(Buf* o, GB* gb, int idx, GB* next) -> void
            {
                MI* m = (MI*)gb.mi.items[idx];
                MI* m2;
                int nid = 0 - 1;
                int cc;
                if (next != (GB*)0) { nid = next.id; };
                if (m.op == M_JMP)
                {
                    if (m.cc == 99) { ->; };
                    if ((int)m.o0.imm == nid) { ->; };
                    if (SSA_OPT_ROTATE == 1)
                    {
                        if (this.e_rotate(o, gb, m, nid)) { ->; };
                    };
                    o.put(9);
                    o.put_str(g"jmp .LB\0");
                    o.put_int((int)m.o0.imm);
                    o.put(10);
                    ->;
                };
                // a conditional jump followed by the jump for the other case
                cc = m.cc;
                if (idx + 1 < gb.mi.len)
                {
                    m2 = (MI*)gb.mi.items[idx + 1];
                    if (m2.op == M_JMP)
                    {
                        if ((int)m.o0.imm == nid)
                        {
                            // the taken case is next: jump on the opposite condition to the other target
                            o.put(9);
                            o.put(106);
                            this.e_cc(o, this.s_invcc(cc));
                            o.put_str(g" .LB\0");
                            o.put_int((int)m2.o0.imm);
                            o.put(10);
                            m2.cc = 99;
                            ->;
                        };
                    };
                };
                o.put(9);
                o.put(106);
                this.e_cc(o, cc);
                o.put_str(g" .LB\0");
                o.put_int((int)m.o0.imm);
                o.put(10);
                ->;
            };

            // Bounds check and indirect jump through the table of the switch, the table follows the function
            e_jtab(Buf* o, MI* m) -> void
            {
                int id;
                i64 lo = m.o1.imm;
                this.lab++;
                id = this.lab;
                bool whole = m.cc == 256 & m.sz == 1 & lo == (i64)0;
                if (!whole)
                {
                    o.put_str(g"\tmovq \0");
                    this.e_op(o, m.o0, 8);
                    o.put_str(g", %r11\n\0");
                };
                if (lo != (i64)0)
                {
                    if (lo > (i64)0 & lo <= (i64)2147483647)
                    {
                        o.put_str(g"\tsubq $\0");
                        put_i64(o, lo);
                        o.put_str(g", %r11\n\0");
                    }
                    else
                    {
                        o.put_str(g"\tmovabsq $\0");
                        put_i64(o, lo);
                        o.put_str(g", %r10\n\tsubq %r10, %r11\n\0");
                    };
                };
                // a table over every value of a byte cannot be left, so it needs no range check
                if (!whole)
                {
                    o.put_str(g"\tcmpq $\0");
                    o.put_int(m.cc - 1);
                    o.put_str(g", %r11\n\tja .LB\0");
                    o.put_int((int)m.o2.imm);
                    o.put(10);
                };
                o.put_str(g"\tleaq .LJT\0");
                o.put_int(id);
                if (whole)
                {
                    o.put_str(g"(%rip), %r10\n\tjmpq *(%r10,\0");
                    this.e_op(o, m.o0, 8);
                    o.put_str(g",8)\n\0");
                }
                else { o.put_str(g"(%rip), %r10\n\tjmpq *(%r10,%r11,8)\n\0"); };
                m.tgt = id;
                pv_push(this.jts, (void*)m);
                ->;
            };

            // Dispatch on byte level of a sparse switch: the byte of the value selects an entry of table nid
            e_rdisp(Buf* o, int reg, int shift, int nid) -> void
            {
                o.put_str(g"\tmovq \0");
                this.e_reg(o, reg, 8);
                o.put_str(g", %r11\n\0");
                if (shift > 0)
                {
                    o.put_str(g"\tshrq $\0");
                    o.put_int(shift);
                    o.put_str(g", %r11\n\0");
                };
                o.put_str(g"\tmovzbl %r11b, %r11d\n\tleaq .LJT\0");
                o.put_int(nid);
                o.put_str(g"(%rip), %r10\n\tjmpq *(%r10,%r11,8)\n\0");
                ->;
            };

            // Builds the table of one level for the cases listed in sel, returns its number. The table and the
            // code that reaches the next level are written to jb.
            e_rnode(MI* m, int reg, int* sel, int nsel, int level, int w) -> int
            {
                int* vals = (int*)m.text;
                int* ids = ((int*)m.text) + 2 * m.cc;
                int* ent = this.s_iz(256);
                int* sub = this.s_iz(nsel + 1);
                int nid, b, i, ns, shift, c;
                u64 v;
                Buf* jb = @this.jb;
                this.lab++;
                nid = this.lab;
                shift = 8 * (w - 1 - level);
                b = 0;
                while (b < 256)
                {
                    ns = 0;
                    i = 0;
                    while (i < nsel)
                    {
                        v = ((u64*)vals)[sel[i]];
                        if ((int)((v >> (u64)shift) `& (u64)255) == b) { sub[ns] = sel[i]; ns++; };
                        i++;
                    };
                    ent[b] = (int)m.o2.imm * 2;
                    if (ns > 0)
                    {
                        if (level == w - 1) { ent[b] = ids[sub[0]] * 2; }
                        else
                        {
                            c = this.e_rnode(m, reg, sub, ns, level + 1, w);
                            ent[b] = c * 2 + 1;
                        };
                    };
                    b++;
                };
                if (level > 0)
                {
                    jb.put_str(g".LT\0");
                    jb.put_int(nid);
                    jb.put_str(g":\n\0");
                    this.e_rdisp(jb, reg, shift, nid);
                };
                jb.put_str(g"\t.section .rodata\n\t.p2align 3\n.LJT\0");
                jb.put_int(nid);
                jb.put_str(g":\n\0");
                b = 0;
                while (b < 256)
                {
                    if ((ent[b] `& 1) != 0) { jb.put_str(g"\t.quad .LT\0"); } else { jb.put_str(g"\t.quad .LB\0"); };
                    jb.put_int(ent[b] >> 1);
                    jb.put(10);
                    b++;
                };
                jb.put_str(g"\t.text\n\0");
                this.s_ifree(ent);
                this.s_ifree(sub);
                -> nid;
            };

            // Sparse switch: levels of 256 entry tables, one byte of the value per level, most significant first
            e_radix(Buf* o, MI* m) -> void
            {
                int w = m.sz;
                int* sel = this.s_iz(m.cc + 1);
                int i, nid;
                int reg = this.s_phys(m.o0.r);
                if (w < 4) { w = 4; };
                i = 0;
                while (i < m.cc) { sel[i] = i; i++; };
                nid = this.e_rnode(m, reg, sel, m.cc, 0, w);
                this.e_rdisp(o, reg, 8 * (w - 1), nid);
                this.s_ifree(sel);
                ->;
            };

            // The tables of the function just written
            e_tables(Buf* o) -> void
            {
                int i, k;
                MI* m;
                if (this.jb.len > 0)
                {
                    o.put_n(this.jb.mem, this.jb.len);
                    this.jb.len = 0;
                };
                if (this.jts.len == 0) { ->; };
                o.put_str(g"\t.section .rodata\n\t.p2align 3\n\0");
                i = 0;
                while (i < this.jts.len)
                {
                    m = (MI*)this.jts.items[i];
                    o.put_str(g".LJT\0");
                    o.put_int(m.tgt);
                    o.put_str(g":\n\0");
                    k = 0;
                    while (k < m.cc)
                    {
                        o.put_str(g"\t.quad .LB\0");
                        o.put_int(((int*)m.text)[k]);
                        o.put(10);
                        k++;
                    };
                    i++;
                };
                o.put_str(g"\t.text\n\0");
                this.jts.len = 0;
                ->;
            };

            // Restores the callee saved registers and returns
            e_epilogue(Buf* o) -> void
            {
                this.e_epilogue2(o, false);
                ->;
            };

            // The restore of the frame; the final ret is left out for a tail jump
            e_epilogue2(Buf* o, bool tail) -> void
            {
                GF* g = this.sf;
                int k = 0;
                int n = 0;
                if (((XGF*)g.tg).sw & !this.efr)
                {
                    // this path never set the frame up
                    if (!tail) { this.e_ln(o, g"ret\0"); };
                    ->;
                };
                if (this.s_nfpn())
                {
                    // give back the rest of the frame, then pop the registers in the reverse order
                    n = 0;
                    k = 0;
                    while (k < 16) { if ((((XGF*)g.tg).saved `& (1 << k)) != 0) { n++; }; k++; };
                    if (((XGF*)g.tg).frame - 8 * n > 0)
                    {
                        o.put_str(g"\taddq $\0");
                        o.put_int(((XGF*)g.tg).frame - 8 * n);
                        o.put_str(g", %rsp\n\0");
                    };
                    k = 15;
                    while (k >= 0)
                    {
                        if ((((XGF*)g.tg).saved `& (1 << k)) != 0)
                        {
                            o.put_str(g"\tpopq \0");
                            this.e_reg(o, k, 8);
                            o.put(10);
                        };
                        k--;
                    };
                    if (!tail) { this.e_ln(o, g"ret\0"); };
                    ->;
                };
                while (k < 16)
                {
                    if ((((XGF*)g.tg).saved `& (1 << k)) != 0)
                    {
                        n++;
                        o.put(9);
                        o.put_str(g"movq \0");
                        this.e_fpm(o, (i64)(0 - 8 * n));
                        o.put_str(g", \0");
                        this.e_reg(o, k, 8);
                        o.put(10);
                    };
                    k++;
                };
                if (((XGF*)g.tg).nofp)
                {
                    if (((XGF*)g.tg).frame > 0)
                    {
                        o.put_str(g"\taddq $\0");
                        o.put_int(((XGF*)g.tg).frame);
                        o.put_str(g", %rsp\n\0");
                    };
                }
                else { this.e_ln(o, g"leave\0"); };
                if (!tail) { this.e_ln(o, g"ret\0"); };
                ->;
            };

            // ==========================================================
            // parallel copies and the writer of a whole function.
            // ==========================================================

            // Location of register number r after allocation: a hardware register, or 100 + slot when spilled
            s_loc(int r) -> int
            {
                GF* g = this.sf;
                if (r < R_VBASE) { -> r; };
                if (g.vcol[r] >= 0) { -> g.vcol[r]; };
                -> 100 + g.vslot[r] - 1;
            };

            // Writes the memory operand at offset off from the frame pointer, from rsp when the function has none
            e_fpm(Buf* o, i64 off) -> void
            {
                if (((XGF*)this.sf.tg).nofp)
                {
                    put_i64(o, off + (i64)(((XGF*)this.sf.tg).frame - 8));
                    o.put_str(g"(%rsp)\0");
                    ->;
                };
                put_i64(o, off);
                o.put_str(g"(%rbp)\0");
                ->;
            };

            // True when no instruction of the function needs rbp as a frame: it makes no calls, has no dynamic
            // allocation, no inline asm, no variable argument handling and no x87 remainder (which uses rsp)
            s_nofp_ok(bool calls) -> bool
            {
                GF* g = this.sf;
                int i, j, op;
                GB* gb;
                MI* m;
                if (((XGF*)g.tg).dyn) { -> false; };
                if (((XGF*)g.tg).vafo != 0 | ((XGF*)g.tg).vagp != 0 | ((XGF*)g.tg).vafp != 0 | ((XGF*)g.tg).vastk != 0) { -> false; };
                if (this.a_win() & ((XGF*)g.tg).frame >= 4096) { -> false; };
                i = 0;
                while (i < g.nb)
                {
                    gb = g.rpo[i];
                    j = 0;
                    while (j < gb.mi.len)
                    {
                        m = (MI*)gb.mi.items[j];
                        op = m.op;
                        if (op == M_CALL & m.tgt == 77) { j++; continue; };
                        if (op == M_CALL & calls) { j++; continue; };
                        if (op == M_CALL | op == M_DALLOC | op == M_VASTART | op == M_VAARG | op == M_SAVEVA | op == M_FREM | op == M_TEXT | op == M_RETADDR) { -> false; };
                        if (op == M_ASM) { if (!this.s_asm_nostack(m.text)) { -> false; }; };
                        j++;
                    };
                    i++;
                };
                -> true;
            };

            // Text of the stack slot of location l
            e_slot(Buf* o, int l) -> void
            {
                XFO* fo = (XFO*)((XGF*)this.sf.tg).fobj.items[l - 100];
                this.e_fpm(o, (i64)fo.off);
                ->;
            };

            e_locop(Buf* o, int l) -> void
            {
                if (l >= 100) { this.e_slot(o, l); ->; };
                this.e_reg(o, l, 8);
                ->;
            };

            // Moves 8 bytes from location s to location d
            e_mvloc(Buf* o, int d, int s) -> void
            {
                if (d == s) { ->; };
                if (d >= 100 & s >= 100)
                {
                    o.put_str(g"\tmovq \0");
                    this.e_slot(o, s);
                    o.put_str(g", %r10\n\tmovq %r10, \0");
                    this.e_slot(o, d);
                    o.put(10);
                    ->;
                };
                if (d < 100 & s < 100 & d >= 16 & s >= 16)
                {
                    o.put_str(g"\tmovaps \0");
                    this.e_locop(o, s);
                    o.put_str(g", \0");
                    this.e_locop(o, d);
                    o.put(10);
                    ->;
                };
                if ((d >= 16 & d < 100) | (s >= 16 & s < 100))
                {
                    if (d >= 100 | s >= 100) { o.put_str(g"\tmovsd \0"); } else { o.put_str(g"\tmovq \0"); };
                    this.e_locop(o, s);
                    o.put_str(g", \0");
                    this.e_locop(o, d);
                    o.put(10);
                    ->;
                };
                o.put_str(g"\tmovq \0");
                this.e_locop(o, s);
                o.put_str(g", \0");
                this.e_locop(o, d);
                o.put(10);
                ->;
            };

            // Loads the constant v into location d
            e_ldconst(Buf* o, int d, IRValue* v, bool fl) -> void
            {
                int k;
                i64 c;
                byte* sy;
                int tr = d;
                if (d >= 100) { tr = 10; };
                if (v.fo > 0 & v.vr == 0)
                {
                    // the address of a frame object
                    o.put_str(g"\tleaq \0");
                    this.e_fpm(o, (i64)((XFO*)((XGF*)this.sf.tg).fobj.items[v.fo - 1]).off);
                    o.put_str(g", \0");
                    this.e_reg(o, tr, 8);
                    o.put(10);
                    if (d >= 100)
                    {
                        o.put_str(g"\tmovq %r10, \0");
                        this.e_slot(o, d);
                        o.put(10);
                    };
                    ->;
                };
                k = this.s_ck(v);
                c = this.scv;
                sy = this.scs;
                if (k == CK_FP)
                {
                    if (d >= 16 & d < 100 & c == (i64)0)
                    {
                        o.put_str(g"\txorps \0");
                        this.e_reg(o, d, 8);
                        o.put_str(g", \0");
                        this.e_reg(o, d, 8);
                        o.put(10);
                        ->;
                    };
                    o.put_str(g"\tmovabsq $\0");
                    put_i64(o, c);
                    o.put_str(g", %r10\n\0");
                    if (d >= 16 & d < 100)
                    {
                        o.put_str(g"\tmovq %r10, \0");
                        this.e_reg(o, d, 8);
                        o.put(10);
                    }
                    else
                    {
                        o.put_str(g"\tmovq %r10, \0");
                        this.e_slot(o, d);
                        o.put(10);
                    };
                    ->;
                };
                if (k == CK_SYM)
                {
                    o.put_str(g"\tleaq \0");
                    o.put_str(sy);
                    if (c > (i64)0) { o.put(43); put_i64(o, c); };
                    if (c < (i64)0) { put_i64(o, c); };
                    o.put_str(g"(%rip), \0");
                    this.e_reg(o, tr, 8);
                    o.put(10);
                }
                else
                {
                    if (k != CK_INT & k != CK_ZERO) { this.s_fail(g"phi constant\0"); ->; };
                    if (k == CK_ZERO) { c = (i64)0; };
                    if (d >= 100 & c >= (i64)-2147483648 & c <= (i64)2147483647 & SSA_OPT_SLOTIMM == 1)
                    {
                        // a constant for a spilled phi goes straight into its slot, no scratch register
                        o.put_str(g"\tmovq $\0");
                        put_i64(o, c);
                        o.put_str(g", \0");
                        this.e_slot(o, d);
                        o.put(10);
                        ->;
                    };
                    if (c == (i64)0 & !fl & SSA_OPT_ZIDIOM == 1)
                    {
                        // the zero idiom: no immediate to fetch, no execution unit
                        o.put_str(g"\txorl \0");
                        this.e_reg(o, tr, 4);
                        o.put_str(g", \0");
                        this.e_reg(o, tr, 4);
                        o.put(10);
                    }
                    elif (c >= (i64)0 & c <= (i64)4294967295)
                    {
                        o.put_str(g"\tmovl $\0");
                        put_i64(o, c);
                        o.put_str(g", \0");
                        this.e_reg(o, tr, 4);
                        o.put(10);
                    }
                    else
                    {
                        if (c >= (i64)-2147483648 & c < (i64)0)
                        {
                            o.put_str(g"\tmovq $\0");
                            put_i64(o, c);
                            o.put_str(g", \0");
                            this.e_reg(o, tr, 8);
                            o.put(10);
                        }
                        else
                        {
                            o.put_str(g"\tmovabsq $\0");
                            put_i64(o, c);
                            o.put_str(g", \0");
                            this.e_reg(o, tr, 8);
                            o.put(10);
                        };
                    };
                };
                if (d >= 100)
                {
                    o.put_str(g"\tmovq %r10, \0");
                    this.e_slot(o, d);
                    o.put(10);
                };
                ->;
            };

            // Parallel copy of the phi values of the edge: the moves are ordered so that no source is overwritten
            // before it is read, a cycle is broken through r11
            // True when the instruction prints nothing: a move of a register onto itself, or a phi copy whose
            // values already sit where the phis are
            s_noop_mi(MI* m) -> bool
            {
                GB* sg;
                GP* gp;
                IRValue* v;
                int i;
                if (m.op == M_MOV)
                {
                    if (m.o0.k != MK_REG | m.o1.k != MK_REG) { -> false; };
                    -> this.s_phys(m.o0.r) == this.s_phys(m.o1.r);
                };
                if (m.op == M_PCOPY)
                {
                    sg = (GB*)this.sf.bl.items[m.tgt];
                    i = 0;
                    while (i < sg.phis.len)
                    {
                        gp = (GP*)sg.phis.items[i];
                        v = this.s_res((IRValue*)gp.vals.items[m.cc]);
                        if (v.vr < R_VBASE) { -> false; };
                        if (this.s_loc(gp.dst) != this.s_loc(v.vr)) { -> false; };
                        i++;
                    };
                    -> true;
                };
                -> false;
            };

            e_pcopy(Buf* o, MI* m, bool fl) -> void
            {
                GB* sg = (GB*)this.sf.bl.items[m.tgt];
                int n = sg.phis.len;
                int* dl = this.s_iz(n + 1);
                int* sl = this.s_iz(n + 1);
                int* dn = this.s_iz(n + 1);
                PtrVec* cv = pv_new();
                GP* gp;
                IRValue* v;
                int i, j, left, prog, c;
                bool rd;
                i = 0;
                while (i < n)
                {
                    gp = (GP*)sg.phis.items[i];
                    v = this.s_res((IRValue*)gp.vals.items[m.cc]);
                    dl[i] = this.s_loc(gp.dst);
                    if (v.vr >= R_VBASE) { sl[i] = this.s_loc(v.vr); }
                    else { sl[i] = 0 - 1; };
                    pv_push(cv, (void*)v);
                    if (sl[i] == dl[i]) { dn[i] = 1; };
                    i++;
                };
                left = 0;
                i = 0;
                while (i < n)
                {
                    if (dn[i] == 0) { left++; };
                    i++;
                };
                while (left > 0)
                {
                    prog = 0;
                    i = 0;
                    while (i < n)
                    {
                        if (dn[i] == 0)
                        {
                            rd = false;
                            j = 0;
                            while (j < n)
                            {
                                if (j != i & dn[j] == 0 & sl[j] == dl[i]) { rd = true; };
                                j++;
                            };
                            if (!rd)
                            {
                                if (sl[i] >= 0) { this.e_mvloc(o, dl[i], sl[i]); }
                                else { this.e_ldconst(o, dl[i], (IRValue*)cv.items[i], fl); };
                                dn[i] = 1;
                                left--;
                                prog = 1;
                            };
                        };
                        i++;
                    };
                    if (prog == 0)
                    {
                        // only cycles are left: park one destination in r11 and redirect its readers
                        i = 0;
                        while (dn[i] != 0) { i++; };
                        c = dl[i];
                        this.e_mvloc(o, 11, c);
                        j = 0;
                        while (j < n)
                        {
                            if (dn[j] == 0 & sl[j] == c) { sl[j] = 11; };
                            j++;
                        };
                    };
                };
                pv_free(cv);
                this.s_ifree(dl);
                this.s_ifree(sl);
                this.s_ifree(dn);
                ->;
            };

            // ----------------------------------------------------------
            // Function writer
            // ----------------------------------------------------------

            // Directives and label that start the function f
            s_head(IRFunc* f, Buf* out) -> void
            {
                byte* nm = this.a_sym(f.self.text);
                bool islocal = false;
                bool weak = false;
                if (f.linkage != (byte*)0)
                {
                    if (this.a_seq(f.linkage, g"internal\0") | this.a_seq(f.linkage, g"private\0")) { islocal = true; };
                    if (this.a_pre(f.linkage, g"linkonce\0") | this.a_pre(f.linkage, g"weak\0")) { weak = true; };
                };
                out.put_str(g"\t.text\n\0");
                if (weak)
                {
                    out.put_str(g"\t.weak \0");
                    out.put_str(nm);
                    out.put(10);
                }
                else
                {
                    if (!islocal)
                    {
                        out.put_str(g"\t.globl \0");
                        out.put_str(nm);
                        out.put(10);
                    };
                };
                if (this.a_win())
                {
                    out.put_str(g"\t.def \0");
                    out.put_str(nm);
                    if (islocal) { out.put_str(g";\n\t.scl 3;\n\t.type 32;\n\t.endef\n\0"); }
                    else { out.put_str(g";\n\t.scl 2;\n\t.type 32;\n\t.endef\n\0"); };
                }
                else
                {
                    out.put_str(g"\t.type \0");
                    out.put_str(nm);
                    out.put_str(g",@function\n\0");
                };
                out.put_str(nm);
                out.put_str(g":\n\0");
                ->;
            };

            // A block that only jumps to another block is skipped by every branch that reaches it
            s_jthread() -> void
            {
                GF* g = this.sf;
                int nb = g.nb;
                int cap = 16;
                int i, j, h, t, st, cnt, n;
                GB* gb;
                MI* m;
                int* hk;
                int* hv;
                int* rk;
                bool found, jt, keep;
                while (cap < 2 * nb + 2) { cap = cap * 2; };
                hk = this.s_iz(cap);
                hv = this.s_iz(cap);
                cnt = 0;
                i = 0;
                while (i < nb)
                {
                    gb = g.rpo[i];
                    i++;
                    if (gb.mi.len != 1) { continue; };
                    m = (MI*)gb.mi.items[0];
                    if (m.op != M_JMP) { continue; };
                    if (m.o0 == (MO*)0) { continue; };
                    if (m.o0.k != MK_BLK) { continue; };
                    if ((int)m.o0.imm == gb.id) { continue; };
                    h = gb.id % cap;
                    while (hk[h] != 0) { h = (h + 1) % cap; };
                    hk[h] = gb.id + 1;
                    hv[h] = (int)m.o0.imm;
                    cnt++;
                };
                if (cnt > 0)
                {
                    i = 0;
                    while (i < nb)
                    {
                        gb = g.rpo[i];
                        i++;
                        j = 0;
                        while (j < gb.mi.len)
                        {
                            m = (MI*)gb.mi.items[j];
                            j++;
                            if (m.op != M_JMP & m.op != M_JCC) { continue; };
                            if (m.o0 == (MO*)0) { continue; };
                            if (m.o0.k != MK_BLK) { continue; };
                            t = (int)m.o0.imm;
                            st = 0;
                            while (st < 8)
                            {
                                h = t % cap;
                                found = false;
                                while (hk[h] != 0)
                                {
                                    if (hk[h] == t + 1) { found = true; break; };
                                    h = (h + 1) % cap;
                                };
                                if (!found) { break; };
                                t = hv[h];
                                st++;
                            };
                            m.o0.imm = (i64)t;
                        };
                    };
                };
                if (cnt > 0)
                {
                    // forwarders that no branch reaches any more are dropped, unless a jump table may name them
                    jt = false;
                    rk = this.s_iz(cap);
                    i = 0;
                    while (i < nb)
                    {
                        gb = g.rpo[i];
                        i++;
                        j = 0;
                        while (j < gb.mi.len)
                        {
                            m = (MI*)gb.mi.items[j];
                            j++;
                            if (m.op == M_JTAB | m.op == M_JTAB2)
                            {
                                // the default and every table entry are references too
                                this.s_jt_ref(rk, cap, (int)m.o2.imm);
                                n = 0;
                                while (n < m.cc)
                                {
                                    if (m.op == M_JTAB) { this.s_jt_ref(rk, cap, ((int*)m.text)[n]); }
                                    else { this.s_jt_ref(rk, cap, ((int*)m.text)[2 * m.cc + n]); };
                                    n++;
                                };
                                continue;
                            };
                            if (m.op != M_JMP & m.op != M_JCC) { continue; };
                            if (m.o0 == (MO*)0) { continue; };
                            if (m.o0.k != MK_BLK) { continue; };
                            this.s_jt_ref(rk, cap, (int)m.o0.imm);
                        };
                    };
                    if (true)
                    {
                        j = 1;
                        i = 1;
                        while (i < nb)
                        {
                            gb = g.rpo[i];
                            i++;
                            keep = true;
                            if (gb.mi.len == 1)
                            {
                                m = (MI*)gb.mi.items[0];
                                if (m.op == M_JMP)
                                {
                                    h = gb.id % cap;
                                    found = false;
                                    while (rk[h] != 0)
                                    {
                                        if (rk[h] == gb.id + 1) { found = true; break; };
                                        h = (h + 1) % cap;
                                    };
                                    if (!found) { keep = false; };
                                };
                            };
                            if (keep) { g.rpo[j] = gb; j++; };
                        };
                        g.nb = j;
                    };
                    this.s_ifree(rk);
                };
                this.s_ifree(hk);
                this.s_ifree(hv);
                ->;
            };


            // Stores of constant bytes to neighbouring addresses of one object become stores of 4, 2 and 1 bytes
            s_stmerge() -> void
            {
                GF* g = this.sf;
                int i, j, n, run, k, w, c;
                GB* gb;
                MI* m;
                MI* q;
                MO* a;
                u64 v;
                i64 sv;
                PtrVec* nv;
                i = 0;
                while (i < g.nb)
                {
                    gb = g.rpo[i];
                    i++;
                    nv = pv_new();
                    j = 0;
                    while (j < gb.mi.len)
                    {
                        m = (MI*)gb.mi.items[j];
                        run = 1;
                        if (this.s_stm_ok(m))
                        {
                            while (j + run < gb.mi.len)
                            {
                                q = (MI*)gb.mi.items[j + run];
                                if (!this.s_stm_ok(q)) { break; };
                                if (q.o1.r != m.o1.r | q.o1.fo != m.o1.fo | q.o1.sc != m.o1.sc | q.o1.r2 != m.o1.r2) { break; };
                                if (q.o1.imm != m.o1.imm + (i64)run) { break; };
                                run++;
                            };
                        };
                        if (run < 2)
                        {
                            pv_push(nv, (void*)m);
                            j++;
                            continue;
                        };
                        k = 0;
                        while (k < run)
                        {
                            w = 1;
                            if (run - k >= 4) { w = 4; } elif (run - k >= 2) { w = 2; };
                            q = (MI*)gb.mi.items[j + k];
                            if (w > 1)
                            {
                                v = (u64)0;
                                c = 0;
                                while (c < w)
                                {
                                    v = v | (((u64)((MI*)gb.mi.items[j + k + c]).o0.imm & (u64)255) << (u64)(8 * c));
                                    c++;
                                };
                                sv = (i64)v;
                                if (w == 4) { sv = (i64)(i32)(u32)v; };
                                if (w == 2) { sv = (i64)(i16)(u16)v; };
                                q.sz = w;
                                q.o0 = this.s_mo_i(sv);
                            };
                            pv_push(nv, (void*)q);
                            k = k + w;
                        };
                        j = j + run;
                    };
                    pv_free(gb.mi);
                    gb.mi = nv;
                };
                ->;
            };

            s_stm_ok(MI* m) -> bool
            {
                if (m.op != M_MOV | m.sz != 1) { -> false; };
                if (m.o0 == (MO*)0 | m.o1 == (MO*)0) { -> false; };
                if (m.o0.k != MK_IMM | m.o1.k != MK_MEM) { -> false; };
                if (m.o1.sym != (byte*)0 | m.o1.r2 >= 0) { -> false; };
                -> true;
            };

            // The blocks that block i continues to are put in sb and counted, -1 when its jumps are not understood
            s_sw_succ(GB* gb, int i, int n, int* hk, int* hv, int cap, int* sb) -> int
            {
                int c = 0;
                int j, t;
                bool term = false;
                MI* m;
                j = 0;
                while (j < gb.mi.len)
                {
                    m = (MI*)gb.mi.items[j];
                    j++;
                    if (m.op == M_JMP | m.op == M_JCC)
                    {
                        if (m.o0 == (MO*)0) { -> 0 - 1; };
                        if (m.o0.k != MK_BLK) { -> 0 - 1; };
                        t = this.s_sw_find(hk, hv, cap, (int)m.o0.imm);
                        if (t < 0 | c >= 60) { -> 0 - 1; };
                        sb[c] = t;
                        c++;
                        if (m.op == M_JMP) { term = true; };
                    };
                    if (m.op == M_RET | m.op == M_UD2) { term = true; };
                };
                if (!term)
                {
                    if (i + 1 >= n) { -> 0 - 1; };
                    sb[c] = i + 1;
                    c++;
                };
                -> c;
            };

            // True when the operand names rsp or rbp or a frame object
            s_sw_opstk(MO* o) -> bool
            {
                int r;
                if (o == (MO*)0) { -> false; };
                if (o.k == MK_REG)
                {
                    r = this.s_phys(o.r);
                    -> r == 4 | r == 5;
                };
                if (o.k == MK_MEM)
                {
                    if (o.fo >= 0) { -> true; };
                    if (o.r >= 0) { r = this.s_phys(o.r); if (r == 4 | r == 5) { -> true; }; };
                    if (o.r2 >= 0) { r = this.s_phys(o.r2); if (r == 4 | r == 5) { -> true; }; };
                };
                -> false;
            };

            // True for the instructions whose lowering touches the stack in ways this pass does not follow
            s_sw_bad(int op) -> bool
            {
                if (op == M_DALLOC | op == M_VAARG | op == M_VASTART | op == M_SAVEVA | op == M_FREM | op == M_TEXT | op == M_RETADDR) { -> true; };
                if (op == M_JTAB | op == M_JTAB2 | op == M_SPILL | op == M_RELOAD) { -> true; };
                if (op == M_COPY | op == M_REPMOVS | op == M_REPSTOS | op == M_MEMMOVE | op == M_BREV | op == M_STRLEN | op == M_CNTB | op == M_RUNB | op == M_FMAP | op == M_VZERO) { -> true; };
                -> false;
            };

            // True when the parallel copy of a phi edge touches a spilled register or the address of a frame object
            // True when the parallel copy m puts a constant that fits sz bytes into the physical register r
            s_pc_zx(MI* m, int r, int sz) -> bool
            {
                GB* sg = (GB*)this.sf.bl.items[m.tgt];
                GP* gp;
                IRValue* v;
                int k = 0;
                while (k < sg.phis.len)
                {
                    gp = (GP*)sg.phis.items[k];
                    k++;
                    if (this.s_loc(gp.dst) == r)
                    {
                        v = this.s_res((IRValue*)gp.vals.items[m.cc]);
                        if (!this.s_cint(v)) { -> false; };
                        if (this.scv < (i64)0 | this.scv >= (i64)(1 << (8 * sz))) { -> false; };
                        -> true;
                    };
                };
                -> false;
            };

            s_sw_pcneeds(MI* m) -> bool
            {
                GB* sg = (GB*)this.sf.bl.items[m.tgt];
                GP* gp;
                IRValue* v;
                int k = 0;
                while (k < sg.phis.len)
                {
                    gp = (GP*)sg.phis.items[k];
                    k++;
                    if (this.s_loc(gp.dst) >= 100) { -> true; };
                    v = this.s_res((IRValue*)gp.vals.items[m.cc]);
                    if (v.vr >= R_VBASE) { if (this.s_loc(v.vr) >= 100) { -> true; }; }
                    elif (v.fo > 0) { -> true; };
                };
                -> false;
            };

            s_sw_needs(MI* m) -> bool
            {
                if (m.op == M_CALL) { -> m.tgt != 77; };
                if (m.op == M_PCOPY) { -> this.s_sw_pcneeds(m); };
                if (this.s_sw_opstk(m.o0) | this.s_sw_opstk(m.o1) | this.s_sw_opstk(m.o2)) { -> true; };
                if (((m.iu `| m.id `| m.clob) `& 48) != 0) { -> true; };
                -> false;
            };

            // The general registers m reads (um) and writes (dm), as masks; kill is set when the write replaces the whole register
            s_sw_ud(MI* m, int* um, int* dm, bool* kill) -> void
            {
                int i, r;
                this.s_scan(m);
                um[0] = 0;
                dm[0] = 0;
                i = 0;
                while (i < this.nub)
                {
                    r = this.s_phys(this.ubuf[i]);
                    if (r >= 0 & r < 16) { um[0] = um[0] `| (1 << r); };
                    i++;
                };
                i = 0;
                while (i < this.ndb)
                {
                    r = this.s_phys(this.dbuf[i]);
                    if (r >= 0 & r < 16) { dm[0] = dm[0] `| (1 << r); };
                    i++;
                };
                // a tail call never returns, so it writes nothing the code after it could see
                if (m.op == M_CALL & m.tgt == 77) { dm[0] = 0; };
                kill[0] = m.sz == 4 | m.sz == 8 | m.op == M_CALL | m.op == M_LEA;
                ->;
            };

            // Rewrites the registers of the operand named in the map tm (register to register, -1 for none)
            s_sw_mo(MO* o, int* tm) -> MO*
            {
                MO* c;
                int r;
                if (o == (MO*)0) { -> o; };
                if (o.k == MK_REG)
                {
                    r = this.s_phys(o.r);
                    if (r >= 0 & r < 16)
                    {
                        if (tm[r] >= 0)
                        {
                            c = this.s_mo_copy(o);
                            c.r = tm[r];
                            -> c;
                        };
                    };
                    -> o;
                };
                if (o.k == MK_MEM)
                {
                    c = o;
                    if (o.r >= 0)
                    {
                        r = this.s_phys(o.r);
                        if (r >= 0 & r < 16)
                        {
                            if (tm[r] >= 0) { c = this.s_mo_copy(o); c.r = tm[r]; };
                        };
                    };
                    if (o.r2 >= 0)
                    {
                        r = this.s_phys(o.r2);
                        if (r >= 0 & r < 16)
                        {
                            if (tm[r] >= 0)
                            {
                                if (c == o) { c = this.s_mo_copy(o); };
                                c.r2 = tm[r];
                            };
                        };
                    };
                    -> c;
                };
                -> o;
            };

            s_shrink() -> void
            {
                GF* g = this.sf;
                int n = g.nb;
                int i, j, k, c, e, t, r, h, cap, ne, top, cnt, nh, a, b, nw, p, q, ref, imp, rmask, um, dm;
                bool ok, changed, kill, anyret;
                GB* gb;
                MI* m;
                MO* o;
                int* hk; int* hv; int* sb; int* sc; int* ss; int* sd; int* ps; int* pd;
                int* pon; int* pol; int* rp; int* idom; int* need; int* hdv; int* fr; int* stk; int* epos; int* seen;
                int* ub; int* db; int* lin; int* lout; int* tm; int* xneed; int* bimp; int* rid;
                bool clo;
                int tries;
                bool retry;
                ((XGF*)g.tg).sw = false;
                if (SSA_OPT_SHRINK != 1 | n < 3 | ((XGF*)g.tg).nofp | this.a_win() | ((XGF*)g.tg).dyn) { ->; };
                if (((XGF*)g.tg).vafo != 0 | ((XGF*)g.tg).vagp != 0 | ((XGF*)g.tg).vafp != 0 | ((XGF*)g.tg).vastk != 0) { ->; };
                cap = 16;
                while (cap < 2 * n + 2) { cap = cap * 2; };
                hk = this.s_iz(cap); hv = this.s_iz(cap);
                sb = this.s_iz(64); sc = this.s_iz(n + 1); ss = this.s_iz(n + 2); ps = this.s_iz(n + 2);
                pon = this.s_iz(n); pol = this.s_iz(n); rp = this.s_iz(n); idom = this.s_iz(n); need = this.s_iz(n);
                hdv = this.s_iz(n); fr = this.s_iz(n); stk = this.s_iz(n + 1); epos = this.s_iz(n + 1); seen = this.s_iz(n);
                ub = this.s_iz(n); db = this.s_iz(n); lin = this.s_iz(n); lout = this.s_iz(n);
                tm = this.s_iz(16); xneed = this.s_iz(n); bimp = this.s_iz(n); rid = this.s_iz(n);
                ref = 0; imp = 0; um = 0; dm = 0;
                sd = (int*)0; pd = (int*)0;
                ok = true;
                tries = 0;
                while (tries < 8)
                {
                tries++;
                retry = false;
                i = 0;
                while (i < n)
                {
                    need[i] = 0; hdv[i] = 0; fr[i] = 0; ub[i] = 0; db[i] = 0; lin[i] = 0; lout[i] = 0; bimp[i] = 0; sc[i] = 0; ss[i] = 0; ps[i] = 0; seen[i] = 0; rid[i] = 0;
                    i++;
                };
                ref = 0; imp = 0;
                ss[n] = 0; ss[n + 1] = 0; ps[n] = 0; ps[n + 1] = 0;
                i = 0;
                while (i < cap) { hk[i] = 0; hv[i] = 0; i++; };
                if (sd != (int*)0) { this.s_ifree(sd); sd = (int*)0; };
                if (pd != (int*)0) { this.s_ifree(pd); pd = (int*)0; };
                while (true)
                {
                    // blocks by label, and the instructions that rule the pass out
                    i = 0;
                    while (i < n)
                    {
                        gb = g.rpo[i];
                        h = gb.id % cap;
                        while (hk[h] != 0) { h = (h + 1) % cap; };
                        hk[h] = gb.id + 1;
                        hv[h] = i;
                        j = 0;
                        while (j < gb.mi.len)
                        {
                            m = (MI*)gb.mi.items[j];
                            if (this.s_sw_bad(m.op)) { ok = false; };
                            if (m.op == M_ASM) { if (!this.s_asm_nostack(m.text)) { ok = false; }; };
                            if (this.s_sw_needs(m)) { need[i] = 1; };
                            j++;
                        };
                        if (xneed[i] == 1) { need[i] = 1; };
                        i++;
                    };
                    if (!ok) { break; };
                    if (need[0] == 1) { break; };
                    // edges
                    ne = 0;
                    i = 0;
                    while (i < n)
                    {
                        c = this.s_sw_succ(g.rpo[i], i, n, hk, hv, cap, sb);
                        if (c < 0) { ok = false; break; };
                        sc[i] = c;
                        ne = ne + c;
                        i++;
                    };
                    if (!ok) { break; };
                    sd = this.s_iz(ne + 1);
                    pd = this.s_iz(ne + 1);
                    i = 0;
                    while (i < n) { ss[i + 1] = ss[i] + sc[i]; i++; };
                    i = 0;
                    while (i < n)
                    {
                        c = this.s_sw_succ(g.rpo[i], i, n, hk, hv, cap, sb);
                        j = 0;
                        while (j < c) { sd[ss[i] + j] = sb[j]; ps[sb[j] + 1] = ps[sb[j] + 1] + 1; j++; };
                        i++;
                    };
                    i = 0;
                    while (i < n) { ps[i + 1] = ps[i + 1] + ps[i]; i++; };
                    // the fill position of each block's predecessor list is kept in seen
                    i = 0;
                    while (i < n) { seen[i] = ps[i]; i++; };
                    i = 0;
                    while (i < n)
                    {
                        j = ss[i];
                        while (j < ss[i + 1]) { pd[seen[sd[j]]] = i; seen[sd[j]] = seen[sd[j]] + 1; j++; };
                        i++;
                    };
                    // post order from the entry
                    i = 0;
                    while (i < n) { seen[i] = 0; i++; };
                    top = 0;
                    cnt = 0;
                    stk[0] = 0; epos[0] = ss[0]; seen[0] = 1; top = 1;
                    while (top > 0)
                    {
                        a = stk[top - 1];
                        if (epos[top - 1] < ss[a + 1])
                        {
                            b = sd[epos[top - 1]];
                            epos[top - 1] = epos[top - 1] + 1;
                            if (seen[b] == 0)
                            {
                                seen[b] = 1;
                                stk[top] = b;
                                epos[top] = ss[b];
                                top++;
                            };
                        }
                        else
                        {
                            pon[a] = cnt;
                            pol[cnt] = a;
                            cnt++;
                            top--;
                        };
                    };
                    if (cnt != n) { ok = false; break; };
                    i = 0;
                    while (i < n) { rp[i] = pol[n - 1 - i]; i++; };
                    // dominators
                    i = 0;
                    while (i < n) { idom[i] = 0 - 1; i++; };
                    idom[0] = 0;
                    changed = true;
                    while (changed)
                    {
                        changed = false;
                        k = 1;
                        while (k < n)
                        {
                            b = rp[k];
                            k++;
                            nw = 0 - 1;
                            j = ps[b];
                            while (j < ps[b + 1])
                            {
                                p = pd[j];
                                j++;
                                if (idom[p] < 0) { continue; };
                                if (nw < 0) { nw = p; continue; };
                                a = p;
                                q = nw;
                                while (a != q)
                                {
                                    while (pon[a] < pon[q]) { a = idom[a]; };
                                    while (pon[q] < pon[a]) { q = idom[q]; };
                                };
                                nw = a;
                            };
                            if (idom[b] != nw) { idom[b] = nw; changed = true; };
                        };
                    };
                    // blocks that need the frame: the first of each dominator subtree opens it
                    i = 0;
                    while (i < n)
                    {
                        if (need[i] == 1) { hdv[i] = 1; };
                        i++;
                    };
                    changed = true;
                    while (changed)
                    {
                        changed = false;
                        // frame state in dominator order
                        k = 0;
                        while (k < n)
                        {
                            b = rp[k];
                            k++;
                            if (b == 0) { fr[b] = 0; continue; };
                            if (fr[idom[b]] != 0) { fr[b] = 2; continue; };
                            fr[b] = 0;
                            if (hdv[b] == 1) { fr[b] = 1; };
                        };
                        // the region below a head is closed: a path that leaves it joins at the common dominator
                        k = 0;
                        while (k < n)
                        {
                            b = rp[k];
                            k++;
                            if (fr[b] == 1) { rid[b] = b; }
                            elif (fr[b] == 2) { rid[b] = rid[idom[b]]; }
                            else { rid[b] = 0 - 1; };
                        };
                        clo = false;
                        i = 0;
                        while (i < n & !clo)
                        {
                            if (fr[i] != 0)
                            {
                                e = ss[i];
                                while (e < ss[i + 1])
                                {
                                    b = sd[e];
                                    e++;
                                    if (rid[b] != rid[i])
                                    {
                                        a = rid[i];
                                        q = b;
                                        while (a != q)
                                        {
                                            while (pon[a] < pon[q]) { a = idom[a]; };
                                            while (pon[q] < pon[a]) { q = idom[q]; };
                                        };
                                        if (a == 0) { ok = false; };
                                        hdv[a] = 1;
                                        clo = true;
                                        changed = true;
                                        break;
                                    };
                                };
                            };
                            i++;
                        };
                        if (!ok) { break; };
                        if (clo) { continue; };
                        // a head on a cycle would save again with the registers changed: it moves up
                        i = 1;
                        while (i < n)
                        {
                            if (fr[i] == 1)
                            {
                                // is i reachable from itself
                                j = 0;
                                while (j < n) { seen[j] = 0; j++; };
                                top = 0;
                                cnt = 0;
                                e = ss[i];
                                while (e < ss[i + 1])
                                {
                                    b = sd[e];
                                    e++;
                                    if (seen[b] == 0) { seen[b] = 1; stk[top] = b; top++; };
                                };
                                while (top > 0)
                                {
                                    top--;
                                    a = stk[top];
                                    e = ss[a];
                                    while (e < ss[a + 1])
                                    {
                                        b = sd[e];
                                        e++;
                                        if (seen[b] == 0) { seen[b] = 1; stk[top] = b; top++; };
                                    };
                                };
                                if (seen[i] == 1)
                                {
                                    hdv[i] = 0;
                                    hdv[idom[i]] = 1;
                                    changed = true;
                                    if (idom[i] == 0) { ok = false; };
                                    break;
                                };
                            };
                            i++;
                        };
                        if (!ok) { break; };
                    };
                    if (!ok) { break; };
                    nh = 0;
                    anyret = false;
                    i = 0;
                    while (i < n)
                    {
                        if (fr[i] == 1) { nh++; };
                        if (fr[i] == 0)
                        {
                            gb = g.rpo[i];
                            j = 0;
                            while (j < gb.mi.len) { if (((MI*)gb.mi.items[j]).op == M_RET) { anyret = true; }; j++; };
                        };
                        i++;
                    };
                    if (nh == 0 | nh > 8 | !anyret) { ok = false; break; };
                    // no path may leave the framed blocks, and the frame is entered only at a head
                    i = 0;
                    while (i < n)
                    {
                        e = ss[i];
                        while (e < ss[i + 1])
                        {
                            b = sd[e];
                            e++;
                            if (fr[i] != 0 & fr[b] == 0) { ok = false; };
                            if (fr[i] == 0 & fr[b] == 2) { ok = false; };
                        };
                        i++;
                    };
                    if (!ok) { break; };
                    // registers read and written by the blocks outside the frame, and the liveness of all blocks
                    i = 0;
                    while (i < n)
                    {
                        gb = g.rpo[i];
                        j = 0;
                        while (j < gb.mi.len)
                        {
                            m = (MI*)gb.mi.items[j];
                            this.s_sw_ud(m, @um, @dm, @kill);
                            ub[i] = ub[i] `| (um `& (65535 `^| db[i]));
                            if (!kill) { ub[i] = ub[i] `| (dm `& (65535 `^| db[i])); };
                            if (kill) { db[i] = db[i] `| dm; };
                            if (fr[i] == 0)
                            {
                                ref = ref `| um `| dm;
                                if (m.op == M_CALL & m.tgt == 77)
                                {
                                    imp = imp `| m.iu;
                                    bimp[i] = bimp[i] `| m.iu;
                                }
                                else
                                {
                                    imp = imp `| (m.iu `| m.id `| m.clob);
                                    bimp[i] = bimp[i] `| (m.iu `| m.id `| m.clob);
                                };
                                if (m.op == M_PCOPY) { imp = imp `| um `| dm; bimp[i] = bimp[i] `| um `| dm; };
                                if (m.op == M_ASM) { imp = imp `| this.s_sw_asmcs(m.text); bimp[i] = bimp[i] `| this.s_sw_asmcs(m.text); };
                            };
                            j++;
                        };
                        i++;
                    };
                    changed = true;
                    while (changed)
                    {
                        changed = false;
                        k = 0;
                        while (k < n)
                        {
                            b = pol[k];
                            k++;
                            nw = 0;
                            e = ss[b];
                            while (e < ss[b + 1]) { nw = nw `| lin[sd[e]]; e++; };
                            lout[b] = nw;
                            nw = ub[b] `| (nw `& (65535 `^| db[b]));
                            if (nw != lin[b]) { lin[b] = nw; changed = true; };
                        };
                    };
                    // callee saved registers touched outside the frame move to free scratch registers there
                    rmask = ref `& ((XGF*)g.tg).saved `& 65535;
                    if (((imp `& rmask) `& 65535) != 0)
                    {
                        // the registers cannot be renamed in these blocks: they get the frame
                        i = 0;
                        while (i < n)
                        {
                            if (fr[i] == 0 & ((bimp[i] `& rmask) `& 65535) != 0) { xneed[i] = 1; retry = true; };
                            i++;
                        };
                        ok = false;
                        break;
                    };
                    i = 0;
                    while (i < 16) { tm[i] = 0 - 1; i++; };
                    r = 0;
                    while (r < 16)
                    {
                        if ((rmask `& (1 << r)) != 0)
                        {
                            t = 0 - 1;
                            k = 6;
                            if (SSA_OPT_SWCOPY == 1)
                            {
                                t = this.s_sw_srck(r, fr, n);
                                if (t >= 0) { k = 10; };
                            };
                            while (k < 10)
                            {
                                if ((ref `& (1 << k)) == 0)
                                {
                                    ok = true;
                                    i = 0;
                                    while (i < n) { if (fr[i] == 1 & (lin[i] `& (1 << k)) != 0) { ok = false; }; i++; };
                                    i = 0;
                                    while (i < 16) { if (tm[i] == k) { ok = false; }; i++; };
                                    if (ok) { t = k; break; };
                                };
                                k++;
                            };
                            ok = true;
                            if (t < 0) { ok = false; break; };
                            tm[r] = t;
                        };
                        r++;
                    };
                    if (!ok) { break; };
                    // apply
                    i = 0;
                    while (i < n)
                    {
                        gb = g.rpo[i];
                        if (fr[i] == 0 & rmask != 0)
                        {
                            j = 0;
                            while (j < gb.mi.len)
                            {
                                m = (MI*)gb.mi.items[j];
                                m.o0 = this.s_sw_mo(m.o0, tm);
                                m.o1 = this.s_sw_mo(m.o1, tm);
                                m.o2 = this.s_sw_mo(m.o2, tm);
                                j++;
                            };
                        };
                        if (fr[i] == 1)
                        {
                            r = 15;
                            while (r >= 0)
                            {
                                if (tm[r] >= 0 & (lin[i] `& (1 << r)) != 0)
                                {
                                    this.scb = gb;
                                    m = this.s_mi(M_MOV, 8);
                                    m.o0 = this.s_mo_r(tm[r], 8);
                                    m.o1 = this.s_mo_r(r, 8);
                                    gb.mi.len = gb.mi.len - 1;
                                    this.s_vins(gb.mi, 0, (void*)m);
                                };
                                r--;
                            };
                        };
                        gb.hd = fr[i];
                        i++;
                    };
                    ((XGF*)g.tg).sw = true;
                    break;
                };
                if (!retry) { break; };
                ok = true;
                };
                if (sd != (int*)0) { this.s_ifree(sd); };
                if (pd != (int*)0) { this.s_ifree(pd); };
                this.s_ifree(hk); this.s_ifree(hv); this.s_ifree(sb); this.s_ifree(sc); this.s_ifree(ss); this.s_ifree(ps);
                this.s_ifree(pon); this.s_ifree(pol); this.s_ifree(rp); this.s_ifree(idom); this.s_ifree(need);
                this.s_ifree(hdv); this.s_ifree(fr); this.s_ifree(stk); this.s_ifree(epos); this.s_ifree(seen);
                this.s_ifree(ub); this.s_ifree(db); this.s_ifree(lin); this.s_ifree(lout);
                this.s_ifree(tm); this.s_ifree(xneed); this.s_ifree(rid); this.s_ifree(bimp);
                ->;
            };

            // The register r outside the frame only ever receives a plain copy of one register k that is not
            // written outside the frame: r can be renamed to k, and the copy disappears. Returns k, or -1.
            s_sw_srck(int r, int* fr, int n) -> int
            {
                GF* g = this.sf;
                int i, j, k, src, um, dm;
                bool kill;
                GB* gb;
                MI* m;
                k = 0 - 1;
                um = 0; dm = 0; kill = false;
                i = 0;
                while (i < n)
                {
                    if (fr[i] == 0)
                    {
                        gb = g.rpo[i];
                        j = 0;
                        while (j < gb.mi.len)
                        {
                            m = (MI*)gb.mi.items[j];
                            this.s_sw_ud(m, @um, @dm, @kill);
                            if ((dm `& (1 << r)) != 0)
                            {
                                if (m.op != M_MOV | m.sz != 8) { -> 0 - 1; };
                                if (m.o0.k != MK_REG | m.o1.k != MK_REG) { -> 0 - 1; };
                                if (this.s_phys(m.o1.r) != r) { -> 0 - 1; };
                                src = this.s_phys(m.o0.r);
                                if (src < 0 | src >= 16) { -> 0 - 1; };
                                if (src == r) { j++; continue; };
                                if (k >= 0 & k != src) { -> 0 - 1; };
                                k = src;
                            };
                            j++;
                        };
                    };
                    i++;
                };
                if (k < 0 | k == 4 | k == 5 | k == 10 | k == 11) { -> 0 - 1; };
                if ((((XGF*)g.tg).saved `& (1 << k)) != 0) { -> 0 - 1; };
                i = 0;
                while (i < n)
                {
                    if (fr[i] == 0)
                    {
                        gb = g.rpo[i];
                        j = 0;
                        while (j < gb.mi.len)
                        {
                            m = (MI*)gb.mi.items[j];
                            this.s_sw_ud(m, @um, @dm, @kill);
                            if ((dm `& (1 << k)) != 0) { -> 0 - 1; };
                            if (m.op == M_CALL | m.op == M_ASM) { -> 0 - 1; };
                            j++;
                        };
                    };
                    i++;
                };
                -> k;
            };

            // Sets up the frame and saves the callee saved registers
            e_prologue(Buf* o) -> void
            {
                GF* g = this.sf;
                int n, k;
                this.ipsv = ((XGF*)g.tg).saved;
                if (!((XGF*)g.tg).nofp) { o.put_str(g"\tpushq %rbp\n\tmovq %rsp, %rbp\n\0"); };
                if (SSA_OPT_PUSHCSR == 1 & !this.a_win())
                {
                    // the callee saved registers go on with push, one byte each, the first one lands where the first
                    // frame slot is, then the rest of the frame is taken
                    n = 0;
                    k = 0;
                    while (k < 16)
                    {
                        if ((((XGF*)g.tg).saved `& (1 << k)) != 0)
                        {
                            n++;
                            o.put_str(g"\tpushq \0");
                            this.e_reg(o, k, 8);
                            o.put(10);
                        };
                        k++;
                    };
                    if (((XGF*)g.tg).frame - 8 * n == 8 & SSA_OPT_PUSHPAD == 1)
                    {
                        // one push takes eight bytes in a single byte of code
                        o.put_str(g"\tpushq %rax\n\0");
                    }
                    elif (((XGF*)g.tg).frame - 8 * n > 0)
                    {
                        o.put_str(g"\tsubq $\0");
                        o.put_int(((XGF*)g.tg).frame - 8 * n);
                        o.put_str(g", %rsp\n\0");
                    };
                    ->;
                };
                if (this.a_win() & ((XGF*)g.tg).frame >= 4096)
                {
                    o.put_str(g"\tmovl $\0");
                    o.put_int(((XGF*)g.tg).frame);
                    o.put_str(g", %eax\n\tcallq __chkstk\n\tsubq %rax, %rsp\n\0");
                }
                else
                {
                    if (((XGF*)g.tg).frame > 0)
                    {
                        o.put_str(g"\tsubq $\0");
                        o.put_int(((XGF*)g.tg).frame);
                        o.put_str(g", %rsp\n\0");
                    };
                };
                n = 0;
                k = 0;
                while (k < 16)
                {
                    if ((((XGF*)g.tg).saved `& (1 << k)) != 0)
                    {
                        n++;
                        o.put_str(g"\tmovq \0");
                        this.e_reg(o, k, 8);
                        o.put_str(g", \0");
                        this.e_fpm(o, (i64)(0 - 8 * n));
                        o.put(10);
                    };
                    k++;
                };
                ->;
            };

            s_emit(IRFunc* f, Buf* out) -> void
            {
                GF* g = this.sf;
                byte* nm = this.a_sym(f.self.text);
                bool islocal = false;
                bool weak = false;
                int i, j, k, n;
                GB* gb;
                GB* nx;
                if (f.linkage != (byte*)0)
                {
                    if (this.a_seq(f.linkage, g"internal\0") | this.a_seq(f.linkage, g"private\0")) { islocal = true; };
                    if (this.a_pre(f.linkage, g"linkonce\0") | this.a_pre(f.linkage, g"weak\0")) { weak = true; };
                };
                this.s_rnames();
                this.jts.len = 0;
                this.jb.len = 0;
                this.s_layout();
                if (SSA_OPT_LAYOUT == 1) { this.s_blocksort(); };
                if (SSA_OPT_JTHREAD == 1) { this.s_jthread(); };
                this.s_head(f, out);
                ((XGF*)g.tg).nofp = false;
                ((XGF*)g.tg).ncl = false;
                if (SSA_OPT_NOFP == 1) { ((XGF*)g.tg).nofp = this.s_nofp_ok(false); };
                if (!((XGF*)g.tg).nofp) { this.s_shrink(); };
                // a function that makes calls and was not shrink wrapped does without the frame pointer too
                if (SSA_OPT_NOFPC == 1 & !((XGF*)g.tg).nofp & !((XGF*)g.tg).sw & !this.a_win() & SSA_OPT_PUSHCSR == 1)
                {
                    if (this.s_nofp_ok(true)) { ((XGF*)g.tg).nofp = true; ((XGF*)g.tg).ncl = true; };
                };
                if (((XGF*)g.tg).nofp) { this.s_layout(); };
                this.efr = true;
                if (!((XGF*)g.tg).sw) { this.e_prologue(out); };
                i = 0;
                while (i < g.nb)
                {
                    gb = g.rpo[i];
                    nx = (GB*)0;
                    if (i + 1 < g.nb) { nx = g.rpo[i + 1]; };
                    out.put_str(g".LB\0");
                    out.put_int(gb.id);
                    out.put_str(g":\n\0");
                    if (((XGF*)g.tg).sw)
                    {
                        this.efr = gb.hd != 0;
                        if (gb.hd == 1) { this.e_prologue(out); };
                    };
                    j = 0;
                    while (j < gb.mi.len)
                    {
                        this.e_mi(out, gb, j, nx);
                        j++;
                    };
                    i++;
                };
                if (!this.a_win())
                {
                    out.put_str(g"\t.size \0");
                    out.put_str(nm);
                    out.put_str(g", .-\0");
                    out.put_str(nm);
                    out.put(10);
                };
                this.e_tables(out);
                ->;
            };

            // Zero and nonzero constants are made in an xmm register straight from their bits
            s_fconst(IRValue* v) -> MO*
            {
                int d = this.s_nv(1);
                int sz = this.s_vsz(v.ty);
                MI* m = this.s_mi2(M_GX, sz, this.s_mo_i(this.scv), this.s_mo_r(d, sz));
                -> this.s_mo_r(d, sz);
            };

            // Operand register of the float value v
            s_freg(IRValue* v) -> int
            {
                MO* o = this.s_src(v);
                if (o.k != MK_REG) { this.s_fail(g"float operand\0"); -> 0; };
                -> o.r;
            };

            // Condition code of a float compare that one flag test decides. The result is 0 - 1 when two flag tests
            // are needed, 0 - 2 for the constant predicates. sfs is set when the operands are swapped.
            s_fcc(int p) -> int
            {
                this.sfs = 0;
                if (p == SP_OGT) { -> C_A; };
                if (p == SP_OGE) { -> C_AE; };
                if (p == SP_OLT) { this.sfs = 1; -> C_A; };
                if (p == SP_OLE) { this.sfs = 1; -> C_AE; };
                if (p == SP_ULT_F) { -> C_B; };
                if (p == SP_ULE_F) { -> C_BE; };
                if (p == SP_UGT_F) { this.sfs = 1; -> C_B; };
                if (p == SP_UGE_F) { this.sfs = 1; -> C_BE; };
                if (p == SP_ORD) { -> C_NP; };
                if (p == SP_UNO) { -> C_P; };
                if (p == SP_FALSE | p == SP_TRUE) { -> 0 - 2; };
                -> 0 - 1;
            };

            // True when the float compare x is decided by one condition code
            s_fsingle(SI* x) -> bool
            {
                int c = this.s_fcc(x.k);
                -> c >= 0;
            };

            // Emits the compare of a float compare decided by one flag test, returns its condition code
            s_fcmpflags(SI* x) -> int
            {
                IRValue* a = this.s_res(x.a);
                IRValue* b = this.s_res(x.b);
                int cc = this.s_fcc(x.k);
                int sw = this.sfs;
                int ra, rb, sz;
                sz = this.s_vsz(a.ty);
                ra = this.s_freg(a);
                rb = this.s_freg(b);
                if (sw == 1) { this.s_mi2(M_FCMP, sz, this.s_mo_r(rb, sz), this.s_mo_r(ra, sz)); }
                else { this.s_mi2(M_FCMP, sz, this.s_mo_r(ra, sz), this.s_mo_r(rb, sz)); };
                -> cc;
            };

            // Register with the 0 or 1 result of the float compare x
            s_fcmpval(SI* x) -> int
            {
                IRValue* a;
                IRValue* b;
                int p = x.k;
                int cc, d, t, ra, rb, sz;
                MI* m;
                d = this.s_nv(0);
                cc = this.s_fcc(p);
                if (cc == 0 - 2)
                {
                    if (p == SP_TRUE) { this.s_mov(this.s_mo_i((i64)1), d, 4); } else { this.s_mov(this.s_mo_i((i64)0), d, 4); };
                    -> d;
                };
                if (cc >= 0)
                {
                    cc = this.s_fcmpflags(x);
                    m = this.s_mi1(M_SETCC, 1, this.s_mo_r(d, 1));
                    m.cc = cc;
                    this.s_mi2(M_MOVZX, 1, this.s_mo_r(d, 1), this.s_mo_r(d, 4));
                    -> d;
                };
                a = this.s_res(x.a);
                b = this.s_res(x.b);
                sz = this.s_vsz(a.ty);
                ra = this.s_freg(a);
                rb = this.s_freg(b);
                this.s_mi2(M_FCMP, sz, this.s_mo_r(ra, sz), this.s_mo_r(rb, sz));
                t = this.s_nv(0);
                m = this.s_mi1(M_SETCC, 1, this.s_mo_r(d, 1));
                if (p == SP_OEQ | p == SP_UEQ) { m.cc = C_E; } else { m.cc = C_NE; };
                this.s_mi2(M_MOVZX, 1, this.s_mo_r(d, 1), this.s_mo_r(d, 4));
                m = this.s_mi1(M_SETCC, 1, this.s_mo_r(t, 1));
                if (p == SP_OEQ | p == SP_ONE) { m.cc = C_NP; } else { m.cc = C_P; };
                this.s_mi2(M_MOVZX, 1, this.s_mo_r(t, 1), this.s_mo_r(t, 4));
                if (p == SP_OEQ | p == SP_ONE) { this.s_mi3c(M_ALU, 4, this.s_mo_r(d, 4), this.s_mo_r(t, 4), this.s_mo_r(d, 4), A_AND); }
                else { this.s_mi3c(M_ALU, 4, this.s_mo_r(d, 4), this.s_mo_r(t, 4), this.s_mo_r(d, 4), A_OR); };
                -> d;
            };

            // The multiply u absorbs, or null when u is not an add or subtract that fuses (or the processor has no FMA)
            s_fmapick(SI* u) -> IRValue*
            {
                IRValue* p;
                int sz;
                if (SSA_OPT_FMA != 1) { -> (IRValue*)0; };
                if ((this.feat `& XF_FMA) == 0) { -> (IRValue*)0; };
                if (u.op != SO_BIN | u.vol) { -> (IRValue*)0; };
                if (u.k != SB_FADD & u.k != SB_FSUB) { -> (IRValue*)0; };
                if (!this.s_isfp(u.ty)) { -> (IRValue*)0; };
                sz = this.s_vsz(u.ty);
                if (sz != 4 & sz != 8) { -> (IRValue*)0; };
                p = this.s_fmad(u.a, u);
                if (p != (IRValue*)0)
                {
                    if (this.s_facc(u.b, u.res, 3)) { -> (IRValue*)0; };
                    -> p;
                };
                p = this.s_fmad(u.b, u);
                if (p != (IRValue*)0)
                {
                    if (this.s_facc(u.a, u.res, 3)) { -> (IRValue*)0; };
                };
                -> p;
            };

            s_fp_bin(SI* x) -> void
            {
                IRValue* a = this.s_res(x.a);
                IRValue* b = this.s_res(x.b);
                int sz = this.s_vsz(x.ty);
                int ra, rb, rc, d;
                MI* m;
                IRValue* p;
                IRValue* c;
                SI* fm;
                SI* u;
                if (x.k == SB_FMUL)
                {
                    // absorbed by the add or subtract that uses it
                    p = this.s_res(x.res);
                    if (p.nu == 1 & p.ui != (void*)0)
                    {
                        u = (SI*)p.ui;
                        if (this.s_fmapick(u) == p) { ->; };
                    };
                };
                if (x.k == SB_FADD | x.k == SB_FSUB)
                {
                    p = this.s_fmapick(x);
                    if (p != (IRValue*)0)
                    {
                        fm = (SI*)p.di;
                        ra = this.s_freg(this.s_res(fm.a));
                        rb = this.s_freg(this.s_res(fm.b));
                        m = (MI*)0;
                        if (this.s_res(x.a) == p) { c = b; } else { c = a; };
                        rc = this.s_freg(c);
                        d = this.s_def(x.res, 1);
                        m = this.s_mi3(M_FMA, sz, this.s_mo_r(ra, sz), this.s_mo_r(rb, sz), this.s_mo_r(d, sz));
                        m.o3 = this.s_mo_r(rc, sz);
                        if (x.k == SB_FADD) { m.cc = 0; }
                        else
                        {
                            if (this.s_res(x.a) == p) { m.cc = 1; } else { m.cc = 2; };
                        };
                        ->;
                    };
                };
                ra = this.s_freg(a);
                rb = this.s_freg(b);
                d = this.s_def(x.res, 1);
                if (x.k == SB_FREM)
                {
                    m = this.s_mi3(M_FREM, sz, this.s_mo_r(ra, sz), this.s_mo_r(rb, sz), this.s_mo_r(d, sz));
                    m.clob = 1;
                    ->;
                };
                m = this.s_mi3(M_FALU, sz, this.s_mo_r(ra, sz), this.s_mo_r(rb, sz), this.s_mo_r(d, sz));
                m.cc = x.k;
                ->;
            };

            s_fp_cast(SI* x) -> void
            {
                IRValue* a = this.s_res(x.a);
                IRType* ft = a.ty;
                IRType* tt = x.ty;
                int k = x.k;
                int r, d, fsz, tsz, fw, tw;
                MI* m;
                fw = 64;
                tw = 64;
                if (ft.kind == LK.INT) { fw = ft.width; };
                if (tt.kind == LK.INT) { tw = tt.width; };
                if (fw > 64 | tw > 64) { this.s_fail(g"wide float cast\0"); ->; };
                fsz = this.s_vsz(ft);
                tsz = this.s_vsz(tt);
                if (k == SK_BITCAST)
                {
                    if (this.s_isfp(ft) == this.s_isfp(tt))
                    {
                        if (fsz != tsz) { this.s_fail(g"bitcast size\0"); ->; };
                        r = this.s_reg(a);
                        d = this.s_def(x.res, this.s_cls(tt));
                        if (this.s_isfp(tt)) { this.s_mi2(M_XMOV, tsz, this.s_mo_r(r, tsz), this.s_mo_r(d, tsz)); }
                        else { this.s_mov(this.s_mo_r(r, tsz), d, tsz); };
                        ->;
                    };
                    if (this.s_isfp(ft))
                    {
                        // float bits into an integer register
                        if (tsz != fsz) { this.s_fail(g"bitcast size\0"); ->; };
                        r = this.s_freg(a);
                        d = this.s_def(x.res, 0);
                        this.s_mi2(M_GX, fsz, this.s_mo_r(r, fsz), this.s_mo_r(d, fsz));
                        ->;
                    };
                    if (tsz != fsz) { this.s_fail(g"bitcast size\0"); ->; };
                    r = this.s_reg(a);
                    d = this.s_def(x.res, 1);
                    this.s_mi2(M_GX, tsz, this.s_mo_r(r, tsz), this.s_mo_r(d, tsz));
                    ->;
                };
                if (k == SK_FPEXT | k == SK_FPTRUNC)
                {
                    r = this.s_freg(a);
                    d = this.s_def(x.res, 1);
                    m = this.s_mi2(M_CVT, tsz, this.s_mo_r(r, fsz), this.s_mo_r(d, tsz));
                    if (k == SK_FPEXT) { m.cc = 1; } else { m.cc = 2; };
                    ->;
                };
                if (k == SK_SITOFP | k == SK_UITOFP)
                {
                    if (k == SK_SITOFP & fw == 1) { this.s_fail(g"i1 sitofp\0"); ->; };
                    r = this.s_reg(a);
                    if (k == SK_SITOFP)
                    {
                        if (fsz < 8) { r = this.s_ext(r, fsz, true, 8); };
                    }
                    else
                    {
                        if (fsz < 4) { r = this.s_ext(r, fsz, false, 4); };
                    };
                    d = this.s_def(x.res, 1);
                    m = this.s_mi2(M_CVT, tsz, this.s_mo_r(r, 8), this.s_mo_r(d, tsz));
                    m.cc = 3;
                    if (k == SK_UITOFP & fw == 64) { m.cc = 4; };
                    ->;
                };
                if (k == SK_FPTOSI | k == SK_FPTOUI)
                {
                    r = this.s_freg(a);
                    d = this.s_def(x.res, 0);
                    m = this.s_mi2(M_CVT, fsz, this.s_mo_r(r, fsz), this.s_mo_r(d, 8));
                    m.cc = 5;
                    if (k == SK_FPTOUI & tw == 64) { m.cc = 6; };
                    if (tw < 64)
                    {
                        m = this.s_mi2(M_MOV, 4, this.s_mo_r(d, 4), this.s_mo_r(d, 4));
                        m.cc = 1;
                        if (tw == 1) { this.s_mi3c(M_ALU, 4, this.s_mo_r(d, 4), this.s_mo_i((i64)1), this.s_mo_r(d, 4), A_AND); };
                    };
                    ->;
                };
                this.s_fail(g"float cast\0");
                ->;
            };

            s_fp_load(SI* x) -> void
            {
                int sz = this.s_vsz(x.ty);
                MO* m = this.s_addr(x.a);
                int d = this.s_def(x.res, 1);
                this.s_mi2(M_XMOV, sz, m, this.s_mo_r(d, sz));
                ->;
            };

            s_fp_store(SI* x) -> void
            {
                int sz = this.s_vsz(x.ty);
                int r = this.s_freg(x.a);
                MO* m = this.s_addr(x.b);
                this.s_mi2(M_XMOV, sz, this.s_mo_r(r, sz), m);
                ->;
            };

            s_fp_select(SI* x) -> void
            {
                IRValue* c = this.s_res(x.a);
                int sz = this.s_vsz(x.ty);
                int ra, rb, d, cc;
                MI* m;
                if (this.s_isint(c))
                {
                    if (this.scv != (i64)0) { ra = this.s_freg(x.b); } else { ra = this.s_freg(x.c); };
                    d = this.s_def(x.res, 1);
                    this.s_mi2(M_XMOV, sz, this.s_mo_r(ra, sz), this.s_mo_r(d, sz));
                    ->;
                };
                ra = this.s_freg(x.b);
                rb = this.s_freg(x.c);
                cc = this.s_cond(c);
                d = this.s_def(x.res, 1);
                m = this.s_mi3(M_FSEL, sz, this.s_mo_r(ra, sz), this.s_mo_r(rb, sz), this.s_mo_r(d, sz));
                m.cc = cc;
                ->;
            };

            // ----------------------------------------------------------
            // Lowering
            // ----------------------------------------------------------

            // Single or double suffix of an SSE mnemonic
            e_fs(Buf* o, int sz) -> void
            {
                if (sz == 4) { o.put_str(g"ss \0"); } else { o.put_str(g"sd \0"); };
                ->;
            };

            e_ps(Buf* o, MO* a, MO* d) -> void
            {
                int pa = this.s_phys(a.r);
                int pd = this.s_phys(d.r);
                if (pa == pd) { ->; };
                o.put_str(g"\tmovaps \0");
                this.e_reg(o, pa, 8);
                o.put_str(g", \0");
                this.e_reg(o, pd, 8);
                o.put(10);
                ->;
            };

            e_falu(Buf* o, MI* m) -> void
            {
                int sz = m.sz;
                int k = m.cc;
                MO* a = m.o0;
                MO* b = m.o1;
                MO* d = m.o2;
                int pa = this.s_phys(a.r);
                int pb = this.s_phys(b.r);
                int pd = this.s_phys(d.r);
                byte* mn;
                if (k == SB_FADD) { mn = g"add\0"; };
                if (k == SB_FSUB) { mn = g"sub\0"; };
                if (k == SB_FMUL) { mn = g"mul\0"; };
                if (k == SB_FDIV) { mn = g"div\0"; };
                if (pd == pb & pd != pa)
                {
                    if (k == SB_FADD | k == SB_FMUL)
                    {
                        o.put(9);
                        o.put_str(mn);
                        this.e_fs(o, sz);
                        this.e_reg(o, pa, 8);
                        o.put_str(g", \0");
                        this.e_reg(o, pd, 8);
                        o.put(10);
                        ->;
                    };
                    o.put_str(g"\tmovaps \0");
                    this.e_reg(o, pb, 8);
                    o.put_str(g", %xmm15\n\0");
                    this.e_ps(o, a, d);
                    o.put(9);
                    o.put_str(mn);
                    this.e_fs(o, sz);
                    o.put_str(g"%xmm15, \0");
                    this.e_reg(o, pd, 8);
                    o.put(10);
                    ->;
                };
                this.e_ps(o, a, d);
                o.put(9);
                o.put_str(mn);
                this.e_fs(o, sz);
                this.e_reg(o, pb, 8);
                o.put_str(g", \0");
                this.e_reg(o, pd, 8);
                o.put(10);
                ->;
            };

            // o2 = o0 * o1 + o3, o0 * o1 - o3 or o3 - o0 * o1 (cc 0, 1, 2) with the destination as one of the three inputs
            e_fma(Buf* o, MI* m) -> void
            {
                int sz = m.sz;
                int k = m.cc;
                int pa = this.s_phys(m.o0.r);
                int pb = this.s_phys(m.o1.r);
                int pd = this.s_phys(m.o2.r);
                int pc = this.s_phys(m.o3.r);
                int fa, fb, fc;
                // the form named by which input the destination is: 231 accumulates in the addend, 132 in a factor
                if (pd == pc) { fa = pa; fb = pb; fc = 231; }
                else
                {
                    if (pd == pa) { fa = pb; fb = pc; fc = 132; }
                    else
                    {
                        if (pd == pb) { fa = pa; fb = pc; fc = 132; }
                        else
                        {
                            this.e_ps(o, m.o3, m.o2);
                            fa = pa; fb = pb; fc = 231;
                        };
                    };
                };
                o.put(9);
                if (k == 0) { o.put_str(g"vfmadd\0"); };
                if (k == 1) { o.put_str(g"vfmsub\0"); };
                if (k == 2) { o.put_str(g"vfnmadd\0"); };
                o.put_int(fc);
                if (sz == 4) { o.put_str(g"ss \0"); } else { o.put_str(g"sd \0"); };
                this.e_reg(o, fa, 8);
                o.put_str(g", \0");
                this.e_reg(o, fb, 8);
                o.put_str(g", \0");
                this.e_reg(o, pd, 8);
                o.put(10);
                ->;
            };

            e_fcmp(Buf* o, MI* m) -> void
            {
                o.put_str(g"\tucomis\0");
                if (m.sz == 4) { o.put_str(g"s \0"); } else { o.put_str(g"d \0"); };
                this.e_reg(o, this.s_phys(m.o1.r), 8);
                o.put_str(g", \0");
                this.e_reg(o, this.s_phys(m.o0.r), 8);
                o.put(10);
                ->;
            };

            e_xmov(Buf* o, MI* m) -> void
            {
                MO* a = m.o0;
                MO* b = m.o1;
                if (a.k == MK_REG & b.k == MK_REG) { this.e_ps(o, a, b); ->; };
                o.put(9);
                if (m.sz == 4) { o.put_str(g"movss \0"); } else { o.put_str(g"movsd \0"); };
                this.e_op(o, a, 8);
                o.put_str(g", \0");
                this.e_op(o, b, 8);
                o.put(10);
                ->;
            };

            e_gx(Buf* o, MI* m) -> void
            {
                MO* a = m.o0;
                MO* b = m.o1;
                int pb;
                int sz = m.sz;
                if (a.k == MK_IMM)
                {
                    pb = this.s_phys(b.r);
                    if (a.imm == (i64)0)
                    {
                        o.put_str(g"\txorps \0");
                        this.e_reg(o, pb, 8);
                        o.put_str(g", \0");
                        this.e_reg(o, pb, 8);
                        o.put(10);
                        ->;
                    };
                    o.put_str(g"\tmovabsq $\0");
                    put_i64(o, a.imm);
                    o.put_str(g", %r10\n\tmovq %r10, \0");
                    this.e_reg(o, pb, 8);
                    o.put(10);
                    ->;
                };
                o.put(9);
                if (sz == 4) { o.put_str(g"movd \0"); } else { o.put_str(g"movq \0"); };
                this.e_reg(o, this.s_phys(a.r), sz);
                o.put_str(g", \0");
                this.e_reg(o, this.s_phys(b.r), sz);
                o.put(10);
                ->;
            };

            e_fsel(Buf* o, MI* m) -> void
            {
                int sz = m.sz;
                MO* a = m.o0;
                MO* b = m.o1;
                MO* d = m.o2;
                int pa = this.s_phys(a.r);
                int pb = this.s_phys(b.r);
                int pd = this.s_phys(d.r);
                int cc = m.cc;
                int n;
                this.lab++;
                n = this.lab;
                if (pd == pa)
                {
                    // d holds the value for the true case: replace it when the condition is false
                    o.put_str(g"\tj\0");
                    this.e_cc(o, cc);
                    o.put_str(g" .LF\0");
                    o.put_int(n);
                    o.put(10);
                    this.e_ps(o, b, d);
                }
                else
                {
                    if (pd != pb) { this.e_ps(o, b, d); };
                    o.put_str(g"\tj\0");
                    this.e_cc(o, this.s_invcc(cc));
                    o.put_str(g" .LF\0");
                    o.put_int(n);
                    o.put(10);
                    this.e_ps(o, a, d);
                };
                o.put_str(g".LF\0");
                o.put_int(n);
                o.put_str(g":\n\0");
                ->;
            };

            // Remainder with the x87 unit, fprem is repeated until the reduction is complete
            e_frem(Buf* o, MI* m) -> void
            {
                int sz = m.sz;
                int pa = this.s_phys(m.o0.r);
                int pb = this.s_phys(m.o1.r);
                int pd = this.s_phys(m.o2.r);
                int n;
                this.lab++;
                n = this.lab;
                o.put_str(g"\tsubq $8, %rsp\n\0");
                o.put(9);
                if (sz == 4) { o.put_str(g"movss \0"); } else { o.put_str(g"movsd \0"); };
                this.e_reg(o, pb, 8);
                o.put_str(g", (%rsp)\n\0");
                if (sz == 4) { o.put_str(g"\tflds (%rsp)\n\0"); } else { o.put_str(g"\tfldl (%rsp)\n\0"); };
                o.put(9);
                if (sz == 4) { o.put_str(g"movss \0"); } else { o.put_str(g"movsd \0"); };
                this.e_reg(o, pa, 8);
                o.put_str(g", (%rsp)\n\0");
                if (sz == 4) { o.put_str(g"\tflds (%rsp)\n\0"); } else { o.put_str(g"\tfldl (%rsp)\n\0"); };
                o.put_str(g".LF\0");
                o.put_int(n);
                o.put_str(g":\n\tfprem\n\tfnstsw %ax\n\ttestb $4, %ah\n\tjne .LF\0");
                o.put_int(n);
                o.put_str(g"\n\tfstp %st(1)\n\0");
                if (sz == 4) { o.put_str(g"\tfstps (%rsp)\n\tmovss (%rsp), \0"); } else { o.put_str(g"\tfstpl (%rsp)\n\tmovsd (%rsp), \0"); };
                this.e_reg(o, pd, 8);
                o.put_str(g"\n\taddq $8, %rsp\n\0");
                ->;
            };

            // Conversions, the labels are numbered from the module counter
            e_cvt(Buf* o, MI* m) -> void
            {
                int k = m.cc;
                int sz = m.sz;
                MO* a = m.o0;
                MO* d = m.o1;
                int pa = this.s_phys(a.r);
                int pd = this.s_phys(d.r);
                int l1, l2;
                if (k == 1 | k == 2)
                {
                    o.put_str(g"\tcvt\0");
                    if (k == 1) { o.put_str(g"ss2sd \0"); } else { o.put_str(g"sd2ss \0"); };
                    this.e_reg(o, pa, 8);
                    o.put_str(g", \0");
                    this.e_reg(o, pd, 8);
                    o.put(10);
                    ->;
                };
                if (k == 3)
                {
                    o.put_str(g"\txorps \0");
                    this.e_reg(o, pd, 8);
                    o.put_str(g", \0");
                    this.e_reg(o, pd, 8);
                    o.put_str(g"\n\tcvtsi2\0");
                    if (sz == 4) { o.put_str(g"ssq \0"); } else { o.put_str(g"sdq \0"); };
                    this.e_reg(o, pa, 8);
                    o.put_str(g", \0");
                    this.e_reg(o, pd, 8);
                    o.put(10);
                    ->;
                };
                this.lab++;
                l1 = this.lab;
                this.lab++;
                l2 = this.lab;
                if (k == 4)
                {
                    // unsigned 64 bit value: halve it with the low bit kept when the top bit is set
                    o.put_str(g"\txorps \0");
                    this.e_reg(o, pd, 8);
                    o.put_str(g", \0");
                    this.e_reg(o, pd, 8);
                    o.put_str(g"\n\ttestq \0");
                    this.e_reg(o, pa, 8);
                    o.put_str(g", \0");
                    this.e_reg(o, pa, 8);
                    o.put_str(g"\n\tjs .LU\0");
                    o.put_int(l1);
                    o.put_str(g"\n\tcvtsi2\0");
                    if (sz == 4) { o.put_str(g"ssq \0"); } else { o.put_str(g"sdq \0"); };
                    this.e_reg(o, pa, 8);
                    o.put_str(g", \0");
                    this.e_reg(o, pd, 8);
                    o.put_str(g"\n\tjmp .LU\0");
                    o.put_int(l2);
                    o.put_str(g"\n.LU\0");
                    o.put_int(l1);
                    o.put_str(g":\n\tmovq \0");
                    this.e_reg(o, pa, 8);
                    o.put_str(g", %r10\n\tshrq %r10\n\tmovq \0");
                    this.e_reg(o, pa, 8);
                    o.put_str(g", %r11\n\tandl $1, %r11d\n\torq %r11, %r10\n\tcvtsi2\0");
                    if (sz == 4) { o.put_str(g"ssq %r10, \0"); } else { o.put_str(g"sdq %r10, \0"); };
                    this.e_reg(o, pd, 8);
                    o.put_str(g"\n\tadd\0");
                    if (sz == 4) { o.put_str(g"ss \0"); } else { o.put_str(g"sd \0"); };
                    this.e_reg(o, pd, 8);
                    o.put_str(g", \0");
                    this.e_reg(o, pd, 8);
                    o.put_str(g"\n.LU\0");
                    o.put_int(l2);
                    o.put_str(g":\n\0");
                    ->;
                };
                if (k == 5)
                {
                    o.put_str(g"\tcvtt\0");
                    if (sz == 4) { o.put_str(g"ss2siq \0"); } else { o.put_str(g"sd2siq \0"); };
                    this.e_reg(o, pa, 8);
                    o.put_str(g", \0");
                    this.e_reg(o, pd, 8);
                    o.put(10);
                    ->;
                };
                // unsigned 64 bit result: values from 2^63 up are converted after subtracting 2^63
                if (sz == 4) { o.put_str(g"\tmovl $0x5f000000, %r10d\n\tmovd %r10d, %xmm15\n\tucomiss %xmm15, \0"); }
                else { o.put_str(g"\tmovabsq $0x43e0000000000000, %r10\n\tmovq %r10, %xmm15\n\tucomisd %xmm15, \0"); };
                this.e_reg(o, pa, 8);
                o.put_str(g"\n\tjae .LU\0");
                o.put_int(l1);
                o.put_str(g"\n\tcvtt\0");
                if (sz == 4) { o.put_str(g"ss2siq \0"); } else { o.put_str(g"sd2siq \0"); };
                this.e_reg(o, pa, 8);
                o.put_str(g", \0");
                this.e_reg(o, pd, 8);
                o.put_str(g"\n\tjmp .LU\0");
                o.put_int(l2);
                o.put_str(g"\n.LU\0");
                o.put_int(l1);
                o.put_str(g":\n\tmovaps \0");
                this.e_reg(o, pa, 8);
                o.put_str(g", %xmm14\n\tsub\0");
                if (sz == 4) { o.put_str(g"ss %xmm15, %xmm14\n\tcvttss2siq %xmm14, \0"); } else { o.put_str(g"sd %xmm15, %xmm14\n\tcvttsd2siq %xmm14, \0"); };
                this.e_reg(o, pd, 8);
                o.put_str(g"\n\tmovabsq $0x8000000000000000, %r10\n\txorq %r10, \0");
                this.e_reg(o, pd, 8);
                o.put_str(g"\n.LU\0");
                o.put_int(l2);
                o.put_str(g":\n\0");
                ->;
            };

            s_inline(SI* x, IRValue* callee) -> void
            {
                byte* t = callee.text;
                IRType* fty = callee.ty.elem;
                IRType* rt = fty.elem;
                GF* g = this.sf;
                MI* m;
                MO* s;
                MO** sv;
                IRValue* a;
                byte* body;
                int len, i, j, bs, ce, qs, bodyend, no, ni, nop, used, cb, ce2, k, c, r, sz, d;
                int imask, omask, ln0, ln1, bl;
                int[40] opreg = noinit;
                int[40] opkind = noinit;
                int[40] opty = noinit;
                int[40] opx = noinit;
                int[40] opmem = noinit;
                int nxr, fo;
                IRType* ot;
                bool brace;
                int modc;
                len = 0;
                while (t[len] != 0) { len++; };
                while (len > 0 & t[len - 1] != 34) { len--; };
                ce = len - 1;
                qs = ce - 1;
                while (qs > 0 & t[qs] != 34) { qs--; };
                bodyend = qs - 3;
                bs = 0;
                while (t[bs] != 34) { bs++; };
                bs++;
                i = qs + 1;
                nop = 0;
                no = 0;
                ni = 0;
                used = 0;
                while (i < ce)
                {
                    cb = i;
                    while (i < ce & t[i] != ',') { i++; };
                    ce2 = i;
                    if (t[cb] == '~')
                    {
                        this.mb.clear();
                        j = cb + 2;
                        while (j < ce2 & t[j] != '}') { this.mb.put((int)t[j]); j++; };
                        r = this.a_regidx(this.mb.mem);
                        if (r >= 0) { used = used `| (1 << r); };
                    }
                    else
                    {
                        if (t[cb] == '=')
                        {
                            opkind[nop] = 1;
                            opreg[nop] = -1;
                            opx[nop] = -1;
                            opmem[nop] = 0;
                            if (t[ce2 - 1] == 'x') { opkind[nop] = 10; opx[nop] = -2; };
                            if (t[cb + 1] == '{' & t[cb + 2] == 'x' & t[cb + 3] == 'm') { opkind[nop] = 10; opx[nop] = (int)t[cb + 6] - 48; };
                            j = cb + 1;
                            while (j < ce2)
                            {
                                if (t[j] == '{')
                                {
                                    this.mb.clear();
                                    j++;
                                    while (j < ce2 & t[j] != '}') { this.mb.put((int)t[j]); j++; };
                                    r = this.a_regidx(this.mb.mem);
                                    opreg[nop] = r;
                                    if (r >= 0) { used = used `| (1 << r); };
                                };
                                if (t[j] == '&') { opkind[nop] = 3; };
                                j++;
                            };
                            nop++;
                            no++;
                        }
                        else
                        {
                            opkind[nop] = 2;
                            opreg[nop] = -1;
                            opx[nop] = -1;
                            opmem[nop] = 0;
                            if (t[cb] == 'm') { opmem[nop] = 1; };
                            if (t[ce2 - 1] == 'x') { opkind[nop] = 9; opx[nop] = -2; };
                            if (t[cb] == '{' & t[cb + 1] == 'x' & t[cb + 2] == 'm') { opkind[nop] = 9; opx[nop] = (int)t[cb + 5] - 48; };
                            if (t[cb] == '{' & opkind[nop] == 2)
                            {
                                this.mb.clear();
                                j = cb + 1;
                                while (j < ce2 & t[j] != '}') { this.mb.put((int)t[j]); j++; };
                                r = this.a_regidx(this.mb.mem);
                                opreg[nop] = r;
                                if (r >= 0) { used = used `| (1 << r); };
                            };
                            if (t[cb] >= 48 & t[cb] <= 57)
                            {
                                opkind[nop] = 4;
                                opreg[nop] = (int)t[cb] - 48;
                            };
                            if (t[cb] == 'i' | t[cb] == 'n') { opkind[nop] = 5; };
                            nop++;
                            ni++;
                        };
                    };
                    i = ce2 + 1;
                };
                if (x.n != ni) { this.s_fail(g"inline asm operands\0"); ->; };
                i = 0;
                while (i < no)
                {
                    if (no == 1) { opty[i] = this.a_size(rt); }
                    else { opty[i] = this.a_size(rt.items[i]); };
                    i++;
                };
                i = 0;
                while (i < ni)
                {
                    opty[no + i] = this.a_size(this.s_res(x.args[i]).ty);
                    i++;
                };
                nxr = 0;
                i = 0;
                while (i < nop)
                {
                    if (opx[i] == -2) { opx[i] = nxr; nxr++; };
                    i++;
                };
                i = no;
                while (i < nop)
                {
                    if (opkind[i] == 2 & opreg[i] < 0)
                    {
                        r = this.a_pick(used);
                        opreg[i] = r;
                        used = used `| (1 << r);
                    };
                    i++;
                };
                i = no;
                while (i < nop)
                {
                    if (opkind[i] == 4)
                    {
                        k = opreg[i];
                        if (opreg[k] < 0)
                        {
                            r = this.a_pick(used);
                            opreg[k] = r;
                            used = used `| (1 << r);
                        };
                        opreg[i] = opreg[k];
                    };
                    i++;
                };
                i = 0;
                while (i < no)
                {
                    if (opreg[i] < 0 & opkind[i] != 10)
                    {
                        r = -1;
                        if (opkind[i] != 3)
                        {
                            j = no;
                            while (j < nop & r < 0)
                            {
                                if (opkind[j] == 2 & opreg[j] >= 0 & !this.a_tied(@opreg[0], @opkind[0], no, nop, opreg[j]))
                                {
                                    r = opreg[j];
                                    opkind[j] = 6;
                                };
                                j++;
                            };
                        };
                        if (r < 0)
                        {
                            r = this.a_pick(used);
                            used = used `| (1 << r);
                        };
                        opreg[i] = r;
                    };
                    i++;
                };
                // operands first: they may need instructions of their own
                sv = (MO**)this.s_ar(8 * (ni + 1));
                i = 0;
                while (i < ni)
                {
                    a = this.s_res(x.args[i]);
                    k = opkind[no + i];
                    sv[i] = (MO*)0;
                    if (k == 5)
                    {
                        if (!this.s_isint(a)) { this.s_fail(g"inline asm constant\0"); ->; };
                    }
                    else
                    {
                        s = this.s_src(a);
                        sz = this.s_vsz(a.ty);
                        if (s.k == MK_REG & sz < 4 & !this.s_isfp(a.ty) & k != 9) { s = this.s_mo_r(this.s_ext(s.r, sz, false, 4), 4); };
                        sv[i] = s;
                    };
                    i++;
                };
                if (this.gwhy != 0) { ->; };
                // inputs go to their registers
                imask = 0;
                i = no;
                while (i < nop)
                {
                    s = sv[i - no];
                    k = opkind[i];
                    if (k == 2 | k == 6 | k == 4)
                    {
                        if (s.k == MK_REG) { s = this.s_mo_copy(s); s.sz = 8; };
                        this.s_mov(s, this.s_ahw(opreg[i]), 8);
                        imask = imask `| (1 << this.s_ahw(opreg[i]));
                    };
                    if (k == 9)
                    {
                        this.s_mi2(M_XMOV, this.s_vsz(this.s_res(x.args[i - no]).ty), s, this.s_mo_r(16 + opx[i], 8));
                        imask = imask `| (1 << (16 + opx[i]));
                    };
                    i++;
                };
                // body text, one tab indented line per source line
                this.mb.clear();
                this.mb.put(9);
                i = bs;
                while (i < bodyend)
                {
                    c = (int)t[i];
                    if (c == '$')
                    {
                        if (t[i + 1] == '$') { this.mb.put(36); i = i + 2; }
                        else
                        {
                            i++;
                            brace = false;
                            modc = 0;
                            if (t[i] == '{') { brace = true; i++; };
                            k = 0;
                            while (t[i] >= 48 & t[i] <= 57) { k = k * 10 + ((int)t[i] - 48); i++; };
                            if (brace)
                            {
                                if (t[i] == ':') { i++; modc = (int)t[i]; i++; };
                                if (t[i] == '}') { i++; };
                            };
                            sz = opty[k];
                            if (modc == 'q') { sz = 8; };
                            if (modc == 'k') { sz = 4; };
                            if (modc == 'w') { sz = 2; };
                            if (modc == 'b') { sz = 1; };
                            if (opkind[k] == 5)
                            {
                                this.s_isint(x.args[k - no]);
                                put_i64(@this.mb, this.scv);
                            }
                            else
                            {
                                if (opkind[k] == 9 | opkind[k] == 10)
                                {
                                    this.mb.put_str(g"%xmm\0");
                                    this.mb.put_int(opx[k]);
                                }
                                else
                                {
                                    if (opmem[k] == 1)
                                    {
                                        this.mb.put(40);
                                        this.e_reg(@this.mb, this.s_ahw(opreg[k]), 8);
                                        this.mb.put(41);
                                    }
                                    else { this.e_reg(@this.mb, this.s_ahw(opreg[k]), sz); };
                                };
                            };
                        };
                    }
                    else
                    {
                        if (c == 10) { this.mb.put(10); this.mb.put(9); }
                        else { this.mb.put(c); };
                        i++;
                    };
                };
                this.mb.put(10);
                bl = this.mb.len;
                body = this.s_ar(bl + 1);
                i = 0;
                while (i < bl) { body[i] = this.mb.mem[i]; i++; };
                body[bl] = 0;
                // registers the asm writes: outputs and everything it names
                omask = this.s_amask(used);
                i = 0;
                while (i < no)
                {
                    if (opkind[i] == 10) { omask = omask `| (1 << (16 + opx[i])); }
                    else { omask = omask `| (1 << this.s_ahw(opreg[i])); };
                    i++;
                };
                i = 0;
                while (i < ni)
                {
                    if (opkind[no + i] == 9) { omask = omask `| (1 << (16 + opx[no + i])); };
                    i++;
                };
                m = this.s_mi(M_ASM, 8);
                m.text = body;
                m.iu = imask;
                m.clob = omask;
                ((XGF*)g.tg).asmsv = ((XGF*)g.tg).asmsv `| omask;
                if (no > 1)
                {
                    // several outputs make a struct result, written field by field into a frame object
                    fo = this.s_newfo(this.a_size(rt), this.a_align(rt));
                    i = 0;
                    while (i < no)
                    {
                        ot = (IRType*)rt.items[i];
                        sz = this.s_vsz(ot);
                        s = this.s_mo_mem(0 - 1, 0 - 1, 1, (i64)this.a_foff(rt, i), (byte*)0, fo - 1);
                        if (opkind[i] == 10) { this.s_mi2(M_XMOV, sz, this.s_mo_r(16 + opx[i], 8), s); }
                        else { this.s_mi2(M_MOV, sz, this.s_mo_r(this.s_ahw(opreg[i]), sz), s); };
                        i++;
                    };
                    x.res.fo = fo;
                    ->;
                };
                i = 0;
                while (i < no)
                {
                    sz = this.s_vsz(rt);
                    if (opkind[i] == 10)
                    {
                        d = this.s_def(x.res, 1);
                        this.s_mi2(M_XMOV, sz, this.s_mo_r(16 + opx[i], 8), this.s_mo_r(d, sz));
                    }
                    else
                    {
                        d = this.s_def(x.res, 0);
                        if (sz < 4) { this.s_mi2(M_MOVZX, sz, this.s_mo_r(this.s_ahw(opreg[i]), sz), this.s_mo_r(d, 4)); }
                        else { this.s_mov(this.s_mo_r(this.s_ahw(opreg[i]), sz), d, sz); };
                    };
                    i++;
                };
                ->;
            };

            // The body of a naked function: the inline asm of its blocks exactly as written, no prologue
            s_naked(IRFunc* f, Buf* out) -> void
            {
                IRBlock* bl;
                SI* x;
                IRValue* callee;
                byte* t;
                int j, k, i, len, bs, bodyend, qs, ce, ls, le, c;
                byte* nm = this.a_sym(f.self.text);
                this.s_head(f, out);
                j = 0;
                while (j < f.blocks.len)
                {
                    bl = (IRBlock*)f.blocks.items[j];
                    out.put_str(g".LB\0");
                    out.put_int(bl.id);
                    out.put_str(g":\n\0");
                    k = 0;
                    while (bl.insts != (PtrVec*)0 & k < bl.insts.len)
                    {
                        x = (SI*)bl.insts.items[k];
                        k++;
                        if (x.op == SO_RETV) { out.put_str(g"\tleave\n\tret\n\0"); }
                        else
                        {
                            if (x.op == SO_UNREACH) { out.put_str(g"\tud2\n\0"); }
                            else
                            {
                                if (x.op == SO_BR)
                                {
                                    out.put_str(g"\tjmp .LB\0");
                                    out.put_int(x.t.id);
                                    out.put(10);
                                }
                                else
                                {
                                    callee = x.a;
                                    if (x.op != SO_CALL | callee == (IRValue*)0) { this.s_fail(g"naked body\0"); ->; };
                                    if (!this.a_pre(callee.text, g"asm\0")) { this.s_fail(g"naked body\0"); ->; };
                                    t = callee.text;
                                    len = 0;
                                    while (t[len] != 0) { len++; };
                                    while (len > 0 & t[len - 1] != 34) { len--; };
                                    ce = len - 1;
                                    qs = ce - 1;
                                    while (qs > 0 & t[qs] != 34) { qs--; };
                                    bodyend = qs - 3;
                                    bs = 0;
                                    while (t[bs] != 34) { bs++; };
                                    bs++;
                                    this.mb.clear();
                                    i = bs;
                                    while (i < bodyend)
                                    {
                                        c = (int)t[i];
                                        if (c == '$')
                                        {
                                            if (t[i + 1] != '$') { this.s_fail(g"naked operand\0"); ->; };
                                            this.mb.put(36);
                                            i = i + 2;
                                        }
                                        else { this.mb.put(c); i++; };
                                    };
                                    // one trimmed line at a time
                                    i = 0;
                                    while (i <= this.mb.len)
                                    {
                                        ls = i;
                                        while (i < this.mb.len & this.mb.mem[i] != 10) { i++; };
                                        le = i;
                                        while (ls < le & (this.mb.mem[ls] == ' ' | this.mb.mem[ls] == 9 | this.mb.mem[ls] == 13)) { ls++; };
                                        while (le > ls & (this.mb.mem[le - 1] == ' ' | this.mb.mem[le - 1] == 9 | this.mb.mem[le - 1] == 13)) { le--; };
                                        if (le > ls)
                                        {
                                            out.put(9);
                                            out.put_n(this.mb.mem + ls, le - ls);
                                            out.put(10);
                                        };
                                        i++;
                                    };
                                };
                            };
                        };
                    };
                    j++;
                };
                if (!this.a_win())
                {
                    out.put_str(g"\t.size \0");
                    out.put_str(nm);
                    out.put_str(g", .-\0");
                    out.put_str(nm);
                    out.put(10);
                };
                ->;
            };

            // ==========================================================
            // driver: one function from the recorded instructions to assembly text.
            // ==========================================================

            // Releases the state of the backend kept in g.tg
            s_tgt_free(GF* g) -> void
            {
                XGF* t = (XGF*)g.tg;
                pv_free(t.fobj);
                ffree((byte*)t);
                g.tg = (void*)0;
                ->;
            };

            // Makes the per function state
            s_gf_new(IRFunc* f) -> GF*
            {
                GF* g = (GF*)fmalloc((u64)(((sizeof(GF) + 7) / 8) * 2));
                g.tg = (void*)fmalloc((u64)(((sizeof(XGF) + 7) / 8) * 2));
                g.f = f;
                g.bl = pv_new();
                g.rpo = (GB**)0;
                g.nb = 0;
                g.nvr = R_VBASE;
                g.capvr = 0;
                g.vcls = (int*)0;
                g.vwgt = (int*)0;
                g.vcol = (int*)0;
                g.vslot = (int*)0;
                g.vforb = (i64*)0;
                g.vhint = (int*)0;
                g.vdef = (int*)0;
                g.vglob = (int*)0;
                g.vuse = (int*)0;
                g.nglob = 0;
                ((XGF*)g.tg).outmax = 0;
                ((XGF*)g.tg).fobj = pv_new();
                ((XGF*)g.tg).saved = 0;
                ((XGF*)g.tg).asmsv = 0;
                ((XGF*)g.tg).sretv = 0;
                ((XGF*)g.tg).vagp = 0;
                ((XGF*)g.tg).vafp = 0;
                ((XGF*)g.tg).vastk = 0;
                ((XGF*)g.tg).vafo = 0;
                ((XGF*)g.tg).frame = 0;
                ((XGF*)g.tg).csbase = 0;
                ((XGF*)g.tg).dyn = false;
                ((XGF*)g.tg).nofp = false;
                ((XGF*)g.tg).sw = false;
                g.mlast = 0;
                g.rcap = 0;
                g.nl = 0;
                g.occ = 0;
                ((XGF*)g.tg).csbase2 = 0;
                g.lpos = (int*)0;
                g.llist = (int*)0;
                g.gv = (int*)0;
                g.gw = (int*)0;
                g.cur = (int*)0;
                ((XGF*)g.tg).csoff = (int*)0;
                -> g;
            };

            // Compiles f with the SSA code generator. Returns false when the function needs something the
            // code generator cannot do yet, the caller then keeps the text the builder wrote.
            s_func(IRFunc* f, Buf* out) -> bool
            {
                bool ok;
                this.gwhy = 0;
                this.gwhys = (byte*)0;
                this.cf = f;
                // the register names are needed from selection on (inline asm operands), not only when writing
                this.s_rnames();
                if (this.a_naked(f))
                {
                    this.s_naked(f, out);
                    -> this.gwhy == 0;
                };
                this.sf = this.s_gf_new(f);
                ok = this.s_cfg();
                if (ok)
                {
                    this.s_prep();
                    this.s_promote();
                    if (SSA_OPT_FOLD == 1) { this.s_opt(); };
                    this.s_prep();
                    ok = this.s_recfg();
                    if (ok & SSA_OPT_MERGE == 1)
                    {
                        if (this.s_merge()) { ok = this.s_recfg(); };
                    };
                    if (ok) { ok = this.s_passes(); };
                    if (ok)
                    {
                        this.s_dce();
                        this.s_loops();
                        if (SSA_OPT_SINK == 1) { this.s_sink(); };
                        ok = this.s_isel();
                        if (ok & SSA_OPT_STMERGE == 1) { this.s_stmerge(); };
                    };
                    if (ok) { ok = this.s_edges(); };
                    if (ok & SSA_OPT_TAILDUP == 1) { this.s_taildup(); };
                    if (ok & SSA_OPT_MDCE == 1) { this.s_mdce(); };
                    if (ok & SSA_OPT_XP == 1) { this.s_xp(); };
                    if (ok) { ok = this.s_ra(); };
                    if (ok & SSA_OPT_SCHED == 1) { this.s_sched(); };
                    if (ok)
                    {
                        this.eo.len = 0;
                        this.s_emit(f, @this.eo);
                        if (this.gwhy != 0) { ok = false; };
                        if (ok & SSA_OPT_PEEP == 1) { this.s_peep(@this.eo); };
                        if (ok) { out.put_n(this.eo.mem, this.eo.len); };
                    };
                };
                this.s_ar_free();
                this.s_gf_free(f);
                if (this.gwhy != 0) { ok = false; };
                -> ok;
            };

        };

    };
};

#endif;
