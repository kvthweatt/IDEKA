// Author: Karac V. Thweatt
//
// ix64.idk - x86_64 assembly backend (System V, AT&T syntax)
//
// Backend counterpart of the LLVM IR text builder (i_llvmir.idk). It has no dependency on
// LLVM IR. It builds the shared code model (imodel.idk) and its builder methods select
// x86_64 instructions and write assembly directly.
//
// Model: every SSA value lives in an 8 byte frame slot (aggregates in a slot of their own
// size). Integers are kept zero extended to 64 bits, floats as raw bits. Each instruction
// loads its operands into scratch registers, computes and stores the result. A register
// allocator can replace this later without changing the builder interface.
//
// Registers: 0 rax 1 rcx 2 rdx 3 rsi 4 rdi 5 r8 6 r9 7 r10 8 r11 9 rbx 10 r12 11 r13 12 r14 13 r15
//
// Aggregates (structs and arrays) are passed by value as stack copies and returned through a
// hidden pointer in rdi, like the System V ABI does for memory class values.
//
// Ownership: every IRType, IRValue, string and block made through an X64Module
// belongs to that module and is released by X64Module.__exit.
//
#ifndef IDEKA_STANDARD
#import <standard.idk>;
#endif;

#ifndef IDEKA_AST
#import "iast.idk";
#endif;

#ifndef IDEKA_TYPES
#import "itypesys.idk";
#endif;

#ifndef IDEKA_MODEL
#import "imodel.idk";
#endif;

#ifndef IDEKA_X64
#def IDEKA_X64 1;

using IDEKA::ast;
using IDEKA::preprocessor;
using IDEKA::types;
using IDEKA::ir;

namespace IDEKA
{
    namespace x64
    {
        // ------------------------------------------------------------------
        // Module
        // ------------------------------------------------------------------

        object X64Module
        {
            byte* mod_name, triple, layout;
            PtrVec* types;      // IRType* made here
            PtrVec* values;     // IRValue* made here
            PtrVec* strs;       // byte* made here
            PtrVec* blobs;      // raw allocations (item arrays, blocks)
            PtrVec* named;      // identified struct types in creation order
            PtrVec* globals;    // IRGlobal*
            PtrVec* funcs;      // IRFunc*
            NameMap* gnames;    // global and function names in use
            NameMap* fmap;      // function name to IRFunc*
            NameMap* gmap;      // global name to IRGlobal*
            Buf tb;             // text scratch
            IRFunc* cf;         // function being built
            IRBlock* cb;        // insertion block
            IRBlock* entry_b;   // entry block of cf
            IRValue** ia;       // small operand scratch
            IRType* nul;        // elem of types that have none, so elem.kind is always readable
            bool a_handled;
            int abi;            // 0 System V, 1 Win64
            bool must_tail;     // set by the code generator before a tail call
            int lab, nunsup, zmax;
            byte** rtab;
            byte* cx_sym;
            i64 cx_off;
            Buf ab, mb, cdata;

            __init(byte* name) -> this
            {
                this.mod_name = ts_dup(name);
                this.triple = (byte*)0;
                this.layout = (byte*)0;
                this.nul = (IRType*)0;
                this.types = pv_new();
                this.values = pv_new();
                this.strs = pv_new();
                this.blobs = pv_new();
                this.named = pv_new();
                this.globals = pv_new();
                this.funcs = pv_new();
                this.gnames = nm_new();
                this.fmap = nm_new();
                this.gmap = nm_new();
                this.tb.__init();
                this.ab.__init();
                this.mb.__init();
                this.cdata.__init();
                this.a_handled = false;
                this.lab = 0;
                this.nunsup = 0;
                this.zmax = 0;
                this.cf = (IRFunc*)0;
                this.cb = (IRBlock*)0;
                this.entry_b = (IRBlock*)0;
                this.ia = (IRValue**)fmalloc((u64)8 * (u64)((sizeof(IRValue*) + 7) / 8));
                this.nul = this.new_type(LK.VOID);
                this.nul.elem = this.nul;
                this.must_tail = false;
                this.a_init();
                -> this;
            };

            __expr() -> X64Module* -> this;

            __exit() -> void
            {
                int i, j;
                IRFunc* f;
                IRBlock* bl;
                while (i < this.types.len)
                {
                    ffree((byte*)this.types.items[i]);
                    i++;
                };
                i = 0;
                while (i < this.values.len)
                {
                    ffree((byte*)this.values.items[i]);
                    i++;
                };
                i = 0;
                while (i < this.strs.len)
                {
                    ffree((byte*)this.strs.items[i]);
                    i++;
                };
                i = 0;
                while (i < this.blobs.len)
                {
                    ffree((byte*)this.blobs.items[i]);
                    i++;
                };
                i = 0;
                while (i < this.funcs.len)
                {
                    f = (IRFunc*)this.funcs.items[i];
                    j = 0;
                    while (j < f.blocks.len)
                    {
                        bl = (IRBlock*)f.blocks.items[j];
                        pv_free(bl.lines);
                        ffree((byte*)bl);
                        j++;
                    };
                    pv_free(f.blocks);
                    pv_free(f.attrs);
                    nm_free(f.names);
                    ffree((byte*)f.args);
                    ffree((byte*)f);
                    i++;
                };
                i = 0;
                while (i < this.globals.len)
                {
                    ffree((byte*)this.globals.items[i]);
                    i++;
                };
                pv_free(this.types);
                pv_free(this.values);
                pv_free(this.strs);
                pv_free(this.blobs);
                pv_free(this.named);
                pv_free(this.globals);
                pv_free(this.funcs);
                nm_free(this.gnames);
                nm_free(this.fmap);
                nm_free(this.gmap);
                ffree(this.mod_name);
                switch (this.triple != (byte*)0)
                {
                    case (true) { ffree(this.triple); }
                    default {};
                };
                switch (this.layout != (byte*)0)
                {
                    case (true) { ffree(this.layout); }
                    default {};
                };
                this.tb.__exit();
                this.ab.__exit();
                this.mb.__exit();
                this.cdata.__exit();
                -> ffree((byte*)this.ia);
            };

            set_target(byte* triple, byte* layout) -> void
            {
                this.triple = ts_dup(triple);
                this.layout = ts_dup(layout);
                ->;
            };

            // Owned copy of s
            own(byte* s) -> byte*
            {
                byte* r = ts_dup(s);
                pv_push(this.strs, (void*)r);
                -> r;
            };

            alloc_items(int n) -> IRType**
            {
                IRType** p = (IRType**)fmalloc((u64)(n + 1) * (u64)((sizeof(IRType*) + 7) / 8));
                pv_push(this.blobs, (void*)p);
                -> p;
            };

            new_type(int kind) -> IRType*
            {
                IRType* t = (IRType*)fmalloc((u64)((sizeof(IRType) + 7) / 8));
                t.kind = kind;
                t.width = 0;
                t.count = 0;
                t.elem = this.nul;
                t.items = (IRType**)0;
                t.nitems = 0;
                t.name = (byte*)0;
                t.vararg = false;
                t.defined = true;
                pv_push(this.types, (void*)t);
                -> t;
            };

            t_void() -> IRType* -> this.new_type(LK.VOID);
            t_float() -> IRType* -> this.new_type(LK.FLOAT);
            t_double() -> IRType* -> this.new_type(LK.DOUBLE);

            t_int(int width) -> IRType*
            {
                IRType* t = this.new_type(LK.INT);
                t.width = width;
                -> t;
            };

            t_ptr(IRType* elem) -> IRType*
            {
                IRType* t = this.new_type(LK.PTR);
                t.elem = elem;
                -> t;
            };

            t_array(IRType* elem, int count) -> IRType*
            {
                IRType* t = this.new_type(LK.ARRAY);
                t.elem = elem;
                t.count = count;
                -> t;
            };

            // Literal struct over the first n entries of items (copied)
            t_struct(IRType** items, int n) -> IRType*
            {
                int i;
                IRType* t = this.new_type(LK.STRUCT);
                t.items = this.alloc_items(n);
                while (i < n)
                {
                    t.items[i] = items[i];
                    i++;
                };
                t.nitems = n;
                -> t;
            };

            t_func(IRType* ret, IRType** params, int n, bool vararg) -> IRType*
            {
                int i;
                IRType* t = this.new_type(LK.FUNC);
                t.elem = ret;
                t.items = this.alloc_items(n);
                while (i < n)
                {
                    t.items[i] = params[i];
                    i++;
                };
                t.nitems = n;
                t.vararg = vararg;
                -> t;
            };

            // Identified struct, body set later with set_body. Returns the existing one
            // when the name is already in use.
            t_named(byte* name) -> IRType*
            {
                int i;
                IRType* t;
                while (i < this.named.len)
                {
                    t = (IRType*)this.named.items[i];
                    switch (cstr_eq(t.name, name))
                    {
                        case (true) { -> t; }
                        default
                        {
                            i++;
                        };
                    };
                };
                t = this.new_type(LK.ISTRUCT);
                t.name = this.own(name);
                t.defined = false;
                pv_push(this.named, (void*)t);
                -> t;
            };

            set_body(IRType* t, IRType** items, int n) -> void
            {
                int i;
                t.items = this.alloc_items(n);
                while (i < n)
                {
                    t.items[i] = items[i];
                    i++;
                };
                t.nitems = n;
                t.defined = true;
                ->;
            };

            type_str(IRType* t) -> byte*
            {
                this.tb.clear();
                lt_text(@this.tb, t);
                -> this.own(this.tb.mem);
            };

            // ----------------------------------------------------------
            // Values
            // ----------------------------------------------------------

            new_value(IRType* ty, byte* text) -> IRValue*
            {
                IRValue* v = (IRValue*)fmalloc((u64)((sizeof(IRValue) + 7) / 8));
                v.ty = ty;
                v.text = this.own(text);
                v.spec = (TypeSpec*)0;
                v.espec = (TypeSpec*)0;
                v.flags = 0;
                v.slot = 0;
                v.is_const = false;
                pv_push(this.values, (void*)v);
                -> v;
            };

            c_int(IRType* ty, i64 val) -> IRValue*
            {
                IRValue* v;
                this.tb.clear();
                switch (ty.width)
                {
                    case (1)
                    {
                        switch (val != (i64)0)
                        {
                            case (true) { this.tb.put_str(g"true\0"); }
                            default { this.tb.put_str(g"false\0"); };
                        };
                    }
                    default { put_i64(@this.tb, val); };
                };
                v = this.new_value(ty, this.tb.mem);
                v.is_const = true;
                -> v;
            };

            // Unsigned 64 bit constant: a Python int above INT64_MAX prints as is
            c_u64(IRType* ty, u64 val) -> IRValue*
            {
                IRValue* v;
                this.tb.clear();
                put_u64(@this.tb, val);
                v = this.new_value(ty, this.tb.mem);
                v.is_const = true;
                -> v;
            };

            c_null(IRType* ty) -> IRValue*
            {
                IRValue* v;
                switch (ty.kind)
                {
                    case (LK.PTR) { v = this.new_value(ty, g"null\0"); }
                    case (LK.INT)
                    {
                        v = this.c_int(ty, 0);
                        // llvmlite formats Constant(i1, 0) as 0, only a Python bool prints false
                        switch (ty.width == 1)
                        {
                            case (true) { v.text = g"0\0"; }
                            default {};
                        };
                        -> v;
                    }
                    default
                    {
                        switch (ty.kind == LK.FLOAT | ty.kind == LK.DOUBLE)
                        {
                            case (true) {
                            v = this.c_fp(ty, 0.0);
                            -> v;
                        }
                            default { v = this.new_value(ty, g"zeroinitializer\0"); };
                        };
                    };
                };
                v.is_const = true;
                -> v;
            };

            c_undef(IRType* ty) -> IRValue*
            {
                IRValue* v = this.new_value(ty, g"undef\0");
                v.is_const = true;
                -> v;
            };

            // Floating point constant. llvmlite prints the double bit pattern for both
            // float and double.
            c_fp(IRType* ty, double d) -> IRValue*
            {
                IRValue* v;
                float f;
                double dd = d;
                u64 bits;
                u64* bp;
                switch (ty.kind == LK.FLOAT)
                {
                    case (true) {
                    f = (float)d;
                    dd = (double)f;
                }
                    default {};
                };
                bp = (u64*)@dd;
                bits = *bp;
                this.tb.clear();
                put_hex64(@this.tb, bits);
                v = this.new_value(ty, this.tb.mem);
                v.is_const = true;
                -> v;
            };

            // Constant array literal [ty v, ty v, ...] as llvmlite prints it
            c_array(IRType* ty, IRValue** elems, int n) -> IRValue*
            {
                IRValue* v;
                int i;
                this.tb.clear();
                this.tb.put(91);
                while (i < n)
                {
                    switch (i > 0) { case (true) { this.tb.put_str(g", \0"); } default {}; };
                    lt_text(@this.tb, elems[i].ty);
                    this.tb.put(32);
                    this.tb.put_str(elems[i].text);
                    i++;
                };
                this.tb.put(93);
                v = this.new_value(ty, this.tb.mem);
                v.is_const = true;
                -> v;
            };

            // c"..." constant over n bytes
            c_bytes(IRType* ty, byte* bytes_in, int n) -> IRValue*
            {
                IRValue* v;
                int i, c;
                this.tb.clear();
                this.tb.put_str(g"c\"\0");
                while (i < n)
                {
                    c = (int)bytes_in[i];
                    switch (c < 32 | c > 126 | c == 34 | c == 92)
                    {
                        case (true) {
                        this.tb.put(92);
                        this.tb.put(hexdig(c / 16));
                        this.tb.put(hexdig(c % 16));
                    }
                        default { this.tb.put(c); };
                    };
                    i++;
                };
                this.tb.put(34);
                v = this.new_value(ty, this.tb.mem);
                v.is_const = true;
                -> v;
            };

            // Operand text "type value"
            unique_global(byte* name) -> byte*
            {
                int n = 1;
                byte* cand;
                switch (!nm_has(this.gnames, name))
                {
                    case (true) { -> this.own(name); }
                    default
                    {
                        while (true)
                        {
                            this.tb.clear();
                            this.tb.put_str(name);
                            this.tb.put(46);
                            this.tb.put_int(n);
                            cand = this.tb.mem;
                            switch (!nm_has(this.gnames, cand))
                            {
                                case (true) { -> this.own(cand); }
                                default
                                {
                                    n++;
                                };
                            };
                        };
                        -> this.own(name);
                    };
                };
            };

            // Global variable of type ty. init is the initializer operand text or null.
            add_global(IRType* ty, byte* name, byte* init) -> IRGlobal*
            {
                IRGlobal* g = (IRGlobal*)fmalloc((u64)((sizeof(IRGlobal) + 7) / 8));
                g.name = this.unique_global(name);
                nm_put(this.gnames, g.name, (void*)g);
                nm_put(this.gmap, g.name, (void*)g);
                g.ty = ty;
                g.init = (byte*)0;
                switch (init != (byte*)0)
                {
                    case (true) { g.init = this.own(init); }
                    default {};
                };
                g.linkage = (byte*)0;
                g.constant = false;
                this.tb.clear();
                this.tb.put(64);
                put_quoted(@this.tb, g.name);
                g.self = this.new_value(this.t_ptr(ty), this.tb.mem);
                g.self.flags = VF_GLOBAL;
                pv_push(this.globals, (void*)g);
                -> g;
            };

            find_global(byte* name) -> IRGlobal* -> (IRGlobal*)nm_get(this.gmap, name);

            // Function with the given type. A function becomes a declaration until a
            // block is appended to it.
            add_function(IRType* ftype, byte* name) -> IRFunc*
            {
                int i;
                IRFunc* f = (IRFunc*)fmalloc((u64)((sizeof(IRFunc) + 7) / 8));
                f.name = this.unique_global(name);
                nm_put(this.gnames, f.name, (void*)f);
                nm_put(this.fmap, f.name, (void*)f);
                f.ftype = ftype;
                f.nargs = ftype.nitems;
                f.args = (IRValue**)fmalloc((u64)(f.nargs + 1) * (u64)((sizeof(IRValue*) + 7) / 8));
                f.blocks = pv_new();
                f.attrs = pv_new();
                f.names = nm_new();
                f.counter = 0;
                f.cconv = (byte*)0;
                f.linkage = (byte*)0;
                f.is_decl = true;
                f.frame = 0;
                f.sret_slot = 0;
                f.cs_mask = 0;
                f.cs = (int*)0;
                while (i < f.nargs)
                {
                    f.counter = f.counter + 1;
                    this.tb.clear();
                    this.tb.put(37);
                    this.tb.put_str(f"\".{f.counter}\0");
                    this.tb.put(34);
                    f.args[i] = this.new_value(ftype.items[i], this.tb.mem);
                    i++;
                };
                this.tb.clear();
                this.tb.put(64);
                put_quoted(@this.tb, f.name);
                f.counter = f.counter + 1;
                f.self = this.new_value(this.t_ptr(ftype), this.tb.mem);
                pv_push(this.funcs, (void*)f);
                -> f;
            };

            find_function(byte* name) -> IRFunc* -> (IRFunc*)nm_get(this.fmap, name);

            // Names parameter i (llvmlite Argument.name = ...)
            name_arg(IRFunc* f, int i, byte* name) -> void
            {
                this.tb.clear();
                this.tb.put(37);
                put_quoted(@this.tb, name);
                f.args[i].text = this.own(this.tb.mem);
                -> nm_put(f.names, name, (void*)f);
            };

            // Gives parameter i a new name, kept unique inside f
            rename_arg(IRFunc* f, int i, byte* name) -> void
            {
                byte* nm = this.fresh_name(f, name);
                f.args[i].text = this.result_text(nm);
                ->;
            };

            // A name unique inside f: base when free, else base.N
            fresh_name(IRFunc* f, byte* base) -> byte*
            {
                int n = 1;
                byte* cand;
                switch (base == (byte*)0)
                {
                    case (true) {
                    f.counter = f.counter + 1;
                    this.tb.clear();
                    this.tb.put(46);
                    this.tb.put_int(f.counter);
                    -> this.own(this.tb.mem);
                }
                    default
                    {
                        switch (base[0] == 0)
                        {
                            case (true) {
                            f.counter = f.counter + 1;
                            this.tb.clear();
                            this.tb.put(46);
                            this.tb.put_int(f.counter);
                            -> this.own(this.tb.mem);
                        }
                            default
                            {
                                switch (!nm_has(f.names, base))
                                {
                                    case (true) {
                                    nm_put(f.names, base, (void*)f);
                                    -> this.own(base);
                                }
                                    default
                                    {
                                        while (true)
                                        {
                                            this.tb.clear();
                                            this.tb.put_str(base);
                                            this.tb.put(46);
                                            this.tb.put_int(n);
                                            cand = this.tb.mem;
                                            switch (!nm_has(f.names, cand))
                                            {
                                                case (true) {
                                                nm_put(f.names, cand, (void*)f);
                                                -> this.own(cand);
                                            }
                                                default
                                                {
                                                    n++;
                                                };
                                            };
                                        };
                                        -> this.own(base);
                                    };
                                };
                            };
                        };
                    };
                };
            };

            append_block(IRFunc* f, byte* name) -> IRBlock*
            {
                IRBlock* bl = (IRBlock*)fmalloc((u64)((sizeof(IRBlock) + 7) / 8));
                bl.name = this.fresh_name(f, name);
                bl.lines = pv_new();
                bl.terminated = false;
                bl.term_at = 0;
                bl.id = 0;
                bl.id = this.lab;
                this.lab++;
                switch (f.blocks.len == 0) { case (true) { this.a_func_begin(f); } default {}; };
                pv_push(f.blocks, (void*)bl);
                f.is_decl = false;
                -> bl;
            };

            // ----------------------------------------------------------
            // Instruction builder
            // ----------------------------------------------------------

            position(IRFunc* f, IRBlock* b) -> void
            {
                this.cf = f;
                this.cb = b;
                ->;
            };

            set_entry(IRBlock* b) -> void
            {
                this.entry_b = b;
                ->;
            };

            is_terminated() -> bool
            {
                switch (this.cb == (IRBlock*)0)
                {
                    case (true) { -> true; }
                    default
                    {
                        -> this.cb.terminated;
                    };
                };
            };

            const_val(IRValue* v) -> i64
            {
                int i;
                bool neg = false;
                i64 r;
                switch (v.text[0] == 45)
                {
                    case (true) { neg = true; i = 1; }
                    default {};
                };
                while (v.text[i] >= 48 & v.text[i] <= 57)
                {
                    r = r * (i64)10 + (i64)((int)v.text[i] - 48);
                    i++;
                };
                switch (neg)
                {
                    case (true) { -> (i64)0 - r; }
                    default
                    {
                        -> r;
                    };
                };
            };

            // Operand text "%name" for a fresh result
            result_text(byte* name) -> byte*
            {
                this.tb.clear();
                this.tb.put(37);
                put_quoted(@this.tb, name);
                -> this.own(this.tb.mem);
            };

            // Ends the instruction held in ib. A typed result gets a name (hint, or the
            // next .N); a void one still takes the next .N.
            binop(byte* op, IRValue* a, IRValue* b, byte* hint) -> IRValue*
            {
                -> this.a_binop(op, a, b, hint);
            };

            cmp(byte* kind, byte* pred, IRValue* a, IRValue* b, byte* hint) -> IRValue*
            {
                -> this.a_cmp(kind, pred, a, b, hint);
            };

            icmp(byte* pred, IRValue* a, IRValue* b, byte* hint) -> IRValue* -> this.cmp(g"icmp\0", pred, a, b, hint);

            fcmp(byte* pred, IRValue* a, IRValue* b, byte* hint) -> IRValue* -> this.cmp(g"fcmp\0", pred, a, b, hint);

            cast(byte* op, IRValue* v, IRType* to, byte* hint) -> IRValue*
            {
                switch (lt_eq(v.ty, to))
                {
                    case (true) { -> v; }
                    default { -> this.a_cast(op, v, to, hint); };
                };
            };

            alloca(IRType* ty, byte* name) -> IRValue*
            {
                -> this.a_alloca(ty, name);
            };

            alloca_here(IRType* ty, byte* name) -> IRValue*
            {
                -> this.a_alloca(ty, name);
            };

            alloca_count(IRType* ty, IRValue* count, byte* name) -> IRValue*
            {
                -> this.a_alloca_count(ty, count, name);
            };

            load(IRValue* p, byte* hint) -> IRValue*
            {
                -> this.a_load(p, hint);
            };

            store_ex(IRValue* v, IRValue* p, bool vol) -> void
            {
                this.a_store(v, p, vol);
                ->;
            };

            store(IRValue* v, IRValue* p) -> void -> this.store_ex(v, p, false);

            // Type reached by indexing t with idx (struct needs a constant)
            index_type(IRType* t, IRValue* idx) -> IRType*
            {
                switch (t.kind == LK.ARRAY)
                {
                    case (true) { -> t.elem; }
                    default
                    {
                        switch (t.kind == LK.PTR)
                        {
                            case (true) { -> t.elem; }
                            default
                            {
                                -> t.items[(int)this.const_val(idx)];
                            };
                        };
                    };
                };
            };

            struct_items(IRType* t) -> IRType** -> t.items;

            gep(IRValue* p, IRValue** idx, int n, bool inbounds, byte* hint) -> IRValue*
            {
                -> this.a_gep(p, idx, n, inbounds, hint);
            };

            struct_body_item(IRType* t, int i) -> IRType* -> t.items[i];

            // gep p, 0, i  (struct field address)
            gep_field(IRValue* p, int i, bool inbounds, byte* hint) -> IRValue*
            {
                this.ia[0] = this.c_int(this.t_int(32), 0);
                this.ia[1] = this.c_int(this.t_int(32), (i64)i);
                -> this.gep(p, this.ia, 2, inbounds, hint);
            };

            // gep p, i  (pointer arithmetic)
            gep_ptr(IRValue* p, IRValue* i, bool inbounds, byte* hint) -> IRValue*
            {
                this.ia[0] = i;
                -> this.gep(p, this.ia, 1, inbounds, hint);
            };

            call_ex(IRValue* callee, IRValue** args, int n, byte* hint, byte* cconv, bool tail) -> IRValue*
            {
                -> this.a_call(callee, args, n, hint, tail);
            };

            call(IRValue* callee, IRValue** args, int n, byte* hint) -> IRValue* -> this.call_ex(callee, args, n, hint, (byte*)0, false);

            phi(IRType* ty, IRValue** vals, IRBlock** blocks, int n, byte* hint) -> IRValue*
            {
                -> this.a_phi(ty, vals, blocks, n, hint);
            };

            va_arg(IRValue* list, IRType* ty, byte* hint) -> IRValue*
            {
                -> this.a_va_arg(list, ty, hint);
            };

            select(IRValue* c, IRValue* a, IRValue* b, byte* hint) -> IRValue*
            {
                -> this.a_select(c, a, b, hint);
            };

            extractvalue(IRValue* agg, int i, byte* hint) -> IRValue*
            {
                -> this.a_extractvalue(agg, i, hint);
            };

            insertvalue(IRValue* agg, IRValue* v, int i, byte* hint) -> IRValue*
            {
                -> this.a_insertvalue(agg, v, i, hint);
            };

            br(IRBlock* target) -> void
            {
                this.a_br(target);
                ->;
            };

            cbr(IRValue* c, IRBlock* t, IRBlock* f) -> void
            {
                this.a_cbr(c, t, f);
                ->;
            };

            ret(IRValue* v) -> void
            {
                this.a_ret(v);
                ->;
            };

            ret_void() -> void
            {
                this.a_ret_void();
                ->;
            };

            unreachable() -> void
            {
                this.a_unreachable();
                ->;
            };

            switch_to(IRValue* v, IRBlock* dflt, IRValue** vals, IRBlock** blocks, int n) -> void
            {
                this.a_switch(v, dflt, vals, blocks, n);
                ->;
            };

            a_init() -> void
            {
                int r, k;
                byte* base;
                this.rtab = (byte**)fmalloc((u64)(14 * 4 * 8));
                while (r < 14)
                {
                    k = 0;
                    while (k < 4)
                    {
                        this.tb.clear();
                        this.tb.put(37);
                        switch (r)
                        {
                            case (0) { this.a_rn(k, g"ax\0", g"al\0"); }
                            case (1) { this.a_rn(k, g"cx\0", g"cl\0"); }
                            case (2) { this.a_rn(k, g"dx\0", g"dl\0"); }
                            case (3) { this.a_rn(k, g"si\0", g"sil\0"); }
                            case (4) { this.a_rn(k, g"di\0", g"dil\0"); }
                            case (9) { this.a_rn(k, g"bx\0", g"bl\0"); }
                            default
                            {
                                this.tb.put(114);
                                switch (r)
                                {
                                    case (5) { this.tb.put_int(8); }
                                    case (6) { this.tb.put_int(9); }
                                    case (7) { this.tb.put_int(10); }
                                    case (8) { this.tb.put_int(11); }
                                    default { this.tb.put_int(r + 2); };
                                };
                                switch (k)
                                {
                                    case (1) { this.tb.put(100); }
                                    case (2) { this.tb.put(119); }
                                    case (3) { this.tb.put(98); }
                                    default {};
                                };
                            };
                        };
                        this.rtab[r * 4 + k] = this.own(this.tb.mem);
                        k++;
                    };
                    r++;
                };
                ->;
            };

            // Appends the name of a legacy register for size index k (0 q, 1 d, 2 w, 3 b)
            a_rn(int k, byte* w, byte* b) -> void
            {
                switch (k)
                {
                    case (0) { this.tb.put(114); this.tb.put_str(w); }
                    case (1) { this.tb.put(101); this.tb.put_str(w); }
                    case (2) { this.tb.put_str(w); }
                    default { this.tb.put_str(b); };
                };
                ->;
            };

            a_reg(int r, int sz) -> byte*
            {
                int k;
                switch (sz)
                {
                    case (4) { k = 1; }
                    case (2) { k = 2; }
                    case (1) { k = 3; }
                    default {};
                };
                -> this.rtab[r * 4 + k];
            };

            // Register for a value of type t
            a_regt(int r, IRType* t) -> byte*
            {
                int sz = this.a_size(t);
                if (sz > 8) { sz = 8; };
                -> this.a_reg(r, sz);
            };

            a_ln(byte* s) -> void
            {
                pv_push(this.cb.lines, (void*)this.own(s));
                ->;
            };

            a_ab() -> void
            {
                this.a_ln(this.ab.mem);
                ->;
            };

            a_unsup(byte* what) -> void
            {
                this.nunsup++;
                this.a_ln(f"ud2 # unsupported: {what}\0");
                ->;
            };

            a_seq(byte* a, byte* b) -> bool
            {
                int i;
                while (a[i] != 0 & b[i] != 0)
                {
                    if (a[i] != b[i]) { -> false; };
                    i++;
                };
                -> a[i] == b[i];
            };

            // True when s starts with p
            a_pre(byte* s, byte* p) -> bool
            {
                int i;
                while (p[i] != 0)
                {
                    if (s[i] != p[i]) { -> false; };
                    i++;
                };
                -> true;
            };

            // ----------------------------------------------------------
            // Type layout
            // ----------------------------------------------------------

            a_size(IRType* t) -> int
            {
                int k = t.kind;
                int i, off, a, al;
                if (k == LK.INT)
                {
                    if (t.width <= 8) { -> 1; };
                    if (t.width <= 16) { -> 2; };
                    if (t.width <= 32) { -> 4; };
                    if (t.width <= 64) { -> 8; };
                    -> 16;
                };
                if (k == LK.PTR | k == LK.DOUBLE | k == LK.FUNC) { -> 8; };
                if (k == LK.FLOAT) { -> 4; };
                if (k == LK.ARRAY) { -> t.count * this.a_size(t.elem); };
                if (k == LK.STRUCT | k == LK.ISTRUCT)
                {
                    al = 1;
                    while (i < t.nitems)
                    {
                        a = this.a_align(t.items[i]);
                        if (a > al) { al = a; };
                        off = (off + a - 1) / a * a;
                        off = off + this.a_size(t.items[i]);
                        i++;
                    };
                    -> (off + al - 1) / al * al;
                };
                -> 0;
            };

            a_align(IRType* t) -> int
            {
                int k = t.kind;
                int i, a, al;
                if (k == LK.ARRAY) { -> this.a_align(t.elem); };
                if (k == LK.STRUCT | k == LK.ISTRUCT)
                {
                    al = 1;
                    while (i < t.nitems)
                    {
                        a = this.a_align(t.items[i]);
                        if (a > al) { al = a; };
                        i++;
                    };
                    -> al;
                };
                a = this.a_size(t);
                if (a < 1) { a = 1; };
                if (a > 16) { a = 16; };
                -> a;
            };

            // Byte offset of member i of a struct
            a_foff(IRType* t, int n) -> int
            {
                int i, a, off;
                while (i < n)
                {
                    a = this.a_align(t.items[i]);
                    off = (off + a - 1) / a * a;
                    off = off + this.a_size(t.items[i]);
                    i++;
                };
                a = this.a_align(t.items[n]);
                -> (off + a - 1) / a * a;
            };

            // ----------------------------------------------------------
            // Frame slots and values
            // ----------------------------------------------------------

            a_slot_f(IRFunc* f, int size, int al) -> int
            {
                int fr;
                if (al < 8) { al = 8; };
                fr = f.frame + size;
                fr = (fr + al - 1) / al * al;
                f.frame = fr;
                -> 0 - fr;
            };

            a_slot(int size, int al) -> int -> this.a_slot_f(this.cf, size, al);

            // New value of type t with its own slot
            a_newv(IRType* t) -> IRValue*
            {
                IRValue* v;
                int sz = this.a_size(t);
                int al = this.a_align(t);
                if (sz < 8) { sz = 8; };
                this.tb.clear();
                this.tb.put_str(g"%v\0");
                this.tb.put_int(this.lab);
                this.lab++;
                v = this.new_value(t, this.tb.mem);
                v.slot = this.a_slot(sz, al);
                -> v;
            };

            // Stores register r (64 bit) into the slot of v
            a_stv(IRValue* v, int r) -> void
            {
                byte* rn = this.a_reg(r, 8);
                this.a_ln(f"movq {rn}, {v.slot}(%rbp)\0");
                ->;
            };

            // Zero extends register r in place to width w
            a_norm(int r, int w) -> void
            {
                int sh;
                byte* r32 = this.a_reg(r, 4);
                byte* r8 = this.a_reg(r, 1);
                byte* r16 = this.a_reg(r, 2);
                if (w >= 64) { ->; };
                if (w == 32) { this.a_ln(f"movl {r32}, {r32}\0"); ->; };
                if (w == 16) { this.a_ln(f"movzwl {r16}, {r32}\0"); ->; };
                if (w == 8) { this.a_ln(f"movzbl {r8}, {r32}\0"); ->; };
                if (w == 1) { this.a_ln(f"andl $1, {r32}\0"); ->; };
                sh = 64 - w;
                this.a_ln(f"shlq ${sh}, {this.a_reg(r, 8)}\0");
                this.a_ln(f"shrq ${sh}, {this.a_reg(r, 8)}\0");
                ->;
            };

            // Sign extends the low w bits of register r to 64 bits
            a_sx(int r, int w) -> void
            {
                int sh;
                byte* r64 = this.a_reg(r, 8);
                byte* r32 = this.a_reg(r, 4);
                byte* r8 = this.a_reg(r, 1);
                byte* r16 = this.a_reg(r, 2);
                if (w >= 64) { ->; };
                if (w == 32) { this.a_ln(f"movslq {r32}, {r64}\0"); ->; };
                if (w == 16) { this.a_ln(f"movswq {r16}, {r64}\0"); ->; };
                if (w == 8) { this.a_ln(f"movsbq {r8}, {r64}\0"); ->; };
                if (w == 1)
                {
                    this.a_ln(f"andl $1, {r32}\0");
                    this.a_ln(f"negq {r64}\0");
                    ->;
                };
                sh = 64 - w;
                this.a_ln(f"shlq ${sh}, {r64}\0");
                this.a_ln(f"sarq ${sh}, {r64}\0");
                ->;
            };

            // ----------------------------------------------------------
            // Constants and symbols
            // ----------------------------------------------------------

            // Symbol name of an operand text @"name"
            a_sym(byte* t) -> byte*
            {
                int i = 1;
                int c;
                bool plain = true;
                this.mb.clear();
                if (t[1] == '"') { i = 2; };
                while (t[i] != 0)
                {
                    c = (int)t[i];
                    if (c == 34 & t[1] == '"') { break; };
                    this.mb.put(c);
                    if (!((c >= 48 & c <= 57) | (c >= 65 & c <= 90) | (c >= 97 & c <= 122) | c == 95 | c == 46 | c == 36)) { plain = false; };
                    i++;
                };
                if (plain) { -> this.own(this.mb.mem); };
                this.tb.clear();
                this.tb.put(34);
                this.tb.put_str(this.mb.mem);
                this.tb.put(34);
                -> this.own(this.tb.mem);
            };

            a_isnum(byte* t) -> bool
            {
                int c = (int)t[0];
                -> (c >= 48 & c <= 57) | (c == 45 & t[1] >= 48 & t[1] <= 57);
            };

            // Integer text to its 64 bit pattern. Handles the hex float patterns too.
            a_num(byte* t) -> u64
            {
                int i;
                bool neg = false;
                u64 r;
                int c;
                if (t[0] == '0' & (t[1] == 'x' | t[1] == 'X'))
                {
                    i = 2;
                    while (t[i] != 0)
                    {
                        c = (int)t[i];
                        if (c >= 48 & c <= 57) { r = (r << (u64)4) `| (u64)(c - 48); }
                        else
                        {
                            if (c >= 97 & c <= 102) { r = (r << (u64)4) `| (u64)(c - 87); }
                            else
                            {
                                if (c >= 65 & c <= 70) { r = (r << (u64)4) `| (u64)(c - 55); }
                                else { break; };
                            };
                        };
                        i++;
                    };
                    -> r;
                };
                if (t[0] == '-') { neg = true; i = 1; };
                while (t[i] >= 48 & t[i] <= 57)
                {
                    r = r * (u64)10 + (u64)((int)t[i] - 48);
                    i++;
                };
                if (neg) { -> (u64)0 - r; };
                -> r;
            };

            // Bits of an integer constant operand (true and false included)
            a_cval(IRValue* v) -> u64
            {
                byte* t = v.text;
                while (t[0] == ' ') { t = t + 1; };
                if (this.a_pre(t, g"true\0")) { -> (u64)1; };
                if (this.a_pre(t, g"false\0") | this.a_pre(t, g"null\0")) { -> (u64)0; };
                -> this.a_num(t);
            };

            // Bits of a float constant as 32 bit float (the text holds the double pattern)
            a_f32bits(u64 dbits) -> u64
            {
                double d;
                float f;
                u64* dp = (u64*)@d;
                u32* fp = (u32*)@f;
                *dp = dbits;
                f = (float)d;
                -> (u64)*fp;
            };

            // mov of a 64 bit pattern into register r
            a_imm(u64 bits, int r) -> void
            {
                byte* r64 = this.a_reg(r, 8);
                byte* r32 = this.a_reg(r, 4);
                i64 sv = (i64)bits;
                this.ab.clear();
                if (bits == (u64)0)
                {
                    this.a_ln(f"xorl {r32}, {r32}\0");
                    ->;
                };
                if (bits <= (u64)4294967295)
                {
                    this.ab.put_str(g"movl $\0");
                    put_u64(@this.ab, bits);
                    this.ab.put_str(g", \0");
                    this.ab.put_str(r32);
                    this.a_ab();
                    ->;
                };
                if (sv >= (i64)-2147483648 & sv < (i64)0)
                {
                    this.ab.put_str(g"movq $\0");
                    put_i64(@this.ab, sv);
                    this.ab.put_str(g", \0");
                    this.ab.put_str(r64);
                    this.a_ab();
                    ->;
                };
                this.ab.put_str(g"movabsq $\0");
                put_u64(@this.ab, bits);
                this.ab.put_str(g", \0");
                this.ab.put_str(r64);
                this.a_ab();
                ->;
            };

            // Mask of the low w bits
            a_mask(u64 v, int w) -> u64
            {
                if (w >= 64) { -> v; };
                -> v `& (((u64)1 << (u64)w) - (u64)1);
            };

            // Skips one type in constant text, leaving p on the first character after it
            a_skiptype(byte* s, int* p) -> void
            {
                int d;
                int c;
                while (s[*p] != 0)
                {
                    c = (int)s[*p];
                    if (c == 91 | c == 123 | c == 40) { d++; };
                    if (c == 93 | c == 125 | c == 41)
                    {
                        if (d == 0) { break; };
                        d--;
                    };
                    if (d == 0 & (c == 32 | c == 44)) { break; };
                    *p = *p + 1;
                };
                ->;
            };

            // Parses a constant address expression. sym is the symbol (null for a plain number),
            // off the byte offset.
            a_cx(byte* s, int* p) -> bool
            {
                int c, k, n;
                int q;
                i64 idx;
                IRGlobal* g;
                IRType* t;
                byte* nm;
                bool first = true;
                while (s[*p] == ' ') { *p = *p + 1; };
                c = (int)s[*p];
                if (c == 64)
                {
                    q = *p;
                    this.mb.clear();
                    nm = (byte*)0;
                    if (s[q + 1] == '"')
                    {
                        q = q + 2;
                        while (s[q] != 34 & s[q] != 0) { this.mb.put((int)s[q]); q++; };
                        q++;
                    }
                    else
                    {
                        q++;
                        while (s[q] != 0 & s[q] != ',' & s[q] != ')' & s[q] != ' ') { this.mb.put((int)s[q]); q++; };
                    };
                    this.tb.clear();
                    this.tb.put(64);
                    this.tb.put(34);
                    this.tb.put_str(this.mb.mem);
                    this.tb.put(34);
                    this.cx_sym = this.a_sym(this.tb.mem);
                    this.cx_off = 0;
                    *p = q;
                    -> true;
                };
                if (this.a_pre(s + *p, g"null\0")) { this.cx_sym = (byte*)0; this.cx_off = 0; *p = *p + 4; -> true; };
                if (this.a_isnum(s + *p))
                {
                    this.cx_sym = (byte*)0;
                    this.cx_off = (i64)this.a_num(s + *p);
                    if (s[*p] == '-') { *p = *p + 1; };
                    while (s[*p] >= 48 & s[*p] <= 57) { *p = *p + 1; };
                    -> true;
                };
                if (this.a_pre(s + *p, g"bitcast\0") | this.a_pre(s + *p, g"inttoptr\0") | this.a_pre(s + *p, g"ptrtoint\0"))
                {
                    while (s[*p] != '(' & s[*p] != 0) { *p = *p + 1; };
                    *p = *p + 1;
                    this.a_skiptype(s, p);
                    while (s[*p] == ' ') { *p = *p + 1; };
                    if (!this.a_cx(s, p)) { -> false; };
                    while (s[*p] != ')' & s[*p] != 0) { *p = *p + 1; };
                    *p = *p + 1;
                    -> true;
                };
                if (this.a_pre(s + *p, g"getelementptr\0"))
                {
                    *p = *p + 13;
                    while (s[*p] == ' ') { *p = *p + 1; };
                    if (this.a_pre(s + *p, g"inbounds\0")) { *p = *p + 8; };
                    while (s[*p] == ' ') { *p = *p + 1; };
                    *p = *p + 1;
                    this.a_skiptype(s, p);
                    while (s[*p] == ',' | s[*p] == ' ') { *p = *p + 1; };
                    this.a_skiptype(s, p);
                    while (s[*p] == ' ') { *p = *p + 1; };
                    if (!this.a_cx(s, p)) { -> false; };
                    g = (IRGlobal*)0;
                    if (this.cx_sym != (byte*)0)
                    {
                        this.tb.clear();
                        this.tb.put_str(this.cx_sym);
                        g = this.find_global(this.tb.mem);
                        if (g == (IRGlobal*)0 & this.cx_sym[0] == '"')
                        {
                            this.tb.clear();
                            k = 1;
                            while (this.cx_sym[k] != 34 & this.cx_sym[k] != 0) { this.tb.put((int)this.cx_sym[k]); k++; };
                            g = this.find_global(this.tb.mem);
                        };
                    };
                    t = this.nul;
                    if (g != (IRGlobal*)0) { t = g.ty; };
                    first = true;
                    while (s[*p] == ',')
                    {
                        *p = *p + 1;
                        while (s[*p] == ' ') { *p = *p + 1; };
                        this.a_skiptype(s, p);
                        while (s[*p] == ' ') { *p = *p + 1; };
                        idx = (i64)this.a_num(s + *p);
                        if (s[*p] == '-') { *p = *p + 1; };
                        while (s[*p] >= 48 & s[*p] <= 57) { *p = *p + 1; };
                        if (first)
                        {
                            this.cx_off = this.cx_off + idx * (i64)this.a_size(t);
                            first = false;
                        }
                        else
                        {
                            if (t.kind == LK.ARRAY)
                            {
                                this.cx_off = this.cx_off + idx * (i64)this.a_size(t.elem);
                                t = t.elem;
                            }
                            else
                            {
                                if (t.kind == LK.STRUCT | t.kind == LK.ISTRUCT)
                                {
                                    this.cx_off = this.cx_off + (i64)this.a_foff(t, (int)idx);
                                    t = t.items[(int)idx];
                                };
                            };
                        };
                    };
                    while (s[*p] != ')' & s[*p] != 0) { *p = *p + 1; };
                    *p = *p + 1;
                    -> true;
                };
                -> false;
            };

            // Loads value v into register r (64 bit)
            a_ld(IRValue* v, int r) -> void
            {
                byte* rn = this.a_reg(r, 8);
                byte* t = v.text;
                int c;
                int p;
                u64 bits;
                byte* sym;
                i64 off;
                while (t[0] == ' ') { t = t + 1; };
                c = (int)t[0];
                if (v.slot != 0)
                {
                    if ((v.flags `& VF_ALLOCA) != 0) { this.a_ln(f"leaq {v.slot}(%rbp), {rn}\0"); }
                    else { this.a_ln(f"movq {v.slot}(%rbp), {rn}\0"); };
                    ->;
                };
                if (c == 64)
                {
                    sym = this.a_sym(t);
                    this.a_ln(f"leaq {sym}(%rip), {rn}\0");
                    ->;
                };
                if (this.a_isnum(t))
                {
                    bits = this.a_num(t);
                    if (v.ty.kind == LK.FLOAT & t[0] == '0' & t[1] == 'x') { bits = this.a_f32bits(bits); }
                    else { if (v.ty.kind == LK.INT) { bits = this.a_mask(bits, v.ty.width); }; };
                    this.a_imm(bits, r);
                    ->;
                };
                if (this.a_pre(t, g"true\0")) { this.a_imm((u64)1, r); ->; };
                if (this.a_pre(t, g"false\0") | this.a_pre(t, g"null\0") | this.a_pre(t, g"zeroinitializer\0") | this.a_pre(t, g"undef\0"))
                {
                    this.a_imm((u64)0, r);
                    ->;
                };
                if (this.a_pre(t, g"getelementptr\0") | this.a_pre(t, g"bitcast\0") | this.a_pre(t, g"inttoptr\0") | this.a_pre(t, g"ptrtoint\0"))
                {
                    p = 0;
                    if (this.a_cx(t, @p))
                    {
                        sym = this.cx_sym;
                        off = this.cx_off;
                        if (sym == (byte*)0) { this.a_imm((u64)off, r); ->; };
                        this.a_ln(f"leaq {sym}(%rip), {rn}\0");
                        if (off != (i64)0)
                        {
                            this.ab.clear();
                            this.ab.put_str(g"addq $\0");
                            put_i64(@this.ab, off);
                            this.ab.put_str(g", \0");
                            this.ab.put_str(rn);
                            this.a_ab();
                        };
                        ->;
                    };
                };
                this.a_unsup(t);
                ->;
            };

            // Loads a float or double value into xmm register x (through rax)
            a_ldx(IRValue* v, int x) -> void
            {
                this.a_ld(v, 0);
                if (v.ty.kind == LK.FLOAT) { this.a_ln(f"movd %eax, %xmm{x}\0"); }
                else { this.a_ln(f"movq %rax, %xmm{x}\0"); };
                ->;
            };

            // Stores xmm0 into a new value of the float type t
            a_stx(IRType* t, int x) -> IRValue*
            {
                IRValue* v = this.a_newv(t);
                if (t.kind == LK.FLOAT) { this.a_ln(f"movd %xmm{x}, %eax\0"); }
                else { this.a_ln(f"movq %xmm{x}, %rax\0"); };
                this.a_stv(v, 0);
                -> v;
            };

            // Directive that starts the read-only data section (ELF .rodata, COFF .rdata)
            a_rodata() -> byte*
            {
                if (this.a_win()) { -> g"\t.section .rdata,\"dr\"\n\0"; };
                -> g"\t.section .rodata\n\0";
            };

            // Label of a read-only copy of an aggregate constant
            a_const_agg(IRValue* v) -> byte*
            {
                int n = this.lab;
                int p;
                this.lab++;
                this.cdata.put_str(this.a_rodata());
                this.cdata.put_str(g"\t.p2align 4\n\0");
                this.cdata.put_str(f".LC{n}:\n\0");
                this.a_dat(v.ty, v.text, @p, @this.cdata);
                this.tb.clear();
                this.tb.put_str(g".LC\0");
                this.tb.put_int(n);
                -> this.own(this.tb.mem);
            };

            // ----------------------------------------------------------
            // Memory operands and copies
            // ----------------------------------------------------------

            // Memory operand text for the pointer p plus extra bytes. tmp is the register used
            // when the pointer must be loaded. The text is valid until the next call.
            a_mem(IRValue* p, int tmp, int extra) -> byte*
            {
                byte* sym;
                byte* rn;
                int q;
                i64 off;
                this.mb.clear();
                if (p.slot != 0 & (p.flags `& VF_ALLOCA) != 0)
                {
                    this.mb.put_int(p.slot + extra);
                    this.mb.put_str(g"(%rbp)\0");
                    -> this.mb.mem;
                };
                if (p.slot == 0 & p.text[0] == '@')
                {
                    sym = this.a_sym(p.text);
                    this.mb.clear();
                    this.mb.put_str(sym);
                    if (extra != 0) { this.mb.put(43); this.mb.put_int(extra); };
                    this.mb.put_str(g"(%rip)\0");
                    -> this.mb.mem;
                };
                this.a_ld(p, tmp);
                rn = this.a_reg(tmp, 8);
                this.mb.clear();
                if (extra != 0) { this.mb.put_int(extra); };
                this.mb.put(40);
                this.mb.put_str(rn);
                this.mb.put(41);
                -> this.mb.mem;
            };

            // Copies sz bytes from (%rsi) to (%rdi), clobbering rax and rcx
            a_copy(int sz) -> void
            {
                int o;
                if (sz > 64)
                {
                    this.a_ln(f"movq ${sz}, %rcx\0");
                    this.a_ln(g"rep movsb\0");
                    ->;
                };
                while (o + 8 <= sz)
                {
                    this.a_ln(f"movq {o}(%rsi), %rax\0");
                    this.a_ln(f"movq %rax, {o}(%rdi)\0");
                    o = o + 8;
                };
                if (o + 4 <= sz)
                {
                    this.a_ln(f"movl {o}(%rsi), %eax\0");
                    this.a_ln(f"movl %eax, {o}(%rdi)\0");
                    o = o + 4;
                };
                if (o + 2 <= sz)
                {
                    this.a_ln(f"movzwl {o}(%rsi), %eax\0");
                    this.a_ln(f"movw %ax, {o}(%rdi)\0");
                    o = o + 2;
                };
                if (o + 1 <= sz)
                {
                    this.a_ln(f"movzbl {o}(%rsi), %eax\0");
                    this.a_ln(f"movb %al, {o}(%rdi)\0");
                };
                ->;
            };

            // rsi = address of the bytes of aggregate value v
            a_agg_src(IRValue* v) -> void
            {
                byte* lb;
                if (v.slot != 0)
                {
                    if (v.slot > 0) { this.a_ln(f"leaq {v.slot}(%rbp), %rsi\0"); }
                    else { this.a_ln(f"leaq {v.slot}(%rbp), %rsi\0"); };
                    ->;
                };
                if (this.a_pre(v.text, g"zeroinitializer\0") | this.a_pre(v.text, g"undef\0"))
                {
                    lb = this.a_zero_label(this.a_size(v.ty));
                    this.a_ln(f"leaq {lb}(%rip), %rsi\0");
                    ->;
                };
                lb = this.a_const_agg(v);
                this.a_ln(f"leaq {lb}(%rip), %rsi\0");
                ->;
            };

            // Label of a zero filled block of at least sz bytes
            a_zero_label(int sz) -> byte*
            {
                if (sz > this.zmax) { this.zmax = sz; };
                -> g".LZERO\0";
            };

            // ----------------------------------------------------------
            // Builder hooks
            // ----------------------------------------------------------

            // Win64: argument position p (the hidden result pointer counts as position 0) is in
            // rcx/rdx/r8/r9 or xmm0-3 for p < 4, and at 16(%rbp) + 8 * p after that.
            a_func_begin_win(IRFunc* f) -> void
            {
                int i, p, base, sz;
                IRType* t;
                f.frame = 0;
                f.sret_slot = 0;
                f.cs_mask = 0;
                f.cs = (int*)fmalloc((u64)20);
                pv_push(this.blobs, (void*)f.cs);
                if (this.a_ret_ptr(f.ftype.elem))
                {
                    f.sret_slot = this.a_slot_f(f, 8, 8);
                    base = 1;
                };
                // rsi and rdi are callee saved in Win64 and this backend uses both as scratch
                f.wsave = this.a_slot_f(f, 16, 16);
                while (i < f.nargs)
                {
                    t = f.ftype.items[i];
                    sz = this.a_size(t);
                    p = base + i;
                    if (lt_is_agg(t) & !this.a_small_agg(sz))
                    {
                        // passed by pointer, the callee works on a private copy
                        f.args[i].slot = this.a_slot_f(f, (sz + 15) / 16 * 16, 16);
                    }
                    else
                    {
                        if (p < 4) { f.args[i].slot = this.a_slot_f(f, 8, 8); }
                        else { f.args[i].slot = 16 + 8 * p; };
                    };
                    i++;
                };
                if (f.ftype.vararg) { f.va_gp = base + f.nargs; };
                ->;
            };

            a_func_begin(IRFunc* f) -> void
            {
                int i, ngp, nfp, stk, sz;
                IRType* t;
                if (this.a_win()) { this.a_func_begin_win(f); ->; };
                f.frame = 0;
                f.sret_slot = 0;
                f.cs_mask = 0;
                f.cs = (int*)fmalloc((u64)20);
                pv_push(this.blobs, (void*)f.cs);
                stk = 16;
                if (lt_is_agg(f.ftype.elem))
                {
                    f.sret_slot = this.a_slot_f(f, 8, 8);
                    ngp = 1;
                };
                while (i < f.nargs)
                {
                    t = f.ftype.items[i];
                    sz = this.a_size(t);
                    if (lt_is_agg(t))
                    {
                        f.args[i].slot = stk;
                        stk = stk + (sz + 7) / 8 * 8;
                    }
                    else
                    {
                        if (lt_is_fp(t))
                        {
                            if (nfp < 8) { f.args[i].slot = this.a_slot_f(f, 8, 8); nfp++; }
                            else { f.args[i].slot = stk; stk = stk + 8; };
                        }
                        else
                        {
                            if (ngp < 6) { f.args[i].slot = this.a_slot_f(f, 8, 8); ngp++; }
                            else { f.args[i].slot = stk; stk = stk + 8; };
                        };
                    };
                    i++;
                };
                if (f.ftype.vararg)
                {
                    f.va_gp = ngp;
                    f.va_fp = nfp;
                    f.va_stk = stk;
                    f.va_slot = this.a_slot_f(f, 176, 16);
                };
                ->;
            };

            // Win64 passes the first four arguments in rcx, rdx, r8, r9 and reserves 32 bytes of shadow space
            a_win() -> bool -> this.abi == 1;

            a_small_agg(int sz) -> bool -> sz == 1 | sz == 2 | sz == 4 | sz == 8;

            // An aggregate result comes back through a hidden first pointer argument
            a_ret_ptr(IRType* rt) -> bool
            {
                if (!lt_is_agg(rt)) { -> false; };
                if (!this.a_win()) { -> true; };
                -> !this.a_small_agg(this.a_size(rt));
            };

            // Loads the sz byte aggregate at (%rsi) into integer register r
            a_agg_load(int sz, int r) -> void
            {
                switch (sz)
                {
                    case (1) { this.a_ln(f"movzbl (%rsi), {this.a_reg(r, 4)}\0"); }
                    case (2) { this.a_ln(f"movzwl (%rsi), {this.a_reg(r, 4)}\0"); }
                    case (4) { this.a_ln(f"movl (%rsi), {this.a_reg(r, 4)}\0"); }
                    default { this.a_ln(f"movq (%rsi), {this.a_reg(r, 8)}\0"); };
                };
                ->;
            };

            // Register number of integer argument i
            a_argreg(int i) -> int
            {
                if (this.a_win())
                {
                    switch (i)
                    {
                        case (0) { -> 1; }
                        case (1) { -> 2; }
                        case (2) { -> 5; }
                        default { -> 6; };
                    };
                };
                switch (i)
                {
                    case (0) { -> 4; }
                    case (1) { -> 3; }
                    case (2) { -> 2; }
                    case (3) { -> 1; }
                    case (4) { -> 5; }
                    default { -> 6; };
                };
            };

            a_term_begin() -> void
            {
                this.cb.term_at = this.cb.lines.len;
                ->;
            };

            a_term_end() -> void
            {
                this.cb.terminated = true;
                ->;
            };

            a_label(IRBlock* b) -> byte*
            {
                this.tb.clear();
                this.tb.put_str(g".LB\0");
                this.tb.put_int(b.id);
                -> this.own(this.tb.mem);
            };

            a_binop(byte* op, IRValue* a, IRValue* b, byte* hint) -> IRValue*
            {
                IRType* t = a.ty;
                IRValue* v = this.a_newv(t);
                int w = t.width;
                byte* ra;
                byte* rc;
                int k;
                if (lt_is_fp(t))
                {
                    this.a_ldx(a, 0);
                    this.a_ldx(b, 1);
                    if (t.kind == LK.FLOAT)
                    {
                        if (this.a_pre(op, g"fadd\0")) { this.a_ln(g"addss %xmm1, %xmm0\0"); };
                        if (this.a_pre(op, g"fsub\0")) { this.a_ln(g"subss %xmm1, %xmm0\0"); };
                        if (this.a_pre(op, g"fmul\0")) { this.a_ln(g"mulss %xmm1, %xmm0\0"); };
                        if (this.a_pre(op, g"fdiv\0")) { this.a_ln(g"divss %xmm1, %xmm0\0"); };
                        if (this.a_pre(op, g"frem\0")) { this.a_frem(true); };
                        this.a_ln(g"movd %xmm0, %eax\0");
                    }
                    else
                    {
                        if (this.a_pre(op, g"fadd\0")) { this.a_ln(g"addsd %xmm1, %xmm0\0"); };
                        if (this.a_pre(op, g"fsub\0")) { this.a_ln(g"subsd %xmm1, %xmm0\0"); };
                        if (this.a_pre(op, g"fmul\0")) { this.a_ln(g"mulsd %xmm1, %xmm0\0"); };
                        if (this.a_pre(op, g"fdiv\0")) { this.a_ln(g"divsd %xmm1, %xmm0\0"); };
                        if (this.a_pre(op, g"frem\0")) { this.a_frem(false); };
                        this.a_ln(g"movq %xmm0, %rax\0");
                    };
                    this.a_stv(v, 0);
                    -> v;
                };
                if (w == 0) { w = 64; };
                this.a_ld(a, 0);
                this.a_ld(b, 1);
                if (this.a_pre(op, g"add\0")) { this.a_ln(g"addq %rcx, %rax\0"); }
                else
                {
                    if (this.a_pre(op, g"sub\0")) { this.a_ln(g"subq %rcx, %rax\0"); }
                    else
                    {
                        if (this.a_pre(op, g"mul\0")) { this.a_ln(g"imulq %rcx, %rax\0"); }
                        else
                        {
                            if (this.a_pre(op, g"and\0")) { this.a_ln(g"andq %rcx, %rax\0"); }
                            else
                            {
                                if (this.a_pre(op, g"or\0")) { this.a_ln(g"orq %rcx, %rax\0"); }
                                else
                                {
                                    if (this.a_pre(op, g"xor\0")) { this.a_ln(g"xorq %rcx, %rax\0"); }
                                    else
                                    {
                                        if (this.a_pre(op, g"shl\0"))
                                        {
                                            // widths up to 32 use the 32 bit shifts like the hardware does, so the count wraps
                                            if (w <= 32) { this.a_ln(g"shll %cl, %eax\0"); } else { this.a_ln(g"shlq %cl, %rax\0"); };
                                        }
                                        else
                                        {
                                            if (this.a_pre(op, g"lshr\0"))
                                            {
                                                if (w <= 32) { this.a_ln(g"shrl %cl, %eax\0"); } else { this.a_ln(g"shrq %cl, %rax\0"); };
                                            }
                                            else
                                            {
                                                if (this.a_pre(op, g"ashr\0"))
                                                {
                                                    this.a_sx(0, w);
                                                    if (w <= 32) { this.a_ln(g"sarl %cl, %eax\0"); } else { this.a_ln(g"sarq %cl, %rax\0"); };
                                                }
                                                else
                                                {
                                                    if (this.a_pre(op, g"udiv\0"))
                                                    {
                                                        this.a_ln(g"xorl %edx, %edx\0");
                                                        this.a_ln(g"divq %rcx\0");
                                                    }
                                                    else
                                                    {
                                                        if (this.a_pre(op, g"urem\0"))
                                                        {
                                                            this.a_ln(g"xorl %edx, %edx\0");
                                                            this.a_ln(g"divq %rcx\0");
                                                            this.a_ln(g"movq %rdx, %rax\0");
                                                        }
                                                        else
                                                        {
                                                            if (this.a_pre(op, g"sdiv\0"))
                                                            {
                                                                this.a_sx(0, w);
                                                                this.a_sx(1, w);
                                                                this.a_ln(g"cqto\0");
                                                                this.a_ln(g"idivq %rcx\0");
                                                            }
                                                            else
                                                            {
                                                                if (this.a_pre(op, g"srem\0"))
                                                                {
                                                                    this.a_sx(0, w);
                                                                    this.a_sx(1, w);
                                                                    this.a_ln(g"cqto\0");
                                                                    this.a_ln(g"idivq %rcx\0");
                                                                    this.a_ln(g"movq %rdx, %rax\0");
                                                                }
                                                                else { this.a_unsup(op); };
                                                            };
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
                this.a_norm(0, w);
                this.a_stv(v, 0);
                -> v;
            };

            // frem through fmod of libm is not available, so use the x87 remainder
            a_frem(bool single) -> void
            {
                if (single)
                {
                    this.a_ln(g"subq $8, %rsp\0");
                    this.a_ln(g"movss %xmm1, (%rsp)\0");
                    this.a_ln(g"flds (%rsp)\0");
                    this.a_ln(g"movss %xmm0, (%rsp)\0");
                    this.a_ln(g"flds (%rsp)\0");
                }
                else
                {
                    this.a_ln(g"subq $8, %rsp\0");
                    this.a_ln(g"movsd %xmm1, (%rsp)\0");
                    this.a_ln(g"fldl (%rsp)\0");
                    this.a_ln(g"movsd %xmm0, (%rsp)\0");
                    this.a_ln(g"fldl (%rsp)\0");
                };
                this.lab++;
                this.a_ln(f".LF{this.lab}:\0");
                this.a_ln(g"fprem\0");
                this.a_ln(g"fnstsw %ax\0");
                this.a_ln(g"testb $4, %ah\0");
                this.a_ln(f"jne .LF{this.lab}\0");
                this.a_ln(g"fstp %st(1)\0");
                if (single)
                {
                    this.a_ln(g"fstps (%rsp)\0");
                    this.a_ln(g"movss (%rsp), %xmm0\0");
                }
                else
                {
                    this.a_ln(g"fstpl (%rsp)\0");
                    this.a_ln(g"movsd (%rsp), %xmm0\0");
                };
                this.a_ln(g"addq $8, %rsp\0");
                ->;
            };

            a_cmp(byte* kind, byte* pred, IRValue* a, IRValue* b, byte* hint) -> IRValue*
            {
                IRValue* v = this.a_newv(this.t_int(1));
                int w = a.ty.width;
                bool dbl = a.ty.kind == LK.DOUBLE;
                byte* uc;
                if (this.a_pre(kind, g"fcmp\0"))
                {
                    this.a_ldx(a, 0);
                    this.a_ldx(b, 1);
                    uc = g"ucomisd\0";
                    if (!dbl) { uc = g"ucomiss\0"; };
                    this.a_fcmp(pred, uc);
                    this.a_ln(g"movzbl %al, %eax\0");
                    this.a_stv(v, 0);
                    -> v;
                };
                if (a.ty.kind != LK.INT) { w = 64; };
                this.a_ld(a, 0);
                this.a_ld(b, 1);
                if (pred[0] == 's' & !this.a_seq(pred, g"ne\0"))
                {
                    this.a_sx(0, w);
                    this.a_sx(1, w);
                };
                this.a_ln(g"cmpq %rcx, %rax\0");
                if (this.a_seq(pred, g"eq\0")) { this.a_ln(g"sete %al\0"); };
                if (this.a_seq(pred, g"ne\0")) { this.a_ln(g"setne %al\0"); };
                if (this.a_seq(pred, g"ugt\0")) { this.a_ln(g"seta %al\0"); };
                if (this.a_seq(pred, g"uge\0")) { this.a_ln(g"setae %al\0"); };
                if (this.a_seq(pred, g"ult\0")) { this.a_ln(g"setb %al\0"); };
                if (this.a_seq(pred, g"ule\0")) { this.a_ln(g"setbe %al\0"); };
                if (this.a_seq(pred, g"sgt\0")) { this.a_ln(g"setg %al\0"); };
                if (this.a_seq(pred, g"sge\0")) { this.a_ln(g"setge %al\0"); };
                if (this.a_seq(pred, g"slt\0")) { this.a_ln(g"setl %al\0"); };
                if (this.a_seq(pred, g"sle\0")) { this.a_ln(g"setle %al\0"); };
                this.a_ln(g"movzbl %al, %eax\0");
                this.a_stv(v, 0);
                -> v;
            };

            // Sets al from the flags of ucomis(xmm1, xmm0) style compares. xmm0 holds the left
            // operand and xmm1 the right one.
            a_fcmp(byte* pred, byte* uc) -> void
            {
                bool neg = false;
                byte* p = pred;
                if (this.a_seq(p, g"true\0")) { this.a_ln(g"movb $1, %al\0"); ->; };
                if (this.a_seq(p, g"false\0")) { this.a_ln(g"xorl %eax, %eax\0"); ->; };
                if (this.a_seq(p, g"ord\0"))
                {
                    this.a_ln(f"{uc} %xmm1, %xmm0\0");
                    this.a_ln(g"setnp %al\0");
                    ->;
                };
                if (this.a_seq(p, g"uno\0"))
                {
                    this.a_ln(f"{uc} %xmm1, %xmm0\0");
                    this.a_ln(g"setp %al\0");
                    ->;
                };
                if (this.a_seq(p, g"oeq\0"))
                {
                    this.a_ln(f"{uc} %xmm1, %xmm0\0");
                    this.a_ln(g"sete %al\0");
                    this.a_ln(g"setnp %cl\0");
                    this.a_ln(g"andb %cl, %al\0");
                    ->;
                };
                if (this.a_seq(p, g"one\0"))
                {
                    this.a_ln(f"{uc} %xmm1, %xmm0\0");
                    this.a_ln(g"setne %al\0");
                    this.a_ln(g"setnp %cl\0");
                    this.a_ln(g"andb %cl, %al\0");
                    ->;
                };
                if (this.a_seq(p, g"ueq\0"))
                {
                    this.a_ln(f"{uc} %xmm1, %xmm0\0");
                    this.a_ln(g"sete %al\0");
                    this.a_ln(g"setp %cl\0");
                    this.a_ln(g"orb %cl, %al\0");
                    ->;
                };
                if (this.a_seq(p, g"une\0"))
                {
                    this.a_ln(f"{uc} %xmm1, %xmm0\0");
                    this.a_ln(g"setne %al\0");
                    this.a_ln(g"setp %cl\0");
                    this.a_ln(g"orb %cl, %al\0");
                    ->;
                };
                // ordered greater forms compare xmm1 against xmm0 swapped for the less forms
                if (this.a_seq(p, g"ogt\0") | this.a_seq(p, g"ule\0"))
                {
                    this.a_ln(f"{uc} %xmm1, %xmm0\0");
                    this.a_ln(g"seta %al\0");
                    if (p[0] == 'u') { this.a_ln(g"xorb $1, %al\0"); };
                    ->;
                };
                if (this.a_seq(p, g"oge\0") | this.a_seq(p, g"ult\0"))
                {
                    this.a_ln(f"{uc} %xmm1, %xmm0\0");
                    this.a_ln(g"setae %al\0");
                    if (p[0] == 'u') { this.a_ln(g"xorb $1, %al\0"); };
                    ->;
                };
                if (this.a_seq(p, g"olt\0") | this.a_seq(p, g"uge\0"))
                {
                    this.a_ln(f"{uc} %xmm0, %xmm1\0");
                    this.a_ln(g"seta %al\0");
                    if (p[0] == 'u') { this.a_ln(g"xorb $1, %al\0"); };
                    ->;
                };
                if (this.a_seq(p, g"ole\0") | this.a_seq(p, g"ugt\0"))
                {
                    this.a_ln(f"{uc} %xmm0, %xmm1\0");
                    this.a_ln(g"setae %al\0");
                    if (p[0] == 'u') { this.a_ln(g"xorb $1, %al\0"); };
                    ->;
                };
                this.a_unsup(pred);
                ->;
            };

            a_cast(byte* op, IRValue* v, IRType* to, byte* hint) -> IRValue*
            {
                IRValue* r = this.a_newv(to);
                IRType* fromt = v.ty;
                int fw = fromt.width;
                int tw = to.width;
                int lab1, lab2;
                bool tdbl = to.kind == LK.DOUBLE;
                bool fdbl = fromt.kind == LK.DOUBLE;
                if (fromt.kind != LK.INT) { fw = 64; };
                if (to.kind != LK.INT) { tw = 64; };
                if (this.a_pre(op, g"fpext\0"))
                {
                    this.a_ldx(v, 0);
                    this.a_ln(g"cvtss2sd %xmm0, %xmm0\0");
                    this.a_ln(g"movq %xmm0, %rax\0");
                    this.a_stv(r, 0);
                    -> r;
                };
                if (this.a_pre(op, g"fptrunc\0"))
                {
                    this.a_ldx(v, 0);
                    this.a_ln(g"cvtsd2ss %xmm0, %xmm0\0");
                    this.a_ln(g"movd %xmm0, %eax\0");
                    this.a_stv(r, 0);
                    -> r;
                };
                if (this.a_pre(op, g"sitofp\0") | this.a_pre(op, g"uitofp\0"))
                {
                    this.a_ld(v, 0);
                    if (this.a_pre(op, g"sitofp\0")) { this.a_sx(0, fw); };
                    if (tdbl)
                    {
                        if (this.a_pre(op, g"uitofp\0") & fw == 64)
                        {
                            this.lab++;
                            lab1 = this.lab;
                            this.lab++;
                            lab2 = this.lab;
                            this.a_ln(g"testq %rax, %rax\0");
                            this.a_ln(f"js .LU{lab1}\0");
                            this.a_ln(g"cvtsi2sdq %rax, %xmm0\0");
                            this.a_ln(f"jmp .LU{lab2}\0");
                            this.a_ln(f".LU{lab1}:\0");
                            this.a_ln(g"movq %rax, %rcx\0");
                            this.a_ln(g"shrq %rcx\0");
                            this.a_ln(g"andl $1, %eax\0");
                            this.a_ln(g"orq %rax, %rcx\0");
                            this.a_ln(g"cvtsi2sdq %rcx, %xmm0\0");
                            this.a_ln(g"addsd %xmm0, %xmm0\0");
                            this.a_ln(f".LU{lab2}:\0");
                        }
                        else { this.a_ln(g"cvtsi2sdq %rax, %xmm0\0"); };
                        this.a_ln(g"movq %xmm0, %rax\0");
                    }
                    else
                    {
                        if (this.a_pre(op, g"uitofp\0") & fw == 64)
                        {
                            this.lab++;
                            lab1 = this.lab;
                            this.lab++;
                            lab2 = this.lab;
                            this.a_ln(g"testq %rax, %rax\0");
                            this.a_ln(f"js .LU{lab1}\0");
                            this.a_ln(g"cvtsi2ssq %rax, %xmm0\0");
                            this.a_ln(f"jmp .LU{lab2}\0");
                            this.a_ln(f".LU{lab1}:\0");
                            this.a_ln(g"movq %rax, %rcx\0");
                            this.a_ln(g"shrq %rcx\0");
                            this.a_ln(g"andl $1, %eax\0");
                            this.a_ln(g"orq %rax, %rcx\0");
                            this.a_ln(g"cvtsi2ssq %rcx, %xmm0\0");
                            this.a_ln(g"addss %xmm0, %xmm0\0");
                            this.a_ln(f".LU{lab2}:\0");
                        }
                        else { this.a_ln(g"cvtsi2ssq %rax, %xmm0\0"); };
                        this.a_ln(g"movd %xmm0, %eax\0");
                    };
                    this.a_stv(r, 0);
                    -> r;
                };
                if (this.a_pre(op, g"fptosi\0") | this.a_pre(op, g"fptoui\0"))
                {
                    this.a_ldx(v, 0);
                    if (this.a_pre(op, g"fptoui\0") & tw == 64)
                    {
                        // values at or above 2^63 are converted after subtracting 2^63
                        this.lab++;
                        lab1 = this.lab;
                        this.lab++;
                        lab2 = this.lab;
                        if (fdbl)
                        {
                            this.a_ln(g"movabsq $0x43e0000000000000, %rcx\0");
                            this.a_ln(g"movq %rcx, %xmm1\0");
                            this.a_ln(g"ucomisd %xmm1, %xmm0\0");
                            this.a_ln(f"jae .LU{lab1}\0");
                            this.a_ln(g"cvttsd2siq %xmm0, %rax\0");
                            this.a_ln(f"jmp .LU{lab2}\0");
                            this.a_ln(f".LU{lab1}:\0");
                            this.a_ln(g"subsd %xmm1, %xmm0\0");
                            this.a_ln(g"cvttsd2siq %xmm0, %rax\0");
                            this.a_ln(g"movabsq $0x8000000000000000, %rcx\0");
                            this.a_ln(g"xorq %rcx, %rax\0");
                            this.a_ln(f".LU{lab2}:\0");
                        }
                        else
                        {
                            this.a_ln(g"movl $0x5f000000, %ecx\0");
                            this.a_ln(g"movd %ecx, %xmm1\0");
                            this.a_ln(g"ucomiss %xmm1, %xmm0\0");
                            this.a_ln(f"jae .LU{lab1}\0");
                            this.a_ln(g"cvttss2siq %xmm0, %rax\0");
                            this.a_ln(f"jmp .LU{lab2}\0");
                            this.a_ln(f".LU{lab1}:\0");
                            this.a_ln(g"subss %xmm1, %xmm0\0");
                            this.a_ln(g"cvttss2siq %xmm0, %rax\0");
                            this.a_ln(g"movabsq $0x8000000000000000, %rcx\0");
                            this.a_ln(g"xorq %rcx, %rax\0");
                            this.a_ln(f".LU{lab2}:\0");
                        };
                    }
                    else
                    {
                        if (fdbl) { this.a_ln(g"cvttsd2siq %xmm0, %rax\0"); }
                        else { this.a_ln(g"cvttss2siq %xmm0, %rax\0"); };
                        this.a_norm(0, tw);
                    };
                    this.a_stv(r, 0);
                    -> r;
                };
                this.a_ld(v, 0);
                if (this.a_pre(op, g"sext\0")) { this.a_sx(0, fw); this.a_norm(0, tw); }
                else
                {
                    // zext, trunc, ptrtoint, inttoptr and bitcast keep the bits
                    if (tw < fw | this.a_pre(op, g"trunc\0")) { this.a_norm(0, tw); };
                };
                this.a_stv(r, 0);
                -> r;
            };

            a_alloca(IRType* ty, byte* name) -> IRValue*
            {
                IRValue* av;
                int sz = this.a_size(ty);
                int al = this.a_align(ty);
                if (sz < 8) { sz = 8; };
                // The System V va_list object is 24 bytes; the front end types it as [1 x i8*].
                // The copies made for indexing `...` are typed the same way and receive a full copy.
                if (name != (byte*)0 & (this.a_pre(name, g"va_list\0") | this.a_pre(name, g"va_copy\0")) & sz < 24) { sz = 24; };
                this.tb.clear();
                this.tb.put_str(g"%a\0");
                this.tb.put_int(this.lab);
                this.lab++;
                av = this.new_value(this.t_ptr(ty), this.tb.mem);
                av.flags = VF_ALLOCA;
                av.slot = this.a_slot(sz, al);
                -> av;
            };

            a_alloca_count(IRType* ty, IRValue* count, byte* name) -> IRValue*
            {
                IRValue* v = this.a_newv(this.t_ptr(ty));
                int sz = this.a_size(ty);
                this.a_ld(count, 0);
                this.a_ln(f"imulq ${sz}, %rax, %rax\0");
                this.a_ln(g"addq $15, %rax\0");
                this.a_ln(g"andq $-16, %rax\0");
                this.a_ln(g"subq %rax, %rsp\0");
                this.a_ln(g"movq %rsp, %rax\0");
                this.a_stv(v, 0);
                -> v;
            };

            a_load(IRValue* p, byte* hint) -> IRValue*
            {
                IRType* t = p.ty.elem;
                IRValue* v = this.a_newv(t);
                int sz = this.a_size(t);
                byte* m;
                if (lt_is_agg(t))
                {
                    this.a_ld(p, 3);
                    this.a_ln(f"leaq {v.slot}(%rbp), %rdi\0");
                    this.a_copy(sz);
                    -> v;
                };
                m = this.a_mem(p, 1, 0);
                switch (sz)
                {
                    case (1) { this.a_ln(f"movzbl {m}, %eax\0"); }
                    case (2) { this.a_ln(f"movzwl {m}, %eax\0"); }
                    case (4) { this.a_ln(f"movl {m}, %eax\0"); }
                    default { this.a_ln(f"movq {m}, %rax\0"); };
                };
                if (t.kind == LK.INT & t.width == 1) { this.a_ln(g"andl $1, %eax\0"); };
                this.a_stv(v, 0);
                -> v;
            };

            a_store(IRValue* v, IRValue* p, bool vol) -> void
            {
