                int sz = this.a_size(t);
                byte* m;
                if (lt_is_agg(t))
                {
                    this.a_agg_src(v);
                    this.a_ld(p, 4);
                    this.a_copy(sz);
                    ->;
                };
                this.a_ld(v, 0);
                m = this.a_mem(p, 1, 0);
                switch (sz)
                {
                    case (1) { this.a_ln(f"movb %al, {m}\0"); }
                    case (2) { this.a_ln(f"movw %ax, {m}\0"); }
                    case (4) { this.a_ln(f"movl %eax, {m}\0"); }
                    default { this.a_ln(f"movq %rax, {m}\0"); };
                };
                ->;
            };

            a_gep(IRValue* p, IRValue** idx, int n, bool inbounds, byte* hint) -> IRValue*
            {
                IRType* t = p.ty.elem;
                IRType* cur = t;
                IRValue* v;
                IRValue* ix;
                i64 off;
                int i, k, sz, w;
                this.a_ld(p, 0);
                ix = idx[0];
                sz = this.a_size(t);
                if (this.a_isnum(ix.text)) { off = off + (i64)this.a_num(ix.text) * (i64)sz; }
                else
                {
                    this.a_ld(ix, 1);
                    w = ix.ty.width;
                    if (ix.ty.kind != LK.INT) { w = 64; };
                    this.a_sx(1, w);
                    if (sz != 1) { this.a_ln(f"imulq ${sz}, %rcx, %rcx\0"); };
                    this.a_ln(g"addq %rcx, %rax\0");
                };
                i = 1;
                while (i < n)
                {
                    ix = idx[i];
                    if (cur.kind == LK.STRUCT | cur.kind == LK.ISTRUCT)
                    {
                        k = (int)this.const_val(ix);
                        off = off + (i64)this.a_foff(cur, k);
                        cur = cur.items[k];
                    }
                    else
                    {
                        sz = this.a_size(cur.elem);
                        if (this.a_isnum(ix.text)) { off = off + (i64)this.a_num(ix.text) * (i64)sz; }
                        else
                        {
                            this.a_ld(ix, 1);
                            w = ix.ty.width;
                            if (ix.ty.kind != LK.INT) { w = 64; };
                            this.a_sx(1, w);
                            if (sz != 1) { this.a_ln(f"imulq ${sz}, %rcx, %rcx\0"); };
                            this.a_ln(g"addq %rcx, %rax\0");
                        };
                        cur = cur.elem;
                    };
                    i++;
                };
                if (off != (i64)0)
                {
                    if (off > (i64)2147483647 | off < (i64)-2147483648)
                    {
                        this.a_imm((u64)off, 1);
                        this.a_ln(g"addq %rcx, %rax\0");
                    }
                    else
                    {
                        this.ab.clear();
                        this.ab.put_str(g"addq $\0");
                        put_i64(@this.ab, off);
                        this.ab.put_str(g", %rax\0");
                        this.a_ab();
                    };
                };
                v = this.a_newv(this.t_ptr(cur));
                this.a_stv(v, 0);
                -> v;
            };

            a_select(IRValue* c, IRValue* a, IRValue* b, byte* hint) -> IRValue*
            {
                IRValue* v = this.a_newv(a.ty);
                int sz = this.a_size(a.ty);
                int l1, l2;
                if (lt_is_agg(a.ty))
                {
                    this.lab++;
                    l1 = this.lab;
                    this.lab++;
                    l2 = this.lab;
                    this.a_ld(c, 2);
                    this.a_ln(g"testq %rdx, %rdx\0");
                    this.a_ln(f"jne .LS{l1}\0");
                    this.a_agg_src(b);
                    this.a_ln(f"jmp .LS{l2}\0");
                    this.a_ln(f".LS{l1}:\0");
                    this.a_agg_src(a);
                    this.a_ln(f".LS{l2}:\0");
                    this.a_ln(f"leaq {v.slot}(%rbp), %rdi\0");
                    this.a_copy(sz);
                    -> v;
                };
                this.a_ld(a, 0);
                this.a_ld(b, 1);
                this.a_ld(c, 2);
                this.a_ln(g"testq %rdx, %rdx\0");
                this.a_ln(g"cmoveq %rcx, %rax\0");
                this.a_stv(v, 0);
                -> v;
            };

            a_phi(IRType* ty, IRValue** vals, IRBlock** blocks, int n, byte* hint) -> IRValue*
            {
                IRValue* v = this.a_newv(ty);
                IRBlock* sb = this.cb;
                IRBlock* b;
                int i, at, before, sz;
                sz = this.a_size(ty);
                while (i < n)
                {
                    b = blocks[i];
                    this.cb = b;
                    at = b.lines.len;
                    if (b.terminated) { at = b.term_at; };
                    // emit the copy at the end of the block, then move it before the terminator
                    before = b.lines.len;
                    if (lt_is_agg(ty))
                    {
                        this.a_agg_src(vals[i]);
                        this.a_ln(f"leaq {v.slot}(%rbp), %rdi\0");
                        this.a_copy(sz);
                    }
                    else
                    {
                        this.a_ld(vals[i], 0);
                        this.a_stv(v, 0);
                    };
                    this.a_move_tail(b, before, at);
                    if (b.terminated) { b.term_at = b.term_at + (b.lines.len - before); };
                    i++;
                };
                this.cb = sb;
                -> v;
            };

            // Moves the lines from index from to the end of b so that they start at index to
            a_move_tail(IRBlock* b, int fr, int dst) -> void
            {
                int cnt = b.lines.len - fr;
                int i, j;
                void* tmp;
                void** items = b.lines.items;
                if (dst >= fr | cnt <= 0) { ->; };
                // rotate [dst, fr) and [fr, end) so the new lines come first
                i = 0;
                while (i < cnt)
                {
                    j = fr + i;
                    tmp = items[j];
                    while (j > dst + i)
                    {
                        items[j] = items[j - 1];
                        j--;
                    };
                    items[dst + i] = tmp;
                    i++;
                };
                ->;
            };

            a_br(IRBlock* target) -> void
            {
                byte* l = this.a_label(target);
                this.a_term_begin();
                this.a_ln(f"jmp {l}\0");
                this.a_term_end();
                ->;
            };

            a_cbr(IRValue* c, IRBlock* t, IRBlock* f) -> void
            {
                byte* lt = this.a_label(t);
                byte* lf = this.a_label(f);
                this.a_term_begin();
                this.a_ld(c, 0);
                this.a_ln(g"testl $1, %eax\0");
                this.a_ln(f"jne {lt}\0");
                this.a_ln(f"jmp {lf}\0");
                this.a_term_end();
                ->;
            };

            a_epilogue() -> void
            {
                this.a_ln(g"leave\0");
                this.a_ln(g"ret\0");
                ->;
            };

            a_ret(IRValue* v) -> void
            {
                IRType* t = v.ty;
                IRFunc* f = this.cf;
                this.a_term_begin();
                if (this.a_ret_ptr(t))
                {
                    this.a_agg_src(v);
                    this.a_ln(f"movq {f.sret_slot}(%rbp), %rdi\0");
                    this.a_copy(this.a_size(t));
                    this.a_ln(f"movq {f.sret_slot}(%rbp), %rax\0");
                }
                else
                {
                    if (lt_is_agg(t))
                    {
                        // Win64 returns a 1, 2, 4 or 8 byte aggregate in rax
                        this.a_agg_src(v);
                        this.a_agg_load(this.a_size(t), 0);
                    }
                    else
                    {
                        if (lt_is_fp(t))
                        {
                            this.a_ldx(v, 0);
                        }
                        else { this.a_ld(v, 0); };
                    };
                };
                this.a_epilogue();
                this.a_term_end();
                ->;
            };

            a_ret_void() -> void
            {
                this.a_term_begin();
                this.a_epilogue();
                this.a_term_end();
                ->;
            };

            a_unreachable() -> void
            {
                this.a_term_begin();
                this.a_ln(g"ud2\0");
                this.a_term_end();
                ->;
            };

            a_switch(IRValue* v, IRBlock* dflt, IRValue** vals, IRBlock** blocks, int n) -> void
            {
                int i;
                byte* l;
                u64 cv;
                int w = v.ty.width;
                this.a_term_begin();
                this.a_ld(v, 0);
                while (i < n)
                {
                    cv = this.a_mask(this.a_cval(vals[i]), w);
                    l = this.a_label(blocks[i]);
                    if (cv <= (u64)2147483647)
                    {
                        this.ab.clear();
                        this.ab.put_str(g"cmpq $\0");
                        put_u64(@this.ab, cv);
                        this.ab.put_str(g", %rax\0");
                        this.a_ab();
                    }
                    else
                    {
                        this.a_imm(cv, 1);
                        this.a_ln(g"cmpq %rcx, %rax\0");
                    };
                    this.a_ln(f"je {l}\0");
                    i++;
                };
                l = this.a_label(dflt);
                this.a_ln(f"jmp {l}\0");
                this.a_term_end();
                ->;
            };

            a_extractvalue(IRValue* agg, int i, byte* hint) -> IRValue*
            {
                IRType* t = this.index_type(agg.ty, this.c_int(this.t_int(32), (i64)i));
                IRValue* v = this.a_newv(t);
                int off = 0;
                int sz = this.a_size(t);
                if (agg.ty.kind == LK.STRUCT | agg.ty.kind == LK.ISTRUCT) { off = this.a_foff(agg.ty, i); }
                else { off = i * this.a_size(agg.ty.elem); };
                this.a_agg_src(agg);
                if (off != 0) { this.a_ln(f"addq ${off}, %rsi\0"); };
                this.a_ln(f"leaq {v.slot}(%rbp), %rdi\0");
                this.a_copy(sz);
                -> v;
            };

            a_insertvalue(IRValue* agg, IRValue* val, int i, byte* hint) -> IRValue*
            {
                IRValue* v = this.a_newv(agg.ty);
                IRType* et = this.index_type(agg.ty, this.c_int(this.t_int(32), (i64)i));
                int off = 0;
                int sz = this.a_size(agg.ty);
                if (agg.ty.kind == LK.STRUCT | agg.ty.kind == LK.ISTRUCT) { off = this.a_foff(agg.ty, i); }
                else { off = i * this.a_size(agg.ty.elem); };
                this.a_agg_src(agg);
                this.a_ln(f"leaq {v.slot}(%rbp), %rdi\0");
                this.a_copy(sz);
                if (lt_is_agg(et))
                {
                    this.a_agg_src(val);
                    this.a_ln(f"leaq {v.slot + off}(%rbp), %rdi\0");
                    this.a_copy(this.a_size(et));
                    -> v;
                };
                this.a_ld(val, 0);
                switch (this.a_size(et))
                {
                    case (1) { this.a_ln(f"movb %al, {v.slot + off}(%rbp)\0"); }
                    case (2) { this.a_ln(f"movw %ax, {v.slot + off}(%rbp)\0"); }
                    case (4) { this.a_ln(f"movl %eax, {v.slot + off}(%rbp)\0"); }
                    default { this.a_ln(f"movq %rax, {v.slot + off}(%rbp)\0"); };
                };
                -> v;
            };

            // ----------------------------------------------------------
            // Calls
            // ----------------------------------------------------------

            // Win64 call: 32 bytes of shadow space, four register arguments chosen by position,
            // aggregates that are not 1, 2, 4 or 8 bytes passed by pointer to a caller made copy.
            a_call_win(IRValue* callee, IRValue** args, int n, byte* hint, bool tail) -> IRValue*
            {
                IRType* fty = callee.ty.elem;
                IRType* rt = fty.elem;
                IRValue* res = (IRValue*)0;
                IRValue* a;
                int i, p, base, stk, stk16, copyoff, cp, sz;
                bool retp = this.a_ret_ptr(rt);
                bool smallret = lt_is_agg(rt) & !retp;
                bool direct = callee.text[0] == '@' & callee.slot == 0;
                byte* sym;
                if (rt.kind != LK.VOID) { res = this.a_newv(rt); };
                if (retp) { base = 1; };
                stk = 32;
                if (base + n > 4) { stk = stk + (base + n - 4) * 8; };
                copyoff = stk;
                i = 0;
                while (i < n)
                {
                    a = args[i];
                    if (lt_is_agg(a.ty))
                    {
                        sz = this.a_size(a.ty);
                        if (!this.a_small_agg(sz)) { stk = stk + (sz + 15) / 16 * 16; };
                    };
                    i++;
                };
                stk16 = (stk + 15) / 16 * 16;
                this.a_ln(f"subq ${stk16}, %rsp\0");
                // copies of by-pointer aggregates and the stack arguments
                cp = copyoff;
                i = 0;
                while (i < n)
                {
                    a = args[i];
                    p = base + i;
                    if (lt_is_agg(a.ty))
                    {
                        sz = this.a_size(a.ty);
                        if (this.a_small_agg(sz))
                        {
                            if (p >= 4)
                            {
                                this.a_agg_src(a);
                                this.a_agg_load(sz, 0);
                                this.a_ln(f"movq %rax, {8 * p}(%rsp)\0");
                            };
                        }
                        else
                        {
                            this.a_agg_src(a);
                            this.a_ln(f"leaq {cp}(%rsp), %rdi\0");
                            this.a_copy(sz);
                            if (p >= 4)
                            {
                                this.a_ln(f"leaq {cp}(%rsp), %rax\0");
                                this.a_ln(f"movq %rax, {8 * p}(%rsp)\0");
                            };
                            cp = cp + (sz + 15) / 16 * 16;
                        };
                    }
                    else
                    {
                        if (p >= 4)
                        {
                            this.a_ld(a, 0);
                            this.a_ln(f"movq %rax, {8 * p}(%rsp)\0");
                        };
                    };
                    i++;
                };
                if (!direct) { this.a_ld(callee, 8); };
                if (retp) { this.a_ln(f"leaq {res.slot}(%rbp), %rcx\0"); };
                // register arguments
                cp = copyoff;
                i = 0;
                while (i < n)
                {
                    a = args[i];
                    p = base + i;
                    if (lt_is_agg(a.ty))
                    {
                        sz = this.a_size(a.ty);
                        if (this.a_small_agg(sz))
                        {
                            if (p < 4)
                            {
                                this.a_agg_src(a);
                                this.a_agg_load(sz, this.a_argreg(p));
                            };
                        }
                        else
                        {
                            if (p < 4) { this.a_ln(f"leaq {cp}(%rsp), {this.a_reg(this.a_argreg(p), 8)}\0"); };
                            cp = cp + (sz + 15) / 16 * 16;
                        };
                    }
                    else
                    {
                        if (p < 4)
                        {
                            if (lt_is_fp(a.ty))
                            {
                                this.a_ldx(a, p);
                                // a variadic callee reads floating point arguments from the integer registers
                                if (fty.vararg) { this.a_ln(f"movq %xmm{p}, {this.a_reg(this.a_argreg(p), 8)}\0"); };
                            }
                            else { this.a_ld(a, this.a_argreg(p)); };
                        };
                    };
                    i++;
                };
                if (direct)
                {
                    sym = this.a_sym(callee.text);
                    this.a_ln(f"callq {sym}\0");
                }
                else { this.a_ln(g"callq *%r11\0"); };
                this.a_ln(f"addq ${stk16}, %rsp\0");
                if (rt.kind == LK.VOID) { -> (IRValue*)0; };
                if (retp) { -> res; };
                if (smallret)
                {
                    sz = this.a_size(rt);
                    switch (sz)
                    {
                        case (1) { this.a_ln(f"movb %al, {res.slot}(%rbp)\0"); }
                        case (2) { this.a_ln(f"movw %ax, {res.slot}(%rbp)\0"); }
                        case (4) { this.a_ln(f"movl %eax, {res.slot}(%rbp)\0"); }
                        default { this.a_ln(f"movq %rax, {res.slot}(%rbp)\0"); };
                    };
                    -> res;
                };
                if (rt.kind == LK.FLOAT) { this.a_ln(g"movd %xmm0, %eax\0"); }
                else
                {
                    if (rt.kind == LK.DOUBLE) { this.a_ln(g"movq %xmm0, %rax\0"); }
                    else { if (rt.kind == LK.INT) { this.a_norm(0, rt.width); }; };
                };
                this.a_stv(res, 0);
                -> res;
            };

            a_call(IRValue* callee, IRValue** args, int n, byte* hint, bool tail) -> IRValue*
            {
                IRType* fty = callee.ty.elem;
                IRType* rt = fty.elem;
                IRValue* res = (IRValue*)0;
                IRValue* a;
                int i, ngp, nfp, stk, stk16, cur, sz, nx;
                bool agg_ret = lt_is_agg(rt);
                bool direct = callee.text[0] == '@' & callee.slot == 0;
                byte* sym;
                byte* rn;
                if (this.a_pre(callee.text, g"asm\0")) { -> this.a_inline(callee, args, n); };
                if (direct & this.a_pre(callee.text, g"@\"llvm.\0"))
                {
                    res = this.a_intrinsic(callee.text + 7, args, n, rt);
                    if (res != (IRValue*)0 | this.a_handled) { this.a_handled = false; -> res; };
                };
                if (this.a_win()) { -> this.a_call_win(callee, args, n, hint, tail); };
                if (rt.kind != LK.VOID) { res = this.a_newv(rt); };
                if (agg_ret) { ngp = 1; };
                i = 0;
                while (i < n)
                {
                    a = args[i];
                    sz = this.a_size(a.ty);
                    if (lt_is_agg(a.ty)) { stk = stk + (sz + 7) / 8 * 8; }
                    else
                    {
                        if (lt_is_fp(a.ty))
                        {
                            if (nfp < 8) { nfp++; } else { stk = stk + 8; };
                        }
                        else
                        {
                            if (ngp < 6) { ngp++; } else { stk = stk + 8; };
                        };
                    };
                    i++;
                };
                stk16 = (stk + 15) / 16 * 16;
                if (stk16 > 0)
                {
                    this.a_ln(f"subq ${stk16}, %rsp\0");
                    ngp = 0;
                    nfp = 0;
                    if (agg_ret) { ngp = 1; };
                    cur = 0;
                    i = 0;
                    while (i < n)
                    {
                        a = args[i];
                        sz = this.a_size(a.ty);
                        if (lt_is_agg(a.ty))
                        {
                            this.a_agg_src(a);
                            this.a_ln(f"leaq {cur}(%rsp), %rdi\0");
                            this.a_copy(sz);
                            cur = cur + (sz + 7) / 8 * 8;
                        }
                        else
                        {
                            if (lt_is_fp(a.ty))
                            {
                                if (nfp < 8) { nfp++; }
                                else
                                {
                                    this.a_ld(a, 0);
                                    this.a_ln(f"movq %rax, {cur}(%rsp)\0");
                                    cur = cur + 8;
                                };
                            }
                            else
                            {
                                if (ngp < 6) { ngp++; }
                                else
                                {
                                    this.a_ld(a, 0);
                                    this.a_ln(f"movq %rax, {cur}(%rsp)\0");
                                    cur = cur + 8;
                                };
                            };
                        };
                        i++;
                    };
                };
                if (!direct) { this.a_ld(callee, 8); };
                ngp = 0;
                nfp = 0;
                if (agg_ret)
                {
                    this.a_ln(f"leaq {res.slot}(%rbp), %rdi\0");
                    ngp = 1;
                };
                i = 0;
                while (i < n)
                {
                    a = args[i];
                    if (!lt_is_agg(a.ty))
                    {
                        if (lt_is_fp(a.ty))
                        {
                            if (nfp < 8)
                            {
                                this.a_ldx(a, nfp);
                                nfp++;
                            };
                        }
                        else
                        {
                            if (ngp < 6)
                            {
                                this.a_ld(a, this.a_argreg(ngp));
                                ngp++;
                            };
                        };
                    };
                    i++;
                };
                if (fty.vararg) { this.a_ln(f"movl ${nfp}, %eax\0"); };
                if (direct)
                {
                    sym = this.a_sym(callee.text);
                    this.a_ln(f"callq {sym}\0");
                }
                else { this.a_ln(g"callq *%r11\0"); };
                if (stk16 > 0) { this.a_ln(f"addq ${stk16}, %rsp\0"); };
                if (rt.kind == LK.VOID) { -> (IRValue*)0; };
                if (agg_ret) { -> res; };
                if (rt.kind == LK.FLOAT) { this.a_ln(g"movd %xmm0, %eax\0"); }
                else
                {
                    if (rt.kind == LK.DOUBLE) { this.a_ln(g"movq %xmm0, %rax\0"); }
                    else { if (rt.kind == LK.INT) { this.a_norm(0, rt.width); }; };
                };
                this.a_stv(res, 0);
                -> res;
            };

            // ----------------------------------------------------------
            // Intrinsics
            // ----------------------------------------------------------

            // nm is the text after @"llvm. Returns the result value, or sets a_handled for a
            // void intrinsic.
            a_intrinsic(byte* nm, IRValue** args, int n, IRType* rt) -> IRValue*
            {
                IRValue* v;
                int w;
                int l1, l2;
                this.a_handled = false;
                if (this.a_pre(nm, g"memset.\0"))
                {
                    this.a_ld(args[0], 4);
                    this.a_ld(args[1], 0);
                    this.a_ld(args[2], 1);
                    this.a_ln(g"rep stosb\0");
                    this.a_handled = true;
                    -> (IRValue*)0;
                };
                if (this.a_pre(nm, g"memcpy.\0"))
                {
                    this.a_ld(args[0], 4);
                    this.a_ld(args[1], 3);
                    this.a_ld(args[2], 1);
                    this.a_ln(g"rep movsb\0");
                    this.a_handled = true;
                    -> (IRValue*)0;
                };
                if (this.a_pre(nm, g"memmove.\0"))
                {
                    this.lab++;
                    l1 = this.lab;
                    this.lab++;
                    l2 = this.lab;
                    this.a_ld(args[0], 4);
                    this.a_ld(args[1], 3);
                    this.a_ld(args[2], 1);
                    this.a_ln(g"cmpq %rsi, %rdi\0");
                    this.a_ln(f"jbe .LM{l1}\0");
                    this.a_ln(g"leaq -1(%rsi,%rcx), %rsi\0");
                    this.a_ln(g"leaq -1(%rdi,%rcx), %rdi\0");
                    this.a_ln(g"std\0");
                    this.a_ln(g"rep movsb\0");
                    this.a_ln(g"cld\0");
                    this.a_ln(f"jmp .LM{l2}\0");
                    this.a_ln(f".LM{l1}:\0");
                    this.a_ln(g"rep movsb\0");
                    this.a_ln(f".LM{l2}:\0");
                    this.a_handled = true;
                    -> (IRValue*)0;
                };
                if (this.a_pre(nm, g"bswap.i\0"))
                {
                    v = this.a_newv(rt);
                    w = rt.width;
                    this.a_ld(args[0], 0);
                    if (w == 16) { this.a_ln(g"rolw $8, %ax\0"); this.a_ln(g"movzwl %ax, %eax\0"); };
                    if (w == 32) { this.a_ln(g"bswapl %eax\0"); };
                    if (w == 64) { this.a_ln(g"bswapq %rax\0"); };
                    this.a_stv(v, 0);
                    this.a_handled = true;
                    -> v;
                };
                if (this.a_pre(nm, g"trap\0"))
                {
                    this.a_ln(g"ud2\0");
                    this.a_handled = true;
                    -> (IRValue*)0;
                };
                if (this.a_pre(nm, g"debugtrap\0"))
                {
                    this.a_ln(g"int3\0");
                    this.a_handled = true;
                    -> (IRValue*)0;
                };
                if (this.a_pre(nm, g"va_start\0"))
                {
                    this.a_va_start(args[0]);
                    this.a_handled = true;
                    -> (IRValue*)0;
                };
                if (this.a_pre(nm, g"va_end\0"))
                {
                    this.a_handled = true;
                    -> (IRValue*)0;
                };
                if (this.a_pre(nm, g"va_copy\0"))
                {
                    this.a_ld(args[0], 4);
                    this.a_ld(args[1], 3);
                    // the Win64 va_list is one pointer, the System V one is 24 bytes
                    if (this.a_win()) { this.a_copy(8); }
                    else { this.a_copy(24); };
                    this.a_handled = true;
                    -> (IRValue*)0;
                };
                this.a_unsup(nm);
                this.a_handled = true;
                -> (IRValue*)0;
            };

            // ----------------------------------------------------------
            // Variadic functions (System V va_list)
            // ----------------------------------------------------------

            a_va_start(IRValue* ap) -> void
            {
                IRFunc* f = this.cf;
                if (this.a_win())
                {
                    // Win64 va_list is a pointer to the first unnamed argument in the home area
                    this.a_ld(ap, 1);
                    this.a_ln(f"leaq {16 + 8 * f.va_gp}(%rbp), %rax\0");
                    this.a_ln(g"movq %rax, (%rcx)\0");
                    ->;
                };
                this.a_ld(ap, 1);
                this.a_ln(f"movl ${f.va_gp * 8}, (%rcx)\0");
                this.a_ln(f"movl ${48 + f.va_fp * 16}, 4(%rcx)\0");
                this.a_ln(f"leaq {f.va_stk}(%rbp), %rax\0");
                this.a_ln(g"movq %rax, 8(%rcx)\0");
                this.a_ln(f"leaq {f.va_slot}(%rbp), %rax\0");
                this.a_ln(g"movq %rax, 16(%rcx)\0");
                ->;
            };

            a_va_arg(IRValue* list, IRType* ty, byte* hint) -> IRValue*
            {
                IRValue* v = this.a_newv(ty);
                int l1, l2, sz;
                bool fp = lt_is_fp(ty);
                if (this.a_win())
                {
                    sz = this.a_size(ty);
                    if (lt_is_agg(ty))
                    {
                        this.a_unsup(g"va_arg of an aggregate on Win64\0");
                        -> v;
                    };
                    this.a_ld(list, 1);
                    this.a_ln(g"movq (%rcx), %rdx\0");
                    this.a_ln(g"leaq 8(%rdx), %r8\0");
                    this.a_ln(g"movq %r8, (%rcx)\0");
                    switch (sz)
                    {
                        case (1) { this.a_ln(g"movzbl (%rdx), %eax\0"); }
                        case (2) { this.a_ln(g"movzwl (%rdx), %eax\0"); }
                        case (4) { this.a_ln(g"movl (%rdx), %eax\0"); }
                        default { this.a_ln(g"movq (%rdx), %rax\0"); };
                    };
                    this.a_stv(v, 0);
                    -> v;
                };
                this.lab++;
                l1 = this.lab;
                this.lab++;
                l2 = this.lab;
                sz = this.a_size(ty);
                this.a_ld(list, 1);
                if (fp)
                {
                    this.a_ln(g"movl 4(%rcx), %eax\0");
                    this.a_ln(g"cmpl $160, %eax\0");
                }
                else
                {
                    this.a_ln(g"movl (%rcx), %eax\0");
                    this.a_ln(g"cmpl $40, %eax\0");
                };
                this.a_ln(f"ja .LV{l1}\0");
                this.a_ln(g"movq 16(%rcx), %rdx\0");
                this.a_ln(g"addq %rax, %rdx\0");
                if (fp) { this.a_ln(g"addl $16, 4(%rcx)\0"); }
                else { this.a_ln(g"addl $8, (%rcx)\0"); };
                this.a_ln(f"jmp .LV{l2}\0");
                this.a_ln(f".LV{l1}:\0");
                this.a_ln(g"movq 8(%rcx), %rdx\0");
                this.a_ln(g"leaq 8(%rdx), %rax\0");
                this.a_ln(g"movq %rax, 8(%rcx)\0");
                this.a_ln(f".LV{l2}:\0");
                switch (sz)
                {
                    case (1) { this.a_ln(g"movzbl (%rdx), %eax\0"); }
                    case (2) { this.a_ln(g"movzwl (%rdx), %eax\0"); }
                    case (4) { this.a_ln(g"movl (%rdx), %eax\0"); }
                    default { this.a_ln(g"movq (%rdx), %rax\0"); };
                };
                this.a_stv(v, 0);
                -> v;
            };

            // ----------------------------------------------------------
            // Inline asm
            // ----------------------------------------------------------

            // Register index of a name such as rax, eax, ax, al, r10d, or -1
            a_regidx(byte* nm) -> int
            {
                int r, k;
                while (r < 14)
                {
                    k = 0;
                    while (k < 4)
                    {
                        if (this.a_seq(nm, this.rtab[r * 4 + k] + 1)) { -> r; };
                        k++;
                    };
                    r++;
                };
                -> -1;
            };

            a_inline(IRValue* callee, IRValue** args, int n) -> IRValue*
            {
                byte* t = callee.text;
                IRType* fty = callee.ty.elem;
                IRType* rt = fty.elem;
                IRFunc* f = this.cf;
                int len, i, j, bs, ce, qs, bodyend, no, ni, nop, used, cb, ce2, k, c, r, sz;
                int[40] opreg = noinit;
                int[40] opkind = noinit;
                int[40] opty = noinit;
                int[40] opx = noinit;
                int[40] opmem = noinit;
                int nxr, xi;
                IRValue* res = (IRValue*)0;
                IRType* ot;
                byte* rn;
                bool brace;
                int modc;
                // locate body and constraint strings
                len = 0;
                while (t[len] != 0) { len++; };
                while (len > 0 & t[len - 1] != 34) { len--; };
                ce = len - 1;
                qs = ce - 1;
                while (qs > 0 & t[qs] != 34) { qs--; };
                bodyend = qs - 3;
                bs = 0;
                while (t[bs] != 34) { bs++; };
                bs++;
                // constraints: count outputs and inputs, collect clobbers and explicit registers
                i = qs + 1;
                nop = 0;
                no = 0;
                ni = 0;
                used = 0;
                while (i < ce)
                {
                    cb = i;
                    while (i < ce & t[i] != ',') { i++; };
                    ce2 = i;
                    if (t[cb] == '~')
                    {
                        // ~{reg}
                        this.mb.clear();
                        j = cb + 2;
                        while (j < ce2 & t[j] != '}') { this.mb.put((int)t[j]); j++; };
                        r = this.a_regidx(this.mb.mem);
                        if (r >= 0) { used = used `| (1 << r); };
                    }
                    else
                    {
                        if (t[cb] == '=')
                        {
                            opkind[nop] = 1;
                            opreg[nop] = -1;
                            opx[nop] = -1;
                            opmem[nop] = 0;
                            if (t[ce2 - 1] == 'x') { opkind[nop] = 10; opx[nop] = -2; };
                            if (t[cb + 1] == '{' & t[cb + 2] == 'x' & t[cb + 3] == 'm') { opkind[nop] = 10; opx[nop] = (int)t[cb + 6] - 48; };
                            j = cb + 1;
                            while (j < ce2)
                            {
                                if (t[j] == '{')
                                {
                                    this.mb.clear();
                                    j++;
                                    while (j < ce2 & t[j] != '}') { this.mb.put((int)t[j]); j++; };
                                    r = this.a_regidx(this.mb.mem);
                                    opreg[nop] = r;
                                    if (r >= 0) { used = used `| (1 << r); };
                                };
                                if (t[j] == '&') { opkind[nop] = 3; };
                                j++;
                            };
                            nop++;
                            no++;
                        }
                        else
                        {
                            opkind[nop] = 2;
                            opreg[nop] = -1;
                            opx[nop] = -1;
                            opmem[nop] = 0;
                            if (t[cb] == 'm') { opmem[nop] = 1; };
                            if (t[ce2 - 1] == 'x') { opkind[nop] = 9; opx[nop] = -2; };
                            if (t[cb] == '{' & t[cb + 1] == 'x' & t[cb + 2] == 'm') { opkind[nop] = 9; opx[nop] = (int)t[cb + 5] - 48; };
                            if (t[cb] == '{' & opkind[nop] == 2)
                            {
                                this.mb.clear();
                                j = cb + 1;
                                while (j < ce2 & t[j] != '}') { this.mb.put((int)t[j]); j++; };
                                r = this.a_regidx(this.mb.mem);
                                opreg[nop] = r;
                                if (r >= 0) { used = used `| (1 << r); };
                            };
                            if (t[cb] >= 48 & t[cb] <= 57)
                            {
                                opkind[nop] = 4;
                                opreg[nop] = (int)t[cb] - 48;
                            };
                            if (t[cb] == 'i' | t[cb] == 'n') { opkind[nop] = 5; };
                            nop++;
                            ni++;
                        };
                    };
                    i = ce2 + 1;
                };
                // operand types
                i = 0;
                while (i < no)
                {
                    if (no == 1) { opty[i] = this.a_size(rt); }
                    else { opty[i] = this.a_size(rt.items[i]); };
                    i++;
                };
                i = 0;
                while (i < ni)
                {
                    opty[no + i] = this.a_size(args[i].ty);
                    i++;
                };
                // xmm operands take consecutive registers unless named
                nxr = 0;
                i = 0;
                while (i < nop)
                {
                    if (opx[i] == -2) { opx[i] = nxr; nxr++; };
                    i++;
                };
                // inputs take the first free registers
                i = no;
                while (i < nop)
                {
                    if (opkind[i] == 2 & opreg[i] < 0)
                    {
                        r = this.a_pick(used);
                        opreg[i] = r;
                        used = used `| (1 << r);
                    };
                    i++;
                };
                // tied inputs share the register of their output, explicit outputs keep theirs
                i = no;
                while (i < nop)
                {
                    if (opkind[i] == 4)
                    {
                        k = opreg[i];
                        if (opreg[k] < 0)
                        {
                            r = this.a_pick(used);
                            opreg[k] = r;
                            used = used `| (1 << r);
                        };
                        opreg[i] = opreg[k];
                    };
                    i++;
                };
                // outputs reuse an input register when they are not early clobbered
                i = 0;
                while (i < no)
                {
                    if (opreg[i] < 0 & opkind[i] != 10)
                    {
                        r = -1;
                        if (opkind[i] != 3)
                        {
                            j = no;
                            while (j < nop & r < 0)
                            {
                                if (opkind[j] == 2 & opreg[j] >= 0 & !this.a_tied(@opreg[0], @opkind[0], no, nop, opreg[j]))
                                {
                                    r = opreg[j];
                                    opkind[j] = 6;
                                };
                                j++;
                            };
                        };
                        if (r < 0)
                        {
                            r = this.a_pick(used);
                            used = used `| (1 << r);
                        };
                        opreg[i] = r;
                    };
                    i++;
                };
                // callee saved registers used by the asm are saved by the prologue
                i = 0;
                while (i < nop)
                {
                    if (opreg[i] >= 9) { this.a_cs_use(opreg[i] - 9); };
                    i++;
                };
                if ((used `& (1 << 9)) != 0) { this.a_cs_use(0); };
                if ((used `& (1 << 10)) != 0) { this.a_cs_use(1); };
                if ((used `& (1 << 11)) != 0) { this.a_cs_use(2); };
                if ((used `& (1 << 12)) != 0) { this.a_cs_use(3); };
                if ((used `& (1 << 13)) != 0) { this.a_cs_use(4); };
                // load inputs (tied inputs load into the output register)
                i = no;
                while (i < nop)
                {
                    if (opkind[i] == 2 | opkind[i] == 6 | opkind[i] == 4)
                    {
                        this.a_ld(args[i - no], opreg[i]);
                    };
                    if (opkind[i] == 9) { this.a_ldx(args[i - no], opx[i]); };
                    i++;
                };
                // body text
                this.mb.clear();
                i = bs;
                while (i < bodyend)
                {
                    c = (int)t[i];
                    if (c == '$')
                    {
                        if (t[i + 1] == '$') { this.mb.put(36); i = i + 2; }
                        else
                        {
                            i++;
                            if (t[i] == '{') { brace = true; i++; };
                            k = 0;
                            while (t[i] >= 48 & t[i] <= 57) { k = k * 10 + ((int)t[i] - 48); i++; };
                            if (brace)
                            {
                                if (t[i] == ':') { i++; modc = (int)t[i]; i++; };
                                if (t[i] == '}') { i++; };
                            };
                            sz = opty[k];
                            if (modc == 'q') { sz = 8; };
                            if (modc == 'k') { sz = 4; };
                            if (modc == 'w') { sz = 2; };
                            if (modc == 'b') { sz = 1; };
                            if (opkind[k] == 5)
                            {
                                put_i64(@this.mb, (i64)this.a_cval(args[k - no]));
                            }
                            else
                            {
                                if (opkind[k] == 9 | opkind[k] == 10)
                                {
                                    xi = opx[k];
                                    this.mb.put_str(g"%xmm\0");
                                    this.mb.put_int(xi);
                                }
                                else
                                {
                                    // a memory operand is addressed through the register holding its pointer
                                    if (opmem[k] == 1)
                                    {
                                        this.mb.put(40);
                                        this.mb.put_str(this.a_reg(opreg[k], 8));
                                        this.mb.put(41);
                                    }
                                    else { this.mb.put_str(this.a_reg(opreg[k], sz)); };
                                };
                            };
                        };
                    }
                    else { this.mb.put(c); i++; };
                };
                this.a_asm_lines(this.mb.mem);
                // outputs
                if (no == 1 & opkind[0] == 10)
                {
                    res = this.a_stx(rt, opx[0]);
                }
                else
                {
                    if (no == 1)
                    {
                        res = this.a_newv(rt);
                        if (rt.kind == LK.INT) { this.a_norm(opreg[0], rt.width); };
                        this.a_stv(res, opreg[0]);
                    };
                };
                if (no > 1)
                {
                    res = this.a_newv(rt);
                    i = 0;
                    while (i < no)
                    {
                        ot = rt.items[i];
                        if (ot.kind == LK.INT) { this.a_norm(opreg[i], ot.width); };
                        k = res.slot + this.a_foff(rt, i);
                        sz = this.a_size(ot);
                        rn = this.a_reg(opreg[i], sz);
                        switch (sz)
                        {
                            case (1) { this.a_ln(f"movb {rn}, {k}(%rbp)\0"); }
                            case (2) { this.a_ln(f"movw {rn}, {k}(%rbp)\0"); }
                            case (4) { this.a_ln(f"movl {rn}, {k}(%rbp)\0"); }
                            default { this.a_ln(f"movq {rn}, {k}(%rbp)\0"); };
                        };
                        i++;
                    };
                };
                -> res;
            };

            // True when a tied input points at register reg
            a_tied(int* opreg, int* opkind, int no, int nop, int reg) -> bool
            {
                int i = no;
                while (i < nop)
                {
                    if (opkind[i] == 4 & opreg[i] == reg) { -> true; };
                    i++;
                };
                -> false;
            };

            // First register not in used, caller saved ones first
            a_pick(int used) -> int
            {
                int r;
                while (r < 14)
                {
                    if ((used `& (1 << r)) == 0) { -> r; };
                    r++;
                };
                -> 13;
            };

            // Marks callee saved register k (0 rbx, 1 r12 ... 4 r15) as used by the function
            a_cs_use(int k) -> void
            {
                IRFunc* f = this.cf;
                if ((f.cs_mask `& (1 << k)) == 0)
                {
                    f.cs_mask = f.cs_mask `| (1 << k);
                    f.cs[k] = this.a_slot(8, 8);
                };
                ->;
            };

            // Splits asm body text into lines, trimming blanks
            a_asm_lines(byte* s) -> void
            {
                int i, a, b;
                int n;
                while (s[n] != 0) { n++; };
                while (i <= n)
                {
                    a = i;
                    while (i < n & s[i] != 10) { i++; };
                    b = i;
                    while (a < b & (s[a] == ' ' | s[a] == 9 | s[a] == 13)) { a++; };
                    while (b > a & (s[b - 1] == ' ' | s[b - 1] == 9 | s[b - 1] == 13)) { b--; };
                    if (b > a)
                    {
                        this.ab.clear();
                        while (a < b) { this.ab.put((int)s[a]); a++; };
                        this.a_ab();
                    };
                    i++;
                };
                ->;
            };

            // ----------------------------------------------------------
            // Constant data
            // ----------------------------------------------------------

            a_emit_int(Buf* o, int sz, u64 bits) -> void
            {
                switch (sz)
                {
                    case (1) { o.put_str(g"\t.byte \0"); }
                    case (2) { o.put_str(g"\t.short \0"); }
                    case (4) { o.put_str(g"\t.long \0"); }
                    default { o.put_str(g"\t.quad \0"); };
                };
                put_u64(o, this.a_mask(bits, sz * 8));
                o.put(10);
                ->;
            };

            a_zero(Buf* o, int n) -> void
            {
                if (n > 0)
                {
                    o.put_str(g"\t.zero \0");
                    o.put_int(n);
                    o.put(10);
                };
                ->;
            };

            // Emits the initializer text s (at p, without its type) for type t
            a_dat(IRType* t, byte* s, int* p, Buf* o) -> void
            {
                int k = t.kind;
                int sz = this.a_size(t);
                int i, off, a, c, cnt, hi, lo;
                u64 bits;
                byte* sym;
                i64 so;
                while (s[*p] == ' ') { *p = *p + 1; };
                if (this.a_pre(s + *p, g"zeroinitializer\0"))
                {
                    *p = *p + 15;
                    this.a_zero(o, sz);
                    ->;
                };
                if (this.a_pre(s + *p, g"undef\0"))
                {
                    *p = *p + 5;
                    this.a_zero(o, sz);
                    ->;
                };
                if (k == LK.INT)
                {
                    if (this.a_pre(s + *p, g"true\0")) { bits = (u64)1; *p = *p + 4; }
                    else
                    {
                        if (this.a_pre(s + *p, g"false\0")) { bits = (u64)0; *p = *p + 5; }
                        else
                        {
                            bits = this.a_num(s + *p);
                            if (s[*p] == '-') { *p = *p + 1; };
                            while (s[*p] >= 48 & s[*p] <= 57) { *p = *p + 1; };
                        };
                    };
                    this.a_emit_int(o, sz, bits);
                    ->;
                };
                if (k == LK.FLOAT | k == LK.DOUBLE)
                {
                    bits = this.a_num(s + *p);
                    if (s[*p] == '0' & s[*p + 1] == 'x')
                    {
                        *p = *p + 2;
                        while ((s[*p] >= 48 & s[*p] <= 57) | (s[*p] >= 97 & s[*p] <= 102) | (s[*p] >= 65 & s[*p] <= 70)) { *p = *p + 1; };
                        if (k == LK.FLOAT) { bits = this.a_f32bits(bits); };
                    }
                    else
                    {
                        if (s[*p] == '-') { *p = *p + 1; };
                        while ((s[*p] >= 48 & s[*p] <= 57) | s[*p] == '.') { *p = *p + 1; };
                    };
                    this.a_emit_int(o, sz, bits);
                    ->;
                };
                if (k == LK.PTR | k == LK.FUNC)
                {
                    if (this.a_cx(s, p))
                    {
                        sym = this.cx_sym;
                        so = this.cx_off;
                        o.put_str(g"\t.quad \0");
                        if (sym != (byte*)0)
                        {
                            o.put_str(sym);
                            if (so != (i64)0) { o.put(43); put_i64(o, so); };
                        }
                        else { put_i64(o, so); };
                        o.put(10);
                    }
                    else
                    {
                        o.put_str(g"\t.quad 0 # unsupported pointer constant\n\0");
                        this.nunsup++;
                    };
                    ->;
                };
                if (k == LK.ARRAY)
                {
                    if (s[*p] == 'c' & s[*p + 1] == '"')
                    {
                        *p = *p + 2;
                        cnt = 0;
                        while (s[*p] != 34 & s[*p] != 0)
                        {
                            c = (int)s[*p];
                            if (c == 92)
                            {
                                hi = (int)s[*p + 1];
                                lo = (int)s[*p + 2];
                                if (hi >= 97) { hi = hi - 87; } else { if (hi >= 65) { hi = hi - 55; } else { hi = hi - 48; }; };
                                if (lo >= 97) { lo = lo - 87; } else { if (lo >= 65) { lo = lo - 55; } else { lo = lo - 48; }; };
                                c = hi * 16 + lo;
                                *p = *p + 3;
                            }
                            else { *p = *p + 1; };
                            if (cnt % 16 == 0) { o.put_str(g"\t.byte \0"); }
                            else { o.put_str(g", \0"); };
                            o.put_int(c);
                            cnt++;
                            if (cnt % 16 == 0) { o.put(10); };
                        };
                        if (cnt % 16 != 0) { o.put(10); };
                        *p = *p + 1;
                        ->;
                    };
                    *p = *p + 1;
                    i = 0;
                    while (i < t.count)
                    {
                        while (s[*p] == ' ') { *p = *p + 1; };
                        this.a_skiptype(s, p);
                        this.a_dat(t.elem, s, p, o);
                        while (s[*p] == ',' | s[*p] == ' ') { *p = *p + 1; };
                        i++;
                    };
                    if (s[*p] == ']') { *p = *p + 1; };
                    ->;
                };
                if (k == LK.STRUCT | k == LK.ISTRUCT)
                {
                    *p = *p + 1;
                    i = 0;
                    while (i < t.nitems)
                    {
                        a = this.a_foff(t, i);
                        this.a_zero(o, a - off);
                        off = a;
                        while (s[*p] == ' ') { *p = *p + 1; };
                        this.a_skiptype(s, p);
                        this.a_dat(t.items[i], s, p, o);
                        off = off + this.a_size(t.items[i]);
                        while (s[*p] == ',' | s[*p] == ' ') { *p = *p + 1; };
                        i++;
                    };
                    this.a_zero(o, sz - off);
                    if (s[*p] == '}') { *p = *p + 1; };
                    ->;
                };
                this.a_zero(o, sz);
                this.nunsup++;
                ->;
            };

            a_log2(int a) -> int
            {
                int n;
                while ((1 << n) < a) { n++; };
                -> n;
            };

            a_put_global(Buf* out, IRGlobal* g) -> void
            {
                int sz = this.a_size(g.ty);
                int al = this.a_align(g.ty);
                int p;
                byte* nm;
                bool zero;
                bool islocal = false;
                if (g.linkage != (byte*)0)
                {
                    if (this.a_seq(g.linkage, g"internal\0") | this.a_seq(g.linkage, g"private\0")) { islocal = true; };
                    if (this.a_seq(g.linkage, g"external\0") & g.init == (byte*)0) { ->; };
                };
                nm = this.a_sym(g.self.text);
                zero = g.init == (byte*)0;
                if (!zero)
                {
                    if (this.a_pre(g.init, g"zeroinitializer\0") | this.a_pre(g.init, g"null\0") | this.a_pre(g.init, g"false\0")) { zero = true; };
                    if (g.init[0] == '0' & g.init[1] == 0) { zero = true; };
                };
                if (g.constant & !zero) { out.put_str(this.a_rodata()); }
                else
                {
                    if (zero) { out.put_str(g"\t.bss\n\0"); }
                    else { out.put_str(g"\t.data\n\0"); };
                };
                if (al < 8 & sz >= 8) { al = 8; };
                if (sz >= 16 & al < 16) { al = 16; };
                out.put_str(g"\t.p2align \0");
                out.put_int(this.a_log2(al));
                out.put(10);
                if (!islocal)
                {
                    out.put_str(g"\t.globl \0");
                    out.put_str(nm);
                    out.put(10);
                };
                if (!this.a_win())
                {
                    out.put_str(g"\t.type \0");
                    out.put_str(nm);
                    out.put_str(g",@object\n\t.size \0");
                    out.put_str(nm);
                    out.put_str(g", \0");
                    out.put_int(sz);
                    out.put(10);
                };
                out.put_str(nm);
                out.put_str(g":\n\0");
                if (zero) { this.a_zero(out, sz); }
                else { this.a_dat(g.ty, g.init, @p, out); };
                ->;
            };

            // ----------------------------------------------------------
            // Functions and module
            // ----------------------------------------------------------

            // Zero extends the low w bits of register r into the text buffer
            a_norm_buf(Buf* o, int r, int w) -> void
            {
                byte* r32 = this.a_reg(r, 4);
                if (w >= 64) { ->; };
                o.put(9);
                if (w == 32) { o.put_str(f"movl {r32}, {r32}\n\0"); ->; };
                if (w == 16) { o.put_str(f"movzwl {this.a_reg(r, 2)}, {r32}\n\0"); ->; };
                if (w == 8) { o.put_str(f"movzbl {this.a_reg(r, 1)}, {r32}\n\0"); ->; };
                o.put_str(f"andl $1, {r32}\n\0");
                ->;
            };

            // a naked function has no prologue, epilogue or spilled arguments
            a_naked(IRFunc* f) -> bool
            {
                int i = 0;
                while (i < f.attrs.len)
                {
                    if (this.a_seq((byte*)f.attrs.items[i], g"naked\0")) { -> true; };
                    i++;
                };
                -> false;
            };

            // Win64 prologue part after the frame exists: save rsi and rdi, home and spill the
            // register arguments, then make private copies of aggregates passed by pointer.
            a_prologue_win(Buf* out, IRFunc* f) -> void
            {
                int i, p, base, sz, j, sl;
                IRType* t;
                if (this.a_ret_ptr(f.ftype.elem)) { base = 1; };
                out.put_str(f"\tmovq %rsi, {f.wsave}(%rbp)\n\tmovq %rdi, {f.wsave + 8}(%rbp)\n\0");
                if (f.ftype.vararg)
                {
                    out.put_str(g"\tmovq %rcx, 16(%rbp)\n\tmovq %rdx, 24(%rbp)\n\tmovq %r8, 32(%rbp)\n\tmovq %r9, 40(%rbp)\n\0");
                };
                if (base == 1) { out.put_str(f"\tmovq %rcx, {f.sret_slot}(%rbp)\n\0"); };
                i = 0;
                while (i < f.nargs)
                {
                    t = f.ftype.items[i];
                    sz = this.a_size(t);
                    p = base + i;
                    if (p < 4)
                    {
                        j = this.a_argreg(p);
                        sl = f.args[i].slot;
                        if (lt_is_agg(t))
                        {
                            if (this.a_small_agg(sz)) { out.put_str(f"\tmovq {this.a_reg(j, 8)}, {sl}(%rbp)\n\0"); }
                            else { out.put_str(f"\tmovq {this.a_reg(j, 8)}, {16 + 8 * p}(%rbp)\n\0"); };
                        }
                        else
                        {
                            if (lt_is_fp(t))
                            {
                                if (t.kind == LK.FLOAT) { out.put_str(f"\tmovd %xmm{p}, %eax\n\tmovq %rax, {sl}(%rbp)\n\0"); }
                                else { out.put_str(f"\tmovq %xmm{p}, {sl}(%rbp)\n\0"); };
                            }
                            else
                            {
                                if (t.kind == LK.INT) { this.a_norm_buf(out, j, t.width); };
                                out.put_str(f"\tmovq {this.a_reg(j, 8)}, {sl}(%rbp)\n\0");
                            };
                        };
                    };
                    i++;
                };
                i = 0;
                while (i < f.nargs)
                {
                    t = f.ftype.items[i];
                    sz = this.a_size(t);
                    p = base + i;
                    if (lt_is_agg(t) & !this.a_small_agg(sz))
                    {
                        sl = f.args[i].slot;
                        out.put_str(f"\tleaq {sl}(%rbp), %rdi\n\tmovq {16 + 8 * p}(%rbp), %rsi\n\tmovl ${sz}, %ecx\n\trep movsb\n\0");
                    };
                    i++;
                };
                ->;
            };

            a_put_function(Buf* out, IRFunc* f) -> void
            {
                int i, j, k, ngp, nfp, frame, sz, sl;
                IRBlock* bl;
                IRType* t;
                byte* nm;
                byte* line;
                bool islocal = false;
                bool weak = false;
                if (f.is_decl) { ->; };
                nm = this.a_sym(f.self.text);
                if (f.linkage != (byte*)0)
                {
                    if (this.a_seq(f.linkage, g"internal\0") | this.a_seq(f.linkage, g"private\0")) { islocal = true; };
                    if (this.a_pre(f.linkage, g"linkonce\0") | this.a_pre(f.linkage, g"weak\0")) { weak = true; };
                };
                frame = (f.frame + 15) / 16 * 16;
                out.put_str(g"\t.text\n\0");
                if (weak)
                {
                    out.put_str(g"\t.weak \0");
                    out.put_str(nm);
                    out.put(10);
                }
                else
                {
                    if (!islocal)
                    {
                        out.put_str(g"\t.globl \0");
                        out.put_str(nm);
                        out.put(10);
                    };
                };
                if (this.a_win())
                {
                    // COFF marks a function with a symbol definition: storage class 2 external, 3 static
                    out.put_str(g"\t.def \0");
                    out.put_str(nm);
                    if (islocal) { out.put_str(g";\n\t.scl 3;\n\t.type 32;\n\t.endef\n\0"); }
                    else { out.put_str(g";\n\t.scl 2;\n\t.type 32;\n\t.endef\n\0"); };
                }
                else
                {
                    out.put_str(g"\t.type \0");
                    out.put_str(nm);
                    out.put_str(g",@function\n\0");
                };
                out.put_str(nm);
                out.put_str(g":\n\0");
                if (this.a_naked(f))
                {
                    // the body is inline asm only, emitted exactly as written
                    j = 0;
                    while (j < f.blocks.len)
                    {
                        bl = (IRBlock*)f.blocks.items[j];
                        out.put_str(f".LB{bl.id}:\n\0");
                        k = 0;
                        while (k < bl.lines.len)
                        {
                            out.put(9);
                            out.put_str((byte*)bl.lines.items[k]);
                            out.put(10);
                            k++;
                        };
                        j++;
                    };
                    if (!this.a_win())
                    {
                        out.put_str(g"\t.size \0");
                        out.put_str(nm);
                        out.put_str(g", .-\0");
                        out.put_str(nm);
                        out.put(10);
                    };
                    ->;
                };
                out.put_str(g"\tpushq %rbp\n\tmovq %rsp, %rbp\n\0");
                if (this.a_win() & frame >= 4096)
                {
                    // the stack grows by touching each page in turn
                    out.put_str(f"\tmovl ${frame}, %eax\n\tcallq __chkstk\n\tsubq %rax, %rsp\n\0");
                }
                else
                {
                    if (frame > 0) { out.put_str(f"\tsubq ${frame}, %rsp\n\0"); };
                };
                k = 0;
                while (k < 5)
                {
                    if ((f.cs_mask `& (1 << k)) != 0)
                    {
                        sl = f.cs[k];
                        out.put_str(f"\tmovq {this.a_reg(9 + k, 8)}, {sl}(%rbp)\n\0");
                    };
                    k++;
                };
                if (this.a_win())
                {
                    this.a_prologue_win(out, f);
                }
                else
                {
                if (lt_is_agg(f.ftype.elem))
                {
                    out.put_str(f"\tmovq %rdi, {f.sret_slot}(%rbp)\n\0");
                    ngp = 1;
                };
                if (f.ftype.vararg)
                {
                    j = f.va_slot;
                    out.put_str(f"\tmovq %rdi, {j}(%rbp)\n\tmovq %rsi, {j + 8}(%rbp)\n\tmovq %rdx, {j + 16}(%rbp)\n\0");
                    out.put_str(f"\tmovq %rcx, {j + 24}(%rbp)\n\tmovq %r8, {j + 32}(%rbp)\n\tmovq %r9, {j + 40}(%rbp)\n\0");
                    k = 0;
                    while (k < 8)
                    {
                        sl = j + 48 + k * 16;
                        out.put_str(f"\tmovaps %xmm{k}, {sl}(%rbp)\n\0");
                        k++;
                    };
                };
                i = 0;
                while (i < f.nargs)
                {
                    t = f.ftype.items[i];
                    if (!lt_is_agg(t) & f.args[i].slot < 0)
                    {
                        if (lt_is_fp(t))
                        {
                            sl = f.args[i].slot;
                            if (t.kind == LK.FLOAT) { out.put_str(f"\tmovd %xmm{nfp}, %eax\n\tmovq %rax, {sl}(%rbp)\n\0"); }
                            else { out.put_str(f"\tmovq %xmm{nfp}, {sl}(%rbp)\n\0"); };
                            nfp++;
                        }
                        else
                        {
                            j = this.a_argreg(ngp);
                            if (t.kind == LK.INT) { this.a_norm_buf(out, j, t.width); };
                            sl = f.args[i].slot;
                            out.put_str(f"\tmovq {this.a_reg(j, 8)}, {sl}(%rbp)\n\0");
                            ngp++;
                        };
                    };
                    i++;
                };
                };
                j = 0;
                while (j < f.blocks.len)
                {
                    bl = (IRBlock*)f.blocks.items[j];
                    out.put_str(f".LB{bl.id}:\n\0");
                    k = 0;
                    while (k < bl.lines.len)
                    {
                        line = (byte*)bl.lines.items[k];
                        if (this.a_seq(line, g"leave\0"))
                        {
                            if (this.a_win())
                            {
                                out.put_str(f"\tmovq {f.wsave}(%rbp), %rsi\n\tmovq {f.wsave + 8}(%rbp), %rdi\n\0");
                            };
                            // restore the callee saved registers the function used
                            i = 0;
                            while (i < 5)
                            {
                                if ((f.cs_mask `& (1 << i)) != 0)
                                {
                                    sl = f.cs[i];
                                    out.put_str(f"\tmovq {sl}(%rbp), {this.a_reg(9 + i, 8)}\n\0");
                                };
                                i++;
                            };
                        };
                        out.put(9);
                        out.put_str(line);
                        out.put(10);
                        k++;
                    };
                    j++;
                };
                if (!this.a_win())
                {
                    out.put_str(g"\t.size \0");
                    out.put_str(nm);
                    out.put_str(g", .-\0");
                    out.put_str(nm);
                    out.put(10);
                };
                ->;
            };

            a_emit(Buf* out) -> void
            {
                int i;
                out.put_str(g"\t.file \0");
                put_quoted(out, this.mod_name);
                out.put(10);
                while (i < this.funcs.len)
                {
                    this.a_put_function(out, (IRFunc*)this.funcs.items[i]);
                    i++;
                };
                i = 0;
                while (i < this.globals.len)
                {
                    this.a_put_global(out, (IRGlobal*)this.globals.items[i]);
                    i++;
                };
                out.put_str(this.cdata.mem);
                if (this.zmax > 0)
                {
                    out.put_str(this.a_rodata());
                    out.put_str(g"\t.p2align 4\n.LZERO:\n\0");
                    this.a_zero(out, this.zmax);
                };
                if (!this.a_win()) { out.put_str(g"\t.section .note.GNU-stack,\"\",@progbits\n\0"); };
                ->;
            };

            // ----------------------------------------------------------
            // Printing
            // ----------------------------------------------------------

            emit(Buf* out) -> void
            {
                this.a_emit(out);
                ->;
            };

        };

    };
};

#endif;
