            ia_vx_fma(cx, g"fmaddsub\0", 0x96, false);
            ia_vx_fma(cx, g"fmsubadd\0", 0x97, false);
            // BMI1 and BMI2 (general registers, VEX encoded)
            ia_vx_bmi(cx, g"andn\0", IA_VF_RVM, 2, 0, 0xF2, 0);
            ia_vx_bmi(cx, g"bextr\0", IA_VF_RMV, 2, 0, 0xF7, 0);
