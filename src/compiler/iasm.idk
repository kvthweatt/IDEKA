        ia_init_evex(IasmCtx* cx) -> void
        {
            int i;
            byte* t, nm;
            // moves
            ia_ex(cx, g"vmovdqa32\0", IA_VF_RM, 1, 1, 0, 0x6F, 0x7F, 0);
            ia_ex(cx, g"vmovdqa64\0", IA_VF_RM, 1, 1, 1, 0x6F, 0x7F, 0);
            ia_ex(cx, g"vmovdqu8\0", IA_VF_RM, 1, 3, 0, 0x6F, 0x7F, 0);
            ia_ex(cx, g"vmovdqu16\0", IA_VF_RM, 1, 3, 1, 0x6F, 0x7F, 0);
            ia_ex(cx, g"vmovdqu32\0", IA_VF_RM, 1, 2, 0, 0x6F, 0x7F, 0);
            ia_ex(cx, g"vmovdqu64\0", IA_VF_RM, 1, 2, 1, 0x6F, 0x7F, 0);
            // logic
            ia_ex_dq(cx, g"vpand\0", IA_VF_RVM, 1, 1, 0xDB, 0, 1);
            ia_ex_dq(cx, g"vpandn\0", IA_VF_RVM, 1, 1, 0xDF, 0, 0);
            ia_ex_dq(cx, g"vpor\0", IA_VF_RVM, 1, 1, 0xEB, 0, 1);
            ia_ex_dq(cx, g"vpxor\0", IA_VF_RVM, 1, 1, 0xEF, 0, 1);
            ia_ex_dq(cx, g"vpternlog\0", IA_VF_RVMI, 3, 1, 0x25, 0, 0);
            // tests and compares into a mask register
            ia_ex(cx, g"vptestmb\0", IA_VF_RVM, 2, 1, 0, 0x26, 0, 0);
            ia_ex(cx, g"vptestmw\0", IA_VF_RVM, 2, 1, 1, 0x26, 0, 0);
            ia_ex_dq(cx, g"vptestm\0", IA_VF_RVM, 2, 1, 0x27, 0, 0);
            ia_ex(cx, g"vptestnmb\0", IA_VF_RVM, 2, 2, 0, 0x26, 0, 0);
            ia_ex(cx, g"vptestnmw\0", IA_VF_RVM, 2, 2, 1, 0x26, 0, 0);
            ia_ex_dq(cx, g"vptestnm\0", IA_VF_RVM, 2, 2, 0x27, 0, 0);
            ia_ex(cx, g"vpcmpb\0", IA_VF_RVMI, 3, 1, 0, 0x3F, 0, 0);
            ia_ex(cx, g"vpcmpw\0", IA_VF_RVMI, 3, 1, 1, 0x3F, 0, 0);
            ia_ex(cx, g"vpcmpub\0", IA_VF_RVMI, 3, 1, 0, 0x3E, 0, 0);
            ia_ex(cx, g"vpcmpuw\0", IA_VF_RVMI, 3, 1, 1, 0x3E, 0, 0);
            ia_ex_dq(cx, g"vpcmp\0", IA_VF_RVMI, 3, 1, 0x1F, 0, 0);
            ia_ex_dq(cx, g"vpcmpu\0", IA_VF_RVMI, 3, 1, 0x1E, 0, 0);
            // vpcmp with the predicate in the name
            i = 0;
            while (i < 6)
            {
                if (i == 0) { t = g"eq\0"; };
                if (i == 1) { t = g"lt\0"; };
                if (i == 2) { t = g"le\0"; };
                if (i == 3) { t = g"neq\0"; };
                if (i == 4) { t = g"nlt\0"; };
                if (i == 5) { t = g"nle\0"; };
                nm = ia_cat2(g"vpcmp\0", t);
                ia_ex_pred(cx, nm, i);
                i++;
            };
            // floating point
            ia_ex_pp(cx, g"vgetexp\0", IA_VF_RM, 2, 0x42, 0, 0);
            ia_ex_ss(cx, g"vgetexp\0", IA_VF_RVM, 2, 0x43, 0, 0);
            ia_ex_pp(cx, g"vgetmant\0", IA_VF_RMI, 3, 0x26, 0, 0);
            ia_ex_ss(cx, g"vgetmant\0", IA_VF_RVMI, 3, 0x27, 0, 0);
            ia_ex(cx, g"vrndscaleps\0", IA_VF_RMI, 3, 1, 0, 0x08, 0, 0);
            ia_ex(cx, g"vrndscalepd\0", IA_VF_RMI, 3, 1, 1, 0x09, 0, 0);
            ia_ex(cx, g"vrndscaless\0", IA_VF_RVMI, 3, 1, 0, 0x0A, 0, 0);
            ia_ex(cx, g"vrndscalesd\0", IA_VF_RVMI, 3, 1, 1, 0x0B, 0, 0);
            ia_ex_pp(cx, g"vscalef\0", IA_VF_RVM, 2, 0x2C, 0, 0);
            ia_ex_ss(cx, g"vscalef\0", IA_VF_RVM, 2, 0x2D, 0, 0);
            ia_ex_pp(cx, g"vfixupimm\0", IA_VF_RVMI, 3, 0x54, 0, 0);
            ia_ex_ss(cx, g"vfixupimm\0", IA_VF_RVMI, 3, 0x55, 0, 0);
            ia_ex_pp(cx, g"vrcp14\0", IA_VF_RM, 2, 0x4C, 0, 0);
            ia_ex_ss(cx, g"vrcp14\0", IA_VF_RVM, 2, 0x4D, 0, 0);
            ia_ex_pp(cx, g"vrsqrt14\0", IA_VF_RM, 2, 0x4E, 0, 0);
            ia_ex_ss(cx, g"vrsqrt14\0", IA_VF_RVM, 2, 0x4F, 0, 0);
            ia_ex_pp(cx, g"vreduce\0", IA_VF_RMI, 3, 0x56, 0, 0);
            ia_ex_ss(cx, g"vreduce\0", IA_VF_RVMI, 3, 0x57, 0, 0);
            ia_ex_pp(cx, g"vrange\0", IA_VF_RVMI, 3, 0x50, 0, 0);
            ia_ex_ss(cx, g"vrange\0", IA_VF_RVMI, 3, 0x51, 0, 0);
            // conversions with unsigned and quadword integers
            ia_ex(cx, g"vcvtudq2ps\0", IA_VF_RM, 1, 3, 0, 0x7A, 0, 0);
            ia_ex(cx, g"vcvtudq2pd\0", IA_VF_RM, 1, 2, 0, 0x7A, 0, 0);
            ia_ex(cx, g"vcvtuqq2ps\0", IA_VF_RM, 1, 3, 1, 0x7A, 0, 0);
            ia_ex(cx, g"vcvtuqq2pd\0", IA_VF_RM, 1, 2, 1, 0x7A, 0, 0);
            ia_ex(cx, g"vcvtqq2ps\0", IA_VF_RM, 1, 0, 1, 0x5B, 0, 0);
            ia_ex(cx, g"vcvtqq2pd\0", IA_VF_RM, 1, 2, 1, 0xE6, 0, 0);
            ia_ex(cx, g"vcvtps2udq\0", IA_VF_RM, 1, 0, 0, 0x79, 0, 0);
            ia_ex(cx, g"vcvtpd2udq\0", IA_VF_RM, 1, 0, 1, 0x79, 0, 0);
            ia_ex(cx, g"vcvtps2qq\0", IA_VF_RM, 1, 1, 0, 0x7B, 0, 0);
            ia_ex(cx, g"vcvtpd2qq\0", IA_VF_RM, 1, 1, 1, 0x7B, 0, 0);
            ia_ex(cx, g"vcvtps2uqq\0", IA_VF_RM, 1, 1, 0, 0x79, 0, 0);
            ia_ex(cx, g"vcvtpd2uqq\0", IA_VF_RM, 1, 1, 1, 0x79, 0, 0);
            ia_ex(cx, g"vcvttps2udq\0", IA_VF_RM, 1, 0, 0, 0x78, 0, 0);
            ia_ex(cx, g"vcvttpd2udq\0", IA_VF_RM, 1, 0, 1, 0x78, 0, 0);
            ia_ex(cx, g"vcvttps2qq\0", IA_VF_RM, 1, 1, 0, 0x7A, 0, 0);
            ia_ex(cx, g"vcvttpd2qq\0", IA_VF_RM, 1, 1, 1, 0x7A, 0, 0);
            ia_ex(cx, g"vcvttps2uqq\0", IA_VF_RM, 1, 1, 0, 0x78, 0, 0);
            ia_ex(cx, g"vcvttpd2uqq\0", IA_VF_RM, 1, 1, 1, 0x78, 0, 0);
            ia_ex(cx, g"vcvtusi2ss\0", IA_VF_CVTI2F, 1, 2, 0, 0x7B, 0, 0);
            ia_ex(cx, g"vcvtusi2ssl\0", IA_VF_CVTI2F, 1, 2, 0, 0x7B, 0, 1);
            ia_ex(cx, g"vcvtusi2ssq\0", IA_VF_CVTI2F, 1, 2, 0, 0x7B, 0, 2);
            ia_ex(cx, g"vcvtusi2sd\0", IA_VF_CVTI2F, 1, 3, 0, 0x7B, 0, 0);
            ia_ex(cx, g"vcvtusi2sdl\0", IA_VF_CVTI2F, 1, 3, 0, 0x7B, 0, 1);
            ia_ex(cx, g"vcvtusi2sdq\0", IA_VF_CVTI2F, 1, 3, 0, 0x7B, 0, 2);
            ia_ex(cx, g"vcvtss2usi\0", IA_VF_RM, 1, 2, 0, 0x79, 0, 0);
            ia_ex(cx, g"vcvtsd2usi\0", IA_VF_RM, 1, 3, 0, 0x79, 0, 0);
            ia_ex(cx, g"vcvttss2usi\0", IA_VF_RM, 1, 2, 0, 0x78, 0, 0);
            ia_ex(cx, g"vcvttsd2usi\0", IA_VF_RM, 1, 3, 0, 0x78, 0, 0);
            // broadcast, extract and insert of 32 and 64 bit element groups
            ia_ex(cx, g"vbroadcastf32x4\0", IA_VF_RM, 2, 1, 0, 0x1A, 0, 0);
            ia_ex(cx, g"vbroadcastf64x2\0", IA_VF_RM, 2, 1, 1, 0x1A, 0, 0);
            ia_ex(cx, g"vbroadcastf32x8\0", IA_VF_RM, 2, 1, 0, 0x1B, 0, 0);
            ia_ex(cx, g"vbroadcastf64x4\0", IA_VF_RM, 2, 1, 1, 0x1B, 0, 0);
            ia_ex(cx, g"vbroadcasti32x4\0", IA_VF_RM, 2, 1, 0, 0x5A, 0, 0);
            ia_ex(cx, g"vbroadcasti64x2\0", IA_VF_RM, 2, 1, 1, 0x5A, 0, 0);
            ia_ex(cx, g"vbroadcasti32x8\0", IA_VF_RM, 2, 1, 0, 0x5B, 0, 0);
            ia_ex(cx, g"vbroadcasti64x4\0", IA_VF_RM, 2, 1, 1, 0x5B, 0, 0);
            ia_ex(cx, g"vbroadcastf32x2\0", IA_VF_RM, 2, 1, 0, 0x19, 0, 0);
            ia_ex(cx, g"vbroadcasti32x2\0", IA_VF_RM, 2, 1, 0, 0x59, 0, 0);
            ia_ex(cx, g"vextractf32x4\0", IA_VF_MRI, 3, 1, 0, 0x19, 0, 0);
            ia_ex(cx, g"vextractf64x2\0", IA_VF_MRI, 3, 1, 1, 0x19, 0, 0);
            ia_ex(cx, g"vextractf32x8\0", IA_VF_MRI, 3, 1, 0, 0x1B, 0, 0);
            ia_ex(cx, g"vextractf64x4\0", IA_VF_MRI, 3, 1, 1, 0x1B, 0, 0);
            ia_ex(cx, g"vextracti32x4\0", IA_VF_MRI, 3, 1, 0, 0x39, 0, 0);
            ia_ex(cx, g"vextracti64x2\0", IA_VF_MRI, 3, 1, 1, 0x39, 0, 0);
            ia_ex(cx, g"vextracti32x8\0", IA_VF_MRI, 3, 1, 0, 0x3B, 0, 0);
            ia_ex(cx, g"vextracti64x4\0", IA_VF_MRI, 3, 1, 1, 0x3B, 0, 0);
            ia_ex(cx, g"vinsertf32x4\0", IA_VF_RVMI, 3, 1, 0, 0x18, 0, 0);
            ia_ex(cx, g"vinsertf64x2\0", IA_VF_RVMI, 3, 1, 1, 0x18, 0, 0);
            ia_ex(cx, g"vinsertf32x8\0", IA_VF_RVMI, 3, 1, 0, 0x1A, 0, 0);
            ia_ex(cx, g"vinsertf64x4\0", IA_VF_RVMI, 3, 1, 1, 0x1A, 0, 0);
            ia_ex(cx, g"vinserti32x4\0", IA_VF_RVMI, 3, 1, 0, 0x38, 0, 0);
            ia_ex(cx, g"vinserti64x2\0", IA_VF_RVMI, 3, 1, 1, 0x38, 0, 0);
            ia_ex(cx, g"vinserti32x8\0", IA_VF_RVMI, 3, 1, 0, 0x3A, 0, 0);
            ia_ex(cx, g"vinserti64x4\0", IA_VF_RVMI, 3, 1, 1, 0x3A, 0, 0);
            // shuffles and permutes
            ia_ex(cx, g"vshuff32x4\0", IA_VF_RVMI, 3, 1, 0, 0x23, 0, 0);
            ia_ex(cx, g"vshuff64x2\0", IA_VF_RVMI, 3, 1, 1, 0x23, 0, 0);
            ia_ex(cx, g"vshufi32x4\0", IA_VF_RVMI, 3, 1, 0, 0x43, 0, 0);
            ia_ex(cx, g"vshufi64x2\0", IA_VF_RVMI, 3, 1, 1, 0x43, 0, 0);
            ia_ex_dq(cx, g"valign\0", IA_VF_RVMI, 3, 1, 0x03, 0, 0);
            ia_ex_dq(cx, g"vpermi2\0", IA_VF_RVM, 2, 1, 0x76, 0, 0);
            ia_ex(cx, g"vpermi2b\0", IA_VF_RVM, 2, 1, 0, 0x75, 0, 0);
            ia_ex(cx, g"vpermi2w\0", IA_VF_RVM, 2, 1, 1, 0x75, 0, 0);
            ia_ex(cx, g"vpermt2b\0", IA_VF_RVM, 2, 1, 0, 0x7D, 0, 0);
            ia_ex(cx, g"vpermt2w\0", IA_VF_RVM, 2, 1, 1, 0x7D, 0, 0);
            ia_ex(cx, g"vmovw\0", IA_VF_MOVD, 5, 1, 0, 0, 0, 0);
            ia_ex(cx, g"vpermi2ps\0", IA_VF_RVM, 2, 1, 0, 0x77, 0, 0);
            ia_ex(cx, g"vpermi2pd\0", IA_VF_RVM, 2, 1, 1, 0x77, 0, 0);
            ia_ex_dq(cx, g"vpermt2\0", IA_VF_RVM, 2, 1, 0x7E, 0, 0);
            ia_ex(cx, g"vpermt2ps\0", IA_VF_RVM, 2, 1, 0, 0x7F, 0, 0);
            ia_ex(cx, g"vpermt2pd\0", IA_VF_RVM, 2, 1, 1, 0x7F, 0, 0);
            ia_ex(cx, g"vpermb\0", IA_VF_RVM, 2, 1, 0, 0x8D, 0, 0);
            ia_ex(cx, g"vpermw\0", IA_VF_RVM, 2, 1, 1, 0x8D, 0, 0);
            // compress and expand
            ia_ex(cx, g"vpcompressd\0", IA_VF_MR, 2, 1, 0, 0x8B, 0, 0);
            ia_ex(cx, g"vpcompressq\0", IA_VF_MR, 2, 1, 1, 0x8B, 0, 0);
            ia_ex(cx, g"vcompressps\0", IA_VF_MR, 2, 1, 0, 0x8A, 0, 0);
            ia_ex(cx, g"vcompresspd\0", IA_VF_MR, 2, 1, 1, 0x8A, 0, 0);
            ia_ex(cx, g"vpexpandd\0", IA_VF_RM, 2, 1, 0, 0x89, 0, 0);
            ia_ex(cx, g"vpexpandq\0", IA_VF_RM, 2, 1, 1, 0x89, 0, 0);
            ia_ex(cx, g"vexpandps\0", IA_VF_RM, 2, 1, 0, 0x88, 0, 0);
            ia_ex(cx, g"vexpandpd\0", IA_VF_RM, 2, 1, 1, 0x88, 0, 0);
            // narrowing moves: plain, signed saturating and unsigned saturating
            ia_ex(cx, g"vpmovwb\0", IA_VF_MR, 2, 2, 0, 0x30, 0, 0);
            ia_ex(cx, g"vpmovdb\0", IA_VF_MR, 2, 2, 0, 0x31, 0, 0);
            ia_ex(cx, g"vpmovqb\0", IA_VF_MR, 2, 2, 0, 0x32, 0, 0);
            ia_ex(cx, g"vpmovdw\0", IA_VF_MR, 2, 2, 0, 0x33, 0, 0);
            ia_ex(cx, g"vpmovqw\0", IA_VF_MR, 2, 2, 0, 0x34, 0, 0);
            ia_ex(cx, g"vpmovqd\0", IA_VF_MR, 2, 2, 0, 0x35, 0, 0);
            ia_ex(cx, g"vpmovswb\0", IA_VF_MR, 2, 2, 0, 0x20, 0, 0);
            ia_ex(cx, g"vpmovsdb\0", IA_VF_MR, 2, 2, 0, 0x21, 0, 0);
            ia_ex(cx, g"vpmovsqb\0", IA_VF_MR, 2, 2, 0, 0x22, 0, 0);
            ia_ex(cx, g"vpmovsdw\0", IA_VF_MR, 2, 2, 0, 0x23, 0, 0);
            ia_ex(cx, g"vpmovsqw\0", IA_VF_MR, 2, 2, 0, 0x24, 0, 0);
            ia_ex(cx, g"vpmovsqd\0", IA_VF_MR, 2, 2, 0, 0x25, 0, 0);
            ia_ex(cx, g"vpmovuswb\0", IA_VF_MR, 2, 2, 0, 0x10, 0, 0);
            ia_ex(cx, g"vpmovusdb\0", IA_VF_MR, 2, 2, 0, 0x11, 0, 0);
            ia_ex(cx, g"vpmovusqb\0", IA_VF_MR, 2, 2, 0, 0x12, 0, 0);
            ia_ex(cx, g"vpmovusdw\0", IA_VF_MR, 2, 2, 0, 0x13, 0, 0);
            ia_ex(cx, g"vpmovusqw\0", IA_VF_MR, 2, 2, 0, 0x14, 0, 0);
            ia_ex(cx, g"vpmovusqd\0", IA_VF_MR, 2, 2, 0, 0x15, 0, 0);
            // mask register to vector and back
            ia_ex(cx, g"vpmovm2b\0", IA_VF_RM, 2, 2, 0, 0x28, 0, 0);
            ia_ex(cx, g"vpmovm2w\0", IA_VF_RM, 2, 2, 1, 0x28, 0, 0);
            ia_ex(cx, g"vpmovm2d\0", IA_VF_RM, 2, 2, 0, 0x38, 0, 0);
            ia_ex(cx, g"vpmovm2q\0", IA_VF_RM, 2, 2, 1, 0x38, 0, 0);
            ia_ex(cx, g"vpmovb2m\0", IA_VF_RM, 2, 2, 0, 0x29, 0, 0);
            ia_ex(cx, g"vpmovw2m\0", IA_VF_RM, 2, 2, 1, 0x29, 0, 0);
            ia_ex(cx, g"vpmovd2m\0", IA_VF_RM, 2, 2, 0, 0x39, 0, 0);
            ia_ex(cx, g"vpmovq2m\0", IA_VF_RM, 2, 2, 1, 0x39, 0, 0);
            // blends
            ia_ex(cx, g"vpblendmb\0", IA_VF_RVM, 2, 1, 0, 0x66, 0, 0);
            ia_ex(cx, g"vpblendmw\0", IA_VF_RVM, 2, 1, 1, 0x66, 0, 0);
            ia_ex_dq(cx, g"vpblendm\0", IA_VF_RVM, 2, 1, 0x64, 0, 0);
            ia_ex(cx, g"vblendmps\0", IA_VF_RVM, 2, 1, 0, 0x65, 0, 0);
            ia_ex(cx, g"vblendmpd\0", IA_VF_RVM, 2, 1, 1, 0x65, 0, 0);
            // integer
            ia_ex(cx, g"vpabsq\0", IA_VF_RM, 2, 1, 1, 0x1F, 0, 0);
            ia_ex(cx, g"vpmaxsq\0", IA_VF_RVM, 2, 1, 1, 0x3D, 0, 0);
            ia_ex(cx, g"vpmaxuq\0", IA_VF_RVM, 2, 1, 1, 0x3F, 0, 0);
            ia_ex(cx, g"vpminsq\0", IA_VF_RVM, 2, 1, 1, 0x39, 0, 0);
            ia_ex(cx, g"vpminuq\0", IA_VF_RVM, 2, 1, 1, 0x3B, 0, 0);
            ia_ex(cx, g"vpsraq\0", IA_VF_SHIFT, 1, 1, 1, 0xE2, 0x72, 4);
            ia_ex(cx, g"vprold\0", IA_VF_SHIFT, 1, 1, 0, 0, 0x72, 1);
            ia_ex(cx, g"vprolq\0", IA_VF_SHIFT, 1, 1, 1, 0, 0x72, 1);
            ia_ex(cx, g"vprord\0", IA_VF_SHIFT, 1, 1, 0, 0, 0x72, 0);
            ia_ex(cx, g"vprorq\0", IA_VF_SHIFT, 1, 1, 1, 0, 0x72, 0);
            ia_ex_dq(cx, g"vprolv\0", IA_VF_RVM, 2, 1, 0x15, 0, 0);
            ia_ex_dq(cx, g"vprorv\0", IA_VF_RVM, 2, 1, 0x14, 0, 0);
            ia_ex_dq(cx, g"vplzcnt\0", IA_VF_RM, 2, 1, 0x44, 0, 0);
            ia_ex_dq(cx, g"vpconflict\0", IA_VF_RM, 2, 1, 0xC4, 0, 0);
            ia_ex(cx, g"vpmullq\0", IA_VF_RVM, 2, 1, 1, 0x40, 0, 0);
            ia_ex(cx, g"vpmadd52luq\0", IA_VF_RVM, 2, 1, 1, 0xB4, 0, 0);
            ia_ex(cx, g"vpmadd52huq\0", IA_VF_RVM, 2, 1, 1, 0xB5, 0, 0);
            ia_ex(cx, g"vpopcntb\0", IA_VF_RM, 2, 1, 0, 0x54, 0, 0);
            ia_ex(cx, g"vpopcntw\0", IA_VF_RM, 2, 1, 1, 0x54, 0, 0);
            ia_ex(cx, g"vpopcntd\0", IA_VF_RM, 2, 1, 0, 0x55, 0, 0);
            ia_ex(cx, g"vpopcntq\0", IA_VF_RM, 2, 1, 1, 0x55, 0, 0);
            ia_ex(cx, g"vpsravw\0", IA_VF_RVM, 2, 1, 1, 0x11, 0, 0);
            ia_ex(cx, g"vpsllvw\0", IA_VF_RVM, 2, 1, 1, 0x12, 0, 0);
            ia_ex(cx, g"vpsrlvw\0", IA_VF_RVM, 2, 1, 1, 0x10, 0, 0);
            ia_ex(cx, g"vpsravq\0", IA_VF_RVM, 2, 1, 1, 0x46, 0, 0);
            // k mask registers
            ia_kop4(cx, g"kmov\0", 0x90, 2);
            ia_kop4(cx, g"kand\0", 0x41, 0);
            ia_kop4(cx, g"kandn\0", 0x42, 0);
            ia_kop4(cx, g"kor\0", 0x45, 0);
            ia_kop4(cx, g"kxnor\0", 0x46, 0);
            ia_kop4(cx, g"kxor\0", 0x47, 0);
            ia_kop4(cx, g"kadd\0", 0x4A, 0);
            ia_kop4(cx, g"knot\0", 0x44, 1);
            ia_kop4(cx, g"kortest\0", 0x98, 1);
            ia_kop4(cx, g"ktest\0", 0x99, 1);
            ia_kop(cx, g"kunpckbw\0", 1, 1, 0, 0x4B, 0, 0);
            ia_kop(cx, g"kunpckwd\0", 1, 0, 0, 0x4B, 0, 0);
            ia_kop(cx, g"kunpckdq\0", 1, 0, 1, 0x4B, 0, 0);
            ia_kop(cx, g"kshiftrb\0", 3, 1, 0, 0x30, 3, 0);
