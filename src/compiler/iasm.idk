            ia_vx(cx, g"vpmovsxbw\0", IA_VF_RM, 2, 1, 0, 0x20, 0, 0);
            ia_vx(cx, g"vpmovsxbd\0", IA_VF_RM, 2, 1, 0, 0x21, 0, 0);
            ia_vx(cx, g"vpmovsxbq\0", IA_VF_RM, 2, 1, 0, 0x22, 0, 0);
            ia_vx(cx, g"vpmovsxwd\0", IA_VF_RM, 2, 1, 0, 0x23, 0, 0);
            ia_vx(cx, g"vpmovsxwq\0", IA_VF_RM, 2, 1, 0, 0x24, 0, 0);
            ia_vx(cx, g"vpmovsxdq\0", IA_VF_RM, 2, 1, 0, 0x25, 0, 0);
            ia_vx(cx, g"vpmovzxbw\0", IA_VF_RM, 2, 1, 0, 0x30, 0, 0);
            ia_vx(cx, g"vpmovzxbd\0", IA_VF_RM, 2, 1, 0, 0x31, 0, 0);
            ia_vx(cx, g"vpmovzxbq\0", IA_VF_RM, 2, 1, 0, 0x32, 0, 0);
            ia_vx(cx, g"vpmovzxwd\0", IA_VF_RM, 2, 1, 0, 0x33, 0, 0);
            ia_vx(cx, g"vpmovzxwq\0", IA_VF_RM, 2, 1, 0, 0x34, 0, 0);
            ia_vx(cx, g"vpmovzxdq\0", IA_VF_RM, 2, 1, 0, 0x35, 0, 0);
            // FMA
            ia_vx_fma(cx, g"fmadd\0", 0x98, false);
            ia_vx_fma(cx, g"fmadd\0", 0x98, true);
            ia_vx_fma(cx, g"fmsub\0", 0x9A, false);
            ia_vx_fma(cx, g"fmsub\0", 0x9A, true);
