            ia_kop(cx, g"kshiftrd\0", 3, 1, 0, 0x31, 3, 0);
            ia_kop(cx, g"kshiftrq\0", 3, 1, 1, 0x31, 3, 0);
            ia_kop(cx, g"kshiftlb\0", 3, 1, 0, 0x32, 3, 0);
            ia_kop(cx, g"kshiftlw\0", 3, 1, 1, 0x32, 3, 0);
            ia_kop(cx, g"kshiftld\0", 3, 1, 0, 0x33, 3, 0);
            ia_kop(cx, g"kshiftlq\0", 3, 1, 1, 0x33, 3, 0);
            ->;
        };

        ia_init_vex(IasmCtx* cx) -> void
        {
            int i = 0;
            byte* pn, t;
            // moves
            ia_vx(cx, g"vmovaps\0", IA_VF_RM, 1, 0, 0, 0x28, 0x29, 0);
            ia_vx(cx, g"vmovups\0", IA_VF_RM, 1, 0, 0, 0x10, 0x11, 0);
            ia_vx(cx, g"vmovapd\0", IA_VF_RM, 1, 1, 0, 0x28, 0x29, 0);
