            ia_vx_bmi(cx, g"blsi\0", IA_VF_NDD, 2, 0, 0xF3, 3);
            ia_vx_bmi(cx, g"blsmsk\0", IA_VF_NDD, 2, 0, 0xF3, 2);
            ia_vx_bmi(cx, g"blsr\0", IA_VF_NDD, 2, 0, 0xF3, 1);
            ->;
        };

        ia_init_mns(IasmCtx* cx) -> void
        {
            int i = 0;
            int cc;
            byte* nm, t;
            // arithmetic and logic group
            ia_mn4(cx, g"add\0", IA_K_ALU, 0, 0, 0);
            ia_mn4(cx, g"or\0", IA_K_ALU, 1, 0, 0);
            ia_mn4(cx, g"adc\0", IA_K_ALU, 2, 0, 0);
            ia_mn4(cx, g"sbb\0", IA_K_ALU, 3, 0, 0);
            ia_mn4(cx, g"and\0", IA_K_ALU, 4, 0, 0);
            ia_mn4(cx, g"sub\0", IA_K_ALU, 5, 0, 0);
            ia_mn4(cx, g"xor\0", IA_K_ALU, 6, 0, 0);
            ia_mn4(cx, g"cmp\0", IA_K_ALU, 7, 0, 0);
            ia_mn4(cx, g"mov\0", IA_K_MOV, 0, 0, 0);
            ia_mn4(cx, g"test\0", IA_K_TEST, 0, 0, 0);
            ia_mn3(cx, g"lea\0", IA_K_LEA, 0, 0, 0);
            // unary group: a is the /n of F6 and F7
            ia_mn4(cx, g"not\0", IA_K_UNARY, 2, 0, 0);
            ia_mn4(cx, g"neg\0", IA_K_UNARY, 3, 0, 0);
            ia_mn4(cx, g"mul\0", IA_K_UNARY, 4, 0, 0);
            ia_mn4(cx, g"div\0", IA_K_UNARY, 6, 0, 0);
            ia_mn4(cx, g"idiv\0", IA_K_UNARY, 7, 0, 0);
            ia_mn4(cx, g"inc\0", IA_K_INCDEC, 0, 0, 0);
            ia_mn4(cx, g"dec\0", IA_K_INCDEC, 1, 0, 0);
            ia_mn3(cx, g"imul\0", IA_K_IMUL, 0, 0, 0);
            // shifts and rotates: a is the /n
            ia_mn4(cx, g"rol\0", IA_K_SHIFT, 0, 0, 0);
            ia_mn4(cx, g"ror\0", IA_K_SHIFT, 1, 0, 0);
            ia_mn4(cx, g"rcl\0", IA_K_SHIFT, 2, 0, 0);
            ia_mn4(cx, g"rcr\0", IA_K_SHIFT, 3, 0, 0);
            ia_mn4(cx, g"shl\0", IA_K_SHIFT, 4, 0, 0);
            ia_mn4(cx, g"sal\0", IA_K_SHIFT, 4, 0, 0);
            ia_mn4(cx, g"shr\0", IA_K_SHIFT, 5, 0, 0);
            ia_mn4(cx, g"sar\0", IA_K_SHIFT, 7, 0, 0);
            // stack and control flow
            ia_mn_add(cx, g"push\0", IA_K_PUSH, 0, 0, 0, 0);
            ia_mn_add(cx, g"pushq\0", IA_K_PUSH, 64, 0, 0, 0);
            ia_mn_add(cx, g"pushw\0", IA_K_PUSH, 16, 0, 0, 0);
            ia_mn_add(cx, g"pop\0", IA_K_POP, 0, 0, 0, 0);
            ia_mn_add(cx, g"popq\0", IA_K_POP, 64, 0, 0, 0);
            ia_mn_add(cx, g"popw\0", IA_K_POP, 16, 0, 0, 0);
            ia_mn_add(cx, g"call\0", IA_K_CALL, 0, 0, 0, 0);
            ia_mn_add(cx, g"callq\0", IA_K_CALL, 64, 0, 0, 0);
            ia_mn_add(cx, g"jmp\0", IA_K_JMP, 0, 0, 0, 0);
            ia_mn_add(cx, g"jmpq\0", IA_K_JMP, 64, 0, 0, 0);
            i = 0;
            while (i < 30)
            {
                nm = ia_cc_name(i);
                cc = ia_cc_code(i);
                ia_mn_add(cx, ia_cat2(g"j\0", nm), IA_K_JCC, 0, cc, 0, 0);
                ia_mn_add(cx, ia_cat2(g"set\0", nm), IA_K_SETCC, 8, cc, 0, 0);
                t = ia_cat2(g"cmov\0", nm);
                ia_mn_add(cx, t, IA_K_CMOV, 0, cc, 0, 0);
                ia_mn_add(cx, ia_cat2(t, g"w\0"), IA_K_CMOV, 16, cc, 0, 0);
                ia_mn_add(cx, ia_cat2(t, g"l\0"), IA_K_CMOV, 32, cc, 0, 0);
                ia_mn_add(cx, ia_cat2(t, g"q\0"), IA_K_CMOV, 64, cc, 0, 0);
                i++;
            };
            // zero and sign extending moves: sz is the destination size, a the source size, b 1 for signed
            ia_mn_add(cx, g"movzbw\0", IA_K_MOVX, 16, 8, 0, 0);
            ia_mn_add(cx, g"movzbl\0", IA_K_MOVX, 32, 8, 0, 0);
            ia_mn_add(cx, g"movzbq\0", IA_K_MOVX, 64, 8, 0, 0);
            ia_mn_add(cx, g"movzwl\0", IA_K_MOVX, 32, 16, 0, 0);
            ia_mn_add(cx, g"movzwq\0", IA_K_MOVX, 64, 16, 0, 0);
            ia_mn_add(cx, g"movsbw\0", IA_K_MOVX, 16, 8, 1, 0);
            ia_mn_add(cx, g"movsbl\0", IA_K_MOVX, 32, 8, 1, 0);
            ia_mn_add(cx, g"movsbq\0", IA_K_MOVX, 64, 8, 1, 0);
            ia_mn_add(cx, g"movswl\0", IA_K_MOVX, 32, 16, 1, 0);
            ia_mn_add(cx, g"movswq\0", IA_K_MOVX, 64, 16, 1, 0);
            ia_mn_add(cx, g"movslq\0", IA_K_MOVX, 64, 32, 1, 0);
            ia_mn_add(cx, g"movabsq\0", IA_K_MOVABS, 64, 0, 0, 0);
            ia_mn_add(cx, g"movabs\0", IA_K_MOVABS, 64, 0, 0, 0);
            ia_mn4(cx, g"xchg\0", IA_K_XCHG, 0, 0, 0);
            ia_mn_add(cx, g"bswapl\0", IA_K_BSWAP, 32, 0, 0, 0);
            ia_mn_add(cx, g"bswapq\0", IA_K_BSWAP, 64, 0, 0, 0);
            ia_mn3(cx, g"bt\0", IA_K_BT, 0, 0, 0);
            ia_mn3(cx, g"bts\0", IA_K_BT, 1, 0, 0);
            ia_mn3(cx, g"btr\0", IA_K_BT, 2, 0, 0);
            ia_mn3(cx, g"btc\0", IA_K_BT, 3, 0, 0);
            // no operand instructions: a holds up to 4 opcode bytes (first byte lowest), b the count
            ia_mn_add(cx, g"ret\0", IA_K_NOARG, 0, 195, 1, 0);
            ia_mn_add(cx, g"retq\0", IA_K_NOARG, 0, 195, 1, 0);
            ia_mn_add(cx, g"cltq\0", IA_K_NOARG, 0, 0x9848, 2, 0);
            ia_mn_add(cx, g"cqto\0", IA_K_NOARG, 0, 0x9948, 2, 0);
            ia_mn_add(cx, g"cltd\0", IA_K_NOARG, 0, 0x99, 1, 0);
            ia_mn_add(cx, g"cwtl\0", IA_K_NOARG, 0, 0x98, 1, 0);
            ia_mn_add(cx, g"cwtd\0", IA_K_NOARG, 0, 0x9966, 2, 0);
            ia_mn_add(cx, g"cbtw\0", IA_K_NOARG, 0, 0x9866, 2, 0);
            ia_mn_add(cx, g"nop\0", IA_K_NOARG, 0, 0x90, 1, 0);
            ia_mn_add(cx, g"syscall\0", IA_K_NOARG, 0, 0x050F, 2, 0);
            ia_mn_add(cx, g"cpuid\0", IA_K_NOARG, 0, 0xA20F, 2, 0);
            ia_mn_add(cx, g"rdtsc\0", IA_K_NOARG, 0, 0x310F, 2, 0);
            ia_mn_add(cx, g"xgetbv\0", IA_K_NOARG, 0, 0xD0010F, 3, 0);
            ia_mn_add(cx, g"pause\0", IA_K_NOARG, 0, 0x90F3, 2, 0);
            ia_mn_add(cx, g"mfence\0", IA_K_NOARG, 0, 0xF0AE0F, 3, 0);
            ia_mn_add(cx, g"lfence\0", IA_K_NOARG, 0, 0xE8AE0F, 3, 0);
            ia_mn_add(cx, g"sfence\0", IA_K_NOARG, 0, 0xF8AE0F, 3, 0);
            ia_mn_add(cx, g"leave\0", IA_K_NOARG, 0, 0xC9, 1, 0);
            ia_mn_add(cx, g"int3\0", IA_K_NOARG, 0, 0xCC, 1, 0);
            ia_mn_add(cx, g"ud2\0", IA_K_NOARG, 0, 0x0B0F, 2, 0);
            ia_mn_add(cx, g"hlt\0", IA_K_NOARG, 0, 0xF4, 1, 0);
            ia_mn_add(cx, g"cld\0", IA_K_NOARG, 0, 0xFC, 1, 0);
            ia_mn_add(cx, g"std\0", IA_K_NOARG, 0, 0xFD, 1, 0);
            ia_mn_add(cx, g"clc\0", IA_K_NOARG, 0, 0xF8, 1, 0);
            ia_mn_add(cx, g"stc\0", IA_K_NOARG, 0, 0xF9, 1, 0);
            ia_mn_add(cx, g"ud2\0", IA_K_NOARG, 0, 0x0B0F, 2, 0);
            // SSE: a = opcode (0F xx packed), b = mandatory prefix, c = store form opcode or 0
            ia_sse(cx, g"movaps\0", 0x280F, 0, 0x290F);
            ia_sse(cx, g"movups\0", 0x100F, 0, 0x110F);
            ia_sse(cx, g"movapd\0", 0x280F, 0x66, 0x290F);
            ia_sse(cx, g"movupd\0", 0x100F, 0x66, 0x110F);
            ia_sse(cx, g"movss\0", 0x100F, 0xF3, 0x110F);
            ia_sse(cx, g"movsd\0", 0x100F, 0xF2, 0x110F);
            ia_sse(cx, g"movdqa\0", 0x6F0F, 0x66, 0x7F0F);
            ia_sse(cx, g"movdqu\0", 0x6F0F, 0xF3, 0x7F0F);
            ia_sse(cx, g"movntdq\0", 0, 0x66, 0xE70F);
            ia_sse(cx, g"movntps\0", 0, 0, 0x2B0F);
            ia_sse(cx, g"movlps\0", 0x120F, 0, 0x130F);
            ia_sse(cx, g"movhps\0", 0x160F, 0, 0x170F);
            ia_sse(cx, g"movlpd\0", 0x120F, 0x66, 0x130F);
            ia_sse(cx, g"movhpd\0", 0x160F, 0x66, 0x170F);
            ia_sse(cx, g"movmskps\0", 0x500F, 0, 0);
            ia_sse(cx, g"movmskpd\0", 0x500F, 0x66, 0);
            ia_sse(cx, g"ucomiss\0", 0x2E0F, 0, 0);
            ia_sse(cx, g"ucomisd\0", 0x2E0F, 0x66, 0);
            ia_sse(cx, g"comiss\0", 0x2F0F, 0, 0);
            ia_sse(cx, g"comisd\0", 0x2F0F, 0x66, 0);
            ia_sse4(cx, g"add\0", 0x580F);
            ia_sse4(cx, g"mul\0", 0x590F);
            ia_sse4(cx, g"sub\0", 0x5C0F);
            ia_sse4(cx, g"min\0", 0x5D0F);
            ia_sse4(cx, g"div\0", 0x5E0F);
            ia_sse4(cx, g"max\0", 0x5F0F);
            ia_sse4(cx, g"sqrt\0", 0x510F);
            ia_sse(cx, g"rsqrtss\0", 0x520F, 0xF3, 0);
            ia_sse(cx, g"rcpss\0", 0x530F, 0xF3, 0);
            ia_sse(cx, g"andps\0", 0x540F, 0, 0);
            ia_sse(cx, g"andpd\0", 0x540F, 0x66, 0);
            ia_sse(cx, g"andnps\0", 0x550F, 0, 0);
            ia_sse(cx, g"andnpd\0", 0x550F, 0x66, 0);
            ia_sse(cx, g"orps\0", 0x560F, 0, 0);
            ia_sse(cx, g"orpd\0", 0x560F, 0x66, 0);
            ia_sse(cx, g"xorps\0", 0x570F, 0, 0);
            ia_sse(cx, g"xorpd\0", 0x570F, 0x66, 0);
            ia_sse(cx, g"unpcklps\0", 0x140F, 0, 0);
            ia_sse(cx, g"unpcklpd\0", 0x140F, 0x66, 0);
            ia_sse(cx, g"unpckhps\0", 0x150F, 0, 0);
            ia_sse(cx, g"unpckhpd\0", 0x150F, 0x66, 0);
            ia_sse(cx, g"cvtss2sd\0", 0x5A0F, 0xF3, 0);
            ia_sse(cx, g"cvtsd2ss\0", 0x5A0F, 0xF2, 0);
            ia_sse(cx, g"cvtps2pd\0", 0x5A0F, 0, 0);
            ia_sse(cx, g"cvtpd2ps\0", 0x5A0F, 0x66, 0);
            ia_sse(cx, g"cvtdq2ps\0", 0x5B0F, 0, 0);
            ia_sse(cx, g"cvtps2dq\0", 0x5B0F, 0x66, 0);
            ia_sse(cx, g"cvttps2dq\0", 0x5B0F, 0xF3, 0);
