        iasm_init(IasmCtx* cx) -> void
        {
            int i = 0;
            cx.nreg = 0;
            cx.nmn = 0;
            cx.err = (byte*)0;
            i = 0;
            while (i < 512) { cx.reghash[i] = 0; i++; };
            i = 0;
            while (i < 8192) { cx.mnhash[i] = 0; i++; };
            ia_init_regs(cx);
            ia_init_mns(cx);
            ->;
        };

        ia_fail(IasmCtx* cx, byte* msg) -> bool
        {
            if (cx.err == 0) { cx.err = msg; };
            -> false;
        };

        // ===== OPERAND PARSING =====

        ia_op_clear(Operand* o) -> void
        {
            o.kind = IA_OP_NONE;
            o.reg = -1;
            o.base = -1;
            o.index = -1;
            o.scale = 1;
            o.val = 0;
            o.sym = (byte*)0;
            o.mod = IA_MOD_NONE;
            o.star = false;
            o.has_disp = false;
            o.seg = -1;
            o.mask = 0;
            o.zero = false;
            o.bcst = 0;
            ->;
        };

        // Parses an integer at s[i...] (decimal or 0x hex, optional sign). Returns the new index or -1.
        ia_parse_int(byte* s, int i, int n, i64* out) -> int
        {
            bool neg = false;
            i64 v = 0;
            int d, start;
            if (i < n & s[i] == '-') { neg = true; i++; }
            else { if (i < n & s[i] == '+') { i++; }; };
            if (i >= n) { -> -1; };
            if (!ia_isdig(s[i])) { -> -1; };
            if (s[i] == '0' & i + 1 < n & (s[i + 1] == 'x' | s[i + 1] == 'X'))
            {
                i = i + 2;
                start = i;
                while (i < n)
                {
                    d = ia_hexval(s[i]);
                    if (d < 0) { break; };
                    v = (v * 16 + d);
                    i++;
                };
                if (i == start) { -> -1; };
            }
            else
            {
                while (i < n & ia_isdig(s[i]))
                {
                    v = (v * 10 + (s[i] - 48));
                    i++;
                };
            };
            if (neg) { v = (0 - v); };
            *out = v;
            -> i;
        };

        // The modifier named at s[i, n) after an @ sign, or -1
        ia_mod_of(byte* s, int i, int n) -> int
        {
            int len = n - i;
            if (ia_eqn(s + i, len, "PLT\0")) { -> IA_MOD_PLT; };
            if (ia_eqn(s + i, len, "GOTPCREL\0")) { -> IA_MOD_GOTPCREL; };
            if (ia_eqn(s + i, len, "GOTPCRELX\0")) { -> IA_MOD_GOTPCRELX; };
            if (ia_eqn(s + i, len, "TPOFF\0")) { -> IA_MOD_TPOFF; };
            if (ia_eqn(s + i, len, "GOTTPOFF\0")) { -> IA_MOD_GOTTPOFF; };
            if (ia_eqn(s + i, len, "TLSGD\0")) { -> IA_MOD_TLSGD; };
            if (ia_eqn(s + i, len, "TLSLD\0")) { -> IA_MOD_TLSLD; };
            if (ia_eqn(s + i, len, "DTPOFF\0")) { -> IA_MOD_DTPOFF; };
            if (ia_eqn(s + i, len, "NTPOFF\0")) { -> IA_MOD_NTPOFF; };
            if (ia_eqn(s + i, len, "IMGREL\0")) { -> IA_MOD_IMGREL; };
            if (ia_eqn(s + i, len, "SECREL32\0")) { -> IA_MOD_SECREL; };
            -> -1;
        };

        // Parses a symbol expression: [sym][@mod][+-number] or a bare number, in s[i, n).
        // Fills o.sym, o.val, o.mod and o.has_disp. Returns the end index or -1.
        ia_parse_expr(byte* s, int i, int n, Operand* o) -> int
        {
            int st = 0;
            int e, m;
            i64 v;
            int k = 0;
            o.has_disp = true;
            if (i < n & s[i] == '"')
            {
                st = i + 1;
                i++;
                while (i < n & s[i] != '"') { i++; };
                if (i >= n) { -> -1; };
                o.sym = ia_dup(s + st, i - st);
                i++;
            }
            else
            {
                if (i < n & (ia_isalpha(s[i]) | s[i] == '_' | s[i] == '.' | s[i] == '$' | s[i] == '@'))
                {
                    st = i;
                    i++;
                    while (i < n & (ia_issym(s[i]) | s[i] == '@'))
                    {
                        // an @ starts a modifier when a known modifier name follows
                        if (s[i] == '@')
                        {
                            e = i + 1;
                            while (e < n & (ia_isalpha(s[e]) | ia_isdig(s[e]))) { e++; };
                            k = ia_mod_of(s, i + 1, e);
                            if (k >= 0)
                            {
                                o.mod = k;
                                o.sym = ia_dup(s + st, i - st);
                                i = e;
                                break;
                            };
                        };
                        i++;
                    };
                    if (o.sym == 0) { o.sym = ia_dup(s + st, i - st); };
                };
            };
            // addend terms
            while (i < n & (s[i] == '+' | s[i] == '-'))
            {
                k = ia_parse_int(s, i, n, @v);
                if (k < 0) { -> -1; };
                o.val = (o.val + v);
                i = k;
            };
            if (o.sym == 0)
            {
                // a bare number
                k = ia_parse_int(s, i, n, @v);
                if (k >= 0)
                {
                    o.val = (o.val + v);
                    i = k;
                    while (i < n & (s[i] == '+' | s[i] == '-'))
                    {
                        k = ia_parse_int(s, i, n, @v);
                        if (k < 0) { -> -1; };
                        o.val = (o.val + v);
                        i = k;
                    };
                };
            };
            -> i;
        };

        // Parses one operand in s[0, n) (already trimmed)
        ia_parse_operand(IasmCtx* cx, byte* s, int n, Operand* o) -> bool
        {
            int i = 0;
            int j = 0;
            int r;
            int k = 0;
            i64 v;
            ia_op_clear(o);
            if (n == 0) { -> true; };
            // EVEX decorations after the operand: {%k1} {z} {1toN}
            while (n > 0)
            {
                while (n > 0 & (s[n - 1] == 32 | s[n - 1] == 9)) { n--; };
                if (n == 0 | s[n - 1] != '}') { break; };
                j = n - 1;
                while (j > 0 & s[j] != '{') { j--; };
                if (s[j] != '{') { -> ia_fail(cx, "bad decoration\0"); };
                if (j + 3 < n & s[j + 1] == '%' & s[j + 2] == 'k' & s[j + 3] >= '0' & s[j + 3] <= '7')
                {
                    o.mask = s[j + 3] - 48 + 1;
                }
                else
                {
                    if (j + 2 < n & s[j + 1] == 'z') { o.zero = true; }
                    else
                    {
                        if (j + 5 < n & s[j + 1] == '1' & s[j + 2] == 't' & s[j + 3] == 'o')
                        {
                            k = 0;
                            r = j + 4;
                            while (r < n - 1 & s[r] >= '0' & s[r] <= '9') { k = k * 10 + s[r] - 48; r++; };
                            o.bcst = k;
                            k = 0;
                        }
                        else { -> ia_fail(cx, "bad decoration\0"); };
                    };
                };
                n = j;
            };
            if (n == 0) { -> ia_fail(cx, "empty operand\0"); };
            if (s[0] == '*') { o.star = true; i = 1; s = s + 1; n = n - 1; };
            if (n == 0) { -> ia_fail(cx, "empty operand\0"); };
            if (s[0] == '%')
            {
                // segment override: %fs:...
                j = 1;
                while (j < n & s[j] != ':' & s[j] != '(' & s[j] != ')') { j++; };
                if (j + 2 < n & s[1] == 's' & s[2] == 't' & s[3] == '(') { j = 4; while (j < n & s[j] != ')') { j++; }; j++; };
                r = ia_reg_find(cx, s + 1, j - 1);
                if (r < 0) { -> ia_fail(cx, "unknown register\0"); };
                if (j == n)
                {
                    o.kind = IA_OP_REG;
                    o.reg = r;
                    -> true;
                };
                if (s[j] == ':' & r / 32 == IA_RC_SEG)
                {
                    o.seg = r % 32;
                    s = s + j + 1;
                    n = n - j - 1;
                }
                else { -> ia_fail(cx, "bad operand\0"); };
            };
            if (n == 0) { -> ia_fail(cx, "bad operand\0"); };
            if (s[0] == '$')
            {
                o.kind = IA_OP_IMM;
                k = ia_parse_expr(s, 1, n, o);
                if (k != n) { -> ia_fail(cx, "bad immediate\0"); };
                -> true;
            };
            // memory: [disp](base,index,scale)  or  a bare symbol / number
            j = 0;
            while (j < n & s[j] != '(') { j++; };
            if (j > 0)
            {
                k = ia_parse_expr(s, 0, j, o);
                if (k != j) { -> ia_fail(cx, "bad displacement\0"); };
            };
            if (j == n)
            {
                if (o.seg >= 0)
                {
                    o.kind = IA_OP_MEM;
                    -> true;
                };
                if (o.sym == 0) { o.kind = IA_OP_MEM; -> true; };
                o.kind = IA_OP_SYM;
                -> true;
            };
            // the parenthesised part
            o.kind = IA_OP_MEM;
            k = j + 1;
            if (s[n - 1] != ')') { -> ia_fail(cx, "bad memory operand\0"); };
            // base
            if (k < n & s[k] == '%')
            {
                j = k + 1;
                while (j < n & s[j] != ',' & s[j] != ')') { j++; };
                r = ia_reg_find(cx, s + k + 1, j - k - 1);
                if (r < 0) { -> ia_fail(cx, "unknown base register\0"); };
                if (r / 32 == IA_RC_IP) { o.base = r; } else { o.base = r; };
                k = j;
            };
            if (k < n & s[k] == ',')
            {
                k++;
                if (k < n & s[k] == '%')
                {
                    j = k + 1;
                    while (j < n & s[j] != ',' & s[j] != ')') { j++; };
                    r = ia_reg_find(cx, s + k + 1, j - k - 1);
                    if (r < 0) { -> ia_fail(cx, "unknown index register\0"); };
                    o.index = r;
                    k = j;
                };
                if (k < n & s[k] == ',')
                {
                    k++;
                    j = ia_parse_int(s, k, n, @v);
                    if (j < 0) { -> ia_fail(cx, "bad scale\0"); };
                    o.scale = v;
                    k = j;
                };
            };
            if (k != n - 1) { -> ia_fail(cx, "bad memory operand\0"); };
            -> true;
        };

        // ===== ENCODING =====

        ia_regnum(int code) -> int -> code % 32;
        ia_regcls(int code) -> int -> code / 32;

        // Operand size in bits of a general register code
        ia_regbits(int code) -> int
        {
            switch (code / 32)
            {
                case (IA_RC_R8) { -> 8; }
                case (IA_RC_R8H) { -> 8; }
                case (IA_RC_R16) { -> 16; }
                case (IA_RC_R32) { -> 32; }
                case (IA_RC_R64) { -> 64; }
                default { -> 0; };
            };
        };

        ia_is_gpr(int code) -> bool
        {
            int c = code / 32;
            -> c >= IA_RC_R8 & c <= IA_RC_R64;
        };

        // True when the register needs a REX prefix just to be addressed (spl bpl sil dil)
        ia_rex8(int code) -> bool -> code / 32 == IA_RC_R8 & (code % 32 >= 4 & code % 32 <= 7);

        // Segment override prefix byte of a memory operand
        ia_seg_byte(int seg) -> int
        {
            switch (seg)
            {
                case (0) { -> 0x26; }
                case (1) { -> 0x2E; }
                case (2) { -> 0x36; }
                case (3) { -> 0x3E; }
                case (4) { -> 0x64; }
                case (5) { -> 0x65; }
                default { -> 0; };
            };
        };

        // The REX.X and REX.B bits needed by a memory operand or register r/m operand
        ia_rm_rexbits(Operand* rm) -> int
        {
            int r = 0;
            if (rm.kind == IA_OP_REG)
            {
                if (ia_regnum(rm.reg) >= 8) { r = 1; };
                -> r;
            };
            if (rm.base >= 0 & ia_regcls(rm.base) != IA_RC_IP)
            {
                if (ia_regnum(rm.base) >= 8) { r = r `| 1; };
            };
            if (rm.index >= 0)
            {
                if (((ia_regnum(rm.index) >> 3) `& 1) != 0) { r = r `| 2; };
            };
            -> r;
        };

        // True when the memory operand uses 32 bit address registers, which need the 67 prefix
        ia_a32(Operand* rm) -> bool
        {
            if (rm.kind != IA_OP_MEM) { -> false; };
            if (rm.base >= 0) { if (ia_regcls(rm.base) == IA_RC_R32) { -> true; }; };
            if (rm.index >= 0) { if (ia_regcls(rm.index) == IA_RC_R32) { -> true; }; };
            -> false;
        };

        // Emits modrm, sib and displacement for the r/m operand rm with the reg field regf.
        // immn is the number of immediate bytes that follow, so rip relative addends are right.
        ia_emit_modrm(IasmCtx* cx, Ib* ib, int regf, Operand* rm, int immn) -> bool
        {
            int rf = regf `& 7;
            int mod, rmb, sib, ss, idx, bs;
            bool hasdisp, d32;
            int fk;
            i64 add;
            i64 d8v = 0;
            if (rm.kind == IA_OP_REG)
            {
                ib_put(ib, 0xC0 `| (rf << 3) `| (ia_regnum(rm.reg) `& 7));
                -> true;
            };
            if (rm.kind != IA_OP_MEM & rm.kind != IA_OP_SYM) { -> ia_fail(cx, "bad r/m operand\0"); };
            // rip relative
            if (rm.base >= 0 & ia_regcls(rm.base) == IA_RC_IP)
            {
                ib_put(ib, 0x05 `| (rf << 3));
                add = rm.val - (4 + immn);
                if (rm.sym != 0)
                {
                    fk = IA_FX_PC32;
                    if (rm.mod == IA_MOD_GOTPCREL) { fk = IA_FX_GOTPCREL; };
                    if (rm.mod == IA_MOD_GOTPCRELX) { fk = IA_FX_GOTPCRELX; };
                    ib_fix(ib, ib.n, fk, add, rm.sym);
                    ib_put32(ib, 0);
                }
                else
                {
                    ib_put32(ib, rm.val);
                };
                -> true;
            };
            hasdisp = rm.has_disp | rm.sym != 0;
            // absolute address, no base and no index
            if (rm.base < 0 & rm.index < 0)
            {
                ib_put(ib, 0x04 `| (rf << 3));
                ib_put(ib, 0x25);
                if (rm.sym != 0)
                {
                    ib_fix(ib, ib.n, IA_FX_ABS32S, rm.val, rm.sym);
                    ib_put32(ib, 0);
                }
                else { ib_put32(ib, rm.val); };
                -> true;
            };
            // choose the displacement size
            d32 = false;
            mod = 0;
            if (rm.sym != 0) { mod = 2; d32 = true; }
            else
            {
                if (rm.val != 0 | (rm.base >= 0 & (ia_regnum(rm.base) `& 7) == 5 & rm.base >= 0))
                {
                    if (cx.d8n > 1)
                    {
                        // EVEX compressed displacement: a multiple of N that fits a byte once divided
                        if (rm.val % cx.d8n == 0 & ia_fits8(rm.val / cx.d8n)) { mod = 1; d8v = rm.val / cx.d8n; }
                        else { mod = 2; d32 = true; };
                    }
                    else
                    {
                        if (ia_fits8(rm.val)) { mod = 1; d8v = rm.val; } else { mod = 2; d32 = true; };
                    };
                };
                // no base register: always disp32 with base field 101
                if (rm.base < 0) { mod = 0; d32 = true; };
            };
            if (rm.index >= 0 | (rm.base >= 0 & (ia_regnum(rm.base) `& 7) == 4))
            {
                // SIB form
                ss = 0;
                if (rm.scale == 2) { ss = 1; };
                if (rm.scale == 4) { ss = 2; };
                if (rm.scale == 8) { ss = 3; };
                idx = 4;
                if (rm.index >= 0) { idx = ia_regnum(rm.index) `& 7; };
                if (rm.base < 0) { bs = 5; mod = 0; d32 = true; } else { bs = ia_regnum(rm.base) `& 7; };
                ib_put(ib, (mod << 6) `| (rf << 3) `| 4);
                ib_put(ib, (ss << 6) `| (idx << 3) `| bs);
            }
            else
            {
                ib_put(ib, (mod << 6) `| (rf << 3) `| (ia_regnum(rm.base) `& 7));
            };
            if (mod == 1) { ib_put(ib, (d8v `& 255)); }
            else
            {
                if (d32)
                {
                    if (rm.sym != 0)
                    {
                        fk = IA_FX_ABS32S;
                        ib_fix(ib, ib.n, fk, rm.val, rm.sym);
                        ib_put32(ib, 0);
                    }
                    else { ib_put32(ib, rm.val); };
                };
            };
            -> true;
        };

        // Emits prefixes, REX, opcode, modrm and the immediate of one instruction.
        //   p66   operand size prefix 0x66
        //   pf    mandatory prefix 0xF2 or 0xF3 (0 for none)
        //   w     REX.W
        //   rex8  an 8 bit register needs REX even without other bits
        //   opn   number of opcode bytes in o (little endian, first byte lowest)
        //   regf  the modrm reg field (0 to 15, bit 3 goes to REX.R)
        //   rm    the r/m operand
        //   immn  immediate byte count, imm the value, immop its operand for symbol fixups
        ia_emit(IasmCtx* cx, Ib* ib, bool p66, int pf, bool w, bool rex8, int opn, int o, int regf, Operand* rm, int immn, i64 imm, Operand* immop) -> bool
        {
            int rex = 0;
            int k = 0;
            int b, sb;
            if (rm.seg >= 0)
            {
                sb = ia_seg_byte(rm.seg);
                if (sb != 0) { ib_put(ib, sb); };
            };
            if (ia_a32(rm)) { ib_put(ib, 0x67); };
            if (p66) { ib_put(ib, 0x66); };
            if (pf != 0) { ib_put(ib, pf); };
            if (w) { rex = rex `| 8; };
            if (regf >= 8) { rex = rex `| 4; };
            k = ia_rm_rexbits(rm);
            if (rm.kind == IA_OP_REG) { if ((k `& 1) != 0) { rex = rex `| 1; }; }
            else { rex = rex `| k; };
            if (rex != 0 | rex8) { ib_put(ib, 0x40 `| rex); };
            k = 0;
            while (k < opn)
            {
                b = (o >> (8 * k)) `& 255;
                ib_put(ib, b);
                k++;
            };
            if (!ia_emit_modrm(cx, ib, regf, rm, immn)) { -> false; };
            if (immn > 0)
            {
                if (immop != 0 & immop.sym != 0)
                {
                    if (immn == 8) { ib_fix(ib, ib.n, IA_FX_ABS64, immop.val, immop.sym); }
                    else
                    {
                        if (immn == 4) { ib_fix(ib, ib.n, IA_FX_ABS32S, immop.val, immop.sym); }
                        else
                        {
                            if (immn == 2) { ib_fix(ib, ib.n, IA_FX_ABS16, immop.val, immop.sym); }
                            else { ib_fix(ib, ib.n, IA_FX_ABS8, immop.val, immop.sym); };
                        };
                    };
                    k = 0;
                    while (k < immn) { ib_put(ib, 0); k++; };
                }
                else
                {
                    if (immn == 1) { ib_put(ib, (imm `& 255)); };
                    if (immn == 2) { ib_put16(ib, imm); };
                    if (immn == 4) { ib_put32(ib, imm); };
                    if (immn == 8) { ib_put64(ib, imm); };
                };
            };
            -> true;
        };

        // A register operand as an r/m operand
        ia_reg_op(Operand* o, int code) -> void
        {
            ia_op_clear(o);
            o.kind = IA_OP_REG;
            o.reg = code;
            ->;
        };

        // Instruction with a register in the opcode (push, pop, bswap, mov imm): [66] [REX] opc+reg
        ia_emit_oreg(Ib* ib, bool p66, bool w, int opn, int o, int reg) -> void
        {
            int rex = 0;
            int k = 0;
            if (p66) { ib_put(ib, 0x66); };
            if (w) { rex = rex `| 8; };
            if (ia_regnum(reg) >= 8) { rex = rex `| 1; };
            if (rex != 0 | ia_rex8(reg)) { ib_put(ib, 0x40 `| rex); };
            k = 0;
            while (k < opn - 1) { ib_put(ib, (o >> (8 * k)) `& 255); k++; };
            ib_put(ib, ((o >> (8 * (opn - 1))) `& 255) + (ia_regnum(reg) `& 7));
            ->;
        };

        // Size in bits of the operation: the suffix size, else from a register operand
        ia_opsize(int sz, Operand* a, Operand* b) -> int
        {
            if (sz != 0) { -> sz; };
            if (a.kind == IA_OP_REG & ia_is_gpr(a.reg)) { -> ia_regbits(a.reg); };
            if (b.kind == IA_OP_REG & ia_is_gpr(b.reg)) { -> ia_regbits(b.reg); };
            -> 0;
        };

        // True when the register operand is the accumulator of its size
        ia_is_acc(Operand* o) -> bool -> o.kind == IA_OP_REG & ia_is_gpr(o.reg) & ia_regnum(o.reg) == 0 & ia_regcls(o.reg) != IA_RC_R8H;

        // movq or movd involving an xmm register
        ia_enc_movd(IasmCtx* cx, Mn* m, Operand* a, Operand* b, Ib* ib, bool q) -> bool
        {
            bool axmm = a.kind == IA_OP_REG & ia_regcls(a.reg) == IA_RC_XMM;
            bool bxmm = b.kind == IA_OP_REG & ia_regcls(b.reg) == IA_RC_XMM;
            bool agpr = a.kind == IA_OP_REG & ia_is_gpr(a.reg);
            bool bgpr = b.kind == IA_OP_REG & ia_is_gpr(b.reg);
            if (bxmm & (agpr | (!q & a.kind == IA_OP_MEM)))
            {
                -> ia_emit(cx, ib, true, 0, q & agpr, false, 2, 0x6E0F, ia_regnum(b.reg), a, 0, 0, (Operand*)0);
            };
            if (axmm & (bgpr | (!q & b.kind == IA_OP_MEM)))
            {
                -> ia_emit(cx, ib, true, 0, q & bgpr, false, 2, 0x7E0F, ia_regnum(a.reg), b, 0, 0, (Operand*)0);
            };
            if (q)
            {
                if (bxmm & (axmm | a.kind == IA_OP_MEM))
                {
                    -> ia_emit(cx, ib, false, 0xF3, false, false, 2, 0x7E0F, ia_regnum(b.reg), a, 0, 0, (Operand*)0);
                };
                if (axmm & b.kind == IA_OP_MEM)
                {
                    -> ia_emit(cx, ib, true, 0, false, false, 2, 0xD60F, ia_regnum(a.reg), b, 0, 0, (Operand*)0);
                };
            };
            -> ia_fail(cx, "bad movd or movq operands\0");
        };

        ia_enc_sse(IasmCtx* cx, Mn* m, Operand* a, Operand* b, Ib* ib) -> bool
        {
            bool p66 = m.b == 0x66;
            int pf = 0;
            if (m.b == 0xF2 | m.b == 0xF3) { pf = m.b; };
            // load form: source r/m, destination xmm
            if (b.kind == IA_OP_REG & (ia_regcls(b.reg) == IA_RC_XMM | ia_is_gpr(b.reg)) & m.a != 0)
            {
                -> ia_emit(cx, ib, p66, pf, false, false, 2, m.a, ia_regnum(b.reg), a, 0, 0, (Operand*)0);
            };
            // store form: source xmm, destination memory
            if (a.kind == IA_OP_REG & ia_regcls(a.reg) == IA_RC_XMM & b.kind == IA_OP_MEM & m.c != 0)
            {
                -> ia_emit(cx, ib, p66, pf, false, false, 2, m.c, ia_regnum(a.reg), b, 0, 0, (Operand*)0);
            };
            -> ia_fail(cx, "bad sse operands\0");
        };

        ia_enc_cvti2f(IasmCtx* cx, Mn* m, Operand* a, Operand* b, Ib* ib) -> bool
        {
            int sz = m.sz;
            if (sz == 0 & a.kind == IA_OP_REG) { sz = ia_regbits(a.reg); };
            if (b.kind != IA_OP_REG | sz == 0) { -> ia_fail(cx, "bad cvtsi2s operands\0"); };
            -> ia_emit(cx, ib, false, m.b, sz == 64, false, 2, m.a, ia_regnum(b.reg), a, 0, 0, (Operand*)0);
        };

        ia_enc_cvtf2i(IasmCtx* cx, Mn* m, Operand* a, Operand* b, Ib* ib) -> bool
        {
            int sz;
            if (b.kind != IA_OP_REG | !ia_is_gpr(b.reg)) { -> ia_fail(cx, "bad cvtts2si operands\0"); };
            sz = ia_regbits(b.reg);
            if (m.sz != 0 & m.sz != sz) { -> ia_fail(cx, "cvts2si suffix does not match the register\0"); };
            -> ia_emit(cx, ib, false, m.b, sz == 64, false, 2, m.a, ia_regnum(b.reg), a, 0, 0, (Operand*)0);
        };

        ia_enc_ssecmp(IasmCtx* cx, Mn* m, Operand* a, Operand* b, Ib* ib) -> bool
        {
            bool p66 = m.b == 0x66;
            int pf = 0;
            if (m.b == 0xF2 | m.b == 0xF3) { pf = m.b; };
            if (b.kind != IA_OP_REG) { -> ia_fail(cx, "bad cmp operands\0"); };
            -> ia_emit(cx, ib, p66, pf, false, false, 2, m.a, ia_regnum(b.reg), a, 1, m.sz, (Operand*)0);
        };

        ia_enc_prefetch(IasmCtx* cx, Mn* m, Operand* a, Ib* ib) -> bool
        {
            if (a.kind != IA_OP_MEM) { -> ia_fail(cx, "bad prefetch operand\0"); };
            -> ia_emit(cx, ib, false, 0, false, false, 2, 0x180F, m.a, a, 0, 0, (Operand*)0);
        };

        ia_enc_x87(IasmCtx* cx, Mn* m, Operand* a, Ib* ib) -> bool
        {
            if (a.kind != IA_OP_MEM) { -> ia_fail(cx, "bad x87 operand\0"); };
            -> ia_emit(cx, ib, false, 0, false, false, 1, m.a, m.b, a, 0, 0, (Operand*)0);
        };

        ia_enc_x87reg(IasmCtx* cx, Mn* m, Operand* a, Ib* ib) -> bool
        {
            if (a.kind != IA_OP_REG | ia_regcls(a.reg) != IA_RC_ST) { -> ia_fail(cx, "bad x87 register\0"); };
            ib_put(ib, m.a);
            ib_put(ib, m.b + ia_regnum(a.reg));
            -> true;
        };

        // VEX (two or three byte) encoding of vmovdq* style moves
        // ===== VEX ENCODING =====

        ia_vx_vec(Operand* o) -> bool
        {
            if (o.kind != IA_OP_REG) { -> false; };
            -> ia_regcls(o.reg) == IA_RC_XMM | ia_regcls(o.reg) == IA_RC_YMM | ia_regcls(o.reg) == IA_RC_ZMM;
        };

        ia_vx_zmm(Operand* o) -> bool
        {
            if (o.kind != IA_OP_REG) { -> false; };
            -> ia_regcls(o.reg) == IA_RC_ZMM;
        };

        // A register that only an EVEX prefix can address: zmm, or xmm and ymm 16 to 31
        ia_ev_reg(Operand* o) -> bool
        {
            int cl;
            if (o.kind != IA_OP_REG) { -> false; };
            cl = ia_regcls(o.reg);
            if (cl == IA_RC_ZMM) { -> true; };
            if ((cl == IA_RC_XMM | cl == IA_RC_YMM) & ia_regnum(o.reg) >= 16) { -> true; };
            -> false;
        };

        // Records the EVEX decorations of one operand in the context
        ia_ev_scan(IasmCtx* cx, Operand* o) -> void
        {
            if (ia_ev_reg(o)) { cx.ev = true; };
            if (o.kind == IA_OP_REG & ia_regcls(o.reg) == IA_RC_K) { cx.ev = true; };
            if (o.mask != 0) { cx.ev = true; cx.ev_k = o.mask - 1; };
            if (o.zero) { cx.ev = true; cx.ev_z = true; };
            if (o.bcst != 0) { cx.ev = true; cx.ev_b = 1; };
            ->;
        };

        ia_ends(byte* s, byte* suf) -> bool
        {
            int n = ia_strlen(s);
            int m = ia_strlen(suf);
            if (m > n) { -> false; };
            -> ia_eqn(s + n - m, m, suf);
        };

        ia_starts(byte* s, byte* pre) -> bool
        {
            int i = 0;
            while (pre[i] != 0)
            {
                if (s[i] != pre[i]) { -> false; };
                i++;
            };
            -> true;
        };

        // True when name is one of the space separated words of list
        ia_word_in(byte* name, byte* list) -> bool
        {
            int i = 0;
            int st;
            int n = ia_strlen(name);
            while (list[i] != 0)
            {
                while (list[i] == 32) { i++; };
                st = i;
                while (list[i] != 0 & list[i] != 32) { i++; };
                if (i > st & i - st == n & ia_eqn(list + st, n, name)) { -> true; };
            };
            -> false;
        };

        // True for the AVX512-FP16 arithmetic family kept in maps 5 and 6 (conversions have their own tuples)
        ia_h16(IasmCtx* cx) -> bool
        {
            byte* nm = cx.ev_mn.name;
            if (ia_starts(nm, "vcvt\0")) { -> false; };
            if (ia_ends(nm, "cph\0") | ia_ends(nm, "csh\0")) { -> false; };
            if (ia_ends(nm, "ph\0") | ia_ends(nm, "sh\0")) { -> true; };
            -> false;
        };

        // The disp8*N scale of the memory operand of the instruction being encoded
        ia_ev_n(IasmCtx* cx, int pp, int w, int l) -> int
        {
            byte* nm = cx.ev_mn.name;
            int vl = 16 << l;
            if (cx.ev_n16) { -> 16; };
            if (cx.ev_mn.sz == IA_VF_GATHER) { if (w == 1) { -> 8; }; -> 4; };
            if (ia_word_in(nm, "vmovw vmovsh\0")) { -> 2; };
            if (ia_ends(nm, "csh\0")) { -> 4; };
            if (ia_word_in(nm, "vcvtph2w vcvtph2uw vcvttph2w vcvttph2uw vcvtw2ph vcvtuw2ph\0")) { if (cx.ev_b != 0) { -> 2; }; -> vl; };
            if (ia_word_in(nm, "vcvtph2dq vcvtph2udq vcvttph2dq vcvttph2udq vcvtph2psx\0")) { if (cx.ev_b != 0) { -> 2; }; -> vl / 2; };
            if (ia_word_in(nm, "vcvtph2qq vcvtph2uqq vcvttph2qq vcvttph2uqq vcvtph2pd\0")) { if (cx.ev_b != 0) { -> 2; }; -> vl / 4; };
            if (ia_word_in(nm, "vcvtdq2ph vcvtudq2ph vcvtps2phx vcvtdq2phx vcvtudq2phx vcvtdq2phy vcvtudq2phy vcvtps2phxx vcvtps2phxy\0")) { if (cx.ev_b != 0) { -> 4; }; -> vl; };
            if (ia_word_in(nm, "vcvtqq2ph vcvtuqq2ph vcvtpd2ph vcvtqq2phx vcvtuqq2phx vcvtpd2phx vcvtqq2phy vcvtuqq2phy vcvtpd2phy\0")) { if (cx.ev_b != 0) { -> 8; }; -> vl; };
            if (ia_word_in(nm, "vcvtsh2ss vcvtsh2sd vcvtsh2si vcvtsh2usi vcvttsh2si vcvttsh2usi\0")) { -> 2; };
            if (ia_word_in(nm, "vcvtss2sh\0")) { -> 4; };
            if (ia_word_in(nm, "vcvtsd2sh\0")) { -> 8; };
            if (ia_starts(nm, "vcvtsi2sh\0") | ia_starts(nm, "vcvtusi2sh\0")) { if (ia_ends(nm, "q\0")) { -> 8; }; -> 4; };
            if (ia_starts(nm, "vf\0") & ia_word_in(nm, "vfmadd132ss vfmadd213ss vfmadd231ss vfmsub132ss vfmsub213ss vfmsub231ss vfnmadd132ss vfnmadd213ss vfnmadd231ss vfnmsub132ss vfnmsub213ss vfnmsub231ss\0")) { -> 4; };
            if (ia_starts(nm, "vf\0") & ia_word_in(nm, "vfmadd132sd vfmadd213sd vfmadd231sd vfmsub132sd vfmsub213sd vfmsub231sd vfnmadd132sd vfnmadd213sd vfnmadd231sd vfnmsub132sd vfnmsub213sd vfnmsub231sd\0")) { -> 8; };
            if (ia_h16(cx))
            {
                if (cx.ev_b != 0) { -> 2; };
                if (ia_ends(nm, "sh\0") | ia_ends(nm, "ch\0")) { -> 2; };
            };
            if (cx.ev_b != 0) { if (w == 1) { -> 8; }; -> 4; };
            if (cx.ev_mn.sz == IA_VF_MOVS) { if (pp == 3) { -> 8; }; -> 4; };
            if (ia_word_in(nm, "vbroadcastss vpbroadcastd vcomiss vucomiss vcvtss2sd vcvtss2si vcvttss2si vextractps vinsertps vpextrd vpinsrd vmovd vpbroadcastd\0")) { -> 4; };
            if (ia_word_in(nm, "vbroadcastsd vpbroadcastq vcomisd vucomisd vcvtsd2ss vcvtsd2si vcvttsd2si vpextrq vpinsrq vmovq vmovlps vmovhps vmovlpd vmovhpd\0")) { -> 8; };
            if (ia_word_in(nm, "vpbroadcastb vpextrb vpinsrb\0")) { -> 1; };
            if (ia_word_in(nm, "vpbroadcastw vpextrw vpinsrw\0")) { -> 2; };
            if (ia_word_in(nm, "vcvtsi2ssl vcvtsi2sdl\0")) { -> 4; };
            if (ia_word_in(nm, "vcvtsi2ss vcvtsi2sd\0")) { if (w == 1) { -> 8; }; -> 4; };
            if (ia_word_in(nm, "vcvtsi2ssq vcvtsi2sdq\0")) { -> 8; };
            if (((cx.ev_mn.a >> 13) `& 1) != 0)
            {
                if (ia_word_in(nm, "vbroadcastf32x4 vbroadcastf64x2 vbroadcasti32x4 vbroadcasti64x2 vextractf32x4 vextractf64x2 vextracti32x4 vextracti64x2 vinsertf32x4 vinsertf64x2 vinserti32x4 vinserti64x2\0")) { -> 16; };
                if (ia_word_in(nm, "vbroadcastf32x8 vbroadcastf64x4 vbroadcasti32x8 vbroadcasti64x4 vextractf32x8 vextractf64x4 vextracti32x8 vextracti64x4 vinsertf32x8 vinsertf64x4 vinserti32x8 vinserti64x4\0")) { -> 32; };
                if (ia_word_in(nm, "vcvtss2usi vcvttss2usi vcvtusi2ssl vcvtusi2sdl vgetexpss vgetmantss vrndscaless vscalefss vfixupimmss vrcp14ss vrsqrt14ss vreducess vrangess\0")) { -> 4; };
                if (ia_word_in(nm, "vcvtsd2usi vcvttsd2usi vcvtusi2ssq vcvtusi2sdq vgetexpsd vgetmantsd vrndscalesd vscalefsd vfixupimmsd vrcp14sd vrsqrt14sd vreducesd vrangesd\0")) { -> 8; };
                if (ia_word_in(nm, "vcvtusi2ss vcvtusi2sd\0")) { if (w == 1) { -> 8; }; -> 4; };
                if (ia_word_in(nm, "vpcompressd vcompressps vpexpandd vexpandps\0")) { -> 4; };
                if (ia_word_in(nm, "vpcompressb vpexpandb\0")) { -> 1; };
                if (ia_word_in(nm, "vpcompressw vpexpandw\0")) { -> 2; };
                if (ia_word_in(nm, "vpcompressq vcompresspd vpexpandq vexpandpd\0")) { -> 8; };
                if (ia_word_in(nm, "vpmovwb vpmovswb vpmovuswb vpmovdw vpmovsdw vpmovusdw vpmovqd vpmovsqd vpmovusqd\0")) { -> vl / 2; };
                if (ia_word_in(nm, "vpmovdb vpmovsdb vpmovusdb vpmovqw vpmovsqw vpmovusqw\0")) { -> vl / 4; };
                if (ia_word_in(nm, "vpmovqb vpmovsqb vpmovusqb\0")) { -> vl / 8; };
                if (ia_word_in(nm, "vcvtudq2pd\0")) { -> vl / 2; };
            };
            if (ia_word_in(nm, "vbroadcastf32x2 vbroadcasti32x2\0")) { -> 8; };
            if (ia_word_in(nm, "vcvtps2qq vcvtps2uqq vcvttps2qq vcvttps2uqq\0")) { -> vl / 2; };
            if (ia_word_in(nm, "vcvtph2ps vcvtps2ph vcvtdq2pd vcvtps2pd vpmovsxbw vpmovzxbw vpmovsxwd vpmovzxwd vpmovsxdq vpmovzxdq\0")) { -> vl / 2; };
            if (ia_word_in(nm, "vpmovsxbd vpmovzxbd vpmovsxwq vpmovzxwq\0")) { -> vl / 4; };
            if (ia_word_in(nm, "vpmovsxbq vpmovzxbq\0")) { -> vl / 8; };
            if (ia_word_in(nm, "vmovddup\0") & l == 0) { -> 8; };
            if (pp == 2 & ia_ends(nm, "ss\0")) { -> 4; };
            if (pp == 3 & ia_ends(nm, "sd\0")) { -> 8; };
            -> vl;
        };

        // EVEX W for an instruction whose VEX entry says w
        ia_ev_w(IasmCtx* cx, int pp, int w) -> int
        {
            byte* nm = cx.ev_mn.name;
            if (((cx.ev_mn.a >> 13) `& 1) != 0) { -> w; };
            if (ia_starts(nm, "vcvtsi2\0")) { -> w; };
            if (ia_word_in(nm, "vpaddq vpsubq vpmuldq vpmuludq vpunpckhqdq vpunpcklqdq vpsllq vpsrlq vpcmpeqq vpcmpgtq vpermq vpermpd vpand vpandn vpor vpxor vmovddup vmovq vbroadcastsd vcomisd vucomisd vpbroadcastq vcvtsd2ss\0")) { -> 1; };
            if (ia_starts(nm, "vcvtpd\0") | ia_starts(nm, "vcvttpd\0")) { -> 1; };
            if (pp == 1 & ia_ends(nm, "pd\0")) { -> 1; };
            if (pp == 3 & ia_ends(nm, "sd\0")) { -> 1; };
            -> w;
        };

        ia_vx_reg64(Operand* o) -> bool
        {
            if (o.kind != IA_OP_REG) { -> false; };
            -> ia_regcls(o.reg) == IA_RC_R64;
        };

        // 0 xmm, 1 ymm, 2 zmm for a vector register, or -1
        ia_vw(int r) -> int
        {
            int cl = ia_regcls(r);
            if (cl == IA_RC_XMM) { -> 0; };
            if (cl == IA_RC_YMM) { -> 1; };
            if (cl == IA_RC_ZMM) { -> 2; };
            -> -1;
        };

        ia_vx_ymm(Operand* o) -> bool
        {
            if (o.kind != IA_OP_REG) { -> false; };
            -> ia_regcls(o.reg) == IA_RC_YMM;
        };

        // Operand that may sit in the r/m field
        ia_vx_rm_ok(Operand* o) -> bool
        {
            -> o.kind == IA_OP_REG | o.kind == IA_OP_MEM | o.kind == IA_OP_SYM;
        };

        ia_vx_imm_ok(Operand* o) -> bool
        {
            -> o.kind == IA_OP_IMM & o.sym == 0;
        };

        // Writes the VEX prefix, the opcode, the ModRM bytes and an optional immediate byte
        ia_vx_emit(IasmCtx* cx, Ib* ib, int map, int pp, int w, int l, int opc, int regf, int vvvv, Operand* rm, bool hasimm, int imm) -> bool
        {
            int rexb = ia_rm_rexbits(rm);
            int vr = 0x80;
            int vx = 0x40;
            int vb = 0x20;
            int vv = (15 - (vvvv `& 15)) << 3;
            int sb, p0, p1, p2, xr, bb;
            int ll = l;
            int bbit = 0;
            int zb = 0;
            int vp = 0;
            if (cx.ev_z) { zb = 1; };
            if (rm.seg >= 0)
            {
                sb = ia_seg_byte(rm.seg);
                if (sb != 0) { ib_put(ib, sb); };
            };
            if (ia_a32(rm)) { ib_put(ib, 0x67); };
            if (cx.ev)
            {
                w = ia_ev_w(cx, pp, w);
                // R, X, B and R' are stored inverted; X also carries bit 4 of a register r/m
                xr = (rexb >> 1) `& 1;
                bb = rexb `& 1;
                if (rm.kind == IA_OP_REG)
                {
                    xr = (ia_regnum(rm.reg) >> 4) `& 1;
                    bb = (ia_regnum(rm.reg) >> 3) `& 1;
                };
                p0 = ((((regf >> 3) `& 1) `^| 1) << 7) `| ((xr `^| 1) << 6) `| ((bb `^| 1) << 5) `| ((((regf >> 4) `& 1) `^| 1) << 4) `| map;
                if (cx.ev_b != 0) { bbit = 1; };
                if (cx.ev_rc >= 1 & cx.ev_rc <= 4) { bbit = 1; ll = cx.ev_rc - 1; };
                if (cx.ev_rc == 5) { bbit = 1; ll = 0; };
                p1 = (w << 7) `| (((15 - (vvvv `& 15))) << 3) `| 4 `| pp;
                vp = (vvvv >> 4) `& 1;
                if (rm.kind == IA_OP_MEM & rm.index >= 0)
                {
                    if (ia_vw(rm.index) >= 0) { vp = (ia_regnum(rm.index) >> 4) `& 1; };
                };
                p2 = (zb << 7) `| (ll << 5) `| (bbit << 4) `| ((vp `^| 1) << 3) `| (cx.ev_k `& 7);
                ib_put(ib, 0x62);
                ib_put(ib, p0);
                ib_put(ib, p1);
                ib_put(ib, p2);
                ib_put(ib, opc);
                cx.d8n = ia_ev_n(cx, pp, w, l);
                if (hasimm)
                {
                    if (!ia_emit_modrm(cx, ib, regf, rm, 1)) { cx.d8n = 0; -> false; };
                    cx.d8n = 0;
                    ib_put(ib, imm `& 255);
                    -> true;
                };
                bool okm = ia_emit_modrm(cx, ib, regf, rm, 0);
                cx.d8n = 0;
                -> okm;
            };
            if (regf >= 8) { vr = 0; };
            if ((rexb `& 2) != 0) { vx = 0; };
            if ((rexb `& 1) != 0) { vb = 0; };
            if (map == 1 & w == 0 & (rexb `& 3) == 0)
            {
                ib_put(ib, 0xC5);
                ib_put(ib, vr `| vv `| (l << 2) `| pp);
            }
            else
            {
                ib_put(ib, 0xC4);
                ib_put(ib, vr `| vx `| vb `| map);
                ib_put(ib, (w << 7) `| vv `| (l << 2) `| pp);
            };
            ib_put(ib, opc);
            if (hasimm)
            {
                if (!ia_emit_modrm(cx, ib, regf, rm, 1)) { -> false; };
                ib_put(ib, imm `& 255);
                -> true;
            };
            -> ia_emit_modrm(cx, ib, regf, rm, 0);
        };

        ia_enc_vx(IasmCtx* cx, Mn* m, Operand* a, Operand* b, Operand* c, Ib* ib) -> bool
        {
            Operand* d = @cx.op4;
            int form = m.sz;
            int opc = m.a `& 255;
            int map = (m.a >> 8) `& 3;
            if (((m.a >> 14) `& 1) != 0) { map = 5; };
            if (((m.a >> 15) `& 1) != 0) { map = 6; };
            int pp = (m.a >> 10) `& 3;
            int w = (m.a >> 12) `& 1;
            int l = 0;
            int regf;
            int vvvv = 0;
            int imm = 0;
            Operand* rm;
            if (ia_vx_ymm(a) | ia_vx_ymm(b) | ia_vx_ymm(c) | ia_vx_ymm(d)) { l = 1; };
            cx.ev = false;
            cx.ev_k = 0;
            cx.ev_z = false;
            cx.ev_b = 0;
            cx.d8n = 0;
            cx.ev_n16 = false;
            cx.ev_mn = m;
            ia_ev_scan(cx, a);
            ia_ev_scan(cx, b);
            ia_ev_scan(cx, c);
            ia_ev_scan(cx, d);
            if (cx.ev_rc != 0) { cx.ev = true; };
            if (((m.a >> 13) `& 1) != 0) { cx.ev = true; };
            if (ia_vx_zmm(a) | ia_vx_zmm(b) | ia_vx_zmm(c) | ia_vx_zmm(d)) { l = 2; };
            // vpbroadcastb/w/d/q from a general register exist only as EVEX
            if (ia_word_in(m.name, "vpbroadcastb vpbroadcastw vpbroadcastd vpbroadcastq\0") & a.kind == IA_OP_REG & ia_is_gpr(a.reg) & ia_vx_vec(b) & c.kind == IA_OP_NONE)
            {
                cx.ev = true;
                if (ia_vx_ymm(b)) { l = 1; };
                opc = 0x7C;
                if (ia_eqn(m.name, 12, "vpbroadcastb")) { opc = 0x7A; };
                if (ia_eqn(m.name, 12, "vpbroadcastw")) { opc = 0x7B; };
                w = 0;
                if (ia_eqn(m.name, 12, "vpbroadcastq")) { w = 1; };
                -> ia_vx_emit(cx, ib, 2, 1, w, l, opc, ia_regnum(b.reg), 0, a, false, 0);
            };
            // vpermq and vpermpd with a vector index have an EVEX form with opcodes 36 and 16
            if (ia_word_in(m.name, "vpermq vpermpd\0") & !ia_vx_imm_ok(a) & ia_vx_rm_ok(a) & ia_vx_vec(b) & ia_vx_vec(c) & d.kind == IA_OP_NONE)
            {
                cx.ev = true;
                opc = 0x36;
                if (ia_eqn(m.name, 7, "vpermpd")) { opc = 0x16; };
                -> ia_vx_emit(cx, ib, 2, 1, 1, l, opc, ia_regnum(c.reg), ia_regnum(b.reg), a, false, 0);
            };
            // a memory source for an immediate shift is EVEX only
            if (form == IA_VF_SHIFT & ia_vx_imm_ok(a) & (b.kind == IA_OP_MEM | b.kind == IA_OP_SYM) & c.kind == IA_OP_REG) { cx.ev = true; };
            // a 512 bit memory source is implied by a ymm destination for the pd to dq/ps conversions
            if (ia_word_in(m.name, "vcvtpd2dq vcvttpd2dq vcvtpd2ps vcvtpd2udq vcvttpd2udq\0"))
            {
                if (b.kind == IA_OP_REG & ia_vx_ymm(b) & (a.kind == IA_OP_MEM | a.kind == IA_OP_SYM)) { l = 2; };
                if (a.bcst != 0 & b.kind == IA_OP_REG)
                {
                    l = 2;
                    if (a.bcst == 4) { l = 1; };
                    if (a.bcst == 2) { l = 0; };
                };
            };
            // memory forms whose length comes from the mnemonic suffix or the narrowed destination
            if (ia_word_in(m.name, "vcvtdq2phx vcvtdq2phy vcvtudq2phx vcvtudq2phy vcvtps2phxx vcvtps2phxy vcvtqq2phx vcvtqq2phy vcvtuqq2phx vcvtuqq2phy vcvtpd2phx vcvtpd2phy\0"))
            {
                if (ia_ends(m.name, "x\0")) { l = 0; };
                if (ia_ends(m.name, "y\0")) { l = 1; };
            };
            if (ia_word_in(m.name, "vcvtdq2ph vcvtudq2ph vcvtps2phx vcvtqq2ph vcvtuqq2ph vcvtpd2ph\0") & (a.kind == IA_OP_MEM | a.kind == IA_OP_SYM) & b.kind == IA_OP_REG) { l = 2; };
            if (ia_starts(m.name, "vcvtneps2bf16\0") | ia_starts(m.name, "vfpclassp\0"))
            {
                if (ia_ends(m.name, "x\0")) { l = 0; };
                if (ia_ends(m.name, "y\0")) { l = 1; };
                if (ia_ends(m.name, "z\0")) { l = 2; };
                if (ia_starts(m.name, "vcvtneps2bf16\0") & !ia_ends(m.name, "x\0") & !ia_ends(m.name, "y\0") & (a.kind == IA_OP_MEM | a.kind == IA_OP_SYM) & b.kind == IA_OP_REG & ia_vx_ymm(b)) { l = 2; };
            };
            if (l == 2) { cx.ev = true; };
            if (form == IA_VF_GATHER)
            {
                Operand* gm, gd, gk;
                int xw = 0;
                int dw;
                gk = (Operand*)0;
                if (m.c == 1)
                {
                    if (!(a.kind == IA_OP_REG & ia_vw(a.reg) >= 0 & b.kind == IA_OP_MEM & c.kind == IA_OP_NONE)) { -> ia_fail(cx, "bad evex operands\0"); };
                    gd = a; gm = b;
                }
                else
                {
                    if (a.kind == IA_OP_MEM & b.kind == IA_OP_REG & ia_vw(b.reg) >= 0 & c.kind == IA_OP_NONE) { gd = b; gm = a; }
                    else
                    {
                        if (!(a.kind == IA_OP_REG & ia_vw(a.reg) >= 0 & b.kind == IA_OP_MEM & c.kind == IA_OP_REG & ia_vw(c.reg) >= 0 & d.kind == IA_OP_NONE)) { -> ia_fail(cx, "bad vex operands\0"); };
                        gd = c; gm = b; gk = a;
                    };
                };
                if (gm.index < 0 | ia_vw(gm.index) < 0) { -> ia_fail(cx, "vector index required\0"); };
                xw = ia_vw(gm.index);
                dw = ia_vw(gd.reg);
                l = dw;
                if (xw > l) { l = xw; };
                if (gk == 0 | m.c == 1 | l == 2 | ia_regnum(gd.reg) >= 16 | ia_regnum(gm.index) >= 16) { cx.ev = true; };
                if (cx.ev & gk != 0) { -> ia_fail(cx, "bad evex operands\0"); };
                if (gk != 0) { -> ia_vx_emit(cx, ib, map, pp, w, l, opc, ia_regnum(gd.reg), ia_regnum(gk.reg), gm, false, 0); };
                -> ia_vx_emit(cx, ib, map, pp, w, l, opc, ia_regnum(gd.reg), 0, gm, false, 0);
            };
            if (form == IA_VF_MASKMOV)
            {
                if (a.kind == IA_OP_MEM & ia_vx_vec(b) & ia_vx_vec(c) & d.kind == IA_OP_NONE)
                {
                    -> ia_vx_emit(cx, ib, map, pp, w, l, opc, ia_regnum(c.reg), ia_regnum(b.reg), a, false, 0);
                };
                if (ia_vx_vec(a) & ia_vx_vec(b) & c.kind == IA_OP_MEM & d.kind == IA_OP_NONE)
                {
                    -> ia_vx_emit(cx, ib, map, pp, w, l, opc + 2, ia_regnum(a.reg), ia_regnum(b.reg), c, false, 0);
                };
                -> ia_fail(cx, "bad vex operands\0");
            };
            if (form == IA_VF_GRP)
            {
                if (!(a.kind == IA_OP_MEM & b.kind == IA_OP_NONE)) { -> ia_fail(cx, "bad vex operands\0"); };
                -> ia_vx_emit(cx, ib, map, pp, w, 0, opc, m.b, 0, a, false, 0);
            };
            if (form == IA_VF_MR)
            {
                if (!(ia_vx_vec(a) & ia_vx_rm_ok(b) & c.kind == IA_OP_NONE)) { -> ia_fail(cx, "bad evex operands\0"); };
                -> ia_vx_emit(cx, ib, map, pp, w, l, opc, ia_regnum(a.reg), 0, b, false, 0);
            };
            if (form == IA_VF_KOP)
            {
                // k mask instructions: VEX encoded, k registers 0 to 7
                cx.ev = false;
                if (m.b == 0)
                {
                    if (!(a.kind == IA_OP_REG & b.kind == IA_OP_REG & c.kind == IA_OP_REG & ia_regcls(a.reg) == IA_RC_K & ia_regcls(b.reg) == IA_RC_K & ia_regcls(c.reg) == IA_RC_K)) { -> ia_fail(cx, "bad mask operands\0"); };
                    -> ia_vx_emit(cx, ib, map, pp, w, 1, opc, ia_regnum(c.reg), ia_regnum(b.reg), a, false, 0);
                };
                if (m.b == 1)
                {
                    if (!(a.kind == IA_OP_REG & b.kind == IA_OP_REG & c.kind == IA_OP_NONE & ia_regcls(a.reg) == IA_RC_K & ia_regcls(b.reg) == IA_RC_K)) { -> ia_fail(cx, "bad mask operands\0"); };
                    -> ia_vx_emit(cx, ib, map, pp, w, 0, opc, ia_regnum(b.reg), 0, a, false, 0);
                };
                if (m.b == 3)
                {
                    if (!(ia_vx_imm_ok(a) & b.kind == IA_OP_REG & c.kind == IA_OP_REG & ia_regcls(b.reg) == IA_RC_K & ia_regcls(c.reg) == IA_RC_K)) { -> ia_fail(cx, "bad mask operands\0"); };
                    -> ia_vx_emit(cx, ib, map, pp, w, 0, opc, ia_regnum(c.reg), 0, b, true, a.val);
                };
                // kmov
                if (a.kind == IA_OP_REG & ia_regcls(a.reg) == IA_RC_K & b.kind == IA_OP_REG & ia_regcls(b.reg) == IA_RC_K)
                {
                    -> ia_vx_emit(cx, ib, map, pp, w, 0, 0x90, ia_regnum(b.reg), 0, a, false, 0);
                };
                if ((a.kind == IA_OP_MEM | a.kind == IA_OP_SYM) & b.kind == IA_OP_REG & ia_regcls(b.reg) == IA_RC_K)
                {
                    -> ia_vx_emit(cx, ib, map, pp, w, 0, 0x90, ia_regnum(b.reg), 0, a, false, 0);
                };
                if (a.kind == IA_OP_REG & ia_regcls(a.reg) == IA_RC_K & (b.kind == IA_OP_MEM | b.kind == IA_OP_SYM))
                {
                    -> ia_vx_emit(cx, ib, map, pp, w, 0, 0x91, ia_regnum(a.reg), 0, b, false, 0);
                };
                if (pp == 1 & w == 1) { pp = 3; w = 0; }
                else { if (pp == 0 & w == 1) { pp = 3; }; };
                if (a.kind == IA_OP_REG & ia_is_gpr(a.reg) & b.kind == IA_OP_REG & ia_regcls(b.reg) == IA_RC_K)
                {
                    -> ia_vx_emit(cx, ib, map, pp, w, 0, 0x92, ia_regnum(b.reg), 0, a, false, 0);
                };
                if (a.kind == IA_OP_REG & ia_regcls(a.reg) == IA_RC_K & b.kind == IA_OP_REG & ia_is_gpr(b.reg))
                {
                    -> ia_vx_emit(cx, ib, map, pp, w, 0, 0x93, ia_regnum(b.reg), 0, a, false, 0);
                };
                -> ia_fail(cx, "bad mask operands\0");
            };
            if (form == IA_VF_RVM | form == IA_VF_CMP)
            {
                if (!(ia_vx_rm_ok(a) & b.kind == IA_OP_REG & c.kind == IA_OP_REG & d.kind == IA_OP_NONE)) { -> ia_fail(cx, "bad vex operands\0"); };
                if (ia_vx_reg64(c)) { w = 1; };
                rm = a;
                regf = ia_regnum(c.reg);
                vvvv = ia_regnum(b.reg);
                // a commutative operation with a high r/m register and a low vvvv register swaps them
                // so the two byte VEX prefix can be used
                bool comm = m.c == 1;
                if (form == IA_VF_CMP) { comm = (pp == 0 | pp == 1) & ((m.c `& 7) == 0 | (m.c `& 7) == 3 | (m.c `& 7) == 4 | (m.c `& 7) == 7); };
                if (comm & map == 1 & w == 0 & a.kind == IA_OP_REG & !cx.ev)
                {
                    if (ia_regnum(a.reg) >= 8 & vvvv < 8)
                    {
                        rm = b;
                        vvvv = ia_regnum(a.reg);
                    };
                };
                if (form == IA_VF_CMP) { -> ia_vx_emit(cx, ib, map, pp, w, l, opc, regf, vvvv, rm, true, m.c); };
                -> ia_vx_emit(cx, ib, map, pp, w, l, opc, regf, vvvv, rm, false, 0);
            };
            if (form == IA_VF_RM)
            {
                if (c.kind != IA_OP_NONE | a.kind == IA_OP_NONE | b.kind == IA_OP_NONE) { -> ia_fail(cx, "bad vex operands\0"); };
                if (m.c == 1) { l = 0; };
                if (m.c == 2) { l = 1; };
                if (m.b != 0 & ia_vx_vec(a) & ia_vx_vec(b) & ia_regnum(a.reg) >= 8 & ia_regnum(b.reg) < 8 & !cx.ev)
                {
                    // register to register with a high source: the store opcode keeps the prefix short
                    -> ia_vx_emit(cx, ib, map, pp, w, l, m.b, ia_regnum(a.reg), 0, b, false, 0);
                };
                if (b.kind == IA_OP_REG & m.a != 0 & ia_vx_rm_ok(a))
                {
                    // only the float to integer conversions take W from the register size
                    if (ia_vx_reg64(b) & (opc == 0x2C | opc == 0x2D | ((opc == 0x78 | opc == 0x79) & pp >= 2))) { w = 1; };
                    -> ia_vx_emit(cx, ib, map, pp, w, l, opc, ia_regnum(b.reg), 0, a, false, 0);
                };
                if (ia_vx_vec(a) & b.kind == IA_OP_MEM & m.b != 0)
                {
                    -> ia_vx_emit(cx, ib, map, pp, w, l, m.b, ia_regnum(a.reg), 0, b, false, 0);
                };
                -> ia_fail(cx, "bad vex operands\0");
            };
            if (form == IA_VF_RMI)
            {
                if (m.b != 0 & !ia_vx_imm_ok(a))
                {
                    // the variable form of vpermilps and vpermilpd: opcode m.b in the 0F38 map
                    if (!(ia_vx_rm_ok(a) & b.kind == IA_OP_REG & c.kind == IA_OP_REG & d.kind == IA_OP_NONE)) { -> ia_fail(cx, "bad vex operands\0"); };
                    -> ia_vx_emit(cx, ib, 2, pp, w, l, m.b, ia_regnum(c.reg), ia_regnum(b.reg), a, false, 0);
                };
                if (!(ia_vx_imm_ok(a) & ia_vx_rm_ok(b) & c.kind == IA_OP_REG & d.kind == IA_OP_NONE)) { -> ia_fail(cx, "bad vex operands\0"); };
                if (ia_vx_reg64(c)) { w = 1; };
                -> ia_vx_emit(cx, ib, map, pp, w, l, opc, ia_regnum(c.reg), 0, b, true, a.val);
            };
            if (form == IA_VF_RVMI)
            {
                if (!(ia_vx_imm_ok(a) & ia_vx_rm_ok(b) & c.kind == IA_OP_REG & d.kind == IA_OP_REG)) { -> ia_fail(cx, "bad vex operands\0"); };
                -> ia_vx_emit(cx, ib, map, pp, w, l, opc, ia_regnum(d.reg), ia_regnum(c.reg), b, true, a.val);
            };
            if (form == IA_VF_RVMR)
            {
                if (!(ia_vx_vec(a) & ia_vx_rm_ok(b) & c.kind == IA_OP_REG & d.kind == IA_OP_REG)) { -> ia_fail(cx, "bad vex operands\0"); };
                -> ia_vx_emit(cx, ib, map, pp, w, l, opc, ia_regnum(d.reg), ia_regnum(c.reg), b, true, ia_regnum(a.reg) << 4);
            };
            if (form == IA_VF_MOVS)
            {
                if (a.kind == IA_OP_REG & b.kind == IA_OP_REG & c.kind == IA_OP_REG)
                {
                    if (ia_regnum(a.reg) >= 8 & ia_regnum(c.reg) < 8 & !cx.ev)
                    {
                        -> ia_vx_emit(cx, ib, map, pp, w, 0, m.b, ia_regnum(a.reg), ia_regnum(b.reg), c, false, 0);
                    };
                    -> ia_vx_emit(cx, ib, map, pp, w, 0, opc, ia_regnum(c.reg), ia_regnum(b.reg), a, false, 0);
                };
                if (a.kind == IA_OP_MEM & b.kind == IA_OP_REG & c.kind == IA_OP_NONE)
                {
                    -> ia_vx_emit(cx, ib, map, pp, w, 0, opc, ia_regnum(b.reg), 0, a, false, 0);
                };
                if (a.kind == IA_OP_REG & b.kind == IA_OP_MEM & c.kind == IA_OP_NONE)
                {
                    -> ia_vx_emit(cx, ib, map, pp, w, 0, m.b, ia_regnum(a.reg), 0, b, false, 0);
                };
                -> ia_fail(cx, "bad vex operands\0");
            };
            if (form == IA_VF_MOVLP)
            {
                if (a.kind == IA_OP_MEM & b.kind == IA_OP_REG & c.kind == IA_OP_REG & d.kind == IA_OP_NONE)
                {
                    -> ia_vx_emit(cx, ib, map, pp, w, 0, opc, ia_regnum(c.reg), ia_regnum(b.reg), a, false, 0);
                };
                if (a.kind == IA_OP_REG & b.kind == IA_OP_MEM & c.kind == IA_OP_NONE)
                {
                    -> ia_vx_emit(cx, ib, map, pp, w, 0, m.b, ia_regnum(a.reg), 0, b, false, 0);
                };
                -> ia_fail(cx, "bad vex operands\0");
            };
            if (form == IA_VF_SHIFT)
            {
                if (ia_vx_imm_ok(a) & ia_vx_rm_ok(b) & c.kind == IA_OP_REG)
                {
                    -> ia_vx_emit(cx, ib, map, pp, w, l, m.b, m.c, ia_regnum(c.reg), b, true, a.val);
                };
                if (opc != 0 & ia_vx_rm_ok(a) & b.kind == IA_OP_REG & c.kind == IA_OP_REG)
                {
                    cx.ev_n16 = true;
                    -> ia_vx_emit(cx, ib, map, pp, w, l, opc, ia_regnum(c.reg), ia_regnum(b.reg), a, false, 0);
                };
                -> ia_fail(cx, "bad vex operands\0");
            };
            if (form == IA_VF_RMV)
            {
                if (!(a.kind == IA_OP_REG & ia_vx_rm_ok(b) & c.kind == IA_OP_REG)) { -> ia_fail(cx, "bad vex operands\0"); };
                if (ia_vx_reg64(c)) { w = 1; };
                -> ia_vx_emit(cx, ib, map, pp, w, 0, opc, ia_regnum(c.reg), ia_regnum(a.reg), b, false, 0);
            };
            if (form == IA_VF_NDD)
            {
                if (!(ia_vx_rm_ok(a) & b.kind == IA_OP_REG & c.kind == IA_OP_NONE)) { -> ia_fail(cx, "bad vex operands\0"); };
                if (ia_vx_reg64(b)) { w = 1; };
                -> ia_vx_emit(cx, ib, map, pp, w, 0, opc, m.c, ia_regnum(b.reg), a, false, 0);
            };
            if (form == IA_VF_MOVD)
            {
                if (ia_vx_vec(b) & ia_vx_rm_ok(a) & !ia_vx_vec(a))
                {
                    if (ia_vx_reg64(a)) { w = 1; };
                    -> ia_vx_emit(cx, ib, map, pp, w, 0, 0x6E, ia_regnum(b.reg), 0, a, false, 0);
                };
                if (ia_vx_vec(a) & ia_vx_rm_ok(b) & !ia_vx_vec(b))
                {
                    if (ia_vx_reg64(b)) { w = 1; };
                    -> ia_vx_emit(cx, ib, map, pp, w, 0, 0x7E, ia_regnum(a.reg), 0, b, false, 0);
                };
                -> ia_fail(cx, "bad vex operands\0");
            };
            if (form == IA_VF_MOVQ)
            {
                if (ia_vx_vec(b) & ia_vx_reg64(a))
                {
                    -> ia_vx_emit(cx, ib, map, pp, 1, 0, 0x6E, ia_regnum(b.reg), 0, a, false, 0);
                };
                if (ia_vx_vec(a) & ia_vx_reg64(b))
                {
                    -> ia_vx_emit(cx, ib, map, pp, 1, 0, 0x7E, ia_regnum(a.reg), 0, b, false, 0);
                };
                if (ia_vx_vec(a) & ia_vx_vec(b) & ia_regnum(a.reg) >= 8 & ia_regnum(b.reg) < 8 & !cx.ev)
                {
                    -> ia_vx_emit(cx, ib, map, pp, 0, 0, 0xD6, ia_regnum(a.reg), 0, b, false, 0);
                };
                if (ia_vx_vec(b) & (ia_vx_vec(a) | a.kind == IA_OP_MEM))
                {
                    -> ia_vx_emit(cx, ib, map, 2, 0, 0, 0x7E, ia_regnum(b.reg), 0, a, false, 0);
                };
                if (ia_vx_vec(a) & b.kind == IA_OP_MEM)
                {
                    -> ia_vx_emit(cx, ib, map, pp, 0, 0, 0xD6, ia_regnum(a.reg), 0, b, false, 0);
                };
                -> ia_fail(cx, "bad vex operands\0");
            };
            if (form == IA_VF_CVTI2F)
            {
                if (!(ia_vx_rm_ok(a) & b.kind == IA_OP_REG & c.kind == IA_OP_REG & d.kind == IA_OP_NONE)) { -> ia_fail(cx, "bad vex operands\0"); };
                if (m.c == 2) { w = 1; };
                if (m.c == 0 & ia_vx_reg64(a)) { w = 1; };
                -> ia_vx_emit(cx, ib, map, pp, w, 0, opc, ia_regnum(c.reg), ia_regnum(b.reg), a, false, 0);
            };
            if (form == IA_VF_MRI)
            {
                if (!(ia_vx_imm_ok(a) & ia_vx_vec(b) & ia_vx_rm_ok(c) & d.kind == IA_OP_NONE)) { -> ia_fail(cx, "bad vex operands\0"); };
                if (opc == 0x15 & c.kind == IA_OP_REG)
                {
                    // vpextrw to a register has its own shorter encoding
                    -> ia_vx_emit(cx, ib, 1, 1, 0, 0, 0xC5, ia_regnum(c.reg), 0, b, true, a.val);
                };
                -> ia_vx_emit(cx, ib, map, pp, w, l, opc, ia_regnum(b.reg), 0, c, true, a.val);
            };
            -> ia_fail(cx, "unsupported vex form\0");
        };

        // movbe: byte swapping load (0F 38 F0) and store (0F 38 F1)
        ia_enc_movbe(IasmCtx* cx, Mn* m, Operand* a, Operand* b, Ib* ib) -> bool
        {
            int sz = ia_opsize(m.sz, a, b);
            if (sz == 0 | sz == 8) { -> ia_fail(cx, "bad operands\0"); };
            if (a.kind == IA_OP_REG & (b.kind == IA_OP_MEM | b.kind == IA_OP_SYM))
            {
                -> ia_emit(cx, ib, sz == 16, 0, sz == 64, false, 3, 0x0F `| (0x38 << 8) `| (0xF1 << 16), ia_regnum(a.reg), b, 0, 0, (Operand*)0);
            };
            if (b.kind == IA_OP_REG & (a.kind == IA_OP_MEM | a.kind == IA_OP_SYM))
            {
                -> ia_emit(cx, ib, sz == 16, 0, sz == 64, false, 3, 0x0F `| (0x38 << 8) `| (0xF0 << 16), ia_regnum(b.reg), a, 0, 0, (Operand*)0);
            };
            -> ia_fail(cx, "bad operands\0");
        };

        // bsf, bsr, popcnt, tzcnt, lzcnt: m.a is the 0F-map opcode and m.b the mandatory prefix
        ia_enc_bscan(IasmCtx* cx, Mn* m, Operand* a, Operand* b, Ib* ib) -> bool
        {
            int sz = ia_opsize(m.sz, a, b);
            if (sz == 0 | sz == 8 | b.kind != IA_OP_REG) { -> ia_fail(cx, "bad operands\0"); };
            if (a.kind != IA_OP_REG & a.kind != IA_OP_MEM & a.kind != IA_OP_SYM) { -> ia_fail(cx, "bad operands\0"); };
            -> ia_emit(cx, ib, sz == 16, m.b, sz == 64, false, 2, 0x0F `| (m.a << 8), ia_regnum(b.reg), a, 0, 0, (Operand*)0);
        };

        ia_sg_x(Operand* o) -> bool
        {
            if (o.kind != IA_OP_REG) { -> false; };
            -> ia_regcls(o.reg) == IA_RC_XMM;
        };

        ia_sg_rm(Operand* o) -> bool
        {
            if (o.kind == IA_OP_MEM | o.kind == IA_OP_SYM) { -> true; };
            -> ia_sg_x(o);
        };

        // Generic legacy SSE encoder. m.sz low byte: form, bits 8 and up: opcode byte count
        // forms: 0 rm,xmm  1 imm,rm,xmm  2 blendv  3 extract  4 insert  5 shift (rm or imm)  6 shift by imm only
        ia_enc_sseg(IasmCtx* cx, Mn* m, Operand* a, Operand* b, Operand* c, Ib* ib) -> bool
        {
            int form = m.sz `& 255;
            int opn = m.sz >> 8;
            bool p66 = m.c == -1;
            int pfx = m.b;
            int pf = 0;
            bool w = false;
            Operand* d = @cx.op4;
            int g;
            p66 = false;
            if (pfx == 0x66) { p66 = true; };
            if (pfx == 0xF2 | pfx == 0xF3) { pf = pfx; };
            if (form == 0)
            {
                if (!(ia_sg_rm(a) & ia_sg_x(b) & c.kind == IA_OP_NONE)) { -> ia_fail(cx, "bad sse operands\0"); };
                -> ia_emit(cx, ib, p66, pf, false, false, opn, m.a, ia_regnum(b.reg), a, 0, 0, (Operand*)0);
            };
            if (form == 1)
            {
                if (!(ia_vx_imm_ok(a) & ia_sg_rm(b) & ia_sg_x(c) & d.kind == IA_OP_NONE)) { -> ia_fail(cx, "bad sse operands\0"); };
                -> ia_emit(cx, ib, p66, pf, false, false, opn, m.a, ia_regnum(c.reg), b, 1, a.val, (Operand*)0);
            };
            if (form == 2)
            {
                if (ia_sg_x(a) & ia_regnum(a.reg) == 0 & ia_sg_rm(b) & ia_sg_x(c) & d.kind == IA_OP_NONE)
                {
                    -> ia_emit(cx, ib, p66, pf, false, false, opn, m.a, ia_regnum(c.reg), b, 0, 0, (Operand*)0);
                };
                if (ia_sg_rm(a) & ia_sg_x(b) & c.kind == IA_OP_NONE)
                {
                    -> ia_emit(cx, ib, p66, pf, false, false, opn, m.a, ia_regnum(b.reg), a, 0, 0, (Operand*)0);
                };
                -> ia_fail(cx, "bad sse operands\0");
            };
            if (form == 3)
            {
                if (!(ia_vx_imm_ok(a) & ia_sg_x(b) & (c.kind == IA_OP_MEM | c.kind == IA_OP_SYM | ia_is_gpr(c.reg)) & d.kind == IA_OP_NONE)) { -> ia_fail(cx, "bad sse operands\0"); };
                if (m.c == 0x0FC5 & c.kind == IA_OP_REG)
                {
                    -> ia_emit(cx, ib, true, 0, false, false, 2, 0xC50F, ia_regnum(c.reg), b, 1, a.val, (Operand*)0);
                };
                if (m.c == 1) { w = true; };
                -> ia_emit(cx, ib, true, 0, w, false, opn, m.a, ia_regnum(b.reg), c, 1, a.val, (Operand*)0);
            };
            if (form == 4)
            {
                if (!(ia_vx_imm_ok(a) & (b.kind == IA_OP_MEM | b.kind == IA_OP_SYM | (b.kind == IA_OP_REG & ia_is_gpr(b.reg))) & ia_sg_x(c) & d.kind == IA_OP_NONE)) { -> ia_fail(cx, "bad sse operands\0"); };
                if (m.c == 1) { w = true; };
                -> ia_emit(cx, ib, true, 0, w, false, opn, m.a, ia_regnum(c.reg), b, 1, a.val, (Operand*)0);
            };
            if (form == 5 | form == 6)
            {
                if (form == 5 & ia_sg_rm(a) & ia_sg_x(b) & c.kind == IA_OP_NONE)
                {
                    -> ia_emit(cx, ib, p66, pf, false, false, opn, m.a, ia_regnum(b.reg), a, 0, 0, (Operand*)0);
                };
                if (ia_vx_imm_ok(a) & ia_sg_x(b) & c.kind == IA_OP_NONE)
                {
                    g = (m.c >> 16) `& 7;
                    -> ia_emit(cx, ib, p66, pf, false, false, 2, m.c `& 65535, g, b, 1, a.val, (Operand*)0);
                };
                -> ia_fail(cx, "bad sse operands\0");
            };
            -> ia_fail(cx, "bad sse operands\0");
        };

        // crc32: F2 [REX.W] 0F 38 F0 (byte source) or F1, the destination is a 32 or 64 bit register
        ia_enc_crc32(IasmCtx* cx, Mn* m, Operand* a, Operand* b, Ib* ib) -> bool
        {
            int sz = m.sz;
            int dsz;
            int opc = 0xF1;
            bool p66 = false;
            if (b.kind != IA_OP_REG | !ia_is_gpr(b.reg)) { -> ia_fail(cx, "bad crc32 operands\0"); };
            dsz = ia_regbits(b.reg);
            if (sz == 0 & a.kind == IA_OP_REG) { sz = ia_regbits(a.reg); };
            if (sz == 0) { -> ia_fail(cx, "ambiguous crc32 size\0"); };
            if (sz == 8) { opc = 0xF0; };
            if (sz == 16) { p66 = true; };
            -> ia_emit(cx, ib, p66, 0xF2, dsz == 64, ia_rex8(a.reg) & a.kind == IA_OP_REG & sz == 8, 3, 0x0F `| (0x38 << 8) `| (opc << 16), ia_regnum(b.reg), a, 0, 0, (Operand*)0);
        };

        // memory (or register) only group instructions: m.a opcode bytes, m.b the /n field
        // m.sz: low byte opcode byte count, 0x100 W, 0x200 66, 0x400 F3, 0x800 register allowed, 0x1000 register only, 0x2000 size from the register
        ia_enc_memx(IasmCtx* cx, Mn* m, Operand* a, Ib* ib) -> bool
        {
            int opn = m.sz `& 255;
            bool w = (m.sz `& 0x100) != 0;
            bool p66 = (m.sz `& 0x200) != 0;
            int pf = 0;
            int sz = m.c;
            bool isreg = a.kind == IA_OP_REG;
            if ((m.sz `& 0x400) != 0) { pf = 0xF3; };
            if ((m.sz `& 0x2000) != 0 & isreg) { sz = ia_regbits(a.reg); };
            if (sz == 64) { w = true; };
            if (sz == 16 & isreg & (m.sz `& 0x4000) != 0) { p66 = true; };
            if (isreg & (m.sz `& 0x1800) == 0) { -> ia_fail(cx, "bad operand\0"); };
            if (!isreg & (m.sz `& 0x1000) != 0) { -> ia_fail(cx, "bad operand\0"); };
            if (isreg & !ia_is_gpr(a.reg)) { -> ia_fail(cx, "bad operand\0"); };
            if (a.kind != IA_OP_MEM & a.kind != IA_OP_SYM & !isreg) { -> ia_fail(cx, "bad operand\0"); };
            -> ia_emit(cx, ib, p66, pf, w, isreg & ia_rex8(a.reg), opn, m.a, m.b, a, 0, 0, (Operand*)0);
        };

        // shld and shrd: count (immediate or %cl), source register, destination r/m
        ia_enc_shld(IasmCtx* cx, Mn* m, Operand* a, Operand* b, Operand* c, Ib* ib) -> bool
        {
            Operand* src = b;
            Operand* dst = c;
            Operand* cnt = a;
            int sz;
            bool imm = false;
            if (c.kind == IA_OP_NONE)
            {
                // two operands: the count is %cl
                src = a; dst = b; cnt = (Operand*)0;
            }
            else
            {
                if (a.kind == IA_OP_IMM) { imm = true; }
                else
                {
                    if (!(a.kind == IA_OP_REG & ia_regcls(a.reg) == IA_RC_R8 & ia_regnum(a.reg) == 1)) { -> ia_fail(cx, "bad shld count\0"); };
                };
            };
            if (src.kind != IA_OP_REG | !ia_is_gpr(src.reg)) { -> ia_fail(cx, "bad shld operands\0"); };
            sz = ia_opsize(m.sz, src, dst);
            if (sz == 0 | sz == 8) { -> ia_fail(cx, "bad shld operands\0"); };
            if (imm) { -> ia_emit(cx, ib, sz == 16, 0, sz == 64, false, 2, 0x0F `| (m.a << 8), ia_regnum(src.reg), dst, 1, cnt.val, (Operand*)0); };
            -> ia_emit(cx, ib, sz == 16, 0, sz == 64, false, 2, 0x0F `| ((m.a + 1) << 8), ia_regnum(src.reg), dst, 0, 0, (Operand*)0);
        };

        ia_enc_movdir64b(IasmCtx* cx, Operand* a, Operand* b, Ib* ib) -> bool
        {
            if (!(a.kind == IA_OP_MEM | a.kind == IA_OP_SYM) | b.kind != IA_OP_REG | !ia_is_gpr(b.reg)) { -> ia_fail(cx, "bad operands\0"); };
            -> ia_emit(cx, ib, true, 0, false, false, 3, 0xF8380F, ia_regnum(b.reg), a, 0, 0, (Operand*)0);
        };

        // adcx, adox, movnti, movdiri, movdir64b. m.a is the prefix (66, F3) or 0x100 for a store with W from the size
        // for the load forms m.b is the opcode bytes and m.c the count; for movnti and movdiri the store form is used
        ia_enc_gprx(IasmCtx* cx, Mn* m, Operand* a, Operand* b, Ib* ib) -> bool
        {
            int sz = m.sz;
            bool p66 = false;
            int pf = 0;
            bool store = m.a == 0x100;
            bool w;
            int opn = m.c `& 15;
            int opc = m.b;
            if (ia_strlen(m.name) >= 9) { if (ia_eqn(m.name, 9, "movdir64b")) { -> ia_enc_movdir64b(cx, a, b, ib); }; };
            if (m.a == 0x66) { p66 = true; };
            if (m.a == 0xF3) { pf = 0xF3; };
            if (store)
            {
                if (a.kind != IA_OP_REG | !ia_is_gpr(a.reg) | !(b.kind == IA_OP_MEM | b.kind == IA_OP_SYM)) { -> ia_fail(cx, "bad operands\0"); };
                sz = ia_opsize(sz, a, b);
                -> ia_emit(cx, ib, false, 0, sz == 64, false, opn, opc, ia_regnum(a.reg), b, 0, 0, (Operand*)0);
            };
            if (b.kind != IA_OP_REG | !ia_is_gpr(b.reg)) { -> ia_fail(cx, "bad operands\0"); };
            sz = ia_opsize(sz, a, b);
            if (sz != 32 & sz != 64) { -> ia_fail(cx, "bad operands\0"); };
            -> ia_emit(cx, ib, p66, pf, sz == 64, false, opn, opc, ia_regnum(b.reg), a, 0, 0, (Operand*)0);
        };

        // int, xabort and enter: immediates only
        ia_enc_immop(IasmCtx* cx, Mn* m, Operand* a, Operand* b, Ib* ib) -> bool
        {
            int k = 0;
            if (a.kind != IA_OP_IMM) { -> ia_fail(cx, "bad operands\0"); };
            if (m.a == 0xCD & a.val == 3 & b.kind == IA_OP_NONE) { ib_put(ib, 0xCC); -> true; };
            while (k < m.b) { ib_put(ib, (m.a >> (8 * k)) `& 255); k++; };
            if (m.sz == 2)
            {
                if (b.kind != IA_OP_IMM) { -> ia_fail(cx, "bad operands\0"); };
                ib_put(ib, (a.val `& 255));
                ib_put(ib, ((a.val >> 8) `& 255));
                ib_put(ib, (b.val `& 255));
                -> true;
            };
            ib_put(ib, (a.val `& 255));
            -> true;
        };

        ia_x87_st(Operand* o) -> bool
        {
            if (o.kind != IA_OP_REG) { -> false; };
            -> ia_regcls(o.reg) == IA_RC_ST;
        };

        // x87 register arithmetic and compares. sz selects the family (see the registrations)
        ia_enc_x87op(IasmCtx* cx, Mn* m, Operand* a, Operand* b, Ib* ib) -> bool
        {
            int i = 1;
            int f = m.sz;
            if (f == 1 | f == 2)
            {
                if (a.kind == IA_OP_NONE)
                {
                    ib_put(ib, 0xDE); ib_put(ib, m.a + 1);
                    -> true;
                };
                if (f == 2)
                {
                    if (!(ia_x87_st(a) & ia_x87_st(b) & ia_regnum(a.reg) == 0)) { -> ia_fail(cx, "bad x87 operands\0"); };
                    ib_put(ib, 0xDE); ib_put(ib, m.a + ia_regnum(b.reg));
                    -> true;
                };
                if (b.kind == IA_OP_NONE & ia_x87_st(a)) { ib_put(ib, 0xD8); ib_put(ib, m.a + ia_regnum(a.reg)); -> true; };
                if (!(ia_x87_st(a) & ia_x87_st(b))) { -> ia_fail(cx, "bad x87 operands\0"); };
                if (ia_regnum(b.reg) == 0) { ib_put(ib, 0xD8); ib_put(ib, m.a + ia_regnum(a.reg)); -> true; };
                if (ia_regnum(a.reg) == 0) { ib_put(ib, 0xDC); ib_put(ib, m.a + ia_regnum(b.reg)); -> true; };
                -> ia_fail(cx, "bad x87 operands\0");
            };
            if (f == 3)
            {
                if (a.kind != IA_OP_NONE)
                {
                    if (!ia_x87_st(a)) { -> ia_fail(cx, "bad x87 operands\0"); };
                    i = ia_regnum(a.reg);
                    if (b.kind != IA_OP_NONE)
                    {
                        if (m.c == 0 | !ia_x87_st(b) | ia_regnum(b.reg) != 0) { -> ia_fail(cx, "bad x87 operands\0"); };
                    };
                };
                ib_put(ib, m.a); ib_put(ib, m.b + i);
                -> true;
            };
            if (f == 4)
            {
                if (!ia_x87_st(a)) { -> ia_fail(cx, "bad x87 operands\0"); };
                ib_put(ib, m.a); ib_put(ib, m.b + ia_regnum(a.reg));
                -> true;
            };
            if (f == 5)
            {
                if (!(ia_x87_st(a) & ia_x87_st(b) & ia_regnum(b.reg) == 0)) { -> ia_fail(cx, "bad x87 operands\0"); };
                ib_put(ib, m.a); ib_put(ib, m.b + ia_regnum(a.reg));
                -> true;
            };
            if (f == 6)
            {
                if (m.a == 1) { ib_put(ib, 0x9B); };
                if (a.kind == IA_OP_REG & ia_regcls(a.reg) == IA_RC_R16 & ia_regnum(a.reg) == 0)
                {
                    ib_put(ib, 0xDF); ib_put(ib, 0xE0);
                    -> true;
                };
                if (a.kind == IA_OP_MEM | a.kind == IA_OP_SYM)
                {
                    -> ia_emit(cx, ib, false, 0, false, false, 1, 0xDD, 7, a, 0, 0, (Operand*)0);
                };
                -> ia_fail(cx, "bad x87 operands\0");
            };
            -> ia_fail(cx, "bad x87 operands\0");
        };

        // SSE4a extrq and insertq: m.a 0 is extrq (66 prefix) and 1 is insertq (F2 prefix)
        ia_enc_sse4a(IasmCtx* cx, Mn* m, Operand* a, Operand* b, Operand* c, Ib* ib) -> bool
        {
            Operand* d = @cx.op4;
            int pf = 0x66;
            if (m.a == 1) { pf = 0xF2; };
            if (a.kind == IA_OP_REG & b.kind == IA_OP_REG & c.kind == IA_OP_NONE & ia_regcls(a.reg) == IA_RC_XMM & ia_regcls(b.reg) == IA_RC_XMM)
            {
                -> ia_emit(cx, ib, false, pf, false, false, 2, 0x0F `| (0x79 << 8), ia_regnum(b.reg), a, 0, 0, (Operand*)0);
            };
            if (m.a == 0 & ia_vx_imm_ok(a) & ia_vx_imm_ok(b) & c.kind == IA_OP_REG & d.kind == IA_OP_NONE & ia_regcls(c.reg) == IA_RC_XMM)
            {
                if (!ia_emit(cx, ib, false, pf, false, false, 2, 0x0F `| (0x78 << 8), 0, c, 0, 0, (Operand*)0)) { -> false; };
                ib_put(ib, (b.val `& 255));
                ib_put(ib, (a.val `& 255));
                -> true;
            };
            if (m.a == 1 & ia_vx_imm_ok(a) & ia_vx_imm_ok(b) & c.kind == IA_OP_REG & d.kind == IA_OP_REG & ia_regcls(c.reg) == IA_RC_XMM & ia_regcls(d.reg) == IA_RC_XMM)
            {
                if (!ia_emit(cx, ib, false, pf, false, false, 2, 0x0F `| (0x78 << 8), ia_regnum(d.reg), c, 0, 0, (Operand*)0)) { -> false; };
                ib_put(ib, (b.val `& 255));
                ib_put(ib, (a.val `& 255));
                -> true;
            };
            -> ia_fail(cx, "bad operands\0");
        };

        ia_enc_rmw(IasmCtx* cx, Mn* m, Operand* a, Operand* b, Ib* ib) -> bool
        {
            int sz = ia_opsize(m.sz, a, b);
            int opc = m.a;
            bool r8 = false;
            if (a.kind != IA_OP_REG | sz == 0) { -> ia_fail(cx, "bad operands\0"); };
            r8 = ia_rex8(a.reg) | (b.kind == IA_OP_REG & ia_rex8(b.reg));
            if (sz != 8) { opc = opc + 0x100; };
            -> ia_emit(cx, ib, sz == 16, 0, sz == 64, r8, 2, opc, ia_regnum(a.reg), b, 0, 0, (Operand*)0);
        };

        // Accumulator immediate forms: [66] [REX.W] opcode imm
        ia_emit_acc(Ib* ib, bool p66, bool w, int opc, int immn, Operand* a, int op) -> bool
        {
            if (p66) { ib_put(ib, 0x66); };
            if (w) { ib_put(ib, 0x48); };
            ib_put(ib, opc);
            if (a.sym != 0)
            {
                if (immn == 4) { ib_fix(ib, ib.n, IA_FX_ABS32S, a.val, a.sym); }
                else
                {
                    if (immn == 2) { ib_fix(ib, ib.n, IA_FX_ABS16, a.val, a.sym); }
                    else { ib_fix(ib, ib.n, IA_FX_ABS8, a.val, a.sym); };
                };
                if (immn == 1) { ib_put(ib, 0); };
                if (immn == 2) { ib_put16(ib, 0); };
                if (immn == 4) { ib_put32(ib, 0); };
                -> true;
            };
            if (immn == 1) { ib_put(ib, (a.val `& 255)); };
            if (immn == 2) { ib_put16(ib, a.val); };
            if (immn == 4) { ib_put32(ib, a.val); };
            -> true;
        };

        ia_enc_alu(IasmCtx* cx, Mn* m, Operand* a, Operand* b, Ib* ib) -> bool
        {
            int sz = ia_opsize(m.sz, a, b);
            int op = m.a;
            bool w, p66;
            bool r8 = false;
            int base, immn;
            if (sz == 0) { -> ia_fail(cx, "ambiguous operand size\0"); };
            w = sz == 64;
            p66 = sz == 16;
            if (a.kind == IA_OP_IMM)
            {
                if (b.kind != IA_OP_REG & b.kind != IA_OP_MEM) { -> ia_fail(cx, "bad operands\0"); };
                r8 = b.kind == IA_OP_REG & ia_rex8(b.reg);
                immn = 4;
                if (sz == 8) { immn = 1; };
                if (sz == 16) { immn = 2; };
                if (sz == 8)
                {
                    if (ia_is_acc(b)) { -> ia_emit_acc(ib, p66, w, 0x04 + 8 * op, 1, a, op); };
                    -> ia_emit(cx, ib, false, 0, false, r8, 1, 0x80, op, b, 1, a.val, a);
                };
                if (a.sym == 0 & ia_fits8(a.val))
                {
                    -> ia_emit(cx, ib, p66, 0, w, r8, 1, 0x83, op, b, 1, a.val, a);
                };
                if (ia_is_acc(b))
                {
                    -> ia_emit_acc(ib, p66, w, 0x05 + 8 * op, immn, a, op);
                };
                -> ia_emit(cx, ib, p66, 0, w, r8, 1, 0x81, op, b, immn, a.val, a);
            };
            if (a.kind == IA_OP_REG)
            {
                // register source: MR form, reg field = source
                r8 = ia_rex8(a.reg) | (b.kind == IA_OP_REG & ia_rex8(b.reg));
                base = 1;
                if (sz == 8) { base = 0; };
                -> ia_emit(cx, ib, p66, 0, w, r8, 1, 8 * op + base, ia_regnum(a.reg), b, 0, 0, (Operand*)0);
            };
            if (a.kind == IA_OP_MEM & b.kind == IA_OP_REG)
            {
                r8 = ia_rex8(b.reg);
                base = 3;
                if (sz == 8) { base = 2; };
                -> ia_emit(cx, ib, p66, 0, w, r8, 1, 8 * op + base, ia_regnum(b.reg), a, 0, 0, (Operand*)0);
            };
            -> ia_fail(cx, "bad operands\0");
        };

        ia_enc_mov(IasmCtx* cx, Mn* m, Operand* a, Operand* b, Ib* ib) -> bool
        {
            int sz = ia_opsize(m.sz, a, b);
            bool w, p66;
            bool r8 = false;
            int immn;
            Operand t;
            if ((a.kind == IA_OP_REG & ia_regcls(a.reg) == IA_RC_XMM) | (b.kind == IA_OP_REG & ia_regcls(b.reg) == IA_RC_XMM))
            {
                -> ia_enc_movd(cx, m, a, b, ib, true);
            };
            if (a.kind == IA_OP_REG & ia_regcls(a.reg) == IA_RC_SEG)
            {
                // mov %seg, r/m: 8C /r, 16 bit store to memory, the register forms follow the register width
                if (!(b.kind == IA_OP_MEM | b.kind == IA_OP_SYM | (b.kind == IA_OP_REG & ia_is_gpr(b.reg)))) { -> ia_fail(cx, "bad mov operands\0"); };
                if (b.kind == IA_OP_REG) { sz = ia_regbits(b.reg); } else { sz = 0; };
                -> ia_emit(cx, ib, sz == 16, 0, sz == 64, false, 1, 0x8C, ia_regnum(a.reg), b, 0, 0, (Operand*)0);
            };
            if (b.kind == IA_OP_REG & ia_regcls(b.reg) == IA_RC_SEG)
            {
                // mov r/m, %seg: 8E /r
                if (!(a.kind == IA_OP_MEM | a.kind == IA_OP_SYM | (a.kind == IA_OP_REG & ia_is_gpr(a.reg)))) { -> ia_fail(cx, "bad mov operands\0"); };
                sz = 0;
                if (a.kind == IA_OP_REG) { sz = ia_regbits(a.reg); };
                -> ia_emit(cx, ib, false, 0, sz == 64, false, 1, 0x8E, ia_regnum(b.reg), a, 0, 0, (Operand*)0);
            };
            if (sz == 0) { -> ia_fail(cx, "ambiguous operand size\0"); };
            w = sz == 64;
            p66 = sz == 16;
            if (a.kind == IA_OP_IMM)
            {
                immn = 4;
                if (sz == 8) { immn = 1; };
                if (sz == 16) { immn = 2; };
                if (b.kind == IA_OP_REG)
                {
                    if (sz == 64)
                    {
                        // movq $imm32, %reg: sign extended C7 /0
                        -> ia_emit(cx, ib, false, 0, true, false, 1, 0xC7, 0, b, 4, a.val, a);
                    };
                    if (p66) { ib_put(ib, 0x66); };
                    if (sz == 8)
                    {
                        ia_emit_oreg(ib, false, false, 1, 0xB0, b.reg);
                        ib_put(ib, (a.val `& 255));
                        -> true;
                    };
                    ia_emit_oreg(ib, false, false, 1, 0xB8, b.reg);
                    if (a.sym != 0)
                    {
                        ib_fix(ib, ib.n, IA_FX_ABS32, a.val, a.sym);
                        ib_put32(ib, 0);
                        -> true;
                    };
                    if (sz == 16) { ib_put16(ib, a.val); } else { ib_put32(ib, a.val); };
                    -> true;
                };
                if (b.kind == IA_OP_MEM)
                {
                    if (sz == 8) { -> ia_emit(cx, ib, false, 0, false, false, 1, 0xC6, 0, b, 1, a.val, a); };
                    -> ia_emit(cx, ib, p66, 0, w, false, 1, 0xC7, 0, b, immn, a.val, a);
                };
                -> ia_fail(cx, "bad operands\0");
            };
            if (a.kind == IA_OP_REG)
            {
                r8 = ia_rex8(a.reg) | (b.kind == IA_OP_REG & ia_rex8(b.reg));
                if (sz == 8) { -> ia_emit(cx, ib, false, 0, false, r8, 1, 0x88, ia_regnum(a.reg), b, 0, 0, (Operand*)0); };
                -> ia_emit(cx, ib, p66, 0, w, false, 1, 0x89, ia_regnum(a.reg), b, 0, 0, (Operand*)0);
            };
            if (a.kind == IA_OP_MEM & b.kind == IA_OP_REG)
            {
                r8 = ia_rex8(b.reg);
                if (sz == 8) { -> ia_emit(cx, ib, false, 0, false, r8, 1, 0x8A, ia_regnum(b.reg), a, 0, 0, (Operand*)0); };
                -> ia_emit(cx, ib, p66, 0, w, false, 1, 0x8B, ia_regnum(b.reg), a, 0, 0, (Operand*)0);
            };
            -> ia_fail(cx, "bad operands\0");
        };

        ia_enc_movabs(IasmCtx* cx, Mn* m, Operand* a, Operand* b, Ib* ib) -> bool
        {
            if (a.kind != IA_OP_IMM | b.kind != IA_OP_REG) { -> ia_fail(cx, "bad movabs operands\0"); };
            ia_emit_oreg(ib, false, true, 1, 0xB8, b.reg);
            if (a.sym != 0)
            {
                ib_fix(ib, ib.n, IA_FX_ABS64, a.val, a.sym);
                ib_put64(ib, 0);
                -> true;
            };
            ib_put64(ib, a.val);
            -> true;
        };

        ia_enc_lea(IasmCtx* cx, Mn* m, Operand* a, Operand* b, Ib* ib) -> bool
        {
            int sz = ia_opsize(m.sz, a, b);
            if (b.kind != IA_OP_REG | (a.kind != IA_OP_MEM & a.kind != IA_OP_SYM)) { -> ia_fail(cx, "bad lea operands\0"); };
            if (sz == 0) { -> ia_fail(cx, "ambiguous operand size\0"); };
            -> ia_emit(cx, ib, sz == 16, 0, sz == 64, false, 1, 0x8D, ia_regnum(b.reg), a, 0, 0, (Operand*)0);
        };

        ia_enc_test(IasmCtx* cx, Mn* m, Operand* a, Operand* b, Ib* ib) -> bool
        {
            int sz = ia_opsize(m.sz, a, b);
            bool w, p66;
            bool r8 = false;
            int immn;
            Operand* rm, rg;
            if (sz == 0) { -> ia_fail(cx, "ambiguous operand size\0"); };
            w = sz == 64;
            p66 = sz == 16;
            if (a.kind == IA_OP_IMM)
            {
                immn = 4;
                if (sz == 8) { immn = 1; };
                if (sz == 16) { immn = 2; };
                if (ia_is_acc(b))
                {
                    if (sz == 8) { -> ia_emit_acc(ib, false, false, 0xA8, 1, a, 0); };
                    -> ia_emit_acc(ib, p66, w, 0xA9, immn, a, 0);
                };
                r8 = b.kind == IA_OP_REG & ia_rex8(b.reg);
                if (sz == 8) { -> ia_emit(cx, ib, false, 0, false, r8, 1, 0xF6, 0, b, 1, a.val, a); };
                -> ia_emit(cx, ib, p66, 0, w, r8, 1, 0xF7, 0, b, immn, a.val, a);
            };
            // test reg, r/m : reg field is the register operand
            if (a.kind == IA_OP_REG) { rg = a; rm = b; }
            else { rg = b; rm = a; };
            if (rg.kind != IA_OP_REG) { -> ia_fail(cx, "bad test operands\0"); };
            r8 = ia_rex8(rg.reg) | (rm.kind == IA_OP_REG & ia_rex8(rm.reg));
            if (sz == 8) { -> ia_emit(cx, ib, false, 0, false, r8, 1, 0x84, ia_regnum(rg.reg), rm, 0, 0, (Operand*)0); };
            -> ia_emit(cx, ib, p66, 0, w, false, 1, 0x85, ia_regnum(rg.reg), rm, 0, 0, (Operand*)0);
        };

        ia_enc_unary(IasmCtx* cx, Mn* m, Operand* a, Ib* ib) -> bool
        {
            int sz = m.sz;
            bool r8 = false;
            if (sz == 0 & a.kind == IA_OP_REG) { sz = ia_regbits(a.reg); };
            if (sz == 0) { -> ia_fail(cx, "ambiguous operand size\0"); };
            if (a.kind != IA_OP_REG & a.kind != IA_OP_MEM) { -> ia_fail(cx, "bad operand\0"); };
            r8 = a.kind == IA_OP_REG & ia_rex8(a.reg);
            if (m.kind == IA_K_INCDEC)
            {
                if (sz == 8) { -> ia_emit(cx, ib, false, 0, false, r8, 1, 0xFE, m.a, a, 0, 0, (Operand*)0); };
                -> ia_emit(cx, ib, sz == 16, 0, sz == 64, false, 1, 0xFF, m.a, a, 0, 0, (Operand*)0);
            };
            if (sz == 8) { -> ia_emit(cx, ib, false, 0, false, r8, 1, 0xF6, m.a, a, 0, 0, (Operand*)0); };
            -> ia_emit(cx, ib, sz == 16, 0, sz == 64, false, 1, 0xF7, m.a, a, 0, 0, (Operand*)0);
        };

        ia_enc_shift(IasmCtx* cx, Mn* m, Operand* a, Operand* b, Ib* ib) -> bool
        {
            int sz;
            bool r8 = false;
            Operand* dst;
            Operand one;
            // shl dst  : shift by one
            if (b.kind == IA_OP_NONE)
            {
                dst = a;
                sz = m.sz;
                if (sz == 0 & dst.kind == IA_OP_REG) { sz = ia_regbits(dst.reg); };
                if (sz == 0) { -> ia_fail(cx, "ambiguous operand size\0"); };
                r8 = dst.kind == IA_OP_REG & ia_rex8(dst.reg);
                if (sz == 8) { -> ia_emit(cx, ib, false, 0, false, r8, 1, 0xD0, m.a, dst, 0, 0, (Operand*)0); };
                -> ia_emit(cx, ib, sz == 16, 0, sz == 64, false, 1, 0xD1, m.a, dst, 0, 0, (Operand*)0);
            };
            dst = b;
            sz = m.sz;
            if (sz == 0 & dst.kind == IA_OP_REG) { sz = ia_regbits(dst.reg); };
            if (sz == 0) { -> ia_fail(cx, "ambiguous operand size\0"); };
            r8 = dst.kind == IA_OP_REG & ia_rex8(dst.reg);
            if (a.kind == IA_OP_REG)
            {
                // count in %cl
                if (a.reg != IA_RC_R8 * 32 + 1) { -> ia_fail(cx, "shift count must be %cl\0"); };
                if (sz == 8) { -> ia_emit(cx, ib, false, 0, false, r8, 1, 0xD2, m.a, dst, 0, 0, (Operand*)0); };
                -> ia_emit(cx, ib, sz == 16, 0, sz == 64, false, 1, 0xD3, m.a, dst, 0, 0, (Operand*)0);
            };
            if (a.kind == IA_OP_IMM)
            {
                if (a.val == 1)
                {
                    if (sz == 8) { -> ia_emit(cx, ib, false, 0, false, r8, 1, 0xD0, m.a, dst, 0, 0, (Operand*)0); };
                    -> ia_emit(cx, ib, sz == 16, 0, sz == 64, false, 1, 0xD1, m.a, dst, 0, 0, (Operand*)0);
                };
                if (sz == 8) { -> ia_emit(cx, ib, false, 0, false, r8, 1, 0xC0, m.a, dst, 1, a.val, (Operand*)0); };
                -> ia_emit(cx, ib, sz == 16, 0, sz == 64, false, 1, 0xC1, m.a, dst, 1, a.val, (Operand*)0);
            };
            -> ia_fail(cx, "bad shift operands\0");
        };

        ia_enc_push_pop(IasmCtx* cx, Mn* m, Operand* a, Ib* ib) -> bool
        {
            bool is_push = m.kind == IA_K_PUSH;
            Operand r;
            if (a.kind == IA_OP_REG)
            {
                if (ia_regcls(a.reg) != IA_RC_R64 & ia_regcls(a.reg) != IA_RC_R16) { -> ia_fail(cx, "bad push or pop register\0"); };
                if (is_push) { ia_emit_oreg(ib, ia_regcls(a.reg) == IA_RC_R16, false, 1, 0x50, a.reg); }
                else { ia_emit_oreg(ib, ia_regcls(a.reg) == IA_RC_R16, false, 1, 0x58, a.reg); };
                -> true;
            };
            if (a.kind == IA_OP_IMM)
            {
                if (!is_push) { -> ia_fail(cx, "pop of an immediate\0"); };
                if (a.sym == 0 & ia_fits8(a.val))
                {
                    ib_put(ib, 0x6A);
                    ib_put(ib, (a.val `& 255));
                    -> true;
                };
                ib_put(ib, 0x68);
                if (a.sym != 0) { ib_fix(ib, ib.n, IA_FX_ABS32S, a.val, a.sym); ib_put32(ib, 0); }
                else { ib_put32(ib, a.val); };
                -> true;
            };
            if (a.kind == IA_OP_MEM)
            {
                if (is_push) { -> ia_emit(cx, ib, m.sz == 16, 0, false, false, 1, 0xFF, 6, a, 0, 0, (Operand*)0); };
                -> ia_emit(cx, ib, m.sz == 16, 0, false, false, 1, 0x8F, 0, a, 0, 0, (Operand*)0);
            };
            -> ia_fail(cx, "bad push or pop operand\0");
        };

        // call and jmp: a direct target becomes a rel32 with a fixup, *r/m is an indirect transfer
        ia_enc_branch(IasmCtx* cx, Mn* m, Operand* a, Ib* ib) -> bool
        {
            bool call = m.kind == IA_K_CALL;
            int fk;
            if (a.star)
            {
                if (a.kind != IA_OP_REG & a.kind != IA_OP_MEM) { -> ia_fail(cx, "bad indirect target\0"); };
                if (call) { -> ia_emit(cx, ib, false, 0, false, false, 1, 0xFF, 2, a, 0, 0, (Operand*)0); };
                -> ia_emit(cx, ib, false, 0, false, false, 1, 0xFF, 4, a, 0, 0, (Operand*)0);
            };
            if (a.kind == IA_OP_REG | a.kind == IA_OP_MEM)
            {
                // AT&T requires the star, but accept a register or memory form
                if (call) { -> ia_emit(cx, ib, false, 0, false, false, 1, 0xFF, 2, a, 0, 0, (Operand*)0); };
                -> ia_emit(cx, ib, false, 0, false, false, 1, 0xFF, 4, a, 0, 0, (Operand*)0);
            };
            if (a.kind != IA_OP_SYM) { -> ia_fail(cx, "bad branch target\0"); };
            ib.sym = a.sym;
            if (!call)
            {
                // short form first; relaxation widens it when the target is too far
                ib.br = 1;
                ib_put(ib, 0xEB);
                if (a.sym != 0) { ib_fix(ib, ib.n, IA_FX_BR8, a.val - 1, a.sym); };
                ib_put(ib, 0);
                -> true;
            };
            ib_put(ib, 0xE8);
            ib.br = 3;
            fk = IA_FX_PLT32;
            if (a.sym != 0) { ib_fix(ib, ib.n, fk, a.val - 4, a.sym); };
            ib_put32(ib, 0);
            -> true;
        };

        ia_enc_jcc(IasmCtx* cx, Mn* m, Operand* a, Ib* ib) -> bool
        {
            if (a.kind != IA_OP_SYM) { -> ia_fail(cx, "bad branch target\0"); };
            ib_put(ib, 0x70 + m.a);
            ib.br = 2;
            ib.brcc = m.a;
            ib.sym = a.sym;
            if (a.sym != 0) { ib_fix(ib, ib.n, IA_FX_BR8, a.val - 1, a.sym); };
            ib_put(ib, 0);
            -> true;
        };

        ia_enc_setcc(IasmCtx* cx, Mn* m, Operand* a, Ib* ib) -> bool
        {
            bool r8 = a.kind == IA_OP_REG & ia_rex8(a.reg);
            if (a.kind != IA_OP_REG & a.kind != IA_OP_MEM) { -> ia_fail(cx, "bad setcc operand\0"); };
            -> ia_emit(cx, ib, false, 0, false, r8, 2, 0x900F + (m.a << 8), 0, a, 0, 0, (Operand*)0);
        };

        ia_enc_cmov(IasmCtx* cx, Mn* m, Operand* a, Operand* b, Ib* ib) -> bool
        {
            int sz = ia_opsize(m.sz, a, b);
            if (b.kind != IA_OP_REG) { -> ia_fail(cx, "bad cmov operands\0"); };
            if (sz == 0) { -> ia_fail(cx, "ambiguous operand size\0"); };
            -> ia_emit(cx, ib, sz == 16, 0, sz == 64, false, 2, 0x400F + (m.a << 8), ia_regnum(b.reg), a, 0, 0, (Operand*)0);
        };

        ia_enc_movx(IasmCtx* cx, Mn* m, Operand* a, Operand* b, Ib* ib) -> bool
        {
            int opc;
            bool r8 = false;
            if (b.kind != IA_OP_REG) { -> ia_fail(cx, "bad movzx operands\0"); };
            r8 = (a.kind == IA_OP_REG & ia_rex8(a.reg)) | ia_rex8(b.reg);
            if (m.a == 32)
            {
                -> ia_emit(cx, ib, false, 0, true, false, 1, 0x63, ia_regnum(b.reg), a, 0, 0, (Operand*)0);
            };
            if (m.b == 1)
            {
                if (m.a == 8) { opc = 0xBE0F; } else { opc = 0xBF0F; };
            }
            else
            {
                if (m.a == 8) { opc = 0xB60F; } else { opc = 0xB70F; };
            };
            -> ia_emit(cx, ib, m.sz == 16, 0, m.sz == 64, r8, 2, opc, ia_regnum(b.reg), a, 0, 0, (Operand*)0);
        };

        ia_enc_imul(IasmCtx* cx, Mn* m, Operand* a, Operand* b, Operand* c, Ib* ib) -> bool
        {
            int sz;
            Mn u;
            Operand* src, dst;
            if (b.kind == IA_OP_NONE)
            {
                // one operand form: F7 /5
                sz = m.sz;
                if (sz == 0 & a.kind == IA_OP_REG) { sz = ia_regbits(a.reg); };
                if (sz == 0) { -> ia_fail(cx, "ambiguous operand size\0"); };
                if (sz == 8) { -> ia_emit(cx, ib, false, 0, false, a.kind == IA_OP_REG & ia_rex8(a.reg), 1, 0xF6, 5, a, 0, 0, (Operand*)0); };
                -> ia_emit(cx, ib, sz == 16, 0, sz == 64, false, 1, 0xF7, 5, a, 0, 0, (Operand*)0);
            };
            if (c.kind != IA_OP_NONE)
            {
                // imul $imm, src, dst
                src = b;
                dst = c;
                if (a.kind != IA_OP_IMM | dst.kind != IA_OP_REG) { -> ia_fail(cx, "bad imul operands\0"); };
            }
            else
            {
                if (a.kind == IA_OP_IMM)
                {
                    // imul $imm, dst : dst is also the source
                    dst = b;
                    src = b;
                }
                else
                {
                    // imul src, dst
                    sz = ia_opsize(m.sz, a, b);
                    if (b.kind != IA_OP_REG) { -> ia_fail(cx, "bad imul operands\0"); };
                    if (sz == 0) { -> ia_fail(cx, "ambiguous operand size\0"); };
                    -> ia_emit(cx, ib, sz == 16, 0, sz == 64, false, 2, 0xAF0F, ia_regnum(b.reg), a, 0, 0, (Operand*)0);
                };
            };
            sz = ia_opsize(m.sz, src, dst);
            if (sz == 0) { -> ia_fail(cx, "ambiguous operand size\0"); };
            if (a.sym == 0 & ia_fits8(a.val))
            {
                -> ia_emit(cx, ib, sz == 16, 0, sz == 64, false, 1, 0x6B, ia_regnum(dst.reg), src, 1, a.val, a);
            };
            if (sz == 16) { -> ia_emit(cx, ib, true, 0, false, false, 1, 0x69, ia_regnum(dst.reg), src, 2, a.val, a); };
            -> ia_emit(cx, ib, false, 0, sz == 64, false, 1, 0x69, ia_regnum(dst.reg), src, 4, a.val, a);
        };

        ia_enc_xchg(IasmCtx* cx, Mn* m, Operand* a, Operand* b, Ib* ib) -> bool
        {
            int sz = ia_opsize(m.sz, a, b);
            Operand* rg, rm;
            bool r8 = false;
            if (sz == 0) { -> ia_fail(cx, "ambiguous operand size\0"); };
            if (a.kind == IA_OP_REG & b.kind != IA_OP_REG) { rg = a; rm = b; } else { rg = b; rm = a; };
            if (rg.kind != IA_OP_REG) { -> ia_fail(cx, "bad xchg operands\0"); };
            r8 = ia_rex8(rg.reg) | (rm.kind == IA_OP_REG & ia_rex8(rm.reg));
            if (sz == 8) { -> ia_emit(cx, ib, false, 0, false, r8, 1, 0x86, ia_regnum(rg.reg), rm, 0, 0, (Operand*)0); };
            if (rm.kind == IA_OP_REG & ia_is_gpr(rg.reg) & ia_is_gpr(rm.reg) & ia_regnum(rg.reg) != ia_regnum(rm.reg))
            {
                // the short form with the accumulator: 90+r
                if (ia_regnum(rg.reg) == 0) { ia_emit_oreg(ib, sz == 16, sz == 64, 1, 0x90, rm.reg); -> true; };
                if (ia_regnum(rm.reg) == 0) { ia_emit_oreg(ib, sz == 16, sz == 64, 1, 0x90, rg.reg); -> true; };
            };
            -> ia_emit(cx, ib, sz == 16, 0, sz == 64, false, 1, 0x87, ia_regnum(rg.reg), rm, 0, 0, (Operand*)0);
        };

        ia_enc_bswap(IasmCtx* cx, Mn* m, Operand* a, Ib* ib) -> bool
        {
            if (a.kind != IA_OP_REG) { -> ia_fail(cx, "bad bswap operand\0"); };
            ia_emit_oreg(ib, false, m.sz == 64, 2, 0xC80F, a.reg);
            -> true;
        };

        ia_enc_bt(IasmCtx* cx, Mn* m, Operand* a, Operand* b, Ib* ib) -> bool
        {
            int sz = ia_opsize(m.sz, a, b);
            int opc;
            if (sz == 0) { -> ia_fail(cx, "ambiguous operand size\0"); };
            if (a.kind == IA_OP_IMM)
            {
                -> ia_emit(cx, ib, sz == 16, 0, sz == 64, false, 2, 0xBA0F, 4 + m.a, b, 1, a.val, (Operand*)0);
            };
            if (a.kind != IA_OP_REG) { -> ia_fail(cx, "bad bt operands\0"); };
            opc = 0xA30F;
            if (m.a == 1) { opc = 0xAB0F; };
            if (m.a == 2) { opc = 0xB30F; };
            if (m.a == 3) { opc = 0xBB0F; };
            -> ia_emit(cx, ib, sz == 16, 0, sz == 64, false, 2, opc, ia_regnum(a.reg), b, 0, 0, (Operand*)0);
        };

        ia_enc_noarg(Mn* m, Ib* ib) -> bool
        {
            int k = 0;
            while (k < m.b)
            {
                ib_put(ib, (m.a >> (8 * k)) `& 255);
                k++;
            };
            -> true;
        };

        // Encodes one instruction from its operands
        ia_encode_ops(IasmCtx* cx, Mn* m, Operand* a, Operand* b, Operand* c, Ib* ib) -> bool
        {
            switch (m.kind)
            {
                case (IA_K_ALU) { -> ia_enc_alu(cx, m, a, b, ib); }
                case (IA_K_MOV) { -> ia_enc_mov(cx, m, a, b, ib); }
                case (IA_K_MOVABS) { -> ia_enc_movabs(cx, m, a, b, ib); }
                case (IA_K_LEA) { -> ia_enc_lea(cx, m, a, b, ib); }
                case (IA_K_TEST) { -> ia_enc_test(cx, m, a, b, ib); }
                case (IA_K_UNARY) { -> ia_enc_unary(cx, m, a, ib); }
                case (IA_K_INCDEC) { -> ia_enc_unary(cx, m, a, ib); }
                case (IA_K_SHIFT) { -> ia_enc_shift(cx, m, a, b, ib); }
                case (IA_K_PUSH) { -> ia_enc_push_pop(cx, m, a, ib); }
                case (IA_K_POP) { -> ia_enc_push_pop(cx, m, a, ib); }
                case (IA_K_CALL) { -> ia_enc_branch(cx, m, a, ib); }
                case (IA_K_JMP) { -> ia_enc_branch(cx, m, a, ib); }
                case (IA_K_JCC) { -> ia_enc_jcc(cx, m, a, ib); }
                case (IA_K_SETCC) { -> ia_enc_setcc(cx, m, a, ib); }
                case (IA_K_CMOV) { -> ia_enc_cmov(cx, m, a, b, ib); }
                case (IA_K_MOVX) { -> ia_enc_movx(cx, m, a, b, ib); }
                case (IA_K_IMUL) { -> ia_enc_imul(cx, m, a, b, c, ib); }
                case (IA_K_XCHG) { -> ia_enc_xchg(cx, m, a, b, ib); }
                case (IA_K_BSWAP) { -> ia_enc_bswap(cx, m, a, ib); }
                case (IA_K_BT) { -> ia_enc_bt(cx, m, a, b, ib); }
                case (IA_K_SSE) { -> ia_enc_sse(cx, m, a, b, ib); }
                case (IA_K_CVTI2F) { -> ia_enc_cvti2f(cx, m, a, b, ib); }
                case (IA_K_CVTF2I) { -> ia_enc_cvtf2i(cx, m, a, b, ib); }
                case (IA_K_SSECMP) { -> ia_enc_ssecmp(cx, m, a, b, ib); }
                case (IA_K_MOVD) { -> ia_enc_movd(cx, m, a, b, ib, false); }
                case (IA_K_PREFETCH) { -> ia_enc_prefetch(cx, m, a, ib); }
                case (IA_K_X87) { -> ia_enc_x87(cx, m, a, ib); }
                case (IA_K_X87REG) { -> ia_enc_x87reg(cx, m, a, ib); }
                case (IA_K_VX) { -> ia_enc_vx(cx, m, a, b, c, ib); }
                case (IA_K_X87OP) { -> ia_enc_x87op(cx, m, a, b, ib); }
                case (IA_K_MEMX) { -> ia_enc_memx(cx, m, a, ib); }
                case (IA_K_SHLD) { -> ia_enc_shld(cx, m, a, b, c, ib); }
                case (IA_K_GPRX) { -> ia_enc_gprx(cx, m, a, b, ib); }
                case (IA_K_IMMOP) { -> ia_enc_immop(cx, m, a, b, ib); }
                case (IA_K_SSEG) { -> ia_enc_sseg(cx, m, a, b, c, ib); }
                case (IA_K_CRC32) { -> ia_enc_crc32(cx, m, a, b, ib); }
                case (IA_K_SSE4A) { -> ia_enc_sse4a(cx, m, a, b, c, ib); }
                case (IA_K_BSCAN) { -> ia_enc_bscan(cx, m, a, b, ib); }
                case (IA_K_RMW) { -> ia_enc_rmw(cx, m, a, b, ib); }
                case (IA_K_MOVBE) { -> ia_enc_movbe(cx, m, a, b, ib); }
                case (IA_K_NOARG) { -> ia_enc_noarg(m, ib); }
                default { -> ia_fail(cx, "unsupported instruction kind\0"); };
            };
        };

        // ===== LINE ENCODING =====

        // Splits the operand text of an instruction at top level commas and parses up to three operands.
        ia_parse_operands(IasmCtx* cx, byte* s, int n, Operand* a, Operand* b, Operand* c) -> bool
        {
            int i = 0;
            int st = 0;
            int depth = 0;
            int idx = 0;
            int e;
            bool inq = false;
            Operand* o;
            ia_op_clear(a);
            ia_op_clear(b);
            ia_op_clear(c);
            ia_op_clear(@cx.op4);
            cx.ev_rc = 0;
            while (i <= n)
            {
                if (i < n & s[i] == '"') { inq = !inq; };
                if (i < n & !inq & s[i] == '(') { depth++; };
                if (i < n & !inq & s[i] == ')') { depth--; };
                if (i == n | (!inq & depth == 0 & s[i] == ','))
                {
                    // trim [st, i)
                    e = i;
                    while (st < e & (s[st] == 32 | s[st] == 9)) { st++; };
                    while (e > st & (s[e - 1] == 32 | s[e - 1] == 9)) { e--; };
                    if (e > st & s[st] == '{')
                    {
                        // a rounding or exception control operand: {sae} {rn-sae} {rd-sae} {ru-sae} {rz-sae}
                        if (e - st == 5) { cx.ev_rc = 5; };
                        if (e - st == 8 & s[st + 1] == 'r')
                        {
                            if (s[st + 2] == 'n') { cx.ev_rc = 1; };
                            if (s[st + 2] == 'd') { cx.ev_rc = 2; };
                            if (s[st + 2] == 'u') { cx.ev_rc = 3; };
                            if (s[st + 2] == 'z') { cx.ev_rc = 4; };
                        };
                        if (cx.ev_rc == 0) { -> ia_fail(cx, "bad rounding control\0"); };
                        e = st;
                    };
                    if (e > st)
                    {
                        if (idx == 0) { o = a; };
                        if (idx == 1) { o = b; };
                        if (idx == 2) { o = c; };
                        if (idx == 3) { o = @cx.op4; };
                        if (idx > 3) { -> ia_fail(cx, "too many operands\0"); };
                        if (!ia_parse_operand(cx, s + st, e - st, o)) { -> false; };
                        idx++;
                    };
                    st = i + 1;
                };
                i++;
            };
            -> true;
        };

        // Encodes one instruction line ("mnemonic operands", no label, no directive)
        // A GOTPCREL reference in an instruction the linker may relax (a mov load, test,
        // an ALU op with a memory source, an indirect call or jmp) becomes GOTPCRELX, or
        // REX_GOTPCRELX when the instruction carries a REX prefix. lea and stores stay GOTPCREL.
        ia_relax_gotpcrel(Ib* ib) -> void
        {
            int k = 0;
            int p = 0;
            int op, bv;
            bool rex = false;
            bool relaxable = false;
            bool found = false;
            while (k < ib.nfx)
            {
                if (ib.fx[k].kind == IA_FX_GOTPCREL) { found = true; };
                k++;
            };
            if (!found) { ->; };
            while (p < ib.n)
            {
                bv = ib.b[p] `& 255;
                if (bv == 0x66 | bv == 0x67 | bv == 0xF2 | bv == 0xF3 | bv == 0x2E | bv == 0x3E | bv == 0x26 | bv == 0x36 | bv == 0x64 | bv == 0x65) { p++; } else { break; };
            };
            if (p < ib.n)
            {
                bv = ib.b[p] `& 255;
                if ((bv `& 0xF0) == 0x40) { rex = true; p++; };
            };
            if (p + 1 < ib.n)
            {
                op = ib.b[p] `& 255;
                if (op == 0x8B | op == 0x85 | op == 0x03 | op == 0x0B | op == 0x13 | op == 0x1B | op == 0x23 | op == 0x2B | op == 0x33 | op == 0x3B | op == 0x8D) { relaxable = true; };
                if (op == 0xFF)
                {
                    k = ((ib.b[p + 1] `& 255) >> 3) `& 7;
                    if (k == 2 | k == 4) { relaxable = true; };
                };
            };
            if (!relaxable) { ->; };
            k = 0;
            while (k < ib.nfx)
            {
                if (ib.fx[k].kind == IA_FX_GOTPCREL)
                {
                    if (rex) { ib.fx[k].kind = IA_FX_REXGOTPCRELX; } else { ib.fx[k].kind = IA_FX_GOTPCRELX; };
                };
                k++;
            };
            ->;
        };

        iasm_encode_line(IasmCtx* cx, byte* line, Ib* ib) -> bool
        {
            int i = 0;
            int n = ia_strlen(line);
            int st = 0;
            int k = 0;
            int pfx;
            Mn* m;
            Operand a, b, c;
            ib.n = 0;
            ib.nfx = 0;
            ib.br = 0;
            ib.brcc = 0;
            ib.sym = (byte*)0;
            cx.err = (byte*)0;
            while (i < n & (line[i] == 32 | line[i] == 9)) { i++; };
            st = i;
            while (i < n & line[i] != 32 & line[i] != 9) { i++; };
            m = ia_mn_find(cx, line + st, i - st);
            if (m == 0) { -> ia_fail(cx, "unknown mnemonic\0"); };
            if (m.kind == IA_K_PREFIX)
            {
                // a prefix: encode the rest of the line, then put the prefix byte first
                pfx = m.a;
                if (!iasm_encode_line(cx, line + i, ib)) { -> false; };
                if (ib.n >= 23) { -> ia_fail(cx, "instruction too long\0"); };
                k = ib.n;
                while (k > 0) { ib.b[k] = ib.b[k - 1]; k--; };
                ib.b[0] = pfx;
                ib.n++;
                k = 0;
                while (k < ib.nfx) { ib.fx[k].off++; k++; };
                -> true;
            };
            if (!ia_parse_operands(cx, line + i, n - i, @a, @b, @c)) { -> false; };
            if (!ia_encode_ops(cx, m, @a, @b, @c, ib)) { -> false; };
            ia_relax_gotpcrel(ib);
            -> true;
        };
    };
};

#endif;
