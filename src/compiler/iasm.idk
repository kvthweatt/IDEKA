// Author: Karac V. Thweatt
//
// iasm.idk - IDEKA x86-64 assembler library (AT&T syntax)
//
// This file is a library. It has no main. The standalone tool is iasm_main.idk.
//
// Usage:
//
//     #import "src/compiler/iasm.idk";
//     using IDEKA::iasm;
//
//     IasmCtx cx;
//     iasm_init(@cx);
//     Ib ib;
//     iasm_encode_line(@cx, line, @ib);     // one instruction, no labels or directives
//
// The output of llc -S is the input this assembler is built for, so the syntax
// accepted is the AT&T syntax llc prints, plus what hand written inline asm needs.

#ifndef IDEKA_STANDARD
#import <standard.idk>;
#endif;

#ifndef IDEKA_STANDARD_FFI_FIO
#import <runtime\ffifio.idk>;
#endif;

#ifndef IDEKA_IASM
#def IDEKA_IASM 1;

// ===== OPERAND KINDS =====

#def IA_OP_NONE 0;
#def IA_OP_REG 1;
#def IA_OP_IMM 2;
#def IA_OP_MEM 3;
#def IA_OP_SYM 4;

// ===== REGISTER CLASSES (register code = class * 32 + number) =====

#def IA_RC_R8 1;
#def IA_RC_R8H 2;
#def IA_RC_R16 3;
#def IA_RC_R32 4;
#def IA_RC_R64 5;
#def IA_RC_XMM 6;
#def IA_RC_ST 7;
#def IA_RC_YMM 8;
#def IA_RC_SEG 9;
#def IA_RC_IP 10;
#def IA_RC_ZMM 11;
#def IA_RC_K 12;

// ===== SYMBOL MODIFIERS =====

#def IA_MOD_NONE 0;
#def IA_MOD_PLT 1;
#def IA_MOD_GOTPCREL 2;
#def IA_MOD_GOTPCRELX 3;
#def IA_MOD_TPOFF 4;
#def IA_MOD_GOTTPOFF 5;
#def IA_MOD_TLSGD 6;
#def IA_MOD_IMGREL 7;
#def IA_MOD_SECREL 8;
#def IA_MOD_NTPOFF 9;
#def IA_MOD_DTPOFF 10;
#def IA_MOD_TLSLD 11;

// ===== FIXUP KINDS =====

#def IA_FX_PC32 1;
#def IA_FX_PLT32 2;
#def IA_FX_ABS32 3;
#def IA_FX_ABS32S 4;
#def IA_FX_ABS64 5;
#def IA_FX_GOTPCREL 6;
#def IA_FX_GOTPCRELX 7;
#def IA_FX_REXGOTPCRELX 8;
#def IA_FX_BR8 9;
#def IA_FX_ABS8 10;
#def IA_FX_ABS16 11;

// ===== MNEMONIC KINDS =====

#def IA_K_NONE 0;
#def IA_K_ALU 1;
#def IA_K_MOV 2;
#def IA_K_LEA 3;
#def IA_K_TEST 4;
#def IA_K_UNARY 5;
#def IA_K_SHIFT 6;
#def IA_K_PUSH 7;
#def IA_K_POP 8;
#def IA_K_CALL 9;
#def IA_K_JMP 10;
#def IA_K_JCC 11;
#def IA_K_SETCC 12;
#def IA_K_CMOV 13;
#def IA_K_MOVX 14;
#def IA_K_IMUL 15;
#def IA_K_NOARG 16;
#def IA_K_XCHG 17;
#def IA_K_BSWAP 18;
#def IA_K_BT 19;
#def IA_K_MOVABS 20;
#def IA_K_PREFIX 21;
#def IA_K_INCDEC 22;
#def IA_K_SSE 23;
#def IA_K_CVTI2F 24;
#def IA_K_CVTF2I 25;
#def IA_K_SSECMP 26;
#def IA_K_MOVD 27;
#def IA_K_PREFETCH 28;
#def IA_K_X87 29;
#def IA_K_VEX 30;
#def IA_K_X87REG 31;
#def IA_K_RMW 32;
#def IA_K_VX 33;
#def IA_K_MOVBE 34;
#def IA_K_BSCAN 35;
#def IA_K_SSE4A 36;
#def IA_K_SSEG 37;
#def IA_K_CRC32 38;
#def IA_K_MEMX 39;
#def IA_K_SHLD 40;
#def IA_K_GPRX 41;
#def IA_K_IMMOP 42;
#def IA_K_X87OP 43;

// VEX forms (Mn.sz of an IA_K_VX entry)
#def IA_VF_RVM 1;
#def IA_VF_RM 2;
#def IA_VF_RMI 3;
#def IA_VF_RVMI 4;
#def IA_VF_RVMR 5;
#def IA_VF_MOVS 6;
#def IA_VF_CMP 7;
#def IA_VF_SHIFT 8;
#def IA_VF_RMV 9;
#def IA_VF_NDD 10;
#def IA_VF_MOVD 11;
#def IA_VF_MOVQ 12;
#def IA_VF_CVTI2F 13;
#def IA_VF_MRI 14;
#def IA_VF_MR 15;
#def IA_VF_KOP 16;
#def IA_VF_MOVLP 17;
#def IA_VF_GATHER 18;
#def IA_VF_MASKMOV 19;
#def IA_VF_GRP 20;

namespace IDEKA
{
    namespace iasm
    {
        // ===== BYTE HELPERS =====

        ia_strlen(byte* s) -> int
        {
            int n = 0;
            while (s[n] != 0) { n++; };
            -> n;
        };

        ia_streq(byte* a, byte* b) -> bool
        {
            int i = 0;
            while (a[i] != 0 & b[i] != 0)
            {
                if (a[i] != b[i]) { -> false; };
                i++;
            };
            -> a[i] == b[i];
        };

        // Compare s[0, n) with the null terminated t
        ia_eqn(byte* s, int n, byte* t) -> bool
        {
            int i = 0;
            while (i < n)
            {
                if (t[i] == 0) { -> false; };
                if (s[i] != t[i]) { -> false; };
                i++;
            };
            -> t[n] == 0;
        };

        ia_dup(byte* s, int n) -> byte*
        {
            byte* p = (byte*)fmalloc(n + 1);
            int i = 0;
            if (p == 0) { -> p; };
            while (i < n) { p[i] = s[i]; i++; };
            p[n] = 0;
            -> p;
        };

        ia_cat2(byte* a, byte* b) -> byte*
        {
            int la = ia_strlen(a);
            int lb = ia_strlen(b);
            byte* p = (byte*)fmalloc(la + lb + 1);
            int i = 0;
            while (i < la) { p[i] = a[i]; i++; };
            i = 0;
            while (i < lb) { p[la + i] = b[i]; i++; };
            p[la + lb] = 0;
            -> p;
        };

        ia_grow(byte* old, int nbytes) -> byte*
        {
            u64 np;
            if (old == 0) { np = fmalloc(nbytes); }
            else { np = frealloc((u64)old, nbytes); };
            -> (byte*)np;
        };

        ia_hexd(int v) -> int
        {
            if (v < 10) { -> 48 + v; };
            -> 87 + v;
        };

        ia_fits8(i64 v) -> bool -> v >= -128 & v <= 127;

        ia_fits32(i64 v) -> bool -> v >= -2147483648 & v <= 2147483647;

        ia_isdig(int c) -> bool -> c >= 48 & c <= 57;

        ia_isalpha(int c) -> bool -> (c >= 65 & c <= 90) | (c >= 97 & c <= 122);

        // Characters that may be part of a symbol name
        ia_issym(int c) -> bool -> ia_isalpha(c) | ia_isdig(c) | c == 95 | c == 46 | c == 36;

        ia_hexval(int c) -> int
        {
            if (c >= 48 & c <= 57) { -> c - 48; };
            if (c >= 97 & c <= 102) { -> c - 87; };
            if (c >= 65 & c <= 70) { -> c - 55; };
            -> -1;
        };

        // ===== OPERANDS =====

        struct Operand
        {
            int kind, reg, base, index, scale;
            i64 val;
            byte* sym;
            int mod;
            bool star, has_disp;
            int seg, mask;
            bool zero;
            int bcst;
        };

        struct Fix
        {
            int off, kind;
            i64 add;
            byte* sym;
        };

        // The bytes of one encoded instruction and the fixups inside them
        struct Ib
        {
            byte[24] b;
            int n;
            Fix[4] fx;
            int nfx;
            // branch info: kind 0 none, 1 jmp, 2 jcc, 3 call; target symbol in sym
            int br, brcc;
            byte* sym;
        };

        ib_put(Ib* ib, int v) -> void
        {
            if (ib.n < 24) { ib.b[ib.n] = v; ib.n++; };
            ->;
        };

        ib_put16(Ib* ib, i64 v) -> void
        {
            ib_put(ib, (v `& 255));
            ib_put(ib, ((v >> 8) `& 255));
            ->;
        };

        ib_put32(Ib* ib, i64 v) -> void
        {
            ib_put16(ib, v);
            ib_put16(ib, v >> 16);
            ->;
        };

        ib_put64(Ib* ib, i64 v) -> void
        {
            ib_put32(ib, v);
            ib_put32(ib, v >> 32);
            ->;
        };

        ib_fix(Ib* ib, int off, int kind, i64 add, byte* sym) -> void
        {
            if (ib.nfx < 4)
            {
                ib.fx[ib.nfx].off = off;
                ib.fx[ib.nfx].kind = kind;
                ib.fx[ib.nfx].add = add;
                ib.fx[ib.nfx].sym = sym;
                ib.nfx++;
            };
            ->;
        };

        // ===== CONTEXT =====

        struct RegEnt
        {
            byte* name;
            int code, next;
        };

        struct Mn
        {
            byte* name;
            int kind, sz, a, b, c, next;
        };

        struct IasmCtx
        {
            RegEnt[420] regs;
            int nreg;
            int[512] reghash;
            Mn[8000] mns;
            int nmn;
            int[16384] mnhash;
            Operand op4;
            byte* err;
            // EVEX state of the instruction being encoded
            bool ev;
            int ev_k;
            bool ev_z;
            int ev_b, ev_rc, d8n;
            bool ev_n16;
            Mn* ev_mn;
        };

        ia_hash(byte* s, int n) -> int
        {
            int h = 5381;
            int i = 0;
            while (i < n)
            {
                h = h * 33 + s[i];
                i++;
            };
            if (h < 0) { h = 0 - h; };
            if (h < 0) { h = 0; };
            -> h;
        };

        ia_reg_add(IasmCtx* cx, byte* name, int cls, int num) -> void
        {
            int h = ia_hash(name, ia_strlen(name)) % 512;
            cx.regs[cx.nreg].name = name;
            cx.regs[cx.nreg].code = cls * 32 + num;
            cx.regs[cx.nreg].next = cx.reghash[h] - 1;
            cx.reghash[h] = cx.nreg + 1;
            cx.nreg++;
            ->;
        };

        // -1 when s[0, n) is not a register name
        ia_reg_find(IasmCtx* cx, byte* s, int n) -> int
        {
            int h = ia_hash(s, n) % 512;
            int i = cx.reghash[h] - 1;
            while (i >= 0)
            {
                if (ia_eqn(s, n, cx.regs[i].name)) { -> cx.regs[i].code; };
                i = cx.regs[i].next;
            };
            -> -1;
        };

        ia_mn_add(IasmCtx* cx, byte* name, int kind, int sz, int a, int b, int c) -> void
        {
            int h = ia_hash(name, ia_strlen(name)) % 8192;
            cx.mns[cx.nmn].name = name;
            cx.mns[cx.nmn].kind = kind;
            cx.mns[cx.nmn].sz = sz;
            cx.mns[cx.nmn].a = a;
            cx.mns[cx.nmn].b = b;
            cx.mns[cx.nmn].c = c;
            cx.mns[cx.nmn].next = cx.mnhash[h] - 1;
            cx.mnhash[h] = cx.nmn + 1;
            cx.nmn++;
            ->;
        };

        ia_mn_find(IasmCtx* cx, byte* s, int n) -> Mn*
        {
            int h = ia_hash(s, n) % 8192;
            int i = cx.mnhash[h] - 1;
            while (i >= 0)
            {
                if (ia_eqn(s, n, cx.mns[i].name)) { -> @cx.mns[i]; };
                i = cx.mns[i].next;
            };
            -> (Mn*)0;
        };

        // base with the b w l q suffixes (sizes 8 16 32 64) and the unsuffixed form (size 0)
        ia_mn4(IasmCtx* cx, byte* base, int kind, int a, int b, int c) -> void
        {
            ia_mn_add(cx, base, kind, 0, a, b, c);
            ia_mn_add(cx, ia_cat2(base, "b\0"), kind, 8, a, b, c);
            ia_mn_add(cx, ia_cat2(base, "w\0"), kind, 16, a, b, c);
            ia_mn_add(cx, ia_cat2(base, "l\0"), kind, 32, a, b, c);
            ia_mn_add(cx, ia_cat2(base, "q\0"), kind, 64, a, b, c);
            ->;
        };

        // base with the w l q suffixes only
        ia_mn3(IasmCtx* cx, byte* base, int kind, int a, int b, int c) -> void
        {
            ia_mn_add(cx, base, kind, 0, a, b, c);
            ia_mn_add(cx, ia_cat2(base, "w\0"), kind, 16, a, b, c);
            ia_mn_add(cx, ia_cat2(base, "l\0"), kind, 32, a, b, c);
            ia_mn_add(cx, ia_cat2(base, "q\0"), kind, 64, a, b, c);
            ->;
        };

        // Condition code names: every alias and its code
        ia_cc_name(int i) -> byte*
        {
            switch (i)
            {
                case (0) { -> g"o\0"; }
                case (1) { -> g"no\0"; }
                case (2) { -> g"b\0"; }
                case (3) { -> g"ae\0"; }
                case (4) { -> g"e\0"; }
                case (5) { -> g"ne\0"; }
                case (6) { -> g"be\0"; }
                case (7) { -> g"a\0"; }
                case (8) { -> g"s\0"; }
                case (9) { -> g"ns\0"; }
                case (10) { -> g"p\0"; }
                case (11) { -> g"np\0"; }
                case (12) { -> g"l\0"; }
                case (13) { -> g"ge\0"; }
                case (14) { -> g"le\0"; }
                case (15) { -> g"g\0"; }
                case (16) { -> g"c\0"; }
                case (17) { -> g"nae\0"; }
                case (18) { -> g"nb\0"; }
                case (19) { -> g"nc\0"; }
                case (20) { -> g"z\0"; }
                case (21) { -> g"nz\0"; }
                case (22) { -> g"na\0"; }
                case (23) { -> g"nbe\0"; }
                case (24) { -> g"pe\0"; }
                case (25) { -> g"po\0"; }
                case (26) { -> g"nge\0"; }
                case (27) { -> g"nl\0"; }
                case (28) { -> g"ng\0"; }
                case (29) { -> g"nle\0"; }
                default { -> (byte*)0; };
            };
        };

        // The code of alias i of ia_cc_name
        ia_cc_code(int i) -> int
        {
            switch (i)
            {
                case (16) { -> 2; }
                case (17) { -> 2; }
                case (18) { -> 3; }
                case (19) { -> 3; }
                case (20) { -> 4; }
                case (21) { -> 5; }
                case (22) { -> 6; }
                case (23) { -> 7; }
                case (24) { -> 10; }
                case (25) { -> 11; }
                case (26) { -> 12; }
                case (27) { -> 13; }
                case (28) { -> 14; }
                case (29) { -> 15; }
                default { -> i; };
            };
        };

        // ===== TABLES =====

        ia_init_regs(IasmCtx* cx) -> void
        {
            int i = 0;
            byte* t;
            byte[16] nb;
            // legacy 64, 32, 16, 8 bit names of registers 0 to 7
            ia_reg_add(cx, g"rax\0", IA_RC_R64, 0); ia_reg_add(cx, g"rcx\0", IA_RC_R64, 1);
            ia_reg_add(cx, g"rdx\0", IA_RC_R64, 2); ia_reg_add(cx, g"rbx\0", IA_RC_R64, 3);
            ia_reg_add(cx, g"rsp\0", IA_RC_R64, 4); ia_reg_add(cx, g"rbp\0", IA_RC_R64, 5);
            ia_reg_add(cx, g"rsi\0", IA_RC_R64, 6); ia_reg_add(cx, g"rdi\0", IA_RC_R64, 7);
            ia_reg_add(cx, g"eax\0", IA_RC_R32, 0); ia_reg_add(cx, g"ecx\0", IA_RC_R32, 1);
            ia_reg_add(cx, g"edx\0", IA_RC_R32, 2); ia_reg_add(cx, g"ebx\0", IA_RC_R32, 3);
            ia_reg_add(cx, g"esp\0", IA_RC_R32, 4); ia_reg_add(cx, g"ebp\0", IA_RC_R32, 5);
            ia_reg_add(cx, g"esi\0", IA_RC_R32, 6); ia_reg_add(cx, g"edi\0", IA_RC_R32, 7);
            ia_reg_add(cx, g"ax\0", IA_RC_R16, 0); ia_reg_add(cx, g"cx\0", IA_RC_R16, 1);
            ia_reg_add(cx, g"dx\0", IA_RC_R16, 2); ia_reg_add(cx, g"bx\0", IA_RC_R16, 3);
            ia_reg_add(cx, g"sp\0", IA_RC_R16, 4); ia_reg_add(cx, g"bp\0", IA_RC_R16, 5);
            ia_reg_add(cx, g"si\0", IA_RC_R16, 6); ia_reg_add(cx, g"di\0", IA_RC_R16, 7);
            ia_reg_add(cx, g"al\0", IA_RC_R8, 0); ia_reg_add(cx, g"cl\0", IA_RC_R8, 1);
            ia_reg_add(cx, g"dl\0", IA_RC_R8, 2); ia_reg_add(cx, g"bl\0", IA_RC_R8, 3);
            ia_reg_add(cx, g"spl\0", IA_RC_R8, 4); ia_reg_add(cx, g"bpl\0", IA_RC_R8, 5);
            ia_reg_add(cx, g"sil\0", IA_RC_R8, 6); ia_reg_add(cx, g"dil\0", IA_RC_R8, 7);
            ia_reg_add(cx, g"ah\0", IA_RC_R8H, 4); ia_reg_add(cx, g"ch\0", IA_RC_R8H, 5);
            ia_reg_add(cx, g"dh\0", IA_RC_R8H, 6); ia_reg_add(cx, g"bh\0", IA_RC_R8H, 7);
            ia_reg_add(cx, g"rip\0", IA_RC_IP, 0);
            ia_reg_add(cx, g"es\0", IA_RC_SEG, 0); ia_reg_add(cx, g"cs\0", IA_RC_SEG, 1);
            ia_reg_add(cx, g"ss\0", IA_RC_SEG, 2); ia_reg_add(cx, g"ds\0", IA_RC_SEG, 3);
            ia_reg_add(cx, g"fs\0", IA_RC_SEG, 4); ia_reg_add(cx, g"gs\0", IA_RC_SEG, 5);
            // r8 to r15 and their d w b forms, xmm0 to xmm15, ymm0 to ymm15
            i = 8;
            while (i < 16)
            {
                nb[0] = 'r';
                if (i < 10) { nb[1] = (48 + i); nb[2] = 0; }
                else { nb[1] = '1'; nb[2] = (48 + i - 10); nb[3] = 0; };
                ia_reg_add(cx, ia_dup(nb, ia_strlen(nb)), IA_RC_R64, i);
                t = ia_cat2(nb, g"d\0"); ia_reg_add(cx, t, IA_RC_R32, i);
                t = ia_cat2(nb, g"w\0"); ia_reg_add(cx, t, IA_RC_R16, i);
                t = ia_cat2(nb, g"b\0"); ia_reg_add(cx, t, IA_RC_R8, i);
                i++;
            };
            i = 0;
            while (i < 32)
            {
                nb[0] = 'x'; nb[1] = 'm'; nb[2] = 'm';
                if (i < 10) { nb[3] = (48 + i); nb[4] = 0; }
                else { nb[3] = (48 + i / 10); nb[4] = (48 + i % 10); nb[5] = 0; };
                ia_reg_add(cx, ia_dup(nb, ia_strlen(nb)), IA_RC_XMM, i);
                nb[0] = 'y';
                ia_reg_add(cx, ia_dup(nb, ia_strlen(nb)), IA_RC_YMM, i);
                nb[0] = 'z';
                ia_reg_add(cx, ia_dup(nb, ia_strlen(nb)), IA_RC_ZMM, i);
                i++;
            };
            i = 0;
            while (i < 8)
            {
                nb[0] = 'k'; nb[1] = (48 + i); nb[2] = 0;
                ia_reg_add(cx, ia_dup(nb, ia_strlen(nb)), IA_RC_K, i);
                i++;
            };
            i = 0;
            while (i < 8)
            {
                nb[0] = 's'; nb[1] = 't'; nb[2] = '('; nb[3] = (48 + i); nb[4] = ')'; nb[5] = 0;
                ia_reg_add(cx, ia_dup(nb, ia_strlen(nb)), IA_RC_ST, i);
                i++;
            };
            ia_reg_add(cx, g"st\0", IA_RC_ST, 0);
            ->;
        };

        ia_sse(IasmCtx* cx, byte* name, int opc, int pfx, int store) -> void
        {
            ia_mn_add(cx, name, IA_K_SSE, 0, opc, pfx, store);
            ->;
        };

        // base + ps / pd / ss / sd forms of an arithmetic SSE op
        ia_sse4(IasmCtx* cx, byte* base, int opc) -> void
        {
            ia_sse(cx, ia_cat2(base, g"ps\0"), opc, 0, 0);
            ia_sse(cx, ia_cat2(base, g"pd\0"), opc, 0x66, 0);
            ia_sse(cx, ia_cat2(base, g"ss\0"), opc, 0xF3, 0);
            ia_sse(cx, ia_cat2(base, g"sd\0"), opc, 0xF2, 0);
            ->;
        };

        // cmpXXss / sd / ps / pd pseudo instructions: sz = predicate
        ia_sse_cmp(IasmCtx* cx) -> void
        {
            int p;
            byte* pn, t;
            p = 0;
            while (p < 8)
            {
                switch (p)
                {
                    case (0) { pn = g"eq\0"; }
                    case (1) { pn = g"lt\0"; }
                    case (2) { pn = g"le\0"; }
                    case (3) { pn = g"unord\0"; }
                    case (4) { pn = g"neq\0"; }
                    case (5) { pn = g"nlt\0"; }
                    case (6) { pn = g"nle\0"; }
                    default { pn = g"ord\0"; };
                };
                t = ia_cat2(g"cmp\0", pn);
                ia_mn_add(cx, ia_cat2(t, g"ps\0"), IA_K_SSECMP, p, 0xC20F, 0, 0);
                ia_mn_add(cx, ia_cat2(t, g"pd\0"), IA_K_SSECMP, p, 0xC20F, 0x66, 0);
                ia_mn_add(cx, ia_cat2(t, g"ss\0"), IA_K_SSECMP, p, 0xC20F, 0xF3, 0);
                ia_mn_add(cx, ia_cat2(t, g"sd\0"), IA_K_SSECMP, p, 0xC20F, 0xF2, 0);
                p++;
            };
            ->;
        };

        // ===== VEX TABLE =====

        // a packs: opcode, map (bits 8-9), pp (10-11: none, 66, F3, F2), W (12)
        ia_vx(IasmCtx* cx, byte* name, int form, int map, int pp, int w, int opc, int b, int c) -> void
        {
            ia_mn_add(cx, name, IA_K_VX, form, opc `| (map << 8) `| (pp << 10) `| (w << 12), b, c);
            ->;
        };

        // v<base>ps, pd, ss and sd with the pp 0, 66, F3, F2 of the 0F map
        ia_vx_4(IasmCtx* cx, byte* base, int opc, int fp, int fs, int comm) -> void
        {
            byte* v = ia_cat2(g"v\0", base);
            ia_vx(cx, ia_cat2(v, g"ps\0"), fp, 1, 0, 0, opc, 0, comm);
            ia_vx(cx, ia_cat2(v, g"pd\0"), fp, 1, 1, 0, opc, 0, comm);
            ia_vx(cx, ia_cat2(v, g"ss\0"), fs, 1, 2, 0, opc, 0, 0);
            ia_vx(cx, ia_cat2(v, g"sd\0"), fs, 1, 3, 0, opc, 0, 0);
            ->;
        };

        // 66 prefixed integer ops of the 0F map, three operand form
        ia_vx_int(IasmCtx* cx, byte* name, int opc, int comm) -> void
        {
            ia_vx(cx, ia_cat2(g"v\0", name), IA_VF_RVM, 1, 1, 0, opc, 0, comm);
            ->;
        };

        ia_vx_fma(IasmCtx* cx, byte* name, int o132, bool scalar) -> void
        {
            int k = 0;
            int add = 0;
            byte* b, t;
            if (scalar) { add = 1; };
            while (k < 3)
            {
                b = ia_cat2(g"v\0", name);
                if (k == 0) { t = g"132\0"; };
                if (k == 1) { t = g"213\0"; };
                if (k == 2) { t = g"231\0"; };
                b = ia_cat2(b, t);
                if (scalar)
                {
                    ia_vx(cx, ia_cat2(b, g"ss\0"), IA_VF_RVM, 2, 1, 0, o132 + 16 * k + add, 0, 0);
                    ia_vx(cx, ia_cat2(b, g"sd\0"), IA_VF_RVM, 2, 1, 1, o132 + 16 * k + add, 0, 0);
                }
                else
                {
                    ia_vx(cx, ia_cat2(b, g"ps\0"), IA_VF_RVM, 2, 1, 0, o132 + 16 * k, 0, 0);
                    ia_vx(cx, ia_cat2(b, g"pd\0"), IA_VF_RVM, 2, 1, 1, o132 + 16 * k, 0, 0);
                };
                k++;
            };
            ->;
        };

        // BMI names come as base, base+l and base+q
        ia_vx_bmi(IasmCtx* cx, byte* name, int form, int map, int pp, int opc, int c) -> void
        {
            ia_vx(cx, name, form, map, pp, 0, opc, 0, c);
            ia_vx(cx, ia_cat2(name, g"l\0"), form, map, pp, 0, opc, 0, c);
            ia_vx(cx, ia_cat2(name, g"q\0"), form, map, pp, 0, opc, 0, c);
            ->;
        };


        // EVEX only instruction: the same table entry as ia_vx, with bit 13 of a set
        ia_ex(IasmCtx* cx, byte* name, int form, int map, int pp, int w, int opc, int b, int c) -> void
        {
            int mp = map;
            int hi = 0;
            if (map == 5) { mp = 0; hi = 16384; };
            if (map == 6) { mp = 0; hi = 32768; };
            ia_mn_add(cx, name, IA_K_VX, form, opc `| (mp << 8) `| (pp << 10) `| (w << 12) `| 8192 `| hi, b, c);
            ->;
        };

        // name + suffix pairs: d with W0 and q with W1
        ia_ex_dq(IasmCtx* cx, byte* base, int form, int map, int pp, int opc, int b, int c) -> void
        {
            ia_ex(cx, ia_cat2(base, g"d\0"), form, map, pp, 0, opc, b, c);
            ia_ex(cx, ia_cat2(base, g"q\0"), form, map, pp, 1, opc, b, c);
            ->;
        };

        // name + ps (W0) and pd (W1)
        ia_ex_pp(IasmCtx* cx, byte* base, int form, int map, int opc, int b, int c) -> void
        {
            ia_ex(cx, ia_cat2(base, g"ps\0"), form, map, 1, 0, opc, b, c);
            ia_ex(cx, ia_cat2(base, g"pd\0"), form, map, 1, 1, opc, b, c);
            ->;
        };

        // name + ss (W0) and sd (W1)
        ia_ex_ss(IasmCtx* cx, byte* base, int form, int map, int opc, int b, int c) -> void
        {
            ia_ex(cx, ia_cat2(base, g"ss\0"), form, map, 1, 0, opc, b, c);
            ia_ex(cx, ia_cat2(base, g"sd\0"), form, map, 1, 1, opc, b, c);
            ->;
        };

        // k mask instruction, VEX encoded: form IA_VF_KOP, b = kind of operands
        ia_kop(IasmCtx* cx, byte* name, int map, int pp, int w, int opc, int kind, int c) -> void
        {
            ia_mn_add(cx, name, IA_K_VX, IA_VF_KOP, opc `| (map << 8) `| (pp << 10) `| (w << 12), kind, c);
            ->;
        };

        // k mask instructions of the four widths b w d q
        ia_kop4(IasmCtx* cx, byte* base, int opc, int kind) -> void
        {
            ia_kop(cx, ia_cat2(base, g"b\0"), 1, 1, 0, opc, kind, 0);
            ia_kop(cx, ia_cat2(base, g"w\0"), 1, 0, 0, opc, kind, 0);
            ia_kop(cx, ia_cat2(base, g"d\0"), 1, 1, 1, opc, kind, 0);
            ia_kop(cx, ia_cat2(base, g"q\0"), 1, 0, 1, opc, kind, 0);
            ->;
        };

        // vpcmp{pred}{b,w,d,q} and the unsigned forms: IA_VF_CMP with the predicate as the immediate
        ia_ex_pred(IasmCtx* cx, byte* nm, int idx) -> void
        {
            int pr = idx;
            if (idx == 3) { pr = 4; };
            if (idx == 4) { pr = 5; };
            if (idx == 5) { pr = 6; };
            if (idx != 0)
            {
                ia_ex(cx, ia_cat2(nm, g"b\0"), IA_VF_CMP, 3, 1, 0, 0x3F, 0, pr);
                ia_ex(cx, ia_cat2(nm, g"w\0"), IA_VF_CMP, 3, 1, 1, 0x3F, 0, pr);
                ia_ex(cx, ia_cat2(nm, g"d\0"), IA_VF_CMP, 3, 1, 0, 0x1F, 0, pr);
                ia_ex(cx, ia_cat2(nm, g"q\0"), IA_VF_CMP, 3, 1, 1, 0x1F, 0, pr);
            };
            ia_ex(cx, ia_cat2(nm, g"ub\0"), IA_VF_CMP, 3, 1, 0, 0x3E, 0, pr);
            ia_ex(cx, ia_cat2(nm, g"uw\0"), IA_VF_CMP, 3, 1, 1, 0x3E, 0, pr);
            ia_ex(cx, ia_cat2(nm, g"ud\0"), IA_VF_CMP, 3, 1, 0, 0x1E, 0, pr);
            ia_ex(cx, ia_cat2(nm, g"uq\0"), IA_VF_CMP, 3, 1, 1, 0x1E, 0, pr);
            ->;
        };

        ia_sg(IasmCtx* cx, byte* name, int sz, int opc, int pfx, int c) -> void
        {
            ia_mn_add(cx, name, IA_K_SSEG, sz, opc, pfx, c);
            ->;
        };

