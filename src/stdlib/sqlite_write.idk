                    if (VD_NJ < 32) { VD_JF[VD_NJ] = a; VD_NJ++; };
                    if (t1 != 0) { sq_vd_putreg(t1); };
                    if (t2 != 0) { sq_vd_putreg(t2); };
                    return 0;
                };
            };
            if (nd.kind != SQN_BIN) { return 1; };
            op = nd.op;
            nm = (byte*)0;
            if (op == SQO_EQ) { nm = "Ne\0"; };
            if (op == SQO_NE) { nm = "Eq\0"; };
            if (op == SQO_LT) { nm = "Ge\0"; };
            if (op == SQO_LE) { nm = "Gt\0"; };
            if (op == SQO_GT) { nm = "Le\0"; };
            if (op == SQO_GE) { nm = "Lt\0"; };
            if ((u64)nm == (u64)0) { return 1; };
            l = @g.nodes[nd.a];
            k = nd.a;
            cl = 0 - 1;
            if (l.kind == SQN_COLLATE) { cl = (int)l.iv; k = l.a; l = @g.nodes[l.a]; };
            if (l.kind != SQN_COL | sq_vd_isconst(g, nd.b) == false) { return 1; };
            if (g.nodes[nd.b].kind == SQN_NULL) { return 1; };
            col = l.col;
            if (col < ti.ncols & cl < 0) { cl = ti.coll[col]; };
            if (cl < 0) { cl = 0; };
            if (col >= ti.ncols | col == ti.ipk) { if (g.nodes[nd.b].kind != SQN_INT | cl != 0) { return 1; }; };
            if (sq_vd_operand(g, ti, k, @r1, @t1) != 0) { return 1; };
            if (sq_vd_operand(g, ti, nd.b, @r2, @t2) != 0) { return 1; };
            a = sq_vd_op(nm, r2, 0, r1);
            if (col == ti.ipk | col >= ti.ncols) { VD_P5[a] = 16 + 68; }
            else
            {
                if (cl == 0) { if (l.col != ti.ipk) { sq_vd_p4s(a, "BINARY-8\0", 8); }; };
                if (cl == 1) { sq_vd_p4s(a, "NOCASE-8\0", 8); };
                if (cl == 2) { sq_vd_p4s(a, "RTRIM-8\0", 7); };
                if (cl > 2) { return 1; };
                VD_P5[a] = 16 + sq_vd_affch(ti.aff[col]);
            };
            if (VD_NJ < 32) { VD_JF[VD_NJ] = a; VD_NJ++; };
            if (t1 != 0) { sq_vd_putreg(t1); };
            if (t2 != 0) { sq_vd_putreg(t2); };
            return 0;
        };

        // flattens an AND tree into its conjuncts
        def sq_vd_split(SQ_STMT* g, int ni, int* arr, int* n) -> void
        {
            SQ_NODE* nd = @g.nodes[ni];
            if (nd.kind == SQN_BIN & nd.op == SQO_AND)
            {
                sq_vd_split(g, nd.a, arr, n);
                sq_vd_split(g, nd.b, arr, n);
                return;
            };
            if (*n < 16) { arr[*n] = ni; *n = *n + 1; };
        };

        // split the WHERE into conjuncts, turning a plain BETWEEN on a column into its >= and <= terms
        def sq_vd_splitx(SQ_STMT* g, int ni, int* arr, int* n) -> void
        {
            int i, k, n1, n2, nn;
            SQ_NODE* nd;
            sq_vd_split(g, ni, arr, n);
            i = 0;
            while (i < *n)
            {
                nd = @g.nodes[arr[i]];
                if (nd.kind == SQN_BETWEEN & nd.op == 1 & *n < 16)
                {
                    k = arr[i];
                    n1 = sq_newnode(g, SQN_BIN);
                    n2 = sq_newnode(g, SQN_BIN);
                    if (n1 < 0 | n2 < 0) { return; };
                    g.nodes[n1] = g.nodes[k]; g.nodes[n1].kind = SQN_BIN; g.nodes[n1].op = SQO_GE; g.nodes[n1].a = g.nodes[k].a; g.nodes[n1].b = g.nodes[k].b;
                    g.nodes[n2] = g.nodes[k]; g.nodes[n2].kind = SQN_BIN; g.nodes[n2].op = SQO_LE; g.nodes[n2].a = g.nodes[k].a; g.nodes[n2].b = g.nodes[k].c; g.nodes[n1].iv = (i64)7771; g.nodes[n2].iv = (i64)7772;
                    for (nn = *n; nn > i + 1; nn--) { arr[nn] = arr[nn - 1]; };
                    arr[i] = n1; arr[i + 1] = n2; *n = *n + 1;
                };
                i++;
            };
        };

        // the first column an expression reads, or -1
        def sq_vd_exprcol(SQ_STMT* g, int ni) -> int
        {
            SQ_NODE* nd;
            int r, an;
            if (ni < 0) { return 0 - 1; };
            nd = @g.nodes[ni];
            if (nd.kind == SQN_COL) { return nd.col; };
            if (nd.kind == SQN_BIN)
            {
                r = sq_vd_exprcol(g, nd.a);
                if (r >= 0) { return r; };
                return sq_vd_exprcol(g, nd.b);
            };
            if (nd.kind == SQN_LIKE) { return sq_vd_exprcol(g, nd.a); };
            if (nd.kind == SQN_FUNC)
            {
                for (an = nd.a; an >= 0; an = g.nodes[an].next)
                {
                    r = sq_vd_exprcol(g, an);
                    if (r >= 0) { return r; };
                };
            };
            return 0 - 1;
        };

        // the column a term tests, including BETWEEN, IN and IS NULL terms
        def sq_vd_tcol(SQ_STMT* g, int ni) -> int
        {
            SQ_NODE* nd;
            if (ni < 0) { return 0 - 1; };
            nd = @g.nodes[ni];
            if (nd.kind == SQN_BETWEEN | nd.kind == SQN_IN | nd.kind == SQN_ISNULL) { return sq_vd_exprcol(g, nd.a); };
            return sq_vd_exprcol(g, ni);
        };

        // 1 when a LIKE or expression term reads a column that another term pins to a constant (SQLite folds that test)
        def sq_vd_likepin(SQ_STMT* g, int wn) -> int
        {
            int[16] cj;
            int n, i, j, c;
            SQ_NODE* x;
            SQ_NODE* y;
            n = 0;
            sq_vd_split(g, wn, @cj[0], @n);
            for (i = 0; i < n; i++)
            {
                x = @g.nodes[cj[i]];
                c = 0 - 1;
                if (x.kind == SQN_IN)
                {
                    if (g.nodes[x.a].kind == SQN_COL)
                    {
                        for (j = i + 1; j < n; j++)
                        {
                            y = @g.nodes[cj[j]];
                            if (y.kind == SQN_IN) { if (g.nodes[y.a].kind == SQN_COL) { if (g.nodes[y.a].col == g.nodes[x.a].col) { return 1; }; }; };
                        };
                    };
                };
                if (x.kind == SQN_LIKE) { c = sq_vd_exprcol(g, x.a); };
                if (x.kind == SQN_BIN)
                {
                    if (g.nodes[x.a].kind == SQN_FUNC | g.nodes[x.a].kind == SQN_BIN) { c = sq_vd_exprcol(g, x.a); };
                };
                if (c < 0) { continue; };
                for (j = 0; j < n; j++)
                {
                    if (j == i) { continue; };
                    y = @g.nodes[cj[j]];
                    if (y.kind == SQN_BIN)
                    {
                        if ((y.op == SQO_EQ | y.op == SQO_IS) & g.nodes[y.a].kind == SQN_COL) { if (g.nodes[y.a].col == c) { return 1; }; };
                    };
                    if (y.kind == SQN_IN)
                    {
                        if (g.nodes[y.a].kind == SQN_COL) { if (g.nodes[y.a].col == c) { return 1; }; };
                    };
                };
            };
            return 0;
        };

        // the access path of the only source: the planner's kind (0 scan, 1 rowid, 2 index) with its index and covering flag
        def sq_vd_plan(SQ_STMT* g, SQ_EQP* po, SQ_IDX* ixo) -> int
        {
            SQ_EQC* c;
            SQ_BLK* b = g.blks[g.root_blk];
            SQ_SRC* sr = @b.src[0];
            int k;
            c = (SQ_EQC*)fmalloc((u64)(sizeof(SQ_EQC) / 8 + 64));
            if ((u64)c == (u64)0) { return 0 - 1; };
            c.g = g; c.b = b; c.bi = g.root_blk; c.nt = 0; c.nsrc = 1;
            sq_eqp_need(c);
            sq_eqp_term(c, b.where_n);
            c.nix[0] = 0;
            if (sr.kind == 1 & (u64)sr.ti != (u64)0 & sr.tbl >= 0) { c.nix[0] = sq_idx_list(sr.sdb, sr.tbl, sr.ti, @c.ixs[0], 12); };
            sq_eqp_plan(c, 0, 0, po);
            k = po.kind;
            if (k == 2 & po.ix >= 0) { ixo[0] = c.ixs[po.ix]; };
            ffree((u64)c);
            return k;
        };

        // the access path SQLite's planner picks for the only source: 0 full scan, anything else is not generated here
        def sq_vd_plankind(SQ_STMT* g) -> int
        {
            SQ_EQC* c;
            SQ_EQP p;
            SQ_BLK* b = g.blks[g.root_blk];
            SQ_SRC* sr = @b.src[0];
            int k;
            c = (SQ_EQC*)fmalloc((u64)(sizeof(SQ_EQC) / 8 + 64));
            if ((u64)c == (u64)0) { return 0 - 1; };
            c.g = g; c.b = b; c.bi = g.root_blk; c.nt = 0; c.nsrc = 1;
            sq_eqp_need(c);
            sq_eqp_term(c, b.where_n);
            c.nix[0] = 0;
            if (sr.kind == 1 & (u64)sr.ti != (u64)0 & sr.tbl >= 0) { c.nix[0] = sq_idx_list(sr.sdb, sr.tbl, sr.ti, @c.ixs[0], 12); };
            sq_eqp_plan(c, 0, 0, @p);
            k = p.kind;
            ffree((u64)c);
            return k;
        };

        // KeyInfo text of an index: k(n,coll,...) with a trailing entry for the rowid
        def sq_vd_kinfo(SQ_IDX* ix, SQ_SB* t) -> int
        {
            int k, m;
            m = ix.nk + 1;
            if (ix.unique != 0 & ix.uqnn != 0) { m = ix.nk; };
            sq_sb_lit(t, "k(\0");
            sq_sb_int(t, (i64)m);
            for (k = 0; k < ix.nk; k++)
            {
                if (ix.coll[k] != 0) { return 1; };
                sq_sb_lit(t, ",\0");
                if (ix.desc[k] != 0) { sq_sb_lit(t, "-\0"); };
            };
            if (m > ix.nk) { sq_sb_lit(t, ",\0"); };
            sq_sb_lit(t, ")\0");
            return 0;
        };

        // key info of a WITHOUT ROWID secondary index: the key columns then the ex primary key columns not already in it
        def sq_vd_kinfo2(SQ_IDX* ix, int ex, SQ_SB* t) -> int
        {
            int k, m;
            m = ix.nk + ex;
            if (ix.unique != 0 & ix.uqnn != 0) { m = ix.nk; ex = 0; };
            sq_sb_lit(t, "k(\0");
            sq_sb_int(t, (i64)m);
            for (k = 0; k < ix.nk; k++)
            {
                if (ix.coll[k] != 0) { return 1; };
                sq_sb_lit(t, ",\0");
                if (ix.desc[k] != 0) { sq_sb_lit(t, "-\0"); };
            };
            for (k = 0; k < ex; k++) { sq_sb_lit(t, ",\0"); };
            sq_sb_lit(t, ")\0");
            return 0;
        };

        // the covering index a full scan of the only source uses; 1 when there is one (copied to ixo)
        def sq_vd_cover(SQ_STMT* g, SQ_TI* ti, SQ_SRC* sr, SQ_IDX* ixo, int onlyidx) -> int
        {
            SQ_EQC* c;
            int k, r;
            if (sr.tbl < 0) { return 0; };
            c = (SQ_EQC*)fmalloc((u64)(sizeof(SQ_EQC) / 8 + 64));
            if ((u64)c == (u64)0) { return 0; };
            c.g = g; c.b = g.blks[g.root_blk]; c.bi = g.root_blk; c.nt = 0; c.nsrc = 1;
            sq_eqp_need(c);
            c.nix[0] = sq_idx_list(sr.sdb, sr.tbl, ti, @c.ixs[0], 12);
            if (onlyidx == 1)
            {
                // count(*) reads no column: the smallest index
                k = 0 - 1;
                for (r = 0; r < c.nix[0]; r++)
                {
                    if (c.ixs[r].partial != 0) { continue; };
                    if (k < 0) { k = r; } else { if (c.ixs[r].nk <= c.ixs[k].nk) { k = r; }; };
                };
            }
            else { k = sq_eqp_covix(c, 0); };
            r = 0;
            if (k >= 0) { ixo[0] = c.ixs[k]; r = 1; if (sr.idxby == 1) { if (sq_eqp_covers(c, 0, @c.ixs[k]) == 0) { r = 2; }; }; };
            ffree((u64)c);
            return r;
        };

        // 1 when the index holds every column the single-table block reads
        def sq_vd_covers1(SQ_STMT* g, SQ_TI* ti, SQ_SRC* sr, SQ_IDX* ix) -> int
        {
            SQ_EQC* c;
            int r;
            if (sr.tbl < 0) { return 0; };
            c = (SQ_EQC*)fmalloc((u64)(sizeof(SQ_EQC) / 8 + 64));
            if ((u64)c == (u64)0) { return 0; };
            c.g = g; c.b = g.blks[g.root_blk]; c.bi = g.root_blk; c.nt = 0; c.nsrc = 1;
            sq_eqp_need(c);
            r = sq_eqp_covers(c, 0, ix);
            ffree((u64)c);
            return r;
        };

        def sq_vd_dummy() -> void
        {
        };

        def sq_vd_ordmatch(SQ_IDX* ix, int* oc, int n) -> int
        {
            int i;
            if (ix.col[0] != oc[0]) { return 0; };
            if (n == 1) { return 1; };
            for (i = 0; i < n; i++)
            {
                if (oc[i] == 0 - 2) { if (i != ix.nk | i != n - 1) { return 0; }; continue; };
                if (i >= ix.nk) { return 0; };
                if (ix.col[i] != oc[i] | ix.isx[i] != 0 | ix.coll[i] != 0 | ix.desc[i] != 0) { return 0; };
            };
            return 1;
        };

        // ORDER BY one plain column that an index leading on that column already delivers in order
        // returns 1 when the covering index serves it, 2 when a non-covering index plus the table does
        // the storage layout of a WITHOUT ROWID table seen as an index: the key columns first, then the others
        def sq_vd_worsyn(SQ_TI* ti, SQ_SRC* sr, SQ_IDX* w) -> void
        {
            int i, a;
            VD_ISWOR = 1;
            for (i = 0; i < 128; i++) { VD_WORM[i] = 0 - 1; };
            a = 0;
            for (i = 0; i < ti.npk; i++) { VD_WORM[ti.pkc[i]] = a; w.col[i] = ti.pkc[i]; w.coll[i] = ti.coll[ti.pkc[i]]; w.desc[i] = 0; w.isx[i] = 0; a++; };
            for (i = 0; i < ti.ncols; i++) { if (VD_WORM[i] < 0) { VD_WORM[i] = a; a++; }; };
            w.nk = ti.npk; w.unique = 1; w.uqnn = 1; w.partial = 0; w.root = sr.root;
        };

        def sq_vd_ordix0(SQ_STMT* g, SQ_IDX* ixo) -> int
        {
            SQ_BLK* b = g.blks[g.root_blk];
            SQ_SRC* sr = @b.src[0];
            SQ_NODE* nd;
            SQ_IDX[12] ixs;
            int n, i, r, j, okm;
            int[8] oc;
            if (b.nsrc == 1 & b.has_agg == 0)
            {
                if (sr.kind == 1 & (u64)sr.ti != (u64)0)
                {
                    if (sr.ti.wor != 0)
                    {
                        // a WITHOUT ROWID table is already in primary key order
                        if (sr.tbl < 0) { return 0; };
                        for (i = 0; i < b.nord & i < sr.ti.npk; i++)
                        {
                            nd = @g.nodes[b.ord[i]];
                            if (nd.kind == SQN_RESREF) { nd = @g.nodes[b.rc[(int)nd.iv]]; };
                            if (nd.kind != SQN_COL) { return 0; };
                            if (nd.col != sr.ti.pkc[i] | b.ocoll[i] >= 0 | b.onull[i] != 0 | b.odesc[i] != b.odesc[0]) { return 0; };
                        };
                        for (i = sr.ti.npk; i < b.nord; i++) { if ((b.odesc[i] != 0) != (b.odesc[0] != 0)) { return 0; }; };
                        sq_vd_worsyn(sr.ti, sr, ixo);
                        return 1;
                    };
                };
            };
            if (b.nord < 1 | b.nord > 8 | b.nsrc != 1 | b.ocoll[0] >= 0 | b.onull[0] != 0 | b.has_agg != 0) { return 0; };
            if (sr.kind != 1 | (u64)sr.ti == (u64)0 | sr.tbl < 0) { return 0; };
            nd = @g.nodes[b.ord[0]];
            if (nd.kind == SQN_RESREF) { nd = @g.nodes[b.rc[(int)nd.iv]]; };
            if (nd.kind == SQN_ROWID) { return 3; };
            if (nd.kind != SQN_COL) { return 0; };
            if (nd.col == sr.ti.ipk | nd.col == sr.ti.ncols) { return 3; };
            if (nd.col < 0 | nd.col >= sr.ti.ncols) { return 0; };
            oc[0] = nd.col;
            for (i = 1; i < b.nord; i++)
            {
                nd = @g.nodes[b.ord[i]];
                if (nd.kind == SQN_RESREF) { nd = @g.nodes[b.rc[(int)nd.iv]]; };
                if (nd.kind != SQN_COL) { return 0; };
                if (nd.col < 0 | nd.col >= sr.ti.ncols | b.ocoll[i] >= 0 | b.onull[i] != 0) { return 0; };
                if ((b.odesc[i] != 0) != (b.odesc[0] != 0)) { return 0; };
                oc[i] = nd.col;
                if (nd.col == sr.ti.ipk) { oc[i] = 0 - 2; };
            };
            r = sq_vd_cover(g, sr.ti, sr, ixo, 0);
            if (r == 1)
            {
                if (sq_vd_ordmatch(ixo, @oc[0], b.nord) == 1) { return 1; };
                if (b.nord == 1) { return 0; };
                n = sq_idx_list(sr.sdb, sr.tbl, sr.ti, @ixs[0], 12);
                for (i = n - 1; i >= 0; i--)
                {
                    if (ixs[i].partial != 0) { continue; };
                    if (sq_vd_ordmatch(@ixs[i], @oc[0], b.nord) == 1) { if (sq_vd_covers1(g, sr.ti, sr, @ixs[i]) == 1) { ixo[0] = ixs[i]; return 1; }; };
                };
                return 0;
            };
            n = sq_idx_list(sr.sdb, sr.tbl, sr.ti, @ixs[0], 12);
            for (i = 0; i < n; i++)
            {
                if (ixs[i].partial != 0) { continue; };
                if (sq_vd_ordmatch(@ixs[i], @oc[0], b.nord) == 1) { ixo[0] = ixs[i]; return 2; };
            };
            return 0;
        };

        int VD_AGGNB = 0;
int VD_AGGNR = 0;
int VD_AGGLO = 0;
int VD_AGGHL = 0;
int VD_AGGHO = 0;
int VD_ORDN0 = 0;

        // ORDER BY served by an index whose leading columns the WHERE pins with constant equalities
        def sq_vd_dupord(SQ_STMT* g, SQ_BLK* b) -> int
        {
            int i, j;
            for (i = 0; i < b.nord; i++) { for (j = 0; j < i; j++) { if (g.nodes[b.ord[i]].kind == SQN_COL & g.nodes[b.ord[j]].kind == SQN_COL) { if (g.nodes[b.ord[i]].col == g.nodes[b.ord[j]].col & g.nodes[b.ord[i]].src == g.nodes[b.ord[j]].src) { return 1; }; }; }; };
            return 0;
        };

        def sq_vd_ordixb(SQ_STMT* g, SQ_IDX* ixo) -> int;

        def sq_vd_ordix(SQ_STMT* g, SQ_IDX* ixo) -> int
        {
            SQ_BLK* b = g.blks[g.root_blk];
            int[8] so, sd, sc, sn;
            int i, j, k, n0, r, dup, keep, fd;
            VD_ORDN0 = 0;
            if (b.nord < 2 | b.nord > 8) { return sq_vd_ordixb(g, ixo); };
            if (sq_vd_dupord(g, b) == 0) { return sq_vd_ordixb(g, ixo); };
            n0 = b.nord; VD_ORDN0 = 0;
            for (i = 0; i < n0; i++) { so[i] = b.ord[i]; sd[i] = b.odesc[i]; sc[i] = b.ocoll[i]; sn[i] = b.onull[i]; };
            k = 0;
            for (i = 0; i < n0; i++)
            {
                dup = 0;
                for (j = 0; j < k; j++)
                {
                    if (g.nodes[b.ord[i]].kind == SQN_COL & g.nodes[b.ord[j]].kind == SQN_COL)
                    {
                        if (g.nodes[b.ord[i]].col == g.nodes[b.ord[j]].col & g.nodes[b.ord[i]].src == g.nodes[b.ord[j]].src) { dup = 1; };
                    };
                };
                if (dup == 0)
                {
                    b.ord[k] = b.ord[i]; b.odesc[k] = b.odesc[i]; b.ocoll[k] = b.ocoll[i]; b.onull[k] = b.onull[i];
                    k++;
                };
            };
            b.nord = k;
            r = sq_vd_ordixb(g, ixo);
            keep = 0;
            if (r == 3) { keep = 1; };
            if (r != 0 & b.src[0].kind == 1 & (u64)b.src[0].ti != (u64)0)
            {
                fd = 0 - 1;
                for (i = 0; i < n0 & fd < 0; i++) { for (j = 0; j < i; j++) { if (g.nodes[so[i]].kind == SQN_COL & g.nodes[so[j]].kind == SQN_COL) { if (g.nodes[so[i]].col == g.nodes[so[j]].col & g.nodes[so[i]].src == g.nodes[so[j]].src) { if (fd < 0) { fd = i; }; }; }; }; };
                for (j = 0; j < fd; j++) { if (g.nodes[so[j]].kind == SQN_COL) { if (g.nodes[so[j]].col == b.src[0].ti.ipk & b.src[0].ti.ipk >= 0) { keep = 1; }; }; };
            };
            if (keep == 1) { VD_ORDN0 = n0; };
            if (keep == 0)
            {
                b.nord = n0;
                for (i = 0; i < n0; i++) { b.ord[i] = so[i]; b.odesc[i] = sd[i]; b.ocoll[i] = sc[i]; b.onull[i] = sn[i]; };
            };
            if (keep == 0) { return 0; };
            return r;
        };

        def sq_vd_ordixb(SQ_STMT* g, SQ_IDX* ixo) -> int
        {
            SQ_BLK* b = g.blks[g.root_blk];
            SQ_SRC* sr = @b.src[0];
            SQ_NODE* nd;
            SQ_NODE* t;
            SQ_IDX[12] ixs;
            SQ_IDX tmp;
            int[8] oc;
            int[16] cj;
            int r, n, i, j, k, q, p, ncj, ok, pin;
            if (b.where_n >= 0 & b.nord >= 1 & b.nord <= 8 & b.nsrc == 1)
            {
                ncj = 0;
                sq_vd_split(g, b.where_n, @cj[0], @ncj);
                for (i = 0; i < b.nord; i++)
                {
                    nd = @g.nodes[b.ord[i]];
                    if (nd.kind == SQN_RESREF) { nd = @g.nodes[b.rc[(int)nd.iv]]; };
                    if (nd.kind != SQN_COL) { continue; };
                    for (j = 0; j < ncj; j++)
                    {
                        t = @g.nodes[cj[j]];
                        if (t.kind == SQN_ISNULL & t.op == 1)
                        {
                            if (g.nodes[t.a].kind == SQN_COL) { if (g.nodes[t.a].col == nd.col) { return 0; }; };
                            continue;
                        };
                        if (t.kind != SQN_BIN | t.op != SQO_EQ) { continue; };
                        if (g.nodes[t.a].kind != SQN_COL) { continue; };
                        if (g.nodes[t.a].col != nd.col) { continue; };
                        if (sq_vd_isconst(g, t.b) == false | g.nodes[t.b].kind == SQN_NULL) { continue; };
                        return 0;
                    };
                };
            };
            r = sq_vd_ordix0(g, ixo);
            if (r != 0) { return r; };
            if (b.where_n < 0 | b.nord < 1 | b.nord > 8 | b.nsrc != 1 | b.ocoll[0] >= 0 | b.onull[0] != 0 | b.has_agg != 0) { return 0; };
            if (sr.kind != 1 | (u64)sr.ti == (u64)0 | sr.tbl < 0 | sr.ti.wor != 0) { return 0; };
            for (i = 0; i < b.nord; i++)
            {
                nd = @g.nodes[b.ord[i]];
                if (nd.kind == SQN_RESREF) { nd = @g.nodes[b.rc[(int)nd.iv]]; };
                if (nd.kind != SQN_COL) { return 0; };
                if (nd.col < 0 | nd.col >= sr.ti.ncols | nd.col == sr.ti.ipk | b.ocoll[i] >= 0 | b.onull[i] != 0) { return 0; };
                if ((b.odesc[i] != 0) != (b.odesc[0] != 0)) { return 0; };
                oc[i] = nd.col;
            };
            ncj = 0;
            sq_vd_split(g, b.where_n, @cj[0], @ncj);
            n = sq_idx_list(sr.sdb, sr.tbl, sr.ti, @ixs[0], 12);
            for (i = 0; i < n; i++)
            {
                if (ixs[i].partial != 0) { continue; };
                for (p = 1; p < ixs[i].nk; p++)
                {
                    ok = 1;
                    for (q = 0; q < p; q++)
                    {
                        pin = 0;
                        for (j = 0; j < ncj; j++)
                        {
                            t = @g.nodes[cj[j]];
                            if (t.kind != SQN_BIN | t.op != SQO_EQ) { continue; };
                            if (g.nodes[t.a].kind != SQN_COL) { continue; };
                            if (g.nodes[t.a].col != ixs[i].col[q]) { continue; };
                            if (sq_vd_isconst(g, t.b) == false | g.nodes[t.b].kind == SQN_NULL) { continue; };
                            pin = 1; break;
                        };
                        if (pin == 0) { ok = 0; break; };
                    };
                    if (ok == 0) { break; };
                    tmp = ixs[i];
                    for (k = 0; k + p < ixs[i].nk; k++)
                    {
                        tmp.col[k] = ixs[i].col[k + p]; tmp.isx[k] = ixs[i].isx[k + p];
                        tmp.coll[k] = ixs[i].coll[k + p]; tmp.desc[k] = ixs[i].desc[k + p];
                    };
                    tmp.nk = ixs[i].nk - p;
                    if (sq_vd_ordmatch(@tmp, @oc[0], b.nord) == 1)
                    {
                        ixo[0] = ixs[i];
                        if (sq_vd_covers1(g, sr.ti, sr, @ixs[i]) == 1) { return 1; };
                        return 2;
                    };
                };
            };
            return 0;
        };

        // 1 when a result column is a min() or max() call
        // 1 when the only aggregate of the block is a single min()
        def sq_vd_onlymin(SQ_STMT* g, SQ_BLK* b) -> int
        {
            int i, k, nm;
            SQ_NODE* nd;
            nm = 0;
            if (b.has_agg == 0 | b.nagg != 1) { return 0; };
            for (i = 0; i < g.nn; i++)
            {
                nd = @g.nodes[i];
                if (nd.kind != SQN_FUNC) { continue; };
                k = sq_func_id(@g.sql[nd.s], nd.sl, (int)nd.iv);
                if (k == 104) { nm++; };
            };
            if (nm == 1) { return 1; };
            return 0;
        };

        def sq_vd_hasmm(SQ_STMT* g, SQ_BLK* b) -> int
        {
            int i, k;
            SQ_NODE* nd;
            for (i = 0; i < b.nres; i++)
            {
                nd = @g.nodes[b.rc[i]];
                if (nd.kind != SQN_FUNC) { continue; };
                k = sq_func_id(@g.sql[nd.s], nd.sl, (int)nd.iv);
                if (k == 104 | k == 105) { return 1; };
            };
            return 0;
        };

        // a positive IN list on the leading column of the index that serves the ORDER BY
        def sq_vd_inlead(SQ_STMT* g, int ni, SQ_IDX* oix) -> int
        {
            SQ_NODE* nd = @g.nodes[ni];
            if (nd.kind != SQN_IN | nd.op != 1 | nd.blk >= 0 | nd.a < 0 | nd.b < 0) { return 0; };
            if (g.nodes[nd.a].kind != SQN_COL) { return 0; };
            if (g.nodes[nd.a].lvl != 0 | g.nodes[nd.a].owner != g.root_blk) { return 0; };
            if (oix.isx[0] != 0 | oix.partial != 0) { return 0; };
            if (g.nodes[nd.a].col != oix.col[0]) { return 0; };
            return 1;
        };

        // ORDER BY ... LIMIT: rows go through an ephemeral index that keeps only the best limit+offset rows
        global int VD_PRN = 0;
        global int VD_AGS = 0;
        def sq_vd_pread(int cov, int pp, SQ_IDX* ix, int tc, int col, int r, int ipk) -> void;

        global int[8] VD_CKV;
        global int VD_NCK;
        def sq_vd_dropipk(SQ_STMT* g, SQ_TI* ti, int ni) -> int;
        global int VD_CKN2 = 0;
        global int[8] VD_CKR2;
        global int[8] VD_CKCL;
        def sq_vd_ckdup(int* ckr, int i) -> int
        {
            int j;
            for (j = 0; j < i; j++) { if (VD_CKCL[j] == VD_CKCL[i] & VD_CKV[j] == VD_CKV[i] & VD_CKCL[i] > 0 - 5 & sq_vd_gon(943) == 0) { return j; }; };
            return 0 - 1;
        };
        global int[8] VD_CKJ2;

        // pre-loop tests of constant primary key null checks (sorted paths): IfNot over a hoisted register
        def sq_vd_ckpre() -> int
        {
            int i, k;
            for (i = 0; i < VD_NCK; i++)
            {
                k = sq_vd_ckdup(@VD_CKR2[0], i);
                if (k >= 0) { VD_CKR2[i] = VD_CKR2[k]; } else { VD_CKR2[i] = sq_vd_getreg(); };
                VD_CKJ2[i] = sq_vd_op("IfNot\0", VD_CKR2[i], 0, 1);
            };
            VD_CKN2 = VD_NCK;
            return 0;
        };

        def sq_vd_ckpatch() -> int
        {
            int i;
            for (i = 0; i < VD_CKN2; i++) { VD_P2[VD_CKJ2[i]] = VD_N; };
            return 0;
        };

        def sq_vd_ckfin() -> int
        {
            int i;
            for (i = 0; i < VD_CKN2; i++) { if (sq_vd_ckdup(@VD_CKR2[0], i) < 0) { sq_vd_op("Integer\0", VD_CKV[i], VD_CKR2[i], 0); }; };
            VD_CKN2 = 0;
            return 0;
        };

        def sq_vd_sortlim(SQ_STMT* st, SQ_STMT* g, SQ_BLK* b, SQ_SRC* sr, SQ_TI* ti, int nk, int nres, int nd2, int off, int lreg, int ho, int init, int rew, int body, int* kcol, int* rcol, int* pos, int cov, SQ_IDX* cix, int tc) -> int
        {
            int i, a, sq, ifn, ile, dl, nxt, srt, loop, ip, obase, rec, lim, hxp;
            hxp = 0;
            if (nk > 0) { for (i = 0; i < nk; i++) { if (kcol[i] < 0 - 50) { hxp = 1; }; }; };
            if (hxp == 1) { VD_NMEM = off + nk + 1 + nres; };
            for (i = 0; i < nk; i++)
            {
                if (kcol[i] < 0 - 50)
                {
                    if (sq_vd_expr(g, ti, 0 - 100 - kcol[i], off + 1 + i) != 0) { if (sq_vd_gon(100) == 1) { sq_seterr(st, "EXPLAIN is not available for this expression #100\0"); return 1; }; };
                    continue;
                };
                sq_vd_pread(cov, 0, cix, tc, kcol[i], off + 1 + i, ti.ipk);
                if (ti.aff[kcol[i]] == 4) { sq_vd_op("RealAffinity\0", off + 1 + i, 0, 0); };
            };
            sq = sq_vd_op("Sequence\0", 1, off + nk + 1, 0);
            if (ho == 1) { lim = 3; } else { lim = 1; };
            obase = off + nk + 2;
            rec = obase + nres;
            ifn = sq_vd_op("IfNotZero\0", lim, 0, 0);
            sq_vd_op("Last\0", 1, 0, 0);
            ile = sq_vd_op("IdxLE\0", 1, 0, off + 1);
            sq_vd_p4i(ile, (i64)nk);
            sq_vd_op("Delete\0", 1, 0, 0);
            VD_P2[ifn] = VD_N;
            for (i = 0; i < nres; i++)
            {
                if (pos[i] >= nk) { sq_vd_pread(cov, 0, cix, tc, rcol[i], off + 2 + pos[i], ti.ipk); if (rcol[i] < ti.ncols & ti.aff[rcol[i]] == 4) { sq_vd_op("RealAffinity\0", off + 2 + pos[i], 0, 0); }; };
            };
            if (hxp == 1) { if (VD_NMEM + 1 > rec) { rec = VD_NMEM + 1; }; };
            sq_vd_op("MakeRecord\0", off + 1, nk + 1 + nd2, rec);
            a = sq_vd_op("IdxInsert\0", 1, rec, off + 1);
            sq_vd_p4i(a, (i64)(nk + 1 + nd2));
            nxt = VD_N;
            VD_P2[ile] = nxt;
            a = sq_vd_op("Next\0", tc, body, 0);
            VD_P5[a] = 1;
            VD_P2[rew] = VD_N;
            sq_vd_ckpatch();
            for (i = 0; i < VD_NJ; i++) { VD_P2[VD_JF[i]] = nxt; };
            srt = sq_vd_op("Sort\0", 1, 0, 0);
            loop = VD_N;
            if (ho == 1)
            {
                ip = sq_vd_op("IfPos\0", 2, 0, 1);
                sq_vd_op("AddImm\0", 1, 0 - 1, 0);
            };
            for (i = nres - 1; i >= 0; i--)
            {
                if (pos[i] < nk) { sq_vd_op("Column\0", 1, pos[i], obase + i); } else { sq_vd_op("Column\0", 1, pos[i] + 1, obase + i); };
            };
            sq_vd_op("ResultRow\0", obase, nres, 0);
            a = sq_vd_op("Next\0", 1, loop, 0);
            if (ho == 1) { VD_P2[ip] = a; };
            VD_P2[srt] = VD_N;
            sq_vd_op("Halt\0", 0, 0, 0);
            VD_P2[init] = VD_N;
            sq_vd_trans(g.db, 0);
            sq_vd_ckfin();
            for (i = 0; i < VD_NH; i++) { sq_vd_lit(g, VD_HN[i], VD_HR[i]); };
            sq_vd_op("Goto\0", 0, 1, 0);
            return 0;
        };

        // position of table column col in the entries of the covering index ix, or col itself when the table is read
        def sq_vd_srcpos(int cov, SQ_IDX* ix, int col) -> int
        {
            int k;
            if (cov == 0) { return col; };
            if (VD_ISWOR == 1) { return VD_WORM[col]; };
            for (k = 0; k < ix.nk; k++) { if (ix.col[k] == col) { return k; }; };
            return col;
        };

        // appends the sorter KeyInfo name of collation id c (-1 default)
        def sq_vd_cname(SQ_SB* t, int c) -> void
        {
            if (c == 1) { sq_sb_lit(t, "NOCASE\0"); return; };
            if (c == 2) { sq_sb_lit(t, "RTRIM\0"); return; };
            sq_sb_lit(t, "B\0");
        };

        // one plain-column read for the sorter: from the index when it holds the column, else from the table
        def sq_vd_pread(int cov, int pp, SQ_IDX* ix, int tc, int col, int r, int ipk) -> void
        {
            int k;
            if ((col == ipk & ipk >= 0) | (col >= 0 & col + 1 == VD_PRN))
            {
                if (pp == 1 | cov == 1) { sq_vd_op("IdxRowid\0", tc, r, 0); } else { sq_vd_op("Rowid\0", tc, r, 0); };
                return;
            };
            if (pp == 1 & cov == 0)
            {
                for (k = 0; k < ix.nk; k++) { if (ix.col[k] == col) { sq_vd_op("Column\0", tc, k, r); return; }; };
                sq_vd_op("Column\0", 0, col, r);
                return;
            };
            sq_vd_op("Column\0", tc, sq_vd_srcpos(cov, ix, col), r);
        };

        // ORDER BY where an index already delivers the first np terms in order: rows are sorted a prefix group at a time
        global int VD_PML;
        global int VD_PMU;

        // a WHERE made only of integer range bounds on the leading primary key column of a WITHOUT ROWID table: returns 1 and the lower and upper bound nodes
        def sq_vd_wrb(SQ_STMT* g, SQ_BLK* b, SQ_TI* ti, int* ml, int* mu) -> int
        {
            int[16] wj;
            int nwj, i;
            SQ_NODE* w;
            SQ_NODE* l;
            ml[0] = 0 - 1; mu[0] = 0 - 1;
            if (ti.wor == 0 | ti.npk <= 0 | b.where_n < 0) { return 0; };
            nwj = 0;
            sq_vd_splitx(g, b.where_n, @wj[0], @nwj);
            if (nwj < 1 | nwj > 2) { return 0; };
            for (i = 0; i < nwj; i++)
            {
                w = @g.nodes[wj[i]];
                if (w.kind != SQN_BIN) { return 0; };
                if (g.nodes[w.b].kind != SQN_INT) { return 0; };
                l = @g.nodes[w.a];
                if (l.kind != SQN_COL) { return 0; };
                if (l.col != ti.pkc[0] | l.lvl != 0 | l.owner != g.root_blk) { return 0; };
                if (w.op == SQO_GT | w.op == SQO_GE) { if (ml[0] >= 0) { return 0; }; ml[0] = wj[i]; }
                else if (w.op == SQO_LT | w.op == SQO_LE) { if (mu[0] >= 0) { return 0; }; mu[0] = wj[i]; }
                else { return 0; };
            };
            return 1;
        };

        def sq_vd_psort(SQ_STMT* st, SQ_STMT* g, SQ_BLK* b, SQ_SRC* sr, SQ_TI* ti, SQ_IDX* ix, int cov, int np, int rev, int nk, int nres, int maxc, int* kcol, int* rcol, int* kco, int hl, int ho) -> int
        {
            SQ_SB kt;
            int[130] pos;
            int pchk, pbd, pk, lreg, ifn, ile, hlt2, hlstar, i, j, a, nrem, nd2, off, outr, prev, ret, dreg, base, init, sn, rew, body, nxt, g1, g2, sc, seq, mv, sub, ss, sd, hlt, tc, pc, fld;
            if (VD_PRN != 0) { if (sq_vd_gon(807) == 1) { sq_seterr(st, "EXPLAIN is not available for this expression #807\0"); return 1; }; };
            nrem = nk - np;
            hlstar = 0;
            for (i = 0; g.sql[i] != (byte)0; i++) { if (g.sql[i] == (byte)42) { hlstar = 1; }; };
            tc = 2; pc = 3;
            nd2 = 0;
            for (i = 0; i < nres; i++)
            {
                pos[i] = 0 - 1;
                for (j = np; j < nk; j++) { if (kcol[j] == rcol[i] & kco[j] < 0) { pos[i] = j - np; }; };
                if (pos[i] >= 0) { for (j = i + 1; j < nres; j++) { if (rcol[j] == rcol[i]) { pos[i] = 0 - 1; }; }; };
                if (pos[i] < 0) { pos[i] = nrem + nd2; nd2++; };
            };
            fld = nrem + nd2;
            sq_vd_reset();
            init = sq_vd_op("Init\0", 0, 0, 0);
            if (hl == 1) { sn = sq_vd_op("OpenEphemeral\0", 1, fld + 1, 0); } else { sn = sq_vd_op("SorterOpen\0", 1, fld, 0); };
            sq_sb_init(@kt);
            sq_sb_lit(@kt, "k(\0");
            sq_sb_int(@kt, (i64)nrem);
            for (i = np; i < nk; i++)
            {
                sq_sb_lit(@kt, ",\0");
                if (b.odesc[i] != 0) { sq_sb_lit(@kt, "-\0"); };
                if ((b.odesc[i] == 0 & b.onull[i] == 2) | (b.odesc[i] != 0 & b.onull[i] == 1)) { sq_sb_lit(@kt, "N.\0"); };
                sq_vd_cname(@kt, kco[i]);
            };
            sq_sb_lit(@kt, ")\0");
            sq_vd_p4s(sn, kt.p, kt.n);
            sq_sb_free(@kt);
            lreg = 0;
            if (hl == 1)
            {
                lreg = 1;
                sq_vd_lit(g, b.limit_n, 1);
                if (ho == 1)
                {
                    sq_vd_lit(g, b.offset_n, 2);
                    sq_vd_op("MustBeInt\0", 2, 0, 0);
                    sq_vd_op("OffsetLimit\0", 1, 3, 2);
                    lreg = 3;
                };
            };
            VD_NCK = 0; VD_CKN2 = 0;
            if (b.where_n >= 0 & VD_KEEP == 0 & ti.wor != 0 & sq_vd_gon(674) == 0)
            {
                b.where_n = sq_vd_dropipk(g, ti, b.where_n);
                VD_NMEM = lreg; VD_NFREE = 0;
                sq_vd_ckpre();
            };
            if (cov == 0)
            {
                a = sq_vd_op("OpenRead\0", 0, sr.root, 0);
                sq_vd_p4i(a, (i64)(maxc + 1));
            };
            a = sq_vd_op("OpenRead\0", tc, ix.root, 0);
            sq_sb_init(@kt);
            if (sq_vd_kinfo(ix, @kt) != 0) { sq_sb_free(@kt); sq_seterr(st, "EXPLAIN is not available for this index collation\0"); return 1; };
            sq_vd_p4s(a, kt.p, kt.n);
            sq_sb_free(@kt);
            VD_NMEM = lreg + VD_CKN2; VD_NH = 0; VD_NH0 = 0;
            VD_NFREE = 0; VD_NJ = 0; VD_COLCUR = 0; VD_IDXCUR = 0;
            pchk = 0 - 1; pbd = 0;
            if (VD_PML > 0 | VD_PMU > 0)
            {
                pbd = 1;
                VD_NMEM++;
                pk = VD_NMEM;
                if (rev == 1)
                {
                    if (VD_PMU > 0)
                    {
                        sq_vd_rlit(g, VD_PMU - 1, pk, 1);
                        if (g.nodes[VD_PMU - 1].op == SQO_LT) { rew = sq_vd_op("SeekLT\0", tc, 0, pk); } else { rew = sq_vd_op("SeekLE\0", tc, 0, pk); };
                        sq_vd_p4i(rew, 1);
                        if (VD_PML > 0)
                        {
                            sq_vd_rlit(g, VD_PML - 1, pk, 0);
                            if (g.nodes[VD_PML - 1].op == SQO_GT) { pchk = sq_vd_op("IdxLE\0", tc, 0, pk); } else { pchk = sq_vd_op("IdxLT\0", tc, 0, pk); };
                            sq_vd_p4i(pchk, 1);
                        };
                    }
                    else
                    {
                        rew = sq_vd_op("Last\0", tc, 0, pk);
                        sq_vd_p4i(rew, 0);
                        sq_vd_rlit(g, VD_PML - 1, pk, 0);
                        if (g.nodes[VD_PML - 1].op == SQO_GT) { pchk = sq_vd_op("IdxLE\0", tc, 0, pk); } else { pchk = sq_vd_op("IdxLT\0", tc, 0, pk); };
                        sq_vd_p4i(pchk, 1);
                    };
                }
                else
                {
                    if (VD_PML > 0)
                    {
                        sq_vd_rlit(g, VD_PML - 1, pk, 0);
                        if (g.nodes[VD_PML - 1].op == SQO_GT) { rew = sq_vd_op("SeekGT\0", tc, 0, pk); } else { rew = sq_vd_op("SeekGE\0", tc, 0, pk); };
                        sq_vd_p4i(rew, 1);
                    }
                    else
                    {
                        rew = sq_vd_op("Rewind\0", tc, 0, pk);
                        sq_vd_p4i(rew, 0);
                    };
                    if (VD_PMU > 0)
                    {
                        sq_vd_rlit(g, VD_PMU - 1, pk, 1);
                        if (g.nodes[VD_PMU - 1].op == SQO_LT) { pchk = sq_vd_op("IdxGE\0", tc, 0, pk); } else { pchk = sq_vd_op("IdxGT\0", tc, 0, pk); };
                        sq_vd_p4i(pchk, 1);
                    };
                };
            }
            else
            {
                if (rev == 1) { rew = sq_vd_op("Last\0", tc, 0, 0); } else { rew = sq_vd_op("Rewind\0", tc, 0, 0); };
                VD_P3[rew] = VD_NMEM + 1;
                sq_vd_p4i(rew, 0);
            };
            if (cov == 1) { VD_COLCUR = tc; } else { VD_COLCUR = 0; };
            VD_IDXCUR = tc;
            sq_vd_setix(ix);
            body = VD_N;
            if (pchk >= 0) { body = pchk; };
            if (cov == 0) { sq_vd_op("DeferredSeek\0", tc, 0, 0); };
            if (b.where_n >= 0 & pbd == 0)
            {
                if (sq_vd_where(g, ti, b.where_n) != 0) { if (sq_vd_gon(101) == 1) { sq_seterr(st, "EXPLAIN is not available for this WHERE clause #101\0"); return 1; }; };
            };
            off = VD_NMEM;
            outr = off + nk + nres + 1;
            base = off + nk + 1;
            if (hl == 1) { base = off + nk + 2; outr = base + nres; };
            prev = outr + 1;
            ret = prev + np;
            dreg = ret + 1;
            if (hl == 1)
            {
                for (i = 0; i < np; i++)
                {
                    sq_vd_pread(cov, 1, ix, tc, kcol[i], off + 1 + i, ti.ipk);
                    if (ti.aff[kcol[i]] == 4) { sq_vd_op("RealAffinity\0", off + 1 + i, 0, 0); };
                };
                for (i = np; i < nk; i++) { sq_vd_pread(cov, 1, ix, tc, kcol[i], off + 1 + i, ti.ipk); if (ti.aff[kcol[i]] == 4) { sq_vd_op("RealAffinity\0", off + 1 + i, 0, 0); }; };
                seq = sq_vd_op("Sequence\0", 1, off + nk + 1, 0);
                for (i = 0; i < nres; i++)
                {
                    if (pos[i] >= nrem) { sq_vd_pread(cov, 1, ix, tc, rcol[i], off + np + 2 + pos[i], ti.ipk); if (rcol[i] < ti.ncols & ti.aff[rcol[i]] == 4) { sq_vd_op("RealAffinity\0", off + np + 2 + pos[i], 0, 0); }; };
                };
                sq_vd_op("MakeRecord\0", off + np + 1, fld + 1, outr);
                sc = sq_vd_op("IfNot\0", off + nk + 1, 0, 0);
                a = sq_vd_op("Compare\0", prev, off + 1, np);
                sq_sb_init(@kt);
                sq_sb_lit(@kt, "k(\0");
                sq_sb_int(@kt, (i64)nk);
                for (i = 0; i < nk; i++) { sq_sb_lit(@kt, ",B\0"); };
                sq_sb_lit(@kt, ")\0");
                sq_vd_p4s(a, kt.p, kt.n);
                sq_sb_free(@kt);
                j = sq_vd_op("Jump\0", VD_N + 1, 0, VD_N + 1);
                g1 = sq_vd_op("Gosub\0", ret, 0, 0);
                sq_vd_op("ResetSorter\0", 1, 0, 0);
                hlt2 = sq_vd_op("IfNot\0", lreg, 0, 0);
                mv = sq_vd_op("Move\0", off + 1, prev, np);
                VD_P2[sc] = mv;
                VD_P2[j] = VD_N;
                ifn = sq_vd_op("IfNotZero\0", lreg, 0, 0);
                sq_vd_op("Last\0", 1, 0, 0);
                ile = sq_vd_op("IdxLE\0", 1, 0, off + np + 1);
                sq_vd_p4i(ile, (i64)nrem);
                sq_vd_op("Delete\0", 1, 0, 0);
                VD_P2[ifn] = VD_N;
                a = sq_vd_op("IdxInsert\0", 1, outr, off + np + 1);
                sq_vd_p4i(a, (i64)(fld + 1));
                nxt = VD_N;
                VD_P2[ile] = nxt;
                if (rev == 1) { a = sq_vd_op("Prev\0", tc, body, 0); } else { a = sq_vd_op("Next\0", tc, body, 0); };
                if (pbd == 0) { VD_P5[a] = 1; };
                VD_P2[rew] = VD_N;
                sq_vd_ckpatch();
                if (pchk >= 0) { VD_P2[pchk] = VD_N; };
                for (i = 0; i < VD_NJ; i++) { VD_P2[VD_JF[i]] = nxt; };
                g2 = sq_vd_op("Gosub\0", ret, 0, 0);
                hlt = sq_vd_op("Goto\0", 0, 0, 0);
                sub = sq_vd_op("Sort\0", 1, 0, 0);
                ss = sub;
                sd = VD_N;
                if (ho == 1)
                {
                    mv = sq_vd_op("IfPos\0", 2, 0, 1);
                    sq_vd_op("AddImm\0", 1, 0 - 1, 0);
                };
                for (i = nres - 1; i >= 0; i--)
                {
                    if (pos[i] < nrem) { sq_vd_op("Column\0", 1, pos[i], base + i); } else { sq_vd_op("Column\0", 1, pos[i] + 1, base + i); };
                };
                sq_vd_op("ResultRow\0", base, nres, 0);
                a = sq_vd_op("Next\0", 1, sd, 0);
                if (ho == 1) { VD_P2[mv] = a; };
                sq_vd_op("Return\0", ret, 0, 0);
                VD_P2[g1] = sub; VD_P2[g2] = sub;
                VD_P2[ss] = VD_N; VD_P2[hlt] = VD_N; VD_P2[hlt2] = VD_N;
                sq_vd_op("Halt\0", 0, 0, 0);
                VD_P2[init] = VD_N;
                sq_vd_trans(g.db, 0);
                sq_vd_ckfin();
                for (i = VD_NH0; i < VD_NH; i++) { sq_vd_lit(g, VD_HN[i], VD_HR[i]); };
                sq_vd_op("Goto\0", 0, 1, 0);
                return 0;
            };
            for (i = 0; i < nres; i++)
            {
                if (pos[i] >= nrem) { sq_vd_pread(cov, 1, ix, tc, rcol[i], off + np + 1 + pos[i], ti.ipk); if (rcol[i] < ti.ncols & ti.aff[rcol[i]] == 4) { sq_vd_op("RealAffinity\0", off + np + 1 + pos[i], 0, 0); }; };
            };
            for (i = 0; i < np; i++)
            {
                sc = 0 - 1;
                if (hlstar == 0) { for (j = 0; j < nres; j++) { if (rcol[j] == kcol[i] & pos[j] >= nrem & kco[i] < 0) { sc = j; break; }; }; };
                if (sc >= 0 & nk > np & sq_vd_gon(739) == 1) { sq_seterr(st, "EXPLAIN is not available for this ORDER BY #739\0"); return 1; };
                if (sc >= 0) { sq_vd_op("Copy\0", off + np + 1 + pos[sc], off + 1 + i, 0); continue; };
                sq_vd_pread(cov, 1, ix, tc, kcol[i], off + 1 + i, ti.ipk);
                if (ti.aff[kcol[i]] == 4) { sq_vd_op("RealAffinity\0", off + 1 + i, 0, 0); };
            };
            for (i = np; i < nk; i++) { sq_vd_pread(cov, 1, ix, tc, kcol[i], off + 1 + i, ti.ipk); if (ti.aff[kcol[i]] == 4) { sq_vd_op("RealAffinity\0", off + 1 + i, 0, 0); }; };
            sq_vd_op("MakeRecord\0", off + np + 1, fld, outr);
            seq = sq_vd_op("SequenceTest\0", 1, 0, 0);
            a = sq_vd_op("Compare\0", prev, off + 1, np);
            sq_sb_init(@kt);
            sq_sb_lit(@kt, "k(\0");
            sq_sb_int(@kt, (i64)nk);
            for (i = 0; i < nk; i++) { sq_sb_lit(@kt, ",B\0"); };
            sq_sb_lit(@kt, ")\0");
            sq_vd_p4s(a, kt.p, kt.n);
            sq_sb_free(@kt);
            j = sq_vd_op("Jump\0", VD_N + 1, 0, VD_N + 1);
            g1 = sq_vd_op("Gosub\0", ret, 0, 0);
            sq_vd_op("ResetSorter\0", 1, 0, 0);
            mv = sq_vd_op("Move\0", off + 1, prev, np);
            VD_P2[seq] = mv;
            VD_P2[j] = VD_N;
            a = sq_vd_op("SorterInsert\0", 1, outr, off + np + 1);
            sq_vd_p4i(a, (i64)fld);
            nxt = VD_N;
            if (rev == 1) { a = sq_vd_op("Prev\0", tc, body, 0); } else { a = sq_vd_op("Next\0", tc, body, 0); };
            if (pbd == 0) { VD_P5[a] = 1; };
            VD_P2[rew] = VD_N;
            sq_vd_ckpatch();
                if (pchk >= 0) { VD_P2[pchk] = VD_N; };
            for (i = 0; i < VD_NJ; i++) { VD_P2[VD_JF[i]] = nxt; };
            g2 = sq_vd_op("Gosub\0", ret, 0, 0);
            hlt = sq_vd_op("Goto\0", 0, 0, 0);
            sub = sq_vd_op("Once\0", 0, 0, 0);
            sq_vd_op("OpenPseudo\0", pc, dreg, nrem + nres + 1);
            VD_P2[sub] = VD_N;
            ss = sq_vd_op("SorterSort\0", 1, 0, 0);
            sd = sq_vd_op("SorterData\0", 1, dreg, pc);
            for (i = nres - 1; i >= 0; i--) { sq_vd_op("Column\0", pc, pos[i], base + i); };
            sq_vd_op("ResultRow\0", base, nres, 0);
            sq_vd_op("SorterNext\0", 1, sd, 0);
            sq_vd_op("Return\0", ret, 0, 0);
            VD_P2[g1] = sub; VD_P2[g2] = sub;
            VD_P2[ss] = VD_N; VD_P2[hlt] = VD_N;
            sq_vd_op("Halt\0", 0, 0, 0);
            VD_P2[init] = VD_N;
            sq_vd_trans(g.db, 0);
            sq_vd_ckfin();
            for (i = VD_NH0; i < VD_NH; i++) { sq_vd_lit(g, VD_HN[i], VD_HR[i]); };
            sq_vd_op("Goto\0", 0, 1, 0);
            return 0;
        };

        // SELECT of plain columns from one plain table with ORDER BY on plain columns, sorted through the sorter
        // structural equality of two expression trees (plain columns, constants, operators and functions)
        def sq_vd_deq(SQ_STMT* g, int i, int j) -> int
        {
            SQ_NODE* x;
            SQ_NODE* y;
            int p, q, n;
            if (i < 0 | j < 0) { if (i < 0 & j < 0) { return 1; }; return 0; };
            x = @g.nodes[i]; y = @g.nodes[j];
            if (x.kind != y.kind | x.op != y.op) { return 0; };
            if (x.kind == SQN_COL) { if (x.col == y.col & x.lvl == y.lvl & x.owner == y.owner) { return 1; }; return 0; };
            if (x.kind == SQN_INT | x.kind == SQN_NULL) { if (x.iv == y.iv) { return 1; }; return 0; };
            if (x.kind == SQN_STR)
            {
                if (x.sl != y.sl) { return 0; };
                for (n = 0; n < x.sl; n++) { if (g.sql[x.s + n] != g.sql[y.s + n]) { return 0; }; };
                return 1;
            };
            if (x.kind == SQN_BIN) { if (sq_vd_deq(g, x.a, y.a) == 1 & sq_vd_deq(g, x.b, y.b) == 1) { return 1; }; return 0; };
            if (x.kind == SQN_UNARY) { if (sq_vd_deq(g, x.a, y.a) == 1) { return 1; }; return 0; };
            if (x.kind == SQN_FUNC)
            {
                if (sq_func_id(@g.sql[x.s], x.sl, (int)x.iv) != sq_func_id(@g.sql[y.s], y.sl, (int)y.iv)) { return 0; };
                if (x.iv != y.iv) { return 0; };
                p = x.a; q = y.a;
                while (p >= 0 & q >= 0)
                {
                    if (sq_vd_deq(g, p, q) == 0) { return 0; };
                    p = g.nodes[p].next; q = g.nodes[q].next;
                };
                if (p >= 0 | q >= 0) { return 0; };
                return 1;
            };
            return 0;
        };

        global int VD_SRTM;
        global int VD_SK_NK;
        global int VD_SK_ND2;
        global int VD_SK_NEX;
        global int[16] VD_SKN;
        global int[16] VD_SKC;
        global int[16] VD_SKO;
        global int[130] VD_SKP;

        // key signature of a sorter, such as k(2,-,B)
        def sq_vd_ksig(SQ_BLK* b, int nk, int* kco, SQ_SB* kt) -> void
        {
            int i;
            sq_sb_init(kt);
            sq_sb_lit(kt, "k(\0");
            sq_sb_int(kt, (i64)nk);
            for (i = 0; i < nk; i++)
            {
                sq_sb_lit(kt, ",\0");
                if (b.odesc[i] != 0) { sq_sb_lit(kt, "-\0"); };
                if ((b.odesc[i] == 0 & b.onull[i] == 2) | (b.odesc[i] != 0 & b.onull[i] == 1)) { sq_sb_lit(kt, "N.\0"); };
                sq_vd_cname(kt, kco[i]);
            };
            sq_sb_lit(kt, ")\0");
            return;
        };

        def sq_vd_sorted(SQ_STMT* st, SQ_STMT* g) -> int
        {
            SQ_BLK* b = g.blks[g.root_blk];
            SQ_SRC* sr = @b.src[0];
            SQ_TI* ti;
            SQ_NODE* nd;
            SQ_IDX ix;
            SQ_SB kt;
            int[16] kcol;
            int[16] kco;
            int[16] wj;
            int nwj;
            int[130] rcol;
            int[130] pos;
            int wrb, wml, wmu, nid, hx, nex, cov, tc, pc, off, outr, base, i, j, k, nk, init, a, maxc, nres, nd2, rew, body, nxt, sd, ss, sn, dup, col, r, hl, ho, lreg, lz, ifn, ip, np, nix, bk, m, nties, cr, prv, rv0, star;
            SQ_IDX[12] ixs;
            int[12] inp;
            int[12] inr;
            SQ_EQP peq;
            SQ_IDX pix2;
            int pk2, pdf;
            if (b.nsrc != 1 | sr.kind != 1 | (u64)sr.ti == (u64)0 | b.nord < 1 | b.nord > 8) { if (sq_vd_gon(102) == 1) { sq_seterr(st, "EXPLAIN is not available for this SELECT shape #102\0"); return 1; }; };
            hl = 0; ho = 0; nex = 0;
            if (b.limit_n >= 0)
            {
                if (g.nodes[b.limit_n].kind != SQN_INT) { if (sq_vd_gon(103) == 1) { sq_seterr(st, "EXPLAIN is not available for this LIMIT #103\0"); return 1; }; };
                if (g.nodes[b.limit_n].iv <= 0) { if (sq_vd_gon(104) == 1) { sq_seterr(st, "EXPLAIN is not available for this LIMIT #104\0"); return 1; }; };
                hl = 1;
                if (b.offset_n >= 0)
                {
                    if (g.nodes[b.offset_n].kind != SQN_INT) { if (sq_vd_gon(105) == 1) { sq_seterr(st, "EXPLAIN is not available for this LIMIT #105\0"); return 1; }; };
                    if (g.nodes[b.offset_n].iv < (i64)0) { if (sq_vd_gon(106) == 1) { sq_seterr(st, "EXPLAIN is not available for this LIMIT #106\0"); return 1; }; };
                    ho = 1;
                };
            };
            ti = sr.ti;
            wrb = 0; VD_PML = 0; VD_PMU = 0;
            if (VD_SRTM == 1 & b.where_n >= 0) { wrb = sq_vd_wrb(g, b, ti, @wml, @wmu); };
            if ((ti.wor != 0 & (VD_SRTM == 0 | wrb == 1) & (sr.tbl < 0 | ti.npk <= 0 | ti.npk > 8)) | b.nres > 100) { if (sq_vd_gon(107) == 1) { sq_seterr(st, "EXPLAIN is not available for this SELECT shape #107\0"); return 1; }; };
            cov = 0; tc = 0; pc = 2;
            if (ti.wor != 0 & (VD_SRTM == 0 | wrb == 1))
            {
                if (sq_idx_list(sr.sdb, sr.tbl, ti, @ixs[0], 12) > 0) { if (sq_vd_gon(108) == 1) { sq_seterr(st, "EXPLAIN is not available for WITHOUT ROWID tables #108\0"); return 1; }; };
                sq_vd_worsyn(ti, sr, @ix);
                cov = 1; tc = 2; pc = 3;
            };
            if (VD_SRTM == 0 & ti.wor == 0) { if (sq_vd_cover(g, ti, sr, @ix, 0) == 1) { cov = 1; tc = 2; pc = 3; }; };
            if (b.where_n >= 0 & VD_SRTM == 0) { if (sq_vd_plankind(g) != 0) { if (sq_vd_gon(109) == 1) { sq_seterr(st, "EXPLAIN is not available for this access path #109\0"); return 1; }; }; };
            nk = b.nord;
            nwj = 0;
            for (i = 0; i < nk; i++)
            {
                nid = b.ord[i];
                nd = @g.nodes[nid];
                kco[i] = b.ocoll[i];
                while (nd.kind == SQN_COLLATE) { if (kco[i] < 0) { kco[i] = (int)nd.iv; }; nid = nd.a; nd = @g.nodes[nid]; };
                hx = 0;
                if (nd.kind == SQN_RESREF) { hx = 1; nid = b.rc[(int)nd.iv]; nd = @g.nodes[nid]; };
                while (nd.kind == SQN_COLLATE) { if (kco[i] < 0) { kco[i] = (int)nd.iv; }; nid = nd.a; nd = @g.nodes[nid]; };
                if (nd.kind != SQN_COL & kco[i] < 0 & (nd.kind == SQN_FUNC | nd.kind == SQN_BIN | nd.kind == SQN_UNARY))
                {
                    hx = 0 - 1;
                    for (j = 0; j < b.nres; j++)
                    {
                        if (sq_vd_deq(g, b.rc[j], nid) == 1) { hx = j; break; };
                    };
                    if (hx < 0) { kcol[i] = 0 - 100 - nid; } else { kcol[i] = 0 - 100 - b.rc[hx]; };
                    VD_SKN[i] = nid;
                    nex++;
                    for (j = 0; j < i; j++) { if (kcol[j] == kcol[i]) { if (sq_vd_gon(0) == 1) { sq_seterr(st, "EXPLAIN is not available for this ORDER BY #0\0"); return 1; }; }; };
                    continue;
                };
                if (nd.kind != SQN_COL | nd.col >= ti.ncols) { if (sq_vd_gon(1) == 1) { sq_seterr(st, "EXPLAIN is not available for this ORDER BY #1\0"); return 1; }; };
                if (nd.col == ti.ipk & (i == 0 | hl == 1)) { if (sq_vd_gon(2) == 1) { sq_seterr(st, "EXPLAIN is not available for this ORDER BY #2\0"); return 1; }; };
                kcol[i] = nd.col;
                VD_SKN[i] = nid;
                for (j = 0; j < i; j++) { if (kcol[j] == kcol[i] & VD_KEEP != 2 & VD_NODUP == 1) { if (sq_vd_gon(3) == 1) { sq_seterr(st, "EXPLAIN is not available for this ORDER BY #3\0"); return 1; }; }; };
            };
            star = 0;
            for (i = 0; g.sql[i] != (byte)0; i++) { if (g.sql[i] == (byte)42) { star = 1; }; };
            for (i = 0; i < nk; i++)
            {
                if (kco[i] < 0) { continue; };
                if (hl == 1) { if (sq_vd_gon(4) == 1) { sq_seterr(st, "EXPLAIN is not available for this ORDER BY #4\0"); return 1; }; };
                if (i == 0 & sr.tbl >= 0)
                {
                    nix = sq_idx_list(sr.sdb, sr.tbl, ti, @ixs[0], 12);
                    for (k = 0; k < nix; k++)
                    {
                        if (ixs[k].partial != 0 | ixs[k].isx[0] != 0) { continue; };
                        if (ixs[k].col[0] == kcol[0] & ixs[k].coll[0] == kco[0]) { if (sq_vd_gon(5) == 1) { sq_seterr(st, "EXPLAIN is not available for this ORDER BY #5\0"); return 1; }; };
                    };
                };
            };
            np = 0;
            if (sr.tbl >= 0 & nk >= 2)
            {
                nix = sq_idx_list(sr.sdb, sr.tbl, ti, @ixs[0], 12);
                nties = 0;
                for (k = 0; k < nix; k++)
                {
                    inp[k] = 0;
                    if (ixs[k].partial != 0) { continue; };
                    rv0 = 0;
                    if ((ixs[k].desc[0] != 0) != (b.odesc[0] != 0)) { rv0 = 1; };
                    for (m = 0; m < ixs[k].nk & m < nk; m++)
                    {
                        if (ixs[k].col[m] != kcol[m] | ixs[k].isx[m] != 0 | ixs[k].coll[m] != 0 | b.onull[m] != 0 | kco[m] >= 0) { break; };
                        if (((ixs[k].desc[m] != 0) != (b.odesc[m] != 0)) != (rv0 == 1)) { break; };
                    };
                    inp[k] = m; inr[k] = rv0;
                    if (m > np) { np = m; };
                };
                if (ti.wor != 0 & (VD_SRTM == 0 | wrb == 1))
                {
                    inp[nix] = 0; inr[nix] = 0;
                    rv0 = 0;
                    if ((ix.desc[0] != 0) != (b.odesc[0] != 0)) { rv0 = 1; };
                    for (m = 0; m < ix.nk & m < nk; m++)
                    {
                        if (ix.col[m] != kcol[m] | ix.isx[m] != 0 | ix.coll[m] != 0 | b.onull[m] != 0 | kco[m] >= 0) { break; };
                        if (((ix.desc[m] != 0) != (b.odesc[m] != 0)) != (rv0 == 1)) { break; };
                    };
                    inp[nix] = m; inr[nix] = rv0;
                    if (m > np) { np = m; };
                    ixs[nix] = ix;
                    nix++;
                };
                if (np >= nk) { if (sq_vd_gon(6) == 1) { sq_seterr(st, "EXPLAIN is not available for this ORDER BY #6\0"); return 1; }; };
                if (VD_WMIX == 1 & np == 0) { if (sq_vd_gon(7) == 1) { sq_seterr(st, "EXPLAIN is not available for this ORDER BY #7\0"); return 1; }; };
                if (np > 0 & VD_SRTM == 1 & wrb == 0 & ti.wor == 0 & sq_vd_gon(675) == 0)
                {
                    // a seek on an index other than the ordering index wins: the rows are sorted in full
                    pk2 = sq_vd_plan(g, @peq, @pix2);
                    pdf = 0;
                    if (pk2 == 1) { pdf = 1; };
                    if (pk2 == 2)
                    {
                        pdf = 1;
                        for (k = 0; k < nix; k++) { if (inp[k] == np & ixs[k].root == pix2.root) { pdf = 0; }; };
                    };
                    for (i = 0; i < nk; i++) { for (j = i + 1; j < nk; j++) { if (kcol[i] == kcol[j]) { pdf = 0; }; }; };
                    if (pdf == 1) { np = 0; };
                };
                if (np > 0 & VD_SRTM == 1 & wrb == 0) { if (sq_vd_gon(8) == 1) { sq_seterr(st, "EXPLAIN is not available for this ORDER BY #8\0"); return 1; }; };
                if (np > 0)
                {
                    for (k = 0; k < nix; k++) { if (inp[k] == np) { nties++; }; };
                    bk = 0 - 1;
                    if (cov == 1)
                    {
                        for (k = 0; k < nix; k++) { if (inp[k] == np & ixs[k].root == ix.root) { bk = k; }; };
                        if (bk >= 0) { prv = inr[bk]; };
                        if (bk < 0) { if (sq_vd_gon(9) == 1) { sq_seterr(st, "EXPLAIN is not available for this ORDER BY #9\0"); return 1; }; };
                    }
                    else
                    {
                        if (nties != 1) { if (sq_vd_gon(10) == 1) { sq_seterr(st, "EXPLAIN is not available for this ORDER BY #10\0"); return 1; }; };
                        for (k = 0; k < nix; k++) { if (inp[k] == np) { bk = k; }; };
                        ix = ixs[bk];
                        prv = inr[bk];
                    };
                };
            };
            if (b.where_n >= 0)
            {
                sq_vd_split(g, b.where_n, @wj[0], @nwj);
                for (i = 0; i < nwj; i++)
                {
                    nd = @g.nodes[wj[i]];
                    if (nd.kind == SQN_BIN)
                    {
                        if (nd.op == SQO_EQ | nd.op == SQO_IS)
                        {
                            for (j = 0; j < nk; j++) { if (g.nodes[nd.a].kind == SQN_COL & g.nodes[nd.a].col == kcol[j]) { if (sq_vd_gon(11) == 1) { sq_seterr(st, "EXPLAIN is not available for this ORDER BY #11\0"); return 1; }; }; };
                        };
                    };
                    if (nd.kind == SQN_ISNULL)
                    {
                        pdf = 0;
                        if (ti.wor != 0 & g.nodes[nd.a].kind == SQN_COL & sq_vd_gon(674) == 0) { for (j = 0; j < ti.npk; j++) { if (ti.pkc[j] == g.nodes[nd.a].col) { pdf = 1; }; }; };
                        if (pdf == 1) { continue; };
                        for (j = 0; j < nk; j++) { if (g.nodes[nd.a].kind == SQN_COL & g.nodes[nd.a].col == kcol[j]) { if (sq_vd_gon(12) == 1) { sq_seterr(st, "EXPLAIN is not available for this ORDER BY #12\0"); return 1; }; }; };
                    };
                };
            };
            nres = b.nres;
            VD_PRN = 0;
            for (i = 0; i < nres; i++)
            {
                nd = @g.nodes[b.rc[i]];
                if (nex > 0 & nd.kind != SQN_COL)
                {
                    rcol[i] = 0 - 100 - b.rc[i];
                    hx = 0;
                    for (j = 0; j < nk; j++) { if (kcol[j] == rcol[i]) { hx = 1; }; };
                    if (hx == 0) { if (sq_vd_gon(110) == 1) { sq_seterr(st, "EXPLAIN is not available for this expression #110\0"); return 1; }; };
                    continue;
                };
                if (nd.kind == SQN_COL) { if (nd.col == ti.ncols) { VD_PRN = ti.ncols + 1; }; };
                if (nd.kind != SQN_COL | nd.col >= ti.ncols) { if (sq_vd_gon(111) == 1) { sq_seterr(st, "EXPLAIN is not available for this expression #111\0"); return 1; }; };
                rcol[i] = nd.col;
                if (nd.col == ti.ncols & ti.ipk >= 0) { rcol[i] = ti.ipk; };
                for (j = 0; j < i; j++) { if (rcol[j] == rcol[i]) { if (sq_vd_gon(112) == 1) { sq_seterr(st, "EXPLAIN is not available for this expression #112\0"); return 1; }; }; };
            };
            maxc = 0 - 1;
            for (i = 0; i < g.nn; i++)
            {
                nd = @g.nodes[i];
                if (nd.kind != SQN_COL | nd.lvl != 0 | nd.owner != g.root_blk) { continue; };
                if (nd.col >= 0 & nd.col < ti.ncols & nd.col != ti.ipk & nd.col > maxc) { maxc = nd.col; };
            };
            if (VD_PRN != 0 & b.where_n >= 0)
            {
                sq_vd_split(g, b.where_n, @wj[0], @nwj);
                for (i = 0; i < nwj; i++) { if (g.nodes[wj[i]].kind == SQN_IN) { if (sq_vd_gon(808) == 1) { sq_seterr(st, "EXPLAIN is not available for this expression #808\0"); return 1; }; }; };
            };
            if (np > 0)
            {
                for (i = 0; i < nk; i++) { if (kco[i] >= 0) { if (sq_vd_gon(13) == 1) { sq_seterr(st, "EXPLAIN is not available for this ORDER BY #13\0"); return 1; }; }; };
                if (hl == 1 & ti.wor == 0) { if (sq_vd_gon(600) == 1) { sq_seterr(st, "EXPLAIN is not available for this ORDER BY #600\0"); return 1; }; };
                if (VD_KEEP == 2) { if (sq_vd_gon(14) == 1) { sq_seterr(st, "EXPLAIN is not available for this ORDER BY #14\0"); return 1; }; };
                if (b.where_n >= 0)
                {
                    sq_vd_split(g, b.where_n, @wj[0], @nwj);
                    for (i = 0; i < nwj; i++) { if (g.nodes[wj[i]].kind == SQN_IN) { if (sq_vd_gon(15) == 1) { sq_seterr(st, "EXPLAIN is not available for this ORDER BY #15\0"); return 1; }; }; };
                };
                for (i = 0; i < nres; i++) { for (j = 0; j < i; j++) { if (rcol[j] == rcol[i]) { if (sq_vd_gon(806) == 1) { sq_seterr(st, "EXPLAIN is not available for this expression #806\0"); return 1; }; }; }; };
                if (VD_PRN != 0) { if (sq_vd_gon(807) == 1) { sq_seterr(st, "EXPLAIN is not available for this expression #807\0"); return 1; }; };
                if (VD_SRTM == 1 & wrb == 1) { VD_PML = wml + 1; VD_PMU = wmu + 1; };
                a = sq_vd_psort(st, g, b, sr, ti, @ix, cov, np, prv, nk, nres, maxc, @kcol[0], @rcol[0], @kco[0], hl, ho);
                VD_PML = 0; VD_PMU = 0;
                return a;
            };
            // record layout: keys, then the result columns that are not keys
            nd2 = 0;
            for (i = 0; i < nres; i++)
            {
                pos[i] = 0 - 1;
                for (j = 0; j < nk; j++) { if (kcol[j] == rcol[i] & (kco[j] < 0 | star == 1)) { pos[i] = j; }; };
                if (pos[i] >= 0) { for (j = i + 1; j < nres; j++) { if (rcol[j] == rcol[i]) { pos[i] = 0 - 1; }; }; };
                if (pos[i] < 0) { pos[i] = nk + nd2; nd2++; };
            };
            if (VD_SRTM == 1 & hl == 1 & nk >= 2) { if (sq_vd_gon(16) == 1) { sq_seterr(st, "EXPLAIN is not available for this ORDER BY #16\0"); return 1; }; };
            if (VD_SRTM == 1)
            {
                VD_SK_NK = nk; VD_SK_ND2 = nd2; VD_SK_NEX = nex;
                for (i = 0; i < nk; i++) { VD_SKC[i] = kcol[i]; VD_SKO[i] = kco[i]; };
                for (i = 0; i < nres; i++) { VD_SKP[i] = pos[i]; };
                return 2;
            };
            off = 0;
            sq_vd_reset();
            if (ti.wor != 0) { sq_vd_worsyn(ti, sr, @ix); };
            VD_INCUR = 2;
            init = sq_vd_op("Init\0", 0, 0, 0);
            if (hl == 1) { sn = sq_vd_op("OpenEphemeral\0", 1, nk + b.nres + 1, 0); } else { sn = sq_vd_op("SorterOpen\0", 1, 0, 0); };
            sq_sb_init(@kt);
            sq_sb_lit(@kt, "k(\0");
            sq_sb_int(@kt, (i64)nk);
            for (i = 0; i < nk; i++)
            {
                sq_sb_lit(@kt, ",\0");
                if (b.odesc[i] != 0) { sq_sb_lit(@kt, "-\0"); };
                if ((b.odesc[i] == 0 & b.onull[i] == 2) | (b.odesc[i] != 0 & b.onull[i] == 1)) { sq_sb_lit(@kt, "N.\0"); };
                sq_vd_cname(@kt, kco[i]);
            };
            sq_sb_lit(@kt, ")\0");
            sq_vd_p4s(sn, kt.p, kt.n);
            sq_sb_free(@kt);
            lreg = 0;
            if (hl == 1)
            {
                lreg = 1;
                sq_vd_lit(g, b.limit_n, 1);
                if (ho == 1)
                {
                    sq_vd_lit(g, b.offset_n, 2);
                    sq_vd_op("MustBeInt\0", 2, 0, 0);
                    sq_vd_op("OffsetLimit\0", 1, 3, 2);
                    lreg = 3;
                };
            };
            VD_NCK = 0; VD_CKN2 = 0;
            if (b.where_n >= 0 & VD_KEEP == 0 & ti.wor != 0 & sq_vd_gon(674) == 0)
            {
                b.where_n = sq_vd_dropipk(g, ti, b.where_n);
                VD_NMEM = lreg; VD_NFREE = 0;
                sq_vd_ckpre();
            };
            if (cov == 1)
            {
                a = sq_vd_op("OpenRead\0", tc, ix.root, 0);
                sq_sb_init(@kt);
                if (sq_vd_kinfo(@ix, @kt) != 0) { sq_sb_free(@kt); sq_seterr(st, "EXPLAIN is not available for this index collation\0"); return 1; };
                sq_vd_p4s(a, kt.p, kt.n);
                sq_sb_free(@kt);
            }
            else
            {
                a = sq_vd_op("OpenRead\0", 0, sr.root, 0);
                sq_vd_p4i(a, (i64)(maxc + 1));
            };
            if (VD_KEEP == 2) { VD_NMEM = lreg + VD_RB; VD_NH0 = VD_NH; } else { VD_NMEM = lreg + VD_CKN2; VD_NH = 0; VD_NH0 = 0; };
            VD_NFREE = 0; VD_NJ = 0; VD_COLCUR = 0; VD_IDXCUR = 0;
            rew = sq_vd_op("Rewind\0", tc, 0, 0);
            if (cov == 1) { VD_P3[rew] = VD_NMEM + 1; sq_vd_p4i(rew, 0); VD_COLCUR = tc; VD_IDXCUR = tc; sq_vd_setix(@ix); };
            body = VD_N;
            if (b.where_n >= 0)
            {
                if (sq_vd_where(g, ti, b.where_n) != 0) { if (sq_vd_gon(113) == 1) { sq_seterr(st, "EXPLAIN is not available for this WHERE clause #113\0"); return 1; }; };
            };
            off = VD_NMEM;
            if (VD_INUSED == 1) { if (pc <= VD_INCUR) { pc = VD_INCUR + 1; }; };
            if (hl == 1) { if (cov == 1 & nex == 0 & sq_vd_gon(33) == 1) { sq_seterr(st, "EXPLAIN is not available for ORDER BY with LIMIT over a covering index #33\0"); return 1; }; return sq_vd_sortlim(st, g, b, sr, ti, nk, nres, nd2, off, lreg, ho, init, rew, body, kcol, rcol, pos, cov, @ix, tc); };
            outr = off + nk + nres + 1;
            base = off + nk + 1;
            VD_P2[sn] = nk + nres + 1;
            for (i = 0; i < nres; i++)
            {
                if (pos[i] >= nk) { sq_vd_pread(cov, 0, @ix, tc, rcol[i], off + 1 + pos[i], ti.ipk); if (rcol[i] < ti.ncols & ti.aff[rcol[i]] == 4) { sq_vd_op("RealAffinity\0", off + 1 + pos[i], 0, 0); }; };
            };
            if (nex > 0) { VD_NMEM = off + nk + nres; };
            for (i = 0; i < nk; i++)
            {
                if (kcol[i] < 0 - 50)
                {
                    if (sq_vd_expr(g, ti, 0 - 100 - kcol[i], off + 1 + i) != 0) { if (sq_vd_gon(114) == 1) { sq_seterr(st, "EXPLAIN is not available for this expression #114\0"); return 1; }; };
                    continue;
                };
                sq_vd_pread(cov, 0, @ix, tc, kcol[i], off + 1 + i, ti.ipk);
                if (ti.aff[kcol[i]] == 4) { sq_vd_op("RealAffinity\0", off + 1 + i, 0, 0); };
            };
            if (nex > 0) { outr = VD_NMEM + 1; };
            sq_vd_op("MakeRecord\0", off + 1, nk + nd2, outr);
            a = sq_vd_op("SorterInsert\0", 1, outr, off + 1);
            sq_vd_p4i(a, (i64)(nk + nd2));
            nxt = VD_N;
            a = sq_vd_op("Next\0", tc, body, 0);
            VD_P5[a] = 1;
            VD_P2[rew] = VD_N;
            sq_vd_ckpatch();
            for (i = 0; i < VD_NJ; i++) { VD_P2[VD_JF[i]] = nxt; };
            sq_vd_op("OpenPseudo\0", pc, outr + 1, nk + nres + 1);
            ss = sq_vd_op("SorterSort\0", 1, 0, 0);
            sd = sq_vd_op("SorterData\0", 1, outr + 1, pc);
            for (i = nres - 1; i >= 0; i--) { sq_vd_op("Column\0", pc, pos[i], base + i); };
            sq_vd_op("ResultRow\0", base, nres, 0);
            sq_vd_op("SorterNext\0", 1, sd, 0);
            VD_P2[ss] = VD_N;
            sq_vd_op("Halt\0", 0, 0, 0);
            VD_P2[init] = VD_N;
            sq_vd_trans(g.db, 0);
            sq_vd_ckfin();
            for (i = VD_NH0; i < VD_NH; i++) { sq_vd_lit(g, VD_HN[i], VD_HR[i]); };
            sq_vd_op("Goto\0", 0, 1, 0);
            return 0;
        };

        // min() or max() alone over an indexed column or the integer primary key: one probe of the end of the b-tree
        def sq_vd_aggmm(SQ_STMT* st, SQ_STMT* g, int mm, SQ_IDX* ix, int fidv) -> int
        {
            SQ_BLK* b = g.blks[g.root_blk];
            SQ_SRC* sr = @b.src[0];
            SQ_TI* ti = sr.ti;
            SQ_NODE* nd = @g.nodes[b.rc[0]];
            SQ_SB kt;
            int init, a, o1, o2, o3, o4, o5, o6, o7, ctr, key, arg, cur, last, endj, fin, rewj, ifa, idg, colo, stp, gt;
            sq_vd_reset();
            init = sq_vd_op("Init\0", 0, 0, 0);
            VD_NMEM = 2; VD_NFREE = 0; VD_NH = 0; VD_NJ = 0; VD_COLCUR = 0; VD_IDXCUR = 0;
            sq_vd_op("Null\0", 0, 1, 2);
            if (mm == 1)
            {
                cur = 0;
                a = sq_vd_op("OpenRead\0", 0, sr.root, 0);
                sq_vd_p4i(a, 0);
            }
            else
            {
                cur = 1;
                sq_sb_init(@kt);
                if (sq_vd_kinfo(ix, @kt) != 0) { if (sq_vd_gon(115) == 1) { sq_seterr(st, "EXPLAIN is not available for this index collation #115\0"); return 1; }; };
                a = sq_vd_op("OpenRead\0", 1, ix.root, 0);
                sq_vd_p4s(a, kt.p, kt.n);
                sq_sb_free(@kt);
            };
            if (fidv == 104 & mm == 2 & ti.notnull[g.nodes[nd.a].col] == 0)
            {
                // min over a nullable index column skips the NULL entries first
                ctr = 3; key = 4; arg = 5;
                sq_vd_op("Null\0", 0, key, 0);
                sq_vd_op("Integer\0", 1, ctr, 0);
                o1 = sq_vd_op("SeekGT\0", 1, 0, key);
                sq_vd_p4i(o1, 1);
                gt = sq_vd_op("Goto\0", 0, 0, 0);
                rewj = sq_vd_op("Rewind\0", 1, 0, key);
                sq_vd_p4i(rewj, 1);
                VD_P2[gt] = VD_N;
                ifa = sq_vd_op("If\0", ctr, 0, 0);
                idg = sq_vd_op("IdxGT\0", 1, 0, key);
                sq_vd_p4i(idg, 1);
                VD_P2[ifa] = VD_N;
                colo = sq_vd_op("Column\0", 1, 0, arg);
                a = sq_vd_op("CollSeq\0", 0, 0, 0);
                sq_vd_p4s(a, "BINARY-8\0", 8);
                stp = sq_vd_op("AggStep\0", 0, arg, 2);
                sq_vd_p4s(stp, "min(1)\0", 6);
                VD_P5[stp] = 1;
                endj = sq_vd_op("Goto\0", 0, 0, 0);
                a = sq_vd_op("Next\0", 1, ifa, 0);
                VD_P5[a] = 1;
                VD_P2[o1] = VD_N;
                VD_P2[rewj] = VD_N;
                VD_P2[idg] = VD_N;
                o2 = sq_vd_op("DecrJumpZero\0", ctr, rewj, 0);
                fin = VD_N;
                VD_P2[endj] = fin;
            }
            else
            {
                arg = 3;
                if (fidv == 105 & mm == 2)
                {
                    o1 = sq_vd_op("Last\0", 1, 0, 3);
                    sq_vd_p4i(o1, 0);
                    colo = sq_vd_op("Column\0", 1, 0, arg);
                }
                else if (fidv == 105)
                {
                    o1 = sq_vd_op("Last\0", 0, 0, 0);
                    colo = sq_vd_op("Rowid\0", 0, arg, 0);
                }
                else if (mm == 2)
                {
                    o1 = sq_vd_op("Rewind\0", 1, 0, 3);
                    sq_vd_p4i(o1, 0);
                    colo = sq_vd_op("Column\0", 1, 0, arg);
                }
                else
                {
                    o1 = sq_vd_op("Rewind\0", 0, 0, 0);
                    colo = sq_vd_op("Rowid\0", 0, arg, 0);
                };
                a = sq_vd_op("CollSeq\0", 0, 0, 0);
                sq_vd_p4s(a, "BINARY-8\0", 8);
                stp = sq_vd_op("AggStep\0", 0, arg, 2);
                if (fidv == 105) { sq_vd_p4s(stp, "max(1)\0", 6); } else { sq_vd_p4s(stp, "min(1)\0", 6); };
                VD_P5[stp] = 1;
                endj = sq_vd_op("Goto\0", 0, 0, 0);
                if (fidv == 105) { a = sq_vd_op("Prev\0", cur, colo, 0); } else { a = sq_vd_op("Next\0", cur, colo, 0); };
                VD_P5[a] = 1;
                VD_P2[o1] = VD_N;
                fin = VD_N;
                VD_P2[endj] = fin;
            };
            a = sq_vd_op("AggFinal\0", 2, 1, 0);
            if (fidv == 105) { sq_vd_p4s(a, "max(1)\0", 6); } else { sq_vd_p4s(a, "min(1)\0", 6); };
            sq_vd_op("Copy\0", 2, arg + 1, 0);
            sq_vd_op("ResultRow\0", arg + 1, 1, 0);
            sq_vd_op("Halt\0", 0, 0, 0);
            VD_P2[init] = VD_N;
            sq_vd_trans(g.db, 0);
            sq_vd_op("Goto\0", 0, 1, 0);
            return 0;
        };

        // SELECT over no table or one plain table: literal and column results, optionally WHERE rowid = integer, LIMIT
        // min() or max() of the integer primary key under a WHERE with no equality term: walk the table in rowid order, first hit ends
        def sq_vd_aggmmr(SQ_STMT* st, SQ_STMT* g, int fid) -> int
        {
            SQ_BLK* b = g.blks[g.root_blk];
            SQ_SRC* sr = @b.src[0];
            SQ_TI* ti = sr.ti;
            int init, a, o1, body, stp, endj, arg, res, nxt, j, maxc, pass, chg;
            int[1024] inw;
            SQ_NODE* o;
            sq_vd_reset();
            init = sq_vd_op("Init\0", 0, 0, 0);
            VD_NMEM = 2; VD_NFREE = 0; VD_NH = 0; VD_NH0 = 0; VD_NJ = 0; VD_COLCUR = 0; VD_IDXCUR = 0;
            maxc = 0 - 1;
            if (g.nn > 1024 | b.where_n < 0) { return 2; };
            for (j = 0; j < g.nn; j++) { inw[j] = 0; };
            inw[b.where_n] = 1;
            for (pass = 0; pass < g.nn; pass++)
            {
                chg = 0;
                for (j = 0; j < g.nn; j++)
                {
                    if (inw[j] == 0) { continue; };
                    o = @g.nodes[j];
                    if (o.a >= 0 & o.a < g.nn & inw[o.a] == 0) { inw[o.a] = 1; chg = 1; };
                    if (o.b >= 0 & o.b < g.nn & inw[o.b] == 0) { inw[o.b] = 1; chg = 1; };
                    if (o.c >= 0 & o.c < g.nn & inw[o.c] == 0) { inw[o.c] = 1; chg = 1; };
                    if (o.next >= 0 & o.next < g.nn & inw[o.next] == 0) { inw[o.next] = 1; chg = 1; };
                };
                if (chg == 0) { break; };
            };
            for (j = 0; j < g.nn; j++)
            {
                if (inw[j] == 0) { continue; };
                o = @g.nodes[j];
                if (o.kind != SQN_COL | o.lvl != 0 | o.owner != g.root_blk) { continue; };
                if (o.col < 0 | o.col == ti.ipk) { return 2; };
                if (o.col < ti.ncols & o.col > maxc) { maxc = o.col; };
            };
            sq_vd_op("Null\0", 0, 1, 2);
            a = sq_vd_op("OpenRead\0", 0, sr.root, 0);
            sq_vd_p4i(a, (i64)(maxc + 1));
            if (fid == 105) { o1 = sq_vd_op("Last\0", 0, 0, 0); } else { o1 = sq_vd_op("Rewind\0", 0, 0, 0); };
            body = VD_N;
            if (sq_vd_where(g, ti, b.where_n) != 0) { if (sq_vd_gon(116) == 1) { sq_seterr(st, "EXPLAIN is not available for this WHERE clause #116\0"); return 1; }; };
            arg = 3;
            res = VD_NMEM;
            if (res < 3) { res = 3; };
            res++;
            sq_vd_op("Rowid\0", 0, arg, 0);
            a = sq_vd_op("CollSeq\0", 0, 0, 0);
            sq_vd_p4s(a, "BINARY-8\0", 8);
            stp = sq_vd_op("AggStep\0", 0, arg, 2);
            if (fid == 105) { sq_vd_p4s(stp, "max(1)\0", 6); } else { sq_vd_p4s(stp, "min(1)\0", 6); };
            VD_P5[stp] = 1;
            endj = sq_vd_op("Goto\0", 0, 0, 0);
            nxt = VD_N;
            if (fid == 105) { a = sq_vd_op("Prev\0", 0, body, 0); } else { a = sq_vd_op("Next\0", 0, body, 0); };
            VD_P5[a] = 1;
            for (j = 0; j < VD_NJ; j++) { VD_P2[VD_JF[j]] = nxt; };
            VD_P2[o1] = VD_N; VD_P2[endj] = VD_N;
            a = sq_vd_op("AggFinal\0", 2, 1, 0);
            if (fid == 105) { sq_vd_p4s(a, "max(1)\0", 6); } else { sq_vd_p4s(a, "min(1)\0", 6); };
            sq_vd_op("Copy\0", 2, res, 0);
            sq_vd_op("ResultRow\0", res, 1, 0);
            sq_vd_op("Halt\0", 0, 0, 0);
            VD_P2[init] = VD_N;
            sq_vd_trans(g.db, 0);
            for (j = VD_NH0; j < VD_NH; j++) { sq_vd_lit(g, VD_HN[j], VD_HR[j]); };
            sq_vd_op("Goto\0", 0, 1, 0);
            return 0;
        };

        // min() or max() of the integer primary key where equality terms pin every column of one index: one probe, then stop
        // 2 when the query is not of that shape
        def sq_vd_aggrisk1(SQ_STMT* g, int ni, SQ_IDX* ixl, int nixl) -> int;
        def sq_vd_resord(SQ_STMT* g, SQ_TI* ti, int* cj, int n, int* used) -> int;
        def sq_vd_mmnull(SQ_STMT* g, SQ_BLK* b, SQ_TI* ti) -> int;

        def sq_vd_aggmmw(SQ_STMT* st, SQ_STMT* g, int fid) -> int
        {
            SQ_BLK* b = g.blks[g.root_blk];
            SQ_SRC* sr = @b.src[0];
            SQ_TI* ti = sr.ti;
            SQ_NODE* o;
            SQ_IDX[12] ixs;
            SQ_SB kt;
            int[16] cj;
            int[16] ec;
            int[16] en;
            int run, i, j, m, nix, bi, init, a, sk, ik, stp, endj, arg, nx, ok, found, anyeq, body, cur, lst, nh, tot, nr, dup, maxc, pass, chg, res, kind2;
            int[16] rs;
            int[1024] inw;
            if (sr.tbl < 0 | b.where_n < 0) { return 2; };
            sq_vd_split(g, b.where_n, @cj[0], @run);
            if (run < 1 | run > 8) { return 2; };
            tot = run; run = 0; nr = 0; anyeq = 0;
            for (i = 0; i < tot; i++)
            {
                o = @g.nodes[cj[i]];
                ok = 0;
                if (o.kind == SQN_BIN & o.op == SQO_EQ)
                {
                    ok = 1;
                    if (g.nodes[o.a].kind == SQN_COL & (g.nodes[o.b].kind == SQN_STR | g.nodes[o.b].kind == SQN_INT)) { ec[run] = g.nodes[o.a].col; en[run] = o.b; }
                    else { if (g.nodes[o.b].kind == SQN_COL & (g.nodes[o.a].kind == SQN_STR | g.nodes[o.a].kind == SQN_INT)) { ec[run] = g.nodes[o.b].col; en[run] = o.a; } else { ok = 0; }; };
                    if (ok == 1)
                    {
                        if (ec[run] < 0 | ec[run] >= ti.ncols | ec[run] == ti.ipk) { ok = 0; };
                    };
                    if (ok == 1)
                    {
                        if (g.nodes[en[run]].kind == SQN_STR) { if (ti.aff[ec[run]] > 1) { ok = 0; }; }
                        else { if (ti.aff[ec[run]] != 0 & ti.aff[ec[run]] != 3) { ok = 0; }; };
                        if (ti.coll[ec[run]] != 0) { ok = 0; };
                    };
                    if (ok == 1)
                    {
                        dup = 0;
                        for (j = 0; j < run; j++) { if (ec[j] == ec[run]) { dup = 1; }; };
                        if (dup == 1) { ok = 0; };
                    };
                };
                if (ok == 1) { run++; } else { rs[nr] = cj[i]; nr++; };
            };
            nix = sq_idx_list(sr.sdb, sr.tbl, ti, @ixs[0], 12);
            for (i = 0; i < nr; i++)
            {
                if (sq_vd_gon(719) == 1 & sq_vd_aggrisk1(g, rs[i], @ixs[0], nix) == 1) { sq_seterr(st, "EXPLAIN is not available for this aggregate query\0"); return 1; };
            };
            if (run == 0) { return sq_vd_aggmmr(st, g, fid); };
            bi = 0 - 1;
            for (i = nix - 1; i >= 0; i--)
            {
                if (ixs[i].partial != 0 | ixs[i].unique != 0 | ixs[i].nk < run) { continue; };
                ok = 1;
                for (m = 0; m < run; m++)
                {
                    found = 0;
                    for (j = 0; j < run; j++) { if (ec[j] == ixs[i].col[m]) { found = 1; }; };
                    if (found == 0 | ixs[i].isx[m] != 0 | ixs[i].coll[m] != 0 | ixs[i].desc[m] != 0) { ok = 0; };
                };
                if (ok == 1)
                {
                    if (bi < 0) { bi = i; } else { if (ixs[i].nk < ixs[bi].nk) { bi = i; }; };
                };
            };
            if (bi < 0) { return 2; };
            sq_vd_reset();
            init = sq_vd_op("Init\0", 0, 0, 0);
            VD_NMEM = 2; VD_NFREE = 0; VD_NH = 0; VD_NJ = 0; VD_COLCUR = 0; VD_IDXCUR = 0;
            VD_NH0 = 0; VD_NJ = 0;
            sq_vd_op("Null\0", 0, 1, 2);
            maxc = 0 - 1;
            if (nr > 0)
            {
                if (g.nn > 1024) { return 2; };
                for (j = 0; j < g.nn; j++) { inw[j] = 0; };
                for (i = 0; i < nr; i++) { inw[rs[i]] = 1; };
                for (pass = 0; pass < g.nn; pass++)
                {
                    chg = 0;
                    for (j = 0; j < g.nn; j++)
                    {
                        if (inw[j] == 0) { continue; };
                        o = @g.nodes[j];
                        if (o.a >= 0 & o.a < g.nn & inw[o.a] == 0) { inw[o.a] = 1; chg = 1; };
                        if (o.b >= 0 & o.b < g.nn & inw[o.b] == 0) { inw[o.b] = 1; chg = 1; };
                        if (o.c >= 0 & o.c < g.nn & inw[o.c] == 0) { inw[o.c] = 1; chg = 1; };
                        if (o.next >= 0 & o.next < g.nn & inw[o.next] == 0) { inw[o.next] = 1; chg = 1; };
                    };
                    if (chg == 0) { break; };
                };
                for (j = 0; j < g.nn; j++)
                {
                    if (inw[j] == 0) { continue; };
                    o = @g.nodes[j];
                    if (o.kind != SQN_COL | o.lvl != 0 | o.owner != g.root_blk) { continue; };
                    if (o.col < 0 | o.col == ti.ipk) { return 2; };
                    if (o.col < ti.ncols & o.col > maxc) { maxc = o.col; };
                };
                a = sq_vd_op("OpenRead\0", 0, sr.root, 0);
                sq_vd_p4i(a, (i64)(maxc + 1));
            };
            sq_sb_init(@kt);
            if (sq_vd_kinfo(@ixs[bi], @kt) != 0) { sq_sb_free(@kt); sq_seterr(st, "EXPLAIN is not available for this index collation\0"); return 1; };
            a = sq_vd_op("OpenRead\0", 1, ixs[bi].root, 0);
            sq_vd_p4s(a, kt.p, kt.n);
            sq_sb_free(@kt);
            if (fid == 105) { VD_P5[a] = 2; };
            for (m = 0; m < run; m++)
            {
                for (j = 0; j < run; j++) { if (ec[j] == ixs[bi].col[m]) { sq_vd_lit(g, en[j], 3 + m); }; };
            };
            arg = 3 + run;
            VD_NMEM = 2 + run;
            if (fid == 105) { sk = sq_vd_op("SeekLE\0", 1, 0, 3); } else { sk = sq_vd_op("SeekGE\0", 1, 0, 3); };
            sq_vd_p4i(sk, run);
            if (fid == 105) { ik = sq_vd_op("IdxLT\0", 1, 0, 3); } else { ik = sq_vd_op("IdxGT\0", 1, 0, 3); };
            sq_vd_p4i(ik, run);
            if (nr > 0)
            {
                sq_vd_op("DeferredSeek\0", 1, 0, 0);
                VD_COLCUR = 0;
                for (i = 0; i < nr; i++)
                {
                    if (sq_vd_where(g, ti, rs[i]) != 0) { if (sq_vd_gon(117) == 1) { sq_seterr(st, "EXPLAIN is not available for this WHERE clause #117\0"); return 1; }; };
                };
            };
            sq_vd_op("IdxRowid\0", 1, arg, 0);
            a = sq_vd_op("CollSeq\0", 0, 0, 0);
            sq_vd_p4s(a, "BINARY-8\0", 8);
            stp = sq_vd_op("AggStep\0", 0, arg, 2);
            if (fid == 105) { sq_vd_p4s(stp, "max(1)\0", 6); } else { sq_vd_p4s(stp, "min(1)\0", 6); };
            VD_P5[stp] = 1;
            endj = 0 - 1;
            if (ixs[bi].nk == run) { endj = sq_vd_op("Goto\0", 0, 0, 0); };
            for (j = 0; j < VD_NJ; j++) { VD_P2[VD_JF[j]] = VD_N; };
            if (fid == 105) { a = sq_vd_op("Prev\0", 1, ik, 0); } else { a = sq_vd_op("Next\0", 1, ik, 0); };
            if (ixs[bi].nk == run) { VD_P3[a] = 1; };
            VD_P2[sk] = VD_N; VD_P2[ik] = VD_N;
            if (endj >= 0) { VD_P2[endj] = VD_N; };
            a = sq_vd_op("AggFinal\0", 2, 1, 0);
            if (fid == 105) { sq_vd_p4s(a, "max(1)\0", 6); } else { sq_vd_p4s(a, "min(1)\0", 6); };
            res = arg;
            if (VD_NMEM > res) { res = VD_NMEM; };
            res++;
            sq_vd_op("Copy\0", 2, res, 0);
            sq_vd_op("ResultRow\0", res, 1, 0);
            sq_vd_op("Halt\0", 0, 0, 0);
            VD_P2[init] = VD_N;
            sq_vd_trans(g.db, 0);
            for (j = VD_NH0; j < VD_NH; j++) { sq_vd_lit(g, VD_HN[j], VD_HR[j]); };
            sq_vd_op("Goto\0", 0, 1, 0);
            return 0;
        };

        // min() or max() of a plain column that leads an index, with a WHERE the index does not serve: ordered index scan, first
        // row passing the filter ends the search. 2 when the query is not of that shape
        // 1 when the column is the rowid alias or leads a non-partial index of the source
        def sq_vd_leads(SQ_SRC* sr, int col) -> int
        {
            SQ_IDX[12] ixs0;
            int i, nix;
            if (col < 0) { return 0; };
            if (col == sr.ti.ipk) { return 1; };
            if (sr.kind != 1 | sr.tbl < 0) { return 0; };
            nix = sq_idx_list(sr.sdb, sr.tbl, sr.ti, @ixs0[0], 12);
            for (i = 0; i < nix; i++) { if (ixs0[i].partial == 0 & ixs0[i].isx[0] == 0 & ixs0[i].col[0] == col) { return 1; }; };
            return 0;
        };

        // 1 when the column is a key column anywhere in any index of the source
        def sq_vd_inidx(SQ_SRC* sr, int col) -> int
        {
            SQ_IDX[12] ixs0;
            int i, j, nix;
            if (col < 0) { return 0; };
            if (col == sr.ti.ipk) { return 1; };
            if (sr.kind != 1 | sr.tbl < 0) { return 0; };
            nix = sq_idx_list(sr.sdb, sr.tbl, sr.ti, @ixs0[0], 12);
            for (i = 0; i < nix; i++) { for (j = 0; j < ixs0[i].nk; j++) { if (ixs0[i].col[j] == col) { return 1; }; }; };
            return 0;
        };

        def sq_vd_aggmmx(SQ_STMT* st, SQ_STMT* g, int fid, int acol) -> int
        {
            SQ_BLK* b = g.blks[g.root_blk];
            SQ_SRC* sr = @b.src[0];
            SQ_TI* ti = sr.ti;
            SQ_NODE* o;
            SQ_IDX[12] ixs;
            SQ_SB kt;
            int[1024] inw;
            int i, j, m, nix, bi, init, a, stp, endj, nxt, body, maxc, pass, chg, res, cov, found;
            if (sr.tbl < 0 | b.where_n < 0 | acol < 0 | acol >= ti.ncols | acol == ti.ipk) { return 2; };
            if (ti.coll[acol] != 0 | g.nn > 1024) { return 2; };
            nix = sq_idx_list(sr.sdb, sr.tbl, ti, @ixs[0], 12);
            bi = 0 - 1;
            for (i = nix - 1; i >= 0 & bi < 0; i--)
            {
                if (ixs[i].partial != 0 | ixs[i].isx[0] != 0 | ixs[i].col[0] != acol | ixs[i].coll[0] != 0 | ixs[i].desc[0] != 0) { continue; };
                bi = i;
            };
            if (bi < 0) { return 2; };
            for (j = 0; j < g.nn; j++) { inw[j] = 0; };
            inw[b.where_n] = 1;
            for (pass = 0; pass < g.nn; pass++)
            {
                chg = 0;
                for (j = 0; j < g.nn; j++)
                {
                    if (inw[j] == 0) { continue; };
                    o = @g.nodes[j];
                    if (o.a >= 0 & o.a < g.nn & inw[o.a] == 0) { inw[o.a] = 1; chg = 1; };
                    if (o.b >= 0 & o.b < g.nn & inw[o.b] == 0) { inw[o.b] = 1; chg = 1; };
                    if (o.c >= 0 & o.c < g.nn & inw[o.c] == 0) { inw[o.c] = 1; chg = 1; };
                    if (o.next >= 0 & o.next < g.nn & inw[o.next] == 0) { inw[o.next] = 1; chg = 1; };
                };
                if (chg == 0) { break; };
            };
            maxc = 0 - 1; cov = 1;
            for (j = 0; j < g.nn; j++)
            {
                if (inw[j] == 0) { continue; };
                o = @g.nodes[j];
                if (o.kind != SQN_COL | o.lvl != 0 | o.owner != g.root_blk) { continue; };
                if (o.col < 0 | o.col == ti.ipk) { return 2; };
                if (o.col < ti.ncols & o.col > maxc) { maxc = o.col; };
                found = 0;
                for (m = 0; m < ixs[bi].nk; m++) { if (ixs[bi].col[m] == o.col) { found = 1; }; };
                if (found == 0) { cov = 0; };
            };
            if (cov == 1) { return 2; };
            if (acol < ti.ncols & acol > maxc) { maxc = acol; };
            sq_vd_reset();
            init = sq_vd_op("Init\0", 0, 0, 0);
            VD_NMEM = 2; VD_NFREE = 0; VD_NH = 0; VD_NH0 = 0; VD_NJ = 0; VD_COLCUR = 0; VD_IDXCUR = 0;
            sq_vd_op("Null\0", 0, 1, 2);
            a = sq_vd_op("OpenRead\0", 0, sr.root, 0);
            sq_vd_p4i(a, (i64)(maxc + 1));
            sq_sb_init(@kt);
            if (sq_vd_kinfo(@ixs[bi], @kt) != 0) { sq_sb_free(@kt); sq_seterr(st, "EXPLAIN is not available for this index collation\0"); return 1; };
            a = sq_vd_op("OpenRead\0", 1, ixs[bi].root, 0);
            sq_vd_p4s(a, kt.p, kt.n);
            sq_sb_free(@kt);
            if (fid == 105) { a = sq_vd_op("Last\0", 1, 0, 3); } else { a = sq_vd_op("Rewind\0", 1, 0, 3); };
            sq_vd_p4i(a, 0);
            res = a;
            body = VD_N;
            sq_vd_op("DeferredSeek\0", 1, 0, 0);
            if (sq_vd_where(g, ti, b.where_n) != 0) { if (sq_vd_gon(118) == 1) { sq_seterr(st, "EXPLAIN is not available for this WHERE clause #118\0"); return 1; }; };
            sq_vd_op("Column\0", 1, 0, 3);
            a = sq_vd_op("CollSeq\0", 0, 0, 0);
            sq_vd_p4s(a, "BINARY-8\0", 8);
            stp = sq_vd_op("AggStep\0", 0, 3, 2);
            if (fid == 105) { sq_vd_p4s(stp, "max(1)\0", 6); } else { sq_vd_p4s(stp, "min(1)\0", 6); };
            VD_P5[stp] = 1;
            endj = sq_vd_op("Goto\0", 0, 0, 0);
            nxt = VD_N;
            if (fid == 105) { a = sq_vd_op("Prev\0", 1, body, 0); } else { a = sq_vd_op("Next\0", 1, body, 0); };
            VD_P5[a] = 1;
            for (j = 0; j < VD_NJ; j++) { VD_P2[VD_JF[j]] = nxt; };
            VD_P2[res] = VD_N; VD_P2[endj] = VD_N;
            a = sq_vd_op("AggFinal\0", 2, 1, 0);
            if (fid == 105) { sq_vd_p4s(a, "max(1)\0", 6); } else { sq_vd_p4s(a, "min(1)\0", 6); };
            nxt = VD_NMEM;
            if (nxt < 3) { nxt = 3; };
            nxt++;
            sq_vd_op("Copy\0", 2, nxt, 0);
            sq_vd_op("ResultRow\0", nxt, 1, 0);
            sq_vd_op("Halt\0", 0, 0, 0);
            VD_P2[init] = VD_N;
            sq_vd_trans(g.db, 0);
            for (j = VD_NH0; j < VD_NH; j++) { sq_vd_lit(g, VD_HN[j], VD_HR[j]); };
            sq_vd_op("Goto\0", 0, 1, 0);
            return 0;
        };

        // aggregate query over one table without GROUP BY: count/sum/total/avg/min/max of plain columns
        // 1 when a WHERE term could be served by an index that this aggregate scan does not use
        def sq_vd_aggrisk1(SQ_STMT* g, int ni, SQ_IDX* ixl, int nixl) -> int
        {
            int k, c, cl;
            SQ_NODE* nd;
            SQ_NODE* l;
            nd = @g.nodes[ni];
            if (nd.kind == SQN_BIN & nd.op == SQO_OR) { return 1; };
            if (nd.kind == SQN_BIN & nd.op == SQO_NE) { return 0; };
            if (nd.kind != SQN_BIN & nd.kind != SQN_ISNULL & nd.kind != SQN_IN & nd.kind != SQN_LIKE & nd.kind != SQN_BETWEEN) { return 0; };
            if (nd.a < 0) { return 0; };
            l = @g.nodes[nd.a];
            if (l.kind != SQN_COL) { return 0; };
            cl = l.col;
            for (k = 0; k < nixl; k++)
            {
                if (ixl[k].partial != 0) { continue; };
                for (c = 0; c < ixl[k].nk; c++) { if (ixl[k].col[c] == cl) { return 1; }; };
            };
            return 0;
        };

        // 1 when a min or max argument is an index column that follows other index columns the WHERE restricts
        def sq_vd_mmnull(SQ_STMT* g, SQ_BLK* b, SQ_TI* ti) -> int
        {
            SQ_SRC* sr = @b.src[0];
            SQ_IDX[12] ixs;
            SQ_NODE* nd;
            int nix, i, k, j, c, q, fid, col;
            if (sr.tbl < 0 | (u64)ti == (u64)0 | sr.kind != 1) { return 0; };
            nix = sq_idx_list(sr.sdb, sr.tbl, ti, @ixs[0], 12);
            for (i = 0; i < b.nres; i++)
            {
                nd = @g.nodes[b.rc[i]];
                if (nd.kind != SQN_FUNC | nd.a < 0) { continue; };
                fid = sq_func_id(@g.sql[nd.s], nd.sl, (int)nd.iv);
                if (fid != 104 & fid != 105) { continue; };
                if (g.nodes[nd.a].kind != SQN_COL) { continue; };
                col = g.nodes[nd.a].col;
                if (sq_vd_gon(751) == 1)
                {
                    for (q = 0; q < g.nn; q++)
                    {
                        if (g.nodes[q].kind != SQN_BIN | g.nodes[q].op != SQO_EQ) { continue; };
                        if (g.nodes[g.nodes[q].a].kind == SQN_COL) { if (g.nodes[g.nodes[q].a].col == col & g.nodes[g.nodes[q].a].lvl == 0) { return 1; }; };
                        if (g.nodes[g.nodes[q].b].kind == SQN_COL) { if (g.nodes[g.nodes[q].b].col == col & g.nodes[g.nodes[q].b].lvl == 0) { return 1; }; };
                    };
                };
                for (k = 0; k < nix; k++)
                {
                    if (ixs[k].partial != 0) { continue; };
                    for (j = 1; j < ixs[k].nk; j++)
                    {
                        if (ixs[k].col[j] != col) { continue; };
                        for (c = 0; c <= j; c++)
                        {
                            for (q = 0; q < g.nn; q++)
                            {
                                if (g.nodes[q].kind == SQN_COL & g.nodes[q].lvl == 0 & g.nodes[q].owner == g.root_blk & g.nodes[q].col == ixs[k].col[c] & q != nd.a) { return 1; };
                            };
                        };
                    };
                };
            };
            return 0;
        };

        def sq_vd_aggrisk(SQ_STMT* g, SQ_BLK* b, SQ_IDX* ixl, int nixl) -> int
        {
            int[16] wj;
            int nw, i;
            nw = 0;
            sq_vd_split(g, b.where_n, @wj[0], @nw);
            for (i = 0; i < nw; i++) { if (sq_vd_aggrisk1(g, wj[i], ixl, nixl) == 1) { return 1; }; };
            return 0;
        };

        def sq_vd_agg(SQ_STMT* st, SQ_STMT* g, int hasl) -> int
        {
            SQ_BLK* b = g.blks[g.root_blk];
            SQ_SRC* sr = @b.src[0];
            SQ_TI* ti = sr.ti;
            SQ_NODE* nd;
            SQ_NODE* ar;
            int[16] fid;
            int[16] acc;
            int[16] first;
            int[16] cj;
            int lo, ifp, djz, lgx;
            SQ_IDX[12] ixtmp;
            SQ_IDX ixu;
            SQ_SB kt;
            int nixa, useix, mm, cc, ixi, pos, ic, distix, eqj, mmw, mmr, mmg, nwq, nn1, nnc, nnr, ngx;
            byte[4] nb2;
            int[16] wq;
            int[16] an; int[16] isb; int[16] rsrc; SQ_NODE* wn; int rr, lt, mmb, flg, bq0, nb, bo, fl, q, init, rew, body, nxt, a, i, j, k, n, reg, rbase, nacc, shift, maxc, same, run, anyipk, dist, nargs, reg2, fnd, nd2;
            SQ_NODE* o;
