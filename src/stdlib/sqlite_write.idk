        // ALTER TABLE t RENAME TO / RENAME COLUMN / DROP COLUMN
        def sq_vd_alter2(SQ_STMT* st, byte* t, int n, int i, byte** pq) -> int
        {
            int k, ns, nl, i0;
            i0 = i;
            i = sq_vd_skip(t, n, i);
            k = sq_vd_ident(t, n, i, @ns, @nl);
            if (k < 0) { if (sq_vd_gon(538) == 1) { sq_seterr(st, "EXPLAIN is not available for this ALTER TABLE #538\0"); return 1; }; };
            if (k < n) { if (t[k] == (byte)46) { if (sq_vd_gon(539) == 1) { sq_seterr(st, "EXPLAIN is not available for this ALTER TABLE #539\0"); return 1; }; }; };
            i = sq_vd_skip(t, n, k);
            k = sq_vd_word(t, n, i, "drop\0");
            if (k >= 0) { VD_TEMPDB = 1; return sq_vd_dropcol(st, t, n, sq_vd_skip(t, n, k), ns, nl, pq); };
            k = sq_vd_word(t, n, i, "rename\0");
            if (k < 0) { if (sq_vd_gon(540) == 1) { sq_seterr(st, "EXPLAIN is not available for this ALTER TABLE #540\0"); return 1; }; };
            VD_TEMPDB = 1;
            i = sq_vd_skip(t, n, k);
            if (sq_vd_word(t, n, i, "to\0") >= 0) { return sq_vd_rename_tab(st, t, n, i0, pq); };
            return sq_vd_rncol(st, t, n, i, ns, nl, pq);
        };

        // 0 when a column definition for ALTER TABLE ADD COLUMN is plain: a name, type words, an optional literal DEFAULT and NOT NULL with a non-NULL default
        def sq_vd_colcheck(byte* t, int s, int e) -> int
        {
            int i, k, depth, hasnot, hasdef, defnull, j, w0, w1, wl;
            byte c, q;
            byte[24] wb;
            i = sq_vd_skip(t, e, s);
            k = sq_vd_ident(t, e, i, @w0, @wl);
            if (k < 0) { return 1; };
            i = k;
            depth = 0; hasnot = 0; hasdef = 0; defnull = 0;
            while (i < e)
            {
                c = t[i];
                if (c == (byte)39 | c == (byte)34 | c == (byte)96)
                {
                    q = c;
                    i++;
                    while (i < e) { if (t[i] == q) { if (i + 1 < e) { if (t[i + 1] == q) { i = i + 2; continue; }; }; break; }; i++; };
                    i++;
                    continue;
                };
                if (c == (byte)40) { depth++; i++; continue; };
                if (c == (byte)41) { depth--; i++; continue; };
                if (c == (byte)91 | c == (byte)59 | c == (byte)45 & i + 1 < e) { if (c == (byte)91) { return 1; }; if (c == (byte)45) { if (t[i + 1] == (byte)45) { return 1; }; }; if (c == (byte)59) { return 1; }; };
                if (c == (byte)47 & i + 1 < e) { if (t[i + 1] == (byte)42) { return 1; }; };
                if (sq_isalpha(c) | c == (byte)95)
                {
                    j = 0;
                    while (i < e & (sq_isalpha(t[i]) | sq_isdigit(t[i]) | t[i] == (byte)95))
                    {
                        if (j < 23) { c = t[i]; if (c >= (byte)65 & c <= (byte)90) { c = c + (byte)32; }; wb[j] = c; j++; };
                        i++;
                    };
                    wb[j] = (byte)0;
                    if (depth != 0) { continue; };
                    if (sq_streq(@wb[0], "primary\0") | sq_streq(@wb[0], "unique\0") | sq_streq(@wb[0], "check\0") | sq_streq(@wb[0], "generated\0") | sq_streq(@wb[0], "as\0") | sq_streq(@wb[0], "constraint\0") | sq_streq(@wb[0], "autoincrement\0")) { return 1; };
                    if (sq_streq(@wb[0], "not\0")) { hasnot = 1; };
                    if (sq_streq(@wb[0], "default\0"))
                    {
                        hasdef = 1;
                        i = sq_vd_skip(t, e, i);
                        if (i >= e) { return 1; };
                        if (t[i] == (byte)40) { return 1; };
                        if (sq_isalpha(t[i]))
                        {
                            if (sq_vd_word(t, e, i, "null\0") >= 0) { defnull = 1; }
                            else { return 1; };
                        };
                    };
                    continue;
                };
                i++;
            };
            if (depth != 0) { return 1; };
            if (hasnot != 0 & (hasdef == 0 | defnull != 0)) { return 2; };
            return 0;
        };

        // ALTER TABLE t ADD [COLUMN] coldef
        def sq_vd_alter(SQ_STMT* st, byte* t, int n, int i, byte** pq) -> int
        {
            int i0, ux, nxx, j2, cc, ro, co, hd, ad, init, k, ns, nl, j, found, cs, ce, depth, off, p, a, rw, rw2, n1, n2, ne, nx, ck, wn, q, nx2, lc;
            byte* sqlt;
            SQ_SB sb, kt;
            SQ_IDX[12] ixs;
            SQ_TI* ti;
            byte c;
            i0 = i;
            i = sq_vd_skip(t, n, i);
            k = sq_vd_ident(t, n, i, @ns, @nl);
            if (k < 0) { if (sq_vd_gon(541) == 1) { sq_seterr(st, "EXPLAIN is not available for this ALTER TABLE #541\0"); return 1; }; };
            if (k < n) { if (t[k] == (byte)46) { if (sq_vd_gon(542) == 1) { sq_seterr(st, "EXPLAIN is not available for this ALTER TABLE #542\0"); return 1; }; }; };
            i = sq_vd_skip(t, n, k);
            k = sq_vd_word(t, n, i, "add\0");
            if (k < 0) { return sq_vd_alter2(st, t, n, i0, pq); };
            i = sq_vd_skip(t, n, k);
            k = sq_vd_word(t, n, i, "column\0");
            if (k >= 0) { i = sq_vd_skip(t, n, k); };
            cs = i;
            ce = n;
            while (ce > cs) { c = t[ce - 1]; if (c == (byte)59 | c == (byte)32 | c == (byte)9 | c == (byte)10 | c == (byte)13) { ce--; } else { break; }; };
            if (ce <= cs) { if (sq_vd_gon(543) == 1) { sq_seterr(st, "EXPLAIN is not available for this ALTER TABLE #543\0"); return 1; }; };
            cc = sq_vd_colcheck(t, cs, ce);
            if (cc == 1) { if (sq_vd_gon(544) == 1) { sq_seterr(st, "EXPLAIN is not available for this column definition #544\0"); return 1; }; };
            found = 0 - 1;
            for (j = 0; j < st.db.nschema; j++)
            {
                if (st.db.schema[j].kind != 1) { continue; };
                if (sq_vd_nameeq(st.db.schema[j].name, t, ns, nl)) { found = j; };
            };
            if (found < 0) { if (sq_vd_gon(545) == 1) { sq_seterr(st, "EXPLAIN is not available for this ALTER TABLE #545\0"); return 1; }; };
            sqlt = st.db.schema[found].sql;
            if ((u64)sqlt == (u64)0) { if (sq_vd_gon(546) == 1) { sq_seterr(st, "EXPLAIN is not available for this ALTER TABLE #546\0"); return 1; }; };
            ti = (SQ_TI*)fmalloc((u64)(sizeof(SQ_TI) / 8 + 4096));
            if ((u64)ti == (u64)0) { sq_seterr(st, "out of memory\0"); return 1; };
            if (sq_ti_load(ti, sqlt) != 0) { ffree((u64)ti); sq_seterr(st, "EXPLAIN is not available for this ALTER TABLE\0"); return 1; };
            if (ti.wor != 0 | ti.ngen != 0) { ffree((u64)ti); sq_seterr(st, "EXPLAIN is not available for this table\0"); return 1; };
            ux = 0 - 1;
            if (cc == 2)
            {
                nxx = sq_idx_list(st.db, found, ti, @ixs[0], 12);
                for (j2 = 0; j2 < nxx; j2++)
                {
                    if (ixs[j2].partial != 0) { continue; };
                    if (ux < 0) { ux = j2; } else { if (ixs[j2].nk < ixs[ux].nk) { ux = j2; }; };
                };
            };
            ffree((u64)ti);
            wn = sq_cstrlen(sqlt);
            for (j = 0; j + 6 <= wn; j++) { if (sq_vd_word(sqlt, wn, j, "strict\0") >= 0 & j > 0) { if (sq_vd_gon(547) == 1) { sq_seterr(st, "EXPLAIN is not available for this table #547\0"); return 1; }; }; };
            // addColOffset: the ')' that closes the column list, or the comma that starts the table constraints
            off = 0 - 1;
            depth = 0;
            p = 0;
            while (p < wn)
            {
                c = sqlt[p];
                if (c == (byte)39 | c == (byte)34 | c == (byte)96)
                {
                    q = p + 1;
                    while (q < wn) { if (sqlt[q] == c) { if (q + 1 < wn) { if (sqlt[q + 1] == c) { q = q + 2; continue; }; }; break; }; q++; };
                    p = q + 1;
                    continue;
                };
                if (c == (byte)40) { depth++; };
                if (c == (byte)41) { depth--; if (depth == 0) { off = p; break; }; };
                if (c == (byte)44 & depth == 1)
                {
                    nx2 = sq_vd_skip(sqlt, wn, p + 1);
                    if (sq_vd_word(sqlt, wn, nx2, "constraint\0") >= 0 | sq_vd_word(sqlt, wn, nx2, "primary\0") >= 0 | sq_vd_word(sqlt, wn, nx2, "unique\0") >= 0 | sq_vd_word(sqlt, wn, nx2, "check\0") >= 0 | sq_vd_word(sqlt, wn, nx2, "foreign\0") >= 0) { off = p; break; };
                };
                p++;
            };
            if (off < 0) { if (sq_vd_gon(548) == 1) { sq_seterr(st, "EXPLAIN is not available for this ALTER TABLE #548\0"); return 1; }; };
            ck = st.db.cookie;
            ro = 0; co = 0; hd = 0;
            if (cc == 2) { ro = 2; co = 1; hd = 1; };
            if (ux >= 0) { co = 2; };
            sq_vd_reset();
            init = sq_vd_op("Init\0", 0, 0, 0);
            if (hd != 0)
            {
                if (ux >= 0)
                {
                    a = sq_vd_op("OpenRead\0", 1, ixs[ux].root, 0);
                    sq_sb_init(@kt);
                    if (sq_vd_kinfo(@ixs[ux], @kt) != 0) { sq_sb_free(@kt); sq_seterr(st, "EXPLAIN is not available for this index collation\0"); return 1; };
                    sq_vd_p4s(a, kt.p, kt.n);
                    sq_sb_free(@kt);
                    rw = sq_vd_op("Rewind\0", 1, 0, 1);
                    sq_vd_p4i(rw, (i64)0);
                    ad = sq_vd_op("Halt\0", 1, 2, 2);
                    sq_vd_op("ResultRow\0", 1, 1, 0);
                    nx = sq_vd_op("Next\0", 1, ad, 0);
                }
                else
                {
                    a = sq_vd_op("OpenRead\0", 0, st.db.schema[found].rootpage, 0);
                    sq_vd_p4i(a, (i64)0);
                    rw = sq_vd_op("Rewind\0", 0, 0, 0);
                    ad = sq_vd_op("Halt\0", 1, 2, 2);
                    sq_vd_op("ResultRow\0", 1, 1, 0);
                    nx = sq_vd_op("Next\0", 0, ad, 0);
                };
                VD_P5[nx] = 1;
                VD_P2[rw] = VD_N;
            };
            sq_vd_op("Null\0", 0, 1 + ro, 2 + ro);
            sq_vd_op("OpenEphemeral\0", 1 + co, 0, 1 + ro);
            a = sq_vd_op("OpenRead\0", co, 1, 0);
            sq_vd_p4i(a, (i64)2);
            rw = sq_vd_op("Rewind\0", co, 0, 0);
            sq_vd_op("Column\0", co, 0, 8 + ro);
            n1 = sq_vd_op("Ne\0", 9 + ro, 0, 8 + ro);
            sq_vd_p4s(n1, "BINARY-8\0", 8);
            sq_vd_op("Column\0", co, 1, 8 + ro);
            n2 = sq_vd_op("Ne\0", 10 + ro, 0, 8 + ro);
            sq_vd_p4s(n2, "BINARY-8\0", 8);
            VD_P5[n1] = 82; VD_P5[n2] = 82;
            sq_vd_op("Rowid\0", co, 2 + ro, 0);
            sq_vd_op("Insert\0", 1 + co, 1 + ro, 2 + ro);
            nx = sq_vd_op("Next\0", co, rw + 1, 0);
            VD_P5[nx] = 1;
            VD_P2[n1] = nx; VD_P2[n2] = nx;
            VD_P2[rw] = VD_N;
            a = sq_vd_op("OpenWrite\0", co, 1, 0);
            sq_vd_p4i(a, (i64)5);
            rw2 = sq_vd_op("Rewind\0", 1 + co, 0, 0);
            sq_vd_op("Rowid\0", 1 + co, 2 + ro, 0);
            ne = sq_vd_op("NotExists\0", co, 0, 2 + ro);
            sq_vd_op("Column\0", co, 0, 3 + ro);
            sq_vd_op("Column\0", co, 1, 4 + ro);
            sq_vd_op("Column\0", co, 2, 5 + ro);
            sq_vd_op("Column\0", co, 3, 6 + ro);
            sq_vd_op("Column\0", co, 4, 14 + ro);
            a = sq_vd_op("Function\0", 1, 13 + ro, 12 + ro);
            sq_vd_p4s(a, "printf(-1)\0", 10);
            sq_vd_op("Concat\0", 15 + ro, 12 + ro, 8 + ro);
            sq_vd_op("Column\0", co, 4, 16 + ro);
            sq_vd_op("Column\0", co, 4, 22 + ro);
            a = sq_vd_op("Function\0", 1, 21 + ro, 20 + ro);
            sq_vd_p4s(a, "printf(-1)\0", 10);
            a = sq_vd_op("Function\0", 0, 20 + ro, 19 + ro);
            sq_vd_p4s(a, "length(1)\0", 9);
            sq_vd_op("Add\0", 19 + ro, 18 + ro, 17 + ro);
            a = sq_vd_op("Function\0", 0, 16 + ro, 12 + ro);
            sq_vd_p4s(a, "substr(2)\0", 9);
            sq_vd_op("Concat\0", 12 + ro, 8 + ro, 7 + ro);
            a = sq_vd_op("MakeRecord\0", 3 + ro, 5, 11 + ro);
            sq_vd_p4s(a, "BBBDB\0", 5);
            sq_vd_op("Insert\0", co, 11 + ro, 2 + ro);
            nx = sq_vd_op("Next\0", 1 + co, rw2 + 1, 0);
            VD_P2[ne] = nx;
            VD_P2[rw2] = VD_N;
            sq_vd_op("ReadCookie\0", 0, 12 + ro, 2);
            sq_vd_op("AddImm\0", 12 + ro, 0 - 2, 0);
            sq_vd_op("IfPos\0", 12 + ro, VD_N + 2, 0);
            sq_vd_op("SetCookie\0", 0, 2, 3);
            sq_vd_op("SetCookie\0", 0, 1, ck + 1);
            a = sq_vd_op("ParseSchema\0", 0, 0, 0);
            VD_P5[a] = 3;
            a = sq_vd_op("ParseSchema\0", 1, 0, 0);
            VD_P5[a] = 3;
            sq_vd_op("Halt\0", 0, 0, 0);
            VD_P2[init] = VD_N;
            sq_vd_trans(st.db, 1);
            if (hd != 0)
            {
                a = sq_vd_op("String8\0", 0, 2, 0);
                sq_vd_p4s(a, "Cannot add a NOT NULL column with default value NULL\0", 52);
            };
            a = sq_vd_op("String8\0", 0, 9 + ro, 0);
            sq_vd_p4s(a, "table\0", 5);
            a = sq_vd_op("String8\0", 0, 10 + ro, 0);
            sq_vd_p4s(a, st.db.schema[found].name, sq_cstrlen(st.db.schema[found].name));
            a = sq_vd_op("String8\0", 0, 13 + ro, 0);
            sq_sb_init(@sb);
            sq_sb_lit(@sb, "%.\0");
            sq_sb_int(@sb, (i64)off);
            sq_sb_lit(@sb, "s, \0");
            sq_vd_p4s(a, sb.p, sb.n);
            sq_sb_free(@sb);
            a = sq_vd_op("String8\0", 0, 15 + ro, 0);
            sq_vd_p4s(a, @t[cs], ce - cs);
            sq_vd_op("Integer\0", 1, 18 + ro, 0);
            a = sq_vd_op("String8\0", 0, 21 + ro, 0);
            sq_sb_init(@sb);
            sq_sb_lit(@sb, "%.\0");
            sq_sb_int(@sb, (i64)off);
            sq_sb_lit(@sb, "s\0");
            sq_vd_p4s(a, sb.p, sb.n);
            sq_sb_free(@sb);
            sq_vd_op("Goto\0", 0, 1, 0);
            sq_vd_query(pq);
            return 0;
        };

        // REINDEX [table | index | collation]
        def sq_vd_reindex(SQ_STMT* st, byte* t, int n, int i, byte** pq) -> int
        {
            int init, k, ns, nl, j, pass, found, tpos, only, isstat, x, iscol, no;
            int[3] pmax;
            int[96] ordv;
            byte* tn;
            i = sq_vd_skip(t, n, i);
            ns = 0; nl = 0; found = 0 - 1; only = 0 - 1; tpos = 0 - 1; isstat = 0; iscol = 0; pmax[0] = 1; pmax[1] = 0; pmax[2] = 0;
            if (i < n)
            {
                k = sq_vd_ident(t, n, i, @ns, @nl);
                if (k < 0) { if (sq_vd_gon(549) == 1) { sq_seterr(st, "EXPLAIN is not available for this REINDEX #549\0"); return 1; }; };
                if (k < n) { if (t[k] == (byte)46) { if (sq_vd_gon(550) == 1) { sq_seterr(st, "EXPLAIN is not available for this REINDEX #550\0"); return 1; }; }; };
                i = sq_vd_skip(t, n, k);
                if (i < n) { if (sq_vd_gon(551) == 1) { sq_seterr(st, "EXPLAIN is not available for this REINDEX #551\0"); return 1; }; };
                for (j = 0; j < st.db.nschema; j++)
                {
                    if (st.db.schema[j].kind != 2 & st.db.schema[j].kind != 1) { continue; };
                    if (sq_vd_nameeq(st.db.schema[j].name, t, ns, nl)) { found = j; };
                };
                if (found < 0)
                {
                    if (nl == 6 & sq_vd_word(t, n, ns, "nocase\0") >= 0) { isstat = 1; iscol = 1; };
                    if (nl == 5 & sq_vd_word(t, n, ns, "rtrim\0") >= 0) { isstat = 1; iscol = 1; };
                    if (nl == 6 & sq_vd_word(t, n, ns, "binary\0") >= 0) { found = 0 - 2; };
                    if (isstat == 0 & found != 0 - 2) { if (sq_vd_gon(552) == 1) { sq_seterr(st, "EXPLAIN is not available for this REINDEX #552\0"); return 1; }; };
                };
            };
            sq_vd_reset();
            VD_NH = 0; VD_NH0 = 0;
            init = sq_vd_op("Init\0", 0, 0, 0);
            pass = 0;
            if (isstat == 0)
            {
                if (found >= 0)
                {
                    if (st.db.schema[found].kind == 2)
                    {
                        only = found;
                        tn = st.db.schema[found].tbl_name;
                        if (sq_vd_reindex_tab(st, tn, sq_cstrlen(tn), only, @pass, 0, @pmax[0]) != 0) { return 1; };
                    }
                    else
                    {
                        if (sq_vd_reindex_tab(st, @t[ns], nl, 0 - 1, @pass, 0, @pmax[0]) != 0) { return 1; };
                    };
                }
                else
                {
                    // SQLite walks its table hash
                    x = sq_vd_tblorder(st.db, @ordv[0]);
                    if (x < 0) { if (sq_vd_gon(553) == 1) { sq_seterr(st, "EXPLAIN is not available for REINDEX over this many tables #553\0"); return 1; }; };
                    pass = 0;
                    for (j = 0; j < x; j++)
                    {
                        if (ordv[j] < 0) { continue; };
                        if (st.db.schema[ordv[j]].kind != 1) { continue; };
                        tn = @st.db.schema[ordv[j]].name[0];
                        if (sq_vd_reindex_tab(st, tn, sq_cstrlen(tn), 0 - 1, @pass, 0, @pmax[0]) != 0) { return 1; };
                    };
                };
            };
            if (isstat == 1 & iscol == 1)
            {
                for (j = 0; j < st.db.nschema; j++)
                {
                    if (st.db.schema[j].kind != 1) { continue; };
                    tn = st.db.schema[j].name;
                    if (sq_vd_reindex_tab(st, tn, sq_cstrlen(tn), 0 - 1, @pass, 1, @pmax[0]) != 0) { return 1; };
                };
            };
            sq_vd_op("Halt\0", 0, 0, 0);
            VD_P2[init] = VD_N;
            if (pass > 0) { sq_vd_trans(st.db, 1); };
            for (k = 0; k < VD_NH; k++) { sq_vd_lit((SQ_STMT*)0, VD_HN[k], VD_HR[k]); };
            sq_vd_op("Goto\0", 0, 1, 0);
            sq_vd_query(pq);
            return 0;
        };

        // PRAGMA statements that read or write a setting, and table_info / table_xinfo / index_list
        // returns -1 when the pragma is not one of these, otherwise 0 or 1 like the other builders
        def sq_vd_pragma2(SQ_STMT* st, byte* t, int n, int i, byte** pq) -> int
        {
            SQLITE_DB* db = st.db;
            SQ_TI* ti;
            SQ_IDX* ixs;
            byte[96] nm;
            int ns, nl, k, ps, pl, init, a, c, tp, cls, pi, hasv, isnum, neg, x, nix, seq, hid, pkpos, q;
            i64 v;
            byte ch;
            k = sq_vd_ident(t, n, i, @ns, @nl);
            if (k < 0) { return 0 - 1; };
            i = sq_vd_skip(t, n, k);
            hasv = 0; isnum = 0; ps = 0; pl = 0; v = (i64)0; neg = 0;
            if (i < n)
            {
                if (t[i] == (byte)40 | t[i] == (byte)61)
                {
                    q = 0;
                    if (t[i] == (byte)40) { q = 1; };
                    i = sq_vd_skip(t, n, i + 1);
                    if (i < n & t[i] == (byte)45) { neg = 1; i = sq_vd_skip(t, n, i + 1); };
                    if (i < n)
                    {
                        if (t[i] >= (byte)48 & t[i] <= (byte)57)
                        {
                            while (i < n)
                            {
                                ch = t[i];
                                if (ch < (byte)48 | ch > (byte)57) { break; };
                                v = v * (i64)10 + (i64)(ch - (byte)48);
                                i++;
                            };
                            isnum = 1;
                            ps = i; pl = 0;
                        }
                        else
                        {
                            x = sq_vd_ident2(t, n, i, @ps, @pl);
                            if (x < 0) { return 0 - 1; };
                            i = x;
                        };
                    }
                    else { return 0 - 1; };
                    i = sq_vd_skip(t, n, i);
                    if (q == 1)
                    {
                        if (i >= n) { return 0 - 1; };
                        if (t[i] != (byte)41) { return 0 - 1; };
                        i = sq_vd_skip(t, n, i + 1);
                    };
                    if (i < n) { return 0 - 1; };
                    hasv = 1;
                    if (neg == 1) { v = (i64)0 - v; };
                }
                else { return 0 - 1; };
            };
            if (sq_ieq(@t[ns], nl, "table_info\0") | sq_ieq(@t[ns], nl, "table_xinfo\0") | sq_ieq(@t[ns], nl, "index_list\0"))
            {
                if (hasv == 0 | isnum == 1 | pl > 90) { return 0 - 1; };
                for (k = 0; k < pl; k++) { nm[k] = t[ps + k]; };
                nm[pl] = (byte)0;
                tp = sq_find_table_n(db, @nm[0], pl);
                sq_vd_reset();
                init = sq_vd_op("Init\0", 0, 0, 0);
                sq_vd_op("Expire\0", 1, 1, 0);
                if (tp >= 0)
                {
                    if ((u64)db.schema[tp].sql == (u64)0 | db.schema[tp].kind != 1) { if (sq_vd_gon(554) == 1) { sq_seterr(st, "EXPLAIN is not available for this PRAGMA #554\0"); return 1; }; };
                    ti = (SQ_TI*)fmalloc((u64)(sizeof(SQ_TI) / 8 + 4096));
                    if ((u64)ti == (u64)0) { sq_seterr(st, "out of memory\0"); return 1; };
                    if (sq_ti_load(ti, db.schema[tp].sql) != 0) { ffree((u64)ti); sq_seterr(st, "cannot read table definition\0"); return 1; };
                    if (sq_ieq(@t[ns], nl, "index_list\0"))
                    {
                        if (ti.wor != 0) { ffree((u64)ti); sq_seterr(st, "EXPLAIN is not available for this PRAGMA\0"); return 1; };
                        ixs = (SQ_IDX*)fmalloc((u64)(sizeof(SQ_IDX) / 8 + 8) * (u64)24);
                        if ((u64)ixs == (u64)0) { ffree((u64)ti); sq_seterr(st, "out of memory\0"); return 1; };
                        nix = sq_idx_list(db, tp, ti, ixs, 24);
                        seq = 0;
                        for (k = nix - 1; k >= 0; k--)
                        {
                            sq_vd_op("Integer\0", seq, 1, 0);
                            seq++;
                            a = sq_vd_op("String8\0", 0, 2, 0);
                            sq_vd_p4s(a, @ixs[k].name[0], sq_cstrlen(@ixs[k].name[0]));
                            sq_vd_op("Integer\0", ixs[k].unique, 3, 0);
                            a = sq_vd_op("String8\0", 0, 4, 0);
                            if ((u64)db.schema[ixs[k].schema_pos].sql != (u64)0) { sq_vd_p4s(a, "c\0", 1); }
                            else { if (ixs[k].ispk == 1) { sq_vd_p4s(a, "pk\0", 2); } else { sq_vd_p4s(a, "u\0", 1); }; };
                            sq_vd_op("Integer\0", ixs[k].partial, 5, 0);
                            sq_vd_op("ResultRow\0", 1, 5, 0);
                        };
                        ffree((u64)ixs);
                    }
                    else
                    {
                        hid = 0;
                        if (sq_ieq(@t[ns], nl, "table_xinfo\0")) { hid = 1; };
                        seq = 0;
                        for (c = 0; c < ti.ncols; c++)
                        {
                            if (ti.gen[c] != 0 & hid == 0) { continue; };
                            if (hid == 1) { sq_vd_op("Integer\0", c, 1, 0); } else { sq_vd_op("Integer\0", seq, 1, 0); };
                            seq++;
                            a = sq_vd_op("String8\0", 0, 2, 0);
                            sq_vd_p4s(a, @ti.base[ti.cs[c]], ti.cl[c]);
                            a = sq_vd_op("String8\0", 0, 3, 0);
                            x = ti.tyl[c];
                            if (x > 60) { x = 60; };
                            if (x < 0) { x = 0; };
                            for (k = 0; k < x; k++)
                            {
                                nm[k] = ti.base[ti.tys[c] + k];
                            };
                            if (sq_ieq(@ti.base[ti.tys[c]], ti.tyl[c], "int\0") | sq_ieq(@ti.base[ti.tys[c]], ti.tyl[c], "integer\0") | sq_ieq(@ti.base[ti.tys[c]], ti.tyl[c], "real\0") | sq_ieq(@ti.base[ti.tys[c]], ti.tyl[c], "text\0") | sq_ieq(@ti.base[ti.tys[c]], ti.tyl[c], "blob\0") | sq_ieq(@ti.base[ti.tys[c]], ti.tyl[c], "any\0"))
                            {
                                for (k = 0; k < x; k++) { if (nm[k] >= (byte)97 & nm[k] <= (byte)122) { nm[k] = (byte)(nm[k] - 32); }; };
                            };
                            sq_vd_p4s(a, @nm[0], x);
                            sq_vd_op("Integer\0", ti.notnull[c], 4, 0);
                            if (ti.dfl[c] > 0) { a = sq_vd_op("String8\0", 0, 5, 0); sq_vd_p4s(a, @ti.base[ti.dfs[c]], ti.dfl[c]); }
                            else { sq_vd_op("Null\0", 0, 5, 0); };
                            pkpos = 0;
                            for (k = 0; k < ti.npk; k++) { if (ti.pkc[k] == c) { pkpos = k + 1; }; };
                            sq_vd_op("Integer\0", pkpos, 6, 0);
                            if (hid == 1)
                            {
                                x = 0;
                                if (ti.gen[c] == 1) { x = 2; };
                                if (ti.gen[c] == 2) { x = 3; };
                                sq_vd_op("Integer\0", x, 7, 0);
                                sq_vd_op("ResultRow\0", 1, 7, 0);
                            }
                            else { sq_vd_op("ResultRow\0", 1, 6, 0); };
                        };
                    };
                    ffree((u64)ti);
                };
                sq_vd_op("Halt\0", 0, 0, 0);
                VD_P2[init] = VD_N;
                sq_vd_trans(db, 0);
                if (VD_TEMPDB == 1 & sq_ieq(@t[ns], nl, "index_list\0") == false)
                {
                    a = sq_vd_op("Transaction\0", 1, 0, 0);
                    sq_vd_p4i(a, 0);
                    VD_P5[a] = 1;
                };
                sq_vd_op("Goto\0", 0, 1, 0);
                sq_vd_query(pq);
                return 0;
            };
            if (sq_ieq(@t[ns], nl, "page_size\0") & hasv == 0)
            {
                sq_vd_reset();
                init = sq_vd_op("Init\0", 0, 0, 0);
                sq_vd_op("Expire\0", 1, 1, 0);
                a = sq_vd_op("Int64\0", 0, 1, 0);
                sq_vd_p4i(a, (i64)db.page_size);
                sq_vd_op("ResultRow\0", 1, 1, 0);
                sq_vd_op("Halt\0", 0, 0, 0);
                VD_P2[init] = VD_N;
                sq_vd_op("Goto\0", 0, 1, 0);
                sq_vd_query(pq);
                return 0;
            };
            if (sq_ieq(@t[ns], nl, "journal_mode\0"))
            {
                x = 0 - 1;
                if (hasv == 1)
                {
                    if (isnum == 1) { return 0 - 1; };
                    if (sq_ieq(@t[ps], pl, "delete\0")) { x = 0; };
                    if (sq_ieq(@t[ps], pl, "persist\0")) { x = 1; };
                    if (sq_ieq(@t[ps], pl, "off\0")) { x = 2; };
                    if (sq_ieq(@t[ps], pl, "truncate\0")) { x = 3; };
                    if (sq_ieq(@t[ps], pl, "memory\0")) { x = 4; };
                    if (sq_ieq(@t[ps], pl, "wal\0")) { x = 5; };
                    if (x < 0) { return 0 - 1; };
                };
                sq_vd_reset();
                init = sq_vd_op("Init\0", 0, 0, 0);
                sq_vd_op("Expire\0", 1, 1, 0);
                sq_vd_op("JournalMode\0", 0, 1, x);
                sq_vd_op("ResultRow\0", 1, 1, 0);
                sq_vd_op("Halt\0", 0, 0, 0);
                VD_P2[init] = VD_N;
                sq_vd_op("Goto\0", 0, 1, 0);
                sq_vd_query(pq);
                return 0;
            };
            // class: 1 setting is echoed when written, 2 write only flags the statement, 3 write does nothing, 0 unknown
            cls = 0;
            if (sq_ieq(@t[ns], nl, "busy_timeout\0") | sq_ieq(@t[ns], nl, "secure_delete\0")) { cls = 1; };
            if (sq_ieq(@t[ns], nl, "foreign_keys\0") | sq_ieq(@t[ns], nl, "recursive_triggers\0") | sq_ieq(@t[ns], nl, "automatic_index\0")) { cls = 2; };
            if (sq_ieq(@t[ns], nl, "cache_size\0") | sq_ieq(@t[ns], nl, "synchronous\0") | sq_ieq(@t[ns], nl, "temp_store\0")) { cls = 3; };
            if (cls == 0) { return 0 - 1; };
            if (hasv == 1)
            {
                if (isnum == 0)
                {
                    if (sq_ieq(@t[ps], pl, "on\0") | sq_ieq(@t[ps], pl, "true\0") | sq_ieq(@t[ps], pl, "yes\0")) { v = (i64)1; isnum = 1; };
                    if (sq_ieq(@t[ps], pl, "off\0") | sq_ieq(@t[ps], pl, "false\0") | sq_ieq(@t[ps], pl, "no\0")) { v = (i64)0; isnum = 1; };
                };
                if (isnum == 0) { return 0 - 1; };
            };
            sq_vd_reset();
            init = sq_vd_op("Init\0", 0, 0, 0);
            sq_vd_op("Expire\0", 1, 1, 0);
            if (hasv == 0 | cls == 1)
            {
                if (hasv == 0)
                {
                    pi = sq_pr_find(@t[ns], nl);
                    if (pi < 0) { if (sq_vd_gon(555) == 1) { sq_seterr(st, "EXPLAIN is not available for this PRAGMA #555\0"); return 1; }; };
                    if (SQ_PRS[pi] == 1) { v = (i64)SQ_PRV[pi]; } else { v = sq_pr_default(pi); };
                    if (pi == 19) { v = (i64)SQ_FK; };
                };
                a = sq_vd_op("Int64\0", 0, 1, 0);
                sq_vd_p4i(a, v);
                sq_vd_op("ResultRow\0", 1, 1, 0);
            }
            else { if (cls == 2) { sq_vd_op("Expire\0", 0, 0, 0); }; };
            sq_vd_op("Halt\0", 0, 0, 0);
            VD_P2[init] = VD_N;
            sq_vd_op("Goto\0", 0, 1, 0);
            sq_vd_query(pq);
            return 0;
        };

        def sq_vd_misc(SQ_STMT* st, byte* t, int n, byte** pq) -> int
        {
            int i, j, k, init, a, mode, ns, nl, ck, neg, set, x;
            i64 v;
            byte c;
            mode = 0 - 1;
            i = sq_vd_skip(t, n, 0);
            k = sq_vd_word(t, n, i, "begin\0");
            if (k >= 0)
            {
                i = sq_vd_skip(t, n, k);
                mode = 0;
                k = sq_vd_word(t, n, i, "deferred\0");
                if (k >= 0) { i = sq_vd_skip(t, n, k); };
                k = sq_vd_word(t, n, i, "immediate\0");
                if (k >= 0) { mode = 1; i = sq_vd_skip(t, n, k); };
                k = sq_vd_word(t, n, i, "exclusive\0");
                if (k >= 0) { mode = 2; i = sq_vd_skip(t, n, k); };
                k = sq_vd_word(t, n, i, "transaction\0");
                if (k >= 0) { i = sq_vd_skip(t, n, k); };
                if (i < n) { if (sq_vd_gon(556) == 1) { sq_seterr(st, "EXPLAIN is not available for this statement #556\0"); return 1; }; };
                sq_vd_reset();
                init = sq_vd_op("Init\0", 0, 0, 0);
                if (mode > 0)
                {
                    sq_vd_op("Transaction\0", 0, mode, 0);
                    sq_vd_op("Transaction\0", 1, mode, 0);
                };
                sq_vd_op("AutoCommit\0", 0, 0, 0);
                sq_vd_op("Halt\0", 0, 0, 0);
                VD_P2[init] = VD_N;
                sq_vd_op("Goto\0", 0, 1, 0);
                sq_vd_query(pq);
                return 0;
            };
            mode = 0 - 1;
            k = sq_vd_word(t, n, i, "commit\0");
            if (k < 0) { k = sq_vd_word(t, n, i, "end\0"); };
            if (k >= 0) { mode = 0; };
            if (mode < 0)
            {
                k = sq_vd_word(t, n, i, "rollback\0");
                if (k >= 0) { mode = 1; };
            };
            if (mode >= 0)
            {
                i = sq_vd_skip(t, n, k);
                k = sq_vd_word(t, n, i, "transaction\0");
                if (k >= 0) { i = sq_vd_skip(t, n, k); };
                if (mode == 1)
                {
                    k = sq_vd_word(t, n, i, "to\0");
                    if (k >= 0)
                    {
                        i = sq_vd_skip(t, n, k);
                        mode = 2;
                        k = sq_vd_word(t, n, i, "savepoint\0");
                        if (k >= 0) { i = sq_vd_skip(t, n, k); };
                        k = sq_vd_ident(t, n, i, @ns, @nl);
                        if (k < 0) { if (sq_vd_gon(557) == 1) { sq_seterr(st, "EXPLAIN is not available for this statement #557\0"); return 1; }; };
                        i = sq_vd_skip(t, n, k);
                        if (i < n) { if (sq_vd_gon(558) == 1) { sq_seterr(st, "EXPLAIN is not available for this statement #558\0"); return 1; }; };
                        sq_vd_reset();
                        init = sq_vd_op("Init\0", 0, 0, 0);
                        a = sq_vd_op("Savepoint\0", 2, 0, 0);
                        sq_vd_p4s(a, @t[ns], nl);
                        sq_vd_op("Halt\0", 0, 0, 0);
                        VD_P2[init] = VD_N;
                        sq_vd_op("Goto\0", 0, 1, 0);
                        sq_vd_query(pq);
                        return 0;
                    };
                };
                if (i < n) { if (sq_vd_gon(559) == 1) { sq_seterr(st, "EXPLAIN is not available for this statement #559\0"); return 1; }; };
                sq_vd_reset();
                init = sq_vd_op("Init\0", 0, 0, 0);
                sq_vd_op("AutoCommit\0", 1, mode, 0);
                sq_vd_op("Halt\0", 0, 0, 0);
                VD_P2[init] = VD_N;
                sq_vd_op("Goto\0", 0, 1, 0);
                sq_vd_query(pq);
                return 0;
            };
            mode = 0 - 1;
            k = sq_vd_word(t, n, i, "savepoint\0");
            if (k >= 0) { mode = 0; };
            if (mode < 0)
            {
                k = sq_vd_word(t, n, i, "release\0");
                if (k >= 0) { mode = 1; };
            };
            if (mode >= 0)
            {
                i = sq_vd_skip(t, n, k);
                if (mode == 1)
                {
                    k = sq_vd_word(t, n, i, "savepoint\0");
                    if (k >= 0) { i = sq_vd_skip(t, n, k); };
                };
                k = sq_vd_ident(t, n, i, @ns, @nl);
                if (k < 0) { if (sq_vd_gon(560) == 1) { sq_seterr(st, "EXPLAIN is not available for this statement #560\0"); return 1; }; };
                i = sq_vd_skip(t, n, k);
                if (i < n) { if (sq_vd_gon(561) == 1) { sq_seterr(st, "EXPLAIN is not available for this statement #561\0"); return 1; }; };
                sq_vd_reset();
                init = sq_vd_op("Init\0", 0, 0, 0);
                a = sq_vd_op("Savepoint\0", mode, 0, 0);
                sq_vd_p4s(a, @t[ns], nl);
                sq_vd_op("Halt\0", 0, 0, 0);
                VD_P2[init] = VD_N;
                sq_vd_op("Goto\0", 0, 1, 0);
                sq_vd_query(pq);
                return 0;
            };
            k = sq_vd_word(t, n, i, "create\0");
            if (k >= 0)
            {
                i = sq_vd_skip(t, n, k);
                k = sq_vd_word(t, n, i, "table\0");
                if (k >= 0)
                {
                    c = sq_vd_ctas(st, t, n, k, pq);
                    if (c != 2) { return c; };
                    return sq_vd_create_table(st, t, n, k, pq);
                };
                k = sq_vd_word(t, n, i, "view\0");
                if (k >= 0) { return sq_vd_create_view(st, t, n, k, pq); };
                k = sq_vd_word(t, n, i, "trigger\0");
                if (k >= 0) { return sq_vd_create_trigger(st, t, n, k, pq); };
                k = sq_vd_word(t, n, i, "unique\0");
                if (k >= 0)
                {
                    i = sq_vd_skip(t, n, k);
                    k = sq_vd_word(t, n, i, "index\0");
                    if (k >= 0) { return sq_vd_create_index(st, t, n, k, 1, pq); };
                };
                k = sq_vd_word(t, n, i, "index\0");
                if (k >= 0) { return sq_vd_create_index(st, t, n, k, 0, pq); };
                sq_seterr(st, "EXPLAIN is not available for this statement\0");
                return 1;
            };
            k = sq_vd_word(t, n, i, "drop\0");
            if (k >= 0)
            {
                i = sq_vd_skip(t, n, k);
                k = sq_vd_word(t, n, i, "table\0");
                if (k >= 0) { return sq_vd_drop(st, t, n, k, 1, pq); };
                k = sq_vd_word(t, n, i, "index\0");
                if (k >= 0) { return sq_vd_drop(st, t, n, k, 0, pq); };
                k = sq_vd_word(t, n, i, "view\0");
                if (k >= 0) { return sq_vd_drop_vt(st, t, n, k, 1, pq); };
                k = sq_vd_word(t, n, i, "trigger\0");
                if (k >= 0) { return sq_vd_drop_vt(st, t, n, k, 0, pq); };
                sq_seterr(st, "EXPLAIN is not available for this statement\0");
                return 1;
            };
            k = sq_vd_word(t, n, i, "reindex\0");
            if (k >= 0) { return sq_vd_reindex(st, t, n, k, pq); };
            k = sq_vd_word(t, n, i, "analyze\0");
            if (k >= 0) { return sq_vd_analyze(st, t, n, k, pq); };
            k = sq_vd_word(t, n, i, "alter\0");
            if (k >= 0)
            {
                j = sq_vd_skip(t, n, k);
                k = sq_vd_word(t, n, j, "table\0");
                if (k < 0) { if (sq_vd_gon(562) == 1) { sq_seterr(st, "EXPLAIN is not available for this statement #562\0"); return 1; }; };
                return sq_vd_alter(st, t, n, k, pq);
            };
            k = sq_vd_word(t, n, i, "attach\0");
            if (k >= 0)
            {
                i = sq_vd_skip(t, n, k);
                k = sq_vd_word(t, n, i, "database\0");
                if (k >= 0) { i = sq_vd_skip(t, n, k); };
                if (i >= n) { if (sq_vd_gon(563) == 1) { sq_seterr(st, "EXPLAIN is not available for this ATTACH #563\0"); return 1; }; };
                if (t[i] != (byte)39) { if (sq_vd_gon(564) == 1) { sq_seterr(st, "EXPLAIN is not available for this ATTACH #564\0"); return 1; }; };
                k = sq_vd_ident2(t, n, i, @ns, @nl);
                if (k < 0) { if (sq_vd_gon(565) == 1) { sq_seterr(st, "EXPLAIN is not available for this ATTACH #565\0"); return 1; }; };
                i = sq_vd_skip(t, n, k);
                k = sq_vd_word(t, n, i, "as\0");
                if (k < 0) { if (sq_vd_gon(566) == 1) { sq_seterr(st, "EXPLAIN is not available for this ATTACH #566\0"); return 1; }; };
                i = sq_vd_skip(t, n, k);
                k = sq_vd_ident2(t, n, i, @j, @mode);
                if (k < 0) { if (sq_vd_gon(567) == 1) { sq_seterr(st, "EXPLAIN is not available for this ATTACH #567\0"); return 1; }; };
                i = sq_vd_skip(t, n, k);
                if (i < n) { if (sq_vd_gon(568) == 1) { sq_seterr(st, "EXPLAIN is not available for this ATTACH #568\0"); return 1; }; };
                sq_vd_reset();
                init = sq_vd_op("Init\0", 0, 0, 0);
                a = sq_vd_op("String8\0", 0, 1, 0);
                sq_vd_p4s(a, @t[ns], nl);
                a = sq_vd_op("String8\0", 0, 2, 0);
                sq_vd_p4s(a, @t[j], mode);
                sq_vd_op("Null\0", 0, 3, 0);
                a = sq_vd_op("Function\0", 0, 1, 4);
                sq_vd_p4s(a, "sqlite_attach(3)\0", 16);
                sq_vd_op("Expire\0", 1, 0, 0);
                sq_vd_op("Halt\0", 0, 0, 0);
                VD_P2[init] = VD_N;
                sq_vd_op("Goto\0", 0, 1, 0);
                sq_vd_query(pq);
                return 0;
            };
            k = sq_vd_word(t, n, i, "detach\0");
            if (k >= 0)
            {
                i = sq_vd_skip(t, n, k);
                k = sq_vd_word(t, n, i, "database\0");
                if (k >= 0) { i = sq_vd_skip(t, n, k); };
                k = sq_vd_ident2(t, n, i, @ns, @nl);
                if (k < 0) { if (sq_vd_gon(569) == 1) { sq_seterr(st, "EXPLAIN is not available for this DETACH #569\0"); return 1; }; };
                i = sq_vd_skip(t, n, k);
                if (i < n) { if (sq_vd_gon(570) == 1) { sq_seterr(st, "EXPLAIN is not available for this DETACH #570\0"); return 1; }; };
                sq_vd_reset();
                init = sq_vd_op("Init\0", 0, 0, 0);
                sq_vd_op("Null\0", 0, 1, 0);
                sq_vd_op("Null\0", 0, 2, 0);
                a = sq_vd_op("String8\0", 0, 3, 0);
                sq_vd_p4s(a, @t[ns], nl);
                a = sq_vd_op("Function\0", 0, 3, 4);
                sq_vd_p4s(a, "sqlite_detach(1)\0", 16);
                sq_vd_op("Expire\0", 0, 0, 0);
                sq_vd_op("Halt\0", 0, 0, 0);
                VD_P2[init] = VD_N;
                sq_vd_op("Goto\0", 0, 1, 0);
                sq_vd_query(pq);
                return 0;
            };
            k = sq_vd_word(t, n, i, "vacuum\0");
            if (k >= 0)
            {
                i = sq_vd_skip(t, n, k);
                if (i < n) { if (sq_vd_gon(571) == 1) { sq_seterr(st, "EXPLAIN is not available for this VACUUM #571\0"); return 1; }; };
                sq_vd_reset();
                init = sq_vd_op("Init\0", 0, 0, 0);
                sq_vd_op("Vacuum\0", 0, 0, 0);
                sq_vd_op("Halt\0", 0, 0, 0);
                VD_P2[init] = VD_N;
                sq_vd_op("Goto\0", 0, 1, 0);
                sq_vd_query(pq);
                return 0;
            };
            k = sq_vd_word(t, n, i, "pragma\0");
            if (k >= 0)
            {
                i = sq_vd_skip(t, n, k);
                ck = 0 - 1;
                x = sq_vd_pragma2(st, t, n, i, pq);
                if (x >= 0) { return x; };
                k = sq_vd_word(t, n, i, "user_version\0");
                if (k >= 0) { ck = 6; };
                if (ck < 0) { k = sq_vd_word(t, n, i, "application_id\0"); if (k >= 0) { ck = 8; }; };
                if (ck < 0) { k = sq_vd_word(t, n, i, "schema_version\0"); if (k >= 0) { ck = 1; }; };
                if (ck < 0) { if (sq_vd_gon(572) == 1) { sq_seterr(st, "EXPLAIN is not available for this PRAGMA #572\0"); return 1; }; };
                i = sq_vd_skip(t, n, k);
                set = 0;
                v = (i64)0;
                if (i < n)
                {
                    if (t[i] != (byte)61 | ck == 1) { if (sq_vd_gon(573) == 1) { sq_seterr(st, "EXPLAIN is not available for this PRAGMA #573\0"); return 1; }; };
                    i = sq_vd_skip(t, n, i + 1);
                    neg = 0;
                    if (i < n & t[i] == (byte)45) { neg = 1; i++; };
                    if (i >= n) { if (sq_vd_gon(574) == 1) { sq_seterr(st, "EXPLAIN is not available for this PRAGMA #574\0"); return 1; }; };
                    while (i < n)
                    {
                        c = t[i];
                        if (c < (byte)48 | c > (byte)57) { break; };
                        v = v * (i64)10 + (i64)(c - (byte)48);
                        i++;
                    };
                    i = sq_vd_skip(t, n, i);
                    if (i < n) { if (sq_vd_gon(575) == 1) { sq_seterr(st, "EXPLAIN is not available for this PRAGMA #575\0"); return 1; }; };
                    if (neg == 1) { v = (i64)0 - v; };
                    set = 1;
                };
                sq_vd_reset();
                init = sq_vd_op("Init\0", 0, 0, 0);
                if (set == 0)
                {
                    sq_vd_op("Noop\0", 1, 1, 0);
                    sq_vd_op("Transaction\0", 0, 0, 0);
                    sq_vd_op("ReadCookie\0", 0, 1, ck);
                    sq_vd_op("ResultRow\0", 1, 1, 0);
                }
                else
                {
                    sq_vd_op("Expire\0", 1, 1, 0);
                    sq_vd_op("Transaction\0", 0, 1, 0);
                    a = sq_vd_op("SetCookie\0", 0, ck, (int)v);
                    VD_P5[a] = 1;
                };
                sq_vd_op("Halt\0", 0, 0, 0);
                VD_P2[init] = VD_N;
                sq_vd_op("Goto\0", 0, 1, 0);
                sq_vd_query(pq);
                return 0;
            };
            sq_seterr(st, "EXPLAIN is not available for this statement\0");
            return 1;
        };

        def sq_exec_explain_vdbe(SQ_STMT* st, byte** pq) -> int
        {
            SQ_STMT* g;
            int s, e, rc, fl, keep, k, c2;
            byte c;
            s = sq_tok_start(st);
            e = st.sqllen;
            if (sq_vd_gon(762) == 1)
            {
                while (e > s)
                {
                    c = st.sql[e - 1];
                    if (c == (byte)32 | c == (byte)9 | c == (byte)10 | c == (byte)13 | c == (byte)59) { e--; } else { break; };
                };
            }
            else
            {
                // CREATE INDEX and CREATE VIEW keep a trailing comment in the stored text
                keep = 0;
                if (sq_vd_word(@st.sql[s], e - s, 0, "alter\0") >= 0) { keep = 1; };
                k = sq_vd_word(@st.sql[s], e - s, 0, "create\0");
                if (k >= 0)
                {
                    k = sq_vd_skip(@st.sql[s], e - s, k);
                    c2 = sq_vd_word(@st.sql[s], e - s, k, "temp\0");
                    if (c2 < 0) { c2 = sq_vd_word(@st.sql[s], e - s, k, "temporary\0"); };
                    if (c2 >= 0) { k = sq_vd_skip(@st.sql[s], e - s, c2); };
                    c2 = sq_vd_word(@st.sql[s], e - s, k, "unique\0");
                    if (c2 >= 0) { k = sq_vd_skip(@st.sql[s], e - s, c2); };
                    if (sq_vd_word(@st.sql[s], e - s, k, "index\0") >= 0 | sq_vd_word(@st.sql[s], e - s, k, "view\0") >= 0) { keep = 1; };
                };
                if (keep == 1)
                {
                    while (e > s)
                    {
                        c = st.sql[e - 1];
                        if (c == (byte)32 | c == (byte)9 | c == (byte)10 | c == (byte)13 | c == (byte)59) { e--; } else { break; };
                    };
                }
                else { e = sq_vd_endtrim(st.sql, s, e); };
            };
            if (sq_is_kw(st, "insert\0") | sq_is_kw(st, "replace\0")) { return sq_vd_insert(st, @st.sql[s], e - s, 0, pq); };
            if (sq_is_kw(st, "delete\0")) { return sq_vd_delete(st, @st.sql[s], e - s, 0, pq); };
            if (sq_is_kw(st, "update\0")) { return sq_vd_update(st, @st.sql[s], e - s, 0, pq); };
            if (sq_is_kw(st, "select\0") == false & sq_is_kw(st, "values\0") == false & sq_is_kw(st, "with\0") == false)
            {
                return sq_vd_misc(st, @st.sql[s], e - s, pq);
            };
            if (false)
            {
                sq_seterr(st, "EXPLAIN is not available for this statement\0");
                return 1;
            };
            g = sq_stmt_new();
            if ((u64)g == (u64)0) { sq_seterr(st, "out of memory\0"); return 1; };
            st.sql[e] = (byte)0;
            if (sq_prep_query(g, st.db, @st.sql[s]) != 0)
            {
                sq_seterr(st, g.err);
                sq_stmt_del(g);
                return 1;
            };
            fl = sq_vd_flatten(g);
            rc = sq_vd_select(st, g);
            sq_stmt_del(g);
            if (rc != 0) { return 1; };
            if (fl >= 1)
            {
                for (s = 0; s < VD_N; s++)
                {
                    e = sq_vd_ufield(s);
                    if (e < 0) { sq_seterr(st, @VD_TXT[VD_O[s]]); return 1; };
                    if ((e & 1) != 0) { VD_P1[s] = VD_P1[s] + fl; };
                    if ((e & 32) != 0) { VD_P3[s] = VD_P3[s] + fl; };
                };
            };
            sq_vd_query(pq);
            return 0;
        };

        // ---- ATTACH / DETACH ----
        // An attached database is a second open database held by the main one. A statement that writes "name." in front of
        // an identifier runs against that database as a whole (see sq_att_pick); one statement cannot mix two databases.

        def sq_att_msg(SQ_STMT* st, byte* pre, byte* nm, int nl, byte* post) -> void
        {
            byte[160] m;
            int i, n;
            n = 0;
            for (i = 0; pre[i] != (byte)0; i++) { m[n] = pre[i]; n++; };
            for (i = 0; i < nl; i++) { m[n] = nm[i]; n++; };
            for (i = 0; post[i] != (byte)0; i++) { m[n] = post[i]; n++; };
            m[n] = (byte)0;
            sq_seterr(st, @m[0]);
        };

        def sq_exec_attach(SQ_STMT* st) -> int
        {
            SQLITE_DB* db = st.db;
            SQLITE_DB* d2;
            byte[330] path;
            byte[40] nm;
            int i, nl, mem, k, ns;
            void* f;
            if (db.in_txn == 1) { sq_seterr(st, "cannot ATTACH database within transaction\0"); return 1; };
            if (sq_is_kw(st, "database\0")) { sq_next(st); };
            if (st.tk != 4 & st.tk != 1) { sq_seterr(st, "syntax error\0"); return 1; };
            if (st.tl > 320) { sq_seterr(st, "unable to open database\0"); return 1; };
            for (i = 0; i < st.tl; i++) { path[i] = st.sql[st.ts + i]; };
            path[st.tl] = (byte)0;
            sq_next(st);
            if (sq_is_kw(st, "as\0") == false) { sq_seterr(st, "syntax error\0"); return 1; };
            sq_next(st);
            if (st.tk != 1 & st.tk != 4) { sq_seterr(st, "syntax error\0"); return 1; };
            nl = st.tl;
            ns = st.ts;
            if (nl > 31 | nl == 0) { sq_seterr(st, "syntax error\0"); return 1; };
            for (i = 0; i < nl; i++)
            {
                nm[i] = st.sql[st.ts + i];
                if (nm[i] >= (byte)65 & nm[i] <= (byte)90) { nm[i] = nm[i] + (byte)32; };
            };
            nm[nl] = (byte)0;
            sq_next(st);
            if (sq_end_check(st) != 0) { return 1; };
            if (nl == 4 & nm[0] == (byte)109 & nm[1] == (byte)97 & nm[2] == (byte)105 & nm[3] == (byte)110)
            {
                sq_seterr(st, "database main is already in use\0"); return 1;
            };
            if (sq_att_find(db, @nm[0], nl) >= 0)
            {
                sq_att_msg(st, "database \0", @st.sql[ns], nl, " is already in use\0");
                return 1;
            };
            if (db.natt >= 10) { sq_seterr(st, "too many attached databases - max 10\0"); return 1; };
            mem = 0;
            if (path[0] == (byte)0 | (path[0] == (byte)58 & path[1] == (byte)109 & path[2] == (byte)101 & path[3] == (byte)109 & path[4] == (byte)111 & path[5] == (byte)114 & path[6] == (byte)121 & path[7] == (byte)58 & path[8] == (byte)0))
            {
                // an in-memory database lives in a private file next to the main one, removed when detached
                mem = 1;
                k = 0;
                while (db.path[k] != (byte)0 & k < 300) { path[k] = db.path[k]; k++; };
                path[k] = (byte)45; path[k + 1] = (byte)97; path[k + 2] = (byte)116; path[k + 3] = (byte)116;
                path[k + 4] = (byte)48 + (byte)db.natt;
                path[k + 5] = (byte)0;
                remove(@path[0]);
            };
            d2 = (SQLITE_DB*)fmalloc((u64)(sizeof(SQLITE_DB) / 8 + 4096));
            if ((u64)d2 == (u64)0) { sq_seterr(st, "out of memory\0"); return 1; };
            if (sq_open_rw(d2, @path[0], 1) != 0)
            {
                ffree((u64)d2);
                sq_seterr(st, "unable to open database\0");
                return 1;
            };
            if (sq_schema_load(d2) < 0)
            {
                sq_close(d2);
                ffree((u64)d2);
                if (mem == 1) { remove(@path[0]); };
                sq_seterr(st, "file is not a database\0");
                return 1;
            };
            k = db.natt;
            d2.home = (void*)db;
            db.att[k] = (void*)d2;
            db.attm[k] = mem;
            for (i = 0; i <= nl; i++) { db.attn[k * 32 + i] = nm[i]; };
            db.natt = k + 1;
            return 0;
        };

        def sq_exec_detach(SQ_STMT* st) -> int
        {
            SQLITE_DB* db = st.db;
            SQLITE_DB* d2;
            byte[40] nm;
            int i, nl, k, ns;
            if (sq_is_kw(st, "database\0")) { sq_next(st); };
            if (st.tk != 1) { sq_seterr(st, "syntax error\0"); return 1; };
            nl = st.tl;
            ns = st.ts;
            if (nl > 31 | nl == 0) { sq_seterr(st, "syntax error\0"); return 1; };
            for (i = 0; i < nl; i++)
            {
                nm[i] = st.sql[st.ts + i];
                if (nm[i] >= (byte)65 & nm[i] <= (byte)90) { nm[i] = nm[i] + (byte)32; };
            };
            nm[nl] = (byte)0;
            sq_next(st);
            if (sq_end_check(st) != 0) { return 1; };
            if (nl == 4 & nm[0] == (byte)109 & nm[1] == (byte)97 & nm[2] == (byte)105 & nm[3] == (byte)110)
            {
                sq_seterr(st, "cannot detach database main\0"); return 1;
            };
            k = sq_att_find(db, @nm[0], nl);
            if (k < 0) { sq_seterr_n(st, "no such database\0", ns, nl); return 1; };
            if (db.in_txn == 1) { sq_seterr(st, "cannot DETACH database within transaction\0"); return 1; };
            d2 = (SQLITE_DB*)db.att[k];
            if (d2.in_txn == 1) { sq_att_msg(st, "database \0", @st.sql[ns], nl, " is locked\0"); return 1; };
            sq_close(d2);
            if (db.attm[k] == 1) { remove(@d2.path[0]); };
            ffree((u64)d2);
            for (i = k; i < db.natt - 1; i++)
            {
                db.att[i] = db.att[i + 1];
                db.attm[i] = db.attm[i + 1];
                for (nl = 0; nl < 32; nl++) { db.attn[i * 32 + nl] = db.attn[(i + 1) * 32 + nl]; };
            };
            db.natt = db.natt - 1;
            db.att[db.natt] = (void*)0;
            return 0;
        };

    }; // sqlite
}; // standard

#endif; // IDEKA_STANDARD_SQLITE_WRITE
