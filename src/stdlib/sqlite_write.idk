        // IF NOT EXISTS / IF EXISTS handling: a statement that finds its object already in the wanted state does nothing
        def sq_vd_noop(SQ_STMT* st, int jm, byte** pq) -> int
        {
            int init;
            sq_vd_reset();
            init = sq_vd_op("Init\0", 0, 0, 0);
            if (jm == 1) { sq_vd_op("JournalMode\0", 0, 1, 0 - 1); };
            sq_vd_op("Halt\0", 0, 0, 0);
            VD_P2[init] = VD_N;
            sq_vd_trans(st.db, 0);
            sq_vd_op("Goto\0", 0, 1, 0);
            sq_vd_query(pq);
            return 0;
        };

        // reads an optional IF NOT EXISTS; returns the index after it, or -1 when it is malformed
        def sq_vd_ifne(byte* t, int n, int i, int* hasp) -> int
        {
            int k;
            hasp[0] = 0;
            k = sq_vd_word(t, n, i, "if\0");
            if (k < 0) { return i; };
            i = sq_vd_skip(t, n, k);
            k = sq_vd_word(t, n, i, "not\0");
            if (k < 0) { return 0 - 1; };
            i = sq_vd_skip(t, n, k);
            k = sq_vd_word(t, n, i, "exists\0");
            if (k < 0) { return 0 - 1; };
            hasp[0] = 1;
            return sq_vd_skip(t, n, k);
        };

        // 1 when a schema object of the kind (trigger or not) carries the name
        def sq_vd_have(SQ_STMT* st, byte* t, int ns, int nl, int istrig) -> int
        {
            int j;
            for (j = 0; j < st.db.nschema; j++)
            {
                if (sq_vd_nameeq(st.db.schema[j].name, t, ns, nl))
                {
                    if (istrig == 1 & st.db.schema[j].kind == 4) { return 1; };
                    if (istrig == 0 & st.db.schema[j].kind != 4) { return 1; };
                };
            };
            return 0;
        };

        // CREATE TABLE: sqlite_master row plus one row per automatic index
        def sq_vd_create_table(SQ_STMT* st, byte* t, int n, int i, byte** pq) -> int
        {
