            a = sq_vd_op("OpenRead\0", 0, 1, 0);
            sq_vd_p4i(a, (i64)3);
            a = sq_vd_op("Rewind\0", 0, 15, 0);
            a = sq_vd_op("Column\0", 0, 0, 8);
            a = sq_vd_op("Ne\0", 9, 9, 8);
            VD_P5[a] = 66;
            sq_vd_p4s(a, "BINARY-8\0", 8);
            a = sq_vd_op("Column\0", 0, 2, 8);
            a = sq_vd_op("Ne\0", 10, 14, 8);
            VD_P5[a] = 82;
            sq_vd_p4s(a, "NOCASE-8\0", 8);
            a = sq_vd_op("Column\0", 0, 1, 12);
            a = sq_vd_op("Function\0", 5, 11, 8);
            sq_vd_p4s(a, "like(3)\0", 7);
            a = sq_vd_op("If\0", 8, 14, 1);
            a = sq_vd_op("Rowid\0", 0, 2, 0);
            a = sq_vd_op("Insert\0", 1, 1, 2);
            a = sq_vd_op("Next\0", 0, 5, 0);
            VD_P5[a] = 1;
            a = sq_vd_op("OpenWrite\0", 0, 1, 0);
            sq_vd_p4i(a, (i64)5);
            a = sq_vd_op("Rewind\0", 1, 30, 0);
            a = sq_vd_op("Rowid\0", 1, 2, 0);
            a = sq_vd_op("NotExists\0", 0, 29, 2);
            a = sq_vd_op("Column\0", 0, 0, 3);
            a = sq_vd_op("Column\0", 0, 1, 4);
            a = sq_vd_op("Column\0", 0, 2, 5);
            a = sq_vd_op("Column\0", 0, 3, 6);
            a = sq_vd_op("Column\0", 0, 0, 16);
            a = sq_vd_op("Column\0", 0, 1, 17);
            a = sq_vd_op("Column\0", 0, 4, 18);
            a = sq_vd_op("Function\0", 113, 15, 7);
            sq_vd_p4s(a, "sqlite_rename_table(7)\0", 22);
            a = sq_vd_op("MakeRecord\0", 3, 5, 14);
            sq_vd_p4s(a, "BBBDB\0", 5);
            a = sq_vd_op("Insert\0", 0, 14, 2);
            a = sq_vd_op("Next\0", 1, 17, 0);
            a = sq_vd_op("Null\0", 0, 22, 23);
            a = sq_vd_op("OpenEphemeral\0", 3, 0, 22);
            a = sq_vd_op("OpenRead\0", 2, 1, 0);
            sq_vd_p4i(a, (i64)3);
            a = sq_vd_op("Rewind\0", 2, 45, 0);
            a = sq_vd_op("Column\0", 2, 2, 8);
            a = sq_vd_op("Ne\0", 10, 44, 8);
            VD_P5[a] = 82;
            sq_vd_p4s(a, "NOCASE-8\0", 8);
            a = sq_vd_op("Column\0", 2, 0, 8);
            a = sq_vd_op("Eq\0", 29, 42, 8);
            VD_P5[a] = 66;
            sq_vd_p4s(a, "BINARY-8\0", 8);
            a = sq_vd_op("Column\0", 2, 0, 8);
            a = sq_vd_op("Eq\0", 9, 42, 8);
            VD_P5[a] = 66;
            sq_vd_p4s(a, "BINARY-8\0", 8);
            a = sq_vd_op("Column\0", 2, 0, 8);
            a = sq_vd_op("Ne\0", 30, 44, 8);
            VD_P5[a] = 82;
            sq_vd_p4s(a, "BINARY-8\0", 8);
            a = sq_vd_op("Rowid\0", 2, 23, 0);
            a = sq_vd_op("Insert\0", 3, 22, 23);
            a = sq_vd_op("Next\0", 2, 34, 0);
            VD_P5[a] = 1;
            a = sq_vd_op("OpenWrite\0", 2, 1, 0);
            sq_vd_p4i(a, (i64)5);
            a = sq_vd_op("Rewind\0", 3, 70, 0);
            a = sq_vd_op("Rowid\0", 3, 23, 0);
            a = sq_vd_op("NotExists\0", 2, 69, 23);
            a = sq_vd_op("Column\0", 2, 0, 24);
            a = sq_vd_op("Column\0", 2, 0, 8);
            a = sq_vd_op("Ne\0", 29, 54, 8);
            VD_P5[a] = 82;
            sq_vd_p4s(a, "BINARY-8\0", 8);
            a = sq_vd_op("String8\0", 0, 25, 0);
            sq_vd_p4s(a, nn, nl2);
            a = sq_vd_op("Goto\0", 0, 64, 0);
            a = sq_vd_op("Column\0", 2, 1, 33);
            a = sq_vd_op("Function\0", 5, 32, 8);
            sq_vd_p4s(a, "like(3)\0", 7);
            a = sq_vd_op("IfNot\0", 8, 63, 1);
            a = sq_vd_op("Column\0", 2, 0, 8);
            a = sq_vd_op("Ne\0", 9, 63, 8);
            VD_P5[a] = 82;
            sq_vd_p4s(a, "BINARY-8\0", 8);
            a = sq_vd_op("Column\0", 2, 1, 36);
            a = sq_vd_op("Function\0", 2, 36, 8);
            sq_vd_p4s(a, "substr(2)\0", 9);
            a = sq_vd_op("Concat\0", 8, 35, 25);
