// Author: Karac V. Thweatt

// sqlite_write.idk - Write path for the SQLite engine: page allocation, table and index b-trees, constraint
// checking, CREATE / DROP / ALTER, INSERT / UPDATE / DELETE and transaction control.
//
//   sq_open_rw(SQLITE_DB*, byte* path, int create) -> int   0 on success, creates a new database file when create is 1
//   sq_exec(SQ_STMT*, SQLITE_DB*, byte* sql) -> int         0 on success, otherwise st.err holds the message
//                                                           st.changes = rows affected, st.last_rowid = last inserted rowid
//
// Files written here are ordinary SQLite 3 databases (rollback journal mode).

#ifndef IDEKA_STANDARD_SQLITE_CORE
#import <sqlite_core.idk>;
#endif;

#ifndef IDEKA_STANDARD_SQLITE_WRITE
#def IDEKA_STANDARD_SQLITE_WRITE 1;

namespace standard
{
    namespace sqlite
    {
        // A page in memory (SQLite's MemPage). img is the whole page image and the authority; the flat view (buf, off, len)
        // lists the logical cells in order, including up to four overflow cells that did not fit on the page. Cells
        // novf at logical index ov0 are the overflow cells; the other cells are those of the image.
        struct SQ_PM
        {
            int type, ncells, rightmost, used, hsz;
            byte* buf;
            int* off;
            int* len;
            SQLITE_DB* db;
            byte* img;
            byte* ovb;
            int pgno, hoff, nimg, nfree, novf, ov0;
            int[4] ovl;
        };

        struct SQ_PATH
        {
            int depth, rightmost;
            int[20] pg;
            int[20] ci;
        };

        // ---- byte helpers ----

        def sq_put_varint(byte* p, u64 v) -> int
        {
            byte[10] tmp;
            int n, i;
            if ((v >> 56) != (u64)0)
            {
                p[8] = (byte)(v `& (u64)255);
                v = v >> 8;
                for (i = 7; i >= 0; i--)
                {
                    p[i] = (byte)((v `& (u64)127) `| (u64)128);
                    v = v >> 7;
                };
                return 9;
            };
            tmp[0] = (byte)(v `& (u64)127);
            n = 1;
            v = v >> 7;
            while (v != (u64)0)
            {
                tmp[n] = (byte)((v `& (u64)127) `| (u64)128);
                n++;
                v = v >> 7;
            };
            for (i = 0; i < n; i++) { p[i] = tmp[n - 1 - i]; };
            return n;
        };

        def sq_varint_len(u64 v) -> int
        {
            int n;
            if ((v >> 56) != (u64)0) { return 9; };
            n = 1;
            v = v >> 7;
            while (v != (u64)0) { n++; v = v >> 7; };
            return n;
        };

        def sq_local_size(SQLITE_DB* db, int total) -> int
        {
            int U, X, M, K;
            U = db.usable;
            X = U - 35;
            if (total <= X) { return total; };
            M = ((U - 12) * 32 / 255) - 23;
            K = M + ((total - M) % (U - 4));
            if (K <= X) { return K; };
            return M;
        };

        // Size in bytes of the table b-tree cell starting at p.
        def sq_cell_size0(SQLITE_DB* db, int type, byte* p) -> int
        {
            u64 a, b;
            int n, m, total, lcl;
            if (type == 10 | type == 2)
            {
                m = 0;
                if (type == 2) { m = 4; };
                n = sq_varint(@p[m], @a);
                total = (int)a;
                lcl = sq_ilocal(db, total);
                if (lcl < total) { return m + n + lcl + 4; };
                return m + n + lcl;
            };
            if (type == 5)
            {
                n = sq_varint(@p[4], @a);
                return 4 + n;
            };
            n = sq_varint(p, @a);
            m = sq_varint(@p[n], @b);
            total = (int)a;
            lcl = sq_local_size(db, total);
            if (lcl < total) { return n + m + lcl + 4; };
            return n + m + lcl;
        };

        // cell sizes are never counted below 4 bytes on leaf pages
        def sq_cell_size(SQLITE_DB* db, int type, byte* p) -> int
        {
            int r;
            r = sq_cell_size0(db, type, p);
            if (r < 4 & (type == 13 | type == 10)) { return 4; };
            return r;
        };

        def sq_hoff(int pgno) -> int
        {
            if (pgno == 1) { return 100; };
            return 0;
        };

        // ---- MemPage: a port of the page editing code of SQLite's btree.c ----
        //
        // The image of a page is edited the way SQLite edits it (freeSpace, allocateSpace, defragmentPage, dropCell, insertCell,
        // zeroPage, editPage, copyNodeContent), so that the bytes written to the file, including free blocks and stale
        // bytes in unused space, are those SQLite writes.

        def sq_pm_init(SQLITE_DB* db, SQ_PM* pm) -> int
        {
            int cnt = db.page_size / 4 + 16;
            pm.db = db;
            pm.buf = (byte*)fmalloc((u64)(db.page_size * 6));
            pm.off = (int*)fmalloc((u64)(cnt * 4 + 64));
            pm.len = (int*)fmalloc((u64)(cnt * 4 + 64));
            pm.ncells = 0;
            pm.used = 0;
            pm.rightmost = 0;
            pm.type = 13;
            pm.hsz = 8;
            pm.img = (byte*)0;
            pm.ovb = (byte*)0;
            pm.pgno = 0;
            pm.hoff = 0;
            pm.nimg = 0;
            pm.nfree = 0;
            pm.novf = 0;
            pm.ov0 = 0;
            if ((u64)pm.buf == (u64)0 | (u64)pm.off == (u64)0 | (u64)pm.len == (u64)0) { return 1; };
            return 0;
        };

        def sq_pm_free(SQ_PM* pm) -> void
        {
            if ((u64)pm.buf != (u64)0) { ffree((u64)pm.buf); pm.buf = (byte*)0; };
            if ((u64)pm.off != (u64)0) { ffree((u64)pm.off); pm.off = (int*)0; };
            if ((u64)pm.len != (u64)0) { ffree((u64)pm.len); pm.len = (int*)0; };
            if ((u64)pm.img != (u64)0) { ffree((u64)pm.img); pm.img = (byte*)0; };
            if ((u64)pm.ovb != (u64)0) { ffree((u64)pm.ovb - (u64)8); pm.ovb = (byte*)0; };
        };

        // memmove
        def sq_mp_move(byte* d, byte* s, int n) -> void
        {
            int i;
            if ((u64)d < (u64)s)
            {
                for (i = 0; i < n; i++) { d[i] = s[i]; };
            }
            else
            {
                for (i = n - 1; i >= 0; i--) { d[i] = s[i]; };
            };
        };

        // get2byteNotZero
        def sq_mp_g2nz(byte* p) -> int
        {
            int v = sq_be16(p);
            if (v == 0) { return 65536; };
            return v;
        };

        // offset of the cell pointer array
        def sq_mp_cof(SQ_PM* pm) -> int
        {
            return pm.hoff + pm.hsz;
        };

        // offset in the image of the cell at image index i
        def sq_mp_cell(SQ_PM* pm, int i) -> int
        {
            return sq_be16(@pm.img[pm.hoff + pm.hsz + 2 * i]);
        };

        // btreeComputeFreeSpace
        def sq_mp_calc_free(SQ_PM* pm) -> int
        {
            byte* d = pm.img;
            int hdr, top, nfree, pc, next, size, cfirst, clast, U;
            U = pm.db.usable;
            hdr = pm.hoff;
            top = sq_mp_g2nz(@d[hdr + 5]);
            nfree = (int)d[hdr + 7] + top;
            pc = sq_be16(@d[hdr + 1]);
            cfirst = hdr + pm.hsz + 2 * pm.nimg;
            clast = U - 4;
            if (pc > 0)
            {
                next = 0;
                while (true)
                {
                    if (pc < cfirst | pc > clast) { return 0 - 1; };
                    next = sq_be16(@d[pc]);
                    size = sq_be16(@d[pc + 2]);
                    nfree = nfree + size;
                    if (next <= pc + size + 3) { break; };
                    pc = next;
                };
                if (next > 0) { return 0 - 1; };
            };
            if (nfree > U | nfree < cfirst) { return 0 - 1; };
            return nfree - cfirst;
        };

        // rebuilds the flat view of the cells from the image and the overflow cells
        def sq_mp_sync(SQ_PM* pm) -> int
        {
            SQLITE_DB* db = pm.db;
            int i, total, k, sz, cp, used, o;
            total = pm.nimg + pm.novf;
            used = 0;
            for (i = 0; i < total; i++)
            {
                if (pm.novf > 0 & i >= pm.ov0 & i < pm.ov0 + pm.novf)
                {
                    k = i - pm.ov0;
                    sz = pm.ovl[k];
                    sq_memcpy(@pm.buf[used], @pm.ovb[k * db.page_size], sz);
                }
                else
                {
                    o = i;
                    if (pm.novf > 0 & i >= pm.ov0 + pm.novf) { o = i - pm.novf; };
                    cp = sq_mp_cell(pm, o);
                    sz = sq_cell_size(db, pm.type, @pm.img[cp]);
                    if (cp + sz > db.page_size) { return 1; };
                    sq_memcpy(@pm.buf[used], @pm.img[cp], sz);
                };
                pm.off[i] = used;
                pm.len[i] = sz;
                used = used + sz;
            };
            pm.ncells = total;
            pm.used = used;
            return 0;
        };

        // re-derives the fields of pm from its image (after the image was replaced or rewritten wholesale)
        def sq_mp_reinit(SQ_PM* pm) -> int
        {
            int t, hdr;
            hdr = pm.hoff;
            t = (int)pm.img[hdr];
            pm.type = t;
            pm.hsz = 8;
            pm.rightmost = 0;
            if (t == 5 | t == 2) { pm.hsz = 12; pm.rightmost = sq_be32(@pm.img[hdr + 8]); };
            pm.nimg = sq_be16(@pm.img[hdr + 3]);
            pm.novf = 0;
            pm.nfree = sq_mp_calc_free(pm);
            if (pm.nfree < 0) { return 1; };
            return sq_mp_sync(pm);
        };

        def sq_pm_load(SQLITE_DB* db, int pgno, SQ_PM* pm) -> int
        {
            byte* page = sq_page(db, pgno);
            int ho, t;
            if ((u64)page == (u64)0) { return 1; };
            ho = sq_hoff(pgno);
            t = (int)page[ho];
            if (t != 13 & t != 5 & t != 10 & t != 2) { return 1; };
            if ((u64)pm.img == (u64)0)
            {
                pm.img = (byte*)fmalloc((u64)(db.page_size + 16));
                if ((u64)pm.img == (u64)0) { return 1; };
            };
            sq_memcpy(pm.img, page, db.page_size);
            pm.pgno = pgno;
            pm.hoff = ho;
            return sq_mp_reinit(pm);
        };

        // sets the right child pointer of an interior page
        def sq_pm_setright(SQ_PM* pm, int v) -> void
        {
            pm.rightmost = v;
            if ((u64)pm.img != (u64)0) { sq_put32(@pm.img[pm.hoff + 8], v); };
        };

        // sets the child pointer of the cell at logical index idx
        def sq_pm_setchild(SQ_PM* pm, int idx, int v) -> void
        {
            int o;
            sq_put32(@pm.buf[pm.off[idx]], v);
            if ((u64)pm.img != (u64)0)
            {
                o = idx;
                if (pm.novf > 0 & idx >= pm.ov0 + pm.novf) { o = idx - pm.novf; };
                if (pm.novf > 0 & idx >= pm.ov0 & idx < pm.ov0 + pm.novf)
                {
                    sq_put32(@pm.ovb[(idx - pm.ov0) * pm.db.page_size], v);
                }
                else { sq_put32(@pm.img[sq_mp_cell(pm, o)], v); };
            };
        };

        // freeSpace
        def sq_mp_freesp(SQ_PM* pm, int istart, int isize) -> int
        {
            byte* d = pm.img;
            int hdr, iptr, ifree, nfrag, iorig, iend, x, U, iptrend;
            U = pm.db.usable;
            hdr = pm.hoff;
            iptr = hdr + 1;
            nfrag = 0;
            iorig = isize;
            iend = istart + isize;
            if (d[iptr + 1] == (byte)0 & d[iptr] == (byte)0) { ifree = 0; }
            else
            {
                ifree = sq_be16(@d[iptr]);
                while (ifree > 0 & ifree < istart)
                {
                    if (ifree <= iptr + 4) { return 1; };
                    iptr = ifree;
                    ifree = sq_be16(@d[iptr]);
                };
                if (ifree > U - 4) { return 1; };
                if (ifree != 0 & iend + 3 >= ifree)
                {
                    nfrag = ifree - iend;
                    if (iend > ifree) { return 1; };
                    iend = ifree + sq_be16(@d[ifree + 2]);
                    if (iend > U) { return 1; };
                    isize = iend - istart;
                    ifree = sq_be16(@d[ifree]);
                };
                if (iptr > hdr + 1)
                {
                    iptrend = iptr + sq_be16(@d[iptr + 2]);
                    if (iptrend + 3 >= istart)
                    {
                        if (iptrend > istart) { return 1; };
                        nfrag = nfrag + (istart - iptrend);
                        isize = iend - iptr;
                        istart = iptr;
                    };
                };
                if (nfrag > (int)d[hdr + 7]) { return 1; };
                d[hdr + 7] = (byte)((int)d[hdr + 7] - nfrag);
            };
            x = sq_be16(@d[hdr + 5]);
            if (istart <= x)
            {
                if (istart < x) { return 1; };
                if (iptr != hdr + 1) { return 1; };
                sq_put16(@d[hdr + 1], ifree);
                sq_put16(@d[hdr + 5], iend);
            }
            else
            {
                sq_put16(@d[iptr], istart);
                sq_put16(@d[istart], ifree);
                sq_put16(@d[istart + 2], isize);
            };
            pm.nfree = pm.nfree + iorig;
            return 0;
        };

        // pageFindSlot: offset of a slot of nbyte bytes taken from the free block list, 0 when none, -1 corrupt
        def sq_mp_findslot(SQ_PM* pm, int nbyte) -> int
        {
            byte* d = pm.img;
            int hdr, iaddr, pc, x, maxpc, size;
            hdr = pm.hoff;
            iaddr = hdr + 1;
            pc = sq_be16(@d[iaddr]);
            maxpc = pm.db.usable - nbyte;
            while (pc <= maxpc)
            {
                size = sq_be16(@d[pc + 2]);
                x = size - nbyte;
                if (x >= 0)
                {
                    if (x < 4)
                    {
                        if ((int)d[hdr + 7] > 57) { return 0; };
                        d[iaddr] = d[pc];
                        d[iaddr + 1] = d[pc + 1];
                        d[hdr + 7] = (byte)((int)d[hdr + 7] + x);
                        return pc;
                    };
                    if (x + pc > maxpc) { return 0 - 1; };
                    sq_put16(@d[pc + 2], x);
                    return pc + x;
                };
                iaddr = pc;
                pc = sq_be16(@d[pc]);
                if (pc <= iaddr)
                {
                    if (pc != 0) { return 0 - 1; };
                    return 0;
                };
            };
            if (pc > maxpc + nbyte - 4) { return 0 - 1; };
            return 0;
        };

        // defragmentPage
        def sq_mp_defrag(SQ_PM* pm, int nmaxfrag) -> int
        {
            SQLITE_DB* db = pm.db;
            byte* d = pm.img;
            byte* tmp;
            byte* src;
            int hdr, cof, ncell, cfirst, U, ifree, ifree2, sz, sz2, top, cbrk, pc, i, clast, size, ap, usedtmp;
            hdr = pm.hoff;
            cof = hdr + pm.hsz;
            ncell = pm.nimg;
            cfirst = cof + 2 * ncell;
            U = db.usable;
            if ((int)d[hdr + 7] <= nmaxfrag)
            {
                ifree = sq_be16(@d[hdr + 1]);
                if (ifree > U - 4) { return 1; };
                if (ifree != 0)
                {
                    ifree2 = sq_be16(@d[ifree]);
                    if (ifree2 > U - 4) { return 1; };
                    if (ifree2 == 0 | (d[ifree2] == (byte)0 & d[ifree2 + 1] == (byte)0))
                    {
                        sz2 = 0;
                        sz = sq_be16(@d[ifree + 2]);
                        top = sq_be16(@d[hdr + 5]);
                        if (top >= ifree) { return 1; };
                        if (ifree2 != 0)
                        {
                            if (ifree + sz > ifree2) { return 1; };
                            sz2 = sq_be16(@d[ifree2 + 2]);
                            if (ifree2 + sz2 > U) { return 1; };
                            sq_mp_move(@d[ifree + sz + sz2], @d[ifree + sz], ifree2 - (ifree + sz));
                            sz = sz + sz2;
                        }
                        else
                        {
                            if (ifree + sz > U) { return 1; };
                        };
                        cbrk = top + sz;
                        sq_mp_move(@d[cbrk], @d[top], ifree - top);
                        for (i = 0; i < ncell; i++)
                        {
                            ap = cof + 2 * i;
                            pc = sq_be16(@d[ap]);
                            if (pc < ifree) { sq_put16(@d[ap], pc + sz); }
                            else
                            {
                                if (pc < ifree2) { sq_put16(@d[ap], pc + sz2); };
                            };
                        };
                        if ((int)d[hdr + 7] + cbrk - cfirst != pm.nfree) { return 1; };
                        sq_put16(@d[hdr + 5], cbrk);
                        d[hdr + 1] = (byte)0;
                        d[hdr + 2] = (byte)0;
                        for (i = cfirst; i < cbrk; i++) { d[i] = (byte)0; };
                        return 0;
                    };
                };
            };
            cbrk = U;
            clast = U - 4;
            tmp = (byte*)0;
            src = d;
            for (i = 0; i < ncell; i++)
            {
                ap = cof + 2 * i;
                pc = sq_be16(@d[ap]);
                if (pc < cfirst | pc > clast) { return 1; };
                size = sq_cell_size(db, pm.type, @src[pc]);
                cbrk = cbrk - size;
                if (cbrk < cfirst | pc + size > U) { return 1; };
                sq_put16(@d[ap], cbrk);
                if ((u64)tmp == (u64)0)
                {
                    if (cbrk == pc) { continue; };
                    tmp = (byte*)fmalloc((u64)(db.page_size + 16));
                    if ((u64)tmp == (u64)0) { return 1; };
                    sq_memcpy(@tmp[cfirst], @d[cfirst], U - cfirst);
                    src = tmp;
                };
                sq_memcpy(@d[cbrk], @src[pc], size);
            };
            if ((u64)tmp != (u64)0) { ffree((u64)tmp); };
            d[hdr + 7] = (byte)0;
            if ((int)d[hdr + 7] + cbrk - cfirst != pm.nfree) { return 1; };
            sq_put16(@d[hdr + 5], cbrk);
            d[hdr + 1] = (byte)0;
            d[hdr + 2] = (byte)0;
            for (i = cfirst; i < cbrk; i++) { d[i] = (byte)0; };
            return 0;
        };

        // allocateSpace: offset of nbyte bytes of room on the page, -1 on a corrupt page
        def sq_mp_alloc(SQ_PM* pm, int nbyte) -> int
        {
            byte* d = pm.img;
            int hdr, gap, top, sp, rc;
            hdr = pm.hoff;
            gap = pm.hoff + pm.hsz + 2 * pm.nimg;
            top = sq_mp_g2nz(@d[hdr + 5]);
            if (gap > top) { return 0 - 1; };
            if ((d[hdr + 1] != (byte)0 | d[hdr + 2] != (byte)0) & gap + 2 <= top)
            {
                sp = sq_mp_findslot(pm, nbyte);
                if (sp > 0) { return sp; };
                if (sp < 0) { return 0 - 1; };
            };
            if (gap + 2 + nbyte > top)
            {
                top = pm.nfree - (2 + nbyte);
                if (top > 4) { top = 4; };
                rc = sq_mp_defrag(pm, top);
                if (rc != 0) { return 0 - 1; };
                top = sq_mp_g2nz(@d[hdr + 5]);
                if (gap + 2 + nbyte > top) { return 0 - 1; };
            };
            top = top - nbyte;
            sq_put16(@d[hdr + 5], top);
            return top;
        };

        // dropCell: removes the cell at image index idx (size sz) from the page
        def sq_mp_dropcell(SQ_PM* pm, int idx, int sz) -> int
        {
            byte* d = pm.img;
            int hdr, pc, ptr, i;
            hdr = pm.hoff;
            ptr = pm.hoff + pm.hsz + 2 * idx;
            pc = sq_be16(@d[ptr]);
            if (pc + sz > pm.db.usable) { return 1; };
            if (sq_mp_freesp(pm, pc, sz) != 0) { return 1; };
            pm.nimg = pm.nimg - 1;
            if (pm.nimg == 0)
            {
                d[hdr + 1] = (byte)0; d[hdr + 2] = (byte)0; d[hdr + 3] = (byte)0; d[hdr + 4] = (byte)0;
                d[hdr + 7] = (byte)0;
                sq_put16(@d[hdr + 5], pm.db.usable);
                pm.nfree = pm.db.usable - pm.hoff - pm.hsz;
            }
            else
            {
                sq_mp_move(@d[ptr], @d[ptr + 2], 2 * (pm.nimg - idx));
                sq_put16(@d[hdr + 3], pm.nimg);
                pm.nfree = pm.nfree + 2;
            };
            return 0;
        };

        // insertCell: puts a cell of sz bytes at logical index idx; a cell that does not fit becomes an overflow cell.
        // With ichild != 0 the first four bytes of the cell are set to that child page number.
        def sq_mp_insertcell(SQ_PM* pm, int idx, byte* cell, int sz, int ichild) -> int
        {
            SQLITE_DB* db = pm.db;
            byte* d = pm.img;
            int hdr, at, j, ptr, n, ci;
            hdr = pm.hoff;
            if (pm.novf > 0 | sz + 2 > pm.nfree)
            {
                if ((u64)pm.ovb == (u64)0)
                {
                    pm.ovb = (byte*)fmalloc((u64)(db.page_size * 4 + 16));
                    if ((u64)pm.ovb == (u64)0) { return 1; };
                    // slack in front of the slots: the leaf-index divider code reads the 4 bytes before a cell
                    pm.ovb = (byte*)((u64)pm.ovb + (u64)8);
                };
                j = pm.novf;
                if (j >= 4) { return 1; };
                sq_memcpy(@pm.ovb[j * db.page_size], cell, sz);
                if (ichild != 0) { sq_put32(@pm.ovb[j * db.page_size], ichild); };
                pm.ovl[j] = sz;
                if (j == 0) { pm.ov0 = idx; };
                pm.novf = j + 1;
                return 0;
            };
            at = sq_mp_alloc(pm, sz);
            if (at < 0) { return 1; };
            pm.nfree = pm.nfree - (2 + sz);
            if (ichild != 0)
            {
                sq_memcpy(@d[at + 4], @cell[4], sz - 4);
                sq_put32(@d[at], ichild);
            }
            else { sq_memcpy(@d[at], cell, sz); };
            ptr = pm.hoff + pm.hsz + 2 * idx;
            sq_mp_move(@d[ptr + 2], @d[ptr], 2 * (pm.nimg - idx));
            sq_put16(@d[ptr], at);
            pm.nimg = pm.nimg + 1;
            n = sq_be16(@d[hdr + 3]) + 1;
            sq_put16(@d[hdr + 3], n);
            return 0;
        };

        // zeroPage: the page becomes empty with the given flags, bytes outside the header keep their old values
        def sq_mp_zero(SQ_PM* pm, int flags) -> void
        {
            byte* d = pm.img;
            int hdr;
            hdr = pm.hoff;
            d[hdr] = (byte)flags;
            d[hdr + 1] = (byte)0; d[hdr + 2] = (byte)0; d[hdr + 3] = (byte)0; d[hdr + 4] = (byte)0;
            d[hdr + 7] = (byte)0;
            sq_put16(@d[hdr + 5], pm.db.usable);
            pm.type = flags;
            pm.hsz = 8;
            if (flags == 5 | flags == 2) { pm.hsz = 12; };
            pm.nimg = 0;
            pm.novf = 0;
            pm.nfree = pm.db.usable - pm.hoff - pm.hsz;
            pm.rightmost = 0;
            if (pm.hsz == 12) { pm.rightmost = sq_be32(@d[hdr + 8]); };
            pm.ncells = 0;
            pm.used = 0;
        };

        def sq_pm_new(SQLITE_DB* db) -> SQ_PM*
        {
            SQ_PM* p = (SQ_PM*)fmalloc((u64)(sizeof(SQ_PM) / 8 + 64));
            if ((u64)p == (u64)0) { return (SQ_PM*)0; };
            if (sq_pm_init(db, p) != 0) { sq_pm_free(p); ffree((u64)p); return (SQ_PM*)0; };
            return p;
        };

        def sq_pm_del(SQ_PM* p) -> void
        {
            if ((u64)p == (u64)0) { return; };
            sq_pm_free(p);
            ffree((u64)p);
        };

        // a page of the file brought into memory as an empty page of the given type (zeroPage on the page just taken from
        // the free list or the end of the file); pm was made with sq_pm_new
        def sq_mp_newpage(SQLITE_DB* db, int pgno, int flags, SQ_PM* pm) -> int
        {
            byte* page;
            page = sq_page(db, pgno);
            if ((u64)page == (u64)0) { return 1; };
            pm.img = (byte*)fmalloc((u64)(db.page_size + 16));
            if ((u64)pm.img == (u64)0) { return 1; };
            sq_memcpy(pm.img, page, db.page_size);
            pm.pgno = pgno;
            pm.hoff = sq_hoff(pgno);
            sq_mp_zero(pm, flags);
            return 0;
        };

        // the page becomes an empty page of the given type, keeping its stale bytes (zeroPage), and is written
        def sq_pm_empty(SQLITE_DB* db, int pgno, int flags) -> int
        {
            SQ_PM* p;
            int rc;
            p = sq_pm_new(db);
            if ((u64)p == (u64)0) { return 1; };
            if (sq_mp_newpage(db, pgno, flags, p) != 0) { sq_pm_del(p); return 1; };
            rc = sq_page_write(db, pgno, p.img);
            sq_pm_del(p);
            return rc;
        };

        // ---- the flat interface used by the insert and delete code ----

        def sq_pm_insert(SQ_PM* pm, int idx, byte* cell, int clen) -> void
        {
            int j, k;
            if ((u64)pm.img != (u64)0)
            {
                if (sq_mp_insertcell(pm, idx, cell, clen, 0) != 0) { return; };
                sq_mp_sync(pm);
                return;
            };
            for (j = pm.ncells; j > idx; j--)
            {
                pm.off[j] = pm.off[j - 1];
                pm.len[j] = pm.len[j - 1];
            };
            for (k = 0; k < clen; k++) { pm.buf[pm.used + k] = cell[k]; };
            pm.off[idx] = pm.used;
            pm.len[idx] = clen;
            pm.used = pm.used + clen;
            pm.ncells = pm.ncells + 1;
        };

        def sq_pm_remove(SQ_PM* pm, int idx) -> void
        {
            int j;
            if ((u64)pm.img != (u64)0)
            {
                if (pm.novf > 0) { return; };
                if (sq_mp_dropcell(pm, idx, pm.len[idx]) != 0) { return; };
                sq_mp_sync(pm);
                return;
            };
            for (j = idx; j < pm.ncells - 1; j++)
            {
                pm.off[j] = pm.off[j + 1];
                pm.len[j] = pm.len[j + 1];
            };
            pm.ncells = pm.ncells - 1;
        };

        // inserts a cell; leaf cells are counted as at least 4 bytes (fillInCell pads them with zeros)
        def sq_pm_ins(SQ_PM* pm, int idx, byte* cell, int clen) -> void
        {
            byte[8] pad;
            int i;
            if (clen < 4 & (pm.type == 13 | pm.type == 10))
            {
                for (i = 0; i < 4; i++) { pad[i] = (byte)0; };
                for (i = 0; i < clen; i++) { pad[i] = cell[i]; };
                sq_pm_insert(pm, idx, @pad[0], 4);
                return;
            };
            sq_pm_insert(pm, idx, cell, clen);
        };

        // writes bytes into the cell at logical index idx (same size), in the image and in the flat view
        def sq_pm_poke(SQ_PM* pm, int idx, int at, byte* src, int n) -> void
        {
            int i, o;
            for (i = 0; i < n; i++) { pm.buf[pm.off[idx] + at + i] = src[i]; };
            if ((u64)pm.img != (u64)0)
            {
                o = sq_mp_cell(pm, idx);
                for (i = 0; i < n; i++) { pm.img[o + at + i] = src[i]; };
            };
        };

        // free bytes of the page when it holds the cells of pm (negative when they do not fit)
        def sq_pm_nfree(SQLITE_DB* db, int pgno, SQ_PM* pm) -> int
        {
            int i, sum;
            sum = 0;
            for (i = 0; i < pm.ncells; i++) { sum = sum + pm.len[i]; };
            return db.usable - sq_hoff(pgno) - pm.hsz - 2 * pm.ncells - sum;
        };

        // Writes the page. A page held with its image is written as it is; a page without an image is built on the old
        // bytes of the page (zeroPage followed by assemblePage).
        def sq_pm_write(SQLITE_DB* db, int pgno, SQ_PM* pm, int a, int b, int type, int rightmost) -> int
        {
            byte* page;
            byte* w = db.wbuf;
            int ho, hsz, i, k, content, n;
            if ((u64)pm.img != (u64)0 & a == 0 & b == pm.ncells & pm.novf == 0)
            {
                return sq_page_write(db, pgno, pm.img);
            };
            ho = sq_hoff(pgno);
            hsz = 8;
            if (type == 5 | type == 2) { hsz = 12; };
            page = sq_page(db, pgno);
            if ((u64)page == (u64)0) { return 1; };
            for (i = 0; i < db.page_size; i++) { w[i] = page[i]; };
            n = b - a;
            w[ho] = (byte)type;
            w[ho + 1] = (byte)0; w[ho + 2] = (byte)0;
            sq_put16(@w[ho + 3], n);
            w[ho + 7] = (byte)0;
            if (type == 5 | type == 2) { sq_put32(@w[ho + 8], rightmost); };
            content = db.usable;
            for (i = a; i < b; i++)
            {
                content = content - pm.len[i];
                for (k = 0; k < pm.len[i]; k++) { w[content + k] = pm.buf[pm.off[i] + k]; };
                sq_put16(@w[ho + hsz + 2 * (i - a)], content);
            };
            if (content >= 65536) { sq_put16(@w[ho + 5], 0); } else { sq_put16(@w[ho + 5], content); };
            return sq_page_write(db, pgno, w);
        };

        // Do cells a..b-1 of pm fit on a page whose header starts at offset ho?
        def sq_range_fits(SQLITE_DB* db, int ho, SQ_PM* pm, int a, int b) -> bool
        {
            int i, sum;
            sum = 0;
            for (i = a; i < b; i++) { sum = sum + pm.len[i]; };
            return ho + pm.hsz + 2 * (b - a) + sum <= db.usable;
        };
        // ---- table b-tree: seek ----

        // 1 found, 0 absent (path leaf index is the insert position), -1 error
        def sq_seek(SQLITE_DB* db, int root, i64 rowid, SQ_PATH* pa) -> int
        {
            byte* page;
            int pgno, d, ho, t, nc, lo, hi, mid, cp, n, child;
            u64 a, b;
            i64 k;
            pgno = root;
            d = 0;
            pa.rightmost = 1;
            while (true)
            {
                if (d >= 20) { return 0 - 1; };
                page = sq_page(db, pgno);
                if ((u64)page == (u64)0) { return 0 - 1; };
                ho = sq_hoff(pgno);
                t = (int)page[ho];
                nc = sq_be16(@page[ho + 3]);
                pa.pg[d] = pgno;
                if (t == 13)
                {
                    lo = 0;
                    hi = nc;
                    while (lo < hi)
                    {
                        mid = (lo + hi) / 2;
                        cp = sq_be16(@page[ho + 8 + 2 * mid]);
                        n = sq_varint(@page[cp], @a);
                        sq_varint(@page[cp + n], @b);
                        k = (i64)b;
                        if (k < rowid) { lo = mid + 1; } else { hi = mid; };
                    };
                    pa.ci[d] = lo;
                    pa.depth = d + 1;
                    if (lo < nc)
                    {
                        cp = sq_be16(@page[ho + 8 + 2 * lo]);
                        n = sq_varint(@page[cp], @a);
                        sq_varint(@page[cp + n], @b);
                        if ((i64)b == rowid) { return 1; };
                    };
                    return 0;
                };
                if (t != 5) { return 0 - 1; };
                lo = 0;
                hi = nc;
                while (lo < hi)
                {
                    mid = (lo + hi) / 2;
                    cp = sq_be16(@page[ho + 12 + 2 * mid]);
                    sq_varint(@page[cp + 4], @b);
                    k = (i64)b;
                    if (k < rowid) { lo = mid + 1; } else { hi = mid; };
                };
                pa.ci[d] = lo;
                if (lo < nc)
                {
                    cp = sq_be16(@page[ho + 12 + 2 * lo]);
                    child = sq_be32(@page[cp]);
                    pa.rightmost = 0;
                }
                else { child = sq_be32(@page[ho + 8]); };
                d++;
                pgno = child;
            };
            return 0 - 1;
        };

        // Largest rowid in the table (0 when empty), -1 on error.
        def sq_max_rowid(SQLITE_DB* db, int root, i64* out) -> int
        {
            byte* page;
            int pgno, ho, t, nc, cp, n, depth;
            u64 a, b;
            pgno = root;
            depth = 0;
            while (depth < 20)
            {
                page = sq_page(db, pgno);
                if ((u64)page == (u64)0) { return 1; };
                ho = sq_hoff(pgno);
                t = (int)page[ho];
                nc = sq_be16(@page[ho + 3]);
                if (t == 13)
                {
                    if (nc == 0) { *out = (i64)0; return 0; };
                    cp = sq_be16(@page[ho + 8 + 2 * (nc - 1)]);
                    n = sq_varint(@page[cp], @a);
                    sq_varint(@page[cp + n], @b);
                    *out = (i64)b;
                    return 0;
                };
                if (t != 5) { return 1; };
                pgno = sq_be32(@page[ho + 8]);
                depth++;
            };
            return 1;
        };

        // ---- table b-tree: insert ----

        // Builds a leaf cell for (rowid, payload) into out. Overflow pages are allocated as needed.
        def sq_build_cell(SQLITE_DB* db, i64 rowid, byte* payload, int plen, byte* out) -> int
        {
            byte* oldpg;
            int n, lcl, i, pos, chunk, cur, nxt, U;
            n = sq_put_varint(out, (u64)plen);
            n = n + sq_put_varint(@out[n], (u64)rowid);
            lcl = sq_local_size(db, plen);
            for (i = 0; i < lcl; i++) { out[n + i] = payload[i]; };
            if (lcl == plen) { return n + lcl; };
            U = db.usable;
            pos = lcl;
            cur = sq_alloc_page(db);
            if (cur == 0) { return 0 - 1; };
            sq_put32(@out[n + lcl], cur);
            while (pos < plen)
            {
                chunk = plen - pos;
                if (chunk > U - 4) { chunk = U - 4; };
                nxt = 0;
                if (pos + chunk < plen)
                {
                    nxt = sq_alloc_page_near(db, cur);
                    if (nxt == 0) { return 0 - 1; };
                };
                oldpg = sq_page(db, cur);
                if ((u64)oldpg == (u64)0) { return 0 - 1; };
                for (i = 0; i < db.page_size; i++) { db.wbuf[i] = oldpg[i]; };
                sq_put32(@db.wbuf[0], nxt);
                for (i = 0; i < chunk; i++) { db.wbuf[4 + i] = payload[pos + i]; };
                if (sq_page_write(db, cur, db.wbuf) != 0) { return 0 - 1; };
                pos = pos + chunk;
                cur = nxt;
            };
            return n + lcl + 4;
        };

        def sq_abs(int x) -> int
        {
            if (x < 0) { return 0 - x; };
            return x;
        };

        // ---- records ----

        def sq_int_serial(i64 v, int* blen) -> int
        {
            if (v == (i64)0) { *blen = 0; return 8; };
            if (v == (i64)1) { *blen = 0; return 9; };
            if (v >= (i64)0 - (i64)128 & v <= (i64)127) { *blen = 1; return 1; };
            if (v >= (i64)0 - (i64)32768 & v <= (i64)32767) { *blen = 2; return 2; };
            if (v >= (i64)0 - (i64)8388608 & v <= (i64)8388607) { *blen = 3; return 3; };
            if (v >= (i64)0 - (i64)2147483648 & v <= (i64)2147483647) { *blen = 4; return 4; };
            if (v >= (i64)0 - (i64)140737488355328 & v <= (i64)140737488355327) { *blen = 6; return 5; };
            *blen = 8;
            return 6;
        };

        def sq_val_serial(SQ_VAL* v, int* blen) -> int
        {
            if (v.t == SQ_NULL) { *blen = 0; return 0; };
            if (v.t == SQ_INTEGER) { return sq_int_serial(v.i, blen); };
            if (v.t == SQ_REAL) { *blen = 8; return 7; };
            if (v.t == SQ_TEXT)
            {
                if (SQ_ENC != 1) { *blen = sq_u8_to_u16(v.p, v.n, (byte*)0); return 13 + 2 * (*blen); };
                *blen = v.n;
                return 13 + 2 * v.n;
            };
            *blen = v.n;
            return 12 + 2 * v.n;
        };

        def sq_rec_size(SQ_VAL* vals, int n) -> int
        {
            int i, st, bl, hs, body, hsz;
            hs = 0;
            body = 0;
            for (i = 0; i < n; i++)
            {
                st = sq_val_serial(@vals[i], @bl);
                hs = hs + sq_varint_len((u64)st);
                body = body + bl;
            };
            hsz = hs + 1;
            if (hsz > 127) { hsz = hs + 2; };
            return hsz + body;
        };

        def sq_rec_write(SQ_VAL* vals, int n, byte* out) -> int
        {
            int i, k, st, bl, hs, hsz, hp, bp;
            u64 u;
            double dv;
            u64* bits;
            hs = 0;
            for (i = 0; i < n; i++)
            {
                st = sq_val_serial(@vals[i], @bl);
                hs = hs + sq_varint_len((u64)st);
            };
            hsz = hs + 1;
            if (hsz > 127) { hsz = hs + 2; };
            hp = sq_put_varint(out, (u64)hsz);
            bp = hsz;
            for (i = 0; i < n; i++)
            {
                st = sq_val_serial(@vals[i], @bl);
                hp = hp + sq_put_varint(@out[hp], (u64)st);
                if (vals[i].t == SQ_INTEGER)
                {
                    u = (u64)vals[i].i;
                    for (k = 0; k < bl; k++) { out[bp + k] = (byte)((u >> (8 * (bl - 1 - k))) `& (u64)255); };
                };
                if (vals[i].t == SQ_REAL)
                {
                    dv = vals[i].r;
                    bits = (u64*)@dv;
                    u = *bits;
                    for (k = 0; k < 8; k++) { out[bp + k] = (byte)((u >> (8 * (7 - k))) `& (u64)255); };
                };
                if (vals[i].t == SQ_TEXT & SQ_ENC != 1) { sq_u8_to_u16(vals[i].p, vals[i].n, @out[bp]); };
                if (vals[i].t == SQ_BLOB | (vals[i].t == SQ_TEXT & SQ_ENC == 1))
                {
                    for (k = 0; k < bl; k++) { out[bp + k] = vals[i].p[k]; };
                };
                bp = bp + bl;
            };
            return bp;
        };

        // ---- b-tree balancing: a literal port of SQLite's balance(), balance_quick(), balance_deeper() and balance_nonroot() ----
        //
        // Pages are SQ_PM objects holding the page image. Cell arrays hold the addresses of cells (in page images, in the
        // overflow buffers of a page and in a scratch area for the dividers), exactly like SQLite's CellArray.


        // copyNodeContent: the content of page f goes to page t (t keeps its other bytes)
        def sq_bl_copynode(SQ_PM* f, SQ_PM* t) -> int
        {
            SQLITE_DB* db = f.db;
            int iFromHdr, iToHdr, iData, n;
            iFromHdr = f.hoff;
            iToHdr = 0;
            if (t.pgno == 1) { iToHdr = 100; };
            iData = sq_be16(@f.img[iFromHdr + 5]);
            sq_memcpy(@t.img[iData], @f.img[iData], db.usable - iData);
            n = f.hoff + f.hsz + 2 * f.nimg;
            sq_memcpy(@t.img[iToHdr], @f.img[iFromHdr], n);
            t.hoff = iToHdr;
            return sq_mp_reinit(t);
        };

        // pageFreeArray: frees the cells iFirst..iFirst+nCell-1 of the array that lie on page p, returns how many
        def sq_bl_freearr(SQ_PM* p, u64* ap, int* szc, int iFirst, int nCell) -> int
        {
            u64 base, pStart, pEnd, pc;
            int[10] aOfst;
            int[10] aAfter;
            int nFree, nRet, i, j, iEnd, iOfst, iAfter;
            base = (u64)p.img;
            pStart = base + (u64)(p.hoff + p.hsz);
            pEnd = base + (u64)p.db.usable;
            nFree = 0;
            nRet = 0;
            iEnd = iFirst + nCell;
            for (i = iFirst; i < iEnd; i++)
            {
                pc = ap[i];
                if (pc >= pStart & pc < pEnd)
                {
                    iOfst = (int)(pc - base);
                    iAfter = iOfst + szc[i];
                    for (j = 0; j < nFree; j++)
                    {
                        if (aOfst[j] == iAfter) { aOfst[j] = iOfst; break; };
                        if (aAfter[j] == iOfst) { aAfter[j] = iAfter; break; };
                    };
                    if (j >= nFree)
                    {
                        if (nFree >= 10)
                        {
                            for (j = 0; j < nFree; j++) { sq_mp_freesp(p, aOfst[j], aAfter[j] - aOfst[j]); };
                            nFree = 0;
                        };
                        aOfst[nFree] = iOfst;
                        aAfter[nFree] = iAfter;
                        if (iAfter > p.db.usable) { return 0; };
                        nFree++;
                    };
                    nRet++;
                };
            };
            for (j = 0; j < nFree; j++) { sq_mp_freesp(p, aOfst[j], aAfter[j] - aOfst[j]); };
            return nRet;
        };

        // pageInsertArray: puts cells iFirst..iFirst+nCell-1 on page p; returns the new content offset or -1
        def sq_bl_insarr(SQ_PM* p, u64* ap, int* szc, int pBegin, int pData, int pCellptr, int iFirst, int nCell) -> int
        {
            byte* d = p.img;
            int i, iEnd, sz, slot;
            i = iFirst;
            iEnd = iFirst + nCell;
            if (iEnd <= iFirst) { return pData; };
            while (true)
            {
                sz = szc[i];
                slot = 0;
                if (d[p.hoff + 1] != (byte)0 | d[p.hoff + 2] != (byte)0)
                {
                    slot = sq_mp_findslot(p, sz);
                    if (slot < 0) { return 0 - 1; };
                };
                if (slot == 0)
                {
                    if (pData - pBegin < sz) { return 0 - 1; };
                    pData = pData - sz;
                    slot = pData;
                };
                sq_mp_move(@d[slot], (byte*)ap[i], sz);
                sq_put16(@d[pCellptr], slot);
                pCellptr = pCellptr + 2;
                i++;
                if (i >= iEnd) { break; };
            };
            return pData;
        };

        // rebuildPage: page p is rebuilt from scratch to hold cells iFirst..iFirst+nCell-1
        def sq_bl_rebuild(SQ_PM* p, u64* ap, int* szc, int iFirst, int nCell) -> int
        {
            SQLITE_DB* db = p.db;
            byte* d = p.img;
            byte* tmp;
            byte* src;
            u64 pc, base, lo;
            int hdr, U, i, j, iEnd, pData, pCellptr, sz;
            hdr = p.hoff;
            U = db.usable;
            tmp = (byte*)fmalloc((u64)(db.page_size + 16));
            if ((u64)tmp == (u64)0) { return 1; };
            j = sq_be16(@d[hdr + 5]);
            if (j > U) { j = 0; };
            sq_memcpy(@tmp[j], @d[j], U - j);
            base = (u64)d;
            lo = base + (u64)j;
            i = iFirst;
            iEnd = i + nCell;
            pData = U;
            pCellptr = hdr + p.hsz;
            while (true)
            {
                pc = ap[i];
                sz = szc[i];
                if (pc >= lo & pc < base + (u64)U)
                {
                    src = (byte*)((u64)tmp + (pc - base));
                }
                else { src = (byte*)pc; };
                pData = pData - sz;
                sq_put16(@d[pCellptr], pData);
                pCellptr = pCellptr + 2;
                if (pData < pCellptr) { ffree((u64)tmp); return 1; };
                sq_memcpy(@d[pData], src, sz);
                i++;
                if (i >= iEnd) { break; };
            };
            ffree((u64)tmp);
            p.nimg = nCell;
            p.novf = 0;
            d[hdr + 1] = (byte)0;
            d[hdr + 2] = (byte)0;
            sq_put16(@d[hdr + 3], nCell);
            sq_put16(@d[hdr + 5], pData);
            d[hdr + 7] = (byte)0;
            return 0;
        };

        // editPage
        def sq_bl_edit(SQ_PM* p, int iOld, int iNew, int nNew, u64* ap, int* szc) -> int
        {
            byte* d = p.img;
            int hdr, co, pBegin, nCell, iOldEnd, iNewEnd, nShift, nTail, pData, nAdd, i, iCell, pCellptr, fail, U, r;
            hdr = p.hoff;
            co = p.hoff + p.hsz;
            U = p.db.usable;
            pBegin = co + nNew * 2;
            nCell = p.nimg;
            iOldEnd = iOld + p.nimg + p.novf;
            iNewEnd = iNew + nNew;
            fail = 0;
            if (iOld < iNew)
            {
                nShift = sq_bl_freearr(p, ap, szc, iOld, iNew - iOld);
                if (nShift > nCell) { return 1; };
                sq_mp_move(@d[co], @d[co + nShift * 2], nCell * 2);
                nCell = nCell - nShift;
            };
            if (iNewEnd < iOldEnd)
            {
                nTail = sq_bl_freearr(p, ap, szc, iNewEnd, iOldEnd - iNewEnd);
                nCell = nCell - nTail;
            };
            pData = sq_mp_g2nz(@d[hdr + 5]);
            if (pData < pBegin) { fail = 1; };
            if (pData > U) { fail = 1; };
            if (fail == 0 & iNew < iOld)
            {
                nAdd = iOld - iNew;
                if (nNew < nAdd) { nAdd = nNew; };
                pCellptr = co;
                sq_mp_move(@d[pCellptr + nAdd * 2], @d[pCellptr], nCell * 2);
                r = sq_bl_insarr(p, ap, szc, pBegin, pData, pCellptr, iNew, nAdd);
                if (r < 0) { fail = 1; } else { pData = r; };
                nCell = nCell + nAdd;
            };
            if (fail == 0)
            {
                for (i = 0; i < p.novf; i++)
                {
                    iCell = (iOld + p.ov0 + i) - iNew;
                    if (iCell >= 0 & iCell < nNew)
                    {
                        pCellptr = co + iCell * 2;
                        if (nCell > iCell) { sq_mp_move(@d[pCellptr + 2], @d[pCellptr], (nCell - iCell) * 2); };
                        nCell++;
                        r = sq_bl_insarr(p, ap, szc, pBegin, pData, pCellptr, iCell + iNew, 1);
                        if (r < 0) { fail = 1; break; };
                        pData = r;
                    };
                };
            };
            if (fail == 0)
            {
                pCellptr = co + nCell * 2;
                r = sq_bl_insarr(p, ap, szc, pBegin, pData, pCellptr, iNew + nCell, nNew - nCell);
                if (r < 0) { fail = 1; } else { pData = r; };
            };
            if (fail == 0)
            {
                p.nimg = nNew;
                p.novf = 0;
                sq_put16(@d[hdr + 3], nNew);
                sq_put16(@d[hdr + 5], pData);
                return 0;
            };
            if (nNew < 1) { return 1; };
            return sq_bl_rebuild(p, ap, szc, iNew, nNew);
        };

        // balance_deeper: the cells of the root move to a new child; *pchild receives it
        def sq_bl_deeper(SQLITE_DB* db, SQ_PM* root, SQ_PM** pchild) -> int
        {
            SQ_PM* ch;
            int pg, i, ps;
            ps = db.page_size;
            pg = sq_alloc_page_near(db, root.pgno);
            if (pg == 0) { return 1; };
            ch = sq_pm_new(db);
            if ((u64)ch == (u64)0) { return 1; };
            ch.img = (byte*)fmalloc((u64)(ps + 16));
            if ((u64)ch.img == (u64)0) { return 1; };
            sq_memcpy(ch.img, sq_page(db, pg), ps);
            ch.pgno = pg;
            ch.hoff = 0;
            if (sq_bl_copynode(root, ch) != 0) { return 1; };
            if (root.novf > 0)
            {
                if ((u64)ch.ovb == (u64)0) { ch.ovb = (byte*)((u64)fmalloc((u64)(ps * 4 + 16)) + (u64)8); };
                for (i = 0; i < root.novf; i++)
                {
                    sq_memcpy(@ch.ovb[i * ps], @root.ovb[i * ps], root.ovl[i]);
                    ch.ovl[i] = root.ovl[i];
                };
                ch.novf = root.novf;
                ch.ov0 = root.ov0;
                sq_mp_sync(ch);
            };
            sq_mp_zero(root, (int)root.img[root.hoff] `& 247);
            sq_put32(@root.img[root.hoff + 8], pg);
            root.rightmost = pg;
            *pchild = ch;
            return 0;
        };

        // balance_quick: cur is a full table leaf at the right edge that took one more cell at its end
        def sq_bl_quick(SQLITE_DB* db, SQ_PM* par, SQ_PM* cur) -> int
        {
            SQ_PM* np;
            u64[1] apc;
            int[1] szc;
            byte[16] dv;
            byte* cell;
            int pg, last, cp, n, m;
            pg = sq_alloc_page(db);
            if (pg == 0) { return 1; };
            np = sq_pm_new(db);
            if ((u64)np == (u64)0) { return 1; };
            if (sq_mp_newpage(db, pg, 13, np) != 0) { return 1; };
            cell = @cur.ovb[0];
            apc[0] = (u64)cell;
            szc[0] = sq_cell_size(db, 13, cell);
            if (sq_bl_rebuild(np, @apc[0], @szc[0], 0, 1) != 0) { return 1; };
            np.nfree = db.usable - (np.hoff + np.hsz) - 2 - szc[0];
            // the key of the divider is the largest key on the old page
            last = cur.nimg - 1;
            cp = sq_mp_cell(cur, last);
            n = 0;
            while (((int)cur.img[cp + n] `& 128) != 0 & n < 8) { n++; };
            n++;
            m = 0;
            while (true)
            {
                dv[4 + m] = cur.img[cp + n + m];
                if (((int)cur.img[cp + n + m] `& 128) == 0 | m >= 8) { break; };
                m++;
            };
            m++;
            if (sq_mp_insertcell(par, par.nimg, @dv[0], 4 + m, cur.pgno) != 0) { return 1; };
            sq_put32(@par.img[par.hoff + 8], pg);
            par.rightmost = pg;
            if (sq_page_write(db, pg, np.img) != 0) { return 1; };
            sq_pm_del(np);
            return 0;
        };

        // balance_nonroot. par is the parent page (in memory, possibly with an overflow cell), iParentIdx the index of the
        // child being balanced in it, cur that child (in memory, maybe with overflow cells).
        def sq_bal_nonroot(SQLITE_DB* db, SQ_PM* par, int iParentIdx, int isRoot, int bBulk, SQ_PM* cur) -> int
        {
            u64[6] pmo;
            u64[8] pmn;
            u64[4] apDiv;
            int[8] cntOld;
            int[8] cntNew;
            int[8] szNew;
            int[8] abDone;
            int[8] ownN;
            int[8] ownO;
            u64* ap;
            int* szc;
            byte* aS1;
            byte[32] dv;
            byte* pd;
            byte* pTemp;
            SQ_PM* po;
            SQ_PM* pn;
            SQ_PM* pq;
            u64 pRightA, pCell, va, vb;
            int nOld, nNew, nxDiv, i, j, k, t, nc, pnov, pgno, lastpg, leaf, leafData, leafCorr, usableSpace, U, ps, sz, iSpace1;
            int limit, cpc, pageFlags, iPg, iOld, iNew, nNewCell, szRight, szLeft, r, d, szR, szD, cap, ho, cof, lim, np, ic, n1, n2, dl;
            ho = par.hoff;
            pd = par.img;
            ps = db.page_size;
            U = db.usable;
            cap = 4 * (ps / 4 + 16);
            ap = (u64*)fmalloc((u64)cap * (u64)8);
            szc = (int*)fmalloc((u64)cap * (u64)4);
            aS1 = (byte*)fmalloc((u64)(ps + 64));
            if ((u64)ap == (u64)0 | (u64)szc == (u64)0 | (u64)aS1 == (u64)0) { return 1; };
            for (i = 0; i < 8; i++) { pmn[i] = (u64)0; abDone[i] = 0; ownN[i] = 0; ownO[i] = 0; };
            for (i = 0; i < 6; i++) { pmo[i] = (u64)0; };
            i = par.novf + par.nimg;
            nxDiv = 0;
            if (i >= 2)
            {
                if (iParentIdx == 0) { nxDiv = 0; }
                else
                {
                    if (iParentIdx == i) { nxDiv = i - 2 + bBulk; } else { nxDiv = iParentIdx - 1; };
                };
                i = 2 - bBulk;
            };
            nOld = i + 1;
            pnov = par.novf;
            t = i + nxDiv - pnov;
            if (t == par.nimg) { pRightA = (u64)@pd[ho + 8]; } else { pRightA = (u64)@pd[sq_mp_cell(par, t)]; };
            pgno = sq_be32((byte*)pRightA);
            // load the siblings from the right to the left, dropping the dividers from the parent
            while (true)
            {
                if (pgno == cur.pgno) { po = cur; }
                else
                {
                    po = sq_pm_new(db);
                    if ((u64)po == (u64)0) { return 1; };
                    if (sq_pm_load(db, pgno, po) != 0) { return 1; };
                    ownO[i] = 1;
                };
                pmo[i] = (u64)po;
                if (i == 0) { break; };
                i--;
                if (pnov > 0 & i + nxDiv == par.ov0)
                {
                    apDiv[i] = (u64)@par.ovb[0];
                    pgno = sq_be32(par.ovb);
                    szNew[i] = sq_cell_size(db, par.type, par.ovb);
                    pnov = 0;
                    par.novf = 0;
                }
                else
                {
                    t = i + nxDiv - pnov;
                    cpc = sq_mp_cell(par, t);
                    apDiv[i] = (u64)@pd[cpc];
                    pgno = sq_be32(@pd[cpc]);
                    szNew[i] = sq_cell_size(db, par.type, @pd[cpc]);
                    if (sq_mp_dropcell(par, t, szNew[i]) != 0) { return 1; };
                };
            };
            lastpg = pgno;
            po = (SQ_PM*)pmo[0];
            pageFlags = (int)po.type;
            leaf = 0;
            if (pageFlags == 13 | pageFlags == 10) { leaf = 1; };
            leafData = 0;
            if (pageFlags == 13) { leafData = 1; };
            leafCorr = 0;
            if (leaf == 1) { leafCorr = 4; };
            // collect the cells of all siblings with the dividers between them
            nc = 0;
            iSpace1 = 0;
            for (i = 0; i < nOld; i++)
            {
                po = (SQ_PM*)pmo[i];
                if ((int)po.type != pageFlags) { return 1; };
                cof = po.hoff + po.hsz;
                limit = 0;
                if (po.novf > 0)
                {
                    limit = po.ov0;
                    for (j = 0; j < limit; j++)
                    {
                        cpc = sq_be16(@po.img[cof + 2 * j]);
                        ap[nc] = (u64)@po.img[cpc];
                        szc[nc] = sq_cell_size(db, pageFlags, @po.img[cpc]);
                        nc++;
                    };
                    for (j = 0; j < po.novf; j++)
                    {
                        ap[nc] = (u64)@po.ovb[j * ps];
                        szc[nc] = sq_cell_size(db, pageFlags, @po.ovb[j * ps]);
                        nc++;
                    };
                };
                for (j = limit; j < po.nimg; j++)
                {
                    cpc = sq_be16(@po.img[cof + 2 * j]);
                    ap[nc] = (u64)@po.img[cpc];
                    szc[nc] = sq_cell_size(db, pageFlags, @po.img[cpc]);
                    nc++;
                };
                cntOld[i] = nc;
                if (i < nOld - 1 & leafData == 0)
                {
                    sz = szNew[i];
                    pTemp = @aS1[iSpace1];
                    iSpace1 = iSpace1 + sz;
                    sq_memcpy(pTemp, (byte*)apDiv[i], sz);
                    ap[nc] = (u64)pTemp + (u64)leafCorr;
                    szc[nc] = sz - leafCorr;
                    if (leaf == 0)
                    {
                        sq_memcpy((byte*)ap[nc], @po.img[po.hoff + 8], 4);
                    }
                    else
                    {
                        while (szc[nc] < 4)
                        {
                            aS1[iSpace1] = (byte)0;
                            iSpace1++;
                            szc[nc] = szc[nc] + 1;
                        };
                    };
                    nc++;
                };
            };
            // the size of the pages, then the number of pages needed and the cells on each
            usableSpace = U - 12 + leafCorr;
            for (i = 0; i < nOld; i++)
            {
                po = (SQ_PM*)pmo[i];
                szNew[i] = usableSpace - po.nfree;
                for (j = 0; j < po.novf; j++) { szNew[i] = szNew[i] + 2 + sq_cell_size(db, pageFlags, @po.ovb[j * ps]); };
                cntNew[i] = cntOld[i];
            };
            k = nOld;
            for (i = 0; i < k; i++)
            {
                while (szNew[i] > usableSpace)
                {
                    if (i + 1 >= k)
                    {
                        k = i + 2;
                        if (k > 5) { return 1; };
                        szNew[k - 1] = 0;
                        cntNew[k - 1] = nc;
                    };
                    sz = 2 + szc[cntNew[i] - 1];
                    szNew[i] = szNew[i] - sz;
                    if (leafData == 0)
                    {
                        if (cntNew[i] < nc) { sz = 2 + szc[cntNew[i]]; } else { sz = 0; };
                    };
                    szNew[i + 1] = szNew[i + 1] + sz;
                    cntNew[i] = cntNew[i] - 1;
                };
                while (cntNew[i] < nc)
                {
                    sz = 2 + szc[cntNew[i]];
                    if (szNew[i] + sz > usableSpace) { break; };
                    szNew[i] = szNew[i] + sz;
                    cntNew[i] = cntNew[i] + 1;
                    if (leafData == 0)
                    {
                        if (cntNew[i] < nc) { sz = 2 + szc[cntNew[i]]; } else { sz = 0; };
                    };
                    szNew[i + 1] = szNew[i + 1] - sz;
                };
                if (cntNew[i] >= nc) { k = i + 1; }
                else
                {
                    lim = 0;
                    if (i > 0) { lim = cntNew[i - 1]; };
                    if (cntNew[i] <= lim) { return 1; };
                };
            };
            // adjust the packing: the right siblings take cells back from the left ones
            for (i = k - 1; i > 0; i--)
            {
                szRight = szNew[i];
                szLeft = szNew[i - 1];
                r = cntNew[i - 1] - 1;
                d = r + 1 - leafData;
                while (true)
                {
                    szR = szc[r];
                    szD = szc[d];
                    lim = 2;
                    if (i == k - 1) { lim = 0; };
                    if (szRight != 0)
                    {
                        if (bBulk == 1) { break; };
                        if (szRight + szD + 2 > szLeft - (szR + lim)) { break; };
                    };
                    szRight = szRight + szD + 2;
                    szLeft = szLeft - (szR + 2);
                    cntNew[i - 1] = r;
                    r--;
                    d--;
                    if (r < 0) { break; };
                };
                szNew[i] = szRight;
                szNew[i - 1] = szLeft;
                lim = 0;
                if (i > 1) { lim = cntNew[i - 2]; };
                if (cntNew[i - 1] <= lim) { return 1; };
            };
            // the pages: the old siblings are reused, further pages are allocated next to the previous one
            nNew = 0;
            for (i = 0; i < k; i++)
            {
                if (i < nOld)
                {
                    pn = (SQ_PM*)pmo[i];
                    pmo[i] = (u64)0;
                    ownN[i] = ownO[i];
                    ownO[i] = 0;
                }
                else
                {
                    j = lastpg;
                    if (bBulk == 1) { j = 1; };
                    np = sq_alloc_page_near(db, j);
                    if (np == 0) { return 1; };
                    lastpg = np;
                    pn = sq_pm_new(db);
                    if ((u64)pn == (u64)0) { return 1; };
                    if (sq_mp_newpage(db, np, pageFlags, pn) != 0) { return 1; };
                    ownN[i] = 1;
                    cntOld[i] = nc;
                };
                pmn[i] = (u64)pn;
                nNew++;
            };
            // the new pages take ascending page numbers
            for (i = 0; i < nNew - 1; i++)
            {
                j = i;
                for (t = i + 1; t < nNew; t++)
                {
                    pn = (SQ_PM*)pmn[t];
                    pq = (SQ_PM*)pmn[j];
                    if (pn.pgno < pq.pgno) { j = t; };
                };
                if (j != i)
                {
                    pn = (SQ_PM*)pmn[i];
                    pq = (SQ_PM*)pmn[j];
                    t = pn.pgno;
                    pn.pgno = pq.pgno;
                    pq.pgno = t;
                };
            };
            // the right pointer of the last page when pages were added or removed
            pn = (SQ_PM*)pmn[nNew - 1];
            if (leaf == 0 & nOld != nNew)
            {
                if (nNew > nOld) { pq = (SQ_PM*)pmn[nOld - 1]; } else { pq = (SQ_PM*)pmo[nOld - 1]; };
                sq_memcpy(@pn.img[pn.hoff + 8], @pq.img[pq.hoff + 8], 4);
            };
            sq_put32((byte*)pRightA, pn.pgno);
            // the divider cells go into the parent
            for (i = 0; i < nNew - 1; i++)
            {
                pn = (SQ_PM*)pmn[i];
                j = cntNew[i];
                pCell = ap[j];
                sz = szc[j] + leafCorr;
                if (leaf == 0)
                {
                    sq_memcpy(@pn.img[pn.hoff + 8], (byte*)pCell, 4);
                    if (sq_mp_insertcell(par, nxDiv + i, (byte*)pCell, sz, pn.pgno) != 0) { return 1; };
                }
                else
                {
                    if (leafData == 1)
                    {
                        j--;
                        n1 = sq_varint((byte*)ap[j], @va);
                        sq_varint((byte*)(ap[j] + (u64)n1), @vb);
                        dl = sq_put_varint(@dv[4], vb);
                        sz = 4 + dl;
                        if (sq_mp_insertcell(par, nxDiv + i, @dv[0], sz, pn.pgno) != 0) { return 1; };
                    }
                    else
                    {
                        pCell = pCell - (u64)4;
                        if (szc[j] == 4) { sz = sq_cell_size(db, par.type, (byte*)pCell); };
                        if (sq_mp_insertcell(par, nxDiv + i, (byte*)pCell, sz, pn.pgno) != 0) { return 1; };
                    };
                };
            };
            // update the pages; the order keeps cells that are still to be read from being overwritten
            for (i = 1 - nNew; i < nNew; i++)
            {
                iPg = i;
                if (i < 0) { iPg = 0 - i; };
                if (abDone[iPg] != 0) { continue; };
                ic = 0;
                if (i >= 0) { ic = 1; }
                else
                {
                    if (cntOld[iPg - 1] >= cntNew[iPg - 1]) { ic = 1; };
                };
                if (ic == 1)
                {
                    if (iPg == 0)
                    {
                        iNew = 0;
                        iOld = 0;
                        nNewCell = cntNew[0];
                    }
                    else
                    {
                        if (iPg < nOld) { iOld = cntOld[iPg - 1] + (1 - leafData); } else { iOld = nc; };
                        iNew = cntNew[iPg - 1] + (1 - leafData);
                        nNewCell = cntNew[iPg] - iNew;
                    };
                    pn = (SQ_PM*)pmn[iPg];
                    if (sq_bl_edit(pn, iOld, iNew, nNewCell, ap, szc) != 0) { return 1; };
                    abDone[iPg] = abDone[iPg] + 1;
                    pn.nfree = usableSpace - szNew[iPg];
                };
            };
            for (i = 0; i < nNew; i++)
            {
                pn = (SQ_PM*)pmn[i];
                if (sq_page_write(db, pn.pgno, pn.img) != 0) { return 1; };
            };
            // the root with no cells left takes over the content of its only child
            pn = (SQ_PM*)pmn[0];
            if (isRoot == 1 & par.nimg == 0 & par.hoff <= pn.nfree)
            {
                if (sq_mp_defrag(pn, 0 - 1) != 0) { return 1; };
                if (sq_bl_copynode(pn, par) != 0) { return 1; };
                if (sq_page_write(db, pn.pgno, pn.img) != 0) { return 1; };
                if (sq_free_page(db, pn.pgno) != 0) { return 1; };
            };
            // old pages that were not reused
            for (i = nNew; i < nOld; i++)
            {
                po = (SQ_PM*)pmo[i];
                if ((u64)po == (u64)cur)
                {
                    if (sq_page_write(db, po.pgno, po.img) != 0) { return 1; };
                };
                if (sq_free_page(db, po.pgno) != 0) { return 1; };
            };
            for (i = 0; i < nNew; i++) { if (ownN[i] == 1) { sq_pm_del((SQ_PM*)pmn[i]); }; };
            for (i = nNew; i < nOld; i++) { if (ownO[i] == 1) { sq_pm_del((SQ_PM*)pmo[i]); }; };
            ffree((u64)ap); ffree((u64)szc); ffree((u64)aS1);
            if (par.hsz == 12) { par.rightmost = sq_be32(@par.img[par.hoff + 8]); };
            return sq_mp_sync(par);
        };

        // The balance loop. cur is the page at path level d (pgs[k] / cis[k]: the page and the child index at level k), held
        // in memory and not yet written. pend, at level pendl (-1 for none), is a parent page held in memory with changes
        // that are not yet written (the interior page of an index delete). *stop receives the level at which the loop ended.
        def sq_bal_run(SQLITE_DB* db, int* pgs, int* cis, int d, SQ_PM* cur, int bulk, int pendl, SQ_PM* pend, int* stop) -> int
        {
            SQ_PM* par;
            SQ_PM* ch;
            u64[40] mine;
            int nm, rc, i, root, isq;
            nm = 0;
            rc = 0;
            while (true)
            {
                if (cur.novf == 0 & cur.nfree * 3 <= db.usable * 2)
                {
                    *stop = d;
                    rc = sq_page_write(db, pgs[d], cur.img);
                    break;
                };
                if (d == 0)
                {
                    if (cur.novf == 0)
                    {
                        *stop = 0;
                        rc = sq_page_write(db, pgs[0], cur.img);
                        break;
                    };
                    if (sq_bl_deeper(db, cur, @ch) != 0) { rc = 1; break; };
                    mine[nm] = (u64)ch;
                    nm++;
                    pgs[1] = ch.pgno;
                    cis[0] = 0;
                    pend = cur;
                    pendl = 0;
                    cur = ch;
                    d = 1;
                    continue;
                };
                if (pendl == d - 1) { par = pend; }
                else
                {
                    par = sq_pm_new(db);
                    if ((u64)par == (u64)0) { rc = 1; break; };
                    mine[nm] = (u64)par;
                    nm++;
                    if (sq_pm_load(db, pgs[d - 1], par) != 0) { rc = 1; break; };
                };
                root = 0;
                if (d == 1) { root = 1; };
                isq = 0;
                if (cur.type == 13 & cur.novf == 1 & cur.ov0 == cur.nimg & par.pgno != 1 & par.nimg == cis[d - 1]) { isq = 1; };
                if (isq == 1)
                {
                    rc = sq_bl_quick(db, par, cur);
                    if (rc == 0) { rc = sq_page_write(db, cur.pgno, cur.img); };
                }
                else { rc = sq_bal_nonroot(db, par, cis[d - 1], root, bulk, cur); };
                if (rc != 0) { break; };
                if (pendl == d - 1) { pendl = 0 - 1; };
                cur = par;
                d--;
            };
            for (i = 0; i < nm; i++) { sq_pm_del((SQ_PM*)mine[i]); };
            return rc;
        };

        // after an insert into cur: pages are only balanced when a cell did not fit
        def sq_bal_ins(SQLITE_DB* db, int* pgs, int* cis, int d, SQ_PM* cur, int bulk) -> int
        {
            int stop;
            if (cur.novf == 0) { return sq_page_write(db, pgs[d], cur.img); };
            return sq_bal_run(db, pgs, cis, d, cur, bulk, 0 - 1, (SQ_PM*)0, @stop);
        };

        // after a cell was removed from cur: the page is always checked
        def sq_bal_del(SQLITE_DB* db, int* pgs, int* cis, int d, SQ_PM* cur) -> int
        {
            int stop;
            return sq_bal_run(db, pgs, cis, d, cur, 0, 0 - 1, (SQ_PM*)0, @stop);
        };
        // ---- table b-tree: insert and delete (SQLite's insert / delete followed by balance()) ----

        // set while a bulk load (VACUUM, INSERT ... SELECT transfer) is writing: BTREE_BULKLOAD
        global int SQ_BULK = 0;

        def sq_btree_insert_b(SQLITE_DB* db, int root, i64 rowid, byte* payload, int plen, int bulk) -> int
        {
            SQ_PATH pa;
            SQ_PM cur;
            int r, clen, d, rc, stop;
            r = sq_seek(db, root, rowid, @pa);
            if (r == 1) { return 2; };
            if (r < 0) { return 1; };
            clen = sq_build_cell(db, rowid, payload, plen, db.cbuf);
            if (clen < 0) { return 1; };
            d = pa.depth - 1;
            if (sq_pm_init(db, @cur) != 0) { sq_pm_free(@cur); return 1; };
            if (sq_pm_load(db, pa.pg[d], @cur) != 0) { sq_pm_free(@cur); return 1; };
            sq_pm_ins(@cur, pa.ci[d], db.cbuf, clen);
            rc = sq_bal_ins(db, @pa.pg[0], @pa.ci[0], d, @cur, bulk);
            sq_pm_free(@cur);
            return rc;
        };

        // 0 inserted, 2 rowid already present, anything else is an error
        def sq_btree_insert(SQLITE_DB* db, int root, i64 rowid, byte* payload, int plen) -> int
        {
            return sq_btree_insert_b(db, root, rowid, payload, plen, SQ_BULK);
        };

        def sq_free_chain(SQLITE_DB* db, int first) -> int
        {
            byte* page;
            int pg, nxt, guard;
            pg = first;
            guard = 0;
            while (pg != 0)
            {
                page = sq_page(db, pg);
                if ((u64)page == (u64)0) { return 1; };
                nxt = sq_be32(@page[0]);
                if (sq_free_page(db, pg) != 0) { return 1; };
                pg = nxt;
                guard++;
                if (guard > db.npages + 4) { return 1; };
            };
            return 0;
        };

        // 0 deleted, 1 no such rowid, 2 error
        def sq_btree_delete(SQLITE_DB* db, int root, i64 rowid) -> int
        {
            SQ_PATH pa;
            SQ_PM cur;
            u64 a, b;
            int r, d, idx, n, m, lcl, total, ov, rc, stop;
            r = sq_seek(db, root, rowid, @pa);
            if (r < 0) { return 2; };
            if (r == 0) { return 1; };
            d = pa.depth - 1;
            idx = pa.ci[d];
            if (sq_pm_init(db, @cur) != 0) { sq_pm_free(@cur); return 2; };
            if (sq_pm_load(db, pa.pg[d], @cur) != 0) { sq_pm_free(@cur); return 2; };
            n = sq_varint(@cur.buf[cur.off[idx]], @a);
            m = sq_varint(@cur.buf[cur.off[idx] + n], @b);
            total = (int)a;
            lcl = sq_local_size(db, total);
            if (lcl < total)
            {
                ov = sq_be32(@cur.buf[cur.off[idx] + n + m + lcl]);
                if (sq_free_chain(db, ov) != 0) { sq_pm_free(@cur); return 2; };
            };
            sq_pm_remove(@cur, idx);
            rc = sq_bal_del(db, @pa.pg[0], @pa.ci[0], d, @cur);
            sq_pm_free(@cur);
            if (rc != 0) { return 2; };
            return 0;
        };


        // Replaces the row with the given rowid the way SQLite's insert over an existing key does: the new cell is built
        // first, a cell of the same size without overflow is overwritten in place, otherwise the old cell is dropped and
        // the new one inserted at the same place.
        def sq_btree_replace(SQLITE_DB* db, int root, i64 rowid, byte* payload, int plen) -> int
        {
            SQ_PATH pa;
            SQ_PM cur;
            u64 a, b;
            byte* page;
            int r, clen, d, idx, n, m, total, lcl, ov, rc, stop, k, j, pgn;
            r = sq_seek(db, root, rowid, @pa);
            if (r < 0) { return 1; };
            if (r == 0) { return sq_btree_insert(db, root, rowid, payload, plen); };
            d = pa.depth - 1;
            idx = pa.ci[d];
            if (sq_pm_init(db, @cur) != 0) { sq_pm_free(@cur); return 1; };
            if (sq_pm_load(db, pa.pg[d], @cur) != 0) { sq_pm_free(@cur); return 1; };
            n = sq_varint(@cur.buf[cur.off[idx]], @a);
            m = sq_varint(@cur.buf[cur.off[idx] + n], @b);
            total = (int)a;
            lcl = sq_local_size(db, total);
            if (total == plen)
            {
                // the payload keeps its size: it is written over the old one, overflow pages included (btreeOverwriteCell)
                sq_pm_poke(@cur, idx, n + m, payload, lcl);
                rc = sq_page_write(db, pa.pg[d], cur.img);
                if (rc == 0 & lcl < total)
                {
                    ov = sq_be32(@cur.buf[cur.off[idx] + n + m + lcl]);
                    r = lcl;
                    while (ov != 0 & r < total)
                    {
                        pgn = ov;
                        page = sq_page(db, pgn);
                        if ((u64)page == (u64)0) { rc = 1; break; };
                        for (k = 0; k < db.page_size; k++) { db.wbuf[k] = page[k]; };
                        ov = sq_be32(@page[0]);
                        k = total - r;
                        if (k > db.usable - 4) { k = db.usable - 4; };
                        for (j = 0; j < k; j++) { db.wbuf[4 + j] = payload[r + j]; };
                        r = r + k;
                        if (sq_page_write(db, pgn, db.wbuf) != 0) { rc = 1; break; };
                    };
                };
                sq_pm_free(@cur);
                if (rc != 0) { return 1; };
                return 0;
            };
            clen = sq_build_cell(db, rowid, payload, plen, db.cbuf);
            if (clen < 0) { sq_pm_free(@cur); return 1; };
            if (lcl == total & cur.len[idx] == clen | (lcl == total & cur.len[idx] == 4 & clen < 4))
            {
                // same size, nothing on overflow pages: overwrite
                sq_pm_poke(@cur, idx, 0, db.cbuf, clen);
                rc = sq_page_write(db, pa.pg[d], cur.img);
                sq_pm_free(@cur);
                if (rc != 0) { return 1; };
                return 0;
            };
            if (lcl < total)
            {
                ov = sq_be32(@cur.buf[cur.off[idx] + n + m + lcl]);
                if (sq_free_chain(db, ov) != 0) { sq_pm_free(@cur); return 1; };
            };
            sq_pm_remove(@cur, idx);
            sq_pm_ins(@cur, idx, db.cbuf, clen);
            rc = sq_bal_ins(db, @pa.pg[0], @pa.ci[0], d, @cur, 0);
            sq_pm_free(@cur);
            return rc;
        };

        // ---- index b-trees: cells ----

        // Builds an index cell for a record payload into out (leaf form; with child >= 0 the interior form).
        // Overflow pages are allocated as needed. Returns the cell size or -1.
        def sq_ix_build_cell(SQLITE_DB* db, byte* payload, int plen, int child, byte* out) -> int
        {
            byte* oldpg;
            int n, lcl, i, pos, chunk, cur, nxt, U, o;
            o = 0;
            if (child >= 0) { sq_put32(out, child); o = 4; };
            n = o + sq_put_varint(@out[o], (u64)plen);
            lcl = sq_ilocal(db, plen);
            for (i = 0; i < lcl; i++) { out[n + i] = payload[i]; };
            if (lcl == plen) { return n + lcl; };
            U = db.usable;
            pos = lcl;
            cur = sq_alloc_page(db);
            if (cur == 0) { return 0 - 1; };
            sq_put32(@out[n + lcl], cur);
            while (pos < plen)
            {
                chunk = plen - pos;
                if (chunk > U - 4) { chunk = U - 4; };
                nxt = 0;
                if (pos + chunk < plen)
                {
                    nxt = sq_alloc_page_near(db, cur);
                    if (nxt == 0) { return 0 - 1; };
                };
                oldpg = sq_page(db, cur);
                if ((u64)oldpg == (u64)0) { return 0 - 1; };
                for (i = 0; i < db.page_size; i++) { db.wbuf[i] = oldpg[i]; };
                sq_put32(@db.wbuf[0], nxt);
                for (i = 0; i < chunk; i++) { db.wbuf[4 + i] = payload[pos + i]; };
                if (sq_page_write(db, cur, db.wbuf) != 0) { return 0 - 1; };
                pos = pos + chunk;
                cur = nxt;
            };
            return n + lcl + 4;
        };

        // overflow chain of a cell (first page number, 0 when none); cell points at the start of the cell on an index page
        def sq_ix_cell_ovf(SQLITE_DB* db, int type, byte* cell) -> int
        {
            u64 a;
            int m, n, total, lcl;
            m = 0;
            if (type == 2) { m = 4; };
            n = sq_varint(@cell[m], @a);
            total = (int)a;
            lcl = sq_ilocal(db, total);
            if (lcl < total) { return sq_be32(@cell[m + n + lcl]); };
            return 0;
        };

        // ---- index b-trees: descent ----

        struct SQ_IPATH
        {
            int depth, found;
            int[20] pg;
            int[20] ci;
        };

        // Descends to the entry equal to probe (all n values compared). found = 1 when the entry exists; the last
        // path level then is the page holding it, otherwise it is the leaf and ci the insertion position.
        def sq_ix_descend(SQ_ICUR* c, SQ_VAL* probe, int n, SQ_IPATH* pa) -> int
        {
            SQLITE_DB* db = c.db;
            byte* page;
            int pgno, ho, t, nc, lo, hi, mid, cmp, child, d;
            pgno = c.ix.root;
            pa.depth = 0;
            pa.found = 0;
            while (true)
            {
                if (pa.depth >= 20) { return 1; };
                page = sq_page(db, pgno);
                if ((u64)page == (u64)0) { return 1; };
                ho = sq_hdr_off(pgno);
                t = (int)page[ho];
                nc = sq_be16(@page[ho + 3]);
                if (t != 2 & t != 10) { return 1; };
                lo = 0;
                hi = nc;
                while (lo < hi)
                {
                    mid = (lo + hi) / 2;
                    if (sq_icur_load(c, pgno, mid) != 0) { return 1; };
                    cmp = sq_icmp(c.ix, @c.v[0], c.nv, probe, n);
                    if (cmp == 0) { lo = mid; hi = mid; pa.found = 1; break; };
                    if (cmp < 0) { lo = mid + 1; } else { hi = mid; };
                };
                d = pa.depth;
                pa.pg[d] = pgno;
                pa.ci[d] = lo;
                pa.depth = d + 1;
                if (pa.found == 1) { return 0; };
                if (t == 10) { return 0; };
                page = sq_page(db, pgno);
                if ((u64)page == (u64)0) { return 1; };
                if (lo < nc) { child = sq_be32(@page[sq_be16(@page[ho + 12 + 2 * lo])]); }
                else { child = sq_be32(@page[ho + 8]); };
                pgno = child;
            };
            return 1;
        };

        // ---- index b-trees: insert ----

        // payload of an entry: key values followed by the rowid
        def sq_ix_payload(SQ_VAL* vals, int n, byte** outp, int* outn) -> int
        {
            int sz;
            byte* rec;
            sz = sq_rec_size(vals, n);
            rec = (byte*)fmalloc((u64)(sz + 8));
            if ((u64)rec == (u64)0) { return 1; };
            sq_rec_write(vals, n, rec);
            *outp = rec;
            *outn = sz;
            return 0;
        };

        // 0 inserted, 2 the exact entry exists, otherwise an error. vals holds nk key values and the rowid.
        def sq_ix_insert_b(SQLITE_DB* db, SQ_IDX* ix, SQ_VAL* vals, int bulk) -> int
        {
            SQ_ICUR c;
            SQ_IPATH pa;
            SQ_PM cur;
            byte* rec;
            byte* cell;
            int rn, clen, rc, d, r, stop;
            if (sq_ix_payload(vals, ix.nrc, @rec, @rn) != 0) { return 1; };
            cell = (byte*)fmalloc((u64)(db.page_size + rn + 64));
            if ((u64)cell == (u64)0) { ffree((u64)rec); return 1; };
            sq_icur_open(@c, db, ix);
            r = sq_ix_descend(@c, vals, ix.ncmp, @pa);
            sq_icur_close(@c);
            if (r != 0) { ffree((u64)rec); ffree((u64)cell); return 1; };
            if (pa.found == 1) { ffree((u64)rec); ffree((u64)cell); return 2; };
            clen = sq_ix_build_cell(db, rec, rn, 0 - 1, cell);
            ffree((u64)rec);
            if (clen < 0) { ffree((u64)cell); return 1; };
            d = pa.depth - 1;
            if (sq_pm_init(db, @cur) != 0) { sq_pm_free(@cur); ffree((u64)cell); return 1; };
            if (sq_pm_load(db, pa.pg[d], @cur) != 0) { sq_pm_free(@cur); ffree((u64)cell); return 1; };
            sq_pm_ins(@cur, pa.ci[d], cell, clen);
            ffree((u64)cell);
            rc = sq_bal_ins(db, @pa.pg[0], @pa.ci[0], d, @cur, bulk);
            sq_pm_free(@cur);
            return rc;
        };

        def sq_ix_insert(SQLITE_DB* db, SQ_IDX* ix, SQ_VAL* vals) -> int
        {
            return sq_ix_insert_b(db, ix, vals, SQ_BULK);
        };

        // Replaces the entry equal to vals the way SQLite's insert over an existing index key does (used for the primary key
        // entry of an UPDATE of a WITHOUT ROWID table that leaves the key alone). 0 done, otherwise an error.
        def sq_ix_replace(SQLITE_DB* db, SQ_IDX* ix, SQ_VAL* vals) -> int
        {
            SQ_ICUR c;
            SQ_IPATH pa;
            SQ_PM cur;
            byte* rec;
            byte* cell;
            int rn, clen, rc, d, r, stop, idx, child, ov, k, ty, ovl, hd, lcl, j, pgn;
            u64 ta;
            byte* page;
            if (sq_ix_payload(vals, ix.nrc, @rec, @rn) != 0) { return 1; };
            cell = (byte*)fmalloc((u64)(db.page_size + rn + 64));
            if ((u64)cell == (u64)0) { ffree((u64)rec); return 1; };
            sq_icur_open(@c, db, ix);
            r = sq_ix_descend(@c, vals, ix.ncmp, @pa);
            sq_icur_close(@c);
            if (r != 0) { ffree((u64)rec); ffree((u64)cell); return 1; };
            if (pa.found == 0) { ffree((u64)rec); ffree((u64)cell); return sq_ix_insert(db, ix, vals); };
            d = pa.depth - 1;
            idx = pa.ci[d];
            if (sq_pm_init(db, @cur) != 0) { sq_pm_free(@cur); ffree((u64)rec); ffree((u64)cell); return 1; };
            if (sq_pm_load(db, pa.pg[d], @cur) != 0) { sq_pm_free(@cur); ffree((u64)rec); ffree((u64)cell); return 1; };
            ty = cur.type;
            child = 0 - 1;
            if (ty == 2) { child = sq_be32(@cur.buf[cur.off[idx]]); };
            ov = sq_ix_cell_ovf(db, ty, @cur.buf[cur.off[idx]]);
            hd = 0;
            if (ty == 2) { hd = 4; };
            hd = hd + sq_varint(@cur.buf[cur.off[idx] + hd], @ta);
            if ((int)ta == rn)
            {
                // the payload keeps its size: it is written over the old one, overflow pages included
                lcl = cur.len[idx] - hd;
                if (ov != 0) { lcl = lcl - 4; };
                sq_pm_poke(@cur, idx, hd, rec, lcl);
                rc = sq_page_write(db, pa.pg[d], cur.img);
                if (rc == 0 & ov != 0)
                {
                    r = lcl;
                    while (ov != 0 & r < rn)
                    {
                        pgn = ov;
                        page = sq_page(db, pgn);
                        if ((u64)page == (u64)0) { rc = 1; break; };
                        for (k = 0; k < db.page_size; k++) { db.wbuf[k] = page[k]; };
                        ov = sq_be32(@page[0]);
                        k = rn - r;
                        if (k > db.usable - 4) { k = db.usable - 4; };
                        for (j = 0; j < k; j++) { db.wbuf[4 + j] = rec[r + j]; };
                        r = r + k;
                        if (sq_page_write(db, pgn, db.wbuf) != 0) { rc = 1; break; };
                    };
                };
                sq_pm_free(@cur);
                ffree((u64)cell);
                ffree((u64)rec);
                if (rc != 0) { return 1; };
                return 0;
            };
            clen = sq_ix_build_cell(db, rec, rn, child, cell);
            ffree((u64)rec);
            if (clen < 0) { sq_pm_free(@cur); ffree((u64)cell); return 1; };
            if (ov != 0) { if (sq_free_chain(db, ov) != 0) { sq_pm_free(@cur); ffree((u64)cell); return 1; }; };
            sq_pm_remove(@cur, idx);
            sq_pm_ins(@cur, idx, cell, clen);
            ffree((u64)cell);
            rc = sq_bal_ins(db, @pa.pg[0], @pa.ci[0], d, @cur, 0);
            sq_pm_free(@cur);
            return rc;
        };

        // ---- index b-trees: delete ----

        // 0 deleted, 1 not found, 2 error
        def sq_ix_delete(SQLITE_DB* db, SQ_IDX* ix, SQ_VAL* vals) -> int
        {
            SQ_ICUR c;
            SQ_IPATH pa;
            SQ_PM ip, lf;
            int r, d, idx, rc, ov, pg, lv, last, stop, k;
            byte* page;
            byte* newcell;
            sq_icur_open(@c, db, ix);
            r = sq_ix_descend(@c, vals, ix.ncmp, @pa);
            sq_icur_close(@c);
            if (r != 0) { return 2; };
            if (pa.found == 0) { return 1; };
            d = pa.depth - 1;
            idx = pa.ci[d];
            if (sq_pm_init(db, @ip) != 0) { sq_pm_free(@ip); return 2; };
            if (sq_pm_load(db, pa.pg[d], @ip) != 0) { sq_pm_free(@ip); return 2; };
            if (ip.type == 10)
            {
                ov = sq_ix_cell_ovf(db, 10, @ip.buf[ip.off[idx]]);
                if (ov != 0) { if (sq_free_chain(db, ov) != 0) { sq_pm_free(@ip); return 2; }; };
                sq_pm_remove(@ip, idx);
                rc = sq_bal_del(db, @pa.pg[0], @pa.ci[0], d, @ip);
                sq_pm_free(@ip);
                if (rc != 0) { return 2; };
                return 0;
            };
            // interior entry: replace it with its predecessor, the last entry of the leaf at the end of the left subtree
            ov = sq_ix_cell_ovf(db, 2, @ip.buf[ip.off[idx]]);
            if (ov != 0) { if (sq_free_chain(db, ov) != 0) { sq_pm_free(@ip); return 2; }; };
            pg = sq_be32(@ip.buf[ip.off[idx]]);
            lv = d;
            while (true)
            {
                lv++;
                if (lv >= 20) { sq_pm_free(@ip); return 2; };
                pa.pg[lv] = pg;
                page = sq_page(db, pg);
                if ((u64)page == (u64)0) { sq_pm_free(@ip); return 2; };
                r = (int)page[sq_hoff(pg)];
                if (r == 10) { break; };
                pa.ci[lv] = sq_be16(@page[sq_hoff(pg) + 3]);
                pg = sq_be32(@page[sq_hoff(pg) + 8]);
            };
            if (sq_pm_init(db, @lf) != 0) { sq_pm_free(@ip); sq_pm_free(@lf); return 2; };
            if (sq_pm_load(db, pg, @lf) != 0) { sq_pm_free(@ip); sq_pm_free(@lf); return 2; };
            if (lf.ncells < 1) { sq_pm_free(@ip); sq_pm_free(@lf); return 2; };
            last = lf.ncells - 1;
            // the new interior cell: the old left child followed by the predecessor entry
            newcell = (byte*)fmalloc((u64)(lf.len[last] + 16));
            if ((u64)newcell == (u64)0) { sq_pm_free(@ip); sq_pm_free(@lf); return 2; };
            sq_put32(newcell, sq_be32(@ip.buf[ip.off[idx]]));
            for (r = 0; r < lf.len[last]; r++) { newcell[4 + r] = lf.buf[lf.off[last] + r]; };
            k = 4 + lf.len[last];
            sq_pm_remove(@ip, idx);
            sq_pm_insert(@ip, idx, newcell, k);
            ffree((u64)newcell);
            sq_pm_remove(@lf, last);
            rc = sq_bal_run(db, @pa.pg[0], @pa.ci[0], lv, @lf, 0, d, @ip, @stop);
            sq_pm_free(@lf);
            if (rc == 0 & stop > d) { rc = sq_bal_del(db, @pa.pg[0], @pa.ci[0], d, @ip); };
            sq_pm_free(@ip);
            if (rc != 0) { return 2; };
            return 0;
        };

        // ---- freeing whole trees ----

        // Frees the pages of a b-tree (table or index) below and including pgno; with keep the page itself stays and is
        // reset to an empty leaf of the given type.
        def sq_tree_free(SQLITE_DB* db, int pgno, int keep, int emptytype, int depth) -> int
        {
            byte* page;
            byte* buf;
            int ho, t, nc, hsz, i, cp, ov, child, sz, n;
            u64 a, b;
            SQ_PM pm;
            if (depth > 20) { return 1; };
            page = sq_page(db, pgno);
            if ((u64)page == (u64)0) { return 1; };
            // copy the page: nested frees reuse the page cache
            buf = (byte*)fmalloc((u64)db.page_size);
            if ((u64)buf == (u64)0) { return 1; };
            for (i = 0; i < db.page_size; i++) { buf[i] = page[i]; };
            ho = sq_hoff(pgno);
            t = (int)buf[ho];
            nc = sq_be16(@buf[ho + 3]);
            hsz = 8;
            if (t == 5 | t == 2) { hsz = 12; };
            for (i = 0; i < nc; i++)
            {
                cp = sq_be16(@buf[ho + hsz + 2 * i]);
                if (cp >= db.page_size) { ffree((u64)buf); return 1; };
                if (t == 5 | t == 2)
                {
                    child = sq_be32(@buf[cp]);
                    if (sq_tree_free(db, child, 0, 0, depth + 1) != 0) { ffree((u64)buf); return 1; };
                };
                ov = 0;
                if (t == 13)
                {
                    n = sq_varint(@buf[cp], @a);
                    sz = sq_cell_size(db, 13, @buf[cp]);
                    if (sq_local_size(db, (int)a) < (int)a) { ov = sq_be32(@buf[cp + sz - 4]); };
                };
                if (t == 10 | t == 2) { ov = sq_ix_cell_ovf(db, t, @buf[cp]); };
                if (ov != 0) { if (sq_free_chain(db, ov) != 0) { ffree((u64)buf); return 1; }; };
            };
            if (t == 5 | t == 2)
            {
                child = sq_be32(@buf[ho + 8]);
                if (sq_tree_free(db, child, 0, 0, depth + 1) != 0) { ffree((u64)buf); return 1; };
            };
            ffree((u64)buf);
            if (keep == 1)
            {
                return sq_pm_empty(db, pgno, t `| 8);
            };
            return sq_free_page(db, pgno);
        };

        // ---- index b-trees: bulk build (used by CREATE INDEX and rebuilds) ----

        struct SQ_SORTIX
        {
            SQ_IDX* ix;
            byte* recs;
            int* off;
            int* len;
            int n;
            SQ_VAL[18] va;
            SQ_VAL[18] vb;
        };

        def sq_sortix_cmp(SQ_SORTIX* so, int a, int b) -> int
        {
            int na, nb, n;
            na = sq_rec_decode_w(@so.recs[so.off[a]], so.len[a], @so.va[0], 18, 0);
            nb = sq_rec_decode_w(@so.recs[so.off[b]], so.len[b], @so.vb[0], 18, 1);
            n = so.ix.ncmp;
            if (na < n | nb < n) { return 0; };
            return sq_icmp(so.ix, @so.va[0], na, @so.vb[0], n);
        };

        // sorts the entry numbers 0..n-1 into perm
        def sq_sortix_run(SQ_SORTIX* so, int* perm) -> int
        {
            int* tmp;
            int n, i, width, lo, mid, hi, a, b, k;
            n = so.n;
            tmp = (int*)fmalloc((u64)(n + 1) * (u64)4);
            if ((u64)tmp == (u64)0) { return 1; };
            for (i = 0; i < n; i++) { perm[i] = i; };
            width = 1;
            while (width < n)
            {
                lo = 0;
                while (lo < n)
                {
                    mid = lo + width;
                    if (mid > n) { mid = n; };
                    hi = lo + 2 * width;
                    if (hi > n) { hi = n; };
                    a = lo; b = mid; k = lo;
                    while (a < mid & b < hi)
                    {
                        if (sq_sortix_cmp(so, perm[b], perm[a]) < 0) { tmp[k] = perm[b]; b++; } else { tmp[k] = perm[a]; a++; };
                        k++;
                    };
                    while (a < mid) { tmp[k] = perm[a]; a++; k++; };
                    while (b < hi) { tmp[k] = perm[b]; b++; k++; };
                    lo = hi;
                };
                for (i = 0; i < n; i++) { perm[i] = tmp[i]; };
                width = width * 2;
            };
            ffree((u64)tmp);
            return 0;
        };

        // Builds the b-tree of ix from the sorted records by appending the entries one after the other with the bulk-load
        // hint, as SQLite does for CREATE INDEX. root keeps its page number. The old tree must already be freed.
        def sq_ix_bulk(SQLITE_DB* db, SQ_IDX* ix, SQ_SORTIX* so, int* perm) -> int
        {
            SQ_PM cur;
            SQ_IPATH pa;
            byte* cellbuf;
            byte* page;
            int n, i, k, cn, pg, d, ho, nc, rc, stop;
            n = so.n;
            rc = sq_pm_empty(db, ix.root, 10);
            if (rc != 0) { return 1; };
            if (n == 0) { return 0; };
            cellbuf = (byte*)fmalloc((u64)(db.page_size + 64));
            if ((u64)cellbuf == (u64)0) { return 1; };
            for (i = 0; i < n; i++)
            {
                k = perm[i];
                cn = sq_ix_build_cell(db, @so.recs[so.off[k]], so.len[k], 0 - 1, cellbuf);
                if (cn < 0) { ffree((u64)cellbuf); return 1; };
                // the path down the right edge of the tree
                pg = ix.root;
                d = 0;
                while (true)
                {
                    if (d >= 20) { ffree((u64)cellbuf); return 1; };
                    page = sq_page(db, pg);
                    if ((u64)page == (u64)0) { ffree((u64)cellbuf); return 1; };
                    ho = sq_hoff(pg);
                    nc = sq_be16(@page[ho + 3]);
                    pa.pg[d] = pg;
                    pa.ci[d] = nc;
                    if ((int)page[ho] == 10) { break; };
                    pg = sq_be32(@page[ho + 8]);
                    d++;
                };
                if (sq_pm_init(db, @cur) != 0) { sq_pm_free(@cur); ffree((u64)cellbuf); return 1; };
                if (sq_pm_load(db, pa.pg[d], @cur) != 0) { sq_pm_free(@cur); ffree((u64)cellbuf); return 1; };
                sq_pm_ins(@cur, cur.ncells, cellbuf, cn);
                rc = sq_bal_ins(db, @pa.pg[0], @pa.ci[0], d, @cur, 1);
                sq_pm_free(@cur);
                if (rc != 0) { ffree((u64)cellbuf); return 1; };
            };
            ffree((u64)cellbuf);
            return 0;
        };

        // ---- small helpers ----

        def sq_ihas(byte* s, int n, byte* lit) -> bool
        {
            int i, m, k;
            m = 0;
            while (lit[m] != (byte)0) { m++; };
            for (i = 0; i + m <= n; i++)
            {
                k = 0;
                while (k < m)
                {
                    if (sq_lc(s[i + k]) != lit[k]) { break; };
                    k++;
                };
                if (k == m) { return true; };
            };
            return false;
        };

        // growable byte buffer
        struct SQ_SB
        {
            byte* p;
            int n, cap, err;
        };

        def sq_sb_init(SQ_SB* b) -> void
        {
            b.cap = 256;
            b.p = (byte*)fmalloc((u64)b.cap);
            b.n = 0;
            b.err = 0;
            if ((u64)b.p == (u64)0) { b.err = 1; b.cap = 0; } else { b.p[0] = (byte)0; };
        };

        def sq_sb_free(SQ_SB* b) -> void
        {
            if ((u64)b.p != (u64)0) { ffree((u64)b.p); b.p = (byte*)0; };
            b.n = 0; b.cap = 0;
        };

        def sq_sb_add(SQ_SB* b, byte* s, int n) -> void
        {
            byte* np;
            int i, cap;
            if (b.err != 0) { return; };
            if (b.n + n + 1 > b.cap)
            {
                cap = b.cap * 2;
                while (cap < b.n + n + 1) { cap = cap * 2; };
                np = (byte*)fmalloc((u64)cap);
                if ((u64)np == (u64)0) { b.err = 1; return; };
                for (i = 0; i < b.n; i++) { np[i] = b.p[i]; };
                ffree((u64)b.p);
                b.p = np;
                b.cap = cap;
            };
            for (i = 0; i < n; i++) { b.p[b.n + i] = s[i]; };
            b.n = b.n + n;
            b.p[b.n] = (byte)0;
        };

        def sq_sb_lit(SQ_SB* b, byte* s) -> void
        {
            sq_sb_add(b, s, sq_cstrlen(s));
        };

        // appends "text" as an identifier: quoted with double quotes when it is not a plain word
        def sq_sb_ident(SQ_SB* b, byte* s, int n) -> void
        {
            int i, plain;
            plain = 1;
            if (n == 0) { plain = 0; };
            for (i = 0; i < n; i++)
            {
                if (sq_isalpha(s[i]) == false & sq_isdigit(s[i]) == false) { plain = 0; };
            };
            if (n > 0) { if (sq_isdigit(s[0])) { plain = 0; }; };
            if (plain == 1) { sq_sb_add(b, s, n); return; };
            sq_sb_add(b, "\"\0", 1);
            for (i = 0; i < n; i++)
            {
                if (s[i] == (byte)34) { sq_sb_add(b, "\"\0", 1); };
                sq_sb_add(b, @s[i], 1);
            };
            sq_sb_add(b, "\"\0", 1);
        };

        // appends a signed number
        def sq_sb_int(SQ_SB* b, i64 v) -> void
        {
            byte[24] t;
            int n;
            u64 u;
            if (v < (i64)0)
            {
                sq_sb_add(b, "-\0", 1);
                u = (u64)0 - (u64)v;
            }
            else { u = (u64)v; };
            n = sq_utoa(u, @t[0]);
            sq_sb_add(b, @t[0], n);
        };

        // formats "<a><name><b>" into the statement error
        def sq_err_name(SQ_STMT* st, byte* a, byte* name, int nl, byte* b) -> void
        {
            SQ_SB sb;
            sq_sb_init(@sb);
            sq_sb_lit(@sb, a);
            if (SQ_QUALN > 0 & a[0] == (byte)110 & a[1] == (byte)111 & a[2] == (byte)32 & a[3] == (byte)115)
            {
                sq_sb_add(@sb, @SQ_QUAL[0], SQ_QUALN);
                sq_sb_lit(@sb, ".\0");
            };
            sq_sb_add(@sb, name, nl);
            sq_sb_lit(@sb, b);
            if (sb.err == 0) { sq_seterr(st, sb.p); } else { sq_seterr(st, "out of memory\0"); };
            sq_sb_free(@sb);
        };

        // ---- table context ----

        struct SQ_TCTX
        {
            SQLITE_DB* db;
            SQ_STMT* st;
            int tpos, root, ncols, nix, seqroot;
            SQ_TI* ti;
            SQ_IDX[20] ix;
            int[20] dirty;
            SQ_ARENA ar;
            SQ_VAL[130] dv;
            SQ_VAL[130] nw;
            SQ_VAL[130] ol;
            SQ_VAL[20] kv;
            byte[64] tname;
            int onconf, keep_on_fail;
            // a REPLACE over an existing rowid or primary key: the table entry is written over, not deleted first
            int repl;
            i64 replr;
            // conflicting row found by a probe check (conflict action 6), and the rowids touched by the statement for RETURNING
            i64 cf_rid;
            int cf_ix;
            int[24] ups_skip;
            i64* rl;
            int rn, rcap, ras, rae;
            u64 fkd;
            // WITHOUT ROWID: the table b-tree as an index, and a ring of key copies that stand in for rowids
            int wor, wn;
            i64 wser;
            SQ_IDX wix;
            SQ_ARENA wa;
            SQ_VAL[1024] wkv;
        };

        def sq_fk_collect(SQ_TCTX* tc) -> int;

        def sq_tc_free(SQ_TCTX* tc) -> void
        {
            if ((u64)tc.ti != (u64)0)
            {
                if (tc.ti.gst != (u64)0) { sq_stmt_del((SQ_STMT*)tc.ti.gst); tc.ti.gst = (u64)0; };
                ffree((u64)tc.ti);
                tc.ti = (SQ_TI*)0;
            };
            if ((u64)tc.rl != (u64)0) { ffree((u64)tc.rl); tc.rl = (i64*)0; };
            if (tc.fkd != (u64)0) { ffree(tc.fkd); tc.fkd = (u64)0; };
            {
                int fi;
                for (fi = 0; fi < tc.nix; fi++)
                {
                    if (tc.ix[fi].est != (u64)0) { sq_stmt_del((SQ_STMT*)tc.ix[fi].est); tc.ix[fi].est = (u64)0; };
                };
            };
            tc.rn = 0; tc.rcap = 0;
            sq_ar_free(@tc.ar);
            sq_ar_free(@tc.wa);
        };

        // true when the name span equals the table name
        def sq_name_is(byte* a, int an, byte* b) -> bool
        {
            int i;
            for (i = 0; i < an; i++)
            {
                if (b[i] == (byte)0) { return false; };
                if (sq_lc(a[i]) != sq_lc(b[i])) { return false; };
            };
            return b[an] == (byte)0;
        };

        // locates a table, loads its description and indexes, and evaluates the column defaults
        def sq_tc_open(SQLITE_DB* db, SQ_STMT* st, byte* name, int nl, SQ_TCTX* tc) -> int
        {
            int i, k, c;
            byte* sql;
            tc.db = db; tc.st = st; tc.ti = (SQ_TI*)0; tc.nix = 0; tc.seqroot = 0; tc.onconf = 0; tc.keep_on_fail = 0; tc.repl = 0; tc.replr = (i64)0;
            tc.rl = (i64*)0; tc.rn = 0; tc.rcap = 0; tc.ras = 0 - 1; tc.rae = 0 - 1; tc.cf_rid = (i64)0; tc.cf_ix = 0 - 1; for (i = 0; i < 24; i++) { tc.ups_skip[i] = 0; };
            tc.fkd = (u64)0;
            tc.wor = 0; tc.wn = 0; tc.wser = (i64)0;
            sq_ar_init(@tc.ar);
            sq_ar_init(@tc.wa);
            for (i = 0; i < db.nschema; i++)
            {
                if (db.schema[i].kind == 3 & sq_name_is(name, nl, @db.schema[i].name[0]))
                {
                    sq_err_name(st, "cannot modify \0", name, nl, " because it is a view\0");
                    return 1;
                };
            };
            tc.tpos = sq_find_table_n(db, name, nl);
            if (tc.tpos < 0) { sq_err_name(st, "no such table: \0", name, nl, "\0"); return 1; };
            sql = db.schema[tc.tpos].sql;
            if ((u64)sql == (u64)0) { sq_seterr(st, "cannot modify this table\0"); return 1; };
            for (k = 0; k < 64; k++) { tc.tname[k] = db.schema[tc.tpos].name[k]; };
            if (sq_ihas(sql, 14, "create virtual\0")) { sq_seterr(st, "virtual tables are not supported\0"); return 1; };
            tc.ti = (SQ_TI*)fmalloc((u64)(sizeof(SQ_TI) / 8 + 4096));
            if ((u64)tc.ti == (u64)0) { sq_seterr(st, "out of memory\0"); return 1; };
            if (sq_ti_load(tc.ti, sql) != 0) { sq_seterr(st, "unsupported table definition\0"); return 1; };
            tc.ncols = tc.ti.ncols;
            tc.root = db.schema[tc.tpos].rootpage;
            tc.nix = sq_idx_list(db, tc.tpos, tc.ti, @tc.ix[0], 20);
            for (i = 0; i < tc.nix; i++)
            {
                tc.dirty[i] = 0;
                if (tc.ix[i].wok == 0) { sq_seterr(st, "unsupported index definition\0"); return 1; };
                tc.ix[i].est = (u64)0;
            };
            if (tc.ti.wor == 1)
            {
                tc.wor = 1;
                tc.wix.root = tc.root; tc.wix.nk = tc.ti.npk; tc.wix.unique = 1; tc.wix.ispk = 1; tc.wix.ok = 0;
                tc.wix.schema_pos = 0 - 1; tc.wix.tbl_pos = tc.tpos; tc.wix.partial = 0; tc.wix.ne = 0; tc.wix.wok = 1;
                tc.wix.ws = 0; tc.wix.wl = 0; tc.wix.est = (u64)0; tc.wix.ntl = 0;
                tc.wix.ncmp = tc.ti.npk; tc.wix.nrc = tc.ti.nrec;
                for (k = 0; k < tc.ti.npk; k++)
                {
                    tc.wix.col[k] = tc.ti.pkc[k]; tc.wix.desc[k] = tc.ti.pkd[k]; tc.wix.coll[k] = tc.ti.pkcl[k];
                    tc.wix.isx[k] = 0;
                };
                tc.wix.name[0] = (byte)0;
            };
            // sqlite_sequence for AUTOINCREMENT
            if (tc.ti.autoinc == 1)
            {
                k = sq_find_table_n(db, "sqlite_sequence\0", 15);
                if (k >= 0) { tc.seqroot = db.schema[k].rootpage; };
            };
            // defaults
            for (c = 0; c < tc.ncols; c++)
            {
                sq_val_null(@tc.dv[c]);
                if (tc.ti.dfl[c] > 0)
                {
                    if (sq_eval_text(db, @tc.ti.base[tc.ti.dfs[c]], tc.ti.dfl[c], @tc.ar, @tc.dv[c]) != 0)
                    {
                        sq_seterr(st, "cannot evaluate a column default\0");
                        return 1;
                    };
                    sq_apply_aff(@tc.ar, tc.ti.aff[c], @tc.dv[c]);
                };
            };
            if (sq_fk_collect(tc) != 0) { return 1; };
            return 0;
        };

        // copies the row under the cursor into out[0..ncols] (rowid last) with text owned by ar
        def sq_tc_row(SQ_TCTX* tc, SQ_CURSOR* cur, SQ_ARENA* ar, SQ_VAL* out) -> void
        {
            SQ_TI* ti = tc.ti;
            int c, k;
            byte* p;
            for (c = 0; c < tc.ncols; c++)
            {
                if (c == ti.ipk) { sq_val_int(@out[c], cur.rowid); continue; };
                if (ti.gen[c] == 1) { sq_val_null(@out[c]); continue; };
                if (ti.ri[c] >= cur.ncols)
                {
                    sq_val_copy(@out[c], @tc.dv[c]);
                    continue;
                };
                k = sq_col_type(cur, ti.ri[c]);
                if (k == SQ_INTEGER)
                {
                    if (ti.aff[c] == 4) { sq_val_real(@out[c], (double)sq_col_int(cur, ti.ri[c])); }
                    else { sq_val_int(@out[c], sq_col_int(cur, ti.ri[c])); };
                    continue;
                };
                if (k == SQ_REAL) { sq_val_real(@out[c], sq_col_real(cur, ti.ri[c])); continue; };
                if (k == SQ_TEXT | k == SQ_BLOB)
                {
                    out[c].t = k; out[c].n = sq_col_bytes(cur, ti.ri[c]); out[c].i = (i64)0; out[c].r = 0.0;
                    p = sq_ar_copy(ar, sq_col_ptr(cur, ti.ri[c]), out[c].n);
                    if ((u64)p == (u64)0) { sq_val_null(@out[c]); } else { out[c].p = p; };
                    continue;
                };
                sq_val_null(@out[c]);
            };
            sq_val_int(@out[tc.ncols], cur.rowid);
            if (ti.ngen > 0) { sq_gen_row(tc.st, ti, ar, out, 1); };
        };

        // key values of an index entry for a row (vals has ncols + 1 entries, the last one is the rowid)
        // the fields that end an index entry: the rowid, or the key columns of a WITHOUT ROWID table
        def sq_tc_tail(SQ_TCTX* tc, SQ_IDX* ix, SQ_VAL* vals, SQ_VAL* key) -> void
        {
            int g;
            for (g = 0; g < ix.ntl; g++)
            {
                if (ix.tlc[g] < 0) { sq_val_copy(@key[ix.nk + g], @vals[tc.ncols]); }
                else { sq_val_copy(@key[ix.nk + g], @vals[ix.tlc[g]]); };
            };
        };

        def sq_tc_key(SQ_TCTX* tc, SQ_IDX* ix, SQ_VAL* vals, SQ_VAL* key) -> void
        {
            int k, c;
            for (k = 0; k < ix.nk; k++)
            {
                c = ix.col[k];
                if (c >= tc.ncols) { sq_val_copy(@key[k], @vals[tc.ncols]); }
                else { sq_val_copy(@key[k], @vals[c]); };
            };
            sq_tc_tail(tc, ix, vals, key);
        };

        // builds the evaluator of an expression or partial index: select (e1), ..., (where) from (select ?1 as c1, ...)
        def sq_tc_ixopen(SQ_TCTX* tc, SQ_IDX* ix) -> int
        {
            SQ_TI* ti = tc.ti;
            SQ_SB sb;
            SQ_STMT* g;
            byte* isql;
            int k, c, n, rc;
            isql = tc.db.schema[ix.schema_pos].sql;
            sq_sb_init(@sb);
            sq_sb_lit(@sb, "select \0");
            n = 0;
            for (k = 0; k < ix.nk; k++)
            {
                if (ix.isx[k] == 0) { continue; };
                if (n > 0) { sq_sb_lit(@sb, ", \0"); };
                n++;
                sq_sb_lit(@sb, "(\0");
                sq_sb_add(@sb, @isql[ix.xs[k]], ix.xl[k]);
                sq_sb_lit(@sb, ")\0");
            };
            if (ix.wl > 0)
            {
                if (n > 0) { sq_sb_lit(@sb, ", \0"); };
                sq_sb_lit(@sb, "(\0");
                sq_sb_add(@sb, @isql[ix.ws], ix.wl);
                sq_sb_lit(@sb, ")\0");
            };
            sq_sb_lit(@sb, " from (select \0");
            for (c = 0; c < tc.ncols; c++)
            {
                if (c > 0) { sq_sb_lit(@sb, ", \0"); };
                sq_sb_lit(@sb, "?\0");
                sq_sb_int(@sb, (i64)(c + 1));
                sq_sb_lit(@sb, " as \0");
                sq_sb_ident(@sb, @ti.base[ti.cs[c]], ti.cl[c]);
            };
            sq_sb_lit(@sb, ")\0");
            if (sb.err != 0) { sq_sb_free(@sb); sq_seterr(tc.st, "out of memory\0"); return 1; };
            g = sq_stmt_new();
            if ((u64)g == (u64)0) { sq_sb_free(@sb); sq_seterr(tc.st, "out of memory\0"); return 1; };
            rc = sq_prep_query(g, tc.db, sb.p);
            sq_sb_free(@sb);
            if (rc != 0)
            {
                sq_seterr(tc.st, @g.err[0]);
                sq_stmt_del(g);
                return 1;
            };
            ix.est = (u64)g;
            return 0;
        };

        // key of a row for an index. Returns 1 with the key built, 0 when the row is not in the (partial) index, 2 on error.
        def sq_tc_ixrow(SQ_TCTX* tc, SQ_IDX* ix, SQ_VAL* vals, SQ_VAL* key, SQ_ARENA* ar) -> int
        {
            SQ_STMT* g;
            SQ_VAL* v;
            SQ_VAL* cv;
            int c, k, m, r;
            if (ix.ne == 0 & ix.wl == 0)
            {
                sq_tc_key(tc, ix, vals, key);
                return 1;
            };
            if (ix.est == (u64)0) { if (sq_tc_ixopen(tc, ix) != 0) { return 2; }; };
            g = (SQ_STMT*)ix.est;
            sq_reset(g);
            sq_params_reset(g);
            for (c = 0; c < tc.ncols; c++)
            {
                v = @vals[c];
                if (v.t == SQ_NULL) { sq_bind_null(g, c + 1); };
                if (v.t == SQ_INTEGER) { sq_bind_int(g, c + 1, v.i); };
                if (v.t == SQ_REAL) { sq_bind_real(g, c + 1, v.r); };
                if (v.t == SQ_TEXT) { sq_bind_text(g, c + 1, v.p, v.n); };
                if (v.t == SQ_BLOB) { sq_bind_blob(g, c + 1, v.p, v.n); };
            };
            r = sq_step_query(g);
            if (r != 1) { sq_seterr(tc.st, @g.err[0]); if (g.err[0] == (byte)0) { sq_seterr(tc.st, "index expression failed\0"); }; return 2; };
            if (ix.wl > 0)
            {
                cv = sq_cell(g, ix.ne);
                if (sq_truth(cv) == 0) { return 0; };
            };
            m = 0;
            for (k = 0; k < ix.nk; k++)
            {
                if (ix.isx[k] == 1)
                {
                    cv = sq_cell(g, m);
                    m++;
                    sq_val_copy(@key[k], cv);
                    sq_val_own(ar, @key[k]);
                }
                else
                {
                    c = ix.col[k];
                    if (c >= tc.ncols) { sq_val_copy(@key[k], @vals[tc.ncols]); }
                    else { sq_val_copy(@key[k], @vals[c]); };
                };
            };
            sq_tc_tail(tc, ix, vals, key);
            return 1;
        };

        // serialises a row into a freshly allocated record (the rowid alias column is stored as NULL)
        def sq_tc_record(SQ_TCTX* tc, SQ_VAL* vals, byte** outp, int* outn) -> int
        {
            SQ_VAL save;
            int ipk, sz;
            byte* rec;
            ipk = tc.ti.ipk;
            if (ipk >= 0)
            {
                sq_val_copy(@save, @vals[ipk]);
                sq_val_null(@vals[ipk]);
            };
            if (tc.ti.nrec != tc.ncols | tc.ti.wor == 1)
            {
                // virtual generated columns are not part of the stored record
                SQ_VAL[128] cv;
                int cc;
                for (cc = 0; cc < tc.ncols; cc++)
                {
                    if (tc.ti.ri[cc] >= 0) { sq_val_copy(@cv[tc.ti.ri[cc]], @vals[cc]); };
                };
                sz = sq_rec_size(@cv[0], tc.ti.nrec);
                rec = (byte*)fmalloc((u64)(sz + 8));
                if ((u64)rec == (u64)0)
                {
                    if (ipk >= 0) { sq_val_copy(@vals[ipk], @save); };
                    return 1;
                };
                sq_rec_write(@cv[0], tc.ti.nrec, rec);
                if (ipk >= 0) { sq_val_copy(@vals[ipk], @save); };
                *outp = rec;
                *outn = sz;
                return 0;
            };
            sz = sq_rec_size(vals, tc.ncols);
            rec = (byte*)fmalloc((u64)(sz + 8));
            if ((u64)rec == (u64)0)
            {
                if (ipk >= 0) { sq_val_copy(@vals[ipk], @save); };
                return 1;
            };
            sq_rec_write(vals, tc.ncols, rec);
            if (ipk >= 0) { sq_val_copy(@vals[ipk], @save); };
            *outp = rec;
            *outn = sz;
            return 0;
        };

        // true when two values are stored identically
        def sq_val_same(SQ_VAL* a, SQ_VAL* b) -> bool
        {
            int i;
            if (a.t != b.t) { return false; };
            if (a.t == SQ_NULL) { return true; };
            if (a.t == SQ_INTEGER) { return a.i == b.i; };
            if (a.t == SQ_REAL) { return a.r == b.r; };
            if (a.n != b.n) { return false; };
            for (i = 0; i < a.n; i++) { if (a.p[i] != b.p[i]) { return false; }; };
            return true;
        };

        // ---- rebuilding an index from its table ----

        def sq_tc_rebuild_src(SQ_TCTX* tc, SQ_IDX* ix, SQLITE_DB* sdb, int sroot) -> int
        {
            SQLITE_DB* db = tc.db;
            SQ_CURSOR cur;
            SQ_SORTIX so;
            SQ_ARENA ar;
            SQ_VAL* row;
            SQ_VAL[20] key;
            byte* rec;
            byte* nr;
            int* perm;
            int* noff;
            int* nlen;
            int rn, ok, cap, rcap, used, i, rc, k, hasnull, kr;
            row = (SQ_VAL*)fmalloc((u64)(tc.ncols + 2) * (u64)sizeof(SQ_VAL));
            if ((u64)row == (u64)0) { return 1; };
            if (sq_tree_free(db, ix.root, 1, 10, 0) != 0) { ffree((u64)row); return 1; };
            sq_ar_init(@ar);
            cap = 1 << 16;
            rcap = 1024;
            rec = (byte*)fmalloc((u64)cap);
            so.off = (int*)fmalloc((u64)rcap * (u64)4);
            so.len = (int*)fmalloc((u64)rcap * (u64)4);
            if ((u64)rec == (u64)0 | (u64)so.off == (u64)0 | (u64)so.len == (u64)0) { ffree((u64)row); return 1; };
            so.n = 0;
            used = 0;
            sq_cur_open(@cur, sdb, sroot);
            ok = sq_cur_first(@cur);
            while (ok == 1)
            {
                sq_ar_reset(@ar);
                sq_tc_row(tc, @cur, @ar, row);
                kr = sq_tc_ixrow(tc, ix, row, @key[0], @ar);
                if (kr == 2) { sq_cur_close(@cur); ffree((u64)row); return 1; };
                if (kr == 0)
                {
                    ok = sq_cur_next(@cur);
                    continue;
                };
                rn = sq_rec_size(@key[0], ix.nrc);
                if (used + rn + 8 > cap)
                {
                    nr = (byte*)fmalloc((u64)(cap * 2 + rn));
                    if ((u64)nr == (u64)0) { sq_cur_close(@cur); return 1; };
                    for (i = 0; i < used; i++) { nr[i] = rec[i]; };
                    ffree((u64)rec);
                    rec = nr;
                    cap = cap * 2 + rn;
                };
                if (so.n >= rcap)
                {
                    noff = (int*)fmalloc((u64)rcap * (u64)8);
                    nlen = (int*)fmalloc((u64)rcap * (u64)8);
                    if ((u64)noff == (u64)0 | (u64)nlen == (u64)0) { sq_cur_close(@cur); return 1; };
                    for (i = 0; i < so.n; i++) { noff[i] = so.off[i]; nlen[i] = so.len[i]; };
                    ffree((u64)so.off); ffree((u64)so.len);
                    so.off = noff; so.len = nlen;
                    rcap = rcap * 2;
                };
                sq_rec_write(@key[0], ix.nrc, @rec[used]);
                so.off[so.n] = used;
                so.len[so.n] = rn;
                so.n++;
                used = used + rn;
                ok = sq_cur_next(@cur);
            };
            sq_cur_close(@cur);
            sq_ar_free(@ar);
            ffree((u64)row);
            if (ok < 0) { return 1; };
            so.ix = ix;
            so.recs = rec;
            perm = (int*)fmalloc((u64)(so.n + 1) * (u64)4);
            if ((u64)perm == (u64)0) { return 1; };
            if (sq_sortix_run(@so, perm) != 0) { return 1; };
            // unique indexes must not hold equal non-NULL keys
            if (ix.unique == 1)
            {
                for (i = 1; i < so.n; i++)
                {
                    k = sq_rec_decode_w(@rec[so.off[perm[i - 1]]], so.len[perm[i - 1]], @so.va[0], 18, 0);
                    rc = sq_rec_decode_w(@rec[so.off[perm[i]]], so.len[perm[i]], @so.vb[0], 18, 1);
                    hasnull = 0;
                    for (k = 0; k < ix.nk; k++) { if (so.va[k].t == SQ_NULL) { hasnull = 1; }; };
                    if (hasnull == 0)
                    {
                        if (sq_icmp(ix, @so.va[0], ix.nk, @so.vb[0], ix.nk) == 0)
                        {
                            ffree((u64)perm); ffree((u64)rec); ffree((u64)so.off); ffree((u64)so.len);
                            return 4;
                        };
                    };
                };
            };
            rc = sq_ix_bulk(db, ix, @so, perm);
            ffree((u64)perm); ffree((u64)rec); ffree((u64)so.off); ffree((u64)so.len);
            return rc;
        };

        def sq_tc_rebuild(SQ_TCTX* tc, SQ_IDX* ix) -> int
        {
            return sq_tc_rebuild_src(tc, ix, tc.db, tc.root);
        };

        // ---- sqlite_master ----

        // appends a row to sqlite_master
        def sq_master_add(SQLITE_DB* db, byte* type, byte* name, byte* tbl, int rootpage, byte* sql) -> int
        {
            SQ_VAL[5] vals;
            byte* rec;
            int size, rc;
            i64 mx;
            vals[0].t = SQ_TEXT; vals[0].p = type; vals[0].n = sq_cstrlen(type); vals[0].i = (i64)0; vals[0].r = 0.0;
            vals[1].t = SQ_TEXT; vals[1].p = name; vals[1].n = sq_cstrlen(name); vals[1].i = (i64)0; vals[1].r = 0.0;
            vals[2].t = SQ_TEXT; vals[2].p = tbl; vals[2].n = sq_cstrlen(tbl); vals[2].i = (i64)0; vals[2].r = 0.0;
            sq_val_int(@vals[3], (i64)rootpage);
            if ((u64)sql == (u64)0) { sq_val_null(@vals[4]); }
            else { vals[4].t = SQ_TEXT; vals[4].p = sql; vals[4].n = sq_cstrlen(sql); vals[4].i = (i64)0; vals[4].r = 0.0; };
            size = sq_rec_size(@vals[0], 5);
            rec = (byte*)fmalloc((u64)(size + 8));
            if ((u64)rec == (u64)0) { return 1; };
            sq_rec_write(@vals[0], 5, rec);
            if (sq_max_rowid(db, 1, @mx) != 0) { ffree((u64)rec); return 1; };
            rc = sq_btree_insert(db, 1, mx + (i64)1, rec, size);
            ffree((u64)rec);
            if (rc != 0) { return 1; };
            db.cookie = db.cookie + 1;
            return 0;
        };

        // rowid of the sqlite_master row with the given name and type (-1 when absent)
        def sq_master_find(SQLITE_DB* db, byte* name, int nl, byte* type) -> i64
        {
            SQ_CURSOR cur;
            byte[160] t;
            byte[16] ty;
            int ok, ln;
            i64 rid;
            rid = (i64)0 - (i64)1;
            sq_cur_open(@cur, db, 1);
            ok = sq_cur_first(@cur);
            while (ok == 1)
            {
                if (sq_col_count(@cur) >= 5)
                {
                    sq_col_text(@cur, 1, @t[0], 160);
                    sq_col_text(@cur, 0, @ty[0], 16);
                    if (sq_name_is(name, nl, @t[0]) & sq_streq(@ty[0], type)) { rid = cur.rowid; break; };
                };
                ok = sq_cur_next(@cur);
            };
            sq_cur_close(@cur);
            return rid;
        };

        // rewrites one sqlite_master row (same rowid) with new values
        def sq_master_replace(SQLITE_DB* db, i64 rowid, byte* type, byte* name, byte* tbl, int rootpage, byte* sql) -> int
        {
            if (sq_btree_delete(db, 1, rowid) != 0) { return 1; };
            SQ_VAL[5] vals;
            byte* rec;
            int size, rc;
            vals[0].t = SQ_TEXT; vals[0].p = type; vals[0].n = sq_cstrlen(type); vals[0].i = (i64)0; vals[0].r = 0.0;
            vals[1].t = SQ_TEXT; vals[1].p = name; vals[1].n = sq_cstrlen(name); vals[1].i = (i64)0; vals[1].r = 0.0;
            vals[2].t = SQ_TEXT; vals[2].p = tbl; vals[2].n = sq_cstrlen(tbl); vals[2].i = (i64)0; vals[2].r = 0.0;
            sq_val_int(@vals[3], (i64)rootpage);
            if ((u64)sql == (u64)0) { sq_val_null(@vals[4]); }
            else { vals[4].t = SQ_TEXT; vals[4].p = sql; vals[4].n = sq_cstrlen(sql); vals[4].i = (i64)0; vals[4].r = 0.0; };
            size = sq_rec_size(@vals[0], 5);
            rec = (byte*)fmalloc((u64)(size + 8));
            if ((u64)rec == (u64)0) { return 1; };
            sq_rec_write(@vals[0], 5, rec);
            rc = sq_btree_insert(db, 1, rowid, rec, size);
            ffree((u64)rec);
            if (rc != 0) { return 1; };
            db.cookie = db.cookie + 1;
            return 0;
        };
        // true when the text contains the keyword outside quotes and parentheses at depth 0 (rough scan for unsupported clauses)
        def sq_find_kw_in(byte* s, int n, byte* kw) -> bool
        {
            int i, m, k, depth;
            byte q;
            m = sq_cstrlen(kw);
            depth = 0;
            i = 0;
            while (i < n)
            {
                if (s[i] == (byte)39 | s[i] == (byte)34 | s[i] == (byte)96)
                {
                    q = s[i];
                    i++;
                    while (i < n & s[i] != q) { i++; };
                    i++;
                    continue;
                };
                if (s[i] == (byte)40) { depth++; };
                if (s[i] == (byte)41) { depth--; };
                if (depth == 0 & i + m <= n)
                {
                    k = 0;
                    while (k < m)
                    {
                        if (sq_lc(s[i + k]) != kw[k]) { break; };
                        k++;
                    };
                    if (k == m)
                    {
                        if (i == 0) { return true; };
                        if (sq_isalpha(s[i - 1]) == false & sq_isdigit(s[i - 1]) == false) { return true; };
                    };
                };
                i++;
            };
            return false;
        };


        // ---- CHECK constraints ----

        struct SQ_CHK
        {
            SQ_STMT* st;
            int n;
            int[40] cs, cl;
        };

        def sq_chk_open(SQ_TCTX* tc, SQ_CHK* chk) -> int
        {
            SQ_TI* ti = tc.ti;
            SQ_SB sb;
            int c, i, rc;
            chk.st = (SQ_STMT*)0;
            chk.n = 0;
            for (c = 0; c < tc.ncols; c++)
            {
                if (ti.chl[c] > 0 & chk.n < 40) { chk.cs[chk.n] = ti.chs[c]; chk.cl[chk.n] = ti.chl[c]; chk.n++; };
            };
            for (i = 0; i < ti.nchk; i++)
            {
                if (chk.n < 40) { chk.cs[chk.n] = ti.ks[i]; chk.cl[chk.n] = ti.kl[i]; chk.n++; };
            };
            if (chk.n == 0) { return 0; };
            if (tc.ncols > 60) { sq_seterr(tc.st, "CHECK constraints on tables with more than 60 columns are not supported\0"); return 1; };
            sq_sb_init(@sb);
            sq_sb_lit(@sb, "select \0");
            for (i = 0; i < chk.n; i++)
            {
                if (i > 0) { sq_sb_lit(@sb, ", \0"); };
                sq_sb_lit(@sb, "(\0");
                sq_sb_add(@sb, @ti.base[chk.cs[i]], chk.cl[i]);
                sq_sb_lit(@sb, ")\0");
            };
            sq_sb_lit(@sb, " from (select \0");
            for (c = 0; c < tc.ncols; c++)
            {
                if (c > 0) { sq_sb_lit(@sb, ", \0"); };
                sq_sb_lit(@sb, "?\0");
                sq_sb_int(@sb, (i64)(c + 1));
                sq_sb_lit(@sb, " as \0");
                sq_sb_ident(@sb, @ti.base[ti.cs[c]], ti.cl[c]);
            };
            sq_sb_lit(@sb, ")\0");
            if (sb.err != 0) { sq_sb_free(@sb); return 1; };
            chk.st = sq_stmt_new();
            if ((u64)chk.st == (u64)0) { sq_sb_free(@sb); return 1; };
            rc = sq_prep_query(chk.st, tc.db, sb.p);
            sq_sb_free(@sb);
            if (rc != 0)
            {
                sq_seterr(tc.st, @chk.st.err[0]);
                sq_stmt_del(chk.st);
                chk.st = (SQ_STMT*)0;
                return 1;
            };
            return 0;
        };

        def sq_chk_close(SQ_CHK* chk) -> void
        {
            if ((u64)chk.st != (u64)0) { sq_stmt_del(chk.st); chk.st = (SQ_STMT*)0; };
        };

        // 0 when every CHECK holds (NULL counts as holding), 1 on a failure (message set)
        def sq_chk_run(SQ_TCTX* tc, SQ_CHK* chk, SQ_VAL* vals) -> int
        {
            SQ_VAL* v;
            int c, i, r;
            SQ_SB sb;
            if ((u64)chk.st == (u64)0) { return 0; };
            sq_reset(chk.st);
            sq_params_reset(chk.st);
            for (c = 0; c < tc.ncols; c++)
            {
                v = @vals[c];
                if (v.t == SQ_NULL) { sq_bind_null(chk.st, c + 1); };
                if (v.t == SQ_INTEGER) { sq_bind_int(chk.st, c + 1, v.i); };
                if (v.t == SQ_REAL) { sq_bind_real(chk.st, c + 1, v.r); };
                if (v.t == SQ_TEXT) { sq_bind_text(chk.st, c + 1, v.p, v.n); };
                if (v.t == SQ_BLOB) { sq_bind_blob(chk.st, c + 1, v.p, v.n); };
            };
            r = sq_step_query(chk.st);
            if (r != 1) { sq_seterr(tc.st, @chk.st.err[0]); if (chk.st.err[0] == (byte)0) { sq_seterr(tc.st, "CHECK evaluation failed\0"); }; return 1; };
            for (i = 0; i < chk.n; i++)
            {
                if (sq_truth(sq_cell(chk.st, i)) == 0)
                {
                    sq_sb_init(@sb);
                    sq_sb_lit(@sb, "CHECK constraint failed: \0");
                    sq_sb_add(@sb, @tc.ti.base[chk.cs[i]], chk.cl[i]);
                    sq_seterr(tc.st, sb.p);
                    sq_sb_free(@sb);
                    return 1;
                };
            };
            return 0;
        };

        // ---- WITHOUT ROWID tables ----
        // The table is an index b-tree keyed by the PRIMARY KEY. Rows are identified by a number handed out from a small
        // ring that keeps copies of the key values, so the rowid based statement code works unchanged.

        // record order of the values of a row
        def sq_wor_vals(SQ_TCTX* tc, SQ_VAL* vals, SQ_VAL* cv) -> void
        {
            int c;
            for (c = 0; c < tc.ncols; c++)
            {
                if (tc.ti.ri[c] >= 0) { sq_val_copy(@cv[tc.ti.ri[c]], @vals[c]); };
            };
        };

        def sq_wor_tick(SQ_TCTX* tc) -> void
        {
            if (tc.wn >= 40) { sq_ar_reset(@tc.wa); tc.wn = 0; };
        };

        // remembers the key of a row and returns its number
        def sq_wor_reg(SQ_TCTX* tc, SQ_VAL* vals) -> i64
        {
            int slot, g;
            SQ_VAL* k;
            byte* p;
            tc.wser = tc.wser + (i64)1;
            slot = (int)(tc.wser % (i64)64);
            for (g = 0; g < tc.ti.npk; g++)
            {
                k = @tc.wkv[slot * 16 + g];
                sq_val_copy(k, @vals[tc.ti.pkc[g]]);
                if ((k.t == SQ_TEXT | k.t == SQ_BLOB) & k.n > 0)
                {
                    p = sq_ar_copy(@tc.wa, k.p, k.n);
                    if ((u64)p != (u64)0) { k.p = p; };
                };
            };
            tc.wn++;
            return tc.wser;
        };

        def sq_wor_key(SQ_TCTX* tc, i64 rid) -> SQ_VAL*
        {
            if (rid <= (i64)0 | tc.wser - rid >= (i64)60) { return (SQ_VAL*)0; };
            return @tc.wkv[(int)(rid % (i64)64) * 16];
        };

        def sq_wor_same(SQ_TCTX* tc, i64 a, i64 b) -> bool
        {
            SQ_VAL* ka;
            SQ_VAL* kb;
            ka = sq_wor_key(tc, a);
            kb = sq_wor_key(tc, b);
            if ((u64)ka == (u64)0 | (u64)kb == (u64)0) { return false; };
            return sq_icmp(@tc.wix, ka, tc.ti.npk, kb, tc.ti.npk) == 0;
        };

        // number for the table row that a secondary index entry points to: its key columns come from the index entry
        def sq_wor_ix_other(SQ_TCTX* tc, SQ_IDX* ix, SQ_ICUR* cu) -> i64
        {
            SQ_VAL[130] tmp;
            int g, j, src;
            for (g = 0; g < tc.ti.npk; g++)
            {
                src = 0 - 1;
                for (j = 0; j < ix.ntl; j++) { if (ix.tlc[j] == tc.ti.pkc[g]) { src = ix.nk + j; }; };
                if (src < 0)
                {
                    for (j = 0; j < ix.nk; j++) { if (ix.isx[j] == 0 & ix.col[j] == tc.ti.pkc[g]) { src = j; }; };
                };
                if (src < 0) { sq_val_null(@tmp[tc.ti.pkc[g]]); }
                else { sq_val_copy(@tmp[tc.ti.pkc[g]], @cu.v[src]); };
            };
            return sq_wor_reg(tc, @tmp[0]);
        };

        // finds the row with the key values; vals receives it when not null. 1 found, 0 absent, -1 error.
        def sq_wor_find(SQ_TCTX* tc, SQ_VAL* key, SQ_ARENA* ar, SQ_VAL* vals) -> int
        {
            SQ_ICUR c;
            SQ_CURSOR cur;
            int r, found;
            sq_icur_open(@c, tc.db, @tc.wix);
            r = sq_icur_seek(@c, key, tc.ti.npk, 0);
            if (r < 0) { sq_icur_close(@c); return 0 - 1; };
            found = 0;
            if (r == 1)
            {
                if (sq_icmp(@tc.wix, @c.v[0], c.nv, key, tc.ti.npk) == 0) { found = 1; };
            };
            if (found == 1 & (u64)vals != (u64)0)
            {
                sq_cur_open(@cur, tc.db, tc.root);
                if (sq_payload_reserve(@cur, c.plen + 8) != 0) { sq_icur_close(@c); return 0 - 1; };
                sq_mcpy(cur.payload, c.pay, c.plen);
                cur.plen = c.plen;
                if (sq_parse_record(@cur) != 0) { sq_cur_close(@cur); sq_icur_close(@c); return 0 - 1; };
                cur.rowid = (i64)0;
                sq_tc_row(tc, @cur, ar, vals);
                sq_cur_close(@cur);
            };
            sq_icur_close(@c);
            return found;
        };

        // rewrites the table b-tree from its remaining rows (used when a delete would empty a page); skip is the key to drop
        def sq_wor_rebuild(SQ_TCTX* tc, SQ_VAL* skip, int dropri) -> int
        {
            SQLITE_DB* db = tc.db;
            SQ_CURSOR cur;
            SQ_SORTIX so;
            SQ_VAL[18] kv;
            SQ_VAL[130] rv;
            SQ_VAL[130] nv;
            byte* rec;
            byte* nr;
            int* perm;
            int* noff;
            int* nlen;
            int ok, cap, rcap, used, i, rc, nk, m, rn, rl;
            cap = 1 << 16;
            rcap = 1024;
            rec = (byte*)fmalloc((u64)cap);
            so.off = (int*)fmalloc((u64)rcap * (u64)4);
            so.len = (int*)fmalloc((u64)rcap * (u64)4);
            if ((u64)rec == (u64)0 | (u64)so.off == (u64)0 | (u64)so.len == (u64)0) { return 1; };
            so.n = 0;
            used = 0;
            sq_cur_open(@cur, db, tc.root);
            ok = sq_cur_first(@cur);
            while (ok == 1)
            {
                nk = 0;
                if ((u64)skip != (u64)0)
                {
                    sq_rec_decode_w(cur.payload, cur.plen, @kv[0], 18, 2);
                    if (sq_icmp(@tc.wix, @kv[0], tc.ti.npk, skip, tc.ti.npk) == 0) { nk = 1; };
                };
                if (nk == 1) { ok = sq_cur_next(@cur); continue; };
                if (used + cur.plen + 24 > cap)
                {
                    nr = (byte*)fmalloc((u64)(cap * 2 + cur.plen + 24));
                    if ((u64)nr == (u64)0) { sq_cur_close(@cur); return 1; };
                    for (i = 0; i < used; i++) { nr[i] = rec[i]; };
                    ffree((u64)rec);
                    rec = nr;
                    cap = cap * 2 + cur.plen + 24;
                };
                if (so.n >= rcap)
                {
                    noff = (int*)fmalloc((u64)rcap * (u64)8);
                    nlen = (int*)fmalloc((u64)rcap * (u64)8);
                    if ((u64)noff == (u64)0 | (u64)nlen == (u64)0) { sq_cur_close(@cur); return 1; };
                    for (i = 0; i < so.n; i++) { noff[i] = so.off[i]; nlen[i] = so.len[i]; };
                    ffree((u64)so.off); ffree((u64)so.len);
                    so.off = noff; so.len = nlen;
                    rcap = rcap * 2;
                };
                rl = cur.plen;
                m = 0;
                if (dropri >= 0) { m = sq_rec_decode_w(cur.payload, cur.plen, @rv[0], 128, 3); };
                if (dropri >= 0 & m > dropri)
                {
                    rn = 0;
                    for (i = 0; i < m; i++)
                    {
                        if (i == dropri) { continue; };
                        sq_val_copy(@nv[rn], @rv[i]);
                        rn++;
                    };
                    rl = sq_rec_size(@nv[0], rn);
                    sq_rec_write(@nv[0], rn, @rec[used]);
                }
                else
                {
                    for (i = 0; i < cur.plen; i++) { rec[used + i] = cur.payload[i]; };
                };
                so.off[so.n] = used;
                so.len[so.n] = rl;
                so.n++;
                used = used + rl;
                ok = sq_cur_next(@cur);
            };
            sq_cur_close(@cur);
            if (ok < 0) { return 1; };
            if (sq_tree_free(db, tc.root, 1, 10, 0) != 0) { return 1; };
            so.ix = @tc.wix;
            so.recs = rec;
            perm = (int*)fmalloc((u64)(so.n + 1) * (u64)4);
            if ((u64)perm == (u64)0) { return 1; };
            for (i = 0; i < so.n; i++) { perm[i] = i; };
            rc = sq_ix_bulk(db, @tc.wix, @so, perm);
            ffree((u64)perm); ffree((u64)rec); ffree((u64)so.off); ffree((u64)so.len);
            return rc;
        };

        // ---- row level operations ----

        // loads the row with the given rowid into vals (text owned by ar). 1 found, 0 absent, -1 error.
        def sq_tc_fetch(SQ_TCTX* tc, i64 rowid, SQ_ARENA* ar, SQ_VAL* vals) -> int
        {
            SQ_CURSOR cur;
            int r;
            if (tc.wor == 1)
            {
                if ((u64)sq_wor_key(tc, rowid) == (u64)0) { return 0 - 1; };
                r = sq_wor_find(tc, sq_wor_key(tc, rowid), ar, vals);
                if (r == 1) { sq_val_int(@vals[tc.ncols], rowid); };
                return r;
            };
            sq_cur_open(@cur, tc.db, tc.root);
            r = sq_cur_seek(@cur, rowid);
            if (r == 1) { sq_tc_row(tc, @cur, ar, vals); };
            sq_cur_close(@cur);
            return r;
        };

        def sq_tc_exists(SQ_TCTX* tc, i64 rowid) -> int
        {
            SQ_CURSOR cur;
            int r;
            if (tc.wor == 1)
            {
                if ((u64)sq_wor_key(tc, rowid) == (u64)0) { return 0 - 1; };
                return sq_wor_find(tc, sq_wor_key(tc, rowid), (SQ_ARENA*)0, (SQ_VAL*)0);
            };
            sq_cur_open(@cur, tc.db, tc.root);
            r = sq_cur_seek(@cur, rowid);
            sq_cur_close(@cur);
            return r;
        };

        // brings a dirty index back in step with the table
        def sq_tc_clean(SQ_TCTX* tc, int i) -> int
        {
            int rc;
            if (tc.dirty[i] == 0) { return 0; };
            rc = sq_tc_rebuild(tc, @tc.ix[i]);
            if (rc != 0) { return 1; };
            tc.dirty[i] = 0;
            return 0;
        };

        // removes a row (given by its current values) from the indexes and the table
        def sq_tc_remove(SQ_TCTX* tc, i64 rowid, SQ_VAL* vals) -> int
        {
            int i, r;
            for (i = tc.nix - 1; i >= 0; i--)
            {
                if (tc.dirty[i] == 1) { continue; };
                r = sq_tc_ixrow(tc, @tc.ix[i], vals, @tc.kv[0], @tc.ar);
                if (r == 2) { return 1; };
                if (r == 0) { continue; };
                r = sq_ix_delete(tc.db, @tc.ix[i], @tc.kv[0]);
                if (r == 3) { tc.dirty[i] = 1; continue; };
                if (r == 2) { sq_seterr(tc.st, "index maintenance failed\0"); return 1; };
            };
            if (tc.wor == 1)
            {
                SQ_VAL[128] cv;
                sq_wor_vals(tc, vals, @cv[0]);
                r = sq_ix_delete(tc.db, @tc.wix, @cv[0]);
                if (r == 3)
                {
                    if (sq_wor_rebuild(tc, @cv[0], 0 - 1) != 0) { sq_seterr(tc.st, "table delete failed\0"); return 1; };
                    return 0;
                };
                if (r == 2 | r == 4) { sq_seterr(tc.st, "table delete failed\0"); return 1; };
                return 0;
            };
            r = sq_btree_delete(tc.db, tc.root, rowid);
            if (r == 2) { sq_seterr(tc.st, "table delete failed\0"); return 1; };
            return 0;
        };

        def sq_fk_delete(SQ_STMT* st, SQ_TCTX* tc, SQ_VAL* old, i64 rid) -> int;

        // deletes the row with the given rowid (REPLACE conflict resolution); foreign keys see it as a delete
        def sq_tc_remove_id(SQ_TCTX* tc, i64 rowid) -> int
        {
            SQ_VAL* vals;
            SQ_ARENA ar;
            int r, rc;
            vals = (SQ_VAL*)fmalloc((u64)(tc.ncols + 2) * (u64)sizeof(SQ_VAL));
            if ((u64)vals == (u64)0) { return 1; };
            sq_ar_init(@ar);
            r = sq_tc_fetch(tc, rowid, @ar, vals);
            rc = 0;
            if (r == 1)
            {
                if (sq_fk_delete(tc.st, tc, vals, rowid) != 0) { rc = 1; }
                else { rc = sq_tc_remove(tc, rowid, vals); };
            };
            if (r < 0) { rc = 1; };
            sq_ar_free(@ar);
            ffree((u64)vals);
            return rc;
        };

        // REPLACE over an existing rowid / key without triggers: only the index entries of the old row are removed (newest
        // index first); the table entry is replaced by the insert that follows.
        def sq_tc_remove_ix_only(SQ_TCTX* tc, i64 rowid) -> int
        {
            SQ_VAL* vals;
            SQ_ARENA ar;
            int r, rc, i;
            vals = (SQ_VAL*)fmalloc((u64)(tc.ncols + 2) * (u64)sizeof(SQ_VAL));
            if ((u64)vals == (u64)0) { return 1; };
            sq_ar_init(@ar);
            r = sq_tc_fetch(tc, rowid, @ar, vals);
            rc = 0;
            if (r == 1)
            {
                if (sq_fk_delete(tc.st, tc, vals, rowid) != 0) { rc = 1; }
                else
                {
                    for (i = tc.nix - 1; i >= 0; i--)
                    {
                        if (tc.dirty[i] == 1) { continue; };
                        r = sq_tc_ixrow(tc, @tc.ix[i], vals, @tc.kv[0], @tc.ar);
                        if (r == 2) { rc = 1; break; };
                        if (r == 0) { continue; };
                        r = sq_ix_delete(tc.db, @tc.ix[i], @tc.kv[0]);
                        if (r == 2) { sq_seterr(tc.st, "index maintenance failed\0"); rc = 1; break; };
                    };
                    if (rc == 0)
                    {
                        if (tc.wor == 1 & tc.nix > 0)
                        {
                            SQ_VAL[128] cv;
                            sq_wor_vals(tc, vals, @cv[0]);
                            r = sq_ix_delete(tc.db, @tc.wix, @cv[0]);
                            if (r == 2 | r == 3 | r == 4) { sq_seterr(tc.st, "table delete failed\0"); rc = 1; };
                        }
                        else
                        {
                            tc.repl = 1;
                            tc.replr = rowid;
                        };
                    };
                };
            };
            if (r < 0) { rc = 1; };
            sq_ar_free(@ar);
            ffree((u64)vals);
            return rc;
        };

        // writes a new row into the table and the indexes
        def sq_tc_put(SQ_TCTX* tc, i64 rowid, SQ_VAL* vals) -> int
        {
            byte* rec;
            int rn, i, r;
            // SQLite writes the entries of the indexes (newest index first) and the table row last
            for (i = tc.nix - 1; i >= 0; i--)
            {
                if (tc.dirty[i] == 1) { continue; };
                r = sq_tc_ixrow(tc, @tc.ix[i], vals, @tc.kv[0], @tc.ar);
                if (r == 2) { return 1; };
                if (r == 0) { continue; };
                r = sq_ix_insert(tc.db, @tc.ix[i], @tc.kv[0]);
                if (r != 0) { sq_seterr(tc.st, "index insert failed\0"); return 1; };
            };
            if (tc.wor == 1)
            {
                SQ_VAL[128] cv;
                sq_wor_vals(tc, vals, @cv[0]);
                if (tc.repl == 1) { r = sq_ix_replace(tc.db, @tc.wix, @cv[0]); }
                else { r = sq_ix_insert(tc.db, @tc.wix, @cv[0]); };
                tc.repl = 0;
                if (r != 0) { sq_seterr(tc.st, "table insert failed\0"); return 1; };
            }
            else
            {
                if (sq_tc_record(tc, vals, @rec, @rn) != 0) { sq_seterr(tc.st, "out of memory\0"); return 1; };
                if (tc.repl == 1 & tc.replr == rowid) { r = sq_btree_replace(tc.db, tc.root, rowid, rec, rn); }
                else { r = sq_btree_insert(tc.db, tc.root, rowid, rec, rn); };
                tc.repl = 0;
                ffree((u64)rec);
                if (r != 0) { sq_seterr(tc.st, "table insert failed\0"); return 1; };
            };
            return 0;
        };

        // true when the index entry has to be rewritten by an UPDATE of the given columns
        def sq_tc_ix_affected(SQ_TCTX* tc, SQ_IDX* ix, int* scol, int nset, int chng) -> bool
        {
            int j, k;
            if (chng == 1) { return true; };
            if (ix.partial != 0 | ix.ne > 0) { return true; };
            for (j = 0; j < nset; j++)
            {
                for (k = 0; k < ix.nk; k++) { if (ix.col[k] == scol[j]) { return true; }; };
                if (tc.wor == 1)
                {
                    for (k = 0; k < tc.wix.nk; k++) { if (tc.wix.col[k] == scol[j]) { return true; }; };
                };
            };
            return false;
        };

        // Rewrites a row as SQLite's UPDATE does: the entries of the affected indexes are deleted (newest index first), a
        // changed key deletes the old table row, the new index entries are inserted and the row is written last.
        def sq_tc_update(SQ_TCTX* tc, i64 rowid, i64 newrid, SQ_VAL* ol, SQ_VAL* nw, int* scol, int nset) -> int
        {
            byte* rec;
            int rn, i, r, chng;
            int[20] aff;
            chng = 0;
            if (newrid != rowid) { chng = 1; };
            if (tc.wor == 1)
            {
                chng = 0;
                for (i = 0; i < nset; i++)
                {
                    for (r = 0; r < tc.wix.nk; r++) { if (tc.wix.col[r] == scol[i]) { chng = 1; }; };
                };
            };
            for (i = 0; i < tc.nix; i++)
            {
                aff[i] = 0;
                if (sq_tc_ix_affected(tc, @tc.ix[i], scol, nset, chng)) { aff[i] = 1; };
            };
            for (i = tc.nix - 1; i >= 0; i--)
            {
                if (aff[i] == 0 | tc.dirty[i] == 1) { continue; };
                r = sq_tc_ixrow(tc, @tc.ix[i], ol, @tc.kv[0], @tc.ar);
                if (r == 2) { return 1; };
                if (r == 0) { continue; };
                r = sq_ix_delete(tc.db, @tc.ix[i], @tc.kv[0]);
                if (r != 0) { sq_seterr(tc.st, "index maintenance failed\0"); return 1; };
            };
            if (tc.wor == 1)
            {
                SQ_VAL[128] cv;
                if (chng == 1)
                {
                    sq_wor_vals(tc, ol, @cv[0]);
                    r = sq_ix_delete(tc.db, @tc.wix, @cv[0]);
                    if (r != 0) { sq_seterr(tc.st, "table delete failed\0"); return 1; };
                };
            }
            else
            {
                if (chng == 1)
                {
                    r = sq_btree_delete(tc.db, tc.root, rowid);
                    if (r == 2) { sq_seterr(tc.st, "table delete failed\0"); return 1; };
                };
            };
            for (i = tc.nix - 1; i >= 0; i--)
            {
                if (aff[i] == 0 | tc.dirty[i] == 1) { continue; };
                r = sq_tc_ixrow(tc, @tc.ix[i], nw, @tc.kv[0], @tc.ar);
                if (r == 2) { return 1; };
                if (r == 0) { continue; };
                r = sq_ix_insert(tc.db, @tc.ix[i], @tc.kv[0]);
                if (r != 0) { sq_seterr(tc.st, "index insert failed\0"); return 1; };
            };
            if (tc.wor == 1)
            {
                SQ_VAL[128] cv;
                sq_wor_vals(tc, nw, @cv[0]);
                if (chng == 1 & tc.repl == 0) { r = sq_ix_insert(tc.db, @tc.wix, @cv[0]); }
                else { r = sq_ix_replace(tc.db, @tc.wix, @cv[0]); };
                tc.repl = 0;
                if (r != 0) { sq_seterr(tc.st, "table insert failed\0"); return 1; };
                return 0;
            };
            if (sq_tc_record(tc, nw, @rec, @rn) != 0) { sq_seterr(tc.st, "out of memory\0"); return 1; };
            if (chng == 1 & tc.repl == 0) { r = sq_btree_insert(tc.db, tc.root, newrid, rec, rn); }
            else { r = sq_btree_replace(tc.db, tc.root, newrid, rec, rn); };
            tc.repl = 0;
            ffree((u64)rec);
            if (r != 0) { sq_seterr(tc.st, "table insert failed\0"); return 1; };
            return 0;
        };

        // builds "UNIQUE constraint failed: t.a, t.b"
        def sq_err_unique(SQ_TCTX* tc, SQ_IDX* ix, int isrowid) -> void
        {
            SQ_SB sb;
            int k, c;
            sq_sb_init(@sb);
            if (isrowid == 0)
            {
                if (ix.ne > 0)
                {
                    sq_sb_lit(@sb, "UNIQUE constraint failed: index '\0");
                    sq_sb_lit(@sb, @ix.name[0]);
                    sq_sb_lit(@sb, "'\0");
                    sq_seterr(tc.st, sb.p);
                    sq_sb_free(@sb);
                    return;
                };
            };
            sq_sb_lit(@sb, "UNIQUE constraint failed: \0");
            if (isrowid == 1 & tc.wor == 1)
            {
                for (k = 0; k < tc.ti.npk; k++)
                {
                    if (k > 0) { sq_sb_lit(@sb, ", \0"); };
                    sq_sb_lit(@sb, @tc.tname[0]);
                    sq_sb_lit(@sb, ".\0");
                    c = tc.ti.pkc[k];
                    sq_sb_add(@sb, @tc.ti.base[tc.ti.cs[c]], tc.ti.cl[c]);
                };
            }
            else {
            if (isrowid == 1)
            {
                sq_sb_lit(@sb, @tc.tname[0]);
                sq_sb_lit(@sb, ".\0");
                if (tc.ti.ipk >= 0) { sq_sb_add(@sb, @tc.ti.base[tc.ti.cs[tc.ti.ipk]], tc.ti.cl[tc.ti.ipk]); }
                else { sq_sb_lit(@sb, "rowid\0"); };
            }
            else
            {
                for (k = 0; k < ix.nk; k++)
                {
                    if (k > 0) { sq_sb_lit(@sb, ", \0"); };
                    sq_sb_lit(@sb, @tc.tname[0]);
                    sq_sb_lit(@sb, ".\0");
                    c = ix.col[k];
                    if (c < tc.ncols) { sq_sb_add(@sb, @tc.ti.base[tc.ti.cs[c]], tc.ti.cl[c]); } else { sq_sb_lit(@sb, "rowid\0"); };
                };
            };
            };
            sq_seterr(tc.st, sb.p);
            sq_sb_free(@sb);
        };

        // Runs the constraint checks for a row about to be stored. own is the rowid of the row being replaced by an UPDATE
        // (hasown 1) so it does not conflict with itself. Returns 0 to go on, 1 on an error, 5 when the row is skipped (IGNORE).
        def sq_tc_check_in(SQ_TCTX* tc, SQ_CHK* chk, SQ_VAL* nw, i64 rowid, int hasown, i64 own, int onconf) -> int
        {
            SQ_TI* ti = tc.ti;
            SQ_ICUR cu;
            SQ_IDX* ix;
            SQ_CURSOR cur;
            SQ_SB sb;
            int c, i, k, r, hasnull;
            i64 other;
            for (c = 0; c < tc.ncols; c++)
            {
                if (c == ti.ipk) { continue; };
                if (nw[c].t == SQ_NULL & ti.notnull[c] == 1)
                {
                    if (onconf == 3) { return 5; };
                    if (onconf == 4 & tc.dv[c].t != SQ_NULL) { sq_val_copy(@nw[c], @tc.dv[c]); continue; };
                    sq_sb_init(@sb);
                    sq_sb_lit(@sb, "NOT NULL constraint failed: \0");
                    sq_sb_lit(@sb, @tc.tname[0]);
                    sq_sb_lit(@sb, ".\0");
                    sq_sb_add(@sb, @ti.base[ti.cs[c]], ti.cl[c]);
                    sq_seterr(tc.st, sb.p);
                    sq_sb_free(@sb);
                    return 1;
                };
            };
            if (chk.n > 0)
            {
                if (sq_chk_run(tc, chk, nw) != 0)
                {
                    if (onconf == 3) { tc.st.err[0] = (byte)0; return 5; };
                    return 1;
                };
            };
            // rowid, or the PRIMARY KEY of a WITHOUT ROWID table
            if (tc.wor == 1)
            {
                SQ_VAL[16] pkv;
                SQ_VAL* ok;
                for (k = 0; k < ti.npk; k++) { sq_val_copy(@pkv[k], @nw[ti.pkc[k]]); };
                r = sq_wor_find(tc, @pkv[0], (SQ_ARENA*)0, (SQ_VAL*)0);
                if (r < 0) { sq_seterr(tc.st, "read error\0"); return 1; };
                if (r == 1 & hasown == 1)
                {
                    ok = sq_wor_key(tc, own);
                    if ((u64)ok != (u64)0) { if (sq_icmp(@tc.wix, ok, ti.npk, @pkv[0], ti.npk) == 0) { r = 0; }; };
                };
                if (r == 1 & tc.ups_skip[22] == 1) { r = 0; };
                if (r == 1)
                {
                    if (onconf == 3) { return 5; };
                    if (onconf == 6) { tc.cf_rid = sq_wor_reg(tc, nw); tc.cf_ix = 0 - 1; return 6; };
                    if (onconf == 4)
                    {
                        if (sq_tc_remove_ix_only(tc, sq_wor_reg(tc, nw)) != 0) { return 1; };
                    }
                    else { sq_err_unique(tc, (SQ_IDX*)0, 1); return 1; };
                };
            };
            if (tc.wor == 0)
            {
            sq_cur_open(@cur, tc.db, tc.root);
            r = sq_cur_seek(@cur, rowid);
            sq_cur_close(@cur);
            if (r < 0) { sq_seterr(tc.st, "read error\0"); return 1; };
            if (r == 1 & tc.ups_skip[22] == 1) { r = 0; };
            if (r == 1)
            {
                if (hasown == 0 | rowid != own)
                {
                    if (onconf == 3) { return 5; };
                    if (onconf == 6) { tc.cf_rid = rowid; tc.cf_ix = 0 - 1; return 6; };
                    if (onconf == 4)
                    {
                        if (sq_tc_remove_ix_only(tc, rowid) != 0) { return 1; };
                    }
                    else { sq_err_unique(tc, (SQ_IDX*)0, 1); return 1; };
                };
            };
            };
            for (i = 0; i < tc.nix; i++)
            {
                ix = @tc.ix[i];
                if (ix.unique == 0) { continue; };
                if (tc.ups_skip[i] == 1) { continue; };
                r = sq_tc_ixrow(tc, ix, nw, @tc.kv[0], @tc.ar);
                if (r == 2) { return 1; };
                if (r == 0) { continue; };
                hasnull = 0;
                for (k = 0; k < ix.nk; k++) { if (tc.kv[k].t == SQ_NULL) { hasnull = 1; }; };
                if (hasnull == 1) { continue; };
                if (sq_tc_clean(tc, i) != 0) { sq_seterr(tc.st, "index rebuild failed\0"); return 1; };
                sq_icur_open(@cu, tc.db, ix);
                r = sq_icur_seek(@cu, @tc.kv[0], ix.nk, 0);
                other = (i64)0 - (i64)1;
                if (r < 0) { sq_icur_close(@cu); sq_seterr(tc.st, "index read error\0"); return 1; };
                if (r == 1)
                {
                    if (sq_icmp(ix, @cu.v[0], cu.nv, @tc.kv[0], ix.nk) == 0)
                    {
                        if (tc.wor == 1) { other = sq_wor_ix_other(tc, ix, @cu); }
                        else { other = sq_icur_rowid(@cu); };
                    };
                };
                sq_icur_close(@cu);
                if (other != (i64)0 - (i64)1)
                {
                    if (hasown == 1 & other == own) { continue; };
                    if (tc.wor == 1 & hasown == 1)
                    {
                        if (sq_wor_same(tc, other, own)) { continue; };
                    };
                    if (onconf == 3) { return 5; };
                    if (onconf == 6) { tc.cf_rid = other; tc.cf_ix = i; return 6; };
                    if (onconf == 4)
                    {
                        if (sq_tc_remove_id(tc, other) != 0) { return 1; };
                        continue;
                    };
                    sq_err_unique(tc, ix, 0);
                    return 1;
                };
            };
            return 0;
        };

        // constraint failures remember the conflict action so the caller can apply ROLLBACK or FAIL semantics
        def sq_tc_check(SQ_TCTX* tc, SQ_CHK* chk, SQ_VAL* nw, i64 rowid, int hasown, i64 own, int onconf) -> int
        {
            int r;
            tc.repl = 0;
            r = sq_tc_check_in(tc, chk, nw, rowid, hasown, own, onconf);
            if (r == 1) { tc.st.pad = onconf; };
            return r;
        };

        // applies the column affinities to a new row
        def sq_tc_affinity(SQ_TCTX* tc, SQ_VAL* nw) -> int
        {
            int c;
            for (c = 0; c < tc.ncols; c++)
            {
                if (c == tc.ti.ipk) { continue; };
                sq_apply_aff(@tc.ar, tc.ti.aff[c], @nw[c]);
            };
            if (tc.ti.ngen > 0)
            {
                if (sq_gen_row(tc.st, tc.ti, @tc.ar, nw, 0) != 0) { return 1; };
            };
            return 0;
        };

        // "cannot INSERT into generated column "x"" / "cannot UPDATE generated column "x""
        def sq_err_gen(SQ_STMT* st, SQ_TI* ti, int c, int isins) -> void
        {
            SQ_SB sb;
            sq_sb_init(@sb);
            if (isins == 1) { sq_sb_lit(@sb, "cannot INSERT into generated column \"\0"); }
            else { sq_sb_lit(@sb, "cannot UPDATE generated column \"\0"); };
            sq_sb_add(@sb, @ti.base[ti.cs[c]], ti.cl[c]);
            sq_sb_lit(@sb, "\"\0");
            sq_seterr(st, sb.p);
            sq_sb_free(@sb);
        };

        // ---- AUTOINCREMENT bookkeeping ----

        // current sqlite_sequence value of the table (0 when there is none); *rowid gets the row's rowid or -1
        def sq_seq_read(SQ_TCTX* tc, i64* rowid) -> i64
        {
            SQ_CURSOR cur;
            byte[160] nm;
            int ok;
            i64 v;
            v = (i64)0;
            *rowid = (i64)0 - (i64)1;
            if (tc.seqroot == 0) { return v; };
            sq_cur_open(@cur, tc.db, tc.seqroot);
            ok = sq_cur_first(@cur);
            while (ok == 1)
            {
                if (sq_col_count(@cur) >= 2)
                {
                    sq_col_text(@cur, 0, @nm[0], 160);
                    if (sq_streq(@nm[0], @tc.tname[0]))
                    {
                        v = sq_col_int(@cur, 1);
                        *rowid = cur.rowid;
                        break;
                    };
                };
                ok = sq_cur_next(@cur);
            };
            sq_cur_close(@cur);
            return v;
        };

        def sq_seq_write(SQ_TCTX* tc, i64 seq) -> int
        {
            SQ_VAL[2] vals;
            byte* rec;
            int rn, r;
            i64 rid, old;
            if (tc.seqroot == 0) { return 0; };
            old = sq_seq_read(tc, @rid);
            vals[0].t = SQ_TEXT; vals[0].p = @tc.tname[0]; vals[0].n = sq_cstrlen(@tc.tname[0]); vals[0].i = (i64)0; vals[0].r = 0.0;
            sq_val_int(@vals[1], seq);
            rn = sq_rec_size(@vals[0], 2);
            rec = (byte*)fmalloc((u64)(rn + 8));
            if ((u64)rec == (u64)0) { return 1; };
            sq_rec_write(@vals[0], 2, rec);
            if (rid >= (i64)0)
            {
                if (sq_btree_delete(tc.db, tc.seqroot, rid) != 0) { ffree((u64)rec); return 1; };
            }
            else
            {
                if (sq_max_rowid(tc.db, tc.seqroot, @rid) != 0) { ffree((u64)rec); return 1; };
                rid = rid + (i64)1;
            };
            r = sq_btree_insert(tc.db, tc.seqroot, rid, rec, rn);
            ffree((u64)rec);
            if (r != 0) { return 1; };
            return 0;
        };

        // ---- statement helpers ----

        // text of the current token as it appears in the statement
        def sq_tok_start(SQ_STMT* st) -> int
        {
            if (st.tk == 4) { return st.ts - 1; };
            if (st.tk == 1 & st.tq == 1) { return st.ts - 1; };
            if (st.tk == 6) { return st.ts - 2; };
            return st.ts;
        };

        // advances over one expression and returns its end offset; stops at a top level comma, an unmatched closing
        // parenthesis, a semicolon, the end, or one of the clause keywords of the statement
        def sq_skip_expr(SQ_STMT* st, int stopkw) -> int
        {
            int depth, e;
            depth = 0;
            e = st.prevend;
            while (st.tk != 0)
            {
                if (st.tk == 5)
                {
                    if (st.tcode == 40) { depth++; };
                    if (st.tcode == 41) { if (depth == 0) { break; }; depth--; };
                    if (st.tcode == 44 & depth == 0) { break; };
                    if (st.tcode == 59 & depth == 0) { break; };
                };
                if (depth == 0 & stopkw == 1)
                {
                    if (sq_is_kw(st, "where\0") | sq_is_kw(st, "from\0") | sq_is_kw(st, "returning\0") | sq_is_kw(st, "order\0") | sq_is_kw(st, "limit\0")) { break; };
                };
                if (depth == 0 & stopkw == 2) { if (sq_is_kw(st, "do\0")) { break; }; };
                if (depth == 0 & stopkw == 3) { if (sq_is_kw(st, "on\0") | sq_is_kw(st, "where\0") | sq_is_kw(st, "returning\0")) { break; }; };
                e = st.tend;
                sq_next(st);
            };
            return e;
        };

        // positions the statement lexer at the start of a text region and reads the first token
        def sq_rewind(SQ_STMT* st, int pos) -> void
        {
            st.pos = pos;
            st.tend = pos;
            st.prevend = pos;
            sq_next(st);
        };

        global int SQ_SPILL = 0;

        // Runs the SELECT in text. The returned statement holds the rows; the caller releases it with sq_stmt_del.
        def sq_run_rows(SQLITE_DB* db, SQ_STMT* owner, byte* text) -> SQ_STMT*
        {
            SQ_STMT* sub;
            int k;
            sub = sq_stmt_new();
            if ((u64)sub == (u64)0) { sq_seterr(owner, "out of memory\0"); return sub; };
            if (sq_prep_query(sub, db, text) != 0)
            {
                sq_seterr(owner, @sub.err[0]);
                sq_stmt_del(sub);
                return (SQ_STMT*)0;
            };
            for (k = 0; k < 64; k++) { sq_val_copy(@sub.pv[k], @owner.pv[k]); };
            sub.state = 0;
            sub.spill = SQ_SPILL;
            if (SQ_SPILL == 1) { for (k = 0; k < 320; k++) { SQ_SPILLP[k] = db.path[k]; if (db.path[k] == (byte)0) { break; }; }; };
            sub.res = sq_run_block(sub, sub.root_blk, 0 - 1);
            if ((u64)sub.res != (u64)0) { if (sq_rs_seal(sub.res) == false) { sq_rs_free(sub.res); sub.res = (SQ_RS*)0; sq_seterr(sub, "write error\0"); }; };
            if ((u64)sub.res == (u64)0)
            {
                sq_seterr(owner, @sub.err[0]);
                sq_stmt_del(sub);
                return (SQ_STMT*)0;
            };
            return sub;
        };

        // ---- RETURNING and upsert support ----

        // position of the first top-level occurrence of the words in kw (single spaces match any run of blanks), or -1
        def sq_find_top(byte* s, int n, byte* kw) -> int
        {
            int i, m, k, j, depth;
            byte q;
            m = sq_cstrlen(kw);
            depth = 0;
            i = 0;
            while (i < n)
            {
                if (s[i] == (byte)39 | s[i] == (byte)34 | s[i] == (byte)96)
                {
                    q = s[i];
                    i++;
                    while (i < n & s[i] != q) { i++; };
                    i++;
                    continue;
                };
                if (s[i] == (byte)45 & i + 1 < n)
                {
                    if (s[i + 1] == (byte)45)
                    {
                        while (i < n & s[i] != (byte)10) { i++; };
                        continue;
                    };
                };
                if (s[i] == (byte)40) { depth++; };
                if (s[i] == (byte)41) { depth--; };
                if (depth == 0)
                {
                    if (i == 0) { j = 1; } else { j = 0; if (sq_isalpha(s[i - 1]) == false & sq_isdigit(s[i - 1]) == false & s[i - 1] != (byte)95) { j = 1; }; };
                    if (j == 1)
                    {
                        k = 0;
                        j = i;
                        while (k < m)
                        {
                            if (kw[k] == (byte)32)
                            {
                                if (j >= n) { break; };
                                if (s[j] != (byte)32 & s[j] != (byte)9 & s[j] != (byte)10 & s[j] != (byte)13) { break; };
                                while (j < n & (s[j] == (byte)32 | s[j] == (byte)9 | s[j] == (byte)10 | s[j] == (byte)13)) { j++; };
                                k++;
                                continue;
                            };
                            if (j >= n) { break; };
                            if (sq_lc(s[j]) != kw[k]) { break; };
                            j++;
                            k++;
                        };
                        if (k == m)
                        {
                            if (j >= n) { return i; };
                            if (sq_isalpha(s[j]) == false & sq_isdigit(s[j]) == false & s[j] != (byte)95) { return i; };
                        };
                    };
                };
                i++;
            };
            return 0 - 1;
        };

        // Splits off a trailing RETURNING clause: st.ret_s / st.ret_e become the span of the returned expression list and the
        // lexer limit moves in front of the clause. Returns the position where the clause began or -1.
        def sq_cut_returning(SQ_STMT* st) -> int
        {
            int e, p;
            e = st.lim;
            while (e > 0)
            {
                if (st.sql[e - 1] == (byte)32 | st.sql[e - 1] == (byte)9 | st.sql[e - 1] == (byte)10 | st.sql[e - 1] == (byte)13 | st.sql[e - 1] == (byte)59) { e--; } else { break; };
            };
            p = sq_find_top(@st.sql[0], e, "returning\0");
            st.ret_s = 0 - 1;
            st.ret_e = 0 - 1;
            if (p < 0) { st.lim = e; return 0 - 1; };
            st.ret_s = p + 9;
            st.ret_e = e;
            st.lim = p;
            return p;
        };

        // Prepares the RETURNING output: the column layout and an empty result. alias is the table alias span or -1.
        def sq_ret_begin(SQ_STMT* st, SQ_TCTX* tc, int as_s, int as_e) -> int
        {
            SQ_SB sb;
            SQ_STMT* sub;
            int nc, rc;
            if (st.ret_s < 0) { return 0; };
            tc.ras = as_s;
            tc.rae = as_e;
            sq_sb_init(@sb);
            sq_sb_lit(@sb, "select \0");
            sq_sb_add(@sb, @st.sql[st.ret_s], st.ret_e - st.ret_s);
            sq_sb_lit(@sb, " from \0");
            sq_sb_ident(@sb, @tc.tname[0], sq_cstrlen(@tc.tname[0]));
            if (as_s >= 0) { sq_sb_lit(@sb, " as \0"); sq_sb_add(@sb, @st.sql[as_s], as_e - as_s); };
            sq_sb_lit(@sb, " where 0\0");
            if (sb.err != 0) { sq_sb_free(@sb); sq_seterr(st, "out of memory\0"); return 1; };
            st.retsql = (byte*)fmalloc((u64)(sq_cstrlen(sb.p) + 8));
            if ((u64)st.retsql == (u64)0) { sq_sb_free(@sb); sq_seterr(st, "out of memory\0"); return 1; };
            sq_mcpy(st.retsql, sb.p, sq_cstrlen(sb.p) + 1);
            sub = sq_stmt_new();
            if ((u64)sub == (u64)0) { sq_sb_free(@sb); sq_seterr(st, "out of memory\0"); return 1; };
            rc = sq_prep_query(sub, st.db, sb.p);
            sq_sb_free(@sb);
            if (rc != 0) { sq_seterr(st, @sub.err[0]); sq_stmt_del(sub); return 1; };
            nc = sub.nres;
            sq_stmt_del(sub);
            st.ret = sq_rs_new(nc, nc);
            if ((u64)st.ret == (u64)0) { sq_seterr(st, "out of memory\0"); return 1; };
            return 0;
        };

        def sq_sb_value(SQ_SB* sb, SQ_VAL* v) -> void;

        // " where <key columns> = <values>" selecting the row that the number stands for (WITHOUT ROWID); qual 1 prefixes the table
        def sq_wor_cond(SQ_SB* sb, SQ_TCTX* tc, i64 rid, int qual) -> int
        {
            SQ_VAL* wk;
            int g;
            wk = sq_wor_key(tc, rid);
            if ((u64)wk == (u64)0) { return 1; };
            sq_sb_lit(sb, " where \0");
            for (g = 0; g < tc.ti.npk; g++)
            {
                if (g > 0) { sq_sb_lit(sb, " and \0"); };
                if (qual == 1) { sq_sb_ident(sb, @tc.tname[0], sq_cstrlen(@tc.tname[0])); sq_sb_lit(sb, ".\0"); };
                sq_sb_ident(sb, @tc.ti.base[tc.ti.cs[tc.ti.pkc[g]]], tc.ti.cl[tc.ti.pkc[g]]);
                sq_sb_lit(sb, " = \0");
                sq_sb_value(sb, @wk[g]);
            };
            return 0;
        };

        // evaluates the RETURNING list for the row as it is right now and appends it to the output
        def sq_tc_note(SQ_TCTX* tc, i64 rid) -> int
        {
            SQ_STMT* st = tc.st;
            SQ_SB sb;
            SQ_STMT* sub;
            SQ_VAL* row;
            SQ_VAL* src;
            int j, c, nc;
            if (st.ret_s < 0) { return 0; };
            nc = st.ret.nc;
            sq_sb_init(@sb);
            sq_sb_lit(@sb, "select \0");
            sq_sb_add(@sb, @st.sql[st.ret_s], st.ret_e - st.ret_s);
            sq_sb_lit(@sb, " from \0");
            sq_sb_ident(@sb, @tc.tname[0], sq_cstrlen(@tc.tname[0]));
            if (tc.ras >= 0) { sq_sb_lit(@sb, " as \0"); sq_sb_add(@sb, @st.sql[tc.ras], tc.rae - tc.ras); };
            if (tc.wor == 1)
            {
                if (sq_wor_cond(@sb, tc, rid, 0) != 0) { sq_sb_free(@sb); sq_seterr(st, "internal error: row not found\0"); return 1; };
            }
            else
            {
                sq_sb_lit(@sb, " where rowid = \0");
                sq_sb_int(@sb, rid);
            };
            if (sb.err != 0) { sq_sb_free(@sb); sq_seterr(st, "out of memory\0"); return 1; };
            sub = sq_run_rows(st.db, st, sb.p);
            sq_sb_free(@sb);
            if ((u64)sub == (u64)0) { return 1; };
            for (j = 0; j < sub.res.n; j++)
            {
                row = sq_rs_row(st.ret);
                if ((u64)row == (u64)0) { sq_stmt_del(sub); sq_seterr(st, "out of memory\0"); return 1; };
                src = @sub.res.d[j * sub.res.nc];
                for (c = 0; c < nc; c++)
                {
                    sq_val_copy(@row[c], @src[c]);
                    sq_val_own(@st.ret.ar, @row[c]);
                };
            };
            sq_stmt_del(sub);
            return 0;
        };

        // ---- upsert clauses ----

        struct SQ_UPS
        {
            int ncl;
            int[4] ntg, action, nset, ws, we;
            int[32] tg, txs, txl;
            int[4] pws, pwl;
            int[64] setc, ses, see;
        };

        // parses "ON CONFLICT ... DO ..." clauses found in the text [pos, end). Returns 0 on success.
        def sq_ups_parse(SQ_STMT* st, SQ_TCTX* tc, SQ_UPS* u, int pos, int end) -> int
        {
            int k, c, es, ee, j, iscol, cts, ctl;
            u.ncl = 0;
            st.pos = pos;
            st.tend = pos;
            st.prevend = pos;
            st.lim = end;
            sq_next(st);
            while (sq_is_kw(st, "on\0"))
            {
                if (u.ncl >= 4) { sq_seterr(st, "too many ON CONFLICT clauses\0"); return 1; };
                k = u.ncl;
                u.ntg[k] = 0; u.nset[k] = 0; u.ws[k] = 0 - 1; u.we[k] = 0 - 1; u.action[k] = 0;
                sq_next(st);
                if (sq_is_kw(st, "conflict\0") == false) { sq_seterr(st, "syntax error in INSERT\0"); return 1; };
                sq_next(st);
                u.pws[k] = 0 - 1; u.pwl[k] = 0;
                if (sq_is_op(st, 40))
                {
                    sq_next(st);
                    while (true)
                    {
                        if (u.ntg[k] >= 8) { sq_seterr(st, "conflict target too long\0"); return 1; };
                        es = sq_tok_start(st);
                        iscol = 0;
                        if (st.tk == 1)
                        {
                            cts = st.ts; ctl = st.tl;
                            sq_next(st);
                            if (sq_is_op(st, 44) | sq_is_op(st, 41)) { iscol = 1; };
                            if (sq_is_kw(st, "collate\0") | sq_is_kw(st, "asc\0") | sq_is_kw(st, "desc\0"))
                            {
                                iscol = 1;
                                while (st.tk != 0 & sq_is_op(st, 44) == false & sq_is_op(st, 41) == false) { sq_next(st); };
                            };
                        };
                        if (iscol == 1)
                        {
                            c = sq_ti_find(tc.ti, @st.sql[0], cts, ctl);
                            if (c < 0)
                            {
                                if (sq_is_rowid_name(@st.sql[cts], ctl) & tc.ti.wor == 0) { c = tc.ti.ipk; if (c < 0) { c = tc.ncols; }; };
                            };
                            if (c < 0) { sq_err_name(st, "no such column: \0", @st.sql[cts], ctl, "\0"); return 1; };
                            u.tg[k * 8 + u.ntg[k]] = c;
                            u.txs[k * 8 + u.ntg[k]] = 0;
                            u.txl[k * 8 + u.ntg[k]] = 0;
                        }
                        else
                        {
                            ee = sq_skip_expr(st, 0);
                            if (ee <= es) { sq_seterr(st, "unsupported conflict target\0"); return 1; };
                            u.tg[k * 8 + u.ntg[k]] = 0 - 1;
                            u.txs[k * 8 + u.ntg[k]] = es;
                            u.txl[k * 8 + u.ntg[k]] = ee - es;
                        };
                        u.ntg[k]++;
                        if (sq_is_op(st, 44)) { sq_next(st); continue; };
                        break;
                    };
                    if (sq_is_op(st, 41) == false) { sq_seterr(st, "expected )\0"); return 1; };
                    sq_next(st);
                    if (sq_is_kw(st, "where\0"))
                    {
                        sq_next(st);
                        es = sq_tok_start(st);
                        ee = sq_skip_expr(st, 2);
                        if (ee <= es) { sq_seterr(st, "expected an expression\0"); return 1; };
                        u.pws[k] = es;
                        u.pwl[k] = ee - es;
                    };
                };
                if (sq_is_kw(st, "do\0") == false) { sq_seterr(st, "expected DO\0"); return 1; };
                sq_next(st);
                if (sq_is_kw(st, "nothing\0")) { sq_next(st); u.action[k] = 0; }
                else
                {
                    if (sq_is_kw(st, "update\0") == false) { sq_seterr(st, "expected NOTHING or UPDATE\0"); return 1; };
                    sq_next(st);
                    if (sq_is_kw(st, "set\0") == false) { sq_seterr(st, "expected SET\0"); return 1; };
                    sq_next(st);
                    u.action[k] = 1;
                    while (true)
                    {
                        if (st.tk != 1) { sq_seterr(st, "expected a column name\0"); return 1; };
                        c = sq_ti_find(tc.ti, @st.sql[0], st.ts, st.tl);
                        if (c < 0)
                        {
                            if (sq_is_rowid_name(@st.sql[st.ts], st.tl) & tc.ti.wor == 0) { c = tc.ti.ipk; if (c < 0) { c = tc.ncols; }; };
                        };
                        if (c < 0) { sq_err_name(st, "no such column: \0", @st.sql[st.ts], st.tl, "\0"); return 1; };
                        if (c < tc.ncols) { if (tc.ti.gen[c] != 0) { sq_err_gen(st, tc.ti, c, 0); return 1; }; };
                        if (u.nset[k] >= 16) { sq_seterr(st, "too many assignments\0"); return 1; };
                        u.setc[k * 16 + u.nset[k]] = c;
                        sq_next(st);
                        if (sq_is_op(st, 61) == false) { sq_seterr(st, "expected =\0"); return 1; };
                        sq_next(st);
                        es = sq_tok_start(st);
                        ee = sq_skip_expr(st, 3);
                        if (ee <= es) { sq_seterr(st, "expected an expression\0"); return 1; };
                        u.ses[k * 16 + u.nset[k]] = es;
                        u.see[k * 16 + u.nset[k]] = ee;
                        u.nset[k]++;
                        if (sq_is_op(st, 44)) { sq_next(st); continue; };
                        break;
                    };
                    if (sq_is_kw(st, "where\0"))
                    {
                        sq_next(st);
                        es = sq_tok_start(st);
                        ee = sq_skip_expr(st, 3);
                        u.ws[k] = es;
                        u.we[k] = ee;
                        while (st.tk != 0 & sq_is_kw(st, "on\0") == false) { sq_next(st); };
                    };
                };
                u.ncl++;
            };
            if (st.tk != 0) { sq_seterr(st, "syntax error in INSERT\0"); return 1; };
            return 0;
        };

        // true when the two texts hold the same tokens (case blind, whitespace blind)
        def sq_xeq(byte* a, int as_, int al, byte* b, int bs, int bl) -> bool
        {
            int pa, pb, ta, la, ka, tb, lb, kb;
            pa = as_; pb = bs;
            while (true)
            {
                pa = sq_tok2(a, pa, as_ + al, @ta, @la, @ka);
                pb = sq_tok2(b, pb, bs + bl, @tb, @lb, @kb);
                if (ka == 0 | kb == 0) { return ka == kb; };
                if (sq_tname_eq(a, ta, la, b, tb, lb) == false) { return false; };
            };
            return false;
        };

        // true when the target of clause k names the constraint cfix (-1: the primary key or rowid)
        def sq_ups_tmatch(SQ_TCTX* tc, SQ_UPS* u, int k, int cfix) -> int
        {
            int a, b, found, same, nuser;
            SQ_IDX* ix;
            byte* isql;
            if (u.ntg[k] == 0) { return 1; };
            if (cfix < 0)
            {
                for (a = 0; a < u.ntg[k]; a++) { if (u.tg[k * 8 + a] < 0) { return 0; }; };
                if (tc.wor == 1)
                {
                    if (u.ntg[k] != tc.ti.npk) { return 0; };
                    for (a = 0; a < u.ntg[k]; a++)
                    {
                        found = 0;
                        for (b = 0; b < tc.ti.npk; b++) { if (tc.ti.pkc[b] == u.tg[k * 8 + a]) { found = 1; }; };
                        if (found == 0) { return 0; };
                    };
                    return 1;
                };
                if (u.ntg[k] != 1) { return 0; };
                if (u.tg[k * 8] == tc.ti.ipk) { return 1; };
                if (tc.ti.ipk < 0 & u.tg[k * 8] == tc.ncols) { return 1; };
                return 0;
            };
            ix = @tc.ix[cfix];
            isql = tc.db.schema[ix.schema_pos].sql;
            nuser = ix.nk;
            if (nuser - 1 == u.ntg[k]) { nuser = nuser - 1; };
            if (nuser != u.ntg[k]) { return 0; };
            if (ix.partial == 1)
            {
                if (u.pwl[k] <= 0) { return 0; };
                if (sq_xeq(@tc.st.sql[0], u.pws[k], u.pwl[k], isql, ix.ws, ix.wl) == false) { return 0; };
            };
            for (a = 0; a < u.ntg[k]; a++)
            {
                found = 0;
                for (b = 0; b < nuser; b++)
                {
                    if (u.tg[k * 8 + a] >= 0)
                    {
                        if (ix.isx[b] == 0 & ix.col[b] == u.tg[k * 8 + a]) { found = 1; };
                    }
                    else
                    {
                        if (ix.isx[b] == 1)
                        {
                            if (sq_xeq(@tc.st.sql[0], u.txs[k * 8 + a], u.txl[k * 8 + a], isql, ix.xs[b], ix.xl[b])) { found = 1; };
                        };
                    };
                };
                if (found == 0) { return 0; };
            };
            return 1;
        };

        // the clause that applies to the violated constraint, or -1
        def sq_ups_match(SQ_TCTX* tc, SQ_UPS* u, int cfix) -> int
        {
            int k;
            for (k = 0; k < u.ncl; k++)
            {
                if (sq_ups_tmatch(tc, u, k, cfix) == 1) { return k; };
            };
            return 0 - 1;
        };

        // every conflict target has to name a PRIMARY KEY or a unique index. Returns 1 after setting the error.
        def sq_ups_check(SQ_STMT* st, SQ_TCTX* tc, SQ_UPS* u) -> int
        {
            int k, i, ok;
            for (k = 0; k < u.ncl; k++)
            {
                if (u.ntg[k] == 0) { continue; };
                ok = sq_ups_tmatch(tc, u, k, 0 - 1);
                for (i = 0; i < tc.nix; i++)
                {
                    if (ok == 1) { break; };
                    if (tc.ix[i].unique == 1) { ok = sq_ups_tmatch(tc, u, k, i); };
                };
                if (ok == 0) { sq_seterr(st, "ON CONFLICT clause does not match any PRIMARY KEY or UNIQUE constraint\0"); return 1; };
            };
            return 0;
        };

        // SQL literal for a value
        def sq_sb_value(SQ_SB* sb, SQ_VAL* v) -> void
        {
            byte[64] t;
            int i, n;
            byte* hx;
            if (v.t == SQ_NULL) { sq_sb_lit(sb, "null\0"); return; };
            if (v.t == SQ_INTEGER) { sq_sb_int(sb, v.i); return; };
            if (v.t == SQ_REAL)
            {
                if (v.r > 1.0e308) { sq_sb_lit(sb, "9e999\0"); return; };
                if (v.r < 0.0 - 1.0e308) { sq_sb_lit(sb, "-9e999\0"); return; };
                n = sq_real_text(v.r, @t[0]);
                if (v.r < 0.0) { sq_sb_lit(sb, "(\0"); sq_sb_add(sb, @t[0], n); sq_sb_lit(sb, ")\0"); }
                else { sq_sb_add(sb, @t[0], n); };
                return;
            };
            if (v.t == SQ_TEXT)
            {
                sq_sb_lit(sb, "'\0");
                for (i = 0; i < v.n; i++)
                {
                    if (v.p[i] == (byte)39) { sq_sb_lit(sb, "''\0"); } else { sq_sb_add(sb, @v.p[i], 1); };
                };
                sq_sb_lit(sb, "'\0");
                return;
            };
            hx = "0123456789ABCDEF\0";
            sq_sb_lit(sb, "x'\0");
            for (i = 0; i < v.n; i++)
            {
                t[0] = hx[((int)v.p[i] >> 4) `& 15];
                t[1] = hx[(int)v.p[i] `& 15];
                sq_sb_add(sb, @t[0], 2);
            };
            sq_sb_lit(sb, "'\0");
        };

        // copies an expression, replacing excluded.name by the column "__ex_name" of the proposed-row source
        def sq_sb_expr(SQ_SB* sb, byte* s, int n) -> void
        {
            int i, j, st0, en;
            byte q;
            i = 0;
            while (i < n)
            {
                if (s[i] == (byte)39 | s[i] == (byte)34 | s[i] == (byte)96)
                {
                    q = s[i];
                    j = i + 1;
                    while (j < n & s[j] != q) { j++; };
                    if (j < n) { j++; };
                    sq_sb_add(sb, @s[i], j - i);
                    i = j;
                    continue;
                };
                if (i + 9 <= n)
                {
                    if (sq_lc(s[i]) == (byte)101 & sq_lc(s[i + 1]) == (byte)120 & sq_lc(s[i + 2]) == (byte)99 & sq_lc(s[i + 3]) == (byte)108 & sq_lc(s[i + 4]) == (byte)117 & sq_lc(s[i + 5]) == (byte)100 & sq_lc(s[i + 6]) == (byte)101 & sq_lc(s[i + 7]) == (byte)100 & s[i + 8] == (byte)46)
                    {
                        j = 1;
                        if (i > 0) { if (sq_isalpha(s[i - 1]) | sq_isdigit(s[i - 1]) | s[i - 1] == (byte)95 | s[i - 1] == (byte)46) { j = 0; }; };
                        if (j == 1 & i + 9 < n)
                        {
                            st0 = i + 9;
                            if (s[st0] == (byte)34)
                            {
                                en = st0 + 1;
                                while (en < n & s[en] != (byte)34) { en++; };
                                sq_sb_lit(sb, "\"__ex_\0");
                                sq_sb_add(sb, @s[st0 + 1], en - st0 - 1);
                                sq_sb_lit(sb, "\"\0");
                                i = en + 1;
                                continue;
                            };
                            if (sq_isalpha(s[st0]) | s[st0] == (byte)95)
                            {
                                en = st0;
                                while (en < n & (sq_isalpha(s[en]) | sq_isdigit(s[en]) | s[en] == (byte)95)) { en++; };
                                sq_sb_lit(sb, "\"__ex_\0");
                                sq_sb_add(sb, @s[st0], en - st0);
                                sq_sb_lit(sb, "\"\0");
                                i = en;
                                continue;
                            };
                        };
                    };
                };
                sq_sb_add(sb, @s[i], 1);
                i++;
            };
        };

        // Applies DO UPDATE of clause k to the existing row cr. nwp holds the values proposed by the INSERT (the "excluded" row).
        // Returns 0 when done, 1 on an error.
        def sq_fk_update(SQ_STMT* st, SQ_TCTX* tc, SQ_VAL* old, SQ_VAL* nw, i64 rid) -> int;

        def sq_ups_apply(SQ_STMT* st, SQ_TCTX* tc, SQ_CHK* chk, SQ_UPS* u, int k, SQ_VAL* nwp, i64 cr) -> int
        {
            SQ_SB sb;
            SQ_STMT* sub;
            SQ_VAL* ov;
            SQ_VAL* nv;
            SQ_VAL* row;
            int c, j, r, rc, ipk, tl;
            int[20] usc;
            i64 newrid;
            ipk = tc.ti.ipk;
            tl = sq_cstrlen(@tc.tname[0]);
            sq_sb_init(@sb);
            sq_sb_lit(@sb, "select \0");
            if (tc.wor == 1) { sq_sb_lit(@sb, "0\0"); }
            else { sq_sb_ident(@sb, @tc.tname[0], tl); sq_sb_lit(@sb, ".rowid\0"); };
            sq_sb_lit(@sb, ", \0");
            sq_sb_ident(@sb, @tc.tname[0], tl);
            sq_sb_lit(@sb, ".*\0");
            for (j = 0; j < u.nset[k]; j++)
            {
                sq_sb_lit(@sb, ", (\0");
                sq_sb_expr(@sb, @st.sql[u.ses[k * 16 + j]], u.see[k * 16 + j] - u.ses[k * 16 + j]);
                sq_sb_lit(@sb, ")\0");
            };
            if (u.ws[k] >= 0)
            {
                sq_sb_lit(@sb, ", (\0");
                sq_sb_expr(@sb, @st.sql[u.ws[k]], u.we[k] - u.ws[k]);
                sq_sb_lit(@sb, ")\0");
            };
            sq_sb_lit(@sb, " from \0");
            sq_sb_ident(@sb, @tc.tname[0], tl);
            sq_sb_lit(@sb, ", (select \0");
            for (c = 0; c < tc.ncols; c++)
            {
                if (c > 0) { sq_sb_lit(@sb, ", \0"); };
                sq_sb_value(@sb, @nwp[c]);
                sq_sb_lit(@sb, " as \"__ex_\0");
                sq_sb_add(@sb, @tc.ti.base[tc.ti.cs[c]], tc.ti.cl[c]);
                sq_sb_lit(@sb, "\"\0");
            };
            sq_sb_lit(@sb, ") as excluded\0");
            if (tc.wor == 1)
            {
                if (sq_wor_cond(@sb, tc, cr, 1) != 0) { sq_sb_free(@sb); sq_seterr(st, "internal error: row not found\0"); return 1; };
            }
            else
            {
                sq_sb_lit(@sb, " where \0");
                sq_sb_ident(@sb, @tc.tname[0], tl);
                sq_sb_lit(@sb, ".rowid = \0");
                sq_sb_int(@sb, cr);
            };
            if (sb.err != 0) { sq_sb_free(@sb); sq_seterr(st, "out of memory\0"); return 1; };
            sub = sq_run_rows(st.db, st, sb.p);
            sq_sb_free(@sb);
            if ((u64)sub == (u64)0) { return 1; };
            if (sub.res.n < 1) { sq_stmt_del(sub); return 0; };
            row = @sub.res.d[0];
            if (u.ws[k] >= 0)
            {
                if (sq_truth(@row[1 + tc.ncols + u.nset[k]]) != 1) { sq_stmt_del(sub); return 0; };
            };
            ov = tc.ol;
            nv = tc.nw;
            for (c = 0; c < tc.ncols; c++)
            {
                sq_val_copy(@ov[c], @row[1 + c]);
                sq_val_own(@tc.ar, @ov[c]);
                sq_val_copy(@nv[c], @ov[c]);
            };
            sq_val_int(@ov[tc.ncols], cr);
            for (j = 0; j < u.nset[k]; j++)
            {
                c = u.setc[k * 16 + j];
                sq_val_copy(@nv[c], @row[1 + tc.ncols + j]);
                sq_val_own(@tc.ar, @nv[c]);
                if (c == tc.ncols) { sq_val_copy(@nv[tc.ncols], @nv[c]); };
            };
            sq_stmt_del(sub);
            if (sq_tc_affinity(tc, nv) != 0) { return 1; };
            newrid = cr;
            if (tc.wor == 1) { newrid = sq_wor_reg(tc, nv); }
            else
            {
                if (ipk >= 0)
                {
                    if (nv[ipk].t != SQ_INTEGER) { sq_seterr(st, "datatype mismatch\0"); return 1; };
                    newrid = nv[ipk].i;
                }
                else
                {
                    for (j = 0; j < u.nset[k]; j++)
                    {
                        if (u.setc[k * 16 + j] == tc.ncols)
                        {
                            sq_cast(@tc.ar, @nv[tc.ncols], 3, @nv[tc.ncols]);
                            newrid = nv[tc.ncols].i;
                        };
                    };
                };
            };
            sq_val_int(@nv[tc.ncols], newrid);
            r = sq_tc_check(tc, chk, nv, newrid, 1, cr, 0);
            if (r == 1) { return 1; };
            if (r == 5) { return 0; };
            for (j = 0; j < u.nset[k] & j < 20; j++) { usc[j] = u.setc[k * 16 + j]; };
            if (sq_tc_update(tc, cr, newrid, ov, nv, @usc[0], u.nset[k]) != 0) { return 1; };
            st.changes++;
            if (sq_tc_note(tc, newrid) != 0) { return 1; };
            if (sq_fk_update(st, tc, ov, nv, newrid) != 0) { return 1; };
            return 0;
        };

        // ---- PRAGMA ----
        // Pragmas that return rows are answered by generating a SELECT over constant rows, which is then prepared as a
        // normal query. Settings that only tune behaviour this library does not have are remembered and read back.

        global int[24] SQ_PRV;
        global int[24] SQ_PRS;
        global int SQ_FK = 0;
        global byte[16] SQ_LOCKMODE;
        global int SQ_LOCKSET = 0;

        struct SQ_PQ
        {
            SQ_SB sb;
            int nc;
        };

        def sq_pq_begin(SQ_PQ* q, byte* names) -> void
        {
            int i, st, n;
            sq_sb_init(@q.sb);
            q.nc = 0;
            sq_sb_lit(@q.sb, "select * from (select \0");
            i = 0;
            n = 0;
            while (true)
            {
                st = i;
                while (names[i] != (byte)44 & names[i] != (byte)0) { i++; };
                if (n > 0) { sq_sb_lit(@q.sb, ", \0"); };
                sq_sb_lit(@q.sb, "null as \"\0");
                sq_sb_add(@q.sb, @names[st], i - st);
                sq_sb_lit(@q.sb, "\"\0");
                n++;
                if (names[i] == (byte)0) { break; };
                i++;
            };
            sq_sb_lit(@q.sb, " where 0\0");
        };

        def sq_pq_row(SQ_PQ* q) -> void
        {
            sq_sb_lit(@q.sb, " union all select \0");
            q.nc = 0;
        };

        def sq_pq_int(SQ_PQ* q, i64 v) -> void
        {
            if (q.nc > 0) { sq_sb_lit(@q.sb, ", \0"); };
            q.nc++;
            sq_sb_int(@q.sb, v);
        };

        def sq_pq_null(SQ_PQ* q) -> void
        {
            if (q.nc > 0) { sq_sb_lit(@q.sb, ", \0"); };
            q.nc++;
            sq_sb_lit(@q.sb, "null\0");
        };

        def sq_pq_str(SQ_PQ* q, byte* s, int n) -> void
        {
            int i;
            if (q.nc > 0) { sq_sb_lit(@q.sb, ", \0"); };
            q.nc++;
            sq_sb_lit(@q.sb, "'\0");
            for (i = 0; i < n; i++)
            {
                if (s[i] == (byte)39) { sq_sb_lit(@q.sb, "''\0"); }
                else { sq_sb_add(@q.sb, @s[i], 1); };
            };
            sq_sb_lit(@q.sb, "'\0");
        };

        def sq_pq_lit(SQ_PQ* q, byte* s) -> void
        {
            sq_pq_str(q, s, sq_cstrlen(s));
        };

        // finishes the query text and hands it to the caller (heap string)
        def sq_pq_done(SQ_PQ* q, byte** pq) -> void
        {
            sq_sb_lit(@q.sb, ")\0");
            *pq = q.sb.p;
        };

        def sq_pr_find(byte* p, int l) -> int
        {
            if (sq_ieq(p, l, "synchronous\0")) { return 0; };
            if (sq_ieq(p, l, "cache_size\0")) { return 1; };
            if (sq_ieq(p, l, "temp_store\0")) { return 2; };
            if (sq_ieq(p, l, "busy_timeout\0")) { return 3; };
            if (sq_ieq(p, l, "recursive_triggers\0")) { return 4; };
            if (sq_ieq(p, l, "secure_delete\0")) { return 5; };
            if (sq_ieq(p, l, "wal_autocheckpoint\0")) { return 6; };
            if (sq_ieq(p, l, "automatic_index\0")) { return 7; };
            if (sq_ieq(p, l, "count_changes\0")) { return 8; };
            if (sq_ieq(p, l, "defer_foreign_keys\0")) { return 9; };
            if (sq_ieq(p, l, "ignore_check_constraints\0")) { return 10; };
            if (sq_ieq(p, l, "query_only\0")) { return 11; };
            if (sq_ieq(p, l, "read_uncommitted\0")) { return 12; };
            if (sq_ieq(p, l, "trusted_schema\0")) { return 13; };
            if (sq_ieq(p, l, "cell_size_check\0")) { return 14; };
            if (sq_ieq(p, l, "legacy_alter_table\0")) { return 15; };
            if (sq_ieq(p, l, "reverse_unordered_selects\0")) { return 16; };
            if (sq_ieq(p, l, "checkpoint_fullfsync\0")) { return 17; };
            if (sq_ieq(p, l, "fullfsync\0")) { return 18; };
            if (sq_ieq(p, l, "foreign_keys\0")) { return 19; };
            if (sq_ieq(p, l, "journal_size_limit\0")) { return 20; };
            return 0 - 1;
        };

        def sq_pr_default(int i) -> i64
        {
            if (i == 0) { return (i64)2; };
            if (i == 1) { return (i64)0 - (i64)2000; };
            if (i == 6) { return (i64)1000; };
            if (i == 7) { return (i64)1; };
            if (i == 13) { return (i64)1; };
            if (i == 20) { return (i64)0 - (i64)1; };
            return (i64)0;
        };

        // reads the value after "=" or inside "( )": a number, a signed number, a word or a string. Returns the text span
        // (ts, tl) and the numeric value. found = 0 when there is no value.
        def sq_pr_value(SQ_STMT* st, int* found, int* ts, int* tl, i64* num, int* isnum) -> int
        {
            int paren, neg;
            *found = 0;
            *isnum = 0;
            *num = (i64)0;
            paren = 0;
            if (sq_is_op(st, 61)) { sq_next(st); }
            else
            {
                if (sq_is_op(st, 40)) { sq_next(st); paren = 1; }
                else { return 0; };
            };
            neg = 0;
            if (sq_is_op(st, 45)) { neg = 1; sq_next(st); }
            else { if (sq_is_op(st, 43)) { sq_next(st); }; };
            if (st.tk == 0) { sq_seterr(st, "syntax error\0"); return 1; };
            *ts = st.ts;
            *tl = st.tl;
            *found = 1;
            if (st.tk == 2)
            {
                *num = sq_atoi(@st.sql[st.ts], st.tl);
                if (neg == 1) { *num = (i64)0 - *num; };
                *isnum = 1;
            }
            else
            {
                if (st.tk == 1 | st.tk == 4)
                {
                    if (sq_ieq(@st.sql[st.ts], st.tl, "on\0") | sq_ieq(@st.sql[st.ts], st.tl, "true\0") | sq_ieq(@st.sql[st.ts], st.tl, "yes\0")) { *num = (i64)1; *isnum = 1; };
                    if (sq_ieq(@st.sql[st.ts], st.tl, "off\0") | sq_ieq(@st.sql[st.ts], st.tl, "false\0") | sq_ieq(@st.sql[st.ts], st.tl, "no\0")) { *num = (i64)0; *isnum = 1; };
                    if (sq_ieq(@st.sql[st.ts], st.tl, "normal\0")) { *num = (i64)1; *isnum = 1; };
                    if (sq_ieq(@st.sql[st.ts], st.tl, "full\0")) { *num = (i64)2; *isnum = 1; };
                    if (sq_ieq(@st.sql[st.ts], st.tl, "extra\0")) { *num = (i64)3; *isnum = 1; };
                };
            };
            sq_next(st);
            if (paren == 1)
            {
                if (sq_is_op(st, 41) == false) { sq_seterr(st, "syntax error\0"); return 1; };
                sq_next(st);
            };
            return 0;
        };

        // std type names are stored in upper case
        def sq_pq_type(SQ_PQ* q, SQ_TI* ti, int c) -> void
        {
            byte[64] b;
            int n, i, std;
            n = ti.tyl[c];
            if (n <= 0) { sq_pq_str(q, "\0", 0); return; };
            if (n > 60) { n = 60; };
            std = 0;
            if (sq_ieq(@ti.base[ti.tys[c]], ti.tyl[c], "int\0") | sq_ieq(@ti.base[ti.tys[c]], ti.tyl[c], "integer\0") | sq_ieq(@ti.base[ti.tys[c]], ti.tyl[c], "real\0") | sq_ieq(@ti.base[ti.tys[c]], ti.tyl[c], "text\0") | sq_ieq(@ti.base[ti.tys[c]], ti.tyl[c], "blob\0") | sq_ieq(@ti.base[ti.tys[c]], ti.tyl[c], "any\0")) { std = 1; };
            for (i = 0; i < n; i++)
            {
                b[i] = ti.base[ti.tys[c] + i];
                if (std == 1) { if (b[i] >= (byte)97 & b[i] <= (byte)122) { b[i] = (byte)(b[i] - 32); }; };
            };
            sq_pq_str(q, @b[0], n);
        };

        // declared type of a view result column. Returns 1 when a declared type text was found
        // (pb, ps, pl), 2 when only an affinity code is known (paff), 3 for the rowid, 0 for none.
        def sq_dt_resolve(SQ_STMT* st, int ni, int depth, byte** pb, int* ps, int* pl, int* paff) -> int
        {
            SQ_NODE* nd;
            SQ_SRC* sr;
            SQ_BLK* sb;
            SQ_TI* ti;
            int r;
            if (ni < 0 | depth > 16) { return 0; };
            nd = @st.nodes[ni];
            if (nd.kind == SQN_COL)
            {
                if (nd.lvl != 0) { return 0; };
                sr = @st.blks[nd.owner].src[nd.src];
                if (nd.col < 0) { return 3; };
                if (sr.kind != 2 & (u64)sr.ti != (u64)0) { if (nd.col >= sr.ti.ncols) { return 3; }; };
                if (sr.kind == 2)
                {
                    sb = st.blks[sr.blk];
                    if (nd.col >= sb.nres) { return 0; };
                    return sq_dt_resolve(st, sb.rc[nd.col], depth + 1, pb, ps, pl, paff);
                };
                ti = sr.ti;
                if ((u64)ti == (u64)0) { return 0; };
                if (ti.tyl[nd.col] > 0)
                {
                    pb[0] = ti.base;
                    ps[0] = ti.tys[nd.col];
                    pl[0] = ti.tyl[nd.col];
                    return 1;
                };
                paff[0] = 0;
                return 2;
            };
            if (nd.kind == SQN_CAST) { paff[0] = (int)nd.iv; return 2; };
            if (nd.kind == SQN_COLLATE)
            {
                r = sq_dt_resolve(st, nd.a, depth + 1, pb, ps, pl, paff);
                if (r == 1) { paff[0] = sq_type_code(@pb[0][ps[0]], pl[0]); return 2; };
                if (r == 3) { paff[0] = 3; return 2; };
                return r;
            };
            if (nd.kind == SQN_SUBQ)
            {
                sb = st.blks[nd.blk];
                if (sb.nres < 1) { return 0; };
                r = sq_dt_resolve(st, sb.rc[0], depth + 1, pb, ps, pl, paff);
                return r;
            };
            return 0;
        };

        def sq_pq_dtype(SQ_PQ* q, SQ_STMT* st, int ni) -> void
        {
            byte* pb;
            byte[64] b;
            int ps, pl, af, r, i, std;
            pb = (byte*)0; ps = 0; pl = 0; af = 0;
            r = sq_dt_resolve(st, ni, 0, @pb, @ps, @pl, @af);
            if (r == 1)
            {
                if (pl > 60) { pl = 60; };
                std = 0;
                if (sq_ieq(@pb[ps], pl, "int\0") | sq_ieq(@pb[ps], pl, "integer\0") | sq_ieq(@pb[ps], pl, "real\0") | sq_ieq(@pb[ps], pl, "text\0") | sq_ieq(@pb[ps], pl, "blob\0") | sq_ieq(@pb[ps], pl, "any\0")) { std = 1; };
                for (i = 0; i < pl; i++)
                {
                    b[i] = pb[ps + i];
                    if (std == 1) { if (b[i] >= (byte)97 & b[i] <= (byte)122) { b[i] = (byte)(b[i] - 32); }; };
                };
                sq_pq_str(q, @b[0], pl);
                return;
            };
            if (r == 3) { sq_pq_lit(q, "INTEGER\0"); return; };
            if (r == 2)
            {
                if (af == 3) { sq_pq_lit(q, "INT\0"); return; };
                if (af == 1) { sq_pq_lit(q, "TEXT\0"); return; };
                if (af == 4) { sq_pq_lit(q, "REAL\0"); return; };
                if (af == 2) { sq_pq_lit(q, "NUM\0"); return; };
                sq_pq_lit(q, "BLOB\0");
                return;
            };
            sq_pq_lit(q, "\0");
        };

        def sq_pq_coll(SQ_PQ* q, int c) -> void
        {
            if (c == 1) { sq_pq_lit(q, "nocase\0"); }
            else { if (c == 2) { sq_pq_lit(q, "rtrim\0"); } else { sq_pq_lit(q, "BINARY\0"); }; };
        };

        // table_info / table_xinfo
        def sq_pr_table_info(SQ_STMT* st, byte* nm, int nl, int xinfo, byte** pq) -> int
        {
            SQLITE_DB* db = st.db;
            SQ_PQ q;
            SQ_TI* ti;
            SQ_STMT* vs;
            byte[160] cn;
            int tp, c, k, cid, i, hid, pkpos, vi;
            tp = sq_find_table_n(db, nm, nl);
            if (xinfo == 1) { sq_pq_begin(@q, "cid,name,type,notnull,dflt_value,pk,hidden\0"); }
            else { sq_pq_begin(@q, "cid,name,type,notnull,dflt_value,pk\0"); };
            if (tp < 0)
            {
                // a view
                vi = 0 - 1;
                for (i = 0; i < db.nschema; i++)
                {
                    if (db.schema[i].kind == 3 & sq_name_is(nm, nl, @db.schema[i].name[0])) { vi = i; };
                };
                if (vi >= 0)
                {
                    SQ_SB vb;
                    sq_sb_init(@vb);
                    sq_sb_lit(@vb, "select * from \0");
                    sq_sb_ident(@vb, nm, nl);
                    vs = sq_stmt_new();
                    if ((u64)vs != (u64)0)
                    {
                        if (sq_prep_query(vs, db, vb.p) == 0)
                        {
                            for (c = 0; c < vs.nres; c++)
                            {
                                sq_column_name(vs, c, @cn[0], 160);
                                sq_pq_row(@q);
                                sq_pq_int(@q, (i64)c);
                                sq_pq_str(@q, @cn[0], sq_cstrlen(@cn[0]));
                                sq_pq_dtype(@q, vs, vs.blks[vs.root_blk].rc[c]);
                                sq_pq_int(@q, (i64)0);
                                sq_pq_null(@q);
                                sq_pq_int(@q, (i64)0);
                                if (xinfo == 1) { sq_pq_int(@q, (i64)0); };
                            };
                        };
                        sq_stmt_del(vs);
                    };
                    sq_sb_free(@vb);
                };
                sq_pq_done(@q, pq);
                return 0;
            };
            if ((u64)db.schema[tp].sql == (u64)0) { sq_pq_done(@q, pq); return 0; };
            ti = (SQ_TI*)fmalloc((u64)(sizeof(SQ_TI) / 8 + 4096));
            if ((u64)ti == (u64)0) { sq_seterr(st, "out of memory\0"); sq_sb_free(@q.sb); return 1; };
            if (sq_ti_load(ti, db.schema[tp].sql) != 0) { ffree((u64)ti); sq_sb_free(@q.sb); sq_seterr(st, "cannot read table definition\0"); return 1; };
            cid = 0;
            for (c = 0; c < ti.ncols; c++)
            {
                if (ti.gen[c] != 0 & xinfo == 0) { continue; };
                sq_pq_row(@q);
                if (xinfo == 1) { sq_pq_int(@q, (i64)c); } else { sq_pq_int(@q, (i64)cid); };
                cid++;
                sq_pq_str(@q, @ti.base[ti.cs[c]], ti.cl[c]);
                sq_pq_type(@q, ti, c);
                sq_pq_int(@q, (i64)ti.notnull[c]);
                if (ti.dfl[c] > 0) { sq_pq_str(@q, @ti.base[ti.dfs[c]], ti.dfl[c]); } else { sq_pq_null(@q); };
                pkpos = 0;
                for (k = 0; k < ti.npk; k++) { if (ti.pkc[k] == c) { pkpos = k + 1; }; };
                sq_pq_int(@q, (i64)pkpos);
                if (xinfo == 1)
                {
                    hid = 0;
                    if (ti.gen[c] == 1) { hid = 2; };
                    if (ti.gen[c] == 2) { hid = 3; };
                    sq_pq_int(@q, (i64)hid);
                };
            };
            ffree((u64)ti);
            sq_pq_done(@q, pq);
            return 0;
        };

        // index_list
        def sq_pr_index_list(SQ_STMT* st, byte* nm, int nl, byte** pq) -> int
        {
            SQLITE_DB* db = st.db;
            SQ_PQ q;
            SQ_TI* ti;
            SQ_IDX* ixs;
            SQ_SB nmb;
            int tp, n, i, seq, pks;
            tp = sq_find_table_n(db, nm, nl);
            sq_pq_begin(@q, "seq,name,unique,origin,partial\0");
            if (tp < 0) { sq_pq_done(@q, pq); return 0; };
            ti = (SQ_TI*)fmalloc((u64)(sizeof(SQ_TI) / 8 + 4096));
            ixs = (SQ_IDX*)fmalloc((u64)(sizeof(SQ_IDX) / 8 + 8) * (u64)24);
            if ((u64)ti == (u64)0 | (u64)ixs == (u64)0) { sq_seterr(st, "out of memory\0"); sq_sb_free(@q.sb); return 1; };
            if (sq_ti_load(ti, db.schema[tp].sql) != 0) { ffree((u64)ti); ffree((u64)ixs); sq_sb_free(@q.sb); sq_seterr(st, "cannot read table definition\0"); return 1; };
            n = sq_idx_list(db, tp, ti, ixs, 24);
            seq = 0;
            pks = 0;
            if (ti.wor == 1)
            {
                for (i = 0; i < ti.nix; i++) { if (ti.ixpk[i] == 1) { pks = i + 1; }; };
            };
            for (i = n - 1; i >= 0; i--)
            {
                if (pks > 0 & ixs[i].slot > 0 & ixs[i].slot < pks)
                {
                    sq_pq_row(@q);
                    sq_pq_int(@q, (i64)seq);
                    seq++;
                    sq_sb_init(@nmb);
                    sq_sb_lit(@nmb, "sqlite_autoindex_\0"); sq_sb_add(@nmb, nm, nl); sq_sb_lit(@nmb, "_\0"); sq_sb_int(@nmb, (i64)pks);
                    sq_pq_str(@q, nmb.p, sq_cstrlen(nmb.p));
                    sq_sb_free(@nmb);
                    sq_pq_int(@q, (i64)1); sq_pq_lit(@q, "pk\0"); sq_pq_int(@q, (i64)0);
                    pks = 0;
                };
                sq_pq_row(@q);
                sq_pq_int(@q, (i64)seq);
                seq++;
                sq_pq_str(@q, @ixs[i].name[0], sq_cstrlen(@ixs[i].name[0]));
                sq_pq_int(@q, (i64)ixs[i].unique);
                if ((u64)db.schema[ixs[i].schema_pos].sql != (u64)0) { sq_pq_lit(@q, "c\0"); }
                else { if (ixs[i].ispk == 1) { sq_pq_lit(@q, "pk\0"); } else { sq_pq_lit(@q, "u\0"); }; };
                sq_pq_int(@q, (i64)ixs[i].partial);
            };
            if (pks > 0)
            {
                sq_pq_row(@q);
                sq_pq_int(@q, (i64)seq);
                sq_sb_init(@nmb);
                sq_sb_lit(@nmb, "sqlite_autoindex_\0"); sq_sb_add(@nmb, nm, nl); sq_sb_lit(@nmb, "_\0"); sq_sb_int(@nmb, (i64)pks);
                sq_pq_str(@q, nmb.p, sq_cstrlen(nmb.p));
                sq_sb_free(@nmb);
                sq_pq_int(@q, (i64)1); sq_pq_lit(@q, "pk\0"); sq_pq_int(@q, (i64)0);
            };
            ffree((u64)ti);
            ffree((u64)ixs);
            sq_pq_done(@q, pq);
            return 0;
        };

        // index_info / index_xinfo
        def sq_pr_index_info(SQ_STMT* st, byte* nm, int nl, int xinfo, byte** pq) -> int
        {
            SQLITE_DB* db = st.db;
            SQ_PQ q;
            SQ_TI* ti;
            SQ_IDX* ixs;
            int ip, tp, n, i, k, c;
            ip = 0 - 1;
            for (i = 0; i < db.nschema; i++)
            {
                if (db.schema[i].kind == 2 & sq_name_is(nm, nl, @db.schema[i].name[0])) { ip = i; };
            };
            if (xinfo == 1) { sq_pq_begin(@q, "seqno,cid,name,desc,coll,key\0"); }
            else { sq_pq_begin(@q, "seqno,cid,name\0"); };
            if (ip < 0)
            {
                // the PRIMARY KEY of a WITHOUT ROWID table is its own b-tree and has no row in sqlite_master
                int tj, pl2, dg, pks2, kk;
                for (tj = 0; tj < db.nschema; tj++)
                {
                    if (db.schema[tj].kind != 1) { continue; };
                    if ((u64)db.schema[tj].sql == (u64)0) { continue; };
                    pl2 = sq_cstrlen(@db.schema[tj].name[0]);
                    if (nl != 17 + pl2 + 1 + 1 & nl != 17 + pl2 + 1 + 2) { continue; };
                    if (sq_ieq(nm, 17, "sqlite_autoindex_\0") == false) { continue; };
                    if (sq_name_is(@nm[17], pl2, @db.schema[tj].name[0]) == false) { continue; };
                    if (nm[17 + pl2] != (byte)95) { continue; };
                    dg = (int)sq_atoi(@nm[17 + pl2 + 1], nl - 17 - pl2 - 1);
                    ti = (SQ_TI*)fmalloc((u64)(sizeof(SQ_TI) / 8 + 4096));
                    if ((u64)ti == (u64)0) { continue; };
                    if (sq_ti_load(ti, db.schema[tj].sql) == 0 & ti.wor == 1)
                    {
                        pks2 = 0;
                        for (kk = 0; kk < ti.nix; kk++) { if (ti.ixpk[kk] == 1) { pks2 = kk + 1; }; };
                        if (pks2 == dg)
                        {
                            for (kk = 0; kk < ti.npk; kk++)
                            {
                                sq_pq_row(@q);
                                sq_pq_int(@q, (i64)kk);
                                sq_pq_int(@q, (i64)ti.pkc[kk]);
                                sq_pq_str(@q, @ti.base[ti.cs[ti.pkc[kk]]], ti.cl[ti.pkc[kk]]);
                                if (xinfo == 1) { sq_pq_int(@q, (i64)ti.pkd[kk]); sq_pq_coll(@q, ti.pkcl[kk]); sq_pq_int(@q, (i64)1); };
                            };
                            if (xinfo == 1)
                            {
                                int seqx;
                                seqx = ti.npk;
                                for (kk = 0; kk < ti.ncols; kk++)
                                {
                                    if (ti.pk[kk] == 1) { continue; };
                                    sq_pq_row(@q);
                                    sq_pq_int(@q, (i64)seqx);
                                    seqx++;
                                    sq_pq_int(@q, (i64)kk);
                                    sq_pq_str(@q, @ti.base[ti.cs[kk]], ti.cl[kk]);
                                    sq_pq_int(@q, (i64)0); sq_pq_coll(@q, ti.coll[kk]); sq_pq_int(@q, (i64)0);
                                };
                            };
                        };
                    };
                    ffree((u64)ti);
                };
                sq_pq_done(@q, pq);
                return 0;
            };
            tp = sq_find_table_n(db, @db.schema[ip].tbl_name[0], sq_cstrlen(@db.schema[ip].tbl_name[0]));
            if (tp < 0) { sq_pq_done(@q, pq); return 0; };
            ti = (SQ_TI*)fmalloc((u64)(sizeof(SQ_TI) / 8 + 4096));
            ixs = (SQ_IDX*)fmalloc((u64)(sizeof(SQ_IDX) / 8 + 8) * (u64)24);
            if ((u64)ti == (u64)0 | (u64)ixs == (u64)0) { sq_seterr(st, "out of memory\0"); sq_sb_free(@q.sb); return 1; };
            if (sq_ti_load(ti, db.schema[tp].sql) != 0) { ffree((u64)ti); ffree((u64)ixs); sq_sb_free(@q.sb); sq_seterr(st, "cannot read table definition\0"); return 1; };
            n = sq_idx_list(db, tp, ti, ixs, 24);
            for (i = 0; i < n; i++)
            {
                if (ixs[i].schema_pos != ip) { continue; };
                for (k = 0; k < ixs[i].nk; k++)
                {
                    c = ixs[i].col[k];
                    sq_pq_row(@q);
                    sq_pq_int(@q, (i64)k);
                    if (c == 0 - 2) { sq_pq_int(@q, (i64)0 - (i64)2); sq_pq_null(@q); }
                    else { if (c >= ti.ncols) { sq_pq_int(@q, (i64)0 - (i64)1); sq_pq_null(@q); }
                    else
                    {
                        sq_pq_int(@q, (i64)c);
                        sq_pq_str(@q, @ti.base[ti.cs[c]], ti.cl[c]);
                    }; };
                    if (xinfo == 1)
                    {
                        sq_pq_int(@q, (i64)ixs[i].desc[k]);
                        sq_pq_coll(@q, ixs[i].coll[k]);
                        sq_pq_int(@q, (i64)1);
                    };
                };
                if (xinfo == 1)
                {
                    for (k = 0; k < ixs[i].ntl; k++)
                    {
                        sq_pq_row(@q);
                        sq_pq_int(@q, (i64)(ixs[i].nk + k));
                        if (ixs[i].tlc[k] < 0)
                        {
                            sq_pq_int(@q, (i64)0 - (i64)1);
                            sq_pq_null(@q);
                        }
                        else
                        {
                            sq_pq_int(@q, (i64)ixs[i].tlc[k]);
                            sq_pq_str(@q, @ti.base[ti.cs[ixs[i].tlc[k]]], ti.cl[ixs[i].tlc[k]]);
                        };
                        sq_pq_int(@q, (i64)ixs[i].desc[ixs[i].nk + k]);
                        sq_pq_coll(@q, ixs[i].coll[ixs[i].nk + k]);
                        sq_pq_int(@q, (i64)0);
                    };
                };
            };
            ffree((u64)ti);
            ffree((u64)ixs);
            sq_pq_done(@q, pq);
            return 0;
        };

        // single value result
        def sq_pr_scalar_int(SQ_STMT* st, byte* name, i64 v, byte** pq) -> void
        {
            SQ_PQ q;
            sq_pq_begin(@q, name);
            sq_pq_row(@q);
            sq_pq_int(@q, v);
            sq_pq_done(@q, pq);
        };

        def sq_pr_scalar_str(SQ_STMT* st, byte* name, byte* v, byte** pq) -> void
        {
            SQ_PQ q;
            sq_pq_begin(@q, name);
            sq_pq_row(@q);
            sq_pq_lit(@q, v);
            sq_pq_done(@q, pq);
        };

        // reads or writes a 4 byte big-endian value in the database header
        def sq_hdr_get(SQLITE_DB* db, int off) -> i64
        {
            byte* pg = sq_page(db, 1);
            if ((u64)pg == (u64)0) { return (i64)0; };
            return (i64)sq_be32(@pg[off]);
        };

        def sq_hdr_set(SQLITE_DB* db, int off, i64 v) -> int
        {
            byte* pg;
            int i;
            pg = sq_page(db, 1);
            if ((u64)pg == (u64)0) { return 1; };
            if (sq_before_write(db, 1) != 0) { return 1; };
            for (i = 0; i < db.page_size; i++) { db.wbuf[i] = pg[i]; };
            sq_put32(@db.wbuf[off], (int)v);
            if (sq_page_write(db, 1, db.wbuf) != 0) { return 1; };
            return 0;
        };

        def sq_pragma_check(SQ_STMT* st, int quick, byte** pq) -> int;
        def sq_pr_fk_list(SQ_STMT* st, byte* nm, int nl, byte** pq) -> int;
        def sq_pr_fk_check(SQ_STMT* st, int found, byte* nm, int nl, byte** pq) -> int;

        // Runs one PRAGMA. When the pragma returns rows, *pq receives the text of a SELECT (heap string) producing them.
        def sq_exec_pragma(SQ_STMT* st, byte** pq) -> int
        {
            SQLITE_DB* db = st.db;
            byte* p;
            int l, found, vs, vl, isnum, pi, xi;
            i64 v;
            byte[80] nm;
            int nl, k;
            *pq = (byte*)0;
            if (st.tk != 1) { sq_seterr(st, "expected a pragma name\0"); return 1; };
            p = @st.sql[st.ts];
            l = st.tl;
            // optional "main." schema prefix
            if (sq_peek_op(st, 46))
            {
                if (sq_ieq(p, l, "main\0") == false) { sq_seterr_n(st, "unknown database \0", st.ts, st.tl); return 1; };
                sq_next(st);
                sq_next(st);
                if (st.tk != 1) { sq_seterr(st, "expected a pragma name\0"); return 1; };
                p = @st.sql[st.ts];
                l = st.tl;
            };
            sq_next(st);
            if (sq_pr_value(st, @found, @vs, @vl, @v, @isnum) != 0) { return 1; };
            nl = 0;
            if (found == 1)
            {
                nl = vl;
                if (nl > 78) { nl = 78; };
                for (k = 0; k < nl; k++) { nm[k] = st.sql[vs + k]; };
                nm[nl] = (byte)0;
            };
            if (sq_ieq(p, l, "user_version\0") | sq_ieq(p, l, "application_id\0"))
            {
                xi = 60;
                if (sq_ieq(p, l, "application_id\0")) { xi = 68; };
                if (found == 1)
                {
                    if (isnum == 0) { sq_seterr(st, "expected a number\0"); return 1; };
                    if (sq_hdr_set(db, xi, v) != 0) { return 1; };
                    return 0;
                };
                v = sq_hdr_get(db, xi);
                if (v >= (i64)2147483648) { v = v - (i64)4294967296; };
                if (xi == 60) { sq_pr_scalar_int(st, "user_version\0", v, pq); } else { sq_pr_scalar_int(st, "application_id\0", v, pq); };
                return 0;
            };
            if (sq_ieq(p, l, "table_info\0")) { if (found == 0) { return 0; }; return sq_pr_table_info(st, @nm[0], nl, 0, pq); };
            if (sq_ieq(p, l, "table_xinfo\0")) { if (found == 0) { return 0; }; return sq_pr_table_info(st, @nm[0], nl, 1, pq); };
            if (sq_ieq(p, l, "index_list\0")) { if (found == 0) { return 0; }; return sq_pr_index_list(st, @nm[0], nl, pq); };
            if (sq_ieq(p, l, "index_info\0")) { if (found == 0) { return 0; }; return sq_pr_index_info(st, @nm[0], nl, 0, pq); };
            if (sq_ieq(p, l, "index_xinfo\0")) { if (found == 0) { return 0; }; return sq_pr_index_info(st, @nm[0], nl, 1, pq); };
            if (sq_ieq(p, l, "integrity_check\0")) { return sq_pragma_check(st, 0, pq); };
            if (sq_ieq(p, l, "quick_check\0")) { return sq_pragma_check(st, 1, pq); };
            if (sq_ieq(p, l, "schema_version\0")) { if (found == 0) { sq_pr_scalar_int(st, "schema_version\0", (i64)db.cookie, pq); }; return 0; };
            if (sq_ieq(p, l, "page_count\0")) { sq_pr_scalar_int(st, "page_count\0", (i64)db.npages, pq); return 0; };
            if (sq_ieq(p, l, "page_size\0")) { if (found == 0) { sq_pr_scalar_int(st, "page_size\0", (i64)db.page_size, pq); }; return 0; };
            if (sq_ieq(p, l, "freelist_count\0")) { sq_pr_scalar_int(st, "freelist_count\0", (i64)db.fcount, pq); return 0; };
            if (sq_ieq(p, l, "max_page_count\0")) { if (found == 0) { sq_pr_scalar_int(st, "max_page_count\0", (i64)4294967294, pq); }; return 0; };
            if (sq_ieq(p, l, "auto_vacuum\0")) { if (found == 0) { sq_pr_scalar_int(st, "auto_vacuum\0", (i64)0, pq); }; return 0; };
            if (sq_ieq(p, l, "encoding\0"))
            {
                if (found == 1)
                {
                    if (sq_ieq(@nm[0], nl, "utf-8\0") | sq_ieq(@nm[0], nl, "utf8\0")) { sq_set_encoding(db, 1); };
                    if (sq_ieq(@nm[0], nl, "utf-16le\0") | sq_ieq(@nm[0], nl, "utf-16\0") | sq_ieq(@nm[0], nl, "utf16le\0") | sq_ieq(@nm[0], nl, "utf16\0")) { sq_set_encoding(db, 2); };
                    if (sq_ieq(@nm[0], nl, "utf-16be\0") | sq_ieq(@nm[0], nl, "utf16be\0")) { sq_set_encoding(db, 3); };
                };
                if (found == 0)
                {
                    if (db.enc == 2) { sq_pr_scalar_str(st, "encoding\0", "UTF-16le\0", pq); }
                    else { if (db.enc == 3) { sq_pr_scalar_str(st, "encoding\0", "UTF-16be\0", pq); } else { sq_pr_scalar_str(st, "encoding\0", "UTF-8\0", pq); }; };
                };
                return 0;
            };
            if (sq_ieq(p, l, "journal_mode\0"))
            {
                if (found == 1)
                {
                    if (sq_ieq(@nm[0], nl, "wal\0")) { sq_set_journal_mode(db, 1); };
                    if (sq_ieq(@nm[0], nl, "delete\0")) { sq_set_journal_mode(db, 0); };
                };
                if (db.wal == 1) { sq_pr_scalar_str(st, "journal_mode\0", "wal\0", pq); }
                else { sq_pr_scalar_str(st, "journal_mode\0", "delete\0", pq); };
                return 0;
            };
            if (sq_ieq(p, l, "wal_autocheckpoint\0"))
            {
                if (found == 1) { if (isnum == 1) { SQ_WALAC = (int)v; }; };
                sq_pr_scalar_int(st, "wal_autocheckpoint\0", (i64)SQ_WALAC, pq);
                return 0;
            };
            if (sq_ieq(p, l, "wal_checkpoint\0"))
            {
                SQ_PQ q;
                int nf, nb;
                if (db.wal == 0)
                {
                    sq_pq_begin(@q, "busy,log,checkpointed\0");
                    sq_pq_row(@q); sq_pq_int(@q, (i64)0); sq_pq_int(@q, (i64)0 - (i64)1); sq_pq_int(@q, (i64)0 - (i64)1);
                    sq_pq_done(@q, pq);
                    return 0;
                };
                nf = db.wtf;
                if (db.in_txn == 1) { nf = db.wtf; sq_pq_begin(@q, "busy,log,checkpointed\0"); sq_pq_row(@q); sq_pq_int(@q, (i64)1); sq_pq_int(@q, (i64)0 - (i64)1); sq_pq_int(@q, (i64)0 - (i64)1); sq_pq_done(@q, pq); return 0; };
                nb = sq_wal_checkpoint(db, 0);
                if (nb == 2) { nb = 1; } else { nb = 0; };
                if (found == 1) { if (sq_ieq(@nm[0], nl, "truncate\0")) { nf = 0; }; };
                sq_pq_begin(@q, "busy,log,checkpointed\0");
                sq_pq_row(@q); sq_pq_int(@q, (i64)nb); sq_pq_int(@q, (i64)nf); sq_pq_int(@q, (i64)nf);
                sq_pq_done(@q, pq);
                return 0;
            };
            if (sq_ieq(p, l, "locking_mode\0"))
            {
                if (found == 1)
                {
                    if (sq_ieq(@nm[0], nl, "exclusive\0")) { db.lkx = 1; };
                    if (sq_ieq(@nm[0], nl, "normal\0"))
                    {
                        db.lkx = 0;
                        if (db.in_txn == 0 & db.rdepth <= 1) { sq_lk_drop(db, 1); };
                    };
                };
                if (db.lkx == 1) { sq_pr_scalar_str(st, "locking_mode\0", "exclusive\0", pq); }
                else { sq_pr_scalar_str(st, "locking_mode\0", "normal\0", pq); };
                return 0;
            };
            if (sq_ieq(p, l, "busy_timeout\0"))
            {
                if (found == 1) { if (isnum == 1) { db.busy_ms = (int)v; if (db.busy_ms < 0) { db.busy_ms = 0; }; }; };
                sq_pr_scalar_int(st, "timeout\0", (i64)db.busy_ms, pq);
                return 0;
            };
            if (sq_ieq(p, l, "collation_list\0"))
            {
                SQ_PQ q;
                sq_pq_begin(@q, "seq,name\0");
                sq_pq_row(@q); sq_pq_int(@q, (i64)0); sq_pq_lit(@q, "RTRIM\0");
                sq_pq_row(@q); sq_pq_int(@q, (i64)1); sq_pq_lit(@q, "NOCASE\0");
                sq_pq_row(@q); sq_pq_int(@q, (i64)2); sq_pq_lit(@q, "BINARY\0");
                sq_pq_done(@q, pq);
                return 0;
            };
            if (sq_ieq(p, l, "database_list\0"))
            {
                SQ_PQ q;
                sq_pq_begin(@q, "seq,name,file\0");
                sq_pq_row(@q); sq_pq_int(@q, (i64)0); sq_pq_lit(@q, "main\0"); sq_pq_str(@q, @db.path[0], sq_cstrlen(@db.path[0]));
                for (k = 0; k < db.natt; k++)
                {
                    sq_pq_row(@q);
                    if (db.attn[k * 32] == (byte)116 & db.attn[k * 32 + 1] == (byte)101 & db.attn[k * 32 + 4] == (byte)0) { sq_pq_int(@q, (i64)1); }
                    else
                    {
                        if (db.attn[0] == (byte)116 & db.attn[1] == (byte)101 & db.attn[4] == (byte)0) { sq_pq_int(@q, (i64)(k + 1)); } else { sq_pq_int(@q, (i64)(k + 2)); };
                    };
                    sq_pq_str(@q, @db.attn[k * 32], sq_cstrlen(@db.attn[k * 32]));
                    if (db.attm[k] == 1) { sq_pq_str(@q, "\0", 0); } else { sq_pq_str(@q, @((SQLITE_DB*)db.att[k]).path[0], sq_cstrlen(@((SQLITE_DB*)db.att[k]).path[0])); };
                };
                sq_pq_done(@q, pq);
                return 0;
            };
            if (sq_ieq(p, l, "foreign_key_list\0")) { if (found == 0) { return 0; }; return sq_pr_fk_list(st, @nm[0], nl, pq); };
            if (sq_ieq(p, l, "foreign_key_check\0")) { return sq_pr_fk_check(st, found, @nm[0], nl, pq); };
            pi = sq_pr_find(p, l);
            if (pi >= 0)
            {
                if (found == 1)
                {
                    if (isnum == 0) { return 0; };
                    SQ_PRV[pi] = (int)v;
                    SQ_PRS[pi] = 1;
                    if (pi == 19) { SQ_FK = (int)v; };
                    return 0;
                };
                if (SQ_PRS[pi] == 1) { v = (i64)SQ_PRV[pi]; } else { v = sq_pr_default(pi); };
                if (pi == 19) { v = (i64)SQ_FK; };
                nl = 0;
                {
                    byte[40] cn;
                    for (k = 0; k < l & k < 38; k++) { cn[k] = sq_lc(p[k]); };
                    cn[k] = (byte)0;
                    sq_pr_scalar_int(st, @cn[0], v, pq);
                };
                return 0;
            };
            // anything else is accepted and ignored, as SQLite does for unknown pragmas
            return 0;
        };

        // answers pragma_NAME(arg) table-valued functions for the core library: returns the pragma's query text in *pq
        def sq_ptvf_hook(SQ_STMT* st, byte* name, int nl, byte* arg, int al, byte** pq) -> int
        {
            SQ_STMT* g;
            byte* buf;
            int n, i, rc, k;
            *pq = (byte*)0;
            buf = (byte*)fmalloc((u64)(nl + al * 2 + 32));
            if ((u64)buf == (u64)0) { sq_seterr(st, "out of memory\0"); return 1; };
            n = 0;
            sq_mcpy(buf, "pragma \0", 7);
            n = 7;
            sq_mcpy(@buf[n], name, nl);
            n = n + nl;
            if ((u64)arg != (u64)0)
            {
                buf[n] = (byte)40; n++;
                buf[n] = (byte)39; n++;
                for (i = 0; i < al; i++)
                {
                    if (arg[i] == (byte)39) { buf[n] = (byte)39; n++; };
                    buf[n] = arg[i]; n++;
                };
                buf[n] = (byte)39; n++;
                buf[n] = (byte)41; n++;
            };
            buf[n] = (byte)0;
            g = sq_stmt_new();
            if ((u64)g == (u64)0) { ffree((u64)buf); sq_seterr(st, "out of memory\0"); return 1; };
            sq_stmt_init(g, st.db, buf);
            ffree((u64)buf);
            sq_next(g);
            sq_next(g);
            rc = sq_exec_pragma(g, pq);
            if (rc != 0)
            {
                for (k = 0; k < 150; k++) { st.err[k] = g.err[k]; if (g.err[k] == (byte)0) { break; }; };
            };
            sq_stmt_del(g);
            return rc;
        };

        // ---- foreign keys ----
        // Violations are counted as SQLite does: every row operation adds to or subtracts from a counter, and the statement
        // (or the transaction, for deferred constraints) fails when the counter is positive at its end.

        global int SQ_FKCNT = 0;
        global int SQ_FKDEF = 0;
        global int SQ_FKDEPTH = 0;

        struct SQ_FKR
        {
            byte[64] ctab;
            byte[64] ptab;
            int n, pn, ondel, onupd, dfr, fkid;
            byte[512] ccol;
            byte[512] pcol;
            byte[512] dflt;
            int[8] fc;
            int[8] pc;
        };

        struct SQ_FKD
        {
            int nch, npar;
            SQ_FKR[8] ch;
            SQ_FKR[8] par;
        };

        def sq_ci_eq(byte* a, byte* b) -> bool
        {
            int i = 0;
            while (a[i] != (byte)0 & b[i] != (byte)0)
            {
                if (sq_lc(a[i]) != sq_lc(b[i])) { return false; };
                i++;
            };
            return a[i] == b[i];
        };

        def sq_fk_name_copy(byte* dst, byte* s, int ts, int tl, int kd) -> void
        {
            int i, a, n;
            a = ts;
            n = tl;
            if (kd == 2) { a = ts + 1; n = tl - 2; };
            if (n > 62) { n = 62; };
            for (i = 0; i < n; i++) { dst[i] = s[a + i]; };
            dst[n] = (byte)0;
        };

        // action words: 0 no action, 1 restrict, 2 set null, 3 set default, 4 cascade
        def sq_fk_parse_ref(SQ_TI* ti, int j, int segend, SQ_FKR* e) -> void
        {
            byte* s = ti.base;
            int ts, tl, kd, nx, ps, pe, k, t2, l2, k2, c;
            e.pn = 0;
            e.ondel = 0; e.onupd = 0; e.dfr = 0;
            nx = sq_tok2(s, j, segend, @ts, @tl, @kd);
            if (kd != 1 & kd != 2) { return; };
            sq_fk_name_copy(@e.ptab[0], s, ts, tl, kd);
            j = nx;
            nx = sq_tok2(s, j, segend, @ts, @tl, @kd);
            if (kd == 4)
            {
                ps = ts + 1;
                pe = ts + tl - 1;
                k = ps;
                while (k < pe & e.pn < 8)
                {
                    k = sq_tok2(s, k, pe, @t2, @l2, @k2);
                    if (k2 == 0) { break; };
                    if (k2 == 1 | k2 == 2)
                    {
                        sq_fk_name_copy(@e.pcol[e.pn * 64], s, t2, l2, k2);
                        e.pn++;
                    };
                };
                j = nx;
            };
            while (true)
            {
                nx = sq_tok2(s, j, segend, @ts, @tl, @kd);
                if (kd != 1) { break; };
                if (sq_ieq(@s[ts], tl, "on\0"))
                {
                    j = nx;
                    nx = sq_tok2(s, j, segend, @ts, @tl, @kd);
                    c = 0;
                    if (sq_ieq(@s[ts], tl, "update\0")) { c = 1; };
                    j = nx;
                    nx = sq_tok2(s, j, segend, @ts, @tl, @kd);
                    k = 0;
                    if (sq_ieq(@s[ts], tl, "cascade\0")) { k = 4; j = nx; }
                    else
                    {
                        if (sq_ieq(@s[ts], tl, "restrict\0")) { k = 1; j = nx; }
                        else
                        {
                            if (sq_ieq(@s[ts], tl, "no\0")) { k = 0; j = nx; nx = sq_tok2(s, j, segend, @ts, @tl, @kd); j = nx; }
                            else
                            {
                                if (sq_ieq(@s[ts], tl, "set\0"))
                                {
                                    j = nx;
                                    nx = sq_tok2(s, j, segend, @ts, @tl, @kd);
                                    if (sq_ieq(@s[ts], tl, "null\0")) { k = 2; } else { k = 3; };
                                    j = nx;
                                };
                            };
                        };
                    };
                    if (c == 1) { e.onupd = k; } else { e.ondel = k; };
                    continue;
                };
                if (sq_ieq(@s[ts], tl, "match\0"))
                {
                    j = nx;
                    j = sq_tok2(s, j, segend, @ts, @tl, @kd);
                    continue;
                };
                if (sq_ieq(@s[ts], tl, "not\0"))
                {
                    j = nx;
                    nx = sq_tok2(s, j, segend, @ts, @tl, @kd);
                    if (sq_ieq(@s[ts], tl, "deferrable\0")) { j = nx; continue; };
                    break;
                };
                if (sq_ieq(@s[ts], tl, "deferrable\0")) { j = nx; continue; };
                if (sq_ieq(@s[ts], tl, "initially\0"))
                {
                    j = nx;
                    nx = sq_tok2(s, j, segend, @ts, @tl, @kd);
                    if (sq_ieq(@s[ts], tl, "deferred\0")) { e.dfr = 1; };
                    j = nx;
                    continue;
                };
                break;
            };
        };

        // Reads the FOREIGN KEY clauses of the table described by ti. Returns the count; fkid numbers follow SQLite
        // (the clause declared last gets id 0).
        def sq_fk_parse(SQ_TI* ti, byte* tname, SQ_FKR* out, int maxn) -> int
        {
            byte* s = ti.base;
            int i, segend, ws, wl, kind, j, cons, k, ts, tl, kd, nx, n, c, q, t2, l2, k2, a;
            n = 0;
            k = 0;
            i = 0;
            while (s[i] != (byte)0 & s[i] != (byte)40) { i++; };
            if (s[i] == (byte)0) { return 0; };
            i++;
            while (s[i] != (byte)0)
            {
                segend = sq_seg_end(s, i);
                j = sq_tok2(s, i, segend, @ws, @wl, @kind);
                if (kind == 0) { break; };
                cons = 0;
                if (kind == 1)
                {
                    if (sq_ieq(@s[ws], wl, "primary\0") | sq_ieq(@s[ws], wl, "unique\0") | sq_ieq(@s[ws], wl, "check\0") | sq_ieq(@s[ws], wl, "foreign\0") | sq_ieq(@s[ws], wl, "constraint\0")) { cons = 1; };
                };
                if (cons == 0)
                {
                    // column definition: look for REFERENCES
                    while (true)
                    {
                        nx = sq_tok2(s, j, segend, @ts, @tl, @kd);
                        if (kd == 0) { break; };
                        j = nx;
                        if (kd == 1)
                        {
                            if (sq_ieq(@s[ts], tl, "references\0") & n < maxn)
                            {
                                sq_fk_name_copy(@out[n].ctab[0], s, 0, 0, 1);
                                for (a = 0; tname[a] != (byte)0 & a < 62; a++) { out[n].ctab[a] = tname[a]; };
                                out[n].ctab[a] = (byte)0;
                                out[n].n = 1;
                                out[n].fc[0] = k;
                                sq_fk_name_copy(@out[n].ccol[0], s, ti.cs[k], ti.cl[k], 1);
                                sq_fk_parse_ref(ti, j, segend, @out[n]);
                                n++;
                                break;
                            };
                        };
                    };
                    k++;
                }
                else
                {
                    if (sq_ieq(@s[ws], wl, "constraint\0"))
                    {
                        j = sq_tok2(s, j, segend, @ws, @wl, @kind);
                        j = sq_tok2(s, j, segend, @ws, @wl, @kind);
                    };
                    if (sq_ieq(@s[ws], wl, "foreign\0") & n < maxn)
                    {
                        j = sq_tok2(s, j, segend, @ts, @tl, @kd);
                        j = sq_tok2(s, j, segend, @ts, @tl, @kd);
                        if (kd == 4)
                        {
                            for (a = 0; tname[a] != (byte)0 & a < 62; a++) { out[n].ctab[a] = tname[a]; };
                            out[n].ctab[a] = (byte)0;
                            out[n].n = 0;
                            q = ts + 1;
                            while (q < ts + tl - 1 & out[n].n < 8)
                            {
                                q = sq_tok2(s, q, ts + tl - 1, @t2, @l2, @k2);
                                if (k2 == 0) { break; };
                                if (k2 == 1 | k2 == 2)
                                {
                                    if (k2 == 2) { c = sq_ti_find(ti, s, t2 + 1, l2 - 2); } else { c = sq_ti_find(ti, s, t2, l2); };
                                    out[n].fc[out[n].n] = c;
                                    sq_fk_name_copy(@out[n].ccol[out[n].n * 64], s, t2, l2, k2);
                                    out[n].n++;
                                };
                            };
                            j = sq_tok2(s, j, segend, @ts, @tl, @kd);
                            if (sq_ieq(@s[ts], tl, "references\0")) { sq_fk_parse_ref(ti, j, segend, @out[n]); };
                            n++;
                        };
                    };
                };
                i = segend;
                if (s[i] == (byte)44) { i++; } else { break; };
            };
            for (i = 0; i < n; i++) { out[i].fkid = n - 1 - i; };
            return n;
        };

        def sq_trg_stmt(SQ_STMT* st, byte* text) -> int;

        def sq_fk_set_dflt(SQ_FKR* e, SQ_TI* ti) -> void
        {
            int k, c, i, n;
            for (k = 0; k < e.n; k++)
            {
                c = e.fc[k];
                e.dflt[k * 64] = (byte)0;
                if (c >= 0 & c < ti.ncols)
                {
                    n = ti.dfl[c];
                    if (n > 62) { n = 62; };
                    if (n > 0)
                    {
                        for (i = 0; i < n; i++) { e.dflt[k * 64 + i] = ti.base[ti.dfs[c] + i]; };
                        e.dflt[k * 64 + n] = (byte)0;
                    };
                };
            };
        };

        def sq_fkr_copy(SQ_FKR* dst, SQ_FKR* src) -> void
        {
            byte* d = (byte*)dst;
            byte* s = (byte*)src;
            int j, n;
            n = (int)(sizeof(SQ_FKR) / 8);
            for (j = 0; j < n; j++) { d[j] = s[j]; };
        };

        // Collects, for the table of tc, its own foreign keys (ch) and those of other tables that reference it (par).
        def sq_fk_collect(SQ_TCTX* tc) -> int
        {
            SQLITE_DB* db = tc.db;
            SQ_FKD* d;
            SQ_TI* ti2;
            SQ_FKR[8] tmp;
            int i, m, k, j, c;
            tc.fkd = (u64)0;
            if (SQ_FK == 0) { return 0; };
            d = (SQ_FKD*)fmalloc((u64)(sizeof(SQ_FKD) / 8 + 64));
            if ((u64)d == (u64)0) { sq_seterr(tc.st, "out of memory\0"); return 1; };
            d.nch = 0; d.npar = 0;
            ti2 = (SQ_TI*)fmalloc((u64)(sizeof(SQ_TI) / 8 + 4096));
            if ((u64)ti2 == (u64)0) { ffree((u64)d); sq_seterr(tc.st, "out of memory\0"); return 1; };
            for (i = 0; i < db.nschema; i++)
            {
                if (db.schema[i].kind != 1) { continue; };
                if ((u64)db.schema[i].sql == (u64)0) { continue; };
                if (sq_ihas(db.schema[i].sql, sq_cstrlen(db.schema[i].sql), "references\0") == false) { continue; };
                if (sq_ti_load(ti2, db.schema[i].sql) != 0) { continue; };
                m = sq_fk_parse(ti2, @db.schema[i].name[0], @tmp[0], 8);
                for (k = 0; k < m; k++)
                {
                    sq_fk_set_dflt(@tmp[k], ti2);
                    if (sq_ci_eq(@tmp[k].ctab[0], @tc.tname[0]))
                    {
                        if (d.nch < 8)
                        {
                            // the child columns are the table's own
                            sq_fkr_copy(@d.ch[d.nch], @tmp[k]);
                            d.nch++;
                        };
                    };
                    if (sq_ci_eq(@tmp[k].ptab[0], @tc.tname[0]))
                    {
                        if (d.npar < 8)
                        {
                            sq_fkr_copy(@d.par[d.npar], @tmp[k]);
                            d.npar++;
                        };
                    };
                };
            };
            ffree((u64)ti2);
            // parent column names (implicit: the primary key) and indexes in this table
            for (i = 0; i < d.npar; i++)
            {
                if (d.par[i].pn == 0)
                {
                    for (j = 0; j < tc.ti.npk & j < 8; j++)
                    {
                        sq_fk_name_copy(@d.par[i].pcol[j * 64], tc.ti.base, tc.ti.cs[tc.ti.pkc[j]], tc.ti.cl[tc.ti.pkc[j]], 1);
                    };
                    d.par[i].pn = tc.ti.npk;
                    if (tc.ti.npk == 0 & tc.ti.ipk >= 0)
                    {
                        sq_fk_name_copy(@d.par[i].pcol[0], tc.ti.base, tc.ti.cs[tc.ti.ipk], tc.ti.cl[tc.ti.ipk], 1);
                        d.par[i].pn = 1;
                    };
                };
                for (j = 0; j < d.par[i].pn; j++)
                {
                    c = sq_ti_find(tc.ti, @d.par[i].pcol[j * 64], 0, sq_cstrlen(@d.par[i].pcol[j * 64]));
                    d.par[i].pc[j] = c;
                };
            };
            if (d.nch == 0 & d.npar == 0) { ffree((u64)d); return 0; };
            tc.fkd = (u64)d;
            return 0;
        };

        def sq_fk_mismatch(SQ_STMT* st, byte* ctab, byte* ptab) -> void
        {
            SQ_SB sb;
            sq_sb_init(@sb);
            sq_sb_lit(@sb, "foreign key mismatch - \"\0");
            sq_sb_lit(@sb, ctab);
            sq_sb_lit(@sb, "\" referencing \"\0");
            sq_sb_lit(@sb, ptab);
            sq_sb_lit(@sb, "\"\0");
            sq_seterr(st, sb.p);
            sq_sb_free(@sb);
        };

        // the WHERE condition matching rows whose key columns equal the values vals[idx[k]]; names are the column names
        def sq_fk_cond(SQ_SB* sb, byte* names, int n, int* idx, SQ_VAL* vals) -> void
        {
            int k;
            for (k = 0; k < n; k++)
            {
                if (k > 0) { sq_sb_lit(sb, " and \0"); };
                sq_sb_ident(sb, @names[k * 64], sq_cstrlen(@names[k * 64]));
                sq_sb_lit(sb, " = \0");
                sq_sb_value(sb, @vals[idx[k]]);
            };
        };

        // number of rows of table tname matching cond (text); -1 on error
        def sq_fk_count(SQ_STMT* st, byte* tname, byte* cond) -> i64
        {
            SQ_SB sb;
            SQ_STMT* sub;
            i64 r;
            sq_sb_init(@sb);
            sq_sb_lit(@sb, "select count(*) from \0");
            sq_sb_ident(@sb, tname, sq_cstrlen(tname));
            sq_sb_lit(@sb, " where \0");
            sq_sb_lit(@sb, cond);
            sub = sq_run_rows(st.db, st, sb.p);
            sq_sb_free(@sb);
            if ((u64)sub == (u64)0) { return (i64)0 - (i64)1; };
            r = sub.res.d[0].i;
            sq_stmt_del(sub);
            return r;
        };

        def sq_fk_nullany(SQ_VAL* vals, int* idx, int n) -> bool
        {
            int k;
            for (k = 0; k < n; k++) { if (vals[idx[k]].t == SQ_NULL) { return true; }; };
            return false;
        };

        // does the parent table of FK e hold a row with the key vals[fc[..]]? 1 yes, 0 no, -1 error. skiprid >= 0 excludes a rowid.
        def sq_fk_parent_has(SQ_STMT* st, SQ_FKR* e, SQ_VAL* vals, i64 skiprid, int useskip) -> int
        {
            SQ_SB sb;
            SQ_STMT* sub;
            int k, r;
            sq_sb_init(@sb);
            sq_sb_lit(@sb, "select 1 from \0");
            sq_sb_ident(@sb, @e.ptab[0], sq_cstrlen(@e.ptab[0]));
            sq_sb_lit(@sb, " where \0");
            for (k = 0; k < e.n; k++)
            {
                if (k > 0) { sq_sb_lit(@sb, " and \0"); };
                sq_sb_ident(@sb, @e.pcol[k * 64], sq_cstrlen(@e.pcol[k * 64]));
                sq_sb_lit(@sb, " = \0");
                sq_sb_value(@sb, @vals[e.fc[k]]);
            };
            if (useskip == 1)
            {
                sq_sb_lit(@sb, " and rowid <> \0");
                sq_sb_int(@sb, skiprid);
            };
            sq_sb_lit(@sb, " limit 1\0");
            sub = sq_run_rows(st.db, st, sb.p);
            sq_sb_free(@sb);
            if ((u64)sub == (u64)0) { return 0 - 1; };
            r = 0;
            if (sub.res.n > 0) { r = 1; };
            sq_stmt_del(sub);
            return r;
        };

        def sq_fk_bump(SQ_FKR* e, i64 d) -> void
        {
            if (e.dfr == 1 | SQ_PRV[9] != 0) { SQ_FKDEF = SQ_FKDEF + (int)d; }
            else { SQ_FKCNT = SQ_FKCNT + (int)d; };
        };

        def sq_fk_fail(SQ_STMT* st) -> int
        {
            sq_seterr(st, "FOREIGN KEY constraint failed\0");
            return 1;
        };

        // checks that the parent key of a child FK is usable (primary key or unique index); 0 ok, 1 mismatch
        def sq_fk_key_ok(SQ_STMT* st, SQ_FKR* e) -> int
        {
            SQLITE_DB* db = st.db;
            SQ_TI* pt;
            SQ_IDX* ixs;
            int pp, n, i, k, j, found, c, ok;
            pp = sq_find_table_n(db, @e.ptab[0], sq_cstrlen(@e.ptab[0]));
            if (pp < 0)
            {
                SQ_SB sb;
                sq_sb_init(@sb);
                sq_sb_lit(@sb, "no such table: main.\0");
                sq_sb_lit(@sb, @e.ptab[0]);
                sq_seterr(st, sb.p);
                sq_sb_free(@sb);
                return 1;
            };
            pt = (SQ_TI*)fmalloc((u64)(sizeof(SQ_TI) / 8 + 4096));
            ixs = (SQ_IDX*)fmalloc((u64)(sizeof(SQ_IDX) / 8 + 8) * (u64)24);
            if ((u64)pt == (u64)0 | (u64)ixs == (u64)0) { sq_seterr(st, "out of memory\0"); return 1; };
            if (sq_ti_load(pt, db.schema[pp].sql) != 0) { ffree((u64)pt); ffree((u64)ixs); return 0; };
            // parent column indexes
            for (k = 0; k < e.n; k++)
            {
                if (e.pn == 0)
                {
                    // implicit: the primary key of the parent
                    if (k < pt.npk) { sq_fk_name_copy(@e.pcol[k * 64], pt.base, pt.cs[pt.pkc[k]], pt.cl[pt.pkc[k]], 1); };
                };
            };
            if (e.pn == 0)
            {
                e.pn = pt.npk;
                if (pt.npk == 0 & pt.ipk >= 0) { sq_fk_name_copy(@e.pcol[0], pt.base, pt.cs[pt.ipk], pt.cl[pt.ipk], 1); e.pn = 1; };
            };
            ok = 0;
            if (e.pn == e.n)
            {
                for (k = 0; k < e.n; k++)
                {
                    c = sq_ti_find(pt, @e.pcol[k * 64], 0, sq_cstrlen(@e.pcol[k * 64]));
                    e.pc[k] = c;
                };
                // set equality with the primary key
                if (pt.npk == e.n)
                {
                    found = 1;
                    for (k = 0; k < e.n; k++)
                    {
                        j = 0;
                        for (i = 0; i < pt.npk; i++) { if (pt.pkc[i] == e.pc[k]) { j = 1; }; };
                        if (j == 0) { found = 0; };
                    };
                    if (found == 1) { ok = 1; };
                };
                if (ok == 0 & e.n == 1 & pt.ipk >= 0) { if (e.pc[0] == pt.ipk) { ok = 1; }; };
                if (ok == 0)
                {
                    n = sq_idx_list(db, pp, pt, ixs, 24);
                    for (i = 0; i < n; i++)
                    {
                        if (ixs[i].unique == 0 | ixs[i].nk != e.n | ixs[i].ok == 0) { continue; };
                        found = 1;
                        for (k = 0; k < e.n; k++)
                        {
                            j = 0;
                            for (c = 0; c < ixs[i].nk; c++) { if (ixs[i].col[c] == e.pc[k]) { j = 1; }; };
                            if (j == 0) { found = 0; };
                        };
                        if (found == 1) { ok = 1; };
                    };
                };
            };
            ffree((u64)pt);
            ffree((u64)ixs);
            if (ok == 0) { sq_fk_mismatch(st, @e.ctab[0], @e.ptab[0]); return 1; };
            return 0;
        };

        // child side: the row nw has been inserted (sign +1) or is about to disappear (sign -1)
        def sq_fk_child_row(SQ_STMT* st, SQ_FKR* e, SQ_VAL* vals, i64 rid, int selfref, int sign) -> int
        {
            int r;
            if (sq_fk_nullany(vals, @e.fc[0], e.n)) { return 0; };
            if (sq_fk_key_ok(st, e) != 0) { return 1; };
            r = sq_fk_parent_has(st, e, vals, rid, 0);
            if (r < 0) { return 1; };
            if (r == 0)
            {
                // a row that is its own parent does not violate
                sq_fk_bump(e, (i64)sign);
            };
            return 0;
        };

        // parent side: rows referencing the key `old` of the parent row (rid) lose it; nw is the new row (null for DELETE)
        def sq_fk_parent_row(SQ_STMT* st, SQ_TCTX* tc, SQ_FKR* e, SQ_VAL* old, SQ_VAL* nw, i64 rid, int isupd) -> int
        {
            SQ_SB cond;
            SQ_SB q;
            i64 n;
            int k, act, r;
            SQ_VAL nv;
            if (sq_fk_key_ok(st, e) != 0) { return 1; };
            if (sq_fk_nullany(old, @e.pc[0], e.n)) { return 0; };
            sq_sb_init(@cond);
            for (k = 0; k < e.n; k++)
            {
                if (k > 0) { sq_sb_lit(@cond, " and \0"); };
                sq_sb_ident(@cond, @e.ccol[k * 64], sq_cstrlen(@e.ccol[k * 64]));
                sq_sb_lit(@cond, " = \0");
                sq_sb_value(@cond, @old[e.pc[k]]);
            };
            if (sq_ci_eq(@e.ctab[0], @tc.tname[0]))
            {
                sq_sb_lit(@cond, " and rowid <> \0");
                sq_sb_int(@cond, rid);
            };
            n = sq_fk_count(st, @e.ctab[0], cond.p);
            if (n < (i64)0) { sq_sb_free(@cond); return 1; };
            if (n == (i64)0) { sq_sb_free(@cond); return 0; };
            act = e.ondel;
            if (isupd == 1) { act = e.onupd; };
            r = 0;
            if (act == 1) { sq_sb_free(@cond); return sq_fk_fail(st); };
            if (act == 0)
            {
                sq_fk_bump(e, n);
                sq_sb_free(@cond);
                return 0;
            };
            if (SQ_FKDEPTH > 30) { sq_sb_free(@cond); sq_seterr(st, "too many levels of trigger recursion\0"); return 1; };
            sq_sb_init(@q);
            if (act == 4 & isupd == 0)
            {
                sq_sb_lit(@q, "delete from \0");
                sq_sb_ident(@q, @e.ctab[0], sq_cstrlen(@e.ctab[0]));
                sq_sb_lit(@q, " where \0");
                sq_sb_lit(@q, cond.p);
            }
            else
            {
                sq_sb_lit(@q, "update \0");
                sq_sb_ident(@q, @e.ctab[0], sq_cstrlen(@e.ctab[0]));
                sq_sb_lit(@q, " set \0");
                for (k = 0; k < e.n; k++)
                {
                    if (k > 0) { sq_sb_lit(@q, ", \0"); };
                    sq_sb_ident(@q, @e.ccol[k * 64], sq_cstrlen(@e.ccol[k * 64]));
                    sq_sb_lit(@q, " = \0");
                    if (act == 4) { sq_sb_value(@q, @nw[e.pc[k]]); }
                    else
                    {
                        if (act == 2) { sq_sb_lit(@q, "null\0"); }
                        else
                        {
                            if (e.dflt[k * 64] == (byte)0) { sq_sb_lit(@q, "null\0"); }
                            else { sq_sb_lit(@q, @e.dflt[k * 64]); };
                        };
                    };
                };
                sq_sb_lit(@q, " where \0");
                sq_sb_lit(@q, cond.p);
            };
            sq_sb_free(@cond);
            SQ_FKDEPTH++;
            r = sq_trg_stmt(st, q.p);
            SQ_FKDEPTH--;
            sq_sb_free(@q);
            return r;
        };

        // un-violation: children already pointing at the key of a newly present parent row
        def sq_fk_parent_new(SQ_STMT* st, SQ_TCTX* tc, SQ_FKR* e, SQ_VAL* nw, i64 rid) -> int
        {
            SQ_SB cond;
            i64 n;
            int k;
            if (sq_fk_nullany(nw, @e.pc[0], e.n)) { return 0; };
            sq_sb_init(@cond);
            for (k = 0; k < e.n; k++)
            {
                if (k > 0) { sq_sb_lit(@cond, " and \0"); };
                sq_sb_ident(@cond, @e.ccol[k * 64], sq_cstrlen(@e.ccol[k * 64]));
                sq_sb_lit(@cond, " = \0");
                sq_sb_value(@cond, @nw[e.pc[k]]);
            };
            if (sq_ci_eq(@e.ctab[0], @tc.tname[0]))
            {
                sq_sb_lit(@cond, " and rowid <> \0");
                sq_sb_int(@cond, rid);
            };
            n = sq_fk_count(st, @e.ctab[0], cond.p);
            sq_sb_free(@cond);
            if (n < (i64)0) { return 1; };
            if (n > (i64)0) { sq_fk_bump(e, (i64)0 - n); };
            return 0;
        };

        def sq_fk_keys_same(SQ_FKR* e, SQ_VAL* a, SQ_VAL* b, int parent) -> bool
        {
            int k, c;
            for (k = 0; k < e.n; k++)
            {
                c = e.fc[k];
                if (parent == 1) { c = e.pc[k]; };
                if (sq_val_same(@a[c], @b[c]) == false) { return false; };
            };
            return true;
        };

        // hooks called by the DML loops. They return 0, or 1 with the error set.
        def sq_fk_insert(SQ_STMT* st, SQ_TCTX* tc, SQ_VAL* nw, i64 rid) -> int
        {
            SQ_FKD* d = (SQ_FKD*)tc.fkd;
            int i;
            if ((u64)d == (u64)0) { return 0; };
            for (i = 0; i < d.nch; i++)
            {
                if (sq_fk_child_row(st, @d.ch[i], nw, rid, 0, 1) != 0) { return 1; };
            };
            for (i = 0; i < d.npar; i++)
            {
                if (d.par[i].pn == 0) { continue; };
                if (sq_fk_parent_new(st, tc, @d.par[i], nw, rid) != 0) { return 1; };
            };
            return 0;
        };

        def sq_fk_delete(SQ_STMT* st, SQ_TCTX* tc, SQ_VAL* old, i64 rid) -> int
        {
            SQ_FKD* d = (SQ_FKD*)tc.fkd;
            int i;
            if ((u64)d == (u64)0) { return 0; };
            for (i = 0; i < d.npar; i++)
            {
                if (sq_fk_parent_row(st, tc, @d.par[i], old, old, rid, 0) != 0) { return 1; };
            };
            for (i = 0; i < d.nch; i++)
            {
                if (sq_fk_child_row(st, @d.ch[i], old, rid, 0, 0 - 1) != 0) { return 1; };
            };
            return 0;
        };

        def sq_fk_update(SQ_STMT* st, SQ_TCTX* tc, SQ_VAL* old, SQ_VAL* nw, i64 rid) -> int
        {
            SQ_FKD* d = (SQ_FKD*)tc.fkd;
            int i;
            if ((u64)d == (u64)0) { return 0; };
            for (i = 0; i < d.nch; i++)
            {
                if (sq_fk_keys_same(@d.ch[i], old, nw, 0)) { continue; };
                if (sq_fk_child_row(st, @d.ch[i], old, rid, 0, 0 - 1) != 0) { return 1; };
                if (sq_fk_child_row(st, @d.ch[i], nw, rid, 0, 1) != 0) { return 1; };
            };
            for (i = 0; i < d.npar; i++)
            {
                if (d.par[i].pn == 0 & d.par[i].n > 0) { continue; };
                if (sq_fk_keys_same(@d.par[i], old, nw, 1)) { continue; };
                if (sq_fk_parent_row(st, tc, @d.par[i], old, nw, rid, 1) != 0) { return 1; };
                if (d.par[i].pn == 0) { continue; };
                if (sq_fk_parent_new(st, tc, @d.par[i], nw, rid) != 0) { return 1; };
            };
            return 0;
        };

        // PRAGMA foreign_key_list(table)
        def sq_pr_fk_list(SQ_STMT* st, byte* nm, int nl, byte** pq) -> int
        {
            SQLITE_DB* db = st.db;
            SQ_PQ q;
            SQ_TI* ti;
            SQ_FKR* f;
            int tp, n, i, k, ord;
            byte* act;
            sq_pq_begin(@q, "id,seq,table,from,to,on_update,on_delete,match\0");
            tp = sq_find_table_n(db, nm, nl);
            if (tp < 0) { sq_pq_done(@q, pq); return 0; };
            ti = (SQ_TI*)fmalloc((u64)(sizeof(SQ_TI) / 8 + 4096));
            f = (SQ_FKR*)fmalloc((u64)(sizeof(SQ_FKR) / 8 + 8) * (u64)16);
            if ((u64)ti == (u64)0 | (u64)f == (u64)0) { sq_seterr(st, "out of memory\0"); sq_sb_free(@q.sb); return 1; };
            if (sq_ti_load(ti, db.schema[tp].sql) != 0) { ffree((u64)ti); ffree((u64)f); sq_sb_free(@q.sb); return 1; };
            n = sq_fk_parse(ti, @db.schema[tp].name[0], f, 16);
            // ids ascending: the last declared clause first
            for (ord = 0; ord < n; ord++)
            {
                i = n - 1 - ord;
                for (k = 0; k < f[i].n; k++)
                {
                    sq_pq_row(@q);
                    sq_pq_int(@q, (i64)ord);
                    sq_pq_int(@q, (i64)k);
                    sq_pq_str(@q, @f[i].ptab[0], sq_cstrlen(@f[i].ptab[0]));
                    sq_pq_str(@q, @f[i].ccol[k * 64], sq_cstrlen(@f[i].ccol[k * 64]));
                    if (k < f[i].pn) { sq_pq_str(@q, @f[i].pcol[k * 64], sq_cstrlen(@f[i].pcol[k * 64])); } else { sq_pq_null(@q); };
                    act = "NO ACTION\0";
                    if (f[i].onupd == 1) { act = "RESTRICT\0"; };
                    if (f[i].onupd == 2) { act = "SET NULL\0"; };
                    if (f[i].onupd == 3) { act = "SET DEFAULT\0"; };
                    if (f[i].onupd == 4) { act = "CASCADE\0"; };
                    sq_pq_lit(@q, act);
                    act = "NO ACTION\0";
                    if (f[i].ondel == 1) { act = "RESTRICT\0"; };
                    if (f[i].ondel == 2) { act = "SET NULL\0"; };
                    if (f[i].ondel == 3) { act = "SET DEFAULT\0"; };
                    if (f[i].ondel == 4) { act = "CASCADE\0"; };
                    sq_pq_lit(@q, act);
                    sq_pq_lit(@q, "NONE\0");
                };
            };
            ffree((u64)ti);
            ffree((u64)f);
            sq_pq_done(@q, pq);
            return 0;
        };

        // PRAGMA foreign_key_check [(table)]: one SELECT per foreign key, joined with UNION ALL
        def sq_pr_fk_check(SQ_STMT* st, int found, byte* nm, int nl, byte** pq) -> int
        {
            SQLITE_DB* db = st.db;
            SQ_PQ q;
            SQ_TI* ti;
            SQ_FKR* f;
            SQ_TI* pt;
            int t, n, i, k, pp;
            sq_pq_begin(@q, "table,rowid,parent,fkid\0");
            ti = (SQ_TI*)fmalloc((u64)(sizeof(SQ_TI) / 8 + 4096));
            pt = (SQ_TI*)fmalloc((u64)(sizeof(SQ_TI) / 8 + 4096));
            f = (SQ_FKR*)fmalloc((u64)(sizeof(SQ_FKR) / 8 + 8) * (u64)16);
            if ((u64)ti == (u64)0 | (u64)f == (u64)0 | (u64)pt == (u64)0) { sq_seterr(st, "out of memory\0"); sq_sb_free(@q.sb); return 1; };
            for (t = 0; t < db.nschema; t++)
            {
                if (db.schema[t].kind != 1) { continue; };
                if ((u64)db.schema[t].sql == (u64)0) { continue; };
                if (found == 1) { if (sq_name_is(nm, nl, @db.schema[t].name[0]) == false) { continue; }; };
                if (sq_ihas(db.schema[t].sql, sq_cstrlen(db.schema[t].sql), "references\0") == false) { continue; };
                if (sq_ti_load(ti, db.schema[t].sql) != 0) { continue; };
                n = sq_fk_parse(ti, @db.schema[t].name[0], f, 16);
                for (i = 0; i < n; i++)
                {
                    pp = sq_find_table_n(db, @f[i].ptab[0], sq_cstrlen(@f[i].ptab[0]));
                    if (pp < 0) { continue; };
                    if (sq_fk_key_ok(st, @f[i]) != 0) { ffree((u64)ti); ffree((u64)f); ffree((u64)pt); sq_sb_free(@q.sb); return 1; };
                    if (f[i].pn == 0)
                    {
                        if (sq_ti_load(pt, db.schema[pp].sql) == 0)
                        {
                            for (k = 0; k < pt.npk & k < 8; k++) { sq_fk_name_copy(@f[i].pcol[k * 64], pt.base, pt.cs[pt.pkc[k]], pt.cl[pt.pkc[k]], 1); };
                            f[i].pn = pt.npk;
                            if (pt.npk == 0 & pt.ipk >= 0) { sq_fk_name_copy(@f[i].pcol[0], pt.base, pt.cs[pt.ipk], pt.cl[pt.ipk], 1); f[i].pn = 1; };
                        };
                    };
                    sq_sb_lit(@q.sb, " union all select \0");
                    sq_sb_lit(@q.sb, "'\0");
                    sq_sb_add(@q.sb, @f[i].ctab[0], sq_cstrlen(@f[i].ctab[0]));
                    sq_sb_lit(@q.sb, "', rowid, '\0");
                    sq_sb_add(@q.sb, @f[i].ptab[0], sq_cstrlen(@f[i].ptab[0]));
                    sq_sb_lit(@q.sb, "', \0");
                    sq_sb_int(@q.sb, (i64)f[i].fkid);
                    sq_sb_lit(@q.sb, " from \0");
                    sq_sb_ident(@q.sb, @f[i].ctab[0], sq_cstrlen(@f[i].ctab[0]));
                    sq_sb_lit(@q.sb, " where \0");
                    for (k = 0; k < f[i].n; k++)
                    {
                        sq_sb_ident(@q.sb, @f[i].ccol[k * 64], sq_cstrlen(@f[i].ccol[k * 64]));
                        sq_sb_lit(@q.sb, " is not null and \0");
                    };
                    sq_sb_lit(@q.sb, "not exists (select 1 from \0");
                    sq_sb_ident(@q.sb, @f[i].ptab[0], sq_cstrlen(@f[i].ptab[0]));
                    sq_sb_lit(@q.sb, " where \0");
                    for (k = 0; k < f[i].n; k++)
                    {
                        if (k > 0) { sq_sb_lit(@q.sb, " and \0"); };
                        sq_sb_ident(@q.sb, @f[i].pcol[k * 64], sq_cstrlen(@f[i].pcol[k * 64]));
                        sq_sb_lit(@q.sb, " = \0");
                        sq_sb_ident(@q.sb, @f[i].ctab[0], sq_cstrlen(@f[i].ctab[0]));
                        sq_sb_lit(@q.sb, ".\0");
                        sq_sb_ident(@q.sb, @f[i].ccol[k * 64], sq_cstrlen(@f[i].ccol[k * 64]));
                    };
                    sq_sb_lit(@q.sb, ")\0");
                };
            };
            ffree((u64)ti);
            ffree((u64)f);
            ffree((u64)pt);
            sq_pq_done(@q, pq);
            return 0;
        };

        // true when the table is referenced by a foreign key of another table
        def sq_fk_is_parent(SQLITE_DB* db, byte* tname) -> bool
        {
            SQ_TI* ti;
            SQ_FKR[8] tmp;
            int i, m, k;
            bool r;
            if (SQ_FK == 0) { return false; };
            ti = (SQ_TI*)fmalloc((u64)(sizeof(SQ_TI) / 8 + 4096));
            if ((u64)ti == (u64)0) { return false; };
            r = false;
            for (i = 0; i < db.nschema; i++)
            {
                if (db.schema[i].kind != 1) { continue; };
                if ((u64)db.schema[i].sql == (u64)0) { continue; };
                if (sq_ihas(db.schema[i].sql, sq_cstrlen(db.schema[i].sql), "references\0") == false) { continue; };
                if (sq_ti_load(ti, db.schema[i].sql) != 0) { continue; };
                m = sq_fk_parse(ti, @db.schema[i].name[0], @tmp[0], 8);
                for (k = 0; k < m; k++)
                {
                    if (sq_ci_eq(@tmp[k].ptab[0], tname)) { r = true; };
                };
            };
            ffree((u64)ti);
            return r;
        };

        // one error line of integrity_check
        def sq_ic_err(SQ_PQ* q, int* nerr, byte* a, byte* b, byte* c, i64 n, int usen) -> void
        {
            SQ_SB sb;
            if (*nerr >= 100) { *nerr = *nerr + 1; return; };
            sq_sb_init(@sb);
            sq_sb_lit(@sb, a);
            if (usen == 1) { sq_sb_int(@sb, n); };
            sq_sb_lit(@sb, b);
            sq_sb_lit(@sb, c);
            sq_pq_row(q);
            sq_pq_str(q, sb.p, sq_cstrlen(sb.p));
            sq_sb_free(@sb);
            *nerr = *nerr + 1;
        };

        // ---- b-tree page structure check (integrity_check, quick_check) ----

        struct SQ_ICP
        {
            SQLITE_DB* db;
            byte* map;
            byte* bufs;
            byte* heaps;
            SQ_SB msg;
            int nmsg, root, leafdepth;
            i64 retmin;
        };

        // starts a message: "Tree <root> page <pg>" with optional " cell <cell>" and the colon
        def sq_icp_begin(SQ_ICP* c, SQ_SB* sb, int pg, int cell) -> void
        {
            sq_sb_init(sb);
            sq_sb_lit(sb, "Tree \0");
            sq_sb_int(sb, (i64)c.root);
            sq_sb_lit(sb, " page \0");
            sq_sb_int(sb, (i64)pg);
            if (cell >= 0) { sq_sb_lit(sb, " cell \0"); sq_sb_int(sb, (i64)cell); };
            sq_sb_lit(sb, ": \0");
        };

        // appends a finished message
        def sq_icp_end(SQ_ICP* c, SQ_SB* sb) -> void
        {
            if (c.nmsg < 100)
            {
                if (c.msg.n > 0) { sq_sb_lit(@c.msg, "\n\0"); };
                sq_sb_add(@c.msg, sb.p, sb.n);
            };
            c.nmsg++;
            sq_sb_free(sb);
        };

        def sq_icp_plain(SQ_ICP* c, byte* text, i64 n1) -> void
        {
            SQ_SB sb;
            sq_sb_init(@sb);
            sq_sb_lit(@sb, text);
            sq_icp_end(c, @sb);
        };

        // marks a page as used. Returns 1 when the number is bad or the page was used before.
        def sq_icp_ref(SQ_ICP* c, int pg, int ctxpg, int ctxcell) -> int
        {
            SQ_SB sb;
            if (pg < 1 | pg > c.db.npages)
            {
                if (c.root != 0) { sq_icp_begin(c, @sb, ctxpg, ctxcell); } else { sq_sb_init(@sb); sq_sb_lit(@sb, "Freelist: \0"); };
                sq_sb_lit(@sb, "invalid page number \0");
                sq_sb_int(@sb, (i64)pg);
                sq_icp_end(c, @sb);
                return 1;
            };
            if (c.map[pg] != (byte)0)
            {
                if (c.root != 0) { sq_icp_begin(c, @sb, ctxpg, ctxcell); } else { sq_sb_init(@sb); };
                sq_sb_lit(@sb, "2nd reference to page \0");
                sq_sb_int(@sb, (i64)pg);
                sq_icp_end(c, @sb);
                return 1;
            };
            c.map[pg] = (byte)1;
            return 0;
        };

        // marks the bytes [a, b) of the page map. Returns the first byte already in use, or -1.
        def sq_icp_use(byte* hpm, int a, int b, int ps) -> int
        {
            int i, bad;
            bad = 0 - 1;
            if (a < 0) { a = 0; };
            if (b > ps) { b = ps; };
            for (i = a; i < b; i++)
            {
                if (hpm[i] != (byte)0) { if (bad < 0) { bad = i; }; };
                hpm[i] = (byte)1;
            };
            return bad;
        };

        def sq_icp_bad(SQ_ICP* c, int pg, int cell, byte* text) -> void
        {
            SQ_SB sb;
            sq_icp_begin(c, @sb, pg, cell);
            sq_sb_lit(@sb, text);
            sq_icp_end(c, @sb);
        };

        def sq_icp_walk(SQ_ICP* c, int pg, int depth, i64 maxkey, int cpg, int ccell) -> int
        {
            SQLITE_DB* db = c.db;
            SQ_SB sb;
            byte* page;
            byte* buf;
            byte* hpm;
            int ps, U, ho, t, leaf, ncell, cstart, hsz, ptrend, fb, fsz, i, off, sz, nv1, nv2, lcl, ovf, expected, cnt;
            int child, d, d0, bad, nfrag, mxl, mnl, k, over, refbad, kce, usedbad, nerr0;
            u64 psz, rid;
            i64 key, inkey;
            ps = db.page_size;
            U = db.usable;
            inkey = maxkey;
            c.retmin = maxkey;
            if (depth >= 19) { return 0 - 1; };
            if (sq_icp_ref(c, pg, cpg, ccell) != 0) { return 0 - 1; };
            page = sq_page(db, pg);
            if ((u64)page == (u64)0) { sq_icp_bad(c, pg, 0 - 1, "unable to get the page\0"); return 0 - 1; };
            buf = @c.bufs[depth * ps];
            hpm = @c.heaps[depth * ps];
            sq_mcpy(buf, page, ps);
            for (i = 0; i < ps; i++) { hpm[i] = (byte)0; };
            ho = sq_hdr_off(pg);
            t = (int)buf[ho];
            if (t != 2 & t != 5 & t != 10 & t != 13)
            {
                sq_icp_bad(c, pg, 0 - 1, "btreeInitPage() returns error code 11\0");
                return 0 - 1;
            };
            leaf = 0;
            if (t == 10 | t == 13) { leaf = 1; };
            ncell = sq_be16(@buf[ho + 3]);
            cstart = sq_be16(@buf[ho + 5]);
            if (cstart == 0) { cstart = 65536; };
            hsz = 8;
            if (leaf == 0) { hsz = 12; };
            ptrend = ho + hsz + 2 * ncell;
            if (ptrend > U | cstart > U | cstart < ptrend)
            {
                sq_icp_bad(c, pg, 0 - 1, "free space corruption\0");
                return 0 - 1;
            };
            sq_icp_use(hpm, 0, ptrend, ps);
            nerr0 = c.nmsg;
            d0 = 0 - 1;
            kce = 1;
            // the right-most child is checked first
            if (leaf == 0)
            {
                child = sq_be32(@buf[ho + 8]);
                d = sq_icp_walk(c, child, depth + 1, maxkey, pg, ncell);
                if (t == 5) { maxkey = c.retmin; };
                kce = 0;
                if (d >= 0) { d0 = d; };
            };
            usedbad = 0;
            for (i = ncell - 1; i >= 0; i--)
            {
                off = sq_be16(@buf[ho + hsz + 2 * i]);
                if (off < cstart | off > U - 4)
                {
                    sq_sb_init(@sb);
                    sq_icp_begin(c, @sb, pg, i);
                    sq_sb_lit(@sb, "Offset \0"); sq_sb_int(@sb, (i64)off);
                    sq_sb_lit(@sb, " out of range \0"); sq_sb_int(@sb, (i64)cstart);
                    sq_sb_lit(@sb, "..\0"); sq_sb_int(@sb, (i64)(U - 4));
                    sq_icp_end(c, @sb);
                    continue;
                };
                child = 0;
                k = off;
                if (leaf == 0) { child = sq_be32(@buf[k]); k = k + 4; };
                key = (i64)0;
                over = 0;
                lcl = 0;
                psz = (u64)0;
                if (t == 5)
                {
                    nv1 = sq_varint(@buf[k], @rid);
                    key = (i64)rid;
                    sz = 4 + nv1;
                }
                else
                {
                    nv1 = sq_varint(@buf[k], @psz);
                    k = k + nv1;
                    nv2 = 0;
                    if (t == 13) { nv2 = sq_varint(@buf[k], @rid); key = (i64)rid; };
                    k = k + nv2;
                    if (t == 13)
                    {
                        mxl = U - 35;
                        mnl = ((U - 12) * 32 / 255) - 23;
                        if ((int)psz <= mxl) { lcl = (int)psz; }
                        else
                        {
                            lcl = mnl + (((int)psz - mnl) % (U - 4));
                            if (lcl > mxl) { lcl = mnl; };
                        };
                    }
                    else { lcl = sq_ilocal(db, (int)psz); };
                    sz = k - off + lcl;
                    if (lcl < (int)psz) { over = 1; sz = sz + 4; };
                };
                if (off + sz > U)
                {
                    sq_icp_bad(c, pg, i, "Extends off end of page\0");
                    continue;
                };
                bad = sq_icp_use(hpm, off, off + sz, ps);
                if (bad >= 0 & usedbad == 0)
                {
                    usedbad = 1;
                    sq_sb_init(@sb);
                    sq_sb_lit(@sb, "Multiple uses for byte \0"); sq_sb_int(@sb, (i64)bad);
                    sq_sb_lit(@sb, " of page \0"); sq_sb_int(@sb, (i64)pg);
                    sq_icp_end(c, @sb);
                };
                if (over == 1)
                {
                    ovf = sq_be32(@buf[off + sz - 4]);
                    expected = ((int)psz - lcl + (U - 4) - 1) / (U - 4);
                    cnt = 0;
                    refbad = 0;
                    while (ovf != 0 & cnt < expected)
                    {
                        if (sq_icp_ref(c, ovf, pg, i) != 0) { refbad = 1; ovf = 0; break; };
                        page = sq_page(db, ovf);
                        if ((u64)page == (u64)0) { ovf = 0; break; };
                        ovf = sq_be32(page);
                        cnt++;
                    };
                    if (cnt < expected & refbad == 0)
                    {
                        sq_icp_begin(c, @sb, pg, i);
                        sq_sb_lit(@sb, "overflow list length is \0"); sq_sb_int(@sb, (i64)cnt);
                        sq_sb_lit(@sb, " but should be \0"); sq_sb_int(@sb, (i64)expected);
                        sq_icp_end(c, @sb);
                    };
                };
                if (t == 13 | t == 5)
                {
                    bad = 0;
                    if (kce == 1) { if (key > maxkey) { bad = 1; }; } else { if (key >= maxkey) { bad = 1; }; };
                    if (bad == 1)
                    {
                        sq_icp_begin(c, @sb, pg, i);
                        sq_sb_lit(@sb, "Rowid \0"); sq_sb_int(@sb, key);
                        sq_sb_lit(@sb, " out of order\0");
                        sq_icp_end(c, @sb);
                    };
                    maxkey = key;
                    kce = 0;
                };
                if (leaf == 0)
                {
                    d = sq_icp_walk(c, child, depth + 1, maxkey, pg, i);
                    if (t == 5) { maxkey = c.retmin; };
                    if (d >= 0)
                    {
                        if (d0 < 0) { d0 = d; };
                        if (d != d0) { sq_icp_bad(c, pg, 0 - 1, "Child page depth differs\0"); };
                    };
                };
            };
            // free blocks
            fb = sq_be16(@buf[ho + 1]);
            while (fb != 0)
            {
                if (fb < cstart | fb > U - 4) { sq_icp_bad(c, pg, 0 - 1, "free space corruption\0"); break; };
                fsz = sq_be16(@buf[fb + 2]);
                if (fb + fsz > U) { sq_icp_bad(c, pg, 0 - 1, "free space corruption\0"); break; };
                bad = sq_icp_use(hpm, fb, fb + fsz, ps);
                if (bad >= 0 & usedbad == 0)
                {
                    usedbad = 1;
                    sq_sb_init(@sb);
                    sq_sb_lit(@sb, "Multiple uses for byte \0"); sq_sb_int(@sb, (i64)bad);
                    sq_sb_lit(@sb, " of page \0"); sq_sb_int(@sb, (i64)pg);
                    sq_icp_end(c, @sb);
                };
                child = sq_be16(@buf[fb]);
                if (child != 0 & child <= fb + fsz - 1) { sq_icp_bad(c, pg, 0 - 1, "free space corruption\0"); break; };
                fb = child;
            };
            // unused bytes between the cells must match the fragment count of the header
            nfrag = 0;
            for (i = cstart; i < U; i++) { if (hpm[i] == (byte)0) { nfrag++; }; };
            if (nfrag != (int)buf[ho + 7] & nerr0 == c.nmsg)
            {
                sq_sb_init(@sb);
                sq_sb_lit(@sb, "Fragmentation of \0"); sq_sb_int(@sb, (i64)nfrag);
                sq_sb_lit(@sb, " bytes reported as \0"); sq_sb_int(@sb, (i64)buf[ho + 7]);
                sq_sb_lit(@sb, " on page \0"); sq_sb_int(@sb, (i64)pg);
                sq_icp_end(c, @sb);
            };
            if (t == 13 | t == 5) { c.retmin = maxkey; } else { c.retmin = inkey; };
            if (d0 < 0) { return 1; };
            return d0 + 1;
        };

        // checks the freelist, every b-tree and the page accounting. Adds the first result row when something is wrong.
        def sq_ic_pages(SQ_STMT* st, SQ_PQ* q, int* nerr) -> int
        {
            SQLITE_DB* db = st.db;
            SQ_ICP c;
            SQ_SB sb;
            byte* page;
            int trunk, n, j, k, i, ps, lv;
            ps = db.page_size;
            c.db = db;
            c.map = (byte*)fmalloc((u64)(db.npages + 4));
            c.bufs = (byte*)fmalloc((u64)ps * (u64)20);
            c.heaps = (byte*)fmalloc((u64)ps * (u64)20);
            if ((u64)c.map == (u64)0 | (u64)c.bufs == (u64)0 | (u64)c.heaps == (u64)0) { return 0; };
            for (i = 0; i < db.npages + 4; i++) { c.map[i] = (byte)0; };
            sq_sb_init(@c.msg);
            c.nmsg = 0; c.root = 0; c.leafdepth = 0 - 1;
            // freelist
            trunk = db.ftrunk;
            n = 0;
            lv = 0;
            while (trunk != 0 & lv < 100000)
            {
                lv++;
                c.root = 0;
                if (sq_icp_ref(@c, trunk, trunk, 0 - 1) != 0) { break; };
                page = sq_page(db, trunk);
                if ((u64)page == (u64)0) { break; };
                k = sq_be32(@page[4]);
                if (k > (db.usable / 4) - 2)
                {
                    sq_sb_init(@sb);
                    sq_sb_lit(@sb, "Freelist: freelist leaf count too big on page \0"); sq_sb_int(@sb, (i64)trunk);
                    sq_icp_end(@c, @sb);
                    break;
                };
                n = n + 1;
                for (j = 0; j < k; j++)
                {
                    page = sq_page(db, trunk);
                    if ((u64)page == (u64)0) { break; };
                    if (sq_icp_ref(@c, sq_be32(@page[8 + 4 * j]), trunk, 0 - 1) == 0) { n = n + 1; };
                };
                page = sq_page(db, trunk);
                if ((u64)page == (u64)0) { break; };
                trunk = sq_be32(page);
            };
            if (n != db.fcount)
            {
                sq_sb_init(@sb);
                sq_sb_lit(@sb, "Freelist: size is \0"); sq_sb_int(@sb, (i64)n);
                sq_sb_lit(@sb, " but should be \0"); sq_sb_int(@sb, (i64)db.fcount);
                sq_icp_end(@c, @sb);
            };
            // trees
            c.root = 1;
            sq_icp_walk(@c, 1, 0, (i64)9223372036854775807, 1, 0 - 1);
            for (i = 0; i < db.nschema; i++)
            {
                if (db.schema[i].rootpage < 2) { continue; };
                if (db.schema[i].kind != 1 & db.schema[i].kind != 2) { continue; };
                c.root = db.schema[i].rootpage;
                sq_icp_walk(@c, db.schema[i].rootpage, 0, (i64)9223372036854775807, db.schema[i].rootpage, 0 - 1);
            };
            for (i = 2; i <= db.npages; i++)
            {
                if (c.map[i] == (byte)0 & i != (1073741824 / db.page_size) + 1)
                {
                    sq_sb_init(@sb);
                    sq_sb_lit(@sb, "Page \0"); sq_sb_int(@sb, (i64)i);
                    sq_sb_lit(@sb, ": never used\0");
                    sq_icp_end(@c, @sb);
                };
            };
            if (c.nmsg > 0)
            {
                sq_sb_init(@sb);
                sq_sb_lit(@sb, "*** in database main ***\n\0");
                sq_sb_add(@sb, c.msg.p, c.msg.n);
                sq_pq_row(q);
                sq_pq_str(q, sb.p, sb.n);
                sq_sb_free(@sb);
                *nerr = *nerr + c.nmsg;
            };
            sq_sb_free(@c.msg);
            ffree((u64)c.map);
            ffree((u64)c.bufs);
            ffree((u64)c.heaps);
            return 0;
        };

        // table / index consistency: NOT NULL, CHECK, and every index entry against its row. quick skips the index scan.
        def sq_pragma_check(SQ_STMT* st, int quick, byte** pq) -> int
        {
            SQLITE_DB* db = st.db;
            SQ_PQ q;
            SQ_TCTX* tc;
            SQ_CURSOR cur;
            SQ_ICUR ic;
            SQ_IPATH pa;
            SQ_ARENA ar;
            SQ_CHK chk;
            SQ_VAL* row;
            SQ_VAL[20] key;
            int[20] cnt;
            int nerr, i, c, k, ok, kr, ntot, nm;
            byte[72] nmv;
            SQ_SB sb;
            nerr = 0;
            if (quick == 1) { sq_pq_begin(@q, "quick_check\0"); } else { sq_pq_begin(@q, "integrity_check\0"); };
            sq_ic_pages(st, @q, @nerr);
            for (i = 0; i < db.nschema; i++)
            {
                if (db.schema[i].kind != 1) { continue; };
                if ((u64)db.schema[i].sql == (u64)0) { continue; };
                if (sq_ihas(db.schema[i].sql, 14, "create virtual\0")) { continue; };
                tc = (SQ_TCTX*)fmalloc((u64)(sizeof(SQ_TCTX) / 8 + 4096));
                if ((u64)tc == (u64)0) { continue; };
                tc.ti = (SQ_TI*)0;
                nm = sq_cstrlen(@db.schema[i].name[0]);
                if (sq_tc_open(db, st, @db.schema[i].name[0], nm, tc) != 0)
                {
                    st.err[0] = (byte)0;
                    sq_tc_free(tc); ffree((u64)tc);
                    continue;
                };
                row = (SQ_VAL*)fmalloc((u64)(tc.ncols + 2) * (u64)sizeof(SQ_VAL));
                if ((u64)row == (u64)0) { sq_tc_free(tc); ffree((u64)tc); continue; };
                sq_ar_init(@ar);
                chk.st = (SQ_STMT*)0; chk.n = 0;
                if (sq_chk_open(tc, @chk) != 0) { st.err[0] = (byte)0; };
                for (k = 0; k < tc.nix; k++) { cnt[k] = 0; };
                sq_cur_open(@cur, db, tc.root);
                ok = sq_cur_first(@cur);
                while (ok == 1)
                {
                    sq_ar_reset(@ar);
                    sq_tc_row(tc, @cur, @ar, row);
                    for (c = 0; c < tc.ncols; c++)
                    {
                        if (tc.ti.notnull[c] == 1 & c != tc.ti.ipk & tc.ti.gen[c] != 1)
                        {
                            if (row[c].t == SQ_NULL)
                            {
                                sq_sb_init(@sb);
                                sq_sb_lit(@sb, "NULL value in \0");
                                sq_sb_lit(@sb, @tc.tname[0]);
                                sq_sb_lit(@sb, ".\0");
                                sq_sb_add(@sb, @tc.ti.base[tc.ti.cs[c]], tc.ti.cl[c]);
                                if (nerr < 100) { sq_pq_row(@q); sq_pq_str(@q, sb.p, sq_cstrlen(sb.p)); };
                                nerr++;
                                sq_sb_free(@sb);
                            };
                        };
                    };
                    if ((u64)chk.st != (u64)0)
                    {
                        if (sq_chk_run(tc, @chk, row) != 0)
                        {
                            st.err[0] = (byte)0;
                            sq_ic_err(@q, @nerr, "CHECK constraint failed in \0", "\0", @tc.tname[0], (i64)0, 0);
                        };
                    };
                    if (quick == 0)
                    {
                        for (k = 0; k < tc.nix; k++)
                        {
                            kr = sq_tc_ixrow(tc, @tc.ix[k], row, @key[0], @ar);
                            if (kr == 2) { st.err[0] = (byte)0; continue; };
                            if (kr == 0) { continue; };
                            cnt[k]++;
                            sq_icur_open(@ic, db, @tc.ix[k]);
                            if (sq_ix_descend(@ic, @key[0], tc.ix[k].ncmp, @pa) == 0)
                            {
                                if (pa.found == 0)
                                {
                                    sq_sb_init(@sb);
                                    sq_sb_lit(@sb, "row \0"); sq_sb_int(@sb, cur.rowid);
                                    sq_sb_lit(@sb, " missing from index \0"); sq_sb_lit(@sb, @tc.ix[k].name[0]);
                                    if (nerr < 100) { sq_pq_row(@q); sq_pq_str(@q, sb.p, sq_cstrlen(sb.p)); };
                                    nerr++;
                                    sq_sb_free(@sb);
                                };
                            };
                            sq_icur_close(@ic);
                        };
                    };
                    ok = sq_cur_next(@cur);
                };
                sq_cur_close(@cur);
                if (quick == 0)
                {
                    for (k = 0; k < tc.nix; k++)
                    {
                        ntot = 0;
                        sq_icur_open(@ic, db, @tc.ix[k]);
                        ok = sq_icur_first(@ic);
                        while (ok == 1) { ntot++; ok = sq_icur_next(@ic); };
                        sq_icur_close(@ic);
                        if (ntot != cnt[k])
                        {
                            sq_sb_init(@sb);
                            sq_sb_lit(@sb, "wrong # of entries in index \0"); sq_sb_lit(@sb, @tc.ix[k].name[0]);
                            if (nerr < 100) { sq_pq_row(@q); sq_pq_str(@q, sb.p, sq_cstrlen(sb.p)); };
                            nerr++;
                            sq_sb_free(@sb);
                        };
                    };
                };
                sq_chk_close(@chk);
                sq_ar_free(@ar);
                ffree((u64)row);
                sq_tc_free(tc);
                ffree((u64)tc);
            };
            if (nerr == 0) { sq_pq_row(@q); sq_pq_lit(@q, "ok\0"); };
            sq_pq_done(@q, pq);
            return 0;
        };
        // ---- TRIGGERS ----

        def sq_dispatch(SQ_STMT* st) -> int;
        def sq_is_query(byte* sql) -> bool;
        def sq_drop_obj_rows(SQLITE_DB* db, byte* name, byte* type) -> int;

        global int SQ_NACT = 0;
        global int[16] SQ_ACT;

        struct SQ_TRG
        {
            int timing, event, nof, ns, nl, ts, tl, name_start, when_s, when_e, body_s, body_e, ine, qs, ql;
            int[16] ofs, ofl;
        };

        // parses the text of a CREATE TRIGGER statement. t is a scratch statement that keeps the text for the spans.
        def sq_trg_parse(SQ_STMT* t, SQLITE_DB* db, byte* sql, SQ_TRG* g) -> int
        {
            int depth, e;
            sq_stmt_init(t, db, sql);
            t.pad = 0;
            g.nof = 0; g.qs = 0 - 1; g.ql = 0; g.when_s = 0 - 1; g.when_e = 0 - 1; g.body_s = 0; g.body_e = 0;
            sq_next(t);
            if (sq_is_kw(t, "create\0") == false) { sq_seterr(t, "syntax error\0"); return 1; };
            sq_next(t);
            if (sq_is_kw(t, "temp\0") | sq_is_kw(t, "temporary\0")) { sq_next(t); };
            if (sq_is_kw(t, "trigger\0") == false) { sq_seterr(t, "syntax error\0"); return 1; };
            sq_next(t);
            g.ine = 0;
            if (sq_is_kw(t, "if\0")) { sq_next(t); sq_next(t); sq_next(t); g.ine = 1; };
            if (t.tk != 1) { sq_seterr(t, "syntax error\0"); return 1; };
            g.name_start = sq_tok_start(t);
            if (sq_peek_op(t, 46)) { sq_next(t); sq_next(t); if (t.tk != 1) { sq_seterr(t, "syntax error\0"); return 1; }; };
            g.ns = t.ts; g.nl = t.tl;
            sq_next(t);
            g.timing = 0;
            if (sq_is_kw(t, "before\0")) { g.timing = 0; sq_next(t); }
            else
            {
                if (sq_is_kw(t, "after\0")) { g.timing = 1; sq_next(t); }
                else
                {
                    if (sq_is_kw(t, "instead\0"))
                    {
                        sq_next(t);
                        if (sq_is_kw(t, "of\0") == false) { sq_seterr(t, "syntax error\0"); return 1; };
                        sq_next(t);
                        g.timing = 2;
                    };
                };
            };
            if (sq_is_kw(t, "delete\0")) { g.event = 3; sq_next(t); }
            else
            {
                if (sq_is_kw(t, "insert\0")) { g.event = 1; sq_next(t); }
                else
                {
                    if (sq_is_kw(t, "update\0"))
                    {
                        g.event = 2;
                        sq_next(t);
                        if (sq_is_kw(t, "of\0"))
                        {
                            sq_next(t);
                            while (true)
                            {
                                if (t.tk != 1 | g.nof >= 16) { sq_seterr(t, "syntax error\0"); return 1; };
                                g.ofs[g.nof] = t.ts; g.ofl[g.nof] = t.tl; g.nof++;
                                sq_next(t);
                                if (sq_is_op(t, 44)) { sq_next(t); } else { break; };
                            };
                        };
                    }
                    else { sq_seterr(t, "syntax error\0"); return 1; };
                };
            };
            if (sq_is_kw(t, "on\0") == false) { sq_seterr(t, "syntax error\0"); return 1; };
            sq_next(t);
            if (t.tk != 1) { sq_seterr(t, "syntax error\0"); return 1; };
            if (sq_peek_op(t, 46)) { g.qs = t.ts; g.ql = t.tl; sq_next(t); sq_next(t); if (t.tk != 1) { sq_seterr(t, "syntax error\0"); return 1; }; };
            g.ts = t.ts; g.tl = t.tl;
            sq_next(t);
            if (sq_is_kw(t, "for\0"))
            {
                sq_next(t);
                if (sq_is_kw(t, "each\0") == false) { sq_seterr(t, "syntax error\0"); return 1; };
                sq_next(t);
                if (sq_is_kw(t, "row\0") == false) { sq_seterr(t, "syntax error\0"); return 1; };
                sq_next(t);
            };
            if (sq_is_kw(t, "when\0"))
            {
                sq_next(t);
                g.when_s = sq_tok_start(t);
                depth = 0;
                while (t.tk != 0)
                {
                    if (sq_is_op(t, 40)) { depth++; };
                    if (sq_is_op(t, 41)) { depth--; };
                    if (depth == 0 & sq_is_kw(t, "begin\0")) { break; };
                    sq_next(t);
                };
                g.when_e = sq_tok_start(t);
                if (g.when_e <= g.when_s) { sq_seterr(t, "syntax error\0"); return 1; };
            };
            if (sq_is_kw(t, "begin\0") == false) { sq_seterr(t, "syntax error\0"); return 1; };
            g.body_s = t.tend;
            // the body ends before the final END
            e = t.sqllen;
            while (e > 0)
            {
                if (t.sql[e - 1] == (byte)32 | t.sql[e - 1] == (byte)9 | t.sql[e - 1] == (byte)10 | t.sql[e - 1] == (byte)13 | t.sql[e - 1] == (byte)59) { e--; } else { break; };
            };
            if (e < g.body_s + 3) { sq_seterr(t, "syntax error\0"); return 1; };
            if (sq_lc(t.sql[e - 1]) != (byte)100 | sq_lc(t.sql[e - 2]) != (byte)110 | sq_lc(t.sql[e - 3]) != (byte)101) { sq_seterr(t, "syntax error\0"); return 1; };
            g.body_e = e - 3;
            return 0;
        };

        // copies text[s..e) into sb replacing NEW.x and OLD.x by the literal values of the row
        def sq_trg_subst(SQ_STMT* t, SQ_TCTX* tc, SQ_VAL* nw, SQ_VAL* ol, byte* text, int s, int e, SQ_SB* out) -> int
        {
            SQ_SB tmp;
            int last, ts0, isnew, c, cs, cl;
            SQ_VAL* row;
            // work on a private copy so the scratch statement can lex it
            sq_sb_init(@tmp);
            sq_sb_add(@tmp, @text[s], e - s);
            sq_stmt_init(t, tc.db, tmp.p);
            t.pad = 0;
            last = 0;
            sq_next(t);
            while (t.tk != 0)
            {
                if (t.tk == 1 & t.tq == 0 & (sq_is_kw(t, "new\0") | sq_is_kw(t, "old\0")) & sq_peek_op(t, 46))
                {
                    isnew = 0;
                    if (sq_is_kw(t, "new\0")) { isnew = 1; };
                    ts0 = sq_tok_start(t);
                    sq_next(t);
                    sq_next(t);
                    if (t.tk != 1) { sq_seterr(tc.st, "syntax error\0"); sq_sb_free(@tmp); return 1; };
                    cs = t.ts; cl = t.tl;
                    c = sq_ti_find(tc.ti, @t.sql[0], cs, cl);
                    if (c < 0)
                    {
                        if (sq_is_rowid_name(@t.sql[cs], cl) & tc.ti.wor == 0) { c = tc.ti.ipk; if (c < 0) { c = tc.ncols; }; };
                    };
                    row = ol;
                    if (isnew == 1) { row = nw; };
                    if (c < 0 | (u64)row == (u64)0)
                    {
                        if (isnew == 1) { sq_err_name(tc.st, "no such column: new.\0", @t.sql[cs], cl, "\0"); }
                        else { sq_err_name(tc.st, "no such column: old.\0", @t.sql[cs], cl, "\0"); };
                        sq_sb_free(@tmp);
                        return 1;
                    };
                    sq_sb_add(out, @t.sql[last], ts0 - last);
                    sq_sb_value(out, @row[c]);
                    last = t.tend;
                    sq_next(t);
                    continue;
                };
                sq_next(t);
            };
            sq_sb_add(out, @t.sql[last], t.sqllen - last);
            sq_sb_free(@tmp);
            return 0;
        };

        // runs one statement of a trigger body; returns 0, 1 on error
        def sq_trg_stmt(SQ_STMT* st, byte* text) -> int
        {
            SQ_STMT* sub;
            int rc;
            if (sq_is_query(text))
            {
                sub = sq_run_rows(st.db, st, text);
                if ((u64)sub == (u64)0) { if (SQ_RPAD != 0) { st.pad = SQ_RPAD; SQ_RPAD = 0; }; return 1; };
                sq_stmt_del(sub);
                return 0;
            };
            sub = sq_stmt_new();
            if ((u64)sub == (u64)0) { sq_seterr(st, "out of memory\0"); return 1; };
            sq_stmt_init(sub, st.db, text);
            sub.pad = 0; sub.ret_s = 0 - 1; sub.ret_e = 0 - 1; sub.wp_s = 0; sub.wp_e = 0;
            sq_next(sub);
            rc = sq_dispatch(sub);
            if (rc != 0)
            {
                sq_seterr(st, @sub.err[0]);
                if (sub.pad != 0) { st.pad = sub.pad; };
            };
            sq_stmt_del(sub);
            if (rc != 0 & SQ_RPAD != 0) { st.pad = SQ_RPAD; SQ_RPAD = 0; };
            return rc;
        };

        // Fires the triggers of the table for one row. nw / ol are the NEW and OLD rows (null when absent). For UPDATE,
        // setcols lists the assigned columns. Returns 0, 1 on an error, 2 when RAISE(IGNORE) skipped the row.
        // the database a trigger's ON qualifier names: 0 when none or unknown
        def sq_trg_qdb(SQLITE_DB* db, byte* sql, SQ_TRG* g) -> SQLITE_DB*
        {
            SQLITE_DB* root;
            int k;
            root = db;
            if ((u64)db.home != (u64)0) { root = (SQLITE_DB*)db.home; };
            if (g.qs < 0) { return (SQLITE_DB*)0; };
            if (sq_name_is(@sql[g.qs], g.ql, "main\0")) { return root; };
            if (sq_name_is(@sql[g.qs], g.ql, "temp\0") | sq_name_is(@sql[g.qs], g.ql, "temporary\0")) { return sq_att_temp(root); };
            k = sq_att_find(root, @sql[g.qs], g.ql);
            if (k < 0) { return (SQLITE_DB*)0; };
            return (SQLITE_DB*)root.att[k];
        };
        // the private TEMP database of the connection, or 0 when none exists
        def sq_trg_tempdb(SQLITE_DB* db) -> SQLITE_DB*
        {
            SQLITE_DB* root;
            root = db;
            if ((u64)db.home != (u64)0) { root = (SQLITE_DB*)db.home; };
            if (root.natt > 0)
            {
                if (root.attn[0] == (byte)116 & root.attn[1] == (byte)101 & root.attn[2] == (byte)109 & root.attn[3] == (byte)112 & root.attn[4] == (byte)0) { return (SQLITE_DB*)root.att[0]; };
            };
            return (SQLITE_DB*)0;
        };

        def sq_trig_fire(SQ_STMT* st, SQ_TCTX* tc, int timing, int event, SQ_VAL* nw, SQ_VAL* ol, int* setcols, int nset) -> int
        {
            SQLITE_DB* db = st.db;
            SQLITE_DB* dbx;
            SQLITE_DB* qd;
            int pp;
            SQ_STMT* t;
            SQ_STMT* u;
            SQ_TRG g;
            SQ_SB sb;
            SQ_SB sw;
            SQ_STMT* sub;
            int i, k, j, c, active, fire, rc, ss, depth, res, a, ok;
            SQ_VAL* v;
            res = 0;
            for (pp = 0; pp < 2; pp++)
            {
            dbx = db;
            if (pp == 1) { dbx = sq_trg_tempdb(db); if ((u64)dbx == (u64)0) { break; }; if ((u64)dbx == (u64)db) { break; }; };
            for (i = 0; i < dbx.nschema; i++)
            {
                if (dbx.schema[i].kind != 4) { continue; };
                if ((u64)dbx.schema[i].sql == (u64)0) { continue; };
                if (sq_name_is(@tc.tname[0], sq_cstrlen(@tc.tname[0]), @dbx.schema[i].tbl_name[0]) == false) { continue; };
                t = sq_stmt_new();
                if ((u64)t == (u64)0) { sq_seterr(st, "out of memory\0"); return 1; };
                if (sq_trg_parse(t, dbx, dbx.schema[i].sql, @g) != 0)
                {
                    sq_stmt_del(t);
                    continue;
                };
                fire = 1;
                if (pp == 1)
                {
                    qd = sq_trg_qdb(db, @t.sql[0], @g);
                    if ((u64)qd != (u64)db) { fire = 0; };
                };
                if (g.timing != timing | g.event != event) { fire = 0; };
                if (fire == 1 & event == 2 & g.nof > 0)
                {
                    fire = 0;
                    for (k = 0; k < g.nof; k++)
                    {
                        c = sq_ti_find(tc.ti, @t.sql[0], g.ofs[k], g.ofl[k]);
                        for (j = 0; j < nset; j++) { if (setcols[j] == c) { fire = 1; }; };
                    };
                };
                active = 0;
                for (k = 0; k < SQ_NACT; k++) { if (SQ_ACT[k] == i + pp * 100000) { active = 1; }; };
                if (active == 1) { fire = 0; };
                if (fire == 0) { sq_stmt_del(t); continue; };
                if (SQ_NACT >= 16) { sq_stmt_del(t); sq_seterr(st, "too many levels of trigger recursion\0"); return 1; };
                u = sq_stmt_new();
                if ((u64)u == (u64)0) { sq_stmt_del(t); sq_seterr(st, "out of memory\0"); return 1; };
                SQ_ACT[SQ_NACT] = i + pp * 100000;
                SQ_NACT++;
                SQ_TRIG_DEPTH++;
                rc = 0;
                // WHEN
                if (g.when_s >= 0)
                {
                    sq_sb_init(@sw);
                    sq_sb_lit(@sw, "select (\0");
                    if (sq_trg_subst(u, tc, nw, ol, t.sql, g.when_s, g.when_e, @sw) != 0) { rc = 1; };
                    sq_sb_lit(@sw, ")\0");
                    if (rc == 0)
                    {
                        sub = sq_run_rows(db, st, sw.p);
                        if ((u64)sub == (u64)0) { rc = 1; }
                        else
                        {
                            ok = 0;
                            if (sub.res.n > 0) { if (sq_truth(@sub.res.d[0]) == 1) { ok = 1; }; };
                            sq_stmt_del(sub);
                            if (ok == 0) { fire = 0; };
                        };
                    };
                    sq_sb_free(@sw);
                };
                // body
                if (rc == 0 & fire == 1)
                {
                    sq_sb_init(@sb);
                    if (sq_trg_subst(u, tc, nw, ol, t.sql, g.body_s, g.body_e, @sb) != 0) { rc = 1; };
                    if (rc == 0)
                    {
                        // split the substituted text at top level semicolons
                        sq_stmt_init(u, db, sb.p);
                        u.pad = 0;
                        sq_next(u);
                        while (u.tk != 0 & rc == 0)
                        {
                            if (sq_is_op(u, 59)) { sq_next(u); continue; };
                            ss = sq_tok_start(u);
                            depth = 0;
                            while (u.tk != 0)
                            {
                                if (sq_is_op(u, 40)) { depth++; };
                                if (sq_is_op(u, 41)) { depth--; };
                                if (depth == 0 & sq_is_op(u, 59)) { break; };
                                sq_next(u);
                            };
                            a = sq_tok_start(u);
                            if (u.tk == 0) { a = u.sqllen; };
                            sw.p = (byte*)0;
                            sq_sb_init(@sw);
                            sq_sb_add(@sw, @u.sql[ss], a - ss);
                            SQ_RAISE = 0;
                            rc = sq_trg_stmt(st, sw.p);
                            sq_sb_free(@sw);
                            if (SQ_RAISE == 1)
                            {
                                SQ_RAISE = 0;
                                st.err[0] = (byte)0;
                                rc = 0;
                                res = 2;
                                break;
                            };
                            if (rc == 0 & u.tk != 0) { sq_next(u); };
                        };
                    };
                    sq_sb_free(@sb);
                };
                SQ_TRIG_DEPTH--;
                SQ_NACT--;
                sq_stmt_del(u);
                sq_stmt_del(t);
                if (rc != 0) { return 1; };
                if (res == 2) { return 2; };
            };
            };
            return 0;
        };

        // true when the table has a trigger of the kind
        def sq_has_trigger(SQLITE_DB* db, byte* tname, int timing, int event) -> bool
        {
            SQ_STMT* t;
            SQ_TRG g;
            int i;
            bool r;
            r = false;
            for (i = 0; i < db.nschema; i++)
            {
                if (db.schema[i].kind != 4) { continue; };
                if ((u64)db.schema[i].sql == (u64)0) { continue; };
                if (sq_name_is(tname, sq_cstrlen(tname), @db.schema[i].tbl_name[0]) == false) { continue; };
                t = sq_stmt_new();
                if ((u64)t == (u64)0) { continue; };
                if (sq_trg_parse(t, db, db.schema[i].sql, @g) == 0)
                {
                    if (g.timing == timing & g.event == event) { r = true; };
                };
                sq_stmt_del(t);
            };
            return r;
        };

        // ---- CREATE TRIGGER / DROP TRIGGER ----


        // appends a database name to the error already set
        def sq_att_msg2(SQ_STMT* st, byte* nm, int nl) -> void
        {
            int i, n;
            n = sq_cstrlen(@st.err[0]);
            for (i = 0; i < nl & n < 150; i++) { st.err[n] = nm[i]; n++; };
            st.err[n] = (byte)0;
        };

        // Scans trigger or view text. mode 1: a table written as "schema.name" as the target of INSERT, UPDATE or DELETE
        // (returns 1). mode 0: any "name." that selects a database other than db (returns 1, *qs and *ql locate the name).
        def sq_xdb_scan(SQLITE_DB* db, byte* sql, int s, int n, int mode, int* qs, int* ql) -> int
        {
            SQLITE_DB* root;
            SQLITE_DB* rd;
            int i, ws, we, ps, pe, ss, se, k, e;
            byte c;
            root = db;
            if ((u64)db.home != (u64)0) { root = (SQLITE_DB*)db.home; };
            ps = 0; pe = 0; ss = 0; se = 0;
            i = s;
            e = s + n;
            while (i < e)
            {
                c = sql[i];
                if (c == (byte)39)
                {
                    i++;
                    while (i < e) { if (sql[i] == (byte)39) { if (sql[i + 1] == (byte)39) { i = i + 2; continue; }; break; }; i++; };
                    i++;
                    continue;
                };
                if (c == (byte)59) { ss = 0; se = 0; ps = 0; pe = 0; i++; continue; };
                if (sq_att_isid(c) & (c < (byte)48 | c > (byte)57))
                {
                    ws = i;
                    while (i < e & sq_att_isid(sql[i])) { i++; };
                    we = i;
                    if (sql[i] == (byte)46 & (ps == pe | true))
                    {
                        if (mode == 1)
                        {
                            if (se > ss)
                            {
                                if (sq_att_wis(sql, ps, pe, "into\0") & (sq_att_wis(sql, ss, se, "insert\0") | sq_att_wis(sql, ss, se, "replace\0"))) { return 1; };
                                if (sq_att_wis(sql, ps, pe, "update\0") & sq_att_wis(sql, ss, se, "update\0")) { return 1; };
                                if (sq_att_wis(sql, ps, pe, "from\0") & sq_att_wis(sql, ss, se, "delete\0")) { return 1; };
                                if (sq_att_wis(sql, ss, se, "update\0") & (sq_att_wis(sql, ps, pe, "replace\0") | sq_att_wis(sql, ps, pe, "abort\0") | sq_att_wis(sql, ps, pe, "fail\0") | sq_att_wis(sql, ps, pe, "ignore\0") | sq_att_wis(sql, ps, pe, "rollback\0"))) { return 1; };
                            };
                        }
                        else
                        {
                            rd = (SQLITE_DB*)0;
                            if (sq_att_wis(sql, ws, we, "main\0")) { rd = root; };
                            for (k = 0; k < root.natt; k++)
                            {
                                if (we - ws < 32)
                                {
                                    if (sq_att_wis(sql, ws, we, @root.attn[k * 32])) { rd = (SQLITE_DB*)root.att[k]; };
                                };
                            };
                            if ((u64)rd != (u64)0 & (u64)rd != (u64)db) { *qs = ws; *ql = we - ws; return 1; };
                        };
                        i++;
                        continue;
                    };
                    if (se == ss) { ss = ws; se = we; };
                    ps = ws; pe = we;
                    continue;
                };
                i++;
            };
            return 0;
        };

        def sq_exec_create_trigger(SQ_STMT* st) -> int
        {
            SQLITE_DB* db = st.db;
            SQLITE_DB* tdb;
            SQLITE_DB* qd;
            SQLITE_DB* tmp;
            int ins;
            SQ_STMT* t;
            SQ_TRG g;
            SQ_SB sb;
            byte[72] name;
            byte[72] tname;
            int ine, i, k, j, tpos, tkind, rc, tqs, tql;
            ine = 0;
            t = sq_stmt_new();
            if ((u64)t == (u64)0) { sq_seterr(st, "out of memory\0"); return 1; };
            if (sq_trg_parse(t, db, @st.sql[0], @g) != 0)
            {
                sq_seterr(st, @t.err[0]);
                sq_stmt_del(t);
                return 1;
            };
            if (g.nl > 62 | g.tl > 62) { sq_stmt_del(t); sq_seterr(st, "name too long\0"); return 1; };
            for (k = 0; k < g.nl; k++) { name[k] = t.sql[g.ns + k]; };
            name[g.nl] = (byte)0;
            ine = g.ine;
            tpos = 0 - 1;
            tdb = db;
            ins = 0;
            tmp = sq_trg_tempdb(db);
            if (g.qs >= 0)
            {
                qd = sq_trg_qdb(db, @t.sql[0], @g);
                if ((u64)qd == (u64)0)
                {
                    sq_err_name(st, "unknown database \0", @t.sql[g.qs], g.ql, "\0");
                    sq_stmt_del(t);
                    return 1;
                };
                if ((u64)qd != (u64)db)
                {
                    if ((u64)tmp == (u64)db) { tdb = qd; }
                    else
                    {
                        sq_err_name(st, "trigger \0", @name[0], g.nl, " cannot reference objects in database \0");
                        sq_att_msg2(st, @t.sql[g.qs], g.ql);
                        sq_stmt_del(t);
                        return 1;
                    };
                };
            };
            for (i = 0; i < tdb.nschema; i++)
            {
                if ((tdb.schema[i].kind == 1 | tdb.schema[i].kind == 3) & sq_name_is(@t.sql[g.ts], g.tl, @tdb.schema[i].name[0])) { tpos = i; };
            };
            if (tpos < 0 & g.qs < 0 & (u64)tmp == (u64)db)
            {
                // a TEMP trigger may sit on a table of any database
                qd = db;
                if ((u64)db.home != (u64)0) { qd = (SQLITE_DB*)db.home; };
                for (k = 0; k < qd.natt + 1 & tpos < 0; k++)
                {
                    if (k > 0) { tdb = (SQLITE_DB*)qd.att[k - 1]; } else { tdb = qd; };
                    if ((u64)tdb == (u64)db) { continue; };
                    for (i = 0; i < tdb.nschema; i++)
                    {
                        if ((tdb.schema[i].kind == 1 | tdb.schema[i].kind == 3) & sq_name_is(@t.sql[g.ts], g.tl, @tdb.schema[i].name[0])) { tpos = i; ins = k + 1; break; };
                    };
                };
                if (tpos < 0) { tdb = db; };
            };
            for (i = 0; i < db.nschema; i++)
            {
                if (db.schema[i].kind == 4 & sq_name_is(@name[0], g.nl, @db.schema[i].name[0]))
                {
                    sq_stmt_del(t);
                    if (ine == 1) { return 0; };
                    sq_err_name(st, "trigger \0", @name[0], g.nl, " already exists\0");
                    return 1;
                };
            };
            if (tpos < 0)
            {
                sq_err_name(st, "no such table: \0", @t.sql[g.ts], g.tl, "\0");
                sq_stmt_del(t);
                return 1;
            };
            tkind = tdb.schema[tpos].kind;
            if (tdb.schema[tpos].name[0] == (byte)115 & tdb.schema[tpos].name[1] == (byte)113 & tdb.schema[tpos].name[2] == (byte)108 & tdb.schema[tpos].name[3] == (byte)105 & tdb.schema[tpos].name[4] == (byte)116 & tdb.schema[tpos].name[5] == (byte)101 & tdb.schema[tpos].name[6] == (byte)95)
            {
                sq_stmt_del(t);
                sq_seterr(st, "cannot create trigger on system table\0");
                return 1;
            };
            if (tkind == 3 & g.timing != 2)
            {
                sq_stmt_del(t);
                if (g.timing == 0) { sq_err_name(st, "cannot create BEFORE trigger on view: \0", @tdb.schema[tpos].name[0], sq_cstrlen(@tdb.schema[tpos].name[0]), "\0"); }
                else { sq_err_name(st, "cannot create AFTER trigger on view: \0", @tdb.schema[tpos].name[0], sq_cstrlen(@tdb.schema[tpos].name[0]), "\0"); };
                return 1;
            };
            if (tkind == 1 & g.timing == 2)
            {
                sq_stmt_del(t);
                sq_err_name(st, "cannot create INSTEAD OF trigger on table: \0", @tdb.schema[tpos].name[0], sq_cstrlen(@tdb.schema[tpos].name[0]), "\0");
                return 1;
            };
            k = sq_find_top(@t.sql[g.name_start], t.sqllen - g.name_start, "begin\0");
            if ((u64)tmp == (u64)db) { k = 0 - 1; };
            if (k >= 0)
            {
                if (sq_xdb_scan(db, @t.sql[0], g.name_start + k + 5, t.sqllen - g.name_start - k - 5, 1, @tqs, @tql) != 0)
                {
                    sq_stmt_del(t);
                    sq_seterr(st, "qualified table names are not allowed on INSERT, UPDATE, and DELETE statements within triggers\0");
                    return 1;
                };
                if (sq_xdb_scan(db, @t.sql[0], g.name_start + k + 5, t.sqllen - g.name_start - k - 5, 0, @tqs, @tql) != 0)
                {
                    sq_stmt_del(t);
                    sq_err_name(st, "trigger \0", @name[0], g.nl, " cannot reference objects in database \0");
                    sq_att_msg2(st, @t.sql[tqs], tql);
                    return 1;
                };
            };
            sq_sb_init(@sb);
            sq_sb_lit(@sb, "CREATE TRIGGER \0");
            k = t.sqllen;
            while (k > g.name_start)
            {
                if (t.sql[k - 1] == (byte)32 | t.sql[k - 1] == (byte)9 | t.sql[k - 1] == (byte)10 | t.sql[k - 1] == (byte)13 | t.sql[k - 1] == (byte)59) { k--; } else { break; };
            };
            if (ins > 0 & (u64)tdb != (u64)db)
            {
                // keep the database of the table in the stored text
                j = g.ts;
                if (t.sql[j - 1] == (byte)34 | t.sql[j - 1] == (byte)96) { j--; };
                sq_sb_add(@sb, @t.sql[g.name_start], j - g.name_start);
                qd = db;
                if ((u64)db.home != (u64)0) { qd = (SQLITE_DB*)db.home; };
                if (ins == 1) { sq_sb_lit(@sb, "main\0"); }
                else { sq_sb_add(@sb, @qd.attn[(ins - 2) * 32], sq_cstrlen(@qd.attn[(ins - 2) * 32])); };
                sq_sb_lit(@sb, ".\0");
                sq_sb_add(@sb, @t.sql[j], k - j);
            }
            else { sq_sb_add(@sb, @t.sql[g.name_start], k - g.name_start); };
            if (sb.err != 0) { sq_sb_free(@sb); sq_stmt_del(t); return 1; };
            rc = sq_master_add(db, "trigger\0", @name[0], @tdb.schema[tpos].name[0], 0, sb.p);
            sq_sb_free(@sb);
            sq_stmt_del(t);
            if (rc != 0) { sq_seterr(st, "write error\0"); return 1; };
            return 0;
        };

        // removes the sqlite_master rows of every trigger attached to the table or view
        def sq_drop_triggers_of(SQLITE_DB* db, byte* tname) -> int
        {
            int i;
            byte[72] nm;
            for (i = 0; i < db.nschema; i++)
            {
                if (db.schema[i].kind != 4) { continue; };
                if (sq_name_is(tname, sq_cstrlen(tname), @db.schema[i].tbl_name[0]) == false) { continue; };
                if (sq_drop_obj_rows(db, @db.schema[i].name[0], "trigger\0") != 0) { return 1; };
            };
            return 0;
        };

        // true when any trigger is attached to the table
        global int SQ_NOTRIG = 0;

        def sq_tbl_has_trg(SQLITE_DB* db, byte* tname) -> bool
        {
            SQLITE_DB* tdb;
            int i;
            if (SQ_NOTRIG == 1) { return false; };
            for (i = 0; i < db.nschema; i++)
            {
                if (db.schema[i].kind != 4) { continue; };
                if (sq_name_is(tname, sq_cstrlen(tname), @db.schema[i].tbl_name[0])) { return true; };
            };
            tdb = sq_trg_tempdb(db);
            if ((u64)tdb != (u64)0 & (u64)tdb != (u64)db)
            {
                for (i = 0; i < tdb.nschema; i++)
                {
                    if (tdb.schema[i].kind != 4) { continue; };
                    if (sq_name_is(tname, sq_cstrlen(tname), @tdb.schema[i].tbl_name[0])) { return true; };
                };
            };
            return false;
        };

        // ---- INSTEAD OF triggers on views ----

        // true when name is a view that has an INSTEAD OF trigger for the event (1 insert, 2 update, 3 delete)
        def sq_view_instead(SQLITE_DB* db, byte* name, int nl, int event) -> bool
        {
            int i;
            for (i = 0; i < db.nschema; i++)
            {
                if (db.schema[i].kind == 3 & sq_name_is(name, nl, @db.schema[i].name[0]))
                {
                    return sq_has_trigger(db, @db.schema[i].name[0], 2, event);
                };
            };
            return false;
        };

        // INSERT / UPDATE / DELETE on a view: every affected row fires the INSTEAD OF triggers. The statement text is read from
        // the token after the view name. Returns 0 or 1.
        def sq_exec_view_dml(SQ_STMT* st, int event, byte* name, int nl) -> int
        {
            SQLITE_DB* db = st.db;
            SQ_TCTX* tc;
            SQ_STMT* vs;
            SQ_STMT* sub;
            SQ_SB sb, ts;
            SQ_VAL* nw;
            SQ_VAL* ol;
            int[130] map;
            int[130] es;
            int[130] ee;
            int nv, c, j, i, k, rc, r, ncol, gs, ge, ws, we, nset, nrow, srcs, srce, haslist;
            byte[72] cn;
            tc = (SQ_TCTX*)fmalloc((u64)(sizeof(SQ_TCTX) / 8 + 4096));
            if ((u64)tc == (u64)0) { sq_seterr(st, "out of memory\0"); return 1; };
            tc.db = db; tc.st = st; tc.ti = (SQ_TI*)0; tc.tpos = 0 - 1;
            for (k = 0; k < nl; k++) { tc.tname[k] = name[k]; };
            tc.tname[nl] = (byte)0;
            nw = tc.nw; ol = tc.ol;
            rc = 0;
            // the column list of the view
            vs = sq_stmt_new();
            if ((u64)vs == (u64)0) { ffree((u64)tc); sq_seterr(st, "out of memory\0"); return 1; };
            sq_sb_init(@sb);
            sq_sb_lit(@sb, "select * from \0");
            sq_sb_ident(@sb, name, nl);
            if (sq_prep_query(vs, db, sb.p) != 0)
            {
                sq_seterr(st, @vs.err[0]);
                sq_sb_free(@sb); sq_stmt_del(vs); ffree((u64)tc);
                return 1;
            };
            sq_sb_free(@sb);
            nv = vs.nres;
            if (nv > 120) { sq_stmt_del(vs); ffree((u64)tc); sq_seterr(st, "too many columns\0"); return 1; };
            sq_sb_init(@ts);
            sq_sb_lit(@ts, "create table x(\0");
            for (c = 0; c < nv; c++)
            {
                sq_column_name(vs, c, @cn[0], 72);
                if (c > 0) { sq_sb_lit(@ts, ", \0"); };
                sq_sb_ident(@ts, @cn[0], sq_cstrlen(@cn[0]));
            };
            sq_sb_lit(@ts, ")\0");
            sq_stmt_del(vs);
            tc.ti = (SQ_TI*)fmalloc((u64)(sizeof(SQ_TI) / 8 + 4096));
            if ((u64)tc.ti == (u64)0) { sq_sb_free(@ts); ffree((u64)tc); sq_seterr(st, "out of memory\0"); return 1; };
            r = sq_ti_load(tc.ti, ts.p);
            if (r != 0) { sq_sb_free(@ts); ffree((u64)tc.ti); ffree((u64)tc); sq_seterr(st, "unsupported view definition\0"); return 1; };
            tc.ncols = tc.ti.ncols;
            sq_ar_init(@tc.ar);
            sq_cut_returning(st);
            if (event == 1)
            {
                ncol = 0;
                haslist = 0;
                if (sq_is_op(st, 40))
                {
                    haslist = 1;
                    sq_next(st);
                    while (true)
                    {
                        if (st.tk != 1) { sq_seterr(st, "expected a column name\0"); rc = 1; break; };
                        c = sq_ti_find(tc.ti, @st.sql[0], st.ts, st.tl);
                        if (c < 0)
                        {
                            sq_sb_init(@sb);
                            sq_sb_lit(@sb, "table \0"); sq_sb_add(@sb, name, nl); sq_sb_lit(@sb, " has no column named \0");
                            sq_sb_add(@sb, @st.sql[st.ts], st.tl);
                            sq_seterr(st, sb.p);
                            sq_sb_free(@sb);
                            rc = 1; break;
                        };
                        map[ncol] = c; ncol++;
                        sq_next(st);
                        if (sq_is_op(st, 44)) { sq_next(st); continue; };
                        break;
                    };
                    if (rc == 0)
                    {
                        if (sq_is_op(st, 41) == false) { sq_seterr(st, "expected )\0"); rc = 1; } else { sq_next(st); };
                    };
                }
                else
                {
                    for (c = 0; c < nv; c++) { map[c] = c; };
                    ncol = nv;
                };
                if (rc == 0)
                {
                    srcs = sq_tok_start(st);
                    srce = st.lim;
                    while (srce > srcs)
                    {
                        if (st.sql[srce - 1] == (byte)32 | st.sql[srce - 1] == (byte)9 | st.sql[srce - 1] == (byte)10 | st.sql[srce - 1] == (byte)13 | st.sql[srce - 1] == (byte)59) { srce--; } else { break; };
                    };
                    sq_sb_init(@sb);
                    if (sq_is_kw(st, "default\0"))
                    {
                        sq_sb_lit(@sb, "select \0");
                        for (c = 0; c < nv; c++) { if (c > 0) { sq_sb_lit(@sb, ", \0"); }; sq_sb_lit(@sb, "null\0"); };
                        ncol = nv;
                        for (c = 0; c < nv; c++) { map[c] = c; };
                    }
                    else
                    {
                        if (sq_is_kw(st, "select\0") == false & sq_is_kw(st, "values\0") == false & sq_is_kw(st, "with\0") == false)
                        {
                            sq_seterr(st, "syntax error in INSERT\0"); rc = 1;
                        }
                        else
                        {
                            if (st.wp_e > st.wp_s) { sq_sb_add(@sb, @st.sql[st.wp_s], st.wp_e - st.wp_s); sq_sb_lit(@sb, " \0"); };
                            sq_sb_add(@sb, @st.sql[srcs], srce - srcs);
                        };
                    };
                    if (rc == 0)
                    {
                        sub = sq_run_rows(db, st, sb.p);
                        if ((u64)sub == (u64)0) { rc = 1; }
                        else
                        {
                            if (sub.nres != ncol)
                            {
                                sq_sb_free(@sb);
                                sq_sb_init(@sb);
                                if (haslist == 0)
                                {
                                    sq_sb_lit(@sb, "table \0"); sq_sb_add(@sb, name, nl); sq_sb_lit(@sb, " has \0");
                                    sq_sb_int(@sb, (i64)ncol); sq_sb_lit(@sb, " columns but \0");
                                    sq_sb_int(@sb, (i64)sub.nres); sq_sb_lit(@sb, " values were supplied\0");
                                }
                                else
                                {
                                    sq_sb_int(@sb, (i64)sub.nres); sq_sb_lit(@sb, " values for \0");
                                    sq_sb_int(@sb, (i64)ncol); sq_sb_lit(@sb, " columns\0");
                                };
                                sq_seterr(st, sb.p);
                                rc = 1;
                            }
                            else
                            {
                                for (i = 0; i < sub.res.n & rc == 0; i++)
                                {
                                    for (c = 0; c < tc.ncols; c++) { sq_val_null(@nw[c]); };
                                    sq_val_null(@nw[tc.ncols]);
                                    for (j = 0; j < ncol; j++) { sq_val_copy(@nw[map[j]], @sub.res.d[i * sub.res.nc + j]); };
                                    r = sq_trig_fire(st, tc, 2, 1, nw, (SQ_VAL*)0, (int*)0, 0);
                                    if (r == 1) { rc = 1; };
                                };
                            };
                            sq_stmt_del(sub);
                        };
                    };
                    sq_sb_free(@sb);
                };
            };
            if (event == 3)
            {
                sq_sb_init(@sb);
                sq_sb_lit(@sb, "select * from \0");
                sq_sb_ident(@sb, name, nl);
                if (sq_is_kw(st, "where\0"))
                {
                    ws = sq_tok_start(st);
                    we = st.lim;
                    while (we > ws)
                    {
                        if (st.sql[we - 1] == (byte)32 | st.sql[we - 1] == (byte)9 | st.sql[we - 1] == (byte)10 | st.sql[we - 1] == (byte)13 | st.sql[we - 1] == (byte)59) { we--; } else { break; };
                    };
                    sq_sb_lit(@sb, " \0");
                    sq_sb_add(@sb, @st.sql[ws], we - ws);
                }
                else
                {
                    if (st.tk != 0 & sq_is_op(st, 59) == false) { sq_seterr(st, "syntax error in DELETE\0"); rc = 1; };
                };
                if (rc == 0)
                {
                    sub = sq_run_rows(db, st, sb.p);
                    if ((u64)sub == (u64)0) { rc = 1; }
                    else
                    {
                        for (i = 0; i < sub.res.n & rc == 0; i++)
                        {
                            for (c = 0; c < nv; c++) { sq_val_copy(@ol[c], @sub.res.d[i * sub.res.nc + c]); };
                            sq_val_null(@ol[nv]);
                            r = sq_trig_fire(st, tc, 2, 3, (SQ_VAL*)0, ol, (int*)0, 0);
                            if (r == 1) { rc = 1; };
                        };
                        sq_stmt_del(sub);
                    };
                };
                sq_sb_free(@sb);
            };
            if (event == 2)
            {
                if (sq_is_kw(st, "set\0") == false) { sq_seterr(st, "expected SET\0"); rc = 1; };
                if (rc == 0)
                {
                    sq_next(st);
                    nset = 0;
                    while (true)
                    {
                        if (st.tk != 1) { sq_seterr(st, "expected a column name\0"); rc = 1; break; };
                        c = sq_ti_find(tc.ti, @st.sql[0], st.ts, st.tl);
                        if (c < 0) { sq_err_name(st, "no such column: \0", @st.sql[st.ts], st.tl, "\0"); rc = 1; break; };
                        sq_next(st);
                        if (sq_is_op(st, 61) == false) { sq_seterr(st, "expected =\0"); rc = 1; break; };
                        sq_next(st);
                        gs = sq_tok_start(st);
                        ge = sq_skip_expr(st, 1);
                        if (nset >= 120) { sq_seterr(st, "too many columns\0"); rc = 1; break; };
                        map[nset] = c; es[nset] = gs; ee[nset] = ge; nset++;
                        if (sq_is_op(st, 44)) { sq_next(st); continue; };
                        break;
                    };
                };
                if (rc == 0)
                {
                    sq_sb_init(@sb);
                    sq_sb_lit(@sb, "select *\0");
                    for (j = 0; j < nset; j++)
                    {
                        sq_sb_lit(@sb, ", (\0");
                        sq_sb_add(@sb, @st.sql[es[j]], ee[j] - es[j]);
                        sq_sb_lit(@sb, ")\0");
                    };
                    sq_sb_lit(@sb, " from \0");
                    sq_sb_ident(@sb, name, nl);
                    if (sq_is_kw(st, "where\0"))
                    {
                        ws = sq_tok_start(st);
                        we = st.lim;
                        while (we > ws)
                        {
                            if (st.sql[we - 1] == (byte)32 | st.sql[we - 1] == (byte)9 | st.sql[we - 1] == (byte)10 | st.sql[we - 1] == (byte)13 | st.sql[we - 1] == (byte)59) { we--; } else { break; };
                        };
                        sq_sb_lit(@sb, " \0");
                        sq_sb_add(@sb, @st.sql[ws], we - ws);
                    }
                    else
                    {
                        if (st.tk != 0 & sq_is_op(st, 59) == false) { sq_seterr(st, "syntax error in UPDATE\0"); rc = 1; };
                    };
                    if (rc == 0)
                    {
                        sub = sq_run_rows(db, st, sb.p);
                        if ((u64)sub == (u64)0) { rc = 1; }
                        else
                        {
                            for (i = 0; i < sub.res.n & rc == 0; i++)
                            {
                                for (c = 0; c < nv; c++)
                                {
                                    sq_val_copy(@ol[c], @sub.res.d[i * sub.res.nc + c]);
                                    sq_val_copy(@nw[c], @sub.res.d[i * sub.res.nc + c]);
                                };
                                sq_val_null(@ol[nv]); sq_val_null(@nw[nv]);
                                for (j = 0; j < nset; j++) { sq_val_copy(@nw[map[j]], @sub.res.d[i * sub.res.nc + nv + j]); };
                                r = sq_trig_fire(st, tc, 2, 2, nw, ol, @map[0], nset);
                                if (r == 1) { rc = 1; };
                            };
                            sq_stmt_del(sub);
                        };
                    };
                    sq_sb_free(@sb);
                };
            };
            sq_ar_free(@tc.ar);
            sq_sb_free(@ts);
            ffree((u64)tc.ti);
            ffree((u64)tc);
            return rc;
        };

        // ---- INSERT ----

        def sq_err_ncols(SQ_STMT* st, SQ_TCTX* tc, int hl, int got, int want) -> void
        {
            SQ_SB sb;
            sq_sb_init(@sb);
            if (hl == 0)
            {
                sq_sb_lit(@sb, "table \0"); sq_sb_lit(@sb, @tc.tname[0]); sq_sb_lit(@sb, " has \0");
                sq_sb_int(@sb, (i64)want); sq_sb_lit(@sb, " columns but \0");
                sq_sb_int(@sb, (i64)got); sq_sb_lit(@sb, " values were supplied\0");
            }
            else
            {
                sq_sb_int(@sb, (i64)got); sq_sb_lit(@sb, " values for \0");
                sq_sb_int(@sb, (i64)want); sq_sb_lit(@sb, " columns\0");
            };
            if (sb.err == 0) { sq_seterr(st, sb.p); } else { sq_seterr(st, "out of memory\0"); };
            sq_sb_free(@sb);
        };

        def sq_exec_insert(SQ_STMT* st, SQ_TCTX* tc, int onconf, byte* name, int nl) -> int
        {
            SQLITE_DB* db = st.db;
            SQ_TI* ti;
            SQ_CHK chk;
            SQ_STMT* sub;
            SQ_VAL* nw;
            SQ_VAL* srow;
            SQ_VAL* src;
            SQ_SB sb;
            int[130] map;
            int[130] isdef;
            int ncol, c, j, r, nrows, i, k, srcn, rs, re, gs, ge, depth, e, rc, sk, first, ipk, isrow, hl;
            i64 rowid, mx, seq;
            byte[64] cn;
            SQ_UPS ups;
            int has_ups, upos, tokstart, ulim, umatch, hastrig, tr, fix0, u0;
            ti = tc.ti;
            ipk = ti.ipk;
            nw = tc.nw;
            rc = 0;
            hastrig = 0;
            if (sq_tbl_has_trg(db, @tc.tname[0])) { hastrig = 1; };
            // RETURNING and ON CONFLICT clauses are split off before the rows are read
            sq_cut_returning(st);
            if (sq_ret_begin(st, tc, 0 - 1, 0 - 1) != 0) { return 1; };
            tokstart = sq_tok_start(st);
            hl = 0;
            has_ups = 0;
            upos = sq_find_top(@st.sql[tokstart], st.lim - tokstart, "on conflict\0");
            if (upos >= 0)
            {
                upos = tokstart + upos;
                ulim = st.lim;
                if (sq_ups_parse(st, tc, @ups, upos, ulim) != 0) { return 1; };
                if (sq_ups_check(st, tc, @ups) != 0) { return 1; };
                has_ups = 1;
                st.lim = upos;
                while (st.lim > tokstart)
                {
                    if (st.sql[st.lim - 1] == (byte)32 | st.sql[st.lim - 1] == (byte)9 | st.sql[st.lim - 1] == (byte)10 | st.sql[st.lim - 1] == (byte)13) { st.lim--; } else { break; };
                };
                sq_rewind(st, tokstart);
                onconf = 6;
            };
            // optional column list
            ncol = 0;
            if (sq_is_op(st, 40))
            {
                sq_next(st);
                while (true)
                {
                    if (st.tk != 1) { sq_seterr(st, "expected a column name\0"); return 1; };
                    c = 0 - 1;
                    if (st.tq == 1) { c = sq_ti_find(ti, @st.sql[0], st.ts, st.tl); }
                    else { c = sq_ti_find(ti, @st.sql[0], st.ts, st.tl); };
                    if (c < 0)
                    {
                        if (sq_is_rowid_name(@st.sql[st.ts], st.tl) & tc.ti.wor == 0)
                        {
                            c = ipk;
                            if (c < 0) { c = tc.ncols; };
                        };
                    };
                    if (c < 0)
                    {
                        sq_sb_init(@sb);
                        sq_sb_lit(@sb, "table \0"); sq_sb_lit(@sb, @tc.tname[0]); sq_sb_lit(@sb, " has no column named \0");
                        sq_sb_add(@sb, @st.sql[st.ts], st.tl);
                        sq_seterr(st, sb.p);
                        sq_sb_free(@sb);
                        return 1;
                    };
                    if (c < tc.ncols) { if (ti.gen[c] != 0) { sq_err_gen(st, ti, c, 1); return 1; }; };
                    if (ncol >= 128) { sq_seterr(st, "too many columns\0"); return 1; };
                    hl = 1;
                    map[ncol] = c;
                    ncol++;
                    sq_next(st);
                    if (sq_is_op(st, 44)) { sq_next(st); continue; };
                    break;
                };
                if (sq_is_op(st, 41) == false) { sq_seterr(st, "expected )\0"); return 1; };
                sq_next(st);
            }
            else
            {
                ncol = 0;
                for (c = 0; c < tc.ncols; c++)
                {
                    if (ti.gen[c] != 0) { continue; };
                    map[ncol] = c;
                    ncol++;
                };
            };
            if (sq_chk_open(tc, @chk) != 0) { return 1; };
            seq = (i64)0;
            if (ti.autoinc == 1) { seq = sq_seq_read(tc, @mx); };
            first = 1;
            // source
            if (sq_is_kw(st, "default\0"))
            {
                sq_next(st);
                if (sq_is_kw(st, "values\0") == false) { sq_seterr(st, "expected VALUES\0"); sq_chk_close(@chk); return 1; };
                sq_next(st);
                srcn = 0;
                sub = (SQ_STMT*)0;
                isrow = 1;
                nrows = 1;
            }
            else
            {
                if (sq_is_kw(st, "values\0")) { isrow = 2; } else { isrow = 0; };
            };
            if (isrow == 0)
            {
                // INSERT ... SELECT
                rs = sq_tok_start(st);
                re = st.lim;
                while (re > rs)
                {
                    if (st.sql[re - 1] == (byte)32 | st.sql[re - 1] == (byte)9 | st.sql[re - 1] == (byte)10 | st.sql[re - 1] == (byte)13 | st.sql[re - 1] == (byte)59) { re--; } else { break; };
                };
                if (st.tk == 0) { sq_seterr(st, "expected VALUES or SELECT\0"); sq_chk_close(@chk); return 1; };
                if (sq_is_kw(st, "select\0") == false & sq_is_kw(st, "with\0") == false)
                {
                    sq_seterr(st, "syntax error in INSERT\0"); sq_chk_close(@chk); return 1;
                };
                sq_sb_init(@sb);
                if (st.wp_e > st.wp_s)
                {
                    if (sq_is_kw(st, "with\0")) { sq_seterr(st, "WITH clause is not allowed here\0"); sq_sb_free(@sb); sq_chk_close(@chk); return 1; };
                    sq_sb_add(@sb, @st.sql[st.wp_s], st.wp_e - st.wp_s);
                    sq_sb_lit(@sb, " \0");
                };
                sq_sb_add(@sb, @st.sql[rs], re - rs);
                SQ_SPILL = 1;
                sub = sq_run_rows(db, st, sb.p);
                SQ_SPILL = 0;
                sq_sb_free(@sb);
                if ((u64)sub == (u64)0) { sq_chk_close(@chk); return 1; };
                if (sub.nres != ncol)
                {
                    r = sub.nres;
                    sq_stmt_del(sub);
                    sq_chk_close(@chk);
                    sq_err_ncols(st, tc, hl, r, ncol);
                    return 1;
                };
                nrows = sub.res.n;
            };
            if (isrow == 2) { sq_next(st); };
            i = 0;
            while (true)
            {
                // fetch the values of the next row into src (srcn values) with isdef marking DEFAULT
                for (c = 0; c < tc.ncols; c++) { sq_val_copy(@nw[c], @tc.dv[c]); };
                sq_val_null(@nw[tc.ncols]);
                if (isrow == 0)
                {
                    if (i >= nrows) { break; };
                    srow = sq_rs_at(sub.res, i);
                    if ((u64)srow == (u64)0) { sq_seterr(st, "read error\0"); rc = 1; break; };
                    for (j = 0; j < ncol; j++) { sq_val_copy(@nw[map[j]], @srow[j]); sq_val_own(@tc.ar, @nw[map[j]]); };
                }
                else
                {
                    if (isrow == 1)
                    {
                        if (i >= 1) { break; };
                    }
                    else
                    {
                        if (i > 0)
                        {
                            if (sq_is_op(st, 44)) { sq_next(st); } else { break; };
                        };
                        if (sq_is_op(st, 40) == false) { sq_seterr(st, "expected (\0"); rc = 1; break; };
                        sq_next(st);
                        sq_sb_init(@sb);
                        sq_sb_lit(@sb, "select \0");
                        j = 0;
                        while (true)
                        {
                            gs = sq_tok_start(st);
                            // a lone DEFAULT keyword uses the column default
                            isdef[j] = 0;
                            if (sq_is_kw(st, "default\0"))
                            {
                                if (sq_peek_op(st, 44) | sq_peek_op(st, 41)) { isdef[j] = 1; };
                            };
                            ge = sq_skip_expr(st, 0);
                            if (j > 0) { sq_sb_lit(@sb, ", \0"); };
                            if (isdef[j] == 1) { sq_sb_lit(@sb, "null\0"); }
                            else { sq_sb_add(@sb, @st.sql[gs], ge - gs); };
                            j++;
                            if (sq_is_op(st, 44)) { sq_next(st); continue; };
                            break;
                        };
                        if (sq_is_op(st, 41) == false) { sq_seterr(st, "expected )\0"); sq_sb_free(@sb); rc = 1; break; };
                        sq_next(st);
                        if (j != ncol)
                        {
                            sq_sb_free(@sb);
                            sq_err_ncols(st, tc, hl, j, ncol);
                            rc = 1;
                            break;
                        };
                        SQ_NOAGG = 1;
                        sub = sq_run_rows(db, st, sb.p);
                        SQ_NOAGG = 0;
                        sq_sb_free(@sb);
                        if ((u64)sub == (u64)0) { rc = 1; break; };
                        for (k = 0; k < ncol; k++)
                        {
                            if (isdef[k] == 1) { continue; };
                            sq_val_copy(@nw[map[k]], @sub.res.d[k]);
                            sq_val_own(@tc.ar, @nw[map[k]]);
                        };
                        sq_stmt_del(sub);
                        sub = (SQ_STMT*)0;
                    };
                };
                // determine the rowid
                if (sq_tc_affinity(tc, nw) != 0) { rc = 1; break; };
                rowid = (i64)0;
                if (tc.wor == 1)
                {
                    sq_wor_tick(tc);
                    rowid = sq_wor_reg(tc, nw);
                    sq_val_int(@nw[tc.ncols], rowid);
                }
                else
                {
                sk = 0;
                if (ipk >= 0)
                {
                    if (nw[ipk].t == SQ_NULL) { sk = 1; }
                    else
                    {
                        if (nw[ipk].t != SQ_INTEGER) { sq_seterr(st, "datatype mismatch\0"); rc = 1; break; };
                        rowid = nw[ipk].i;
                    };
                }
                else
                {
                    sk = 1;
                    for (j = 0; j < ncol; j++)
                    {
                        if (map[j] == tc.ncols)
                        {
                            sk = 0;
                            // explicit rowid: any integer
                            if (nw[tc.ncols].t == SQ_NULL) { sk = 1; }
                            else
                            {
                                sq_cast(@tc.ar, @nw[tc.ncols], 3, @nw[tc.ncols]);
                                rowid = nw[tc.ncols].i;
                            };
                        };
                    };
                };
                if (sk == 1)
                {
                    if (sq_max_rowid(db, tc.root, @mx) != 0) { sq_seterr(st, "read error\0"); rc = 1; break; };
                    if (ti.autoinc == 1 & seq > mx) { mx = seq; };
                    if (mx == (i64)9223372036854775807) { sq_seterr(st, "database or disk is full\0"); rc = 1; break; };
                    rowid = mx + (i64)1;
                };
                if (ipk >= 0) { sq_val_int(@nw[ipk], rowid); };
                sq_val_int(@nw[tc.ncols], rowid);
                };
                tr = 0;
                if (hastrig == 1)
                {
                    tr = sq_trig_fire(st, tc, 0, 1, nw, (SQ_VAL*)0, (int*)0, 0);
                    if (tr == 1) { rc = 1; break; };
                };
                if (tr == 2) { r = 5; }
                else { r = sq_tc_check(tc, @chk, nw, rowid, 0, (i64)0, onconf); };
                if (r == 1) { rc = 1; break; };
                if (r == 6)
                {
                    umatch = sq_ups_match(tc, @ups, tc.cf_ix);
                    if (umatch < 0)
                    {
                        // the conflict is on another constraint: look for one the target names
                        fix0 = tc.cf_ix;
                        for (u0 = 0; u0 < 24; u0++) { tc.ups_skip[u0] = 0; };
                        while (umatch < 0 & r == 6)
                        {
                            if (tc.cf_ix < 0) { tc.ups_skip[22] = 1; } else { tc.ups_skip[tc.cf_ix] = 1; };
                            r = sq_tc_check(tc, @chk, nw, rowid, 0, (i64)0, onconf);
                            if (r == 6) { umatch = sq_ups_match(tc, @ups, tc.cf_ix); };
                        };
                        for (u0 = 0; u0 < 24; u0++) { tc.ups_skip[u0] = 0; };
                        if (r == 1) { rc = 1; break; };
                    };
                    if (umatch < 0)
                    {
                        if (fix0 < 0) { sq_err_unique(tc, (SQ_IDX*)0, 1); } else { sq_err_unique(tc, @tc.ix[fix0], 0); };
                        st.pad = 0;
                        rc = 1;
                        break;
                    };
                    if (ups.action[umatch] == 1)
                    {
                        if (sq_ups_apply(st, tc, @chk, @ups, umatch, nw, tc.cf_rid) != 0) { rc = 1; break; };
                    };
                };
                if (r == 0)
                {
                    if (sq_tc_put(tc, rowid, nw) != 0) { rc = 1; break; };
                    st.changes++;
                    if (tc.wor == 0) { st.last_rowid = rowid; };
                    if (sq_tc_note(tc, rowid) != 0) { rc = 1; break; };
                    if (sq_fk_insert(st, tc, nw, rowid) != 0) { rc = 1; break; };
                    if (hastrig == 1)
                    {
                        tr = sq_trig_fire(st, tc, 1, 1, nw, (SQ_VAL*)0, (int*)0, 0);
                        if (tr == 1) { rc = 1; break; };
                    };
                };
                if (ti.autoinc == 1) { if (rowid > seq) { seq = rowid; }; };
                sq_ar_reset(@tc.ar);
                i++;
                if (isrow == 1) { break; };
                if (first == 1) { first = 0; };
            };
            if (isrow == 0 & (u64)sub != (u64)0) { sq_stmt_del(sub); };
            sq_chk_close(@chk);
            if (rc != 0) { return 1; };
            if (isrow != 0)
            {
                if (st.tk != 0 & sq_is_op(st, 59) == false) { sq_seterr(st, "syntax error in INSERT\0"); return 1; };
            };
            if (ti.autoinc == 1) { if (sq_seq_write(tc, seq) != 0) { sq_seterr(st, "cannot update sqlite_sequence\0"); return 1; }; };
            return 0;
        };

        // ---- shared tail: bring dirty indexes up to date ----

        def sq_tc_finish(SQ_TCTX* tc) -> int
        {
            int i;
            for (i = 0; i < tc.nix; i++)
            {
                if (sq_tc_clean(tc, i) != 0) { sq_seterr(tc.st, "index rebuild failed\0"); return 1; };
            };
            return 0;
        };

        // ---- DELETE ----

        // DELETE without WHERE: SQLite empties the table btree, then each index (newest first)
        def sq_tc_clear_all(SQ_TCTX* tc) -> int
        {
            SQLITE_DB* db = tc.db;
            SQ_CURSOR cur;
            int i, ok, n;
            n = 0;
            sq_cur_open(@cur, db, tc.root);
            ok = sq_cur_first(@cur);
            while (ok == 1) { n++; ok = sq_cur_next(@cur); };
            sq_cur_close(@cur);
            if (ok < 0) { return 1; };
            // SQLite order: rowid table first, explicit indexes newest first, then the
            // automatic indexes (the WITHOUT ROWID primary key among them) in creation order
            if (tc.wor == 0)
            {
                if (sq_tree_free(db, tc.root, 1, 13, 0) != 0) { sq_seterr(tc.st, "table delete failed\0"); return 1; };
            };
            for (i = tc.nix - 1; i >= 0; i--)
            {
                if (tc.ix[i].name[0] == (byte)115 & tc.ix[i].name[7] == (byte)97 & tc.ix[i].name[8] == (byte)117) { continue; };
                if (sq_tree_free(db, tc.ix[i].root, 1, 10, 0) != 0) { sq_seterr(tc.st, "index maintenance failed\0"); return 1; };
            };
            if (tc.wor == 1)
            {
                if (sq_tree_free(db, tc.root, 1, 10, 0) != 0) { sq_seterr(tc.st, "table delete failed\0"); return 1; };
            };
            for (i = 0; i < tc.nix; i++)
            {
                if (tc.ix[i].name[0] == (byte)115 & tc.ix[i].name[7] == (byte)97 & tc.ix[i].name[8] == (byte)117)
                {
                    if (sq_tree_free(db, tc.ix[i].root, 1, 10, 0) != 0) { sq_seterr(tc.st, "index maintenance failed\0"); return 1; };
                };
            };
            tc.st.changes = tc.st.changes + n;
            return 0;
        };


        // the select that produces rowid and all columns of the rows to change
        def sq_exec_delete(SQ_STMT* st, SQ_TCTX* tc, byte* name, int nl) -> int
        {
            SQLITE_DB* db = st.db;
            SQ_STMT* sub;
            SQ_SB sb;
            SQ_VAL* vals;
            SQ_ARENA ar;
            int ws, we, i, c, rc, r, as_s, as_e, hastrig, tr, nowhere;
            i64 rid;
            nowhere = 0;
            sq_cut_returning(st);
            hastrig = 0;
            if (sq_tbl_has_trg(db, @tc.tname[0])) { hastrig = 1; };
            // optional alias
            as_s = 0 - 1;
            if (st.tk == 1 & sq_is_kw(st, "where\0") == false & sq_is_kw(st, "order\0") == false & sq_is_kw(st, "limit\0") == false)
            {
                if (sq_is_kw(st, "as\0")) { sq_next(st); };
                as_s = sq_tok_start(st);
                as_e = st.tend;
                sq_next(st);
            };
            if (sq_ret_begin(st, tc, as_s, as_e) != 0) { return 1; };
            sq_sb_init(@sb);
            if (st.wp_e > st.wp_s) { sq_sb_add(@sb, @st.sql[st.wp_s], st.wp_e - st.wp_s); sq_sb_lit(@sb, " \0"); };
            if (tc.wor == 1) { sq_sb_lit(@sb, "select 0, * from \0"); } else { sq_sb_lit(@sb, "select rowid, * from \0"); };
            sq_sb_ident(@sb, name, nl);
            if (as_s >= 0) { sq_sb_lit(@sb, " as \0"); sq_sb_add(@sb, @st.sql[as_s], as_e - as_s); };
            if (sq_is_kw(st, "where\0") | sq_is_kw(st, "order\0") | sq_is_kw(st, "limit\0"))
            {
                ws = sq_tok_start(st);
                we = st.lim;
                while (we > ws)
                {
                    if (st.sql[we - 1] == (byte)32 | st.sql[we - 1] == (byte)9 | st.sql[we - 1] == (byte)10 | st.sql[we - 1] == (byte)13 | st.sql[we - 1] == (byte)59) { we--; } else { break; };
                };
                sq_sb_lit(@sb, " \0");
                sq_sb_add(@sb, @st.sql[ws], we - ws);
            }
            else
            {
                if (st.tk != 0 & sq_is_op(st, 59) == false) { sq_sb_free(@sb); sq_seterr(st, "syntax error in DELETE\0"); return 1; };
                nowhere = 1;
            };
            if (nowhere == 1 & hastrig == 0 & st.ret_s < 0 & tc.fkd == (u64)0)
            {
                sq_sb_free(@sb);
                rc = sq_tc_clear_all(tc);
                if (rc != 0) { return 1; };
                return sq_tc_finish(tc);
            };
            SQ_NORANGE = 1;
            SQ_NOAGG = 1;
            sub = sq_run_rows(db, st, sb.p);
            SQ_NOAGG = 0;
            SQ_NORANGE = 0;
            sq_sb_free(@sb);
            if ((u64)sub == (u64)0) { return 1; };
            vals = (SQ_VAL*)fmalloc((u64)(tc.ncols + 2) * (u64)sizeof(SQ_VAL));
            if ((u64)vals == (u64)0) { sq_stmt_del(sub); return 1; };
            sq_ar_init(@ar);
            rc = 0;
            if (st.ret_s >= 0)
            {
                for (i = 0; i < sub.res.n; i++)
                {
                    rid = sub.res.d[i * sub.res.nc].i;
                    if (tc.wor == 1)
                    {
                        sq_wor_tick(tc);
                        for (c = 0; c < tc.ncols; c++) { sq_val_copy(@vals[c], @sub.res.d[i * sub.res.nc + 1 + c]); };
                        rid = sq_wor_reg(tc, vals);
                    };
                    if (sq_tc_note(tc, rid) != 0) { rc = 1; break; };
                };
            };
            for (i = 0; i < sub.res.n; i++)
            {
                if (rc != 0) { break; };
                rid = sub.res.d[i * sub.res.nc].i;
                for (c = 0; c < tc.ncols; c++) { sq_val_copy(@vals[c], @sub.res.d[i * sub.res.nc + 1 + c]); };
                if (tc.wor == 1) { sq_wor_tick(tc); rid = sq_wor_reg(tc, vals); };
                sq_val_int(@vals[tc.ncols], rid);
                if (hastrig == 1)
                {
                    tr = sq_trig_fire(st, tc, 0, 3, (SQ_VAL*)0, vals, (int*)0, 0);
                    if (tr == 1) { rc = 1; break; };
                    if (tr == 2) { continue; };
                };
                // the row may have vanished (REPLACE side effects are not possible here, but stay safe)
                if (sq_tc_remove(tc, rid, vals) != 0) { rc = 1; break; };
                st.changes++;
                if (sq_fk_delete(st, tc, vals, rid) != 0) { rc = 1; break; };
                if (hastrig == 1)
                {
                    tr = sq_trig_fire(st, tc, 1, 3, (SQ_VAL*)0, vals, (int*)0, 0);
                    if (tr == 1) { rc = 1; break; };
                };
            };
            sq_ar_free(@ar);
            ffree((u64)vals);
            sq_stmt_del(sub);
            if (rc != 0) { return 1; };
            return sq_tc_finish(tc);
        };

        // ---- UPDATE ----

        def sq_exec_update(SQ_STMT* st, SQ_TCTX* tc, int onconf, byte* name, int nl) -> int
        {
            SQLITE_DB* db = st.db;
            SQ_TI* ti;
            SQ_CHK chk;
            SQ_STMT* sub;
            SQ_SB sb;
            SQ_VAL* nw;
            SQ_VAL* ol;
            int[130] scol;
            int nset, c, j, i, ws, we, es, ee, r, rc, ipk, changed, k, oc, as_s, as_e, rn, depth, hastrig, tr;
            i64 rowid, newrid, seq, mx;
            ti = tc.ti;
            ipk = ti.ipk;
            hastrig = 0;
            if (sq_tbl_has_trg(st.db, @tc.tname[0])) { hastrig = 1; };
            sq_cut_returning(st);
            // optional alias before SET
            as_s = 0 - 1;
            if (st.tk == 1 & sq_is_kw(st, "set\0") == false)
            {
                if (sq_is_kw(st, "as\0")) { sq_next(st); };
                as_s = sq_tok_start(st);
                as_e = st.tend;
                sq_next(st);
            };
            if (sq_is_kw(st, "set\0") == false) { sq_seterr(st, "expected SET\0"); return 1; };
            if (sq_ret_begin(st, tc, as_s, as_e) != 0) { return 1; };
            sq_next(st);
            sq_sb_init(@sb);
            if (st.wp_e > st.wp_s) { sq_sb_add(@sb, @st.sql[st.wp_s], st.wp_e - st.wp_s); sq_sb_lit(@sb, " \0"); };
            if (tc.wor == 1) { sq_sb_lit(@sb, "select 0, *\0"); } else { sq_sb_lit(@sb, "select rowid, *\0"); };
            nset = 0;
            while (true)
            {
                if (sq_is_op(st, 40))
                {
                    // SET (a, b, ...) = (x, y, ...)
                    rn = 0;
                    sq_next(st);
                    while (true)
                    {
                        if (st.tk != 1) { sq_seterr(st, "expected a column name\0"); sq_sb_free(@sb); return 1; };
                        c = sq_ti_find(ti, @st.sql[0], st.ts, st.tl);
                        if (c < 0)
                        {
                            if (sq_is_rowid_name(@st.sql[st.ts], st.tl) & tc.ti.wor == 0) { c = ipk; if (c < 0) { c = tc.ncols; }; };
                        };
                        if (c < 0) { sq_err_name(st, "no such column: \0", @st.sql[st.ts], st.tl, "\0"); sq_sb_free(@sb); return 1; };
                        if (c < tc.ncols) { if (ti.gen[c] != 0) { sq_err_gen(st, ti, c, 0); sq_sb_free(@sb); return 1; }; };
                        if (nset + rn >= 120) { sq_seterr(st, "too many assignments\0"); sq_sb_free(@sb); return 1; };
                        scol[nset + rn] = c;
                        rn++;
                        sq_next(st);
                        if (sq_is_op(st, 44)) { sq_next(st); continue; };
                        break;
                    };
                    if (sq_is_op(st, 41) == false) { sq_seterr(st, "expected )\0"); sq_sb_free(@sb); return 1; };
                    sq_next(st);
                    if (sq_is_op(st, 61) == false) { sq_seterr(st, "expected =\0"); sq_sb_free(@sb); return 1; };
                    sq_next(st);
                    if (sq_is_op(st, 40) == false) { sq_seterr(st, "row value misused\0"); sq_sb_free(@sb); return 1; };
                    sq_next(st);
                    if (sq_is_kw(st, "select\0") | sq_is_kw(st, "with\0") | sq_is_kw(st, "values\0"))
                    {
                        es = sq_tok_start(st);
                        depth = 1;
                        while (st.tk != 0)
                        {
                            if (sq_is_op(st, 40)) { depth++; };
                            if (sq_is_op(st, 41)) { depth--; if (depth == 0) { break; }; };
                            sq_next(st);
                        };
                        if (depth != 0) { sq_seterr(st, "expected )\0"); sq_sb_free(@sb); return 1; };
                        ee = sq_tok_start(st);
                        for (k = 0; k < rn; k++)
                        {
                            sq_sb_lit(@sb, ", __subcol(\0");
                            sq_sb_int(@sb, (i64)k);
                            sq_sb_lit(@sb, ", \0");
                            sq_sb_int(@sb, (i64)rn);
                            sq_sb_lit(@sb, ", \0");
                            sq_sb_add(@sb, @st.sql[es], ee - es);
                            sq_sb_lit(@sb, ")\0");
                        };
                        sq_next(st);
                        nset = nset + rn;
                        if (sq_is_op(st, 44)) { sq_next(st); continue; };
                        break;
                    };
                    for (k = 0; k < rn; k++)
                    {
                        es = sq_tok_start(st);
                        ee = sq_skip_expr(st, 1);
                        if (ee <= es) { sq_seterr(st, "expected an expression\0"); sq_sb_free(@sb); return 1; };
                        sq_sb_lit(@sb, ", (\0");
                        sq_sb_add(@sb, @st.sql[es], ee - es);
                        sq_sb_lit(@sb, ")\0");
                        if (k + 1 < rn)
                        {
                            if (sq_is_op(st, 44) == false) { sq_seterr_asg(st, rn, k + 1); sq_sb_free(@sb); return 1; };
                            sq_next(st);
                        };
                    };
                    if (sq_is_op(st, 44))
                    {
                        sq_seterr_asg(st, rn, rn + 1); sq_sb_free(@sb); return 1;
                    };
                    if (sq_is_op(st, 41) == false) { sq_seterr(st, "expected )\0"); sq_sb_free(@sb); return 1; };
                    sq_next(st);
                    nset = nset + rn;
                    if (sq_is_op(st, 44)) { sq_next(st); continue; };
                    break;
                };
                if (st.tk != 1) { sq_seterr(st, "expected a column name\0"); sq_sb_free(@sb); return 1; };
                c = sq_ti_find(ti, @st.sql[0], st.ts, st.tl);
                if (c < 0)
                {
                    if (sq_is_rowid_name(@st.sql[st.ts], st.tl) & tc.ti.wor == 0) { c = ipk; if (c < 0) { c = tc.ncols; }; };
                };
                if (c < 0) { sq_err_name(st, "no such column: \0", @st.sql[st.ts], st.tl, "\0"); sq_sb_free(@sb); return 1; };
                if (c < tc.ncols) { if (ti.gen[c] != 0) { sq_err_gen(st, ti, c, 0); sq_sb_free(@sb); return 1; }; };
                if (nset >= 120) { sq_seterr(st, "too many assignments\0"); sq_sb_free(@sb); return 1; };
                scol[nset] = c;
                sq_next(st);
                if (sq_is_op(st, 61) == false) { sq_seterr(st, "expected =\0"); sq_sb_free(@sb); return 1; };
                sq_next(st);
                es = sq_tok_start(st);
                ee = sq_skip_expr(st, 1);
                if (ee <= es) { sq_seterr(st, "expected an expression\0"); sq_sb_free(@sb); return 1; };
                sq_sb_lit(@sb, ", (\0");
                sq_sb_add(@sb, @st.sql[es], ee - es);
                sq_sb_lit(@sb, ")\0");
                nset++;
                if (sq_is_op(st, 44)) { sq_next(st); continue; };
                break;
            };
            sq_sb_lit(@sb, " from \0");
            sq_sb_ident(@sb, name, nl);
            if (as_s >= 0) { sq_sb_lit(@sb, " as \0"); sq_sb_add(@sb, @st.sql[as_s], as_e - as_s); };
            if (sq_is_kw(st, "where\0") | sq_is_kw(st, "order\0") | sq_is_kw(st, "limit\0"))
            {
                ws = sq_tok_start(st);
                we = st.lim;
                while (we > ws)
                {
                    if (st.sql[we - 1] == (byte)32 | st.sql[we - 1] == (byte)9 | st.sql[we - 1] == (byte)10 | st.sql[we - 1] == (byte)13 | st.sql[we - 1] == (byte)59) { we--; } else { break; };
                };
                sq_sb_lit(@sb, " \0");
                sq_sb_add(@sb, @st.sql[ws], we - ws);
            }
            else
            {
                if (st.tk != 0 & sq_is_op(st, 59) == false) { sq_sb_free(@sb); sq_seterr(st, "syntax error in UPDATE\0"); return 1; };
            };
            if (sq_chk_open(tc, @chk) != 0) { sq_sb_free(@sb); return 1; };
            SQ_NORANGE = 1;
            SQ_NOAGG = 1;
            sub = sq_run_rows(db, st, sb.p);
            SQ_NOAGG = 0;
            SQ_NORANGE = 0;
            sq_sb_free(@sb);
            if ((u64)sub == (u64)0) { sq_chk_close(@chk); return 1; };
            nw = tc.nw;
            ol = tc.ol;
            seq = (i64)0;
            rc = 0;
            for (i = 0; i < sub.res.n; i++)
            {
                rowid = sub.res.d[i * sub.res.nc].i;
                if (tc.wor == 1)
                {
                    sq_wor_tick(tc);
                    for (c = 0; c < tc.ncols; c++) { sq_val_copy(@ol[c], @sub.res.d[i * sub.res.nc + 1 + c]); };
                    rowid = sq_wor_reg(tc, ol);
                };
                // the row may have been removed by a REPLACE earlier in this statement
                if (i > 0)
                {
                    r = sq_tc_exists(tc, rowid);
                    if (r < 0) { rc = 1; break; };
                    if (r == 0) { continue; };
                };
                for (c = 0; c < tc.ncols; c++)
                {
                    sq_val_copy(@ol[c], @sub.res.d[i * sub.res.nc + 1 + c]);
                    sq_val_copy(@nw[c], @ol[c]);
                };
                sq_val_int(@ol[tc.ncols], rowid);
                for (j = 0; j < nset; j++)
                {
                    oc = scol[j];
                    sq_val_copy(@nw[oc], @sub.res.d[i * sub.res.nc + 1 + tc.ncols + j]);
                    sq_val_own(@tc.ar, @nw[oc]);
                    if (oc == tc.ncols) { sq_val_copy(@nw[tc.ncols], @nw[oc]); };
                };
                if (sq_tc_affinity(tc, nw) != 0) { rc = 1; break; };
                newrid = rowid;
                if (tc.wor == 1) { newrid = sq_wor_reg(tc, nw); }
                else {
                if (ipk >= 0)
                {
                    if (nw[ipk].t == SQ_NULL) { sq_seterr(st, "datatype mismatch\0"); rc = 1; break; };
                    if (nw[ipk].t != SQ_INTEGER) { sq_seterr(st, "datatype mismatch\0"); rc = 1; break; };
                    newrid = nw[ipk].i;
                }
                else
                {
                    for (j = 0; j < nset; j++)
                    {
                        if (scol[j] == tc.ncols)
                        {
                            sq_cast(@tc.ar, @nw[tc.ncols], 3, @nw[tc.ncols]);
                            newrid = nw[tc.ncols].i;
                        };
                    };
                };
                };
                sq_val_int(@nw[tc.ncols], newrid);
                if (hastrig == 1)
                {
                    tr = sq_trig_fire(st, tc, 0, 2, nw, ol, @scol[0], nset);
                    if (tr == 1) { rc = 1; break; };
                    if (tr == 2) { sq_ar_reset(@tc.ar); continue; };
                };
                r = sq_tc_check(tc, @chk, nw, newrid, 1, rowid, onconf);
                if (r == 1) { rc = 1; break; };
                if (r == 5) { sq_ar_reset(@tc.ar); continue; };
                // replace the row: remove the old one, store the new one
                if (sq_tc_update(tc, rowid, newrid, ol, nw, @scol[0], nset) != 0) { rc = 1; break; };
                st.changes++;
                if (sq_tc_note(tc, newrid) != 0) { rc = 1; break; };
                if (sq_fk_update(st, tc, ol, nw, newrid) != 0) { rc = 1; break; };
                if (hastrig == 1)
                {
                    tr = sq_trig_fire(st, tc, 1, 2, nw, ol, @scol[0], nset);
                    if (tr == 1) { rc = 1; break; };
                };
                sq_ar_reset(@tc.ar);
            };
            sq_stmt_del(sub);
            sq_chk_close(@chk);
            if (rc != 0) { return 1; };
            return sq_tc_finish(tc);
        };

        // ---- rewriting dependent objects after ALTER TABLE ... RENAME ----

        // keyword before the token at position ts (lower case compare), 1 when it is one of the table position words
        def sq_ren_tblpos(byte* s, int prevs, int prevl) -> bool
        {
            if (prevl <= 0) { return false; };
            if (sq_ieq(@s[prevs], prevl, "from\0") | sq_ieq(@s[prevs], prevl, "join\0") | sq_ieq(@s[prevs], prevl, "into\0") | sq_ieq(@s[prevs], prevl, "update\0") | sq_ieq(@s[prevs], prevl, "table\0") | sq_ieq(@s[prevs], prevl, "references\0") | sq_ieq(@s[prevs], prevl, "on\0")) { return true; };
            return false;
        };

        // Rewrites the table name old to the quoted text nw wherever it is used as a table in the stored SQL. Returns the count.
        def sq_sql_dep_tbl(byte* s, byte* old, int ol, byte* nw, int nlen, SQ_SB* out) -> int
        {
            int i, end, ts, tl, kd, last, count, ps, pl, rep, infrom, nx, t2, l2, k2;
            end = sq_cstrlen(s);
            i = 0;
            last = 0;
            count = 0;
            ps = 0; pl = 0;
            infrom = 0;
            while (i < end)
            {
                i = sq_tok2(s, i, end, @ts, @tl, @kd);
                if (kd == 0) { break; };
                rep = 0;
                if (kd == 1 | kd == 2)
                {
                    if (kd == 1) { if (sq_tname_eq(s, ts, tl, old, 0, ol)) { rep = 1; }; };
                    if (kd == 2) { if (sq_tname_eq(s, ts + 1, tl - 2, old, 0, ol)) { rep = 1; }; };
                    if (rep == 1)
                    {
                        rep = 0;
                        if (sq_ren_tblpos(s, ps, pl)) { rep = 1; };
                        nx = sq_tok2(s, i, end, @t2, @l2, @k2);
                        if (k2 == 5) { if (s[t2] == (byte)46) { rep = 1; }; };
                        if (infrom == 1 & pl == 1) { if (s[ps] == (byte)44) { rep = 1; }; };
                        // a column of a qualified name (x.old) is not a table
                        if (pl == 1) { if (s[ps] == (byte)46) { rep = 0; }; };
                    };
                    if (kd == 1)
                    {
                        if (sq_ieq(@s[ts], tl, "from\0") | sq_ieq(@s[ts], tl, "join\0")) { infrom = 1; };
                        if (sq_ieq(@s[ts], tl, "where\0") | sq_ieq(@s[ts], tl, "group\0") | sq_ieq(@s[ts], tl, "order\0") | sq_ieq(@s[ts], tl, "having\0") | sq_ieq(@s[ts], tl, "limit\0") | sq_ieq(@s[ts], tl, "select\0") | sq_ieq(@s[ts], tl, "set\0") | sq_ieq(@s[ts], tl, "values\0") | sq_ieq(@s[ts], tl, "union\0") | sq_ieq(@s[ts], tl, "window\0") | sq_ieq(@s[ts], tl, "returning\0") | sq_ieq(@s[ts], tl, "begin\0")) { infrom = 0; };
                    };
                };
                if (rep == 1)
                {
                    sq_sb_add(out, @s[last], ts - last);
                    sq_sb_add(out, nw, nlen);
                    last = ts + tl;
                    count++;
                };
                ps = ts; pl = tl;
                if (kd == 4) { i = ts + 1; ps = ts; pl = 0; };
            };
            sq_sb_add(out, @s[last], end - last);
            return count;
        };

        // table rename: rewrites views, triggers and the foreign keys of other tables. nw is the quoted new name.
        def sq_ren_tbl_deps(SQ_STMT* st, byte* old, int ol, byte* nw, int nlen, byte* newplain, int npl) -> int
        {
            SQLITE_DB* db = st.db;
            SQ_SB nsql;
            int i, cnt, rc, kind;
            i64 rid;
            byte* tn;
            byte* ty;
            for (i = 0; i < db.nschema; i++)
            {
                kind = db.schema[i].kind;
                if (kind != 3 & kind != 4 & kind != 1) { continue; };
                if ((u64)db.schema[i].sql == (u64)0) { continue; };
                if (kind == 1)
                {
                    if (sq_ihas(db.schema[i].sql, sq_cstrlen(db.schema[i].sql), "references\0") == false) { continue; };
                };
                sq_sb_init(@nsql);
                cnt = sq_sql_dep_tbl(db.schema[i].sql, old, ol, nw, nlen, @nsql);
                if (kind == 1) { if (sq_name_is(old, ol, @db.schema[i].name[0])) { sq_sb_free(@nsql); continue; }; };
                tn = @db.schema[i].tbl_name[0];
                if (kind == 4)
                {
                    // a trigger on the renamed table follows it
                    if (sq_name_is(old, ol, tn)) { tn = newplain; cnt = cnt + 1; };
                };
                if (cnt == 0 | nsql.err != 0) { sq_sb_free(@nsql); continue; };
                ty = "table\0";
                if (kind == 3) { ty = "view\0"; };
                if (kind == 4) { ty = "trigger\0"; };
                rid = sq_master_find(db, @db.schema[i].name[0], sq_cstrlen(@db.schema[i].name[0]), ty);
                if (rid < (i64)0) { sq_sb_free(@nsql); continue; };
                rc = sq_master_replace(db, rid, ty, @db.schema[i].name[0], tn, db.schema[i].rootpage, nsql.p);
                sq_sb_free(@nsql);
                if (rc != 0) { sq_seterr(st, "write error\0"); return 1; };
            };
            return 0;
        };

        // true when the token at ts..ts+tl equals the name
        def sq_ren_tok_is(byte* s, int ts, int tl, int kd, byte* nm, int nl) -> bool
        {
            if (kd == 1) { return sq_tname_eq(s, ts, tl, nm, 0, nl); };
            if (kd == 2) { return sq_tname_eq(s, ts + 1, tl - 2, nm, 0, nl); };
            return false;
        };

        // Foreign keys of other tables: "references T ( cols )": renames the column in the list.
        def sq_sql_dep_fkcol(byte* s, byte* tname, int tl, byte* oc, int ocl, byte* nc, int ncl, SQ_SB* out) -> int
        {
            int i, end, ts, tl2, kd, last, count, st2, ps, pl, nx, t2, l2, k2, q, a, b, k3, l3, kk;
            end = sq_cstrlen(s);
            i = 0;
            last = 0;
            count = 0;
            ps = 0; pl = 0;
            while (i < end)
            {
                nx = sq_tok2(s, i, end, @ts, @tl2, @kd);
                if (kd == 0) { break; };
                i = nx;
                if (kd == 4) { i = ts + 1; };
                if (kd == 1)
                {
                    if (sq_ieq(@s[ts], tl2, "references\0"))
                    {
                        i = sq_tok2(s, i, end, @t2, @l2, @k2);
                        if (sq_ren_tok_is(s, t2, l2, k2, tname, tl))
                        {
                            nx = sq_tok2(s, i, end, @a, @b, @kk);
                            if (kk == 4)
                            {
                                q = a + 1;
                                while (q < a + b - 1)
                                {
                                    q = sq_tok2(s, q, a + b - 1, @t2, @l2, @k2);
                                    if (k2 == 0) { break; };
                                    if (sq_ren_tok_is(s, t2, l2, k2, oc, ocl))
                                    {
                                        sq_sb_add(out, @s[last], t2 - last);
                                        sq_sb_add(out, nc, ncl);
                                        last = t2 + l2;
                                        count++;
                                    };
                                };
                                i = nx;
                            };
                        };
                    };
                };
            };
            sq_sb_add(out, @s[last], end - last);
            return count;
        };

        // Renames occurrences of oc inside a trigger: NEW.x / OLD.x, UPDATE OF lists, and bare names in statements that
        // target the renamed table.
        // is the parenthesis group starting at ts a subquery
        def sq_trig_issub(byte* s, int ts, int end) -> bool
        {
            int a, b, c;
            sq_tok2(s, ts + 1, end, @a, @b, @c);
            if (c != 1) { return false; };
            if (sq_ieq(@s[a], b, "select\0")) { return true; };
            if (sq_ieq(@s[a], b, "with\0")) { return true; };
            return false;
        };

        // which query scopes of a trigger body name the table in a table position: sf[k] is 1 for scope k. A scope is a statement
        // or a parenthesised subquery; scopes are numbered in the order they open.
        def sq_trig_tf(byte* s, byte* tname, int tl, int* sf) -> void
        {
            int i, end, ts, tl2, kd, ps, pl, inbody, k, nsc, sp;
            int[64] stk;
            end = sq_cstrlen(s);
            for (k = 0; k < 128; k++) { sf[k] = 0; };
            i = 0; ps = 0; pl = 0; inbody = 0; nsc = 0; sp = 0;
            stk[0] = 0;
            while (i < end)
            {
                i = sq_tok2(s, i, end, @ts, @tl2, @kd);
                if (kd == 0) { break; };
                if (kd == 1)
                {
                    if (sq_ieq(@s[ts], tl2, "begin\0"))
                    {
                        inbody = 1; sp = 0;
                        if (nsc < 126) { nsc++; }; stk[0] = nsc;
                    };
                };
                if (inbody == 1 & (kd == 1 | kd == 2))
                {
                    if (sq_ren_tblpos(s, ps, pl) & sq_ieq(@s[ps], pl, "on\0") == false & sq_ieq(@s[ps], pl, "into\0") == false)
                    {
                        if (sq_ren_tok_is(s, ts, tl2, kd, tname, tl)) { sf[stk[sp]] = 1; };
                    };
                };
                if (kd == 5 & inbody == 1)
                {
                    if (s[ts] == (byte)59) { sp = 0; if (nsc < 126) { nsc++; }; stk[0] = nsc; };
                    if (s[ts] == (byte)41) { if (sp > 0) { sp--; }; };
                };
                ps = ts; pl = tl2;
                if (kd == 4)
                {
                    if (inbody == 1 & sp < 60)
                    {
                        if (sq_trig_issub(s, ts, end)) { if (nsc < 126) { nsc++; }; stk[sp + 1] = nsc; }
                        else { stk[sp + 1] = stk[sp]; };
                        sp++;
                    };
                    i = ts + 1; ps = ts; pl = 0;
                };
            };
        };

        def sq_sql_dep_trigcol(byte* s, byte* tname, int tl, byte* oc, int ocl, byte* nc, int ncl, int ontable, SQ_SB* out) -> int
        {
            int i, end, ts, tl2, kd, last, count, ps, pl, rep, nx, pps, ppl, depth, instmt, target, inbody, first, p3s, p3l, sidx, intoother;
            int[128] tf;
            int[64] stk;
            int sp, nsc, intot;
            end = sq_cstrlen(s);
            i = 0;
            last = 0;
            count = 0;
            ps = 0; pl = 0; pps = 0; ppl = 0;
            inbody = 0;
            instmt = 0;
            target = 0;
            first = 1;
            sidx = 0;
            intoother = 0;
            sq_trig_tf(s, tname, tl, @tf[0]);
            sp = 0; nsc = 0; stk[0] = 0; intot = 0;
            while (i < end)
            {
                i = sq_tok2(s, i, end, @ts, @tl2, @kd);
                if (kd == 0) { break; };
                rep = 0;
                if (kd == 4 & intoother == 2 & inbody == 1)
                {
                    // the column list of an INSERT into another table
                    intoother = 0;
                    ps = ts; pl = 0;
                    continue;
                };
                if (intoother == 2) { intoother = 0; };
                if (kd == 1 | kd == 2)
                {
                    if (sq_ren_tok_is(s, ts, tl2, kd, oc, ocl))
                    {
                        // NEW.x and OLD.x
                        if (pl == 1 & s[ps] == (byte)46)
                        {
                            if (sq_ieq(@s[pps], ppl, "new\0") | sq_ieq(@s[pps], ppl, "old\0")) { if (ontable == 1) { rep = 1; }; };
                            if (sq_ren_tok_is(s, pps, ppl, 1, tname, tl)) { rep = 1; };
                        }
                        else
                        {
                            // UPDATE OF col, col
                            if (inbody == 0 & ontable == 1) { rep = 1; };
                            if (inbody == 1 & target == 1) { rep = 1; };
                        };
                    };
                    if (kd == 1)
                    {
                        if (sq_ieq(@s[ts], tl2, "begin\0")) { inbody = 1; instmt = 0; target = 0; sp = 0; if (nsc < 126) { nsc++; }; stk[0] = nsc; };
                        if (sq_ieq(@s[ts], tl2, "when\0")) { inbody = 2; };
                    };
                };
                if (kd == 5)
                {
                    if (s[ts] == (byte)59) { instmt = 0; target = 0; intoother = 0; if (inbody == 1) { sp = 0; if (nsc < 126) { nsc++; }; stk[0] = nsc; }; };
                    if (s[ts] == (byte)41) { if (inbody == 1 & sp > 0) { sp--; target = tf[stk[sp]]; }; };
                };
                if (inbody == 1 & kd == 1 & instmt == 0)
                {
                    // start of a statement: find its target table
                    instmt = 1;
                    target = tf[stk[sp]];
                };
                if (inbody == 1 & (kd == 1 | kd == 2))
                {
                    if (sq_ren_tblpos(s, ps, pl) & sq_ieq(@s[ps], pl, "on\0") == false)
                    {
                        if (sq_ieq(@s[ps], pl, "into\0")) { if (sq_ren_tok_is(s, ts, tl2, kd, tname, tl) == false) { intoother = 3; } else { intot = 2; }; };
                    };
                };
                if (rep == 1)
                {
                    sq_sb_add(out, @s[last], ts - last);
                    sq_sb_add(out, nc, ncl);
                    last = ts + tl2;
                    count++;
                };
                pps = ps; ppl = pl;
                ps = ts; pl = tl2;
                if (intoother == 3) { intoother = 2; };
                if (kd == 4)
                {
                    if (inbody == 1 & sp < 60)
                    {
                        if (sq_trig_issub(s, ts, end)) { if (nsc < 126) { nsc++; }; stk[sp + 1] = nsc; }
                        else { stk[sp + 1] = stk[sp]; };
                        sp++;
                        target = tf[stk[sp]];
                        if (intot == 1) { target = 1; };
                    };
                    i = ts + 1; ps = ts; pl = 0;
                };
                if (intot > 0) { intot--; };
            };
            sq_sb_add(out, @s[last], end - last);
            return count;
        };

        // Columns of views: bind the view, then rewrite the exact tokens that resolve to the renamed column.
        def sq_ren_view_col(SQ_STMT* st, int vi, byte* tname, int tl, int tcol, byte* nc, int ncl, int* changed) -> int
        {
            SQLITE_DB* db = st.db;
            SQ_STMT* g;
            SQ_SB q;
            SQ_SB out;
            SQ_NODE* nd;
            SQ_SRC* sr;
            int[64] ps;
            int[64] pl;
            int n, i, j, base, vl, rc, t, a;
            byte* vs;
            i64 rid;
            *changed = 0;
            vs = db.schema[vi].sql;
            if ((u64)vs == (u64)0) { return 0; };
            vl = sq_cstrlen(vs);
            sq_sb_init(@q);
            sq_sb_lit(@q, "select * from \0");
            sq_sb_ident(@q, @db.schema[vi].name[0], sq_cstrlen(@db.schema[vi].name[0]));
            g = sq_stmt_new();
            if ((u64)g == (u64)0) { sq_sb_free(@q); return 1; };
            base = q.n + 1;
            rc = sq_prep_query(g, db, q.p);
            sq_sb_free(@q);
            if (rc != 0) { sq_stmt_del(g); return 0; };
            n = 0;
            for (i = 0; i < g.nn; i++)
            {
                nd = @g.nodes[i];
                if (nd.kind != SQN_COL) { continue; };
                if (nd.src < 0 | nd.rblk < 0) { continue; };
                if (nd.s < base | nd.s >= base + vl) { continue; };
                sr = @g.blks[nd.rblk].src[nd.src];
                if (sr.kind != 1) { continue; };
                if (nd.col != tcol) { continue; };
                if (sq_tname_eq(@g.sql[0], sr.ts, sr.tl, tname, 0, tl) == false) { continue; };
                if (n < 64) { ps[n] = nd.s - base; pl[n] = nd.sl; n++; };
            };
            sq_stmt_del(g);
            if (n == 0) { return 0; };
            // sort ascending
            for (i = 1; i < n; i++)
            {
                a = ps[i]; t = pl[i];
                j = i - 1;
                while (j >= 0 & ps[j] > a) { ps[j + 1] = ps[j]; pl[j + 1] = pl[j]; j--; };
                ps[j + 1] = a; pl[j + 1] = t;
            };
            sq_sb_init(@out);
            j = 0;
            for (i = 0; i < n; i++)
            {
                if (i > 0) { if (ps[i] == ps[i - 1]) { continue; }; };
                sq_sb_add(@out, @vs[j], ps[i] - j);
                sq_sb_add(@out, nc, ncl);
                j = ps[i] + pl[i];
                // a quoted name keeps its quotes in the span: the span covers the name only
                if (vs[j] == (byte)34 | vs[j] == (byte)96) { j++; };
            };
            sq_sb_add(@out, @vs[j], vl - j);
            rid = sq_master_find(db, @db.schema[vi].name[0], sq_cstrlen(@db.schema[vi].name[0]), "view\0");
            if (rid < (i64)0) { sq_sb_free(@out); return 0; };
            rc = sq_master_replace(db, rid, "view\0", @db.schema[vi].name[0], @db.schema[vi].tbl_name[0], 0, out.p);
            sq_sb_free(@out);
            *changed = 1;
            if (rc != 0) { return 1; };
            return 0;
        };

        // column rename: rewrites views, triggers and foreign keys of other tables
        def sq_ren_col_deps(SQ_STMT* st, byte* tname, int tl, int tcol, byte* oc, int ocl, byte* nc, int ncl) -> int
        {
            SQLITE_DB* db = st.db;
            SQ_SB nsql;
            int i, cnt, rc, kind, ch, ontable, cnt2;
            i64 rid;
            byte* ty;
            for (i = 0; i < db.nschema; i++)
            {
                kind = db.schema[i].kind;
                if (kind != 3 & kind != 4 & kind != 1) { continue; };
                if ((u64)db.schema[i].sql == (u64)0) { continue; };
                if (kind == 3)
                {
                    if (sq_ren_view_col(st, i, tname, tl, tcol, nc, ncl, @ch) != 0) { sq_seterr(st, "write error\0"); return 1; };
                    continue;
                };
                sq_sb_init(@nsql);
                if (kind == 1)
                {
                    if (sq_name_is(tname, tl, @db.schema[i].name[0])) { sq_sb_free(@nsql); continue; };
                    if (sq_ihas(db.schema[i].sql, sq_cstrlen(db.schema[i].sql), "references\0") == false) { sq_sb_free(@nsql); continue; };
                    cnt = sq_sql_dep_fkcol(db.schema[i].sql, tname, tl, oc, ocl, nc, ncl, @nsql);
                    ty = "table\0";
                }
                else
                {
                    ontable = 0;
                    if (sq_name_is(tname, tl, @db.schema[i].tbl_name[0])) { ontable = 1; };
                    cnt = sq_sql_dep_trigcol(db.schema[i].sql, tname, tl, oc, ocl, nc, ncl, ontable, @nsql);
                    ty = "trigger\0";
                };
                if (cnt == 0 | nsql.err != 0) { sq_sb_free(@nsql); continue; };
                rid = sq_master_find(db, @db.schema[i].name[0], sq_cstrlen(@db.schema[i].name[0]), ty);
                if (rid < (i64)0) { sq_sb_free(@nsql); continue; };
                rc = sq_master_replace(db, rid, ty, @db.schema[i].name[0], @db.schema[i].tbl_name[0], db.schema[i].rootpage, nsql.p);
                sq_sb_free(@nsql);
                if (rc != 0) { sq_seterr(st, "write error\0"); return 1; };
            };
            return 0;
        };

        // First reference to column oc of the table inside a trigger (same rules as sq_sql_dep_trigcol); msg receives the
        // name as SQLite reports it (new.x / old.x / x). Returns 1 when found.
        def sq_sql_trig_ref(byte* s, byte* tname, int tl, byte* oc, int ocl, int ontable, byte* msg) -> int
        {
            int i, end, ts, tl2, kd, ps, pl, pps, ppl, inbody, instmt, target, hit, k, n;
            end = sq_cstrlen(s);
            i = 0;
            ps = 0; pl = 0; pps = 0; ppl = 0;
            inbody = 0; instmt = 0; target = 0;
            while (i < end)
            {
                i = sq_tok2(s, i, end, @ts, @tl2, @kd);
                if (kd == 0) { break; };
                hit = 0;
                if (kd == 1 | kd == 2)
                {
                    if (sq_ren_tok_is(s, ts, tl2, kd, oc, ocl))
                    {
                        if (pl == 1 & s[ps] == (byte)46)
                        {
                            if (sq_ieq(@s[pps], ppl, "new\0") | sq_ieq(@s[pps], ppl, "old\0")) { if (ontable == 1) { hit = 2; }; };
                            if (sq_ren_tok_is(s, pps, ppl, 1, tname, tl)) { hit = 1; };
                        }
                        else
                        {
                            if (inbody == 0 & ontable == 1) { hit = 1; };
                            if (inbody == 1 & target == 1) { hit = 1; };
                        };
                    };
                    if (kd == 1)
                    {
                        if (sq_ieq(@s[ts], tl2, "begin\0")) { inbody = 1; instmt = 0; target = 0; };
                        if (sq_ieq(@s[ts], tl2, "when\0")) { inbody = 2; };
                    };
                };
                if (kd == 5) { if (s[ts] == (byte)59) { instmt = 0; target = 0; }; };
                if (inbody == 1 & kd == 1 & instmt == 0) { instmt = 1; target = 0; };
                if (inbody == 1 & (kd == 1 | kd == 2))
                {
                    if (sq_ren_tblpos(s, ps, pl) & sq_ieq(@s[ps], pl, "on\0") == false)
                    {
                        if (sq_ren_tok_is(s, ts, tl2, kd, tname, tl)) { target = 1; };
                    };
                };
                if (hit != 0)
                {
                    n = 0;
                    if (hit == 2)
                    {
                        for (k = 0; k < ppl & n < 60; k++) { msg[n] = s[pps + k]; n++; };
                        msg[n] = (byte)46; n++;
                    }
                    else
                    {
                        if (pl == 1 & s[ps] == (byte)46)
                        {
                            for (k = 0; k < ppl & n < 60; k++) { msg[n] = s[pps + k]; n++; };
                            msg[n] = (byte)46; n++;
                        };
                    };
                    for (k = 0; k < tl2 & n < 120; k++) { msg[n] = s[ts + k]; n++; };
                    msg[n] = (byte)0;
                    return 1;
                };
                pps = ps; ppl = pl;
                ps = ts; pl = tl2;
                if (kd == 4) { i = ts + 1; ps = ts; pl = 0; };
            };
            return 0;
        };

        // true when the text between a and a+n contains an identifier equal to the name
        def sq_span_has_id(byte* s, int a, int n, byte* nm, int nl) -> bool
        {
            int i, ts, tl2, kd;
            i = a;
            while (i < a + n)
            {
                i = sq_tok2(s, i, a + n, @ts, @tl2, @kd);
                if (kd == 0) { break; };
                if (sq_ren_tok_is(s, ts, tl2, kd, nm, nl)) { return true; };
                if (kd == 4) { i = ts + 1; };
            };
            return false;
        };

        // ---- DDL helpers ----

        // true when a schema object (table, view or index) of that name exists
        def sq_obj_exists(SQLITE_DB* db, byte* name, int nl) -> int
        {
            int i;
            for (i = 0; i < db.nschema; i++)
            {
                if (sq_name_is(name, nl, @db.schema[i].name[0])) { return db.schema[i].kind; };
            };
            return 0;
        };

        // allocates a root page holding an empty leaf of the given type
        def sq_new_root(SQLITE_DB* db, int type) -> int
        {
            SQ_PM pm;
            int pg, rc;
            pg = sq_alloc_page_near(db, 1);
            if (pg == 0) { return 0; };
            rc = sq_pm_empty(db, pg, type);
            if (rc != 0) { return 0; };
            return pg;
        };

        // copy of the statement text from offset a to the end without trailing blanks and semicolons
        def sq_tail_text(SQ_STMT* st, int a, SQ_SB* sb) -> void
        {
            int e = st.sqllen;
            while (e > a)
            {
                if (st.sql[e - 1] == (byte)32 | st.sql[e - 1] == (byte)9 | st.sql[e - 1] == (byte)10 | st.sql[e - 1] == (byte)13 | st.sql[e - 1] == (byte)59) { e--; } else { break; };
            };
            sq_sb_add(sb, @st.sql[a], e - a);
        };

        // ---- CREATE TABLE ----

        // ---- CREATE TABLE ... AS SELECT ----

        // true when the word is a keyword of the SQL dialect (such names are quoted in stored text)
        def sq_is_keyword(byte* s, int n) -> bool
        {
            byte[48] w;
            int i;
            byte* kws;
            if (n > 20 | n < 2) { return false; };
            w[0] = (byte)124;
            for (i = 0; i < n; i++) { w[1 + i] = sq_lc(s[i]); };
            w[n + 1] = (byte)124;
            w[n + 2] = (byte)0;
            kws = "|abort|action|add|after|all|alter|always|analyze|and|as|asc|attach|autoincrement|before|begin|between|by|cascade|case|cast|check|collate|column|commit|conflict|constraint|create|cross|current|current_date|current_time|current_timestamp|database|default|deferrable|deferred|delete|desc|detach|distinct|do|drop|each|else|end|escape|except|exclude|exclusive|exists|explain|fail|filter|first|following|for|foreign|from|full|generated|glob|group|groups|having|if|ignore|immediate|in|index|indexed|initially|inner|insert|instead|intersect|into|is|isnull|join|key|last|left|like|limit|match|materialized|natural|no|not|nothing|notnull|null|nulls|of|offset|on|or|order|others|outer|over|partition|plan|pragma|preceding|primary|query|raise|range|recursive|references|regexp|reindex|release|rename|replace|restrict|returning|right|rollback|row|rows|savepoint|select|set|table|temp|temporary|then|ties|to|transaction|trigger|unbounded|union|unique|update|using|vacuum|values|view|virtual|when|where|window|with|without|\0";
            return sq_ihas(kws, sq_cstrlen(kws), @w[0]);
        };

        // identifier as SQLite writes it into stored CREATE text
        def sq_sb_ident_k(SQ_SB* b, byte* s, int n) -> void
        {
            int i, plain;
            plain = 1;
            if (n == 0) { plain = 0; };
            for (i = 0; i < n; i++)
            {
                if (sq_isalpha(s[i]) == false & sq_isdigit(s[i]) == false & s[i] != (byte)95) { plain = 0; };
                if (s[i] >= (byte)128) { plain = 0; };
            };
            if (n > 0) { if (sq_isdigit(s[0])) { plain = 0; }; };
            if (plain == 1) { if (sq_is_keyword(s, n)) { plain = 0; }; };
            if (plain == 1) { sq_sb_add(b, s, n); return; };
            sq_sb_add(b, "\"\0", 1);
            for (i = 0; i < n; i++)
            {
                if (s[i] == (byte)34) { sq_sb_add(b, "\"\0", 1); };
                sq_sb_add(b, @s[i], 1);
            };
            sq_sb_add(b, "\"\0", 1);
        };

        // Builds the stored CREATE TABLE text for the select in sel[0..sn).
        def sq_ctas_text(SQ_STMT* st, SQ_SB* out, byte* name, int nl, byte* sel, int sn) -> int
        {
            SQ_STMT* sub;
            SQ_BLK* b;
            byte* names;
            byte[24] suf;
            int i, j, k, n, cnt, a, rc, l, nn, hit, sl, tot;
            sub = sq_stmt_new();
            if ((u64)sub == (u64)0) { sq_seterr(st, "out of memory\0"); return 1; };
            rc = sq_prep_query(sub, st.db, sel);
            if (rc != 0) { sq_seterr(st, @sub.err[0]); sq_stmt_del(sub); return 1; };
            b = sub.blks[sub.root_blk];
            n = sub.nres;
            names = (byte*)fmalloc((u64)(n * 256 + 16));
            if ((u64)names == (u64)0) { sq_stmt_del(sub); sq_seterr(st, "out of memory\0"); return 1; };
            for (i = 0; i < n; i++)
            {
                l = sq_column_name(sub, i, @names[i * 256], 200);
                // make the name unique: name:N
                cnt = 0;
                hit = 1;
                while (hit == 1)
                {
                    hit = 0;
                    for (j = 0; j < i; j++)
                    {
                        if (sq_ieq2(@names[j * 256], sq_cstrlen(@names[j * 256]), @names[i * 256], l)) { hit = 1; };
                    };
                    if (hit == 1)
                    {
                        nn = l;
                        k = nn - 1;
                        while (k > 0 & sq_isdigit(names[i * 256 + k])) { k--; };
                        if (k > 0) { if (names[i * 256 + k] == (byte)58) { nn = k; }; };
                        cnt++;
                        sl = 0;
                        k = cnt;
                        if (k == 0) { suf[0] = (byte)48; sl = 1; };
                        while (k > 0) { suf[sl] = (byte)(48 + (k % 10)); k = k / 10; sl++; };
                        names[i * 256 + nn] = (byte)58;
                        for (k = 0; k < sl; k++) { names[i * 256 + nn + 1 + k] = suf[sl - 1 - k]; };
                        l = nn + 1 + sl;
                        names[i * 256 + l] = (byte)0;
                    };
                };
            };
            // SQLite switches to one column per line once the estimated statement length reaches 50
            tot = nl + 2;
            for (k = 0; k < nl; k++) { if (name[k] == (byte)34) { tot++; }; };
            for (i = 0; i < n; i++)
            {
                l = sq_cstrlen(@names[i * 256]);
                tot = tot + l + 7;
                for (k = 0; k < l; k++) { if (names[i * 256 + k] == (byte)34) { tot++; }; };
            };
            sq_sb_lit(out, "CREATE TABLE \0");
            sq_sb_ident_k(out, name, nl);
            if (tot >= 50) { sq_sb_lit(out, "(\n  \0"); } else { sq_sb_lit(out, "(\0"); };
            for (i = 0; i < n; i++)
            {
                if (i > 0) { if (tot >= 50) { sq_sb_lit(out, ",\n  \0"); } else { sq_sb_lit(out, ",\0"); }; };
                sq_sb_ident_k(out, @names[i * 256], sq_cstrlen(@names[i * 256]));
                a = sq_eaff(sub, b.rc[i]);
                if (a == 1) { sq_sb_lit(out, " TEXT\0"); };
                if (a == 2) { sq_sb_lit(out, " NUM\0"); };
                if (a == 3) { sq_sb_lit(out, " INT\0"); };
                if (a == 4) { sq_sb_lit(out, " REAL\0"); };
            };
            if (tot >= 50) { sq_sb_lit(out, "\n)\0"); } else { sq_sb_lit(out, ")\0"); };
            ffree((u64)names);
            sq_stmt_del(sub);
            return 0;
        };

        def sq_exec_create_table(SQ_STMT* st) -> int
        {
            SQLITE_DB* db = st.db;
            SQ_TI* ti;
            SQ_SB sb, nm;
            byte[72] name;
            int ine, nl, nstart, i, j, root, rc, k, ctas, ss, se, ck0;
            SQ_TCTX* tc;
            byte* selp;
            ine = 0;
            if (sq_is_kw(st, "if\0"))
            {
                sq_next(st);
                if (sq_is_kw(st, "not\0") == false) { sq_seterr(st, "expected NOT\0"); return 1; };
                sq_next(st);
                if (sq_is_kw(st, "exists\0") == false) { sq_seterr(st, "expected EXISTS\0"); return 1; };
                sq_next(st);
                ine = 1;
            };
            if (st.tk != 1) { sq_seterr(st, "expected a table name\0"); return 1; };
            nl = st.tl;
            if (nl > 50) { sq_seterr(st, "table name too long\0"); return 1; };
            for (i = 0; i < nl; i++) { name[i] = st.sql[st.ts + i]; };
            name[nl] = (byte)0;
            nstart = sq_tok_start(st);
            if (nl >= 7) { if (sq_ihas(@name[0], 7, "sqlite_\0")) { sq_seterr(st, "object name reserved for internal use: \0"); sq_err_name(st, "object name reserved for internal use: \0", @name[0], nl, "\0"); return 1; }; };
            sq_next(st);
            ctas = 0;
            if (sq_is_kw(st, "as\0")) { ctas = 1; };
            if (ctas == 0) { if (sq_is_op(st, 40) == false) { sq_seterr(st, "expected (\0"); return 1; }; };
            k = sq_obj_exists(db, @name[0], nl);
            if (k != 0)
            {
                if (ine == 1 & k == 1) { return 0; };
                if (k == 2) { sq_err_name(st, "there is already an index named \0", @name[0], nl, "\0"); }
                else { sq_err_name(st, "table \0", @name[0], nl, " already exists\0"); };
                return 1;
            };
            sq_sb_init(@sb);
            if (ctas == 1)
            {
                sq_next(st);
                ss = sq_tok_start(st);
                se = st.sqllen;
                while (se > ss & (st.sql[se - 1] == (byte)32 | st.sql[se - 1] == (byte)9 | st.sql[se - 1] == (byte)10 | st.sql[se - 1] == (byte)13 | st.sql[se - 1] == (byte)59)) { se--; };
                if (se <= ss) { sq_seterr(st, "syntax error\0"); return 1; };
                selp = (byte*)fmalloc((u64)(se - ss + 8));
                if ((u64)selp == (u64)0) { sq_seterr(st, "out of memory\0"); return 1; };
                for (i = 0; i < se - ss; i++) { selp[i] = st.sql[ss + i]; };
                selp[se - ss] = (byte)0;
                rc = sq_ctas_text(st, @sb, @name[0], nl, selp, se - ss);
                ffree((u64)selp);
                if (rc != 0) { sq_sb_free(@sb); return 1; };
            }
            else
            {
                sq_sb_lit(@sb, "CREATE TABLE \0");
                sq_tail_text(st, nstart, @sb);
            };
            if (sb.err != 0) { sq_sb_free(@sb); sq_seterr(st, "out of memory\0"); return 1; };
            ti = (SQ_TI*)fmalloc((u64)(sizeof(SQ_TI) / 8 + 4096));
            if ((u64)ti == (u64)0) { sq_sb_free(@sb); return 1; };
            rc = sq_ti_load(ti, sb.p);
            if (rc != 0 | ti.ncols == 0)
            {
                ffree((u64)ti); sq_sb_free(@sb);
                sq_seterr(st, "cannot read column definitions\0");
                return 1;
            };
            if (ti.wor == 1)
            {
                if (ti.autoinc == 1)
                {
                    ffree((u64)ti); sq_sb_free(@sb);
                    sq_seterr(st, "AUTOINCREMENT not allowed on WITHOUT ROWID tables\0");
                    return 1;
                };
                if (ti.npk == 0)
                {
                    sq_err_name(st, "PRIMARY KEY missing on table \0", @name[0], nl, "\0");
                    ffree((u64)ti); sq_sb_free(@sb);
                    return 1;
                };
            };
            if (ti.ngen > 0)
            {
                j = 0;
                for (i = 0; i < ti.ncols; i++) { if (ti.gen[i] == 0) { j++; }; };
                if (j == 0)
                {
                    ffree((u64)ti); sq_sb_free(@sb);
                    sq_seterr(st, "must have at least one non-generated column\0");
                    return 1;
                };
                for (i = 0; i < ti.ncols; i++)
                {
                    if (ti.gen[i] != 0 & ti.pk[i] == 1)
                    {
                        ffree((u64)ti); sq_sb_free(@sb);
                        sq_seterr(st, "generated columns cannot be part of the PRIMARY KEY\0");
                        return 1;
                    };
                };
            };
            for (i = 0; i < ti.ncols; i++)
            {
                for (j = 0; j < i; j++)
                {
                    if (sq_tname_eq(sb.p, ti.cs[i], ti.cl[i], sb.p, ti.cs[j], ti.cl[j]))
                    {
                        sq_err_name(st, "duplicate column name: \0", @sb.p[ti.cs[i]], ti.cl[i], "\0");
                        ffree((u64)ti); sq_sb_free(@sb);
                        return 1;
                    };
                };
            };
            if (ti.wor == 1) { root = sq_new_root(db, 10); } else { root = sq_new_root(db, 13); };
            if (root == 0) { ffree((u64)ti); sq_sb_free(@sb); sq_seterr(st, "write error\0"); return 1; };
            ck0 = db.cookie;
            if (sq_master_add(db, "table\0", @name[0], @name[0], root, sb.p) != 0)
            {
                ffree((u64)ti); sq_sb_free(@sb); sq_seterr(st, "write error\0"); return 1;
            };
            // automatic indexes for UNIQUE and PRIMARY KEY constraints
            for (i = 0; i < ti.nix; i++)
            {
                if (ti.wor == 1 & ti.ixpk[i] == 1) { continue; };
                root = sq_new_root(db, 10);
                if (root == 0) { ffree((u64)ti); sq_sb_free(@sb); sq_seterr(st, "write error\0"); return 1; };
                sq_sb_init(@nm);
                sq_sb_lit(@nm, "sqlite_autoindex_\0");
                sq_sb_add(@nm, @name[0], nl);
                sq_sb_lit(@nm, "_\0");
                sq_sb_int(@nm, (i64)(i + 1));
                rc = sq_master_add(db, "index\0", nm.p, @name[0], root, (byte*)0);
                sq_sb_free(@nm);
                if (rc != 0) { ffree((u64)ti); sq_sb_free(@sb); sq_seterr(st, "write error\0"); return 1; };
            };
            if (ti.autoinc == 1)
            {
                if (sq_find_table_n(db, "sqlite_sequence\0", 15) < 0 & sq_master_find(db, "sqlite_sequence\0", 15, "table\0") < (i64)0)
                {
                    root = sq_new_root(db, 13);
                    if (root == 0) { ffree((u64)ti); sq_sb_free(@sb); sq_seterr(st, "write error\0"); return 1; };
                    if (sq_master_add(db, "table\0", "sqlite_sequence\0", "sqlite_sequence\0", root, "CREATE TABLE sqlite_sequence(name,seq)\0") != 0)
                    {
                        ffree((u64)ti); sq_sb_free(@sb); sq_seterr(st, "write error\0"); return 1;
                    };
                };
            };
            db.cookie = ck0 + 1;
            ffree((u64)ti);
            sq_sb_free(@sb);
            if (ctas == 1)
            {
                sq_schema_load(db);
                tc = (SQ_TCTX*)fmalloc((u64)(sizeof(SQ_TCTX) / 8 + 4096));
                if ((u64)tc == (u64)0) { sq_seterr(st, "out of memory\0"); return 1; };
                tc.ti = (SQ_TI*)0;
                rc = sq_tc_open(db, st, @name[0], nl, tc);
                if (rc == 0) { rc = sq_exec_insert(st, tc, 0, @name[0], nl); };
                if (rc == 0) { rc = sq_tc_finish(tc); };
                sq_tc_free(tc);
                ffree((u64)tc);
                return rc;
            };
            return 0;
        };

        // ---- CREATE INDEX ----

        // scans an expression text. Returns 1 for a non-deterministic function, 2 for a subquery, 0 otherwise.
        def sq_nondet_scan(byte* s, int start, int len) -> int
        {
            int i, j, e, n, r;
            byte q;
            i = start;
            e = start + len;
            r = 0;
            while (i < e)
            {
                if (s[i] == (byte)39 | s[i] == (byte)34 | s[i] == (byte)96)
                {
                    q = s[i];
                    i++;
                    while (i < e & s[i] != q) { i++; };
                    i++;
                    continue;
                };
                if (sq_isalpha(s[i]) | s[i] == (byte)95)
                {
                    j = i;
                    while (j < e & (sq_isalpha(s[j]) | sq_isdigit(s[j]) | s[j] == (byte)95)) { j++; };
                    n = j - i;
                    if (sq_ieq(@s[i], n, "select\0")) { return 2; };
                    if (sq_ieq(@s[i], n, "current_time\0") | sq_ieq(@s[i], n, "current_date\0") | sq_ieq(@s[i], n, "current_timestamp\0")) { r = 1; };
                    while (j < e & (s[j] == (byte)32 | s[j] == (byte)9 | s[j] == (byte)10 | s[j] == (byte)13)) { j++; };
                    if (j < e)
                    {
                        if (s[j] == (byte)40)
                        {
                            if (sq_ieq(@s[i], n, "random\0") | sq_ieq(@s[i], n, "randomblob\0") | sq_ieq(@s[i], n, "changes\0") | sq_ieq(@s[i], n, "total_changes\0") | sq_ieq(@s[i], n, "last_insert_rowid\0") | sq_ieq(@s[i], n, "sqlite_version\0") | sq_ieq(@s[i], n, "sqlite_source_id\0") | sq_ieq(@s[i], n, "sqlite_compileoption_used\0") | sq_ieq(@s[i], n, "sqlite_compileoption_get\0")) { r = 1; };
                        };
                    };
                    i = i + n;
                    continue;
                };
                i++;
            };
            return r;
        };

        def sq_exec_create_index(SQ_STMT* st, int unique) -> int
        {
            SQLITE_DB* db = st.db;
            SQ_SB sb;
            SQ_TCTX* tc;
            byte[72] iname;
            byte[72] tname;
            int ine, il, tl, istart, root, rc, k, tp, ixn, ok;
            ine = 0;
            if (sq_is_kw(st, "if\0"))
            {
                sq_next(st);
                sq_next(st);
                sq_next(st);
                ine = 1;
            };
            if (st.tk != 1) { sq_seterr(st, "expected an index name\0"); return 1; };
            il = st.tl;
            if (il > 62) { sq_seterr(st, "index name too long\0"); return 1; };
            for (k = 0; k < il; k++) { iname[k] = st.sql[st.ts + k]; };
            iname[il] = (byte)0;
            istart = sq_tok_start(st);
            if (il >= 7) { if (sq_ihas(@iname[0], 7, "sqlite_\0")) { sq_err_name(st, "object name reserved for internal use: \0", @iname[0], il, "\0"); return 1; }; };
            sq_next(st);
            if (sq_is_kw(st, "on\0") == false) { sq_seterr(st, "expected ON\0"); return 1; };
            sq_next(st);
            if (st.tk != 1) { sq_seterr(st, "expected a table name\0"); return 1; };
            tl = st.tl;
            if (tl > 62) { sq_seterr(st, "table name too long\0"); return 1; };
            for (k = 0; k < tl; k++) { tname[k] = st.sql[st.ts + k]; };
            tname[tl] = (byte)0;
            k = sq_obj_exists(db, @iname[0], il);
            if (k != 0)
            {
                if (ine == 1 & k == 2) { return 0; };
                sq_err_name(st, "index \0", @iname[0], il, " already exists\0");
                return 1;
            };
            tp = sq_find_table_n(db, @tname[0], tl);
            if (tp < 0) { sq_err_name(st, "no such table: \0", @tname[0], tl, "\0"); return 1; };
            sq_sb_init(@sb);
            if (unique == 1) { sq_sb_lit(@sb, "CREATE UNIQUE INDEX \0"); } else { sq_sb_lit(@sb, "CREATE INDEX \0"); };
            sq_tail_text(st, istart, @sb);
            if (sb.err != 0) { sq_sb_free(@sb); return 1; };
            // validate the column list before touching the file
            tc = (SQ_TCTX*)fmalloc((u64)(sizeof(SQ_TCTX) / 8 + 4096));
            if ((u64)tc == (u64)0) { sq_sb_free(@sb); return 1; };
            if (sq_tc_open(db, st, @tname[0], tl, tc) != 0) { sq_tc_free(tc); ffree((u64)tc); sq_sb_free(@sb); return 1; };
            {
                SQ_IDX vix;
                int vr, vk;
                vix.ne = 0; vix.wl = 0; vix.nk = 0;
                sq_idx_parse(tc.ti, sb.p, @vix);
                vr = 0;
                for (vk = 0; vk < vix.nk; vk++)
                {
                    if (vix.isx[vk] == 1 & vr == 0)
                    {
                        vr = sq_nondet_scan(sb.p, vix.xs[vk], vix.xl[vk]);
                        if (vr == 1) { sq_seterr(st, "non-deterministic functions prohibited in index expressions\0"); };
                        if (vr == 2) { sq_seterr(st, "subqueries prohibited in index expressions\0"); };
                    };
                };
                if (vr == 0 & vix.wl > 0)
                {
                    vr = sq_nondet_scan(sb.p, vix.ws, vix.wl);
                    if (vr == 1) { sq_seterr(st, "non-deterministic functions prohibited in partial index WHERE clauses\0"); };
                    if (vr == 2) { sq_seterr(st, "subqueries prohibited in partial index WHERE clauses\0"); };
                };
                if (vr != 0) { sq_tc_free(tc); ffree((u64)tc); sq_sb_free(@sb); return 1; };
            };
            root = sq_new_root(db, 10);
            if (root == 0) { sq_tc_free(tc); ffree((u64)tc); sq_sb_free(@sb); sq_seterr(st, "write error\0"); return 1; };
            if (sq_master_add(db, "index\0", @iname[0], @db.schema[tp].name[0], root, sb.p) != 0)
            {
                sq_tc_free(tc); ffree((u64)tc); sq_sb_free(@sb); sq_seterr(st, "write error\0"); return 1;
            };
            // a fresh table context sees the new index
            sq_tc_free(tc);
            sq_schema_load(db);
            if (sq_tc_open(db, st, @tname[0], tl, tc) != 0) { ffree((u64)tc); sq_sb_free(@sb); return 1; };
            ixn = 0 - 1;
            for (k = 0; k < tc.nix; k++)
            {
                if (sq_name_is(@iname[0], il, @tc.ix[k].name[0])) { ixn = k; };
            };
            ok = 1;
            if (ixn < 0) { sq_seterr(st, "cannot create index (expression and partial indexes are not supported)\0"); ok = 0; };
            if (ok == 1)
            {
                rc = sq_tc_rebuild(tc, @tc.ix[ixn]);
                if (rc == 4) { sq_err_unique(tc, @tc.ix[ixn], 0); ok = 0; };
                if (rc == 1) { sq_seterr(st, "index build failed\0"); ok = 0; };
            };
            sq_tc_free(tc);
            ffree((u64)tc);
            sq_sb_free(@sb);
            if (ok == 0) { return 1; };
            return 0;
        };

        // ---- CREATE VIEW ----

        def sq_exec_create_view(SQ_STMT* st) -> int
        {
            SQLITE_DB* db = st.db;
            SQ_SB sb;
            byte[72] name;
            int ine, nl, nstart, k, vqs, vql;
            ine = 0;
            if (sq_is_kw(st, "if\0"))
            {
                sq_next(st);
                sq_next(st);
                sq_next(st);
                ine = 1;
            };
            if (st.tk != 1) { sq_seterr(st, "expected a view name\0"); return 1; };
            nl = st.tl;
            if (nl > 62) { sq_seterr(st, "view name too long\0"); return 1; };
            for (k = 0; k < nl; k++) { name[k] = st.sql[st.ts + k]; };
            name[nl] = (byte)0;
            nstart = sq_tok_start(st);
            k = sq_obj_exists(db, @name[0], nl);
            if (k != 0)
            {
                if (ine == 1 & k == 3) { return 0; };
                sq_err_name(st, "view \0", @name[0], nl, " already exists\0");
                return 1;
            };
            sq_next(st);
            if (sq_is_op(st, 40)) { while (st.tk != 0) { if (sq_is_op(st, 41)) { sq_next(st); break; }; sq_next(st); }; };
            if (sq_is_kw(st, "as\0") == false) { sq_seterr(st, "expected AS\0"); return 1; };
            sq_next(st);
            if (sq_is_kw(st, "select\0") == false & sq_is_kw(st, "with\0") == false & sq_is_kw(st, "values\0") == false)
            {
                sq_seterr(st, "expected a SELECT\0");
                return 1;
            };
            if (sq_xdb_scan(db, @st.sql[0], st.ts, st.sqllen - st.ts, 0, @vqs, @vql) != 0)
            {
                sq_err_name(st, "view \0", @name[0], nl, " cannot reference objects in database \0");
                sq_att_msg2(st, @st.sql[vqs], vql);
                return 1;
            };
            sq_sb_init(@sb);
            sq_sb_lit(@sb, "CREATE VIEW \0");
            sq_tail_text(st, nstart, @sb);
            if (sb.err != 0) { sq_sb_free(@sb); return 1; };
            k = sq_master_add(db, "view\0", @name[0], @name[0], 0, sb.p);
            sq_sb_free(@sb);
            if (k != 0) { sq_seterr(st, "write error\0"); return 1; };
            return 0;
        };

        // ---- DROP ----

        def sq_drop_obj_rows(SQLITE_DB* db, byte* name, byte* type) -> int
        {
            i64 rid;
            rid = sq_master_find(db, name, sq_cstrlen(name), type);
            if (rid < (i64)0) { return 0; };
            if (sq_btree_delete(db, 1, rid) != 0) { return 1; };
            db.cookie = db.cookie + 1;
            return 0;
        };

        def sq_sb_quoted(SQ_SB* sb, byte* s, int n) -> void;

        // like sqlite3ClearStatTables: removes the sqlite_stat1 rows of a dropped table (col tbl) or index (col idx)
        def sq_drop_stat(SQ_STMT* st, byte* name, int col) -> int
        {
            SQLITE_DB* db = st.db;
            SQ_SB sb;
            int rc;
            i64 sv;
            if (sq_find_table_n(db, "sqlite_stat1\0", 12) < 0) { return 0; };
            sq_sb_init(@sb);
            sq_sb_lit(@sb, "delete from sqlite_stat1 where \0");
            if (col == 0) { sq_sb_lit(@sb, "tbl=\0"); } else { sq_sb_lit(@sb, "idx=\0"); };
            sq_sb_quoted(@sb, name, sq_cstrlen(name));
            sv = st.changes;
            rc = sq_trg_stmt(st, sb.p);
            st.changes = sv;
            sq_sb_free(@sb);
            return rc;
        };

        def sq_exec_drop(SQ_STMT* st) -> int
        {
            SQLITE_DB* db = st.db;
            SQ_TCTX tc;
            byte[72] name;
            int kind, ie, nl, k, i, pos, rc, nr;
            int[72] roots;
            i64 sr, rid;
            kind = 0;
            if (sq_is_kw(st, "table\0")) { kind = 1; };
            if (sq_is_kw(st, "index\0")) { kind = 2; };
            if (sq_is_kw(st, "view\0")) { kind = 3; };
            if (sq_is_kw(st, "trigger\0")) { kind = 4; };
            if (kind == 0) { sq_seterr(st, "only DROP TABLE, INDEX, VIEW and TRIGGER are supported\0"); return 1; };
            sq_next(st);
            ie = 0;
            if (sq_is_kw(st, "if\0")) { sq_next(st); sq_next(st); ie = 1; };
            if (st.tk != 1) { sq_seterr(st, "expected a name\0"); return 1; };
            nl = st.tl;
            if (nl > 62) { sq_seterr(st, "name too long\0"); return 1; };
            for (k = 0; k < nl; k++) { name[k] = st.sql[st.ts + k]; };
            name[nl] = (byte)0;
            pos = 0 - 1;
            for (i = 0; i < db.nschema; i++)
            {
                if (db.schema[i].kind == kind & sq_name_is(@name[0], nl, @db.schema[i].name[0])) { pos = i; };
            };
            if (pos < 0)
            {
                if (ie == 1) { return 0; };
                if (kind == 1) { sq_err_name(st, "no such table: \0", @name[0], nl, "\0"); };
                if (kind == 2) { sq_err_name(st, "no such index: \0", @name[0], nl, "\0"); };
                if (kind == 3) { sq_err_name(st, "no such view: \0", @name[0], nl, "\0"); };
                if (kind == 4) { sq_err_name(st, "no such trigger: \0", @name[0], nl, "\0"); };
                return 1;
            };
            if (kind == 4)
            {
                return sq_drop_obj_rows(db, @db.schema[pos].name[0], "trigger\0");
            };
            if (kind == 3)
            {
                if (sq_drop_triggers_of(db, @db.schema[pos].name[0]) != 0) { sq_seterr(st, "write error\0"); return 1; };
                return sq_drop_obj_rows(db, @db.schema[pos].name[0], "view\0");
            };
            if (kind == 2)
            {
                if ((u64)db.schema[pos].sql == (u64)0)
                {
                    sq_seterr(st, "index associated with UNIQUE or PRIMARY KEY constraint cannot be dropped\0");
                    return 1;
                };
                nr = db.schema[pos].rootpage;
                if (sq_drop_obj_rows(db, @db.schema[pos].name[0], "index\0") != 0) { sq_seterr(st, "write error\0"); return 1; };
                if (sq_drop_stat(st, @name[0], 1) != 0) { return 1; };
                if (sq_tree_free(db, nr, 0, 0, 0) != 0) { sq_seterr(st, "write error\0"); return 1; };
                return 0;
            };
            // table
            if (sq_ihas(@db.schema[pos].name[0], 7, "sqlite_\0"))
            {
                if (db.schema[pos].name[0] == (byte)115 & db.schema[pos].name[1] == (byte)113)
                {
                    sq_err_name(st, "table \0", @name[0], nl, " may not be dropped\0");
                    return 1;
                };
            };
            if (sq_fk_is_parent(db, @db.schema[pos].name[0]))
            {
                // like SQLite, dropping a parent table first deletes its rows so the foreign key actions run
                SQ_SB dq;
                int drc;
                sq_sb_init(@dq);
                sq_sb_lit(@dq, "delete from \0");
                sq_sb_ident(@dq, @db.schema[pos].name[0], sq_cstrlen(@db.schema[pos].name[0]));
                SQ_NOTRIG = 1;
                drc = sq_trg_stmt(st, dq.p);
                SQ_NOTRIG = 0;
                sq_sb_free(@dq);
                if (drc != 0) { return 1; };
                if (SQ_FKCNT > 0) { sq_seterr(st, "FOREIGN KEY constraint failed\0"); return 1; };
            };
            if (sq_drop_triggers_of(db, @db.schema[pos].name[0]) != 0) { sq_seterr(st, "write error\0"); return 1; };
            // roots in SQLite's destroy order: the table, explicit indexes newest first, then automatic ones
            nr = 0;
            roots[nr] = db.schema[pos].rootpage; nr++;
            for (i = db.nschema - 1; i >= 0; i--)
            {
                if (db.schema[i].kind == 2 & (u64)db.schema[i].sql != (u64)0)
                {
                    if (sq_streq(@db.schema[i].tbl_name[0], @db.schema[pos].name[0]) & nr < 70) { roots[nr] = db.schema[i].rootpage; nr++; };
                };
            };
            for (i = 0; i < db.nschema; i++)
            {
                if (db.schema[i].kind == 2 & (u64)db.schema[i].sql == (u64)0)
                {
                    if (sq_streq(@db.schema[i].tbl_name[0], @db.schema[pos].name[0]) & nr < 70) { roots[nr] = db.schema[i].rootpage; nr++; };
                };
            };
            for (i = 0; i < db.nschema; i++)
            {
                if (db.schema[i].kind == 2)
                {
                    if (sq_streq(@db.schema[i].tbl_name[0], @db.schema[pos].name[0]))
                    {
                        if (sq_drop_obj_rows(db, @db.schema[i].name[0], "index\0") != 0) { sq_seterr(st, "write error\0"); return 1; };
                    };
                };
            };
            if (sq_drop_obj_rows(db, @db.schema[pos].name[0], "table\0") != 0) { sq_seterr(st, "write error\0"); return 1; };
            if (sq_drop_stat(st, @name[0], 0) != 0) { return 1; };
            // the AUTOINCREMENT counter goes with the table
            k = sq_find_table_n(db, "sqlite_sequence\0", 15);
            if (k >= 0)
            {
                tc.db = db; tc.st = st; tc.seqroot = db.schema[k].rootpage;
                for (i = 0; i < 64; i++) { tc.tname[i] = db.schema[pos].name[i]; };
                if (sq_seq_read(@tc, @rid) >= (i64)0 | rid >= (i64)0)
                {
                    if (rid >= (i64)0) { sq_btree_delete(db, tc.seqroot, rid); };
                };
            };
            for (i = 0; i < nr; i++)
            {
                if (sq_tree_free(db, roots[i], 0, 0, 0) != 0) { sq_seterr(st, "write error\0"); return 1; };
            };
            return 0;
        };

        // ---- ALTER TABLE ----

        // rewrites one name inside stored SQL: every identifier equal to old becomes new (already formatted text).
        // With firstonly the first match after the leading keywords is replaced (the table name).
        def sq_sql_rename(byte* s, byte* old, int ol, byte* nw, int nlen, int skiptok, SQ_SB* out) -> int
        {
            int i, end, ts, tl, kd, last, count, tokn, rep;
            end = sq_cstrlen(s);
            i = 0;
            last = 0;
            count = 0;
            tokn = 0;
            while (i < end)
            {
                i = sq_tok2(s, i, end, @ts, @tl, @kd);
                if (kd == 0) { break; };
                tokn++;
                rep = 0;
                if (tokn > skiptok)
                {
                    if (kd == 1) { if (sq_tname_eq(s, ts, tl, old, 0, ol)) { rep = 1; }; };
                    if (kd == 2) { if (sq_tname_eq(s, ts + 1, tl - 2, old, 0, ol)) { rep = 1; }; };
                };
                if (rep == 1)
                {
                    sq_sb_add(out, @s[last], ts - last);
                    sq_sb_add(out, nw, nlen);
                    last = ts + tl;
                    count++;
                };
                if (kd == 4)
                {
                    // descend into a parenthesised group by re-scanning its contents
                    i = ts + 1;
                };
            };
            sq_sb_add(out, @s[last], end - last);
            return count;
        };

        // replaces the first identifier equal to old after skiptok tokens (the table name in CREATE TABLE <name>)
        def sq_sql_first_rename(byte* s, byte* old, int ol, byte* nw, int nlen, int skiptok, SQ_SB* out) -> int
        {
            int i, end, ts, tl, kd, tokn, rep;
            end = sq_cstrlen(s);
            i = 0;
            tokn = 0;
            while (i < end)
            {
                i = sq_tok2(s, i, end, @ts, @tl, @kd);
                if (kd == 0) { break; };
                tokn++;
                if (tokn <= skiptok) { continue; };
                rep = 0;
                if (kd == 1) { if (sq_tname_eq(s, ts, tl, old, 0, ol)) { rep = 1; }; };
                if (kd == 2) { if (sq_tname_eq(s, ts + 1, tl - 2, old, 0, ol)) { rep = 1; }; };
                if (rep == 1)
                {
                    sq_sb_add(out, s, ts);
                    sq_sb_add(out, nw, nlen);
                    sq_sb_add(out, @s[ts + tl], end - ts - tl);
                    return 1;
                };
                break;
            };
            return 0;
        };

        // CREATE [UNIQUE] INDEX name ON table (...): replaces the table name after ON
        def sq_sql_after_on(byte* s, byte* old, int ol, byte* nw, int nlen, SQ_SB* out) -> void
        {
            int i, end, ts, tl, kd, seen;
            end = sq_cstrlen(s);
            i = 0;
            seen = 0;
            while (i < end)
            {
                i = sq_tok2(s, i, end, @ts, @tl, @kd);
                if (kd == 0) { break; };
                if (seen == 1)
                {
                    sq_sb_add(out, s, ts);
                    sq_sb_add(out, nw, nlen);
                    sq_sb_add(out, @s[ts + tl], end - ts - tl);
                    return;
                };
                if (kd == 1) { if (sq_ieq(@s[ts], tl, "on\0")) { seen = 1; }; };
            };
            sq_sb_add(out, s, end);
        };

        def sq_end_check(SQ_STMT* st) -> int;

        // ---- ALTER TABLE ... DROP COLUMN ----

        // offset of the first depth-0 comma or unmatched ')' at or after pos in sql
        def sq_def_end(byte* s, int pos) -> int
        {
            int i, end, ts, tl, kd;
            end = sq_cstrlen(s);
            i = pos;
            while (i < end)
            {
                i = sq_tok2(s, i, end, @ts, @tl, @kd);
                if (kd == 0) { break; };
                if (kd == 5)
                {
                    if (s[ts] == (byte)41 | s[ts] == (byte)44) { return ts; };
                };
            };
            return end;
        };

        // start of the name token of column c as written in the stored text (a quoted name starts at its quote)
        def sq_col_tok_start(SQ_TI* ti, int c) -> int
        {
            int a = ti.cs[c];
            if (a > 0)
            {
                if (ti.base[a - 1] == (byte)34 | ti.base[a - 1] == (byte)96 | ti.base[a - 1] == (byte)91) { return a - 1; };
            };
            return a;
        };

        // rewrites every row of the table without column c
        def sq_drop_rewrite(SQLITE_DB* db, SQ_STMT* st, SQ_TCTX* tc, int c) -> int
        {
            SQ_CURSOR cur;
            SQ_ARENA ar;
            SQ_VAL* vals;
            SQ_VAL* nv;
            i64* ids;
            byte* rec;
            int n, cap, r, k, m, rn, i, nc, ipk;
            i64 rid;
            nc = tc.ncols;
            ipk = tc.ti.ipk;
            if (tc.wor == 1)
            {
                if (tc.ti.ri[c] < 0) { return 0; };
                if (sq_wor_rebuild(tc, (SQ_VAL*)0, tc.ti.ri[c]) != 0) { sq_seterr(st, "write error\0"); return 1; };
                return 0;
            };
            cap = 1024; n = 0;
            ids = (i64*)fmalloc((u64)cap * (u64)8);
            if ((u64)ids == (u64)0) { sq_seterr(st, "out of memory\0"); return 1; };
            sq_cur_open(@cur, db, tc.root);
            r = sq_cur_first(@cur);
            while (r == 1)
            {
                if (n >= cap)
                {
                    i64* g = (i64*)fmalloc((u64)cap * (u64)16);
                    if ((u64)g == (u64)0) { sq_cur_close(@cur); ffree((u64)ids); sq_seterr(st, "out of memory\0"); return 1; };
                    for (i = 0; i < n; i++) { g[i] = ids[i]; };
                    ffree((u64)ids);
                    ids = g;
                    cap = cap * 2;
                };
                ids[n] = cur.rowid;
                n++;
                r = sq_cur_next(@cur);
            };
            sq_cur_close(@cur);
            vals = (SQ_VAL*)fmalloc((u64)(nc + 2) * (u64)sizeof(SQ_VAL));
            nv = (SQ_VAL*)fmalloc((u64)(nc + 2) * (u64)sizeof(SQ_VAL));
            if ((u64)vals == (u64)0 | (u64)nv == (u64)0) { ffree((u64)ids); sq_seterr(st, "out of memory\0"); return 1; };
            for (i = 0; i < n; i++)
            {
                rid = ids[i];
                sq_ar_init(@ar);
                sq_cur_open(@cur, db, tc.root);
                r = sq_cur_seek(@cur, rid);
                if (r != 1) { sq_cur_close(@cur); sq_ar_free(@ar); continue; };
                m = cur.ncols;
                if (m > nc) { m = nc; };
                sq_tc_row(tc, @cur, @ar, vals);
                sq_cur_close(@cur);
                rn = 0;
                for (k = 0; k < m; k++)
                {
                    if (k == c) { continue; };
                    sq_val_copy(@nv[rn], @vals[k]);
                    if (k == ipk) { sq_val_null(@nv[rn]); };
                    rn++;
                };
                rec = (byte*)fmalloc((u64)(sq_rec_size(nv, rn) + 8));
                if ((u64)rec == (u64)0) { sq_ar_free(@ar); ffree((u64)ids); ffree((u64)vals); ffree((u64)nv); sq_seterr(st, "out of memory\0"); return 1; };
                sq_rec_write(nv, rn, rec);
                k = sq_rec_size(nv, rn);
                if (sq_btree_delete(db, tc.root, rid) == 2) { ffree((u64)rec); sq_ar_free(@ar); ffree((u64)ids); ffree((u64)vals); ffree((u64)nv); sq_seterr(st, "write error\0"); return 1; };
                r = sq_btree_insert(db, tc.root, rid, rec, k);
                ffree((u64)rec);
                sq_ar_free(@ar);
                if (r != 0) { ffree((u64)ids); ffree((u64)vals); ffree((u64)nv); sq_seterr(st, "write error\0"); return 1; };
            };
            ffree((u64)ids); ffree((u64)vals); ffree((u64)nv);
            return 0;
        };

        // error "error in <what> <name> after drop column: <msg>"
        def sq_drop_err(SQ_STMT* st, byte* what, byte* name, byte* msg) -> void
        {
            SQ_SB b;
            sq_sb_init(@b);
            sq_sb_lit(@b, "error in \0");
            sq_sb_lit(@b, what);
            sq_sb_lit(@b, " \0");
            sq_sb_lit(@b, name);
            sq_sb_lit(@b, " after drop column: \0");
            sq_sb_lit(@b, msg);
            st.err[0] = (byte)0;
            sq_seterr(st, b.p);
            sq_sb_free(@b);
        };

        def sq_exec_drop_column(SQ_STMT* st, int tp, byte* tname, int tl) -> int
        {
            SQLITE_DB* db = st.db;
            SQ_TCTX tc;
            SQ_TCTX tc2;
            SQ_CHK chk;
            SQ_SB nsql, vq;
            SQ_STMT* vs;
            byte[160] oc;
            int ocl, c, k, i, g, a, b2, rc, last, e, nuq, u, hit, sidx;
            i64 rid;
            byte* sql;
            sq_next(st);
            if (sq_is_kw(st, "column\0")) { sq_next(st); };
            if (st.tk != 1) { sq_seterr(st, "expected a column name\0"); return 1; };
            ocl = st.tl;
            if (ocl > 150) { sq_seterr(st, "name too long\0"); return 1; };
            for (k = 0; k < ocl; k++) { oc[k] = st.sql[st.ts + k]; };
            oc[ocl] = (byte)0;
            sq_next(st);
            if (sq_end_check(st) != 0) { return 1; };
            if (sq_ihas(@db.schema[tp].name[0], 7, "sqlite_\0")) { sq_seterr(st, "table may not be altered\0"); return 1; };
            if (sq_tc_open(db, st, tname, tl, @tc) != 0) { sq_tc_free(@tc); return 1; };
            c = sq_ti_find(tc.ti, @oc[0], 0, ocl);
            if (c < 0) { sq_err_name(st, "no such column: \"\0", @oc[0], ocl, "\"\0"); sq_tc_free(@tc); return 1; };
            if (tc.ti.pk[c] != 0) { sq_err_name(st, "cannot drop PRIMARY KEY column: \"\0", @oc[0], ocl, "\"\0"); sq_tc_free(@tc); return 1; };
            if (tc.ti.uniq[c] != 0) { sq_err_name(st, "cannot drop UNIQUE column: \"\0", @oc[0], ocl, "\"\0"); sq_tc_free(@tc); return 1; };
            if (tc.ncols <= 1) { sq_err_name(st, "cannot drop column \"\0", @oc[0], ocl, "\": no other columns exist\0"); sq_tc_free(@tc); return 1; };
            // table level UNIQUE constraints that name the column
            g = 0;
            for (u = 0; u < tc.ti.nuq; u++)
            {
                for (k = 0; k < tc.ti.uqn[u]; k++)
                {
                    if (tc.ti.uqc[g + k] == c)
                    {
                        sq_sb_init(@vq);
                        sq_sb_lit(@vq, "no such column: \0");
                        sq_sb_add(@vq, @oc[0], ocl);
                        sq_drop_err(st, "table\0", tname, vq.p);
                        sq_sb_free(@vq);
                        sq_tc_free(@tc);
                        return 1;
                    };
                };
                g = g + tc.ti.uqn[u];
            };
            // the new table text
            sql = db.schema[tp].sql;
            sq_sb_init(@nsql);
            a = sq_col_tok_start(tc.ti, c);
            if (c < tc.ncols - 1)
            {
                b2 = sq_col_tok_start(tc.ti, c + 1);
                sq_sb_add(@nsql, sql, a);
                sq_sb_add(@nsql, @sql[b2], sq_cstrlen(sql) - b2);
            }
            else
            {
                b2 = sq_def_end(sql, tc.ti.cs[c]);
                while (a > 0 & sql[a] != (byte)44) { a--; };
                sq_sb_add(@nsql, sql, a);
                sq_sb_add(@nsql, @sql[b2], sq_cstrlen(sql) - b2);
            };
            if (nsql.err != 0) { sq_sb_free(@nsql); sq_tc_free(@tc); sq_seterr(st, "out of memory\0"); return 1; };
            // the rows
            if (sq_drop_rewrite(db, st, @tc, c) != 0) { sq_sb_free(@nsql); sq_tc_free(@tc); return 1; };
            rid = sq_master_find(db, tname, tl, "table\0");
            if (rid < (i64)0) { sq_sb_free(@nsql); sq_tc_free(@tc); sq_seterr(st, "alter failed\0"); return 1; };
            rc = sq_master_replace(db, rid, "table\0", @db.schema[tp].name[0], @db.schema[tp].name[0], db.schema[tp].rootpage, nsql.p);
            sq_sb_free(@nsql);
            sq_tc_free(@tc);
            if (rc != 0) { sq_seterr(st, "write error\0"); return 1; };
            sq_schema_load(db);
            // everything that was built on the old text must still resolve
            for (i = 0; i < db.nschema; i++)
            {
                if (db.schema[i].kind == 1)
                {
                    if (sq_streq(@db.schema[i].name[0], tname) == false) { continue; };
                    // CHECK constraints must still resolve
                    {
                        SQ_TI* t3;
                        byte[300] em;
                        t3 = (SQ_TI*)fmalloc((u64)(sizeof(SQ_TI) / 8 + 4096));
                        if ((u64)t3 == (u64)0) { sq_seterr(st, "out of memory\0"); return 1; };
                        if (sq_ti_load(t3, db.schema[i].sql) != 0) { ffree((u64)t3); sq_drop_err(st, "table\0", tname, "cannot read the table definition\0"); return 1; };
                        tc2.db = db; tc2.st = st; tc2.ti = t3; tc2.ncols = t3.ncols;
                        rc = sq_chk_open(@tc2, @chk);
                        if (rc != 0)
                        {
                            for (k = 0; k < 290; k++) { em[k] = st.err[k]; if (st.err[k] == (byte)0) { break; }; };
                            em[290] = (byte)0;
                            sq_chk_close(@chk);
                            ffree((u64)t3);
                            sq_drop_err(st, "table\0", tname, @em[0]);
                            return 1;
                        };
                        sq_chk_close(@chk);
                        {
                            SQ_FKR* fl;
                            int nf, q2, q3;
                            fl = (SQ_FKR*)fmalloc((u64)(sizeof(SQ_FKR) / 8 + 8) * (u64)16);
                            if ((u64)fl != (u64)0)
                            {
                                nf = sq_fk_parse(t3, @db.schema[i].name[0], fl, 16);
                                for (q2 = 0; q2 < nf; q2++)
                                {
                                    for (q3 = 0; q3 < fl[q2].n; q3++)
                                    {
                                        if (fl[q2].fc[q3] < 0)
                                        {
                                            sq_sb_init(@vq);
                                            sq_sb_lit(@vq, "unknown column \"\0");
                                            sq_sb_lit(@vq, @fl[q2].ccol[q3 * 64]);
                                            sq_sb_lit(@vq, "\" in foreign key definition\0");
                                            sq_drop_err(st, "table\0", tname, vq.p);
                                            sq_sb_free(@vq);
                                            ffree((u64)fl); ffree((u64)t3);
                                            return 1;
                                        };
                                    };
                                };
                                ffree((u64)fl);
                            };
                        };
                        ffree((u64)t3);
                    };
                };
                if (db.schema[i].kind == 2)
                {
                    if (sq_streq(@db.schema[i].tbl_name[0], tname) == false) { continue; };
                    if ((u64)db.schema[i].sql == (u64)0) { continue; };
                    {
                        SQ_TI* t4;
                        SQ_IDX* ixa;
                        int nn, q, bad;
                        t4 = (SQ_TI*)fmalloc((u64)(sizeof(SQ_TI) / 8 + 4096));
                        ixa = (SQ_IDX*)fmalloc((u64)20 * (u64)sizeof(SQ_IDX));
                        if ((u64)t4 == (u64)0 | (u64)ixa == (u64)0) { sq_seterr(st, "out of memory\0"); return 1; };
                        sq_ti_load(t4, db.schema[tp].sql);
                        nn = sq_idx_list(db, sq_find_table_n(db, tname, tl), t4, ixa, 20);
                        bad = 0;
                        for (q = 0; q < nn; q++)
                        {
                            if (ixa[q].schema_pos == i)
                            {
                                if (ixa[q].wok == 0) { bad = 1; };
                                if (ixa[q].ne > 0)
                                {
                                    for (hit = 0; hit < ixa[q].nk; hit++)
                                    {
                                        if (ixa[q].isx[hit] == 1) { if (sq_span_has_id(db.schema[i].sql, ixa[q].xs[hit], ixa[q].xl[hit], @oc[0], ocl)) { bad = 1; }; };
                                    };
                                };
                                if (ixa[q].wl > 0) { if (sq_span_has_id(db.schema[i].sql, ixa[q].ws, ixa[q].wl, @oc[0], ocl)) { bad = 1; }; };
                            };
                        };
                        ffree((u64)t4); ffree((u64)ixa);
                        if (bad == 1)
                        {
                            sq_sb_init(@vq);
                            sq_sb_lit(@vq, "no such column: \0");
                            sq_sb_add(@vq, @oc[0], ocl);
                            sq_drop_err(st, "index\0", @db.schema[i].name[0], vq.p);
                            sq_sb_free(@vq);
                            return 1;
                        };
                    };
                };
                if (db.schema[i].kind == 3)
                {
                    sq_sb_init(@vq);
                    sq_sb_lit(@vq, "select * from \"\0");
                    sq_sb_add(@vq, @db.schema[i].name[0], sq_cstrlen(@db.schema[i].name[0]));
                    sq_sb_lit(@vq, "\"\0");
                    vs = sq_stmt_new();
                    if ((u64)vs == (u64)0) { sq_sb_free(@vq); sq_seterr(st, "out of memory\0"); return 1; };
                    rc = sq_prep_query(vs, db, vq.p);
                    sq_sb_free(@vq);
                    if (rc != 0)
                    {
                        sq_drop_err(st, "view\0", @db.schema[i].name[0], @vs.err[0]);
                        sq_stmt_del(vs);
                        return 1;
                    };
                    sq_stmt_del(vs);
                };
            };
            for (i = 0; i < db.nschema; i++)
            {
                if (db.schema[i].kind == 4)
                {
                    if ((u64)db.schema[i].sql != (u64)0)
                    {
                        byte[160] tmsg;
                        int ont;
                        ont = 0;
                        if (sq_name_is(tname, tl, @db.schema[i].tbl_name[0])) { ont = 1; };
                        if (sq_sql_trig_ref(db.schema[i].sql, tname, tl, @oc[0], ocl, ont, @tmsg[0]) == 1)
                        {
                            sq_sb_init(@vq);
                            sq_sb_lit(@vq, "no such column: \0");
                            sq_sb_lit(@vq, @tmsg[0]);
                            sq_drop_err(st, "trigger\0", @db.schema[i].name[0], vq.p);
                            sq_sb_free(@vq);
                            return 1;
                        };
                    };
                };
            };
            return 0;
        };

        def sq_exec_alter(SQ_STMT* st) -> int
        {
            SQLITE_DB* db = st.db;
            SQ_TCTX tc;
            SQ_SB sb, nsql, q;
            byte[72] tname;
            byte[72] nname;
            byte[160] oc;
            byte[160] ncn;
            int tl, tp, k, i, nl, ocl, ncl, c, es, rc, lastp, cstart, e;
            i64 rid;
            byte* sql;
            if (sq_is_kw(st, "table\0") == false) { sq_seterr(st, "only ALTER TABLE is supported\0"); return 1; };
            sq_next(st);
            if (st.tk != 1) { sq_seterr(st, "expected a table name\0"); return 1; };
            tl = st.tl;
            if (tl > 62) { sq_seterr(st, "table name too long\0"); return 1; };
            for (k = 0; k < tl; k++) { tname[k] = st.sql[st.ts + k]; };
            tname[tl] = (byte)0;
            tp = sq_find_table_n(db, @tname[0], tl);
            if (tp < 0) { sq_err_name(st, "no such table: \0", @tname[0], tl, "\0"); return 1; };
            sq_next(st);
            if (sq_is_kw(st, "rename\0"))
            {
                sq_next(st);
                if (sq_is_kw(st, "to\0"))
                {
                    sq_next(st);
                    if (st.tk != 1) { sq_seterr(st, "expected a table name\0"); return 1; };
                    nl = st.tl;
                    if (nl > 50) { sq_seterr(st, "table name too long\0"); return 1; };
                    for (k = 0; k < nl; k++) { nname[k] = st.sql[st.ts + k]; };
                    nname[nl] = (byte)0;
                    if (sq_obj_exists(db, @nname[0], nl) != 0) { sq_err_name(st, "there is already another table or index with this name: \0", @nname[0], nl, "\0"); return 1; };
                    if (sq_ihas(@nname[0], 7, "sqlite_\0")) { sq_err_name(st, "object name reserved for internal use: \0", @nname[0], nl, "\0"); return 1; };
                    if (sq_ihas(@db.schema[tp].name[0], 7, "sqlite_\0")) { sq_seterr(st, "table may not be altered\0"); return 1; };
                    // quoted new name
                    sq_sb_init(@q);
                    sq_sb_lit(@q, "\"\0");
                    sq_sb_add(@q, @nname[0], nl);
                    sq_sb_lit(@q, "\"\0");
                    // the table row
                    sql = db.schema[tp].sql;
                    sq_sb_init(@nsql);
                    // tokens: CREATE TABLE name
                    rid = sq_master_find(db, @tname[0], tl, "table\0");
                    if (rid < (i64)0) { sq_seterr(st, "rename failed\0"); return 1; };
                    i = sq_sql_first_rename(sql, @tname[0], tl, q.p, q.n, 2, @nsql);
                    if (i == 0) { sq_seterr(st, "rename failed\0"); return 1; };
                    {
                        SQ_SB n2;
                        sq_sb_init(@n2);
                        sq_sql_dep_tbl(nsql.p, @tname[0], tl, q.p, q.n, @n2);
                        if (sq_master_replace(db, rid, "table\0", @nname[0], @nname[0], db.schema[tp].rootpage, n2.p) != 0) { sq_seterr(st, "write error\0"); return 1; };
                        sq_sb_free(@n2);
                    };
                    sq_sb_free(@nsql);
                    // indexes
                    for (i = 0; i < db.nschema; i++)
                    {
                        if (db.schema[i].kind != 2) { continue; };
                        if (sq_streq(@db.schema[i].tbl_name[0], @tname[0]) == false) { continue; };
                        rid = sq_master_find(db, @db.schema[i].name[0], sq_cstrlen(@db.schema[i].name[0]), "index\0");
                        if (rid < (i64)0) { continue; };
                        sq_sb_init(@nsql);
                        if ((u64)db.schema[i].sql == (u64)0)
                        {
                            // sqlite_autoindex_<table>_<n>
                            k = sq_cstrlen(@db.schema[i].name[0]);
                            c = k;
                            while (c > 0 & sq_isdigit(db.schema[i].name[c - 1])) { c--; };
                            sq_sb_lit(@nsql, "sqlite_autoindex_\0");
                            sq_sb_add(@nsql, @nname[0], nl);
                            sq_sb_lit(@nsql, "_\0");
                            sq_sb_add(@nsql, @db.schema[i].name[c], k - c);
                            rc = sq_master_replace(db, rid, "index\0", nsql.p, @nname[0], db.schema[i].rootpage, (byte*)0);
                        }
                        else
                        {
                            // CREATE [UNIQUE] INDEX name ON table: the table name is the token after ON
                            sq_sql_after_on(db.schema[i].sql, @tname[0], tl, q.p, q.n, @nsql);
                            rc = sq_master_replace(db, rid, "index\0", @db.schema[i].name[0], @nname[0], db.schema[i].rootpage, nsql.p);
                        };
                        sq_sb_free(@nsql);
                        if (rc != 0) { sq_seterr(st, "write error\0"); return 1; };
                    };
                    // sqlite_sequence
                    k = sq_find_table_n(db, "sqlite_sequence\0", 15);
                    if (k >= 0)
                    {
                        tc.db = db; tc.st = st; tc.seqroot = db.schema[k].rootpage;
                        for (i = 0; i < 64; i++) { tc.tname[i] = db.schema[tp].name[i]; };
                        c = (int)sq_seq_read(@tc, @rid);
                        if (rid >= (i64)0)
                        {
                            for (i = 0; i < 64; i++) { tc.tname[i] = (byte)0; };
                            for (i = 0; i < nl; i++) { tc.tname[i] = nname[i]; };
                            if (sq_btree_delete(db, tc.seqroot, rid) != 0) { return 1; };
                            if (sq_seq_write(@tc, (i64)c) != 0) { return 1; };
                        };
                    };
                    if (sq_ren_tbl_deps(st, @tname[0], tl, q.p, q.n, @nname[0], nl) != 0) { sq_sb_free(@q); return 1; };
                    sq_sb_free(@q);
                    return 0;
                };
                // RENAME [COLUMN] old TO new
                if (sq_is_kw(st, "column\0")) { sq_next(st); };
                if (st.tk != 1) { sq_seterr(st, "expected a column name\0"); return 1; };
                ocl = st.tl;
                if (ocl > 150) { sq_seterr(st, "name too long\0"); return 1; };
                for (k = 0; k < ocl; k++) { oc[k] = st.sql[st.ts + k]; };
                oc[ocl] = (byte)0;
                sq_next(st);
                if (sq_is_kw(st, "to\0") == false) { sq_seterr(st, "expected TO\0"); return 1; };
                sq_next(st);
                if (st.tk != 1) { sq_seterr(st, "expected a column name\0"); return 1; };
                es = sq_tok_start(st);
                ncl = st.tend - es;
                if (ncl > 150) { sq_seterr(st, "name too long\0"); return 1; };
                for (k = 0; k < ncl; k++) { ncn[k] = st.sql[es + k]; };
                ncn[ncl] = (byte)0;
                if (sq_tc_open(db, st, @tname[0], tl, @tc) != 0) { sq_tc_free(@tc); return 1; };
                c = sq_ti_find(tc.ti, @oc[0], 0, ocl);
                if (c < 0) { sq_err_name(st, "no such column: \0", @oc[0], ocl, "\0"); sq_tc_free(@tc); return 1; };
                if (sq_ti_find(tc.ti, st.sql, st.ts, st.tl) >= 0 & sq_tname_eq(@oc[0], 0, ocl, st.sql, st.ts, st.tl) == false)
                {
                    sq_err_name(st, "duplicate column name: \0", @st.sql[st.ts], st.tl, "\0");
                    sq_tc_free(@tc);
                    return 1;
                };
                sq_tc_free(@tc);
                // the table
                sql = db.schema[tp].sql;
                sq_sb_init(@nsql);
                sq_sql_rename(sql, @oc[0], ocl, @ncn[0], ncl, 3, @nsql);
                rid = sq_master_find(db, @tname[0], tl, "table\0");
                if (rid < (i64)0 | nsql.err != 0) { sq_seterr(st, "rename failed\0"); return 1; };
                rc = sq_master_replace(db, rid, "table\0", @db.schema[tp].name[0], @db.schema[tp].name[0], db.schema[tp].rootpage, nsql.p);
                sq_sb_free(@nsql);
                if (rc != 0) { sq_seterr(st, "write error\0"); return 1; };
                // indexes that name the column
                for (i = 0; i < db.nschema; i++)
                {
                    if (db.schema[i].kind != 2) { continue; };
                    if ((u64)db.schema[i].sql == (u64)0) { continue; };
                    if (sq_streq(@db.schema[i].tbl_name[0], @tname[0]) == false) { continue; };
                    rid = sq_master_find(db, @db.schema[i].name[0], sq_cstrlen(@db.schema[i].name[0]), "index\0");
                    if (rid < (i64)0) { continue; };
                    sq_sb_init(@nsql);
                    sq_sql_rename(db.schema[i].sql, @oc[0], ocl, @ncn[0], ncl, 6, @nsql);
                    rc = sq_master_replace(db, rid, "index\0", @db.schema[i].name[0], @db.schema[i].tbl_name[0], db.schema[i].rootpage, nsql.p);
                    sq_sb_free(@nsql);
                    if (rc != 0) { sq_seterr(st, "write error\0"); return 1; };
                };
                if (sq_ren_col_deps(st, @tname[0], tl, c, @oc[0], ocl, @ncn[0], ncl) != 0) { return 1; };
                return 0;
            };
            if (sq_is_kw(st, "drop\0")) { return sq_exec_drop_column(st, tp, @tname[0], tl); };
            if (sq_is_kw(st, "add\0"))
            {
                sq_next(st);
                if (sq_is_kw(st, "column\0")) { sq_next(st); };
                cstart = sq_tok_start(st);
                if (st.tk != 1) { sq_seterr(st, "expected a column definition\0"); return 1; };
                sq_sb_init(@q);
                sq_tail_text(st, cstart, @q);
                if (sq_find_kw_in(q.p, q.n, "primary\0")) { sq_sb_free(@q); sq_seterr(st, "Cannot add a PRIMARY KEY column\0"); return 1; };
                if (sq_find_kw_in(q.p, q.n, "unique\0")) { sq_sb_free(@q); sq_seterr(st, "Cannot add a UNIQUE column\0"); return 1; };
                if (sq_find_kw_in(q.p, q.n, "current_\0")) { sq_sb_free(@q); sq_seterr(st, "Cannot add a column with non-constant default\0"); return 1; };
                if (sq_find_kw_in(q.p, q.n, "stored\0")) { sq_sb_free(@q); sq_seterr(st, "cannot add a STORED column\0"); return 1; };
                if (sq_tc_open(db, st, @tname[0], tl, @tc) != 0) { sq_tc_free(@tc); sq_sb_free(@q); return 1; };
                // the new column name must be free
                es = st.ts;
                if (sq_ti_find(tc.ti, st.sql, st.ts, st.tl) >= 0)
                {
                    sq_err_name(st, "duplicate column name: \0", @st.sql[st.ts], st.tl, "\0");
                    sq_tc_free(@tc); sq_sb_free(@q);
                    return 1;
                };
                sq_tc_free(@tc);
                // new definition text: the old text with the column inserted before the last ')'
                sql = db.schema[tp].sql;
                e = sq_cstrlen(sql);
                lastp = 0 - 1;
                for (i = 0; i < e; i++) { if (sql[i] == (byte)41) { lastp = i; }; };
                if (lastp < 0) { sq_sb_free(@q); sq_seterr(st, "cannot read the table definition\0"); return 1; };
                sq_sb_init(@nsql);
                sq_sb_add(@nsql, sql, lastp);
                sq_sb_lit(@nsql, ", \0");
                sq_sb_add(@nsql, q.p, q.n);
                sq_sb_add(@nsql, @sql[lastp], e - lastp);
                sq_sb_free(@q);
                // validate: NOT NULL columns need a non-NULL default
                {
                    SQ_TI* t2;
                    t2 = (SQ_TI*)fmalloc((u64)(sizeof(SQ_TI) / 8 + 4096));
                    if ((u64)t2 == (u64)0) { sq_sb_free(@nsql); return 1; };
                    if (sq_ti_load(t2, nsql.p) != 0) { ffree((u64)t2); sq_sb_free(@nsql); sq_seterr(st, "unsupported column definition\0"); return 1; };
                    c = t2.ncols - 1;
                    if (t2.notnull[c] == 1)
                    {
                        if (t2.dfl[c] <= 0) { ffree((u64)t2); sq_sb_free(@nsql); sq_seterr(st, "Cannot add a NOT NULL column with default value NULL\0"); return 1; };
                        if (sq_ieq(@t2.base[t2.dfs[c]], t2.dfl[c], "null\0")) { ffree((u64)t2); sq_sb_free(@nsql); sq_seterr(st, "Cannot add a NOT NULL column with default value NULL\0"); return 1; };
                    };
                    ffree((u64)t2);
                };
                rid = sq_master_find(db, @tname[0], tl, "table\0");
                if (rid < (i64)0) { sq_sb_free(@nsql); sq_seterr(st, "alter failed\0"); return 1; };
                rc = sq_master_replace(db, rid, "table\0", @db.schema[tp].name[0], @db.schema[tp].name[0], db.schema[tp].rootpage, nsql.p);
                sq_sb_free(@nsql);
                if (rc != 0) { sq_seterr(st, "write error\0"); return 1; };
                return 0;
            };
            sq_seterr(st, "unsupported ALTER TABLE (only RENAME TO, RENAME COLUMN, ADD COLUMN and DROP COLUMN)\0");
            return 1;
        };


        // ---- statement dispatcher ----

        def sq_end_check(SQ_STMT* st) -> int
        {
            if (sq_is_op(st, 59)) { sq_next(st); };
            if (st.tk != 0) { sq_seterr(st, "unexpected text after the end of the statement\0"); return 1; };
            return 0;
        };

        // reads "OR <action>" after INSERT / UPDATE: 0 abort, 1 rollback, 2 fail, 3 ignore, 4 replace
        def sq_read_conflict(SQ_STMT* st) -> int
        {
            int r = 0;
            if (sq_is_kw(st, "or\0"))
            {
                sq_next(st);
                if (sq_is_kw(st, "abort\0")) { r = 0; };
                if (sq_is_kw(st, "rollback\0")) { r = 1; };
                if (sq_is_kw(st, "fail\0")) { r = 2; };
                if (sq_is_kw(st, "ignore\0")) { r = 3; };
                if (sq_is_kw(st, "replace\0")) { r = 4; };
                sq_next(st);
            };
            return r;
        };

        // table name after INSERT INTO / UPDATE / DELETE FROM; a leading "main." is skipped. Returns 0 on success.
        def sq_read_table_name(SQ_STMT* st, byte* name, int* nl) -> int
        {
            int k;
            if (st.tk != 1) { sq_seterr(st, "expected a table name\0"); return 1; };
            if (sq_peek_op(st, 46))
            {
                sq_next(st);
                sq_next(st);
                if (st.tk != 1) { sq_seterr(st, "expected a table name\0"); return 1; };
            };
            if (st.tl > 62) { sq_seterr(st, "table name too long\0"); return 1; };
            for (k = 0; k < st.tl; k++) { name[k] = st.sql[st.ts + k]; };
            name[st.tl] = (byte)0;
            *nl = st.tl;
            sq_next(st);
            return 0;
        };

        def sq_exec_reindex(SQ_STMT* st) -> int;
        def sq_exec_analyze(SQ_STMT* st) -> int;
        def sq_exec_vacuum(SQ_STMT* st) -> int;
        def sq_exec_explain(SQ_STMT* st, byte** pq) -> int;
        def sq_exec_attach(SQ_STMT* st) -> int;
        def sq_exec_detach(SQ_STMT* st) -> int;

        // runs one DML or DDL statement; the transaction around it is handled by the caller
        def sq_dispatch(SQ_STMT* st) -> int
        {
            SQLITE_DB* db = st.db;
            SQ_TCTX* tc;
            byte[72] name;
            int nl, oc, rc, unique, isreplace;
            if (sq_is_kw(st, "create\0"))
            {
                sq_next(st);
                if (sq_is_kw(st, "temp\0") | sq_is_kw(st, "temporary\0")) { sq_seterr(st, "temporary objects are not supported\0"); return 1; };
                if (sq_is_kw(st, "table\0")) { sq_next(st); return sq_exec_create_table(st); };
                unique = 0;
                if (sq_is_kw(st, "unique\0")) { unique = 1; sq_next(st); };
                if (sq_is_kw(st, "index\0")) { sq_next(st); return sq_exec_create_index(st, unique); };
                if (sq_is_kw(st, "view\0")) { sq_next(st); return sq_exec_create_view(st); };
                if (sq_is_kw(st, "virtual\0")) { sq_seterr(st, "virtual tables are not supported\0"); return 1; };
                if (sq_is_kw(st, "trigger\0")) { return sq_exec_create_trigger(st); };
                sq_seterr(st, "unsupported CREATE statement\0");
                return 1;
            };
            if (sq_is_kw(st, "drop\0")) { sq_next(st); return sq_exec_drop(st); };
            if (sq_is_kw(st, "alter\0")) { sq_next(st); return sq_exec_alter(st); };
            if (sq_is_kw(st, "reindex\0")) { sq_next(st); return sq_exec_reindex(st); };
            if (sq_is_kw(st, "analyze\0")) { sq_next(st); return sq_exec_analyze(st); };
            isreplace = 0;
            if (sq_is_kw(st, "replace\0")) { isreplace = 1; };
            if (sq_is_kw(st, "insert\0") | isreplace == 1)
            {
                sq_next(st);
                oc = sq_read_conflict(st);
                if (isreplace == 1) { oc = 4; };
                if (sq_is_kw(st, "into\0") == false) { sq_seterr(st, "expected INTO\0"); return 1; };
                sq_next(st);
                if (sq_read_table_name(st, @name[0], @nl) != 0) { return 1; };
                if (sq_is_kw(st, "as\0")) { sq_next(st); sq_next(st); };
                if (sq_view_instead(db, @name[0], nl, 1)) { return sq_exec_view_dml(st, 1, @name[0], nl); };
                tc = (SQ_TCTX*)fmalloc((u64)(sizeof(SQ_TCTX) / 8 + 4096));
                if ((u64)tc == (u64)0) { sq_seterr(st, "out of memory\0"); return 1; };
                tc.ti = (SQ_TI*)0;
                rc = sq_tc_open(db, st, @name[0], nl, tc);
                if (rc == 0) { rc = sq_exec_insert(st, tc, oc, @name[0], nl); };
                if (rc == 0) { rc = sq_tc_finish(tc); };
                sq_tc_free(tc);
                ffree((u64)tc);
                return rc;
            };
            if (sq_is_kw(st, "update\0"))
            {
                sq_next(st);
                oc = sq_read_conflict(st);
                if (sq_read_table_name(st, @name[0], @nl) != 0) { return 1; };
                if (sq_view_instead(db, @name[0], nl, 2)) { return sq_exec_view_dml(st, 2, @name[0], nl); };
                tc = (SQ_TCTX*)fmalloc((u64)(sizeof(SQ_TCTX) / 8 + 4096));
                if ((u64)tc == (u64)0) { sq_seterr(st, "out of memory\0"); return 1; };
                tc.ti = (SQ_TI*)0;
                rc = sq_tc_open(db, st, @name[0], nl, tc);
                if (rc == 0) { rc = sq_exec_update(st, tc, oc, @name[0], nl); };
                sq_tc_free(tc);
                ffree((u64)tc);
                return rc;
            };
            if (sq_is_kw(st, "delete\0"))
            {
                sq_next(st);
                if (sq_is_kw(st, "from\0") == false) { sq_seterr(st, "expected FROM\0"); return 1; };
                sq_next(st);
                if (sq_read_table_name(st, @name[0], @nl) != 0) { return 1; };
                if (sq_view_instead(db, @name[0], nl, 3)) { return sq_exec_view_dml(st, 3, @name[0], nl); };
                tc = (SQ_TCTX*)fmalloc((u64)(sizeof(SQ_TCTX) / 8 + 4096));
                if ((u64)tc == (u64)0) { sq_seterr(st, "out of memory\0"); return 1; };
                tc.ti = (SQ_TI*)0;
                rc = sq_tc_open(db, st, @name[0], nl, tc);
                if (rc == 0) { rc = sq_exec_delete(st, tc, @name[0], nl); };
                sq_tc_free(tc);
                ffree((u64)tc);
                return rc;
            };
            sq_seterr(st, "unsupported statement\0");
            return 1;
        };

        // ---- parameters in DML statements ----

        // Rewrites ?, ?N, :name, @name and $name into explicit ?N form so that any slice of the statement keeps the numbering.
        // Names are kept after the end of the text so sq_param_index still finds them. Returns 0 on success.
        def sq_rewrite_params(SQ_STMT* st) -> int
        {
            byte* out;
            int i, n, o, maxp, idx, k, j, d, l, nn, q;
            byte c;
            int[64] ns, nl;
            n = st.sqllen;
            out = (byte*)fmalloc((u64)(n * 2 + 400));
            if ((u64)out == (u64)0) { sq_seterr(st, "out of memory\0"); return 1; };
            o = 0;
            i = 0;
            maxp = 0;
            nn = 0;
            while (i < n)
            {
                c = st.sql[i];
                if (c == (byte)39 | c == (byte)34 | c == (byte)96 | c == (byte)91)
                {
                    q = (int)c;
                    if (c == (byte)91) { q = 93; };
                    out[o] = c; o++; i++;
                    while (i < n & (int)st.sql[i] != q) { out[o] = st.sql[i]; o++; i++; };
                    if (i < n) { out[o] = st.sql[i]; o++; i++; };
                    continue;
                };
                if (c == (byte)45 & i + 1 < n)
                {
                    if (st.sql[i + 1] == (byte)45)
                    {
                        while (i < n & st.sql[i] != (byte)10) { out[o] = st.sql[i]; o++; i++; };
                        continue;
                    };
                };
                if (c == (byte)47 & i + 1 < n)
                {
                    if (st.sql[i + 1] == (byte)42)
                    {
                        out[o] = st.sql[i]; o++; i++;
                        out[o] = st.sql[i]; o++; i++;
                        while (i + 1 < n)
                        {
                            if (st.sql[i] == (byte)42 & st.sql[i + 1] == (byte)47) { break; };
                            out[o] = st.sql[i]; o++; i++;
                        };
                        continue;
                    };
                };
                idx = 0;
                if (c == (byte)63)
                {
                    j = i + 1;
                    d = 0;
                    while (j < n & sq_isdigit(st.sql[j])) { d = d * 10 + (int)st.sql[j] - 48; j++; if (d > 100000) { d = 100000; }; };
                    if (j > i + 1)
                    {
                        idx = d;
                        if (idx < 1 | idx > 64) { ffree((u64)out); sq_seterr(st, "parameter index out of range\0"); return 1; };
                        if (idx > maxp) { maxp = idx; };
                        while (i < j) { out[o] = st.sql[i]; o++; i++; };
                        continue;
                    };
                    maxp++;
                    idx = maxp;
                };
                if (idx == 0 & (c == (byte)58 | c == (byte)64 | c == (byte)36))
                {
                    j = i + 1;
                    if (j < n)
                    {
                        if (sq_isalpha(st.sql[j]) | st.sql[j] == (byte)95)
                        {
                            while (j < n & (sq_isalpha(st.sql[j]) | sq_isdigit(st.sql[j]) | st.sql[j] == (byte)95)) { j++; };
                            l = j - i;
                            idx = 0;
                            for (k = 0; k < nn; k++)
                            {
                                if (nl[k] == l)
                                {
                                    if (sq_mem_eq(@st.sql[ns[k]], @st.sql[i], l)) { idx = k + 1; };
                                };
                            };
                            if (idx == 0)
                            {
                                if (nn >= 64) { ffree((u64)out); sq_seterr(st, "too many parameters\0"); return 1; };
                                ns[nn] = i; nl[nn] = l; nn++;
                                maxp++;
                                if (maxp > 64) { ffree((u64)out); sq_seterr(st, "too many parameters\0"); return 1; };
                                idx = maxp;
                                ns[nn - 1] = i;
                            };
                            i = j;
                        };
                    };
                };
                if (idx > 0)
                {
                    if (idx > 64) { ffree((u64)out); sq_seterr(st, "too many parameters\0"); return 1; };
                    out[o] = (byte)63; o++;
                    if (idx >= 10) { out[o] = (byte)(48 + idx / 10); o++; };
                    out[o] = (byte)(48 + idx % 10); o++;
                    continue;
                };
                out[o] = c;
                o++;
                i++;
            };
            out[o] = (byte)0;
            // names are copied behind the text before it is replaced
            if (o + 1 > 200000) { ffree((u64)out); sq_seterr(st, "statement too large\0"); return 1; };
            k = o + 1;
            for (j = 0; j < nn; j++)
            {
                if (k + nl[j] + 1 > 260000) { break; };
                for (l = 0; l < nl[j]; l++) { out[k + l] = st.sql[ns[j] + l]; };
                st.pns[j] = k;
                st.pnl[j] = nl[j];
                k = k + nl[j];
            };
            for (j = 0; j < k; j++) { st.sql[j] = out[j]; };
            st.sqllen = o;
            st.lim = o;
            st.nparam = maxp;
            ffree((u64)out);
            return 0;
        };

        // true when the statement text starts a SELECT, WITH or VALUES query
        def sq_is_query(byte* sql) -> bool
        {
            int i = 0;
            while (sql[i] == (byte)32 | sql[i] == (byte)9 | sql[i] == (byte)10 | sql[i] == (byte)13) { i++; };
            if (sq_lc(sql[i]) == (byte)115 & sq_lc(sql[i + 1]) == (byte)101 & sq_lc(sql[i + 2]) == (byte)108) { return true; };
            if (sq_lc(sql[i]) == (byte)119 & sq_lc(sql[i + 1]) == (byte)105 & sq_lc(sql[i + 2]) == (byte)116) { return true; };
            if (sq_lc(sql[i]) == (byte)118 & sq_lc(sql[i + 1]) == (byte)97 & sq_lc(sql[i + 2]) == (byte)108) { return true; };
            return false;
        };

        // topmost savepoint level with the given name, or -1
        def sq_sp_find(SQLITE_DB* db, byte* nm, int nl) -> int
        {
            int lv, k, same;
            lv = db.nlv - 1;
            while (lv >= 0)
            {
                if (db.lv_kind[lv] == 1)
                {
                    same = 1;
                    for (k = 0; k < nl; k++) { if (sq_lc(db.lv_name[lv * 40 + k]) != sq_lc(nm[k])) { same = 0; }; };
                    if (db.lv_name[lv * 40 + nl] != (byte)0) { same = 0; };
                    if (same == 1) { return lv; };
                };
                lv--;
            };
            return 0 - 1;
        };

        // deferred foreign key violation count at the time each savepoint level was opened
        global int[20] SQ_LVFK;

        // SAVEPOINT / RELEASE / ROLLBACK TO. kind: 1 savepoint, 2 release, 3 rollback to. Returns 0 on success.
        // one savepoint operation on one database (kind 1 SAVEPOINT, 2 RELEASE, 3 ROLLBACK TO)
        def sq_sp_one(SQ_STMT* st, SQLITE_DB* db, int kind, byte* nm, int nl) -> int
        {
            int lv, rc;
            if (kind == 1)
            {
                if (db.in_txn == 0)
                {
                    if (sq_txn_begin(db, 1) != 0) { sq_seterr(st, "cannot begin transaction\0"); return 1; };
                    db.sp_auto = 1;
                };
                if (sq_lv_push(db, 1, nm) != 0) { sq_seterr(st, "too many savepoints\0"); return 1; };
                SQ_LVFK[db.nlv - 1] = SQ_FKDEF;
                return 0;
            };
            lv = sq_sp_find(db, nm, nl);
            if (lv < 0) { sq_err_name(st, "no such savepoint: \0", nm, nl, "\0"); return 1; };
            if (kind == 2)
            {
                while (db.nlv - 1 >= lv)
                {
                    if (sq_lv_merge(db) != 0) { sq_seterr(st, "savepoint release failed\0"); return 1; };
                };
                if (db.nlv == 0 & db.sp_auto == 1)
                {
                    db.sp_auto = 0;
                    if (sq_txn_commit(db) != 0) { sq_seterr(st, "write error\0"); return 1; };
                };
                return 0;
            };
            while (db.nlv - 1 > lv) { sq_lv_undo(db, 0); };
            sq_lv_undo(db, 1);
            SQ_FKDEF = SQ_LVFK[lv];
            rc = sq_schema_load(db);
            return 0;
        };

        // a savepoint applies to the main database and to every attached one
        def sq_exec_savepoint(SQ_STMT* st, int kind) -> int
        {
            SQLITE_DB* db = st.db;
            byte[48] nm;
            int nl, k, rc;
            if (st.tk != 1) { sq_seterr(st, "expected a savepoint name\0"); return 1; };
            nl = st.tl;
            if (nl > 38) { sq_seterr(st, "savepoint name too long\0"); return 1; };
            for (k = 0; k < nl; k++) { nm[k] = st.sql[st.ts + k]; };
            nm[nl] = (byte)0;
            sq_next(st);
            if (sq_end_check(st) != 0) { return 1; };
            rc = sq_sp_one(st, db, kind, @nm[0], nl);
            if (rc != 0) { return rc; };
            for (k = 0; k < db.natt; k++)
            {
                rc = sq_sp_one(st, (SQLITE_DB*)db.att[k], kind, @nm[0], nl);
                if (rc != 0) { return rc; };
            };
            return 0;
        };

        // skips a parenthesised group; the current token is the opening parenthesis
        def sq_skip_group(SQ_STMT* st) -> int
        {
            int depth = 0;
            while (st.tk != 0)
            {
                if (sq_is_op(st, 40)) { depth++; };
                if (sq_is_op(st, 41)) { depth--; if (depth == 0) { sq_next(st); return 0; }; };
                sq_next(st);
            };
            return 1;
        };

        // WITH clause in front of INSERT/UPDATE/DELETE: records its text span (wp_s..wp_e) and leaves the lexer on the
        // DML keyword. Returns 0 (lexer restored) when the statement is a plain query.
        def sq_with_scan(SQ_STMT* st) -> int
        {
            int ws, ok;
            ws = sq_tok_start(st);
            ok = 0;
            sq_next(st);
            if (sq_is_kw(st, "recursive\0")) { sq_next(st); };
            while (true)
            {
                if (st.tk != 1) { break; };
                sq_next(st);
                if (sq_is_op(st, 40)) { if (sq_skip_group(st) != 0) { break; }; };
                if (sq_is_kw(st, "as\0") == false) { break; };
                sq_next(st);
                if (sq_is_kw(st, "not\0")) { sq_next(st); };
                if (sq_is_kw(st, "materialized\0")) { sq_next(st); };
                if (sq_is_op(st, 40) == false) { break; };
                if (sq_skip_group(st) != 0) { break; };
                if (sq_is_op(st, 44)) { sq_next(st); continue; };
                if (sq_is_kw(st, "insert\0") | sq_is_kw(st, "replace\0") | sq_is_kw(st, "update\0") | sq_is_kw(st, "delete\0")) { ok = 1; };
                break;
            };
            if (ok == 1)
            {
                st.wp_s = ws;
                st.wp_e = sq_tok_start(st);
                return 1;
            };
            st.pad = 0;
            st.pos = 0; st.tend = 0; st.prevend = 0; st.lim = st.sqllen;
            sq_next(st);
            return 0;
        };

        // Runs the statement held in st (text prepared, parameters bound). With keep set, a successful run leaves st ready to
        // step through the RETURNING rows (kind 3).
        def sq_exec_run0(SQ_STMT* st, int keep) -> int
        {
            SQ_PRFN = (u64)@sq_ptvf_hook;
            SQLITE_DB* db = st.db;
            int rc, autoc, ctl, kp, nchg, fkdef0, ak, am;
            i64 lrid;
            SQ_RS* sret;
            byte* sretsql;
            byte* pq;
            st.pad = 0;
            st.pos = 0; st.tend = 0; st.prevend = 0; st.lim = st.sqllen;
            st.ret_s = 0 - 1; st.ret_e = 0 - 1;
            st.wp_s = 0; st.wp_e = 0;
            sq_next(st);
            if (sq_is_kw(st, "with\0")) { sq_with_scan(st); };
            if (st.wp_e == 0 & (sq_is_kw(st, "select\0") | sq_is_kw(st, "with\0") | sq_is_kw(st, "values\0")))
            {
                if (sq_prep_query(st, db, st.sql) != 0) { return 1; };
                while (sq_step_query(st) == 1) { };
                rc = 0;
                if (st.err[0] != (byte)0) { rc = 1; };
                sq_finalize(st);
                return rc;
            };
            if (sq_is_kw(st, "attach\0"))
            {
                sq_next(st);
                rc = sq_exec_attach(st);
                sq_finalize(st);
                return rc;
            };
            if (sq_is_kw(st, "detach\0"))
            {
                sq_next(st);
                rc = sq_exec_detach(st);
                sq_finalize(st);
                return rc;
            };
            if (db.rw != 1) { sq_seterr(st, "database is open read-only\0"); return 1; };
            // transaction control
            ctl = 0;
            if (sq_is_kw(st, "begin\0")) { ctl = 1; };
            if (sq_is_kw(st, "commit\0") | sq_is_kw(st, "end\0")) { ctl = 2; };
            if (sq_is_kw(st, "rollback\0")) { ctl = 3; };
            if (sq_is_kw(st, "savepoint\0"))
            {
                sq_next(st);
                rc = sq_exec_savepoint(st, 1);
                sq_finalize(st);
                return rc;
            };
            if (sq_is_kw(st, "release\0"))
            {
                sq_next(st);
                if (sq_is_kw(st, "savepoint\0")) { sq_next(st); };
                rc = sq_exec_savepoint(st, 2);
                sq_finalize(st);
                return rc;
            };
            if (ctl != 0)
            {
                sq_next(st);
                if (sq_is_kw(st, "deferred\0") | sq_is_kw(st, "immediate\0") | sq_is_kw(st, "exclusive\0")) { sq_next(st); };
                if (sq_is_kw(st, "transaction\0")) { sq_next(st); };
                if (ctl == 3 & sq_is_kw(st, "to\0"))
                {
                    sq_next(st);
                    if (sq_is_kw(st, "savepoint\0")) { sq_next(st); };
                    rc = sq_exec_savepoint(st, 3);
                    sq_finalize(st);
                    return rc;
                };
                if (sq_end_check(st) != 0) { sq_finalize(st); return 1; };
                sq_finalize(st);
                if (ctl == 1)
                {
                    if (db.in_txn == 1) { sq_seterr(st, "cannot start a transaction within a transaction\0"); return 1; };
                    if (sq_txn_begin(db, 1) != 0) { sq_seterr(st, "cannot begin transaction\0"); return 1; };
                    for (ak = 0; ak < db.natt; ak++)
                    {
                        if (sq_txn_begin((SQLITE_DB*)db.att[ak], 1) != 0)
                        {
                            for (am = 0; am < ak; am++) { sq_txn_rollback((SQLITE_DB*)db.att[am]); };
                            sq_txn_rollback(db);
                            sq_seterr(st, "cannot begin transaction\0");
                            return 1;
                        };
                    };
                    return 0;
                };
                if (db.in_txn == 0)
                {
                    sq_seterr(st, "cannot commit or roll back: no transaction is active\0");
                    return 1;
                };
                if (ctl == 2)
                {
                    if (SQ_FKDEF > 0) { sq_seterr(st, "FOREIGN KEY constraint failed\0"); return 1; };
                    if (sq_txn_commit(db) != 0) { sq_seterr(st, "write error\0"); return 1; };
                    for (ak = 0; ak < db.natt; ak++)
                    {
                        if (((SQLITE_DB*)db.att[ak]).in_txn == 1)
                        {
                            if (sq_txn_commit((SQLITE_DB*)db.att[ak]) != 0) { sq_seterr(st, "write error\0"); return 1; };
                        };
                    };
                    SQ_FKDEF = 0;
                    return 0;
                };
                SQ_FKDEF = 0;
                for (ak = 0; ak < db.natt; ak++)
                {
                    if (((SQLITE_DB*)db.att[ak]).in_txn == 1)
                    {
                        sq_txn_rollback((SQLITE_DB*)db.att[ak]);
                        sq_schema_load((SQLITE_DB*)db.att[ak]);
                    };
                };
                rc = sq_txn_rollback(db);
                sq_schema_load(db);
                if (rc != 0) { sq_seterr(st, "rollback failed\0"); return 1; };
                return 0;
            };
            if (sq_is_kw(st, "vacuum\0"))
            {
                sq_next(st);
                rc = sq_exec_vacuum(st);
                sq_finalize(st);
                return rc;
            };
            if (sq_is_kw(st, "explain\0"))
            {
                sq_next(st);
                pq = (byte*)0;
                rc = sq_exec_explain(st, @pq);
                sq_finalize(st);
                if ((u64)pq != (u64)0)
                {
                    if (rc == 0 & keep == 1)
                    {
                        rc = sq_prep_query(st, db, pq);
                        ffree((u64)pq);
                        return rc;
                    };
                    ffree((u64)pq);
                };
                return rc;
            };
            if (sq_is_kw(st, "pragma\0"))
            {
                sq_next(st);
                pq = (byte*)0;
                rc = sq_exec_pragma(st, @pq);
                sq_finalize(st);
                if ((u64)pq != (u64)0)
                {
                    if (rc == 0 & keep == 1)
                    {
                        rc = sq_prep_query(st, db, pq);
                        ffree((u64)pq);
                        return rc;
                    };
                    ffree((u64)pq);
                };
                return rc;
            };
            autoc = 0;
            if (db.in_txn == 0)
            {
                autoc = 1;
                if (sq_txn_begin(db, 0) != 0) { sq_seterr(st, "cannot begin transaction\0"); return 1; };
            }
            else
            {
                if (sq_stmt_begin(db) != 0) { sq_seterr(st, "out of memory\0"); return 1; };
            };
            SQ_FKCNT = 0;
            fkdef0 = SQ_FKDEF;
            rc = sq_dispatch(st);
            if (rc == 0 & SQ_FKCNT > 0) { sq_seterr(st, "FOREIGN KEY constraint failed\0"); rc = 1; };
            if (rc == 0 & autoc == 1 & SQ_FKDEF > 0) { sq_seterr(st, "FOREIGN KEY constraint failed\0"); rc = 1; };
            if (rc != 0) { SQ_FKDEF = fkdef0; };
            SQ_FKCNT = 0;
            kp = 0;
            if (rc != 0 & st.pad == 2) { kp = 1; };
            nchg = st.changes;
            lrid = st.last_rowid;
            sret = st.ret;
            sretsql = st.retsql;
            st.ret = (SQ_RS*)0;
            st.retsql = (byte*)0;
            sq_finalize(st);
            if (autoc == 1)
            {
                if (rc == 0 | kp == 1)
                {
                    if (sq_txn_commit(db) != 0)
                    {
                        sq_txn_rollback(db);
                        sq_seterr(st, "write error\0");
                        rc = 1;
                    };
                }
                else { sq_txn_rollback(db); };
            }
            else
            {
                if (rc == 0 | kp == 1) { sq_stmt_end(db, 1); } else { sq_stmt_end(db, 0); };
                if (rc != 0 & st.pad == 1) { sq_txn_rollback(db); };
            };
            if (db.in_txn == 0) { SQ_FKDEF = 0; };
            sq_schema_load(db);
            if (rc != 0)
            {
                if ((u64)sret != (u64)0) { sq_rs_free(sret); };
                if ((u64)sretsql != (u64)0) { ffree((u64)sretsql); };
                return rc;
            };
            if (keep == 1)
            {
                if ((u64)sretsql != (u64)0)
                {
                    if (sq_prep_query(st, db, sretsql) != 0) { sq_rs_free(sret); ffree((u64)sretsql); return 1; };
                    ffree((u64)sretsql);
                }
                else { sq_stmt_init(st, db, "\0"); };
                st.kind = 3;
                st.ret = sret;
                st.state = 0;
                st.changes = nchg;
                st.last_rowid = lrid;
                return 0;
            };
            if ((u64)sret != (u64)0) { sq_rs_free(sret); };
            if ((u64)sretsql != (u64)0) { ffree((u64)sretsql); };
            return 0;
        };

        // a lock that could not be taken (another connection is writing or reading) is reported the way SQLite does
        def sq_busy_err(SQ_STMT* st) -> void
        {
            byte* m = "database is locked\0";
            int i;
            for (i = 0; m[i] != (byte)0; i++) { st.err[i] = m[i]; };
            st.err[i] = (byte)0;
            st.db.busy = 0;
        };

        def sq_exec_run(SQ_STMT* st, int keep) -> int
        {
            SQLITE_DB* db = st.db;
            int rc;
            db.busy = 0;
            if (sq_read_begin(db) != 0) { sq_busy_err(st); return 1; };
            rc = sq_exec_run0(st, keep);
            sq_read_end(db);
            if (rc != 0 & db.busy == 1) { sq_busy_err(st); };
            db.busy = 0;
            return rc;
        };

        // Executes one statement of any kind and discards any rows (use sq_prepare / sq_step to read them).
        // st.changes and st.last_rowid describe the effect of INSERT, UPDATE and DELETE.
        // Parameters bound to st with sq_bind_* before the call are kept.
        def sq_exec(SQ_STMT* st, SQLITE_DB* db, byte* sql) -> int
        {
            SQ_VAL[64] keep;
            int i;
            for (i = 0; i < 64; i++) { sq_val_copy(@keep[i], @st.pv[i]); };
            sq_stmt_init(st, db, sql);
            for (i = 0; i < 64; i++) { sq_val_copy(@st.pv[i], @keep[i]); };
            if (sq_rewrite_params(st) != 0) { return 1; };
            return sq_exec_run(st, 0);
        };

        // Prepares any statement. Queries are prepared at once; other statements run on the first sq_step, so parameters can be
        // bound between the two. After the run sq_step returns the rows of RETURNING, if any.
        def sq_prepare(SQ_STMT* st, SQLITE_DB* db, byte* sql) -> int
        {
            int dml, i;
            dml = 0;
            if (sq_is_query(sql))
            {
                i = 0;
                while (sql[i] == (byte)32 | sql[i] == (byte)9 | sql[i] == (byte)10 | sql[i] == (byte)13) { i++; };
                if (sq_lc(sql[i]) == (byte)119)
                {
                    // WITH in front of INSERT/UPDATE/DELETE is not a query
                    sq_stmt_init(st, db, sql);
                    st.pad = 0;
                    st.wp_s = 0; st.wp_e = 0;
                    sq_next(st);
                    dml = sq_with_scan(st);
                    st.wp_s = 0; st.wp_e = 0;
                };
                if (dml == 0) { return sq_prep_query(st, db, sql); };
            };
            sq_stmt_init(st, db, sql);
            if (sq_rewrite_params(st) != 0) { return 1; };
            st.kind = 4;
            st.state = 0;
            return 0;
        };

        def sq_step(SQ_STMT* st) -> int
        {
            if (st.kind == 4)
            {
                if (st.state == 0)
                {
                    if (sq_exec_run(st, 1) != 0) { st.state = 2; return 0 - 1; };
                    if (st.kind != 3 & st.kind != 1) { st.state = 2; return 0; };
                };
            };
            return sq_step_query(st);
        };

        // ---- REINDEX and ANALYZE ----

        // The order SQLite walks its table hash (REINDEX and ANALYZE of a whole database): the hash keeps a
        // list where a new entry goes in front of its bucket chain, or in front of the list when the bucket
        // is empty or there are no buckets yet. Returns the number of table positions written to out.
        def sq_hash_order(SQLITE_DB* db, int* out, int maxn) -> int
        {
            int* nx;
            int* pv;
            u64* hv;
            int* pos;
            int* bh;
            int m, nm, i, first, count, htsize, b, head, e, nxt, ns, w, outn, ch;
            u64 h;
            nm = db.nschema + 1;
            nx = (int*)fmalloc((u64)nm * (u64)4);
            pv = (int*)fmalloc((u64)nm * (u64)4);
            pos = (int*)fmalloc((u64)nm * (u64)4);
            hv = (u64*)fmalloc((u64)nm * (u64)8);
            if ((u64)nx == (u64)0 | (u64)pv == (u64)0 | (u64)pos == (u64)0 | (u64)hv == (u64)0) { return 0; };
            bh = (int*)0;
            first = 0 - 1; count = 0; htsize = 0;
            w = 0;
            for (i = 0; i < db.nschema + 1; i++)
            {
                if (i > 0) { if (db.schema[i - 1].kind != 1 & db.schema[i - 1].kind != 3) { continue; }; };
                pos[w] = i - 1;
                h = (u64)0;
                if (i == 0)
                {
                    byte* sm = "sqlite_master\0";
                    for (e = 0; sm[e] != (byte)0; e++) { h = ((h + (u64)sm[e]) * (u64)2654435761) % (u64)4294967296; };
                }
                else
                {
                    for (e = 0; db.schema[i - 1].name[e] != (byte)0; e++)
                    {
                        ch = (int)db.schema[i - 1].name[e];
                        if (ch >= 65 & ch <= 90) { ch = ch + 32; };
                        h = ((h + (u64)ch) * (u64)2654435761) % (u64)4294967296;
                    };
                };
                hv[w] = h;
                m = w;
                w++;
                count++;
                if (count >= 10 & count > 2 * htsize)
                {
                    ns = count * 2;
                    if ((u64)bh != (u64)0) { ffree((u64)bh); };
                    bh = (int*)fmalloc((u64)ns * (u64)4);
                    for (b = 0; b < ns; b++) { bh[b] = 0 - 1; };
                    htsize = ns;
                    e = first;
                    first = 0 - 1;
                    while (e != 0 - 1)
                    {
                        nxt = nx[e];
                        b = (int)(hv[e] % (u64)htsize);
                        head = bh[b];
                        if (head != 0 - 1)
                        {
                            nx[e] = head; pv[e] = pv[head];
                            if (pv[head] != 0 - 1) { nx[pv[head]] = e; } else { first = e; };
                            pv[head] = e;
                        }
                        else
                        {
                            nx[e] = first;
                            if (first != 0 - 1) { pv[first] = e; };
                            pv[e] = 0 - 1;
                            first = e;
                        };
                        bh[b] = e;
                        e = nxt;
                    };
                };
                b = 0 - 1;
                head = 0 - 1;
                if (htsize > 0) { b = (int)(hv[m] % (u64)htsize); head = bh[b]; };
                if (head != 0 - 1)
                {
                    nx[m] = head; pv[m] = pv[head];
                    if (pv[head] != 0 - 1) { nx[pv[head]] = m; } else { first = m; };
                    pv[head] = m;
                }
                else
                {
                    nx[m] = first;
                    if (first != 0 - 1) { pv[first] = m; };
                    pv[m] = 0 - 1;
                    first = m;
                };
                if (b >= 0) { bh[b] = m; };
            };
            outn = 0;
            e = first;
            while (e != 0 - 1)
            {
                if (pos[e] >= 0 & outn < maxn) { out[outn] = pos[e]; outn++; };
                e = nx[e];
            };
            if ((u64)bh != (u64)0) { ffree((u64)bh); };
            ffree((u64)nx); ffree((u64)pv); ffree((u64)pos); ffree((u64)hv);
            return outn;
        };

        // rebuilds one index of an open table context
        def sq_reindex_ix(SQ_STMT* st, SQ_TCTX* tc, int ixn) -> int
        {
            int rc = sq_tc_rebuild(tc, @tc.ix[ixn]);
            if (rc == 4) { sq_err_unique(tc, @tc.ix[ixn], 0); return 1; };
            if (rc != 0) { sq_seterr(st, "index build failed\0"); return 1; };
            return 0;
        };

        // rebuilds the indexes of the table at schema position tp; only is an index name to restrict to, coll a collation
        // code to restrict to (-1 for none)
        def sq_reindex_table(SQ_STMT* st, int tp, byte* only, int coll) -> int
        {
            SQLITE_DB* db = st.db;
            SQ_TCTX* tc;
            byte[72] tn;
            int k, j, rc, use, tl, pass, m, isauto;
            tl = 0;
            while (db.schema[tp].name[tl] != (byte)0 & tl < 70) { tn[tl] = db.schema[tp].name[tl]; tl++; };
            tn[tl] = (byte)0;
            tc = (SQ_TCTX*)fmalloc((u64)(sizeof(SQ_TCTX) / 8 + 4096));
            if ((u64)tc == (u64)0) { sq_seterr(st, "out of memory\0"); return 1; };
            tc.ti = (SQ_TI*)0;
            if (sq_tc_open(db, st, @tn[0], tl, tc) != 0) { sq_tc_free(tc); ffree((u64)tc); return 1; };
            rc = 0;
            // SQLite order: explicit indexes newest first, then the automatic ones (the WITHOUT ROWID
            // primary key first) in creation order
            for (pass = 0; pass < 3; pass++)
            {
                for (m = 0; m < tc.nix + 1; m++)
                {
                    if (rc != 0) { break; };
                    use = 1;
                    if (pass == 0) { k = tc.nix - 1 - m; };
                    if (pass == 1) { k = 0 - 1; if (m != 0 | tc.wor == 0) { continue; }; };
                    if (pass == 2) { k = m; };
                    if (k >= tc.nix | (pass == 0 & k < 0)) { continue; };
                    if (k >= 0)
                    {
                        isauto = 0;
                        if (tc.ix[k].name[0] == (byte)115 & tc.ix[k].name[7] == (byte)97 & tc.ix[k].name[8] == (byte)117) { isauto = 1; };
                        if (isauto != pass / 2) { continue; };
                        if ((u64)only != (u64)0) { if (sq_name_is(only, sq_cstrlen(only), @tc.ix[k].name[0]) == false) { use = 0; }; };
                        if (coll >= 0)
                        {
                            use = 0;
                            for (j = 0; j < tc.ix[k].nk; j++) { if (tc.ix[k].coll[j] == coll) { use = 1; }; };
                        };
                    }
                    else
                    {
                        if ((u64)only != (u64)0) { use = 0; };
                        if (coll >= 0)
                        {
                            use = 0;
                            for (j = 0; j < tc.wix.nk; j++) { if (tc.wix.coll[j] == coll) { use = 1; }; };
                        };
                    };
                    if (use == 0) { continue; };
                    if (k >= 0) { if (sq_reindex_ix(st, tc, k) != 0) { rc = 1; break; }; }
                    else { if (sq_wor_rebuild(tc, (SQ_VAL*)0, 0 - 1) != 0) { sq_seterr(st, "index build failed\0"); rc = 1; break; }; };
                };
            };
            sq_tc_free(tc);
            ffree((u64)tc);
            return rc;
        };

        def sq_exec_reindex(SQ_STMT* st) -> int
        {
            SQLITE_DB* db = st.db;
            byte[72] nm;
            int nl, i, c, found, tp, hn;
            int* ho;
            if (st.tk == 0 | sq_is_op(st, 59))
            {
                if (sq_end_check(st) != 0) { return 1; };
                ho = (int*)fmalloc((u64)(db.nschema + 2) * (u64)4);
                hn = sq_hash_order(db, ho, db.nschema + 1);
                for (i = 0; i < hn; i++)
                {
                    if (sq_reindex_table(st, ho[i], (byte*)0, 0 - 1) != 0) { ffree((u64)ho); return 1; };
                };
                ffree((u64)ho);
                return 0;
            };
            if (sq_read_table_name(st, @nm[0], @nl) != 0) { return 1; };
            if (sq_end_check(st) != 0) { return 1; };
            c = sq_coll_id(@nm[0], nl);
            if (c >= 0)
            {
                ho = (int*)fmalloc((u64)(db.nschema + 2) * (u64)4);
                hn = sq_hash_order(db, ho, db.nschema + 1);
                for (i = 0; i < hn; i++)
                {
                    if (sq_reindex_table(st, ho[i], (byte*)0, c) != 0) { ffree((u64)ho); return 1; };
                };
                ffree((u64)ho);
                return 0;
            };
            tp = sq_find_table_n(db, @nm[0], nl);
            if (tp >= 0) { return sq_reindex_table(st, tp, (byte*)0, 0 - 1); };
            found = 0 - 1;
            for (i = 0; i < db.nschema; i++)
            {
                if (db.schema[i].kind == 2 & sq_name_is(@nm[0], nl, @db.schema[i].name[0])) { found = i; };
            };
            if (found >= 0)
            {
                tp = sq_find_table_n(db, @db.schema[found].tbl_name[0], sq_cstrlen(@db.schema[found].tbl_name[0]));
                if (tp >= 0) { return sq_reindex_table(st, tp, @db.schema[found].name[0], 0 - 1); };
            };
            sq_seterr(st, "unable to identify the object to be reindexed\0");
            return 1;
        };

        // adds 'text' to the builder with quotes doubled
        def sq_sb_quoted(SQ_SB* sb, byte* s, int n) -> void
        {
            int i;
            sq_sb_lit(sb, "'\0");
            for (i = 0; i < n; i++)
            {
                if (s[i] == (byte)39) { sq_sb_lit(sb, "''\0"); } else { sq_sb_add(sb, @s[i], 1); };
            };
            sq_sb_lit(sb, "'\0");
        };

        // counts the rows of a table, or the distinct values of the first npre key columns of an index (npre 0: all rows)
        def sq_an_count(SQ_STMT* st, SQ_TI* ti, byte* tn, int tl, SQ_IDX* ix, byte* isql, int npre, int usewhere, i64* out) -> int
        {
            SQ_SB sb;
            SQ_STMT* sub;
            int k, c;
            sq_sb_init(@sb);
            if (npre == 0) { sq_sb_lit(@sb, "select count(*) from \0"); }
            else { sq_sb_lit(@sb, "select count(*) from (select distinct \0"); };
            for (k = 0; k < npre; k++)
            {
                if (k > 0) { sq_sb_lit(@sb, ", \0"); };
                if (ix.isx[k] == 1)
                {
                    sq_sb_lit(@sb, "(\0");
                    sq_sb_add(@sb, @isql[ix.xs[k]], ix.xl[k]);
                    sq_sb_lit(@sb, ")\0");
                }
                else
                {
                    c = ix.col[k];
                    if (c >= ti.ncols) { sq_sb_lit(@sb, "rowid\0"); }
                    else { sq_sb_ident(@sb, @ti.base[ti.cs[c]], ti.cl[c]); };
                };
                if (ix.coll[k] == 1) { sq_sb_lit(@sb, " collate nocase\0"); };
                if (ix.coll[k] == 2) { sq_sb_lit(@sb, " collate rtrim\0"); };
            };
            if (npre > 0) { sq_sb_lit(@sb, " from \0"); };
            sq_sb_ident(@sb, tn, tl);
            if (usewhere == 1 & ix.wl > 0)
            {
                sq_sb_lit(@sb, " where \0");
                sq_sb_add(@sb, @isql[ix.ws], ix.wl);
            };
            if (npre > 0) { sq_sb_lit(@sb, ")\0"); };
            if (sb.err != 0) { sq_sb_free(@sb); sq_seterr(st, "out of memory\0"); return 1; };
            sub = sq_run_rows(st.db, st, sb.p);
            sq_sb_free(@sb);
            if ((u64)sub == (u64)0) { return 1; };
            out[0] = (i64)0;
            if (sub.res.n > 0) { out[0] = sub.res.d[0].i; };
            sq_stmt_del(sub);
            return 0;
        };

        // the statistics line of an index: the row count and, for every key column prefix, the average rows per value
        def sq_an_stat(SQ_STMT* st, SQ_TI* ti, byte* tn, int tl, SQ_IDX* ix, byte* isql, int ncols, SQ_SB* out, i64* nrow) -> int
        {
            i64 n, d, v;
            int k;
            if (sq_an_count(st, ti, tn, tl, ix, isql, 0, 1, @n) != 0) { return 1; };
            nrow[0] = n;
            if (n == (i64)0) { return 0; };
            sq_sb_int(out, n);
            for (k = 1; k <= ncols; k++)
            {
                if (sq_an_count(st, ti, tn, tl, ix, isql, k, 1, @d) != 0) { return 1; };
                if (d < (i64)1) { d = (i64)1; };
                v = (n + d - (i64)1) / d;
                if (v == (i64)2 & n * (i64)10 <= d * (i64)11) { v = (i64)1; };
                sq_sb_lit(out, " \0");
                sq_sb_int(out, v);
            };
            return 0;
        };

        // writes one sqlite_stat1 row
        def sq_an_put(SQ_STMT* st, byte* tn, int tl, byte* idx, int il, SQ_SB* stat) -> int
        {
            SQ_SB sb;
            int rc;
            sq_sb_init(@sb);
            sq_sb_lit(@sb, "insert into sqlite_stat1(tbl,idx,stat) values(\0");
            sq_sb_quoted(@sb, tn, tl);
            sq_sb_lit(@sb, ",\0");
            if ((u64)idx == (u64)0) { sq_sb_lit(@sb, "null\0"); } else { sq_sb_quoted(@sb, idx, il); };
            sq_sb_lit(@sb, ",\0");
            sq_sb_quoted(@sb, stat.p, stat.n);
            sq_sb_lit(@sb, ")\0");
            if (sb.err != 0) { sq_sb_free(@sb); sq_seterr(st, "out of memory\0"); return 1; };
            rc = sq_trg_stmt(st, sb.p);
            sq_sb_free(@sb);
            return rc;
        };

        // gathers the statistics of the table at schema position tp (only: an index name to restrict to)
        def sq_an_table(SQ_STMT* st, int tp, byte* only, int onlyl) -> int
        {
            SQLITE_DB* db = st.db;
            SQ_TI* ti;
            SQ_IDX* ixs;
            SQ_SB stat;
            SQ_SB del;
            byte* isql;
            byte[72] tn;
            i64 nrow;
            int n, i, tl, rc, tablecnt, ncols;
            tl = 0;
            while (db.schema[tp].name[tl] != (byte)0 & tl < 70) { tn[tl] = db.schema[tp].name[tl]; tl++; };
            tn[tl] = (byte)0;
            if (tl >= 7)
            {
                if (sq_lc(tn[0]) == (byte)115 & sq_lc(tn[1]) == (byte)113 & sq_lc(tn[2]) == (byte)108 & sq_lc(tn[3]) == (byte)105 & sq_lc(tn[4]) == (byte)116 & sq_lc(tn[5]) == (byte)101 & tn[6] == (byte)95) { return 0; };
            };
            if ((u64)db.schema[tp].sql == (u64)0) { return 0; };
            ti = (SQ_TI*)fmalloc((u64)(sizeof(SQ_TI) / 8 + 4096));
            ixs = (SQ_IDX*)fmalloc((u64)(sizeof(SQ_IDX) / 8 + 8) * (u64)24);
            if ((u64)ti == (u64)0 | (u64)ixs == (u64)0) { sq_seterr(st, "out of memory\0"); return 1; };
            if (sq_ti_load(ti, db.schema[tp].sql) != 0) { ffree((u64)ti); ffree((u64)ixs); sq_seterr(st, "cannot read table definition\0"); return 1; };
            n = sq_idx_list(db, tp, ti, ixs, 24);
            // old rows
            sq_sb_init(@del);
            sq_sb_lit(@del, "delete from sqlite_stat1 where tbl=\0");
            sq_sb_quoted(@del, @tn[0], tl);
            if ((u64)only != (u64)0)
            {
                sq_sb_lit(@del, " and idx=\0");
                sq_sb_quoted(@del, only, onlyl);
            };
            rc = sq_trg_stmt(st, del.p);
            sq_sb_free(@del);
            if (rc != 0) { ffree((u64)ti); ffree((u64)ixs); return 1; };
            tablecnt = 1;
            if ((u64)only != (u64)0) { tablecnt = 0; };
            for (i = n - 1; i >= 0 & rc == 0; i--)
            {
                if (ixs[i].wok == 0 | ixs[i].nk < 1) { continue; };
                if ((u64)only != (u64)0) { if (sq_name_is(only, onlyl, @ixs[i].name[0]) == false) { continue; }; };
                isql = (byte*)0;
                if (ixs[i].schema_pos >= 0) { isql = db.schema[ixs[i].schema_pos].sql; };
                sq_sb_init(@stat);
                ncols = ixs[i].nk;
                rc = sq_an_stat(st, ti, @tn[0], tl, @ixs[i], isql, ncols, @stat, @nrow);
                if (rc == 0 & nrow > (i64)0) { rc = sq_an_put(st, @tn[0], tl, @ixs[i].name[0], sq_cstrlen(@ixs[i].name[0]), @stat); };
                sq_sb_free(@stat);
                if (ixs[i].partial == 0) { tablecnt = 0; };
            };
            if (rc == 0 & ti.wor == 1 & (u64)only == (u64)0)
            {
                // the primary key of a WITHOUT ROWID table is analysed under the table name
                SQ_IDX pk;
                pk.nk = ti.npk; pk.ws = 0; pk.wl = 0; pk.partial = 0;
                for (i = 0; i < ti.npk; i++) { pk.col[i] = ti.pkc[i]; pk.coll[i] = ti.pkcl[i]; pk.desc[i] = ti.pkd[i]; pk.isx[i] = 0; };
                sq_sb_init(@stat);
                rc = sq_an_stat(st, ti, @tn[0], tl, @pk, (byte*)0, ti.npk, @stat, @nrow);
                if (rc == 0 & nrow > (i64)0) { rc = sq_an_put(st, @tn[0], tl, @tn[0], tl, @stat); };
                sq_sb_free(@stat);
                tablecnt = 0;
            };
            if (rc == 0 & tablecnt == 1)
            {
                SQ_IDX nix;
                nix.nk = 0; nix.wl = 0; nix.ws = 0;
                sq_sb_init(@stat);
                rc = sq_an_stat(st, ti, @tn[0], tl, @nix, (byte*)0, 0, @stat, @nrow);
                if (rc == 0 & nrow > (i64)0) { rc = sq_an_put(st, @tn[0], tl, (byte*)0, 0, @stat); };
                sq_sb_free(@stat);
            };
            ffree((u64)ti);
            ffree((u64)ixs);
            return rc;
        };

        def sq_exec_analyze(SQ_STMT* st) -> int
        {
            SQLITE_DB* db = st.db;
            byte[72] nm;
            int nl, i, root, tp, found, rc, all, hn;
            int* ho;
            all = 0;
            nl = 0;
            if (st.tk == 0 | sq_is_op(st, 59)) { all = 1; }
            else
            {
                if (sq_read_table_name(st, @nm[0], @nl) != 0) { return 1; };
                if (nl == 4 & sq_ieq(@nm[0], 4, "main\0")) { all = 1; };
                if (nl == 4 & sq_ieq(@nm[0], 4, "temp\0")) { if (sq_end_check(st) != 0) { return 1; }; return 0; };
            };
            if (sq_end_check(st) != 0) { return 1; };
            tp = 0 - 1;
            found = 0 - 1;
            if (all == 0)
            {
                tp = sq_find_table_n(db, @nm[0], nl);
                if (tp < 0)
                {
                    for (i = 0; i < db.nschema; i++)
                    {
                        if (db.schema[i].kind == 2 & sq_name_is(@nm[0], nl, @db.schema[i].name[0])) { found = i; };
                    };
                    if (found >= 0) { tp = sq_find_table_n(db, @db.schema[found].tbl_name[0], sq_cstrlen(@db.schema[found].tbl_name[0])); };
                };
                if (tp < 0) { sq_err_name(st, "no such table: \0", @nm[0], nl, "\0"); return 1; };
            };
            if (sq_find_table_n(db, "sqlite_stat1\0", 12) < 0)
            {
                root = sq_new_root(db, 13);
                if (root == 0) { sq_seterr(st, "write error\0"); return 1; };
                if (sq_master_add(db, "table\0", "sqlite_stat1\0", "sqlite_stat1\0", root, "CREATE TABLE sqlite_stat1(tbl,idx,stat)\0") != 0) { sq_seterr(st, "write error\0"); return 1; };
                if (sq_schema_load(db) < 0) { sq_seterr(st, "write error\0"); return 1; };
            };
            if (all == 1)
            {
                if (sq_trg_stmt(st, "delete from sqlite_stat1\0") != 0) { return 1; };
                ho = (int*)fmalloc((u64)(db.nschema + 2) * (u64)4);
                hn = sq_hash_order(db, ho, db.nschema + 1);
                for (i = 0; i < hn; i++)
                {
                    rc = sq_an_table(st, ho[i], (byte*)0, 0);
                    if (rc != 0) { ffree((u64)ho); return 1; };
                };
                ffree((u64)ho);
                return 0;
            };
            if (found >= 0) { return sq_an_table(st, tp, @db.schema[found].name[0], sq_cstrlen(@db.schema[found].name[0])); };
            return sq_an_table(st, tp, (byte*)0, 0);
        };

        // ---- VACUUM ----

        // runs one statement on another database (the vacuum copy) and refreshes that database's schema
        def sq_vac_run(SQLITE_DB* d2, SQ_STMT* st, byte* text) -> int
        {
            SQ_STMT* sub;
            int rc;
            sub = sq_stmt_new();
            if ((u64)sub == (u64)0) { sq_seterr(st, "out of memory\0"); return 1; };
            sq_stmt_init(sub, d2, text);
            sub.pad = 0; sub.ret_s = 0 - 1; sub.ret_e = 0 - 1; sub.wp_s = 0; sub.wp_e = 0;
            sq_next(sub);
            rc = sq_dispatch(sub);
            if (rc != 0) { sq_seterr(st, sub.err); };
            sq_stmt_del(sub);
            if (rc == 0) { if (sq_schema_load(d2) < 0) { sq_seterr(st, "write error\0"); return 1; }; };
            return rc;
        };

        // copies the rows of one table (the primary key tree for WITHOUT ROWID) in bulk, keeping rowids
        def sq_vac_rows(SQ_STMT* st, SQ_STMT* st2, SQ_TCTX* ta, SQ_TCTX* tb) -> int
        {
            SQ_CURSOR cur;
            SQ_ICUR ic;
            SQ_ARENA ar;
            SQ_VAL* vals;
            int rc, ok, snix;
            vals = (SQ_VAL*)fmalloc((u64)(ta.ncols + 2) * (u64)sizeof(SQ_VAL));
            if ((u64)vals == (u64)0) { sq_seterr(st, "out of memory\0"); return 1; };
            sq_ar_init(@ar);
            rc = 0;
            snix = tb.nix;
            tb.nix = 0;
            SQ_BULK = 1;
            if (ta.wor == 1)
            {
                sq_cur_open(@cur, st.db, ta.root);
                sq_icur_open(@ic, st.db, @ta.wix);
                ok = sq_icur_first(@ic);
                while (ok == 1)
                {
                    sq_ar_reset(@ar);
                    if (sq_wor_load_entry(@cur, @ic) != 0) { rc = 1; break; };
                    sq_tc_row(ta, @cur, @ar, vals);
                    if (sq_tc_put(tb, (i64)0, vals) != 0) { sq_seterr(st, st2.err); rc = 1; break; };
                    ok = sq_icur_next(@ic);
                };
                if (ok < 0) { rc = 1; };
                sq_icur_close(@ic);
                sq_cur_close(@cur);
            }
            else
            {
                sq_cur_open(@cur, st.db, ta.root);
                ok = sq_cur_first(@cur);
                while (ok == 1)
                {
                    sq_ar_reset(@ar);
                    sq_tc_row(ta, @cur, @ar, vals);
                    if (sq_tc_put(tb, cur.rowid, vals) != 0) { sq_seterr(st, st2.err); rc = 1; break; };
                    ok = sq_cur_next(@cur);
                };
                if (ok < 0) { rc = 1; };
                sq_cur_close(@cur);
            };
            SQ_BULK = 0;
            tb.nix = snix;
            sq_ar_free(@ar);
            ffree((u64)vals);
            return rc;
        };

        // one class of indexes of the new table, filled from the source table (SQLite xfer order:
        // explicit indexes newest first, then the automatic ones in creation order)
        def sq_vac_ixs(SQ_STMT* st, SQ_STMT* st2, SQ_TCTX* ta, SQ_TCTX* tb, int autos) -> int
        {
            int i, isauto, k_, i_rc;
            for (i = 0; i < tb.nix; i++)
            {
                if (autos == 1) { k_ = i; } else { k_ = tb.nix - 1 - i; };
                isauto = 0;
                if (tb.ix[k_].name[0] == (byte)115 & tb.ix[k_].name[7] == (byte)97 & tb.ix[k_].name[8] == (byte)117) { isauto = 1; };
                if (isauto != autos) { continue; };
                SQ_BULK = 1;
                i_rc = sq_tc_rebuild_src(tb, @tb.ix[k_], st.db, ta.root);
                SQ_BULK = 0;
                if (i_rc != 0) { sq_seterr(st, st2.err); return 1; };
            };
            return 0;
        };

        def sq_vac_copy(SQ_STMT* st, SQ_STMT* st2, byte* name, int nl) -> int
        {
            SQ_TCTX* ta;
            SQ_TCTX* tb;
            int rc;
            ta = (SQ_TCTX*)fmalloc((u64)(sizeof(SQ_TCTX) / 8 + 4096));
            tb = (SQ_TCTX*)fmalloc((u64)(sizeof(SQ_TCTX) / 8 + 4096));
            if ((u64)ta == (u64)0 | (u64)tb == (u64)0) { sq_seterr(st, "out of memory\0"); return 1; };
            if (sq_tc_open(st.db, st, name, nl, ta) != 0) { return 1; };
            if (sq_tc_open(st2.db, st2, name, nl, tb) != 0) { sq_seterr(st, st2.err); return 1; };
            rc = 0;
            if (ta.wor == 0) { rc = sq_vac_rows(st, st2, ta, tb); };
            if (rc == 0) { rc = sq_vac_ixs(st, st2, ta, tb, 0); };
            if (rc == 0) { if (ta.wor == 1) { rc = sq_vac_rows(st, st2, ta, tb); }; };
            if (rc == 0) { rc = sq_vac_ixs(st, st2, ta, tb, 1); };
            sq_tc_free(ta); sq_tc_free(tb);
            ffree((u64)ta); ffree((u64)tb);
            if (rc != 0 & st.err[0] == (byte)0) { sq_seterr(st, "write error\0"); };
            return rc;
        };

        def sq_vac_pass(SQ_STMT* st, SQ_STMT* st2, int kinds) -> int
        {
            SQLITE_DB* db = st.db;
            SQLITE_DB* d2 = st2.db;
            int i, k, nl, nm;
            for (i = 0; i < db.nschema; i++)
            {
                k = db.schema[i].kind;
                if ((u64)db.schema[i].sql == (u64)0) { continue; };
                if (kinds == 1)
                {
                    if (k != 1) { continue; };
                    if (sq_streq(@db.schema[i].name[0], "sqlite_sequence\0")) { continue; };
                    if (sq_ihas(db.schema[i].sql, 14, "create virtual\0")) { sq_seterr(st, "virtual tables are not supported\0"); return 1; };
                    if (sq_streq(@db.schema[i].name[0], "sqlite_stat1\0"))
                    {
                        nm = sq_new_root(d2, 13);
                        if (sq_master_add(d2, "table\0", "sqlite_stat1\0", "sqlite_stat1\0", nm, db.schema[i].sql) != 0) { sq_seterr(st, "write error\0"); return 1; };
                        if (sq_schema_load(d2) < 0) { return 1; };
                        continue;
                    };
                };
                if (kinds == 2) { if (k != 2) { continue; }; };
                if (kinds == 3) { if (k != 3 & k != 4) { continue; }; };
                if (sq_vac_run(d2, st, db.schema[i].sql) != 0) { return 1; };
            };
            return 0;
        };

        def sq_exec_vacuum_body(SQ_STMT* st, byte* outp) -> int
        {
            SQLITE_DB* db = st.db;
            SQLITE_DB* d2;
            SQ_STMT* st2;
            byte[340] p2;
            byte* pg;
            byte* h1;
            byte* hb;
            byte[8] z;
            int i, n, nl, rc, oldn, newn, cookie;
            void* f;
            if (db.rw == 0) { sq_seterr(st, "attempt to write a readonly database\0"); return 1; };
            n = 0;
            while (db.path[n] != (byte)0 & n < 310) { p2[n] = db.path[n]; n++; };
            byte* sfx = "-vacuum\0";
            for (i = 0; sfx[i] != (byte)0; i++) { p2[n + i] = sfx[i]; };
            p2[n + i] = (byte)0;
            if ((u64)outp != (u64)0)
            {
                for (i = 0; outp[i] != (byte)0; i++) { p2[i] = outp[i]; };
                p2[i] = (byte)0;
            }
            else { remove(@p2[0]); };
            if (sq_create_file(@p2[0], db.page_size) != 0) { sq_seterr(st, "unable to open database file\0"); return 1; };
            // the copy keeps the text encoding of the original
            pg = sq_page(db, 1);
            if ((u64)pg == (u64)0) { remove(@p2[0]); return 1; };
            f = fopen(@p2[0], "r+b\0");
            if ((u64)f != (u64)0)
            {
                fseek(f, 56, 0);
                fwrite(@pg[56], 1, 4, f);
                fclose(f);
            };
            d2 = (SQLITE_DB*)fmalloc((u64)(sizeof(SQLITE_DB) / 8 + 4096));
            if ((u64)d2 == (u64)0) { remove(@p2[0]); sq_seterr(st, "out of memory\0"); return 1; };
            if (sq_open_rw(d2, @p2[0], 0) != 0) { ffree((u64)d2); remove(@p2[0]); sq_seterr(st, "unable to open database file\0"); return 1; };
            if (sq_schema_load(d2) < 0) { sq_close(d2); ffree((u64)d2); remove(@p2[0]); return 1; };
            st2 = sq_stmt_new();
            sq_stmt_init(st2, d2, "\0");
            rc = 0;
            if (sq_txn_begin(d2, 1) != 0) { rc = 1; sq_seterr(st, "cannot begin transaction\0"); };
            if (rc == 0) { rc = sq_vac_pass(st, st2, 1); };
            if (rc == 0) { rc = sq_vac_pass(st, st2, 2); };
            if (rc == 0)
            {
                for (i = 0; i < db.nschema; i++)
                {
                    if (db.schema[i].kind != 1 | (u64)db.schema[i].sql == (u64)0) { continue; };
                    nl = 0;
                    while (db.schema[i].name[nl] != (byte)0) { nl++; };
                    if (sq_vac_copy(st, st2, @db.schema[i].name[0], nl) != 0) { rc = 1; break; };
                };
            };
            if (rc == 0) { rc = sq_vac_pass(st, st2, 3); };
            if (rc == 0) { if (sq_txn_commit(d2) != 0) { rc = 1; sq_seterr(st, "write error\0"); }; };
            if (rc != 0) { if (d2.in_txn == 1) { sq_txn_rollback(d2); }; };
            newn = d2.npages;
            oldn = db.npages;
            if ((u64)outp != (u64)0)
            {
                sq_stmt_del(st2);
                sq_close(d2);
                ffree((u64)d2);
                if (rc != 0) { remove(@p2[0]); if (st.err[0] == (byte)0) { sq_seterr(st, "write error\0"); }; };
                return rc;
            };
            if (rc == 0)
            {
                cookie = db.cookie;
                // pages that disappear are journaled first so a crash before the commit restores them
                for (i = newn + 1; i <= oldn; i++) { if (sq_before_write(db, i) != 0) { rc = 1; break; }; };
            };
            if (rc == 0)
            {
                if (newn > db.npages) { db.npages = newn; };
                h1 = (byte*)fmalloc((u64)(db.page_size + 8));
                for (i = 1; i <= newn; i++)
                {
                    hb = sq_page(d2, i);
                    if ((u64)hb == (u64)0) { rc = 1; break; };
                    for (n = 0; n < db.page_size; n++) { h1[n] = hb[n]; };
                    if (i == 1)
                    {
                        // keep the settings of the original that VACUUM does not touch
                        pg = sq_page(db, 1);
                        if ((u64)pg == (u64)0) { rc = 1; break; };
                        h1[18] = pg[18]; h1[19] = pg[19];
                        for (n = 44; n < 48; n++) { h1[n] = pg[n]; };
                        for (n = 48; n < 52; n++) { h1[n] = pg[n]; };
                        for (n = 60; n < 64; n++) { h1[n] = pg[n]; };
                        for (n = 68; n < 72; n++) { h1[n] = pg[n]; };
                    };
                    if (sq_page_write(db, i, h1) != 0) { rc = 1; break; };
                };
                ffree((u64)h1);
                if (rc == 0)
                {
                    db.npages = newn;
                    db.ftrunk = d2.ftrunk;
                    db.fcount = d2.fcount;
                    db.cookie = cookie + 1;
                    sq_cache_clear(db);
                };
            };
            sq_stmt_del(st2);
            sq_close(d2);
            ffree((u64)d2);
            remove(@p2[0]);
            n = 0;
            while (p2[n] != (byte)0) { n++; };
            p2[n] = (byte)45; p2[n + 1] = (byte)106; p2[n + 2] = (byte)111; p2[n + 3] = (byte)117; p2[n + 4] = (byte)114; p2[n + 5] = (byte)110; p2[n + 6] = (byte)97; p2[n + 7] = (byte)108; p2[n + 8] = (byte)0;
            remove(@p2[0]);
            if (rc != 0 & st.err[0] == (byte)0) { sq_seterr(st, "write error\0"); };
            return rc;
        };

        // VACUUM [schema-name] : rebuilds the database into a compact file. Not allowed inside a transaction.
        // truncate(2) by raw system call (no library call); returns 0 on success, 1 when unavailable or failed
        def sq_os_truncate(byte* path, i64 len) -> int
        {
            i64 res;
            res = (i64)(0 - 1);
#ifdef __LINUX__
#ifdef __ARCH_X86_64__
            volatile asm
            {
                movq $$76, %rax
                movq $1, %rdi
                movq $2, %rsi
                syscall
                movq %rax, $0
            } : "=r"(res) : "r"(path), "r"(len)
              : "rax","rdi","rsi","rcx","r11","memory";
#endif;
#ifdef __ARCH_ARM64__
            volatile asm
            {
                mov x8, #45
                mov x0, $1
                mov x1, $2
                svc #0
                mov $0, x0
            } : "=r"(res) : "r"(path), "r"(len)
              : "x0","x1","x8","memory";
#endif;
#endif;
            if (res == (i64)0) { return 0; };
            return 1;
        };

        // Cuts the database file back to npages pages after an in-place VACUUM. Without a truncate call the
        // first npages pages are saved to a side file, the database file is reopened empty and the pages are
        // written back, then the side file is removed.
        def sq_shrink_file(SQLITE_DB* db, int npages) -> int
        {
            void* src;
            void* dst;
            byte* buf;
            byte[340] tp;
            long total, want, left;
            int n, i, got, pass;
            if (db.wal != 0) { return 0; };
            want = (long)npages * (long)db.page_size;
            fflush(db.fp);
            src = fopen(@db.path[0], "rb\0");
            if ((u64)src == (u64)0) { return 1; };
            fseek(src, 0, 2);
            total = ftell(src);
            fclose(src);
            if (total <= want) { return 0; };
            if (sq_os_truncate(@db.path[0], (i64)want) == 0)
            {
                fseek(db.fp, 0, 0);
                sq_cache_clear(db);
                return 0;
            };
            n = 0;
            while (db.path[n] != (byte)0 & n < 320) { tp[n] = db.path[n]; n++; };
            byte* sfx = "-shrink\0";
            for (i = 0; sfx[i] != (byte)0; i++) { tp[n + i] = sfx[i]; };
            tp[n + i] = (byte)0;
            buf = (byte*)fmalloc((u64)65536);
            if ((u64)buf == (u64)0) { return 1; };
            for (pass = 0; pass < 2; pass++)
            {
                if (pass == 0) { src = fopen(@db.path[0], "rb\0"); dst = fopen(@tp[0], "wb\0"); }
                else { src = fopen(@tp[0], "rb\0"); dst = fopen(@db.path[0], "wb\0"); };
                if ((u64)src == (u64)0 | (u64)dst == (u64)0)
                {
                    if ((u64)src != (u64)0) { fclose(src); };
                    if ((u64)dst != (u64)0) { fclose(dst); };
                    ffree((u64)buf);
                    return 1;
                };
                left = want;
                while (left > (long)0)
                {
                    got = 65536;
                    if (left < (long)got) { got = (int)left; };
                    got = (int)fread(buf, 1, (u64)got, src);
                    if (got <= 0) { break; };
                    fwrite(buf, 1, (u64)got, dst);
                    left = left - (long)got;
                };
                fflush(dst);
                fclose(src);
                fclose(dst);
                if (left > (long)0) { ffree((u64)buf); return 1; };
            };
            ffree((u64)buf);
            remove(@tp[0]);
            fseek(db.fp, 0, 0);
            sq_cache_clear(db);
            return 0;
        };

        def sq_exec_vacuum(SQ_STMT* st) -> int
        {
            SQLITE_DB* db = st.db;
            int rc, i;
            byte[320] outb;
            byte* outp;
            void* f;
            outp = (byte*)0;
            if (db.in_txn == 1) { sq_seterr(st, "cannot VACUUM from within a transaction\0"); return 1; };
            if (st.tk == 1 & sq_is_kw(st, "into\0") == false)
            {
                if (sq_ieq(@st.sql[sq_tok_start(st)], st.tend - sq_tok_start(st), "main\0") == false) { sq_seterr(st, "unknown database \0"); return 1; };
                sq_next(st);
            };
            if (sq_is_kw(st, "into\0"))
            {
                sq_next(st);
                if (st.tk != 4 | st.tl > 300) { sq_seterr(st, "syntax error\0"); return 1; };
                for (i = 0; i < st.tl; i++) { outb[i] = st.sql[st.ts + i]; };
                outb[st.tl] = (byte)0;
                sq_next(st);
                outp = @outb[0];
                f = fopen(outp, "rb\0");
                if ((u64)f != (u64)0) { fclose(f); sq_seterr(st, "output file already exists\0"); return 1; };
            };
            if (sq_end_check(st) != 0) { return 1; };
            if (sq_txn_begin(db, 0) != 0) { sq_seterr(st, "cannot begin transaction\0"); return 1; };
            rc = sq_exec_vacuum_body(st, outp);
            if (rc == 0)
            {
                if (sq_txn_commit(db) != 0) { sq_txn_rollback(db); sq_seterr(st, "write error\0"); rc = 1; }
                else
                {
                    if ((u64)outp == (u64)0)
                    {
                        if (sq_shrink_file(db, db.npages) != 0) { sq_seterr(st, "write error\0"); rc = 1; };
                    };
                };
            }
            else { sq_txn_rollback(db); };
            sq_schema_load(db);
            return rc;
        };

        // ---- EXPLAIN QUERY PLAN ----
        // The plan is derived from the same rules SQLite applies when it has no statistics: equality and range terms on the
        // rowid or on the leading columns of an index, covering indexes, automatic indexes for joins, and temporary b-trees
        // for ORDER BY, GROUP BY and DISTINCT. The id and notused columns are numbered here; SQLite uses program addresses.

        struct SQ_EQT
        {
            int src, col, kind, mask;
        };

        struct SQ_EQP
        {
            int kind, ix, neq, lo, hi, cov, nord, rid, ridq;
            double rows, cost, setup;
        };

        struct SQ_EQC
        {
            SQ_STMT* g;
            SQ_BLK* b;
            int bi, nt, nsrc;
            SQ_EQT[96] t;
            byte[1100] need;
            int[8] nix;
            SQ_IDX[96] ixs;
            int[8] ord;
            int[8] bestk;
            double[8] cst;
        };

        global int SQ_EQN = 0;

        def sq_eqp_mask(SQ_STMT* st, int ni) -> int
        {
            SQ_NODE* nd;
            int m, c;
            if (ni < 0) { return 0; };
            nd = @st.nodes[ni];
            m = 0;
            if (nd.kind == SQN_COL)
            {
                if (nd.lvl == 0 & nd.src >= 0 & nd.src < 30) { return 1 << nd.src; };
                return 0;
            };
            if (nd.kind == SQN_SUBQ | nd.kind == SQN_EXISTS | (nd.kind == SQN_IN & nd.blk >= 0))
            {
                if (nd.blk >= 0) { if (st.blks[nd.blk].is_corr == 1) { return 0 - 1; }; };
            };
            c = nd.a;
            while (c >= 0) { m = m | sq_eqp_mask(st, c); c = st.nodes[c].next; };
            c = nd.b;
            while (c >= 0) { m = m | sq_eqp_mask(st, c); c = st.nodes[c].next; };
            c = nd.c;
            while (c >= 0) { m = m | sq_eqp_mask(st, c); c = st.nodes[c].next; };
            return m;
        };

        def sq_eqp_addt(SQ_EQC* c, int src, int col, int kind, int mask) -> void
        {
            if (c.nt >= 96) { return; };
            c.t[c.nt].src = src; c.t[c.nt].col = col; c.t[c.nt].kind = kind; c.t[c.nt].mask = mask;
            c.nt++;
        };

        def sq_eqp_isc(SQ_STMT* st, int ni, int bi) -> bool
        {
            SQ_NODE* nd;
            if (ni < 0) { return false; };
            nd = @st.nodes[ni];
            if (nd.kind != SQN_COL) { return false; };
            if (nd.lvl != 0) { return false; };
            return true;
        };

        // the constant prefix of a GLOB pattern that an index range can serve: returns its length (0 when none)
        // cplt is set when the pattern is the prefix followed by one trailing star, so the range alone decides the match
        def sq_eqp_globpfx(SQ_STMT* st, int ni, byte* buf, int* cplt) -> int
        {
            SQ_NODE* nd;
            SQ_NODE* p;
            byte[260] tmp;
            int n, k, w;
            cplt[0] = 0;
            if (ni < 0) { return 0; };
            nd = @st.nodes[ni];
            if (nd.kind != SQN_LIKE) { return 0; };
            if (nd.iv != (i64)1 | nd.op != 1 | nd.c >= 0) { return 0; };
            p = @st.nodes[nd.b];
            if (p.kind != SQN_STR) { return 0; };
            n = 0; k = 0;
            while (k < p.sl)
            {
                if (n >= 250) { return 0; };
                tmp[n] = st.sql[p.s + k];
                if (k + 1 < p.sl & st.sql[p.s + k] == (byte)39 & st.sql[p.s + k + 1] == (byte)39) { k++; };
                k++;
                n++;
            };
            w = 0;
            while (w < n & tmp[w] != (byte)42 & tmp[w] != (byte)63 & tmp[w] != (byte)91) { w++; };
            if (w == 0) { return 0; };
            if (tmp[w - 1] == (byte)255) { return 0; };
            for (k = 0; k < w; k++) { buf[k] = tmp[k]; };
            if (w == n - 1 & tmp[w] == (byte)42) { cplt[0] = 1; };
            return w;
        };

        // records the usable terms of one conjunct
        // true when a comparison between column x and the expression y may drive an index on x: the comparison affinity must not
        // convert the values of an index column that has no numeric affinity (sqlite3IndexAffinityOk)
        def sq_eqp_affok(SQ_EQC* c, int xn, int yn) -> bool
        {
            SQ_STMT* st = c.g;
            SQ_NODE* x = @st.nodes[xn];
            SQ_NODE* y = @st.nodes[yn];
            SQ_TI* xt;
            SQ_TI* yt;
            int ax, ay;
            if (y.kind != SQN_COL) { return true; };
            if (y.lvl != 0 | x.lvl != 0) { return true; };
            xt = c.b.src[x.src].ti; yt = c.b.src[y.src].ti;
            if ((u64)xt == (u64)0 | (u64)yt == (u64)0) { return true; };
            if (x.col < 0 | y.col < 0) { return true; };
            if (x.col >= xt.ncols | x.col == xt.ipk) { return true; };
            ax = xt.aff[x.col];
            if (y.col >= yt.ncols | y.col == yt.ipk) { ay = 3; } else { ay = yt.aff[y.col]; };
            if (ax >= 2) { return true; };
            if (ay >= 2) { return false; };
            return true;
        };

        def sq_eqp_term(SQ_EQC* c, int ni) -> void
        {
            SQ_STMT* st = c.g;
            SQ_NODE* nd;
            SQ_NODE* na;
            SQ_NODE* nb;
            SQ_NODE* nx;
            int op, k, ma, mb, e1, e2;
            if (ni < 0) { return; };
            nd = @st.nodes[ni];
            if (nd.kind == SQN_BIN & nd.op == SQO_AND)
            {
                sq_eqp_term(c, nd.a);
                sq_eqp_term(c, nd.b);
                return;
            };
            if (nd.kind == SQN_BIN & nd.op == SQO_OR)
            {
                // col = x OR col = y on one column behaves like IN
                e1 = nd.a; e2 = nd.b;
                if (st.nodes[e1].kind == SQN_BIN & st.nodes[e2].kind == SQN_BIN)
                {
                    if (st.nodes[e1].op == SQO_EQ & st.nodes[e2].op == SQO_EQ)
                    {
                        na = @st.nodes[st.nodes[e1].a];
                        nb = @st.nodes[st.nodes[e2].a];
                        if (na.kind == SQN_COL & nb.kind == SQN_COL)
                        {
                            if (na.lvl == 0 & nb.lvl == 0 & na.src == nb.src & na.col == nb.col)
                            {
                                if (sq_eqp_mask(st, st.nodes[e1].b) == 0 & sq_eqp_mask(st, st.nodes[e2].b) == 0)
                                {
                                    sq_eqp_addt(c, na.src, na.col, 5, 0);
                                };
                            };
                        };
                    };
                };
                return;
            };
            if (nd.kind == SQN_IN)
            {
                if (sq_eqp_isc(st, nd.a, c.bi) & nd.op == 1)
                {
                    na = @st.nodes[nd.a];
                    ma = 0;
                    if (nd.blk < 0) { ma = sq_eqp_mask(st, nd.b); };
                    if (((ma >> na.src) `& 1) == 0)
                    {
                        // the IN list made from an OR of rowid equalities is planned as one rowid lookup
                        k = 5;
                        if (nd.agg == 9 & na.col == c.b.src[na.src].ti.ipk) { k = 1; };
                        sq_eqp_addt(c, na.src, na.col, k, 0);
                    };
                };
                return;
            };
            if (nd.kind == SQN_ISNULL)
            {
                if (sq_eqp_isc(st, nd.a, c.bi) & nd.op == 1)
                {
                    na = @st.nodes[nd.a];
                    sq_eqp_addt(c, na.src, na.col, 1, 0);
                };
                return;
            };
            if (nd.kind == SQN_BETWEEN)
            {
                if (sq_eqp_isc(st, nd.a, c.bi) & nd.op == 1)
                {
                    na = @st.nodes[nd.a];
                    sq_eqp_addt(c, na.src, na.col, 2, sq_eqp_mask(st, nd.b));
                    sq_eqp_addt(c, na.src, na.col, 3, sq_eqp_mask(st, nd.c));
                };
                return;
            };
            if (nd.kind == SQN_LIKE)
            {
                byte[260] gb;
                int gc;
                if (sq_eqp_isc(st, nd.a, c.bi) == false) { return; };
                na = @st.nodes[nd.a];
                if (na.col < 0 | na.col >= c.b.src[na.src].ti.ncols) { return; };
                if (na.col == c.b.src[na.src].ti.ipk) { return; };
                if (c.b.src[na.src].ti.coll[na.col] != 0 | c.b.src[na.src].ti.aff[na.col] > 1) { return; };
                if (sq_eqp_globpfx(st, ni, @gb[0], @gc) == 0) { return; };
                sq_eqp_addt(c, na.src, na.col, 2, 0);
                sq_eqp_addt(c, na.src, na.col, 3, 0);
                return;
            };
            if (nd.kind != SQN_BIN) { return; };
            op = nd.op;
            if (op != SQO_EQ & op != SQO_IS & op != SQO_LT & op != SQO_LE & op != SQO_GT & op != SQO_GE) { return; };
            ma = sq_eqp_mask(st, nd.a);
            mb = sq_eqp_mask(st, nd.b);
            if (sq_eqp_isc(st, nd.a, c.bi))
            {
                na = @st.nodes[nd.a];
                k = 1;
                if (op == SQO_GT | op == SQO_GE) { k = 2; };
                if (op == SQO_LT | op == SQO_LE) { k = 3; };
                if (((mb >> na.src) `& 1) == 0 & sq_eqp_affok(c, nd.a, nd.b)) { sq_eqp_addt(c, na.src, na.col, k, mb); };
            };
            if (sq_eqp_isc(st, nd.b, c.bi))
            {
                nb = @st.nodes[nd.b];
                k = 1;
                if (op == SQO_GT | op == SQO_GE) { k = 3; };
                if (op == SQO_LT | op == SQO_LE) { k = 2; };
                if (((ma >> nb.src) `& 1) == 0 & sq_eqp_affok(c, nd.b, nd.a)) { sq_eqp_addt(c, nb.src, nb.col, k, ma); };
            };
        };


        global int SQ_EQO_B = 0;
        global int SQ_EQO_J = 0;

        // terms of the enclosing block that constrain the columns of a flattened subquery
        def sq_eqp_push(SQ_EQC* c, int ni, int ob, int oj) -> void
        {
            SQ_STMT* st = c.g;
            SQ_NODE* nd;
            SQ_NODE* na;
            SQ_NODE* nin;
            int op, k, side, other, cc, mk;
            if (ni < 0) { return; };
            nd = @st.nodes[ni];
            if (nd.kind == SQN_BIN & nd.op == SQO_AND)
            {
                sq_eqp_push(c, nd.a, ob, oj);
                sq_eqp_push(c, nd.b, ob, oj);
                return;
            };
            if (nd.kind == SQN_BIN)
            {
                op = nd.op;
                if (op != SQO_EQ & op != SQO_IS & op != SQO_LT & op != SQO_LE & op != SQO_GT & op != SQO_GE) { return; };
                for (side = 0; side < 2; side++)
                {
                    if (side == 0) { cc = nd.a; other = nd.b; } else { cc = nd.b; other = nd.a; };
                    if (cc < 0 | other < 0) { continue; };
                    na = @st.nodes[cc];
                    if (na.kind != SQN_COL) { continue; };
                    if (na.lvl != 0 | na.owner != ob | na.src != oj) { continue; };
                    if (sq_eqp_mask(st, other) != 0) { continue; };
                    if (na.col < 0 | na.col >= c.b.nres) { continue; };
                    nin = @st.nodes[c.b.rc[na.col]];
                    if (nin.kind != SQN_COL | nin.lvl != 0) { continue; };
                    k = 1;
                    if (side == 0) { if (op == SQO_GT | op == SQO_GE) { k = 2; }; if (op == SQO_LT | op == SQO_LE) { k = 3; }; }
                    else { if (op == SQO_GT | op == SQO_GE) { k = 3; }; if (op == SQO_LT | op == SQO_LE) { k = 2; }; };
                    sq_eqp_addt(c, nin.src, nin.col, k, 0);
                };
                return;
            };
            if (nd.kind == SQN_IN | nd.kind == SQN_BETWEEN)
            {
                if (nd.op != 1) { return; };
                if (nd.a < 0) { return; };
                na = @st.nodes[nd.a];
                if (na.kind != SQN_COL) { return; };
                if (na.lvl != 0 | na.owner != ob | na.src != oj) { return; };
                if (na.col < 0 | na.col >= c.b.nres) { return; };
                nin = @st.nodes[c.b.rc[na.col]];
                if (nin.kind != SQN_COL | nin.lvl != 0) { return; };
                if (nd.kind == SQN_IN)
                {
                    mk = 0;
                    if (nd.blk < 0) { mk = sq_eqp_mask(st, nd.b); };
                    if (mk == 0) { sq_eqp_addt(c, nin.src, nin.col, 5, 0); };
                }
                else
                {
                    if (sq_eqp_mask(st, nd.b) == 0 & sq_eqp_mask(st, nd.c) == 0)
                    {
                        sq_eqp_addt(c, nin.src, nin.col, 2, 0);
                        sq_eqp_addt(c, nin.src, nin.col, 3, 0);
                    };
                };
            };
        };

        // marks the columns of each source the block reads
        def sq_eqp_need(SQ_EQC* c) -> void
        {
            SQ_STMT* st = c.g;
            SQ_NODE* nd;
            int i;
            for (i = 0; i < 1100; i++) { c.need[i] = (byte)0; };
            for (i = 0; i < st.nn; i++)
            {
                nd = @st.nodes[i];
                if (nd.kind != SQN_COL) { continue; };
                if (nd.lvl == 0) { if (nd.owner != c.bi) { continue; }; } else { if (nd.rblk != c.bi) { continue; }; };
                if (nd.src < 0 | nd.src >= 8) { continue; };
                if (nd.col < 0 | nd.col >= 130) { continue; };
                c.need[nd.src * 130 + nd.col] = (byte)1;
            };
        };

        def sq_eqp_cname(SQ_STMT* st, SQ_TI* ti, int col, SQ_SB* o) -> void
        {
            if (col >= ti.ncols) { sq_sb_lit(o, "rowid\0"); return; };
            sq_sb_add(o, @ti.base[ti.cs[col]], ti.cl[col]);
        };

        // the best way to reach rows of source j once the sources in avail are bound
        def sq_eqp_plan(SQ_EQC* c, int j, int avail, SQ_EQP* out) -> void
        {
            SQ_STMT* st = c.g;
            SQ_BLK* b = c.b;
            SQ_SRC* sr = @b.src[j];
            SQ_TI* ti;
            SQ_IDX* ix;
            SQ_EQP cand;
            int[132] eq;
            int[132] lo;
            int[132] hi;
            int i, k, n, nc, m, neq, rlo, rhi, cv, col, t, allu, ncol2, ridf, ridq;
            double rows, cost;
            out.rid = 0; out.ridq = 0; out.kind = 0; out.ix = 0 - 1; out.neq = 0; out.lo = 0; out.hi = 0; out.cov = 0; out.rows = 1000000.0; out.cost = 1000000.0; out.setup = 0.0;
            if (sr.kind != 1 | (u64)sr.ti == (u64)0) { return; };
            ti = sr.ti;
            nc = ti.ncols;
            for (i = 0; i < 132; i++) { eq[i] = 0; lo[i] = 0; hi[i] = 0; };
            for (i = 0; i < c.nt; i++)
            {
                if (c.t[i].src != j) { continue; };
                if ((c.t[i].mask `& (0 - 1 - avail)) != 0) { continue; };
                if (((c.t[i].mask >> j) `& 1) == 1) { continue; };
                col = c.t[i].col;
                if (col < 0 | col > nc) { continue; };
                if (c.t[i].kind == 1) { eq[col] = 1; };
                if (c.t[i].kind == 5) { if (eq[col] == 0) { eq[col] = 2; }; };
                if (c.t[i].kind == 2) { lo[col] = 1; };
                if (c.t[i].kind == 3) { hi[col] = 1; };
            };
            if (ti.ipk >= 0)
            {
                if (eq[ti.ipk] > 0) { eq[nc] = 1; if (eq[ti.ipk] == 2) { eq[nc] = 2; }; };
                if (lo[ti.ipk] == 1) { lo[nc] = 1; };
                if (hi[ti.ipk] == 1) { hi[nc] = 1; };
            };
            if (ti.wor == 0)
            {
                if (eq[nc] == 1)
                {
                    out.kind = 1; out.rows = 1.0; out.cost = 25.0; out.neq = 1;
                    return;
                };
                if (eq[nc] == 2)
                {
                    // an IN list on the rowid: one probe per value, a little dearer than a covering index probe
                    out.kind = 1; out.rows = 3.0; out.cost = 29.5; out.neq = 1;
                };
                if (lo[nc] == 1 | hi[nc] == 1)
                {
                    out.kind = 1; out.lo = lo[nc]; out.hi = hi[nc];
                    out.rows = 250000.0; if (lo[nc] == 1 & hi[nc] == 1) { out.rows = 15625.0; };
                    out.cost = 25.0 + out.rows;
                };
            };
            // WITHOUT ROWID primary key
            if (ti.wor == 1)
            {
                neq = 0;
                while (neq < ti.npk)
                {
                    if (eq[ti.pkc[neq]] > 0) { neq++; } else { break; };
                };
                rlo = 0; rhi = 0;
                if (neq < ti.npk) { rlo = lo[ti.pkc[neq]]; rhi = hi[ti.pkc[neq]]; };
                if (neq > 0 | rlo == 1 | rhi == 1)
                {
                    rows = 1000000.0;
                    if (neq == ti.npk) { rows = 1.0; }
                    else
                    {
                        if (neq == 1) { rows = 10.0; };
                        if (neq == 2) { rows = 5.0; };
                        if (neq >= 3) { rows = 3.0; };
                        if (neq == 0) { rows = 1000000.0; };
                    };
                    if (rlo == 1) { rows = rows / 4.0; };
                    if (rhi == 1) { rows = rows / 4.0; };
                    cost = 25.0 + rows;
                    if (cost < out.cost)
                    {
                        out.kind = 3; out.neq = neq; out.lo = rlo; out.hi = rhi; out.rows = rows; out.cost = cost; out.ix = 0 - 1;
                    };
                };
            };
            n = c.nix[j];
            if (sr.idxby == 2) { n = 0; };
            for (k = 0; k < n; k++)
            {
                ix = @c.ixs[j * 12 + k];
                if (sr.idxby == 1)
                {
                    // INDEXED BY: only the named index may be used
                    ncol2 = 0;
                    while (ix.name[ncol2] != (byte)0) { ncol2++; };
                    allu = 0;
                    if (ncol2 == sr.ixs_l)
                    {
                        allu = 1;
                        for (i = 0; i < ncol2; i++) { if (sq_lc(ix.name[i]) != sq_lc(st.sql[sr.ixs_s + i])) { allu = 0; }; };
                    };
                    if (allu == 0) { continue; };
                };
                if (ix.partial != 0) { continue; };
                allu = 1;
                for (i = 0; i < ix.nk; i++) { if (ix.isx[i] != 0) { allu = 0; }; };
                if (allu == 0) { continue; };
                neq = 0;
                while (neq < ix.nk)
                {
                    if (eq[ix.col[neq]] > 0) { neq++; } else { break; };
                };
                rlo = 0; rhi = 0; ridf = 0; ridq = 0;
                if (neq < ix.nk) { rlo = lo[ix.col[neq]]; rhi = hi[ix.col[neq]]; }
                else
                {
                    if (ti.wor == 0 & neq > 0) { rlo = lo[nc]; rhi = hi[nc]; ridf = 1; };
                    if (ti.wor == 0 & neq > 0 & eq[nc] == 2) { ridq = 1; rlo = 0; rhi = 0; ridf = 0; };
                };
                if (neq == 0 & rlo == 0 & rhi == 0) { continue; };
                rows = 1000000.0;
                if (neq == 1) { rows = 10.0; };
                if (neq == 2) { rows = 5.0; };
                if (neq >= 3) { rows = 3.0; };
                if (neq == ix.nk & ix.unique == 1) { rows = 1.0; };
                for (t = 0; t < neq; t++) { if (eq[ix.col[t]] == 2) { rows = rows * 3.0; }; };
                if (ridq == 1) { rows = 3.0; };
                if (rlo == 1) { rows = rows / 4.0; };
                if (rhi == 1) { rows = rows / 4.0; };
                cv = 1;
                for (i = 0; i < nc; i++)
                {
                    if (c.need[j * 130 + i] == (byte)0) { continue; };
                    if (i == ti.ipk) { continue; };
                    m = 0;
                    for (t = 0; t < ix.nk; t++) { if (ix.col[t] == i) { m = 1; }; };
                    if (m == 0) { cv = 0; };
                };
                cost = 25.0 + rows * 2.0;
                if (cv == 1) { cost = 25.0 + rows; };
                if (cost < out.cost | (cost == out.cost & neq > out.neq))
                {
                    out.kind = 2; out.rid = ridf; out.ridq = ridq; out.ix = k; out.neq = neq; out.lo = rlo; out.hi = rhi; out.cov = cv; out.rows = rows; out.cost = cost;
                };
            };
            if (out.kind == 0 & avail != 0)
            {
                // an automatic index on the columns that join to earlier sources
                m = 0;
                for (i = 0; i < c.nt; i++)
                {
                    if (c.t[i].src != j | c.t[i].kind != 1) { continue; };
                    if (c.t[i].mask == 0) { continue; };
                    if ((c.t[i].mask `& (0 - 1 - avail)) != 0) { continue; };
                    m = 1;
                };
                if (m == 1)
                {
                    out.kind = 4; out.rows = 10.0; out.cost = 40.0; out.setup = 20000000.0;
                };
            };
        };

        // names the terms of an access path: (a=? AND b>?)
        def sq_eqp_terms_txt(SQ_EQC* c, int j, SQ_EQP* p, SQ_SB* o) -> void
        {
            SQ_SRC* sr = @c.b.src[j];
            SQ_TI* ti = sr.ti;
            SQ_IDX* ix;
            int i, col, nc, first;
            nc = ti.ncols;
            if (p.kind == 2 & p.neq == 0 & p.lo == 0 & p.hi == 0) { return; };
            sq_sb_lit(o, " (\0");
            first = 1;
            if (p.kind == 1)
            {
                if (p.neq == 1) { sq_sb_lit(o, "rowid=?\0"); }
                else
                {
                    if (p.lo == 1) { sq_sb_lit(o, "rowid>?\0"); first = 0; };
                    if (p.hi == 1) { if (first == 0) { sq_sb_lit(o, " AND \0"); }; sq_sb_lit(o, "rowid<?\0"); };
                };
                sq_sb_lit(o, ")\0");
                return;
            };
            for (i = 0; i < p.neq; i++)
            {
                if (p.kind == 3) { col = ti.pkc[i]; } else { ix = @c.ixs[j * 12 + p.ix]; col = ix.col[i]; };
                if (first == 0) { sq_sb_lit(o, " AND \0"); };
                first = 0;
                sq_eqp_cname(c.g, ti, col, o);
                sq_sb_lit(o, "=?\0");
            };
            if (p.ridq == 1)
            {
                sq_sb_lit(o, " AND rowid=?\0");
            };
            if (p.lo == 1 | p.hi == 1)
            {
                if (p.rid == 1) { col = nc; }
                else
                {
                    if (p.kind == 3) { col = ti.pkc[p.neq]; } else { ix = @c.ixs[j * 12 + p.ix]; col = ix.col[p.neq]; };
                };
                if (p.lo == 1)
                {
                    if (first == 0) { sq_sb_lit(o, " AND \0"); };
                    first = 0;
                    sq_eqp_cname(c.g, ti, col, o); sq_sb_lit(o, ">?\0");
                };
                if (p.hi == 1)
                {
                    if (first == 0) { sq_sb_lit(o, " AND \0"); };
                    sq_eqp_cname(c.g, ti, col, o); sq_sb_lit(o, "<?\0");
                };
            };
            sq_sb_lit(o, ")\0");
        };


        def sq_eqp_covers(SQ_EQC* c, int j, SQ_IDX* ix) -> int
        {
            SQ_TI* ti = c.b.src[j].ti;
            int i, t, m;
            for (i = 0; i < ti.ncols; i++)
            {
                if (c.need[j * 130 + i] == (byte)0) { continue; };
                if (i == ti.ipk) { continue; };
                m = 0;
                for (t = 0; t < ix.nk; t++) { if (ix.col[t] == i) { m = 1; }; };
                if (m == 0) { return 0; };
            };
            return 1;
        };

        // columns named by ORDER BY (kind 1), GROUP BY (kind 2) or DISTINCT (kind 3) of a one-source block; -1 when not plain columns
        def sq_eqp_ordcols(SQ_EQC* c, int kind, int* cols) -> int
        {
            SQ_STMT* g = c.g;
            SQ_BLK* b = c.b;
            SQ_TI* ti = b.src[0].ti;
            SQ_NODE* nd;
            int i, n, ni, d0;
            n = 0;
            if (kind == 1) { n = b.nord; };
            if (kind == 2) { n = b.ngrp; };
            if (kind == 3) { n = b.nres; };
            if (n == 0 | n > 8) { return 0 - 1; };
            d0 = 0;
            for (i = 0; i < n; i++)
            {
                if (kind == 1) { ni = b.ord[i]; };
                if (kind == 2) { ni = b.grp[i]; };
                if (kind == 3) { ni = b.rc[i]; };
                if (ni < 0) { return 0 - 1; };
                nd = @g.nodes[ni];
                if (nd.kind != SQN_COL) { return 0 - 1; };
                if (nd.lvl != 0 | nd.src != 0) { return 0 - 1; };
                cols[i] = nd.col;
                if (nd.col == ti.ipk) { cols[i] = ti.ncols; };
                if (kind == 1)
                {
                    if (i == 0) { d0 = b.odesc[0]; } else { if (b.odesc[i] != d0) { return 0 - 1; }; };
                };
            };
            return n;
        };

        // can the rows come out already in the order (ORDER BY) or grouped (GROUP BY, DISTINCT) the block needs
        // returns -2 when not, -1 when the rowid order does it, otherwise the index number
        def sq_eqp_ordix(SQ_EQC* c, SQ_EQP* p, int kind) -> int
        {
            SQ_TI* ti = c.b.src[0].ti;
            SQ_IDX* ix;
            int[8] cols;
            int n, k, skip, t, u, ok, found, sk, nk, kk, pass, cnt;
            if (c.nsrc != 1) { return 0 - 2; };
            if (c.b.src[0].kind != 1) { return 0 - 2; };
            if (kind == 4) { n = sq_eqp_ordcols(c, 1, @cols[0]); if (n >= 2) { n = n - 1; } else { n = 0 - 1; }; }
            else { n = sq_eqp_ordcols(c, kind, @cols[0]); };
            if (n <= 0) { return 0 - 2; };
            kk = kind;
            if (kk == 4) { kk = 1; };
            if (ti.wor == 1)
            {
                if (p.kind != 0 & p.kind != 3) { return 0 - 2; };
                skip = 0;
                if (p.kind == 3) { skip = p.neq; };
                for (pass = 0; pass < 2; pass++)
                {
                    sk = 0;
                    if (pass == 1) { sk = skip; };
                    ok = 1;
                    if (sk + n > ti.npk) { ok = 0; };
                    for (t = 0; t < n & ok == 1; t++)
                    {
                        if (kk == 1) { if (ti.pkc[sk + t] != cols[t]) { ok = 0; }; }
                        else
                        {
                            found = 0;
                            for (u = 0; u < n; u++) { if (cols[u] == ti.pkc[sk + t]) { found = 1; }; };
                            if (found == 0) { ok = 0; };
                        };
                    };
                    if (ok == 1) { return 0 - 1; };
                };
                return 0 - 2;
            };
            if (p.kind == 1 | p.kind == 0)
            {
                if (n == 1 & cols[0] == ti.ncols) { return 0 - 1; };
            };
            if (p.kind == 2 & n == 1 & cols[0] == ti.ncols & p.lo == 0 & p.hi == 0) { return p.ix; };
            if (p.kind != 0 & p.kind != 2) { return 0 - 2; };
            for (k = 0; k < c.nix[0]; k++)
            {
                ix = @c.ixs[k];
                if (ix.partial != 0) { continue; };
                ok = 1;
                for (t = 0; t < ix.nk; t++) { if (ix.isx[t] != 0) { ok = 0; }; };
                if (ok == 0) { continue; };
                if (p.kind == 2)
                {
                    // the index must keep the equality columns of the search in front
                    if (ix.nk < p.neq) { continue; };
                    nk = 1;
                    for (t = 0; t < p.neq; t++)
                    {
                        found = 0;
                        for (u = 0; u < p.neq; u++) { if (ix.col[t] == c.ixs[p.ix].col[u]) { found = 1; }; };
                        if (found == 0) { nk = 0; };
                    };
                    if (nk == 0) { continue; };
                };
                for (pass = 0; pass < 2; pass++)
                {
                    sk = 0;
                    if (pass == 1 & p.kind == 2) { sk = p.neq; };
                    if (pass == 1 & p.kind != 2) { break; };
                    ok = 1;
                    if (sk + n > ix.nk) { ok = 0; };
                    for (t = 0; t < n & ok == 1; t++)
                    {
                        if (kk == 1) { if (ix.col[sk + t] != cols[t]) { ok = 0; }; }
                        else
                        {
                            found = 0;
                            for (u = 0; u < n; u++) { if (cols[u] == ix.col[sk + t]) { found = 1; }; };
                            if (found == 0) { ok = 0; };
                        };
                    };
                    if (ok == 1) { return k; };
                };
            };
            return 0 - 2;
        };

        // the smallest index that holds every column the block reads
        def sq_eqp_covix(SQ_EQC* c, int j) -> int
        {
            SQ_IDX* ix;
            int k, t, ok, best, bn;
            best = 0 - 1; bn = 1000;
            if (c.b.src[j].idxby == 2) { return 0 - 1; };
            for (k = 0; k < c.nix[j]; k++)
            {
                ix = @c.ixs[j * 12 + k];
                if (ix.partial != 0) { continue; };
                if (c.b.src[j].idxby == 1)
                {
                    // INDEXED BY scans the named index even when it does not cover
                    t = 0;
                    while (ix.name[t] != (byte)0) { t++; };
                    ok = 0;
                    if (t == c.b.src[j].ixs_l)
                    {
                        ok = 1;
                        for (bn = 0; bn < t; bn++) { if (sq_lc(ix.name[bn]) != sq_lc(c.g.sql[c.b.src[j].ixs_s + bn])) { ok = 0; }; };
                    };
                    if (ok == 1) { return k; };
                    continue;
                };
                ok = 1;
                for (t = 0; t < ix.nk; t++) { if (ix.isx[t] != 0) { ok = 0; }; };
                if (ok == 0) { continue; };
                if (sq_eqp_covers(c, j, ix) == 0) { continue; };
                if (ix.nk <= bn) { bn = ix.nk; best = k; };
            };
            return best;
        };

        global int SQ_EQS = 0;

        // the name a source is shown by: an attached database's tables carry the database name in front
        def sq_eqp_srcname(SQ_STMT* g, SQ_SRC* sr, SQ_SB* t) -> void
        {
            SQLITE_DB* h;
            int k;
            if (sr.as_l > 0) { sq_sb_add(t, @g.sql[sr.as_s], sr.as_l); return; };
            if (sr.kind == 1 & (u64)sr.sdb != (u64)0)
            {
                h = g.db;
                if ((u64)h.home != (u64)0) { h = (SQLITE_DB*)h.home; };
                for (k = 0; k < h.natt; k++)
                {
                    if ((u64)h.att[k] == (u64)sr.sdb)
                    {
                        if (h.attm[k] == 0) { sq_sb_add(t, @h.attn[k * 32], sq_cstrlen(@h.attn[k * 32])); sq_sb_lit(t, ".\0"); };
                    };
                };
            };
            sq_sb_add(t, @g.sql[sr.ts], sr.tl);
        };

        def sq_eqp_row(SQ_SB* out, int parent, SQ_SB* txt) -> int
        {
            SQ_EQN++;
            sq_sb_int(out, (i64)SQ_EQN);
            sq_sb_lit(out, "|\0");
            sq_sb_int(out, (i64)parent);
            sq_sb_lit(out, "|\0");
            sq_sb_add(out, txt.p, txt.n);
            sq_sb_lit(out, "\n\0");
            return SQ_EQN;
        };

        global int SQ_EQV = 0;

        def sq_vd_usingon(SQ_STMT* g, SQ_BLK* b, SQ_SRC* sr, int j) -> int;
        def sq_vd_in1(SQ_STMT* g, int ni) -> void;

        // LEFT JOIN elimination: a trailing LEFT JOINed table that nothing reads and that the ON clause matches on a unique key
        global int VD_LJE = 0;

        def sq_lje_cnt(SQ_STMT* g, int ni, int j, int* nc, int* ok) -> void
        {
            SQ_NODE* nd;
            if (ni < 0) { return; };
            nd = @g.nodes[ni];
            if (nd.kind == SQN_COL) { if (nd.src == j) { nc[0] = nc[0] + 1; }; return; };
            if (nd.kind == SQN_BIN) { sq_lje_cnt(g, nd.a, j, nc, ok); sq_lje_cnt(g, nd.b, j, nc, ok); return; };
            if (nd.kind == SQN_INT | nd.kind == SQN_STR | nd.kind == SQN_REAL | nd.kind == SQN_NULL) { return; };
            ok[0] = 0;
        };

        def sq_lje_cols(SQ_STMT* g, SQ_BLK* b, int ni, int j, int* cols, int* ncol, int* ok) -> void
        {
            SQ_NODE* nd;
            SQ_NODE* l;
            SQ_NODE* r;
            int x;
            if (ni < 0) { ok[0] = 0; return; };
            nd = @g.nodes[ni];
            if (nd.kind == SQN_BIN & nd.op == SQO_AND) { sq_lje_cols(g, b, nd.a, j, cols, ncol, ok); sq_lje_cols(g, b, nd.b, j, cols, ncol, ok); return; };
            if (nd.kind != SQN_BIN | nd.op != SQO_EQ) { ok[0] = 0; return; };
            l = @g.nodes[nd.a]; r = @g.nodes[nd.b];
            x = 0 - 1;
            if (l.kind == SQN_COL & l.src == j & !(r.kind == SQN_COL & r.src == j)) { x = l.col; };
            if (r.kind == SQN_COL & r.src == j & !(l.kind == SQN_COL & l.src == j)) { x = r.col; };
            if (x < 0) { ok[0] = 0; return; };
            // the other side must compare with the same affinity or the unique index is not used
            if (l.kind == SQN_COL & l.src == j & r.kind == SQN_COL) { if (r.src < 0 | r.src >= b.nsrc | r.col < 0) { ok[0] = 0; return; }; if (b.src[r.src].ti.aff[r.col] != b.src[j].ti.aff[x] & !(b.src[j].ti.aff[x] >= 2 & b.src[r.src].ti.aff[r.col] == 0)) { ok[0] = 0; return; }; };
            if (r.kind == SQN_COL & r.src == j & l.kind == SQN_COL) { if (l.src < 0 | l.src >= b.nsrc | l.col < 0) { ok[0] = 0; return; }; if (b.src[l.src].ti.aff[l.col] != b.src[j].ti.aff[x] & !(b.src[j].ti.aff[x] >= 2 & b.src[l.src].ti.aff[l.col] == 0)) { ok[0] = 0; return; }; };
            if (ncol[0] < 8) { cols[ncol[0]] = x; ncol[0] = ncol[0] + 1; };
        };

        def sq_lje(SQ_STMT* g, SQ_BLK* b) -> void
        {
            SQ_SRC* sr;
            SQ_TI* ti;
            SQ_IDX[12] ix;
            int[8] cols;
            int[1] ncol;
            int[1] nc;
            int[1] ok;
            int j, i, tot, n, k, m, hit, q;
            while (b.nsrc >= 2 & b.cnext < 0 & b.ngrp == 0 & b.nwin == 0 & b.ncte == 0)
            {
                j = b.nsrc - 1;
                sr = @b.src[j];
                if (sr.jt != 2 | sr.kind != 1 | (u64)sr.ti == (u64)0 | sr.tbl < 0 | sr.on < 0 | sr.nusing > 0 | sr.natural != 0) { return; };
                ti = sr.ti;
                if (ti.wor != 0) { return; };
                ok[0] = 1; ncol[0] = 0; nc[0] = 0;
                sq_lje_cols(g, b, sr.on, j, @cols[0], @ncol[0], @ok[0]);
                if (ok[0] == 0) { return; };
                sq_lje_cnt(g, sr.on, j, @nc[0], @ok[0]);
                if (ok[0] == 0) { return; };
                tot = 0;
                for (i = 0; i < g.nn; i++)
                {
                    if (g.nodes[i].kind == SQN_COL & g.nodes[i].src == j & g.nodes[i].owner == g.root_blk & g.nodes[i].lvl == 0) { tot++; };
                };
                if (tot != nc[0]) { return; };
                hit = 0;
                for (k = 0; k < ncol[0]; k++) { if (cols[k] == ti.ipk & ti.ipk >= 0) { hit = 1; }; };
                if (hit == 0)
                {
                    n = sq_idx_list(sr.sdb, sr.tbl, ti, @ix[0], 12);
                    for (m = 0; m < n; m++)
                    {
                        if (ix[m].unique == 0 | ix[m].partial != 0) { continue; };
                        q = 1;
                        for (i = 0; i < ix[m].nk; i++)
                        {
                            if (ix[m].isx[i] != 0) { q = 0; break; };
                            hit = 0;
                            for (k = 0; k < ncol[0]; k++) { if (cols[k] == ix[m].col[i]) { hit = 1; }; };
                            if (hit == 0) { q = 0; break; };
                        };
                        if (q == 1) { hit = 1; break; };
                        hit = 0;
                    };
                };
                if (hit == 0) { return; };
                b.nsrc = b.nsrc - 1;
                VD_LJE = VD_LJE + 1;
            };
        };

        def sq_eqp_block(SQ_STMT* g, int bi, int parent, SQ_SB* out) -> void;

        def sq_eqp_litrow(SQ_SB* out, int parent, byte* s) -> int
        {
            SQ_SB t;
            int r;
            sq_sb_init(@t);
            sq_sb_lit(@t, s);
            r = sq_eqp_row(out, parent, @t);
            sq_sb_free(@t);
            return r;
        };

        // a non-ALL compound is merged from sorted arms, written left deep
        def sq_eqp_arm(SQ_STMT* g, int e, int parent, SQ_SB* out) -> void
        {
            int sv;
            sv = g.blks[e].cnext;
            g.blks[e].cnext = 0 - 1;
            sq_eqp_block(g, e, parent, out);
            g.blks[e].cnext = sv;
        };

        def sq_eqp_mergeto(SQ_STMT* g, int* arms, int m, int parent, SQ_SB* out) -> void
        {
            SQ_SB t;
            int r, k;
            if (m == 0) { sq_eqp_arm(g, arms[0], parent, out); return; };
            sq_sb_init(@t);
            k = g.blks[arms[m]].cop;
            if (k == 2) { sq_sb_lit(@t, "MERGE (UNION ALL)\0"); }
            else
            {
                if (k == 1) { sq_sb_lit(@t, "MERGE (UNION)\0"); }
                else
                {
                    if (k == 3) { sq_sb_lit(@t, "MERGE (INTERSECT)\0"); } else { sq_sb_lit(@t, "MERGE (EXCEPT)\0"); };
                };
            };
            r = sq_eqp_row(out, parent, @t);
            sq_sb_free(@t);
            k = sq_eqp_litrow(out, r, "LEFT\0");
            sq_eqp_mergeto(g, arms, m - 1, k, out);
            k = sq_eqp_litrow(out, r, "RIGHT\0");
            sq_eqp_arm(g, arms[m], k, out);
        };

        def sq_eqp_merge(SQ_STMT* g, int bi, int parent, SQ_SB* out) -> void
        {
            int[16] arms;
            int m, e;
            arms[0] = bi;
            m = 0;
            e = g.blks[bi].cnext;
            while (e >= 0 & m < 15)
            {
                m++;
                arms[m] = e;
                e = g.blks[e].cnext;
            };
            sq_eqp_mergeto(g, @arms[0], m, parent, out);
        };




        global int SQ_EQX = 0;
        global int SQ_EQFN = 0;
        global int[16] SQ_EQF;

        // a subquery that is one plain table with no aggregation, grouping, limit or ordering
        def sq_eqp_simple(SQ_STMT* g, int k) -> bool
        {
            SQ_BLK* b = g.blks[k];
            if (b.cnext >= 0 | b.nsrc != 1) { return false; };
            if (b.src[0].kind != 1) { return false; };
            if (b.nagg != 0 | b.has_agg != 0 | b.ngrp != 0 | b.distinct != 0 | b.limit_n >= 0 | b.nwin != 0 | b.nord != 0) { return false; };
            return true;
        };

        // EXISTS (subquery) written as a conjunct of WHERE is run as a join by SQLite: collect those
        def sq_eqp_flat(SQ_STMT* g, int ni, int bi) -> void
        {
            SQ_NODE* nd;
            if (ni < 0) { return; };
            nd = @g.nodes[ni];
            if (nd.kind == SQN_BIN & nd.op == SQO_AND)
            {
                sq_eqp_flat(g, nd.a, bi);
                sq_eqp_flat(g, nd.b, bi);
                return;
            };
            if (nd.kind == SQN_EXISTS & nd.blk >= 0 & SQ_EQFN < 16)
            {
                if (g.blks[nd.blk].parent == bi) { if (sq_eqp_simple(g, nd.blk)) { SQ_EQF[SQ_EQFN] = ni; SQ_EQFN++; }; };
            };
        };

        // subqueries written in the expressions of block bi
        def sq_eqp_subs(SQ_STMT* g, int bi, int parent, SQ_SB* out) -> void
        {
            SQ_NODE* nd;
            SQ_SB t;
            SQ_IDX[12] ixl;
            int i, r, k, n1, fl;
            for (i = 0; i < g.nn; i++)
            {
                nd = @g.nodes[i];
                if (nd.owner != bi) { continue; };
                if (nd.kind != SQN_SUBQ & nd.kind != SQN_IN & nd.kind != SQN_EXISTS) { continue; };
                if (nd.blk < 0) { continue; };
                if (nd.kind == SQN_IN) { if (nd.blk == 0 - 1) { continue; }; };
                if (nd.blk >= g.nblk) { continue; };
                if (g.blks[nd.blk].parent != bi) { continue; };
                fl = 0;
                for (r = 0; r < SQ_EQFN; r++) { if (SQ_EQF[r] == i) { fl = 1; }; };
                if (fl == 1) { continue; };
                if (nd.kind == SQN_IN & nd.op != 1)
                {
                    // NOT IN over an indexed column reads the index directly
                    if (sq_eqp_simple(g, nd.blk) & g.blks[nd.blk].where_n < 0 & g.blks[nd.blk].nres == 1)
                    {
                        if (g.nodes[g.blks[nd.blk].rc[0]].kind == SQN_COL)
                        {
                            n1 = sq_idx_list(g.blks[nd.blk].src[0].sdb, g.blks[nd.blk].src[0].tbl, g.blks[nd.blk].src[0].ti, @ixl[0], 12);
                            for (k = 0; k < n1; k++)
                            {
                                if (ixl[k].partial == 0 & ixl[k].isx[0] == 0 & ixl[k].col[0] == g.nodes[g.blks[nd.blk].rc[0]].col)
                                {
                                    sq_sb_init(@t);
                                    sq_sb_lit(@t, "USING INDEX \0");
                                    sq_sb_lit(@t, @ixl[k].name[0]);
                                    sq_sb_lit(@t, " FOR IN-OPERATOR\0");
                                    sq_eqp_row(out, parent, @t);
                                    sq_sb_free(@t);
                                    fl = 1;
                                    break;
                                };
                            };
                        };
                    };
                };
                if (fl == 1) { continue; };
                sq_sb_init(@t);
                if (nd.kind == SQN_IN) { sq_sb_lit(@t, "LIST SUBQUERY \0"); }
                else
                {
                    if (g.blks[nd.blk].is_corr == 1) { sq_sb_lit(@t, "CORRELATED SCALAR SUBQUERY \0"); } else { sq_sb_lit(@t, "SCALAR SUBQUERY \0"); };
                };
                k = nd.blk;
                SQ_EQS++;
                sq_sb_int(@t, (i64)SQ_EQS);
                r = sq_eqp_row(out, parent, @t);
                sq_sb_free(@t);
                sq_eqp_block(g, k, r, out);
            };
        };


        def sq_eqp_orlist(SQ_STMT* g, int ni, int* arr, int n) -> int
        {
            SQ_NODE* nd;
            if (ni < 0 | n >= 8) { return n; };
            nd = @g.nodes[ni];
            if (nd.kind == SQN_BIN & nd.op == SQO_OR)
            {
                n = sq_eqp_orlist(g, nd.a, arr, n);
                n = sq_eqp_orlist(g, nd.b, arr, n);
                return n;
            };
            arr[n] = ni;
            return n + 1;
        };

        def sq_eqp_findor(SQ_STMT* g, int ni) -> int
        {
            SQ_NODE* nd;
            int r;
            if (ni < 0) { return 0 - 1; };
            nd = @g.nodes[ni];
            if (nd.kind == SQN_BIN & nd.op == SQO_OR) { return ni; };
            if (nd.kind == SQN_BIN & nd.op == SQO_AND)
            {
                r = sq_eqp_findor(g, nd.a);
                if (r >= 0) { return r; };
                return sq_eqp_findor(g, nd.b);
            };
            return 0 - 1;
        };

        // the " USING ..." part of an index, rowid or primary key access
        def sq_eqp_acc(SQ_EQC* c, int j, SQ_EQP* p, SQ_SB* t) -> void
        {
            SQ_IDX* ix;
            if (p.kind == 1) { sq_sb_lit(t, " USING INTEGER PRIMARY KEY\0"); sq_eqp_terms_txt(c, j, p, t); return; };
            if (p.kind == 3) { sq_sb_lit(t, " USING PRIMARY KEY\0"); sq_eqp_terms_txt(c, j, p, t); return; };
            ix = @c.ixs[j * 12 + p.ix];
            if (p.cov == 1) { sq_sb_lit(t, " USING COVERING INDEX \0"); } else { sq_sb_lit(t, " USING INDEX \0"); };
            sq_sb_lit(t, @ix.name[0]);
            sq_eqp_terms_txt(c, j, p, t);
        };

        // OR of terms that each have their own index: every branch is searched and the rows are merged
        def sq_eqp_mor(SQ_EQC* c, SQ_STMT* g, SQ_BLK* b, int parent, SQ_SB* out, int ex) -> bool
        {
            SQ_EQP[8] ps;
            int[8] arr;
            SQ_SB t;
            SQ_SRC* sr = @b.src[0];
            int ni, n, i, save;
            ni = sq_eqp_findor(g, b.where_n);
            if (ni < 0) { return false; };
            n = sq_eqp_orlist(g, ni, @arr[0], 0);
            if (n < 2) { return false; };
            save = c.nt;
            for (i = 0; i < n; i++)
            {
                c.nt = 0;
                sq_eqp_term(c, arr[i]);
                sq_eqp_plan(c, 0, 0, @ps[i]);
                if (ps[i].kind == 0 | ps[i].kind == 4) { c.nt = save; return false; };
            };
            sq_eqp_litrow(out, parent, "MULTI-INDEX OR\0");
            for (i = 0; i < n; i++)
            {
                c.nt = 0;
                sq_eqp_term(c, arr[i]);
                sq_sb_init(@t);
                sq_sb_lit(@t, "INDEX \0");
                sq_sb_int(@t, (i64)(i + 1));
                sq_eqp_row(out, parent, @t);
                sq_sb_free(@t);
                sq_sb_init(@t);
                sq_sb_lit(@t, "SEARCH \0");
                sq_eqp_srcname(g, sr, @t);
                sq_eqp_acc(c, 0, @ps[i], @t);
                sq_eqp_row(out, parent, @t);
                sq_sb_free(@t);
            };
            c.nt = save;
            return true;
        };

        def sq_eqp_block(SQ_STMT* g, int bi, int parent, SQ_SB* out) -> void
        {
            SQ_BLK* b = g.blks[bi];
            SQ_EQC* c;
            SQ_SB t;
            SQ_EQP p;
            SQ_EQP best;
            SQ_SRC* sr;
            SQ_IDX* ix;
            int[8] order;
            int[8] bestord;
            int[8] used;
            int j, k, i, n, r, pos, avail, left, nsrc, par, nord, ok, perm, cnt, e, oix, gix, dix, sel, tcov, lastt, v1, ob, oj, ex, nfl, fi;
            int[16] lf;
            double cost, bestcost, loops;
            SQ_NODE* nd;
            ex = SQ_EQX;
            SQ_EQX = 0;
            if (b.cnext >= 0 & SQ_EQV == 1 & bi == g.root_blk)
            {
                cnt = 1;
                e = b.cnext;
                while (e >= 0) { cnt++; e = g.blks[e].cnext; };
                sq_sb_init(@t);
                sq_sb_lit(@t, "SCAN \0");
                sq_sb_int(@t, (i64)cnt);
                sq_sb_lit(@t, "-ROW VALUES CLAUSE\0");
                sq_eqp_row(out, parent, @t);
                sq_sb_free(@t);
                return;
            };
            if (b.cnext >= 0)
            {
                nord = 0;
                e = b.cnext;
                while (e >= 0) { if (g.blks[e].cop != 2) { nord = 1; }; e = g.blks[e].cnext; };
                if (nord == 1)
                {
                    sq_eqp_merge(g, bi, parent, out);
                    return;
                };
            };
            if (b.cnext >= 0)
            {
                // compound select
                par = sq_eqp_litrow(out, parent, "COMPOUND QUERY\0");
                r = sq_eqp_litrow(out, par, "LEFT-MOST SUBQUERY\0");
                b.cnext = b.cnext;
                e = b.cnext;
                b.cnext = 0 - 1;
                sq_eqp_block(g, bi, r, out);
                b.cnext = e;
                while (e >= 0)
                {
                    sq_sb_init(@t);
                    k = g.blks[e].cop;
                    if (k == 2) { sq_sb_lit(@t, "UNION ALL\0"); }
                    else
                    {
                        if (k == 1) { sq_sb_lit(@t, "UNION USING TEMP B-TREE\0"); }
                        else
                        {
                            if (k == 3) { sq_sb_lit(@t, "INTERSECT USING TEMP B-TREE\0"); } else { sq_sb_lit(@t, "EXCEPT USING TEMP B-TREE\0"); };
                        };
                    };
                    r = sq_eqp_row(out, par, @t);
                    sq_sb_free(@t);
                    i = g.blks[e].cnext;
                    g.blks[e].cnext = 0 - 1;
                    sq_eqp_block(g, e, r, out);
                    g.blks[e].cnext = i;
                    e = i;
                };
                return;
            };
            SQ_EQFN = 0;
            if (b.nsrc == 1) { sq_eqp_flat(g, b.where_n, bi); };
            nfl = SQ_EQFN;
            for (fi = 0; fi < nfl; fi++) { lf[fi] = SQ_EQF[fi]; };
            ob = SQ_EQO_B - 1; oj = SQ_EQO_J;
            SQ_EQO_B = 0;
            sq_lje(g, b);
            if (b.where_n >= 0) { sq_vd_in1(g, b.where_n); };
            nsrc = b.nsrc;
            for (j = 1; j < nsrc; j++) { if (b.src[j].nusing > 0 & b.src[j].kind == 1 & b.src[j].jt != 2 & b.src[j].jt < 4) { sq_vd_usingon(g, b, @b.src[j], j); }; };
            if (nsrc == 0)
            {
                sq_eqp_litrow(out, parent, "SCAN CONSTANT ROW\0");
                sq_eqp_subs(g, bi, parent, out);
                return;
            };
            c = (SQ_EQC*)fmalloc((u64)(sizeof(SQ_EQC) / 8 + 64));
            if ((u64)c == (u64)0) { return; };
            c.g = g; c.b = b; c.bi = bi; c.nt = 0; c.nsrc = nsrc;
            sq_eqp_need(c);
            sq_eqp_term(c, b.where_n);
            if (ob >= 0) { sq_eqp_push(c, g.blks[ob].where_n, ob, oj); };
            for (j = 0; j < nsrc; j++)
            {
                sr = @b.src[j];
                c.nix[j] = 0;
                if (sr.on >= 0) { sq_eqp_term(c, sr.on); };
                if (sr.kind == 1 & (u64)sr.ti != (u64)0 & sr.tbl >= 0 & j < 8)
                {
                    c.nix[j] = sq_idx_list(sr.sdb, sr.tbl, sr.ti, @c.ixs[j * 12], 12);
                };
            };
            // join order
            for (j = 0; j < nsrc; j++) { order[j] = j; };
            left = 0;
            for (j = 1; j < nsrc; j++) { if (b.src[j].jt == 2 | b.src[j].jt >= 4 | b.src[j].natural != 0 | b.src[j].nusing > 0) { left = 1; }; };
            if (nsrc > 1 & nsrc <= 5 & left == 0)
            {
                bestcost = 1.0e30;
                cnt = 1;
                for (j = 2; j <= nsrc; j++) { cnt = cnt * j; };
                for (perm = 0; perm < cnt; perm++)
                {
                    // decode the permutation number in factorial base
                    for (j = 0; j < nsrc; j++) { used[j] = 0; };
                    n = perm;
                    k = cnt;
                    for (pos = 0; pos < nsrc; pos++)
                    {
                        k = k / (nsrc - pos);
                        i = n / k;
                        n = n % k;
                        // pick the i-th unused source
                        for (j = 0; j < nsrc; j++)
                        {
                            if (used[j] == 0)
                            {
                                if (i == 0) { order[pos] = j; used[j] = 1; break; };
                                i--;
                            };
                        };
                    };
                    avail = 0;
                    cost = 0.0;
                    loops = 1.0;
                    for (pos = 0; pos < nsrc; pos++)
                    {
                        sq_eqp_plan(c, order[pos], avail, @p);
                        cost = cost + loops * p.cost + p.setup;
                        loops = loops * p.rows;
                        if (loops > 1.0e15) { loops = 1.0e15; };
                        avail = avail | (1 << order[pos]);
                    };
                    if (cost < bestcost * 0.9999)
                    {
                        bestcost = cost;
                        for (j = 0; j < nsrc; j++) { bestord[j] = order[j]; };
                    };
                };
                for (j = 0; j < nsrc; j++) { order[j] = bestord[j]; };
            };
            // ordering that an index scan of the only source already provides
            oix = 0 - 2; gix = 0 - 2; dix = 0 - 2;
            if (nsrc == 1)
            {
                sq_eqp_plan(c, 0, 0, @p);
                if (b.ngrp > 0) { gix = sq_eqp_ordix(c, @p, 2); };
                if (b.nord > 0) { oix = sq_eqp_ordix(c, @p, 1); };
                if (b.distinct == 1 & b.ngrp == 0) { dix = sq_eqp_ordix(c, @p, 3); };
                lastt = 0;
                if (oix == 0 - 2 & b.nord >= 2)
                {
                    oix = sq_eqp_ordix(c, @p, 4);
                    if (oix != 0 - 2) { lastt = 1; };
                };
                if (oix >= 0 & gix >= 0 & oix != gix) { oix = 0 - 2; lastt = 0; };
                if (dix >= 0 & gix >= 0 & dix != gix) { dix = 0 - 2; };
                if (dix >= 0 & oix >= 0 & dix != oix) { dix = 0 - 2; };
            };
            for (fi = 0; fi < nfl; fi++)
            {
                if (g.blks[g.nodes[lf[fi]].blk].is_corr == 0)
                {
                    SQ_EQX = 1;
                    sq_eqp_block(g, g.nodes[lf[fi]].blk, parent, out);
                };
            };
            avail = 0;
            for (pos = 0; pos < nsrc; pos++)
            {
                j = order[pos];
                sr = @b.src[j];
                sq_eqp_plan(c, j, avail, @p);
                if (nsrc == 1 & p.kind == 2)
                {
                    sel = 0 - 1;
                    if (oix >= 0) { sel = oix; } else { if (gix >= 0) { sel = gix; }; };
                    if (sel >= 0 & sel != p.ix) { p.ix = sel; p.cov = sq_eqp_covers(c, j, @c.ixs[j * 12 + sel]); };
                };
                if (nsrc == 1 & p.kind == 0 & sr.kind == 1 & sr.ti.wor == 0 & b.nres == 1 & b.where_n < 0 & b.ngrp == 0 & b.nord == 0)
                {
                    // MIN() or MAX() of the leading column of an index reads one end of the index
                    nd = @g.nodes[b.rc[0]];
                    if (nd.kind == SQN_FUNC & (nd.col == 104 | nd.col == 105) & nd.a >= 0)
                    {
                        if (g.nodes[nd.a].kind == SQN_COL & g.nodes[nd.a].lvl == 0)
                        {
                            if (g.nodes[nd.a].col == sr.ti.ipk | g.nodes[nd.a].col == sr.ti.ncols) { p.kind = 6; };
                            for (k = 0; k < c.nix[j]; k++)
                            {
                                ix = @c.ixs[j * 12 + k];
                                if (ix.partial == 0 & ix.isx[0] == 0 & ix.col[0] == g.nodes[nd.a].col & p.kind == 0)
                                {
                                    p.kind = 2; p.ix = k; p.neq = 0; p.lo = 0; p.hi = 0; p.cov = sq_eqp_covers(c, j, ix);
                                };
                            };
                        };
                    };
                };
                avail = avail | (1 << j);
                if (nsrc == 1 & p.kind == 0 & sr.kind == 1 & sr.ti.wor == 0 & ob < 0)
                {
                    if (sq_eqp_mor(c, g, b, parent, out, ex)) { continue; };
                };
                sq_sb_init(@t);
                if (sr.kind == 2 & sr.blk >= 0)
                {
                    // a subquery in FROM: flattened when it is a plain select
                    k = sr.blk;
                    if (g.blks[k].cnext < 0 & g.blks[k].nagg == 0 & g.blks[k].has_agg == 0 & g.blks[k].ngrp == 0 & g.blks[k].distinct == 0 & g.blks[k].limit_n < 0 & g.blks[k].nwin == 0)
                    {
                        sq_sb_free(@t);
                        SQ_EQO_B = bi + 1; SQ_EQO_J = j;
                        sq_eqp_block(g, k, parent, out);
                        SQ_EQO_B = 0;
                        continue;
                    };
                    sq_sb_lit(@t, "CO-ROUTINE \0");
                    if (sr.as_l > 0) { sq_sb_add(@t, @g.sql[sr.as_s], sr.as_l); }
                    else { sq_sb_lit(@t, "(subquery-\0"); sq_sb_int(@t, (i64)(SQ_EQN + 1)); sq_sb_lit(@t, ")\0"); };
                    r = sq_eqp_row(out, parent, @t);
                    sq_sb_free(@t);
                    sq_eqp_block(g, k, r, out);
                    sq_sb_init(@t);
                    sq_sb_lit(@t, "SCAN \0");
                    if (sr.as_l > 0) { sq_sb_add(@t, @g.sql[sr.as_s], sr.as_l); }
                    else { sq_sb_lit(@t, "(subquery-\0"); sq_sb_int(@t, (i64)(r)); sq_sb_lit(@t, ")\0"); };
                    sq_eqp_row(out, parent, @t);
                    sq_sb_free(@t);
                    continue;
                };
                if (p.kind == 0) { sq_sb_lit(@t, "SCAN \0"); } else { sq_sb_lit(@t, "SEARCH \0"); };
                sq_eqp_srcname(g, sr, @t);
                if (ex == 1) { sq_sb_lit(@t, " EXISTS\0"); };
                if (p.kind == 1) { sq_sb_lit(@t, " USING INTEGER PRIMARY KEY\0"); sq_eqp_terms_txt(c, j, @p, @t); };
                if (p.kind == 2)
                {
                    ix = @c.ixs[j * 12 + p.ix];
                    if (p.cov == 1) { sq_sb_lit(@t, " USING COVERING INDEX \0"); } else { sq_sb_lit(@t, " USING INDEX \0"); };
                    sq_sb_lit(@t, @ix.name[0]);
                    sq_eqp_terms_txt(c, j, @p, @t);
                };
                if (p.kind == 3) { sq_sb_lit(@t, " USING PRIMARY KEY\0"); sq_eqp_terms_txt(c, j, @p, @t); };
                if (p.kind == 0 & sr.kind == 1 & sr.ti.wor == 0)
                {
                    sel = 0 - 1;
                    if (nsrc == 1)
                    {
                        if (gix >= 0) { sel = gix; } else { if (oix >= 0) { sel = oix; } else { if (dix >= 0) { sel = dix; }; }; };
                    };
                    if (sel < 0 & gix == 0 - 2 & oix == 0 - 2 & dix == 0 - 2) { sel = sq_eqp_covix(c, j); };
                    if (sel < 0 & nsrc == 1 & (gix == 0 - 1 | oix == 0 - 1 | dix == 0 - 1)) { sel = 0 - 1; };
                    if (sel < 0 & nsrc == 1 & (gix >= 0 | oix >= 0 | dix >= 0)) { sel = 0 - 1; };
                    if (sel < 0 & (gix == 0 - 2 | oix == 0 - 2 | dix == 0 - 2) & nsrc == 1)
                    {
                        // an unordered requirement still lets a covering index replace the table scan
                        sel = sq_eqp_covix(c, j);
                    };
                    if (sel >= 0)
                    {
                        ix = @c.ixs[j * 12 + sel];
                        if (sq_eqp_covers(c, j, ix) == 1) { sq_sb_lit(@t, " USING COVERING INDEX \0"); } else { sq_sb_lit(@t, " USING INDEX \0"); };
                        sq_sb_lit(@t, @ix.name[0]);
                    };
                };
                if (p.kind == 4)
                {
                    sq_sb_free(@t);
                    sq_sb_init(@t);
                    sq_sb_lit(@t, "BLOOM FILTER ON \0");
                    if (sr.as_l > 0) { sq_sb_add(@t, @g.sql[sr.as_s], sr.as_l); } else { sq_sb_add(@t, @g.sql[sr.ts], sr.tl); };
                    sq_sb_lit(@t, " (\0");
                    n = 0;
                    for (i = 0; i < c.nt; i++)
                    {
                        if (c.t[i].src != j | c.t[i].kind != 1 | c.t[i].mask == 0) { continue; };
                        if (n > 0) { sq_sb_lit(@t, " AND \0"); };
                        sq_eqp_cname(g, sr.ti, c.t[i].col, @t);
                        sq_sb_lit(@t, "=?\0");
                        n++;
                    };
                    sq_sb_lit(@t, ")\0");
                    sq_eqp_row(out, parent, @t);
                    sq_sb_free(@t);
                    sq_sb_init(@t);
                    if (sr.as_l > 0) { sq_sb_lit(@t, "SEARCH \0"); sq_sb_add(@t, @g.sql[sr.as_s], sr.as_l); } else { sq_sb_lit(@t, "SEARCH \0"); sq_sb_add(@t, @g.sql[sr.ts], sr.tl); };
                    sq_sb_lit(@t, " USING AUTOMATIC COVERING INDEX (\0");
                    n = 0;
                    for (i = 0; i < c.nt; i++)
                    {
                        if (c.t[i].src != j | c.t[i].kind != 1 | c.t[i].mask == 0) { continue; };
                        if (n > 0) { sq_sb_lit(@t, " AND \0"); };
                        sq_eqp_cname(g, sr.ti, c.t[i].col, @t);
                        sq_sb_lit(@t, "=?\0");
                        n++;
                    };
                    sq_sb_lit(@t, ")\0");
                };
                if (sr.jt == 2 | sr.jt == 5) { sq_sb_lit(@t, " LEFT-JOIN\0"); };
                sq_eqp_row(out, parent, @t);
                sq_sb_free(@t);
            };
            for (fi = 0; fi < nfl; fi++)
            {
                if (g.blks[g.nodes[lf[fi]].blk].is_corr == 1)
                {
                    SQ_EQX = 1;
                    sq_eqp_block(g, g.nodes[lf[fi]].blk, parent, out);
                };
            };
            SQ_EQFN = nfl;
            for (fi = 0; fi < nfl; fi++) { SQ_EQF[fi] = lf[fi]; };
            sq_eqp_subs(g, bi, parent, out);
            SQ_EQFN = 0;
            if (b.ngrp > 0 & gix == 0 - 2) { sq_eqp_litrow(out, parent, "USE TEMP B-TREE FOR GROUP BY\0"); };
            if (b.distinct == 1 & b.ngrp == 0 & dix == 0 - 2) { sq_eqp_litrow(out, parent, "USE TEMP B-TREE FOR DISTINCT\0"); };
            if (b.nord > 0 & oix == 0 - 2) { sq_eqp_litrow(out, parent, "USE TEMP B-TREE FOR ORDER BY\0"); };
            if (b.nord > 0 & lastt == 1) { sq_eqp_litrow(out, parent, "USE TEMP B-TREE FOR LAST TERM OF ORDER BY\0"); };
            ffree((u64)c);
        };

        def sq_exec_explain_vdbe(SQ_STMT* st, byte** pq) -> int;

        // EXPLAIN [QUERY PLAN] statement: returns the plan as a query text in *pq
        def sq_exec_explain(SQ_STMT* st, byte** pq) -> int
        {
            SQ_STMT* g;
            SQ_SB out;
            SQ_SB q;
            int s, e, i, lines, started, dml, norows, n, k, j, ns, ne;
            byte c;
            if (sq_is_kw(st, "query\0") == false) { return sq_exec_explain_vdbe(st, pq); };
            sq_next(st);
            if (sq_is_kw(st, "plan\0") == false) { sq_seterr(st, "syntax error\0"); return 1; };
            sq_next(st);
            s = sq_tok_start(st);
            e = st.sqllen;
            while (e > s)
            {
                c = st.sql[e - 1];
                if (c == (byte)32 | c == (byte)9 | c == (byte)10 | c == (byte)13 | c == (byte)59) { e--; } else { break; };
            };
            // INSERT, UPDATE and DELETE are explained by the query that finds their rows
            dml = 0; norows = 0;
            if (sq_is_kw(st, "insert\0") | sq_is_kw(st, "replace\0")) { dml = 1; };
            if (sq_is_kw(st, "update\0")) { dml = 2; };
            if (sq_is_kw(st, "delete\0")) { dml = 3; };
            sq_sb_init(@q);
            if (dml == 0) { sq_sb_add(@q, @st.sql[s], e - s); }
            else
            {
                n = e - s;
                k = sq_find_top(@st.sql[s], n, "returning\0");
                if (k >= 0) { n = k; };
                if (dml == 1)
                {
                    k = sq_find_top(@st.sql[s], n, "select\0");
                    j = sq_find_top(@st.sql[s], n, "with\0");
                    if (k < 0 | (j >= 0 & j < k)) { k = j; };
                    if (k < 0) { norows = 1; }
                    else
                    {
                        j = sq_find_top(@st.sql[s + k], n - k, "on conflict\0");
                        if (j >= 0) { sq_sb_add(@q, @st.sql[s + k], j); } else { sq_sb_add(@q, @st.sql[s + k], n - k); };
                    };
                }
                else
                {
                    sq_next(st);
                    if (dml == 3) { sq_next(st); }
                    else
                    {
                        if (sq_is_kw(st, "or\0")) { sq_next(st); sq_next(st); };
                    };
                    ns = sq_tok_start(st);
                    ne = st.tend;
                    sq_next(st);
                    k = sq_find_top(@st.sql[s], n, "where\0");
                    if (dml == 3 & k < 0) { norows = 1; }
                    else
                    {
                        sq_sb_lit(@q, "select * from \0");
                        sq_sb_add(@q, @st.sql[ns], ne - ns);
                        if (k >= 0) { sq_sb_lit(@q, " \0"); sq_sb_add(@q, @st.sql[s + k], n - k); };
                    };
                };
            };
            sq_sb_init(@out);
            started = 0;
            if (norows == 0)
            {
                g = sq_stmt_new();
                if ((u64)g == (u64)0) { sq_sb_free(@q); sq_seterr(st, "out of memory\0"); return 1; };
                if (dml == 0)
                {
                    if (sq_is_kw(st, "values\0")) { started = 1; };
                    if (sq_is_kw(st, "select\0") == false & sq_is_kw(st, "with\0") == false & sq_is_kw(st, "values\0") == false)
                    {
                        sq_stmt_del(g); sq_sb_free(@q); sq_sb_free(@out);
                        sq_seterr(st, "EXPLAIN QUERY PLAN supports SELECT, INSERT, UPDATE and DELETE statements\0");
                        return 1;
                    };
                };
                if (sq_prep_query(g, st.db, q.p) != 0)
                {
                    sq_seterr(st, g.err);
                    sq_stmt_del(g); sq_sb_free(@q); sq_sb_free(@out);
                    return 1;
                };
                SQ_EQN = 0;
                SQ_EQS = 0;
                SQ_EQV = 0;
                if (started == 1) { SQ_EQV = 1; };
                sq_eqp_block(g, g.root_blk, 0, @out);
                sq_stmt_del(g);
            };
            sq_sb_free(@q);
            // rows id|parent|detail become a constant-row query
            sq_sb_init(@q);
            sq_sb_lit(@q, "select * from (select null as id, null as parent, null as notused, null as detail where 0\0");
            i = 0;
            while (i < out.n)
            {
                sq_sb_lit(@q, " union all select \0");
                lines = 0;
                while (i < out.n & out.p[i] != (byte)10)
                {
                    if (out.p[i] == (byte)124 & lines < 2)
                    {
                        sq_sb_lit(@q, ", \0");
                        lines++;
                        if (lines == 2) { sq_sb_lit(@q, "0, '\0"); };
                        i++;
                        continue;
                    };
                    if (out.p[i] == (byte)39) { sq_sb_lit(@q, "''\0"); i++; continue; };
                    sq_sb_add(@q, @out.p[i], 1);
                    i++;
                };
                sq_sb_lit(@q, "'\0");
                i++;
            };
            sq_sb_lit(@q, ")\0");
            sq_sb_free(@out);
            *pq = q.p;
            return 0;
        };
        // ---- plain EXPLAIN: the VDBE program listing ----
        // The program is generated the way SQLite's code generator lays it out (Init at the top, the body, Halt, then the
        // transaction and constant section and the closing Goto). Statements the generator does not model are reported
        // as an error naming the statement shape, never as an invented listing.

        global int VD_N = 0;
        global int VD_TN = 0;
        global int[1024] VD_O;
        global int[1024] VD_P1;
        global int[1024] VD_P2;
        global int[1024] VD_P3;
        global int[1024] VD_P4;
        global int[1024] VD_P5;
        global byte[32768] VD_TXT;

        global int VD_RN = 0, VD_RR = 0, VD_INCUR = 1, VD_INUSED = 0;
        global int VD_DBGZ = 0, VD_LASTG = 0;
        global int VD_INRW = 0, VD_INNL = 0, VD_INTOP = 0, VD_INDESC = 0;
        global int VD_INDML = 0;
        global int VD_CNULL = 0;
        global int VD_CGZ = 0;
        global int VD_ISWOR = 0;
        global int VD_SEMI = 0;
        global int VD_INSUB = 0;
        global int VD_INDIR = 0;
        global int VD_INSB = 0;
        global int VD_INC = 0;
        global int VD_INLO = 0;
        global int VD_INHI = 0;
        global int VD_PLWOR = 0;
        global int[128] VD_WORM;

        global int VD_KEEP = 0;
        global int VD_NGW = 0;
        global int VD_ARM = 0;
        global int VD_NH0 = 0;
        global int VD_WASTE = 0;
        global int VD_WA = 0;
        global int VD_XT = 0;
        global int VD_XF = 0;
        global int VD_NEST = 0;
        global int VD_DST = 0;
        global int VD_RB = 0;

        global int VD_EPOCH = 1;
        def sq_vd_reset() -> void
        {
            VD_EPOCH++;
            if (VD_KEEP == 0)
            {
                VD_N = 0; VD_TN = 0;
                while (VD_XGN > 0) { VD_XGN--; sq_stmt_del((SQ_STMT*)VD_XG[VD_XGN]); };
            };
            VD_RN = 0;
            VD_RR = 0;
            VD_INCUR = 1;
            VD_INUSED = 0;
            VD_ISWOR = 0;
        };

        def sq_vd_txt(byte* s, int n) -> int
        {
            int o, i;
            o = VD_TN;
            if (o + n + 1 >= 32768) { return 0 - 1; };
            for (i = 0; i < n; i++) { VD_TXT[o + i] = s[i]; };
            VD_TXT[o + n] = (byte)0;
            VD_TN = o + n + 1;
            return o;
        };

        // appends an instruction and returns its address
        def sq_vd_op(byte* name, int p1, int p2, int p3) -> int
        {
            int a;
            a = VD_N;
            if (a >= 1000) { return 0 - 1; };
            VD_O[a] = sq_vd_txt(name, sq_cstrlen(name));
            VD_P1[a] = p1; VD_P2[a] = p2; VD_P3[a] = p3; VD_P4[a] = 0 - 1; VD_P5[a] = 0;
            VD_N = a + 1;
            return a;
        };

        // moves the last emitted instruction to position pos, shifting the ones from pos on up by one
        def sq_vd_rot(int pos) -> void
        {
            int i, o, a, b, c, d, e;
            i = VD_N - 1;
            o = VD_O[i]; a = VD_P1[i]; b = VD_P2[i]; c = VD_P3[i]; d = VD_P4[i]; e = VD_P5[i];
            while (i > pos)
            {
                VD_O[i] = VD_O[i - 1]; VD_P1[i] = VD_P1[i - 1]; VD_P2[i] = VD_P2[i - 1]; VD_P3[i] = VD_P3[i - 1]; VD_P4[i] = VD_P4[i - 1]; VD_P5[i] = VD_P5[i - 1];
                i--;
            };
            VD_O[pos] = o; VD_P1[pos] = a; VD_P2[pos] = b; VD_P3[pos] = c; VD_P4[pos] = d; VD_P5[pos] = e;
        };

        // a scalar function call; in an index expression or partial index WHERE it is a PureFunc with the context flag in P5
        def sq_vd_fnop(int mask, int r0, int target) -> int
        {
            int a;
            if (VD_PURE != 0)
            {
                a = sq_vd_op("PureFunc\0", mask, r0, target);
                VD_P5[a] = VD_PURE;
                return a;
            };
            return sq_vd_op("Function\0", mask, r0, target);
        };

        def sq_vd_p4s(int a, byte* s, int n) -> void
        {
            VD_P4[a] = sq_vd_txt(s, n);
        };

        def sq_vd_p4i(int a, i64 v) -> void
        {
            SQ_SB t;
            sq_sb_init(@t);
            sq_sb_int(@t, v);
            VD_P4[a] = sq_vd_txt(t.p, t.n);
            sq_sb_free(@t);
        };

        // the program as a query text
        // the DEFAULT of a column as SQLite shows it in the P4 of Column: the literal after column affinity, or -1 when the
        // default is not a plain literal
        def sq_vd_dflp4(SQ_TI* ti, int col, byte* out) -> int
        {
            byte* e;
            SQ_VAL v;
            SQ_SB sb;
            byte[800] tb;
            int n, i, j, neg, ok, d, q, dd, sg, hx, o, hasdot;
            i64 hv;
            if (col < 0 | col >= ti.ncols) { return 0 - 1; };
            n = ti.dfl[col];
            if (n <= 0) { return 0 - 1; };
            e = @ti.base[ti.dfs[col]];
            while (n > 0 & (e[0] == (byte)32 | e[0] == (byte)9 | e[0] == (byte)10 | e[0] == (byte)13)) { e = @e[1]; n--; };
            while (n > 0 & (e[n - 1] == (byte)32 | e[n - 1] == (byte)9 | e[n - 1] == (byte)10 | e[n - 1] == (byte)13)) { n--; };
            while (n >= 2 & e[0] == (byte)40 & e[n - 1] == (byte)41)
            {
                d = 0; ok = 1;
                for (j = 0; j < n - 1; j++)
                {
                    if (e[j] == (byte)39) { j++; while (j < n & e[j] != (byte)39) { j++; }; continue; };
                    if (e[j] == (byte)40) { d++; };
                    if (e[j] == (byte)41) { d--; if (d == 0) { ok = 0; break; }; };
                };
                if (ok == 0) { break; };
                e = @e[1]; n = n - 2;
                while (n > 0 & e[0] == (byte)32) { e = @e[1]; n--; };
                while (n > 0 & e[n - 1] == (byte)32) { n--; };
            };
            if (n <= 0) { return 0 - 1; };
            neg = 0; sg = 0;
            if (e[0] == (byte)45) { neg = 1; sg = 1; e = @e[1]; n--; }
            else { if (e[0] == (byte)43) { sg = 1; e = @e[1]; n--; }; };
            while (n > 0 & e[0] == (byte)32) { e = @e[1]; n--; };
            if (n <= 0) { return 0 - 1; };
            sq_val_null(@v);
            if (e[0] == (byte)39)
            {
                if (sg == 1) { return 0 - 1; };
                o = 0; j = 1;
                while (j < n)
                {
                    if (e[j] == (byte)39)
                    {
                        if (j + 1 < n) { if (e[j + 1] == (byte)39) { if (o < 790) { tb[o] = (byte)39; o++; }; j = j + 2; continue; }; };
                        break;
                    };
                    if (o < 790) { tb[o] = e[j]; o++; };
                    j++;
                };
                if (j != n - 1) { return 0 - 1; };
                v.t = SQ_TEXT; v.p = @tb[0]; v.n = o;
            }
            else
            {
                if ((e[0] == (byte)120 | e[0] == (byte)88) & n >= 3 & e[1] == (byte)39)
                {
                    if (sg == 1 | e[n - 1] != (byte)39) { return 0 - 1; };
                    v.t = SQ_BLOB; v.n = 1;
                }
                else
                {
                    if (sq_isdigit(e[0]) | e[0] == (byte)46)
                    {
                        if (n > 2 & e[0] == (byte)48 & (e[1] == (byte)120 | e[1] == (byte)88))
                        {
                            hv = (i64)0;
                            for (j = 2; j < n; j++)
                            {
                                hx = 0 - 1;
                                if (e[j] >= (byte)48 & e[j] <= (byte)57) { hx = (int)e[j] - 48; };
                                if (e[j] >= (byte)97 & e[j] <= (byte)102) { hx = (int)e[j] - 87; };
                                if (e[j] >= (byte)65 & e[j] <= (byte)70) { hx = (int)e[j] - 55; };
                                if (hx < 0) { return 0 - 1; };
                                hv = hv * (i64)16 + (i64)hx;
                            };
                            if (neg == 1) { hv = (i64)0 - hv; };
                            sq_val_int(@v, hv);
                        }
                        else
                        {
                            j = 0; dd = 0;
                            while (j < n & sq_isdigit(e[j])) { j++; dd++; };
                            if (j < n & e[j] == (byte)46) { j++; while (j < n & sq_isdigit(e[j])) { j++; dd++; }; };
                            if (dd == 0) { return 0 - 1; };
                            if (j < n & (e[j] == (byte)101 | e[j] == (byte)69))
                            {
                                j++;
                                if (j < n & (e[j] == (byte)43 | e[j] == (byte)45)) { j++; };
                                q = 0;
                                while (j < n & sq_isdigit(e[j])) { j++; q++; };
                                if (q == 0) { return 0 - 1; };
                            };
                            if (j != n) { return 0 - 1; };
                            o = 0;
                            if (neg == 1) { tb[0] = (byte)45; o = 1; };
                            for (j = 0; j < n & o < 790; j++) { tb[o] = e[j]; o++; };
                            sq_str2num(@tb[0], o, @v);
                        };
                    }
                    else
                    {
                        if (sg == 1) { return 0 - 1; };
                        if (n == 4 & (e[0] | (byte)32) == (byte)110 & (e[1] | (byte)32) == (byte)117 & (e[2] | (byte)32) == (byte)108 & (e[3] | (byte)32) == (byte)108) { sq_val_null(@v); v.n = 1; }
                        else
                        {
                            if (n == 4 & (e[0] | (byte)32) == (byte)116 & (e[1] | (byte)32) == (byte)114 & (e[2] | (byte)32) == (byte)117 & (e[3] | (byte)32) == (byte)101) { sq_val_int(@v, (i64)1); }
                            else
                            {
                                if (n == 5 & (e[0] | (byte)32) == (byte)102 & (e[1] | (byte)32) == (byte)97 & (e[2] | (byte)32) == (byte)108 & (e[3] | (byte)32) == (byte)115 & (e[4] | (byte)32) == (byte)101) { sq_val_int(@v, (i64)0); }
                                else { return 0 - 1; };
                            };
                        };
                    };
                };
            };
            o = 0;
            if (v.t == SQ_BLOB) { out[0] = (byte)40; out[1] = (byte)98; out[2] = (byte)108; out[3] = (byte)111; out[4] = (byte)98; out[5] = (byte)41; out[6] = (byte)0; return 6; };
            if (v.t == SQ_NULL) { out[0] = (byte)78; out[1] = (byte)85; out[2] = (byte)76; out[3] = (byte)76; out[4] = (byte)0; return 4; };
            if (ti.aff[col] == 1)
            {
                if (v.t == SQ_INTEGER | v.t == SQ_REAL)
                {
                    sq_sb_init(@sb);
                    if (v.t == SQ_INTEGER) { sq_sb_int(@sb, v.i); }
                    else
                    {
                        o = sq_real_g16(v.r, @tb[0]);
                        hasdot = 0;
                        for (j = 0; j < o; j++) { if (tb[j] == (byte)46 | tb[j] == (byte)101 | tb[j] == (byte)78 | tb[j] == (byte)73 | tb[j] == (byte)105) { hasdot = 1; }; };
                        sq_sb_add(@sb, @tb[0], o);
                        if (hasdot == 0) { sq_sb_lit(@sb, ".0\0"); };
                    };
                    for (j = 0; j < sb.n & j < 790; j++) { out[j] = sb.p[j]; };
                    out[j] = (byte)0;
                    j = sb.n;
                    sq_sb_free(@sb);
                    return j;
                };
            }
            else
            {
                if (ti.aff[col] != 0) { sq_apply_aff((SQ_ARENA*)0, ti.aff[col], @v); };
            };
            if (v.t == SQ_INTEGER)
            {
                sq_sb_init(@sb);
                sq_sb_int(@sb, v.i);
                for (j = 0; j < sb.n & j < 790; j++) { out[j] = sb.p[j]; };
                out[j] = (byte)0;
                j = sb.n;
                sq_sb_free(@sb);
                return j;
            };
            if (v.t == SQ_REAL) { return sq_real_g16(v.r, out); };
            if (v.t == SQ_TEXT)
            {
                for (j = 0; j < v.n & j < 790; j++) { out[j] = v.p[j]; };
                out[j] = (byte)0;
                return v.n;
            };
            return 0 - 1;
        };

        // the table column that a Column instruction on the cursor opened over root page rt reads at record position pos
        def sq_vd_cursorcol(SQLITE_DB* db, int rt, int pos, SQ_TI** pti) -> int
        {
            SQ_TI* ti;
            SQ_IDX[12] ixs;
            int j, tp, x, nx, a, c, k, isw;
            byte* sqlt;
            *pti = (SQ_TI*)0;
            tp = 0 - 1; x = 0 - 1;
            for (j = 0; j < db.nschema; j++)
            {
                if (db.schema[j].rootpage != rt) { continue; };
                if (db.schema[j].kind == 1) { tp = j; };
                if (db.schema[j].kind == 2) { x = j; };
            };
            if (tp < 0 & x < 0) { return 0 - 1; };
            if (x >= 0)
            {
                for (j = 0; j < db.nschema; j++)
                {
                    if (db.schema[j].kind != 1) { continue; };
                    if (sq_streq(db.schema[j].name, db.schema[x].tbl_name)) { tp = j; };
                };
            };
            if (tp < 0) { return 0 - 1; };
            sqlt = db.schema[tp].sql;
            if ((u64)sqlt == (u64)0) { return 0 - 1; };
            ti = (SQ_TI*)fmalloc((u64)(sizeof(SQ_TI) / 8 + 4096));
            if ((u64)ti == (u64)0) { return 0 - 1; };
            if (sq_ti_load(ti, sqlt) != 0) { ffree((u64)ti); return 0 - 1; };
            c = 0 - 1;
            if (x < 0)
            {
                if (ti.wor != 0)
                {
                    if (pos < ti.npk) { c = ti.pkc[pos]; }
                    else
                    {
                        k = pos - ti.npk;
                        for (j = 0; j < ti.ncols; j++)
                        {
                            isw = 0;
                            for (a = 0; a < ti.npk; a++) { if (ti.pkc[a] == j) { isw = 1; }; };
                            if (isw == 1) { continue; };
                            if (k == 0) { c = j; break; };
                            k--;
                        };
                    };
                }
                else { c = pos; };
            }
            else
            {
                nx = sq_idx_list(db, tp, ti, @ixs[0], 12);
                for (j = 0; j < nx; j++)
                {
                    if (ixs[j].root != rt) { continue; };
                    if (pos < ixs[j].nk) { if (ixs[j].isx[pos] == 0) { c = ixs[j].col[pos]; }; }
                    else { if (ti.wor != 0 & pos - ixs[j].nk < ti.npk) { c = ti.pkc[pos - ixs[j].nk]; }; };
                };
            };
            if (c < 0 | c >= ti.ncols) { ffree((u64)ti); return 0 - 1; };
            *pti = ti;
            return c;
        };

        // adds the column defaults to the P4 of Column instructions over real tables and indexes
        def sq_vd_dflpass() -> void
        {
            int[128] cr;
            byte[800] buf;
            SQ_TI* ti;
            byte* nm;
            int a, c, n, cu;
            if ((u64)VD_DB == (u64)0) { return; };
            for (a = 0; a < 128; a++) { cr[a] = 0 - 1; };
            for (a = 0; a < VD_N; a++)
            {
                nm = @VD_TXT[VD_O[a]];
                cu = VD_P1[a];
                if (cu < 0 | cu >= 128) { continue; };
                if (sq_streq(nm, "OpenRead\0") | sq_streq(nm, "OpenWrite\0")) { cr[cu] = VD_P2[a]; continue; };
                if (sq_streq(nm, "OpenEphemeral\0") | sq_streq(nm, "OpenAutoindex\0") | sq_streq(nm, "OpenPseudo\0") | sq_streq(nm, "SorterOpen\0")) { cr[cu] = 0 - 1; continue; };
                if (sq_streq(nm, "Column\0") == false) { continue; };
                if (VD_P4[a] >= 0 | cr[cu] <= 1) { continue; };
                c = sq_vd_cursorcol(VD_DB, cr[cu], VD_P2[a], @ti);
                if (c < 0) { continue; };
                n = sq_vd_dflp4(ti, c, @buf[0]);
                ffree((u64)ti);
                if (n >= 0) { sq_vd_p4s(a, @buf[0], n); };
            };
        };

        def sq_vd_query(byte** pq) -> void
        {
            sq_vd_dflpass();
            SQ_SB q;
            int a, i;
            byte c;
            sq_sb_init(@q);
            sq_sb_lit(@q, "select * from (select null as addr, null as opcode, null as p1, null as p2, null as p3, null as p4, null as p5, null as comment where 0\0");
            for (a = 0; a < VD_N; a++)
            {
                sq_sb_lit(@q, " union all select \0");
                sq_sb_int(@q, (i64)a);
                sq_sb_lit(@q, ", '\0");
                sq_sb_add(@q, @VD_TXT[VD_O[a]], sq_cstrlen(@VD_TXT[VD_O[a]]));
                sq_sb_lit(@q, "', \0");
                sq_sb_int(@q, (i64)VD_P1[a]);
                sq_sb_lit(@q, ", \0");
                sq_sb_int(@q, (i64)VD_P2[a]);
                sq_sb_lit(@q, ", \0");
                sq_sb_int(@q, (i64)VD_P3[a]);
                sq_sb_lit(@q, ", \0");
                if (VD_P4[a] < 0) { sq_sb_lit(@q, "null\0"); }
                else
                {
                    sq_sb_lit(@q, "'\0");
                    i = VD_P4[a];
                    while (VD_TXT[i] != (byte)0)
                    {
                        c = VD_TXT[i];
                        if (c == (byte)39) { sq_sb_lit(@q, "''\0"); } else { sq_sb_add(@q, @VD_TXT[i], 1); };
                        i++;
                    };
                    sq_sb_lit(@q, "'\0");
                };
                sq_sb_lit(@q, ", \0");
                sq_sb_int(@q, (i64)VD_P5[a]);
                sq_sb_lit(@q, ", null\0");
            };
            sq_sb_lit(@q, ")\0");
            *pq = q.p;
        };

        // one literal result column into register reg; 1 when the node is not a literal
        def sq_vd_lit(SQ_STMT* g, int ni, int reg) -> int
        {
            SQ_NODE* nd;
            int a, n;
            if (ni >= 100000) { g = (SQ_STMT*)VD_XG[ni / 100000 - 1]; ni = ni % 100000; };
            nd = @g.nodes[ni];
            SQ_SB t;
            byte[40] nb;
            byte[400] gbuf;
            if (nd.kind == SQN_INT)
            {
                if (nd.iv >= (0 - 2147483648) & nd.iv <= 2147483647)
                {
                    sq_vd_op("Integer\0", (int)nd.iv, reg, 0);
                }
                else
                {
                    a = sq_vd_op("Int64\0", 0, reg, 0);
                    sq_sb_init(@t);
                    sq_sb_int(@t, nd.iv);
                    sq_vd_p4s(a, t.p, t.n);
                    sq_sb_free(@t);
                };
                return 0;
            };
            if (nd.kind == SQN_REAL)
            {
                a = sq_vd_op("Real\0", 0, reg, 0);
                sq_sb_init(@t);
                n = sq_real_g16(nd.rv, @gbuf[0]);
                sq_sb_add(@t, @gbuf[0], n);
                sq_vd_p4s(a, t.p, t.n);
                sq_sb_free(@t);
                return 0;
            };
            if (nd.kind == SQN_STR)
            {
                a = sq_vd_op("String8\0", 0, reg, 0);
                sq_sb_init(@t);
                n = 0;
                while (n < nd.sl)
                {
                    sq_sb_add(@t, @g.sql[nd.s + n], 1);
                    if (n + 1 < nd.sl & g.sql[nd.s + n] == (byte)39 & g.sql[nd.s + n + 1] == (byte)39) { n++; };
                    n++;
                };
                sq_vd_p4s(a, t.p, t.n);
                sq_sb_free(@t);
                return 0;
            };
            if (nd.kind == SQN_NULL) { sq_vd_op("Null\0", 0, reg, 0); return 0; };
            return 1;
        };

        global int VD_GLC = 0;
        global u64[8] VD_XG;
        global int VD_XGN = 0;
        global int VD_RGB = 0;
        global int VD_RGR = 0;
        global u64 VD_IXST = (u64)0;
        global u64 VD_IXNM = (u64)0;
        global int VD_IXNL = 0;
        global int VD_PURE = 0;
        // range bound term: a plain comparison, or a GLOB term whose constant prefix gives the bounds
        def sq_vd_rlit(SQ_STMT* g, int ni, int reg, int role) -> int
        {
            byte[260] bf;
            int cp, n, a;
            if (g.nodes[ni].kind == SQN_ISNULL) { sq_vd_op("Null\0", 0, reg, 0); return 0; };
            if (g.nodes[ni].kind != SQN_LIKE) { return sq_vd_lit(g, g.nodes[ni].b, reg); };
            n = sq_eqp_globpfx(g, ni, @bf[0], @cp);
            if (role == 1) { bf[n - 1] = bf[n - 1] + (byte)1; };
            a = sq_vd_op("String8\0", 0, reg, VD_GLC);
            sq_vd_p4s(a, @bf[0], n);
            return 0;
        };

        global int VD_TKA = 0;
        // an integer key literal compared with a text index column gets the column affinity applied
        def sq_vd_tka(SQ_STMT* g, SQ_TI* ti, int ni, int reg) -> void
        {
            int a;
            byte[2] nb;
            if (VD_TKA != 1) { return; };
            if (g.nodes[ni].kind != SQN_BIN) { return; };
            if (g.nodes[g.nodes[ni].b].kind != SQN_INT) { return; };
            if (g.nodes[g.nodes[ni].a].kind != SQN_COL) { return; };
            if (ti.aff[g.nodes[g.nodes[ni].a].col] != 1) { return; };
            nb[0] = (byte)66; nb[1] = (byte)0;
            a = sq_vd_op("Affinity\0", reg, 1, 0);
            sq_vd_p4s(a, @nb[0], 1);
        };

        def sq_vd_rop(SQ_STMT* g, int ni, int role) -> int
        {
            if (g.nodes[ni].kind == SQN_ISNULL) { return SQO_GT; };
            if (g.nodes[ni].kind != SQN_LIKE) { return g.nodes[ni].op; };
            if (role == 0) { return SQO_GE; };
            return SQO_LT;
        };

        // header of the closing section: Transaction for statements that touch a table
        global SQLITE_DB* VD_DB;

        // UPDATE OR <mode>: 0 abort, 1 replace, 2 ignore, 3 fail, 4 rollback; ignore turns a constraint Halt into a Goto to the loop continue
        global int VD_UMODE;
        global int[16] VD_UIG;
        global int[16] VD_UIK;
        global int VD_NUIG;
        def sq_vd_uhalt(int a) -> void
        {
            if (VD_UMODE == 3) { VD_P2[a] = 3; };
            if (VD_UMODE == 4) { VD_P2[a] = 1; };
            if (VD_UMODE == 2 & VD_NUIG < 16)
            {
                VD_UIG[VD_NUIG] = a;
                VD_UIK[VD_NUIG] = 1;
                VD_NUIG++;
            };
        };

        // the NOT NULL check of an UPDATE OR <mode>: ignore skips the row with IsNull
        def sq_vd_uhaltn(int a) -> void
        {
            if (VD_UMODE == 3) { VD_P2[a] = 3; };
            if (VD_UMODE == 4) { VD_P2[a] = 1; };
            if (VD_UMODE == 2 & VD_NUIG < 16)
            {
                VD_UIG[VD_NUIG] = a;
                VD_UIK[VD_NUIG] = 2;
                VD_NUIG++;
            };
        };

        // patches the ignore Gotos once the final Halt is in place: the target is the last Next of the program, else the Halt
        def sq_vd_uigfin() -> void
        {
            int k, x, tg;
            if (VD_NUIG == 0) { return; };
            tg = VD_N - 1;
            for (x = VD_N - 2; x > VD_UIG[0]; x--)
            {
                if (VD_O[x] >= 0) { if (sq_streq(@VD_TXT[VD_O[x]], "Next\0")) { tg = x; }; };
            };
            for (k = 0; k < VD_NUIG; k++)
            {
                x = VD_UIG[k];
                if (VD_UIK[k] == 2)
                {
                    VD_O[x] = sq_vd_txt("IsNull\0", 6);
                    VD_P1[x] = VD_P3[x]; VD_P2[x] = tg; VD_P3[x] = 0; VD_P4[x] = 0 - 1; VD_P5[x] = 0;
                }
                else
                {
                    VD_O[x] = sq_vd_txt("Goto\0", 4);
                    VD_P1[x] = 0; VD_P2[x] = tg; VD_P3[x] = 0; VD_P4[x] = 0 - 1; VD_P5[x] = 0;
                };
            };
            VD_NUIG = 0;
        };

        def sq_vd_trans(SQLITE_DB* db, int write) -> void
        {
            int a;
            VD_DB = db;
            sq_vd_uigfin();
            a = sq_vd_op("Transaction\0", 0, write, db.cookie);
            sq_vd_p4i(a, 0);
            VD_P5[a] = 1;
        };

        // register allocation as SQLite's: registers only grow, temporaries are recycled through a small stack
        global int VD_NMEM = 0;
        global int VD_NFREE = 0;
        global int[8] VD_FREE;
        global int VD_NH = 0;
        global int VD_NOHOIST = 0;
        global int VD_TEMPDB = 0;
        global int VD_DDESC = 0;
        global int VD_GDIST = 0, VD_DISTRED = 0, VD_CMAPON = 0, VD_XS = 0, VD_XCUR = 0, VD_ORDPIN = 0, VD_PINDEP = 0, VD_ORDORIG = 0, VD_PINPART = 0, VD_WMIX = 0, VD_NOWOR = 0, VD_NODUP = 0, VD_GOFFN = 0;
        global int[64] VD_GOFF;
        global int[16] VD_OO, VD_OD, VD_OC, VD_ON;
        global int[128] VD_CMAP;
        global SQ_TI* VD_XTI;
        global int[64] VD_HN;
        global int[64] VD_HR;
        global int[64] VD_HEP;
        global int[64] VD_HKI;
        global i64[64] VD_HIV;
        global u64[64] VD_HGP;
        global int[64] VD_HF;
        global int VD_NJ = 0;
        global int[32] VD_JF;
        global int VD_COLCUR = 0;
        global int VD_ROWIDCOL = 0;
        global int VD_IDXCUR = 0;
        global int VD_IDXCOL = 0;
        global int[128] VD_IXM;

        // position of a table column in the key of the index being read, -1 when it is not in it
        def sq_vd_ixpos(int col) -> int
        {
            if (col < 0 | col >= 128) { return 0 - 1; };
            return VD_IXM[col];
        };

        // the position of a table column in the record of an index, or of the table itself when it is WITHOUT ROWID; -1 when absent
        def sq_vd_ixcol(SQ_IDX* ix, int col) -> int
        {
            int a;
            if (col < 0 | col >= 128) { return 0 - 1; };
            if (VD_ISWOR == 1) { return VD_WORM[col]; };
            for (a = 0; a < ix.nk; a++) { if (ix.col[a] == col) { return a; }; };
            return 0 - 1;
        };

        def sq_vd_setix(SQ_IDX* ix) -> void
        {
            int i;
            if (VD_ISWOR == 1) { for (i = 0; i < 128; i++) { VD_IXM[i] = VD_WORM[i]; }; return; };
            for (i = 0; i < 128; i++) { VD_IXM[i] = 0 - 1; };
            for (i = ix.nk - 1; i >= 0; i--) { if (ix.col[i] >= 0 & ix.col[i] < 128) { VD_IXM[ix.col[i]] = i; }; };
        };

        def sq_vd_colrd(int col, int r) -> int
        {
            if (VD_CMAPON == 1) { return sq_vd_op("Column\0", VD_COLCUR, VD_CMAP[col], r); };
            return sq_vd_op("Column\0", VD_COLCUR, col, r);
        };

        def sq_vd_getreg() -> int
        {
            if (VD_NFREE > 0) { VD_NFREE--; return VD_FREE[VD_NFREE]; };
            VD_NMEM++;
            return VD_NMEM;
        };

        def sq_vd_putreg(int r) -> void
        {
            if (VD_NFREE < 8) { VD_FREE[VD_NFREE] = r; VD_NFREE++; };
        };

        // a run of consecutive registers: a single register comes from the free stack, longer runs from the spare run or fresh
        def sq_vd_getrange(int n) -> int
        {
            int r;
            if (n == 1) { return sq_vd_getreg(); };
            if (n <= VD_RN)
            {
                r = VD_RR;
                VD_RN = VD_RN - n;
                VD_RR = VD_RR + n;
                return r;
            };
            r = VD_NMEM + 1;
            VD_NMEM = VD_NMEM + n;
            return r;
        };

        def sq_vd_putrange(int r, int n) -> void
        {
            if (n == 1) { sq_vd_putreg(r); return; };
            if (n > VD_RN) { VD_RN = n; VD_RR = r; };
        };

        def sq_vd_isconst(SQ_STMT* g, int ni) -> bool
        {
            int k = g.nodes[ni].kind;
            return k == SQN_INT | k == SQN_REAL | k == SQN_STR | k == SQN_NULL;
        };

        // 0 coded, 1 unsupported. Column references read from the cursor given in VD_COLCUR
        def sq_vd_expr(SQ_STMT* g, SQ_TI* ti, int ni, int target) -> int;
        def sq_vd_affch(int aff) -> int;
        def sq_vd_setv(SQ_STMT* g, SQ_TI* ti, int ni, int reg) -> int;
        def sq_vd_leads(SQ_SRC* sr, int col) -> int;
        def sq_vd_ipkpin(SQ_STMT* g, int* cj, int ncj) -> int;
        def sq_vd_samecol(SQ_STMT* g, int* cj, int ncj) -> int;
        def sq_vd_allled(SQ_STMT* g, SQ_SRC* sr, int ni, int* ok) -> void;
        def sq_vd_bothlead(SQ_STMT* g, int* cj, int ncj) -> int;
        def sq_vd_trans2(SQ_STMT* g, int* cj, int ncj) -> int;
        def sq_vd_ufield(int a) -> int;
        def sq_vd_gon(int n) -> int;
        def sq_vd_inemit(SQ_STMT* st, SQ_STMT* g, int ephno, int la) -> int;

        // true when two literal nodes are the same constant
        def sq_vd_same(SQ_STMT* g, int n1, int n2) -> bool
        {
            SQ_NODE* a = @g.nodes[n1];
            SQ_NODE* b = @g.nodes[n2];
            int i;
            if (a.kind != b.kind) { return false; };
            if (a.kind == SQN_INT) { return a.iv == b.iv; };
            if (a.kind == SQN_NULL) { return true; };
            if (a.kind == SQN_REAL | a.kind == SQN_STR)
            {
                if (a.sl != b.sl) { return false; };
                for (i = 0; i < a.sl; i++) { if (g.sql[a.s + i] != g.sql[b.s + i]) { return false; }; };
                return true;
            };
            return false;
        };

        // register of a constant already queued for the end of the program, or 0
        def sq_vd_findconst(SQ_STMT* g, int ni) -> int
        {
            int i;
            SQ_NODE* nd = @g.nodes[ni];
            for (i = 0; i < VD_NH; i++)
            {
                if (VD_HN[i] < 0 | VD_HF[i] != 0) { continue; };
                if (VD_HEP[i] == VD_EPOCH & VD_HGP[i] == (u64)g & VD_HN[i] < 100000) { if (sq_vd_same(g, VD_HN[i], ni)) { return VD_HR[i]; }; continue; };
                if (VD_HEP[i] == VD_EPOCH & VD_HGP[i] != (u64)g & VD_HGP[i] != (u64)0)
                {
                    if (VD_HKI[i] == SQN_INT & nd.kind == SQN_INT) { if (VD_HIV[i] == nd.iv) { return VD_HR[i]; }; };
                    continue;
                };
                if (VD_HN[i] < 100000 & VD_HEP[i] != VD_EPOCH) { if (sq_vd_same(g, VD_HN[i], ni)) { return VD_HR[i]; }; };
            };
            return 0;
        };

        // an operand: constants are computed once at the end of the program, anything else lands in a temporary
        def sq_vd_operand(SQ_STMT* g, SQ_TI* ti, int ni, int* reg, int* tmp) -> int
        {
            int r;
            if (VD_NOHOIST == 0 & sq_vd_isconst(g, ni))
            {
                r = sq_vd_findconst(g, ni);
                if (r > 0) { *reg = r; *tmp = 0; return 0; };
                VD_NMEM++;
                r = VD_NMEM;
                if (VD_NH >= 64) { return 1; };
                VD_HF[VD_NH] = 0; VD_HN[VD_NH] = ni; VD_HR[VD_NH] = r;
                VD_HEP[VD_NH] = VD_EPOCH; VD_HGP[VD_NH] = (u64)g; VD_HKI[VD_NH] = g.nodes[ni].kind; VD_HIV[VD_NH] = g.nodes[ni].iv;
                VD_NH++;
                *reg = r; *tmp = 0;
                return 0;
            };
            if (VD_RGB > 0)
            {
                if (g.nodes[ni].kind == SQN_COL)
                {
                    r = g.nodes[ni].col;
                    if (r >= 0 & r < ti.ncols & r != ti.ipk & ti.aff[r] != 4) { *reg = VD_RGB + r; *tmp = 0; return 0; };
                    if (r >= 0 & r < ti.ncols & r == ti.ipk) { *reg = VD_RGR; *tmp = 0; return 0; };
                };
            };
            r = sq_vd_getreg();
            if (sq_vd_expr(g, ti, ni, r) != 0) { return 1; };
            *reg = r; *tmp = r;
            return 0;
        };

        // CASE expression over column and literal comparisons
        def sq_vd_case(SQ_STMT* g, SQ_TI* ti, int ni, int target) -> int
        {
            SQ_NODE* nd = @g.nodes[ni];
            SQ_NODE* w;
            SQ_NODE* cn;
            int[8] gj;
            int ng, wi, rb, rd, r1, r2, t1, t2, a, nx, col, op;
            byte* nm;
            ng = 0;
            rb = 0;
            if (nd.a >= 0)
            {
                if (g.nodes[nd.a].kind != SQN_COL) { return 1; };
                col = g.nodes[nd.a].col;
                if (col >= ti.ncols | col == ti.ipk) { return 1; };
                if (ti.coll[col] != 0) { return 1; };
                rb = sq_vd_getreg();
                rd = sq_vd_getreg();
                if (sq_vd_expr(g, ti, nd.a, rb) != 0) { return 1; };
            };
            for (wi = nd.b; wi >= 0; wi = g.nodes[wi].next)
            {
                if (ng >= 8) { return 1; };
                w = @g.nodes[wi];
                if (nd.a >= 0)
                {
                    if (sq_vd_isconst(g, w.a) == false) { return 1; };
                    if (g.nodes[w.a].kind == SQN_NULL) { return 1; };
                    if (sq_vd_operand(g, ti, w.a, @r2, @t2) != 0) { return 1; };
                    a = sq_vd_op("Ne\0", r2, 0, rb);
                    sq_vd_p4s(a, "BINARY-8\0", 8);
                    VD_P5[a] = 16 + sq_vd_affch(ti.aff[col]);
                    if (t2 != 0) { sq_vd_putreg(t2); };
                }
                else
                {
                    cn = @g.nodes[w.a];
                    if (cn.kind != SQN_BIN) { return 1; };
                    op = cn.op;
                    nm = (byte*)0;
                    if (op == SQO_EQ) { nm = "Ne\0"; };
                    if (op == SQO_NE) { nm = "Eq\0"; };
                    if (op == SQO_LT) { nm = "Ge\0"; };
                    if (op == SQO_LE) { nm = "Gt\0"; };
                    if (op == SQO_GT) { nm = "Le\0"; };
                    if (op == SQO_GE) { nm = "Lt\0"; };
                    if ((u64)nm == (u64)0) { return 1; };
                    if (g.nodes[cn.a].kind != SQN_COL | sq_vd_isconst(g, cn.b) == false) { return 1; };
                    if (g.nodes[cn.b].kind == SQN_NULL) { return 1; };
                    col = g.nodes[cn.a].col;
                    if (col >= ti.ncols) { return 1; };
                    if (col != ti.ipk) { if (ti.coll[col] != 0) { return 1; }; };
                    if (sq_vd_operand(g, ti, cn.a, @r1, @t1) != 0) { return 1; };
                    if (sq_vd_operand(g, ti, cn.b, @r2, @t2) != 0) { return 1; };
                    a = sq_vd_op(nm, r2, 0, r1);
                    if (col != ti.ipk) { sq_vd_p4s(a, "BINARY-8\0", 8); VD_P5[a] = 16 + sq_vd_affch(ti.aff[col]); }
                    else { VD_P5[a] = 16 + sq_vd_affch(3); };
                    if (t1 != 0) { sq_vd_putreg(t1); };
                    if (t2 != 0) { sq_vd_putreg(t2); };
                };
                nx = a;
                if (sq_vd_expr(g, ti, w.b, target) != 0) { return 1; };
                gj[ng] = sq_vd_op("Goto\0", 0, 0, 0);
                ng++;
                VD_P2[nx] = VD_N;
            };
            if (nd.c >= 0) { if (sq_vd_expr(g, ti, nd.c, target) != 0) { return 1; }; }
            else { sq_vd_op("Null\0", 0, target, 0); };
            for (wi = 0; wi < ng; wi++) { VD_P2[gj[wi]] = VD_N; };
            if (rb > 0) { sq_vd_putreg(rd); sq_vd_putreg(rb); };
            return 0;
        };

        // coalesce / ifnull: the first argument that is not NULL
        def sq_vd_coalesce(SQ_STMT* g, SQ_TI* ti, int ni, int target) -> int
        {
            SQ_NODE* nd = @g.nodes[ni];
            int[8] nj;
            int na, an, i, k;
            na = (int)nd.iv;
            if (na < 2 | na > 8) { return 1; };
            an = nd.a;
            k = 0;
            for (i = 0; i < na; i++)
            {
                if (sq_vd_expr(g, ti, an, target) != 0) { return 1; };
                if (i < na - 1) { nj[k] = sq_vd_op("NotNull\0", target, 0, 0); k++; };
                an = g.nodes[an].next;
            };
            for (i = 0; i < k; i++) { VD_P2[nj[i]] = VD_N; };
            return 0;
        };

        // scalar function call: arguments in consecutive registers, constant arguments hoisted into their own register
        global byte[48] VD_NB;
        global int VD_NBN = 0;
        // builds the lower-case name(n) text shown for a function call in VD_NB
        def sq_vd_funcname(SQ_STMT* g, SQ_NODE* nd, int fid, int na, int dummy) -> int
        {
            int i, k, nn, vn, vj;
            vn = na; vj = 0;
            if (nd.sl > 30) { return 1; };
            for (i = 0; i < nd.sl; i++)
            {
                k = (int)g.sql[nd.s + i];
                if (k >= 65 & k <= 90) { k = k + 32; };
                VD_NB[i] = (byte)k;
            };
            nn = nd.sl;
            VD_NB[nn] = (byte)0;
            if (sq_streq(@VD_NB[0], "json_extract\0") | sq_streq(@VD_NB[0], "json_array\0") | sq_streq(@VD_NB[0], "json_object\0") | sq_streq(@VD_NB[0], "json_set\0") | sq_streq(@VD_NB[0], "json_insert\0") | sq_streq(@VD_NB[0], "json_replace\0") | sq_streq(@VD_NB[0], "json_remove\0") | sq_streq(@VD_NB[0], "json_array_insert\0") | sq_streq(@VD_NB[0], "jsonb_extract\0") | sq_streq(@VD_NB[0], "jsonb_array\0") | sq_streq(@VD_NB[0], "jsonb_object\0") | sq_streq(@VD_NB[0], "jsonb_set\0") | sq_streq(@VD_NB[0], "jsonb_insert\0") | sq_streq(@VD_NB[0], "jsonb_replace\0") | sq_streq(@VD_NB[0], "jsonb_remove\0") | sq_streq(@VD_NB[0], "jsonb_array_insert\0")) { vj = 1; };
            VD_NB[nn] = (byte)40; nn++;
            if (vj == 1) { VD_NB[nn] = (byte)45; nn++; vn = 1; };
            if (fid == 19 | fid == 21 | fid == 31 | fid == 32 | fid == 33 | fid == 34 | fid == 35 | fid == 36 | fid == 11 | fid == 12) { VD_NB[nn] = (byte)45; nn++; vn = 1; };
            if (fid == 11 | fid == 12) { VD_NB[nn] = (byte)51; nn++; }
            else { VD_NB[nn] = (byte)(48 + vn); nn++; };
            VD_NB[nn] = (byte)41; nn++;
            VD_NB[nn] = (byte)0;
            VD_NBN = nn;
            return 0;
        };

        def sq_vd_func(SQ_STMT* g, SQ_TI* ti, int ni, int target) -> int
        {
            SQ_NODE* nd = @g.nodes[ni];
            byte[40] nb;
            int fid, na, i, an, r0, mask, nconst, a, k, bit, once, tmp;
            int[8] args;
            if (nd.win >= 0 | nd.col >= 100 | nd.op != 0) { return 1; };
            fid = sq_func_id(@g.sql[nd.s], nd.sl, (int)nd.iv);
            if (fid == 1 | fid == 2) { return sq_vd_coalesce(g, ti, ni, target); };
            if (fid == 27)
            {
                // iif(x, a, b) is CASE WHEN x THEN a ELSE b END
                if ((int)nd.iv != 3) { return 1; };
                an = nd.a;
                k = sq_newnode(g, SQN_CASE);
                i = sq_newnode(g, SQN_BIN);
                if (k < 0 | i < 0) { return 1; };
                nd = @g.nodes[ni];
                g.nodes[i] = g.nodes[an];
                g.nodes[i].a = an;
                g.nodes[i].b = g.nodes[an].next;
                g.nodes[i].next = 0 - 1;
                g.nodes[k] = g.nodes[ni];
                g.nodes[k].kind = SQN_CASE;
                g.nodes[k].a = 0 - 1;
                g.nodes[k].b = i;
                g.nodes[k].c = g.nodes[g.nodes[an].next].next;
                g.nodes[k].next = 0 - 1;
                return sq_vd_case(g, ti, k, target);
            };
            if (fid < 3 | fid >= 100 | fid == 28 | fid == 29) { return 1; };
            na = (int)nd.iv;
            if (na < 0 | na > 6 | nd.sl > 30) { return 1; };
            an = nd.a;
            nconst = 0;
            for (i = 0; i < na; i++)
            {
                if (an < 0) { return 1; };
                args[i] = an;
                if (sq_vd_isconst(g, an)) { nconst++; };
                an = g.nodes[an].next;
            };
            if (fid == 59 | fid == 72 | fid == 73)
            {
                if (na < 1) { return 1; };
                return sq_vd_expr(g, ti, args[0], target);
            };
            if (fid == 9 & na != 2) { return 1; };
            if ((fid == 11 | fid == 12) & na < 2) { return 1; };
            if (nconst == na & fid != 23 & fid != 24 & fid != 40 & fid != 41 & fid != 42)
            {
                once = sq_vd_op("Once\0", 0, 0, 0);
                tmp = sq_vd_getreg();
                r0 = 0;
                if (na > 0) { r0 = sq_vd_getrange(na); };
                mask = 0; bit = 1;
                for (i = 0; i < na; i++)
                {
                    if (sq_vd_lit(g, args[i], r0 + i) != 0) { return 1; };
                    mask = mask + bit;
                    bit = bit * 2;
                };
                if (sq_vd_funcname(g, nd, fid, na, 0 - 1) != 0) { return 1; };
                a = sq_vd_fnop(mask, r0, tmp);
                sq_vd_p4s(a, @VD_NB[0], VD_NBN);
                VD_P2[once] = VD_N;
                sq_vd_op("Copy\0", tmp, target, 0);
                return 0;
            };
            r0 = sq_vd_getrange(na);
            mask = 0; bit = 1;
            for (i = 0; i < na; i++)
            {
                if (sq_vd_isconst(g, args[i]))
                {
                    if (VD_NH >= 64) { return 1; };
                    VD_HF[VD_NH] = 1; VD_HN[VD_NH] = args[i]; VD_HR[VD_NH] = r0 + i; VD_HEP[VD_NH] = 0; VD_NH++;
                    mask = mask + bit;
                }
                else
                {
                    if (sq_vd_expr(g, ti, args[i], r0 + i) != 0) { return 1; };
                    if ((fid == 5 | fid == 3) & g.nodes[args[i]].kind == SQN_COL) { if (g.nodes[args[i]].col < ti.ncols & g.nodes[args[i]].col != ti.ipk) { if (ti.aff[g.nodes[args[i]].col] != 4) { if (fid == 5) { VD_P5[VD_N - 1] = 64; } else { VD_P5[VD_N - 1] = 128; }; }; }; };
                };
                bit = bit * 2;
            };
            if (fid == 9 | fid == 11 | fid == 12) { a = sq_vd_op("CollSeq\0", 0, 0, 0); sq_vd_p4s(a, "BINARY-8\0", 8); };
            if (sq_vd_funcname(g, nd, fid, na, 0 - 1) != 0) { return 1; };
            a = sq_vd_fnop(mask, r0, target);
            sq_vd_p4s(a, @VD_NB[0], VD_NBN);
            if (nconst == 0) { sq_vd_putrange(r0, na); };
            return 0;
        };

        def sq_vd_expr(SQ_STMT* g, SQ_TI* ti, int ni, int target) -> int
        {
            SQ_NODE* nd = @g.nodes[ni];
            int r1, r2, t1, t2, op, col, zn, un;
            byte* nm;
            if (nd.kind == SQN_COL & VD_XS > 0)
            {
                if (nd.src == VD_XS - 1)
                {
                    if (nd.col == VD_XTI.ipk | nd.col == VD_XTI.ncols) { sq_vd_op("IdxRowid\0", VD_XCUR, target, 0); return 0; };
                    if (VD_CMAP[nd.col] < 0) { return 1; };
                    sq_vd_op("Column\0", VD_XCUR, VD_CMAP[nd.col], target);
                    if (VD_XTI.aff[nd.col] == 4) { sq_vd_op("RealAffinity\0", target, 0, 0); };
                    return 0;
                };
            };
            if (VD_RGB > 0)
            {
                if (nd.kind == SQN_ROWID | (nd.kind == SQN_COL & nd.col == ti.ncols)) { return 1; };
                if (nd.kind == SQN_COL)
                {
                    if (nd.col < 0 | nd.col > ti.ncols) { return 1; };
                    if (nd.col == ti.ipk) { sq_vd_op("SCopy\0", VD_RGR, target, 0); return 0; };
                    sq_vd_op("SCopy\0", VD_RGB + nd.col, target, 0);
                    if (ti.aff[nd.col] == 4) { sq_vd_op("RealAffinity\0", target, 0, 0); };
                    return 0;
                };
            };
            if (nd.kind == SQN_ROWID | (nd.kind == SQN_COL & (nd.col == ti.ipk | nd.col == ti.ncols)))
            {
                if (VD_IDXCUR > 0) { sq_vd_op("IdxRowid\0", VD_IDXCUR, target, 0); } else { sq_vd_op("Rowid\0", VD_COLCUR, target, 0); };
                return 0;
            };
            if (nd.kind == SQN_COL)
            {
                if (VD_IDXCUR > 0 & sq_vd_ixpos(nd.col) >= 0) { sq_vd_op("Column\0", VD_IDXCUR, sq_vd_ixpos(nd.col), target); } else { sq_vd_colrd(nd.col, target); };
                if (ti.aff[nd.col] == 4) { sq_vd_op("RealAffinity\0", target, 0, 0); };
                return 0;
            };
            if (sq_vd_isconst(g, ni)) { return sq_vd_lit(g, ni, target); };
            if (nd.kind == SQN_BIN & (nd.op < SQO_EQ | nd.op == SQO_CAT))
            {
                op = nd.op;
                nm = (byte*)0;
                if (op == SQO_ADD) { nm = "Add\0"; };
                if (op == SQO_SUB) { nm = "Subtract\0"; };
                if (op == SQO_MUL) { nm = "Multiply\0"; };
                if (op == SQO_DIV) { nm = "Divide\0"; };
                if (op == SQO_MOD) { nm = "Remainder\0"; };
                if (op == SQO_CAT) { nm = "Concat\0"; };
                if ((u64)nm == (u64)0) { return 1; };
                if (sq_vd_operand(g, ti, nd.a, @r1, @t1) != 0) { return 1; };
                if (sq_vd_operand(g, ti, nd.b, @r2, @t2) != 0) { return 1; };
                sq_vd_op(nm, r2, r1, target);
                if (t1 != 0) { sq_vd_putreg(t1); };
                if (t2 != 0) { sq_vd_putreg(t2); };
                return 0;
            };
            if (nd.kind == SQN_UNARY)
            {
                op = nd.op;
                un = nd.a;
                if (op == 4) { return sq_vd_expr(g, ti, un, target); };
                if (op == 1)
                {
                    zn = sq_newnode(g, SQN_INT);
                    if (zn < 0) { return 1; };
                    g.nodes[zn].iv = (i64)0;
                    if (sq_vd_operand(g, ti, zn, @r1, @t1) != 0) { return 1; };
                    if (sq_vd_operand(g, ti, un, @r2, @t2) != 0) { return 1; };
                    sq_vd_op("Subtract\0", r2, r1, target);
                    if (t1 != 0) { sq_vd_putreg(t1); };
                    if (t2 != 0) { sq_vd_putreg(t2); };
                    return 0;
                };
                if (op == 2 | op == 3)
                {
                    if (g.nodes[un].kind == SQN_BIN) { if (g.nodes[un].op >= SQO_EQ & g.nodes[un].op != SQO_CAT & (g.nodes[un].op < SQO_BAND)) { return 1; }; };
                    if (g.nodes[un].kind != SQN_COL & g.nodes[un].kind != SQN_BIN & g.nodes[un].kind != SQN_FUNC & g.nodes[un].kind != SQN_UNARY) { return 1; };
                    if (sq_vd_operand(g, ti, un, @r2, @t2) != 0) { return 1; };
                    if (op == 2) { sq_vd_op("Not\0", r2, target, 0); } else { sq_vd_op("BitNot\0", r2, target, 0); };
                    if (t2 != 0) { sq_vd_putreg(t2); };
                    return 0;
                };
                return 1;
            };
            if (nd.kind == SQN_FUNC)
            {
                return sq_vd_func(g, ti, ni, target);
            };
            if (nd.kind == SQN_CASE)
            {
                return sq_vd_case(g, ti, ni, target);
            };
            if (nd.kind == SQN_COLLATE)
            {
                if (g.nodes[nd.a].kind != SQN_COL) { return 1; };
                return sq_vd_expr(g, ti, nd.a, target);
            };
            if (nd.kind == SQN_ISNULL)
            {
                if (g.nodes[nd.a].kind != SQN_COL) { return 1; };
                sq_vd_op("Integer\0", 1, target, 0);
                r1 = sq_vd_getreg();
                if (sq_vd_expr(g, ti, nd.a, r1) != 0) { return 1; };
                if (nd.op == 1) { op = sq_vd_op("IsNull\0", r1, 0, 0); } else { op = sq_vd_op("NotNull\0", r1, 0, 0); };
                sq_vd_op("Integer\0", 0, target, 0);
                VD_P2[op] = VD_N;
                sq_vd_putreg(r1);
                return 0;
            };
            if (nd.kind == SQN_CAST)
            {
                if (g.nodes[nd.a].kind != SQN_COL) { return 1; };
                if (nd.iv < (i64)0 | nd.iv > (i64)4) { return 1; };
                if (sq_vd_expr(g, ti, nd.a, target) != 0) { return 1; };
                sq_vd_op("Cast\0", target, 65 + (int)nd.iv, 0);
                return 0;
            };
            if (nd.kind == SQN_BIN & (nd.op == SQO_AND | nd.op == SQO_OR))
            {
                if (g.nodes[nd.a].kind != SQN_COL | g.nodes[nd.b].kind != SQN_COL) { return 1; };
                if (sq_vd_expr(g, ti, nd.a, target) != 0) { return 1; };
                r2 = sq_vd_getreg();
                if (sq_vd_expr(g, ti, nd.b, r2) != 0) { return 1; };
                if (nd.op == SQO_AND) { sq_vd_op("And\0", r2, target, target); } else { sq_vd_op("Or\0", r2, target, target); };
                sq_vd_putreg(r2);
                return 0;
            };
            if (nd.kind == SQN_BIN & nd.op >= SQO_EQ & nd.op <= SQO_GE)
            {
                nm = (byte*)0;
                if (nd.op == SQO_EQ) { nm = "Eq\0"; };
                if (nd.op == SQO_NE) { nm = "Ne\0"; };
                if (nd.op == SQO_LT) { nm = "Lt\0"; };
                if (nd.op == SQO_LE) { nm = "Le\0"; };
                if (nd.op == SQO_GT) { nm = "Gt\0"; };
                if (nd.op == SQO_GE) { nm = "Ge\0"; };
                if ((u64)nm == (u64)0) { return 1; };
                if (g.nodes[nd.a].kind != SQN_COL) { return 1; };
                col = g.nodes[nd.a].col;
                if (col >= ti.ncols | col == ti.ipk) { return 1; };
                if (ti.coll[col] != 0) { return 1; };
                if (g.nodes[nd.b].kind == SQN_NULL) { return 1; };
                if (g.nodes[nd.b].kind == SQN_COL)
                {
                    zn = g.nodes[nd.b].col;
                    if (zn >= ti.ncols | zn == ti.ipk) { return 1; };
                    if (ti.coll[zn] != 0 | ti.aff[zn] != ti.aff[col]) { return 1; };
                }
                else { if (sq_vd_isconst(g, nd.b) == false) { return 1; }; };
                if (sq_vd_operand(g, ti, nd.a, @r1, @t1) != 0) { return 1; };
                if (sq_vd_operand(g, ti, nd.b, @r2, @t2) != 0) { return 1; };
                sq_vd_op("Integer\0", 1, target, 0);
                un = sq_vd_op(nm, r2, 0, r1);
                sq_vd_p4s(un, "BINARY-8\0", 8);
                VD_P5[un] = sq_vd_affch(ti.aff[col]);
                sq_vd_op("ZeroOrNull\0", r1, target, r2);
                VD_P2[un] = VD_N;
                if (t1 != 0) { sq_vd_putreg(t1); };
                if (t2 != 0) { sq_vd_putreg(t2); };
                return 0;
            };
            return 1;
        };

        def sq_vd_affch(int aff) -> int
        {
            return 65 + aff;
        };

        // WHERE terms of a full scan: each comparison of a column with a literal jumps to the next row when false
        // 1 when the tree holds an OR
        def sq_vd_hasnn(SQ_STMT* g, int ni) -> int
        {
            SQ_NODE* nd;
            if (ni < 0) { return 0; };
            nd = @g.nodes[ni];
            if (nd.kind == SQN_ISNULL & nd.op == 2) { return 1; };
            if (nd.kind == SQN_BIN)
            {
                if (nd.op == SQO_AND | nd.op == SQO_OR) { if (sq_vd_hasnn(g, nd.a) == 1) { return 1; }; return sq_vd_hasnn(g, nd.b); };
            };
            return 0;
        };

        def sq_vd_hasor(SQ_STMT* g, int ni) -> int
        {
            SQ_NODE* nd;
            if (ni < 0) { return 0; };
            nd = @g.nodes[ni];
            if (nd.kind == SQN_BIN)
            {
                if (nd.op == SQO_OR) { return 1; };
                if (nd.op == SQO_AND) { if (sq_vd_hasor(g, nd.a) == 1) { return 1; }; return sq_vd_hasor(g, nd.b); };
            };
            return 0;
        };

        def sq_vd_orin(SQ_STMT* g, SQ_TI* ti, int ni) -> void;
        def sq_vd_dupor(SQ_STMT* g, int ni) -> int;
        def sq_vd_havwhere(SQ_STMT* g, SQ_BLK* b) -> void;
        def sq_vd_orin_undo(SQ_STMT* g) -> void;
        global int VD_ORN = 0;
        // 1 when an OR inside the WHERE tests the rowid alias or the leading column of an index (SQLite may plan a multi-index OR)
        def sq_vd_orix(SQ_STMT* g, SQ_TI* ti, SQ_IDX* ixs, int nix, int ni, int inor) -> int
        {
            SQ_NODE* nd;
            int k, c;
            if (ni < 0) { return 0; };
            nd = @g.nodes[ni];
            if (nd.kind == SQN_BIN)
            {
                if (nd.op == SQO_AND) { if (sq_vd_orix(g, ti, ixs, nix, nd.a, inor) == 1) { return 1; }; return sq_vd_orix(g, ti, ixs, nix, nd.b, inor); };
                if (nd.op == SQO_OR)
                {
                    VD_ORN = 0;
                    sq_vd_orin(g, ti, ni);
                    if (VD_ORN > 0) { sq_vd_orin_undo(g); return 0; };
                };
                if (nd.op == SQO_OR) { if (sq_vd_orix(g, ti, ixs, nix, nd.a, 1) == 1) { return 1; }; return sq_vd_orix(g, ti, ixs, nix, nd.b, 1); };
            };
            if (inor == 0) { return 0; };
            c = 0 - 1;
            if (nd.kind == SQN_BIN) { if (g.nodes[nd.a].kind == SQN_COL) { c = g.nodes[nd.a].col; }; }
            else { if (nd.kind == SQN_ISNULL) { if (g.nodes[nd.a].kind == SQN_COL) { c = g.nodes[nd.a].col; }; }; };
            if (c < 0) { return 0; };
            if (c == ti.ipk) { return 1; };
            for (k = 0; k < nix; k++) { if (ixs[k].nk > 0 & ixs[k].col[0] == c) { return 1; }; };
            return 0;
        };

        // flattens an OR tree into its terms
        // 1 when the block selects only count(*)
        def sq_vd_cntstar(SQ_STMT* g, SQ_BLK* b) -> int
        {
            int i;
            if (b.nres < 1) { return 0; };
            for (i = 0; i < b.nres; i++)
            {
                if (g.nodes[b.rc[i]].kind != SQN_FUNC) { return 0; };
                if (g.nodes[b.rc[i]].op != 2) { return 0; };
            };
            return 1;
        };

        def sq_vd_orsplit(SQ_STMT* g, int ni, int* arr, int* n) -> void
        {
            SQ_NODE* nd = @g.nodes[ni];
            if (nd.kind == SQN_BIN & nd.op == SQO_OR)
            {
                sq_vd_orsplit(g, nd.a, arr, n);
                sq_vd_orsplit(g, nd.b, arr, n);
                return;
            };
            if (*n < 8) { arr[*n] = ni; *n = *n + 1; };
        };

        // an equivalent tree without NOT: neg flips each comparison and swaps AND with OR; -1 when the shape is not handled
        def sq_vd_pushnot(SQ_STMT* g, int ni, int neg) -> int
        {
            int k, n, x, y;
            k = g.nodes[ni].kind;
            if (k == SQN_UNARY & g.nodes[ni].op == 2)
            {
                if (neg == 0) { return sq_vd_pushnot(g, g.nodes[ni].a, 1); };
                return sq_vd_pushnot(g, g.nodes[ni].a, 0);
            };
            if (neg == 0)
            {
                if (k == SQN_BIN & (g.nodes[ni].op == SQO_AND | g.nodes[ni].op == SQO_OR))
                {
                    x = sq_vd_pushnot(g, g.nodes[ni].a, 0);
                    y = sq_vd_pushnot(g, g.nodes[ni].b, 0);
                    if (x < 0 | y < 0) { return 0 - 1; };
                    n = sq_newnode(g, SQN_BIN);
                    if (n < 0) { return 0 - 1; };
                    g.nodes[n] = g.nodes[ni]; g.nodes[n].a = x; g.nodes[n].b = y;
                    return n;
                };
                return ni;
            };
            if (k == SQN_BIN)
            {
                x = g.nodes[ni].op;
                y = 0;
                if (x == SQO_AND | x == SQO_OR)
                {
                    x = sq_vd_pushnot(g, g.nodes[ni].a, 1);
                    y = sq_vd_pushnot(g, g.nodes[ni].b, 1);
                    if (x < 0 | y < 0) { return 0 - 1; };
                    n = sq_newnode(g, SQN_BIN);
                    if (n < 0) { return 0 - 1; };
                    g.nodes[n] = g.nodes[ni]; g.nodes[n].a = x; g.nodes[n].b = y;
                    if (g.nodes[ni].op == SQO_AND) { g.nodes[n].op = SQO_OR; } else { g.nodes[n].op = SQO_AND; };
                    return n;
                };
                if (x == SQO_EQ) { y = SQO_NE; };
                if (x == SQO_NE) { y = SQO_EQ; };
                if (x == SQO_LT) { y = SQO_GE; };
                if (x == SQO_GE) { y = SQO_LT; };
                if (x == SQO_LE) { y = SQO_GT; };
                if (x == SQO_GT) { y = SQO_LE; };
                if (y == 0) { return 0 - 1; };
                n = sq_newnode(g, SQN_BIN);
                if (n < 0) { return 0 - 1; };
                g.nodes[n] = g.nodes[ni]; g.nodes[n].op = y;
                return n;
            };
            if (k == SQN_ISNULL & (g.nodes[ni].op == 1 | g.nodes[ni].op == 2))
            {
                n = sq_newnode(g, SQN_ISNULL);
                if (n < 0) { return 0 - 1; };
                g.nodes[n] = g.nodes[ni];
                g.nodes[n].op = 3 - g.nodes[ni].op;
                return n;
            };
            if (k == SQN_IN & (g.nodes[ni].op == 1 | g.nodes[ni].op == 2))
            {
                n = sq_newnode(g, SQN_IN);
                if (n < 0) { return 0 - 1; };
                g.nodes[n] = g.nodes[ni];
                g.nodes[n].op = 3 - g.nodes[ni].op;
                return n;
            };
            if (k == SQN_LIKE & (g.nodes[ni].op == 1 | g.nodes[ni].op == 2))
            {
                n = sq_newnode(g, SQN_LIKE);
                if (n < 0) { return 0 - 1; };
                g.nodes[n] = g.nodes[ni];
                g.nodes[n].op = 3 - g.nodes[ni].op;
                return n;
            };
            return 0 - 1;
        };

        def sq_vd_colr2(SQ_TI* ti, int col, int r) -> int
        {
            if (col == ti.ipk & ti.ipk >= 0) { if (VD_IDXCUR > 0 & sq_vd_gon(722) == 0) { return sq_vd_op("IdxRowid\0", VD_IDXCUR, r, 0); }; return sq_vd_op("Rowid\0", 0, r, 0); };
            return sq_vd_colrd(col, r);
        };

        def sq_vd_where(SQ_STMT* g, SQ_TI* ti, int ni) -> int
        {
            SQ_NODE* nd = @g.nodes[ni];
            SQ_NODE* l;
            int r1, r2, t1, t2, a, op, col, i, no, bd, k, nin, rn, r3, a2, cl;
            byte[4] nb2;
            int[8] ot;
            int[8] oj;
            int[8] ofr;
            int[8] oe;
            int no2;
            byte* nm;
            if (nd.kind == SQN_UNARY & nd.op == 2)
            {
                k = sq_vd_pushnot(g, ni, 0);
                if (k < 0) { return 1; };
                return sq_vd_where(g, ti, k);
            };
            if (nd.kind == SQN_BIN & nd.op == SQO_OR)
            {
                no = 0;
                for (i = 0; i < 8; i++) { ofr[i] = 0; };
                sq_vd_orsplit(g, ni, @ot[0], @no);
                for (i = 0; i < no; i++)
                {
                    nd = @g.nodes[ot[i]];
                    if (nd.kind == SQN_ISNULL & sq_vd_gon(907) == 0)
                    {
                        l = @g.nodes[nd.a];
                        if (l.kind != SQN_COL | l.col >= ti.ncols | l.col == ti.ipk | l.lvl != 0 | (nd.op != 1 & nd.op != 2)) { return 1; };
                        if (VD_IDXCUR > 0 & ((VD_ISWOR == 0 & sq_vd_gon(972) == 1) | (VD_ISWOR == 1 & sq_vd_gon(956) == 1))) { return 1; };
                        if (VD_ISWOR == 1) { if (ti.pk[l.col] != 0) { return 1; }; };
                        r1 = sq_vd_getreg();
                        a = sq_vd_colrd(l.col, r1);
                        if (ti.aff[l.col] != 4) { VD_P5[a] = 128; } else { sq_vd_op("RealAffinity\0", r1, 0, 0); };
                        if (i == no - 1)
                        {
                            if (nd.op == 1) { a = sq_vd_op("NotNull\0", r1, 0, 0); } else { a = sq_vd_op("IsNull\0", r1, 0, 0); };
                            if (VD_NJ < 32) { VD_JF[VD_NJ] = a; VD_NJ++; };
                        }
                        else
                        {
                            if (nd.op == 1) { a = sq_vd_op("IsNull\0", r1, 0, 0); } else { a = sq_vd_op("NotNull\0", r1, 0, 0); };
                            oj[i] = a;
                        };
                        sq_vd_putreg(r1);
                        continue;
                    };
                    if (nd.kind == SQN_BETWEEN & nd.op == 1 & sq_vd_gon(908) == 0)
                    {
                        if ((g.blks[g.root_blk].has_agg != 0 & (sq_vd_gon(959) == 1 | sq_vd_cntstar(g, g.blks[g.root_blk]) == 0 & sq_vd_gon(960) == 1)) | g.blks[g.root_blk].ngrp != 0 | g.blks[g.root_blk].distinct != 0) { return 1; };
                        l = @g.nodes[nd.a];
                        if (l.kind != SQN_COL | l.col >= ti.ncols | l.col == ti.ipk | l.lvl != 0 | ti.coll[l.col] != 0 | (VD_IDXCUR > 0 & (VD_ISWOR == 0 | sq_vd_gon(956) == 1))) { return 1; };
                        if (sq_vd_isconst(g, nd.b) == false | sq_vd_isconst(g, nd.c) == false) { return 1; };
                        if (g.nodes[nd.b].kind == SQN_NULL | g.nodes[nd.c].kind == SQN_NULL) { return 1; };
                        if (sq_vd_operand(g, ti, nd.a, @r1, @t1) != 0) { return 1; };
                        bd = sq_vd_getreg();
                        if (sq_vd_operand(g, ti, nd.b, @r2, @t2) != 0) { return 1; };
                        a = sq_vd_op("Lt\0", r2, 0, r1);
                        sq_vd_p4s(a, "BINARY-8\0", 8);
                        VD_P5[a] = 16 + sq_vd_affch(ti.aff[l.col]);
                        if (i == no - 1) { if (VD_NJ < 32) { VD_JF[VD_NJ] = a; VD_NJ++; }; } else { k = a; };
                        if (t2 != 0) { sq_vd_putreg(t2); };
                        if (sq_vd_operand(g, ti, nd.c, @r2, @t2) != 0) { return 1; };
                        if (i == no - 1)
                        {
                            a = sq_vd_op("Gt\0", r2, 0, r1);
                            sq_vd_p4s(a, "BINARY-8\0", 8);
                            VD_P5[a] = 16 + sq_vd_affch(ti.aff[l.col]);
                            if (VD_NJ < 32) { VD_JF[VD_NJ] = a; VD_NJ++; };
                        }
                        else
                        {
                            a = sq_vd_op("Le\0", r2, 0, r1);
                            sq_vd_p4s(a, "BINARY-8\0", 8);
                            VD_P5[a] = sq_vd_affch(ti.aff[l.col]);
                            oj[i] = a;
                            VD_P2[k] = VD_N;
                        };
                        if (t2 != 0) { sq_vd_putreg(t2); };
                        sq_vd_putreg(bd);
                        if (t1 != 0) { sq_vd_putreg(t1); };
                        continue;
                    };
                    if (nd.kind == SQN_LIKE & nd.op == 1 & sq_vd_gon(910) == 0)
                    {
                        if ((g.blks[g.root_blk].has_agg != 0 & (sq_vd_gon(959) == 1 | sq_vd_cntstar(g, g.blks[g.root_blk]) == 0 & sq_vd_gon(960) == 1)) | g.blks[g.root_blk].ngrp != 0 | g.blks[g.root_blk].distinct != 0) { return 1; };
                        if ((nd.iv != (i64)0 & nd.iv != (i64)1) | nd.c >= 0 | g.nodes[nd.b].kind != SQN_STR | (VD_IDXCUR > 0 & (VD_ISWOR == 0 | sq_vd_gon(956) == 1))) { return 1; };
                        l = @g.nodes[nd.a];
                        if (l.kind != SQN_COL | l.col >= ti.ncols | l.col == ti.ipk | l.lvl != 0) { return 1; };
                        r1 = sq_vd_getreg();
                        r2 = sq_vd_getrange(2);
                        if (VD_NH >= 64) { return 1; };
                        VD_HF[VD_NH] = 1; VD_HN[VD_NH] = nd.b; VD_HR[VD_NH] = r2; VD_HEP[VD_NH] = 0; VD_NH++;
                        if (sq_vd_expr(g, ti, nd.a, r2 + 1) != 0) { return 1; };
                        a = sq_vd_fnop(1, r2, r1);
                        if (nd.iv == (i64)1) { sq_vd_p4s(a, "glob(2)\0", 7); } else { sq_vd_p4s(a, "like(2)\0", 7); };
                        if (i == no - 1)
                        {
                            a = sq_vd_op("IfNot\0", r1, 0, 1);
                            if (VD_NJ < 32) { VD_JF[VD_NJ] = a; VD_NJ++; };
                        }
                        else
                        {
                            a = sq_vd_op("If\0", r1, 0, 0);
                            oj[i] = a;
                        };
                        sq_vd_putreg(r1);
                        continue;
                    };
                    if (nd.kind == SQN_IN & nd.op == 2 & i == no - 1 & sq_vd_gon(911) == 0)
                    {
                        if ((g.blks[g.root_blk].has_agg != 0 & (sq_vd_gon(959) == 1 | sq_vd_cntstar(g, g.blks[g.root_blk]) == 0 & sq_vd_gon(960) == 1)) | g.blks[g.root_blk].ngrp != 0 | g.blks[g.root_blk].distinct != 0) { return 1; };
                        if (sq_vd_where(g, ti, ot[i]) != 0) { return 1; };
                        continue;
                    };
                    if (nd.kind == SQN_IN & nd.op == 2 & i < no - 1 & sq_vd_gon(911) == 0)
                    {
                        if ((g.blks[g.root_blk].has_agg != 0 & (sq_vd_gon(959) == 1 | sq_vd_cntstar(g, g.blks[g.root_blk]) == 0 & sq_vd_gon(960) == 1)) | g.blks[g.root_blk].ngrp != 0 | g.blks[g.root_blk].distinct != 0) { return 1; };
                        if (nd.blk >= 0 | nd.b < 0) { return 1; };
                        l = @g.nodes[nd.a];
                        if (l.kind != SQN_COL | l.col >= ti.ncols | l.col == ti.ipk | l.lvl != 0 | ti.coll[l.col] != 0 | (ti.aff[l.col] == 4 & sq_vd_gon(962) == 1) | (VD_IDXCUR > 0 & (VD_ISWOR == 0 | sq_vd_gon(956) == 1))) { return 1; };
                        bd = 0;
                        for (k = nd.b; k >= 0; k = g.nodes[k].next) { if (sq_vd_isconst(g, k) == false | g.nodes[k].kind == SQN_NULL) { return 1; }; bd++; };
                        if (bd != 2) { return 1; };
                        r1 = sq_vd_getreg();
                        a = sq_vd_colr2(ti, l.col, r1);
                        if (ti.aff[l.col] == 4) { sq_vd_op("RealAffinity\0", r1, 0, 0); };
                        r3 = sq_vd_getreg();
                        sq_vd_op("BitAnd\0", r1, r1, r3);
                        k = nd.b;
                        no2 = 0;
                        while (k >= 0)
                        {
                            if (sq_vd_operand(g, ti, k, @r2, @t2) != 0) { return 1; };
                            a = sq_vd_op("Eq\0", r1, 0, r2);
                            sq_vd_p4s(a, "BINARY-8\0", 8);
                            VD_P5[a] = sq_vd_affch(ti.aff[l.col]);
                            oe[no2] = a; no2++;
                            if (t2 != 0) { sq_vd_putreg(t2); };
                            k = g.nodes[k].next;
                        };
                        a = sq_vd_op("IsNull\0", r3, 0, 0);
                        oe[no2] = a; no2++;
