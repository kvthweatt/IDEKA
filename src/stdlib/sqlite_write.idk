                };
                if (haso == 1 & VD_DISTRED == 1) { ip = sq_vd_op("IfPos\0", 2, 0, 1); };
                sq_vd_op("ResultRow\0", base, b.nres, 0);
            };
            };
            decr = 0 - 1;
            if (hasl == 1 & aggm == 0) { decr = sq_vd_op("DecrJumpZero\0", 1, 0, 0); };
            if (dst == 1) { VD_P2[sile] = VD_N; };
            if (hasw == 1)
            {
                VD_P2[seek] = VD_N;
                if (decr >= 0) { VD_P2[decr] = VD_N; };
                if (ip >= 0) { VD_P2[ip] = VD_N; };
                for (i = 0; i < npj; i++) { VD_P2[pj[i]] = VD_N; };
                for (i = 0; i < VD_NJ; i++) { VD_P2[VD_JF[i]] = VD_N; };
            }
            else
            {
                nxt = VD_N;
                if (mode == 3) { VD_IDXCUR = ic3; };
                r1 = 0;
                if (mode == 3 & nk3 > 0) { i = nk3 - 1; if (inn < 0 | i != inp) { if (g.nodes[cj[eqt[i]]].kind == SQN_ISNULL) { r1 = 1; }; }; };
                if (mode == 3 & ixs.unique != 0 & nk3 == ixs.nk & ml < 0 & mu < 0 & r1 == 0) { a = 0 - 1; }
                else
                {
                if ((ordx != 0 | (mode == 3 & dsc == 1) | (VD_ORDPIN == 1 & srt == 0 & mode == 0 & b.has_agg == 0 & ((ti.wor != 0 & ti.npk == 1 & g.nodes[b.ord[0]].kind == SQN_COL & g.nodes[b.ord[0]].col == ti.pkc[0] & sq_vd_gon(986) == 0) | (ti.wor == 0 & ti.ipk >= 0 & VD_NCK > 0 & g.nodes[b.ord[0]].kind == SQN_COL & g.nodes[b.ord[0]].col == ti.ipk & sq_vd_gon(988) == 0)))) & b.odesc[0] != 0 & (mode != 3 | dsc == 1)) { a = sq_vd_op("Prev\0", cur, body, 0); } else { a = sq_vd_op("Next\0", cur, body, 0); };
                if (mode == 0 & nn0 == 0) { VD_P5[a] = 1; };
                if (mode == 3) { if (nk3 >= ixs.nk & (ml < 0 & mu < 0 | rr3 == 1) & (inn < 0 | inp >= ixs.nk) & r1 == 0) { VD_P3[a] = 1; }; };
                if (mode == 3 & pp.cov == 0) { VD_P1[a] = ic3; };
                };
                if (rew >= 0) { VD_P2[rew] = VD_N; };
                if (sk >= 0) { VD_P2[sk] = VD_N; };
                if (chk >= 0) { VD_P2[chk] = VD_N; };
                if (glc >= 0) { a = sq_vd_op("DecrJumpZero\0", glc, glr, 0); };
                if (decr >= 0 & inn < 0) { VD_P2[decr] = VD_N; };
                if (ip >= 0) { VD_P2[ip] = nxt; };
                for (i = 0; i < VD_NJ; i++) { VD_P2[VD_JF[i]] = nxt; };
                if (inn >= 0)
                {
                    if (inp > 0)
                    {
                        a = sq_vd_op("IfNoHope\0", ic3, VD_N + 2, kreg);
                        sq_vd_p4i(a, (i64)inp);
                    };
                    VD_P2[einull] = VD_N;
                    ilp = 0 - 1;
                    if (srl == 1 & srt == 1 & sile >= 0) { if (sq_vd_oblim(b, @ixs, nk3, inp, dsc) == 1) { VD_P2[sile] = VD_N; }; };
                    if (mode == 3 & dsc == 1) { sq_vd_op("Prev\0", ecur, eloop, 0); } else { sq_vd_op("Next\0", ecur, eloop, 0); };
                    if (ilp >= 0) { VD_P2[ilp] = VD_N; };
                    VD_P2[einr] = VD_N;
                    if (decr >= 0) { VD_P2[decr] = VD_N; };
                };
            };
            VD_IDXCUR = 0;
            if (aggm == 1) { sq_vd_aggfin(g, b, @afid[0], @aacc[0], @afirst[0], anacc, ashift); };
            if (lzero >= 0) { VD_P2[lzero] = VD_N; };
            for (i = 0; i < npj; i++) { VD_P2[pj[i]] = VD_N; };
            if (srt == 1)
            {
                pcs = 3;
                if (mode == 2 & inn < 0 & (b.src[0].ti.wor == 0 | sq_vd_gon(971) == 1)) { pcs = 2; };
                if (mode == 0 & VD_NCK > 0 & inn < 0 & sq_vd_gon(940) == 0 & b.src[0].ti.wor == 0) { pcs = 2; };
                if (mode == 3 & inn >= 0) { pcs = ecur + 1; };
                sq_vd_srtout(b, srl, sro, ors, sof, pcs);
            };
            sq_vd_op("Halt\0", 0, 0, 0);
            VD_P2[init] = VD_N;
            sq_vd_trans(g.db, 0);
            for (i = 0; i < VD_NCK; i++) { if (sq_vd_ckdup(@ckr[0], i) < 0) { sq_vd_op("Integer\0", VD_CKV[i], ckr[i], 0); }; };
            for (i = VD_NH0; i < VD_NH; i++) { sq_vd_lit(g, VD_HN[i], VD_HR[i]); };
            sq_vd_op("Goto\0", 0, 1, 0);
            return 0;
        };

        global int[1024] AU_O;
        global int[1024] AU_P1;
        global int[1024] AU_P2;
        global int[1024] AU_P3;
        global int[1024] AU_P4;
        global int[1024] AU_P5;

        // how an arm instruction is remapped when arms are joined: 1 cursor in P1, 2 jump in P2, 32 cursor in P3; -1 when the
        // instruction is not known to be safe to move
        def sq_vd_ufield(int a) -> int
        {
            byte* nm = @VD_TXT[VD_O[a]];
            if (sq_streq(nm, "Rewind\0") | sq_streq(nm, "Next\0") | sq_streq(nm, "Prev\0") | sq_streq(nm, "SeekRowid\0") | sq_streq(nm, "NotExists\0")) { return 3; };
            if (sq_streq(nm, "SeekGE\0") | sq_streq(nm, "SeekGT\0") | sq_streq(nm, "SeekLE\0") | sq_streq(nm, "SeekLT\0")) { return 3; };
            if (sq_streq(nm, "IdxGE\0") | sq_streq(nm, "IdxGT\0") | sq_streq(nm, "IdxLE\0") | sq_streq(nm, "IdxLT\0")) { return 3; };
            if (sq_streq(nm, "NotFound\0") | sq_streq(nm, "Found\0") | sq_streq(nm, "NoConflict\0")) { return 3; };
            if (sq_streq(nm, "OpenRead\0") | sq_streq(nm, "Column\0") | sq_streq(nm, "Rowid\0") | sq_streq(nm, "IdxRowid\0")) { return 1; };
            if (sq_streq(nm, "NullRow\0") | sq_streq(nm, "Close\0") | sq_streq(nm, "OpenEphemeral\0") | sq_streq(nm, "IdxInsert\0")) { return 1; };
            if (sq_streq(nm, "DeferredSeek\0")) { return 1 + 32; };
            if (sq_streq(nm, "Eq\0") | sq_streq(nm, "Ne\0") | sq_streq(nm, "Lt\0") | sq_streq(nm, "Le\0") | sq_streq(nm, "Gt\0") | sq_streq(nm, "Ge\0")) { return 2; };
            if (sq_streq(nm, "IfNot\0") | sq_streq(nm, "If\0") | sq_streq(nm, "IsNull\0") | sq_streq(nm, "NotNull\0") | sq_streq(nm, "IfPos\0")) { return 2; };
            if (sq_streq(nm, "DecrJumpZero\0") | sq_streq(nm, "Once\0") | sq_streq(nm, "Return\0") | sq_streq(nm, "Goto\0") | sq_streq(nm, "Gosub\0")) { return 2; };
            if (sq_streq(nm, "Integer\0") | sq_streq(nm, "String8\0") | sq_streq(nm, "Real\0") | sq_streq(nm, "Null\0") | sq_streq(nm, "ResultRow\0")) { return 0; };
            if (sq_streq(nm, "Add\0") | sq_streq(nm, "Subtract\0") | sq_streq(nm, "Multiply\0") | sq_streq(nm, "Divide\0") | sq_streq(nm, "Remainder\0") | sq_streq(nm, "Concat\0")) { return 0; };
            if (sq_streq(nm, "Function\0") | sq_streq(nm, "PureFunc\0") | sq_streq(nm, "RealAffinity\0") | sq_streq(nm, "Affinity\0") | sq_streq(nm, "MakeRecord\0") | sq_streq(nm, "Copy\0") | sq_streq(nm, "SCopy\0")) { return 0; };
            if (sq_streq(nm, "BeginSubrtn\0") | sq_streq(nm, "Not\0") | sq_streq(nm, "MustBeInt\0") | sq_streq(nm, "OffsetLimit\0")) { return 0; };
            if (sq_streq(nm, "Noop\0")) { return 1; };
            if (sq_streq(nm, "SorterOpen\0") | sq_streq(nm, "SorterInsert\0") | sq_streq(nm, "OpenPseudo\0")) { return 1; };
            if (sq_streq(nm, "SorterSort\0") | sq_streq(nm, "SorterNext\0")) { return 3; };
            if (sq_streq(nm, "SorterData\0")) { return 1 + 32; };
            if (sq_streq(nm, "Init\0")) { return 2; };
            if (sq_streq(nm, "Halt\0") | sq_streq(nm, "Transaction\0") | sq_streq(nm, "Int64\0") | sq_streq(nm, "Blob\0") | sq_streq(nm, "SetCookie\0") | sq_streq(nm, "Yield\0") | sq_streq(nm, "InitCoroutine\0") | sq_streq(nm, "EndCoroutine\0")) { return 0; };
            if (sq_streq(nm, "Last\0") | sq_streq(nm, "SeekRowid\0")) { return 3; };
            if (sq_streq(nm, "Found\0") | sq_streq(nm, "Insert\0") | sq_streq(nm, "Delete\0") | sq_streq(nm, "NewRowid\0") | sq_streq(nm, "Sequence\0") | sq_streq(nm, "Count\0")) { return 1; };
            return 0 - 1;
        };

        def sq_vd_ucur(int c, int na, int j, int off) -> int
        {
            if (c == 0) { return na - 1 - j; };
            return na + off + c - 1;
        };

        // UNION ALL of plain selects: every arm is generated by the single select generator, then the arms are joined
        // the way SQLite lays them out (cursors numbered last arm first, constants of all arms after the Transaction)
        // VALUES with two or more rows: a coroutine that yields each row, then a loop that copies and outputs it
        def sq_vd_values(SQ_STMT* st, SQ_STMT* g) -> int
        {
            SQ_BLK* ab;
            int bi, nc, i, init, ic1, ic2, yl, out, rg, nr;
            bi = g.root_blk;
            nc = g.blks[bi].nres;
            nr = 0;
            while (bi >= 0)
            {
                ab = g.blks[bi];
                if (ab.nres != nc) { sq_seterr(st, "all VALUES must have the same number of terms\0"); return 1; };
                if (ab.limit_n >= 0 | ab.offset_n >= 0 | ab.nord > 0) { if (sq_vd_gon(423) == 1) { sq_seterr(st, "EXPLAIN is not available for VALUES with ORDER BY or LIMIT #423\0"); return 1; }; };
                nr++;
                bi = ab.cnext;
            };
            sq_vd_reset();
            init = sq_vd_op("Init\0", 0, 0, 0);
            ic1 = sq_vd_op("InitCoroutine\0", 1, 0, 2);
            VD_NMEM = 3 + nc;
            bi = g.root_blk;
            while (bi >= 0)
            {
                ab = g.blks[bi];
                for (i = 0; i < nc; i++)
                {
                    if (sq_vd_isconst(g, ab.rc[i]) == false) { if (sq_vd_gon(424) == 1) { sq_seterr(st, "EXPLAIN is not available for this expression #424\0"); return 1; }; };
                    if (sq_vd_lit(g, ab.rc[i], 4 + i) != 0) { if (sq_vd_gon(425) == 1) { sq_seterr(st, "EXPLAIN is not available for this expression #425\0"); return 1; }; };
                };
                sq_vd_op("Yield\0", 1, 0, 0);
                bi = ab.cnext;
            };
            sq_vd_op("EndCoroutine\0", 1, 0, 0);
            VD_P2[ic1] = VD_N;
            ic2 = sq_vd_op("InitCoroutine\0", 1, 0, 2);
            yl = sq_vd_op("Yield\0", 1, 0, 0);
            out = 4 + 2 * nc;
            for (i = 0; i < nc; i++)
            {
                rg = sq_vd_op("Copy\0", 4 + i, out + i, 0);
                VD_P5[rg] = 2;
            };
            sq_vd_op("ResultRow\0", out, nc, 0);
            sq_vd_op("Goto\0", 0, yl, 0);
            VD_P2[yl] = VD_N;
            sq_vd_op("Halt\0", 0, 0, 0);
            VD_P2[init] = VD_N;
            sq_vd_op("Goto\0", 0, 1, 0);
            return 0;
        };

        def sq_vd_unionall(SQ_STMT* st, SQ_STMT* g) -> int
        {
            int[32] arms;
            int[32] ast;
            int[32] aen;
            int[32] harr;
            int[1024] nm;
            int[64] ncj;
            int[32] maxc;
            SQ_BLK* ab;
            int ntab, jr, na, bi, j, a, i, rc, cn, sroot, h, f, cnt, nc, k, nn, hh, off, cl, co2, sk, pro, ifo, tj;
            int[32] trf;
            int[32] ifa;
            na = 0;
            bi = g.root_blk;
            while (bi >= 0)
            {
                if (na >= 32) { if (sq_vd_gon(426) == 1) { sq_seterr(st, "EXPLAIN is not available for this compound SELECT #426\0"); return 1; }; };
                ab = g.blks[bi];
                if (na > 0 & ab.cop != 2) { if (sq_vd_gon(427) == 1) { sq_seterr(st, "EXPLAIN is not available for this compound SELECT #427\0"); return 1; }; };
                if (ab.nord > 0) { if (sq_vd_gon(428) == 1) { sq_seterr(st, "EXPLAIN is not available for a compound SELECT with ORDER BY or LIMIT #428\0"); return 1; }; };
                if (na > 0) { if (ab.limit_n >= 0 | ab.offset_n >= 0) { if (sq_vd_gon(429) == 1) { sq_seterr(st, "EXPLAIN is not available for a compound SELECT with ORDER BY or LIMIT #429\0"); return 1; }; }; };
                if (na > 0) { if (ab.nres != g.blks[arms[0]].nres) { sq_seterr(st, "SELECTs to the left and right of UNION ALL do not have the same number of result columns\0"); return 1; }; };
                arms[na] = bi;
                na++;
                bi = ab.cnext;
            };
            sroot = g.root_blk;
            cl = g.blks[arms[0]].limit_n; co2 = g.blks[arms[0]].offset_n;
            if (cl < 0 & co2 >= 0) { if (sq_vd_gon(430) == 1) { sq_seterr(st, "EXPLAIN is not available for this LIMIT #430\0"); return 1; }; };
            if (cl >= 0)
            {
                if (g.nodes[cl].kind != SQN_INT) { if (sq_vd_gon(431) == 1) { sq_seterr(st, "EXPLAIN is not available for this LIMIT #431\0"); return 1; }; };
                if (g.nodes[cl].iv <= (i64)0) { if (sq_vd_gon(432) == 1) { sq_seterr(st, "EXPLAIN is not available for this LIMIT #432\0"); return 1; }; };
                if (co2 >= 0) { if (g.nodes[co2].kind != SQN_INT) { if (sq_vd_gon(433) == 1) { sq_seterr(st, "EXPLAIN is not available for this LIMIT #433\0"); return 1; }; }; };
            };
            sk = 1; pro = 1;
            if (co2 >= 0) { sk = 3; pro = 4; };
            VD_N = 0; VD_TN = 0;
            VD_KEEP = 1;
            VD_XT = 0; VD_XF = 0;
            for (j = 0; j < na; j++)
            {
                ab = g.blks[arms[j]];
                cn = ab.cnext;
                ab.cnext = 0 - 1;
                ab.limit_n = cl; ab.offset_n = co2;
                g.root_blk = arms[j];
                ast[j] = VD_N;
                VD_ARM = j;
                rc = sq_vd_select(st, g);
                aen[j] = VD_N;
                VD_XT = 0; VD_XF = 0;
                for (a = ast[j]; a < aen[j]; a++)
                {
                    if (sq_streq(@VD_TXT[VD_O[a]], "Function\0")) { VD_XF = 1; };
                    if (sq_streq(@VD_TXT[VD_O[a]], "Add\0") | sq_streq(@VD_TXT[VD_O[a]], "Subtract\0") | sq_streq(@VD_TXT[VD_O[a]], "Multiply\0") | sq_streq(@VD_TXT[VD_O[a]], "Function\0") | sq_streq(@VD_TXT[VD_O[a]], "Concat\0")) { VD_XT = 1; };
                };
                ab.cnext = cn;
                if (j > 0) { ab.limit_n = 0 - 1; ab.offset_n = 0 - 1; };
                g.root_blk = sroot;
                if (rc != 0) { VD_KEEP = 0; return 1; };
            };
            VD_KEEP = 0;
            VD_ARM = 0;
            // structure of each arm: Init, body, Halt, Transaction, constants, Goto
            cnt = 0;
            for (j = 0; j < na; j++)
            {
                h = 0 - 1;
                for (a = ast[j] + 1; a < aen[j]; a++) { if (h < 0) { if (sq_streq(@VD_TXT[VD_O[a]], "Halt\0")) { h = a; }; }; };
                if (h < 0 | h + 1 > aen[j] - 1) { if (sq_vd_gon(434) == 1) { sq_seterr(st, "EXPLAIN is not available for this compound SELECT #434\0"); return 1; }; };
                if (sq_streq(@VD_TXT[VD_O[ast[j]]], "Init\0") == false | sq_streq(@VD_TXT[VD_O[aen[j] - 1]], "Goto\0") == false) { if (sq_vd_gon(435) == 1) { sq_seterr(st, "EXPLAIN is not available for this compound SELECT #435\0"); return 1; }; };
                harr[j] = h;
                trf[j] = 0;
                if (sq_streq(@VD_TXT[VD_O[h + 1]], "Transaction\0")) { trf[j] = 1; };
                for (a = ast[j]; a < aen[j]; a++) { nm[a] = 1 + cnt; };
                maxc[j] = 0;
                ifa[j] = 0 - 1;
                if (cl >= 0 & j > 0)
                {
                    for (i = 0; i < sk; i++)
                    {
                        if (i < 2) { if (sq_streq(@VD_TXT[VD_O[ast[j] + 1 + i]], "Integer\0") == false) { if (sq_vd_gon(436) == 1) { sq_seterr(st, "EXPLAIN is not available for this compound SELECT #436\0"); return 1; }; }; }
                        else { if (sq_streq(@VD_TXT[VD_O[ast[j] + 1 + i]], "MustBeInt\0") == false) { if (sq_vd_gon(437) == 1) { sq_seterr(st, "EXPLAIN is not available for this compound SELECT #437\0"); return 1; }; }; };
                    };
                    ifa[j] = 1 + cnt;
                    cnt++;
                };
                for (a = ast[j] + 1; a < h; a++)
                {
                    if (cl >= 0 & j > 0 & a - ast[j] <= sk) { nm[a] = 1 + cnt; continue; };
                    f = sq_vd_ufield(a);
                    if (f < 0) { if (sq_vd_gon(438) == 1) { sq_seterr(st, "EXPLAIN is not available for this compound SELECT #438\0"); return 1; }; };
                    if ((f `& 1) != 0) { if (VD_P1[a] > maxc[j]) { maxc[j] = VD_P1[a]; }; };
                    if ((f `& 32) != 0) { if (VD_P3[a] > maxc[j]) { maxc[j] = VD_P3[a]; }; };
                    nm[a] = 1 + cnt;
                    cnt++;
                };
                nm[h] = 1 + cnt;
                nc = aen[j] - 1 - (h + 1 + trf[j]);
                if (nc > 64) { if (sq_vd_gon(439) == 1) { sq_seterr(st, "EXPLAIN is not available for this compound SELECT #439\0"); return 1; }; };
                ncj[j] = nc;
                for (a = h + 1 + trf[j]; a < aen[j] - 1; a++)
                {
                    if (sq_vd_ufield(a) != 0) { if (sq_vd_gon(440) == 1) { sq_seterr(st, "EXPLAIN is not available for this compound SELECT #440\0"); return 1; }; };
                };
            };
            hh = 1 + cnt;
            ntab = 0;
            for (i = 0; i < na; i++) { if (g.blks[arms[i]].nsrc > 0) { ntab++; }; };
            a = ast[0];
            AU_O[0] = VD_O[a]; AU_P1[0] = VD_P1[a]; AU_P2[0] = hh + 1; AU_P3[0] = VD_P3[a]; AU_P4[0] = VD_P4[a]; AU_P5[0] = VD_P5[a];
            nn = 1;
            off = 0;
            for (j = 0; j < na; j++)
            {
                h = harr[j];
                nc = ncj[j];
                jr = 0;
                for (i = 0; i < j; i++) { if (g.blks[arms[i]].nsrc > 0) { jr++; }; };
                if (ifa[j] >= 0)
                {
                    AU_O[nn] = sq_vd_txt("IfNot\0", 5); AU_P1[nn] = 1; AU_P2[nn] = nm[h]; AU_P3[nn] = 0; AU_P4[nn] = 0 - 1; AU_P5[nn] = 0;
                    nn++;
                };
                for (a = ast[j] + 1; a < h; a++)
                {
                    if (cl >= 0 & j > 0 & a - ast[j] <= sk) { continue; };
                    f = sq_vd_ufield(a);
                    AU_O[nn] = VD_O[a]; AU_P1[nn] = VD_P1[a]; AU_P2[nn] = VD_P2[a]; AU_P3[nn] = VD_P3[a]; AU_P4[nn] = VD_P4[a]; AU_P5[nn] = VD_P5[a];
                    if ((f `& 1) != 0) { AU_P1[nn] = sq_vd_ucur(VD_P1[a], ntab, jr, off); };
                    if ((f `& 32) != 0) { AU_P3[nn] = sq_vd_ucur(VD_P3[a], ntab, jr, off); };
                    if ((f `& 2) != 0) { AU_P2[nn] = nm[VD_P2[a]]; };
                    nn++;
                };
                off = off + maxc[j];
            };
            a = harr[0];
            AU_O[nn] = VD_O[a]; AU_P1[nn] = VD_P1[a]; AU_P2[nn] = VD_P2[a]; AU_P3[nn] = VD_P3[a]; AU_P4[nn] = VD_P4[a]; AU_P5[nn] = VD_P5[a];
            nn++;
            tj = 0 - 1;
            for (j = 0; j < na; j++) { if (tj < 0 & trf[j] == 1) { tj = j; }; };
            if (tj >= 0)
            {
                a = harr[tj] + 1;
                AU_O[nn] = VD_O[a]; AU_P1[nn] = VD_P1[a]; AU_P2[nn] = VD_P2[a]; AU_P3[nn] = VD_P3[a]; AU_P4[nn] = VD_P4[a]; AU_P5[nn] = VD_P5[a];
                nn++;
            };
            for (j = 0; j < na; j++)
            {
                h = harr[j];
                for (k = 0; k < ncj[j]; k++)
                {
                    a = h + 1 + trf[j] + k;
                    AU_O[nn] = VD_O[a]; AU_P1[nn] = VD_P1[a]; AU_P2[nn] = VD_P2[a]; AU_P3[nn] = VD_P3[a]; AU_P4[nn] = VD_P4[a]; AU_P5[nn] = VD_P5[a];
                    nn++;
                };
            };
            a = aen[0] - 1;
            AU_O[nn] = VD_O[a]; AU_P1[nn] = VD_P1[a]; AU_P2[nn] = VD_P2[a]; AU_P3[nn] = VD_P3[a]; AU_P4[nn] = VD_P4[a]; AU_P5[nn] = VD_P5[a];
            nn++;
            for (i = 0; i < nn; i++)
            {
                VD_O[i] = AU_O[i]; VD_P1[i] = AU_P1[i]; VD_P2[i] = AU_P2[i]; VD_P3[i] = AU_P3[i]; VD_P4[i] = AU_P4[i]; VD_P5[i] = AU_P5[i];
            };
            VD_N = nn;
            return 0;
        };

        // ---- UNION, INTERSECT and EXCEPT: each arm is an ORDER BY coroutine, the arms are merged ----
        global int[2048] CS_O;
        global int[2048] CS_P1;
        global int[2048] CS_P2;
        global int[2048] CS_P3;
        global int[2048] CS_P4;
        global int[2048] CS_P5;
        global int CS_N = 0;
        global int[256] CS_CO;
        global int[256] CS_C1;
        global int[256] CS_C2;
        global int[256] CS_C3;
        global int[256] CS_C4;
        global int[256] CS_C5;
        global int CS_NC = 0;
        global int CS_REG = 0;
        global int CS_NCOL = 0;
        global int[40] CS_KE;
        global int CS_NA = 0;
        global int CS_NT = 0;
        global int CS_PERM = 0;
        global int CS_TRAIL = 0;
        global int CS_ONLYALL = 0;
        global int CS_ALLM = 0;
        global int CS_LREG = 0;
        global int CS_OREG = 0;
        global int[8] CS_DJ;
        global int CS_NDJ = 0;
        global int CS_NKEY = 0;
        global int CS_PERMT = 0;
        global int[16] CS_PL;
        global int CS_PLN = 0;
        global int CS_OBN = 0;
        global int[16] CS_OBC;
        global int[16] CS_OBD;
        global int[16] CS_OBU;
        global int[16] CS_OBK;
        global int CS_LIM = 0;
        global int CS_ACNT = 0;
        global int CS_OFN = 0;
        global int CS_SK = 0;
        global int CS_SKM = 0;
        global int CS_OFF = 0;
        global int CS_ERR = 0;
        global int CS_KI = 0;
        global int CS_TR = 0;
        global int[32] CS_ARMS;
        global int[64] CN_OP;
        global int[64] CN_L;
        global int[64] CN_R;
        global int CN_N = 0;
        global int[64] CN_EL;

        def cn_mk(int op, int l, int r) -> int
        {
            int id;
            id = CS_NA + CN_N;
            CN_OP[CN_N] = op; CN_L[CN_N] = l; CN_R[CN_N] = r;
            CN_N++;
            return id;
        };

        // balanced tree of UNIONs over the elements CN_EL[lo..hi): runs of up to three stay left-deep
        def cn_bal(int lo, int hi) -> int
        {
            int c, i, mid;
            if (hi - lo == 1) { return CN_EL[lo]; };
            if (hi - lo <= 3)
            {
                c = CN_EL[lo];
                for (i = lo + 1; i < hi; i++) { c = cn_mk(1, c, CN_EL[i]); };
                return c;
            };
            mid = lo + (hi - lo) / 2;
            return cn_mk(1, cn_bal(lo, mid), cn_bal(mid, hi));
        };

        // the compound tree for arms 0..hi the way SQLite nests them
        def cn_build(SQ_STMT* g, int hi) -> int
        {
            int j, m, i, t, base;
            int[64] el;
            if (hi == 0) { return 0; };
            if (g.blks[CS_ARMS[hi]].cop != 1)
            {
                t = cn_build(g, hi - 1);
                return cn_mk(g.blks[CS_ARMS[hi]].cop, t, hi);
            };
            j = hi;
            while (j > 0)
            {
                if (g.blks[CS_ARMS[j]].cop != 1) { break; };
                j--;
            };
            base = cn_build(g, j);
            m = 0;
            el[m] = base; m++;
            for (i = j + 1; i <= hi; i++) { el[m] = i; m++; };
            for (i = 0; i < m; i++) { CN_EL[i] = el[i]; };
            return cn_bal(0, m);
        };

        def cs_op(byte* name, int p1, int p2, int p3) -> int
        {
            int a;
            a = CS_N;
            if (a >= 2040) { CS_ERR = 1; return 0 - 1; };
            CS_O[a] = sq_vd_txt(name, sq_cstrlen(name));
            CS_P1[a] = p1; CS_P2[a] = p2; CS_P3[a] = p3; CS_P4[a] = 0 - 1; CS_P5[a] = 0;
            CS_N = a + 1;
            return a;
        };

        // k(N,...) text of the sorter becomes the three-way compare key k(N+1,...,)
        // key info text with the sort direction marks removed
        def cs_kplain(int ki) -> int
        {
            SQ_SB t;
            int i, o;
            sq_sb_init(@t);
            sq_sb_lit(@t, "k(\0");
            sq_sb_int(@t, (i64)CS_NCOL);
            for (i = 0; i < CS_NCOL; i++) { if (i < 40 & CS_KE[i] == 1 & sq_vd_gon(791) == 0) { sq_sb_lit(@t, ",\0"); } else { sq_sb_lit(@t, ",B\0"); }; };
            sq_sb_lit(@t, ")\0");
            o = sq_vd_txt(t.p, t.n);
            sq_sb_free(@t);
            return o;
        };

        // emits the Permutation that precedes a merge Compare when the key order differs from the column order; returns 1 when emitted
        def cs_perm() -> int
        {
            int pm;
            if (CS_PERM == 0) { return 0; };
            SQ_SB pt;
            int i;
            pm = cs_op("Permutation\0", 0, 0, 0);
            sq_sb_init(@pt);
            sq_sb_lit(@pt, "[\0");
            for (i = 0; i < CS_PLN; i++)
            {
                if (i > 0) { sq_sb_lit(@pt, ",\0"); };
                sq_sb_int(@pt, (i64)CS_PL[i]);
            };
            sq_sb_lit(@pt, "]\0");
            CS_P4[pm] = sq_vd_txt(pt.p, pt.n);
            sq_sb_free(@pt);
            return 1;
        };

        def cs_ki2(int ki) -> int
        {
            SQ_SB t;
            int i, n, o;
            sq_sb_init(@t);
            if (ki < 0)
            {
                sq_sb_lit(@t, "k(\0");
                sq_sb_int(@t, (i64)(CS_NCOL + 1));
                for (i = 0; i < CS_NCOL; i++)
                {
                    sq_sb_lit(@t, ",\0");
                    if (i < CS_OBN) { if (CS_OBD[i] != 0) { sq_sb_lit(@t, "-\0"); }; };
                    sq_sb_lit(@t, "B\0");
                };
                sq_sb_lit(@t, ",)\0");
                o = sq_vd_txt(t.p, t.n);
                sq_sb_free(@t);
                return o;
            };
            sq_sb_lit(@t, "k(\0");
            i = ki + 2;
            n = 0;
            while (VD_TXT[i] >= (byte)48 & VD_TXT[i] <= (byte)57) { n = n * 10 + (int)(VD_TXT[i] - (byte)48); i++; };
            sq_sb_int(@t, (i64)(n + 1));
            while (VD_TXT[i] != (byte)41 & VD_TXT[i] != (byte)0) { sq_sb_add(@t, @VD_TXT[i], 1); i++; };
            sq_sb_lit(@t, ",)\0");
            o = sq_vd_txt(t.p, t.n);
            sq_sb_free(@t);
            return o;
        };

        // 1 when the arm's rows already come out ordered by all result columns (each column pinned by = or the rowid key), 2 when only some are
        def cs_sat(SQ_STMT* g, SQ_BLK* ab) -> int
        {
            SQ_SRC* sr;
            SQ_TI* ti;
            SQ_NODE* nd;
            SQ_NODE* o;
            int[16] cj;
            int[16] pin;
            int i, j, run, c, npin, res, any;
            if (ab.nsrc != 1) { return 0; };
            sr = @ab.src[0];
            if (sr.kind != 1 | (u64)sr.ti == (u64)0) { return 0; };
            ti = sr.ti;
            for (i = 0; i < 16; i++) { pin[i] = 0; };
            run = 0;
            if (ab.where_n >= 0)
            {
                sq_vd_split(g, ab.where_n, @cj[0], @run);
                for (j = 0; j < run; j++)
                {
                    o = @g.nodes[cj[j]];
                    if (o.kind == SQN_ISNULL) { return 2; };
                    if (o.kind == SQN_BIN & o.op == SQO_EQ)
                    {
                        if (g.nodes[o.a].kind == SQN_COL & g.nodes[o.b].kind != SQN_COL)
                        {
                            for (i = 0; i < ab.nres; i++)
                            {
                                nd = @g.nodes[ab.rc[i]];
                                if (nd.kind == SQN_COL) { if (nd.col == g.nodes[o.a].col) { pin[i] = 1; }; };
                            };
                        };
                    };
                };
            };
            npin = 0;
            res = 0;
            for (i = 0; i < ab.nres; i++)
            {
                nd = @g.nodes[ab.rc[i]];
                if (pin[i] == 1) { npin++; continue; };
                if (nd.kind == SQN_COL) { if (nd.col == ti.ipk & ti.ipk >= 0) { res = 1; break; }; };
                res = 3;
                break;
            };
            if (res == 0) { return 1; };
            if (res == 1) { return 1; };
            if (npin > 0) { return 2; };
            return 0;
        };

        // a trailing UNION ALL arm: the plain select appended after the merged rows
        def cs_plain(SQ_STMT* st, SQ_STMT* g, int j) -> int
        {
            SQ_BLK* ab;
            int cn, sroot, rc, ast, aen, h, a, f, ic, jj, i, mx, base, k2;
            int[1024] np;
            ab = g.blks[CS_ARMS[j]];
            jj = 0;
            for (i = 0; i < j; i++) { if (g.blks[CS_ARMS[i]].nsrc > 0) { jj++; }; };
            if (ab.nres != CS_NCOL | ab.nord > 0 | ab.limit_n >= 0 | ab.offset_n >= 0) { sq_seterr(st, "EXPLAIN is not available for this compound SELECT\0"); CS_ERR = 1; return 0; };
            cn = ab.cnext;
            ab.cnext = 0 - 1;
            sroot = g.root_blk;
            g.root_blk = CS_ARMS[j];
            VD_KEEP = 2;
            VD_ARM = 0;
            VD_RB = CS_REG;
            VD_NMEM = CS_REG;
            VD_XT = 0; VD_XF = 0;
            ast = VD_N;
            rc = sq_vd_select(st, g);
            aen = VD_N;
            VD_KEEP = 0;
            ab.cnext = cn;
            g.root_blk = sroot;
            if (rc != 0) { CS_ERR = 1; return 0; };
            h = 0 - 1;
            for (a = ast + 1; a < aen; a++) { if (h < 0) { if (sq_streq(@VD_TXT[VD_O[a]], "Halt\0")) { h = a; }; }; };
            if (h < 0 | h + 1 > aen - 1) { sq_seterr(st, "EXPLAIN is not available for this compound SELECT\0"); CS_ERR = 1; return 0; };
            if (sq_streq(@VD_TXT[VD_O[ast]], "Init\0") == false | sq_streq(@VD_TXT[VD_O[aen - 1]], "Goto\0") == false) { sq_seterr(st, "EXPLAIN is not available for this compound SELECT\0"); CS_ERR = 1; return 0; };
            base = CS_N;
            mx = 0;
            for (a = ast + 1; a < h; a++)
            {
                f = sq_vd_ufield(a);
                if (f < 0) { sq_seterr(st, "EXPLAIN is not available for this compound SELECT\0"); CS_ERR = 1; return 0; };
                if ((f `& 1) != 0) { if (VD_P1[a] > mx) { mx = VD_P1[a]; }; };
                if ((f `& 32) != 0) { if (VD_P3[a] > mx) { mx = VD_P3[a]; }; };
                np[a - ast - 1] = base + (a - ast - 1);
            };
            np[h - ast - 1] = base + (h - ast - 1);
            for (a = ast + 1; a < h; a++)
            {
                f = sq_vd_ufield(a);
                ic = cs_op("Nop\0", 0, 0, 0);
                CS_O[ic] = VD_O[a]; CS_P1[ic] = VD_P1[a]; CS_P2[ic] = VD_P2[a]; CS_P3[ic] = VD_P3[a]; CS_P4[ic] = VD_P4[a]; CS_P5[ic] = VD_P5[a];
                if ((f `& 1) != 0) { CS_P1[ic] = sq_vd_ucur(VD_P1[a], CS_NT, jj, CS_OFF); };
                if ((f `& 32) != 0) { CS_P3[ic] = sq_vd_ucur(VD_P3[a], CS_NT, jj, CS_OFF); };
                if ((f `& 2) != 0) { CS_P2[ic] = np[VD_P2[a] - ast - 1]; };
            };
            k2 = h + 1;
            if (sq_streq(@VD_TXT[VD_O[k2]], "Transaction\0"))
            {
                if (CS_TR < 0)
                {
                    CS_TR = VD_O[k2];
                    CS_C1[255] = VD_P1[k2]; CS_C2[255] = VD_P2[k2]; CS_C3[255] = VD_P3[k2]; CS_C4[255] = VD_P4[k2]; CS_C5[255] = VD_P5[k2];
                };
                k2++;
            };
            for (a = k2; a < aen - 1; a++)
            {
                if (CS_NC >= 250) { CS_ERR = 1; return 0; };
                CS_CO[CS_NC] = VD_O[a]; CS_C1[CS_NC] = VD_P1[a]; CS_C2[CS_NC] = VD_P2[a]; CS_C3[CS_NC] = VD_P3[a]; CS_C4[CS_NC] = VD_P4[a]; CS_C5[CS_NC] = VD_P5[a];
                CS_NC++;
            };
            CS_OFF = CS_OFF + mx;
            VD_N = ast;
            return 0;
        };

        def cs_nofrom(SQ_STMT* st, SQ_STMT* g, int j, int yreg) -> int
        {
            SQ_BLK* ab;
            int cn, sroot, rc, ast, aen, h, a, f, ic, out;
            SQ_SB kt;
            ab = g.blks[CS_ARMS[j]];
            cn = ab.cnext;
            ab.cnext = 0 - 1;
            sroot = g.root_blk;
            g.root_blk = CS_ARMS[j];
            VD_KEEP = 2;
            VD_ARM = 0;
            VD_RB = CS_REG;
            VD_NMEM = CS_REG;
            VD_XT = 0; VD_XF = 0;
            ast = VD_N;
            rc = sq_vd_select(st, g);
            aen = VD_N;
            VD_KEEP = 0;
            ab.cnext = cn;
            g.root_blk = sroot;
            if (rc != 0) { CS_ERR = 1; return 0; };
            CS_REG = VD_NMEM;
            h = 0 - 1;
            for (a = ast + 1; a < aen; a++) { if (h < 0) { if (sq_streq(@VD_TXT[VD_O[a]], "Halt\0")) { h = a; }; }; };
            if (h < 0 | h + 2 > aen) { sq_seterr(st, "EXPLAIN is not available for this compound SELECT\0"); CS_ERR = 1; return 0; };
            if (sq_streq(@VD_TXT[VD_O[ast]], "Init\0") == false | sq_streq(@VD_TXT[VD_O[aen - 1]], "Goto\0") == false) { sq_seterr(st, "EXPLAIN is not available for this compound SELECT\0"); CS_ERR = 1; return 0; };
            cs_op("Noop\0", sq_vd_ucur(1, CS_NT, 0, CS_OFF), 2 * CS_NCOL + 1, 0);
            if (CS_KI < 0)
            {
                sq_sb_init(@kt);
                sq_sb_lit(@kt, "k(\0");
                sq_sb_int(@kt, (i64)CS_NCOL);
                for (a = 0; a < CS_NCOL; a++) { sq_sb_lit(@kt, ",B\0"); };
                sq_sb_lit(@kt, ")\0");
                CS_KI = sq_vd_txt(kt.p, kt.n);
                sq_sb_free(@kt);
            };
            out = 0 - 1;
            for (a = ast + 1; a < h; a++)
            {
                f = sq_vd_ufield(a);
                if (f != 0) { sq_seterr(st, "EXPLAIN is not available for this compound SELECT\0"); CS_ERR = 1; return 0; };
                if (sq_streq(@VD_TXT[VD_O[a]], "ResultRow\0"))
                {
                    if (VD_P2[a] != CS_NCOL) { sq_seterr(st, "EXPLAIN is not available for this compound SELECT\0"); CS_ERR = 1; return 0; };
                    out = VD_P1[a];
                    cs_op("Yield\0", yreg, 0, 0);
                    continue;
                };
                ic = cs_op("Nop\0", 0, 0, 0);
                CS_O[ic] = VD_O[a]; CS_P1[ic] = VD_P1[a]; CS_P2[ic] = VD_P2[a]; CS_P3[ic] = VD_P3[a]; CS_P4[ic] = VD_P4[a]; CS_P5[ic] = VD_P5[a];
            };
            if (out < 0) { sq_seterr(st, "EXPLAIN is not available for this compound SELECT\0"); CS_ERR = 1; return 0; };
            cs_op("EndCoroutine\0", yreg, 0, 0);
            for (a = h + 1; a < aen - 1; a++)
            {
                if (CS_NC >= 250) { CS_ERR = 1; return 0; };
                CS_CO[CS_NC] = VD_O[a]; CS_C1[CS_NC] = VD_P1[a]; CS_C2[CS_NC] = VD_P2[a]; CS_C3[CS_NC] = VD_P3[a]; CS_C4[CS_NC] = VD_P4[a]; CS_C5[CS_NC] = VD_P5[a];
                CS_NC++;
            };
            CS_OFF = CS_OFF + 1;
            VD_N = ast;
            return out;
        };

        // compiles arm j as an ORDER BY coroutine and copies it into the output; returns the first result register
        def cs_arm(SQ_STMT* st, SQ_STMT* g, int j, int yreg) -> int
        {
            SQ_BLK* ab;
            SQ_NODE* nd;
            int rrp, shf, i, ni, cn, sroot, rc, ast, aen, h, a, f, mx, base, na, nn2, out, tgt, ic, pl, nh0, nrr, sc, pc, ob, rec, pr, k2, ss, sd, sat, scur, mxs, jj;
            int[1024] np;
            SQ_SB kt;
            ab = g.blks[CS_ARMS[j]];
            jj = 0;
            for (i = 0; i < j; i++) { if (g.blks[CS_ARMS[i]].nsrc > 0) { jj++; }; };
            if (ab.nres != CS_NCOL | ab.nres > 16) { sq_seterr(st, "EXPLAIN is not available for this compound SELECT\0"); CS_ERR = 1; return 0; };
            if (ab.nsrc == 0) { if (CS_ACNT > 0) { sq_seterr(st, "EXPLAIN is not available for this compound SELECT\0"); CS_ERR = 1; return 0; }; return cs_nofrom(st, g, j, yreg); };
            CS_SK++;
            nn2 = 0;
            for (i = 0; i < CS_OBN; i++)
            {
                ni = sq_newnode(g, SQN_RESREF);
                if (ni < 0) { CS_ERR = 1; return 0; };
                g.nodes[ni].iv = (i64)CS_OBC[i];
                ab.ord[nn2] = ni; ab.odesc[nn2] = CS_OBD[i]; ab.onull[nn2] = CS_OBU[i]; ab.ocoll[nn2] = CS_OBK[i];
                nn2++;
            };
            for (i = 0; i < ab.nres; i++)
            {
                f = 0;
                for (a = 0; a < CS_OBN; a++) { if (CS_OBC[a] == i) { f = 1; }; };
                if (CS_ONLYALL != 0) { f = 1; };
                if (f == 1) { continue; };
                ni = sq_newnode(g, SQN_RESREF);
                if (ni < 0) { CS_ERR = 1; return 0; };
                g.nodes[ni].iv = (i64)i;
                ab.ord[nn2] = ni; ab.odesc[nn2] = 0; ab.onull[nn2] = 0; ab.ocoll[nn2] = 0 - 1;
                nn2++;
            };
            ab.nord = nn2;
            cn = ab.cnext;
            ab.cnext = 0 - 1;
            sroot = g.root_blk;
            g.root_blk = CS_ARMS[j];
            VD_KEEP = 2;
            VD_ARM = 0;
            VD_RB = CS_REG;
            VD_NMEM = CS_REG;
            VD_XT = 0; VD_XF = 0;
            ast = VD_N;
            nh0 = VD_NH;
            pl = 0;
            rc = sq_vd_select(st, g);
            if (rc != 0)
            {
                if (CS_OBN > 0) { ab.nord = 0; CS_ERR = 1; ab.cnext = cn; g.root_blk = sroot; VD_KEEP = 0; return 0; };
                st.err[0] = (byte)0;
                VD_N = ast;
                VD_NH = nh0;
                ab.nord = 0;
                pl = 1;
                sat = cs_sat(g, ab);
                if (sat == 2) { sq_seterr(st, "EXPLAIN is not available for this compound SELECT\0"); CS_ERR = 1; ab.cnext = cn; g.root_blk = sroot; VD_KEEP = 0; return 0; };
                if (sat == 1) { pl = 2; };
                VD_KEEP = 2;
                VD_RB = CS_REG;
                VD_NMEM = CS_REG;
                VD_XT = 0; VD_XF = 0;
                rc = sq_vd_select(st, g);
            };
            aen = VD_N;
            VD_KEEP = 0;
            ab.cnext = cn;
            g.root_blk = sroot;
            if (rc != 0) { CS_ERR = 1; return 0; };
            CS_REG = VD_NMEM;
            for (a = ast + 1; a < aen; a++) { if (sq_streq(@VD_TXT[VD_O[a]], "OpenPseudo\0")) { if (VD_P2[a] > CS_REG) { CS_REG = VD_P2[a]; }; }; };
            h = 0 - 1;
            for (a = ast + 1; a < aen; a++) { if (h < 0) { if (sq_streq(@VD_TXT[VD_O[a]], "Halt\0")) { h = a; }; }; };
            if (h < 0 | h + 2 > aen - 1) { sq_seterr(st, "EXPLAIN is not available for this compound SELECT\0"); CS_ERR = 1; return 0; };
            if (CS_ACNT > 0 & pl != 0) { sq_seterr(st, "EXPLAIN is not available for this compound SELECT\0"); CS_ERR = 1; return 0; };
            rrp = 0 - 1;
            for (a = ast + 1; a < h; a++) { if (sq_streq(@VD_TXT[VD_O[a]], "ResultRow\0")) { rrp = a - ast - 1; }; };
            if (sq_streq(@VD_TXT[VD_O[ast]], "Init\0") == false | sq_streq(@VD_TXT[VD_O[h + 1]], "Transaction\0") == false | sq_streq(@VD_TXT[VD_O[aen - 1]], "Goto\0") == false) { sq_seterr(st, "EXPLAIN is not available for this compound SELECT\0"); CS_ERR = 1; return 0; };
            mx = 0;
            for (a = ast + 1; a < h; a++)
            {
                f = sq_vd_ufield(a);
                if (f < 0) { sq_seterr(st, "EXPLAIN is not available for this compound SELECT\0"); CS_ERR = 1; return 0; };
                if ((f `& 1) != 0) { if (VD_P1[a] > mx) { mx = VD_P1[a]; }; };
                if ((f `& 32) != 0) { if (VD_P3[a] > mx) { mx = VD_P3[a]; }; };
            };
            for (a = h + 2; a < aen - 1; a++)
            {
                if (sq_vd_ufield(a) != 0) { sq_seterr(st, "EXPLAIN is not available for this compound SELECT\0"); CS_ERR = 1; return 0; };
            };
            if (pl == 2) { if (mx < 1) { mx = 1; }; };
            if (pl == 2) { cs_op("Noop\0", sq_vd_ucur(1, CS_NT, jj, CS_OFF), 2 * CS_NCOL + 1, 0); };
            base = CS_N;
            out = 0 - 1;
            if (pl == 1)
            {
                nrr = 0;
                for (a = ast + 1; a <= h; a++)
                {
                    np[a - ast - 1] = base + 1 + (a - ast - 1) + nrr;
                    if (a < h) { if (sq_streq(@VD_TXT[VD_O[a]], "ResultRow\0")) { nrr++; }; };
                };
                if (nrr != 1) { sq_seterr(st, "EXPLAIN is not available for this compound SELECT\0"); CS_ERR = 1; return 0; };
                mxs = 1;
                if (mx >= 1) { mxs = mx + 1; };
                sc = 1; pc = mxs + 1;
                mx = pc;
                ic = cs_op("SorterOpen\0", sc, 2 * CS_NCOL + 1, 0);
                sq_sb_init(@kt);
                sq_sb_lit(@kt, "k(\0");
                sq_sb_int(@kt, (i64)CS_NCOL);
                for (i = 0; i < CS_NCOL; i++) { sq_sb_lit(@kt, ",B\0"); };
                sq_sb_lit(@kt, ")\0");
                CS_P4[ic] = sq_vd_txt(kt.p, kt.n);
                if (CS_KI < 0) { CS_KI = CS_P4[ic]; };
                sq_sb_free(@kt);
                CS_P1[ic] = sq_vd_ucur(sc, CS_NT, jj, CS_OFF);
                scur = CS_P1[ic];
                for (a = ast + 1; a < h; a++)
                {
                    f = sq_vd_ufield(a);
                    if (sq_streq(@VD_TXT[VD_O[a]], "ResultRow\0"))
                    {
                        if (VD_P2[a] != CS_NCOL) { sq_seterr(st, "EXPLAIN is not available for this compound SELECT\0"); CS_ERR = 1; return 0; };
                        out = VD_P1[a];
                        ob = out + CS_NCOL;
                        if (VD_NMEM >= ob) { ob = VD_NMEM + 1; };
                        rec = ob + CS_NCOL;
                        pr = rec + 1;
                        k2 = cs_op("MakeRecord\0", out, CS_NCOL, rec);
                        k2 = cs_op("SorterInsert\0", scur, rec, out);
                        sq_sb_init(@kt);
                        sq_sb_int(@kt, (i64)CS_NCOL);
                        CS_P4[k2] = sq_vd_txt(kt.p, kt.n);
                        sq_sb_free(@kt);
                        continue;
                    };
                    ic = cs_op("Nop\0", 0, 0, 0);
                    CS_O[ic] = VD_O[a]; CS_P1[ic] = VD_P1[a]; CS_P2[ic] = VD_P2[a]; CS_P3[ic] = VD_P3[a]; CS_P4[ic] = VD_P4[a]; CS_P5[ic] = VD_P5[a];
                    if ((f `& 1) != 0) { k2 = VD_P1[a]; if (k2 >= 1) { k2 = k2 + 1; }; CS_P1[ic] = sq_vd_ucur(k2, CS_NT, jj, CS_OFF); };
                    if ((f `& 32) != 0) { k2 = VD_P3[a]; if (k2 >= 1) { k2 = k2 + 1; }; CS_P3[ic] = sq_vd_ucur(k2, CS_NT, jj, CS_OFF); };
                    if ((f `& 2) != 0) { CS_P2[ic] = np[VD_P2[a] - ast - 1]; };
                };
                if (out < 0) { sq_seterr(st, "EXPLAIN is not available for this compound SELECT\0"); CS_ERR = 1; return 0; };
                a = cs_op("OpenPseudo\0", sq_vd_ucur(pc, CS_NT, jj, CS_OFF), pr, 2 * CS_NCOL + 1);
                ss = cs_op("SorterSort\0", scur, 0, 0);
                sd = cs_op("SorterData\0", scur, pr, sq_vd_ucur(pc, CS_NT, jj, CS_OFF));
                for (i = CS_NCOL - 1; i >= 0; i--) { cs_op("Column\0", sq_vd_ucur(pc, CS_NT, jj, CS_OFF), i, ob + i); };
                out = ob;
                cs_op("Yield\0", yreg, 0, 0);
                cs_op("SorterNext\0", scur, sd, 0);
                CS_P2[ss] = CS_N;
                cs_op("EndCoroutine\0", yreg, 0, 0);
                if (CS_REG < pr) { CS_REG = pr; };
                CS_OFF = CS_OFF + mx;
                if (CS_TR < 0)
                {
                    CS_TR = VD_O[h + 1];
                    CS_C1[255] = VD_P1[h + 1]; CS_C2[255] = VD_P2[h + 1]; CS_C3[255] = VD_P3[h + 1]; CS_C4[255] = VD_P4[h + 1]; CS_C5[255] = VD_P5[h + 1];
                };
                for (a = h + 2; a < aen - 1; a++)
                {
                    if (CS_NC >= 250) { CS_ERR = 1; return 0; };
                    CS_CO[CS_NC] = VD_O[a]; CS_C1[CS_NC] = VD_P1[a]; CS_C2[CS_NC] = VD_P2[a]; CS_C3[CS_NC] = VD_P3[a]; CS_C4[CS_NC] = VD_P4[a]; CS_C5[CS_NC] = VD_P5[a];
                    CS_NC++;
                };
                VD_N = ast;
                return out;
            };
            for (a = ast + 1; a < h; a++)
            {
                f = sq_vd_ufield(a);
                ic = cs_op("Nop\0", 0, 0, 0);
                if (ic < 0) { return 0; };
                CS_O[ic] = VD_O[a]; CS_P1[ic] = VD_P1[a]; CS_P2[ic] = VD_P2[a]; CS_P3[ic] = VD_P3[a]; CS_P4[ic] = VD_P4[a]; CS_P5[ic] = VD_P5[a];
                if ((f `& 1) != 0) { CS_P1[ic] = sq_vd_ucur(VD_P1[a], CS_NT, jj, CS_OFF); };
                if ((f `& 32) != 0) { CS_P3[ic] = sq_vd_ucur(VD_P3[a], CS_NT, jj, CS_OFF); };
                if ((f `& 2) != 0)
                {
                    tgt = VD_P2[a];
                    shf = 0;
                    if (CS_ACNT > 0) { if (tgt == h | tgt - ast - 1 > rrp) { shf = 1; }; };
                    if (tgt == h) { CS_P2[ic] = base + (h - ast - 1) + shf; } else { CS_P2[ic] = base + (tgt - ast - 1) + shf; };
                };
                if (sq_streq(@VD_TXT[VD_O[a]], "ResultRow\0"))
                {
                    if (out >= 0 | VD_P2[a] != CS_NCOL) { sq_seterr(st, "EXPLAIN is not available for this compound SELECT\0"); CS_ERR = 1; return 0; };
                    out = VD_P1[a];
                    CS_O[ic] = sq_vd_txt("Yield\0", 5);
                    CS_P1[ic] = yreg; CS_P2[ic] = 0; CS_P3[ic] = 0;
                    if (CS_ACNT > 0) { cs_op("DecrJumpZero\0", CS_ACNT, base + (h - ast - 1) + 1, 0); };
                };
                if (sq_streq(@VD_TXT[VD_O[a]], "SorterOpen\0")) { if (CS_KI < 0) { CS_KI = VD_P4[a]; }; };
            };
            if (out < 0) { sq_seterr(st, "EXPLAIN is not available for this compound SELECT\0"); CS_ERR = 1; return 0; };
            cs_op("EndCoroutine\0", yreg, 0, 0);
            CS_OFF = CS_OFF + mx;
            if (CS_TR < 0)
            {
                CS_TR = VD_O[h + 1];
                CS_C1[255] = VD_P1[h + 1]; CS_C2[255] = VD_P2[h + 1]; CS_C3[255] = VD_P3[h + 1]; CS_C4[255] = VD_P4[h + 1]; CS_C5[255] = VD_P5[h + 1];
            };
            for (a = h + 2; a < aen - 1; a++)
            {
                if (CS_NC >= 250) { CS_ERR = 1; return 0; };
                CS_CO[CS_NC] = VD_O[a]; CS_C1[CS_NC] = VD_P1[a]; CS_C2[CS_NC] = VD_P2[a]; CS_C3[CS_NC] = VD_P3[a]; CS_C4[CS_NC] = VD_P4[a]; CS_C5[CS_NC] = VD_P5[a];
                CS_NC++;
            };
            VD_N = ast;
            return out;
        };

        // key info text for a node whose arms never built a sorter: k(n,) with no collation names
        def cs_kn() -> int
        {
            SQ_SB kt;
            int i, r;
            sq_sb_init(@kt);
            sq_sb_lit(@kt, "k(\0");
            sq_sb_int(@kt, (i64)CS_NCOL);
            for (i = 0; i < CS_NCOL; i++) { sq_sb_lit(@kt, ",\0"); };
            sq_sb_lit(@kt, ")\0");
            r = sq_vd_txt(kt.p, kt.n);
            sq_sb_free(@kt);
            return r;
        };

        // the subroutine that emits one row of the left or right side unless it repeats the previous row
        def cs_sub(int outb, int flag, int prev, int ret, int ycaller, int xout) -> int
        {
            int a0, n, a, ip;
            n = CS_NCOL;
            if (CS_ALLM != 0)
            {
                a0 = CS_N;
                ip = 0 - 1;
                if (ycaller < 0 & CS_OREG > 0) { ip = cs_op("IfPos\0", CS_OREG, 0, 1); };
                if (ycaller < 0) { cs_op("ResultRow\0", outb, n, 0); }
                else { cs_op("Move\0", outb, xout, n); cs_op("Yield\0", ycaller, 0, 0); };
                if (ycaller < 0 & CS_LREG > 0)
                {
                    a = cs_op("DecrJumpZero\0", CS_LREG, 0, 0);
                    if (CS_NDJ < 8) { CS_DJ[CS_NDJ] = a; CS_NDJ++; };
                };
                a = cs_op("Return\0", ret, 0, 0);
                if (ip >= 0) { CS_P2[ip] = a; };
                return a0;
            };
            a0 = cs_op("IfNot\0", flag, 0, 0);
            CS_P2[a0] = a0 + 3;
            a = cs_op("Compare\0", outb, prev, n);
            if (CS_SKM != 0) { CS_P4[a] = cs_kplain(CS_KI); } else { CS_P4[a] = cs_kn(); };
            a = cs_op("Jump\0", a0 + 3, 0, a0 + 3);
            cs_op("Copy\0", outb, prev, n - 1);
            cs_op("Integer\0", 1, flag, 0);
            ip = 0 - 1;
            if (ycaller < 0 & CS_OREG > 0) { ip = cs_op("IfPos\0", CS_OREG, 0, 1); };
            if (ycaller < 0) { cs_op("ResultRow\0", outb, n, 0); }
            else { cs_op("Move\0", outb, xout, n); cs_op("Yield\0", ycaller, 0, 0); };
            if (ycaller < 0 & CS_LREG > 0)
            {
                a = cs_op("DecrJumpZero\0", CS_LREG, 0, 0);
                if (CS_NDJ < 8) { CS_DJ[CS_NDJ] = a; CS_NDJ++; };
            };
            a = cs_op("Return\0", ret, 0, 0);
            CS_P2[a0 + 2] = a;
            if (ip >= 0) { CS_P2[ip] = a; };
            return a0;
        };

        // compound made of arms 0..m: returns the register holding its rows (a coroutine caller gets them through Yield)
        def cs_gen(SQ_STMT* st, SQ_STMT* g, int m, int ycaller) -> int
        {
            int n, fr, flag, prev, yl, yr, rl, rr, icl, icr, outl, outr, subl, subr, op, s1, s2, s3, s4, m0, cmp, end, a, xout, d1, e1, e2, m1, m2, pe1, pe2, pe3, pe4, np, sk0, pm, extra, lr, lcnt, lsrc;
            int[8] pend;
            sk0 = CS_SK;
            n = CS_NCOL;
            fr = CS_REG + 1;
            extra = 0;
            if (ycaller < 0 & CS_LIM >= 0) { extra = 1; if (CS_OFN >= 0) { extra = 3; }; };
            op = CN_OP[m - CS_NA];
            lcnt = 0;
            if (op == 2 & extra > 0)
            {
                if (CN_L[m - CS_NA] >= CS_NA | CN_R[m - CS_NA] >= CS_NA) { sq_seterr(st, "EXPLAIN is not available for this compound SELECT\0"); CS_ERR = 1; return 0; };
                lcnt = extra;
                extra = extra + 2;
            };
            if (op == 2)
            {
                CS_REG = CS_REG + 4 + extra;
                flag = fr; prev = fr; yl = fr + extra; yr = yl + 1; rl = yl + 2; rr = yl + 3;
            }
            else
            {
                CS_REG = CS_REG + n + 5 + extra;
                flag = fr; prev = fr + 1; yl = fr + n + 1 + extra; yr = yl + 1; rl = yl + 2; rr = yl + 3;
                cs_op("Integer\0", 0, flag, 0);
            };
            if (extra > 0)
            {
                lr = fr + n + 1;
                if (op == 2) { lr = fr; };
                CS_LREG = lr;
                cs_op("Integer\0", (int)g.nodes[CS_LIM].iv, lr, 0);
                if (CS_OFN >= 0)
                {
                    CS_OREG = lr + 1;
                    cs_op("Integer\0", (int)g.nodes[CS_OFN].iv, lr + 1, 0);
                    cs_op("MustBeInt\0", lr + 1, 0, 0);
                    cs_op("OffsetLimit\0", lr, lr + 2, lr + 1);
                };
                if (lcnt > 0)
                {
                    lsrc = lr;
                    if (lcnt == 3) { lsrc = lr + 2; };
                    cs_op("Copy\0", lsrc, lr + lcnt, 0);
                    cs_op("Copy\0", lr + lcnt, lr + lcnt + 1, 0);
                };
            };
            icl = cs_op("InitCoroutine\0", yl, 0, 0);
            CS_P3[icl] = CS_N;
            if (lcnt > 0) { CS_ACNT = lr + lcnt; };
            if (CN_L[m - CS_NA] < CS_NA) { outl = cs_arm(st, g, CN_L[m - CS_NA], yl); }
            else { outl = cs_gen(st, g, CN_L[m - CS_NA], yl); };
            if (CS_ERR != 0) { return 0; };
            CS_P2[icl] = CS_N;
            icr = cs_op("InitCoroutine\0", yr, 0, 0);
            CS_P3[icr] = CS_N;
            if (lcnt > 0) { CS_ACNT = lr + lcnt + 1; };
            if (CN_R[m - CS_NA] < CS_NA) { outr = cs_arm(st, g, CN_R[m - CS_NA], yr); }
            else { outr = cs_gen(st, g, CN_R[m - CS_NA], yr); };
            if (CS_ERR != 0) { return 0; };
            CS_ACNT = 0;
            xout = 0;
            if (ycaller >= 0) { xout = CS_REG + 1; CS_REG = CS_REG + n; };
            CS_SKM = 0;
            if (CS_SK > sk0) { CS_SKM = 1; };
            CS_ALLM = 0;
            if (op == 2) { CS_ALLM = 1; };
            subl = cs_sub(outl, flag, prev, rl, ycaller, xout);
            subr = 0;
            if (op == 1 | op == 2) { subr = cs_sub(outr, flag, prev, rr, ycaller, xout); };
            CS_ALLM = 0;
            np = 0;
            if (op == 1 | op == 2)
            {
                s1 = cs_op("Gosub\0", rr, subr, 0);
                a = cs_op("Yield\0", yr, 0, 0); pend[np] = a; np++;
                cs_op("Goto\0", 0, s1, 0);
                s2 = cs_op("Gosub\0", rl, subl, 0);
                a = cs_op("Yield\0", yl, 0, 0); pend[np] = a; np++;
                cs_op("Goto\0", 0, s2, 0);
                s3 = cs_op("Gosub\0", rl, subl, 0);
                cs_op("Yield\0", yl, s1, 0);
                a = cs_op("Goto\0", 0, 0, 0); pe1 = a;
                s4 = cs_op("Gosub\0", rr, subr, 0);
                cs_op("Yield\0", yr, s2, 0);
                a = cs_op("Goto\0", 0, 0, 0); pe2 = a;
                m0 = cs_op("Yield\0", yl, s1 + 1, 0);
                cs_op("Yield\0", yr, s2, 0);
                pm = cs_perm();
                cmp = cs_op("Compare\0", outl, outr, CS_NKEY);
                if (pm == 1) { CS_P5[cmp] = 1; };
                CS_P4[cmp] = cs_ki2(CS_KI);
                if (op == 2) { cs_op("Jump\0", s3, s3, s4); } else { cs_op("Jump\0", s3, s3 + 1, s4); };
                CS_P2[pe1] = cmp; CS_P2[pe2] = cmp;
            };
            if (op == 3)
            {
                m1 = cs_op("Gosub\0", rl, subl, 0);
                m2 = cs_op("Yield\0", yl, 0, 0); pend[np] = m2; np++;
                pe1 = cs_op("Goto\0", 0, 0, 0);
                m0 = cs_op("Yield\0", yl, 0, 0); pend[np] = m0; np++;
                a = cs_op("Yield\0", yr, 0, 0); pend[np] = a; np++;
                pm = cs_perm();
                cmp = cs_op("Compare\0", outl, outr, CS_NKEY);
                if (pm == 1) { CS_P5[cmp] = 1; };
                CS_P4[cmp] = cs_ki2(CS_KI);
                cs_op("Jump\0", m2, m1, m0 + 1);
                CS_P2[pe1] = cmp;
            };
            if (op == 4)
            {
                d1 = cs_op("Gosub\0", rl, subl, 0);
                a = cs_op("Yield\0", yl, 0, 0); pend[np] = a; np++;
                cs_op("Goto\0", 0, d1, 0);
                e1 = cs_op("Gosub\0", rl, subl, 0);
                e2 = cs_op("Yield\0", yl, 0, 0); pend[np] = e2; np++;
                pe1 = cs_op("Goto\0", 0, 0, 0);
                m0 = cs_op("Yield\0", yl, 0, 0); pend[np] = m0; np++;
                cs_op("Yield\0", yr, d1, 0);
                pm = cs_perm();
                cmp = cs_op("Compare\0", outl, outr, CS_NKEY);
                if (pm == 1) { CS_P5[cmp] = 1; };
                CS_P4[cmp] = cs_ki2(CS_KI);
                cs_op("Jump\0", e1, e2, m0 + 1);
                CS_P2[pe1] = cmp;
            };
            CS_P2[icr] = m0;
            if (ycaller < 0 & CS_TRAIL > 0) { end = CS_N; }
            else { if (ycaller < 0) { end = cs_op("Halt\0", 0, 0, 0); }
            else { end = cs_op("EndCoroutine\0", ycaller, 0, 0); }; };
            for (a = 0; a < np; a++) { CS_P2[pend[a]] = end; };
            for (a = 0; a < CS_NDJ; a++) { CS_P2[CS_DJ[a]] = end; };
            CS_NDJ = 0;
            if (ycaller >= 0) { return xout; };
            return 0;
        };

        def sq_vd_compound(SQ_STMT* st, SQ_STMT* g) -> int
        {
            SQ_BLK* ab;
            int bi, na, i, j, k, init, a, tr, hasall, hasother, f2;
            SQ_IDX[12] cs_ixl;
            na = 0;
            hasall = 0; hasother = 0;
            bi = g.root_blk;
            while (bi >= 0)
            {
                if (na >= 30) { if (sq_vd_gon(441) == 1) { sq_seterr(st, "EXPLAIN is not available for this compound SELECT #441\0"); return 1; }; };
                ab = g.blks[bi];
                if (na > 0) { if (ab.cop == 2) { hasall = 1; } else { hasother = 1; }; };
                if (na > 0) { if (ab.nord > 0 | ab.limit_n >= 0 | ab.offset_n >= 0) { if (sq_vd_gon(442) == 1) { sq_seterr(st, "EXPLAIN is not available for a compound SELECT with ORDER BY or LIMIT #442\0"); return 1; }; }; };
                if (na > 0) { if (ab.nres != g.blks[CS_ARMS[0]].nres) { sq_seterr(st, "SELECTs to the left and right of a compound operator do not have the same number of result columns\0"); return 1; }; };
                CS_ARMS[na] = bi;
                na++;
                bi = ab.cnext;
            };
            CS_NCOL = g.blks[CS_ARMS[0]].nres;
            ab = g.blks[CS_ARMS[0]];
            if (hasother == 1)
            {
                for (j = 0; j < na; j++)
                {
                    ab = g.blks[CS_ARMS[j]];
                    if (ab.nsrc == 1 & ab.where_n < 0 & ab.nres >= 2 & ab.src[0].kind == 1 & ab.src[0].tbl >= 0 & (u64)ab.src[0].ti != (u64)0 & g.nodes[ab.rc[0]].kind == SQN_COL)
                    {
                        a = sq_idx_list(ab.src[0].sdb, ab.src[0].tbl, ab.src[0].ti, @cs_ixl[0], 12);
                        for (k = 0; k < a; k++)
                        {
                            if (cs_ixl[k].partial == 0 & cs_ixl[k].col[0] == g.nodes[ab.rc[0]].col & cs_ixl[k].isx[0] == 0)
                            {
                                if (sq_vd_covers1(g, ab.src[0].ti, @ab.src[0], @cs_ixl[k]) == 0 & sq_vd_gon(792) == 1) { sq_seterr(st, "EXPLAIN is not available for this compound SELECT #792\0"); return 1; };
                            };
                        };
                    };
                };
            };
            for (i = 0; i < 40; i++) { CS_KE[i] = 1; };
            for (j = 0; j < na; j++)
            {
                ab = g.blks[CS_ARMS[j]];
                for (i = 0; i < CS_NCOL & i < 40; i++)
                {
                    k = 0;
                    if (g.nodes[ab.rc[i]].kind == SQN_ROWID) { k = 1; };
                    if (g.nodes[ab.rc[i]].kind == SQN_COL & ab.nsrc == 1) { if ((u64)ab.src[0].ti != (u64)0) { if (g.nodes[ab.rc[i]].col == ab.src[0].ti.ipk & ab.src[0].ti.ipk >= 0) { k = 1; }; if (g.nodes[ab.rc[i]].col == ab.src[0].ti.ncols) { k = 1; }; }; };
                    if (k == 0) { CS_KE[i] = 0; };
                };
            };
            ab = g.blks[CS_ARMS[0]];
            CS_OBN = 0;
            for (i = 0; i < ab.nord; i++)
            {
                if (g.nodes[ab.ord[i]].kind != SQN_RESREF) { if (sq_vd_gon(443) == 1) { sq_seterr(st, "EXPLAIN is not available for this compound SELECT #443\0"); return 1; }; };
                CS_OBC[CS_OBN] = (int)g.nodes[ab.ord[i]].iv; CS_OBD[CS_OBN] = ab.odesc[i]; CS_OBU[CS_OBN] = ab.onull[i]; CS_OBK[CS_OBN] = ab.ocoll[i];
                if (ab.ocoll[i] >= 0) { if (sq_vd_gon(444) == 1) { sq_seterr(st, "EXPLAIN is not available for a compound SELECT ordered with a collation #444\0"); return 1; }; };
                CS_OBN++;
            };
            CS_ACNT = 0;
            CS_ONLYALL = 0;
            if (na > 1) { CS_ONLYALL = 1; };
            for (i = 1; i < na; i++) { if (g.blks[CS_ARMS[i]].cop != 2) { CS_ONLYALL = 0; }; };
            if (CS_ONLYALL != 0 & CS_OBN == 0) { if (sq_vd_gon(445) == 1) { sq_seterr(st, "EXPLAIN is not available for this compound SELECT #445\0"); return 1; }; };
            CS_NKEY = CS_OBN;
            for (bi = 0; bi < CS_NCOL; bi++)
            {
                f2 = 0;
                for (i = 0; i < CS_OBN; i++) { if (CS_OBC[i] == bi) { f2 = 1; }; };
                if (f2 == 0 & CS_ONLYALL == 0) { CS_NKEY++; };
            };
            CS_PERM = 0;
            {
                int kk, xx, ff;
                kk = 0;
                for (i = 0; i < CS_OBN; i++) { if (CS_OBC[i] != kk) { CS_PERM = 1; }; kk++; };
                if (CS_PERM == 1)
                {
                    CS_PLN = 0;
                    for (i = 0; i < CS_OBN; i++) { CS_PL[CS_PLN] = CS_OBC[i]; CS_PLN++; };
                    for (xx = 0; xx < CS_NCOL; xx++)
                    {
                        ff = 0;
                        for (i = 0; i < CS_OBN; i++) { if (CS_OBC[i] == xx) { ff = 1; }; };
                        if (CS_ONLYALL != 0) { ff = 1; };
                        if (ff == 0) { CS_PL[CS_PLN] = xx; CS_PLN++; };
                    };
                };
            };
            CS_LIM = ab.limit_n; CS_OFN = ab.offset_n;
            ab.nord = 0; ab.limit_n = 0 - 1; ab.offset_n = 0 - 1;
            if (CS_LIM >= 0)
            {
                if (g.nodes[CS_LIM].kind != SQN_INT) { if (sq_vd_gon(446) == 1) { sq_seterr(st, "EXPLAIN is not available for this LIMIT #446\0"); return 1; }; };
                if (g.nodes[CS_LIM].iv <= (i64)0 | g.nodes[CS_LIM].iv > (i64)2000000000) { if (sq_vd_gon(447) == 1) { sq_seterr(st, "EXPLAIN is not available for this LIMIT #447\0"); return 1; }; };
                if (CS_OFN >= 0)
                {
                    if (g.nodes[CS_OFN].kind != SQN_INT) { if (sq_vd_gon(448) == 1) { sq_seterr(st, "EXPLAIN is not available for this LIMIT #448\0"); return 1; }; };
                    if (g.nodes[CS_OFN].iv < (i64)0 | g.nodes[CS_OFN].iv > (i64)2000000000) { if (sq_vd_gon(449) == 1) { sq_seterr(st, "EXPLAIN is not available for this LIMIT #449\0"); return 1; }; };
                };
            }
            else { if (CS_OFN >= 0) { if (sq_vd_gon(450) == 1) { sq_seterr(st, "EXPLAIN is not available for this LIMIT #450\0"); return 1; }; }; };
            CS_NA = na;
            CS_NT = 0;
            for (i = 0; i < na; i++) { if (g.blks[CS_ARMS[i]].nsrc > 0) { CS_NT++; }; };
            if (CS_NT == 0) { if (sq_vd_gon(451) == 1) { sq_seterr(st, "EXPLAIN is not available for this compound SELECT #451\0"); return 1; }; };
            CS_SK = 0; CS_SKM = 0; CS_LREG = 0; CS_OREG = 0; CS_NDJ = 0; CS_OFF = 0; CS_ERR = 0; CS_KI = 0 - 1; CS_TR = 0 - 1; CS_NC = 0; CS_N = 0; CS_REG = 0;
            VD_N = 0; VD_TN = 0; VD_NH = 0;
            sq_vd_reset();
            init = cs_op("Init\0", 0, 0, 0);
            CN_N = 0;
            CS_TRAIL = 0;
            if (CS_OBN == 0) { while (CS_TRAIL < na - 2 & g.blks[CS_ARMS[na - 1 - CS_TRAIL]].cop == 2) { CS_TRAIL++; }; };
            if (CS_TRAIL > 0 & CS_LIM >= 0) { if (sq_vd_gon(452) == 1) { sq_seterr(st, "EXPLAIN is not available for this compound SELECT #452\0"); return 1; }; };
            CS_NA = na - CS_TRAIL;
            cs_gen(st, g, cn_build(g, na - CS_TRAIL - 1), 0 - 1);
            if (CS_ERR == 0)
            {
                for (i = na - CS_TRAIL; i < na; i++) { cs_plain(st, g, i); if (CS_ERR != 0) { break; }; };
                if (CS_TRAIL > 0) { cs_op("Halt\0", 0, 0, 0); };
            };
            if (CS_ERR != 0) { VD_KEEP = 0; if (st.err[0] == (byte)0) { sq_seterr(st, "EXPLAIN is not available for this compound SELECT\0"); }; return 1; };
            tr = cs_op("Transaction\0", CS_C1[255], CS_C2[255], CS_C3[255]);
            CS_O[tr] = CS_TR; CS_P4[tr] = CS_C4[255]; CS_P5[tr] = CS_C5[255];
            CS_P2[init] = tr;
            for (i = 0; i < CS_NC; i++)
            {
                a = cs_op("Nop\0", 0, 0, 0);
                CS_O[a] = CS_CO[i]; CS_P1[a] = CS_C1[i]; CS_P2[a] = CS_C2[i]; CS_P3[a] = CS_C3[i]; CS_P4[a] = CS_C4[i]; CS_P5[a] = CS_C5[i];
            };
            cs_op("Goto\0", 0, 1, 0);
            if (CS_ERR != 0) { if (sq_vd_gon(453) == 1) { sq_seterr(st, "EXPLAIN is not available for this compound SELECT #453\0"); return 1; }; };
            for (i = 0; i < CS_N; i++)
            {
                VD_O[i] = CS_O[i]; VD_P1[i] = CS_P1[i]; VD_P2[i] = CS_P2[i]; VD_P3[i] = CS_P3[i]; VD_P4[i] = CS_P4[i]; VD_P5[i] = CS_P5[i];
            };
            VD_N = CS_N;
            return 0;
        };

        // ---- INSERT, UPDATE and DELETE on plain rowid tables ----

        def sq_vd_skip(byte* t, int n, int i) -> int
        {
            int go;
            go = 1;
            while (go == 1)
            {
                go = 0;
                while (i < n & (t[i] == (byte)32 | t[i] == (byte)9 | t[i] == (byte)10 | t[i] == (byte)13)) { i++; };
                if (sq_vd_gon(761) == 1) { return i; };
                if (i + 1 < n)
                {
                    if (t[i] == (byte)45 & t[i + 1] == (byte)45)
                    {
                        while (i < n & t[i] != (byte)10) { i++; };
                        go = 1;
                    }
                    else
                    {
                        if (t[i] == (byte)47 & t[i + 1] == (byte)42)
                        {
                            i = i + 2;
                            while (i + 1 < n & (t[i] != (byte)42 | t[i + 1] != (byte)47)) { i++; };
                            if (i + 1 < n) { i = i + 2; } else { i = n; };
                            go = 1;
                        };
                    };
                };
            };
            return i;
        };

        // end of the last real token of a statement: trailing whitespace, semicolons and comments are not part of it
        def sq_vd_endtrim(byte* t, int s, int n) -> int
        {
            int i, last;
            byte c, q;
            i = s; last = s;
            while (i < n)
            {
                c = t[i];
                if (c == (byte)39 | c == (byte)34 | c == (byte)96)
                {
                    q = c; i++;
                    while (i < n)
                    {
                        if (t[i] == q)
                        {
                            if (i + 1 < n) { if (t[i + 1] == q) { i = i + 2; continue; }; };
                            i++;
                            break;
                        };
                        i++;
                    };
                    last = i;
                    continue;
                };
                if (c == (byte)91)
                {
                    while (i < n & t[i] != (byte)93) { i++; };
                    if (i < n) { i++; };
                    last = i;
                    continue;
                };
                if (c == (byte)45 & i + 1 < n) { if (t[i + 1] == (byte)45) { while (i < n & t[i] != (byte)10) { i++; }; continue; }; };
                if (c == (byte)47 & i + 1 < n)
                {
                    if (t[i + 1] == (byte)42)
                    {
                        i = i + 2;
                        while (i + 1 < n & (t[i] != (byte)42 | t[i + 1] != (byte)47)) { i++; };
                        if (i + 1 < n) { i = i + 2; } else { i = n; };
                        continue;
                    };
                };
                if (c == (byte)32 | c == (byte)9 | c == (byte)10 | c == (byte)13 | c == (byte)59) { i++; continue; };
                i++;
                last = i;
            };
            return last;
        };

        // index after the keyword kw at position i, or -1
        def sq_vd_word(byte* t, int n, int i, byte* kw) -> int
        {
            int m, k;
            byte a, b;
            m = sq_cstrlen(kw);
            if (i + m > n) { return 0 - 1; };
            for (k = 0; k < m; k++)
            {
                a = t[i + k]; b = kw[k];
                if (a >= (byte)65 & a <= (byte)90) { a = a + (byte)32; };
                if (a != b) { return 0 - 1; };
            };
            if (i + m < n)
            {
                a = t[i + m];
                if (sq_isalpha(a) | sq_isdigit(a) | a == (byte)95) { return 0 - 1; };
            };
            return i + m;
        };

        // an identifier at i: *ps and *pl give its text (quotes excluded); returns the index after it or -1
        def sq_vd_ident(byte* t, int n, int i, int* ps, int* pl) -> int
        {
            byte q;
            int b;
            if (i >= n) { return 0 - 1; };
            q = t[i];
            if (q == (byte)34 | q == (byte)96 | q == (byte)91)
            {
                if (q == (byte)91) { q = (byte)93; };
                b = i + 1;
                i++;
                while (i < n & t[i] != q) { i++; };
                if (i >= n) { return 0 - 1; };
                *ps = b; *pl = i - b;
                return i + 1;
            };
            if (sq_isalpha(q) == false & q != (byte)95) { return 0 - 1; };
            b = i;
            while (i < n & (sq_isalpha(t[i]) | sq_isdigit(t[i]) | t[i] == (byte)95)) { i++; };
            *ps = b; *pl = i - b;
            return i;
        };

        // prepares "select <head><name><tail>" and returns the statement, or null
        def sq_vd_prep(SQ_STMT* st, byte* head, byte* nm, int nl, byte* tail, int tn, SQ_STMT** pg) -> int
        {
            SQ_SB q;
            SQ_STMT* g;
            sq_sb_init(@q);
            sq_sb_lit(@q, head);
            if (nl > 0) { sq_sb_lit(@q, "\"\0"); sq_sb_add(@q, nm, nl); sq_sb_lit(@q, "\"\0"); };
            if (tn > 0) { sq_sb_add(@q, tail, tn); };
            g = sq_stmt_new();
            if ((u64)g == (u64)0) { sq_sb_free(@q); sq_seterr(st, "out of memory\0"); return 1; };
            if (sq_prep_query(g, st.db, q.p) != 0)
            {
                sq_seterr(st, g.err);
                sq_stmt_del(g); sq_sb_free(@q);
                return 1;
            };
            sq_sb_free(@q);
            *pg = g;
            return 0;
        };

        // like sq_vd_prep with a WHERE clause text appended when tn > 0
        def sq_vd_prep2(SQ_STMT* st, byte* head, byte* nm, int nl, byte* tail, int tn, SQ_STMT** pg) -> int
        {
            SQ_SB q;
            SQ_STMT* g;
            sq_sb_init(@q);
            sq_sb_lit(@q, head);
            sq_sb_lit(@q, "\"\0");
            sq_sb_add(@q, nm, nl);
            sq_sb_lit(@q, "\"\0");
            if (tn > 0) { sq_sb_lit(@q, " where \0"); sq_sb_add(@q, tail, tn); };
            g = sq_stmt_new();
            if ((u64)g == (u64)0) { sq_sb_free(@q); sq_seterr(st, "out of memory\0"); return 1; };
            if (sq_prep_query(g, st.db, q.p) != 0)
            {
                sq_seterr(st, g.err);
                sq_stmt_del(g); sq_sb_free(@q);
                return 1;
            };
            sq_sb_free(@q);
            *pg = g;
            return 0;
        };

        // the table of a prepared "select * from T": 0 when it is a plain rowid table without triggers, indexes of its own beyond nix
        def sq_vd_plain(SQ_STMT* st, SQ_STMT* g, byte* nm, int nl, int* pnix) -> int
        {
            SQ_BLK* b = g.blks[g.root_blk];
            SQ_SRC* sr;
            SQ_TI* ti;
            SQ_IDX[12] ixs;
            byte[130] nbuf;
            int i;
            if (b.nsrc != 1) { if (sq_vd_gon(454) == 1) { sq_seterr(st, "EXPLAIN is not available for this statement #454\0"); return 1; }; };
            sr = @b.src[0];
            if (sr.kind != 1 | (u64)sr.ti == (u64)0 | sr.tbl < 0) { if (sq_vd_gon(455) == 1) { sq_seterr(st, "EXPLAIN is not available for this table #455\0"); return 1; }; };
            ti = sr.ti;
            if ((ti.wor != 0 & VD_PLWOR == 0) | ti.nchk != 0 | ti.ngen != 0) { if (sq_vd_gon(456) == 1) { sq_seterr(st, "EXPLAIN is not available for this table #456\0"); return 1; }; };
            for (i = 0; i < nl & i < 128; i++) { nbuf[i] = nm[i]; };
            nbuf[i] = (byte)0;
            if (sq_tbl_has_trg(st.db, @nbuf[0])) { if (sq_vd_gon(457) == 1) { sq_seterr(st, "EXPLAIN is not available for tables with triggers #457\0"); return 1; }; };
            *pnix = sq_idx_list(sr.sdb, sr.tbl, ti, @ixs[0], 12);
            return 0;
        };

        // INSERT into a table with an INTEGER PRIMARY KEY from a row source: the key column decides the rowid
        def sq_vd_ipkput(SQ_TI* ti, byte* t, int ns, int nl, int cur, int rr, int base) -> void
        {
            SQ_SB aff;
            int k, a;
            sq_vd_op("Copy\0", base + ti.ipk, rr, 0);
            sq_vd_op("SoftNull\0", base + ti.ipk, 0, 0);
            k = sq_vd_op("NotNull\0", rr, 0, 0);
            sq_vd_op("NewRowid\0", cur, rr, 0);
            VD_P2[k] = VD_N;
            sq_vd_op("MustBeInt\0", rr, 0, 0);
            k = sq_vd_op("NotExists\0", cur, 0, rr);
            a = sq_vd_op("Halt\0", 1555, 2, 0);
            sq_sb_init(@aff);
            sq_sb_add(@aff, @t[ns], nl);
            sq_sb_lit(@aff, ".\0");
            sq_sb_add(@aff, @ti.base[ti.cs[ti.ipk]], ti.cl[ti.ipk]);
            sq_vd_p4s(a, aff.p, aff.n);
            sq_sb_free(@aff);
            VD_P5[a] = 2;
            VD_P2[k] = VD_N;
        };

        // INSERT with several VALUES rows into a plain table: the rows are produced by a coroutine
        // OpenWrite of every index of an INSERT target (newest index gets the lowest cursor after the table): 0 ok, 1 unsupported
        global SQ_TI* VD_DTI;
        def sq_vd_ixwhere(SQ_IDX* ix, SQ_STMT** pg, int* pj) -> int;
        def sq_vd_ixprep(SQ_IDX* ix, SQ_STMT** pg) -> int;

        // 1 when an UPDATE that assigns the columns with map[c] >= 0 changes anything the index stores or tests, 0 when it does not,
        // 0-1 when the index text cannot be analysed
        def sq_vd_ixchg(SQ_IDX* ix, SQ_TI* ti, int* map) -> int
        {
            SQ_STMT* gk;
            SQ_NODE* nd;
            int k, c, r;
            VD_DTI = ti;
            if (sq_vd_ixprep(ix, @gk) != 0) { return 0 - 1; };
            r = 0;
            for (k = 0; k < gk.nn; k++)
            {
                nd = @gk.nodes[k];
                if (nd.kind != SQN_COL | nd.lvl != 0) { continue; };
                c = nd.col;
                if (c >= 0 & c < ti.ncols) { if (map[c] >= 0) { r = 1; }; };
            };
            sq_stmt_del(gk);
            return r;
        };
        def sq_vd_ixkey(SQ_IDX* ix, SQ_STMT* gk, int slot, int j, int cur, int reg) -> int;

        // dry run of the WHERE and key expressions of a partial or expression index in register mode: 1 when they cannot be coded
        def sq_vd_ixprobe(SQ_TI* ti, SQ_IDX* xi, int regmode) -> int
        {
            SQ_STMT* gk;
            int n0, h0, j0, m0, f0, x0, hx, j, slot, r, nj0, x;
            hx = 0;
            for (j = 0; j < xi.nk; j++) { if (xi.isx[j] != 0) { hx = 1; }; };
            if (xi.partial == 0 & hx == 0) { return 0; };
            n0 = VD_N; h0 = VD_NH; j0 = VD_NJ; m0 = VD_NMEM; f0 = VD_NFREE; x0 = VD_XGN;
            if (regmode == 1) { VD_RGB = 1; VD_RGR = 1; };
            VD_DTI = ti;
            r = 0;
            nj0 = VD_NJ;
            VD_NMEM = 200;
            slot = sq_vd_ixwhere(xi, @gk, @nj0);
            if (slot == 0 - 2) { r = 1; }
            else { for (j = 0; j < xi.nk; j++) { if (sq_vd_ixkey(xi, gk, slot, j, 0, 150) != 0) { r = 1; }; }; };
            VD_RGB = 0; VD_RGR = 0;
            VD_N = n0; VD_NH = h0; VD_NJ = j0; VD_NMEM = m0; VD_NFREE = f0;
            for (x = x0; x < VD_XGN; x++) { sq_stmt_del((SQ_STMT*)VD_XG[x]); };
            VD_XGN = x0;
            return r;
        };

        def sq_vd_insopen(SQ_TI* ti, SQ_IDX* ixl, int nx, int tcur) -> int
        {
            SQ_IDX* xi;
            SQ_SB kt;
            int k, j, a;
            for (k = nx - 1; k >= 0; k--)
            {
                xi = @ixl[k];
                if (xi.nk < 1) { return 1; };
                for (j = 0; j < xi.nk; j++) { if (xi.isx[j] == 0 & (xi.col[j] == ti.ipk | xi.col[j] >= ti.ncols)) { return 1; }; };
                if (sq_vd_ixprobe(ti, xi, 1) != 0) { return 1; };
                a = sq_vd_op("OpenWrite\0", tcur + nx - k, xi.root, 0);
                sq_sb_init(@kt);
                if (sq_vd_kinfo(xi, @kt) != 0) { sq_sb_free(@kt); return 1; };
                sq_vd_p4s(a, kt.p, kt.n);
                sq_sb_free(@kt);
            };
            return 0;
        };

        // the record and index part of an INSERT whose row is in base..base+ncol-1 with its rowid in rowr
        def sq_vd_instail(SQ_TI* ti, SQ_IDX* ixl, int nx, byte* t, int ns, int nl, int base, int rowr, int tcur, int rec0, int orm, int p5, int* ign, int* pnign) -> int
        {
            SQ_IDX* xi;
            SQ_IDX* yi;
            SQ_SB aff;
            SQ_SB un;
            int[12] irec;
            int[12] ikb;
            SQ_STMT* gk;
            int[12] isl;
            int[12] ipj;
            int ncol, xk, yk, j, k, c, a, ne, ne2, nkc, kb, kb2, idxrec, recr, hasaff, useaff, tmp, nm, hx, slot, nj0, x, npart;
            ncol = ti.ncols;
            hasaff = 0;
            for (k = 0; k < ncol; k++) { if (ti.aff[k] != 0) { hasaff = 1; }; };
            sq_sb_init(@aff);
            for (k = 0; k < ncol; k++) { c = 65 + ti.aff[k]; sq_sb_add(@aff, (byte*)@c, 1); };
            while (aff.n > 0 & aff.p[aff.n - 1] == (byte)65) { aff.n--; };
            useaff = 0;
            if (nx > 0 & aff.n > 0)
            {
                a = sq_vd_op("Affinity\0", base, aff.n, 0);
                sq_vd_p4s(a, aff.p, aff.n);
                useaff = 1;
            };
            nm = rec0 - 1;
            for (xk = nx - 1; xk >= 0; xk--)
            {
                nm++;
                irec[xk] = nm;
                ikb[xk] = nm + 1;
                nm = nm + ixl[xk].nk + 1;
            };
            nm++;
            recr = nm;
            VD_NMEM = nm;
            npart = 0;
            for (xk = nx - 1; xk >= 0; xk--) { if (ixl[xk].partial != 0) { npart = 1; }; };
            if (npart == 1) { VD_NMEM = nm + 1; sq_vd_putreg(nm + 1); };
            for (xk = nx - 1; xk >= 0; xk--)
            {
                xi = @ixl[xk];
                nkc = xi.nk;
                idxrec = irec[xk];
                kb = ikb[xk];
                hx = 0;
                for (j = 0; j < nkc; j++) { if (xi.isx[j] != 0) { hx = 1; }; };
                slot = 0 - 1;
                nj0 = VD_NJ;
                ipj[xk] = nj0;
                if (xi.partial != 0) { sq_vd_op("Null\0", 0, idxrec, 0); };
                if (xi.partial != 0 | hx == 1)
                {
                    VD_RGB = base; VD_RGR = rowr; VD_DTI = ti;
                    slot = sq_vd_ixwhere(xi, @gk, @nj0);
                    VD_RGB = 0; VD_RGR = 0;
                    if (slot == 0 - 2) { return 1; };
                };
                isl[xk] = slot;
                for (j = 0; j < nkc; j++)
                {
                    if (xi.isx[j] != 0)
                    {
                        VD_RGB = base; VD_RGR = rowr; VD_DTI = ti;
                        x = sq_vd_ixkey(xi, gk, slot, j, 0, kb + j);
                        VD_RGB = 0; VD_RGR = 0;
                        if (x != 0) { return 1; };
                    }
                    else { sq_vd_op("SCopy\0", base + xi.col[j], kb + j, 0); };
                };
                sq_vd_op("IntCopy\0", rowr, kb + nkc, 0);
                sq_vd_op("MakeRecord\0", kb, nkc + 1, idxrec);
                if (xi.unique != 0)
                {
                    ne = sq_vd_op("NoConflict\0", tcur + nx - xk, 0, kb);
                    sq_vd_p4i(ne, (i64)nkc);
                    if (orm == 2)
                    {
                        ign[pnign[0]] = sq_vd_op("Goto\0", 0, 0, 0);
                        pnign[0] = pnign[0] + 1;
                        VD_P2[ne] = VD_N;
                    };
                    if (orm == 1)
                    {
                        tmp = sq_vd_getreg();
                        sq_vd_op("IdxRowid\0", tcur + nx - xk, tmp, 0);
                        ne2 = sq_vd_op("NotExists\0", tcur, 0, tmp);
                        sq_vd_p4i(ne2, (i64)1);
                        for (yk = nx - 1; yk >= 0; yk--)
                        {
                            if (yk == xk) { continue; };
                            yi = @ixl[yk];
                            hx = 0;
                            for (j = 0; j < yi.nk; j++) { if (yi.isx[j] != 0) { hx = 1; }; };
                            slot = 0 - 1;
                            nj0 = VD_NJ;
                            if (yi.partial != 0 | hx == 1)
                            {
                                VD_DTI = ti; VD_COLCUR = tcur;
                                slot = sq_vd_ixwhere(yi, @gk, @nj0);
                            };
                            kb2 = sq_vd_getrange(yi.nk + 1);
                            for (j = 0; j < yi.nk; j++)
                            {
                                if (yi.isx[j] != 0) { sq_vd_ixkey(yi, gk, slot, j, tcur, kb2 + j); }
                                else { sq_vd_op("Column\0", tcur, yi.col[j], kb2 + j); };
                            };
                            sq_vd_op("Rowid\0", tcur, kb2 + yi.nk, 0);
                            a = sq_vd_op("IdxDelete\0", tcur + nx - yk, kb2, yi.nk + 1);
                            sq_vd_p4s(a, @yi.name[0], sq_cstrlen(@yi.name[0]));
                            sq_vd_putrange(kb2, yi.nk + 1);
                            VD_COLCUR = 0;
                            for (x = nj0; x < VD_NJ; x++) { VD_P2[VD_JF[x]] = VD_N; };
                            VD_NJ = nj0;
                        };
                        sq_vd_putreg(tmp);
                        a = sq_vd_op("Delete\0", tcur, 0, 0);
                        sq_vd_p4s(a, @t[ns], nl);
                        sq_vd_op("Delete\0", tcur + nx - xk, 0, 0);
                        VD_P2[ne] = VD_N;
                        VD_P2[ne2] = VD_N;
                    };
                    if (orm == 0)
                    {
                        a = sq_vd_op("Halt\0", 2067, 2, 0);
                        sq_sb_init(@un);
                        for (j = 0; j < nkc; j++)
                        {
                            if (j > 0) { sq_sb_lit(@un, ", \0"); };
                            sq_sb_add(@un, @t[ns], nl);
                            sq_sb_lit(@un, ".\0");
                            sq_sb_add(@un, @ti.base[ti.cs[xi.col[j]]], ti.cl[xi.col[j]]);
                        };
                        sq_vd_p4s(a, un.p, un.n);
                        sq_sb_free(@un);
                        VD_P5[a] = 2;
                        VD_P2[ne] = VD_N;
                    };
                };
                if (slot >= 0)
                {
                    for (x = ipj[xk]; x < VD_NJ; x++) { VD_P2[VD_JF[x]] = VD_N; };
                    VD_NJ = ipj[xk];
                };
            };
            a = sq_vd_op("MakeRecord\0", base, ncol, recr);
            if (useaff == 0 & hasaff == 1) { sq_vd_p4s(a, aff.p, aff.n); };
            sq_sb_free(@aff);
            for (xk = nx - 1; xk >= 0; xk--)
            {
                if (ixl[xk].partial != 0) { a = sq_vd_op("IsNull\0", irec[xk], VD_N + 2, 0); };
                a = sq_vd_op("IdxInsert\0", tcur + nx - xk, irec[xk], ikb[xk]);
                sq_vd_p4i(a, (i64)(ixl[xk].nk + 1));
                VD_P5[a] = 16;
            };
            a = sq_vd_op("Insert\0", tcur, recr, rowr);
            sq_vd_p4s(a, @t[ns], nl);
            VD_P5[a] = p5;
            return 0;
        };

        def sq_vd_insmulti(SQ_STMT* st, SQ_STMT* g1, SQ_TI* ti, SQ_SRC* sr, byte* t, int n, int i, int vs, int ve, int ns, int nl, int* map, int nv, byte** pq) -> int
        {
            if (ti.wor != 0 | ti.autoinc != 0) { sq_stmt_del(g1); sq_seterr(st, "EXPLAIN is not available for this INSERT\0"); return 1; };
            SQ_STMT* g2;
            SQ_BLK* b2;
            SQ_SB aff;
            SQ_IDX[12] ixl;
            int[12] ign;
            int nign, p5v, ident, rr, mb;
            int ncol, init, ic, a, k, c, y, rec, rs, re, depth, nx;
            byte q;
            ncol = ti.ncols;
            ident = 1;
            if (nv != ncol) { ident = 0; };
            for (k = 0; k < ncol; k++) { if (map[k] != k) { ident = 0; }; };
            nx = sq_idx_list(sr.sdb, sr.tbl, ti, @ixl[0], 12);
            for (k = 0; k < ncol; k++) { if (ti.notnull[k] != 0 | ti.dfl[k] != 0) { sq_stmt_del(g1); sq_seterr(st, "EXPLAIN is not available for this INSERT\0"); return 1; }; };
            sq_vd_reset();
            init = sq_vd_op("Init\0", 0, 0, 0);
            ic = sq_vd_op("InitCoroutine\0", 1, 0, 2);
            VD_NMEM = 1; VD_NFREE = 0; VD_NH = 0; VD_NJ = 0;
            rs = vs; re = ve;
            while (1 == 1)
            {
                if (sq_vd_prep(st, "select \0", (byte*)0, 0, @t[rs], re - rs, @g2) != 0) { sq_stmt_del(g1); return 1; };
                b2 = g2.blks[g2.root_blk];
                if (b2.nres != nv) { sq_stmt_del(g1); sq_stmt_del(g2); sq_seterr(st, "EXPLAIN is not available for this INSERT\0"); return 1; };
                for (k = 0; k < nv; k++)
                {
                    if (sq_vd_isconst(g2, b2.rc[k]) == false) { sq_stmt_del(g1); sq_stmt_del(g2); sq_seterr(st, "EXPLAIN is not available for this expression\0"); return 1; };
                    sq_vd_lit(g2, b2.rc[k], 4 + k);
                };
                sq_stmt_del(g2);
                sq_vd_op("Yield\0", 1, 0, 0);
                i = sq_vd_skip(t, n, re + 1);
                if (i >= n) { break; };
                if (t[i] != (byte)44) { sq_stmt_del(g1); sq_seterr(st, "EXPLAIN is not available for this INSERT\0"); return 1; };
                i = sq_vd_skip(t, n, i + 1);
                if (i >= n | t[i] != (byte)40) { sq_stmt_del(g1); sq_seterr(st, "EXPLAIN is not available for this INSERT\0"); return 1; };
                rs = i + 1;
                depth = 0;
                while (i < n)
                {
                    q = t[i];
                    if (q == (byte)39 | q == (byte)34)
                    {
                        i++;
                        while (i < n & t[i] != q) { i++; };
                    };
                    if (t[i] == (byte)40) { depth++; };
                    if (t[i] == (byte)41) { depth--; if (depth == 0) { break; }; };
                    i++;
                };
                if (i >= n) { sq_stmt_del(g1); sq_seterr(st, "EXPLAIN is not available for this INSERT\0"); return 1; };
                re = i;
            };
            sq_vd_op("EndCoroutine\0", 1, 0, 0);
            VD_P2[ic] = VD_N;
            a = sq_vd_op("OpenWrite\0", 0, sr.root, 0);
            sq_vd_p4i(a, (i64)ncol);
            if (sq_vd_insopen(ti, @ixl[0], nx, 0) != 0) { sq_stmt_del(g1); sq_seterr(st, "EXPLAIN is not available for this index\0"); return 1; };
            y = sq_vd_op("Yield\0", 1, 0, 0);
            if (ident == 0)
            {
                rr = 4 + 2 * nv;
                mb = rr + 1;
                VD_NMEM = mb + ncol - 1; VD_NFREE = 0; VD_NH = 0;
                if (ti.ipk >= 0)
                {
                    if (map[ti.ipk] >= 0) { sq_stmt_del(g1); sq_seterr(st, "EXPLAIN is not available for this INSERT\0"); return 1; };
                    sq_vd_op("SoftNull\0", mb + ti.ipk, 0, 0);
                };
                for (k = 0; k < ncol; k++)
                {
                    if (k == ti.ipk) { continue; };
                    if (map[k] >= 0) { sq_vd_op("SCopy\0", 4 + map[k], mb + k, 0); }
                    else { VD_HF[VD_NH] = 0; VD_HN[VD_NH] = 0 - 1; VD_HR[VD_NH] = mb + k; VD_HEP[VD_NH] = 0; VD_NH++; };
                };
                sq_vd_op("NewRowid\0", 0, rr, 0);
                nign = 0;
                if (nx > 0)
                {
                    sq_vd_instail(ti, @ixl[0], nx, t, ns, nl, mb, rr, 0, VD_NMEM + 1, 0, 57, @ign[0], @nign);
                }
                else
                {
                    VD_NMEM++;
                    a = sq_vd_op("MakeRecord\0", mb, ncol, VD_NMEM);
                    sq_sb_init(@aff);
                    for (k = 0; k < ncol; k++) { c = 65 + ti.aff[k]; sq_sb_add(@aff, (byte*)@c, 1); };
                    while (aff.n > 0 & aff.p[aff.n - 1] == (byte)65) { aff.n--; };
                    if (aff.n > 0) { sq_vd_p4s(a, aff.p, aff.n); };
                    sq_sb_free(@aff);
                    a = sq_vd_op("Insert\0", 0, VD_NMEM, rr);
                    sq_vd_p4s(a, @t[ns], nl);
                    VD_P5[a] = 57;
                };
                sq_vd_op("Goto\0", 0, y, 0);
                VD_P2[y] = VD_N;
                sq_vd_op("Halt\0", 0, 0, 0);
                VD_P2[init] = VD_N;
                sq_vd_trans(st.db, 1);
                for (k = 0; k < VD_NH; k++) { if (VD_HN[k] < 0) { sq_vd_op("Null\0", 0, VD_HR[k], 0); } else { sq_vd_lit(g1, VD_HN[k], VD_HR[k]); }; };
                sq_vd_op("Goto\0", 0, 1, 0);
                sq_stmt_del(g1);
                sq_vd_query(pq);
                return 0;
            };
            if (ti.ipk >= 0) { sq_vd_ipkput(ti, t, ns, nl, 0, 3, 4); }
            else { sq_vd_op("NewRowid\0", 0, 3, 0); };
            rec = 3 * ncol + 5;
            if (nx > 0)
            {
                nign = 0;
                p5v = 57;
                if (ti.ipk >= 0) { p5v = 49; };
                sq_vd_instail(ti, @ixl[0], nx, t, ns, nl, 4, 3, 0, rec, 0, p5v, @ign[0], @nign);
                sq_vd_op("Goto\0", 0, y, 0);
                VD_P2[y] = VD_N;
                sq_vd_op("Halt\0", 0, 0, 0);
                VD_P2[init] = VD_N;
                sq_vd_trans(st.db, 1);
                for (k = 0; k < VD_NH; k++) { if (VD_HN[k] >= 0) { sq_vd_lit(g1, VD_HN[k], VD_HR[k]); }; };
                sq_vd_op("Goto\0", 0, 1, 0);
                sq_stmt_del(g1);
                sq_vd_query(pq);
                return 0;
            };
            a = sq_vd_op("MakeRecord\0", 4, ncol, rec);
            sq_sb_init(@aff);
            for (k = 0; k < ncol; k++) { c = 65 + ti.aff[k]; sq_sb_add(@aff, (byte*)@c, 1); };
            while (aff.n > 0 & aff.p[aff.n - 1] == (byte)65) { aff.n--; };
            if (aff.n > 0) { sq_vd_p4s(a, aff.p, aff.n); };
            sq_sb_free(@aff);
            a = sq_vd_op("Insert\0", 0, rec, 3);
            sq_vd_p4s(a, @t[ns], nl);
            VD_P5[a] = 57;
            if (ti.ipk >= 0) { VD_P5[a] = 49; };
            sq_vd_op("Goto\0", 0, y, 0);
            VD_P2[y] = VD_N;
            sq_vd_op("Halt\0", 0, 0, 0);
            VD_P2[init] = VD_N;
            sq_vd_trans(st.db, 1);
            sq_vd_op("Goto\0", 0, 1, 0);
            sq_stmt_del(g1);
            sq_vd_query(pq);
            return 0;
        };

        // INSERT ... SELECT of plain columns from one table: the SELECT runs as a coroutine
        def sq_vd_inssel(SQ_STMT* st, SQ_STMT* g1, SQ_TI* ti, SQ_SRC* sr, byte* t, int n, int i, int ns, int nl, int* map, int nv, byte** pq) -> int
        {
