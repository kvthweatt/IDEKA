                c = @g.nodes[b.rc[i]];
                if (c.kind == SQN_ROWID) { return 1; };
                if (c.kind != SQN_COL | c.lvl != 0) { continue; };
                if (c.col == ti.ipk | c.col == ti.ncols) { return 1; };
                if (c.col >= 0 & c.col < 16) { if (ti.coll[c.col] == 0) { inres[c.col] = 1; }; };
            };
