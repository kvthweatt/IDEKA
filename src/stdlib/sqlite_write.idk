                        if (m > 2) { VD_NOHOIST = 0; return 2; };
                        x = s;
                        if (m == 1) { for (j = 0; j < n; j++) { if (((tm[i] >> j) `& 1) != 0) { x = j; }; }; };
                        sq_vd_pointat(b, x, nlx.ix);
                        if (sq_vd_where(g, b.src[x].ti, cj[i]) != 0) { VD_NOHOIST = 0; return 2; };
                    };
                };
                VD_NOHOIST = 0;
                jhi[L] = VD_NJ;
                if (left[s] == 1) { lint[L] = sq_vd_op("Integer\0", 1, lflag[L], 0); };
            };
            if (jagg == 1)
            {
                if (sq_vd_jagg_step(st, g, b, 0, 0) != 0) { return 2; };
            }
            else
            {
                if (ordm == 1)
                {
                    ooff = VD_NMEM;
                    ooutr = ooff + onk + nres + 1;
                    obase = ooff + onk + 1;
                    VD_P2[osn] = onk + nres + 1;
                    for (i = 0; i < nres; i++)
                    {
                        if (rpos[i] >= onk)
                        {
                            sq_vd_rdc(b, rcs[i], rcc[i], ooff + 1 + rpos[i]);
                        };
                    };
                    for (i = 0; i < onk; i++)
                    {
                        sq_vd_rdc(b, oks[i], okc[i], ooff + 1 + i);
                    };
                    sq_vd_op("MakeRecord\0", ooff + 1, onk + ond2, ooutr);
                    a = sq_vd_op("SorterInsert\0", scur, ooutr, ooff + 1);
                    sq_vd_p4i(a, (i64)(onk + ond2));
                }
                else
                {
                    base = VD_NMEM + 1;
                    VD_NMEM = VD_NMEM + nres;
                    if (dstm == 1) { drec = sq_vd_getreg(); };
                    for (i = 0; i < nres; i++)
                    {
                        nd = @g.nodes[b.rc[i]];
                        if (nd.kind == SQN_COL)
                        {
                            if (nd.src < 0 | nd.src >= n) { return 2; };
                            sq_vd_pointat(b, nd.src, nlx.ix);
                            if (sq_vd_expr(g, b.src[nd.src].ti, b.rc[i], base + i) != 0) { return 2; };
                        }
                        else
                        {
                            x = sq_eqp_mask(g, b.rc[i]);
                            m = 0 - 1;
                            for (j = 0; j < n; j++) { if (((x >> j) `& 1) != 0) { if (m >= 0) { return 2; }; m = j; }; };
                            if (m < 0) { m = 0; };
                            sq_vd_pointat(b, m, nlx.ix);
                            if (sq_vd_expr(g, b.src[m].ti, b.rc[i], base + i) != 0) { return 2; };
                        };
                    };
                    if (dstm == 1)
                    {
                        dfound = sq_vd_op("Found\0", scur, 0, base);
                        sq_vd_p4i(dfound, (i64)nres);
                        sq_vd_op("MakeRecord\0", base, nres, drec);
                        a = sq_vd_op("IdxInsert\0", scur, drec, base);
                        sq_vd_p4i(a, (i64)nres);
                        VD_P5[a] = 16;
                    };
                    sq_vd_op("ResultRow\0", base, nres, 0);
                    if (VD_SEMI == 1) { sgo = sq_vd_op("Goto\0", 0, 0, 0); };
                };
            };
            lim = 0 - 1;
            if (hasl == 1) { lim = sq_vd_op("DecrJumpZero\0", 1, 0, 0); };
            for (L = n - 1; L >= 0; L--)
            {
                s = ord[L];
                nxt[L] = VD_N;
                if (kind[L] == 0)
                {
                    a = sq_vd_op("Next\0", s, body[L], 0);
                    VD_P5[a] = 1;
                    if (VD_INSUB == 1 & s == 1) { VD_P5[a] = 0; };
                };
                if (kind[L] == 3)
                {
                    a = sq_vd_op("Next\0", icur[L], body[L], 0);
                    VD_P5[a] = 1;
                };
                if (kind[L] == 4) { a = sq_vd_op("Next\0", icur[L], body[L], 0); };
                if (kind[L] == 2 & uniq[L] == 0)
                {
                    x = 0;
                    if (neq[L] == nlx.ix[s].nk) { x = 1; };
                    if (VD_INSUB == 1) { x = 0; };
                    a = sq_vd_op("Next\0", icur[L], body[L], x);
                };
                ifp[L] = VD_N;
                if (left[s] == 1)
                {
                    a = sq_vd_op("IfPos\0", lflag[L], 0, 0);
                    if (kind[L] != 3 & kind[L] != 4 & cov[L] == 0) { sq_vd_op("NullRow\0", s, 0, 0); };
                    if (icur[L] > 0) { sq_vd_op("NullRow\0", icur[L], 0, 0); };
                    sq_vd_op("Goto\0", 0, lint[L], 0);
                    VD_P2[a] = VD_N;
                };
                exl[L] = VD_N;
            };
            for (L = 0; L < n; L++)
            {
                s = ord[L];
                tgt = exl[L];
                if (left[s] == 1) { tgt = ifp[L]; };
                if (kind[L] == 0 | kind[L] == 3) { VD_P2[rew[L]] = tgt; if (L > 0 & left[s] == 0 & kind[L] == 0) { VD_P2[rew[L]] = exl[0]; }; };
                if (kind[L] == 1) { VD_P2[sop[L]] = tgt; if (kjm[L * 4] >= 0) { VD_P2[kjm[L * 4]] = tgt; }; };
                if (kind[L] == 4)
                {
                    if (left[s] == 1) { VD_P2[arew[L]] = lbody[L]; } else { VD_P2[arew[L]] = exl[0]; };
                    VD_P2[kjm[L * 4]] = tgt;
                    if (kjm[L * 4 + 1] >= 0) { VD_P2[kjm[L * 4 + 1]] = tgt; };
                    VD_P2[sk[L]] = tgt; VD_P2[ig[L]] = tgt;
                };
                if (kind[L] == 2)
                {
                    for (j = 0; j < neq[L]; j++) { if (kjm[L * 4 + j] >= 0) { VD_P2[kjm[L * 4 + j]] = tgt; }; };
                    VD_P2[sk[L]] = tgt; VD_P2[ig[L]] = tgt;
                };
                for (k = jlo[L]; k < jhi[L]; k++) { VD_P2[VD_JF[k]] = nxt[L]; };
            };
            if (lim >= 0) { VD_P2[lim] = VD_N; };
            if (sgo >= 0) { VD_P2[sgo] = nxt[n - 2]; };
            for (L = 2; L < n; L++) { if (ife[L] >= 0) { VD_P2[ife[L]] = exl[0]; }; };
            if (dfound >= 0) { VD_P2[dfound] = nxt[n - 1]; };
            if (jagg == 1) { sq_vd_jagg_final(g, b); };
            if (ordm == 1)
            {
                pcur = nic;
                sq_vd_op("OpenPseudo\0", pcur, ooutr + 1, onk + nres + 1);
                oss = sq_vd_op("SorterSort\0", scur, 0, 0);
                osd = sq_vd_op("SorterData\0", scur, ooutr + 1, pcur);
                for (i = nres - 1; i >= 0; i--) { sq_vd_op("Column\0", pcur, rpos[i], obase + i); };
                sq_vd_op("ResultRow\0", obase, nres, 0);
                sq_vd_op("SorterNext\0", scur, osd, 0);
                VD_P2[oss] = VD_N;
            };
            if (VD_SEMI == 1)
            {
                // the EXISTS subquery itself takes cursor 1, so the flattened source and its index cursors start one higher
                for (k = 0; k < VD_N; k++)
                {
                    a = sq_vd_ufield(k);
                    if (a < 0) { continue; };
                    if ((a `& 1) != 0) { if (VD_P1[k] >= 1) { VD_P1[k] = VD_P1[k] + 1; }; };
                    if ((a `& 32) != 0) { if (VD_P3[k] >= 1) { VD_P3[k] = VD_P3[k] + 1; }; };
                };
            };
            if (VD_INSUB == 1)
            {
                for (k = 0; k < VD_N; k++)
                {
                    if (k >= sbeg & k < send) { continue; };
                    a = sq_vd_ufield(k);
                    if (a < 0) { continue; };
                    if ((a `& 1) != 0) { if (VD_P1[k] == 1) { VD_P1[k] = ephno; }; };
                    if ((a `& 32) != 0) { if (VD_P3[k] == 1) { VD_P3[k] = ephno; }; };
                };
            };
            if (sgi >= 0) { VD_P2[sgi] = VD_N; };
            sq_vd_op("Halt\0", 0, 0, 0);
            VD_P2[init] = VD_N;
            sq_vd_trans(g.db, 0);
            for (k = 0; k < VD_NH; k++) { sq_vd_lit(g, VD_HN[k], VD_HR[k]); };
            sq_vd_op("Goto\0", 0, 1, 0);
            return 0;
        };

        // a constant constraint on a column that a join equality also names: SQLite derives the constant for the other table
        def sq_vd_trans2(SQ_STMT* g, int* cj, int ncj) -> int
        {
            SQ_NODE* nd;
            SQ_NODE* ln;
            SQ_NODE* rn;
            SQ_NODE* o;
            SQ_NODE* p;
            int i, j, c, s;
            for (i = 0; i < ncj; i++)
            {
                nd = @g.nodes[cj[i]];
                c = 0 - 1; s = 0 - 1;
                if (nd.kind == SQN_ISNULL) { if (g.nodes[nd.a].kind == SQN_COL) { c = g.nodes[nd.a].col; s = g.nodes[nd.a].src; }; };
                if (nd.kind == SQN_BIN)
                {
                    if (nd.op == SQO_EQ | nd.op == SQO_IS)
                    {
                        ln = @g.nodes[nd.a]; rn = @g.nodes[nd.b];
                        if (ln.kind == SQN_COL & rn.kind != SQN_COL) { c = ln.col; s = ln.src; };
                        if (rn.kind == SQN_COL & ln.kind != SQN_COL) { c = rn.col; s = rn.src; };
                    };
                };
                if (c < 0) { continue; };
                for (j = 0; j < ncj; j++)
                {
                    o = @g.nodes[cj[j]];
                    if (o.kind != SQN_BIN) { continue; };
                    if (o.op != SQO_EQ) { continue; };
                    ln = @g.nodes[o.a]; rn = @g.nodes[o.b];
                    if (ln.kind != SQN_COL | rn.kind != SQN_COL) { continue; };
                    if (ln.src == rn.src) { continue; };
                    if (ln.src == s & ln.col == c) { return 1; };
                    if (rn.src == s & rn.col == c) { return 1; };
                };
            };
            return 0;
        };

        // an equality between two columns that both lead an index (or are the rowid): SQLite may pick either table as the outer loop
        def sq_vd_bothlead(SQ_STMT* g, int* cj, int ncj) -> int
        {
            SQ_BLK* b = g.blks[g.root_blk];
            SQ_NODE* nd;
            SQ_NODE* ln;
            SQ_NODE* rn;
            SQ_IDX[12] ixs0;
            int i, j, x, m, nix;
            for (i = 0; i < ncj; i++)
            {
                nd = @g.nodes[cj[i]];
                if (nd.kind != SQN_BIN | nd.op != SQO_EQ) { continue; };
                ln = @g.nodes[nd.a]; rn = @g.nodes[nd.b];
                if (ln.kind != SQN_COL | rn.kind != SQN_COL | ln.src == rn.src | ln.lvl != 0 | rn.lvl != 0) { continue; };
                x = 0; m = 0;
                if (ln.col == b.src[ln.src].ti.ipk) { x = 1; };
                if (rn.col == b.src[rn.src].ti.ipk) { m = 1; };
                if (x == 0 & b.src[ln.src].kind == 1 & b.src[ln.src].tbl >= 0)
                {
                    nix = sq_idx_list(b.src[ln.src].sdb, b.src[ln.src].tbl, b.src[ln.src].ti, @ixs0[0], 12);
                    for (j = 0; j < nix; j++) { if (ixs0[j].partial == 0 & ixs0[j].isx[0] == 0 & ixs0[j].col[0] == ln.col) { x = 1; }; };
                };
                if (m == 0 & b.src[rn.src].kind == 1 & b.src[rn.src].tbl >= 0)
                {
                    nix = sq_idx_list(b.src[rn.src].sdb, b.src[rn.src].tbl, b.src[rn.src].ti, @ixs0[0], 12);
                    for (j = 0; j < nix; j++) { if (ixs0[j].partial == 0 & ixs0[j].isx[0] == 0 & ixs0[j].col[0] == rn.col) { m = 1; }; };
                };
                if (x == 1 & m == 1 & ln.col != b.src[ln.src].ti.ipk & rn.col != b.src[rn.src].ti.ipk) { return 1; };
            };
            return 0;
        };

        // walks an expression and clears ok[0] when a column does not lead an index; counts columns in ok[1]
        def sq_vd_allled(SQ_STMT* g, SQ_SRC* sr, int ni, int* ok) -> void
        {
            SQ_NODE* nd;
            if (ni < 0) { return; };
            nd = @g.nodes[ni];
            if (nd.kind == SQN_COL) { ok[1] = ok[1] + 1; if (sq_vd_leads(sr, nd.col) == 0) { ok[0] = 0; }; return; };
            if (nd.kind == SQN_BIN) { sq_vd_allled(g, sr, nd.a, ok); sq_vd_allled(g, sr, nd.b, ok); return; };
            if (nd.kind == SQN_ISNULL) { sq_vd_allled(g, sr, nd.a, ok); return; };
            if (nd.kind == SQN_BETWEEN) { sq_vd_allled(g, sr, nd.a, ok); return; };
            if (nd.kind == SQN_IN) { sq_vd_allled(g, sr, nd.a, ok); return; };
            if (nd.kind == SQN_INT | nd.kind == SQN_STR | nd.kind == SQN_REAL | nd.kind == SQN_NULL) { return; };
            ok[0] = 0;
        };

        // classifies a term against a literal: 1 equality, 2 lower bound, 3 upper bound, 4 BETWEEN, 5 IS NULL, 6 IN, 0 other; col and src of the constrained column
        def sq_vd_tclass(SQ_STMT* g, int ni, int* col, int* src) -> int
        {
            SQ_NODE* nd = @g.nodes[ni];
            SQ_NODE* ln;
            SQ_NODE* rn;
            int sw;
            col[0] = 0 - 1; src[0] = 0 - 1;
            if (nd.kind == SQN_ISNULL) { if (g.nodes[nd.a].kind == SQN_COL) { col[0] = g.nodes[nd.a].col; src[0] = g.nodes[nd.a].src; if (nd.op == 1) { return 5; }; return 0; }; return 0; };
            if (nd.kind == SQN_BETWEEN) { if (g.nodes[nd.a].kind == SQN_COL) { col[0] = g.nodes[nd.a].col; src[0] = g.nodes[nd.a].src; return 4; }; return 0; };
            if (nd.kind == SQN_IN) { if (g.nodes[nd.a].kind == SQN_COL & nd.op == 1) { col[0] = g.nodes[nd.a].col; src[0] = g.nodes[nd.a].src; return 6; }; return 0; };
            if (nd.kind != SQN_BIN) { return 0; };
            ln = @g.nodes[nd.a]; rn = @g.nodes[nd.b];
            sw = 0;
            if (ln.kind == SQN_COL & rn.kind != SQN_COL) { col[0] = ln.col; src[0] = ln.src; };
            if (col[0] < 0 & rn.kind == SQN_COL & ln.kind != SQN_COL) { col[0] = rn.col; src[0] = rn.src; sw = 1; };
            if (col[0] < 0) { return 0; };
            if (nd.op == SQO_EQ | nd.op == SQO_IS) { return 1; };
            if (nd.op == SQO_GT | nd.op == SQO_GE) { if (sw == 0) { return 2; }; return 3; };
            if (nd.op == SQO_LT | nd.op == SQO_LE) { if (sw == 0) { return 3; }; return 2; };
            return 0;
        };

        // 1 when two terms constrain the same column in a way SQLite simplifies (anything but one lower and one upper bound)
        def sq_vd_samecol(SQ_STMT* g, int* cj, int ncj) -> int
        {
            int i, j, ci, cj2, si, sj, ki, kj;
            for (i = 0; i < ncj; i++)
            {
                ki = sq_vd_tclass(g, cj[i], @ci, @si);
                if (ki == 0) { continue; };
                for (j = i + 1; j < ncj; j++)
                {
                    kj = sq_vd_tclass(g, cj[j], @cj2, @sj);
                    if (kj == 0) { continue; };
                    if (ci != cj2 | si != sj) { continue; };
                    if (ki == 2 & kj == 3) { continue; };
                    if (ki == 3 & kj == 2) { continue; };
                    if (ki == 2 & kj == 2) { continue; };
                    if (ki == 3 & kj == 3) { continue; };
                    return 1;
                };
            };
            return 0;
        };

        // a join through a rowid alias with a literal equality on an indexed column of that table: SQLite may pick either loop order
        def sq_vd_ipkpin(SQ_STMT* g, int* cj, int ncj) -> int
        {
            SQ_BLK* b = g.blks[g.root_blk];
            SQ_NODE* nd;
            SQ_NODE* ln;
            SQ_NODE* rn;
            SQ_NODE* o;
            int i, j, sv, cv;
            for (i = 0; i < ncj; i++)
            {
                nd = @g.nodes[cj[i]];
                if (nd.kind != SQN_BIN | nd.op != SQO_EQ) { continue; };
                ln = @g.nodes[nd.a]; rn = @g.nodes[nd.b];
                sv = 0 - 1; cv = 0 - 1;
                if (ln.kind == SQN_COL & rn.kind != SQN_COL & ln.src >= 0 & ln.src < b.nsrc) { sv = ln.src; cv = ln.col; };
                if (sv < 0 & rn.kind == SQN_COL & ln.kind != SQN_COL & rn.src >= 0 & rn.src < b.nsrc) { sv = rn.src; cv = rn.col; };
                if (sv < 0 | cv < 0) { continue; };
                if (b.src[sv].kind != 1 | (u64)b.src[sv].ti == (u64)0) { continue; };
                if (cv == b.src[sv].ti.ipk) { continue; };
                if (sq_vd_leads(@b.src[sv], cv) == 0) { continue; };
                for (j = 0; j < ncj; j++)
                {
                    o = @g.nodes[cj[j]];
                    if (o.kind != SQN_BIN | o.op != SQO_EQ) { continue; };
                    ln = @g.nodes[o.a]; rn = @g.nodes[o.b];
                    if (ln.kind != SQN_COL | rn.kind != SQN_COL) { continue; };
                    if (ln.src == sv & rn.src != sv & ln.col == b.src[sv].ti.ipk & ln.col >= 0) { return 1; };
                    if (rn.src == sv & ln.src != sv & rn.col == b.src[sv].ti.ipk & rn.col >= 0) { return 1; };
                };
            };
            return 0;
        };

        def sq_vd_nl(SQ_STMT* st, SQ_STMT* g) -> int
        {
            int r, i;
            SQ_NLX* nx;
            nx = (SQ_NLX*)fmalloc((u64)(sizeof(SQ_NLX) / 8 + 64));
            if ((u64)nx == (u64)0) { return 2; };
            r = sq_vd_nl0(st, g, nx);
            ffree((u64)nx);
            for (i = 0; i < 4; i++) { VD_SIXC[i] = 0; };
            VD_COLCUR = 0; VD_IDXCUR = 0; VD_NOHOIST = 0;
            return r;
        };

        def sq_vd_join(SQ_STMT* st, SQ_STMT* g) -> int
        {
            SQ_BLK* b = g.blks[g.root_blk];
            SQ_SRC* s0;
            SQ_SRC* s1;
            SQ_NODE* nd;
            SQ_TI* ti2;
            int[16] cj;
            int[16] tsrc;
            int[2] ord;
            int[2] maxc;
            int[2] nfil;
            int[2] jlo;
            int[2] jhi;
            int[2] rew;
            int[2] body;
            int[2] nxt;
            int ncj, i, k, init, a, x, n, base, lp, cr, c0, c1, cross, nix1, kk, m;
            SQ_IDX[12] ixs1;
            int seek, sinner, souter, scol, skey, sop, nj2, ncj0, onfrom, left, lflag, lint, lgoto, lnull, lscan, ifpos;
            int aidxm, akey0, akey1, ainner, aouter, anic, abloom, adst, akr, akb, acnt, aone, aidx, ainit, ahalt, abody, aseek, aigt, anext, aexp, ak, aopos;
            int[128] aused;
            int[128] apos;
            int[8] ajmp;
            int najmp, knum0, knum1, abl, anum, resplain, hasl, lim, jagg, ordm, dstm, dfound, drec;
            int[8] okc;
            int[8] oks;
            int[32] rcs;
            int[32] rcc;
            int[32] rpos;
            int onk, ond2, ooff, ooutr, osn, oss, osd, obase, j;
            SQ_SB okt;
            SQ_SB asb;
            SQ_NODE* ln;
            SQ_NODE* rn;
            if (b.nsrc != 2 | b.cnext >= 0 | b.ngrp != 0 | b.having >= 0 | b.nwin != 0 | b.ncte != 0)
            {
                sq_seterr(st, "EXPLAIN is not available for this SELECT shape\0"); return 1;
            };
            jagg = 0; ordm = 0; dstm = 0;
            if (b.nord > 0) { ordm = 1; };
            if (b.distinct != 0) { dstm = 1; };
            if (dstm == 1 & (b.has_agg != 0 | b.nord > 0 | b.limit_n >= 0 | b.nres > 30)) { if (sq_vd_gon(236) == 1) { sq_seterr(st, "EXPLAIN is not available for this DISTINCT #236\0"); return 1; }; };
            if (b.has_agg != 0) { jagg = 1; if (sq_vd_jagg_prep(st, g, b) != 0) { return 1; }; };
            hasl = 0; lim = 0 - 1;
            if (b.limit_n >= 0)
            {
                if (g.nodes[b.limit_n].kind != SQN_INT | b.offset_n >= 0) { if (sq_vd_gon(237) == 1) { sq_seterr(st, "EXPLAIN is not available for this LIMIT #237\0"); return 1; }; };
                if (g.nodes[b.limit_n].iv <= 0) { if (sq_vd_gon(238) == 1) { sq_seterr(st, "EXPLAIN is not available for this LIMIT #238\0"); return 1; }; };
                hasl = 1;
                if (jagg == 1) { if (sq_vd_gon(239) == 1) { sq_seterr(st, "EXPLAIN is not available for this LIMIT #239\0"); return 1; }; };
            };
            if (ordm == 1)
            {
                if (jagg == 1 | hasl == 1 | b.nord > 8 | b.nres > 30) { if (sq_vd_gon(240) == 1) { sq_seterr(st, "EXPLAIN is not available for this ORDER BY #240\0"); return 1; }; };
                onk = b.nord;
                for (i = 0; i < onk; i++)
                {
                    nd = @g.nodes[b.ord[i]];
                    if (nd.kind == SQN_RESREF) { nd = @g.nodes[b.rc[(int)nd.iv]]; };
                    if (nd.kind != SQN_COL | nd.src < 0 | nd.src > 1 | nd.col < 0 | b.ocoll[i] >= 0) { if (sq_vd_gon(241) == 1) { sq_seterr(st, "EXPLAIN is not available for this ORDER BY #241\0"); return 1; }; };
