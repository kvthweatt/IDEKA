        // UPDATE of a table with secondary indexes: constant assignments, full scan, every changed index deleted and re-inserted
        def sq_vd_setv(SQ_STMT* g, SQ_TI* ti, int ni, int reg) -> int
        {
            if (sq_vd_isconst(g, ni)) { return sq_vd_lit(g, ni, reg); };
            return sq_vd_expr(g, ti, ni, reg);
        };

        // the conjunct of a WHERE that is rowid = integer, or -1; *pn is the conjunct count
        def sq_vd_ridfind(SQ_STMT* g, SQ_TI* ti, int wn, int* cj, int* pn) -> int
        {
            SQ_NODE* w;
            int x, c;
            *pn = 0;
            sq_vd_split(g, wn, cj, pn);
            if (*pn < 2) { return 0 - 1; };
            for (x = 0; x < *pn; x++)
            {
                w = @g.nodes[cj[x]];
                if (w.kind != SQN_BIN | w.op != SQO_EQ) { continue; };
                c = w.a;
                if (g.nodes[c].kind == SQN_ROWID | (g.nodes[c].kind == SQN_COL & (g.nodes[c].col == ti.ncols | (g.nodes[c].col == ti.ipk & ti.ipk >= 0))))
                {
                    if (g.nodes[w.b].kind == SQN_INT) { return x; };
                };
            };
            return 0 - 1;
        };

