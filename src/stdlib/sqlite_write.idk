                    if (sq_vd_where(g, ti, b.where_n) != 0) { if (sq_vd_gon(165) == 1) { sq_seterr(st, "EXPLAIN is not available for this WHERE clause #165\0"); return 1; }; };
                };
                base = VD_NMEM + 1;
                if (ordf == 1) { VD_NMEM = base - 1 + 2 * n; } else { VD_NMEM = base - 1 + n; };
                if (nulla >= 0) { VD_P2[nulla] = base + n; };
                for (i = 0; i < n; i++)
                {
                    k = 0 - 1;
                    for (a = 0; a < cix.nk; a++) { if (cix.col[a] == g.nodes[b.rc[i]].col) { k = a; }; };
                    if (ti.wor != 0) { sq_vd_op("Column\0", 2, g.nodes[b.rc[i]].col, base + i); }
                    else { if (k >= 0) { sq_vd_op("Column\0", 2, k, base + i); } else { sq_vd_op("Column\0", 0, g.nodes[b.rc[i]].col, base + i); }; };
                    if (ti.aff[g.nodes[b.rc[i]].col] == 4) { sq_vd_op("RealAffinity\0", base + i, 0, 0); };
                };
                if (ordf == 1)
                {
                    cmpn = 0;
                    for (i = 0; i < n; i++)
                    {
                        if (i < n - 1) { cj[i] = sq_vd_op("Ne\0", base + i, 0, base + n + i); }
                        else { cj[i] = sq_vd_op("Eq\0", base + i, 0, base + n + i); };
                        sq_vd_p4s(cj[i], "BINARY-8\0", 8);
                    };
                    for (i = 0; i < n; i++) { VD_P5[cj[i]] = 128; };
                    for (i = 0; i < n - 1; i++) { VD_P2[cj[i]] = VD_N; };
                    sq_vd_op("Copy\0", base, base + n, n - 1);
                    if (doff == 1) { dip = sq_vd_op("IfPos\0", 2, 0, 1); };
                    sq_vd_op("ResultRow\0", base, n, 0);
                    if (dlim == 1) { djz = sq_vd_op("DecrJumpZero\0", 1, 0, 0); };
                    nxt = VD_N;
                    if (doff == 1) { VD_P2[dip] = nxt; };
                    VD_P2[cj[n - 1]] = nxt;
                }
                else
                {
                    rec = sq_vd_getreg();
                    k = sq_vd_op("Found\0", 1, 0, base);
                    sq_vd_p4i(k, (i64)n);
                    sq_vd_op("MakeRecord\0", base, n, rec);
                    a = sq_vd_op("IdxInsert\0", 1, rec, base);
                    sq_vd_p4i(a, (i64)n);
                    VD_P5[a] = 16;
                    if (doff == 1) { dip = sq_vd_op("IfPos\0", 2, 0, 1); };
                    sq_vd_op("ResultRow\0", base, n, 0);
                    if (dlim == 1) { djz = sq_vd_op("DecrJumpZero\0", 1, 0, 0); };
                    nxt = VD_N;
                    if (doff == 1) { VD_P2[dip] = nxt; };
                    VD_P2[k] = nxt;
                };
                a = sq_vd_op("Next\0", 2, body, 0);
                VD_P5[a] = 1;
                VD_P2[rew] = VD_N;
                if (dlim == 1) { VD_P2[djz] = VD_N; };
                for (i = 0; i < VD_NJ; i++) { VD_P2[VD_JF[i]] = nxt; };
                sq_vd_op("Halt\0", 0, 0, 0);
                VD_P2[init] = VD_N;
                sq_vd_trans(g.db, 0);
                for (i = 0; i < VD_NH; i++) { sq_vd_lit(g, VD_HN[i], VD_HR[i]); };
                sq_vd_op("Goto\0", 0, 1, 0);
                return 0;
            };
            sq_vd_reset();
            init = sq_vd_op("Init\0", 0, 0, 0);
            if (VD_ORDPIN > 0) { sq_vd_op("Noop\0", 1, b.nres + VD_ORDPIN + 1, 0); };
            VD_NMEM = 0; VD_NFREE = 0; VD_NH = 0; VD_NJ = 0; VD_COLCUR = 0; VD_IDXCUR = 0;
            if (dlim == 1) { sq_vd_lit(g, b.limit_n, 1); VD_NMEM = 1; if (doff == 1) { sq_vd_lit(g, b.offset_n, 2); sq_vd_op("MustBeInt\0", 2, 0, 0); sq_vd_op("OffsetLimit\0", 1, 3, 2); VD_NMEM = 3; }; };
            a = sq_vd_op("OpenEphemeral\0", 1, 0, 0);
            sq_sb_init(@kt);
            sq_sb_lit(@kt, "k(\0");
            sq_sb_int(@kt, (i64)n);
            for (i = 0; i < n; i++) { if (VD_DDESC == 1) { sq_sb_lit(@kt, ",-B\0"); } else { sq_sb_lit(@kt, ",B\0"); }; };
            sq_sb_lit(@kt, ")\0");
            sq_vd_p4s(a, kt.p, kt.n);
            sq_sb_free(@kt);
            VD_P5[a] = 8;
            a = sq_vd_op("OpenRead\0", 0, sr.root, 0);
            sq_vd_p4i(a, (i64)(maxc + 1));
            if (VD_DDESC == 1) { rew = sq_vd_op("Last\0", 0, 0, 0); } else { rew = sq_vd_op("Rewind\0", 0, 0, 0); };
            body = VD_N;
            if (b.where_n >= 0)
            {
                if (sq_vd_where(g, ti, b.where_n) != 0) { if (sq_vd_gon(165) == 1) { sq_seterr(st, "EXPLAIN is not available for this WHERE clause #165\0"); return 1; }; };
            };
            base = VD_NMEM + 1;
            VD_NMEM = VD_NMEM + n;
            rec = sq_vd_getreg();
            for (i = 0; i < n; i++)
            {
                if (sq_vd_expr(g, ti, b.rc[i], base + i) != 0) { if (sq_vd_gon(166) == 1) { sq_seterr(st, "EXPLAIN is not available for this expression #166\0"); return 1; }; };
            };
            k = sq_vd_op("Found\0", 1, 0, base);
            sq_vd_p4i(k, (i64)n);
            sq_vd_op("MakeRecord\0", base, n, rec);
            a = sq_vd_op("IdxInsert\0", 1, rec, base);
            sq_vd_p4i(a, (i64)n);
            VD_P5[a] = 16;
            if (doff == 1) { dip = sq_vd_op("IfPos\0", 2, 0, 1); };
            sq_vd_op("ResultRow\0", base, n, 0);
            if (dlim == 1) { djz = sq_vd_op("DecrJumpZero\0", 1, 0, 0); };
            nxt = VD_N;
            if (doff == 1) { VD_P2[dip] = nxt; };
            if (VD_DDESC == 1) { a = sq_vd_op("Prev\0", 0, body, 0); } else { a = sq_vd_op("Next\0", 0, body, 0); };
            VD_P5[a] = 1;
            VD_P2[rew] = VD_N;
            if (dlim == 1) { VD_P2[djz] = VD_N; };
            VD_P2[k] = nxt;
            for (i = 0; i < VD_NJ; i++) { VD_P2[VD_JF[i]] = nxt; };
            sq_vd_op("Halt\0", 0, 0, 0);
            VD_P2[init] = VD_N;
            sq_vd_trans(g.db, 0);
            for (i = 0; i < VD_NH; i++) { sq_vd_lit(g, VD_HN[i], VD_HR[i]); };
            sq_vd_op("Goto\0", 0, 1, 0);
            return 0;
        };

        // aggregate name of a function id for the P4 text
        def sq_vd_aggname(int id, int star, SQ_SB* t) -> void
        {
            if (id == 100) { if (star == 1) { sq_sb_lit(t, "count(0)\0"); } else { sq_sb_lit(t, "count(1)\0"); }; };
            if (id == 101) { sq_sb_lit(t, "sum(1)\0"); };
            if (id == 102) { sq_sb_lit(t, "total(1)\0"); };
            if (id == 103) { sq_sb_lit(t, "avg(1)\0"); };
            if (id == 104) { sq_sb_lit(t, "min(1)\0"); };
            if (id == 105) { sq_sb_lit(t, "max(1)\0"); };
            if (id == 106) { sq_sb_lit(t, "group_concat(1)\0"); };
        };

        // GROUP BY over plain columns of one table: sorter, compare with the previous key, output subroutine
        def sq_vd_ridrange(SQ_STMT* g, SQ_BLK* b, SQ_TI* ti, int ecur, int* out) -> int;

        def sq_vd_group(SQ_STMT* st, SQ_STMT* g) -> int
        {
            SQ_BLK* b = g.blks[g.root_blk];
            SQ_SRC* sr = @b.src[0];
            SQ_TI* ti = sr.ti;
            SQ_NODE* nd;
            SQ_NODE* ar;
            SQ_NODE* o;
            SQ_SB kt;
            SQ_SB nm;
            SQ_IDX[12] ixs;
            int[16] gcol;
            int[16] fid;
            int[16] iacol;
            int[16] acc;
            int[16] first;
            int[16] acol;
            int[16] aout;
            int[16] rcol;
            int[16] src;
            int[16] cj;
            SQ_NODE* hv;
            byte* hn;
            int hf, hj, hr, ht, hk;
            int gdesc;
            int ng, n, nac, nacc, nrec, init, rew, body, nxt, a, i, j, k, same, maxc, aggbase, sbase, rec, pse, ss, loopa, jmp, ip, g1, gf, g2, ifa, outa, reta, reseta, abta, rbase, run, reg, pos, nix, hit, pass, ixm, ixi, tabop, cc;
            SQ_SB kt2;
            int[8] gro;
            int ipg, ro, co, ordm, limm, dj, offm, rtn, gsk, gkr, glt, gsk2, gipk, gigt, gchk, gtgt, gnb, glo, ghi, gsk3;
            int osrt, oi, kK, kRec, kPrec, kLoop, kHalt, nfld, dp, nxa, nht, ht3;
            int[16] hts;
            SQ_SB ksb;
            SQ_NODE* gwn;
            offm = 0; rtn = 0; gsk = 0; gipk = 0;
            hit = 0; ro = 0; co = 0; ordm = 0; limm = 0;
            if (sq_vd_gon(796) == 0) { sq_vd_havwhere(g, b); };
            n = b.nres;
            ng = b.ngrp;
            // ORDER BY an aggregate result column: the groups are emitted through an ORDER BY sorter
            osrt = 0; oi = 0 - 1;
            if (b.nord == 1 & ng == 1 & (b.offset_n < 0 | b.limit_n >= 0) & sq_vd_gon(798) == 0)
            {
                nd = @g.nodes[b.ord[0]];
                if (nd.kind == SQN_RESREF) { oi = (int)nd.iv; }
                else
                {
                    for (i = 0; i < n; i++)
                    {
                        if (b.ord[0] == b.rc[i]) { oi = i; break; };
                        ar = @g.nodes[b.rc[i]];
                        if (ar.kind != SQN_FUNC | nd.kind != SQN_FUNC) { continue; };
                        if (ar.sl != nd.sl | ar.op != nd.op | ar.iv != nd.iv) { continue; };
                        same = 1;
                        for (j = 0; j < ar.sl; j++) { if (g.sql[ar.s + j] != g.sql[nd.s + j]) { same = 0; }; };
                        if (same == 1 & ar.op != 2) { if (g.nodes[ar.a].kind != SQN_COL | g.nodes[nd.a].kind != SQN_COL) { same = 0; } else if (g.nodes[ar.a].col != g.nodes[nd.a].col) { same = 0; }; };
                        if (same == 1) { oi = i; break; };
                    };
                };
                if (oi >= 0 & oi < n) { if (g.nodes[b.rc[oi]].kind == SQN_FUNC & b.ocoll[0] < 0 & b.onull[0] == 0) { osrt = 1; co = 1; if (b.limit_n >= 0) { osrt = 2; }; }; };
            };
            if (ng < 1 | ng > 8 | n < 1 | n > 15 | b.nord > ng) { if (sq_vd_gon(167) == 1) { sq_seterr(st, "EXPLAIN is not available for this GROUP BY #167\0"); return 1; }; };
            if (b.limit_n >= 0) { if (g.nodes[b.limit_n].kind != SQN_INT | (b.offset_n >= 0 & sq_vd_gon(758) == 1) | g.nodes[b.limit_n].iv <= (i64)0) { if (sq_vd_gon(168) == 1) { sq_seterr(st, "EXPLAIN is not available for this GROUP BY #168\0"); return 1; }; }; limm = 1; ro = 1; if (b.offset_n >= 0) { if (g.nodes[b.offset_n].kind != SQN_INT | b.having >= 0 | g.nodes[b.offset_n].iv < (i64)0) { sq_seterr(st, "EXPLAIN is not available for this GROUP BY\0"); return 1; }; offm = 1; ro = 3; }; };
            nix = sq_idx_list(sr.sdb, sr.tbl, ti, @ixs[0], 12);
            ixm = 0;
            ipg = 0;
            if (ng == 1) { if (g.nodes[b.grp[0]].kind == SQN_COL) { if (g.nodes[b.grp[0]].col == ti.ipk & ti.ipk >= 0) { ipg = 1; }; }; };
            // a single lower bound on the group column becomes a seek on the cursor that supplies the groups
            if (ng == 1 & b.where_n >= 0)
            {
                gwn = @g.nodes[b.where_n];
                if (gwn.kind == SQN_BIN & (gwn.op == SQO_GT | gwn.op == SQO_GE | gwn.op == SQO_EQ) & g.nodes[b.grp[0]].kind == SQN_COL)
                {
                    if (g.nodes[gwn.a].kind == SQN_COL & sq_vd_isconst(g, gwn.b) == true)
                    {
                        if (g.nodes[gwn.a].col == g.nodes[b.grp[0]].col & g.nodes[gwn.a].col >= 0 & g.nodes[gwn.a].col < ti.ncols)
                        {
                            if (g.nodes[gwn.b].kind == SQN_INT & ti.aff[g.nodes[gwn.a].col] != 1) { gsk = 1; };
                            if (g.nodes[gwn.b].kind == SQN_STR & ti.aff[g.nodes[gwn.a].col] <= 1) { gsk = 1; };
                            if (g.nodes[gwn.b].kind == SQN_REAL & ti.aff[g.nodes[gwn.a].col] != 1) { gsk = 1; };
                            if (gwn.op == SQO_EQ) { if (gsk == 1 & g.nodes[gwn.b].kind != SQN_REAL & g.nodes[gwn.a].col != ti.ipk) { gsk = 2; } else { gsk = 0; }; };
                            if (gsk != 0 & nix == 0 & ipg == 0) { gsk = 0; };
                            if (gsk == 2 & (b.distinct != 0 | VD_DISTRED > 0 | VD_GDIST == 1)) { gsk = 0; };
                        };
                    };
                };
            };
            if (b.where_n >= 0 & sq_vd_gon(759) == 1)
            {
                sq_vd_split(g, b.where_n, @cj[0], @run);
                k = 0;
                for (i = 0; i < run; i++)
                {
                    nd = @g.nodes[cj[i]];
                    if (nd.kind == SQN_BETWEEN) { k++; };
                    if (ipg == 1 & nd.kind == SQN_BIN & nd.op == SQO_EQ) { k = k + 2; };
                };
                if (k >= 2) { sq_seterr(st, "EXPLAIN is not available for this GROUP BY\0"); return 1; };
            };
            if (nix != 0 & b.where_n >= 0 & sq_vd_gon(756) == 1)
            {
                sq_vd_split(g, b.where_n, @cj[0], @run);
                for (i = 0; i < run; i++)
                {
                    nd = @g.nodes[cj[i]];
                    if (nd.kind != SQN_ISNULL | nd.a < 0) { continue; };
                    if (g.nodes[nd.a].kind != SQN_COL) { continue; };
                    for (j = 0; j < nix; j++)
                    {
                        for (k = 0; k < ixs[j].nk; k++) { if (ixs[j].col[k] == g.nodes[nd.a].col) { sq_seterr(st, "EXPLAIN is not available for GROUP BY on indexed tables\0"); return 1; }; };
                    };
                };
            };
            gsk2 = 0;
            if (b.where_n >= 0 & gsk == 0 & ipg == 0)
            {
                run = 0;
                sq_vd_split(g, b.where_n, @cj[0], @run);
                gsk2 = 1;
                if (run != 1) { gsk2 = 0; };
                for (i = 0; i < run; i++)
                {
                    nd = @g.nodes[cj[i]];
                    if (nd.kind != SQN_BIN | (nd.op != SQO_GT & nd.op != SQO_GE & nd.op != SQO_LT & nd.op != SQO_LE)) { gsk2 = 0; continue; };
                    if (g.nodes[nd.a].kind != SQN_COL & g.nodes[nd.a].kind != SQN_ROWID) { gsk2 = 0; continue; };
                    if (g.nodes[nd.a].kind == SQN_COL) { if (g.nodes[nd.a].col != ti.ipk | ti.ipk < 0) { gsk2 = 0; }; };
                    if (g.nodes[nd.b].kind != SQN_INT | sq_vd_isconst(g, nd.b) == false) { gsk2 = 0; };
                };
            };
            gsk3 = 0;
            if (b.where_n >= 0 & gsk == 0 & ipg == 0 & ixm == 0)
            {
                run = 0;
                sq_vd_splitx(g, b.where_n, @cj[0], @run);
                gsk3 = 1; glo = 0; ghi = 0;
                if (run < 1 | run > 2) { gsk3 = 0; };
                for (i = 0; i < run; i++)
                {
                    nd = @g.nodes[cj[i]];
                    if (nd.kind != SQN_BIN | (nd.op != SQO_GT & nd.op != SQO_GE & nd.op != SQO_LT & nd.op != SQO_LE)) { gsk3 = 0; continue; };
                    if (g.nodes[nd.a].kind != SQN_COL & g.nodes[nd.a].kind != SQN_ROWID) { gsk3 = 0; continue; };
                    if (g.nodes[nd.a].kind == SQN_COL) { if ((g.nodes[nd.a].col != ti.ipk | ti.ipk < 0) & g.nodes[nd.a].col != ti.ncols) { gsk3 = 0; }; };
                    if (g.nodes[nd.b].kind != SQN_INT | sq_vd_isconst(g, nd.b) == false) { gsk3 = 0; continue; };
                    if (nd.op == SQO_GT | nd.op == SQO_GE) { glo++; } else { ghi++; };
                };
                if (glo > 1 | ghi > 1) { gsk3 = 0; };
            };
            if (nix != 0 & b.where_n >= 0 & gsk == 0 & gsk2 == 0 & gsk3 == 0)
            {
                if (sq_vd_gon(754) == 1 | sq_vd_plankind(g) != 0 | sq_vd_hasor(g, b.where_n) == 1 | (sq_vd_gon(755) == 1 & sq_vd_aggrisk(g, b, @ixs[0], nix) == 1))
                {
                    if (sq_vd_gon(169) == 1) { sq_seterr(st, "EXPLAIN is not available for GROUP BY on indexed tables #169\0"); return 1; };
                };
            };
            for (i = 0; i < ng; i++)
            {
                nd = @g.nodes[b.grp[i]];
                if (nd.kind != SQN_COL | nd.col < 0 | nd.col >= ti.ncols | (nd.col == ti.ipk & ipg == 0)) { if (sq_vd_gon(170) == 1) { sq_seterr(st, "EXPLAIN is not available for this GROUP BY #170\0"); return 1; }; };
                if (ti.coll[nd.col] != 0) { if (sq_vd_gon(171) == 1) { sq_seterr(st, "EXPLAIN is not available for this collation #171\0"); return 1; }; };
                gcol[i] = nd.col;
                for (j = 0; j < i; j++) { if (gcol[j] == gcol[i]) { if (sq_vd_gon(172) == 1) { sq_seterr(st, "EXPLAIN is not available for this GROUP BY #172\0"); return 1; }; }; };
            };
            if (b.where_n >= 0 & gsk == 0 & gsk2 == 0 & gsk3 == 0) { if (sq_vd_plankind(g) != 0) { if (sq_vd_gon(173) == 1) { sq_seterr(st, "EXPLAIN is not available for this access path #173\0"); return 1; }; }; };
            // a group column pinned by the WHERE makes SQLite drop the sorter
            if (b.where_n >= 0 & gsk != 2)
            {
                run = 0;
                sq_vd_split(g, b.where_n, @cj[0], @run);
                if (sq_vd_samecol(g, @cj[0], run) == 1) { if (sq_vd_gon(174) == 1) { sq_seterr(st, "EXPLAIN is not available for this GROUP BY #174\0"); return 1; }; };
                if (sq_vd_hasor(g, b.where_n) == 1) { if (sq_vd_gon(175) == 1) { sq_seterr(st, "EXPLAIN is not available for this GROUP BY #175\0"); return 1; }; };
                for (i = 0; i < g.nn; i++)
                {
                    if (g.nodes[i].kind != SQN_INT | i == b.limit_n | i == b.offset_n) { continue; };
                    for (j = i + 1; j < g.nn; j++)
                    {
                        if (g.nodes[j].kind == SQN_INT & j != b.limit_n & j != b.offset_n & g.nodes[j].iv == g.nodes[i].iv) { if (sq_vd_gon(176) == 1) { sq_seterr(st, "EXPLAIN is not available for this GROUP BY #176\0"); return 1; }; };
                    };
                };
                for (i = 0; i < run; i++)
                {
                    o = @g.nodes[cj[i]];
                    if (o.kind == SQN_IN & o.op == 2) { if (sq_vd_gon(177) == 1) { sq_seterr(st, "EXPLAIN is not available for this GROUP BY #177\0"); return 1; }; };
                    if ((o.kind == SQN_BIN & o.op == SQO_EQ) | (o.kind == SQN_ISNULL & o.op == 1))
                    {
                        for (j = 0; j < ng; j++)
                        {
                            if (g.nodes[o.a].kind == SQN_COL) { if (g.nodes[o.a].col == gcol[j]) { if (sq_vd_gon(178) == 1) { sq_seterr(st, "EXPLAIN is not available for this GROUP BY #178\0"); return 1; }; }; };
                            if (o.kind == SQN_BIN) { if (g.nodes[o.b].kind == SQN_COL) { if (g.nodes[o.b].col == gcol[j]) { if (sq_vd_gon(179) == 1) { sq_seterr(st, "EXPLAIN is not available for this GROUP BY #179\0"); return 1; }; }; }; };
                        };
                    };
                };
            };
            // result items: plain columns or aggregates; aCol lists the columns read, aout marks those read outside aggregates
            nac = 0; nacc = 0;
            // a HAVING aggregate that the result list lacks gets an accumulator after the result ones
            nxa = n;
            nht = 0;
            if (b.having >= 0) { sq_vd_split(g, b.having, @hts[0], @nht); };
            if (b.having >= 0 & sq_vd_gon(799) == 0)
            {
                for (i = 0; i < nht; i++)
                {
                    hv = @g.nodes[hts[i]];
                    if (hv.kind == SQN_BIN & nxa < 15) { if (g.nodes[hv.a].kind == SQN_FUNC) { b.rc[nxa] = hv.a; nxa++; }; };
                };
            };
            for (pass = 0; pass < 2; pass++)
            {
            for (i = 0; i < nxa; i++)
            {
                nd = @g.nodes[b.rc[i]];
                fid[i] = 0;
                if (nd.kind == SQN_COL & pass == 0)
                {
                    if (nd.col < 0 | ((nd.col >= ti.ncols | (nd.col == ti.ipk & ipg == 0)) & sq_vd_gon(757) == 1) | (nd.col < ti.ncols & nd.col >= 0 & ti.coll[nd.col] != 0)) { if (sq_vd_gon(180) == 1) { sq_seterr(st, "EXPLAIN is not available for this GROUP BY #180\0"); return 1; }; };
                    pos = 0 - 1;
                    for (j = 0; j < nac; j++) { if (acol[j] == nd.col | ((acol[j] >= ti.ncols | acol[j] == ti.ipk) & (nd.col >= ti.ncols | nd.col == ti.ipk))) { pos = j; }; };
                    if (pos < 0) { pos = nac; acol[nac] = nd.col; aout[nac] = 0; nac++; };
                    aout[pos] = 1;
                    iacol[i] = pos;
                };
