// Author: Karac V. Thweatt

// sqlite_write.idk - Write path for the SQLite engine: page allocation, table and index b-trees, constraint
// checking, CREATE / DROP / ALTER, INSERT / UPDATE / DELETE and transaction control.
//
//   sq_open_rw(SQLITE_DB*, byte* path, int create) -> int   0 on success, creates a new database file when create is 1
//   sq_exec(SQ_STMT*, SQLITE_DB*, byte* sql) -> int         0 on success, otherwise st.err holds the message
//                                                           st.changes = rows affected, st.last_rowid = last inserted rowid
//
// Files written here are ordinary SQLite 3 databases (rollback journal mode).

#ifndef IDEKA_STANDARD_SQLITE_CORE
#import <sqlite_core.idk>;
#endif;

#ifndef IDEKA_STANDARD_SQLITE_WRITE
#def IDEKA_STANDARD_SQLITE_WRITE 1;

namespace standard
{
    namespace sqlite
    {
        struct SQ_PM
        {
            int type, ncells, rightmost, used, hsz;
            byte* buf;
            int* off;
            int* len;
        };

        struct SQ_PATH
        {
            int depth, rightmost;
            int[20] pg;
            int[20] ci;
        };

        // ---- byte helpers ----

        def sq_put_varint(byte* p, u64 v) -> int
        {
            byte[10] tmp;
            int n, i;
            if ((v >> 56) != (u64)0)
            {
                p[8] = (byte)(v `& (u64)255);
                v = v >> 8;
                for (i = 7; i >= 0; i--)
                {
                    p[i] = (byte)((v `& (u64)127) `| (u64)128);
                    v = v >> 7;
                };
                return 9;
            };
            tmp[0] = (byte)(v `& (u64)127);
            n = 1;
            v = v >> 7;
            while (v != (u64)0)
            {
                tmp[n] = (byte)((v `& (u64)127) `| (u64)128);
                n++;
                v = v >> 7;
            };
            for (i = 0; i < n; i++) { p[i] = tmp[n - 1 - i]; };
            return n;
        };

        def sq_varint_len(u64 v) -> int
        {
            int n;
            if ((v >> 56) != (u64)0) { return 9; };
            n = 1;
            v = v >> 7;
            while (v != (u64)0) { n++; v = v >> 7; };
            return n;
        };

        // ---- page model: the cells of one page held in memory ----

        def sq_pm_init(SQLITE_DB* db, SQ_PM* pm) -> int
        {
            int cnt = db.page_size / 4 + 16;
            pm.buf = (byte*)fmalloc((u64)(db.page_size * 3));
            pm.off = (int*)fmalloc((u64)(cnt * 4));
            pm.len = (int*)fmalloc((u64)(cnt * 4));
            pm.ncells = 0;
            pm.used = 0;
            pm.rightmost = 0;
            pm.type = 13;
            pm.hsz = 8;
            if ((u64)pm.buf == (u64)0 | (u64)pm.off == (u64)0 | (u64)pm.len == (u64)0) { return 1; };
            return 0;
        };

        def sq_pm_free(SQ_PM* pm) -> void
        {
            if ((u64)pm.buf != (u64)0) { ffree((u64)pm.buf); pm.buf = (byte*)0; };
            if ((u64)pm.off != (u64)0) { ffree((u64)pm.off); pm.off = (int*)0; };
            if ((u64)pm.len != (u64)0) { ffree((u64)pm.len); pm.len = (int*)0; };
        };

        def sq_local_size(SQLITE_DB* db, int total) -> int
        {
            int U, X, M, K;
            U = db.usable;
            X = U - 35;
            if (total <= X) { return total; };
            M = ((U - 12) * 32 / 255) - 23;
            K = M + ((total - M) % (U - 4));
            if (K <= X) { return K; };
            return M;
        };

        // Size in bytes of the table b-tree cell starting at p.
        def sq_cell_size(SQLITE_DB* db, int type, byte* p) -> int
        {
            u64 a, b;
            int n, m, total, lcl;
            if (type == 10 | type == 2)
            {
                m = 0;
                if (type == 2) { m = 4; };
                n = sq_varint(@p[m], @a);
                total = (int)a;
                lcl = sq_ilocal(db, total);
                if (lcl < total) { return m + n + lcl + 4; };
                return m + n + lcl;
            };
            if (type == 5)
            {
                n = sq_varint(@p[4], @a);
                return 4 + n;
            };
            n = sq_varint(p, @a);
            m = sq_varint(@p[n], @b);
            total = (int)a;
            lcl = sq_local_size(db, total);
            if (lcl < total) { return n + m + lcl + 4; };
            return n + m + lcl;
        };

        def sq_hoff(int pgno) -> int
        {
            if (pgno == 1) { return 100; };
            return 0;
        };

        def sq_pm_load(SQLITE_DB* db, int pgno, SQ_PM* pm) -> int
        {
            byte* page = sq_page(db, pgno);
            int ho, t, nc, hsz, i, cp, sz, k;
            if ((u64)page == (u64)0) { return 1; };
            ho = sq_hoff(pgno);
            t = (int)page[ho];
            if (t != 13 & t != 5 & t != 10 & t != 2) { return 1; };
            nc = sq_be16(@page[ho + 3]);
            hsz = 8;
            pm.rightmost = 0;
            if (t == 5 | t == 2) { hsz = 12; pm.rightmost = sq_be32(@page[ho + 8]); };
            pm.type = t;
            pm.hsz = hsz;
            pm.used = 0;
            for (i = 0; i < nc; i++)
            {
                cp = sq_be16(@page[ho + hsz + 2 * i]);
                if (cp >= db.page_size) { return 1; };
                sz = sq_cell_size(db, t, @page[cp]);
                if (cp + sz > db.page_size) { return 1; };
                for (k = 0; k < sz; k++) { pm.buf[pm.used + k] = page[cp + k]; };
                pm.off[i] = pm.used;
                pm.len[i] = sz;
                pm.used = pm.used + sz;
            };
            pm.ncells = nc;
            return 0;
        };

        def sq_pm_insert(SQ_PM* pm, int idx, byte* cell, int clen) -> void
        {
            int j, k;
            for (j = pm.ncells; j > idx; j--)
            {
                pm.off[j] = pm.off[j - 1];
                pm.len[j] = pm.len[j - 1];
            };
            for (k = 0; k < clen; k++) { pm.buf[pm.used + k] = cell[k]; };
            pm.off[idx] = pm.used;
            pm.len[idx] = clen;
            pm.used = pm.used + clen;
            pm.ncells = pm.ncells + 1;
        };

        def sq_pm_remove(SQ_PM* pm, int idx) -> void
        {
            int j;
            for (j = idx; j < pm.ncells - 1; j++)
            {
                pm.off[j] = pm.off[j + 1];
                pm.len[j] = pm.len[j + 1];
            };
            pm.ncells = pm.ncells - 1;
        };

        // Do cells a..b-1 fit on a page whose header starts at offset ho?
        def sq_range_fits(SQLITE_DB* db, int ho, SQ_PM* pm, int a, int b) -> bool
        {
            int i, sum;
            sum = 0;
            for (i = a; i < b; i++) { sum = sum + pm.len[i]; };
            return ho + pm.hsz + 2 * (b - a) + sum <= db.usable;
        };

        // Writes cells a..b-1 of pm as page pgno.
        def sq_pm_write(SQLITE_DB* db, int pgno, SQ_PM* pm, int a, int b, int type, int rightmost) -> int
        {
            byte* old;
            byte* w = db.wbuf;
            int ho, hsz, i, k, content, n;
            ho = sq_hoff(pgno);
            hsz = 8;
            if (type == 5 | type == 2) { hsz = 12; };
            if (pgno == 1)
            {
                old = sq_page(db, 1);
                if ((u64)old == (u64)0) { return 1; };
                for (i = 0; i < 100; i++) { w[i] = old[i]; };
            };
            for (i = ho; i < db.page_size; i++) { w[i] = (byte)0; };
            n = b - a;
            w[ho] = (byte)type;
            sq_put16(@w[ho + 3], n);
            if (type == 5 | type == 2) { sq_put32(@w[ho + 8], rightmost); };
            content = db.usable;
            for (i = a; i < b; i++)
            {
                content = content - pm.len[i];
                for (k = 0; k < pm.len[i]; k++) { w[content + k] = pm.buf[pm.off[i] + k]; };
                sq_put16(@w[ho + hsz + 2 * (i - a)], content);
            };
            if (content >= 65536) { sq_put16(@w[ho + 5], 0); } else { sq_put16(@w[ho + 5], content); };
            return sq_page_write(db, pgno, w);
        };

        // ---- table b-tree: seek ----

        // 1 found, 0 absent (path leaf index is the insert position), -1 error
        def sq_seek(SQLITE_DB* db, int root, i64 rowid, SQ_PATH* pa) -> int
        {
            byte* page;
            int pgno, d, ho, t, nc, lo, hi, mid, cp, n, child;
            u64 a, b;
            i64 k;
            pgno = root;
            d = 0;
            pa.rightmost = 1;
            while (true)
            {
                if (d >= 20) { return 0 - 1; };
                page = sq_page(db, pgno);
                if ((u64)page == (u64)0) { return 0 - 1; };
                ho = sq_hoff(pgno);
                t = (int)page[ho];
                nc = sq_be16(@page[ho + 3]);
                pa.pg[d] = pgno;
                if (t == 13)
                {
                    lo = 0;
                    hi = nc;
                    while (lo < hi)
                    {
                        mid = (lo + hi) / 2;
                        cp = sq_be16(@page[ho + 8 + 2 * mid]);
                        n = sq_varint(@page[cp], @a);
                        sq_varint(@page[cp + n], @b);
                        k = (i64)b;
                        if (k < rowid) { lo = mid + 1; } else { hi = mid; };
                    };
                    pa.ci[d] = lo;
                    pa.depth = d + 1;
                    if (lo < nc)
                    {
                        cp = sq_be16(@page[ho + 8 + 2 * lo]);
                        n = sq_varint(@page[cp], @a);
                        sq_varint(@page[cp + n], @b);
                        if ((i64)b == rowid) { return 1; };
                    };
                    return 0;
                };
                if (t != 5) { return 0 - 1; };
                lo = 0;
                hi = nc;
                while (lo < hi)
                {
                    mid = (lo + hi) / 2;
                    cp = sq_be16(@page[ho + 12 + 2 * mid]);
                    sq_varint(@page[cp + 4], @b);
                    k = (i64)b;
                    if (k < rowid) { lo = mid + 1; } else { hi = mid; };
                };
                pa.ci[d] = lo;
                if (lo < nc)
                {
                    cp = sq_be16(@page[ho + 12 + 2 * lo]);
                    child = sq_be32(@page[cp]);
                    pa.rightmost = 0;
                }
                else { child = sq_be32(@page[ho + 8]); };
                d++;
                pgno = child;
            };
            return 0 - 1;
        };

        // Largest rowid in the table (0 when empty), -1 on error.
        def sq_max_rowid(SQLITE_DB* db, int root, i64* out) -> int
        {
            byte* page;
            int pgno, ho, t, nc, cp, n, depth;
            u64 a, b;
            pgno = root;
            depth = 0;
            while (depth < 20)
            {
                page = sq_page(db, pgno);
                if ((u64)page == (u64)0) { return 1; };
                ho = sq_hoff(pgno);
                t = (int)page[ho];
                nc = sq_be16(@page[ho + 3]);
                if (t == 13)
                {
                    if (nc == 0) { *out = (i64)0; return 0; };
                    cp = sq_be16(@page[ho + 8 + 2 * (nc - 1)]);
                    n = sq_varint(@page[cp], @a);
                    sq_varint(@page[cp + n], @b);
                    *out = (i64)b;
                    return 0;
                };
                if (t != 5) { return 1; };
                pgno = sq_be32(@page[ho + 8]);
                depth++;
            };
            return 1;
        };

        // ---- table b-tree: insert ----

        // Builds a leaf cell for (rowid, payload) into out. Overflow pages are allocated as needed.
        def sq_build_cell(SQLITE_DB* db, i64 rowid, byte* payload, int plen, byte* out) -> int
        {
            int n, lcl, i, pos, chunk, cur, nxt, U;
            n = sq_put_varint(out, (u64)plen);
            n = n + sq_put_varint(@out[n], (u64)rowid);
            lcl = sq_local_size(db, plen);
            for (i = 0; i < lcl; i++) { out[n + i] = payload[i]; };
            if (lcl == plen) { return n + lcl; };
            U = db.usable;
            pos = lcl;
            cur = sq_alloc_page(db);
            if (cur == 0) { return 0 - 1; };
            sq_put32(@out[n + lcl], cur);
            while (pos < plen)
            {
                chunk = plen - pos;
                if (chunk > U - 4) { chunk = U - 4; };
                nxt = 0;
                if (pos + chunk < plen)
                {
                    nxt = sq_alloc_page(db);
                    if (nxt == 0) { return 0 - 1; };
                };
                for (i = 0; i < db.page_size; i++) { db.wbuf[i] = (byte)0; };
                sq_put32(@db.wbuf[0], nxt);
                for (i = 0; i < chunk; i++) { db.wbuf[4 + i] = payload[pos + i]; };
                if (sq_page_write(db, cur, db.wbuf) != 0) { return 0 - 1; };
                pos = pos + chunk;
                cur = nxt;
            };
            return n + lcl + 4;
        };

        def sq_abs(int x) -> int
        {
            if (x < 0) { return 0 - x; };
            return x;
        };

        // Inserts nnew consecutive cells (cells, lengths in clens) at index idx of the page at path level d,
        // splitting the page and recursing into the parent when it does not fit. When fix is 1 the child pointer
        // at idx is first changed to newpg (the right half of a split child).
        def sq_page_insert(SQLITE_DB* db, SQ_PATH* pa, int d, int idx, byte* cells, int* clens, int nnew, int fix, int newpg) -> int
        {
            SQ_PM pm;
            int pgno, n, i, k, s, best, bestd, tot, acc, dd, ho, type, isleaf, isroot, ngroups, m, rc;
            int[4] gb;
            int[4] pages;
            byte[64] divbuf;
            int[2] dlen;
            u64 a, b;
            int dpos;
            pgno = pa.pg[d];
            if (sq_pm_init(db, @pm) != 0) { sq_pm_free(@pm); return 1; };
            if (sq_pm_load(db, pgno, @pm) != 0) { sq_pm_free(@pm); return 1; };
            if (fix == 1)
            {
                if (idx < pm.ncells) { sq_put32(@pm.buf[pm.off[idx]], newpg); }
                else { pm.rightmost = newpg; };
            };
            k = 0;
            for (i = 0; i < nnew; i++)
            {
                sq_pm_insert(@pm, idx + i, @cells[k], clens[i]);
                k = k + clens[i];
            };
            ho = sq_hoff(pgno);
            n = pm.ncells;
            type = pm.type;
            if (sq_range_fits(db, ho, @pm, 0, n))
            {
                rc = sq_pm_write(db, pgno, @pm, 0, n, type, pm.rightmost);
                sq_pm_free(@pm);
                return rc;
            };
            // ---- split ----
            isleaf = 0;
            if (type == 13) { isleaf = 1; };
            isroot = 0;
            if (d == 0) { isroot = 1; };
            tot = 0;
            for (i = 0; i < n; i++) { tot = tot + pm.len[i]; };
            m = 0 - 1;
            if (isleaf == 1)
            {
                if (pa.rightmost == 1 & nnew == 1 & idx == n - 1)
                {
                    ngroups = 2; gb[0] = 0; gb[1] = n - 1; gb[2] = n;
                }
                else
                {
                    best = 0 - 1;
                    bestd = 0;
                    acc = 0;
                    for (s = 1; s < n; s++)
                    {
                        acc = acc + pm.len[s - 1];
                        if (sq_range_fits(db, 0, @pm, 0, s) & sq_range_fits(db, 0, @pm, s, n))
                        {
                            dd = sq_abs(acc * 2 - tot);
                            if (best < 0) { best = s; bestd = dd; }
                            else { if (dd < bestd) { best = s; bestd = dd; }; };
                        };
                    };
                    if (best >= 0)
                    {
                        ngroups = 2; gb[0] = 0; gb[1] = best; gb[2] = n;
                    }
                    else
                    {
                        if (idx < 1 | idx + 1 >= n) { sq_pm_free(@pm); return 1; };
                        ngroups = 3; gb[0] = 0; gb[1] = idx; gb[2] = idx + 1; gb[3] = n;
                    };
                };
            }
            else
            {
                if (n < 3) { sq_pm_free(@pm); return 1; };
                best = 0 - 1;
                bestd = 0;
                acc = 0;
                for (s = 1; s < n - 1; s++)
                {
                    acc = acc + pm.len[s - 1];
                    dd = sq_abs(acc * 2 - (tot - pm.len[s]));
                    if (best < 0) { best = s; bestd = dd; }
                    else { if (dd < bestd) { best = s; bestd = dd; }; };
                };
                m = best;
                ngroups = 2;
                gb[0] = 0; gb[1] = m; gb[2] = m + 1; gb[3] = n;
            };
            // pages for the groups
            for (i = 0; i < ngroups; i++)
            {
                if (i == 0 & isroot == 0) { pages[i] = pgno; }
                else
                {
                    pages[i] = sq_alloc_page(db);
                    if (pages[i] == 0) { sq_pm_free(@pm); return 1; };
                };
            };
            // dividers (child pointer + key) for the parent
            dpos = 0;
            if (isleaf == 1)
            {
                for (i = 0; i < ngroups - 1; i++)
                {
                    k = gb[i + 1] - 1;
                    sq_varint(@pm.buf[pm.off[k]], @a);
                    sq_varint(@pm.buf[pm.off[k] + sq_varint_len(a)], @b);
                    sq_put32(@divbuf[dpos], pages[i]);
                    dlen[i] = 4 + sq_put_varint(@divbuf[dpos + 4], b);
                    dpos = dpos + dlen[i];
                };
            }
            else
            {
                sq_varint(@pm.buf[pm.off[m] + 4], @b);
                sq_put32(@divbuf[0], pages[0]);
                dlen[0] = 4 + sq_put_varint(@divbuf[4], b);
            };
            // write the groups
            if (isleaf == 1)
            {
                for (i = 0; i < ngroups; i++)
                {
                    if (sq_pm_write(db, pages[i], @pm, gb[i], gb[i + 1], 13, 0) != 0) { sq_pm_free(@pm); return 1; };
                };
            }
            else
            {
                k = sq_be32(@pm.buf[pm.off[m]]);
                if (sq_pm_write(db, pages[0], @pm, 0, m, 5, k) != 0) { sq_pm_free(@pm); return 1; };
                if (sq_pm_write(db, pages[1], @pm, m + 1, n, 5, pm.rightmost) != 0) { sq_pm_free(@pm); return 1; };
            };
            if (isroot == 1)
            {
                // the root keeps its page number and becomes an interior page over the new pages
                pm.ncells = 0;
                pm.used = 0;
                pm.type = 5;
                pm.hsz = 12;
                dpos = 0;
                for (i = 0; i < ngroups - 1; i++)
                {
                    sq_pm_insert(@pm, i, @divbuf[dpos], dlen[i]);
                    dpos = dpos + dlen[i];
                };
                rc = sq_pm_write(db, pgno, @pm, 0, ngroups - 1, 5, pages[ngroups - 1]);
                sq_pm_free(@pm);
                return rc;
            };
            sq_pm_free(@pm);
            return sq_page_insert(db, pa, d - 1, pa.ci[d - 1], @divbuf[0], @dlen[0], ngroups - 1, 1, pages[ngroups - 1]);
        };

        // 0 inserted, 2 rowid already present, anything else is an error
        def sq_btree_insert(SQLITE_DB* db, int root, i64 rowid, byte* payload, int plen) -> int
        {
            SQ_PATH pa;
            int r, clen, d;
            int[2] lens;
            r = sq_seek(db, root, rowid, @pa);
            if (r == 1) { return 2; };
            if (r < 0) { return 1; };
            clen = sq_build_cell(db, rowid, payload, plen, db.cbuf);
            if (clen < 0) { return 1; };
            d = pa.depth - 1;
            lens[0] = clen;
            return sq_page_insert(db, @pa, d, pa.ci[d], db.cbuf, @lens[0], 1, 0, 0);
        };

        // ---- table b-tree: delete ----

        def sq_free_chain(SQLITE_DB* db, int first) -> int
        {
            byte* page;
            int pg, nxt, guard;
            pg = first;
            guard = 0;
            while (pg != 0)
            {
                page = sq_page(db, pg);
                if ((u64)page == (u64)0) { return 1; };
                nxt = sq_be32(@page[0]);
                if (sq_free_page(db, pg) != 0) { return 1; };
                pg = nxt;
                guard++;
                if (guard > db.npages + 4) { return 1; };
            };
            return 0;
        };

        // An interior page at path level lvl has no cells left, only its rightmost child. Remove the level.
        def sq_collapse(SQLITE_DB* db, SQ_PATH* pa, int lvl, int child) -> int
        {
            SQ_PM pm, gp;
            int rc, j, pg;
            pg = pa.pg[lvl];
            if (lvl == 0)
            {
                if (sq_pm_init(db, @pm) != 0) { sq_pm_free(@pm); return 1; };
                if (sq_pm_load(db, child, @pm) != 0) { sq_pm_free(@pm); return 1; };
                if (sq_range_fits(db, sq_hoff(pg), @pm, 0, pm.ncells) == false) { sq_pm_free(@pm); return 0; };
                rc = sq_pm_write(db, pg, @pm, 0, pm.ncells, pm.type, pm.rightmost);
                sq_pm_free(@pm);
                if (rc != 0) { return 1; };
                return sq_free_page(db, child);
            };
            if (sq_pm_init(db, @gp) != 0) { sq_pm_free(@gp); return 1; };
            if (sq_pm_load(db, pa.pg[lvl - 1], @gp) != 0) { sq_pm_free(@gp); return 1; };
            j = pa.ci[lvl - 1];
            if (j < gp.ncells) { sq_put32(@gp.buf[gp.off[j]], child); }
            else { gp.rightmost = child; };
            rc = sq_pm_write(db, pa.pg[lvl - 1], @gp, 0, gp.ncells, 5, gp.rightmost);
            sq_pm_free(@gp);
            if (rc != 0) { return 1; };
            return sq_free_page(db, pg);
        };

        // 0 deleted, 1 no such rowid, 2 error
        def sq_btree_delete(SQLITE_DB* db, int root, i64 rowid) -> int
        {
            SQ_PATH pa;
            SQ_PM pm;
            u64 a, b;
            int r, d, idx, leaf, n, m, lcl, total, ov, rc, j, lvl, child, ncl;
            r = sq_seek(db, root, rowid, @pa);
            if (r < 0) { return 2; };
            if (r == 0) { return 1; };
            d = pa.depth - 1;
            leaf = pa.pg[d];
            idx = pa.ci[d];
            if (sq_pm_init(db, @pm) != 0) { sq_pm_free(@pm); return 2; };
            if (sq_pm_load(db, leaf, @pm) != 0) { sq_pm_free(@pm); return 2; };
            n = sq_varint(@pm.buf[pm.off[idx]], @a);
            m = sq_varint(@pm.buf[pm.off[idx] + n], @b);
            total = (int)a;
            lcl = sq_local_size(db, total);
            if (lcl < total)
            {
                ov = sq_be32(@pm.buf[pm.off[idx] + n + m + lcl]);
                if (sq_free_chain(db, ov) != 0) { sq_pm_free(@pm); return 2; };
            };
            sq_pm_remove(@pm, idx);
            if (pm.ncells > 0 | d == 0)
            {
                rc = sq_pm_write(db, leaf, @pm, 0, pm.ncells, 13, 0);
                sq_pm_free(@pm);
                if (rc != 0) { return 2; };
                return 0;
            };
            // the leaf is empty: free it and drop it from its parent, climbing while parents empty out
            sq_pm_free(@pm);
            if (sq_free_page(db, leaf) != 0) { return 2; };
            lvl = d - 1;
            while (lvl >= 0)
            {
                if (sq_pm_init(db, @pm) != 0) { sq_pm_free(@pm); return 2; };
                if (sq_pm_load(db, pa.pg[lvl], @pm) != 0) { sq_pm_free(@pm); return 2; };
                j = pa.ci[lvl];
                if (pm.ncells == 0)
                {
                    // the only child is gone
                    sq_pm_free(@pm);
                    if (lvl == 0)
                    {
                        // root becomes an empty leaf
                        if (sq_pm_init(db, @pm) != 0) { sq_pm_free(@pm); return 2; };
                        rc = sq_pm_write(db, pa.pg[0], @pm, 0, 0, 13, 0);
                        sq_pm_free(@pm);
                        if (rc != 0) { return 2; };
                        return 0;
                    };
                    if (sq_free_page(db, pa.pg[lvl]) != 0) { return 2; };
                    lvl--;
                }
                else
                {
                    if (j < pm.ncells) { sq_pm_remove(@pm, j); }
                    else
                    {
                        pm.rightmost = sq_be32(@pm.buf[pm.off[pm.ncells - 1]]);
                        sq_pm_remove(@pm, pm.ncells - 1);
                    };
                    rc = sq_pm_write(db, pa.pg[lvl], @pm, 0, pm.ncells, 5, pm.rightmost);
                    ncl = pm.ncells;
                    child = pm.rightmost;
                    sq_pm_free(@pm);
                    if (rc != 0) { return 2; };
                    if (ncl == 0)
                    {
                        if (sq_collapse(db, @pa, lvl, child) != 0) { return 2; };
                    };
                    return 0;
                };
            };
            return 0;
        };

        // ---- records ----

        def sq_int_serial(i64 v, int* blen) -> int
        {
            if (v == (i64)0) { *blen = 0; return 8; };
            if (v == (i64)1) { *blen = 0; return 9; };
            if (v >= (i64)0 - (i64)128 & v <= (i64)127) { *blen = 1; return 1; };
            if (v >= (i64)0 - (i64)32768 & v <= (i64)32767) { *blen = 2; return 2; };
            if (v >= (i64)0 - (i64)8388608 & v <= (i64)8388607) { *blen = 3; return 3; };
            if (v >= (i64)0 - (i64)2147483648 & v <= (i64)2147483647) { *blen = 4; return 4; };
            if (v >= (i64)0 - (i64)140737488355328 & v <= (i64)140737488355327) { *blen = 6; return 5; };
            *blen = 8;
            return 6;
        };

        def sq_val_serial(SQ_VAL* v, int* blen) -> int
        {
            if (v.t == SQ_NULL) { *blen = 0; return 0; };
            if (v.t == SQ_INTEGER) { return sq_int_serial(v.i, blen); };
            if (v.t == SQ_REAL) { *blen = 8; return 7; };
            if (v.t == SQ_TEXT) { *blen = v.n; return 13 + 2 * v.n; };
            *blen = v.n;
            return 12 + 2 * v.n;
        };

        def sq_rec_size(SQ_VAL* vals, int n) -> int
        {
            int i, st, bl, hs, body, hsz;
            hs = 0;
            body = 0;
            for (i = 0; i < n; i++)
            {
                st = sq_val_serial(@vals[i], @bl);
                hs = hs + sq_varint_len((u64)st);
                body = body + bl;
            };
            hsz = hs + 1;
            if (hsz > 127) { hsz = hs + 2; };
            return hsz + body;
        };

        def sq_rec_write(SQ_VAL* vals, int n, byte* out) -> int
        {
            int i, k, st, bl, hs, hsz, hp, bp;
            u64 u;
            double dv;
            u64* bits;
            hs = 0;
            for (i = 0; i < n; i++)
            {
                st = sq_val_serial(@vals[i], @bl);
                hs = hs + sq_varint_len((u64)st);
            };
            hsz = hs + 1;
            if (hsz > 127) { hsz = hs + 2; };
            hp = sq_put_varint(out, (u64)hsz);
            bp = hsz;
            for (i = 0; i < n; i++)
            {
                st = sq_val_serial(@vals[i], @bl);
                hp = hp + sq_put_varint(@out[hp], (u64)st);
                if (vals[i].t == SQ_INTEGER)
                {
                    u = (u64)vals[i].i;
                    for (k = 0; k < bl; k++) { out[bp + k] = (byte)((u >> (8 * (bl - 1 - k))) `& (u64)255); };
                };
                if (vals[i].t == SQ_REAL)
                {
                    dv = vals[i].r;
                    bits = (u64*)@dv;
                    u = *bits;
                    for (k = 0; k < 8; k++) { out[bp + k] = (byte)((u >> (8 * (7 - k))) `& (u64)255); };
                };
                if (vals[i].t == SQ_TEXT | vals[i].t == SQ_BLOB)
                {
                    for (k = 0; k < bl; k++) { out[bp + k] = vals[i].p[k]; };
                };
                bp = bp + bl;
            };
            return bp;
        };


        // ---- index b-trees: cells ----

        // Builds an index cell for a record payload into out (leaf form; with child >= 0 the interior form).
        // Overflow pages are allocated as needed. Returns the cell size or -1.
        def sq_ix_build_cell(SQLITE_DB* db, byte* payload, int plen, int child, byte* out) -> int
        {
            int n, lcl, i, pos, chunk, cur, nxt, U, o;
            o = 0;
            if (child >= 0) { sq_put32(out, child); o = 4; };
            n = o + sq_put_varint(@out[o], (u64)plen);
            lcl = sq_ilocal(db, plen);
            for (i = 0; i < lcl; i++) { out[n + i] = payload[i]; };
            if (lcl == plen) { return n + lcl; };
            U = db.usable;
            pos = lcl;
            cur = sq_alloc_page(db);
            if (cur == 0) { return 0 - 1; };
            sq_put32(@out[n + lcl], cur);
            while (pos < plen)
            {
                chunk = plen - pos;
                if (chunk > U - 4) { chunk = U - 4; };
                nxt = 0;
                if (pos + chunk < plen)
                {
                    nxt = sq_alloc_page(db);
                    if (nxt == 0) { return 0 - 1; };
                };
                for (i = 0; i < db.page_size; i++) { db.wbuf[i] = (byte)0; };
                sq_put32(@db.wbuf[0], nxt);
                for (i = 0; i < chunk; i++) { db.wbuf[4 + i] = payload[pos + i]; };
                if (sq_page_write(db, cur, db.wbuf) != 0) { return 0 - 1; };
                pos = pos + chunk;
                cur = nxt;
            };
            return n + lcl + 4;
        };

        // overflow chain of a cell (first page number, 0 when none); cell points at the start of the cell on an index page
        def sq_ix_cell_ovf(SQLITE_DB* db, int type, byte* cell) -> int
        {
            u64 a;
            int m, n, total, lcl;
            m = 0;
            if (type == 2) { m = 4; };
            n = sq_varint(@cell[m], @a);
            total = (int)a;
            lcl = sq_ilocal(db, total);
            if (lcl < total) { return sq_be32(@cell[m + n + lcl]); };
            return 0;
        };

        // ---- index b-trees: descent ----

        struct SQ_IPATH
        {
            int depth, found;
            int[20] pg;
            int[20] ci;
        };

        // Descends to the entry equal to probe (all n values compared). found = 1 when the entry exists; the last
        // path level then is the page holding it, otherwise it is the leaf and ci the insertion position.
        def sq_ix_descend(SQ_ICUR* c, SQ_VAL* probe, int n, SQ_IPATH* pa) -> int
        {
            SQLITE_DB* db = c.db;
            byte* page;
            int pgno, ho, t, nc, lo, hi, mid, cmp, child, d;
            pgno = c.ix.root;
            pa.depth = 0;
            pa.found = 0;
            while (true)
            {
                if (pa.depth >= 20) { return 1; };
                page = sq_page(db, pgno);
                if ((u64)page == (u64)0) { return 1; };
                ho = sq_hdr_off(pgno);
                t = (int)page[ho];
                nc = sq_be16(@page[ho + 3]);
                if (t != 2 & t != 10) { return 1; };
                lo = 0;
                hi = nc;
                while (lo < hi)
                {
                    mid = (lo + hi) / 2;
                    if (sq_icur_load(c, pgno, mid) != 0) { return 1; };
                    cmp = sq_icmp(c.ix, @c.v[0], c.nv, probe, n);
                    if (cmp == 0) { lo = mid; hi = mid; pa.found = 1; break; };
                    if (cmp < 0) { lo = mid + 1; } else { hi = mid; };
                };
                d = pa.depth;
                pa.pg[d] = pgno;
                pa.ci[d] = lo;
                pa.depth = d + 1;
                if (pa.found == 1) { return 0; };
                if (t == 10) { return 0; };
                page = sq_page(db, pgno);
                if ((u64)page == (u64)0) { return 1; };
                if (lo < nc) { child = sq_be32(@page[sq_be16(@page[ho + 12 + 2 * lo])]); }
                else { child = sq_be32(@page[ho + 8]); };
                pgno = child;
            };
            return 1;
        };

        // ---- index b-trees: insert ----

        // Inserts nnew cells at index idx of the page at path level d, splitting when needed. fix = 1 first points the child at idx
        // to newpg.
        def sq_ix_page_insert(SQLITE_DB* db, SQ_IPATH* pa, int d, int idx, byte* cells, int* clens, int nnew, int fix, int newpg) -> int
        {
            SQ_PM pm;
            byte* dv;
            int pgno, n, i, k, s, best, bestd, tot, acc, dd, ho, type, isleaf, isroot, m, rc, dlen, lp, rp, lchild, acc2;
            pgno = pa.pg[d];
            if (sq_pm_init(db, @pm) != 0) { sq_pm_free(@pm); return 1; };
            if (sq_pm_load(db, pgno, @pm) != 0) { sq_pm_free(@pm); return 1; };
            if (fix == 1)
            {
                if (idx < pm.ncells) { sq_put32(@pm.buf[pm.off[idx]], newpg); }
                else { pm.rightmost = newpg; };
            };
            k = 0;
            for (i = 0; i < nnew; i++)
            {
                sq_pm_insert(@pm, idx + i, @cells[k], clens[i]);
                k = k + clens[i];
            };
            ho = sq_hoff(pgno);
            n = pm.ncells;
            type = pm.type;
            if (sq_range_fits(db, ho, @pm, 0, n))
            {
                rc = sq_pm_write(db, pgno, @pm, 0, n, type, pm.rightmost);
                sq_pm_free(@pm);
                return rc;
            };
            isleaf = 0;
            if (type == 10) { isleaf = 1; };
            isroot = 0;
            if (d == 0) { isroot = 1; };
            if (n < 3) { sq_pm_free(@pm); return 1; };
            tot = 0;
            for (i = 0; i < n; i++) { tot = tot + pm.len[i]; };
            // the median goes up; choose it so both halves fit and are close in size
            best = 0 - 1;
            bestd = 0;
            acc = 0;
            for (s = 1; s < n - 1; s++)
            {
                acc = acc + pm.len[s - 1];
                if (sq_range_fits(db, ho, @pm, 0, s) & sq_range_fits(db, 0, @pm, s + 1, n))
                {
                    dd = sq_abs(acc * 2 - (tot - pm.len[s]));
                    if (best < 0) { best = s; bestd = dd; }
                    else { if (dd < bestd) { best = s; bestd = dd; }; };
                };
            };
            if (best < 0) { sq_pm_free(@pm); return 1; };
            m = best;
            if (isroot == 1)
            {
                lp = sq_alloc_page(db);
                if (lp == 0) { sq_pm_free(@pm); return 1; };
            }
            else { lp = pgno; };
            rp = sq_alloc_page(db);
            if (rp == 0) { sq_pm_free(@pm); return 1; };
            // divider: the left page number followed by the entry of cell m
            dv = (byte*)fmalloc((u64)(pm.len[m] + 16));
            if ((u64)dv == (u64)0) { sq_pm_free(@pm); return 1; };
            sq_put32(dv, lp);
            if (isleaf == 1)
            {
                for (i = 0; i < pm.len[m]; i++) { dv[4 + i] = pm.buf[pm.off[m] + i]; };
                dlen = 4 + pm.len[m];
                lchild = 0;
            }
            else
            {
                for (i = 4; i < pm.len[m]; i++) { dv[i] = pm.buf[pm.off[m] + i]; };
                dlen = pm.len[m];
                lchild = sq_be32(@pm.buf[pm.off[m]]);
            };
            if (sq_pm_write(db, lp, @pm, 0, m, type, lchild) != 0) { sq_pm_free(@pm); ffree((u64)dv); return 1; };
            if (sq_pm_write(db, rp, @pm, m + 1, n, type, pm.rightmost) != 0) { sq_pm_free(@pm); ffree((u64)dv); return 1; };
            if (isroot == 1)
            {
                pm.ncells = 0;
                pm.used = 0;
                pm.type = 2;
                pm.hsz = 12;
                sq_pm_insert(@pm, 0, dv, dlen);
                rc = sq_pm_write(db, pgno, @pm, 0, 1, 2, rp);
                sq_pm_free(@pm);
                ffree((u64)dv);
                return rc;
            };
            sq_pm_free(@pm);
            pm.ncells = 0;
            rc = sq_ix_page_insert(db, pa, d - 1, pa.ci[d - 1], dv, @dlen, 1, 1, rp);
            ffree((u64)dv);
            return rc;
        };

        // payload of an entry: key values followed by the rowid
        def sq_ix_payload(SQ_VAL* vals, int n, byte** outp, int* outn) -> int
        {
            int sz;
            byte* rec;
            sz = sq_rec_size(vals, n);
            rec = (byte*)fmalloc((u64)(sz + 8));
            if ((u64)rec == (u64)0) { return 1; };
            sq_rec_write(vals, n, rec);
            *outp = rec;
            *outn = sz;
            return 0;
        };

        // 0 inserted, 2 the exact entry exists, otherwise an error. vals holds nk key values and the rowid.
        def sq_ix_insert(SQLITE_DB* db, SQ_IDX* ix, SQ_VAL* vals) -> int
        {
            SQ_ICUR c;
            SQ_IPATH pa;
            byte* rec;
            byte* cell;
            int rn, clen, rc, d, r;
            int[2] lens;
            if (sq_ix_payload(vals, ix.nk + 1, @rec, @rn) != 0) { return 1; };
            cell = (byte*)fmalloc((u64)(db.page_size + rn + 64));
            if ((u64)cell == (u64)0) { ffree((u64)rec); return 1; };
            sq_icur_open(@c, db, ix);
            r = sq_ix_descend(@c, vals, ix.nk + 1, @pa);
            sq_icur_close(@c);
            if (r != 0) { ffree((u64)rec); ffree((u64)cell); return 1; };
            if (pa.found == 1) { ffree((u64)rec); ffree((u64)cell); return 2; };
            clen = sq_ix_build_cell(db, rec, rn, 0 - 1, cell);
            ffree((u64)rec);
            if (clen < 0) { ffree((u64)cell); return 1; };
            d = pa.depth - 1;
            lens[0] = clen;
            rc = sq_ix_page_insert(db, @pa, d, pa.ci[d], cell, @lens[0], 1, 0, 0);
            ffree((u64)cell);
            return rc;
        };

        // ---- index b-trees: delete ----

        // 0 deleted, 1 not found, 3 the page would be left empty (the caller rebuilds the index), 2 error
        def sq_ix_delete(SQLITE_DB* db, SQ_IDX* ix, SQ_VAL* vals) -> int
        {
            SQ_ICUR c;
            SQ_IPATH pa;
            SQ_PM pm, lf;
            int r, d, leaf, idx, rc, ov, ty, pg, cell_i, lv, last;
            byte* page;
            byte* pc;
            byte* newcell;
            int[2] lens;
            sq_icur_open(@c, db, ix);
            r = sq_ix_descend(@c, vals, ix.nk + 1, @pa);
            sq_icur_close(@c);
            if (r != 0) { return 2; };
            if (pa.found == 0) { return 1; };
            d = pa.depth - 1;
            leaf = pa.pg[d];
            idx = pa.ci[d];
            if (sq_pm_init(db, @pm) != 0) { sq_pm_free(@pm); return 2; };
            if (sq_pm_load(db, leaf, @pm) != 0) { sq_pm_free(@pm); return 2; };
            ty = pm.type;
            if (ty == 10)
            {
                if (pm.ncells == 1 & d > 0) { sq_pm_free(@pm); return 3; };
                ov = sq_ix_cell_ovf(db, 10, @pm.buf[pm.off[idx]]);
                if (ov != 0) { if (sq_free_chain(db, ov) != 0) { sq_pm_free(@pm); return 2; }; };
                sq_pm_remove(@pm, idx);
                rc = sq_pm_write(db, leaf, @pm, 0, pm.ncells, 10, 0);
                sq_pm_free(@pm);
                if (rc != 0) { return 2; };
                return 0;
            };
            // interior entry: replace it with its predecessor, the last entry of the leaf at the end of the left subtree
            pg = sq_be32(@pm.buf[pm.off[idx]]);
            lv = d;
            while (true)
            {
                lv++;
                if (lv >= 20) { sq_pm_free(@pm); return 2; };
                pa.pg[lv] = pg;
                page = sq_page(db, pg);
                if ((u64)page == (u64)0) { sq_pm_free(@pm); return 2; };
                r = (int)page[sq_hoff(pg)];
                if (r == 10) { break; };
                pa.ci[lv] = sq_be16(@page[sq_hoff(pg) + 3]);
                pg = sq_be32(@page[sq_hoff(pg) + 8]);
            };
            if (sq_pm_init(db, @lf) != 0) { sq_pm_free(@pm); sq_pm_free(@lf); return 2; };
            if (sq_pm_load(db, pg, @lf) != 0) { sq_pm_free(@pm); sq_pm_free(@lf); return 2; };
            if (lf.ncells < 2) { sq_pm_free(@pm); sq_pm_free(@lf); return 3; };
            last = lf.ncells - 1;
            // the new interior cell: the old left child followed by the predecessor entry
            newcell = (byte*)fmalloc((u64)(lf.len[last] + 16));
            if ((u64)newcell == (u64)0) { sq_pm_free(@pm); sq_pm_free(@lf); return 2; };
            sq_put32(newcell, sq_be32(@pm.buf[pm.off[idx]]));
            for (r = 0; r < lf.len[last]; r++) { newcell[4 + r] = lf.buf[lf.off[last] + r]; };
            lens[0] = 4 + lf.len[last];
            // free the overflow of the removed interior entry
            ov = sq_ix_cell_ovf(db, 2, @pm.buf[pm.off[idx]]);
            if (ov != 0) { if (sq_free_chain(db, ov) != 0) { sq_pm_free(@pm); sq_pm_free(@lf); ffree((u64)newcell); return 2; }; };
            // the predecessor leaves its leaf (its overflow chain moves with the entry)
            sq_pm_remove(@lf, last);
            rc = sq_pm_write(db, pg, @lf, 0, lf.ncells, 10, 0);
            sq_pm_free(@lf);
            if (rc != 0) { sq_pm_free(@pm); ffree((u64)newcell); return 2; };
            // replace the interior cell: remove it, then insert the new one (this may split the page)
            sq_pm_remove(@pm, idx);
            rc = sq_pm_write(db, leaf, @pm, 0, pm.ncells, 2, pm.rightmost);
            sq_pm_free(@pm);
            if (rc != 0) { ffree((u64)newcell); return 2; };
            rc = sq_ix_page_insert(db, @pa, d, idx, newcell, @lens[0], 1, 0, 0);
            ffree((u64)newcell);
            if (rc != 0) { return 2; };
            return 0;
        };

        // ---- freeing whole trees ----

        // Frees the pages of a b-tree (table or index) below and including pgno; with keep the page itself stays and is
        // reset to an empty leaf of the given type.
        def sq_tree_free(SQLITE_DB* db, int pgno, int keep, int emptytype, int depth) -> int
        {
            byte* page;
            byte* buf;
            int ho, t, nc, hsz, i, cp, ov, child, sz, n;
            u64 a, b;
            SQ_PM pm;
            if (depth > 20) { return 1; };
            page = sq_page(db, pgno);
            if ((u64)page == (u64)0) { return 1; };
            // copy the page: nested frees reuse the page cache
            buf = (byte*)fmalloc((u64)db.page_size);
            if ((u64)buf == (u64)0) { return 1; };
            for (i = 0; i < db.page_size; i++) { buf[i] = page[i]; };
            ho = sq_hoff(pgno);
            t = (int)buf[ho];
            nc = sq_be16(@buf[ho + 3]);
            hsz = 8;
            if (t == 5 | t == 2) { hsz = 12; };
            for (i = 0; i < nc; i++)
            {
                cp = sq_be16(@buf[ho + hsz + 2 * i]);
                if (cp >= db.page_size) { ffree((u64)buf); return 1; };
                if (t == 5 | t == 2)
                {
                    child = sq_be32(@buf[cp]);
                    if (sq_tree_free(db, child, 0, 0, depth + 1) != 0) { ffree((u64)buf); return 1; };
                };
                ov = 0;
                if (t == 13)
                {
                    n = sq_varint(@buf[cp], @a);
                    sz = sq_cell_size(db, 13, @buf[cp]);
                    if (sq_local_size(db, (int)a) < (int)a) { ov = sq_be32(@buf[cp + sz - 4]); };
                };
                if (t == 10 | t == 2) { ov = sq_ix_cell_ovf(db, t, @buf[cp]); };
                if (ov != 0) { if (sq_free_chain(db, ov) != 0) { ffree((u64)buf); return 1; }; };
            };
            if (t == 5 | t == 2)
            {
                child = sq_be32(@buf[ho + 8]);
                if (sq_tree_free(db, child, 0, 0, depth + 1) != 0) { ffree((u64)buf); return 1; };
            };
            ffree((u64)buf);
            if (keep == 1)
            {
                if (sq_pm_init(db, @pm) != 0) { sq_pm_free(@pm); return 1; };
                i = sq_pm_write(db, pgno, @pm, 0, 0, emptytype, 0);
                sq_pm_free(@pm);
                return i;
            };
            return sq_free_page(db, pgno);
        };

        // ---- index b-trees: bulk build (used by CREATE INDEX and rebuilds) ----

        struct SQ_SORTIX
        {
            SQ_IDX* ix;
            byte* recs;
            int* off;
            int* len;
            int n;
            SQ_VAL[18] va;
            SQ_VAL[18] vb;
        };

        def sq_sortix_cmp(SQ_SORTIX* so, int a, int b) -> int
        {
            int na, nb, n;
            na = sq_rec_decode(@so.recs[so.off[a]], so.len[a], @so.va[0], 18);
            nb = sq_rec_decode(@so.recs[so.off[b]], so.len[b], @so.vb[0], 18);
            n = so.ix.nk + 1;
            if (na < n | nb < n) { return 0; };
            return sq_icmp(so.ix, @so.va[0], na, @so.vb[0], n);
        };

        // sorts the entry numbers 0..n-1 into perm
        def sq_sortix_run(SQ_SORTIX* so, int* perm) -> int
        {
            int* tmp;
            int n, i, width, lo, mid, hi, a, b, k;
            n = so.n;
            tmp = (int*)fmalloc((u64)(n + 1) * (u64)4);
            if ((u64)tmp == (u64)0) { return 1; };
            for (i = 0; i < n; i++) { perm[i] = i; };
            width = 1;
            while (width < n)
            {
                lo = 0;
                while (lo < n)
                {
                    mid = lo + width;
                    if (mid > n) { mid = n; };
                    hi = lo + 2 * width;
                    if (hi > n) { hi = n; };
                    a = lo; b = mid; k = lo;
                    while (a < mid & b < hi)
                    {
                        if (sq_sortix_cmp(so, perm[b], perm[a]) < 0) { tmp[k] = perm[b]; b++; } else { tmp[k] = perm[a]; a++; };
                        k++;
                    };
                    while (a < mid) { tmp[k] = perm[a]; a++; k++; };
                    while (b < hi) { tmp[k] = perm[b]; b++; k++; };
                    lo = hi;
                };
                for (i = 0; i < n; i++) { perm[i] = tmp[i]; };
                width = width * 2;
            };
            ffree((u64)tmp);
            return 0;
        };

        // Builds the b-tree of ix from the sorted records. root keeps its page number. The old tree must already be freed.
        def sq_ix_bulk(SQLITE_DB* db, SQ_IDX* ix, SQ_SORTIX* so, int* perm) -> int
        {
            byte* cells;
            int* coff;
            int* clen;
            int* nodes;
            int* nn;
            int* sepi;
            int* sepn;
            int n, i, a, b, k, cap, used, ho, nlevel, nk2, u, t, rc, tot, root;
            SQ_PM pm;
            byte* cellbuf;
            int cn, pg;
            n = so.n;
            root = ix.root;
            if (n == 0)
            {
                if (sq_pm_init(db, @pm) != 0) { sq_pm_free(@pm); return 1; };
                rc = sq_pm_write(db, root, @pm, 0, 0, 10, 0);
                sq_pm_free(@pm);
                return rc;
            };
            // leaf cells for every entry (their overflow pages are allocated here)
            cellbuf = (byte*)fmalloc((u64)(db.page_size + 64));
            if ((u64)cellbuf == (u64)0) { return 1; };
            coff = (int*)fmalloc((u64)(n + 1) * (u64)4);
            clen = (int*)fmalloc((u64)(n + 1) * (u64)4);
            cap = n * 40 + 4096;
            cells = (byte*)fmalloc((u64)cap);
            if ((u64)coff == (u64)0 | (u64)clen == (u64)0 | (u64)cells == (u64)0) { return 1; };
            used = 0;
            for (i = 0; i < n; i++)
            {
                k = perm[i];
                cn = sq_ix_build_cell(db, @so.recs[so.off[k]], so.len[k], 0 - 1, cellbuf);
                if (cn < 0) { return 1; };
                if (used + cn > cap)
                {
                    // grow
                    byte* nc = (byte*)fmalloc((u64)(cap * 2 + cn));
                    if ((u64)nc == (u64)0) { return 1; };
                    for (t = 0; t < used; t++) { nc[t] = cells[t]; };
                    ffree((u64)cells);
                    cells = nc;
                    cap = cap * 2 + cn;
                };
                for (t = 0; t < cn; t++) { cells[used + t] = cellbuf[t]; };
                coff[i] = used;
                clen[i] = cn;
                used = used + cn;
            };
            ffree((u64)cellbuf);
            // level 0: the leaves. nodes[] are page numbers, sepi[] the entry (cell number) separating node j and j+1.
            nodes = (int*)fmalloc((u64)(n + 2) * (u64)4);
            sepi = (int*)fmalloc((u64)(n + 2) * (u64)4);
            nn = (int*)fmalloc((u64)(n + 2) * (u64)4);
            sepn = (int*)fmalloc((u64)(n + 2) * (u64)4);
            if ((u64)nodes == (u64)0 | (u64)sepi == (u64)0 | (u64)nn == (u64)0 | (u64)sepn == (u64)0) { return 1; };
            if (sq_pm_init(db, @pm) != 0) { sq_pm_free(@pm); return 1; };
            nlevel = 0;
            i = 0;
            while (i < n)
            {
                a = i;
                b = i;
                tot = 0;
                while (b < n)
                {
                    if (8 + tot + 2 + clen[b] + 2 * (b - a) <= db.usable) { tot = tot + clen[b]; b++; } else { break; };
                };
                if (b == a) { sq_pm_free(@pm); return 1; };
                if (b < n)
                {
                    // the separator is entry b; keep at least one entry for the next page
                    if (b + 1 >= n) { b--; if (b <= a) { sq_pm_free(@pm); return 1; }; };
                };
                pm.ncells = 0; pm.used = 0; pm.type = 10; pm.hsz = 8;
                for (k = a; k < b; k++) { sq_pm_insert(@pm, k - a, @cells[coff[k]], clen[k]); };
                pg = sq_alloc_page(db);
                if (pg == 0) { sq_pm_free(@pm); return 1; };
                if (sq_pm_write(db, pg, @pm, 0, b - a, 10, 0) != 0) { sq_pm_free(@pm); return 1; };
                nodes[nlevel] = pg;
                if (b < n) { sepi[nlevel] = b; i = b + 1; } else { sepi[nlevel] = 0 - 1; i = n; };
                nlevel++;
            };
            // upper levels
            while (nlevel > 1)
            {
                nk2 = 0;
                i = 0;
                while (i < nlevel)
                {
                    a = i;
                    b = i + 1;
                    tot = 0;
                    // node b-1 .. : the page holds nodes a..b-1 with cells for separators a..b-2
                    while (b < nlevel)
                    {
                        if (12 + tot + 2 + 4 + clen[sepi[b - 1]] + 2 * (b - 1 - a) <= db.usable) { tot = tot + 4 + clen[sepi[b - 1]]; b++; } else { break; };
                    };
                    if (b < nlevel)
                    {
                        // the separator after node b-1 goes up; keep at least two nodes for the next page
                        if (b + 1 >= nlevel) { b--; if (b - a < 2) { sq_pm_free(@pm); return 1; }; };
                    };
                    pm.ncells = 0; pm.used = 0; pm.type = 2; pm.hsz = 12;
                    for (k = a; k < b - 1; k++)
                    {
                        sq_put32(db.cbuf, nodes[k]);
                        for (t = 0; t < clen[sepi[k]]; t++) { db.cbuf[4 + t] = cells[coff[sepi[k]] + t]; };
                        sq_pm_insert(@pm, k - a, db.cbuf, 4 + clen[sepi[k]]);
                    };
                    pg = sq_alloc_page(db);
                    if (pg == 0) { sq_pm_free(@pm); return 1; };
                    if (sq_pm_write(db, pg, @pm, 0, b - 1 - a, 2, nodes[b - 1]) != 0) { sq_pm_free(@pm); return 1; };
                    nn[nk2] = pg;
                    if (b < nlevel) { sepn[nk2] = sepi[b - 1]; i = b; } else { sepn[nk2] = 0 - 1; i = nlevel; };
                    nk2++;
                };
                for (i = 0; i < nk2; i++) { nodes[i] = nn[i]; sepi[i] = sepn[i]; };
                nlevel = nk2;
            };
            // the single remaining page becomes the root
            pg = nodes[0];
            if (sq_pm_load(db, pg, @pm) != 0) { sq_pm_free(@pm); return 1; };
            rc = sq_pm_write(db, root, @pm, 0, pm.ncells, pm.type, pm.rightmost);
            sq_pm_free(@pm);
            if (rc != 0) { return 1; };
            if (sq_free_page(db, pg) != 0) { return 1; };
            ffree((u64)cells); ffree((u64)coff); ffree((u64)clen);
            ffree((u64)nodes); ffree((u64)sepi); ffree((u64)nn); ffree((u64)sepn);
            return 0;
        };

        // ---- small helpers ----

        def sq_ihas(byte* s, int n, byte* lit) -> bool
        {
            int i, m, k;
            m = 0;
            while (lit[m] != (byte)0) { m++; };
            for (i = 0; i + m <= n; i++)
            {
                k = 0;
                while (k < m)
                {
                    if (sq_lc(s[i + k]) != lit[k]) { break; };
                    k++;
                };
                if (k == m) { return true; };
            };
            return false;
        };

        // growable byte buffer
        struct SQ_SB
        {
            byte* p;
            int n, cap, err;
        };

        def sq_sb_init(SQ_SB* b) -> void
        {
            b.cap = 256;
            b.p = (byte*)fmalloc((u64)b.cap);
            b.n = 0;
            b.err = 0;
            if ((u64)b.p == (u64)0) { b.err = 1; b.cap = 0; } else { b.p[0] = (byte)0; };
        };

        def sq_sb_free(SQ_SB* b) -> void
        {
            if ((u64)b.p != (u64)0) { ffree((u64)b.p); b.p = (byte*)0; };
            b.n = 0; b.cap = 0;
        };

        def sq_sb_add(SQ_SB* b, byte* s, int n) -> void
        {
            byte* np;
            int i, cap;
            if (b.err != 0) { return; };
            if (b.n + n + 1 > b.cap)
            {
                cap = b.cap * 2;
                while (cap < b.n + n + 1) { cap = cap * 2; };
                np = (byte*)fmalloc((u64)cap);
                if ((u64)np == (u64)0) { b.err = 1; return; };
                for (i = 0; i < b.n; i++) { np[i] = b.p[i]; };
                ffree((u64)b.p);
                b.p = np;
                b.cap = cap;
            };
            for (i = 0; i < n; i++) { b.p[b.n + i] = s[i]; };
            b.n = b.n + n;
            b.p[b.n] = (byte)0;
        };

        def sq_sb_lit(SQ_SB* b, byte* s) -> void
        {
            sq_sb_add(b, s, sq_cstrlen(s));
        };

        // appends "text" as an identifier: quoted with double quotes when it is not a plain word
        def sq_sb_ident(SQ_SB* b, byte* s, int n) -> void
        {
            int i, plain;
            plain = 1;
            if (n == 0) { plain = 0; };
            for (i = 0; i < n; i++)
            {
                if (sq_isalpha(s[i]) == false & sq_isdigit(s[i]) == false) { plain = 0; };
            };
            if (n > 0) { if (sq_isdigit(s[0])) { plain = 0; }; };
            if (plain == 1) { sq_sb_add(b, s, n); return; };
            sq_sb_add(b, "\"\0", 1);
            for (i = 0; i < n; i++)
            {
                if (s[i] == (byte)34) { sq_sb_add(b, "\"\0", 1); };
                sq_sb_add(b, @s[i], 1);
            };
            sq_sb_add(b, "\"\0", 1);
        };

        // appends a signed number
        def sq_sb_int(SQ_SB* b, i64 v) -> void
        {
            byte[24] t;
            int n;
            u64 u;
            if (v < (i64)0)
            {
                sq_sb_add(b, "-\0", 1);
                u = (u64)0 - (u64)v;
            }
            else { u = (u64)v; };
            n = sq_utoa(u, @t[0]);
            sq_sb_add(b, @t[0], n);
        };

        // formats "<a><name><b>" into the statement error
        def sq_err_name(SQ_STMT* st, byte* a, byte* name, int nl, byte* b) -> void
        {
            SQ_SB sb;
            sq_sb_init(@sb);
            sq_sb_lit(@sb, a);
            sq_sb_add(@sb, name, nl);
            sq_sb_lit(@sb, b);
            if (sb.err == 0) { sq_seterr(st, sb.p); } else { sq_seterr(st, "out of memory\0"); };
            sq_sb_free(@sb);
        };

        // ---- table context ----

        struct SQ_TCTX
        {
            SQLITE_DB* db;
            SQ_STMT* st;
            int tpos, root, ncols, nix, seqroot;
            SQ_TI* ti;
            SQ_IDX[20] ix;
            int[20] dirty;
            SQ_ARENA ar;
            SQ_VAL[130] dv;
            SQ_VAL[130] nw;
            SQ_VAL[130] ol;
            SQ_VAL[20] kv;
            byte[64] tname;
            int onconf, keep_on_fail;
            // conflicting row found by a probe check (conflict action 6), and the rowids touched by the statement for RETURNING
            i64 cf_rid;
            int cf_ix;
            i64* rl;
            int rn, rcap, ras, rae;
        };

        def sq_tc_free(SQ_TCTX* tc) -> void
        {
            if ((u64)tc.ti != (u64)0) { ffree((u64)tc.ti); tc.ti = (SQ_TI*)0; };
            if ((u64)tc.rl != (u64)0) { ffree((u64)tc.rl); tc.rl = (i64*)0; };
            tc.rn = 0; tc.rcap = 0;
            sq_ar_free(@tc.ar);
        };

        // true when the name span equals the table name
        def sq_name_is(byte* a, int an, byte* b) -> bool
        {
            int i;
            for (i = 0; i < an; i++)
            {
                if (b[i] == (byte)0) { return false; };
                if (sq_lc(a[i]) != sq_lc(b[i])) { return false; };
            };
            return b[an] == (byte)0;
        };

        // locates a table, loads its description and indexes, and evaluates the column defaults
        def sq_tc_open(SQLITE_DB* db, SQ_STMT* st, byte* name, int nl, SQ_TCTX* tc) -> int
        {
            int i, k, c;
            byte* sql;
            tc.db = db; tc.st = st; tc.ti = (SQ_TI*)0; tc.nix = 0; tc.seqroot = 0; tc.onconf = 0; tc.keep_on_fail = 0;
            tc.rl = (i64*)0; tc.rn = 0; tc.rcap = 0; tc.ras = 0 - 1; tc.rae = 0 - 1; tc.cf_rid = (i64)0; tc.cf_ix = 0 - 1;
            sq_ar_init(@tc.ar);
            for (i = 0; i < db.nschema; i++)
            {
                if (db.schema[i].kind == 3 & sq_name_is(name, nl, @db.schema[i].name[0]))
                {
                    sq_err_name(st, "cannot modify \0", name, nl, " because it is a view\0");
                    return 1;
                };
            };
            tc.tpos = sq_find_table_n(db, name, nl);
            if (tc.tpos < 0) { sq_err_name(st, "no such table: \0", name, nl, "\0"); return 1; };
            sql = db.schema[tc.tpos].sql;
            if ((u64)sql == (u64)0) { sq_seterr(st, "cannot modify this table\0"); return 1; };
            for (k = 0; k < 64; k++) { tc.tname[k] = db.schema[tc.tpos].name[k]; };
            if (sq_ihas(sql, sq_cstrlen(sql), "without rowid\0")) { sq_seterr(st, "WITHOUT ROWID tables are not supported\0"); return 1; };
            if (sq_ihas(sql, 14, "create virtual\0")) { sq_seterr(st, "virtual tables are not supported\0"); return 1; };
            tc.ti = (SQ_TI*)fmalloc((u64)(sizeof(SQ_TI) / 8 + 4096));
            if ((u64)tc.ti == (u64)0) { sq_seterr(st, "out of memory\0"); return 1; };
            if (sq_ti_load(tc.ti, sql) != 0) { sq_seterr(st, "unsupported table definition (generated columns)\0"); return 1; };
            tc.ncols = tc.ti.ncols;
            tc.root = db.schema[tc.tpos].rootpage;
            for (i = 0; i < db.nschema; i++)
            {
                if (db.schema[i].kind == 4)
                {
                    if (sq_streq(@db.schema[i].tbl_name[0], @tc.tname[0])) { sq_seterr(st, "tables with triggers are not supported\0"); return 1; };
                };
            };
            tc.nix = sq_idx_list(db, tc.tpos, tc.ti, @tc.ix[0], 20);
            for (i = 0; i < tc.nix; i++)
            {
                tc.dirty[i] = 0;
                if (tc.ix[i].ok == 0) { sq_seterr(st, "tables with expression or partial indexes are not supported\0"); return 1; };
                tc.ix[i].coll[tc.ix[i].nk] = 0;
                tc.ix[i].desc[tc.ix[i].nk] = 0;
            };
            // sqlite_sequence for AUTOINCREMENT
            if (tc.ti.autoinc == 1)
            {
                k = sq_find_table_n(db, "sqlite_sequence\0", 15);
                if (k >= 0) { tc.seqroot = db.schema[k].rootpage; };
            };
            // defaults
            for (c = 0; c < tc.ncols; c++)
            {
                sq_val_null(@tc.dv[c]);
                if (tc.ti.dfl[c] > 0)
                {
                    if (sq_eval_text(db, @tc.ti.base[tc.ti.dfs[c]], tc.ti.dfl[c], @tc.ar, @tc.dv[c]) != 0)
                    {
                        sq_seterr(st, "cannot evaluate a column default\0");
                        return 1;
                    };
                    sq_apply_aff(@tc.ar, tc.ti.aff[c], @tc.dv[c]);
                };
            };
            return 0;
        };

        // copies the row under the cursor into out[0..ncols] (rowid last) with text owned by ar
        def sq_tc_row(SQ_TCTX* tc, SQ_CURSOR* cur, SQ_ARENA* ar, SQ_VAL* out) -> void
        {
            SQ_TI* ti = tc.ti;
            int c, k;
            byte* p;
            for (c = 0; c < tc.ncols; c++)
            {
                if (c == ti.ipk) { sq_val_int(@out[c], cur.rowid); continue; };
                if (c >= cur.ncols)
                {
                    sq_val_copy(@out[c], @tc.dv[c]);
                    continue;
                };
                k = sq_col_type(cur, c);
                if (k == SQ_INTEGER)
                {
                    if (ti.aff[c] == 4) { sq_val_real(@out[c], (double)sq_col_int(cur, c)); }
                    else { sq_val_int(@out[c], sq_col_int(cur, c)); };
                    continue;
                };
                if (k == SQ_REAL) { sq_val_real(@out[c], sq_col_real(cur, c)); continue; };
                if (k == SQ_TEXT | k == SQ_BLOB)
                {
                    out[c].t = k; out[c].n = sq_col_bytes(cur, c); out[c].i = (i64)0; out[c].r = 0.0;
                    p = sq_ar_copy(ar, sq_col_ptr(cur, c), out[c].n);
                    if ((u64)p == (u64)0) { sq_val_null(@out[c]); } else { out[c].p = p; };
                    continue;
                };
                sq_val_null(@out[c]);
            };
            sq_val_int(@out[tc.ncols], cur.rowid);
        };

        // key values of an index entry for a row (vals has ncols + 1 entries, the last one is the rowid)
        def sq_tc_key(SQ_TCTX* tc, SQ_IDX* ix, SQ_VAL* vals, SQ_VAL* key) -> void
        {
            int k, c;
            for (k = 0; k < ix.nk; k++)
            {
                c = ix.col[k];
                if (c >= tc.ncols) { sq_val_copy(@key[k], @vals[tc.ncols]); }
                else { sq_val_copy(@key[k], @vals[c]); };
            };
            sq_val_copy(@key[ix.nk], @vals[tc.ncols]);
        };

        // serialises a row into a freshly allocated record (the rowid alias column is stored as NULL)
        def sq_tc_record(SQ_TCTX* tc, SQ_VAL* vals, byte** outp, int* outn) -> int
        {
            SQ_VAL save;
            int ipk, sz;
            byte* rec;
            ipk = tc.ti.ipk;
            if (ipk >= 0)
            {
                sq_val_copy(@save, @vals[ipk]);
                sq_val_null(@vals[ipk]);
            };
            sz = sq_rec_size(vals, tc.ncols);
            rec = (byte*)fmalloc((u64)(sz + 8));
            if ((u64)rec == (u64)0)
            {
                if (ipk >= 0) { sq_val_copy(@vals[ipk], @save); };
                return 1;
            };
            sq_rec_write(vals, tc.ncols, rec);
            if (ipk >= 0) { sq_val_copy(@vals[ipk], @save); };
            *outp = rec;
            *outn = sz;
            return 0;
        };

        // true when two values are stored identically
        def sq_val_same(SQ_VAL* a, SQ_VAL* b) -> bool
        {
            int i;
            if (a.t != b.t) { return false; };
            if (a.t == SQ_NULL) { return true; };
            if (a.t == SQ_INTEGER) { return a.i == b.i; };
            if (a.t == SQ_REAL) { return a.r == b.r; };
            if (a.n != b.n) { return false; };
            for (i = 0; i < a.n; i++) { if (a.p[i] != b.p[i]) { return false; }; };
            return true;
        };

        // ---- rebuilding an index from its table ----

        def sq_tc_rebuild(SQ_TCTX* tc, SQ_IDX* ix) -> int
        {
            SQLITE_DB* db = tc.db;
            SQ_CURSOR cur;
            SQ_SORTIX so;
            SQ_ARENA ar;
            SQ_VAL* row;
            SQ_VAL[20] key;
            byte* rec;
            byte* nr;
            int* perm;
            int* noff;
            int* nlen;
            int rn, ok, cap, rcap, used, i, rc, k, hasnull;
            row = (SQ_VAL*)fmalloc((u64)(tc.ncols + 2) * (u64)sizeof(SQ_VAL));
            if ((u64)row == (u64)0) { return 1; };
            if (sq_tree_free(db, ix.root, 1, 10, 0) != 0) { ffree((u64)row); return 1; };
            sq_ar_init(@ar);
            cap = 1 << 16;
            rcap = 1024;
            rec = (byte*)fmalloc((u64)cap);
            so.off = (int*)fmalloc((u64)rcap * (u64)4);
            so.len = (int*)fmalloc((u64)rcap * (u64)4);
            if ((u64)rec == (u64)0 | (u64)so.off == (u64)0 | (u64)so.len == (u64)0) { ffree((u64)row); return 1; };
            so.n = 0;
            used = 0;
            sq_cur_open(@cur, db, tc.root);
            ok = sq_cur_first(@cur);
            while (ok == 1)
            {
                sq_ar_reset(@ar);
                sq_tc_row(tc, @cur, @ar, row);
                sq_tc_key(tc, ix, row, @key[0]);
                rn = sq_rec_size(@key[0], ix.nk + 1);
                if (used + rn + 8 > cap)
                {
                    nr = (byte*)fmalloc((u64)(cap * 2 + rn));
                    if ((u64)nr == (u64)0) { sq_cur_close(@cur); return 1; };
                    for (i = 0; i < used; i++) { nr[i] = rec[i]; };
                    ffree((u64)rec);
                    rec = nr;
                    cap = cap * 2 + rn;
                };
                if (so.n >= rcap)
                {
                    noff = (int*)fmalloc((u64)rcap * (u64)8);
                    nlen = (int*)fmalloc((u64)rcap * (u64)8);
                    if ((u64)noff == (u64)0 | (u64)nlen == (u64)0) { sq_cur_close(@cur); return 1; };
                    for (i = 0; i < so.n; i++) { noff[i] = so.off[i]; nlen[i] = so.len[i]; };
                    ffree((u64)so.off); ffree((u64)so.len);
                    so.off = noff; so.len = nlen;
                    rcap = rcap * 2;
                };
                sq_rec_write(@key[0], ix.nk + 1, @rec[used]);
                so.off[so.n] = used;
                so.len[so.n] = rn;
                so.n++;
                used = used + rn;
                ok = sq_cur_next(@cur);
            };
            sq_cur_close(@cur);
            sq_ar_free(@ar);
            ffree((u64)row);
            if (ok < 0) { return 1; };
            so.ix = ix;
            so.recs = rec;
            perm = (int*)fmalloc((u64)(so.n + 1) * (u64)4);
            if ((u64)perm == (u64)0) { return 1; };
            if (sq_sortix_run(@so, perm) != 0) { return 1; };
            // unique indexes must not hold equal non-NULL keys
            if (ix.unique == 1)
            {
                for (i = 1; i < so.n; i++)
                {
                    k = sq_rec_decode(@rec[so.off[perm[i - 1]]], so.len[perm[i - 1]], @so.va[0], 18);
                    rc = sq_rec_decode(@rec[so.off[perm[i]]], so.len[perm[i]], @so.vb[0], 18);
                    hasnull = 0;
                    for (k = 0; k < ix.nk; k++) { if (so.va[k].t == SQ_NULL) { hasnull = 1; }; };
                    if (hasnull == 0)
                    {
                        if (sq_icmp(ix, @so.va[0], ix.nk, @so.vb[0], ix.nk) == 0)
                        {
                            ffree((u64)perm); ffree((u64)rec); ffree((u64)so.off); ffree((u64)so.len);
                            return 4;
                        };
                    };
                };
            };
            rc = sq_ix_bulk(db, ix, @so, perm);
            ffree((u64)perm); ffree((u64)rec); ffree((u64)so.off); ffree((u64)so.len);
            return rc;
        };

        // ---- sqlite_master ----

        // appends a row to sqlite_master
        def sq_master_add(SQLITE_DB* db, byte* type, byte* name, byte* tbl, int rootpage, byte* sql) -> int
        {
            SQ_VAL[5] vals;
            byte* rec;
            int size, rc;
            i64 mx;
            vals[0].t = SQ_TEXT; vals[0].p = type; vals[0].n = sq_cstrlen(type); vals[0].i = (i64)0; vals[0].r = 0.0;
            vals[1].t = SQ_TEXT; vals[1].p = name; vals[1].n = sq_cstrlen(name); vals[1].i = (i64)0; vals[1].r = 0.0;
            vals[2].t = SQ_TEXT; vals[2].p = tbl; vals[2].n = sq_cstrlen(tbl); vals[2].i = (i64)0; vals[2].r = 0.0;
            sq_val_int(@vals[3], (i64)rootpage);
            if ((u64)sql == (u64)0) { sq_val_null(@vals[4]); }
            else { vals[4].t = SQ_TEXT; vals[4].p = sql; vals[4].n = sq_cstrlen(sql); vals[4].i = (i64)0; vals[4].r = 0.0; };
            size = sq_rec_size(@vals[0], 5);
            rec = (byte*)fmalloc((u64)(size + 8));
            if ((u64)rec == (u64)0) { return 1; };
            sq_rec_write(@vals[0], 5, rec);
            if (sq_max_rowid(db, 1, @mx) != 0) { ffree((u64)rec); return 1; };
            rc = sq_btree_insert(db, 1, mx + (i64)1, rec, size);
            ffree((u64)rec);
            if (rc != 0) { return 1; };
            db.cookie = db.cookie + 1;
            return 0;
        };

        // rowid of the sqlite_master row with the given name and type (-1 when absent)
        def sq_master_find(SQLITE_DB* db, byte* name, int nl, byte* type) -> i64
        {
            SQ_CURSOR cur;
            byte[160] t;
            byte[16] ty;
            int ok, ln;
            i64 rid;
            rid = (i64)0 - (i64)1;
            sq_cur_open(@cur, db, 1);
            ok = sq_cur_first(@cur);
            while (ok == 1)
            {
                if (sq_col_count(@cur) >= 5)
                {
                    sq_col_text(@cur, 1, @t[0], 160);
                    sq_col_text(@cur, 0, @ty[0], 16);
                    if (sq_name_is(name, nl, @t[0]) & sq_streq(@ty[0], type)) { rid = cur.rowid; break; };
                };
                ok = sq_cur_next(@cur);
            };
            sq_cur_close(@cur);
            return rid;
        };

        // rewrites one sqlite_master row (same rowid) with new values
        def sq_master_replace(SQLITE_DB* db, i64 rowid, byte* type, byte* name, byte* tbl, int rootpage, byte* sql) -> int
        {
            if (sq_btree_delete(db, 1, rowid) != 0) { return 1; };
            SQ_VAL[5] vals;
            byte* rec;
            int size, rc;
            vals[0].t = SQ_TEXT; vals[0].p = type; vals[0].n = sq_cstrlen(type); vals[0].i = (i64)0; vals[0].r = 0.0;
            vals[1].t = SQ_TEXT; vals[1].p = name; vals[1].n = sq_cstrlen(name); vals[1].i = (i64)0; vals[1].r = 0.0;
            vals[2].t = SQ_TEXT; vals[2].p = tbl; vals[2].n = sq_cstrlen(tbl); vals[2].i = (i64)0; vals[2].r = 0.0;
            sq_val_int(@vals[3], (i64)rootpage);
            if ((u64)sql == (u64)0) { sq_val_null(@vals[4]); }
            else { vals[4].t = SQ_TEXT; vals[4].p = sql; vals[4].n = sq_cstrlen(sql); vals[4].i = (i64)0; vals[4].r = 0.0; };
            size = sq_rec_size(@vals[0], 5);
            rec = (byte*)fmalloc((u64)(size + 8));
            if ((u64)rec == (u64)0) { return 1; };
            sq_rec_write(@vals[0], 5, rec);
            rc = sq_btree_insert(db, 1, rowid, rec, size);
            ffree((u64)rec);
            if (rc != 0) { return 1; };
            db.cookie = db.cookie + 1;
            return 0;
        };
        // true when the text contains the keyword outside quotes and parentheses at depth 0 (rough scan for unsupported clauses)
        def sq_find_kw_in(byte* s, int n, byte* kw) -> bool
        {
            int i, m, k, depth;
            byte q;
            m = sq_cstrlen(kw);
            depth = 0;
            i = 0;
            while (i < n)
            {
                if (s[i] == (byte)39 | s[i] == (byte)34 | s[i] == (byte)96)
                {
                    q = s[i];
                    i++;
                    while (i < n & s[i] != q) { i++; };
                    i++;
                    continue;
                };
                if (s[i] == (byte)40) { depth++; };
                if (s[i] == (byte)41) { depth--; };
                if (depth == 0 & i + m <= n)
                {
                    k = 0;
                    while (k < m)
                    {
                        if (sq_lc(s[i + k]) != kw[k]) { break; };
                        k++;
                    };
                    if (k == m)
                    {
                        if (i == 0) { return true; };
                        if (sq_isalpha(s[i - 1]) == false & sq_isdigit(s[i - 1]) == false) { return true; };
                    };
                };
                i++;
            };
            return false;
        };


        // ---- CHECK constraints ----

        struct SQ_CHK
        {
            SQ_STMT* st;
            int n;
            int[40] cs, cl;
        };

        def sq_chk_open(SQ_TCTX* tc, SQ_CHK* chk) -> int
        {
            SQ_TI* ti = tc.ti;
            SQ_SB sb;
            int c, i, rc;
            chk.st = (SQ_STMT*)0;
            chk.n = 0;
            for (c = 0; c < tc.ncols; c++)
            {
                if (ti.chl[c] > 0 & chk.n < 40) { chk.cs[chk.n] = ti.chs[c]; chk.cl[chk.n] = ti.chl[c]; chk.n++; };
            };
            for (i = 0; i < ti.nchk; i++)
            {
                if (chk.n < 40) { chk.cs[chk.n] = ti.ks[i]; chk.cl[chk.n] = ti.kl[i]; chk.n++; };
            };
            if (chk.n == 0) { return 0; };
            if (tc.ncols > 60) { sq_seterr(tc.st, "CHECK constraints on tables with more than 60 columns are not supported\0"); return 1; };
            sq_sb_init(@sb);
            sq_sb_lit(@sb, "select \0");
            for (i = 0; i < chk.n; i++)
            {
                if (i > 0) { sq_sb_lit(@sb, ", \0"); };
                sq_sb_lit(@sb, "(\0");
                sq_sb_add(@sb, @ti.base[chk.cs[i]], chk.cl[i]);
                sq_sb_lit(@sb, ")\0");
            };
            sq_sb_lit(@sb, " from (select \0");
            for (c = 0; c < tc.ncols; c++)
            {
                if (c > 0) { sq_sb_lit(@sb, ", \0"); };
                sq_sb_lit(@sb, "?\0");
                sq_sb_int(@sb, (i64)(c + 1));
                sq_sb_lit(@sb, " as \0");
                sq_sb_ident(@sb, @ti.base[ti.cs[c]], ti.cl[c]);
            };
            sq_sb_lit(@sb, ")\0");
            if (sb.err != 0) { sq_sb_free(@sb); return 1; };
            chk.st = sq_stmt_new();
            if ((u64)chk.st == (u64)0) { sq_sb_free(@sb); return 1; };
            rc = sq_prep_query(chk.st, tc.db, sb.p);
            sq_sb_free(@sb);
            if (rc != 0)
            {
                sq_seterr(tc.st, @chk.st.err[0]);
                sq_stmt_del(chk.st);
                chk.st = (SQ_STMT*)0;
                return 1;
            };
            return 0;
        };

        def sq_chk_close(SQ_CHK* chk) -> void
        {
            if ((u64)chk.st != (u64)0) { sq_stmt_del(chk.st); chk.st = (SQ_STMT*)0; };
        };

        // 0 when every CHECK holds (NULL counts as holding), 1 on a failure (message set)
        def sq_chk_run(SQ_TCTX* tc, SQ_CHK* chk, SQ_VAL* vals) -> int
        {
            SQ_VAL* v;
            int c, i, r;
            SQ_SB sb;
            if ((u64)chk.st == (u64)0) { return 0; };
            sq_reset(chk.st);
            sq_params_reset(chk.st);
            for (c = 0; c < tc.ncols; c++)
            {
                v = @vals[c];
                if (v.t == SQ_NULL) { sq_bind_null(chk.st, c + 1); };
                if (v.t == SQ_INTEGER) { sq_bind_int(chk.st, c + 1, v.i); };
                if (v.t == SQ_REAL) { sq_bind_real(chk.st, c + 1, v.r); };
                if (v.t == SQ_TEXT) { sq_bind_text(chk.st, c + 1, v.p, v.n); };
                if (v.t == SQ_BLOB) { sq_bind_blob(chk.st, c + 1, v.p, v.n); };
            };
            r = sq_step_query(chk.st);
            if (r != 1) { sq_seterr(tc.st, @chk.st.err[0]); if (chk.st.err[0] == (byte)0) { sq_seterr(tc.st, "CHECK evaluation failed\0"); }; return 1; };
            for (i = 0; i < chk.n; i++)
            {
                if (sq_truth(sq_cell(chk.st, i)) == 0)
                {
                    sq_sb_init(@sb);
                    sq_sb_lit(@sb, "CHECK constraint failed: \0");
                    sq_sb_add(@sb, @tc.ti.base[chk.cs[i]], chk.cl[i]);
                    sq_seterr(tc.st, sb.p);
                    sq_sb_free(@sb);
                    return 1;
                };
            };
            return 0;
        };

        // ---- row level operations ----

        // loads the row with the given rowid into vals (text owned by ar). 1 found, 0 absent, -1 error.
        def sq_tc_fetch(SQ_TCTX* tc, i64 rowid, SQ_ARENA* ar, SQ_VAL* vals) -> int
        {
            SQ_CURSOR cur;
            int r;
            sq_cur_open(@cur, tc.db, tc.root);
            r = sq_cur_seek(@cur, rowid);
            if (r == 1) { sq_tc_row(tc, @cur, ar, vals); };
            sq_cur_close(@cur);
            return r;
        };

        def sq_tc_exists(SQ_TCTX* tc, i64 rowid) -> int
        {
            SQ_CURSOR cur;
            int r;
            sq_cur_open(@cur, tc.db, tc.root);
            r = sq_cur_seek(@cur, rowid);
            sq_cur_close(@cur);
            return r;
        };

        // brings a dirty index back in step with the table
        def sq_tc_clean(SQ_TCTX* tc, int i) -> int
        {
            int rc;
            if (tc.dirty[i] == 0) { return 0; };
            rc = sq_tc_rebuild(tc, @tc.ix[i]);
            if (rc != 0) { return 1; };
            tc.dirty[i] = 0;
            return 0;
        };

        // removes a row (given by its current values) from the indexes and the table
        def sq_tc_remove(SQ_TCTX* tc, i64 rowid, SQ_VAL* vals) -> int
        {
            int i, r;
            for (i = 0; i < tc.nix; i++)
            {
                if (tc.dirty[i] == 1) { continue; };
                sq_tc_key(tc, @tc.ix[i], vals, @tc.kv[0]);
                r = sq_ix_delete(tc.db, @tc.ix[i], @tc.kv[0]);
                if (r == 3) { tc.dirty[i] = 1; continue; };
                if (r == 2) { sq_seterr(tc.st, "index maintenance failed\0"); return 1; };
            };
            r = sq_btree_delete(tc.db, tc.root, rowid);
            if (r == 2) { sq_seterr(tc.st, "table delete failed\0"); return 1; };
            return 0;
        };

        // deletes the row with the given rowid (REPLACE conflict resolution)
        def sq_tc_remove_id(SQ_TCTX* tc, i64 rowid) -> int
        {
            SQ_VAL* vals;
            SQ_ARENA ar;
            int r, rc;
            vals = (SQ_VAL*)fmalloc((u64)(tc.ncols + 2) * (u64)sizeof(SQ_VAL));
            if ((u64)vals == (u64)0) { return 1; };
            sq_ar_init(@ar);
            r = sq_tc_fetch(tc, rowid, @ar, vals);
            rc = 0;
            if (r == 1) { rc = sq_tc_remove(tc, rowid, vals); };
            if (r < 0) { rc = 1; };
            sq_ar_free(@ar);
            ffree((u64)vals);
            return rc;
        };

        // writes a new row into the table and the indexes
        def sq_tc_put(SQ_TCTX* tc, i64 rowid, SQ_VAL* vals) -> int
        {
            byte* rec;
            int rn, i, r;
            if (sq_tc_record(tc, vals, @rec, @rn) != 0) { sq_seterr(tc.st, "out of memory\0"); return 1; };
            r = sq_btree_insert(tc.db, tc.root, rowid, rec, rn);
            ffree((u64)rec);
            if (r != 0) { sq_seterr(tc.st, "table insert failed\0"); return 1; };
            for (i = 0; i < tc.nix; i++)
            {
                if (tc.dirty[i] == 1) { continue; };
                sq_tc_key(tc, @tc.ix[i], vals, @tc.kv[0]);
                r = sq_ix_insert(tc.db, @tc.ix[i], @tc.kv[0]);
                if (r != 0) { sq_seterr(tc.st, "index insert failed\0"); return 1; };
            };
            return 0;
        };

        // builds "UNIQUE constraint failed: t.a, t.b"
        def sq_err_unique(SQ_TCTX* tc, SQ_IDX* ix, int isrowid) -> void
        {
            SQ_SB sb;
            int k, c;
            sq_sb_init(@sb);
            sq_sb_lit(@sb, "UNIQUE constraint failed: \0");
            if (isrowid == 1)
            {
                sq_sb_lit(@sb, @tc.tname[0]);
                sq_sb_lit(@sb, ".\0");
                if (tc.ti.ipk >= 0) { sq_sb_add(@sb, @tc.ti.base[tc.ti.cs[tc.ti.ipk]], tc.ti.cl[tc.ti.ipk]); }
                else { sq_sb_lit(@sb, "rowid\0"); };
            }
            else
            {
                for (k = 0; k < ix.nk; k++)
                {
                    if (k > 0) { sq_sb_lit(@sb, ", \0"); };
                    sq_sb_lit(@sb, @tc.tname[0]);
                    sq_sb_lit(@sb, ".\0");
                    c = ix.col[k];
                    if (c < tc.ncols) { sq_sb_add(@sb, @tc.ti.base[tc.ti.cs[c]], tc.ti.cl[c]); } else { sq_sb_lit(@sb, "rowid\0"); };
                };
            };
            sq_seterr(tc.st, sb.p);
            sq_sb_free(@sb);
        };

        // Runs the constraint checks for a row about to be stored. own is the rowid of the row being replaced by an UPDATE
        // (hasown 1) so it does not conflict with itself. Returns 0 to go on, 1 on an error, 5 when the row is skipped (IGNORE).
        def sq_tc_check_in(SQ_TCTX* tc, SQ_CHK* chk, SQ_VAL* nw, i64 rowid, int hasown, i64 own, int onconf) -> int
        {
            SQ_TI* ti = tc.ti;
            SQ_ICUR cu;
            SQ_IDX* ix;
            SQ_CURSOR cur;
            SQ_SB sb;
            int c, i, k, r, hasnull;
            i64 other;
            for (c = 0; c < tc.ncols; c++)
            {
                if (c == ti.ipk) { continue; };
                if (nw[c].t == SQ_NULL & ti.notnull[c] == 1)
                {
                    if (onconf == 3) { return 5; };
                    if (onconf == 4 & tc.dv[c].t != SQ_NULL) { sq_val_copy(@nw[c], @tc.dv[c]); continue; };
                    sq_sb_init(@sb);
                    sq_sb_lit(@sb, "NOT NULL constraint failed: \0");
                    sq_sb_lit(@sb, @tc.tname[0]);
                    sq_sb_lit(@sb, ".\0");
                    sq_sb_add(@sb, @ti.base[ti.cs[c]], ti.cl[c]);
                    sq_seterr(tc.st, sb.p);
                    sq_sb_free(@sb);
                    return 1;
                };
            };
            if (chk.n > 0)
            {
                if (sq_chk_run(tc, chk, nw) != 0)
                {
                    if (onconf == 3) { tc.st.err[0] = (byte)0; return 5; };
                    return 1;
                };
            };
            // rowid
            sq_cur_open(@cur, tc.db, tc.root);
            r = sq_cur_seek(@cur, rowid);
            sq_cur_close(@cur);
            if (r < 0) { sq_seterr(tc.st, "read error\0"); return 1; };
            if (r == 1)
            {
                if (hasown == 0 | rowid != own)
                {
                    if (onconf == 3) { return 5; };
                    if (onconf == 6) { tc.cf_rid = rowid; tc.cf_ix = 0 - 1; return 6; };
                    if (onconf == 4)
                    {
                        if (sq_tc_remove_id(tc, rowid) != 0) { return 1; };
                    }
                    else { sq_err_unique(tc, (SQ_IDX*)0, 1); return 1; };
                };
            };
            for (i = 0; i < tc.nix; i++)
            {
                ix = @tc.ix[i];
                if (ix.unique == 0) { continue; };
                sq_tc_key(tc, ix, nw, @tc.kv[0]);
                hasnull = 0;
                for (k = 0; k < ix.nk; k++) { if (tc.kv[k].t == SQ_NULL) { hasnull = 1; }; };
                if (hasnull == 1) { continue; };
                if (sq_tc_clean(tc, i) != 0) { sq_seterr(tc.st, "index rebuild failed\0"); return 1; };
                sq_icur_open(@cu, tc.db, ix);
                r = sq_icur_seek(@cu, @tc.kv[0], ix.nk, 0);
                other = (i64)0 - (i64)1;
                if (r < 0) { sq_icur_close(@cu); sq_seterr(tc.st, "index read error\0"); return 1; };
                if (r == 1)
                {
                    if (sq_icmp(ix, @cu.v[0], cu.nv, @tc.kv[0], ix.nk) == 0) { other = sq_icur_rowid(@cu); };
                };
                sq_icur_close(@cu);
                if (other != (i64)0 - (i64)1)
                {
                    if (hasown == 1 & other == own) { continue; };
                    if (onconf == 3) { return 5; };
                    if (onconf == 6) { tc.cf_rid = other; tc.cf_ix = i; return 6; };
                    if (onconf == 4)
                    {
                        if (sq_tc_remove_id(tc, other) != 0) { return 1; };
                        continue;
                    };
                    sq_err_unique(tc, ix, 0);
                    return 1;
                };
            };
            return 0;
        };

        // constraint failures remember the conflict action so the caller can apply ROLLBACK or FAIL semantics
        def sq_tc_check(SQ_TCTX* tc, SQ_CHK* chk, SQ_VAL* nw, i64 rowid, int hasown, i64 own, int onconf) -> int
        {
            int r = sq_tc_check_in(tc, chk, nw, rowid, hasown, own, onconf);
            if (r == 1) { tc.st.pad = onconf; };
            return r;
        };

        // applies the column affinities to a new row
        def sq_tc_affinity(SQ_TCTX* tc, SQ_VAL* nw) -> void
        {
            int c;
            for (c = 0; c < tc.ncols; c++)
            {
                if (c == tc.ti.ipk) { continue; };
                sq_apply_aff(@tc.ar, tc.ti.aff[c], @nw[c]);
            };
        };

        // ---- AUTOINCREMENT bookkeeping ----

        // current sqlite_sequence value of the table (0 when there is none); *rowid gets the row's rowid or -1
        def sq_seq_read(SQ_TCTX* tc, i64* rowid) -> i64
        {
            SQ_CURSOR cur;
            byte[160] nm;
            int ok;
            i64 v;
            v = (i64)0;
            *rowid = (i64)0 - (i64)1;
            if (tc.seqroot == 0) { return v; };
            sq_cur_open(@cur, tc.db, tc.seqroot);
            ok = sq_cur_first(@cur);
            while (ok == 1)
            {
                if (sq_col_count(@cur) >= 2)
                {
                    sq_col_text(@cur, 0, @nm[0], 160);
                    if (sq_streq(@nm[0], @tc.tname[0]))
                    {
                        v = sq_col_int(@cur, 1);
                        *rowid = cur.rowid;
                        break;
                    };
                };
                ok = sq_cur_next(@cur);
            };
            sq_cur_close(@cur);
            return v;
        };

        def sq_seq_write(SQ_TCTX* tc, i64 seq) -> int
        {
            SQ_VAL[2] vals;
            byte* rec;
            int rn, r;
            i64 rid, old;
            if (tc.seqroot == 0) { return 0; };
            old = sq_seq_read(tc, @rid);
            vals[0].t = SQ_TEXT; vals[0].p = @tc.tname[0]; vals[0].n = sq_cstrlen(@tc.tname[0]); vals[0].i = (i64)0; vals[0].r = 0.0;
            sq_val_int(@vals[1], seq);
            rn = sq_rec_size(@vals[0], 2);
            rec = (byte*)fmalloc((u64)(rn + 8));
            if ((u64)rec == (u64)0) { return 1; };
            sq_rec_write(@vals[0], 2, rec);
            if (rid >= (i64)0)
            {
                if (sq_btree_delete(tc.db, tc.seqroot, rid) != 0) { ffree((u64)rec); return 1; };
            }
            else
            {
                if (sq_max_rowid(tc.db, tc.seqroot, @rid) != 0) { ffree((u64)rec); return 1; };
                rid = rid + (i64)1;
            };
            r = sq_btree_insert(tc.db, tc.seqroot, rid, rec, rn);
            ffree((u64)rec);
            if (r != 0) { return 1; };
            return 0;
        };

        // ---- statement helpers ----

        // text of the current token as it appears in the statement
        def sq_tok_start(SQ_STMT* st) -> int
        {
            if (st.tk == 4) { return st.ts - 1; };
            if (st.tk == 1 & st.tq == 1) { return st.ts - 1; };
            if (st.tk == 6) { return st.ts - 2; };
            return st.ts;
        };

        // advances over one expression and returns its end offset; stops at a top level comma, an unmatched closing
        // parenthesis, a semicolon, the end, or one of the clause keywords of the statement
        def sq_skip_expr(SQ_STMT* st, int stopkw) -> int
        {
            int depth, e;
            depth = 0;
            e = st.prevend;
            while (st.tk != 0)
            {
                if (st.tk == 5)
                {
                    if (st.tcode == 40) { depth++; };
                    if (st.tcode == 41) { if (depth == 0) { break; }; depth--; };
                    if (st.tcode == 44 & depth == 0) { break; };
                    if (st.tcode == 59 & depth == 0) { break; };
                };
                if (depth == 0 & stopkw == 1)
                {
                    if (sq_is_kw(st, "where\0") | sq_is_kw(st, "from\0") | sq_is_kw(st, "returning\0") | sq_is_kw(st, "order\0") | sq_is_kw(st, "limit\0")) { break; };
                };
                e = st.tend;
                sq_next(st);
            };
            return e;
        };

        // positions the statement lexer at the start of a text region and reads the first token
        def sq_rewind(SQ_STMT* st, int pos) -> void
        {
            st.pos = pos;
            st.tend = pos;
            st.prevend = pos;
            sq_next(st);
        };

        // Runs the SELECT in text. The returned statement holds the rows; the caller releases it with sq_stmt_del.
        def sq_run_rows(SQLITE_DB* db, SQ_STMT* owner, byte* text) -> SQ_STMT*
        {
            SQ_STMT* sub;
            int k;
            sub = sq_stmt_new();
            if ((u64)sub == (u64)0) { sq_seterr(owner, "out of memory\0"); return sub; };
            if (sq_prep_query(sub, db, text) != 0)
            {
                sq_seterr(owner, @sub.err[0]);
                sq_stmt_del(sub);
                return (SQ_STMT*)0;
            };
            for (k = 0; k < 64; k++) { sq_val_copy(@sub.pv[k], @owner.pv[k]); };
            sub.state = 0;
            sub.res = sq_run_block(sub, sub.root_blk, 0 - 1);
            if ((u64)sub.res == (u64)0)
            {
                sq_seterr(owner, @sub.err[0]);
                sq_stmt_del(sub);
                return (SQ_STMT*)0;
            };
            return sub;
        };

        // ---- RETURNING and upsert support ----

        // position of the first top-level occurrence of the words in kw (single spaces match any run of blanks), or -1
        def sq_find_top(byte* s, int n, byte* kw) -> int
        {
            int i, m, k, j, depth;
            byte q;
            m = sq_cstrlen(kw);
            depth = 0;
            i = 0;
            while (i < n)
            {
                if (s[i] == (byte)39 | s[i] == (byte)34 | s[i] == (byte)96)
                {
                    q = s[i];
                    i++;
                    while (i < n & s[i] != q) { i++; };
                    i++;
                    continue;
                };
                if (s[i] == (byte)45 & i + 1 < n)
                {
                    if (s[i + 1] == (byte)45)
                    {
                        while (i < n & s[i] != (byte)10) { i++; };
                        continue;
                    };
                };
                if (s[i] == (byte)40) { depth++; };
                if (s[i] == (byte)41) { depth--; };
                if (depth == 0)
                {
                    if (i == 0) { j = 1; } else { j = 0; if (sq_isalpha(s[i - 1]) == false & sq_isdigit(s[i - 1]) == false & s[i - 1] != (byte)95) { j = 1; }; };
                    if (j == 1)
                    {
                        k = 0;
                        j = i;
                        while (k < m)
                        {
                            if (kw[k] == (byte)32)
                            {
                                if (j >= n) { break; };
                                if (s[j] != (byte)32 & s[j] != (byte)9 & s[j] != (byte)10 & s[j] != (byte)13) { break; };
                                while (j < n & (s[j] == (byte)32 | s[j] == (byte)9 | s[j] == (byte)10 | s[j] == (byte)13)) { j++; };
                                k++;
                                continue;
                            };
                            if (j >= n) { break; };
                            if (sq_lc(s[j]) != kw[k]) { break; };
                            j++;
                            k++;
                        };
                        if (k == m)
                        {
                            if (j >= n) { return i; };
                            if (sq_isalpha(s[j]) == false & sq_isdigit(s[j]) == false & s[j] != (byte)95) { return i; };
                        };
                    };
                };
                i++;
            };
            return 0 - 1;
        };

        // Splits off a trailing RETURNING clause: st.ret_s / st.ret_e become the span of the returned expression list and the
        // lexer limit moves in front of the clause. Returns the position where the clause began or -1.
        def sq_cut_returning(SQ_STMT* st) -> int
        {
            int e, p;
            e = st.lim;
            while (e > 0)
            {
                if (st.sql[e - 1] == (byte)32 | st.sql[e - 1] == (byte)9 | st.sql[e - 1] == (byte)10 | st.sql[e - 1] == (byte)13 | st.sql[e - 1] == (byte)59) { e--; } else { break; };
            };
            p = sq_find_top(@st.sql[0], e, "returning\0");
            st.ret_s = 0 - 1;
            st.ret_e = 0 - 1;
            if (p < 0) { st.lim = e; return 0 - 1; };
            st.ret_s = p + 9;
            st.ret_e = e;
            st.lim = p;
            return p;
        };

        // Prepares the RETURNING output: the column layout and an empty result. alias is the table alias span or -1.
        def sq_ret_begin(SQ_STMT* st, SQ_TCTX* tc, int as_s, int as_e) -> int
        {
            SQ_SB sb;
            SQ_STMT* sub;
            int nc, rc;
            if (st.ret_s < 0) { return 0; };
            tc.ras = as_s;
            tc.rae = as_e;
            sq_sb_init(@sb);
            sq_sb_lit(@sb, "select \0");
            sq_sb_add(@sb, @st.sql[st.ret_s], st.ret_e - st.ret_s);
            sq_sb_lit(@sb, " from \0");
            sq_sb_ident(@sb, @tc.tname[0], sq_cstrlen(@tc.tname[0]));
            if (as_s >= 0) { sq_sb_lit(@sb, " as \0"); sq_sb_add(@sb, @st.sql[as_s], as_e - as_s); };
            sq_sb_lit(@sb, " where 0\0");
            if (sb.err != 0) { sq_sb_free(@sb); sq_seterr(st, "out of memory\0"); return 1; };
            st.retsql = (byte*)fmalloc((u64)(sq_cstrlen(sb.p) + 8));
            if ((u64)st.retsql == (u64)0) { sq_sb_free(@sb); sq_seterr(st, "out of memory\0"); return 1; };
            sq_mcpy(st.retsql, sb.p, sq_cstrlen(sb.p) + 1);
            sub = sq_stmt_new();
            if ((u64)sub == (u64)0) { sq_sb_free(@sb); sq_seterr(st, "out of memory\0"); return 1; };
            rc = sq_prep_query(sub, st.db, sb.p);
            sq_sb_free(@sb);
            if (rc != 0) { sq_seterr(st, @sub.err[0]); sq_stmt_del(sub); return 1; };
            nc = sub.nres;
            sq_stmt_del(sub);
            st.ret = sq_rs_new(nc, nc);
            if ((u64)st.ret == (u64)0) { sq_seterr(st, "out of memory\0"); return 1; };
            return 0;
        };

        // evaluates the RETURNING list for the row as it is right now and appends it to the output
        def sq_tc_note(SQ_TCTX* tc, i64 rid) -> int
        {
            SQ_STMT* st = tc.st;
            SQ_SB sb;
            SQ_STMT* sub;
            SQ_VAL* row;
            SQ_VAL* src;
            int j, c, nc;
            if (st.ret_s < 0) { return 0; };
            nc = st.ret.nc;
            sq_sb_init(@sb);
            sq_sb_lit(@sb, "select \0");
            sq_sb_add(@sb, @st.sql[st.ret_s], st.ret_e - st.ret_s);
            sq_sb_lit(@sb, " from \0");
            sq_sb_ident(@sb, @tc.tname[0], sq_cstrlen(@tc.tname[0]));
            if (tc.ras >= 0) { sq_sb_lit(@sb, " as \0"); sq_sb_add(@sb, @st.sql[tc.ras], tc.rae - tc.ras); };
            sq_sb_lit(@sb, " where rowid = \0");
            sq_sb_int(@sb, rid);
            if (sb.err != 0) { sq_sb_free(@sb); sq_seterr(st, "out of memory\0"); return 1; };
            sub = sq_run_rows(st.db, st, sb.p);
            sq_sb_free(@sb);
            if ((u64)sub == (u64)0) { return 1; };
            for (j = 0; j < sub.res.n; j++)
            {
                row = sq_rs_row(st.ret);
                if ((u64)row == (u64)0) { sq_stmt_del(sub); sq_seterr(st, "out of memory\0"); return 1; };
                src = @sub.res.d[j * sub.res.nc];
                for (c = 0; c < nc; c++)
                {
                    sq_val_copy(@row[c], @src[c]);
                    sq_val_own(@st.ret.ar, @row[c]);
                };
            };
            sq_stmt_del(sub);
            return 0;
        };

        // ---- upsert clauses ----

        struct SQ_UPS
        {
            int ncl;
            int[4] ntg, action, nset, ws, we;
            int[32] tg;
            int[64] setc, ses, see;
        };

        // parses "ON CONFLICT ... DO ..." clauses found in the text [pos, end). Returns 0 on success.
        def sq_ups_parse(SQ_STMT* st, SQ_TCTX* tc, SQ_UPS* u, int pos, int end) -> int
        {
            int k, c, es, ee, j;
            u.ncl = 0;
            st.pos = pos;
            st.tend = pos;
            st.prevend = pos;
            st.lim = end;
            sq_next(st);
            while (sq_is_kw(st, "on\0"))
            {
                if (u.ncl >= 4) { sq_seterr(st, "too many ON CONFLICT clauses\0"); return 1; };
                k = u.ncl;
                u.ntg[k] = 0; u.nset[k] = 0; u.ws[k] = 0 - 1; u.we[k] = 0 - 1; u.action[k] = 0;
                sq_next(st);
                if (sq_is_kw(st, "conflict\0") == false) { sq_seterr(st, "syntax error in INSERT\0"); return 1; };
                sq_next(st);
                if (sq_is_op(st, 40))
                {
                    sq_next(st);
                    while (true)
                    {
                        if (st.tk != 1) { sq_seterr(st, "unsupported conflict target\0"); return 1; };
                        c = sq_ti_find(tc.ti, @st.sql[0], st.ts, st.tl);
                        if (c < 0)
                        {
                            if (sq_is_rowid_name(@st.sql[st.ts], st.tl)) { c = tc.ti.ipk; if (c < 0) { c = tc.ncols; }; };
                        };
                        if (c < 0) { sq_err_name(st, "no such column: \0", @st.sql[st.ts], st.tl, "\0"); return 1; };
                        if (u.ntg[k] >= 8) { sq_seterr(st, "conflict target too long\0"); return 1; };
                        u.tg[k * 8 + u.ntg[k]] = c;
                        u.ntg[k]++;
                        sq_next(st);
                        if (sq_is_op(st, 44)) { sq_next(st); continue; };
                        break;
                    };
                    if (sq_is_op(st, 41) == false) { sq_seterr(st, "expected )\0"); return 1; };
                    sq_next(st);
                    if (sq_is_kw(st, "where\0"))
                    {
                        sq_next(st);
                        j = sq_skip_expr(st, 0);
                        sq_seterr(st, "partial index conflict targets are not supported\0");
                        return 1;
                    };
                };
                if (sq_is_kw(st, "do\0") == false) { sq_seterr(st, "expected DO\0"); return 1; };
                sq_next(st);
                if (sq_is_kw(st, "nothing\0")) { sq_next(st); u.action[k] = 0; }
                else
                {
                    if (sq_is_kw(st, "update\0") == false) { sq_seterr(st, "expected NOTHING or UPDATE\0"); return 1; };
                    sq_next(st);
                    if (sq_is_kw(st, "set\0") == false) { sq_seterr(st, "expected SET\0"); return 1; };
                    sq_next(st);
                    u.action[k] = 1;
                    while (true)
                    {
                        if (st.tk != 1) { sq_seterr(st, "expected a column name\0"); return 1; };
                        c = sq_ti_find(tc.ti, @st.sql[0], st.ts, st.tl);
                        if (c < 0)
                        {
                            if (sq_is_rowid_name(@st.sql[st.ts], st.tl)) { c = tc.ti.ipk; if (c < 0) { c = tc.ncols; }; };
                        };
                        if (c < 0) { sq_err_name(st, "no such column: \0", @st.sql[st.ts], st.tl, "\0"); return 1; };
                        if (u.nset[k] >= 16) { sq_seterr(st, "too many assignments\0"); return 1; };
                        u.setc[k * 16 + u.nset[k]] = c;
                        sq_next(st);
                        if (sq_is_op(st, 61) == false) { sq_seterr(st, "expected =\0"); return 1; };
                        sq_next(st);
                        es = sq_tok_start(st);
                        ee = sq_skip_expr(st, 1);
                        if (ee <= es) { sq_seterr(st, "expected an expression\0"); return 1; };
                        u.ses[k * 16 + u.nset[k]] = es;
                        u.see[k * 16 + u.nset[k]] = ee;
                        u.nset[k]++;
                        if (sq_is_op(st, 44)) { sq_next(st); continue; };
                        break;
                    };
                    if (sq_is_kw(st, "where\0"))
                    {
                        sq_next(st);
                        es = sq_tok_start(st);
                        ee = sq_skip_expr(st, 0);
                        u.ws[k] = es;
                        u.we[k] = ee;
                        while (st.tk != 0 & sq_is_kw(st, "on\0") == false) { sq_next(st); };
                    };
                };
                u.ncl++;
            };
            if (st.tk != 0) { sq_seterr(st, "syntax error in INSERT\0"); return 1; };
            return 0;
        };

        // the clause that applies to the violated constraint, or -1
        def sq_ups_match(SQ_TCTX* tc, SQ_UPS* u, int cfix) -> int
        {
            int k, a, b, found, same;
            SQ_IDX* ix;
            for (k = 0; k < u.ncl; k++)
            {
                if (u.ntg[k] == 0) { return k; };
                if (cfix < 0)
                {
                    same = 0;
                    if (u.ntg[k] == 1)
                    {
                        if (u.tg[k * 8] == tc.ti.ipk) { same = 1; };
                        if (tc.ti.ipk < 0 & u.tg[k * 8] == tc.ncols) { same = 1; };
                    };
                    if (same == 1) { return k; };
                    continue;
                };
                ix = @tc.ix[cfix];
                if (ix.nk - 1 != u.ntg[k] & ix.nk != u.ntg[k]) { continue; };
                same = 1;
                for (a = 0; a < u.ntg[k]; a++)
                {
                    found = 0;
                    for (b = 0; b < u.ntg[k]; b++) { if (ix.col[b] == u.tg[k * 8 + a]) { found = 1; }; };
                    if (found == 0) { same = 0; };
                };
                if (same == 1) { return k; };
            };
            return 0 - 1;
        };

        // SQL literal for a value
        def sq_sb_value(SQ_SB* sb, SQ_VAL* v) -> void
        {
            byte[64] t;
            int i, n;
            byte* hx;
            if (v.t == SQ_NULL) { sq_sb_lit(sb, "null\0"); return; };
            if (v.t == SQ_INTEGER) { sq_sb_int(sb, v.i); return; };
            if (v.t == SQ_REAL)
            {
                if (v.r > 1.0e308) { sq_sb_lit(sb, "9e999\0"); return; };
                if (v.r < 0.0 - 1.0e308) { sq_sb_lit(sb, "-9e999\0"); return; };
                n = sq_real_text(v.r, @t[0]);
                if (v.r < 0.0) { sq_sb_lit(sb, "(\0"); sq_sb_add(sb, @t[0], n); sq_sb_lit(sb, ")\0"); }
                else { sq_sb_add(sb, @t[0], n); };
                return;
            };
            if (v.t == SQ_TEXT)
            {
                sq_sb_lit(sb, "'\0");
                for (i = 0; i < v.n; i++)
                {
                    if (v.p[i] == (byte)39) { sq_sb_lit(sb, "''\0"); } else { sq_sb_add(sb, @v.p[i], 1); };
                };
                sq_sb_lit(sb, "'\0");
                return;
            };
            hx = "0123456789ABCDEF\0";
            sq_sb_lit(sb, "x'\0");
            for (i = 0; i < v.n; i++)
            {
                t[0] = hx[((int)v.p[i] >> 4) `& 15];
                t[1] = hx[(int)v.p[i] `& 15];
                sq_sb_add(sb, @t[0], 2);
            };
            sq_sb_lit(sb, "'\0");
        };

        // copies an expression, replacing excluded.name by the column "__ex_name" of the proposed-row source
        def sq_sb_expr(SQ_SB* sb, byte* s, int n) -> void
        {
            int i, j, st0, en;
            byte q;
            i = 0;
            while (i < n)
            {
                if (s[i] == (byte)39 | s[i] == (byte)34 | s[i] == (byte)96)
                {
                    q = s[i];
                    j = i + 1;
                    while (j < n & s[j] != q) { j++; };
                    if (j < n) { j++; };
                    sq_sb_add(sb, @s[i], j - i);
                    i = j;
                    continue;
                };
                if (i + 9 <= n)
                {
                    if (sq_lc(s[i]) == (byte)101 & sq_lc(s[i + 1]) == (byte)120 & sq_lc(s[i + 2]) == (byte)99 & sq_lc(s[i + 3]) == (byte)108 & sq_lc(s[i + 4]) == (byte)117 & sq_lc(s[i + 5]) == (byte)100 & sq_lc(s[i + 6]) == (byte)101 & sq_lc(s[i + 7]) == (byte)100 & s[i + 8] == (byte)46)
                    {
                        j = 1;
                        if (i > 0) { if (sq_isalpha(s[i - 1]) | sq_isdigit(s[i - 1]) | s[i - 1] == (byte)95 | s[i - 1] == (byte)46) { j = 0; }; };
                        if (j == 1 & i + 9 < n)
                        {
                            st0 = i + 9;
                            if (s[st0] == (byte)34)
                            {
                                en = st0 + 1;
                                while (en < n & s[en] != (byte)34) { en++; };
                                sq_sb_lit(sb, "\"__ex_\0");
                                sq_sb_add(sb, @s[st0 + 1], en - st0 - 1);
                                sq_sb_lit(sb, "\"\0");
                                i = en + 1;
                                continue;
                            };
                            if (sq_isalpha(s[st0]) | s[st0] == (byte)95)
                            {
                                en = st0;
                                while (en < n & (sq_isalpha(s[en]) | sq_isdigit(s[en]) | s[en] == (byte)95)) { en++; };
                                sq_sb_lit(sb, "\"__ex_\0");
                                sq_sb_add(sb, @s[st0], en - st0);
                                sq_sb_lit(sb, "\"\0");
                                i = en;
                                continue;
                            };
                        };
                    };
                };
                sq_sb_add(sb, @s[i], 1);
                i++;
            };
        };

        // Applies DO UPDATE of clause k to the existing row cr. nwp holds the values proposed by the INSERT (the "excluded" row).
        // Returns 0 when done, 1 on an error.
        def sq_ups_apply(SQ_STMT* st, SQ_TCTX* tc, SQ_CHK* chk, SQ_UPS* u, int k, SQ_VAL* nwp, i64 cr) -> int
        {
            SQ_SB sb;
            SQ_STMT* sub;
            SQ_VAL* ov;
            SQ_VAL* nv;
            SQ_VAL* row;
            int c, j, r, rc, ipk, tl;
            i64 newrid;
            ipk = tc.ti.ipk;
            tl = sq_cstrlen(@tc.tname[0]);
            sq_sb_init(@sb);
            sq_sb_lit(@sb, "select \0");
            sq_sb_ident(@sb, @tc.tname[0], tl);
            sq_sb_lit(@sb, ".rowid, \0");
            sq_sb_ident(@sb, @tc.tname[0], tl);
            sq_sb_lit(@sb, ".*\0");
            for (j = 0; j < u.nset[k]; j++)
            {
                sq_sb_lit(@sb, ", (\0");
                sq_sb_expr(@sb, @st.sql[u.ses[k * 16 + j]], u.see[k * 16 + j] - u.ses[k * 16 + j]);
                sq_sb_lit(@sb, ")\0");
            };
            if (u.ws[k] >= 0)
            {
                sq_sb_lit(@sb, ", (\0");
                sq_sb_expr(@sb, @st.sql[u.ws[k]], u.we[k] - u.ws[k]);
                sq_sb_lit(@sb, ")\0");
            };
            sq_sb_lit(@sb, " from \0");
            sq_sb_ident(@sb, @tc.tname[0], tl);
            sq_sb_lit(@sb, ", (select \0");
            for (c = 0; c < tc.ncols; c++)
            {
                if (c > 0) { sq_sb_lit(@sb, ", \0"); };
                sq_sb_value(@sb, @nwp[c]);
                sq_sb_lit(@sb, " as \"__ex_\0");
                sq_sb_add(@sb, @tc.ti.base[tc.ti.cs[c]], tc.ti.cl[c]);
                sq_sb_lit(@sb, "\"\0");
            };
            sq_sb_lit(@sb, ") as excluded where \0");
            sq_sb_ident(@sb, @tc.tname[0], tl);
            sq_sb_lit(@sb, ".rowid = \0");
            sq_sb_int(@sb, cr);
            if (sb.err != 0) { sq_sb_free(@sb); sq_seterr(st, "out of memory\0"); return 1; };
            sub = sq_run_rows(st.db, st, sb.p);
            sq_sb_free(@sb);
            if ((u64)sub == (u64)0) { return 1; };
            if (sub.res.n < 1) { sq_stmt_del(sub); return 0; };
            row = @sub.res.d[0];
            if (u.ws[k] >= 0)
            {
                if (sq_truth(@row[1 + tc.ncols + u.nset[k]]) != 1) { sq_stmt_del(sub); return 0; };
            };
            ov = tc.ol;
            nv = tc.nw;
            for (c = 0; c < tc.ncols; c++)
            {
                sq_val_copy(@ov[c], @row[1 + c]);
                sq_val_own(@tc.ar, @ov[c]);
                sq_val_copy(@nv[c], @ov[c]);
            };
            sq_val_int(@ov[tc.ncols], cr);
            for (j = 0; j < u.nset[k]; j++)
            {
                c = u.setc[k * 16 + j];
                sq_val_copy(@nv[c], @row[1 + tc.ncols + j]);
                sq_val_own(@tc.ar, @nv[c]);
                if (c == tc.ncols) { sq_val_copy(@nv[tc.ncols], @nv[c]); };
            };
            sq_stmt_del(sub);
            sq_tc_affinity(tc, nv);
            newrid = cr;
            if (ipk >= 0)
            {
                if (nv[ipk].t != SQ_INTEGER) { sq_seterr(st, "datatype mismatch\0"); return 1; };
                newrid = nv[ipk].i;
            }
            else
            {
                for (j = 0; j < u.nset[k]; j++)
                {
                    if (u.setc[k * 16 + j] == tc.ncols)
                    {
                        sq_cast(@tc.ar, @nv[tc.ncols], 3, @nv[tc.ncols]);
                        newrid = nv[tc.ncols].i;
                    };
                };
            };
            sq_val_int(@nv[tc.ncols], newrid);
            r = sq_tc_check(tc, chk, nv, newrid, 1, cr, 0);
            if (r == 1) { return 1; };
            if (r == 5) { return 0; };
            if (sq_tc_remove(tc, cr, ov) != 0) { return 1; };
            if (sq_tc_put(tc, newrid, nv) != 0) { return 1; };
            st.changes++;
            if (sq_tc_note(tc, newrid) != 0) { return 1; };
            return 0;
        };

        // ---- INSERT ----

        def sq_exec_insert(SQ_STMT* st, SQ_TCTX* tc, int onconf, byte* name, int nl) -> int
        {
            SQLITE_DB* db = st.db;
            SQ_TI* ti;
            SQ_CHK chk;
            SQ_STMT* sub;
            SQ_VAL* nw;
            SQ_VAL* src;
            SQ_SB sb;
            int[130] map;
            int[130] isdef;
            int ncol, c, j, r, nrows, i, k, srcn, rs, re, gs, ge, depth, e, rc, sk, first, ipk, isrow;
            i64 rowid, mx, seq;
            byte[64] cn;
            SQ_UPS ups;
            int has_ups, upos, tokstart, ulim, umatch;
            ti = tc.ti;
            ipk = ti.ipk;
            nw = tc.nw;
            rc = 0;
            // RETURNING and ON CONFLICT clauses are split off before the rows are read
            sq_cut_returning(st);
            if (sq_ret_begin(st, tc, 0 - 1, 0 - 1) != 0) { return 1; };
            tokstart = sq_tok_start(st);
            has_ups = 0;
            upos = sq_find_top(@st.sql[tokstart], st.lim - tokstart, "on conflict\0");
            if (upos >= 0)
            {
                upos = tokstart + upos;
                ulim = st.lim;
                if (sq_ups_parse(st, tc, @ups, upos, ulim) != 0) { return 1; };
                has_ups = 1;
                st.lim = upos;
                while (st.lim > tokstart)
                {
                    if (st.sql[st.lim - 1] == (byte)32 | st.sql[st.lim - 1] == (byte)9 | st.sql[st.lim - 1] == (byte)10 | st.sql[st.lim - 1] == (byte)13) { st.lim--; } else { break; };
                };
                sq_rewind(st, tokstart);
                onconf = 6;
            };
            // optional column list
            ncol = 0;
            if (sq_is_op(st, 40))
            {
                sq_next(st);
                while (true)
                {
                    if (st.tk != 1) { sq_seterr(st, "expected a column name\0"); return 1; };
                    c = 0 - 1;
                    if (st.tq == 1) { c = sq_ti_find(ti, @st.sql[0], st.ts, st.tl); }
                    else { c = sq_ti_find(ti, @st.sql[0], st.ts, st.tl); };
                    if (c < 0)
                    {
                        if (sq_is_rowid_name(@st.sql[st.ts], st.tl))
                        {
                            c = ipk;
                            if (c < 0) { c = tc.ncols; };
                        };
                    };
                    if (c < 0) { sq_err_name(st, "table has no column named \0", @st.sql[st.ts], st.tl, "\0"); return 1; };
                    if (ncol >= 128) { sq_seterr(st, "too many columns\0"); return 1; };
                    map[ncol] = c;
                    ncol++;
                    sq_next(st);
                    if (sq_is_op(st, 44)) { sq_next(st); continue; };
                    break;
                };
                if (sq_is_op(st, 41) == false) { sq_seterr(st, "expected )\0"); return 1; };
                sq_next(st);
            }
            else
            {
                for (c = 0; c < tc.ncols; c++) { map[c] = c; };
                ncol = tc.ncols;
            };
            if (sq_chk_open(tc, @chk) != 0) { return 1; };
            seq = (i64)0;
            if (ti.autoinc == 1) { seq = sq_seq_read(tc, @mx); };
            first = 1;
            // source
            if (sq_is_kw(st, "default\0"))
            {
                sq_next(st);
                if (sq_is_kw(st, "values\0") == false) { sq_seterr(st, "expected VALUES\0"); sq_chk_close(@chk); return 1; };
                sq_next(st);
                srcn = 0;
                sub = (SQ_STMT*)0;
                isrow = 1;
                nrows = 1;
            }
            else
            {
                if (sq_is_kw(st, "values\0")) { isrow = 2; } else { isrow = 0; };
            };
            if (isrow == 0)
            {
                // INSERT ... SELECT
                rs = sq_tok_start(st);
                re = st.lim;
                while (re > rs)
                {
                    if (st.sql[re - 1] == (byte)32 | st.sql[re - 1] == (byte)9 | st.sql[re - 1] == (byte)10 | st.sql[re - 1] == (byte)13 | st.sql[re - 1] == (byte)59) { re--; } else { break; };
                };
                if (st.tk == 0) { sq_seterr(st, "expected VALUES or SELECT\0"); sq_chk_close(@chk); return 1; };
                if (sq_is_kw(st, "select\0") == false & sq_is_kw(st, "with\0") == false)
                {
                    sq_seterr(st, "syntax error in INSERT\0"); sq_chk_close(@chk); return 1;
                };
                sq_sb_init(@sb);
                sq_sb_add(@sb, @st.sql[rs], re - rs);
                sub = sq_run_rows(db, st, sb.p);
                sq_sb_free(@sb);
                if ((u64)sub == (u64)0) { sq_chk_close(@chk); return 1; };
                if (sub.nres != ncol)
                {
                    sq_stmt_del(sub);
                    sq_chk_close(@chk);
                    sq_seterr(st, "number of values does not match the number of columns\0");
                    return 1;
                };
                nrows = sub.res.n;
            };
            if (isrow == 2) { sq_next(st); };
            i = 0;
            while (true)
            {
                // fetch the values of the next row into src (srcn values) with isdef marking DEFAULT
                for (c = 0; c < tc.ncols; c++) { sq_val_copy(@nw[c], @tc.dv[c]); };
                sq_val_null(@nw[tc.ncols]);
                if (isrow == 0)
                {
                    if (i >= nrows) { break; };
                    for (j = 0; j < ncol; j++) { sq_val_copy(@nw[map[j]], @sub.res.d[i * sub.res.nc + j]); sq_val_own(@tc.ar, @nw[map[j]]); };
                }
                else
                {
                    if (isrow == 1)
                    {
                        if (i >= 1) { break; };
                    }
                    else
                    {
                        if (i > 0)
                        {
                            if (sq_is_op(st, 44)) { sq_next(st); } else { break; };
                        };
                        if (sq_is_op(st, 40) == false) { sq_seterr(st, "expected (\0"); rc = 1; break; };
                        sq_next(st);
                        sq_sb_init(@sb);
                        sq_sb_lit(@sb, "select \0");
                        j = 0;
                        while (true)
                        {
                            gs = sq_tok_start(st);
                            // a lone DEFAULT keyword uses the column default
                            isdef[j] = 0;
                            if (sq_is_kw(st, "default\0"))
                            {
                                if (sq_peek_op(st, 44) | sq_peek_op(st, 41)) { isdef[j] = 1; };
                            };
                            ge = sq_skip_expr(st, 0);
                            if (j > 0) { sq_sb_lit(@sb, ", \0"); };
                            if (isdef[j] == 1) { sq_sb_lit(@sb, "null\0"); }
                            else { sq_sb_add(@sb, @st.sql[gs], ge - gs); };
                            j++;
                            if (sq_is_op(st, 44)) { sq_next(st); continue; };
                            break;
                        };
                        if (sq_is_op(st, 41) == false) { sq_seterr(st, "expected )\0"); sq_sb_free(@sb); rc = 1; break; };
                        sq_next(st);
                        if (j != ncol)
                        {
                            sq_sb_free(@sb);
                            sq_seterr(st, "number of values does not match the number of columns\0");
                            rc = 1;
                            break;
                        };
                        sub = sq_run_rows(db, st, sb.p);
                        sq_sb_free(@sb);
                        if ((u64)sub == (u64)0) { rc = 1; break; };
                        for (k = 0; k < ncol; k++)
                        {
                            if (isdef[k] == 1) { continue; };
                            sq_val_copy(@nw[map[k]], @sub.res.d[k]);
                            sq_val_own(@tc.ar, @nw[map[k]]);
                        };
                        sq_stmt_del(sub);
                        sub = (SQ_STMT*)0;
                    };
                };
                // determine the rowid
                sq_tc_affinity(tc, nw);
                rowid = (i64)0;
                sk = 0;
                if (ipk >= 0)
                {
                    if (nw[ipk].t == SQ_NULL) { sk = 1; }
                    else
                    {
                        if (nw[ipk].t != SQ_INTEGER) { sq_seterr(st, "datatype mismatch\0"); rc = 1; break; };
                        rowid = nw[ipk].i;
                    };
                }
                else
                {
                    sk = 1;
                    for (j = 0; j < ncol; j++)
                    {
                        if (map[j] == tc.ncols)
                        {
                            sk = 0;
                            // explicit rowid: any integer
                            if (nw[tc.ncols].t == SQ_NULL) { sk = 1; }
                            else
                            {
                                sq_cast(@tc.ar, @nw[tc.ncols], 3, @nw[tc.ncols]);
                                rowid = nw[tc.ncols].i;
                            };
                        };
                    };
                };
                if (sk == 1)
                {
                    if (sq_max_rowid(db, tc.root, @mx) != 0) { sq_seterr(st, "read error\0"); rc = 1; break; };
                    if (ti.autoinc == 1 & seq > mx) { mx = seq; };
                    if (mx == (i64)9223372036854775807) { sq_seterr(st, "database or disk is full\0"); rc = 1; break; };
                    rowid = mx + (i64)1;
                };
                if (ipk >= 0) { sq_val_int(@nw[ipk], rowid); };
                sq_val_int(@nw[tc.ncols], rowid);
                r = sq_tc_check(tc, @chk, nw, rowid, 0, (i64)0, onconf);
                if (r == 1) { rc = 1; break; };
                if (r == 6)
                {
                    umatch = sq_ups_match(tc, @ups, tc.cf_ix);
                    if (umatch < 0)
                    {
                        if (tc.cf_ix < 0) { sq_err_unique(tc, (SQ_IDX*)0, 1); } else { sq_err_unique(tc, @tc.ix[tc.cf_ix], 0); };
                        st.pad = 0;
                        rc = 1;
                        break;
                    };
                    if (ups.action[umatch] == 1)
                    {
                        if (sq_ups_apply(st, tc, @chk, @ups, umatch, nw, tc.cf_rid) != 0) { rc = 1; break; };
                    };
                };
                if (r == 0)
                {
                    if (sq_tc_put(tc, rowid, nw) != 0) { rc = 1; break; };
                    st.changes++;
                    st.last_rowid = rowid;
                    if (sq_tc_note(tc, rowid) != 0) { rc = 1; break; };
                };
                if (ti.autoinc == 1) { if (rowid > seq) { seq = rowid; }; };
                sq_ar_reset(@tc.ar);
                i++;
                if (isrow == 1) { break; };
                if (first == 1) { first = 0; };
            };
            if (isrow == 0 & (u64)sub != (u64)0) { sq_stmt_del(sub); };
            sq_chk_close(@chk);
            if (rc != 0) { return 1; };
            if (isrow != 0)
            {
                if (st.tk != 0 & sq_is_op(st, 59) == false) { sq_seterr(st, "syntax error in INSERT\0"); return 1; };
            };
            if (ti.autoinc == 1) { if (sq_seq_write(tc, seq) != 0) { sq_seterr(st, "cannot update sqlite_sequence\0"); return 1; }; };
            return 0;
        };

        // ---- shared tail: bring dirty indexes up to date ----

        def sq_tc_finish(SQ_TCTX* tc) -> int
        {
            int i;
            for (i = 0; i < tc.nix; i++)
            {
                if (sq_tc_clean(tc, i) != 0) { sq_seterr(tc.st, "index rebuild failed\0"); return 1; };
            };
            return 0;
        };

        // ---- DELETE ----

        // the select that produces rowid and all columns of the rows to change
        def sq_exec_delete(SQ_STMT* st, SQ_TCTX* tc, byte* name, int nl) -> int
        {
            SQLITE_DB* db = st.db;
            SQ_STMT* sub;
            SQ_SB sb;
            SQ_VAL* vals;
            SQ_ARENA ar;
            int ws, we, i, c, rc, r, as_s, as_e;
            i64 rid;
            sq_cut_returning(st);
            // optional alias
            as_s = 0 - 1;
            if (st.tk == 1 & sq_is_kw(st, "where\0") == false & sq_is_kw(st, "order\0") == false & sq_is_kw(st, "limit\0") == false)
            {
                if (sq_is_kw(st, "as\0")) { sq_next(st); };
                as_s = sq_tok_start(st);
                as_e = st.tend;
                sq_next(st);
            };
            if (sq_ret_begin(st, tc, as_s, as_e) != 0) { return 1; };
            sq_sb_init(@sb);
            sq_sb_lit(@sb, "select rowid, * from \0");
            sq_sb_ident(@sb, name, nl);
            if (as_s >= 0) { sq_sb_lit(@sb, " as \0"); sq_sb_add(@sb, @st.sql[as_s], as_e - as_s); };
            if (sq_is_kw(st, "where\0") | sq_is_kw(st, "order\0") | sq_is_kw(st, "limit\0"))
            {
                ws = sq_tok_start(st);
                we = st.lim;
                while (we > ws)
                {
                    if (st.sql[we - 1] == (byte)32 | st.sql[we - 1] == (byte)9 | st.sql[we - 1] == (byte)10 | st.sql[we - 1] == (byte)13 | st.sql[we - 1] == (byte)59) { we--; } else { break; };
                };
                sq_sb_lit(@sb, " \0");
                sq_sb_add(@sb, @st.sql[ws], we - ws);
            }
            else
            {
                if (st.tk != 0 & sq_is_op(st, 59) == false) { sq_sb_free(@sb); sq_seterr(st, "syntax error in DELETE\0"); return 1; };
            };
            sub = sq_run_rows(db, st, sb.p);
            sq_sb_free(@sb);
            if ((u64)sub == (u64)0) { return 1; };
            vals = (SQ_VAL*)fmalloc((u64)(tc.ncols + 2) * (u64)sizeof(SQ_VAL));
            if ((u64)vals == (u64)0) { sq_stmt_del(sub); return 1; };
            sq_ar_init(@ar);
            rc = 0;
            if (st.ret_s >= 0)
            {
                for (i = 0; i < sub.res.n; i++)
                {
                    if (sq_tc_note(tc, sub.res.d[i * sub.res.nc].i) != 0) { rc = 1; break; };
                };
            };
            for (i = 0; i < sub.res.n; i++)
            {
                if (rc != 0) { break; };
                rid = sub.res.d[i * sub.res.nc].i;
                for (c = 0; c < tc.ncols; c++) { sq_val_copy(@vals[c], @sub.res.d[i * sub.res.nc + 1 + c]); };
                sq_val_int(@vals[tc.ncols], rid);
                // the row may have vanished (REPLACE side effects are not possible here, but stay safe)
                if (sq_tc_remove(tc, rid, vals) != 0) { rc = 1; break; };
                st.changes++;
            };
            sq_ar_free(@ar);
            ffree((u64)vals);
            sq_stmt_del(sub);
            if (rc != 0) { return 1; };
            return sq_tc_finish(tc);
        };

        // ---- UPDATE ----

        def sq_exec_update(SQ_STMT* st, SQ_TCTX* tc, int onconf, byte* name, int nl) -> int
        {
            SQLITE_DB* db = st.db;
            SQ_TI* ti;
            SQ_CHK chk;
            SQ_STMT* sub;
            SQ_SB sb;
            SQ_VAL* nw;
            SQ_VAL* ol;
            int[130] scol;
            int nset, c, j, i, ws, we, es, ee, r, rc, ipk, changed, k, oc, as_s, as_e;
            i64 rowid, newrid, seq, mx;
            ti = tc.ti;
            ipk = ti.ipk;
            sq_cut_returning(st);
            // optional alias before SET
            as_s = 0 - 1;
            if (st.tk == 1 & sq_is_kw(st, "set\0") == false)
            {
                if (sq_is_kw(st, "as\0")) { sq_next(st); };
                as_s = sq_tok_start(st);
                as_e = st.tend;
                sq_next(st);
            };
            if (sq_is_kw(st, "set\0") == false) { sq_seterr(st, "expected SET\0"); return 1; };
            if (sq_ret_begin(st, tc, as_s, as_e) != 0) { return 1; };
            sq_next(st);
            sq_sb_init(@sb);
            sq_sb_lit(@sb, "select rowid, *\0");
            nset = 0;
            while (true)
            {
                if (st.tk != 1) { sq_seterr(st, "expected a column name\0"); sq_sb_free(@sb); return 1; };
                c = sq_ti_find(ti, @st.sql[0], st.ts, st.tl);
                if (c < 0)
                {
                    if (sq_is_rowid_name(@st.sql[st.ts], st.tl)) { c = ipk; if (c < 0) { c = tc.ncols; }; };
                };
                if (c < 0) { sq_err_name(st, "no such column: \0", @st.sql[st.ts], st.tl, "\0"); sq_sb_free(@sb); return 1; };
                if (nset >= 120) { sq_seterr(st, "too many assignments\0"); sq_sb_free(@sb); return 1; };
                scol[nset] = c;
                sq_next(st);
                if (sq_is_op(st, 61) == false) { sq_seterr(st, "expected =\0"); sq_sb_free(@sb); return 1; };
                sq_next(st);
                es = sq_tok_start(st);
                ee = sq_skip_expr(st, 1);
                if (ee <= es) { sq_seterr(st, "expected an expression\0"); sq_sb_free(@sb); return 1; };
                sq_sb_lit(@sb, ", (\0");
                sq_sb_add(@sb, @st.sql[es], ee - es);
                sq_sb_lit(@sb, ")\0");
                nset++;
                if (sq_is_op(st, 44)) { sq_next(st); continue; };
                break;
            };
            sq_sb_lit(@sb, " from \0");
            sq_sb_ident(@sb, name, nl);
            if (as_s >= 0) { sq_sb_lit(@sb, " as \0"); sq_sb_add(@sb, @st.sql[as_s], as_e - as_s); };
            if (sq_is_kw(st, "where\0") | sq_is_kw(st, "order\0") | sq_is_kw(st, "limit\0"))
            {
                ws = sq_tok_start(st);
                we = st.lim;
                while (we > ws)
                {
                    if (st.sql[we - 1] == (byte)32 | st.sql[we - 1] == (byte)9 | st.sql[we - 1] == (byte)10 | st.sql[we - 1] == (byte)13 | st.sql[we - 1] == (byte)59) { we--; } else { break; };
                };
                sq_sb_lit(@sb, " \0");
                sq_sb_add(@sb, @st.sql[ws], we - ws);
            }
            else
            {
                if (st.tk != 0 & sq_is_op(st, 59) == false) { sq_sb_free(@sb); sq_seterr(st, "syntax error in UPDATE\0"); return 1; };
            };
            if (sq_chk_open(tc, @chk) != 0) { sq_sb_free(@sb); return 1; };
            sub = sq_run_rows(db, st, sb.p);
            sq_sb_free(@sb);
            if ((u64)sub == (u64)0) { sq_chk_close(@chk); return 1; };
            nw = tc.nw;
            ol = tc.ol;
            seq = (i64)0;
            rc = 0;
            for (i = 0; i < sub.res.n; i++)
            {
                rowid = sub.res.d[i * sub.res.nc].i;
                // the row may have been removed by a REPLACE earlier in this statement
                if (i > 0)
                {
                    r = sq_tc_exists(tc, rowid);
                    if (r < 0) { rc = 1; break; };
                    if (r == 0) { continue; };
                };
                for (c = 0; c < tc.ncols; c++)
                {
                    sq_val_copy(@ol[c], @sub.res.d[i * sub.res.nc + 1 + c]);
                    sq_val_copy(@nw[c], @ol[c]);
                };
                sq_val_int(@ol[tc.ncols], rowid);
                for (j = 0; j < nset; j++)
                {
                    oc = scol[j];
                    sq_val_copy(@nw[oc], @sub.res.d[i * sub.res.nc + 1 + tc.ncols + j]);
                    sq_val_own(@tc.ar, @nw[oc]);
                    if (oc == tc.ncols) { sq_val_copy(@nw[tc.ncols], @nw[oc]); };
                };
                sq_tc_affinity(tc, nw);
                newrid = rowid;
                if (ipk >= 0)
                {
                    if (nw[ipk].t == SQ_NULL) { sq_seterr(st, "datatype mismatch\0"); rc = 1; break; };
                    if (nw[ipk].t != SQ_INTEGER) { sq_seterr(st, "datatype mismatch\0"); rc = 1; break; };
                    newrid = nw[ipk].i;
                }
                else
                {
                    for (j = 0; j < nset; j++)
                    {
                        if (scol[j] == tc.ncols)
                        {
                            sq_cast(@tc.ar, @nw[tc.ncols], 3, @nw[tc.ncols]);
                            newrid = nw[tc.ncols].i;
                        };
                    };
                };
                sq_val_int(@nw[tc.ncols], newrid);
                r = sq_tc_check(tc, @chk, nw, newrid, 1, rowid, onconf);
                if (r == 1) { rc = 1; break; };
                if (r == 5) { sq_ar_reset(@tc.ar); continue; };
                // replace the row: remove the old one, store the new one
                if (sq_tc_remove(tc, rowid, ol) != 0) { rc = 1; break; };
                if (sq_tc_put(tc, newrid, nw) != 0) { rc = 1; break; };
                st.changes++;
                if (sq_tc_note(tc, newrid) != 0) { rc = 1; break; };
                sq_ar_reset(@tc.ar);
            };
            sq_stmt_del(sub);
            sq_chk_close(@chk);
            if (rc != 0) { return 1; };
            return sq_tc_finish(tc);
        };


        // ---- DDL helpers ----

        // true when a schema object (table, view or index) of that name exists
        def sq_obj_exists(SQLITE_DB* db, byte* name, int nl) -> int
        {
            int i;
            for (i = 0; i < db.nschema; i++)
            {
                if (sq_name_is(name, nl, @db.schema[i].name[0])) { return db.schema[i].kind; };
            };
            return 0;
        };

        // allocates a root page holding an empty leaf of the given type
        def sq_new_root(SQLITE_DB* db, int type) -> int
        {
            SQ_PM pm;
            int pg, rc;
            pg = sq_alloc_page(db);
            if (pg == 0) { return 0; };
            if (sq_pm_init(db, @pm) != 0) { sq_pm_free(@pm); return 0; };
            rc = sq_pm_write(db, pg, @pm, 0, 0, type, 0);
            sq_pm_free(@pm);
            if (rc != 0) { return 0; };
            return pg;
        };

        // copy of the statement text from offset a to the end without trailing blanks and semicolons
        def sq_tail_text(SQ_STMT* st, int a, SQ_SB* sb) -> void
        {
            int e = st.sqllen;
            while (e > a)
            {
                if (st.sql[e - 1] == (byte)32 | st.sql[e - 1] == (byte)9 | st.sql[e - 1] == (byte)10 | st.sql[e - 1] == (byte)13 | st.sql[e - 1] == (byte)59) { e--; } else { break; };
            };
            sq_sb_add(sb, @st.sql[a], e - a);
        };

        // ---- CREATE TABLE ----

        // ---- CREATE TABLE ... AS SELECT ----

        // true when the word is a keyword of the SQL dialect (such names are quoted in stored text)
        def sq_is_keyword(byte* s, int n) -> bool
        {
            byte[48] w;
            int i;
            byte* kws;
            if (n > 20 | n < 2) { return false; };
            w[0] = (byte)124;
            for (i = 0; i < n; i++) { w[1 + i] = sq_lc(s[i]); };
            w[n + 1] = (byte)124;
            w[n + 2] = (byte)0;
            kws = "|abort|action|add|after|all|alter|always|analyze|and|as|asc|attach|autoincrement|before|begin|between|by|cascade|case|cast|check|collate|column|commit|conflict|constraint|create|cross|current|current_date|current_time|current_timestamp|database|default|deferrable|deferred|delete|desc|detach|distinct|do|drop|each|else|end|escape|except|exclude|exclusive|exists|explain|fail|filter|first|following|for|foreign|from|full|generated|glob|group|groups|having|if|ignore|immediate|in|index|indexed|initially|inner|insert|instead|intersect|into|is|isnull|join|key|last|left|like|limit|match|materialized|natural|no|not|nothing|notnull|null|nulls|of|offset|on|or|order|others|outer|over|partition|plan|pragma|preceding|primary|query|raise|range|recursive|references|regexp|reindex|release|rename|replace|restrict|returning|right|rollback|row|rows|savepoint|select|set|table|temp|temporary|then|ties|to|transaction|trigger|unbounded|union|unique|update|using|vacuum|values|view|virtual|when|where|window|with|without|\0";
            return sq_ihas(kws, sq_cstrlen(kws), @w[0]);
        };

        // identifier as SQLite writes it into stored CREATE text
        def sq_sb_ident_k(SQ_SB* b, byte* s, int n) -> void
        {
            int i, plain;
            plain = 1;
            if (n == 0) { plain = 0; };
            for (i = 0; i < n; i++)
            {
                if (sq_isalpha(s[i]) == false & sq_isdigit(s[i]) == false & s[i] != (byte)95) { plain = 0; };
                if (s[i] >= (byte)128) { plain = 0; };
            };
            if (n > 0) { if (sq_isdigit(s[0])) { plain = 0; }; };
            if (plain == 1) { if (sq_is_keyword(s, n)) { plain = 0; }; };
            if (plain == 1) { sq_sb_add(b, s, n); return; };
            sq_sb_add(b, "\"\0", 1);
            for (i = 0; i < n; i++)
            {
                if (s[i] == (byte)34) { sq_sb_add(b, "\"\0", 1); };
                sq_sb_add(b, @s[i], 1);
            };
            sq_sb_add(b, "\"\0", 1);
        };

        // Builds the stored CREATE TABLE text for the select in sel[0..sn).
        def sq_ctas_text(SQ_STMT* st, SQ_SB* out, byte* name, int nl, byte* sel, int sn) -> int
        {
            SQ_STMT* sub;
            SQ_BLK* b;
            byte* names;
            byte[24] suf;
            int i, j, k, n, cnt, a, rc, l, nn, hit, sl, tot;
            sub = sq_stmt_new();
            if ((u64)sub == (u64)0) { sq_seterr(st, "out of memory\0"); return 1; };
            rc = sq_prep_query(sub, st.db, sel);
            if (rc != 0) { sq_seterr(st, @sub.err[0]); sq_stmt_del(sub); return 1; };
            b = sub.blks[sub.root_blk];
            n = sub.nres;
            names = (byte*)fmalloc((u64)(n * 256 + 16));
            if ((u64)names == (u64)0) { sq_stmt_del(sub); sq_seterr(st, "out of memory\0"); return 1; };
            for (i = 0; i < n; i++)
            {
                l = sq_column_name(sub, i, @names[i * 256], 200);
                // make the name unique: name:N
                cnt = 0;
                hit = 1;
                while (hit == 1)
                {
                    hit = 0;
                    for (j = 0; j < i; j++)
                    {
                        if (sq_ieq2(@names[j * 256], sq_cstrlen(@names[j * 256]), @names[i * 256], l)) { hit = 1; };
                    };
                    if (hit == 1)
                    {
                        nn = l;
                        k = nn - 1;
                        while (k > 0 & sq_isdigit(names[i * 256 + k])) { k--; };
                        if (k > 0) { if (names[i * 256 + k] == (byte)58) { nn = k; }; };
                        cnt++;
                        sl = 0;
                        k = cnt;
                        if (k == 0) { suf[0] = (byte)48; sl = 1; };
                        while (k > 0) { suf[sl] = (byte)(48 + (k % 10)); k = k / 10; sl++; };
                        names[i * 256 + nn] = (byte)58;
                        for (k = 0; k < sl; k++) { names[i * 256 + nn + 1 + k] = suf[sl - 1 - k]; };
                        l = nn + 1 + sl;
                        names[i * 256 + l] = (byte)0;
                    };
                };
            };
            // SQLite switches to one column per line once the estimated statement length reaches 50
            tot = nl + 2;
            for (k = 0; k < nl; k++) { if (name[k] == (byte)34) { tot++; }; };
            for (i = 0; i < n; i++)
            {
                l = sq_cstrlen(@names[i * 256]);
                tot = tot + l + 7;
                for (k = 0; k < l; k++) { if (names[i * 256 + k] == (byte)34) { tot++; }; };
            };
            sq_sb_lit(out, "CREATE TABLE \0");
            sq_sb_ident_k(out, name, nl);
            if (tot >= 50) { sq_sb_lit(out, "(\n  \0"); } else { sq_sb_lit(out, "(\0"); };
            for (i = 0; i < n; i++)
            {
                if (i > 0) { if (tot >= 50) { sq_sb_lit(out, ",\n  \0"); } else { sq_sb_lit(out, ",\0"); }; };
                sq_sb_ident_k(out, @names[i * 256], sq_cstrlen(@names[i * 256]));
                a = sq_eaff(sub, b.rc[i]);
                if (a == 1) { sq_sb_lit(out, " TEXT\0"); };
                if (a == 2) { sq_sb_lit(out, " NUM\0"); };
                if (a == 3) { sq_sb_lit(out, " INT\0"); };
                if (a == 4) { sq_sb_lit(out, " REAL\0"); };
            };
            if (tot >= 50) { sq_sb_lit(out, "\n)\0"); } else { sq_sb_lit(out, ")\0"); };
            ffree((u64)names);
            sq_stmt_del(sub);
            return 0;
        };

        def sq_exec_create_table(SQ_STMT* st) -> int
        {
            SQLITE_DB* db = st.db;
            SQ_TI* ti;
            SQ_SB sb, nm;
            byte[72] name;
            int ine, nl, nstart, i, j, root, rc, k, ctas, ss, se;
            SQ_TCTX* tc;
            byte* selp;
            ine = 0;
            if (sq_is_kw(st, "if\0"))
            {
                sq_next(st);
                if (sq_is_kw(st, "not\0") == false) { sq_seterr(st, "expected NOT\0"); return 1; };
                sq_next(st);
                if (sq_is_kw(st, "exists\0") == false) { sq_seterr(st, "expected EXISTS\0"); return 1; };
                sq_next(st);
                ine = 1;
            };
            if (st.tk != 1) { sq_seterr(st, "expected a table name\0"); return 1; };
            nl = st.tl;
            if (nl > 50) { sq_seterr(st, "table name too long\0"); return 1; };
            for (i = 0; i < nl; i++) { name[i] = st.sql[st.ts + i]; };
            name[nl] = (byte)0;
            nstart = sq_tok_start(st);
            if (nl >= 7) { if (sq_ihas(@name[0], 7, "sqlite_\0")) { sq_seterr(st, "object name reserved for internal use: \0"); sq_err_name(st, "object name reserved for internal use: \0", @name[0], nl, "\0"); return 1; }; };
            sq_next(st);
            ctas = 0;
            if (sq_is_kw(st, "as\0")) { ctas = 1; };
            if (ctas == 0) { if (sq_is_op(st, 40) == false) { sq_seterr(st, "expected (\0"); return 1; }; };
            k = sq_obj_exists(db, @name[0], nl);
            if (k != 0)
            {
                if (ine == 1 & k == 1) { return 0; };
                if (k == 2) { sq_err_name(st, "there is already an index named \0", @name[0], nl, "\0"); }
                else { sq_err_name(st, "table \0", @name[0], nl, " already exists\0"); };
                return 1;
            };
            sq_sb_init(@sb);
            if (ctas == 1)
            {
                sq_next(st);
                ss = sq_tok_start(st);
                se = st.sqllen;
                while (se > ss & (st.sql[se - 1] == (byte)32 | st.sql[se - 1] == (byte)9 | st.sql[se - 1] == (byte)10 | st.sql[se - 1] == (byte)13 | st.sql[se - 1] == (byte)59)) { se--; };
                if (se <= ss) { sq_seterr(st, "syntax error\0"); return 1; };
                selp = (byte*)fmalloc((u64)(se - ss + 8));
                if ((u64)selp == (u64)0) { sq_seterr(st, "out of memory\0"); return 1; };
                for (i = 0; i < se - ss; i++) { selp[i] = st.sql[ss + i]; };
                selp[se - ss] = (byte)0;
                rc = sq_ctas_text(st, @sb, @name[0], nl, selp, se - ss);
                ffree((u64)selp);
                if (rc != 0) { sq_sb_free(@sb); return 1; };
            }
            else
            {
                sq_sb_lit(@sb, "CREATE TABLE \0");
                sq_tail_text(st, nstart, @sb);
            };
            if (sb.err != 0) { sq_sb_free(@sb); sq_seterr(st, "out of memory\0"); return 1; };
            if (sq_ihas(sb.p, sb.n, "without\0"))
            {
                if (sq_find_kw_in(sb.p, sb.n, "without\0")) { sq_sb_free(@sb); sq_seterr(st, "WITHOUT ROWID tables are not supported\0"); return 1; };
            };
            ti = (SQ_TI*)fmalloc((u64)(sizeof(SQ_TI) / 8 + 4096));
            if ((u64)ti == (u64)0) { sq_sb_free(@sb); return 1; };
            rc = sq_ti_load(ti, sb.p);
            if (rc != 0 | ti.ncols == 0)
            {
                ffree((u64)ti); sq_sb_free(@sb);
                sq_seterr(st, "cannot read column definitions (generated columns are not supported)\0");
                return 1;
            };
            for (i = 0; i < ti.ncols; i++)
            {
                for (j = 0; j < i; j++)
                {
                    if (sq_tname_eq(sb.p, ti.cs[i], ti.cl[i], sb.p, ti.cs[j], ti.cl[j]))
                    {
                        sq_err_name(st, "duplicate column name: \0", @sb.p[ti.cs[i]], ti.cl[i], "\0");
                        ffree((u64)ti); sq_sb_free(@sb);
                        return 1;
                    };
                };
            };
            root = sq_new_root(db, 13);
            if (root == 0) { ffree((u64)ti); sq_sb_free(@sb); sq_seterr(st, "write error\0"); return 1; };
            if (sq_master_add(db, "table\0", @name[0], @name[0], root, sb.p) != 0)
            {
                ffree((u64)ti); sq_sb_free(@sb); sq_seterr(st, "write error\0"); return 1;
            };
            // automatic indexes for UNIQUE and PRIMARY KEY constraints
            for (i = 0; i < ti.nix; i++)
            {
                root = sq_new_root(db, 10);
                if (root == 0) { ffree((u64)ti); sq_sb_free(@sb); sq_seterr(st, "write error\0"); return 1; };
                sq_sb_init(@nm);
                sq_sb_lit(@nm, "sqlite_autoindex_\0");
                sq_sb_add(@nm, @name[0], nl);
                sq_sb_lit(@nm, "_\0");
                sq_sb_int(@nm, (i64)(i + 1));
                rc = sq_master_add(db, "index\0", nm.p, @name[0], root, (byte*)0);
                sq_sb_free(@nm);
                if (rc != 0) { ffree((u64)ti); sq_sb_free(@sb); sq_seterr(st, "write error\0"); return 1; };
            };
            if (ti.autoinc == 1)
            {
                if (sq_find_table_n(db, "sqlite_sequence\0", 15) < 0 & sq_master_find(db, "sqlite_sequence\0", 15, "table\0") < (i64)0)
                {
                    root = sq_new_root(db, 13);
                    if (root == 0) { ffree((u64)ti); sq_sb_free(@sb); sq_seterr(st, "write error\0"); return 1; };
                    if (sq_master_add(db, "table\0", "sqlite_sequence\0", "sqlite_sequence\0", root, "CREATE TABLE sqlite_sequence(name,seq)\0") != 0)
                    {
                        ffree((u64)ti); sq_sb_free(@sb); sq_seterr(st, "write error\0"); return 1;
                    };
                };
            };
            ffree((u64)ti);
            sq_sb_free(@sb);
            if (ctas == 1)
            {
                sq_schema_load(db);
                tc = (SQ_TCTX*)fmalloc((u64)(sizeof(SQ_TCTX) / 8 + 4096));
                if ((u64)tc == (u64)0) { sq_seterr(st, "out of memory\0"); return 1; };
                tc.ti = (SQ_TI*)0;
                rc = sq_tc_open(db, st, @name[0], nl, tc);
                if (rc == 0) { rc = sq_exec_insert(st, tc, 0, @name[0], nl); };
                if (rc == 0) { rc = sq_tc_finish(tc); };
                sq_tc_free(tc);
                ffree((u64)tc);
                return rc;
            };
            return 0;
        };

        // ---- CREATE INDEX ----

        def sq_exec_create_index(SQ_STMT* st, int unique) -> int
        {
            SQLITE_DB* db = st.db;
            SQ_SB sb;
            SQ_TCTX* tc;
            byte[72] iname;
            byte[72] tname;
            int ine, il, tl, istart, root, rc, k, tp, ixn, ok;
            ine = 0;
            if (sq_is_kw(st, "if\0"))
            {
                sq_next(st);
                sq_next(st);
                sq_next(st);
                ine = 1;
            };
            if (st.tk != 1) { sq_seterr(st, "expected an index name\0"); return 1; };
            il = st.tl;
            if (il > 62) { sq_seterr(st, "index name too long\0"); return 1; };
            for (k = 0; k < il; k++) { iname[k] = st.sql[st.ts + k]; };
            iname[il] = (byte)0;
            istart = sq_tok_start(st);
            if (il >= 7) { if (sq_ihas(@iname[0], 7, "sqlite_\0")) { sq_err_name(st, "object name reserved for internal use: \0", @iname[0], il, "\0"); return 1; }; };
            sq_next(st);
            if (sq_is_kw(st, "on\0") == false) { sq_seterr(st, "expected ON\0"); return 1; };
            sq_next(st);
            if (st.tk != 1) { sq_seterr(st, "expected a table name\0"); return 1; };
            tl = st.tl;
            if (tl > 62) { sq_seterr(st, "table name too long\0"); return 1; };
            for (k = 0; k < tl; k++) { tname[k] = st.sql[st.ts + k]; };
            tname[tl] = (byte)0;
            k = sq_obj_exists(db, @iname[0], il);
            if (k != 0)
            {
                if (ine == 1 & k == 2) { return 0; };
                sq_err_name(st, "index \0", @iname[0], il, " already exists\0");
                return 1;
            };
            tp = sq_find_table_n(db, @tname[0], tl);
            if (tp < 0) { sq_err_name(st, "no such table: \0", @tname[0], tl, "\0"); return 1; };
            sq_sb_init(@sb);
            if (unique == 1) { sq_sb_lit(@sb, "CREATE UNIQUE INDEX \0"); } else { sq_sb_lit(@sb, "CREATE INDEX \0"); };
            sq_tail_text(st, istart, @sb);
            if (sb.err != 0) { sq_sb_free(@sb); return 1; };
            // validate the column list before touching the file
            tc = (SQ_TCTX*)fmalloc((u64)(sizeof(SQ_TCTX) / 8 + 4096));
            if ((u64)tc == (u64)0) { sq_sb_free(@sb); return 1; };
            if (sq_tc_open(db, st, @tname[0], tl, tc) != 0) { sq_tc_free(tc); ffree((u64)tc); sq_sb_free(@sb); return 1; };
            root = sq_new_root(db, 10);
            if (root == 0) { sq_tc_free(tc); ffree((u64)tc); sq_sb_free(@sb); sq_seterr(st, "write error\0"); return 1; };
            if (sq_master_add(db, "index\0", @iname[0], @db.schema[tp].name[0], root, sb.p) != 0)
            {
                sq_tc_free(tc); ffree((u64)tc); sq_sb_free(@sb); sq_seterr(st, "write error\0"); return 1;
            };
            // a fresh table context sees the new index
            sq_tc_free(tc);
            sq_schema_load(db);
            if (sq_tc_open(db, st, @tname[0], tl, tc) != 0) { ffree((u64)tc); sq_sb_free(@sb); return 1; };
            ixn = 0 - 1;
            for (k = 0; k < tc.nix; k++)
            {
                if (sq_name_is(@iname[0], il, @tc.ix[k].name[0])) { ixn = k; };
            };
            ok = 1;
            if (ixn < 0) { sq_seterr(st, "cannot create index (expression and partial indexes are not supported)\0"); ok = 0; };
            if (ok == 1)
            {
                rc = sq_tc_rebuild(tc, @tc.ix[ixn]);
                if (rc == 4) { sq_err_unique(tc, @tc.ix[ixn], 0); ok = 0; };
                if (rc == 1) { sq_seterr(st, "index build failed\0"); ok = 0; };
            };
            sq_tc_free(tc);
            ffree((u64)tc);
            sq_sb_free(@sb);
            if (ok == 0) { return 1; };
            return 0;
        };

        // ---- CREATE VIEW ----

        def sq_exec_create_view(SQ_STMT* st) -> int
        {
            SQLITE_DB* db = st.db;
            SQ_SB sb;
            byte[72] name;
            int ine, nl, nstart, k;
            ine = 0;
            if (sq_is_kw(st, "if\0"))
            {
                sq_next(st);
                sq_next(st);
                sq_next(st);
                ine = 1;
            };
            if (st.tk != 1) { sq_seterr(st, "expected a view name\0"); return 1; };
            nl = st.tl;
            if (nl > 62) { sq_seterr(st, "view name too long\0"); return 1; };
            for (k = 0; k < nl; k++) { name[k] = st.sql[st.ts + k]; };
            name[nl] = (byte)0;
            nstart = sq_tok_start(st);
            k = sq_obj_exists(db, @name[0], nl);
            if (k != 0)
            {
                if (ine == 1 & k == 3) { return 0; };
                sq_err_name(st, "view \0", @name[0], nl, " already exists\0");
                return 1;
            };
            sq_next(st);
            if (sq_is_op(st, 40)) { while (st.tk != 0) { if (sq_is_op(st, 41)) { sq_next(st); break; }; sq_next(st); }; };
            if (sq_is_kw(st, "as\0") == false) { sq_seterr(st, "expected AS\0"); return 1; };
            sq_next(st);
            if (sq_is_kw(st, "select\0") == false & sq_is_kw(st, "with\0") == false & sq_is_kw(st, "values\0") == false)
            {
                sq_seterr(st, "expected a SELECT\0");
                return 1;
            };
            sq_sb_init(@sb);
            sq_sb_lit(@sb, "CREATE VIEW \0");
            sq_tail_text(st, nstart, @sb);
            if (sb.err != 0) { sq_sb_free(@sb); return 1; };
            k = sq_master_add(db, "view\0", @name[0], @name[0], 0, sb.p);
            sq_sb_free(@sb);
            if (k != 0) { sq_seterr(st, "write error\0"); return 1; };
            return 0;
        };

        // ---- DROP ----

        def sq_drop_obj_rows(SQLITE_DB* db, byte* name, byte* type) -> int
        {
            i64 rid;
            rid = sq_master_find(db, name, sq_cstrlen(name), type);
            if (rid < (i64)0) { return 0; };
            if (sq_btree_delete(db, 1, rid) != 0) { return 1; };
            db.cookie = db.cookie + 1;
            return 0;
        };

        def sq_exec_drop(SQ_STMT* st) -> int
        {
            SQLITE_DB* db = st.db;
            SQ_TCTX tc;
            byte[72] name;
            int kind, ie, nl, k, i, pos, rc;
            i64 sr, rid;
            kind = 0;
            if (sq_is_kw(st, "table\0")) { kind = 1; };
            if (sq_is_kw(st, "index\0")) { kind = 2; };
            if (sq_is_kw(st, "view\0")) { kind = 3; };
            if (kind == 0) { sq_seterr(st, "only DROP TABLE, INDEX and VIEW are supported\0"); return 1; };
            sq_next(st);
            ie = 0;
            if (sq_is_kw(st, "if\0")) { sq_next(st); sq_next(st); ie = 1; };
            if (st.tk != 1) { sq_seterr(st, "expected a name\0"); return 1; };
            nl = st.tl;
            if (nl > 62) { sq_seterr(st, "name too long\0"); return 1; };
            for (k = 0; k < nl; k++) { name[k] = st.sql[st.ts + k]; };
            name[nl] = (byte)0;
            pos = 0 - 1;
            for (i = 0; i < db.nschema; i++)
            {
                if (db.schema[i].kind == kind & sq_name_is(@name[0], nl, @db.schema[i].name[0])) { pos = i; };
            };
            if (pos < 0)
            {
                if (ie == 1) { return 0; };
                if (kind == 1) { sq_err_name(st, "no such table: \0", @name[0], nl, "\0"); };
                if (kind == 2) { sq_err_name(st, "no such index: \0", @name[0], nl, "\0"); };
                if (kind == 3) { sq_err_name(st, "no such view: \0", @name[0], nl, "\0"); };
                return 1;
            };
            if (kind == 3)
            {
                return sq_drop_obj_rows(db, @db.schema[pos].name[0], "view\0");
            };
            if (kind == 2)
            {
                if ((u64)db.schema[pos].sql == (u64)0)
                {
                    sq_seterr(st, "index associated with UNIQUE or PRIMARY KEY constraint cannot be dropped\0");
                    return 1;
                };
                if (sq_tree_free(db, db.schema[pos].rootpage, 0, 0, 0) != 0) { sq_seterr(st, "write error\0"); return 1; };
                return sq_drop_obj_rows(db, @db.schema[pos].name[0], "index\0");
            };
            // table
            if (sq_ihas(@db.schema[pos].name[0], 7, "sqlite_\0"))
            {
                if (db.schema[pos].name[0] == (byte)115 & db.schema[pos].name[1] == (byte)113)
                {
                    sq_err_name(st, "table \0", @name[0], nl, " may not be dropped\0");
                    return 1;
                };
            };
            for (i = 0; i < db.nschema; i++)
            {
                if (db.schema[i].kind == 4)
                {
                    if (sq_streq(@db.schema[i].tbl_name[0], @db.schema[pos].name[0])) { sq_seterr(st, "tables with triggers are not supported\0"); return 1; };
                };
            };
            for (i = 0; i < db.nschema; i++)
            {
                if (db.schema[i].kind == 2)
                {
                    if (sq_streq(@db.schema[i].tbl_name[0], @db.schema[pos].name[0]))
                    {
                        if (sq_tree_free(db, db.schema[i].rootpage, 0, 0, 0) != 0) { sq_seterr(st, "write error\0"); return 1; };
                        if (sq_drop_obj_rows(db, @db.schema[i].name[0], "index\0") != 0) { sq_seterr(st, "write error\0"); return 1; };
                    };
                };
            };
            if (sq_tree_free(db, db.schema[pos].rootpage, 0, 0, 0) != 0) { sq_seterr(st, "write error\0"); return 1; };
            if (sq_drop_obj_rows(db, @db.schema[pos].name[0], "table\0") != 0) { sq_seterr(st, "write error\0"); return 1; };
            // the AUTOINCREMENT counter goes with the table
            k = sq_find_table_n(db, "sqlite_sequence\0", 15);
            if (k >= 0)
            {
                tc.db = db; tc.st = st; tc.seqroot = db.schema[k].rootpage;
                for (i = 0; i < 64; i++) { tc.tname[i] = db.schema[pos].name[i]; };
                if (sq_seq_read(@tc, @rid) >= (i64)0 | rid >= (i64)0)
                {
                    if (rid >= (i64)0) { sq_btree_delete(db, tc.seqroot, rid); };
                };
            };
            return 0;
        };

        // ---- ALTER TABLE ----

        // rewrites one name inside stored SQL: every identifier equal to old becomes new (already formatted text).
        // With firstonly the first match after the leading keywords is replaced (the table name).
        def sq_sql_rename(byte* s, byte* old, int ol, byte* nw, int nlen, int skiptok, SQ_SB* out) -> int
        {
            int i, end, ts, tl, kd, last, count, tokn, rep;
            end = sq_cstrlen(s);
            i = 0;
            last = 0;
            count = 0;
            tokn = 0;
            while (i < end)
            {
                i = sq_tok2(s, i, end, @ts, @tl, @kd);
                if (kd == 0) { break; };
                tokn++;
                rep = 0;
                if (tokn > skiptok)
                {
                    if (kd == 1) { if (sq_tname_eq(s, ts, tl, old, 0, ol)) { rep = 1; }; };
                    if (kd == 2) { if (sq_tname_eq(s, ts + 1, tl - 2, old, 0, ol)) { rep = 1; }; };
                };
                if (rep == 1)
                {
                    sq_sb_add(out, @s[last], ts - last);
                    sq_sb_add(out, nw, nlen);
                    last = ts + tl;
                    count++;
                };
                if (kd == 4)
                {
                    // descend into a parenthesised group by re-scanning its contents
                    i = ts + 1;
                };
            };
            sq_sb_add(out, @s[last], end - last);
            return count;
        };

        // replaces the first identifier equal to old after skiptok tokens (the table name in CREATE TABLE <name>)
        def sq_sql_first_rename(byte* s, byte* old, int ol, byte* nw, int nlen, int skiptok, SQ_SB* out) -> int
        {
            int i, end, ts, tl, kd, tokn, rep;
            end = sq_cstrlen(s);
            i = 0;
            tokn = 0;
            while (i < end)
            {
                i = sq_tok2(s, i, end, @ts, @tl, @kd);
                if (kd == 0) { break; };
                tokn++;
                if (tokn <= skiptok) { continue; };
                rep = 0;
                if (kd == 1) { if (sq_tname_eq(s, ts, tl, old, 0, ol)) { rep = 1; }; };
                if (kd == 2) { if (sq_tname_eq(s, ts + 1, tl - 2, old, 0, ol)) { rep = 1; }; };
                if (rep == 1)
                {
                    sq_sb_add(out, s, ts);
                    sq_sb_add(out, nw, nlen);
                    sq_sb_add(out, @s[ts + tl], end - ts - tl);
                    return 1;
                };
                break;
            };
            return 0;
        };

        // CREATE [UNIQUE] INDEX name ON table (...): replaces the table name after ON
        def sq_sql_after_on(byte* s, byte* old, int ol, byte* nw, int nlen, SQ_SB* out) -> void
        {
            int i, end, ts, tl, kd, seen;
            end = sq_cstrlen(s);
            i = 0;
            seen = 0;
            while (i < end)
            {
                i = sq_tok2(s, i, end, @ts, @tl, @kd);
                if (kd == 0) { break; };
                if (seen == 1)
                {
                    sq_sb_add(out, s, ts);
                    sq_sb_add(out, nw, nlen);
                    sq_sb_add(out, @s[ts + tl], end - ts - tl);
                    return;
                };
                if (kd == 1) { if (sq_ieq(@s[ts], tl, "on\0")) { seen = 1; }; };
            };
            sq_sb_add(out, s, end);
        };

        def sq_end_check(SQ_STMT* st) -> int;

        // ---- ALTER TABLE ... DROP COLUMN ----

        // offset of the first depth-0 comma or unmatched ')' at or after pos in sql
        def sq_def_end(byte* s, int pos) -> int
        {
            int i, end, ts, tl, kd;
            end = sq_cstrlen(s);
            i = pos;
            while (i < end)
            {
                i = sq_tok2(s, i, end, @ts, @tl, @kd);
                if (kd == 0) { break; };
                if (kd == 5)
                {
                    if (s[ts] == (byte)41 | s[ts] == (byte)44) { return ts; };
                };
            };
            return end;
        };

        // start of the name token of column c as written in the stored text (a quoted name starts at its quote)
        def sq_col_tok_start(SQ_TI* ti, int c) -> int
        {
            int a = ti.cs[c];
            if (a > 0)
            {
                if (ti.base[a - 1] == (byte)34 | ti.base[a - 1] == (byte)96 | ti.base[a - 1] == (byte)91) { return a - 1; };
            };
            return a;
        };

        // rewrites every row of the table without column c
        def sq_drop_rewrite(SQLITE_DB* db, SQ_STMT* st, SQ_TCTX* tc, int c) -> int
        {
            SQ_CURSOR cur;
            SQ_ARENA ar;
            SQ_VAL* vals;
            SQ_VAL* nv;
            i64* ids;
            byte* rec;
            int n, cap, r, k, m, rn, i, nc, ipk;
            i64 rid;
            nc = tc.ncols;
            ipk = tc.ti.ipk;
            cap = 1024; n = 0;
            ids = (i64*)fmalloc((u64)cap * (u64)8);
            if ((u64)ids == (u64)0) { sq_seterr(st, "out of memory\0"); return 1; };
            sq_cur_open(@cur, db, tc.root);
            r = sq_cur_first(@cur);
            while (r == 1)
            {
                if (n >= cap)
                {
                    i64* g = (i64*)fmalloc((u64)cap * (u64)16);
                    if ((u64)g == (u64)0) { sq_cur_close(@cur); ffree((u64)ids); sq_seterr(st, "out of memory\0"); return 1; };
                    for (i = 0; i < n; i++) { g[i] = ids[i]; };
                    ffree((u64)ids);
                    ids = g;
                    cap = cap * 2;
                };
                ids[n] = cur.rowid;
                n++;
                r = sq_cur_next(@cur);
            };
            sq_cur_close(@cur);
            vals = (SQ_VAL*)fmalloc((u64)(nc + 2) * (u64)sizeof(SQ_VAL));
            nv = (SQ_VAL*)fmalloc((u64)(nc + 2) * (u64)sizeof(SQ_VAL));
            if ((u64)vals == (u64)0 | (u64)nv == (u64)0) { ffree((u64)ids); sq_seterr(st, "out of memory\0"); return 1; };
            for (i = 0; i < n; i++)
            {
                rid = ids[i];
                sq_ar_init(@ar);
                sq_cur_open(@cur, db, tc.root);
                r = sq_cur_seek(@cur, rid);
                if (r != 1) { sq_cur_close(@cur); sq_ar_free(@ar); continue; };
                m = cur.ncols;
                if (m > nc) { m = nc; };
                sq_tc_row(tc, @cur, @ar, vals);
                sq_cur_close(@cur);
                rn = 0;
                for (k = 0; k < m; k++)
                {
                    if (k == c) { continue; };
                    sq_val_copy(@nv[rn], @vals[k]);
                    if (k == ipk) { sq_val_null(@nv[rn]); };
                    rn++;
                };
                rec = (byte*)fmalloc((u64)(sq_rec_size(nv, rn) + 8));
                if ((u64)rec == (u64)0) { sq_ar_free(@ar); ffree((u64)ids); ffree((u64)vals); ffree((u64)nv); sq_seterr(st, "out of memory\0"); return 1; };
                sq_rec_write(nv, rn, rec);
                k = sq_rec_size(nv, rn);
                if (sq_btree_delete(db, tc.root, rid) == 2) { ffree((u64)rec); sq_ar_free(@ar); ffree((u64)ids); ffree((u64)vals); ffree((u64)nv); sq_seterr(st, "write error\0"); return 1; };
                r = sq_btree_insert(db, tc.root, rid, rec, k);
                ffree((u64)rec);
                sq_ar_free(@ar);
                if (r != 0) { ffree((u64)ids); ffree((u64)vals); ffree((u64)nv); sq_seterr(st, "write error\0"); return 1; };
            };
            ffree((u64)ids); ffree((u64)vals); ffree((u64)nv);
            return 0;
        };

        // error "error in <what> <name> after drop column: <msg>"
        def sq_drop_err(SQ_STMT* st, byte* what, byte* name, byte* msg) -> void
        {
            SQ_SB b;
            sq_sb_init(@b);
            sq_sb_lit(@b, "error in \0");
            sq_sb_lit(@b, what);
            sq_sb_lit(@b, " \0");
            sq_sb_lit(@b, name);
            sq_sb_lit(@b, " after drop column: \0");
            sq_sb_lit(@b, msg);
            st.err[0] = (byte)0;
            sq_seterr(st, b.p);
            sq_sb_free(@b);
        };

        def sq_exec_drop_column(SQ_STMT* st, int tp, byte* tname, int tl) -> int
        {
            SQLITE_DB* db = st.db;
            SQ_TCTX tc;
            SQ_TCTX tc2;
            SQ_CHK chk;
            SQ_SB nsql, vq;
            SQ_STMT* vs;
            byte[160] oc;
            int ocl, c, k, i, g, a, b2, rc, last, e, nuq, u, hit, sidx;
            i64 rid;
            byte* sql;
            sq_next(st);
            if (sq_is_kw(st, "column\0")) { sq_next(st); };
            if (st.tk != 1) { sq_seterr(st, "expected a column name\0"); return 1; };
            ocl = st.tl;
            if (ocl > 150) { sq_seterr(st, "name too long\0"); return 1; };
            for (k = 0; k < ocl; k++) { oc[k] = st.sql[st.ts + k]; };
            oc[ocl] = (byte)0;
            sq_next(st);
            if (sq_end_check(st) != 0) { return 1; };
            if (sq_ihas(@db.schema[tp].name[0], 7, "sqlite_\0")) { sq_seterr(st, "table may not be altered\0"); return 1; };
            if (sq_tc_open(db, st, tname, tl, @tc) != 0) { sq_tc_free(@tc); return 1; };
            c = sq_ti_find(tc.ti, @oc[0], 0, ocl);
            if (c < 0) { sq_err_name(st, "no such column: \"\0", @oc[0], ocl, "\"\0"); sq_tc_free(@tc); return 1; };
            if (tc.ti.pk[c] != 0) { sq_err_name(st, "cannot drop PRIMARY KEY column: \"\0", @oc[0], ocl, "\"\0"); sq_tc_free(@tc); return 1; };
            if (tc.ti.uniq[c] != 0) { sq_err_name(st, "cannot drop UNIQUE column: \"\0", @oc[0], ocl, "\"\0"); sq_tc_free(@tc); return 1; };
            if (tc.ncols <= 1) { sq_err_name(st, "cannot drop column \"\0", @oc[0], ocl, "\": no other columns exist\0"); sq_tc_free(@tc); return 1; };
            // table level UNIQUE constraints that name the column
            g = 0;
            for (u = 0; u < tc.ti.nuq; u++)
            {
                for (k = 0; k < tc.ti.uqn[u]; k++)
                {
                    if (tc.ti.uqc[g + k] == c)
                    {
                        sq_sb_init(@vq);
                        sq_sb_lit(@vq, "no such column: \0");
                        sq_sb_add(@vq, @oc[0], ocl);
                        sq_drop_err(st, "table\0", tname, vq.p);
                        sq_sb_free(@vq);
                        sq_tc_free(@tc);
                        return 1;
                    };
                };
                g = g + tc.ti.uqn[u];
            };
            // the new table text
            sql = db.schema[tp].sql;
            sq_sb_init(@nsql);
            a = sq_col_tok_start(tc.ti, c);
            if (c < tc.ncols - 1)
            {
                b2 = sq_col_tok_start(tc.ti, c + 1);
                sq_sb_add(@nsql, sql, a);
                sq_sb_add(@nsql, @sql[b2], sq_cstrlen(sql) - b2);
            }
            else
            {
                b2 = sq_def_end(sql, tc.ti.cs[c]);
                while (a > 0 & sql[a] != (byte)44) { a--; };
                sq_sb_add(@nsql, sql, a);
                sq_sb_add(@nsql, @sql[b2], sq_cstrlen(sql) - b2);
            };
            if (nsql.err != 0) { sq_sb_free(@nsql); sq_tc_free(@tc); sq_seterr(st, "out of memory\0"); return 1; };
            // the rows
            if (sq_drop_rewrite(db, st, @tc, c) != 0) { sq_sb_free(@nsql); sq_tc_free(@tc); return 1; };
            rid = sq_master_find(db, tname, tl, "table\0");
            if (rid < (i64)0) { sq_sb_free(@nsql); sq_tc_free(@tc); sq_seterr(st, "alter failed\0"); return 1; };
            rc = sq_master_replace(db, rid, "table\0", @db.schema[tp].name[0], @db.schema[tp].name[0], db.schema[tp].rootpage, nsql.p);
            sq_sb_free(@nsql);
            sq_tc_free(@tc);
            if (rc != 0) { sq_seterr(st, "write error\0"); return 1; };
            sq_schema_load(db);
            // everything that was built on the old text must still resolve
            for (i = 0; i < db.nschema; i++)
            {
                if (db.schema[i].kind == 1)
                {
                    if (sq_streq(@db.schema[i].name[0], tname) == false) { continue; };
                    // CHECK constraints must still resolve
                    {
                        SQ_TI* t3;
                        byte[300] em;
                        t3 = (SQ_TI*)fmalloc((u64)(sizeof(SQ_TI) / 8 + 4096));
                        if ((u64)t3 == (u64)0) { sq_seterr(st, "out of memory\0"); return 1; };
                        if (sq_ti_load(t3, db.schema[i].sql) != 0) { ffree((u64)t3); sq_drop_err(st, "table\0", tname, "cannot read the table definition\0"); return 1; };
                        tc2.db = db; tc2.st = st; tc2.ti = t3; tc2.ncols = t3.ncols;
                        rc = sq_chk_open(@tc2, @chk);
                        if (rc != 0)
                        {
                            for (k = 0; k < 290; k++) { em[k] = st.err[k]; if (st.err[k] == (byte)0) { break; }; };
                            em[290] = (byte)0;
                            sq_chk_close(@chk);
                            ffree((u64)t3);
                            sq_drop_err(st, "table\0", tname, @em[0]);
                            return 1;
                        };
                        sq_chk_close(@chk);
                        ffree((u64)t3);
                    };
                };
                if (db.schema[i].kind == 2)
                {
                    if (sq_streq(@db.schema[i].tbl_name[0], tname) == false) { continue; };
                    if ((u64)db.schema[i].sql == (u64)0) { continue; };
                    {
                        SQ_TI* t4;
                        SQ_IDX* ixa;
                        int nn, q, bad;
                        t4 = (SQ_TI*)fmalloc((u64)(sizeof(SQ_TI) / 8 + 4096));
                        ixa = (SQ_IDX*)fmalloc((u64)20 * (u64)sizeof(SQ_IDX));
                        if ((u64)t4 == (u64)0 | (u64)ixa == (u64)0) { sq_seterr(st, "out of memory\0"); return 1; };
                        sq_ti_load(t4, db.schema[tp].sql);
                        nn = sq_idx_list(db, sq_find_table_n(db, tname, tl), t4, ixa, 20);
                        bad = 0;
                        for (q = 0; q < nn; q++)
                        {
                            if (ixa[q].schema_pos == i) { if (ixa[q].ok == 0) { bad = 1; }; };
                        };
                        ffree((u64)t4); ffree((u64)ixa);
                        if (bad == 1)
                        {
                            sq_sb_init(@vq);
                            sq_sb_lit(@vq, "no such column: \0");
                            sq_sb_add(@vq, @oc[0], ocl);
                            sq_drop_err(st, "index\0", @db.schema[i].name[0], vq.p);
                            sq_sb_free(@vq);
                            return 1;
                        };
                    };
                };
                if (db.schema[i].kind == 3)
                {
                    sq_sb_init(@vq);
                    sq_sb_lit(@vq, "select * from \"\0");
                    sq_sb_add(@vq, @db.schema[i].name[0], sq_cstrlen(@db.schema[i].name[0]));
                    sq_sb_lit(@vq, "\"\0");
                    vs = sq_stmt_new();
                    if ((u64)vs == (u64)0) { sq_sb_free(@vq); sq_seterr(st, "out of memory\0"); return 1; };
                    rc = sq_prep_query(vs, db, vq.p);
                    sq_sb_free(@vq);
                    if (rc != 0)
                    {
                        sq_drop_err(st, "view\0", @db.schema[i].name[0], @vs.err[0]);
                        sq_stmt_del(vs);
                        return 1;
                    };
                    sq_stmt_del(vs);
                };
            };
            return 0;
        };

        def sq_exec_alter(SQ_STMT* st) -> int
        {
            SQLITE_DB* db = st.db;
            SQ_TCTX tc;
            SQ_SB sb, nsql, q;
            byte[72] tname;
            byte[72] nname;
            byte[160] oc;
            byte[160] ncn;
            int tl, tp, k, i, nl, ocl, ncl, c, es, rc, lastp, cstart, e;
            i64 rid;
            byte* sql;
            if (sq_is_kw(st, "table\0") == false) { sq_seterr(st, "only ALTER TABLE is supported\0"); return 1; };
            sq_next(st);
            if (st.tk != 1) { sq_seterr(st, "expected a table name\0"); return 1; };
            tl = st.tl;
            if (tl > 62) { sq_seterr(st, "table name too long\0"); return 1; };
            for (k = 0; k < tl; k++) { tname[k] = st.sql[st.ts + k]; };
            tname[tl] = (byte)0;
            tp = sq_find_table_n(db, @tname[0], tl);
            if (tp < 0) { sq_err_name(st, "no such table: \0", @tname[0], tl, "\0"); return 1; };
            sq_next(st);
            if (sq_is_kw(st, "rename\0"))
            {
                sq_next(st);
                if (sq_is_kw(st, "to\0"))
                {
                    sq_next(st);
                    if (st.tk != 1) { sq_seterr(st, "expected a table name\0"); return 1; };
                    nl = st.tl;
                    if (nl > 50) { sq_seterr(st, "table name too long\0"); return 1; };
                    for (k = 0; k < nl; k++) { nname[k] = st.sql[st.ts + k]; };
                    nname[nl] = (byte)0;
                    if (sq_obj_exists(db, @nname[0], nl) != 0) { sq_err_name(st, "there is already another table or index with this name: \0", @nname[0], nl, "\0"); return 1; };
                    if (sq_ihas(@nname[0], 7, "sqlite_\0")) { sq_err_name(st, "object name reserved for internal use: \0", @nname[0], nl, "\0"); return 1; };
                    if (sq_ihas(@db.schema[tp].name[0], 7, "sqlite_\0")) { sq_seterr(st, "table may not be altered\0"); return 1; };
                    // quoted new name
                    sq_sb_init(@q);
                    sq_sb_lit(@q, "\"\0");
                    sq_sb_add(@q, @nname[0], nl);
                    sq_sb_lit(@q, "\"\0");
                    // the table row
                    sql = db.schema[tp].sql;
                    sq_sb_init(@nsql);
                    // tokens: CREATE TABLE name
                    rid = sq_master_find(db, @tname[0], tl, "table\0");
                    if (rid < (i64)0) { sq_seterr(st, "rename failed\0"); return 1; };
                    i = sq_sql_first_rename(sql, @tname[0], tl, q.p, q.n, 2, @nsql);
                    if (i == 0) { sq_seterr(st, "rename failed\0"); return 1; };
                    if (sq_master_replace(db, rid, "table\0", @nname[0], @nname[0], db.schema[tp].rootpage, nsql.p) != 0) { sq_seterr(st, "write error\0"); return 1; };
                    sq_sb_free(@nsql);
                    // indexes
                    for (i = 0; i < db.nschema; i++)
                    {
                        if (db.schema[i].kind != 2) { continue; };
                        if (sq_streq(@db.schema[i].tbl_name[0], @tname[0]) == false) { continue; };
                        rid = sq_master_find(db, @db.schema[i].name[0], sq_cstrlen(@db.schema[i].name[0]), "index\0");
                        if (rid < (i64)0) { continue; };
                        sq_sb_init(@nsql);
                        if ((u64)db.schema[i].sql == (u64)0)
                        {
                            // sqlite_autoindex_<table>_<n>
                            k = sq_cstrlen(@db.schema[i].name[0]);
                            c = k;
                            while (c > 0 & sq_isdigit(db.schema[i].name[c - 1])) { c--; };
                            sq_sb_lit(@nsql, "sqlite_autoindex_\0");
                            sq_sb_add(@nsql, @nname[0], nl);
                            sq_sb_lit(@nsql, "_\0");
                            sq_sb_add(@nsql, @db.schema[i].name[c], k - c);
                            rc = sq_master_replace(db, rid, "index\0", nsql.p, @nname[0], db.schema[i].rootpage, (byte*)0);
                        }
                        else
                        {
                            // CREATE [UNIQUE] INDEX name ON table: the table name is the token after ON
                            sq_sql_after_on(db.schema[i].sql, @tname[0], tl, q.p, q.n, @nsql);
                            rc = sq_master_replace(db, rid, "index\0", @db.schema[i].name[0], @nname[0], db.schema[i].rootpage, nsql.p);
                        };
                        sq_sb_free(@nsql);
                        if (rc != 0) { sq_seterr(st, "write error\0"); return 1; };
                    };
                    // sqlite_sequence
                    k = sq_find_table_n(db, "sqlite_sequence\0", 15);
                    if (k >= 0)
                    {
                        tc.db = db; tc.st = st; tc.seqroot = db.schema[k].rootpage;
                        for (i = 0; i < 64; i++) { tc.tname[i] = db.schema[tp].name[i]; };
                        c = (int)sq_seq_read(@tc, @rid);
                        if (rid >= (i64)0)
                        {
                            for (i = 0; i < 64; i++) { tc.tname[i] = (byte)0; };
                            for (i = 0; i < nl; i++) { tc.tname[i] = nname[i]; };
                            if (sq_btree_delete(db, tc.seqroot, rid) != 0) { return 1; };
                            if (sq_seq_write(@tc, (i64)c) != 0) { return 1; };
                        };
                    };
                    sq_sb_free(@q);
                    return 0;
                };
                // RENAME [COLUMN] old TO new
                if (sq_is_kw(st, "column\0")) { sq_next(st); };
                if (st.tk != 1) { sq_seterr(st, "expected a column name\0"); return 1; };
                ocl = st.tl;
                if (ocl > 150) { sq_seterr(st, "name too long\0"); return 1; };
                for (k = 0; k < ocl; k++) { oc[k] = st.sql[st.ts + k]; };
                oc[ocl] = (byte)0;
                sq_next(st);
                if (sq_is_kw(st, "to\0") == false) { sq_seterr(st, "expected TO\0"); return 1; };
                sq_next(st);
                if (st.tk != 1) { sq_seterr(st, "expected a column name\0"); return 1; };
                es = sq_tok_start(st);
                ncl = st.tend - es;
                if (ncl > 150) { sq_seterr(st, "name too long\0"); return 1; };
                for (k = 0; k < ncl; k++) { ncn[k] = st.sql[es + k]; };
                ncn[ncl] = (byte)0;
                if (sq_tc_open(db, st, @tname[0], tl, @tc) != 0) { sq_tc_free(@tc); return 1; };
                c = sq_ti_find(tc.ti, @oc[0], 0, ocl);
                if (c < 0) { sq_err_name(st, "no such column: \0", @oc[0], ocl, "\0"); sq_tc_free(@tc); return 1; };
                if (sq_ti_find(tc.ti, st.sql, st.ts, st.tl) >= 0 & sq_tname_eq(@oc[0], 0, ocl, st.sql, st.ts, st.tl) == false)
                {
                    sq_err_name(st, "duplicate column name: \0", @st.sql[st.ts], st.tl, "\0");
                    sq_tc_free(@tc);
                    return 1;
                };
                sq_tc_free(@tc);
                // the table
                sql = db.schema[tp].sql;
                sq_sb_init(@nsql);
                sq_sql_rename(sql, @oc[0], ocl, @ncn[0], ncl, 3, @nsql);
                rid = sq_master_find(db, @tname[0], tl, "table\0");
                if (rid < (i64)0 | nsql.err != 0) { sq_seterr(st, "rename failed\0"); return 1; };
                rc = sq_master_replace(db, rid, "table\0", @db.schema[tp].name[0], @db.schema[tp].name[0], db.schema[tp].rootpage, nsql.p);
                sq_sb_free(@nsql);
                if (rc != 0) { sq_seterr(st, "write error\0"); return 1; };
                // indexes that name the column
                for (i = 0; i < db.nschema; i++)
                {
                    if (db.schema[i].kind != 2) { continue; };
                    if ((u64)db.schema[i].sql == (u64)0) { continue; };
                    if (sq_streq(@db.schema[i].tbl_name[0], @tname[0]) == false) { continue; };
                    rid = sq_master_find(db, @db.schema[i].name[0], sq_cstrlen(@db.schema[i].name[0]), "index\0");
                    if (rid < (i64)0) { continue; };
                    sq_sb_init(@nsql);
                    sq_sql_rename(db.schema[i].sql, @oc[0], ocl, @ncn[0], ncl, 6, @nsql);
                    rc = sq_master_replace(db, rid, "index\0", @db.schema[i].name[0], @db.schema[i].tbl_name[0], db.schema[i].rootpage, nsql.p);
                    sq_sb_free(@nsql);
                    if (rc != 0) { sq_seterr(st, "write error\0"); return 1; };
                };
                return 0;
            };
            if (sq_is_kw(st, "drop\0")) { return sq_exec_drop_column(st, tp, @tname[0], tl); };
            if (sq_is_kw(st, "add\0"))
            {
                sq_next(st);
                if (sq_is_kw(st, "column\0")) { sq_next(st); };
                cstart = sq_tok_start(st);
                if (st.tk != 1) { sq_seterr(st, "expected a column definition\0"); return 1; };
                sq_sb_init(@q);
                sq_tail_text(st, cstart, @q);
                if (sq_find_kw_in(q.p, q.n, "primary\0")) { sq_sb_free(@q); sq_seterr(st, "Cannot add a PRIMARY KEY column\0"); return 1; };
                if (sq_find_kw_in(q.p, q.n, "unique\0")) { sq_sb_free(@q); sq_seterr(st, "Cannot add a UNIQUE column\0"); return 1; };
                if (sq_find_kw_in(q.p, q.n, "current_\0")) { sq_sb_free(@q); sq_seterr(st, "Cannot add a column with non-constant default\0"); return 1; };
                if (sq_find_kw_in(q.p, q.n, "generated\0")) { sq_sb_free(@q); sq_seterr(st, "generated columns are not supported\0"); return 1; };
                if (sq_tc_open(db, st, @tname[0], tl, @tc) != 0) { sq_tc_free(@tc); sq_sb_free(@q); return 1; };
                // the new column name must be free
                es = st.ts;
                if (sq_ti_find(tc.ti, st.sql, st.ts, st.tl) >= 0)
                {
                    sq_err_name(st, "duplicate column name: \0", @st.sql[st.ts], st.tl, "\0");
                    sq_tc_free(@tc); sq_sb_free(@q);
                    return 1;
                };
                sq_tc_free(@tc);
                // new definition text: the old text with the column inserted before the last ')'
                sql = db.schema[tp].sql;
                e = sq_cstrlen(sql);
                lastp = 0 - 1;
                for (i = 0; i < e; i++) { if (sql[i] == (byte)41) { lastp = i; }; };
                if (lastp < 0) { sq_sb_free(@q); sq_seterr(st, "cannot read the table definition\0"); return 1; };
                sq_sb_init(@nsql);
                sq_sb_add(@nsql, sql, lastp);
                sq_sb_lit(@nsql, ", \0");
                sq_sb_add(@nsql, q.p, q.n);
                sq_sb_add(@nsql, @sql[lastp], e - lastp);
                sq_sb_free(@q);
                // validate: NOT NULL columns need a non-NULL default
                {
                    SQ_TI* t2;
                    t2 = (SQ_TI*)fmalloc((u64)(sizeof(SQ_TI) / 8 + 4096));
                    if ((u64)t2 == (u64)0) { sq_sb_free(@nsql); return 1; };
                    if (sq_ti_load(t2, nsql.p) != 0) { ffree((u64)t2); sq_sb_free(@nsql); sq_seterr(st, "unsupported column definition\0"); return 1; };
                    c = t2.ncols - 1;
                    if (t2.notnull[c] == 1)
                    {
                        if (t2.dfl[c] <= 0) { ffree((u64)t2); sq_sb_free(@nsql); sq_seterr(st, "Cannot add a NOT NULL column with default value NULL\0"); return 1; };
                        if (sq_ieq(@t2.base[t2.dfs[c]], t2.dfl[c], "null\0")) { ffree((u64)t2); sq_sb_free(@nsql); sq_seterr(st, "Cannot add a NOT NULL column with default value NULL\0"); return 1; };
                    };
                    ffree((u64)t2);
                };
                rid = sq_master_find(db, @tname[0], tl, "table\0");
                if (rid < (i64)0) { sq_sb_free(@nsql); sq_seterr(st, "alter failed\0"); return 1; };
                rc = sq_master_replace(db, rid, "table\0", @db.schema[tp].name[0], @db.schema[tp].name[0], db.schema[tp].rootpage, nsql.p);
                sq_sb_free(@nsql);
                if (rc != 0) { sq_seterr(st, "write error\0"); return 1; };
                return 0;
            };
            sq_seterr(st, "unsupported ALTER TABLE (only RENAME TO, RENAME COLUMN, ADD COLUMN and DROP COLUMN)\0");
            return 1;
        };


        // ---- statement dispatcher ----

        def sq_end_check(SQ_STMT* st) -> int
        {
            if (sq_is_op(st, 59)) { sq_next(st); };
            if (st.tk != 0) { sq_seterr(st, "unexpected text after the end of the statement\0"); return 1; };
            return 0;
        };

        // reads "OR <action>" after INSERT / UPDATE: 0 abort, 1 rollback, 2 fail, 3 ignore, 4 replace
        def sq_read_conflict(SQ_STMT* st) -> int
        {
            int r = 0;
            if (sq_is_kw(st, "or\0"))
            {
                sq_next(st);
                if (sq_is_kw(st, "abort\0")) { r = 0; };
                if (sq_is_kw(st, "rollback\0")) { r = 1; };
                if (sq_is_kw(st, "fail\0")) { r = 2; };
                if (sq_is_kw(st, "ignore\0")) { r = 3; };
                if (sq_is_kw(st, "replace\0")) { r = 4; };
                sq_next(st);
            };
            return r;
        };

        // table name after INSERT INTO / UPDATE / DELETE FROM; a leading "main." is skipped. Returns 0 on success.
        def sq_read_table_name(SQ_STMT* st, byte* name, int* nl) -> int
        {
            int k;
            if (st.tk != 1) { sq_seterr(st, "expected a table name\0"); return 1; };
            if (sq_peek_op(st, 46))
            {
                sq_next(st);
                sq_next(st);
                if (st.tk != 1) { sq_seterr(st, "expected a table name\0"); return 1; };
            };
            if (st.tl > 62) { sq_seterr(st, "table name too long\0"); return 1; };
            for (k = 0; k < st.tl; k++) { name[k] = st.sql[st.ts + k]; };
            name[st.tl] = (byte)0;
            *nl = st.tl;
            sq_next(st);
            return 0;
        };

        // runs one DML or DDL statement; the transaction around it is handled by the caller
        def sq_dispatch(SQ_STMT* st) -> int
        {
            SQLITE_DB* db = st.db;
            SQ_TCTX* tc;
            byte[72] name;
            int nl, oc, rc, unique, isreplace;
            if (sq_is_kw(st, "create\0"))
            {
                sq_next(st);
                if (sq_is_kw(st, "temp\0") | sq_is_kw(st, "temporary\0")) { sq_seterr(st, "temporary objects are not supported\0"); return 1; };
                if (sq_is_kw(st, "table\0")) { sq_next(st); return sq_exec_create_table(st); };
                unique = 0;
                if (sq_is_kw(st, "unique\0")) { unique = 1; sq_next(st); };
                if (sq_is_kw(st, "index\0")) { sq_next(st); return sq_exec_create_index(st, unique); };
                if (sq_is_kw(st, "view\0")) { sq_next(st); return sq_exec_create_view(st); };
                if (sq_is_kw(st, "virtual\0")) { sq_seterr(st, "virtual tables are not supported\0"); return 1; };
                if (sq_is_kw(st, "trigger\0")) { sq_seterr(st, "triggers are not supported\0"); return 1; };
                sq_seterr(st, "unsupported CREATE statement\0");
                return 1;
            };
            if (sq_is_kw(st, "drop\0")) { sq_next(st); return sq_exec_drop(st); };
            if (sq_is_kw(st, "alter\0")) { sq_next(st); return sq_exec_alter(st); };
            isreplace = 0;
            if (sq_is_kw(st, "replace\0")) { isreplace = 1; };
            if (sq_is_kw(st, "insert\0") | isreplace == 1)
            {
                sq_next(st);
                oc = sq_read_conflict(st);
                if (isreplace == 1) { oc = 4; };
                if (sq_is_kw(st, "into\0") == false) { sq_seterr(st, "expected INTO\0"); return 1; };
                sq_next(st);
                if (sq_read_table_name(st, @name[0], @nl) != 0) { return 1; };
                if (sq_is_kw(st, "as\0")) { sq_next(st); sq_next(st); };
                tc = (SQ_TCTX*)fmalloc((u64)(sizeof(SQ_TCTX) / 8 + 4096));
                if ((u64)tc == (u64)0) { sq_seterr(st, "out of memory\0"); return 1; };
                tc.ti = (SQ_TI*)0;
                rc = sq_tc_open(db, st, @name[0], nl, tc);
                if (rc == 0) { rc = sq_exec_insert(st, tc, oc, @name[0], nl); };
                if (rc == 0) { rc = sq_tc_finish(tc); };
                sq_tc_free(tc);
                ffree((u64)tc);
                return rc;
            };
            if (sq_is_kw(st, "update\0"))
            {
                sq_next(st);
                oc = sq_read_conflict(st);
                if (sq_read_table_name(st, @name[0], @nl) != 0) { return 1; };
                tc = (SQ_TCTX*)fmalloc((u64)(sizeof(SQ_TCTX) / 8 + 4096));
                if ((u64)tc == (u64)0) { sq_seterr(st, "out of memory\0"); return 1; };
                tc.ti = (SQ_TI*)0;
                rc = sq_tc_open(db, st, @name[0], nl, tc);
                if (rc == 0) { rc = sq_exec_update(st, tc, oc, @name[0], nl); };
                sq_tc_free(tc);
                ffree((u64)tc);
                return rc;
            };
            if (sq_is_kw(st, "delete\0"))
            {
                sq_next(st);
                if (sq_is_kw(st, "from\0") == false) { sq_seterr(st, "expected FROM\0"); return 1; };
                sq_next(st);
                if (sq_read_table_name(st, @name[0], @nl) != 0) { return 1; };
                tc = (SQ_TCTX*)fmalloc((u64)(sizeof(SQ_TCTX) / 8 + 4096));
                if ((u64)tc == (u64)0) { sq_seterr(st, "out of memory\0"); return 1; };
                tc.ti = (SQ_TI*)0;
                rc = sq_tc_open(db, st, @name[0], nl, tc);
                if (rc == 0) { rc = sq_exec_delete(st, tc, @name[0], nl); };
                sq_tc_free(tc);
                ffree((u64)tc);
                return rc;
            };
            sq_seterr(st, "unsupported statement\0");
            return 1;
        };

        // PRAGMAs that only tune behaviour this library does not have are accepted and ignored
        def sq_exec_pragma(SQ_STMT* st) -> int
        {
            SQLITE_DB* db = st.db;
            byte* p;
            int l;
            i64 v;
            byte* pg;
            if (st.tk != 1) { sq_seterr(st, "expected a pragma name\0"); return 1; };
            p = @st.sql[st.ts];
            l = st.tl;
            if (sq_ieq(p, l, "user_version\0"))
            {
                sq_next(st);
                if (sq_is_op(st, 61) == false) { return 0; };
                sq_next(st);
                if (st.tk != 2) { sq_seterr(st, "expected a number\0"); return 1; };
                v = sq_atoi(@st.sql[st.ts], st.tl);
                pg = sq_page(db, 1);
                if ((u64)pg == (u64)0) { return 1; };
                if (sq_before_write(db, 1) != 0) { return 1; };
                {
                    int i;
                    for (i = 0; i < db.page_size; i++) { db.wbuf[i] = pg[i]; };
                };
                sq_put32(@db.wbuf[60], (int)v);
                if (sq_page_write(db, 1, db.wbuf) != 0) { return 1; };
                return 0;
            };
            if (sq_ieq(p, l, "foreign_keys\0") | sq_ieq(p, l, "synchronous\0") | sq_ieq(p, l, "journal_mode\0") | sq_ieq(p, l, "locking_mode\0") | sq_ieq(p, l, "cache_size\0") | sq_ieq(p, l, "temp_store\0") | sq_ieq(p, l, "busy_timeout\0") | sq_ieq(p, l, "recursive_triggers\0") | sq_ieq(p, l, "case_sensitive_like\0") | sq_ieq(p, l, "secure_delete\0") | sq_ieq(p, l, "mmap_size\0") | sq_ieq(p, l, "wal_autocheckpoint\0") | sq_ieq(p, l, "automatic_index\0"))
            {
                return 0;
            };
            sq_seterr(st, "unsupported PRAGMA\0");
            return 1;
        };

        // ---- parameters in DML statements ----

        // Rewrites ?, ?N, :name, @name and $name into explicit ?N form so that any slice of the statement keeps the numbering.
        // Names are kept after the end of the text so sq_param_index still finds them. Returns 0 on success.
        def sq_rewrite_params(SQ_STMT* st) -> int
        {
            byte* out;
            int i, n, o, maxp, idx, k, j, d, l, nn, q;
            byte c;
            int[64] ns, nl;
            n = st.sqllen;
            out = (byte*)fmalloc((u64)(n * 2 + 400));
            if ((u64)out == (u64)0) { sq_seterr(st, "out of memory\0"); return 1; };
            o = 0;
            i = 0;
            maxp = 0;
            nn = 0;
            while (i < n)
            {
                c = st.sql[i];
                if (c == (byte)39 | c == (byte)34 | c == (byte)96 | c == (byte)91)
                {
                    q = (int)c;
                    if (c == (byte)91) { q = 93; };
                    out[o] = c; o++; i++;
                    while (i < n & (int)st.sql[i] != q) { out[o] = st.sql[i]; o++; i++; };
                    if (i < n) { out[o] = st.sql[i]; o++; i++; };
                    continue;
                };
                if (c == (byte)45 & i + 1 < n)
                {
                    if (st.sql[i + 1] == (byte)45)
                    {
                        while (i < n & st.sql[i] != (byte)10) { out[o] = st.sql[i]; o++; i++; };
                        continue;
                    };
                };
                if (c == (byte)47 & i + 1 < n)
                {
                    if (st.sql[i + 1] == (byte)42)
                    {
                        out[o] = st.sql[i]; o++; i++;
                        out[o] = st.sql[i]; o++; i++;
                        while (i + 1 < n)
                        {
                            if (st.sql[i] == (byte)42 & st.sql[i + 1] == (byte)47) { break; };
                            out[o] = st.sql[i]; o++; i++;
                        };
                        continue;
                    };
                };
                idx = 0;
                if (c == (byte)63)
                {
                    j = i + 1;
                    d = 0;
                    while (j < n & sq_isdigit(st.sql[j])) { d = d * 10 + (int)st.sql[j] - 48; j++; if (d > 100000) { d = 100000; }; };
                    if (j > i + 1)
                    {
                        idx = d;
                        if (idx < 1 | idx > 64) { ffree((u64)out); sq_seterr(st, "parameter index out of range\0"); return 1; };
                        if (idx > maxp) { maxp = idx; };
                        while (i < j) { out[o] = st.sql[i]; o++; i++; };
                        continue;
                    };
                    maxp++;
                    idx = maxp;
                };
                if (idx == 0 & (c == (byte)58 | c == (byte)64 | c == (byte)36))
                {
                    j = i + 1;
                    if (j < n)
                    {
                        if (sq_isalpha(st.sql[j]) | st.sql[j] == (byte)95)
                        {
                            while (j < n & (sq_isalpha(st.sql[j]) | sq_isdigit(st.sql[j]) | st.sql[j] == (byte)95)) { j++; };
                            l = j - i;
                            idx = 0;
                            for (k = 0; k < nn; k++)
                            {
                                if (nl[k] == l)
                                {
                                    if (sq_mem_eq(@st.sql[ns[k]], @st.sql[i], l)) { idx = k + 1; };
                                };
                            };
                            if (idx == 0)
                            {
                                if (nn >= 64) { ffree((u64)out); sq_seterr(st, "too many parameters\0"); return 1; };
                                ns[nn] = i; nl[nn] = l; nn++;
                                maxp++;
                                if (maxp > 64) { ffree((u64)out); sq_seterr(st, "too many parameters\0"); return 1; };
                                idx = maxp;
                                ns[nn - 1] = i;
                            };
                            i = j;
                        };
                    };
                };
                if (idx > 0)
                {
                    if (idx > 64) { ffree((u64)out); sq_seterr(st, "too many parameters\0"); return 1; };
                    out[o] = (byte)63; o++;
                    if (idx >= 10) { out[o] = (byte)(48 + idx / 10); o++; };
                    out[o] = (byte)(48 + idx % 10); o++;
                    continue;
                };
                out[o] = c;
                o++;
                i++;
            };
            out[o] = (byte)0;
            // names are copied behind the text before it is replaced
            if (o + 1 > 200000) { ffree((u64)out); sq_seterr(st, "statement too large\0"); return 1; };
            k = o + 1;
            for (j = 0; j < nn; j++)
            {
                if (k + nl[j] + 1 > 260000) { break; };
                for (l = 0; l < nl[j]; l++) { out[k + l] = st.sql[ns[j] + l]; };
                st.pns[j] = k;
                st.pnl[j] = nl[j];
                k = k + nl[j];
            };
            for (j = 0; j < k; j++) { st.sql[j] = out[j]; };
            st.sqllen = o;
            st.lim = o;
            st.nparam = maxp;
            ffree((u64)out);
            return 0;
        };

        // true when the statement text starts a SELECT, WITH or VALUES query
        def sq_is_query(byte* sql) -> bool
        {
            int i = 0;
            while (sql[i] == (byte)32 | sql[i] == (byte)9 | sql[i] == (byte)10 | sql[i] == (byte)13) { i++; };
            if (sq_lc(sql[i]) == (byte)115 & sq_lc(sql[i + 1]) == (byte)101 & sq_lc(sql[i + 2]) == (byte)108) { return true; };
            if (sq_lc(sql[i]) == (byte)119 & sq_lc(sql[i + 1]) == (byte)105 & sq_lc(sql[i + 2]) == (byte)116) { return true; };
            if (sq_lc(sql[i]) == (byte)118 & sq_lc(sql[i + 1]) == (byte)97 & sq_lc(sql[i + 2]) == (byte)108) { return true; };
            return false;
        };

        // topmost savepoint level with the given name, or -1
        def sq_sp_find(SQLITE_DB* db, byte* nm, int nl) -> int
        {
            int lv, k, same;
            lv = db.nlv - 1;
            while (lv >= 0)
            {
                if (db.lv_kind[lv] == 1)
                {
                    same = 1;
                    for (k = 0; k < nl; k++) { if (sq_lc(db.lv_name[lv * 40 + k]) != sq_lc(nm[k])) { same = 0; }; };
                    if (db.lv_name[lv * 40 + nl] != (byte)0) { same = 0; };
                    if (same == 1) { return lv; };
                };
                lv--;
            };
            return 0 - 1;
        };

        // SAVEPOINT / RELEASE / ROLLBACK TO. kind: 1 savepoint, 2 release, 3 rollback to. Returns 0 on success.
        def sq_exec_savepoint(SQ_STMT* st, int kind) -> int
        {
            SQLITE_DB* db = st.db;
            byte[48] nm;
            int nl, lv, k, rc;
            if (st.tk != 1) { sq_seterr(st, "expected a savepoint name\0"); return 1; };
            nl = st.tl;
            if (nl > 38) { sq_seterr(st, "savepoint name too long\0"); return 1; };
            for (k = 0; k < nl; k++) { nm[k] = st.sql[st.ts + k]; };
            nm[nl] = (byte)0;
            sq_next(st);
            if (sq_end_check(st) != 0) { return 1; };
            if (kind == 1)
            {
                if (db.in_txn == 0)
                {
                    if (sq_txn_begin(db, 1) != 0) { sq_seterr(st, "cannot begin transaction\0"); return 1; };
                    db.sp_auto = 1;
                };
                if (sq_lv_push(db, 1, @nm[0]) != 0) { sq_seterr(st, "too many savepoints\0"); return 1; };
                return 0;
            };
            lv = sq_sp_find(db, @nm[0], nl);
            if (lv < 0) { sq_err_name(st, "no such savepoint: \0", @nm[0], nl, "\0"); return 1; };
            if (kind == 2)
            {
                while (db.nlv - 1 >= lv)
                {
                    if (sq_lv_merge(db) != 0) { sq_seterr(st, "savepoint release failed\0"); return 1; };
                };
                if (db.nlv == 0 & db.sp_auto == 1)
                {
                    db.sp_auto = 0;
                    if (sq_txn_commit(db) != 0) { sq_seterr(st, "write error\0"); return 1; };
                };
                return 0;
            };
            while (db.nlv - 1 > lv) { sq_lv_undo(db, 0); };
            sq_lv_undo(db, 1);
            rc = sq_schema_load(db);
            return 0;
        };

        // Runs the statement held in st (text prepared, parameters bound). With keep set, a successful run leaves st ready to
        // step through the RETURNING rows (kind 3).
        def sq_exec_run(SQ_STMT* st, int keep) -> int
        {
            SQLITE_DB* db = st.db;
            int rc, autoc, ctl, kp, nchg;
            i64 lrid;
            SQ_RS* sret;
            byte* sretsql;
            st.pad = 0;
            st.pos = 0; st.tend = 0; st.prevend = 0; st.lim = st.sqllen;
            st.ret_s = 0 - 1; st.ret_e = 0 - 1;
            sq_next(st);
            if (sq_is_kw(st, "select\0") | sq_is_kw(st, "with\0") | sq_is_kw(st, "values\0"))
            {
                if (sq_prep_query(st, db, st.sql) != 0) { return 1; };
                while (sq_step_query(st) == 1) { };
                rc = 0;
                if (st.err[0] != (byte)0) { rc = 1; };
                sq_finalize(st);
                return rc;
            };
            if (db.rw != 1) { sq_seterr(st, "database is open read-only\0"); return 1; };
            // transaction control
            ctl = 0;
            if (sq_is_kw(st, "begin\0")) { ctl = 1; };
            if (sq_is_kw(st, "commit\0") | sq_is_kw(st, "end\0")) { ctl = 2; };
            if (sq_is_kw(st, "rollback\0")) { ctl = 3; };
            if (sq_is_kw(st, "savepoint\0"))
            {
                sq_next(st);
                rc = sq_exec_savepoint(st, 1);
                sq_finalize(st);
                return rc;
            };
            if (sq_is_kw(st, "release\0"))
            {
                sq_next(st);
                if (sq_is_kw(st, "savepoint\0")) { sq_next(st); };
                rc = sq_exec_savepoint(st, 2);
                sq_finalize(st);
                return rc;
            };
            if (ctl != 0)
            {
                sq_next(st);
                if (sq_is_kw(st, "deferred\0") | sq_is_kw(st, "immediate\0") | sq_is_kw(st, "exclusive\0")) { sq_next(st); };
                if (sq_is_kw(st, "transaction\0")) { sq_next(st); };
                if (ctl == 3 & sq_is_kw(st, "to\0"))
                {
                    sq_next(st);
                    if (sq_is_kw(st, "savepoint\0")) { sq_next(st); };
                    rc = sq_exec_savepoint(st, 3);
                    sq_finalize(st);
                    return rc;
                };
                if (sq_end_check(st) != 0) { sq_finalize(st); return 1; };
                sq_finalize(st);
                if (ctl == 1)
                {
                    if (db.in_txn == 1) { sq_seterr(st, "cannot start a transaction within a transaction\0"); return 1; };
                    if (sq_txn_begin(db, 1) != 0) { sq_seterr(st, "cannot begin transaction\0"); return 1; };
                    return 0;
                };
                if (db.in_txn == 0)
                {
                    sq_seterr(st, "cannot commit or roll back: no transaction is active\0");
                    return 1;
                };
                if (ctl == 2)
                {
                    if (sq_txn_commit(db) != 0) { sq_seterr(st, "write error\0"); return 1; };
                    return 0;
                };
                rc = sq_txn_rollback(db);
                sq_schema_load(db);
                if (rc != 0) { sq_seterr(st, "rollback failed\0"); return 1; };
                return 0;
            };
            if (sq_is_kw(st, "pragma\0"))
            {
                sq_next(st);
                rc = sq_exec_pragma(st);
                sq_finalize(st);
                return rc;
            };
            autoc = 0;
            if (db.in_txn == 0)
            {
                autoc = 1;
                if (sq_txn_begin(db, 0) != 0) { sq_seterr(st, "cannot begin transaction\0"); return 1; };
            }
            else
            {
                if (sq_stmt_begin(db) != 0) { sq_seterr(st, "out of memory\0"); return 1; };
            };
            rc = sq_dispatch(st);
            kp = 0;
            if (rc != 0 & st.pad == 2) { kp = 1; };
            nchg = st.changes;
            lrid = st.last_rowid;
            sret = st.ret;
            sretsql = st.retsql;
            st.ret = (SQ_RS*)0;
            st.retsql = (byte*)0;
            sq_finalize(st);
            if (autoc == 1)
            {
                if (rc == 0 | kp == 1)
                {
                    if (sq_txn_commit(db) != 0)
                    {
                        sq_txn_rollback(db);
                        sq_seterr(st, "write error\0");
                        rc = 1;
                    };
                }
                else { sq_txn_rollback(db); };
            }
            else
            {
                if (rc == 0 | kp == 1) { sq_stmt_end(db, 1); } else { sq_stmt_end(db, 0); };
                if (rc != 0 & st.pad == 1) { sq_txn_rollback(db); };
            };
            sq_schema_load(db);
            if (rc != 0)
            {
                if ((u64)sret != (u64)0) { sq_rs_free(sret); };
                if ((u64)sretsql != (u64)0) { ffree((u64)sretsql); };
                return rc;
            };
            if (keep == 1)
            {
                if ((u64)sretsql != (u64)0)
                {
                    if (sq_prep_query(st, db, sretsql) != 0) { sq_rs_free(sret); ffree((u64)sretsql); return 1; };
                    ffree((u64)sretsql);
                }
                else { sq_stmt_init(st, db, "\0"); };
                st.kind = 3;
                st.ret = sret;
                st.state = 0;
                st.changes = nchg;
                st.last_rowid = lrid;
                return 0;
            };
            if ((u64)sret != (u64)0) { sq_rs_free(sret); };
            if ((u64)sretsql != (u64)0) { ffree((u64)sretsql); };
            return 0;
        };

        // Executes one statement of any kind and discards any rows (use sq_prepare / sq_step to read them).
        // st.changes and st.last_rowid describe the effect of INSERT, UPDATE and DELETE.
        // Parameters bound to st with sq_bind_* before the call are kept.
        def sq_exec(SQ_STMT* st, SQLITE_DB* db, byte* sql) -> int
        {
            SQ_VAL[64] keep;
            int i;
            for (i = 0; i < 64; i++) { sq_val_copy(@keep[i], @st.pv[i]); };
            sq_stmt_init(st, db, sql);
            for (i = 0; i < 64; i++) { sq_val_copy(@st.pv[i], @keep[i]); };
            if (sq_rewrite_params(st) != 0) { return 1; };
            return sq_exec_run(st, 0);
        };

        // Prepares any statement. Queries are prepared at once; other statements run on the first sq_step, so parameters can be
        // bound between the two. After the run sq_step returns the rows of RETURNING, if any.
        def sq_prepare(SQ_STMT* st, SQLITE_DB* db, byte* sql) -> int
        {
            if (sq_is_query(sql)) { return sq_prep_query(st, db, sql); };
            sq_stmt_init(st, db, sql);
            if (sq_rewrite_params(st) != 0) { return 1; };
            st.kind = 4;
            st.state = 0;
            return 0;
        };

        def sq_step(SQ_STMT* st) -> int
        {
            if (st.kind == 4)
            {
                if (st.state == 0)
                {
                    if (sq_exec_run(st, 1) != 0) { st.state = 2; return 0 - 1; };
                    if (st.kind != 3) { st.state = 2; return 0; };
                };
            };
            return sq_step_query(st);
        };

    }; // sqlite
}; // standard

#endif; // IDEKA_STANDARD_SQLITE_WRITE
