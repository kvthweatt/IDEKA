        // how many leading DISTINCT terms (in select-list order) the key columns of the index deliver in order
        def sq_vd_dprefix(SQ_STMT* g, SQ_BLK* b, SQ_IDX* ix) -> int
        {
            int a, j, k, n, p;
            int[32] sat;
            n = b.nres;
            if (ix.partial != 0 | n > 30) { return 0; };
            for (a = 0; a < 32; a++) { sat[a] = 0; };
            for (j = 0; j < ix.nk; j++)
            {
                if (ix.isx[j] != 0 | ix.coll[j] != 0) { break; };
                k = 0 - 1;
                for (a = 0; a < n; a++)
                {
                    if (sat[a] != 0) { continue; };
                    if (g.nodes[b.rc[a]].kind != SQN_COL) { continue; };
                    if (g.nodes[b.rc[a]].col == ix.col[j]) { k = a; break; };
                };
                if (k < 0) { break; };
                sat[k] = 1;
            };
            p = 0;
            while (p < n) { if (sat[p] != 0) { p++; } else { break; }; };
            return p;
        };

        // 1 when the DISTINCT columns are exactly the leading key columns of the index, in any order
        def sq_vd_satpre(SQ_STMT* g, SQ_BLK* b, SQ_IDX* ix) -> int
