            {
                r = 4 + 8 * j;
                if (j == pkpos & wo == 1) { o = sq_vd_op("Goto\0", 0, 0, 0); } else { o = sq_vd_op("Noop\0", 0, 0, 0); };
                sq_vd_op("CreateBtree\0", 0, r, 2);
                a = sq_vd_op("OpenWrite\0", j + 1, 1, 0);
                sq_vd_p4i(a, (i64)5);
                a = sq_vd_op("String8\0", 0, r + 2, 0);
                sq_vd_p4s(a, "index\0", 5);
                a = sq_vd_op("String8\0", 0, r + 3, 0);
                sq_sb_init(@sb);
                sq_sb_lit(@sb, "sqlite_autoindex_\0");
                sq_sb_add(@sb, @t[ns], nl);
                sq_sb_lit(@sb, "_\0");
                sq_sb_int(@sb, (i64)(j + 1));
                sq_vd_p4s(a, sb.p, sb.n);
                sq_sb_free(@sb);
                a = sq_vd_op("String8\0", 0, r + 4, 0);
                sq_vd_p4s(a, @t[ns], nl);
                sq_vd_op("SCopy\0", r, r + 5, 0);
                sq_vd_op("Null\0", 0, r + 6, 0);
                sq_vd_op("NewRowid\0", j + 1, r + 1, 0);
                a = sq_vd_op("MakeRecord\0", r + 2, 5, r + 7);
                sq_vd_p4s(a, "BBBDB\0", 5);
                a = sq_vd_op("Insert\0", j + 1, r + 7, r + 1);
                VD_P5[a] = 24;
                VD_P2[o] = VD_N;
            };
            sq_vd_op("Close\0", 0, 0, 0);
            b = 4 + 8 * nauto;
            sq_vd_op("Null\0", 0, b, b + 1);
            sq_vd_op("Noop\0", cb + 1, 0, b);
            a = sq_vd_op("OpenWrite\0", cb, 1, 0);
            sq_vd_p4i(a, (i64)5);
            sk = sq_vd_op("SeekRowid\0", cb, 0, 1);
            sq_vd_op("Rowid\0", cb, b + 1, 0);
            VD_P2[sk] = VD_N;
            ii = sq_vd_op("IsNull\0", b + 1, 0, 0);
            a = sq_vd_op("String8\0", 0, b + 2, 0);
            sq_vd_p4s(a, "table\0", 5);
            a = sq_vd_op("String8\0", 0, b + 3, 0);
            sq_vd_p4s(a, @t[ns], nl);
            a = sq_vd_op("String8\0", 0, b + 4, 0);
            sq_vd_p4s(a, @t[ns], nl);
            sq_vd_op("Copy\0", 2, b + 5, 0);
            a = sq_vd_op("String8\0", 0, b + 6, 0);
            sq_sb_init(@sb);
            sq_sb_lit(@sb, "CREATE TABLE \0");
            sq_sb_add(@sb, @t[raw], n - raw);
            sq_vd_p4s(a, sb.p, sb.n);
            sq_sb_free(@sb);
            a = sq_vd_op("MakeRecord\0", b + 2, 5, b);
            sq_vd_p4s(a, "BBBDB\0", 5);
            sq_vd_op("Insert\0", cb, b, b + 1);
            VD_P2[ii] = VD_N;
            sq_vd_op("SetCookie\0", 0, 1, ck + 1);
            a = sq_vd_op("ParseSchema\0", 0, 0, 0);
            sq_sb_init(@sb);
            sq_sb_lit(@sb, "tbl_name='\0");
            sq_sb_add(@sb, @t[ns], nl);
            sq_sb_lit(@sb, "' AND type!='trigger'\0");
            sq_vd_p4s(a, sb.p, sb.n);
            sq_sb_free(@sb);
            if (VD_NEST != 0) { return 0; };
            sq_vd_op("Halt\0", 0, 0, 0);
            VD_P2[init] = VD_N;
            sq_vd_trans(st.db, 1);
            sq_vd_op("Goto\0", 0, 1, 0);
            sq_vd_query(pq);
            return 0;
        };

        // CREATE TABLE name AS SELECT: plain columns of one table, written through a coroutine. 2 when the statement is not that form
        def sq_vd_ctas(SQ_STMT* st, byte* t, int n, int i, byte** pq) -> int
        {
            SQ_STMT* g2;
            SQ_BLK* b2;
            SQ_SRC* s2;
            SQ_TI* t2;
            SQ_NODE* nd;
            SQ_SB sb;
            SQ_SB kt;
            SQ_IDX cix;
            int ns, nl, k, q, nv, init, ic, a, c, maxc, ucov, tcur, vb, rew, body, nxt, y, cb, b, sk, ii, iff, ck, cc, ln;
            byte[8] bl;
            i = sq_vd_skip(t, n, i);
            ns = 0; nl = 0;
            k = sq_vd_ident(t, n, i, @ns, @nl);
            if (k < 0) { return 2; };
            q = sq_vd_skip(t, n, k);
            if (sq_vd_word(t, n, q, "as\0") < 0) { return 2; };
            q = sq_vd_skip(t, n, sq_vd_word(t, n, q, "as\0"));
            if (sq_obj_exists(st.db, @t[ns], nl) != 0) { if (sq_vd_gon(486) == 1) { sq_seterr(st, "EXPLAIN is not available for this CREATE TABLE #486\0"); return 1; }; };
            if (sq_vd_prep(st, "select \0", (byte*)0, 0, @t[q + 6], n - q - 6, @g2) != 0) { return 1; };
            if (sq_vd_word(t, n, q, "select\0") < 0) { sq_stmt_del(g2); sq_seterr(st, "EXPLAIN is not available for this CREATE TABLE\0"); return 1; };
            b2 = g2.blks[g2.root_blk];
            nv = b2.nres;
            if (b2.nsrc != 1 | nv < 1 | nv > 16 | b2.cnext >= 0 | b2.distinct != 0 | b2.ngrp != 0 | b2.having >= 0 | b2.nord > 0 | b2.limit_n >= 0 | b2.has_agg != 0 | b2.nwin != 0 | b2.ncte != 0 | b2.where_n >= 0)
            {
                sq_stmt_del(g2); sq_seterr(st, "EXPLAIN is not available for this CREATE TABLE\0"); return 1;
            };
            s2 = @b2.src[0];
            if (s2.kind != 1 | (u64)s2.ti == (u64)0 | s2.on >= 0) { sq_stmt_del(g2); sq_seterr(st, "EXPLAIN is not available for this CREATE TABLE\0"); return 1; };
            t2 = s2.ti;
            if (t2.wor != 0) { sq_stmt_del(g2); sq_seterr(st, "EXPLAIN is not available for this CREATE TABLE\0"); return 1; };
            maxc = 0 - 1;
            for (k = 0; k < nv; k++)
            {
                nd = @g2.nodes[b2.rc[k]];
                if (nd.kind != SQN_COL) { sq_stmt_del(g2); sq_seterr(st, "EXPLAIN is not available for this CREATE TABLE\0"); return 1; };
                if (nd.col < 0 | nd.col >= t2.ncols) { sq_stmt_del(g2); sq_seterr(st, "EXPLAIN is not available for this CREATE TABLE\0"); return 1; };
                if (b2.rnl[k] > 0)
                {
                    ln = t2.cl[nd.col];
                    if (b2.rnl[k] != ln) { sq_stmt_del(g2); sq_seterr(st, "EXPLAIN is not available for this CREATE TABLE\0"); return 1; };
                    for (c = 0; c < ln; c++) { if (g2.sql[b2.rns[k] + c] != t2.base[t2.cs[nd.col] + c]) { sq_stmt_del(g2); sq_seterr(st, "EXPLAIN is not available for this CREATE TABLE\0"); return 1; }; };
                };
                if (nd.col != t2.ipk & nd.col > maxc) { maxc = nd.col; };
            };
            ucov = sq_vd_cover(g2, t2, s2, @cix, 0);
            bl[0] = (byte)6; bl[1] = (byte)0;
            ck = st.db.cookie;
            sq_vd_reset();
            init = sq_vd_op("Init\0", 0, 0, 0);
            sq_vd_op("ReadCookie\0", 0, 3, 2);
            iff = sq_vd_op("If\0", 3, 0, 0);
            sq_vd_op("SetCookie\0", 0, 2, 4);
            sq_vd_op("SetCookie\0", 0, 5, 1);
            VD_P2[iff] = VD_N;
            sq_vd_op("CreateBtree\0", 0, 2, 1);
            a = sq_vd_op("OpenWrite\0", 0, 1, 0);
            sq_vd_p4i(a, (i64)5);
            sq_vd_op("NewRowid\0", 0, 1, 0);
            a = sq_vd_op("Blob\0", 6, 3, 0);
            sq_vd_p4s(a, @bl[0], 1);
            a = sq_vd_op("Insert\0", 0, 3, 1);
            VD_P5[a] = 8;
            sq_vd_op("Close\0", 0, 0, 0);
            sq_vd_op("Close\0", 0, 0, 0);
            a = sq_vd_op("OpenWrite\0", 1, 2, 0);
            VD_P5[a] = 16;
            ic = sq_vd_op("InitCoroutine\0", 4, 0, 0);
            VD_P3[ic] = VD_N;
            VD_NMEM = 6; VD_NFREE = 0; VD_NH = 0; VD_NJ = 0; VD_COLCUR = 0; VD_IDXCUR = 0;
            vb = 7;
            tcur = 2;
            if (ucov == 1)
            {
                tcur = 3;
                a = sq_vd_op("OpenRead\0", 3, cix.root, 0);
                sq_sb_init(@kt);
                if (sq_vd_kinfo(@cix, @kt) != 0) { sq_sb_free(@kt); sq_stmt_del(g2); sq_seterr(st, "EXPLAIN is not available for this index collation\0"); return 1; };
                sq_vd_p4s(a, kt.p, kt.n);
                sq_sb_free(@kt);
                VD_COLCUR = 3; VD_IDXCUR = 3;
                sq_vd_setix(@cix);
                rew = sq_vd_op("Rewind\0", 3, 0, vb);
                sq_vd_p4i(rew, (i64)0);
            }
            else
            {
                a = sq_vd_op("OpenRead\0", 2, s2.root, 0);
                sq_vd_p4i(a, (i64)(maxc + 1));
                VD_COLCUR = 2;
                rew = sq_vd_op("Rewind\0", 2, 0, 0);
            };
            body = VD_N;
            for (k = 0; k < nv; k++)
            {
                if (sq_vd_expr(g2, t2, b2.rc[k], vb + k) != 0) { sq_stmt_del(g2); sq_seterr(st, "EXPLAIN is not available for this expression\0"); return 1; };
            };
            sq_vd_op("Yield\0", 4, 0, 0);
            a = sq_vd_op("Next\0", tcur, body, 0);
            VD_P5[a] = 1;
            VD_P2[rew] = VD_N;
            sq_vd_op("EndCoroutine\0", 4, 0, 0);
            VD_P2[ic] = VD_N;
            VD_COLCUR = 0; VD_IDXCUR = 0;
            y = sq_vd_op("Yield\0", 4, 0, 0);
            a = sq_vd_op("MakeRecord\0", vb, nv, 5);
            sq_sb_init(@sb);
            for (k = 0; k < nv; k++) { c = 65 + t2.aff[g2.nodes[b2.rc[k]].col]; sq_sb_add(@sb, (byte*)@c, 1); };
            while (sb.n > 0 & sb.p[sb.n - 1] == (byte)65) { sb.n--; };
            if (sb.n > 0) { sq_vd_p4s(a, sb.p, sb.n); };
            sq_sb_free(@sb);
            sq_vd_op("NewRowid\0", 1, 6, 0);
            sq_vd_op("Insert\0", 1, 5, 6);
            sq_vd_op("Goto\0", 0, y, 0);
            VD_P2[y] = VD_N;
            sq_vd_op("Close\0", 1, 0, 0);
            cb = 3;
            if (ucov == 1) { cb = 4; };
            b = vb + nv;
            sq_vd_op("Null\0", 0, b, b + 1);
            sq_vd_op("Noop\0", cb + 1, 0, b);
            a = sq_vd_op("OpenWrite\0", cb, 1, 0);
            sq_vd_p4i(a, (i64)5);
            sk = sq_vd_op("SeekRowid\0", cb, 0, 1);
            sq_vd_op("Rowid\0", cb, b + 1, 0);
            VD_P2[sk] = VD_N;
            ii = sq_vd_op("IsNull\0", b + 1, 0, 0);
            a = sq_vd_op("String8\0", 0, b + 2, 0);
            sq_vd_p4s(a, "table\0", 5);
            a = sq_vd_op("String8\0", 0, b + 3, 0);
            sq_vd_p4s(a, @t[ns], nl);
            a = sq_vd_op("String8\0", 0, b + 4, 0);
            sq_vd_p4s(a, @t[ns], nl);
            sq_vd_op("Copy\0", 2, b + 5, 0);
            a = sq_vd_op("String8\0", 0, b + 6, 0);
            sq_sb_init(@sb);
            sq_sb_lit(@sb, "CREATE TABLE \0");
            sq_sb_add(@sb, @t[ns], nl);
            sq_sb_lit(@sb, "(\0");
            for (k = 0; k < nv; k++)
            {
                c = g2.nodes[b2.rc[k]].col;
                if (k > 0) { sq_sb_lit(@sb, ",\0"); };
                sq_sb_add(@sb, @t2.base[t2.cs[c]], t2.cl[c]);
                if (t2.aff[c] == 3) { sq_sb_lit(@sb, " INT\0"); };
                if (t2.aff[c] == 1) { sq_sb_lit(@sb, " TEXT\0"); };
                if (t2.aff[c] == 4) { sq_sb_lit(@sb, " REAL\0"); };
                if (t2.aff[c] == 2) { sq_sb_lit(@sb, " NUM\0"); };
            };
            sq_sb_lit(@sb, ")\0");
            sq_vd_p4s(a, sb.p, sb.n);
            sq_sb_free(@sb);
            a = sq_vd_op("MakeRecord\0", b + 2, 5, b);
            sq_vd_p4s(a, "BBBDB\0", 5);
            sq_vd_op("Insert\0", cb, b, b + 1);
            VD_P2[ii] = VD_N;
            sq_vd_op("SetCookie\0", 0, 1, ck + 1);
            a = sq_vd_op("ParseSchema\0", 0, 0, 0);
            sq_sb_init(@sb);
            sq_sb_lit(@sb, "tbl_name='\0");
            sq_sb_add(@sb, @t[ns], nl);
            sq_sb_lit(@sb, "' AND type!='trigger'\0");
            sq_vd_p4s(a, sb.p, sb.n);
            sq_sb_free(@sb);
            sq_vd_op("Halt\0", 0, 0, 0);
            VD_P2[init] = VD_N;
            sq_vd_trans(st.db, 1);
            for (k = 0; k < VD_NH; k++) { sq_vd_lit(g2, VD_HN[k], VD_HR[k]); };
            sq_vd_op("Goto\0", 0, 1, 0);
            sq_stmt_del(g2);
            sq_vd_query(pq);
            return 0;
        };

        // CREATE VIEW: a schema row with root page 0
        def sq_vd_create_view(SQ_STMT* st, byte* t, int n, int i, byte** pq) -> int
        {
            SQ_SB sb;
            int ifn, raw, ns, nl, k, init, a, nauto, j, r, b, o, iff, sk, ii, ck, cb;
            byte[2] bl;
            i = sq_vd_skip(t, n, i);
            ifn = 0;
            k = sq_vd_ifne(t, n, i, @ifn);
            if (k < 0) { if (sq_vd_gon(487) == 1) { sq_seterr(st, "EXPLAIN is not available for this CREATE VIEW #487\0"); return 1; }; };
            i = k;
            raw = i;
            k = sq_vd_ident(t, n, i, @ns, @nl);
            if (k < 0) { if (sq_vd_gon(488) == 1) { sq_seterr(st, "EXPLAIN is not available for this CREATE VIEW #488\0"); return 1; }; };
            if (k < n) { if (t[k] == (byte)46) { if (sq_vd_gon(489) == 1) { sq_seterr(st, "EXPLAIN is not available for this CREATE VIEW #489\0"); return 1; }; }; };
            i = sq_vd_skip(t, n, k);
            if (i >= n) { if (sq_vd_gon(490) == 1) { sq_seterr(st, "EXPLAIN is not available for this CREATE VIEW #490\0"); return 1; }; };
            if (ifn == 1) { if (sq_vd_have(st, t, ns, nl, 0) == 1) { return sq_vd_noop(st, 1, pq); }; };
            if (sq_obj_exists(st.db, @t[ns], nl) != 0) { if (sq_vd_gon(491) == 1) { sq_seterr(st, "EXPLAIN is not available for this CREATE VIEW #491\0"); return 1; }; };
            sq_sb_init(@sb);
            sq_sb_lit(@sb, "CREATE VIEW \0");
            sq_sb_add(@sb, @t[raw], n - raw);
            nauto = 0;
            bl[0] = (byte)6; bl[1] = (byte)0;
            ck = st.db.cookie;
            init = 0;
            if (VD_NEST == 0) { sq_vd_reset(); init = sq_vd_op("Init\0", 0, 0, 0); };
            cb = nauto + 1;
            if (VD_NEST != 0) { cb = cb + 2; };
            sq_vd_op("ReadCookie\0", 0, 3, 2);
            iff = sq_vd_op("If\0", 3, 0, 0);
            sq_vd_op("SetCookie\0", 0, 2, 4);
            sq_vd_op("SetCookie\0", 0, 5, 1);
            VD_P2[iff] = VD_N;
            sq_vd_op("Integer\0", 0, 2, 0);
            a = sq_vd_op("OpenWrite\0", 0, 1, 0);
            sq_vd_p4i(a, (i64)5);
            sq_vd_op("NewRowid\0", 0, 1, 0);
            a = sq_vd_op("Blob\0", 6, 3, 0);
            sq_vd_p4s(a, @bl[0], 1);
            a = sq_vd_op("Insert\0", 0, 3, 1);
            VD_P5[a] = 8;
            sq_vd_op("Close\0", 0, 0, 0);
            for (j = 0; j < nauto; j++)
            {
                r = 4 + 8 * j;
                o = sq_vd_op("Noop\0", 0, 0, 0);
                sq_vd_op("CreateBtree\0", 0, r, 2);
                a = sq_vd_op("OpenWrite\0", j + 1, 1, 0);
                sq_vd_p4i(a, (i64)5);
                a = sq_vd_op("String8\0", 0, r + 2, 0);
                sq_vd_p4s(a, "index\0", 5);
                a = sq_vd_op("String8\0", 0, r + 3, 0);
                sq_sb_init(@sb);
                sq_sb_lit(@sb, "sqlite_autoindex_\0");
                sq_sb_add(@sb, @t[ns], nl);
                sq_sb_lit(@sb, "_\0");
                sq_sb_int(@sb, (i64)(j + 1));
                sq_vd_p4s(a, sb.p, sb.n);
                sq_sb_free(@sb);
                a = sq_vd_op("String8\0", 0, r + 4, 0);
                sq_vd_p4s(a, @t[ns], nl);
                sq_vd_op("SCopy\0", r, r + 5, 0);
                sq_vd_op("Null\0", 0, r + 6, 0);
                sq_vd_op("NewRowid\0", j + 1, r + 1, 0);
                a = sq_vd_op("MakeRecord\0", r + 2, 5, r + 7);
                sq_vd_p4s(a, "BBBDB\0", 5);
                a = sq_vd_op("Insert\0", j + 1, r + 7, r + 1);
                VD_P5[a] = 24;
                VD_P2[o] = VD_N;
            };
            sq_vd_op("Close\0", 0, 0, 0);
            b = 4 + 8 * nauto;
            sq_vd_op("Null\0", 0, b, b + 1);
            sq_vd_op("Noop\0", cb + 1, 0, b);
            a = sq_vd_op("OpenWrite\0", cb, 1, 0);
            sq_vd_p4i(a, (i64)5);
            sk = sq_vd_op("SeekRowid\0", cb, 0, 1);
            sq_vd_op("Rowid\0", cb, b + 1, 0);
            VD_P2[sk] = VD_N;
            ii = sq_vd_op("IsNull\0", b + 1, 0, 0);
            a = sq_vd_op("String8\0", 0, b + 2, 0);
            sq_vd_p4s(a, "view\0", 4);
            a = sq_vd_op("String8\0", 0, b + 3, 0);
            sq_vd_p4s(a, @t[ns], nl);
            a = sq_vd_op("String8\0", 0, b + 4, 0);
            sq_vd_p4s(a, @t[ns], nl);
            sq_vd_op("Copy\0", 2, b + 5, 0);
            a = sq_vd_op("String8\0", 0, b + 6, 0);
            sq_sb_init(@sb);
            sq_sb_lit(@sb, "CREATE VIEW \0");
            sq_sb_add(@sb, @t[raw], n - raw);
            sq_vd_p4s(a, sb.p, sb.n);
            sq_sb_free(@sb);
            a = sq_vd_op("MakeRecord\0", b + 2, 5, b);
            sq_vd_p4s(a, "BBBDB\0", 5);
            sq_vd_op("Insert\0", cb, b, b + 1);
            VD_P2[ii] = VD_N;
            sq_vd_op("SetCookie\0", 0, 1, ck + 1);
            a = sq_vd_op("ParseSchema\0", 0, 0, 0);
            sq_sb_init(@sb);
            sq_sb_lit(@sb, "tbl_name='\0");
            sq_sb_add(@sb, @t[ns], nl);
            sq_sb_lit(@sb, "' AND type!='trigger'\0");
            sq_vd_p4s(a, sb.p, sb.n);
            sq_sb_free(@sb);
            if (VD_NEST != 0) { return 0; };
            sq_vd_op("Halt\0", 0, 0, 0);
            VD_P2[init] = VD_N;
            sq_vd_trans(st.db, 1);
            sq_vd_op("Goto\0", 0, 1, 0);
            sq_vd_query(pq);
            return 0;
        };

        // DROP VIEW / DROP TRIGGER: the schema rows are removed by a scan of sqlite_master
        def sq_vd_drop_vt(SQ_STMT* st, byte* t, int n, int i, int isview, byte** pq) -> int
        {
            int ifx, ns, nl, k, j, found, init, a, rw, e1, e2, body, ck;
            i = sq_vd_skip(t, n, i);
            ifx = 0;
            k = sq_vd_word(t, n, i, "if\0");
            if (k >= 0)
            {
                i = sq_vd_skip(t, n, k);
                k = sq_vd_word(t, n, i, "exists\0");
                if (k < 0) { if (sq_vd_gon(492) == 1) { sq_seterr(st, "EXPLAIN is not available for this DROP #492\0"); return 1; }; };
                i = sq_vd_skip(t, n, k);
                ifx = 1;
            };
            k = sq_vd_ident(t, n, i, @ns, @nl);
            if (k < 0) { if (sq_vd_gon(493) == 1) { sq_seterr(st, "EXPLAIN is not available for this DROP #493\0"); return 1; }; };
            if (k < n) { if (t[k] == (byte)46) { if (sq_vd_gon(494) == 1) { sq_seterr(st, "EXPLAIN is not available for this DROP #494\0"); return 1; }; }; };
            i = sq_vd_skip(t, n, k);
            if (i < n) { if (sq_vd_gon(495) == 1) { sq_seterr(st, "EXPLAIN is not available for this DROP #495\0"); return 1; }; };
            found = 0;
            for (j = 0; j < st.db.nschema; j++)
            {
                if (sq_vd_nameeq(st.db.schema[j].name, t, ns, nl)) { if (isview == 1 & st.db.schema[j].kind == 3) { found = 1; }; if (isview == 0 & st.db.schema[j].kind == 4) { found = 1; }; };
            };
            if (found == 0 & ifx == 1) { if (sq_vd_have(st, t, ns, nl, 1 - isview) == 0) { return sq_vd_noop(st, isview, pq); }; };
            if (found == 0) { if (sq_vd_gon(496) == 1) { sq_seterr(st, "EXPLAIN is not available for this DROP #496\0"); return 1; }; };
            ck = st.db.cookie;
            sq_vd_reset();
            init = sq_vd_op("Init\0", 0, 0, 0);
            sq_vd_op("Null\0", 0, 1, 0);
            a = sq_vd_op("OpenWrite\0", 0, 1, 0);
            sq_vd_p4i(a, (i64)5);
            rw = sq_vd_op("Rewind\0", 0, 0, 0);
            body = VD_N;
            if (isview == 1) { sq_vd_op("Column\0", 0, 2, 2); } else { sq_vd_op("Column\0", 0, 1, 2); };
            e1 = sq_vd_op("Ne\0", 3, 0, 2);
            sq_vd_p4s(e1, "BINARY-8\0", 8);
            VD_P5[e1] = 82;
            sq_vd_op("Column\0", 0, 0, 2);
            if (isview == 1) { e2 = sq_vd_op("Eq\0", 4, 0, 2); } else { e2 = sq_vd_op("Ne\0", 4, 0, 2); };
            sq_vd_p4s(e2, "BINARY-8\0", 8);
            VD_P5[e2] = 82;
            sq_vd_op("Rowid\0", 0, 5, 0);
            a = sq_vd_op("Delete\0", 0, 0, 0);
            VD_P5[a] = 2;
            VD_P2[e1] = VD_N; VD_P2[e2] = VD_N;
            a = sq_vd_op("Next\0", 0, body, 0);
            VD_P5[a] = 1;
            VD_P2[rw] = VD_N;
            if (isview == 1)
            {
                a = sq_vd_op("DropTable\0", 0, 0, 0);
                sq_vd_p4s(a, @t[ns], nl);
                sq_vd_op("SetCookie\0", 0, 1, ck + 1);
            }
            else
            {
                sq_vd_op("SetCookie\0", 0, 1, ck + 1);
                a = sq_vd_op("DropTrigger\0", 0, 0, 0);
                sq_vd_p4s(a, @t[ns], nl);
            };
            sq_vd_op("Halt\0", 0, 0, 0);
            VD_P2[init] = VD_N;
            sq_vd_trans(st.db, 1);
            a = sq_vd_op("String8\0", 0, 3, 0);
            sq_vd_p4s(a, @t[ns], nl);
            a = sq_vd_op("String8\0", 0, 4, 0);
            if (isview == 1) { sq_vd_p4s(a, "trigger\0", 7); } else { sq_vd_p4s(a, "trigger\0", 7); };
            sq_vd_op("Goto\0", 0, 1, 0);
            sq_vd_query(pq);
            return 0;
        };

        // CREATE TRIGGER: one schema row, then the trigger is parsed into the schema
        def sq_vd_create_trigger(SQ_STMT* st, byte* t, int n, int i, byte** pq) -> int
        {
            SQ_SB sb;
            int ifn, raw, ns, nl, k, init, a, ts, tl, ck, e;
            i = sq_vd_skip(t, n, i);
            ifn = 0;
            k = sq_vd_ifne(t, n, i, @ifn);
            if (k < 0) { if (sq_vd_gon(497) == 1) { sq_seterr(st, "EXPLAIN is not available for this CREATE TRIGGER #497\0"); return 1; }; };
            i = k;
            raw = i;
            k = sq_vd_ident(t, n, i, @ns, @nl);
            if (k < 0) { if (sq_vd_gon(498) == 1) { sq_seterr(st, "EXPLAIN is not available for this CREATE TRIGGER #498\0"); return 1; }; };
            if (k < n) { if (t[k] == (byte)46) { if (sq_vd_gon(499) == 1) { sq_seterr(st, "EXPLAIN is not available for this CREATE TRIGGER #499\0"); return 1; }; }; };
            if (ifn == 1) { if (sq_vd_have(st, t, ns, nl, 1) == 1) { return sq_vd_noop(st, 0, pq); }; };
            if (sq_obj_exists(st.db, @t[ns], nl) != 0) { if (sq_vd_gon(500) == 1) { sq_seterr(st, "EXPLAIN is not available for this CREATE TRIGGER #500\0"); return 1; }; };
            i = sq_vd_skip(t, n, k);
            ts = 0 - 1;
            while (i < n & ts < 0)
            {
                e = i;
                while (e < n & t[e] != (byte)32 & t[e] != (byte)9 & t[e] != (byte)10 & t[e] != (byte)13) { e++; };
                if (e - i == 2)
                {
                    k = sq_vd_word(t, n, i, "on\0");
                    if (k >= 0)
                    {
                        k = sq_vd_skip(t, n, k);
                        k = sq_vd_ident(t, n, k, @ts, @tl);
                        if (k < 0) { if (sq_vd_gon(501) == 1) { sq_seterr(st, "EXPLAIN is not available for this CREATE TRIGGER #501\0"); return 1; }; };
                        break;
                    };
                };
                i = sq_vd_skip(t, n, e);
            };
            if (ts < 0) { if (sq_vd_gon(502) == 1) { sq_seterr(st, "EXPLAIN is not available for this CREATE TRIGGER #502\0"); return 1; }; };
            ck = st.db.cookie;
            sq_vd_reset();
            init = sq_vd_op("Init\0", 0, 0, 0);
            a = sq_vd_op("OpenWrite\0", 0, 1, 0);
            sq_vd_p4i(a, (i64)5);
            a = sq_vd_op("String8\0", 0, 2, 0);
            sq_vd_p4s(a, "trigger\0", 7);
            a = sq_vd_op("String8\0", 0, 3, 0);
            sq_vd_p4s(a, @t[ns], nl);
            a = sq_vd_op("String8\0", 0, 4, 0);
            sq_vd_p4s(a, @t[ts], tl);
            sq_vd_op("Integer\0", 0, 5, 0);
            a = sq_vd_op("String8\0", 0, 6, 0);
            sq_sb_init(@sb);
            sq_sb_lit(@sb, "CREATE TRIGGER \0");
            sq_sb_add(@sb, @t[raw], n - raw);
            sq_vd_p4s(a, sb.p, sb.n);
            sq_sb_free(@sb);
            sq_vd_op("NewRowid\0", 0, 1, 0);
            a = sq_vd_op("MakeRecord\0", 2, 5, 7);
            sq_vd_p4s(a, "BBBDB\0", 5);
            a = sq_vd_op("Insert\0", 0, 7, 1);
            VD_P5[a] = 24;
            sq_vd_op("SetCookie\0", 0, 1, ck + 1);
            a = sq_vd_op("ParseSchema\0", 0, 0, 0);
            sq_sb_init(@sb);
            sq_sb_lit(@sb, "type='trigger' AND name='\0");
            sq_sb_add(@sb, @t[ns], nl);
            sq_sb_lit(@sb, "'\0");
            sq_vd_p4s(a, sb.p, sb.n);
            sq_sb_free(@sb);
            sq_vd_op("Halt\0", 0, 0, 0);
            VD_P2[init] = VD_N;
            sq_vd_trans(st.db, 1);
            sq_vd_op("Goto\0", 0, 1, 0);
            sq_vd_query(pq);
            return 0;
        };

        // the end of one CREATE INDEX element: the top-level comma or the closing parenthesis, -1 when none
        def sq_vd_elend(byte* t, int n, int i) -> int
        {
            int d;
            byte q, c;
            d = 0;
            while (i < n)
            {
                c = t[i];
                if (c == (byte)39 | c == (byte)34 | c == (byte)96)
                {
                    q = c;
                    i++;
                    while (i < n) { if (t[i] == q) { break; }; i++; };
                    if (i >= n) { return 0 - 1; };
                    i++;
                    continue;
                };
                if (c == (byte)40) { d++; };
                if (c == (byte)41) { if (d == 0) { return i; }; d--; };
                if (c == (byte)44 & d == 0) { return i; };
                i++;
            };
            return 0 - 1;
        };

        // trailing ASC or DESC of an element: returns the new end, sets *pd to 1 for DESC
        def sq_vd_elmod(byte* t, int s, int e, int* pd) -> int
        {
            int w, k, ok;
            byte[5] dw;
            *pd = 0;
            while (e > s) { if (t[e - 1] == (byte)32) { e--; } else { break; }; };
            w = e;
            while (w > s) { if (t[w - 1] == (byte)32) { break; }; w--; };
            if (w <= s) { return e; };
            if (e - w == 4)
            {
                ok = 1;
                if (sq_lc(t[w]) != (byte)100 | sq_lc(t[w + 1]) != (byte)101 | sq_lc(t[w + 2]) != (byte)115 | sq_lc(t[w + 3]) != (byte)99) { ok = 0; };
                if (ok == 1) { *pd = 1; e = w; while (e > s) { if (t[e - 1] == (byte)32) { e--; } else { break; }; }; return e; };
            };
            if (e - w == 3)
            {
                if (sq_lc(t[w]) == (byte)97 & sq_lc(t[w + 1]) == (byte)115 & sq_lc(t[w + 2]) == (byte)99) { e = w; while (e > s) { if (t[e - 1] == (byte)32) { e--; } else { break; }; }; return e; };
            };
            return e;
        };

        // CREATE [UNIQUE] INDEX on columns, expressions and an optional WHERE
        def sq_vd_create_index(SQ_STMT* st, byte* t, int n, int i, int uniq, byte** pq) -> int
        {
            SQ_STMT* g;
            SQ_BLK* b;
            SQ_SRC* sr;
            SQ_TI* ti;
            SQ_SB sb;
            SQ_SB kt;
            int[16] kc;
            int[16] kd;
            SQ_STMT* g2;
            SQ_BLK* b2;
            int[16] ke;
            int[16] exs;
            int[16] exe;
            int ifn, raw, ns, nl, ts, tl, k, init, a, j, c, nk, nix, rc, o, rew, sd, ck, sc, sn, hl, d, cs, cl, fin, sorts, cmp, gt, es, ee, xe, nex, hasw, ws, base, nxt;
            i = sq_vd_skip(t, n, i);
            ifn = 0;
            k = sq_vd_ifne(t, n, i, @ifn);
            if (k < 0) { if (sq_vd_gon(503) == 1) { sq_seterr(st, "EXPLAIN is not available for this CREATE INDEX #503\0"); return 1; }; };
            i = k;
            raw = i;
            k = sq_vd_ident(t, n, i, @ns, @nl);
            if (k < 0) { if (sq_vd_gon(504) == 1) { sq_seterr(st, "EXPLAIN is not available for this CREATE INDEX #504\0"); return 1; }; };
            if (k < n) { if (t[k] == (byte)46) { if (sq_vd_gon(505) == 1) { sq_seterr(st, "EXPLAIN is not available for this CREATE INDEX #505\0"); return 1; }; }; };
            i = sq_vd_skip(t, n, k);
            k = sq_vd_word(t, n, i, "on\0");
            if (k < 0) { if (sq_vd_gon(506) == 1) { sq_seterr(st, "EXPLAIN is not available for this CREATE INDEX #506\0"); return 1; }; };
            i = sq_vd_skip(t, n, k);
            k = sq_vd_ident(t, n, i, @ts, @tl);
            if (k < 0) { if (sq_vd_gon(507) == 1) { sq_seterr(st, "EXPLAIN is not available for this CREATE INDEX #507\0"); return 1; }; };
            i = sq_vd_skip(t, n, k);
            if (i >= n) { if (sq_vd_gon(508) == 1) { sq_seterr(st, "EXPLAIN is not available for this CREATE INDEX #508\0"); return 1; }; };
            if (t[i] != (byte)40) { if (sq_vd_gon(509) == 1) { sq_seterr(st, "EXPLAIN is not available for this CREATE INDEX #509\0"); return 1; }; };
            if (ifn == 1) { if (sq_vd_have(st, t, ns, nl, 0) == 1) { return sq_vd_noop(st, 1, pq); }; };
            if (sq_obj_exists(st.db, @t[ns], nl) != 0) { if (sq_vd_gon(510) == 1) { sq_seterr(st, "EXPLAIN is not available for this CREATE INDEX #510\0"); return 1; }; };
            if (sq_vd_prep(st, "select * from \0", @t[ts], tl, (byte*)0, 0, @g) != 0) { return 1; };
            if (sq_vd_plain(st, g, @t[ts], tl, @nix) != 0) { sq_stmt_del(g); return 1; };
            b = g.blks[g.root_blk];
            sr = @b.src[0];
            ti = sr.ti;
            i = i + 1;
            nk = 0;
            nex = 0; hasw = 0; ws = 0;
            while (1 == 1)
            {
                i = sq_vd_skip(t, n, i);
                es = i;
                ee = sq_vd_elend(t, n, i);
                if (ee < 0 | nk >= 15 | ee <= es) { sq_stmt_del(g); sq_seterr(st, "EXPLAIN is not available for this CREATE INDEX\0"); return 1; };
                xe = sq_vd_elmod(t, es, ee, @d);
                kd[nk] = d;
                k = sq_vd_ident(t, n, es, @cs, @cl);
                c = 0 - 1;
                ke[nk] = 0 - 1;
                if (k >= 0)
                {
                    if (sq_vd_skip(t, n, k) >= xe)
                    {
                        for (j = 0; j < ti.ncols; j++)
                        {
                            if (ti.cl[j] == cl)
                            {
                                rc = 1;
                                for (d = 0; d < cl; d++) { if (sq_lc(ti.base[ti.cs[j] + d]) != sq_lc(t[cs + d])) { rc = 0; }; };
                                if (rc == 1) { c = j; };
                            };
                        };
                        if (c < 0 | c == ti.ipk) { sq_stmt_del(g); sq_seterr(st, "EXPLAIN is not available for this CREATE INDEX\0"); return 1; };
                    };
                };
                if (c < 0)
                {
                    ke[nk] = nex; exs[nex] = es; exe[nex] = xe; nex++;
                };
                kc[nk] = c;
                nk++;
                i = ee;
                if (t[i] == (byte)44) { i++; continue; };
                i++;
                break;
            };
            i = sq_vd_skip(t, n, i);
            if (i < n)
            {
                k = sq_vd_word(t, n, i, "where\0");
                if (k < 0) { sq_stmt_del(g); sq_seterr(st, "EXPLAIN is not available for this CREATE INDEX\0"); return 1; };
                ws = sq_vd_skip(t, n, k);
                hasw = 1;
            };
            g2 = g;
            if (nex > 0 | hasw == 1)
            {
                sq_sb_init(@sb);
                sq_sb_lit(@sb, "select \0");
                if (nex > 0)
                {
                    for (j = 0; j < nex; j++)
                    {
                        if (j > 0) { sq_sb_lit(@sb, ",\0"); };
                        sq_sb_add(@sb, @t[exs[j]], exe[j] - exs[j]);
                    };
                }
                else { sq_sb_lit(@sb, "*\0"); };
                sq_sb_lit(@sb, " from \0");
                a = 0;
                if (hasw == 1) { a = n - ws; };
                if (sq_vd_prep2(st, sb.p, @t[ts], tl, @t[ws], a, @g2) != 0) { sq_sb_free(@sb); sq_stmt_del(g); return 1; };
                sq_sb_free(@sb);
                b2 = g2.blks[g2.root_blk];
            };
            sq_sb_init(@kt);
            sq_sb_lit(@kt, "k(\0");
            sq_sb_int(@kt, (i64)(nk + 1));
            for (j = 0; j < nk; j++) { sq_sb_lit(@kt, ",\0"); if (kd[j] == 1) { sq_sb_lit(@kt, "-\0"); }; };
            sq_sb_lit(@kt, ",)\0");
            ck = st.db.cookie;
            sq_vd_reset();
            init = sq_vd_op("Init\0", 0, 0, 0);
            o = sq_vd_op("Noop\0", 0, 0, 0);
            sq_vd_op("CreateBtree\0", 0, 1, 2);
            a = sq_vd_op("OpenWrite\0", 0, 1, 0);
            sq_vd_p4i(a, (i64)5);
            a = sq_vd_op("String8\0", 0, 3, 0);
            sq_vd_p4s(a, "index\0", 5);
            a = sq_vd_op("String8\0", 0, 4, 0);
            sq_vd_p4s(a, @t[ns], nl);
            a = sq_vd_op("String8\0", 0, 5, 0);
            sq_vd_p4s(a, @t[ts], tl);
            sq_vd_op("SCopy\0", 1, 6, 0);
            a = sq_vd_op("String8\0", 0, 7, 0);
            sq_sb_init(@sb);
            if (uniq == 1) { sq_sb_lit(@sb, "CREATE UNIQUE INDEX \0"); } else { sq_sb_lit(@sb, "CREATE INDEX \0"); };
            sq_sb_add(@sb, @t[raw], n - raw);
            sq_vd_p4s(a, sb.p, sb.n);
            sq_sb_free(@sb);
            sq_vd_op("NewRowid\0", 0, 2, 0);
            a = sq_vd_op("MakeRecord\0", 3, 5, 8);
            sq_vd_p4s(a, "BBBDB\0", 5);
            a = sq_vd_op("Insert\0", 0, 8, 2);
            VD_P5[a] = 24;
            a = sq_vd_op("SorterOpen\0", 3, 0, nk);
            sq_vd_p4s(a, kt.p, kt.n);
            a = sq_vd_op("OpenRead\0", 1, sr.root, 0);
            sq_vd_p4i(a, (i64)ti.ncols);
            rew = sq_vd_op("Rewind\0", 1, 0, 0);
            hl = VD_N;
            VD_NMEM = 9; VD_NH = 0; VD_NH0 = 0; VD_NFREE = 0; VD_NJ = 0; VD_COLCUR = 1; VD_IDXCUR = 0;
            VD_PURE = 2;
            if (hasw == 1)
            {
                if (sq_vd_where(g2, ti, b2.where_n) != 0) { VD_PURE = 0; sq_sb_free(@kt); if ((u64)g2 != (u64)g) { sq_stmt_del(g2); }; sq_stmt_del(g); sq_seterr(st, "EXPLAIN is not available for this CREATE INDEX\0"); return 1; };
            };
            VD_PURE = 32;
            base = VD_NMEM + 1;
            VD_NMEM = base + nk;
            for (j = 0; j < nk; j++)
            {
                if (kc[j] >= 0) { sq_vd_op("Column\0", 1, kc[j], base + j); if (ti.aff[kc[j]] == 4) { sq_vd_op("Noop\0", base + j, 0, 0); }; }
                else
                {
                    if (sq_vd_expr(g2, ti, b2.rc[ke[j]], base + j) != 0) { VD_PURE = 0; sq_sb_free(@kt); if ((u64)g2 != (u64)g) { sq_stmt_del(g2); }; sq_stmt_del(g); sq_seterr(st, "EXPLAIN is not available for this CREATE INDEX\0"); return 1; };
                };
            };
            VD_PURE = 0;
            sq_vd_op("Rowid\0", 1, base + nk, 0);
            sq_vd_op("MakeRecord\0", base, nk + 1, 9);
            sq_vd_op("SorterInsert\0", 3, 9, 0);
            nxt = VD_N;
            a = sq_vd_op("Next\0", 1, hl, 0);
            for (j = 0; j < VD_NJ; j++) { VD_P2[VD_JF[j]] = nxt; };
            VD_P2[rew] = VD_N;
            a = sq_vd_op("OpenWrite\0", 2, 1, 0);
            sq_vd_p4s(a, kt.p, kt.n);
            VD_P5[a] = 17;
            sorts = sq_vd_op("SorterSort\0", 3, 0, 0);
            if (uniq == 1)
            {
                gt = sq_vd_op("Goto\0", 0, 0, 0);
                cmp = sq_vd_op("SorterCompare\0", 3, 0, 9);
                sq_vd_p4i(cmp, (i64)nk);
                a = sq_vd_op("Halt\0", 2067, 2, 0);
                sq_sb_init(@sb);
                if (nex > 0)
                {
                    sq_sb_lit(@sb, "index '\0");
                    sq_sb_add(@sb, @t[ns], nl);
                    sq_sb_lit(@sb, "'\0");
                }
                else
                {
                    for (j = 0; j < nk; j++)
                    {
                        if (j > 0) { sq_sb_lit(@sb, ", \0"); };
                        sq_sb_add(@sb, @t[ts], tl);
                        sq_sb_lit(@sb, ".\0");
                        sq_sb_add(@sb, @ti.base[ti.cs[kc[j]]], ti.cl[kc[j]]);
                    };
                };
                sq_vd_p4s(a, sb.p, sb.n);
                sq_sb_free(@sb);
                VD_P5[a] = 2;
                VD_P2[gt] = VD_N;
            };
            sd = sq_vd_op("SorterData\0", 3, 9, 2);
            sq_vd_op("SeekEnd\0", 2, 0, 0);
            a = sq_vd_op("IdxInsert\0", 2, 9, 0);
            VD_P5[a] = 16;
            if (uniq == 1) { sq_vd_op("SorterNext\0", 3, cmp, 0); VD_P2[cmp] = gt; }
            else { sq_vd_op("SorterNext\0", 3, sd, 0); };
            VD_P2[sorts] = VD_N;
            sq_vd_op("Close\0", 1, 0, 0);
            sq_vd_op("Close\0", 2, 0, 0);
            sq_vd_op("Close\0", 3, 0, 0);
            sq_vd_op("SetCookie\0", 0, 1, ck + 1);
            a = sq_vd_op("ParseSchema\0", 0, 0, 0);
            sq_sb_init(@sb);
            sq_sb_lit(@sb, "name='\0");
            sq_sb_add(@sb, @t[ns], nl);
            sq_sb_lit(@sb, "' AND type='index'\0");
            sq_vd_p4s(a, sb.p, sb.n);
            sq_sb_free(@sb);
            sq_vd_op("Expire\0", 0, 1, 0);
            VD_P2[o] = VD_N;
            sq_vd_op("Halt\0", 0, 0, 0);
            VD_P2[init] = VD_N;
            sq_vd_trans(st.db, 1);
            for (j = VD_NH0; j < VD_NH; j++) { sq_vd_lit(g2, VD_HN[j], VD_HR[j]); };
            sq_vd_op("Goto\0", 0, 1, 0);
            sq_sb_free(@kt);
            if ((u64)g2 != (u64)g) { sq_stmt_del(g2); };
            sq_stmt_del(g);
            sq_vd_query(pq);
            return 0;
        };

        // case-insensitive name equality between a NUL-terminated schema name and a slice of the statement
        def sq_vd_nameeq(byte* nm, byte* t, int ns, int nl) -> bool
        {
            int k;
            for (k = 0; k < nl; k++)
            {
                if (nm[k] == (byte)0) { return false; };
                if (sq_lc(nm[k]) != sq_lc(t[ns + k])) { return false; };
            };
            return nm[nl] == (byte)0;
        };

        // the relocation pass after one Destroy: rewrites the sqlite_master rows whose root page moved
        def sq_vd_dropblock(int j, int root, int* pb) -> void
        {
            int curR, curE, b, v, rec, a, ifn, rw, body, nx, w2, ne2, rw2, ro, ne;
            curR = 2 * j + 1; curE = 2 * j + 2;
            if (j == 0) { b = 6; v = 8; rec = 15; } else { b = *pb; v = b + 2; rec = v + 5; };
            sq_vd_op("Destroy\0", root, 2, 0);
            sq_vd_op("Null\0", 0, b, b + 1);
            sq_vd_op("OpenEphemeral\0", curE, 0, b);
            ifn = sq_vd_op("IfNot\0", 2, 0, 1);
            a = sq_vd_op("OpenRead\0", curR, 1, 0);
            sq_vd_p4i(a, (i64)4);
            rw = sq_vd_op("Rewind\0", curR, 0, 0);
            body = VD_N;
            sq_vd_op("Column\0", curR, 3, 13);
            ne = sq_vd_op("Ne\0", 2, 0, 13);
            sq_vd_p4s(ne, "BINARY-8\0", 8);
            VD_P5[ne] = 84;
            sq_vd_op("Rowid\0", curR, b + 1, 0);
            sq_vd_op("Insert\0", curE, b, b + 1);
            nx = VD_N;
            a = sq_vd_op("Next\0", curR, body, 0);
            VD_P5[a] = 1;
            VD_P2[ne] = nx;
            VD_P2[ifn] = VD_N;
            VD_P2[rw] = VD_N;
            a = sq_vd_op("OpenWrite\0", curR, 1, 0);
            sq_vd_p4i(a, (i64)5);
            rw2 = sq_vd_op("Rewind\0", curE, 0, 0);
            ro = sq_vd_op("Rowid\0", curE, b + 1, 0);
            ne2 = sq_vd_op("NotExists\0", curR, 0, b + 1);
            sq_vd_op("Column\0", curR, 0, v);
            sq_vd_op("Column\0", curR, 1, v + 1);
            sq_vd_op("Column\0", curR, 2, v + 2);
            sq_vd_op("Integer\0", root, v + 3, 0);
            sq_vd_op("Column\0", curR, 4, v + 4);
            a = sq_vd_op("MakeRecord\0", v, 5, rec);
            sq_vd_p4s(a, "BBBDB\0", 5);
            sq_vd_op("Insert\0", curR, rec, b + 1);
            VD_P2[ne2] = VD_N;
            sq_vd_op("Next\0", curE, ro, 0);
            VD_P2[rw2] = VD_N;
            *pb = rec + 1;
        };

        // DROP TABLE / DROP INDEX
        def sq_vd_drop(SQ_STMT* st, byte* t, int n, int i, int istab, byte** pq) -> int
        {
            SQ_STMT* g;
            SQ_BLK* bk;
            SQ_SRC* sr;
            SQ_TI* ti;
            SQ_IDX[12] ixs;
            int[16] roots;
            int init, a, k, ns, nl, nix, j, x, y, tmp, ck, rw, body, nx, nb, found, nr, pos, sname, ifx;
            byte* stored;
            i = sq_vd_skip(t, n, i);
            ifx = 0;
            k = sq_vd_word(t, n, i, "if\0");
            if (k >= 0)
            {
                i = sq_vd_skip(t, n, k);
                k = sq_vd_word(t, n, i, "exists\0");
                if (k < 0) { if (sq_vd_gon(511) == 1) { sq_seterr(st, "EXPLAIN is not available for this DROP #511\0"); return 1; }; };
                i = sq_vd_skip(t, n, k);
                ifx = 1;
            };
            k = sq_vd_ident(t, n, i, @ns, @nl);
            if (k < 0) { if (sq_vd_gon(512) == 1) { sq_seterr(st, "EXPLAIN is not available for this DROP #512\0"); return 1; }; };
            if (k < n) { if (t[k] == (byte)46) { if (sq_vd_gon(513) == 1) { sq_seterr(st, "EXPLAIN is not available for this DROP #513\0"); return 1; }; }; };
            i = sq_vd_skip(t, n, k);
            if (i < n) { if (sq_vd_gon(514) == 1) { sq_seterr(st, "EXPLAIN is not available for this DROP #514\0"); return 1; }; };
            if (ifx == 1)
            {
                found = 0;
                for (j = 0; j < st.db.nschema; j++)
                {
                    if (sq_vd_nameeq(st.db.schema[j].name, t, ns, nl)) { found = 1; };
                };
                if (found == 0)
                {
                    sq_vd_reset();
                    init = sq_vd_op("Init\0", 0, 0, 0);
                    sq_vd_op("JournalMode\0", 0, 1, 0 - 1);
                    sq_vd_op("Halt\0", 0, 0, 0);
                    VD_P2[init] = VD_N;
                    sq_vd_trans(st.db, 0);
                    sq_vd_op("Goto\0", 0, 1, 0);
                    sq_vd_query(pq);
                    return 0;
                };
            };
            ck = st.db.cookie;
            nr = 0;
            g = (SQ_STMT*)0;
            if (istab == 1)
            {
                if (sq_vd_prep(st, "select * from \0", @t[ns], nl, (byte*)0, 0, @g) != 0) { return 1; };
                if (sq_vd_plain(st, g, @t[ns], nl, @nix) != 0) { sq_stmt_del(g); return 1; };
                bk = g.blks[g.root_blk];
                sr = @bk.src[0];
                ti = sr.ti;
                if (ti.autoinc != 0 | ti.wor != 0) { sq_stmt_del(g); sq_seterr(st, "EXPLAIN is not available for this DROP\0"); return 1; };
                nix = sq_idx_list(sr.sdb, sr.tbl, ti, @ixs[0], 12);
                if (nix > 12) { sq_stmt_del(g); sq_seterr(st, "EXPLAIN is not available for this DROP\0"); return 1; };
                for (j = 0; j < nix; j++) { roots[nr] = ixs[j].root; nr++; };
                roots[nr] = sr.root; nr++;
                stored = sr.sdb.schema[sr.tbl].name;
            }
            else
            {
                found = 0 - 1;
                for (j = 0; j < st.db.nschema; j++)
                {
                    if (st.db.schema[j].kind != 2) { continue; };
                    if (sq_vd_nameeq(st.db.schema[j].name, t, ns, nl)) { found = j; };
                };
                if (found < 0) { if (sq_vd_gon(515) == 1) { sq_seterr(st, "EXPLAIN is not available for this DROP #515\0"); return 1; }; };
                if ((u64)st.db.schema[found].sql == (u64)0) { if (sq_vd_gon(516) == 1) { sq_seterr(st, "EXPLAIN is not available for this DROP #516\0"); return 1; }; };
                roots[0] = st.db.schema[found].rootpage; nr = 1;
                stored = st.db.schema[found].name;
            };
            for (x = 0; x < nr; x++)
            {
                for (y = x + 1; y < nr; y++)
                {
                    if (roots[y] > roots[x]) { tmp = roots[x]; roots[x] = roots[y]; roots[y] = tmp; };
                };
            };
            sq_vd_reset();
            init = sq_vd_op("Init\0", 0, 0, 0);
            sq_vd_op("Null\0", 0, 1, 0);
            a = sq_vd_op("OpenWrite\0", 0, 1, 0);
            sq_vd_p4i(a, (i64)5);
            rw = sq_vd_op("Rewind\0", 0, 0, 0);
            body = VD_N;
            if (istab == 1)
            {
                sq_vd_op("Column\0", 0, 2, 2);
                k = sq_vd_op("Ne\0", 3, 0, 2);
                sq_vd_p4s(k, "BINARY-8\0", 8);
                VD_P5[k] = 82;
                sq_vd_op("Column\0", 0, 0, 2);
                x = sq_vd_op("Eq\0", 4, 0, 2);
                sq_vd_p4s(x, "BINARY-8\0", 8);
                VD_P5[x] = 82;
            }
            else
            {
                sq_vd_op("Column\0", 0, 1, 2);
                k = sq_vd_op("Ne\0", 3, 0, 2);
                sq_vd_p4s(k, "BINARY-8\0", 8);
                VD_P5[k] = 82;
                sq_vd_op("Column\0", 0, 0, 2);
                x = sq_vd_op("Ne\0", 4, 0, 2);
                sq_vd_p4s(x, "BINARY-8\0", 8);
                VD_P5[x] = 82;
            };
            sq_vd_op("Rowid\0", 0, 5, 0);
            a = sq_vd_op("Delete\0", 0, 0, 0);
            VD_P5[a] = 2;
            nx = VD_N;
            a = sq_vd_op("Next\0", 0, body, 0);
            VD_P5[a] = 1;
            VD_P2[k] = nx; VD_P2[x] = nx;
            VD_P2[rw] = VD_N;
            if (istab == 0) { sq_vd_op("SetCookie\0", 0, 1, ck + 1); };
            nb = 0;
            for (j = 0; j < nr; j++) { sq_vd_dropblock(j, roots[j], @nb); };
            if (istab == 1)
            {
                a = sq_vd_op("DropTable\0", 0, 0, 0);
                sq_vd_p4s(a, stored, sq_cstrlen(stored));
                sq_vd_op("SetCookie\0", 0, 1, ck + 1);
            }
            else
            {
                a = sq_vd_op("DropIndex\0", 0, 0, 0);
                sq_vd_p4s(a, stored, sq_cstrlen(stored));
            };
            sq_vd_op("Halt\0", 0, 0, 0);
            VD_P2[init] = VD_N;
            sq_vd_trans(st.db, 1);
            a = sq_vd_op("String8\0", 0, 3, 0);
            sq_vd_p4s(a, stored, sq_cstrlen(stored));
            a = sq_vd_op("String8\0", 0, 4, 0);
            if (istab == 1) { sq_vd_p4s(a, "trigger\0", 7); } else { sq_vd_p4s(a, "index\0", 5); };
            sq_vd_op("Goto\0", 0, 1, 0);
            if ((u64)g != (u64)0) { sq_stmt_del(g); };
            sq_vd_query(pq);
            return 0;
        };

        // transaction control, savepoints, VACUUM and the user_version / application_id / schema_version pragmas
        // one REINDEX rebuild pass per index of a table (newest index first); only = schema position of the one index, or -1 for all
        def sq_vd_reindex_tab(SQ_STMT* st, byte* nm, int nl, int only, int* ppass, int mode, int* pmax) -> int
        {
            SQ_STMT* g;
            SQ_BLK* bk;
            SQ_SRC* sr;
            SQ_TI* ti;
            SQ_IDX[12] ixs;
            SQ_IDX* xi;
            SQ_SB aff;
            SQ_SB kt;
            SQ_IDX wsyn;
            int[130] rcols;
            int kmin, ex, dd, nrc, tm, ii, hx, slot, nj0;
            SQ_STMT* gk;
            int nix, nx, k, j, ct, ci, cs, a, rw, body, sn, sg, ncols, base, tmax, jt;
            base = 0;
            tmax = 0;
            g = (SQ_STMT*)0;
            if (sq_vd_prep(st, "select * from \0", nm, nl, (byte*)0, 0, @g) != 0) { return 1; };
            VD_PLWOR = 1;
            ii = sq_vd_plain(st, g, nm, nl, @nix);
            VD_PLWOR = 0;
            if (ii != 0) { sq_stmt_del(g); return 1; };
            bk = g.blks[g.root_blk];
            sr = @bk.src[0];
            ti = sr.ti;
            ncols = ti.ncols;
            nx = sq_idx_list(sr.sdb, sr.tbl, ti, @ixs[0], 12);
            kmin = 0;
            if (ti.wor != 0)
            {
                sq_vd_worsyn(ti, sr, @wsyn);
                for (j = 0; j < nl; j++) { wsyn.name[j] = nm[j]; };
                wsyn.name[nl] = (byte)0;
                wsyn.schema_pos = 0 - 5;
                wsyn.ispk = 1;
                if (only < 0) { kmin = 0 - 1; };
            };
            for (k = nx - 1; k >= kmin; k--)
            {
                if (k >= 0) { xi = @ixs[k]; } else { xi = @wsyn; };
                if (only >= 0 & xi.schema_pos != only) { continue; };
                if (xi.nk < 1) { sq_stmt_del(g); sq_seterr(st, "EXPLAIN is not available for this index\0"); return 1; };
                for (j = 0; j < xi.nk; j++)
                {
                    if (xi.isx[j] == 0 & ((xi.col[j] == ti.ipk & ti.wor == 0) | xi.col[j] >= ncols)) { sq_stmt_del(g); sq_seterr(st, "EXPLAIN is not available for this index\0"); return 1; };
                };
                if (ti.wor != 0 & (xi.partial != 0 | xi.ne != 0)) { sq_stmt_del(g); sq_seterr(st, "EXPLAIN is not available for this index\0"); return 1; };
                if (xi.partial != 0 | xi.ne != 0)
                {
                    VD_IXST = (u64)st; VD_IXNM = (u64)nm; VD_IXNL = nl;
                    if (sq_vd_ixprobe(ti, xi, 0) != 0) { sq_stmt_del(g); sq_seterr(st, "EXPLAIN is not available for this index\0"); return 1; };
                };
                if (mode == 2) { *ppass = *ppass + 1; continue; };
                if (mode == 1)
                {
                    for (j = 0; j < xi.nk; j++) { if (xi.coll[j] != 0) { sq_stmt_del(g); sq_seterr(st, "EXPLAIN is not available for this index collation\0"); return 1; }; };
                    continue;
                };
                nrc = xi.nk + 1;
                ex = 1;
                if (ti.wor != 0)
                {
                    for (j = 0; j < xi.nk; j++) { rcols[j] = xi.col[j]; };
                    nrc = xi.nk;
                    if (k >= 0)
                    {
                        for (dd = 0; dd < ti.npk; dd++)
                        {
                            tm = 0;
                            for (j = 0; j < xi.nk; j++) { if (xi.col[j] == ti.pkc[dd]) { tm = 1; }; };
                            if (tm == 0) { rcols[nrc] = ti.pkc[dd]; nrc++; };
                        };
                        ex = nrc - xi.nk;
                    }
                    else
                    {
                        for (dd = 0; dd < ncols; dd++)
                        {
                            tm = 0;
                            for (j = 0; j < xi.nk; j++) { if (xi.col[j] == dd) { tm = 1; }; };
                            if (tm == 0) { rcols[nrc] = dd; nrc++; };
                        };
                        ex = 0;
                    };
                };
                tmax = nrc;
                if (tmax <= pmax[2])
                {
                    base = pmax[1];
                    pmax[2] = pmax[2] - tmax;
                    pmax[1] = pmax[1] + tmax;
                }
                else
                {
                    base = pmax[0] + 1;
                    pmax[0] = pmax[0] + tmax;
                };
                if (tmax > pmax[2]) { pmax[1] = base; pmax[2] = tmax; };
                ct = 3 * (*ppass); ci = ct + 1; cs = ct + 2;
                *ppass = *ppass + 1;
                nj0 = VD_NJ;
                sq_sb_init(@aff);
                if (ti.wor != 0 & k >= 0) { ii = sq_vd_kinfo2(xi, ex, @aff); } else { ii = sq_vd_kinfo(xi, @aff); };
                if (ii != 0) { sq_sb_free(@aff); sq_stmt_del(g); sq_seterr(st, "EXPLAIN is not available for this index collation\0"); return 1; };
                a = sq_vd_op("SorterOpen\0", cs, 0, xi.nk);
                sq_vd_p4s(a, aff.p, aff.n);
                a = sq_vd_op("OpenRead\0", ct, sr.root, 0);
                if (ti.wor != 0)
                {
                    sq_sb_init(@kt);
                    if (sq_vd_kinfo(@wsyn, @kt) != 0) { sq_sb_free(@kt); sq_sb_free(@aff); sq_stmt_del(g); sq_seterr(st, "EXPLAIN is not available for this index collation\0"); return 1; };
                    sq_vd_p4s(a, kt.p, kt.n);
                    sq_sb_free(@kt);
                }
                else { sq_vd_p4i(a, (i64)ncols); };
                rw = sq_vd_op("Rewind\0", ct, 0, 0);
                body = VD_N;
                if (ti.wor != 0)
                {
                    for (j = 0; j < nrc; j++) { sq_vd_op("Column\0", ct, rcols[j], base + j); };
                    sq_vd_op("MakeRecord\0", base, nrc, 1);
                }
                else
                {
                    hx = 0;
                    for (j = 0; j < xi.nk; j++) { if (xi.isx[j] != 0) { hx = 1; }; };
                    slot = 0 - 1;
                    nj0 = VD_NJ;
                    if (xi.partial != 0 | hx == 1)
                    {
                        VD_DTI = ti; VD_COLCUR = ct;
                        VD_NFREE = 0;
                        tm = base + xi.nk;
                        if (xi.partial != 0) { tm++; };
                        for (dd = 0; dd < VD_NH; dd++) { if (VD_HR[dd] > tm) { tm = VD_HR[dd]; }; };
                        VD_NMEM = tm;
                        slot = sq_vd_ixwhere(xi, @gk, @nj0);
                        if (slot == 0 - 2) { VD_COLCUR = 0; sq_stmt_del(g); sq_seterr(st, "EXPLAIN is not available for this index\0"); return 1; };
                    };
                    for (j = 0; j < xi.nk; j++)
                    {
                        if (xi.isx[j] != 0)
                        {
                            if (sq_vd_ixkey(xi, gk, slot, j, ct, base + j) != 0) { VD_COLCUR = 0; sq_stmt_del(g); sq_seterr(st, "EXPLAIN is not available for this index\0"); return 1; };
                        }
                        else
                        {
                            sq_vd_op("Column\0", ct, xi.col[j], base + j);
                            if (xi.col[j] >= 0 & xi.col[j] < ti.ncols) { if (ti.aff[xi.col[j]] == 4) { sq_vd_op("Noop\0", base + j, 0, 0); }; };
                        };
                    };
                    sq_vd_op("Rowid\0", ct, base + xi.nk, 0);
                    sq_vd_op("MakeRecord\0", base, xi.nk + 1, 1);
                    VD_COLCUR = 0;
                    if (slot >= 0) { if (VD_NMEM > pmax[0]) { pmax[0] = VD_NMEM; }; };
                };
                sq_vd_op("SorterInsert\0", cs, 1, 0);
                for (jt = nj0; jt < VD_NJ; jt++) { VD_P2[VD_JF[jt]] = VD_N; };
                VD_NJ = nj0;
                sq_vd_op("Next\0", ct, body, 0);
                VD_P2[rw] = VD_N;
                sq_vd_op("Clear\0", xi.root, 0, 0);
                a = sq_vd_op("OpenWrite\0", ci, xi.root, 0);
                sq_vd_p4s(a, aff.p, aff.n);
                VD_P5[a] = 1;
                sq_sb_free(@aff);
                sn = sq_vd_op("SorterSort\0", cs, 0, 0);
                sg = VD_N;
                jt = 0 - 1;
                if (xi.unique != 0)
                {
                    jt = sq_vd_op("Goto\0", 0, 0, 0);
                    sg = VD_N;
                    a = sq_vd_op("SorterCompare\0", cs, jt, 1);
                    sq_vd_p4i(a, (i64)xi.nk);
                    sq_sb_init(@aff);
                    for (j = 0; j < xi.nk; j++)
                    {
                        if (j > 0) { sq_sb_lit(@aff, ", \0"); };
                        sq_sb_add(@aff, nm, nl);
                        sq_sb_lit(@aff, ".\0");
                        sq_sb_add(@aff, @ti.base[ti.cs[xi.col[j]]], ti.cl[xi.col[j]]);
                    };
                    if (xi.ispk != 0) { a = sq_vd_op("Halt\0", 1555, 2, 0); } else { a = sq_vd_op("Halt\0", 2067, 2, 0); };
                    sq_vd_p4s(a, aff.p, aff.n);
                    VD_P5[a] = 2;
                    sq_sb_free(@aff);
                    VD_P2[jt] = VD_N;
                };
                sq_vd_op("SorterData\0", cs, 1, ci);
                sq_vd_op("SeekEnd\0", ci, 0, 0);
                a = sq_vd_op("IdxInsert\0", ci, 1, 0);
                VD_P5[a] = 16;
                sq_vd_op("SorterNext\0", cs, sg, 0);
                VD_P2[sn] = VD_N;
                sq_vd_op("Close\0", ct, 0, 0);
                sq_vd_op("Close\0", ci, 0, 0);
                sq_vd_op("Close\0", cs, 0, 0);
            };
            sq_stmt_del(g);
            return 0;
        };

        // links element e into the table hash list, in bucket b when the bucket array exists (SQLite's insertElement)
        def sq_vd_hins(int e, int b, int* nxt, int* prv, int* first, int* bcnt, int* bch) -> void
        {
            int hd;
            hd = 0 - 1;
            if (b >= 0)
            {
                if (bcnt[b] != 0) { hd = bch[b]; };
                bcnt[b] = bcnt[b] + 1;
                bch[b] = e;
            };
            if (hd >= 0)
            {
                nxt[e] = hd;
                prv[e] = prv[hd];
                if (prv[hd] >= 0) { nxt[prv[hd]] = e; } else { *first = e; };
                prv[hd] = e;
            }
            else
            {
                nxt[e] = *first;
                if (*first >= 0) { prv[*first] = e; };
                prv[e] = 0 - 1;
                *first = e;
            };
        };

        // the order SQLite walks its table hash (REINDEX, ANALYZE): sqlite_master first inserted, then the tables and views in creation order.
        // fills ord with schema positions (-1 for sqlite_master) and returns how many, or -1 when there are too many
        def sq_vd_tblorder(SQLITE_DB* db, int* ord) -> int
        {
            int[96] nxt;
            int[96] prv;
            int[96] sch;
            u64[96] hv;
            int[400] bcnt;
            int[400] bch;
            int first, count, htsize, i, j, e, ne, nsz, n, c, b, ee, nx2;
            byte* nm;
            u64 h;
            byte[16] mn;
            mn[0] = (byte)115; mn[1] = (byte)113; mn[2] = (byte)108; mn[3] = (byte)105; mn[4] = (byte)116; mn[5] = (byte)101; mn[6] = (byte)95;
            mn[7] = (byte)109; mn[8] = (byte)97; mn[9] = (byte)115; mn[10] = (byte)116; mn[11] = (byte)101; mn[12] = (byte)114; mn[13] = (byte)0;
            first = 0 - 1; count = 0; htsize = 0; ne = 0;
            for (i = 0 - 1; i < db.nschema; i++)
            {
                if (i >= 0) { if (db.schema[i].kind != 1 & db.schema[i].kind != 3) { continue; }; };
                if (ne >= 90) { return 0 - 1; };
                e = ne;
                ne++;
                if (i < 0) { nm = @mn[0]; } else { nm = @db.schema[i].name[0]; };
                sch[e] = i;
                h = (u64)0;
                c = 0;
                while (nm[c] != (byte)0)
                {
                    h = (h + ((u64)nm[c] `& (u64)223)) `& (u64)4294967295;
                    h = (h * (u64)2654435761) `& (u64)4294967295;
                    c++;
                };
                hv[e] = h;
                count++;
                if (count >= 5 & count > 2 * htsize)
                {
                    nsz = count * 3;
                    if (nsz > 400) { return 0 - 1; };
                    htsize = nsz;
                    for (j = 0; j < htsize; j++) { bcnt[j] = 0; bch[j] = 0 - 1; };
                    ee = first;
                    first = 0 - 1;
                    while (ee >= 0)
                    {
                        nx2 = nxt[ee];
                        sq_vd_hins(ee, (int)(hv[ee] % (u64)htsize), @nxt[0], @prv[0], @first, @bcnt[0], @bch[0]);
                        ee = nx2;
                    };
                };
                b = 0 - 1;
                if (htsize > 0) { b = (int)(h % (u64)htsize); };
                sq_vd_hins(e, b, @nxt[0], @prv[0], @first, @bcnt[0], @bch[0]);
            };
            n = 0;
            ee = first;
            while (ee >= 0)
            {
                ord[n] = sch[ee];
                n++;
                ee = nxt[ee];
            };
            return n;
        };

        // the statistics gathering of one table for ANALYZE; only is the schema position of the single index to analyze, or -1
        def sq_vd_analyze_tab(SQ_STMT* st, byte* nm, int nl, int only, int tabcur, int M) -> int
        {
            SQ_STMT* g;
            SQ_BLK* bk;
            SQ_SRC* sr;
            SQ_TI* ti;
            SQ_IDX[12] ixs;
            SQ_IDX* xi;
            SQ_IDX wsyn;
            int kmin, ex, dd, sgp;
            SQ_SB kb;
            int[16] ne;
            int nx, k, j, a, ncols, ci, ncol, ntest, needcnt, rw, gt, nxt, nn, e1, allnn, jz, rNew, rStat, rChng, rRowid, rTemp, rTemp2, rTab, rIdx, rStat1, rPrev, nix;
            rNew = M; rStat = M + 1; rChng = M + 2; rRowid = M + 3; rTemp = M + 4; rTemp2 = M + 5; rTab = M + 6; rIdx = M + 7; rStat1 = M + 8; rPrev = M + 9;
            g = (SQ_STMT*)0;
            if (sq_vd_prep(st, "select * from \0", nm, nl, (byte*)0, 0, @g) != 0) { return 1; };
            bk = g.blks[g.root_blk];
            if (bk.nsrc != 1) { sq_stmt_del(g); sq_seterr(st, "EXPLAIN is not available for this statement\0"); return 1; };
            sr = @bk.src[0];
            if (sr.kind != 1 | (u64)sr.ti == (u64)0 | sr.tbl < 0) { sq_stmt_del(g); sq_seterr(st, "EXPLAIN is not available for this table\0"); return 1; };
            ti = sr.ti;
            ncols = ti.ncols;
            ci = tabcur + 1;
            nx = sq_idx_list(sr.sdb, sr.tbl, ti, @ixs[0], 12);
            a = sq_vd_op("OpenRead\0", tabcur, sr.root, 0);
            kmin = 0;
            if (ti.wor != 0)
            {
                sq_vd_worsyn(ti, sr, @wsyn);
                wsyn.name[0] = (byte)0;
                for (j = 0; j < nl; j++) { wsyn.name[j] = nm[j]; };
                wsyn.name[nl] = (byte)0;
                wsyn.schema_pos = 0 - 5;
                sq_sb_init(@kb);
                if (sq_vd_kinfo(@wsyn, @kb) != 0) { sq_sb_free(@kb); sq_stmt_del(g); sq_seterr(st, "EXPLAIN is not available for this index collation\0"); return 1; };
                sq_vd_p4s(a, kb.p, kb.n);
                sq_sb_free(@kb);
                if (only < 0) { kmin = 0 - 1; };
            }
            else { sq_vd_p4i(a, (i64)ncols); };
            a = sq_vd_op("String8\0", 0, rTab, 0);
            sq_vd_p4s(a, nm, nl);
            needcnt = 1;
            for (k = nx - 1; k >= kmin; k--)
            {
                if (k >= 0) { xi = @ixs[k]; } else { xi = @wsyn; };
                if (only >= 0 & xi.schema_pos != only) { continue; };
                if (xi.nk < 1) { sq_stmt_del(g); sq_seterr(st, "EXPLAIN is not available for this index\0"); return 1; };
                for (j = 0; j < xi.nk; j++)
                {
                    if (xi.isx[j] == 0 & ((xi.col[j] == ti.ipk & ti.wor == 0) | xi.col[j] >= ncols)) { sq_stmt_del(g); sq_seterr(st, "EXPLAIN is not available for this index\0"); return 1; };
                };
                needcnt = 0;
                ncol = xi.nk + 1;
                ex = 1;
                if (ti.wor != 0)
                {
                    ex = ti.npk;
                    if (k < 0) { ex = 0; }
                    else
                    {
                        for (dd = 0; dd < ti.npk; dd++) { for (j = 0; j < xi.nk; j++) { if (xi.col[j] == ti.pkc[dd]) { ex--; break; }; }; };
                    };
                    ncol = xi.nk + ex;
                };
                ntest = ncol - 1;
                if (xi.unique != 0 & xi.uqnn != 0) { ntest = xi.nk - 1; };
                a = sq_vd_op("String8\0", 0, rIdx, 0);
                sq_vd_p4s(a, @xi.name[0], sq_cstrlen(@xi.name[0]));
                sq_sb_init(@kb);
                if (ti.wor != 0 & k >= 0)
                {
                    if (sq_vd_kinfo2(xi, ex, @kb) != 0) { sq_sb_free(@kb); sq_stmt_del(g); sq_seterr(st, "EXPLAIN is not available for this index collation\0"); return 1; };
                }
                else
                {
                    if (sq_vd_kinfo(xi, @kb) != 0) { sq_sb_free(@kb); sq_stmt_del(g); sq_seterr(st, "EXPLAIN is not available for this index collation\0"); return 1; };
                };
                a = sq_vd_op("OpenRead\0", ci, xi.root, 0);
                sq_vd_p4s(a, kb.p, kb.n);
                sq_sb_free(@kb);
                sq_vd_op("Integer\0", 0, rTemp2, 0);
                sq_vd_op("Integer\0", ncol, rChng, 0);
                sq_vd_op("Integer\0", xi.nk, rRowid, 0);
                sq_vd_op("Count\0", ci, rTemp, 0);
                a = sq_vd_op("Function\0", 0, rChng, rStat);
                sq_vd_p4s(a, "stat_init(4)\0", 12);
                rw = sq_vd_op("Rewind\0", ci, 0, 0);
                sq_vd_op("Integer\0", 0, rChng, 0);
                nxt = VD_N;
                if (ntest > 0)
                {
                    gt = sq_vd_op("Goto\0", 0, 0, 0);
                    nxt = VD_N;
                    nn = 0 - 1;
                    if (ntest == 1 & xi.nk == 1 & xi.unique != 0) { nn = sq_vd_op("NotNull\0", rPrev, 0, 0); };
                    for (j = 0; j < ntest; j++)
                    {
                        sq_vd_op("Integer\0", j, rChng, 0);
                        sq_vd_op("Column\0", ci, j, rTemp);
                        ne[j] = sq_vd_op("Ne\0", rTemp, 0, rPrev + j);
                        sq_vd_p4s(ne[j], "BINARY-8\0", 8);
                        VD_P5[ne[j]] = 128;
                    };
                    sq_vd_op("Integer\0", ntest, rChng, 0);
                    e1 = sq_vd_op("Goto\0", 0, 0, 0);
                    VD_P2[gt] = VD_N;
                    for (j = 0; j < ntest; j++)
                    {
                        VD_P2[ne[j]] = VD_N;
                        sq_vd_op("Column\0", ci, j, rPrev + j);
                    };
                    VD_P2[e1] = VD_N;
                    if (nn >= 0) { VD_P2[nn] = VD_N; };
                };
                a = sq_vd_op("Function\0", 1, rStat, rTemp);
                sq_vd_p4s(a, "stat_push(2)\0", 12);
                sq_vd_op("Next\0", ci, nxt, 0);
                sgp = VD_N;
                a = sq_vd_op("Function\0", 0, rStat, rStat1);
                sq_vd_p4s(a, "stat_get(1)\0", 12);
                a = sq_vd_op("MakeRecord\0", rTab, 3, rTemp);
                sq_vd_p4s(a, "BBB\0", 3);
                sq_vd_op("NewRowid\0", 0, rNew, 0);
                a = sq_vd_op("Insert\0", 0, rTemp, rNew);
                VD_P5[a] = 8;
                VD_P2[rw] = VD_N;
                if (xi.partial != 0) { VD_P2[rw] = sgp; };
            };
            if (only < 0 & needcnt != 0)
            {
                sq_vd_op("Count\0", tabcur, rStat1, 0);
                jz = sq_vd_op("IfNot\0", rStat1, 0, 0);
                sq_vd_op("Null\0", 0, rIdx, 0);
                a = sq_vd_op("MakeRecord\0", rTab, 3, rTemp);
                sq_vd_p4s(a, "BBB\0", 3);
                sq_vd_op("NewRowid\0", 0, rNew, 0);
                a = sq_vd_op("Insert\0", 0, rTemp, rNew);
                VD_P5[a] = 8;
                VD_P2[jz] = VD_N;
            };
            sq_stmt_del(g);
            return 0;
        };

        // ANALYZE [table | index]
        def sq_vd_analyze(SQ_STMT* st, byte* t, int n, int i, byte** pq) -> int
        {
            int init, k, ns, nl, j, stat, root, M, tabcur, a, found, fkind, rw, ne, nx, x, nu, byname, only;
            byte* tn;
            byte[72] nb;
            int[96] ordv;
            i = sq_vd_skip(t, n, i);
            ns = 0; nl = 0; found = 0 - 1; only = 0 - 1; byname = 0;
            if (i < n)
            {
                k = sq_vd_ident(t, n, i, @ns, @nl);
                if (k < 0) { if (sq_vd_gon(517) == 1) { sq_seterr(st, "EXPLAIN is not available for this ANALYZE #517\0"); return 1; }; };
                if (k < n) { if (t[k] == (byte)46) { if (sq_vd_gon(518) == 1) { sq_seterr(st, "EXPLAIN is not available for this ANALYZE #518\0"); return 1; }; }; };
                i = sq_vd_skip(t, n, k);
                if (i < n) { if (sq_vd_gon(519) == 1) { sq_seterr(st, "EXPLAIN is not available for this ANALYZE #519\0"); return 1; }; };
                if (nl == 4 & sq_vd_word(t, n, ns, "main\0") >= 0) { byname = 0; }
                else
                {
                    for (j = 0; j < st.db.nschema; j++)
                    {
                        if (st.db.schema[j].kind != 2 & st.db.schema[j].kind != 1) { continue; };
                        if (sq_vd_nameeq(st.db.schema[j].name, t, ns, nl)) { found = j; };
                    };
                    if (found < 0) { if (sq_vd_gon(520) == 1) { sq_seterr(st, "EXPLAIN is not available for this ANALYZE #520\0"); return 1; }; };
                    tn = st.db.schema[found].name;
                    if (st.db.schema[found].kind == 1) { if (tn[0] == (byte)115 & tn[1] == (byte)113 & tn[2] == (byte)108 & tn[3] == (byte)105 & tn[4] == (byte)116 & tn[5] == (byte)101 & tn[6] == (byte)95) { if (sq_vd_gon(521) == 1) { sq_seterr(st, "EXPLAIN is not available for this ANALYZE #521\0"); return 1; }; }; };
                    byname = 1;
                };
            };
            stat = 0 - 1;
            for (j = 0; j < st.db.nschema; j++)
            {
                if (st.db.schema[j].kind == 1 & sq_vd_nameeq(st.db.schema[j].name, "sqlite_stat1\0", 0, 12)) { stat = j; };
            };
            sq_vd_reset();
            init = sq_vd_op("Init\0", 0, 0, 0);
            if (stat < 0)
            {
                VD_NEST = 1;
                nb[0] = (byte)0;
                k = sq_vd_create_table(st, "sqlite_stat1(tbl,idx,stat)\0", 26, 0, pq);
                VD_NEST = 0;
                if (k != 0) { return 1; };
                a = sq_vd_op("OpenWrite\0", 0, 2, 0);
                sq_vd_p4i(a, (i64)3);
                VD_P5[a] = 16;
                M = 12; tabcur = 5;
            }
            else
            {
                root = st.db.schema[stat].rootpage;
                tabcur = 3;
                if (byname == 0)
                {
                    sq_vd_op("Clear\0", root, 0, 0);
                    a = sq_vd_op("OpenWrite\0", 0, root, 0);
                    sq_vd_p4i(a, (i64)3);
                    M = 1;
                }
                else
                {
                    sq_vd_op("Null\0", 0, 1, 0);
                    a = sq_vd_op("OpenWrite\0", 3, root, 0);
                    sq_vd_p4i(a, (i64)3);
                    rw = sq_vd_op("Rewind\0", 3, 0, 0);
                    if (st.db.schema[found].kind == 1) { sq_vd_op("Column\0", 3, 0, 2); } else { sq_vd_op("Column\0", 3, 1, 2); };
                    ne = sq_vd_op("Ne\0", 3, 0, 2);
                    sq_vd_p4s(ne, "BINARY-8\0", 8);
                    VD_P5[ne] = 81;
                    sq_vd_op("Rowid\0", 3, 4, 0);
                    a = sq_vd_op("Delete\0", 3, 0, 0);
                    sq_vd_p4s(a, "sqlite_stat1\0", 12);
                    VD_P5[a] = 2;
                    a = sq_vd_op("Next\0", 3, rw + 1, 0);
                    VD_P5[a] = 1;
                    VD_P2[rw] = VD_N;
                    VD_P2[ne] = VD_N - 1;
                    a = sq_vd_op("OpenWrite\0", 0, root, 0);
                    sq_vd_p4i(a, (i64)3);
                    M = 5;
                    tabcur = 4;
                };
            };
            if (byname == 0)
            {
                nu = sq_vd_tblorder(st.db, @ordv[0]);
                if (nu < 0) { if (sq_vd_gon(522) == 1) { sq_seterr(st, "EXPLAIN is not available for ANALYZE over this many tables #522\0"); return 1; }; };
                for (j = 0; j < nu; j++)
                {
                    if (ordv[j] < 0) { continue; };
                    if (st.db.schema[ordv[j]].kind != 1) { continue; };
                    tn = @st.db.schema[ordv[j]].name[0];
                    if (tn[0] == (byte)115 & tn[1] == (byte)113 & tn[2] == (byte)108 & tn[3] == (byte)105 & tn[4] == (byte)116 & tn[5] == (byte)101 & tn[6] == (byte)95) { continue; };
                    if (sq_vd_analyze_tab(st, tn, sq_cstrlen(tn), 0 - 1, tabcur, M) != 0) { return 1; };
                };
            }
            else
            {
                if (st.db.schema[found].kind == 1)
                {
                    tn = st.db.schema[found].name;
                    if (sq_vd_analyze_tab(st, tn, sq_cstrlen(tn), 0 - 1, tabcur, M) != 0) { return 1; };
                }
                else
                {
                    tn = st.db.schema[found].tbl_name;
                    if (sq_vd_analyze_tab(st, tn, sq_cstrlen(tn), found, tabcur, M) != 0) { return 1; };
                };
            };
            sq_vd_op("LoadAnalysis\0", 0, 0, 0);
            sq_vd_op("Expire\0", 0, 0, 0);
            sq_vd_op("Halt\0", 0, 0, 0);
            VD_P2[init] = VD_N;
            sq_vd_trans(st.db, 1);
            if (byname != 0 & stat >= 0)
            {
                a = sq_vd_op("String8\0", 0, 3, 0);
                sq_vd_p4s(a, st.db.schema[found].name, sq_cstrlen(st.db.schema[found].name));
            };
            sq_vd_op("Goto\0", 0, 1, 0);
            sq_vd_query(pq);
            return 0;
        };

        // identifier that also accepts a single-quoted name (ALTER TABLE targets)
        def sq_vd_ident2(byte* t, int n, int i, int* ps, int* pl) -> int
        {
            int b;
            if (i < n) { if (t[i] == (byte)39)
            {
                b = i + 1;
                i++;
                while (i < n & t[i] != (byte)39) { i++; };
                if (i >= n) { return 0 - 1; };
                *ps = b; *pl = i - b;
                return i + 1;
            }; };
            return sq_vd_ident(t, n, i, ps, pl);
        };

        // ALTER TABLE t RENAME TO t2: SQLite's fixed program, one rewrite of sqlite_master per statement kind
        def sq_vd_rename_tab(SQ_STMT* st, byte* t, int n, int i, byte** pq) -> int
        {
            int k, ns, nl, found, j, a, ck, ol, nl2, nsx, sq, sqroot, da, dr, dc;
            byte* on;
            byte* nn;
            int nlen;
            i = sq_vd_skip(t, n, i);
            k = sq_vd_ident(t, n, i, @ns, @nl);
            if (k < 0) { if (sq_vd_gon(523) == 1) { sq_seterr(st, "EXPLAIN is not available for this ALTER TABLE #523\0"); return 1; }; };
            if (k < n) { if (t[k] == (byte)46) { if (sq_vd_gon(524) == 1) { sq_seterr(st, "EXPLAIN is not available for this ALTER TABLE #524\0"); return 1; }; }; };
            i = sq_vd_skip(t, n, k);
            k = sq_vd_word(t, n, i, "rename\0");
            if (k < 0) { if (sq_vd_gon(525) == 1) { sq_seterr(st, "EXPLAIN is not available for this ALTER TABLE #525\0"); return 1; }; };
            i = sq_vd_skip(t, n, k);
            k = sq_vd_word(t, n, i, "to\0");
            if (k < 0) { if (sq_vd_gon(526) == 1) { sq_seterr(st, "EXPLAIN is not available for this ALTER TABLE #526\0"); return 1; }; };
            i = sq_vd_skip(t, n, k);
            k = sq_vd_ident2(t, n, i, @nsx, @nlen);
            if (k < 0) { if (sq_vd_gon(527) == 1) { sq_seterr(st, "EXPLAIN is not available for this ALTER TABLE #527\0"); return 1; }; };
            i = sq_vd_skip(t, n, k);
            if (i < n) { if (t[i] == (byte)59) { i = sq_vd_skip(t, n, i + 1); }; };
            if (i < n) { if (sq_vd_gon(528) == 1) { sq_seterr(st, "EXPLAIN is not available for this ALTER TABLE #528\0"); return 1; }; };
            found = 0 - 1;
            for (j = 0; j < st.db.nschema; j++)
            {
                if (st.db.schema[j].kind == 0) { continue; };
                if (sq_vd_nameeq(st.db.schema[j].name, t, nsx, nlen)) { if (sq_vd_gon(529) == 1) { sq_seterr(st, "EXPLAIN is not available for this ALTER TABLE #529\0"); return 1; }; };
                if (st.db.schema[j].kind == 1) { if (sq_vd_nameeq(st.db.schema[j].name, t, ns, nl)) { found = j; }; };
            };
            if (found < 0) { if (sq_vd_gon(530) == 1) { sq_seterr(st, "EXPLAIN is not available for this ALTER TABLE #530\0"); return 1; }; };
            sq = 0; sqroot = 0;
