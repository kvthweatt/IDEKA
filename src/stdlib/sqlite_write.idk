                    sq_vd_p4s(a, "C\0", 1);
                };
                if (abl == 1)
                {
                    a = sq_vd_op("Filter\0", abloom, 0, akb); sq_vd_p4i(a, (i64)1); ajmp[najmp] = a; najmp++;
                };
                aseek = sq_vd_op("SeekGE\0", 2, 0, akb); sq_vd_p4i(aseek, (i64)1); ajmp[najmp] = aseek; najmp++;
                aigt = sq_vd_op("IdxGT\0", 2, 0, akb); sq_vd_p4i(aigt, (i64)1); ajmp[najmp] = aigt; najmp++;
                for (i = 0; i < b.src[ainner].ti.ncols; i++) { VD_CMAP[i] = apos[i]; };
                jlo[1] = VD_NJ;
                VD_COLCUR = 2; VD_CMAPON = 1;
                for (i = 0; i < ncj; i++)
                {
                    if (tsrc[i] != ainner) { continue; };
                    if (sq_vd_where(g, b.src[ainner].ti, cj[i]) != 0) { VD_CMAPON = 0; sq_seterr(st, "EXPLAIN is not available for this WHERE clause\0"); return 1; };
                };
                VD_CMAPON = 0;
                jhi[1] = VD_NJ;
                base = VD_NMEM + 1;
                if (jagg == 0) { VD_NMEM = VD_NMEM + n; };
                VD_COLCUR = aouter;
                VD_XS = ainner + 1; VD_XCUR = 2; VD_XTI = b.src[ainner].ti;
                if (jagg == 1)
                {
                    if (sq_vd_jagg_step(st, g, b, 1, aouter) != 0) { VD_XS = 0; return 1; };
                }
                else
                {
                    for (i = 0; i < n; i++)
                    {
                        if (sq_vd_expr(g, b.src[aouter].ti, b.rc[i], base + i) != 0) { VD_XS = 0; sq_seterr(st, "EXPLAIN is not available for this expression\0"); return 1; };
                    };
                };
                VD_XS = 0;
                if (jagg == 0) { sq_vd_op("ResultRow\0", base, n, 0); };
                if (hasl == 1) { lim = sq_vd_op("DecrJumpZero\0", 1, 0, 0); };
                for (k = jlo[1]; k < jhi[1]; k++) { VD_P2[VD_JF[k]] = VD_N; };
                anext = sq_vd_op("Next\0", 2, aigt, 0);
                x = VD_N;
                a = sq_vd_op("Next\0", aouter, abody, 0);
                VD_P5[a] = 1;
                for (k = 0; k < najmp; k++) { if (k > 0) { VD_P2[ajmp[k]] = x; }; };
                for (k = jlo[0]; k < jhi[0]; k++) { VD_P2[VD_JF[k]] = x; };
                VD_P2[ahalt] = VD_N; VD_P2[ajmp[0]] = VD_N;
                if (lim >= 0) { VD_P2[lim] = VD_N; };
                if (jagg == 1) { sq_vd_jagg_final(g, b); };
                sq_vd_op("Halt\0", 0, 0, 0);
                VD_P2[ainit] = VD_N;
                sq_vd_trans(g.db, 0);
                for (k = 0; k < VD_NH; k++) { sq_vd_lit(g, VD_HN[k], VD_HR[k]); };
                sq_vd_op("Goto\0", 0, 1, 0);
                return 0;
            };
            if (resplain == 0) { if (sq_vd_gon(277) == 1) { sq_seterr(st, "EXPLAIN is not available for this join 18 #277\0"); return 1; }; };
            k = 0;
            if (seek >= 0) { k = 1; };
            if (sq_vd_planchk(g, k, @ord[0], 2) != 0) { if (sq_vd_gon(278) == 1) { sq_seterr(st, "EXPLAIN is not available for this join 19 #278\0"); return 1; }; };
            for (k = 0; k < 2; k++) { maxc[k] = 0 - 1; };
            for (i = 0; i < g.nn; i++)
            {
                nd = @g.nodes[i];
                if (nd.kind != SQN_COL | nd.lvl != 0 | nd.owner != g.root_blk) { continue; };
                if (nd.src < 0 | nd.src > 1) { continue; };
                ti2 = b.src[nd.src].ti;
                if (nd.col >= 0 & nd.col < ti2.ncols & nd.col != ti2.ipk & nd.col > maxc[nd.src]) { maxc[nd.src] = nd.col; };
            };
            if (seek >= 0)
            {
                for (i = 0; i < g.nn; i++)
                {
                    nd = @g.nodes[i];
                    if (nd.kind != SQN_COL | nd.lvl != 0 | nd.owner != g.root_blk) { continue; };
                };
            };
            sq_vd_reset();
            init = sq_vd_op("Init\0", 0, 0, 0);
            VD_NMEM = 0; VD_NFREE = 0; VD_NH = 0; VD_NJ = 0; VD_IDXCUR = 0;
            if (hasl == 1) { VD_NMEM = 1; sq_vd_lit(g, b.limit_n, 1); };
            if (jagg == 1) { VD_NMEM = JA_NACC + JA_SHIFT + 1; sq_vd_op("Null\0", 0, 1, JA_NACC + JA_SHIFT + 1); };
            osn = 0 - 1; dfound = 0 - 1;
            if (dstm == 1)
            {
                osn = sq_vd_op("OpenEphemeral\0", 2, 0, 0);
                sq_sb_init(@okt);
                sq_sb_lit(@okt, "k(\0");
                sq_sb_int(@okt, (i64)b.nres);
                for (i = 0; i < b.nres; i++) { sq_sb_lit(@okt, ",B\0"); };
                sq_sb_lit(@okt, ")\0");
                sq_vd_p4s(osn, okt.p, okt.n);
                sq_sb_free(@okt);
                VD_P5[osn] = 8;
            };
            if (ordm == 1)
            {
                osn = sq_vd_op("SorterOpen\0", 2, 0, 0);
                sq_sb_init(@okt);
                sq_sb_lit(@okt, "k(\0");
                sq_sb_int(@okt, (i64)onk);
                for (i = 0; i < onk; i++)
                {
                    sq_sb_lit(@okt, ",\0");
                    if (b.odesc[i] != 0) { sq_sb_lit(@okt, "-\0"); };
                    if ((b.odesc[i] == 0 & b.onull[i] == 2) | (b.odesc[i] != 0 & b.onull[i] == 1)) { sq_sb_lit(@okt, "N.\0"); };
                    sq_sb_lit(@okt, "B\0");
                };
                sq_sb_lit(@okt, ")\0");
                sq_vd_p4s(osn, okt.p, okt.n);
                sq_sb_free(@okt);
            };
            for (lp = 0; lp < 2; lp++)
            {
                cr = ord[lp];
                a = sq_vd_op("OpenRead\0", cr, b.src[cr].root, 0);
                sq_vd_p4i(a, (i64)(maxc[cr] + 1));
            };
            sop = 0 - 1;
            for (lp = 0; lp < 2; lp++)
            {
                cr = ord[lp];
                if (seek >= 0 & lp == 1)
                {
                    rew[lp] = 0 - 1;
                    VD_COLCUR = souter;
                    if (left == 1)
                    {
                        VD_NMEM = VD_NMEM + 1;
                        lflag = VD_NMEM;
                        sq_vd_op("Integer\0", 0, lflag, 0);
                    };
                    VD_NMEM = VD_NMEM + 1;
                    nd = @g.nodes[skey];
                    if (nd.col == b.src[souter].ti.ipk) { sq_vd_op("Rowid\0", souter, VD_NMEM, 0); } else { sq_vd_op("Column\0", souter, nd.col, VD_NMEM); };
                    sop = sq_vd_op("SeekRowid\0", cr, 0, VD_NMEM);
                    body[lp] = VD_N;
                    jlo[lp] = VD_NJ;
                }
                else
                {
                    if (lscan == 1 & lp == 1)
                    {
                        VD_NMEM = VD_NMEM + 1;
                        lflag = VD_NMEM;
                        sq_vd_op("Integer\0", 0, lflag, 0);
                    };
                    rew[lp] = sq_vd_op("Rewind\0", cr, 0, 0);
                    body[lp] = VD_N;
                    jlo[lp] = VD_NJ;
                };
                VD_COLCUR = cr;
                for (i = 0; i < ncj; i++)
                {
                    if (tsrc[i] != cr) { continue; };
                    if (left == 1 & lp == 1) { VD_NOHOIST = 1; };
                    if (lscan == 1 & sq_vd_termsrc(g, cj[i]) == 0 - 2) { if (sq_vd_colcmp(g, b, cj[i]) != 0) { VD_NOHOIST = 0; sq_seterr(st, "EXPLAIN is not available for this join 20\0"); return 1; }; continue; };
                    if (sq_vd_where(g, b.src[cr].ti, cj[i]) != 0) { VD_NOHOIST = 0; sq_seterr(st, "EXPLAIN is not available for this WHERE clause\0"); return 1; };
                    VD_NOHOIST = 0;
                };
                jhi[lp] = VD_NJ;
                if (left == 1 & lp == 1) { lint = sq_vd_op("Integer\0", 1, lflag, 0); };
            };
            base = VD_NMEM + 1;
            if (jagg == 1)
            {
                if (sq_vd_jagg_step(st, g, b, 0, 0) != 0) { return 1; };
            }
            else
            {
                if (ordm == 1)
                {
                    ooff = VD_NMEM;
                    ooutr = ooff + onk + n + 1;
                    obase = ooff + onk + 1;
                    VD_P2[osn] = onk + n + 1;
                    for (i = 0; i < n; i++)
                    {
                        if (rpos[i] >= onk)
                        {
                            sq_vd_op("Column\0", rcs[i], rcc[i], ooff + 1 + rpos[i]);
                            if (b.src[rcs[i]].ti.aff[rcc[i]] == 4) { sq_vd_op("RealAffinity\0", ooff + 1 + rpos[i], 0, 0); };
                        };
                    };
                    for (i = 0; i < onk; i++)
                    {
                        sq_vd_op("Column\0", oks[i], okc[i], ooff + 1 + i);
                        if (b.src[oks[i]].ti.aff[okc[i]] == 4) { sq_vd_op("RealAffinity\0", ooff + 1 + i, 0, 0); };
                    };
                    sq_vd_op("MakeRecord\0", ooff + 1, onk + ond2, ooutr);
                    a = sq_vd_op("SorterInsert\0", 2, ooutr, ooff + 1);
                    sq_vd_p4i(a, (i64)(onk + ond2));
                }
                else
                {
                    VD_NMEM = VD_NMEM + n;
                    if (dstm == 1) { drec = sq_vd_getreg(); };
                    for (i = 0; i < n; i++)
                    {
                        nd = @g.nodes[b.rc[i]];
                        VD_COLCUR = nd.src;
                        if (sq_vd_expr(g, b.src[nd.src].ti, b.rc[i], base + i) != 0) { if (sq_vd_gon(279) == 1) { sq_seterr(st, "EXPLAIN is not available for this expression #279\0"); return 1; }; };
                    };
                    if (dstm == 1)
                    {
                        dfound = sq_vd_op("Found\0", 2, 0, base);
                        sq_vd_p4i(dfound, (i64)n);
                        sq_vd_op("MakeRecord\0", base, n, drec);
                        a = sq_vd_op("IdxInsert\0", 2, drec, base);
                        sq_vd_p4i(a, (i64)n);
                        VD_P5[a] = 16;
                    };
                    sq_vd_op("ResultRow\0", base, n, 0);
                };
            };
            if (hasl == 1) { lim = sq_vd_op("DecrJumpZero\0", 1, 0, 0); };
            for (lp = 1; lp >= 0; lp--)
            {
                cr = ord[lp];
                nxt[lp] = VD_N;
                if (seek >= 0 & lp == 1)
                {
                    VD_P2[sop] = nxt[lp];
                    if (left == 1)
                    {
                        a = sq_vd_op("IfPos\0", lflag, 0, 0);
                        sq_vd_op("NullRow\0", cr, 0, 0);
                        sq_vd_op("Goto\0", 0, lint, 0);
                        VD_P2[a] = VD_N;
                    };
                    continue;
                };
                a = sq_vd_op("Next\0", cr, body[lp], 0);
                VD_P5[a] = 1;
                if (lscan == 1 & lp == 1)
                {
                    ifpos = VD_N;
                    a = sq_vd_op("IfPos\0", lflag, 0, 0);
                    sq_vd_op("NullRow\0", cr, 0, 0);
                    sq_vd_op("Goto\0", 0, lint, 0);
                    VD_P2[a] = VD_N;
                };
            };
            x = VD_N;
            if (dfound >= 0) { VD_P2[dfound] = nxt[1]; };
            for (lp = 0; lp < 2; lp++)
            {
                if (rew[lp] >= 0) { VD_P2[rew[lp]] = x; if (lp == 1) { VD_P2[rew[lp]] = nxt[0]; }; if (lscan == 1 & lp == 1) { VD_P2[rew[lp]] = ifpos; }; };
                for (k = jlo[lp]; k < jhi[lp]; k++) { VD_P2[VD_JF[k]] = nxt[lp]; };
            };
            if (lim >= 0) { VD_P2[lim] = VD_N; };
            if (jagg == 1) { sq_vd_jagg_final(g, b); };
            if (ordm == 1)
            {
                sq_vd_op("OpenPseudo\0", 3, ooutr + 1, onk + n + 1);
                oss = sq_vd_op("SorterSort\0", 2, 0, 0);
                osd = sq_vd_op("SorterData\0", 2, ooutr + 1, 3);
                for (i = n - 1; i >= 0; i--) { sq_vd_op("Column\0", 3, rpos[i], obase + i); };
                sq_vd_op("ResultRow\0", obase, n, 0);
                sq_vd_op("SorterNext\0", 2, osd, 0);
                VD_P2[oss] = VD_N;
            };
            sq_vd_op("Halt\0", 0, 0, 0);
            VD_P2[init] = VD_N;
            sq_vd_trans(g.db, 0);
            for (k = 0; k < VD_NH; k++) { sq_vd_lit(g, VD_HN[k], VD_HR[k]); };
            sq_vd_op("Goto\0", 0, 1, 0);
            return 0;
        };

        // three or four tables joined: rowid seeks from one scanned table, or plain nested scans when nothing constrains the join
        def sq_vd_joinn(SQ_STMT* st, SQ_STMT* g) -> int
        {
            SQ_BLK* b = g.blks[g.root_blk];
            SQ_NODE* nd;
            SQ_NODE* ln;
            SQ_NODE* rn;
            SQ_TI* ti2;
            int[24] cj;
            int[24] tsrc;
            int[4] efrom;
            int[4] ekey;
            int[4] eterm;
            int[4] nin;
            int[4] ord;
            int[4] maxc;
            int[4] placed;
            int[4] jlo;
            int[4] jhi;
            int[4] rew;
            int[4] nxt;
            int[4] sk;
            int[8] ecs;
            int[8] ecc;
            int ncj, i, j, k, l, n, ns, ne, init, a, x, base, root, lastc, body0, ifm, npl, cand, cr, ok;
            ns = b.nsrc;
            if (b.cnext >= 0 | b.distinct != 0 | b.ngrp != 0 | b.having >= 0 | b.nord > 0 | b.limit_n >= 0 | b.has_agg != 0 | b.nwin != 0 | b.ncte != 0)
            {
                sq_seterr(st, "EXPLAIN is not available for this SELECT shape\0"); return 1;
            };
            for (i = 0; i < ns; i++)
            {
                if (b.src[i].kind != 1 | (u64)b.src[i].ti == (u64)0 | b.src[i].nusing > 0 | b.src[i].natural != 0) { if (sq_vd_gon(280) == 1) { sq_seterr(st, "EXPLAIN is not available for this join #280\0"); return 1; }; };
                if (b.src[i].ti.wor != 0 | sq_vd_nidx(@b.src[i]) != 0) { if (sq_vd_gon(281) == 1) { sq_seterr(st, "EXPLAIN is not available for this join #281\0"); return 1; }; };
                if (i > 0) { if (b.src[i].jt != 1 & b.src[i].jt != 3) { if (sq_vd_gon(282) == 1) { sq_seterr(st, "EXPLAIN is not available for this join #282\0"); return 1; }; }; };
                for (j = 0; j < i; j++) { if (b.src[j].root == b.src[i].root) { if (sq_vd_gon(283) == 1) { sq_seterr(st, "EXPLAIN is not available for this join #283\0"); return 1; }; }; };
            };
            if (b.src[0].on >= 0) { if (sq_vd_gon(284) == 1) { sq_seterr(st, "EXPLAIN is not available for this join #284\0"); return 1; }; };
            n = b.nres;
            if (n < 1 | n > 30) { if (sq_vd_gon(285) == 1) { sq_seterr(st, "EXPLAIN is not available for this join #285\0"); return 1; }; };
            for (i = 0; i < n; i++)
            {
                nd = @g.nodes[b.rc[i]];
                if (nd.kind != SQN_COL | nd.src < 0 | nd.src >= ns | nd.col < 0) { if (sq_vd_gon(286) == 1) { sq_seterr(st, "EXPLAIN is not available for this join #286\0"); return 1; }; };
                if (nd.col >= b.src[nd.src].ti.ncols) { if (sq_vd_gon(287) == 1) { sq_seterr(st, "EXPLAIN is not available for this join #287\0"); return 1; }; };
            };
            ncj = 0;
            if (b.where_n >= 0) { sq_vd_split(g, b.where_n, @cj[0], @ncj); };
            for (i = 1; i < ns; i++) { if (b.src[i].on >= 0) { sq_vd_split(g, b.src[i].on, @cj[0], @ncj); }; };
            ne = 0;
            for (i = 0; i < ns; i++) { nin[i] = 0; };
            for (i = 0; i < ncj; i++)
            {
                x = sq_vd_termsrc(g, cj[i]);
                tsrc[i] = x;
                if (x == 0 - 1) { if (sq_vd_gon(288) == 1) { sq_seterr(st, "EXPLAIN is not available for this join #288\0"); return 1; }; };
                if (x >= 0)
                {
                    k = sq_vd_exprcol(g, cj[i]);
                    if (k == b.src[x].ti.ipk) { if (sq_vd_gon(289) == 1) { sq_seterr(st, "EXPLAIN is not available for this join #289\0"); return 1; }; };
                    continue;
                };
                nd = @g.nodes[cj[i]];
                if (nd.kind != SQN_BIN | nd.op != SQO_EQ | ne >= 4) { if (sq_vd_gon(290) == 1) { sq_seterr(st, "EXPLAIN is not available for this join #290\0"); return 1; }; };
                ln = @g.nodes[nd.a]; rn = @g.nodes[nd.b];
                if (ln.kind != SQN_COL | rn.kind != SQN_COL | ln.src == rn.src | ln.src < 0 | rn.src < 0 | ln.src >= ns | rn.src >= ns | ln.col < 0 | rn.col < 0) { if (sq_vd_gon(291) == 1) { sq_seterr(st, "EXPLAIN is not available for this join #291\0"); return 1; }; };
                if (rn.col == b.src[rn.src].ti.ipk & ln.col == b.src[ln.src].ti.ipk)
                {
                    if (ln.src < rn.src) { efrom[ne] = ln.src; ekey[ne] = nd.a; nin[rn.src]++; ecs[ne] = rn.src; } else { efrom[ne] = rn.src; ekey[ne] = nd.b; nin[ln.src]++; ecs[ne] = ln.src; };
                }
                else
                {
                    if (rn.col == b.src[rn.src].ti.ipk) { efrom[ne] = ln.src; ekey[ne] = nd.a; nin[rn.src]++; ecs[ne] = rn.src; }
                    else
                    {
                        if (ln.col == b.src[ln.src].ti.ipk) { efrom[ne] = rn.src; ekey[ne] = nd.b; nin[ln.src]++; ecs[ne] = ln.src; }
                        else { if (sq_vd_gon(292) == 1) { sq_seterr(st, "EXPLAIN is not available for this join #292\0"); return 1; }; };
                    };
                };
