            anyipk = 0; dist = 0; rr = 0;
            for (i = 0; i < g.nn; i++)
            {
                if (g.nodes[i].kind == SQN_IN & g.nodes[i].blk < 0 & g.nodes[i].a >= 0)
                {
                    if (g.nodes[g.nodes[i].a].kind == SQN_COL) { if (g.nodes[g.nodes[i].a].col < ti.ncols) { if (ti.aff[g.nodes[g.nodes[i].a].col] == 4 & (sq_vd_gon(782) == 1 & (sq_vd_gon(964) == 1 | sq_vd_hasmm(g, b) == 1))) { sq_seterr(st, "EXPLAIN is not available for this aggregate query #782\0"); return 1; }; }; };
                };
            };
            if (b.where_n >= 0) { if (sq_vd_dupor(g, b.where_n) == 1 & sq_vd_gon(784) == 1) { sq_seterr(st, "EXPLAIN is not available for this aggregate query #784\0"); return 1; }; };
            if ((hasl == 1 & sq_vd_gon(790) == 1) | b.nres > 15 | b.nres < 1 | b.nagg < 1) { if (sq_vd_gon(119) == 1) { sq_seterr(st, "EXPLAIN is not available for this aggregate query #119\0"); return 1; }; };
            if (ags == 1 & hasl == 1 & (b.offset_n >= 0 & sq_vd_gon(914) == 1 | sq_vd_gon(913) == 1)) { sq_seterr(st, "EXPLAIN is not available for this aggregate query\0"); return 1; };
            if (ags == 1)
            {
                for (hk = 0; hk < b.nres; hk++) { if (g.nodes[b.rc[hk]].kind == SQN_FUNC) { j = sq_func_id(@g.sql[g.nodes[b.rc[hk]].s], g.nodes[b.rc[hk]].sl, (int)g.nodes[b.rc[hk]].iv); if (j == 104 | j == 105)
                    {
                        if (hasl == 1) { sq_seterr(st, "EXPLAIN is not available for this aggregate query\0"); return 1; };
                        if (g.nodes[g.nodes[b.rc[hk]].a].kind != SQN_COL) { sq_seterr(st, "EXPLAIN is not available for this aggregate query\0"); return 1; };
                        if (sq_vd_leads(@b.src[0], g.nodes[g.nodes[b.rc[hk]].a].col) == 1) { sq_seterr(st, "EXPLAIN is not available for this aggregate query\0"); return 1; };
                        for (hj = 0; hj < b.nord; hj++) { if (g.nodes[b.ord[hj]].kind == SQN_COL) { if (sq_vd_leads(@b.src[0], g.nodes[b.ord[hj]].col) == 1) { sq_seterr(st, "EXPLAIN is not available for this aggregate query\0"); return 1; }; }; };
                    };
                    if ((j == 104 | j == 105) & sq_vd_gon(915) == 1) { sq_seterr(st, "EXPLAIN is not available for this aggregate query\0"); return 1; }; if (g.nodes[b.rc[hk]].op == 1) { sq_seterr(st, "EXPLAIN is not available for this aggregate query\0"); return 1; }; }; };
                for (hk = 0; hk < b.nord; hk++)
                {
                    hf = 0;
                    for (hj = 0; hj < b.nres; hj++) { if (g.nodes[b.rc[hj]].kind == SQN_COL) { if (g.nodes[b.rc[hj]].col == g.nodes[b.ord[hk]].col) { hf = 1; }; }; };
                    if (hf == 0)
                    {
                        if (b.nres >= 15) { sq_seterr(st, "EXPLAIN is not available for this aggregate query\0"); return 1; };
                        b.rc[b.nres] = b.ord[hk];
                        b.nres++;
                    };
                };
            };
            n = 0; nb = 0;
            for (i = 0; i < b.nres; i++)
            {
                nd = @g.nodes[b.rc[i]];
                isb[i] = 0;
                if (nd.kind == SQN_FUNC)
