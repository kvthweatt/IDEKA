            k = sq_vd_ident2(t, n, i, @nsx, @nl2);
            if (k < 0) { if (sq_vd_gon(534) == 1) { sq_seterr(st, "EXPLAIN is not available for this ALTER TABLE #534\0"); return 1; }; };
