                    while (aff.n > 0 & aff.p[aff.n - 1] == (byte)65) { aff.n--; };
                    if (aff.n > 0) { sq_vd_p4s(a, aff.p, aff.n); };
                    sq_sb_free(@aff);
                    a = sq_vd_op("Insert\0", tcur, VD_NMEM, 1);
