            if (k < 0) { if (sq_vd_gon(481) == 1) { sq_seterr(st, "EXPLAIN is not available for this CREATE TABLE #481\0"); return 1; }; };
            if (k < n) { if (t[k] == (byte)46) { if (sq_vd_gon(482) == 1) { sq_seterr(st, "EXPLAIN is not available for this CREATE TABLE #482\0"); return 1; }; }; };
            i = sq_vd_skip(t, n, k);
