            int[16] inres;
            int[16] wj;
            int nwj, i, j, k, nix, ok, ot, col;
            if (b.distinct == 0 | b.nsrc != 1 | b.cnext >= 0 | b.ngrp != 0 | b.having >= 0 | b.nwin != 0 | b.ncte != 0 | b.has_agg != 0 | b.nord > 0) { return 0; };
            if (sr.kind != 1 | (u64)sr.ti == (u64)0 | sr.tbl < 0 | sr.on >= 0) { return 0; };
            ti = sr.ti;
            if (b.nres < 1 | b.nres > 30) { return 0; };
            for (i = 0; i < 16; i++) { have[i] = 0; inres[i] = 0; };
            for (i = 0; i < b.nres; i++)
