                sq_vd_op("Halt\0", 0, 0, 0);
                VD_P2[init] = VD_N;
                sq_vd_trans(st.db, 1);
                for (k = 0; k < VD_NH; k++)
                {
                    if (VD_HN[k] < 0) { sq_vd_op("Null\0", 0, VD_HR[k], 0); } else { sq_vd_lit(g2, VD_HN[k], VD_HR[k]); };
                };
                sq_vd_op("Goto\0", 0, 1, 0);
                sq_stmt_del(g1);
                sq_stmt_del(g2);
                sq_vd_query(pq);
                return 0;
            };
            if (ti.ipk >= 0) { sq_vd_ipkput(ti, t, ns, nl, tcur, 1, 2); }
            else { sq_vd_op("NewRowid\0", tcur, 1, 0); };
            rec = VD_NMEM + 1;
            if (nx > 0)
            {
                nign = 0;
                p5v = 57;
                if (ti.ipk >= 0) { p5v = 49; };
                sq_vd_instail(ti, @ixl[0], nx, t, ns, nl, 2, 1, tcur, rec, 0, p5v, @ign[0], @nign);
                sq_vd_op("Goto\0", 0, y, 0);
                VD_P2[y] = VD_N;
                sq_vd_op("Halt\0", 0, 0, 0);
                VD_P2[init] = VD_N;
                sq_vd_trans(st.db, 1);
                for (k = 0; k < VD_NH; k++) { sq_vd_lit(g2, VD_HN[k], VD_HR[k]); };
                sq_vd_op("Goto\0", 0, 1, 0);
                sq_stmt_del(g1);
                sq_stmt_del(g2);
                sq_vd_query(pq);
                return 0;
            };
            a = sq_vd_op("MakeRecord\0", 2, ncol, rec);
            sq_sb_init(@aff);
            for (k = 0; k < ncol; k++) { c = 65 + ti.aff[k]; sq_sb_add(@aff, (byte*)@c, 1); };
            while (aff.n > 0 & aff.p[aff.n - 1] == (byte)65) { aff.n--; };
            if (aff.n > 0) { sq_vd_p4s(a, aff.p, aff.n); };
            sq_sb_free(@aff);
            a = sq_vd_op("Insert\0", tcur, rec, 1);
            sq_vd_p4s(a, @t[ns], nl);
            VD_P5[a] = 57;
            if (ti.ipk >= 0) { VD_P5[a] = 49; };
            sq_vd_op("Goto\0", 0, y, 0);
            VD_P2[y] = VD_N;
            sq_vd_op("Halt\0", 0, 0, 0);
            VD_P2[init] = VD_N;
            sq_vd_trans(st.db, 1);
            for (k = 0; k < VD_NH; k++) { sq_vd_lit(g2, VD_HN[k], VD_HR[k]); };
            sq_vd_op("Goto\0", 0, 1, 0);
            sq_stmt_del(g1);
            sq_stmt_del(g2);
            sq_vd_query(pq);
            return 0;
        };

        // INSERT of one VALUES row into a WITHOUT ROWID table: one record per secondary index (newest first),
        // then the primary key record; the primary key is checked for a conflict before any record is inserted
        def sq_vd_worins(SQ_STMT* st, SQ_STMT* g1, SQ_STMT* g2, SQ_TI* ti, SQ_SRC* sr, SQ_BLK* b2, int* map, int* dmap, int nv, byte* t, int ns, int nl, int orm, byte** pq) -> int
        {
            SQ_IDX wsyn;
            SQ_IDX[12] ixl;
            SQ_IDX* xi;
            SQ_SB kt;
            SQ_SB msg;
            SQ_SB af;
            byte[130] ab;
            int[14] rec;
            int[14] kst;
            int[14] nfl;
            int[130] ispk;
            int[130] hr;
            int[130] hn;
            int nh, ncol, nx, k, j, c, a, init, base, nxt, nfld, ncp, na, nc2, ow, nco;
            ncol = ti.ncols;
            nx = sq_idx_list(sr.sdb, sr.tbl, ti, @ixl[0], 12);
            if (orm != 0 | nx > 12 | ti.npk <= 0 | ti.npk > 8 | ncol > 120) { sq_stmt_del(g1); sq_stmt_del(g2); sq_seterr(st, "EXPLAIN is not available for this INSERT\0"); return 1; };
            sq_vd_worsyn(ti, sr, @wsyn);
            for (k = 0; k < ncol; k++) { ispk[k] = 0; };
            for (k = 0; k < ti.npk; k++) { ispk[ti.pkc[k]] = 1; };
            for (k = 0; k < nx; k++)
            {
                xi = @ixl[k];
                if (xi.partial != 0 | xi.unique != 0 | xi.nk < 1 | xi.nk + ti.npk > 12) { sq_stmt_del(g1); sq_stmt_del(g2); sq_seterr(st, "EXPLAIN is not available for this index\0"); return 1; };
                for (j = 0; j < xi.nk; j++)
                {
                    if (xi.isx[j] != 0 | xi.col[j] >= ncol | xi.col[j] < 0 | xi.coll[j] != 0 | xi.desc[j] != 0) { sq_stmt_del(g1); sq_stmt_del(g2); sq_seterr(st, "EXPLAIN is not available for this index\0"); return 1; };
                    if (ispk[xi.col[j]] != 0) { sq_stmt_del(g1); sq_stmt_del(g2); sq_seterr(st, "EXPLAIN is not available for this index\0"); return 1; };
                };
            };
            for (k = 0; k < ncol; k++) { if (ti.coll[k] != 0 & ispk[k] != 0) { sq_stmt_del(g1); sq_stmt_del(g2); sq_seterr(st, "EXPLAIN is not available for this index collation\0"); return 1; }; };
            sq_vd_reset();
            VD_ISWOR = 1;
            init = sq_vd_op("Init\0", 0, 0, 0);
            for (k = nx - 1; k >= 0; k--)
            {
                xi = @ixl[k];
                a = sq_vd_op("OpenWrite\0", nx - k, xi.root, 0);
                sq_sb_init(@kt);
                sq_sb_lit(@kt, "k(\0");
                sq_sb_int(@kt, (i64)(xi.nk + ti.npk));
                for (j = 0; j < xi.nk + ti.npk; j++) { sq_sb_lit(@kt, ",\0"); };
                sq_sb_lit(@kt, ")\0");
                sq_vd_p4s(a, kt.p, kt.n);
                sq_sb_free(@kt);
            };
            a = sq_vd_op("OpenWrite\0", nx + 1, sr.root, 0);
            sq_sb_init(@kt);
            if (sq_vd_kinfo(@wsyn, @kt) != 0) { sq_sb_free(@kt); sq_stmt_del(g1); sq_stmt_del(g2); sq_seterr(st, "EXPLAIN is not available for this index collation\0"); return 1; };
            sq_vd_p4s(a, kt.p, kt.n);
            sq_sb_free(@kt);
            base = 2;
            nh = 0;
            for (k = 0; k < ncol; k++)
            {
                if (map[k] < 0)
                {
                    if (dmap[k] >= 0) { hn[nh] = b2.rc[dmap[k]]; hr[nh] = base + k; nh++; }
                    else
                    {
                        if (ti.dfl[k] != 0) { sq_stmt_del(g1); sq_stmt_del(g2); sq_seterr(st, "EXPLAIN is not available for column defaults\0"); return 1; };
                        hn[nh] = 0 - 1; hr[nh] = base + k; nh++;
                    };
                }
                else
                {
                    if (sq_vd_isconst(g2, b2.rc[map[k]]) == false) { sq_stmt_del(g1); sq_stmt_del(g2); sq_seterr(st, "EXPLAIN is not available for this expression\0"); return 1; };
                    if (sq_vd_lit(g2, b2.rc[map[k]], base + k) != 0) { sq_stmt_del(g1); sq_stmt_del(g2); return 1; };
                };
            };
            sq_vd_op("Null\0", 0, 1, 0);
            for (k = 0; k < ncol; k++)
            {
                if (ispk[k] == 0 & ti.notnull[k] == 0) { continue; };
                a = sq_vd_op("HaltIfNull\0", 1299, 2, base + k);
                sq_sb_init(@msg);
                sq_sb_add(@msg, @t[ns], nl);
                sq_sb_lit(@msg, ".\0");
                sq_sb_add(@msg, @ti.base[ti.cs[k]], ti.cl[k]);
                sq_vd_p4s(a, msg.p, msg.n);
                sq_sb_free(@msg);
                VD_P5[a] = 1;
            };
            na = 0;
            for (k = 0; k < ncol; k++) { if (sq_vd_affch(ti.aff[k]) != 65) { na = k + 1; }; };
            if (na > 0)
            {
                for (k = 0; k < na; k++) { ab[k] = (byte)sq_vd_affch(ti.aff[k]); };
                a = sq_vd_op("Affinity\0", base, na, 0);
                sq_vd_p4s(a, @ab[0], na);
            };
            nxt = base + ncol;
            // records: secondary indexes newest first, then the primary key record
            for (k = nx - 1; k >= 0; k--)
            {
                xi = @ixl[k];
                nfld = xi.nk + ti.npk;
                rec[nx - 1 - k] = nxt; kst[nx - 1 - k] = nxt + 1; nfl[nx - 1 - k] = nfld;
                for (j = 0; j < xi.nk; j++) { sq_vd_op("SCopy\0", base + xi.col[j], nxt + 1 + j, 0); };
                for (j = 0; j < ti.npk; j++) { sq_vd_op("SCopy\0", base + ti.pkc[j], nxt + 1 + xi.nk + j, 0); };
                sq_vd_op("MakeRecord\0", nxt + 1, nfld, nxt);
                nxt = nxt + 1 + nfld;
            };
            rec[nx] = nxt; kst[nx] = nxt + 1; nfl[nx] = ncol;
            for (j = 0; j < ncol; j++)
            {
                c = 0 - 1;
                for (k = 0; k < ncol; k++) { if (VD_WORM[k] == j) { c = k; }; };
                sq_vd_op("SCopy\0", base + c, nxt + 1 + j, 0);
            };
            sq_vd_op("MakeRecord\0", nxt + 1, ncol, nxt);
            nc2 = sq_vd_op("NoConflict\0", nx + 1, 0, nxt + 1);
            sq_vd_p4i(nc2, (i64)ti.npk);
            a = sq_vd_op("Halt\0", 1555, 2, 0);
            sq_sb_init(@msg);
            for (j = 0; j < ti.npk; j++)
            {
                if (j > 0) { sq_sb_lit(@msg, ", \0"); };
                sq_sb_add(@msg, @t[ns], nl);
                sq_sb_lit(@msg, ".\0");
                sq_sb_add(@msg, @ti.base[ti.cs[ti.pkc[j]]], ti.cl[ti.pkc[j]]);
            };
            sq_vd_p4s(a, msg.p, msg.n);
            sq_sb_free(@msg);
            VD_P5[a] = 2;
            VD_P2[nc2] = VD_N;
            for (k = 0; k <= nx; k++)
            {
                a = sq_vd_op("IdxInsert\0", k + 1, rec[k], kst[k]);
                if (k == nx) { sq_vd_p4i(a, (i64)ti.npk); VD_P5[a] = 17; } else { sq_vd_p4i(a, (i64)nfl[k]); VD_P5[a] = 16; };
            };
            sq_vd_op("Halt\0", 0, 0, 0);
            VD_P2[init] = VD_N;
            sq_vd_trans(st.db, 1);
            for (k = 0; k < nh; k++)
            {
                if (hn[k] < 0) { sq_vd_op("Null\0", 0, hr[k], 0); } else { sq_vd_lit(g2, hn[k], hr[k]); };
            };
            sq_vd_op("Goto\0", 0, 1, 0);
            sq_stmt_del(g1); sq_stmt_del(g2);
            sq_vd_query(pq);
            return 0;
        };

        def sq_vd_insert(SQ_STMT* st, byte* t, int n, int i, byte** pq) -> int
        {
            SQ_STMT* g1;
            SQ_STMT* g2;
            SQ_BLK* b;
            SQ_BLK* b2;
            SQ_SRC* sr;
            SQ_TI* ti;
            SQ_SB aff;
            SQ_SB msg;
            SQ_IDX[12] ixl;
            SQ_IDX* xi;
            int ipk, ipm, ips, nn, nl2, idxrec, kb, nkc, tr, useaff, recr, nx, halt, ne, xk, ra, sqroot, sj, le, nn2, rr2, mm;
            int[12] ign;
            int nign, p5v;
            int[130] map;
            int ns, nl, cs, cl, depth, vs, ve, nix, k, c, init, a, ncol, nv, j, base, rc, hasaff, mi, ci, orm, dv, ni, nd;
            int[130] dmap;
            int[130] retc;
            int hasret, rn, rs0, rl0, rk, rw, rb2;
            SQ_SB dt;
            byte q;
            orm = 0; dv = 0; ni = 0 - 1; hasret = 0; rn = 0;
            ni = sq_vd_word(t, n, i, "replace\0");
            if (ni >= 0) { orm = 1; i = ni; } else { i = sq_vd_word(t, n, i, "insert\0"); };
            i = sq_vd_skip(t, n, i);
            ni = 0 - 1;
            if (orm == 0) { ni = sq_vd_word(t, n, i, "or\0"); };
            if (ni >= 0)
            {
                i = sq_vd_skip(t, n, ni);
                ni = sq_vd_word(t, n, i, "replace\0");
                if (ni >= 0) { orm = 1; };
                if (ni < 0) { ni = sq_vd_word(t, n, i, "ignore\0"); if (ni >= 0) { orm = 2; }; };
                if (ni < 0) { if (sq_vd_gon(458) == 1) { sq_seterr(st, "EXPLAIN is not available for this INSERT #458\0"); return 1; }; };
                i = sq_vd_skip(t, n, ni);
            };
            i = sq_vd_word(t, n, i, "into\0");
            if (i < 0) { if (sq_vd_gon(459) == 1) { sq_seterr(st, "EXPLAIN is not available for this INSERT #459\0"); return 1; }; };
            i = sq_vd_skip(t, n, i);
            i = sq_vd_ident(t, n, i, @ns, @nl);
            VD_IXST = (u64)st; VD_IXNM = (u64)@t[ns]; VD_IXNL = nl;
            if (i < 0) { if (sq_vd_gon(460) == 1) { sq_seterr(st, "EXPLAIN is not available for this INSERT #460\0"); return 1; }; };
            ni = 0 - 1;
            if (sq_vd_prep(st, "select * from \0", @t[ns], nl, (byte*)0, 0, @g1) != 0) { return 1; };
            VD_PLWOR = 1;
            nx = sq_vd_plain(st, g1, @t[ns], nl, @nix);
            VD_PLWOR = 0;
            if (nx != 0) { sq_stmt_del(g1); return 1; };
            b = g1.blks[g1.root_blk];
            sr = @b.src[0];
            ti = sr.ti;
            if (nix > 8 | ti.nchk != 0 | ti.ngen != 0) { sq_stmt_del(g1); sq_seterr(st, "EXPLAIN is not available for tables with indexes or constraints\0"); return 1; };
            ncol = ti.ncols;
            ra = 0; sqroot = 0 - 1;
            if (ti.autoinc != 0)
            {
                ra = 4;
                if (orm != 0) { sq_stmt_del(g1); sq_seterr(st, "EXPLAIN is not available for this conflict clause\0"); return 1; };
                for (sj = 0; sj < st.db.nschema; sj++) { if (st.db.schema[sj].kind == 1) { if (sq_vd_nameeq(st.db.schema[sj].name, "sqlite_sequence\0", 0, 15)) { sqroot = st.db.schema[sj].rootpage; }; }; };
                if (sqroot < 0) { sq_stmt_del(g1); sq_seterr(st, "EXPLAIN is not available for this table\0"); return 1; };
            };
            for (k = 0; k < ncol; k++)
            {
                map[k] = 0 - 1;
            };
            i = sq_vd_skip(t, n, i);
            k = sq_vd_word(t, n, i, "select\0");
            if (k >= 0 & orm == 0)
            {
                for (c = 0; c < ncol; c++) { map[c] = c; };
                return sq_vd_inssel(st, g1, ti, sr, t, n, k, ns, nl, @map[0], ncol, pq);
            };
            nv = 0;
            k = sq_vd_word(t, n, i, "default\0");
            if (k >= 0)
            {
                i = sq_vd_skip(t, n, k);
                k = sq_vd_word(t, n, i, "values\0");
                if (k < 0) { sq_stmt_del(g1); sq_seterr(st, "EXPLAIN is not available for this INSERT\0"); return 1; };
                i = sq_vd_skip(t, n, k);
                if (i < n) { sq_stmt_del(g1); sq_seterr(st, "EXPLAIN is not available for this INSERT\0"); return 1; };
                dv = 1;
            };
            if (dv == 0 & i < n & t[i] == (byte)40)
            {
                // column list
                i++;
                while (1 == 1)
                {
                    i = sq_vd_skip(t, n, i);
                    i = sq_vd_ident(t, n, i, @cs, @cl);
                    if (i < 0) { sq_stmt_del(g1); sq_seterr(st, "EXPLAIN is not available for this INSERT\0"); return 1; };
                    c = 0 - 1;
                    for (k = 0; k < ncol; k++)
                    {
                        if (ti.cl[k] == cl)
                        {
                            rc = 1;
                            for (j = 0; j < cl; j++) { if (sq_lc(ti.base[ti.cs[k] + j]) != sq_lc(t[cs + j])) { rc = 0; }; };
                            if (rc == 1) { c = k; };
                        };
                    };
                    if (c < 0 | map[c] >= 0) { sq_stmt_del(g1); sq_seterr(st, "EXPLAIN is not available for this INSERT\0"); return 1; };
                    map[c] = nv;
                    nv++;
                    i = sq_vd_skip(t, n, i);
                    if (i < n & t[i] == (byte)44) { i++; continue; };
                    if (i < n & t[i] == (byte)41) { i++; break; };
                    sq_stmt_del(g1); sq_seterr(st, "EXPLAIN is not available for this INSERT\0"); return 1;
                };
                i = sq_vd_skip(t, n, i);
            };
            if (dv == 0 & nv > 0 & i < n)
            {
                k = sq_vd_word(t, n, i, "select\0");
                if (k >= 0 & orm == 0) { return sq_vd_inssel(st, g1, ti, sr, t, n, k, ns, nl, @map[0], nv, pq); };
            };
            if (dv == 0 & (i >= n | t[i] != (byte)40) & nv == 0)
            {
                for (k = 0; k < ncol; k++) { map[k] = k; };
                nv = ncol;
            };
            if (dv == 0) { i = sq_vd_word(t, n, i, "values\0"); };
            vs = 0; ve = 0;
            if (dv == 0)
            {
            if (i < 0) { sq_stmt_del(g1); sq_seterr(st, "EXPLAIN is not available for this INSERT\0"); return 1; };
            i = sq_vd_skip(t, n, i);
            if (i >= n | t[i] != (byte)40) { sq_stmt_del(g1); sq_seterr(st, "EXPLAIN is not available for this INSERT\0"); return 1; };
            vs = i + 1;
            depth = 0;
            while (i < n)
            {
                q = t[i];
                if (q == (byte)39 | q == (byte)34)
                {
                    i++;
                    while (i < n & t[i] != q) { i++; };
                };
                if (t[i] == (byte)40) { depth++; };
                if (t[i] == (byte)41) { depth--; if (depth == 0) { break; }; };
                i++;
            };
            if (i >= n) { sq_stmt_del(g1); sq_seterr(st, "EXPLAIN is not available for this INSERT\0"); return 1; };
            ve = i;
            i = sq_vd_skip(t, n, i + 1);
            if (i < n)
            {
                if (t[i] == (byte)44)
                {
                    if (orm != 0) { sq_stmt_del(g1); sq_seterr(st, "EXPLAIN is not available for this INSERT\0"); return 1; };
                    return sq_vd_insmulti(st, g1, ti, sr, t, n, i, vs, ve, ns, nl, @map[0], nv, pq);
                };
                ni = sq_vd_word(t, n, i, "on\0");
                if (ni >= 0 & orm == 0 & dv == 0)
                {
                    i = sq_vd_skip(t, n, ni);
                    ni = sq_vd_word(t, n, i, "conflict\0");
                    if (ni < 0) { sq_stmt_del(g1); sq_seterr(st, "EXPLAIN is not available for this INSERT\0"); return 1; };
                    i = sq_vd_skip(t, n, ni);
                    if (i < n) { if (t[i] == (byte)40)
                    {
                        // a conflict target naming the integer primary key is the same as no target
                        i = sq_vd_skip(t, n, i + 1);
                        ni = sq_vd_ident(t, n, i, @rs0, @rl0);
                        rk = 0 - 1;
                        if (ni >= 0 & ti.ipk >= 0) { if (ti.cl[ti.ipk] == rl0) { rk = ti.ipk; for (j = 0; j < rl0; j++) { if (sq_lc(t[rs0 + j]) != sq_lc(ti.base[ti.cs[rk] + j])) { rk = 0 - 1; }; }; }; };
                        if (rk < 0) { sq_stmt_del(g1); sq_seterr(st, "EXPLAIN is not available for this conflict target\0"); return 1; };
                        i = sq_vd_skip(t, n, ni);
                        if (i >= n) { sq_stmt_del(g1); sq_seterr(st, "EXPLAIN is not available for this INSERT\0"); return 1; };
                        if (t[i] != (byte)41) { sq_stmt_del(g1); sq_seterr(st, "EXPLAIN is not available for this INSERT\0"); return 1; };
                        i = sq_vd_skip(t, n, i + 1);
                    }; };
                    ni = sq_vd_word(t, n, i, "do\0");
                    if (ni < 0) { sq_stmt_del(g1); sq_seterr(st, "EXPLAIN is not available for this INSERT\0"); return 1; };
                    i = sq_vd_skip(t, n, ni);
                    ni = sq_vd_word(t, n, i, "nothing\0");
                    if (ni < 0) { sq_stmt_del(g1); sq_seterr(st, "EXPLAIN is not available for this conflict clause\0"); return 1; };
                    i = sq_vd_skip(t, n, ni);
                    if (i < n) { sq_stmt_del(g1); sq_seterr(st, "EXPLAIN is not available for this INSERT\0"); return 1; };
                    orm = 2;
                };
                if (orm != 2 | i < n)
                {
                ni = sq_vd_word(t, n, i, "returning\0");
                if (ni < 0 | orm != 0 | dv != 0) { sq_stmt_del(g1); sq_seterr(st, "EXPLAIN is not available for this INSERT\0"); return 1; };
                i = sq_vd_skip(t, n, ni);
                while (i < n)
                {
                    if (t[i] == (byte)42)
                    {
                        for (k = 0; k < ncol; k++) { retc[rn] = k; rn++; };
                        i++;
                    }
                    else
                    {
                        ni = sq_vd_ident(t, n, i, @rs0, @rl0);
                        if (ni < 0) { sq_stmt_del(g1); sq_seterr(st, "EXPLAIN is not available for this INSERT\0"); return 1; };
                        rk = 0 - 1;
                        for (k = 0; k < ncol; k++)
                        {
                            if (ti.cl[k] != rl0) { continue; };
                            c = 1;
                            for (j = 0; j < rl0; j++) { if (sq_lc(t[rs0 + j]) != sq_lc(ti.base[ti.cs[k] + j])) { c = 0; }; };
                            if (c == 1) { rk = k; break; };
                        };
                        if (rk < 0 | rn >= 120) { sq_stmt_del(g1); sq_seterr(st, "EXPLAIN is not available for this INSERT\0"); return 1; };
                        retc[rn] = rk; rn++;
                        i = ni;
                    };
                    i = sq_vd_skip(t, n, i);
                    if (i < n) { if (t[i] == (byte)44) { i = sq_vd_skip(t, n, i + 1); continue; }; };
                    break;
                };
                if (i < n | rn < 1 | ra > 0) { sq_stmt_del(g1); sq_seterr(st, "EXPLAIN is not available for this INSERT\0"); return 1; };
                hasret = 1;
                };
            };
            };
            // omitted columns that have a literal DEFAULT are appended to the select list so they get nodes of their own
            sq_sb_init(@dt);
            nd = 0;
            if (dv == 0) { sq_sb_add(@dt, @t[vs], ve - vs); };
            for (k = 0; k < ncol; k++)
            {
                dmap[k] = 0 - 1;
                if (k == ti.ipk | map[k] >= 0 | ti.dfl[k] <= 0) { continue; };
                if (dt.n > 0) { sq_sb_lit(@dt, ",\0"); };
                sq_sb_add(@dt, @ti.base[ti.dfs[k]], ti.dfl[k]);
                dmap[k] = nv + nd; nd++;
            };
            if (dt.n == 0) { sq_sb_lit(@dt, "null\0"); };
            if (sq_vd_prep(st, "select \0", (byte*)0, 0, dt.p, dt.n, @g2) != 0) { sq_sb_free(@dt); sq_stmt_del(g1); return 1; };
            sq_sb_free(@dt);
            b2 = g2.blks[g2.root_blk];
            if (b2.nres != nv + nd & (dv == 0 | nd > 0)) { sq_stmt_del(g1); sq_stmt_del(g2); sq_seterr(st, "EXPLAIN is not available for this INSERT\0"); return 1; };
            if (ti.wor != 0 & hasret != 0) { sq_stmt_del(g1); sq_stmt_del(g2); sq_seterr(st, "EXPLAIN is not available for this INSERT\0"); return 1; };
            if (ti.wor != 0) { return sq_vd_worins(st, g1, g2, ti, sr, b2, @map[0], @dmap[0], nv, t, ns, nl, orm, pq); };
            sq_vd_reset();
            init = sq_vd_op("Init\0", 0, 0, 0);
            a = sq_vd_op("OpenWrite\0", 0, sr.root, 0);
            sq_vd_p4i(a, (i64)ncol);
            nx = sq_idx_list(sr.sdb, sr.tbl, ti, @ixl[0], 12);
            for (k = nx - 1; k >= 0; k--)
            {
                xi = @ixl[k];
                if (xi.nk < 1) { sq_stmt_del(g1); sq_stmt_del(g2); sq_seterr(st, "EXPLAIN is not available for this index\0"); return 1; };
                for (j = 0; j < xi.nk; j++) { if (xi.isx[j] == 0 & (xi.col[j] == ti.ipk | xi.col[j] >= ncol)) { sq_stmt_del(g1); sq_stmt_del(g2); sq_seterr(st, "EXPLAIN is not available for this index\0"); return 1; }; };
                if (sq_vd_ixprobe(ti, xi, 1) != 0) { sq_stmt_del(g1); sq_stmt_del(g2); sq_seterr(st, "EXPLAIN is not available for this index\0"); return 1; };
                a = sq_vd_op("OpenWrite\0", nx - k, xi.root, 0);
                sq_sb_init(@aff);
                if (sq_vd_kinfo(xi, @aff) != 0) { sq_sb_free(@aff); sq_stmt_del(g1); sq_stmt_del(g2); sq_seterr(st, "EXPLAIN is not available for this index collation\0"); return 1; };
                sq_vd_p4s(a, aff.p, aff.n);
                sq_sb_free(@aff);
            };
            VD_NMEM = 1; VD_NFREE = 0; VD_NH = 0; VD_NJ = 0;
            base = 2 + ra;
            VD_NMEM = 1 + ra + ncol;
            ipk = ti.ipk;
            ipm = 0; ips = 0;
            if (ipk >= 0)
            {
                sq_vd_op("SoftNull\0", base + ipk, 0, 0);
                if (map[ipk] >= 0) { ips = 1; };
                if (map[ipk] >= 0) { if (g2.nodes[b2.rc[map[ipk]]].kind != SQN_NULL) { ipm = 1; }; };
            };
            for (k = 0; k < ncol; k++)
            {
                if (k == ipk) { continue; };
                if (map[k] < 0)
                {
                    if (dmap[k] >= 0)
                    {
                        VD_HF[VD_NH] = 0; VD_HN[VD_NH] = b2.rc[dmap[k]]; VD_HR[VD_NH] = base + k; VD_HEP[VD_NH] = 0; VD_NH++;
                    }
                    else
                    {
                        if (ti.dfl[k] != 0) { sq_stmt_del(g1); sq_stmt_del(g2); sq_seterr(st, "EXPLAIN is not available for column defaults\0"); return 1; };
                        VD_HF[VD_NH] = 0; VD_HN[VD_NH] = 0 - 1; VD_HR[VD_NH] = base + k; VD_HEP[VD_NH] = 0; VD_NH++;
                    };
                }
                else
                {
                    if (sq_vd_isconst(g2, b2.rc[map[k]]) == false)
                    {
                        VD_NMEM = 1 + ra + ncol;
                        for (j = 0; j < nx; j++) { VD_NMEM = VD_NMEM + 1 + ixl[j].nk + 1; };
                        VD_NMEM++;
                        VD_NFREE = 0;
                        if (sq_vd_expr(g2, ti, b2.rc[map[k]], base + k) != 0) { sq_stmt_del(g1); sq_stmt_del(g2); sq_seterr(st, "EXPLAIN is not available for this expression\0"); return 1; };
                        VD_NMEM = 1 + ra + ncol;
                        VD_NFREE = 0;
                    }
                    else { if (sq_vd_lit(g2, b2.rc[map[k]], base + k) != 0) { sq_stmt_del(g1); sq_stmt_del(g2); return 1; }; };
                };
            };
            nn = 0 - 1;
            if (ipm == 1)
            {
                if (sq_vd_isconst(g2, b2.rc[map[ipk]]) == false) { sq_stmt_del(g1); sq_stmt_del(g2); sq_seterr(st, "EXPLAIN is not available for this expression\0"); return 1; };
                sq_vd_lit(g2, b2.rc[map[ipk]], 1 + ra);
                nn = sq_vd_op("NotNull\0", 1 + ra, 0, 0);
                sq_vd_op("NewRowid\0", 0, 1 + ra, 0);
                if (ra > 0) { VD_P3[VD_N - 1] = 2; };
                VD_P2[nn] = VD_N;
                sq_vd_op("MustBeInt\0", 1 + ra, 0, 0);
            }
            else { sq_vd_op("NewRowid\0", 0, 1 + ra, 0); if (ra > 0) { VD_P3[VD_N - 1] = 2; }; };
            if (ra > 0) { sq_vd_op("MemMax\0", 2, 1 + ra, 0); };
            for (k = 0; k < ncol; k++)
            {
                if (k == ipk | ti.notnull[k] == 0) { continue; };
                if (orm != 0) { sq_stmt_del(g1); sq_stmt_del(g2); sq_seterr(st, "EXPLAIN is not available for this conflict clause\0"); return 1; };
                a = sq_vd_op("HaltIfNull\0", 1299, 2, base + k);
                sq_sb_init(@msg);
                sq_sb_add(@msg, @t[ns], nl);
                sq_sb_lit(@msg, ".\0");
                sq_sb_add(@msg, @ti.base[ti.cs[k]], ti.cl[k]);
                sq_vd_p4s(a, msg.p, msg.n);
                sq_sb_free(@msg);
                VD_P5[a] = 1;
            };
            if (ips == 1)
            {
                ne = sq_vd_op("NotExists\0", 0, 0, 1 + ra);
                if (orm == 1)
                {
                    if (nx == 1)
                    {
                        xi = @ixl[0];
                        if (xi.unique != 0 | xi.partial != 0 | xi.ne != 0) { sq_stmt_del(g1); sq_stmt_del(g2); sq_seterr(st, "EXPLAIN is not available for this conflict clause\0"); return 1; };
                        nkc = xi.nk;
                        kb = VD_NMEM + 1 + nkc + 1 + 1 + 1;
                        for (j = 0; j < nkc; j++) { sq_vd_op("Column\0", 0, xi.col[j], kb + j); };
                        sq_vd_op("Rowid\0", 0, kb + nkc, 0);
                        a = sq_vd_op("IdxDelete\0", 1, kb, nkc + 1);
                        sq_vd_p4s(a, @xi.name[0], sq_cstrlen(@xi.name[0]));
                    };
                    VD_P2[ne] = VD_N; ne = 0 - 1;
                };
                ni = 0 - 1;
                if (orm == 2) { VD_P2[ne] = VD_N + 1; ne = 0 - 1; ni = sq_vd_op("Goto\0", 0, 0, 0); };
                if (orm == 0) {
                a = sq_vd_op("Halt\0", 1555, 2, 0);
                sq_sb_init(@msg);
                sq_sb_add(@msg, @t[ns], nl);
                sq_sb_lit(@msg, ".\0");
                sq_sb_add(@msg, @ti.base[ti.cs[ipk]], ti.cl[ipk]);
                sq_vd_p4s(a, msg.p, msg.n);
                sq_sb_free(@msg);
                VD_P5[a] = 2;
                VD_P2[ne] = VD_N;
                };
            };
            for (k = 0; k < nx; k++) { if (orm == 1 & (ixl[k].partial != 0 | ixl[k].ne != 0)) { if (sq_vd_ixprobe(ti, @ixl[k], 0) != 0) { sq_stmt_del(g1); sq_stmt_del(g2); sq_seterr(st, "EXPLAIN is not available for this conflict clause\0"); return 1; }; }; };
            if (nx > 1 & ips == 1 & orm != 0) { sq_stmt_del(g1); sq_stmt_del(g2); sq_seterr(st, "EXPLAIN is not available for this conflict clause\0"); return 1; };
            nign = 0;
            p5v = 57;
            if (ipm == 1) { p5v = 49; };
            sq_vd_instail(ti, @ixl[0], nx, t, ns, nl, base, 1 + ra, 0, VD_NMEM + 1, orm, p5v, @ign[0], @nign);
            mm = VD_NMEM;
            for (k = 0; k < nign; k++) { VD_P2[ign[k]] = VD_N; };
            if (ni >= 0 & orm == 2) { VD_P2[ni] = VD_N; };
            if (hasret == 1)
            {
                rb2 = VD_NMEM + 1;
                for (j = 0; j < nx; j++) { if (ixl[j].unique != 0) { rb2++; break; }; };
                for (j = 0; j < rn; j++)
                {
                    if (retc[j] == ipk) { sq_vd_op("Copy\0", 1 + ra, rb2 + j, 0); }
                    else
                    {
                        sq_vd_op("Copy\0", base + retc[j], rb2 + j, 0);
                        if (ti.aff[retc[j]] == 4) { sq_vd_op("RealAffinity\0", rb2 + j, 0, 0); };
                    };
                };
                sq_vd_op("MakeRecord\0", rb2, rn, rb2 + rn);
                sq_vd_op("NewRowid\0", nx + 2, rb2 + rn + 1, 0);
                sq_vd_op("Insert\0", nx + 2, rb2 + rn, rb2 + rn + 1);
                sq_vd_op("FkCheck\0", 0, 0, 0);
                rw = sq_vd_op("Rewind\0", nx + 2, 0, 0);
                for (j = 0; j < rn; j++) { sq_vd_op("Column\0", nx + 2, j, rb2 + j); };
                sq_vd_op("ResultRow\0", rb2, rn, 0);
                a = sq_vd_op("Next\0", nx + 2, rw + 1, 0);
                VD_P2[rw] = VD_N;
            };
            le = 0 - 1;
            if (ra > 0)
            {
                le = sq_vd_op("Le\0", 4, 0, 2);
                a = sq_vd_op("OpenWrite\0", 0, sqroot, 0);
                sq_vd_p4i(a, (i64)2);
                nn2 = sq_vd_op("NotNull\0", 3, 0, 0);
                sq_vd_op("NewRowid\0", 0, 3, 0);
                VD_P2[nn2] = VD_N;
                sq_vd_op("MakeRecord\0", 1, 2, mm + 1);
                a = sq_vd_op("Insert\0", 0, mm + 1, 3);
                VD_P5[a] = 8;
                sq_vd_op("Close\0", 0, 0, 0);
                VD_P2[le] = VD_N;
            };
            sq_vd_op("Halt\0", 0, 0, 0);
            VD_P2[init] = VD_N;
            sq_vd_trans(st.db, 1);
            if (ra > 0)
            {
                a = sq_vd_op("OpenRead\0", 0, sqroot, 0);
                sq_vd_p4i(a, (i64)2);
                a = sq_vd_op("String8\0", 0, 1, 0);
                sq_vd_p4s(a, @t[ns], nl);
                sq_vd_op("Null\0", 0, 2, 4);
                rr2 = sq_vd_op("Rewind\0", 0, 0, 0);
                sq_vd_op("Column\0", 0, 0, 2);
                nn2 = sq_vd_op("Ne\0", 1, 0, 2);
                VD_P5[nn2] = 16;
                sq_vd_op("Rowid\0", 0, 3, 0);
                sq_vd_op("Column\0", 0, 1, 2);
                sq_vd_op("AddImm\0", 2, 0, 0);
                sq_vd_op("Copy\0", 2, 4, 0);
                le = sq_vd_op("Goto\0", 0, 0, 0);
                VD_P2[nn2] = VD_N;
                sq_vd_op("Next\0", 0, rr2 + 1, 0);
                VD_P2[rr2] = VD_N;
                sq_vd_op("Integer\0", 0, 2, 0);
                VD_P2[le] = VD_N;
                sq_vd_op("Close\0", 0, 0, 0);
            };
            for (k = 0; k < VD_NH; k++)
            {
                if (VD_HN[k] < 0) { sq_vd_op("Null\0", 0, VD_HR[k], 0); } else { sq_vd_lit(g2, VD_HN[k], VD_HR[k]); };
            };
            if (hasret == 1) { a = sq_vd_op("OpenEphemeral\0", nx + 2, rn, 0); };
            sq_vd_op("Goto\0", 0, 1, 0);
            sq_stmt_del(g1); sq_stmt_del(g2);
            sq_vd_query(pq);
            return 0;
        };

        // index maintenance of one DELETE row for every index (newest index first): optional Once,
        // all OpenWrites, then per index the key columns, Rowid and IdxDelete
        // index-seek plan of a single-table WHERE: 2 = equality prefix of one index, 3 = range on its first column, 0 = none
        global int VD_SKNL;
        global int VD_SKINL;
        global int VD_SKUQ;
        def sq_vd_seekplan(SQ_STMT* g, SQ_BLK* b, SQ_TI* ti, SQ_IDX* ixs, int nix, int* cj, int* pnc, int* psm, int* psp, int* plo, int* phi) -> int
        {
            SQ_NODE* w;
            int tw, sm, sp, nc, pl, fnd, x, j, k, lo, hi, kn, okn;
            VD_SKNL = 0; VD_SKINL = 0; VD_SKUQ = 0;
            tw = 0; sm = 0; sp = 0; nc = 0; lo = 0 - 1; hi = 0 - 1;
            sm = 0; sp = 0;
            kn = 0; okn = 0;
            if (nix >= 1 & sq_vd_gon(695) == 0)
            {
                if (g.nodes[b.where_n].kind == SQN_BIN & g.nodes[b.where_n].op == SQO_OR)
                {
                    VD_ORN = 0;
                    sq_vd_orin(g, ti, b.where_n);
                    okn = 1;
                };
            };
            if (tw == 0 & nix >= 1)
            {
                nc = 0;
                sq_vd_splitx(g, b.where_n, @cj[0], @nc);
                for (k = nix - 1; k >= 0; k--)
                {
                    if (ixs[k].partial != 0 | ixs[k].ne != 0) { continue; };
                    pl = 0; kn = 0;
                    for (j = 0; j < ixs[k].nk; j++)
                    {
                        if (ixs[k].coll[j] != 0 | ixs[k].desc[j] != 0) { break; };
                        fnd = 0 - 1; kn = 0;
                        for (x = 0; x < nc; x++)
                        {
                            w = @g.nodes[cj[x]];
                            if (w.kind == SQN_ISNULL & w.op == 1 & sq_vd_gon(690) == 0)
                            {
                                if (g.nodes[w.a].kind == SQN_COL) { if (g.nodes[w.a].col == ixs[k].col[j] & g.nodes[w.a].col != ti.ipk & (ixs[k].unique == 0 | (ixs[k].nk == 1 & sq_vd_gon(707) == 0))) { fnd = x; kn = 1; }; };
                                continue;
                            };
                            if (w.kind != SQN_BIN) { continue; };
                            if (w.op != SQO_EQ | g.nodes[w.a].kind != SQN_COL) { continue; };
                            if (g.nodes[w.a].col != ixs[k].col[j] | g.nodes[w.a].col == ti.ipk) { continue; };
                            if (g.nodes[w.b].kind == SQN_INT & (ti.aff[ixs[k].col[j]] == 3 | ti.aff[ixs[k].col[j]] == 0)) { fnd = x; };
                            if (g.nodes[w.b].kind == SQN_STR & (ti.aff[ixs[k].col[j]] == 1 | ti.aff[ixs[k].col[j]] == 0)) { fnd = x; };
                        };
                        if (fnd < 0) { break; };
                        pl++;
                    };
                    if (ixs[k].unique != 0 & pl != ixs[k].nk) { continue; };
                    if (pl > sp & pl == nc) { sp = pl; sm = k; tw = 2; VD_SKNL = kn; };
                };
            };
            if (tw == 0 & nix >= 1 & nc == 1 & sq_vd_gon(691) == 0)
            {
                w = @g.nodes[cj[0]];
                if (w.kind == SQN_IN & w.blk < 0 & w.b >= 0 & w.op != 2)
                {
                    if (g.nodes[w.a].kind == SQN_COL & g.nodes[w.a].lvl == 0 & g.nodes[w.b].next >= 0)
                    {
                        for (k = nix - 1; k >= 0 & tw == 0; k--)
                        {
                            if (ixs[k].unique != 0 | ixs[k].partial != 0 | ixs[k].ne != 0 | ixs[k].coll[0] != 0 | ixs[k].desc[0] != 0) { continue; };
                            if (ixs[k].col[0] != g.nodes[w.a].col | ixs[k].col[0] == ti.ipk) { continue; };
                            if (ixs[k].isx[0] != 0 | ti.coll[ixs[k].col[0]] != 0) { continue; };
                            tw = 2; sm = k; sp = 1; VD_SKNL = 1; VD_SKINL = 1;
                        };
                    };
                };
            };
            if (tw == 0 & nix >= 1 & nc >= 2 & nc <= 4 & sq_vd_gon(692) == 0)
            {
                for (k = nix - 1; k >= 0 & tw == 0; k--)
                {
                    if (ixs[k].unique != 0 | ixs[k].partial != 0 | ixs[k].ne != 0) { continue; };
                    pl = 0;
                    for (j = 0; j < ixs[k].nk; j++)
                    {
                        if (ixs[k].coll[j] != 0 | ixs[k].desc[j] != 0 | ixs[k].isx[j] != 0 | ixs[k].col[j] == ti.ipk) { break; };
                        fnd = 0 - 1;
                        for (x = 0; x < nc; x++)
                        {
                            w = @g.nodes[cj[x]];
                            if (w.kind != SQN_BIN | w.op != SQO_EQ) { continue; };
                            if (g.nodes[w.a].kind != SQN_COL) { continue; };
                            if (g.nodes[w.a].col != ixs[k].col[j]) { continue; };
                            if (g.nodes[w.b].kind == SQN_INT & (ti.aff[ixs[k].col[j]] == 3 | ti.aff[ixs[k].col[j]] == 0)) { fnd = x; };
                            if (g.nodes[w.b].kind == SQN_STR & (ti.aff[ixs[k].col[j]] == 1 | ti.aff[ixs[k].col[j]] == 0)) { fnd = x; };
                        };
                        if (fnd < 0) { break; };
                        pl++;
                        if (pl + 1 >= ixs[k].nk + 1) { break; };
                        if (pl == nc - 1 | pl == nc - 2) { break; };
                    };
                    if (pl < 1 | pl >= ixs[k].nk) { continue; };
                    if (ixs[k].coll[pl] != 0 | ixs[k].desc[pl] != 0 | ixs[k].isx[pl] != 0 | ixs[k].col[pl] == ti.ipk) { continue; };
                    lo = 0 - 1; hi = 0 - 1; fnd = 0; kn = 0;
                    for (x = 0; x < nc; x++)
                    {
                        w = @g.nodes[cj[x]];
                        if (w.kind != SQN_BIN | g.nodes[w.a].kind != SQN_COL) { fnd = 0 - 1; break; };
                        if (w.op == SQO_EQ)
                        {
                            for (j = 0; j < pl; j++) { if (g.nodes[w.a].col == ixs[k].col[j]) { kn++; break; }; };
                            continue;
                        };
                        if (g.nodes[w.a].col != ixs[k].col[pl]) { fnd = 0 - 1; break; };
                        if (g.nodes[w.b].kind == SQN_INT & ti.aff[ixs[k].col[pl]] == 1) { fnd = 0 - 1; break; };
                        if (g.nodes[w.b].kind != SQN_INT & (g.nodes[w.b].kind != SQN_STR | ti.aff[ixs[k].col[pl]] != 1 | sq_vd_gon(685) == 1)) { fnd = 0 - 1; break; };
                        if (w.op == SQO_GT | w.op == SQO_GE) { if (lo >= 0) { fnd = 0 - 1; break; }; lo = x; fnd++; continue; };
                        if (w.op == SQO_LT | w.op == SQO_LE) { if (hi >= 0) { fnd = 0 - 1; break; }; hi = x; fnd++; continue; };
                        fnd = 0 - 1; break;
                    };
                    if (fnd >= 1 & kn == pl & fnd + kn == nc) { tw = 5; sm = k; sp = pl; };
                };
            };
            if (tw == 0 & nix >= 1 & nc >= 2 & nc <= 4 & sq_vd_gon(705) == 0)
            {
                for (k = nix - 1; k >= 0 & tw == 0; k--)
                {
                    if (ixs[k].unique != 0 | ixs[k].partial != 0 | ixs[k].ne != 0) { continue; };
                    pl = 0;
                    for (j = 0; j < ixs[k].nk; j++)
                    {
                        if (ixs[k].coll[j] != 0 | ixs[k].desc[j] != 0 | ixs[k].isx[j] != 0 | ixs[k].col[j] == ti.ipk) { break; };
                        fnd = 0 - 1;
                        for (x = 0; x < nc; x++)
                        {
                            w = @g.nodes[cj[x]];
                            if (w.kind != SQN_BIN | w.op != SQO_EQ) { continue; };
                            if (g.nodes[w.a].kind != SQN_COL) { continue; };
                            if (g.nodes[w.a].col != ixs[k].col[j]) { continue; };
                            if (g.nodes[w.b].kind == SQN_INT & (ti.aff[ixs[k].col[j]] == 3 | ti.aff[ixs[k].col[j]] == 0)) { fnd = x; };
                            if (g.nodes[w.b].kind == SQN_STR & (ti.aff[ixs[k].col[j]] == 1 | ti.aff[ixs[k].col[j]] == 0)) { fnd = x; };
                        };
                        if (fnd < 0) { break; };
                        pl++;
                    };
                    if (pl != ixs[k].nk) { continue; };
                    lo = 0 - 1; hi = 0 - 1; fnd = 0; kn = 0;
                    for (x = 0; x < nc; x++)
                    {
                        w = @g.nodes[cj[x]];
                        if (w.kind != SQN_BIN) { fnd = 0 - 1; break; };
                        if (w.op == SQO_EQ) { kn++; continue; };
                        if (g.nodes[w.a].kind != SQN_ROWID & !(g.nodes[w.a].kind == SQN_COL & ((g.nodes[w.a].col == ti.ipk & ti.ipk >= 0) | g.nodes[w.a].col == ti.ncols))) { fnd = 0 - 1; break; };
                        if (g.nodes[w.b].kind != SQN_INT) { fnd = 0 - 1; break; };
                        if (w.op == SQO_GT | w.op == SQO_GE) { if (lo >= 0) { fnd = 0 - 1; break; }; lo = x; fnd++; continue; };
                        if (w.op == SQO_LT | w.op == SQO_LE) { if (hi >= 0) { fnd = 0 - 1; break; }; hi = x; fnd++; continue; };
                        fnd = 0 - 1; break;
                    };
                    if (fnd >= 1 & kn == pl & fnd + kn == nc) { tw = 6; sm = k; sp = pl; };
                };
            };
            if (tw == 0 & nix >= 1 & nc >= 1 & nc <= 2)
            {
                for (k = nix - 1; k >= 0; k--)
                {
                    if ((ixs[k].unique != 0 & sq_vd_gon(686) == 1) | ixs[k].partial != 0 | ixs[k].ne != 0 | ixs[k].coll[0] != 0 | ixs[k].desc[0] != 0) { continue; };
                    if (ixs[k].col[0] == ti.ipk) { continue; };
                    if (ti.aff[ixs[k].col[0]] != 3 & ti.aff[ixs[k].col[0]] != 0 & (ti.aff[ixs[k].col[0]] != 1 | sq_vd_gon(685) == 1)) { continue; };
                    lo = 0 - 1; hi = 0 - 1; fnd = 1;
                    for (x = 0; x < nc; x++)
                    {
                        w = @g.nodes[cj[x]];
                        if (w.kind != SQN_BIN) { fnd = 0; break; };
                        if (g.nodes[w.a].kind != SQN_COL) { fnd = 0; break; };
                        if (g.nodes[w.b].kind != SQN_INT & (g.nodes[w.b].kind != SQN_STR | ti.aff[ixs[k].col[0]] != 1 | sq_vd_gon(685) == 1)) { fnd = 0; break; };
                        if (g.nodes[w.b].kind == SQN_INT & ti.aff[ixs[k].col[0]] == 1) { fnd = 0; break; };
                        if (g.nodes[w.a].col != ixs[k].col[0]) { fnd = 0; break; };
                        if (w.op == SQO_GT | w.op == SQO_GE) { if (lo >= 0) { fnd = 0; break; }; lo = x; };
                        if (w.op == SQO_LT | w.op == SQO_LE) { if (hi >= 0) { fnd = 0; break; }; hi = x; };
                        if (w.op != SQO_GT & w.op != SQO_GE & w.op != SQO_LT & w.op != SQO_LE) { fnd = 0; break; };
                    };
                    if (fnd == 1) { tw = 3; sm = k; break; };
                };
            };
            if (okn == 1)
            {
                if (VD_SKINL == 0) { sq_vd_orin_undo(g); };
                VD_ORN = 0;
            };
            if (tw == 2) { if (ixs[sm].unique != 0 & VD_SKNL == 0) { VD_SKUQ = 1; }; };
            pnc[0] = nc; psm[0] = sm; psp[0] = sp; plo[0] = lo; phi[0] = hi;
            return tw;
        };

        // the statement that carries the expressions and the WHERE of a partial or expression index
        def sq_vd_ixprep(SQ_IDX* ix, SQ_STMT** pg) -> int
        {
            SQ_SB q;
            SQ_TI* ti = VD_DTI;
            SQ_STMT* st = (SQ_STMT*)VD_IXST;
            byte* sql;
            int j, r, wl;
            sql = st.db.schema[ix.schema_pos].sql;
            if ((u64)sql == (u64)0) { return 1; };
            wl = 0;
            if (ix.partial != 0) { if (ix.wok == 0 | ix.wl <= 0) { return 1; }; wl = ix.wl; };
            sq_sb_init(@q);
            sq_sb_lit(@q, "select \0");
            for (j = 0; j < ix.nk; j++)
            {
                if (j > 0) { sq_sb_lit(@q, ",\0"); };
                if (ix.isx[j] != 0) { sq_sb_add(@q, @sql[ix.xs[j]], ix.xl[j]); }
                else
                {
                    sq_sb_lit(@q, "\"\0");
                    sq_sb_add(@q, @ti.base[ti.cs[ix.col[j]]], ti.cl[ix.col[j]]);
                    sq_sb_lit(@q, "\"\0");
                };
            };
            sq_sb_lit(@q, " from \0");
            r = sq_vd_prep2(st, q.p, (byte*)VD_IXNM, VD_IXNL, @sql[ix.ws], wl, pg);
            sq_sb_free(@q);
            return r;
        };

        // marks the constants queued since nh0 as belonging to the side statement in slot
        def sq_vd_ixtag(int nh0, int slot) -> void
        {
            int x;
            for (x = nh0; x < VD_NH; x++) { if (VD_HN[x] >= 0) { VD_HN[x] = VD_HN[x] + 100000 * (slot + 1); }; };
        };

        // the partial-index WHERE of one index: falls through when the row belongs in the index, else jumps past the maintenance
        // returns the side statement slot, 0-1 when the index has no WHERE; sets *pj to the first jump slot to patch
        def sq_vd_ixwhere(SQ_IDX* ix, SQ_STMT** pg, int* pj) -> int
        {
            SQ_STMT* gk;
            SQ_BLK* gb;
            int nh0, r, slot;
            *pj = VD_NJ;
            if (VD_XGN >= 8) { return 0 - 2; };
            if (sq_vd_ixprep(ix, @gk) != 0) { return 0 - 2; };
            slot = VD_XGN;
            VD_XG[slot] = (u64)gk;
            VD_XGN++;
            *pg = gk;
            if (ix.partial == 0) { return slot; };
            gb = gk.blks[gk.root_blk];
            nh0 = VD_NH;
            VD_PURE = 2;
            r = sq_vd_where(gk, VD_DTI, gb.where_n);
            VD_PURE = 0;
            sq_vd_ixtag(nh0, slot);
            if (r != 0) { return 0 - 2; };
            return slot;
        };

        // one key value of an index for the row under the table cursor: a column or an index expression
        def sq_vd_ixkey(SQ_IDX* ix, SQ_STMT* gk, int slot, int j, int cur, int reg) -> int
        {
            SQ_BLK* gb;
            int nh0, r;
            if (ix.isx[j] == 0) { sq_vd_op("Column\0", cur, ix.col[j], reg); return 0; };
            gb = gk.blks[gk.root_blk];
            nh0 = VD_NH;
            VD_PURE = 32;
            r = sq_vd_expr(gk, VD_DTI, gb.rc[j], reg);
            VD_PURE = 0;
            sq_vd_ixtag(nh0, slot);
            return r;
        };

        // loads the plain-column key of index m from the table cursor cur; shares the registers of the previous index pm when the
        // register range is the same one, as SQLite does when it deletes from several indexes in a row
        def sq_vd_ixload(SQ_IDX* ixs, int m, int pm, int kb, int pkb, int cur) -> void
        {
            int j, sh;
            sh = 0;
            if (pm >= 0) { if (ixs[pm].partial == 0 & pkb == kb) { sh = 1; }; };
            for (j = 0; j < ixs[m].nk; j++)
            {
                if (sh == 1 & j < ixs[pm].nk)
                {
                    if (ixs[pm].isx[j] == 0 & ixs[m].isx[j] == 0 & ixs[pm].col[j] == ixs[m].col[j] & ixs[pm].coll[j] == ixs[m].coll[j]) { continue; };
                };
                sq_vd_op("Column\0", cur, ixs[m].col[j], kb + j);
                if (ixs[m].col[j] >= 0 & ixs[m].col[j] < VD_DTI.ncols) { if (VD_DTI.aff[ixs[m].col[j]] == 4) { sq_vd_op("Noop\0", kb + j, 0, 0); }; };
            };
            if (sh == 1) { if (ixs[pm].nk == ixs[m].nk) { return; }; };
            sq_vd_op("Rowid\0", cur, kb + ixs[m].nk, 0);
        };

        global int VD_IDXPH = 0;
        def sq_vd_idxdel(SQ_IDX* ixs, int nix, int once, int skip) -> int
        {
            SQ_STMT* gk;
            int a, o, k, j, kb, r0, slot, nj0, x, hx, pk, pkb, sh;
            SQ_SB kt;
            o = 0 - 1;
            if (once == 1) { o = sq_vd_op("Once\0", 0, 0, 0); };
            for (k = nix - 1; k >= 0; k--)
            {
                if (k == skip | VD_IDXPH == 2) { continue; };
                a = sq_vd_op("OpenWrite\0", nix - k, ixs[k].root, 0);
                sq_sb_init(@kt);
                if (sq_vd_kinfo(@ixs[k], @kt) != 0) { sq_sb_free(@kt); return 1; };
                sq_vd_p4s(a, kt.p, kt.n);
                sq_sb_free(@kt);
                VD_P5[a] = 8;
            };
            if (once == 1) { VD_P2[o] = VD_N; };
            if (VD_IDXPH == 1) { return 0; };
            pk = 0 - 1; pkb = 0;
            for (k = nix - 1; k >= 0; k--)
            {
                if (k == skip) { continue; };
                hx = 0;
                for (j = 0; j < ixs[k].nk; j++) { if (ixs[k].isx[j] != 0) { hx = 1; }; };
                slot = 0 - 1;
                nj0 = VD_NJ;
                if (ixs[k].partial != 0 | hx == 1)
                {
                    slot = sq_vd_ixwhere(@ixs[k], @gk, @nj0);
                    if (slot == 0 - 2) { return 1; };
                };
                kb = sq_vd_getrange(ixs[k].nk + 1);
                sh = 0;
                if (pk >= 0)
                {
                    if (ixs[pk].partial == 0 & pkb == kb) { sh = 1; };
                };
                for (j = 0; j < ixs[k].nk; j++)
                {
                    if (sh == 1 & j < ixs[pk].nk)
                    {
                        if (ixs[pk].isx[j] == 0 & ixs[k].isx[j] == 0 & ixs[pk].col[j] == ixs[k].col[j] & ixs[pk].coll[j] == ixs[k].coll[j]) { continue; };
                    };
                    if (slot >= 0) { if (sq_vd_ixkey(@ixs[k], gk, slot, j, 0, kb + j) != 0) { return 1; }; }
                    else { sq_vd_op("Column\0", 0, ixs[k].col[j], kb + j); };
                    if (ixs[k].isx[j] == 0 & ixs[k].col[j] >= 0 & ixs[k].col[j] < VD_DTI.ncols) { if (VD_DTI.aff[ixs[k].col[j]] == 4) { sq_vd_op("Noop\0", kb + j, 0, 0); }; };
                };
                if (sh == 1) { if (ixs[pk].nk != ixs[k].nk) { sh = 0; }; };
                if (sh == 0) { sq_vd_op("Rowid\0", 0, kb + ixs[k].nk, 0); };
                pk = k; pkb = kb;
                a = sq_vd_op("IdxDelete\0", nix - k, kb, ixs[k].nk + 1);
                sq_vd_p4s(a, @ixs[k].name[0], sq_cstrlen(@ixs[k].name[0]));
                sq_vd_putrange(kb, ixs[k].nk + 1);
                if (ixs[k].partial != 0)
                {
                    for (x = nj0; x < VD_NJ; x++) { VD_P2[VD_JF[x]] = VD_N; };
                    VD_NJ = nj0;
                };
            };
            return 0;
        };

        // DELETE from a WITHOUT ROWID table: the table is its own primary key index
        def sq_vd_wordel(SQ_STMT* st, SQ_STMT* g, byte* t, int ns, int nl, int ws, int upd, int* umap, byte** pq) -> int
        {
            SQ_BLK* b = g.blks[g.root_blk];
            SQ_SRC* sr = @b.src[0];
            SQ_TI* ti = sr.ti;
            SQ_IDX wsyn;
            SQ_IDX[12] ixs;
            SQ_IDX px;
            SQ_EQP pp;
            SQ_SB kt;
            SQ_NODE* w;
            SQ_NODE* l;
            int[16] cj;
            int[16] used;
            int[8] eqt;
            int wnull, wgz, winl, wch, nsec, ncj, i, a, k, init, kreg, nk3, nkr, ml, mu, pos3, sk, chk, rew, body, nxt, pcur, pk, uq, r0, nrg, j, ow, isn, ldaddr, cb, nrecs, prec, nfld, na, c, ncol, aff1, chgpk, ob, nfd, hlt, ncf;
            byte[130] ab;
            byte[2] wnb;
            int[10] cmpo;
            nsec = sq_idx_list(sr.sdb, sr.tbl, ti, @ixs[0], 12);
            if (nsec > 1 | ti.npk <= 0 | ti.npk > 8) { if (sq_vd_gon(461) == 1) { sq_seterr(st, "EXPLAIN is not available for this DELETE #461\0"); return 1; }; };
            sq_vd_worsyn(ti, sr, @wsyn);
            sq_vd_reset();
            VD_ISWOR = 1;
            init = sq_vd_op("Init\0", 0, 0, 0);
            if (ws < 0 & upd == 0)
            {
                for (k = nsec - 1; k >= 0; k--) { sq_vd_op("Clear\0", ixs[k].root, 0, 0); };
                a = sq_vd_op("Clear\0", sr.root, 0, 0 - 1);
                sq_vd_op("Halt\0", 0, 0, 0);
                VD_P2[init] = VD_N;
                sq_vd_trans(st.db, 1);
                sq_vd_op("Goto\0", 0, 1, 0);
                sq_stmt_del(g);
                sq_vd_query(pq);
                return 0;
            };
            pk = 0; winl = 0;
            if (ws >= 0 & nsec == 0 & ti.npk == 1 & sq_vd_gon(693) == 0)
            {
                VD_ORN = 0;
                sq_vd_orin(g, ti, b.where_n);
                w = @g.nodes[b.where_n];
                if (w.kind == SQN_IN & w.blk < 0 & w.b >= 0 & w.op != 2)
                {
                    if (g.nodes[w.b].next >= 0 & g.nodes[w.a].kind == SQN_COL & g.nodes[w.a].lvl == 0) { if (g.nodes[w.a].col == wsyn.col[0] & ti.aff[wsyn.col[0]] != 1) { winl = 1; }; };
                };
                if (winl == 1 & upd == 1) { if (umap[ti.pkc[0]] >= 0) { winl = 0; }; };
                if (winl == 0) { sq_vd_orin_undo(g); };
                VD_ORN = 0;
            };
            wnull = 0;
            if (ws >= 0 & nsec == 0 & ti.npk == 1 & sq_vd_gon(694) == 0)
            {
                w = @g.nodes[b.where_n];
                if (w.kind == SQN_ISNULL & w.op == 1 & g.nodes[w.a].kind == SQN_COL) { if (g.nodes[w.a].col == wsyn.col[0] & g.nodes[w.a].lvl == 0) { wnull = 1; }; };
            };
            if (wnull == 1 & upd == 1) { if (umap[ti.pkc[0]] >= 0) { wnull = 0; }; };
            if (ws >= 0 & winl == 0 & wnull == 0) { pk = sq_vd_plan(g, @pp, @px); };
            if (pk != 0 & pk != 3) { sq_stmt_del(g); sq_seterr(st, "EXPLAIN is not available for this access path @16306\0"); return 1; };
            ncol = ti.ncols;
            nfd = 0 - 1; isn = 0 - 1; ldaddr = 0 - 1; nrecs = 0; cb = 0; aff1 = 0; chgpk = 0; ob = 0;
            if (upd == 1)
            {
                chgpk = 0;
                for (j = 0; j < ti.npk; j++) { if (umap[ti.pkc[j]] >= 0) { chgpk = 1; }; };
                for (j = 0; j < ncol; j++) { if (ti.coll[j] != 0) { sq_stmt_del(g); sq_seterr(st, "EXPLAIN is not available for this index collation\0"); return 1; }; };
                if (nsec == 1)
                {
                    c = 0;
                    for (j = 0; j < ixs[0].nk; j++) { if (ixs[0].col[j] >= 0 & ixs[0].col[j] < ncol) { if (umap[ixs[0].col[j]] >= 0) { c = 1; }; }; };
                    aff1 = c;
                    if (chgpk == 1) { aff1 = 1; };
                    if (aff1 == 1) { nrecs = 1 + ixs[0].nk + ti.npk; };
                };
                nrecs = nrecs + 1 + ncol;
                ob = nrecs + 3;
                cb = ob;
                if (chgpk == 1) { cb = ob + ncol + 1; };
            };
            if (nsec == 1 & pk != 3) { sq_stmt_del(g); sq_seterr(st, "EXPLAIN is not available for this access path @16327\0"); return 1; };
            if (sq_vd_hasor(g, b.where_n) == 1) { sq_stmt_del(g); sq_seterr(st, "EXPLAIN is not available for this access path @16328\0"); return 1; };
            pcur = nsec + 1;
            if (upd == 1) { sq_vd_op("Null\0", 0, cb + ncol, cb + ncol + ti.npk - 1); };
            sq_vd_op("Noop\0", nsec + 2, ti.npk, 0);
            wgz = 0 - 1;
            if (wnull == 1) { wgz = sq_vd_op("Goto\0", 0, 0, 0); };
            a = sq_vd_op("OpenWrite\0", pcur, sr.root, 0);
            ow = a;
            sq_sb_init(@kt);
            if (sq_vd_kinfo(@wsyn, @kt) != 0) { sq_sb_free(@kt); sq_stmt_del(g); sq_seterr(st, "EXPLAIN is not available for this index collation\0"); return 1; };
            sq_vd_p4s(a, kt.p, kt.n);
            sq_sb_free(@kt);
            VD_NMEM = ti.npk; VD_NFREE = 0; VD_NH = 0; VD_NJ = 0;
            if (upd == 1) { VD_NMEM = cb + ncol + ti.npk; };
            VD_COLCUR = pcur; VD_IDXCUR = pcur;
            sq_vd_setix(@wsyn);
            rew = 0 - 1; sk = 0 - 1; chk = 0 - 1; ml = 0 - 1; mu = 0 - 1; nk3 = 0; uq = 0;
            ncj = 0;
            if (winl == 1)
            {
                VD_P5[ow] = 2;
                kreg = VD_NMEM + 1;
                VD_NMEM++;
                VD_INDESC = 0;
                sq_vd_insub(g, ti, b.where_n, wsyn.col[0], 0, nsec + 3, kreg);
                if (sq_vd_affch(ti.aff[wsyn.col[0]]) != 65)
                {
                    wch = sq_vd_affch(ti.aff[wsyn.col[0]]);
                    if (wch == 68) { wch = 67; };
                    wnb[0] = (byte)wch; wnb[1] = (byte)0;
                    a = sq_vd_op("Affinity\0", kreg, 1, 0);
                    sq_vd_p4s(a, @wnb[0], 1);
                };
                sk = sq_vd_op("SeekGE\0", pcur, 0, kreg);
                sq_vd_p4i(sk, 1);
                chk = sq_vd_op("IdxGT\0", pcur, 0, kreg);
                sq_vd_p4i(chk, 1);
                body = chk;
            }
            else if (pk == 3)
            {
                sq_vd_splitx(g, b.where_n, @cj[0], @ncj);
                for (i = 0; i < ncj; i++) { used[i] = 0; };
                for (a = 0; a < ti.npk; a++)
                {
                    pos3 = 0 - 1;
                    for (i = 0; i < ncj; i++)
                    {
                        w = @g.nodes[cj[i]];
                        if (used[i] != 0 | w.kind != SQN_BIN | w.op != SQO_EQ) { continue; };
                        if (sq_vd_isconst(g, w.b) == false | g.nodes[w.b].kind == SQN_NULL) { continue; };
                        l = @g.nodes[w.a];
                        if (l.kind != SQN_COL) { continue; };
                        if (l.col != wsyn.col[a]) { continue; };
                        pos3 = i; break;
                    };
                    if (pos3 >= 0) { used[pos3] = 1; eqt[nk3] = pos3; nk3++; continue; };
                    for (i = 0; i < ncj; i++)
                    {
                        w = @g.nodes[cj[i]];
                        if (used[i] != 0 | w.kind != SQN_BIN) { continue; };
                        if (sq_vd_isconst(g, w.b) == false | g.nodes[w.b].kind == SQN_NULL) { continue; };
                        l = @g.nodes[w.a];
                        if (l.kind != SQN_COL) { continue; };
                        if (l.col != wsyn.col[a]) { continue; };
                        if ((w.op == SQO_GT | w.op == SQO_GE) & ml < 0) { ml = i; used[i] = 1; };
                        if ((w.op == SQO_LT | w.op == SQO_LE) & mu < 0) { mu = i; used[i] = 1; };
                    };
                    break;
                };
                if (nk3 == 0 & ml < 0 & mu < 0) { sq_stmt_del(g); sq_seterr(st, "EXPLAIN is not available for this access path @16398\0"); return 1; };
                for (i = 0; i < ncj; i++)
                {
                    w = @g.nodes[cj[i]];
                    if (w.kind == SQN_BIN)
                    {
                        if (g.nodes[w.a].kind == SQN_COL)
                        {
                            k = g.nodes[w.a].col;
                            if (sq_vd_inix(@wsyn, k) >= 0)
                            {
                                a = g.nodes[w.b].kind;
                                if (ti.aff[k] == 1 & a != SQN_STR) { sq_stmt_del(g); sq_seterr(st, "EXPLAIN is not available for this comparison\0"); return 1; };
                                if (ti.aff[k] >= 2 & ti.aff[k] != 4 & a != SQN_INT) { sq_stmt_del(g); sq_seterr(st, "EXPLAIN is not available for this comparison\0"); return 1; };
                                if (ti.aff[k] == 4 & a != SQN_INT & a != SQN_REAL) { sq_stmt_del(g); sq_seterr(st, "EXPLAIN is not available for this comparison\0"); return 1; };
                            };
                        };
                    };
                };
                if (nk3 == ti.npk & ml < 0 & mu < 0) { uq = 1; };
                if (nk3 > 0 & ml < 0 & mu < 0) { VD_P5[ow] = 2; };
                if (nsec == 1 & (uq == 0 | ncj != nk3)) { sq_stmt_del(g); sq_seterr(st, "EXPLAIN is not available for this access path @16419\0"); return 1; };
                kreg = VD_NMEM + 1;
                nkr = nk3;
                if (ml >= 0 | mu >= 0) { nkr = nk3 + 1; };
                VD_NMEM = VD_NMEM + nkr;
                for (i = 0; i < nk3; i++) { sq_vd_lit(g, g.nodes[cj[eqt[i]]].b, kreg + i); };
                if (ml >= 0 | mu >= 0)
                {
                    if (ml >= 0)
                    {
                        sq_vd_lit(g, g.nodes[cj[ml]].b, kreg + nk3);
                        if (g.nodes[cj[ml]].op == SQO_GT) { sk = sq_vd_op("SeekGT\0", pcur, 0, kreg); } else { sk = sq_vd_op("SeekGE\0", pcur, 0, kreg); };
                    }
                    else
                    {
                        if (nk3 == 0)
                        {
                            rew = sq_vd_op("Rewind\0", pcur, 0, kreg);
                            sq_vd_p4i(rew, 0);
                        }
                        else
                        {
                            sq_vd_op("Null\0", 0, kreg + nk3, 0);
                            sk = sq_vd_op("SeekGT\0", pcur, 0, kreg);
                        };
                    };
                    if (sk >= 0) { sq_vd_p4i(sk, nk3 + 1); };
                    if (mu >= 0)
                    {
                        sq_vd_lit(g, g.nodes[cj[mu]].b, kreg + nk3);
                        if (g.nodes[cj[mu]].op == SQO_LT) { chk = sq_vd_op("IdxGE\0", pcur, 0, kreg); } else { chk = sq_vd_op("IdxGT\0", pcur, 0, kreg); };
                        sq_vd_p4i(chk, nk3 + 1);
                    }
                    else
                    {
                        if (nk3 > 0) { chk = sq_vd_op("IdxGT\0", pcur, 0, kreg); sq_vd_p4i(chk, nk3); };
                    };
                }
                else
                {
                    sk = sq_vd_op("SeekGE\0", pcur, 0, kreg);
                    sq_vd_p4i(sk, nk3);
                    chk = sq_vd_op("IdxGT\0", pcur, 0, kreg);
                    sq_vd_p4i(chk, nk3);
                };
                body = chk;
                if (body < 0) { body = VD_N; };
                for (i = 0; i < ncj; i++)
                {
                    if (used[i] != 0) { continue; };
                    if (sq_vd_where(g, ti, cj[i]) != 0) { sq_stmt_del(g); sq_seterr(st, "EXPLAIN is not available for this WHERE clause\0"); return 1; };
                };
            }
            else
            {
                rew = sq_vd_op("Rewind\0", pcur, 0, VD_NMEM + 1);
                sq_vd_p4i(rew, 0);
                body = VD_N;
                if (b.where_n >= 0 & wnull == 0) { if (sq_vd_where(g, ti, b.where_n) != 0) { sq_stmt_del(g); sq_seterr(st, "EXPLAIN is not available for this WHERE clause\0"); return 1; }; };
            };
            if (upd == 0) {
            for (j = 0; j < ti.npk; j++) { sq_vd_op("Column\0", pcur, j, j + 1); };
            if (nsec == 1)
            {
                a = sq_vd_op("OpenWrite\0", 1, ixs[0].root, 0);
                VD_P5[a] = 8;
                sq_sb_init(@kt);
                for (j = 0; j < ixs[0].nk; j++) { if (ixs[0].coll[j] != 0 | ixs[0].desc[j] != 0 | ixs[0].isx[j] != 0) { sq_sb_free(@kt); sq_stmt_del(g); sq_seterr(st, "EXPLAIN is not available for this index collation\0"); return 1; }; };
                sq_sb_lit(@kt, "k(\0");
                sq_sb_int(@kt, (i64)(ixs[0].nk + ti.npk));
                for (j = 0; j < ixs[0].nk + ti.npk; j++) { sq_sb_lit(@kt, ",\0"); };
                sq_sb_lit(@kt, ")\0");
                sq_vd_p4s(a, kt.p, kt.n);
                sq_sb_free(@kt);
                r0 = VD_NMEM + 1;
                nrg = ixs[0].nk + ti.npk;
                VD_NMEM = VD_NMEM + nrg;
                for (j = 0; j < ixs[0].nk; j++) { sq_vd_op("Column\0", pcur, VD_WORM[ixs[0].col[j]], r0 + j); };
                for (j = 0; j < ti.npk; j++) { sq_vd_op("Column\0", pcur, j, r0 + ixs[0].nk + j); };
                a = sq_vd_op("IdxDelete\0", 1, r0, nrg);
                sq_vd_p4s(a, @ixs[0].name[0], 0);
                k = 0;
                while (ixs[0].name[k] != (byte)0) { k++; };
                sq_vd_p4s(a, @ixs[0].name[0], k);
            };
            a = sq_vd_op("Delete\0", pcur, 1, 0);
            sq_vd_p4s(a, @t[ns], nl);
            if (uq == 0) { VD_P5[a] = 2; };
            } else {
            for (j = 0; j < ti.npk; j++) { sq_vd_op("Column\0", pcur, j, cb + ncol + j); };
            if (aff1 == 1)
            {
                a = sq_vd_op("OpenWrite\0", 1, ixs[0].root, 0);
                for (j = 0; j < ixs[0].nk; j++) { if (ixs[0].coll[j] != 0 | ixs[0].desc[j] != 0 | ixs[0].isx[j] != 0 | sq_vd_inix(@wsyn, ixs[0].col[j]) >= 0) { sq_stmt_del(g); sq_seterr(st, "EXPLAIN is not available for this index collation\0"); return 1; }; };
                sq_sb_init(@kt);
                sq_sb_lit(@kt, "k(\0");
                sq_sb_int(@kt, (i64)(ixs[0].nk + ti.npk));
                for (j = 0; j < ixs[0].nk + ti.npk; j++) { sq_sb_lit(@kt, ",\0"); };
                sq_sb_lit(@kt, ")\0");
                sq_vd_p4s(a, kt.p, kt.n);
                sq_sb_free(@kt);
            };
            ldaddr = VD_N;
            if (aff1 == 1) { ldaddr = ldaddr - 1; };
            if (chgpk == 1 & uq == 0) { sq_stmt_del(g); sq_seterr(st, "EXPLAIN is not available for this UPDATE\0"); return 1; };
            isn = sq_vd_op("IsNull\0", cb + ncol, 0, 0);
            if (chgpk == 1)
            {
                for (k = 0; k < ncol; k++)
                {
                    c = 0;
                    for (j = 0; j < ti.npk; j++) { if (ti.pkc[j] == k) { c = 1; }; };
                    if (c == 1) { sq_vd_op("Column\0", pcur, VD_WORM[k], ob + k); } else { sq_vd_op("Null\0", 0, ob + k, 0); };
                };
            };
            for (k = 0; k < ncol; k++)
            {
                if (umap[k] >= 0)
                {
                    if (sq_vd_setv(g, ti, b.rc[umap[k]], cb + k) != 0) { sq_stmt_del(g); sq_seterr(st, "EXPLAIN is not available for this expression\0"); return 1; };
                }
                else { sq_vd_op("Column\0", pcur, VD_WORM[k], cb + k); if (ti.aff[k] == 4) { sq_vd_op("RealAffinity\0", cb + k, 0, 0); }; };
            };
            if (chgpk == 1)
            {
                for (k = 0; k < ncol; k++)
                {
                    c = 0;
                    for (j = 0; j < ti.npk; j++) { if (ti.pkc[j] == k & umap[k] >= 0) { c = 1; }; };
                    if (c == 0) { continue; };
                    a = sq_vd_op("HaltIfNull\0", 1299, 2, cb + k);
                    sq_vd_uhaltn(a);
                    sq_sb_init(@kt);
                    sq_sb_add(@kt, @t[ns], nl);
                    sq_sb_lit(@kt, ".\0");
                    sq_sb_add(@kt, @ti.base[ti.cs[k]], ti.cl[k]);
                    sq_vd_p4s(a, kt.p, kt.n);
                    sq_sb_free(@kt);
                    VD_P5[a] = 1;
                };
            };
            na = 0;
            for (k = 0; k < ncol; k++) { if (sq_vd_affch(ti.aff[k]) != 65) { na = k + 1; }; };
            if (na > 0)
            {
                for (k = 0; k < na; k++) { ab[k] = (byte)sq_vd_affch(ti.aff[k]); };
                a = sq_vd_op("Affinity\0", cb, na, 0);
                sq_vd_p4s(a, @ab[0], na);
            };
            prec = 1;
            nfld = 0;
            if (aff1 == 1)
            {
                nfld = ixs[0].nk + ti.npk;
                for (j = 0; j < ixs[0].nk; j++) { sq_vd_op("SCopy\0", cb + ixs[0].col[j], 2 + j, 0); };
                for (j = 0; j < ti.npk; j++) { sq_vd_op("SCopy\0", cb + ti.pkc[j], 2 + ixs[0].nk + j, 0); };
                sq_vd_op("MakeRecord\0", 2, nfld, 1);
                prec = 2 + nfld;
            };
            for (j = 0; j < ncol; j++)
            {
                c = 0 - 1;
                for (k = 0; k < ncol; k++) { if (VD_WORM[k] == j) { c = k; }; };
                sq_vd_op("SCopy\0", cb + c, prec + 1 + j, 0);
            };
            sq_vd_op("MakeRecord\0", prec + 1, ncol, prec);
            if (chgpk == 1)
            {
                ncf = sq_vd_op("NoConflict\0", pcur, 0, prec + 1);
                sq_vd_p4i(ncf, (i64)ti.npk);
                for (j = 0; j < ti.npk; j++)
                {
                    if (j < ti.npk - 1) { a = sq_vd_op("Ne\0", ob + ti.pkc[j], 0, prec + 1 + j); }
                    else { a = sq_vd_op("Eq\0", ob + ti.pkc[j], 0, prec + 1 + j); };
                    sq_vd_p4s(a, "BINARY-8\0", 8);
                    VD_P5[a] = 144;
                    cmpo[j] = a;
                };
                a = sq_vd_op("Halt\0", 1555, 2, 0);
                sq_vd_uhalt(a);
                sq_sb_init(@kt);
                for (j = 0; j < ti.npk; j++)
                {
                    if (j > 0) { sq_sb_lit(@kt, ", \0"); };
                    sq_sb_add(@kt, @t[ns], nl);
                    sq_sb_lit(@kt, ".\0");
                    sq_sb_add(@kt, @ti.base[ti.cs[ti.pkc[j]]], ti.cl[ti.pkc[j]]);
                };
                sq_vd_p4s(a, kt.p, kt.n);
                sq_sb_free(@kt);
                VD_P5[a] = 2;
                for (j = 0; j < ti.npk - 1; j++) { VD_P2[cmpo[j]] = VD_N - 1; };
                VD_P2[ncf] = VD_N;
                VD_P2[cmpo[ti.npk - 1]] = VD_N;
                nfd = sq_vd_op("NotFound\0", pcur, 0, cb + ncol);
                sq_vd_p4i(nfd, (i64)ti.npk);
            };
            if (aff1 == 1)
            {
                r0 = VD_NMEM + 1;
                for (j = 0; j < ixs[0].nk; j++) { sq_vd_op("Column\0", pcur, VD_WORM[ixs[0].col[j]], r0 + j); };
                for (j = 0; j < ti.npk; j++) { sq_vd_op("Column\0", pcur, j, r0 + ixs[0].nk + j); };
                a = sq_vd_op("IdxDelete\0", 1, r0, nfld);
                k = 0;
                while (ixs[0].name[k] != (byte)0) { k++; };
                sq_vd_p4s(a, @ixs[0].name[0], k);
            };
            if (chgpk == 1) { sq_vd_op("Delete\0", pcur, 0, 0); };
            if (aff1 == 1)
            {
                a = sq_vd_op("IdxInsert\0", 1, 1, 2);
                sq_vd_p4i(a, (i64)nfld);
            };
            a = sq_vd_op("IdxInsert\0", pcur, prec, prec + 1);
            sq_vd_p4i(a, (i64)ti.npk);
            VD_P5[a] = 3;
            if (uq == 1) { VD_P5[a] = 1; };
            };
            nxt = VD_N;
            if (winl == 1)
            {
                VD_P2[sk] = VD_N; VD_P2[chk] = VD_N; VD_P2[VD_INNL] = VD_N;
                sk = 0 - 1; chk = 0 - 1;
                sq_vd_op("Next\0", nsec + 3, VD_INTOP, 0);
                VD_P2[VD_INRW] = VD_N;
            };
            if (uq == 0 & winl == 0)
            {
                a = sq_vd_op("Next\0", pcur, body, 0);
                if (pk == 0) { VD_P5[a] = 1; };
            };
            if (rew >= 0) { VD_P2[rew] = VD_N; };
            if (sk >= 0) { VD_P2[sk] = VD_N; };
            if (chk >= 0) { VD_P2[chk] = VD_N; };
            if (isn >= 0) { VD_P2[isn] = VD_N; };
            if (nfd >= 0) { VD_P2[nfd] = VD_N; };
            if (upd == 1 & uq == 1) { VD_P2[sk] = ldaddr; VD_P2[chk] = ldaddr; };
            for (k = 0; k < VD_NJ; k++) { if (upd == 1 & uq == 1) { VD_P2[VD_JF[k]] = ldaddr; } else { VD_P2[VD_JF[k]] = nxt; }; };
            VD_IDXCUR = 0;
            if (wgz >= 0) { VD_P2[wgz] = VD_N; };
            sq_vd_op("Halt\0", 0, 0, 0);
            VD_P2[init] = VD_N;
            sq_vd_trans(st.db, 1);
            for (k = 0; k < VD_NH; k++) { sq_vd_lit(g, VD_HN[k], VD_HR[k]); };
            sq_vd_op("Goto\0", 0, 1, 0);
            sq_stmt_del(g);
            sq_vd_query(pq);
            return 0;
        };

        // loop head for a rowid range (lower and/or upper bound on the rowid) of a table without secondary indexes
        // out: 0 = Rewind, 1 = Seek, 2 = bound check, 3 = loop top; residual terms are emitted as filters
        def sq_vd_ridrange(SQ_STMT* g, SQ_BLK* b, SQ_TI* ti, int ecur, int* out) -> int
        {
            SQ_NODE* w;
            SQ_NODE* l;
            int[16] cj;
            int[16] used;
            int ncj, i, ml, mu, me, lt, kreg, tgt, sk, rew, chk, inn, inx, inbd, reg;
            inn = 0 - 1;
            ncj = 0; ml = 0 - 1; mu = 0 - 1; me = 0 - 1; sk = 0 - 1; rew = 0 - 1; chk = 0 - 1; tgt = 0 - 1;
            sq_vd_splitx(g, b.where_n, @cj[0], @ncj);
            if (ncj > 16) { return 1; };
            for (i = 0; i < ncj; i++)
            {
                used[i] = 0;
                w = @g.nodes[cj[i]];
                if (w.kind != SQN_BIN) { continue; };
                if (sq_vd_isconst(g, w.b) == false | g.nodes[w.b].kind == SQN_NULL) { continue; };
                l = @g.nodes[w.a];
                if (l.kind != SQN_COL & l.kind != SQN_ROWID) { continue; };
                if (l.kind == SQN_COL) { if (l.col != ti.ipk & l.col != ti.ncols) { continue; }; };
                if (g.nodes[w.b].kind != SQN_INT) { continue; };
                if (w.op == SQO_EQ & me < 0) { me = i; used[i] = 1; };
                if ((w.op == SQO_GT | w.op == SQO_GE) & ml < 0 & me < 0) { ml = i; used[i] = 1; };
                if ((w.op == SQO_LT | w.op == SQO_LE) & mu < 0 & me < 0) { mu = i; used[i] = 1; };
            };
            for (i = 0; i < ncj; i++)
            {
                w = @g.nodes[cj[i]];
                if (w.kind != SQN_IN) { continue; };
                if (w.op != 1 | w.blk >= 0 | w.b < 0 | w.a < 0) { continue; };
                l = @g.nodes[w.a];
                if (l.kind != SQN_ROWID & l.kind != SQN_COL) { continue; };
                if (l.kind == SQN_COL) { if (l.lvl != 0 | l.owner != g.root_blk | (l.col != ti.ipk & l.col < ti.ncols)) { continue; }; };
                inbd = 0;
                for (inx = w.b; inx >= 0; inx = g.nodes[inx].next)
                {
                    if (sq_vd_isconst(g, inx) == false | g.nodes[inx].kind == SQN_NULL) { inbd = 0 - 1000; break; };
                    inbd++;
                };
                if (inbd < 2) { return 1; };
                if (inn >= 0) { return 1; };
                inn = i; used[i] = 1;
            };
            if (inn >= 0)
            {
                if (me >= 0 | ml >= 0 | mu >= 0) { return 1; };
                VD_NMEM++;
                reg = VD_NMEM;
                sq_vd_insub(g, ti, cj[inn], 0, 1, ecur, reg);
                out[4] = 1; out[5] = VD_INTOP; out[6] = VD_INRW; out[7] = VD_INNL;
                sk = sq_vd_op("SeekRowid\0", 0, 0, reg);
                for (i = 0; i < ncj; i++)
                {
                    if (used[i] != 0) { continue; };
                    if (sq_vd_where(g, ti, cj[i]) != 0) { return 1; };
                };
                out[0] = 0 - 1; out[1] = sk; out[2] = 0 - 1; out[3] = out[5];
                return 0;
            };
            out[4] = 0;
            if (me >= 0 | (ml < 0 & mu < 0)) { return 1; };
            if (ml >= 0)
            {
                lt = sq_vd_findconst(g, g.nodes[cj[ml]].b);
                if (lt == 0)
                {
                    VD_NMEM++;
                    lt = VD_NMEM;
                    VD_HF[VD_NH] = 0; VD_HN[VD_NH] = g.nodes[cj[ml]].b; VD_HR[VD_NH] = lt; VD_HEP[VD_NH] = 0; VD_NH++;
                };
                if (g.nodes[cj[ml]].op == SQO_GT) { sk = sq_vd_op("SeekGT\0", 0, 0, lt); } else { sk = sq_vd_op("SeekGE\0", 0, 0, lt); };
            }
            else { rew = sq_vd_op("Rewind\0", 0, 0, 0); };
            if (mu >= 0)
            {
                VD_NMEM++;
                kreg = VD_NMEM;
                sq_vd_lit(g, g.nodes[cj[mu]].b, kreg);
                VD_NMEM++;
                tgt = sq_vd_op("Rowid\0", 0, VD_NMEM, 0);
                if (g.nodes[cj[mu]].op == SQO_LT) { chk = sq_vd_op("Ge\0", kreg, 0, VD_NMEM); } else { chk = sq_vd_op("Gt\0", kreg, 0, VD_NMEM); };
                VD_P5[chk] = 83;
            };
            if (tgt < 0) { tgt = VD_N; };
            for (i = 0; i < ncj; i++)
            {
                if (used[i] != 0) { continue; };
                if (sq_vd_where(g, ti, cj[i]) != 0) { return 1; };
            };
            out[0] = rew; out[1] = sk; out[2] = chk; out[3] = tgt;
            return 0;
        };

        def sq_vd_ridfind(SQ_STMT* g, SQ_TI* ti, int wn, int* cj, int* pn) -> int;

        // one equality key of a seek on another index: the constant, or NULL (with the column affinity) for IS NULL
        def sq_vd_seekkey(SQ_STMT* g, SQ_TI* ti, SQ_NODE* w, int reg) -> void
        {
            int a, ch;
            byte[2] nb;
            if (w.kind != SQN_ISNULL) { sq_vd_lit(g, w.b, reg); return; };
            sq_vd_op("Null\0", 0, reg, 0);
            ch = sq_vd_affch(ti.aff[g.nodes[w.a].col]);
            if (ch == 68) { ch = 67; };
            if (ch != 65)
            {
                nb[0] = (byte)ch; nb[1] = (byte)0;
                a = sq_vd_op("Affinity\0", reg, 1, 0);
                sq_vd_p4s(a, @nb[0], 1);
            };
        };

        // index of the RETURNING keyword that starts a clause (outside quotes), or -1
        def sq_vd_findret(byte* t, int n, int i) -> int
        {
            byte q, c;
            int k;
            q = (byte)0;
            for (k = i; k < n; k++)
            {
                c = t[k];
                if (q != (byte)0) { if (c == q) { q = (byte)0; }; continue; };
                if (c == (byte)39 | c == (byte)34 | c == (byte)96) { q = c; continue; };
                if (k > 0 & (c == (byte)114 | c == (byte)82))
                {
                    if (sq_isalpha(t[k - 1]) | sq_isdigit(t[k - 1]) | t[k - 1] == (byte)95) { continue; };
                    if (sq_vd_word(t, n, k, "returning\0") >= 0) { return k; };
                };
            };
            return 0 - 1;
        };

        // DELETE ... RETURNING on a rowid table without indexes: a RowSet pass, then delete and queue the rows in an ephemeral table
        def sq_vd_delret(SQ_STMT* st, byte* t, int n, int i, int rpos, int ns, int nl, byte** pq) -> int
        {
            SQ_STMT* g;
            SQ_STMT* g3;
            SQ_BLK* b;
            SQ_SRC* sr;
            SQ_TI* ti;
            SQ_NODE* nd;
            int a, k, j, c, nix, init, op, rew, body, nxt, ws, rid, rcopy, c0, wk, rs0, rl0, rn, res, rec, nrw, rsr, ncol, mx, fk, rwe, nk, ni;
            int[120] retc;
            int[16] cj;
            int[8] ro;
            byte[2] dnb;
            int dinl, dch, cnull, gz, one, rr, nc, sm, sp, lo, hi, tw, kreg, ureg, seek, ec, x;
            SQ_SB kt;
            SQ_NODE* w;
            SQ_IDX[12] ixs;
            ws = 0 - 1;
            tw = 0; rr = 0;
            k = sq_vd_skip(t, n, i);
            wk = k;
            if (k < rpos)
            {
                ws = sq_vd_word(t, n, k, "where\0");
                if (ws < 0) { sq_seterr(st, "EXPLAIN is not available for this DELETE\0"); return 1; };
            };
            if (ws < 0) { if (sq_vd_prep(st, "select * from \0", @t[ns], nl, (byte*)0, 0, @g) != 0) { return 1; }; }
            else { if (sq_vd_prep(st, "select * from \0", @t[ns], nl, @t[k], rpos - k, @g) != 0) { return 1; }; };
            if (g.blks[g.root_blk].nord > 0 | g.blks[g.root_blk].limit_n >= 0) { sq_stmt_del(g); sq_seterr(st, "syntax error near ORDER BY or LIMIT\0"); return 1; };
            VD_PLWOR = 1;
            a = sq_vd_plain(st, g, @t[ns], nl, @nix);
            VD_PLWOR = 0;
            if (a != 0) { sq_stmt_del(g); return 1; };
            b = g.blks[g.root_blk];
            sr = @b.src[0];
            ti = sr.ti;
            VD_DTI = ti;
            ncol = ti.ncols;
            nix = sq_idx_list(sr.sdb, sr.tbl, ti, @ixs[0], 12);
            if (ti.wor != 0 | (ti.ipk >= 0 & sq_vd_gon(701) == 1) | sq_vd_gon(698) == 1 | (nix != 0 & sq_vd_gon(699) == 1)) { sq_stmt_del(g); sq_seterr(st, "EXPLAIN is not available for DELETE RETURNING on this table\0"); return 1; };
            one = 0;
            if (b.where_n >= 0 & sq_vd_gon(702) == 0)
            {
                w = @g.nodes[b.where_n];
                if (w.kind == SQN_BIN & w.op == SQO_EQ)
                {
                    if ((g.nodes[w.a].kind == SQN_ROWID | (g.nodes[w.a].kind == SQN_COL & ((g.nodes[w.a].col == ti.ipk & ti.ipk >= 0) | g.nodes[w.a].col == ti.ncols))) & g.nodes[w.b].kind == SQN_INT) { one = 1; };
                };
            };
            cnull = 0; gz = 0 - 1;
            if (b.where_n >= 0 & one == 0 & sq_vd_gon(703) == 0)
            {
                w = @g.nodes[b.where_n];
                if (w.kind == SQN_ISNULL & w.op == 1)
                {
                    if (g.nodes[w.a].kind == SQN_ROWID | (g.nodes[w.a].kind == SQN_COL & ((g.nodes[w.a].col == ti.ipk & ti.ipk >= 0) | g.nodes[w.a].col == ti.ncols))) { cnull = 1; };
                };
            };
            if (b.where_n >= 0 & one == 0 & cnull == 0)
            {
                if (nix == 0) { if (sq_vd_hasor(g, b.where_n) == 1) { VD_ORN = 0; sq_vd_orin(g, ti, b.where_n); if (VD_ORN > 0) { if (sq_vd_plankind(g) != 1) { sq_vd_orin_undo(g); }; }; }; rr = sq_vd_plankind(g); if (rr != 0 & rr != 1) { sq_stmt_del(g); sq_seterr(st, "EXPLAIN is not available for this access path @16864\0"); return 1; }; };
                if (nix >= 1)
                {
                    tw = sq_vd_seekplan(g, b, ti, @ixs[0], nix, @cj[0], @nc, @sm, @sp, @lo, @hi);
                    if (tw != 0)
                    {
                        if ((VD_SKINL == 1 & sq_vd_gon(704) == 1) | (tw == 2 & VD_SKUQ != 0) | (tw != 2 & tw != 3 & tw != 5) | sq_vd_gon(700) == 1) { sq_stmt_del(g); sq_seterr(st, "EXPLAIN is not available for this access path @16870\0"); return 1; };
                    }
                    else { if (sq_vd_hasor(g, b.where_n) == 1) { VD_ORN = 0; sq_vd_orin(g, ti, b.where_n); if (VD_ORN > 0) { if (sq_vd_plankind(g) != 1) { sq_vd_orin_undo(g); }; }; }; rr = sq_vd_plankind(g); if (rr != 0 & rr != 1) { sq_stmt_del(g); sq_seterr(st, "EXPLAIN is not available for this access path @16872\0"); return 1; }; };
                };
            };
            if (b.where_n >= 0 & one == 0 & cnull == 0 & tw == 0) { if (sq_vd_orix(g, ti, @ixs[0], nix, b.where_n, 0) == 1) { sq_stmt_del(g); sq_seterr(st, "EXPLAIN is not available for this access path @16875\0"); return 1; }; };
            rn = 0;
            i = sq_vd_skip(t, n, rpos + 9);
            while (i < n)
            {
                if (t[i] == (byte)42) { for (k = 0; k < ncol; k++) { retc[rn] = k; rn++; }; i++; }
                else
