            if (t[i] != (byte)40) { if (sq_vd_gon(484) == 1) { sq_seterr(st, "EXPLAIN is not available for this CREATE TABLE #484\0"); return 1; }; };
            if (ifn == 1) { if (sq_vd_have(st, t, ns, nl, 0) == 1) { return sq_vd_noop(st, 1, pq); }; };
            if (sq_obj_exists(st.db, @t[ns], nl) != 0) { if (sq_vd_gon(485) == 1) { sq_seterr(st, "EXPLAIN is not available for this CREATE TABLE #485\0"); return 1; }; };
            sq_sb_init(@sb);
