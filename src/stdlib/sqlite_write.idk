            if (sq_vd_prep(st, "select \0", (byte*)0, 0, @t[i], n - i, @g2) != 0) { sq_stmt_del(g1); return 1; };
            b2 = g2.blks[g2.root_blk];
            if (b2.nsrc != 1 | b2.nres != nv | b2.cnext >= 0 | b2.distinct != 0 | b2.ngrp != 0 | b2.having >= 0 | b2.nord > 0 | b2.limit_n >= 0 | b2.has_agg != 0 | b2.nwin != 0 | b2.ncte != 0)
            {
