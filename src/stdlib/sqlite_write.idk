            {
                if (st.db.schema[j].kind == 1) { if (sq_vd_nameeq(st.db.schema[j].name, "sqlite_sequence\0", 0, 15)) { sq = 1; sqroot = st.db.schema[j].rootpage; }; };
            };
            da = 18 * sq; dr = 5 * sq; dc = 2 * sq;
            if (nlen >= 7)
            {
                if ((t[nsx] | (byte)32) == (byte)115 & (t[nsx + 1] | (byte)32) == (byte)113 & (t[nsx + 2] | (byte)32) == (byte)108 & (t[nsx + 3] | (byte)32) == (byte)105 & (t[nsx + 4] | (byte)32) == (byte)116 & (t[nsx + 5] | (byte)32) == (byte)101 & t[nsx + 6] == (byte)95) { if (sq_vd_gon(531) == 1) { sq_seterr(st, "EXPLAIN is not available for this ALTER TABLE #531\0"); return 1; }; };
            };
            on = st.db.schema[found].name;
            ol = sq_cstrlen(on);
