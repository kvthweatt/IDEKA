                k = 0;
                for (j = 0; j < n; j++) { if (ix.col[j] == g.nodes[b.rc[a]].col) { k = 1; }; };
                if (k == 0) { return 0; };
                for (j = 0; j < a; j++) { if (g.nodes[b.rc[j]].col == g.nodes[b.rc[a]].col) { return 0; }; };
            };
            return 1;
        };

