                hv = @g.nodes[hts[ht3]];
                if (hv.kind != SQN_BIN) { if (sq_vd_gon(192) == 1) { sq_seterr(st, "EXPLAIN is not available for this HAVING #192\0"); return 1; }; };
                hn = (byte*)0;
                if (hv.op == SQO_EQ) { hn = "Ne\0"; };
                if (hv.op == SQO_NE) { hn = "Eq\0"; };
                if (hv.op == SQO_LT) { hn = "Ge\0"; };
                if (hv.op == SQO_LE) { hn = "Gt\0"; };
                if (hv.op == SQO_GT) { hn = "Le\0"; };
                if (hv.op == SQO_GE) { hn = "Lt\0"; };
                if ((u64)hn == (u64)0) { if (sq_vd_gon(193) == 1) { sq_seterr(st, "EXPLAIN is not available for this HAVING #193\0"); return 1; }; };
                if (g.nodes[hv.a].kind != SQN_FUNC | sq_vd_isconst(g, hv.b) == false) { if (sq_vd_gon(194) == 1) { sq_seterr(st, "EXPLAIN is not available for this HAVING #194\0"); return 1; }; };
                if (g.nodes[hv.b].kind == SQN_NULL) { if (sq_vd_gon(195) == 1) { sq_seterr(st, "EXPLAIN is not available for this HAVING #195\0"); return 1; }; };
                hf = sq_func_id(@g.sql[g.nodes[hv.a].s], g.nodes[hv.a].sl, (int)g.nodes[hv.a].iv);
                hj = 0 - 1;
                for (j = 0; j < nacc; j++)
                {
                    i = first[j];
                    nd = @g.nodes[b.rc[i]];
                    if (fid[i] != hf) { continue; };
                    if (g.nodes[hv.a].op != nd.op) { continue; };
                    if (nd.op != 2) { if (g.nodes[g.nodes[hv.a].a].col != g.nodes[nd.a].col) { continue; }; };
                    hj = j;
                };
                if (hj < 0) { if (sq_vd_gon(196) == 1) { sq_seterr(st, "EXPLAIN is not available for this HAVING #196\0"); return 1; }; };
                if (ixm == 1 & VD_NMEM == aggbase + nac + nacc - 1 & ht3 == 0 & (b.where_n < 0 | sq_vd_findconst(g, hv.b) == 0)) { VD_NMEM++; };
                if (sq_vd_operand(g, ti, hv.b, @hr, @ht) != 0) { if (sq_vd_gon(197) == 1) { sq_seterr(st, "EXPLAIN is not available for this HAVING #197\0"); return 1; }; };
                hk = sq_vd_op(hn, hr, outa + 1, aggbase + nac + hj);
                VD_P5[hk] = 80;
            };
            if (offm == 1 & osrt == 0) { hk = sq_vd_op("IfPos\0", 2, rtn, 1); };
            rbase = VD_NMEM + 1;
            if (osrt != 0) { VD_NMEM = VD_NMEM + 1 + n + 2; } else { VD_NMEM = VD_NMEM + n; };
            for (i = 0; i < n; i++)
            {
                if (fid[i] == 0) { src[i] = aggbase + iacol[i]; } else { src[i] = aggbase + nac + acc[i]; };
            };
            if (osrt == 2)
            {
                // top N: an index holding the best rows seen, dropped from the worst end
                kK = rbase; kRec = rbase + 2 + n;
                sq_vd_op("Copy\0", src[oi], kK, 0);
                sq_vd_op("Sequence\0", 1, kK + 1, 0);
                kLoop = sq_vd_op("IfNotZero\0", ro, 0, 0);
                sq_vd_op("Last\0", 1, 0, 0);
                kHalt = sq_vd_op("IdxLE\0", 1, 0, kK);
                sq_vd_p4i(kHalt, (i64)1);
                sq_vd_op("Delete\0", 1, 0, 0);
                VD_P2[kLoop] = VD_N;
                dp = 0;
                for (i = 0; i < n; i++)
                {
                    if (i == oi) { continue; };
                    run = 0;
                    while (i + run + 1 < n) { if (i + run + 1 == oi) { break; }; if (src[i + run + 1] == src[i + run] + 1) { run++; } else { break; }; };
                    sq_vd_op("Copy\0", src[i], kK + 2 + dp, run);
                    dp = dp + run + 1;
                    i = i + run;
                };
                nfld = n + 1;
                sq_vd_op("MakeRecord\0", kK, nfld, kRec);
                ht = sq_vd_op("IdxInsert\0", 1, kRec, kK);
                sq_vd_p4i(ht, (i64)nfld);
                VD_P2[kHalt] = VD_N;
                sq_vd_op("Return\0", 3 + ro, 0, 0);
            }
            else if (osrt == 1)
            {
                // the sorter record: the ORDER BY key, then the result columns the key does not repeat
                kK = rbase; kRec = rbase + 1 + n; kPrec = kRec + 1;
                // data columns, packed in result order without the key column
                dp = 0;
                for (i = 0; i < n; i++)
                {
                    if (i == oi) { continue; };
                    run = 0;
                    while (i + run + 1 < n) { if (i + run + 1 == oi) { break; }; if (src[i + run + 1] == src[i + run] + 1) { run++; } else { break; }; };
                    sq_vd_op("Copy\0", src[i], kK + 1 + dp, run);
                    dp = dp + run + 1;
                    i = i + run;
                };
                sq_vd_op("Copy\0", src[oi], kK, 0);
                nfld = n;
                sq_vd_op("MakeRecord\0", kK, nfld, kRec);
                ht = sq_vd_op("SorterInsert\0", 1, kRec, kK);
                sq_vd_p4i(ht, (i64)nfld);
                sq_vd_op("Return\0", 3 + ro, 0, 0);
            }
            else
            {
            i = 0;
            while (i < n)
            {
                run = 0;
                while (i + run + 1 < n) { if (src[i + run + 1] == src[i + run] + 1) { run++; } else { break; }; };
                sq_vd_op("Copy\0", src[i], rbase + i, run);
                i = i + run + 1;
            };
            sq_vd_op("ResultRow\0", rbase, n, 0);
            if (limm == 1) { dj = sq_vd_op("DecrJumpZero\0", 1, abta, 0); };
            sq_vd_op("Return\0", 3 + ro, 0, 0);
            };
            reta = VD_N;
            sq_vd_op("Null\0", 0, aggbase, aggbase + nac + nacc - 1);
            sq_vd_op("Integer\0", 0, 1 + ro, 0);
            sq_vd_op("Return\0", 4 + ro, 0, 0);
            k = VD_N;
            if (osrt == 2)
            {
                kHalt = sq_vd_op("Sort\0", 1, 0, 0);
                kLoop = VD_N;
                if (offm == 1)
                {
                    ht = sq_vd_op("IfPos\0", 2, 0, 1);
                    sq_vd_op("AddImm\0", 1, 0 - 1, 0);
                };
                for (i = n - 1; i >= 0; i--)
                {
                    if (i == oi) { sq_vd_op("Column\0", 1, 0, kK + 2 + i); }
                    else
                    {
                        dp = i;
                        if (i > oi) { dp = i - 1; };
                        sq_vd_op("Column\0", 1, 2 + dp, kK + 2 + i);
                    };
                };
                sq_vd_op("ResultRow\0", kK + 2, n, 0);
                hk = sq_vd_op("Next\0", 1, kLoop, 0);
                if (offm == 1) { VD_P2[ht] = hk; };
                VD_P2[kHalt] = VD_N;
            };
            if (osrt == 1)
            {
                sq_vd_op("OpenPseudo\0", 4, kPrec, b.nres + b.nord + 1);
                kHalt = sq_vd_op("SorterSort\0", 1, 0, 0);
                kLoop = sq_vd_op("SorterData\0", 1, kPrec, 4);
                dp = n - 1;
                for (i = n - 1; i >= 0; i--)
                {
                    if (i == oi) { sq_vd_op("Column\0", 4, 0, kK + 1 + i); }
                    else
                    {
                        dp = i;
                        if (i > oi) { dp = i - 1; };
                        sq_vd_op("Column\0", 4, 1 + dp, kK + 1 + i);
                    };
                };
                sq_vd_op("ResultRow\0", kK + 1, n, 0);
                ht = sq_vd_op("SorterNext\0", 1, kLoop, 0);
                VD_P2[kHalt] = VD_N;
            };
            sq_vd_op("Halt\0", 0, 0, 0);
            VD_P2[init] = VD_N;
            if (ixm == 1) { VD_P2[rew] = gf; if (gsk == 2) { VD_P2[gigt] = gf; }; } else { VD_P2[ss] = k; };
            VD_P2[ip] = k;
            VD_P2[a] = k;
            VD_P2[reseta] = reta;
            VD_P2[g2] = reta;
            VD_P2[g1] = outa;
            VD_P2[gf] = outa;
            sq_vd_trans(g.db, 0);
            sq_vd_op("Null\0", 0, 5 + ro, 4 + ng + ro);
            for (k = 0; k < VD_NH; k++) { sq_vd_lit(g, VD_HN[k], VD_HR[k]); };
            sq_vd_op("Goto\0", 0, 1, 0);
            sq_sb_free(@kt);
            return 0;
        };

        // the single source a WHERE term reads: its index, -1 for none, -2 when it reads several
        def sq_vd_termsrc(SQ_STMT* g, int ni) -> int
        {
            SQ_NODE* nd = @g.nodes[ni];
            int x, y;
            if (nd.kind == SQN_COL) { return nd.src; };
            if (nd.kind == SQN_INT | nd.kind == SQN_STR | nd.kind == SQN_REAL | nd.kind == SQN_NULL) { return 0 - 1; };
            if (nd.kind == SQN_ISNULL) { return sq_vd_termsrc(g, nd.a); };
            if (nd.kind == SQN_BIN)
            {
                x = sq_vd_termsrc(g, nd.a);
                y = sq_vd_termsrc(g, nd.b);
                if (x == 0 - 2 | y == 0 - 2) { return 0 - 2; };
                if (x < 0) { return y; };
                if (y < 0) { return x; };
                if (x != y) { return 0 - 2; };
                return x;
            };
            if (nd.kind == SQN_BETWEEN)
            {
                x = sq_vd_termsrc(g, nd.a);
                y = sq_vd_termsrc(g, nd.b);
                if (y != 0 - 1 & y != 0 - 2) { return 0 - 2; };
                y = sq_vd_termsrc(g, nd.c);
                if (y != 0 - 1) { return 0 - 2; };
                return x;
            };
            return 0 - 2;
        };

        global int JA_NACC = 0, JA_SHIFT = 0;
        global int[16] JA_FID, JA_ACC, JA_FIRST;

        def sq_vd_has(byte* t, int n, byte* w) -> int;

        // number of indexes on a source table, 0 when none
        def sq_vd_nidx(SQ_SRC* sr) -> int
        {
            SQ_IDX[12] ixs;
            return sq_idx_list(sr.sdb, sr.tbl, sr.ti, @ixs[0], 12);
        };

        // checks the planner's choice for a join against the shape being coded: mode 0 plain scans, 1 rowid seeks, 2 also
        // automatic indexes. Returns 0 when the plan reads the tables in the given order through those paths only
        def sq_vd_planchk(SQ_STMT* g, int mode, int* ord, int ns) -> int
        {
            SQ_BLK* b = g.blks[g.root_blk];
            SQ_SB out;
            SQ_SB nm;
            int i, j, k, e, st0, nl, good, pos, okn;
            byte* t;
            int tn;
            sq_sb_init(@out);
            sq_eqp_block(g, g.root_blk, 0, @out);
            t = out.p; tn = out.n;
            good = 1; pos = 0;
            i = 0;
            while (i < tn)
            {
                // a line is  id|parent|detail
                st0 = i;
                while (i < tn & t[i] != (byte)10) { i++; };
                e = i;
                i++;
                k = st0; j = 0;
                while (k < e & j < 2) { if (t[k] == (byte)124) { j++; }; k++; };
                nl = e - k;
                if (nl >= 5 & t[k] == (byte)83 & t[k + 1] == (byte)67 & t[k + 2] == (byte)65 & t[k + 3] == (byte)78 & t[k + 4] == (byte)32)
                {
                    if (sq_vd_has(@t[k], nl, " USING \0") == 1) { good = 0; };
                    pos++;
                    continue;
                };
                if (nl >= 7 & t[k] == (byte)83 & t[k + 1] == (byte)69 & t[k + 2] == (byte)65 & t[k + 3] == (byte)82 & t[k + 4] == (byte)67 & t[k + 5] == (byte)72 & t[k + 6] == (byte)32)
                {
                    if (sq_vd_has(@t[k], nl, "USING INTEGER PRIMARY KEY (rowid=?)\0") == 1 & mode >= 1) { }
                    else
                    {
                        if (mode == 2 & sq_vd_has(@t[k], nl, "USING AUTOMATIC\0") == 1) { }
                        else { good = 0; };
                    };
                    pos++;
                    continue;
                };
                if (nl >= 12 & t[k] == (byte)66 & t[k + 1] == (byte)76 & t[k + 2] == (byte)79 & t[k + 3] == (byte)79 & t[k + 4] == (byte)77) { if (mode != 2) { good = 0; }; continue; };
                if (nl >= 14 & t[k] == (byte)85 & t[k + 1] == (byte)83 & t[k + 2] == (byte)69 & t[k + 3] == (byte)32 & t[k + 4] == (byte)84 & t[k + 5] == (byte)69 & t[k + 6] == (byte)77 & t[k + 7] == (byte)80) { continue; };
                good = 0;
            };
            sq_sb_free(@out);
            if (pos != ns) { good = 0; };
            if (good == 1) { return 0; };
            return 1;
        };

        // true when the text of n bytes contains the zero-terminated word
        def sq_vd_has(byte* t, int n, byte* w) -> int
        {
            int i, j, wl;
            wl = sq_cstrlen(w);
            for (i = 0; i + wl <= n; i++)
            {
                j = 0;
                while (j < wl) { if (t[i + j] != w[j]) { break; }; j++; };
                if (j == wl) { return 1; };
            };
            return 0;
        };

        // aggregates over a join: validates the select list and works out the shared accumulators
        def sq_vd_jagg_prep(SQ_STMT* st, SQ_STMT* g, SQ_BLK* b) -> int
        {
            SQ_NODE* nd;
            SQ_NODE* ar;
            SQ_NODE* o;
            int i, j, n, same, nixg;
            SQ_IDX[12] ixg;
            if (b.nres != b.nagg | b.nres > 15 | b.nres < 1) { if (sq_vd_gon(198) == 1) { sq_seterr(st, "EXPLAIN is not available for this aggregate query #198\0"); return 1; }; };
            n = b.nres;
            for (i = 0; i < n; i++)
            {
                nd = @g.nodes[b.rc[i]];
                if (nd.kind != SQN_FUNC) { if (sq_vd_gon(199) == 1) { sq_seterr(st, "EXPLAIN is not available for this aggregate query #199\0"); return 1; }; };
                JA_FID[i] = sq_func_id(@g.sql[nd.s], nd.sl, (int)nd.iv);
                if (JA_FID[i] < 100 | JA_FID[i] > 105 | nd.op == 1) { if (sq_vd_gon(200) == 1) { sq_seterr(st, "EXPLAIN is not available for this aggregate query #200\0"); return 1; }; };
                if (nd.op == 2)
                {
                    if (JA_FID[i] != 100) { if (sq_vd_gon(201) == 1) { sq_seterr(st, "EXPLAIN is not available for this aggregate query #201\0"); return 1; }; };
                }
                else
                {
                    if (nd.iv != (i64)1 | nd.next >= 0) { if (sq_vd_gon(202) == 1) { sq_seterr(st, "EXPLAIN is not available for this aggregate query #202\0"); return 1; }; };
                    ar = @g.nodes[nd.a];
                    if (ar.kind != SQN_COL | ar.src < 0 | ar.src > 1 | ar.col < 0) { if (sq_vd_gon(203) == 1) { sq_seterr(st, "EXPLAIN is not available for this aggregate expression #203\0"); return 1; }; };
                    if (ar.col >= b.src[ar.src].ti.ncols | ar.col == b.src[ar.src].ti.ipk) { if (sq_vd_gon(204) == 1) { sq_seterr(st, "EXPLAIN is not available for this aggregate expression #204\0"); return 1; }; };
                    if (b.src[ar.src].ti.coll[ar.col] != 0) { if (sq_vd_gon(205) == 1) { sq_seterr(st, "EXPLAIN is not available for this collation #205\0"); return 1; }; };
                    if (b.src[ar.src].kind == 1 & b.src[ar.src].tbl >= 0)
                    {
                        nixg = sq_idx_list(b.src[ar.src].sdb, b.src[ar.src].tbl, b.src[ar.src].ti, @ixg[0], 12);
                        for (j = 0; j < nixg; j++)
                        {
                            if (ixg[j].col[0] == ar.col & ixg[j].partial == 0) { if (sq_vd_gon(776) == 1) { sq_seterr(st, "EXPLAIN is not available for this aggregate query #776\0"); return 1; }; };
                        };
                    };
                };
            };
            JA_NACC = 0; JA_SHIFT = 0;
            for (i = 0; i < n; i++)
            {
                nd = @g.nodes[b.rc[i]];
                JA_ACC[i] = 0 - 1;
                for (j = 0; j < JA_NACC; j++)
                {
                    o = @g.nodes[b.rc[JA_FIRST[j]]];
                    same = 0;
                    if (JA_FID[JA_FIRST[j]] == JA_FID[i] & o.op == nd.op)
                    {
                        if (nd.op == 2) { same = 1; }
                        else { if (g.nodes[o.a].col == g.nodes[nd.a].col & g.nodes[o.a].src == g.nodes[nd.a].src) { same = 1; }; };
                    };
                    if (same == 1) { JA_ACC[i] = j; break; };
                };
                if (JA_ACC[i] < 0) { JA_ACC[i] = JA_NACC; JA_FIRST[JA_NACC] = i; JA_NACC++; };
            };
            for (i = 0; i < n; i++)
            {
                nd = @g.nodes[b.rc[i]];
                if (nd.op == 2) { continue; };
                same = 0;
                for (j = 0; j < i; j++)
                {
                    o = @g.nodes[b.rc[j]];
                    if (o.op != 2) { if (g.nodes[o.a].col == g.nodes[nd.a].col & g.nodes[o.a].src == g.nodes[nd.a].src) { same = 1; }; };
                };
                if (same == 0) { JA_SHIFT++; };
            };
            JA_SHIFT--;
            return 0;
        };

        def sq_vd_pointat(SQ_BLK* b, int src, SQ_IDX* ixa) -> void;

        // one AggStep per accumulator; the argument column is read from the cursor of its table
        def sq_vd_jagg_step(SQ_STMT* st, SQ_STMT* g, SQ_BLK* b, int aidx, int aouter) -> int
        {
            SQ_NODE* nd;
            SQ_NODE* ar;
            int j, i, a, reg;
            for (j = 0; j < JA_NACC; j++)
            {
                i = JA_FIRST[j];
                nd = @g.nodes[b.rc[i]];
                reg = 0;
                if (nd.op != 2)
                {
                    ar = @g.nodes[nd.a];
                    reg = sq_vd_getreg();
                    if (aidx == 1) { VD_COLCUR = aouter; } else { sq_vd_pointat(b, ar.src, (SQ_IDX*)0); };
                    if (sq_vd_expr(g, b.src[ar.src].ti, nd.a, reg) != 0) { if (sq_vd_gon(206) == 1) { sq_seterr(st, "EXPLAIN is not available for this aggregate expression #206\0"); return 1; }; };
                    if (JA_FID[i] == 104 | JA_FID[i] == 105)
                    {
                        a = sq_vd_op("CollSeq\0", 0, 0, 0);
                        sq_vd_p4s(a, "BINARY-8\0", 8);
                    };
                };
                a = sq_vd_op("AggStep\0", 0, reg, j + 2 + JA_SHIFT);
                if (JA_FID[i] == 100) { if (nd.op == 2) { sq_vd_p4s(a, "count(0)\0", 8); } else { sq_vd_p4s(a, "count(1)\0", 8); }; };
                if (JA_FID[i] == 101) { sq_vd_p4s(a, "sum(1)\0", 6); };
                if (JA_FID[i] == 102) { sq_vd_p4s(a, "total(1)\0", 8); };
                if (JA_FID[i] == 103) { sq_vd_p4s(a, "avg(1)\0", 6); };
                if (JA_FID[i] == 104) { sq_vd_p4s(a, "min(1)\0", 6); };
                if (JA_FID[i] == 105) { sq_vd_p4s(a, "max(1)\0", 6); };
                if (nd.op != 2) { VD_P5[a] = 1; sq_vd_putreg(reg); };
            };
            return 0;
        };

        def sq_vd_jagg_final(SQ_STMT* g, SQ_BLK* b) -> void
        {
            SQ_NODE* nd;
            int j, i, a, rbase, run, n;
            n = b.nres;
            for (j = 0; j < JA_NACC; j++)
            {
                i = JA_FIRST[j];
                nd = @g.nodes[b.rc[i]];
                a = sq_vd_op("AggFinal\0", j + 2 + JA_SHIFT, 0, 0);
                if (nd.op != 2) { VD_P2[a] = 1; };
                if (JA_FID[i] == 100) { if (nd.op == 2) { sq_vd_p4s(a, "count(0)\0", 8); } else { sq_vd_p4s(a, "count(1)\0", 8); }; };
                if (JA_FID[i] == 101) { sq_vd_p4s(a, "sum(1)\0", 6); };
                if (JA_FID[i] == 102) { sq_vd_p4s(a, "total(1)\0", 8); };
                if (JA_FID[i] == 103) { sq_vd_p4s(a, "avg(1)\0", 6); };
                if (JA_FID[i] == 104) { sq_vd_p4s(a, "min(1)\0", 6); };
                if (JA_FID[i] == 105) { sq_vd_p4s(a, "max(1)\0", 6); };
            };
            rbase = VD_NMEM + 1;
            i = 0;
            while (i < n)
            {
                run = 0;
                while (i + run + 1 < n) { if (JA_ACC[i + run + 1] == JA_ACC[i + run] + 1) { run++; } else { break; }; };
                sq_vd_op("Copy\0", JA_ACC[i] + 2 + JA_SHIFT, rbase + i, run);
                i = i + run + 1;
            };
            sq_vd_op("ResultRow\0", rbase, n, 0);
        };

        // two tables joined without a join constraint: nested full scans, filters placed on the loop that reads their table
        global int VD_JXS = 0;
        def sq_vd_rdc(SQ_BLK* b, int src, int col, int r) -> void;

        // a comparison between columns of the two joined tables, jumping to the next row of the inner loop when false
        def sq_vd_colcmp(SQ_STMT* g, SQ_BLK* b, int ni) -> int
        {
            SQ_NODE* nd = @g.nodes[ni];
            SQ_NODE* l;
            SQ_NODE* r;
            SQ_TI* lt;
            SQ_TI* rt;
            int r1, r2, a, aff, cl;
            byte* nm;
            nm = (byte*)0;
            if (nd.kind != SQN_BIN) { return 1; };
            if (nd.op == SQO_EQ) { nm = "Ne\0"; };
            if (nd.op == SQO_NE) { nm = "Eq\0"; };
            if (nd.op == SQO_LT) { nm = "Ge\0"; };
            if (nd.op == SQO_LE) { nm = "Gt\0"; };
            if (nd.op == SQO_GT) { nm = "Le\0"; };
            if (nd.op == SQO_GE) { nm = "Lt\0"; };
            if ((u64)nm == (u64)0) { return 1; };
            l = @g.nodes[nd.a]; r = @g.nodes[nd.b];
            if (l.kind != SQN_COL | r.kind != SQN_COL) { return 1; };
            if (l.src < 0 | l.src >= b.nsrc | r.src < 0 | r.src >= b.nsrc | l.src == r.src) { return 1; };
            lt = b.src[l.src].ti; rt = b.src[r.src].ti;
            if (l.col < 0 | r.col < 0 | l.col >= lt.ncols | r.col >= rt.ncols) { return 1; };
            r1 = sq_vd_getreg();
            sq_vd_rdc(b, l.src, l.col, r1);
            r2 = sq_vd_getreg();
            sq_vd_rdc(b, r.src, r.col, r2);
            aff = 0;
            if (l.col == lt.ipk) { aff = 3; } else { aff = lt.aff[l.col]; };
            cl = 0;
            if (l.col != lt.ipk) { cl = lt.coll[l.col]; };
            if (cl == 0 & r.col != rt.ipk) { cl = rt.coll[r.col]; };
            if (r.col == rt.ipk) { if (aff < 2) { aff = 3; }; } else { if (rt.aff[r.col] >= 2 | aff >= 2) { aff = 2; } else { aff = 0; }; };
            if (l.col == lt.ipk & r.col == rt.ipk) { aff = 2; };
            if (aff >= 2) { aff = 2; };
            a = sq_vd_op(nm, r2, 0, r1);
            if (cl == 0) { sq_vd_p4s(a, "BINARY-8\0", 8); };
            if (cl == 1) { sq_vd_p4s(a, "NOCASE-8\0", 8); };
            if (cl == 2) { sq_vd_p4s(a, "RTRIM-8\0", 7); };
            if (cl > 2) { return 1; };
            VD_P5[a] = 16 + sq_vd_affch(aff);
            if (VD_NJ < 32) { VD_JF[VD_NJ] = a; VD_NJ++; };
            return 0;
        };

        // turns the USING / NATURAL columns of a joined source into the equivalent ON terms
        def sq_vd_usingon(SQ_STMT* g, SQ_BLK* b, SQ_SRC* sr, int j) -> int
        {
            int u, l, r, t, acc;
            SQ_SRC* ol;
            acc = 0 - 1;
            for (u = 0; u < sr.nusing; u++)
            {
                ol = @b.src[sr.uls[u]];
                l = sq_newnode(g, SQN_COL);
                r = sq_newnode(g, SQN_COL);
                if (l < 0 | r < 0) { return 1; };
                g.nodes[l].owner = g.root_blk; g.nodes[l].lvl = 0; g.nodes[r].owner = g.root_blk; g.nodes[r].lvl = 0;
                g.nodes[l].src = sr.uls[u]; g.nodes[l].col = sr.ulc[u]; g.nodes[l].aff = ol.ti.aff[sr.ulc[u]]; g.nodes[l].coll = ol.ti.coll[sr.ulc[u]];
                g.nodes[r].src = j; g.nodes[r].col = sr.urc[u]; g.nodes[r].aff = sr.ti.aff[sr.urc[u]]; g.nodes[r].coll = sr.ti.coll[sr.urc[u]];
                t = sq_mkbin_raw(g, SQO_EQ, l, r);
                if (t < 0) { return 1; };
                if (acc < 0) { acc = t; } else { acc = sq_mkbin_raw(g, SQO_AND, acc, t); };
            };
            if (sr.on >= 0 & acc >= 0) { acc = sq_mkbin_raw(g, SQO_AND, sr.on, acc); };
            if (acc >= 0) { sr.on = acc; };
            sr.nusing = 0; sr.natural = 0;
            return 0;
        };

        // two tables where the planner reads the second one through an index lookup keyed by the first (or by constants):
        // returns 2 when the block is not of that shape so the other join generators can try it
        def sq_vd_joinix(SQ_STMT* st, SQ_STMT* g) -> int
        {
            SQ_BLK* b = g.blks[g.root_blk];
            SQ_EQC* c;
            SQ_EQP[2] pl;
            SQ_EQP ptmp;
            SQ_IDX ix;
            SQ_SRC* so;
            SQ_SRC* si;
            SQ_NODE* nd;
            SQ_NODE* ln;
            SQ_NODE* rn;
            SQ_SB kt;
            int[24] cj;
            int[24] role;
            int[24] used;
            int[8] kn;
            int[8] kjmp;
            int[24] fj;
            int[2] order;
            int[2] maxc;
            int ncj, onfrom, i, j, k, n, o, in2, left, init, a, cost0, cost1, rewo, lflag, lint, igt, nxti, nxto, ifpos, base, nkeys, k0, jlo, jhi, nfi, ns, hasuniq, cov, x, p5;
            double bc, cc, lp;
            if (b.nsrc != 2 | b.cnext >= 0 | b.ngrp != 0 | b.having >= 0 | b.nwin != 0 | b.ncte != 0 | b.has_agg != 0 | b.distinct != 0 | b.nord > 0 | b.limit_n >= 0) { return 2; };
            if (b.nres < 1 | b.nres > 30) { return 2; };
            so = @b.src[0]; si = @b.src[1];
            if (so.kind != 1 | si.kind != 1 | (u64)so.ti == (u64)0 | (u64)si.ti == (u64)0 | so.on >= 0) { return 2; };
            if (so.ti.wor != 0 | si.ti.wor != 0 | so.root == si.root | so.tbl < 0 | si.tbl < 0) { return 2; };
            if (si.jt != 1 & si.jt != 2 & si.jt != 3) { return 2; };
            if (so.idxby != 0 | si.idxby != 0) { return 2; };
            left = 0;
            if (si.jt == 2) { left = 1; };
            c = (SQ_EQC*)fmalloc((u64)(sizeof(SQ_EQC) / 8 + 64));
            if ((u64)c == (u64)0) { return 2; };
            c.g = g; c.b = b; c.bi = g.root_blk; c.nt = 0; c.nsrc = 2;
            sq_eqp_need(c);
            sq_eqp_term(c, b.where_n);
            for (j = 0; j < 2; j++)
            {
                c.nix[j] = 0;
                if (b.src[j].on >= 0) { sq_eqp_term(c, b.src[j].on); };
                c.nix[j] = 0;
                if (b.src[j].tbl >= 0) { c.nix[j] = sq_idx_list(b.src[j].sdb, b.src[j].tbl, b.src[j].ti, @c.ixs[j * 12], 12); };
            };
            order[0] = 0; order[1] = 1;
            if (left == 0)
            {
                sq_eqp_plan(c, 0, 0, @ptmp); cc = ptmp.cost + ptmp.setup; lp = ptmp.rows;
                sq_eqp_plan(c, 1, 1, @ptmp); bc = cc + lp * ptmp.cost + ptmp.setup;
                sq_eqp_plan(c, 1, 0, @ptmp); cc = ptmp.cost + ptmp.setup; lp = ptmp.rows;
                sq_eqp_plan(c, 0, 2, @ptmp); cc = cc + lp * ptmp.cost + ptmp.setup;
                if (cc < bc * 0.9999) { order[0] = 1; order[1] = 0; };
            };
            o = order[0]; in2 = order[1];
            sq_eqp_plan(c, o, 0, @pl[0]);
            sq_eqp_plan(c, in2, 1 << o, @pl[1]);
            if (pl[0].kind != 0 | pl[1].kind != 2 | pl[1].neq < 1 | pl[1].lo != 0 | pl[1].hi != 0 | pl[1].ridq != 0)
            {
                ffree((u64)c); return 2;
            };
            if (sq_eqp_covix(c, o) >= 0) { ffree((u64)c); return 2; };
            ix = c.ixs[in2 * 12 + pl[1].ix];
            cov = pl[1].cov;
            ffree((u64)c);
            if (ix.partial != 0) { return 2; };
            nkeys = pl[1].neq;
            for (i = 0; i < ix.nk; i++) { if (ix.isx[i] != 0 | ix.coll[i] != 0) { return 2; }; };
            so = @b.src[o]; si = @b.src[in2];
            // conjuncts: the WHERE terms first, then the ON terms
            ncj = 0;
            if (b.where_n >= 0) { sq_vd_split(g, b.where_n, @cj[0], @ncj); };
            onfrom = ncj;
            if (b.src[1].on >= 0) { sq_vd_split(g, b.src[1].on, @cj[0], @ncj); };
            if (ncj > 20) { return 2; };
            for (i = 0; i < ncj; i++) { used[i] = 0; role[i] = 0; };
            // equality terms for the leading index columns
            for (k = 0; k < nkeys; k++)
            {
                kn[k] = 0 - 1;
                for (i = 0; i < ncj; i++)
                {
                    if (used[i] != 0) { continue; };
                    nd = @g.nodes[cj[i]];
                    if (nd.kind != SQN_BIN | nd.op != SQO_EQ) { continue; };
                    ln = @g.nodes[nd.a]; rn = @g.nodes[nd.b];
                    x = 0 - 1;
                    if (ln.kind == SQN_COL & ln.lvl == 0 & ln.src == in2 & ln.col == ix.col[k]) { x = nd.b; };
                    if (x < 0 & rn.kind == SQN_COL & rn.lvl == 0 & rn.src == in2 & rn.col == ix.col[k]) { x = nd.a; };
                    if (x < 0) { continue; };
                    j = sq_vd_termsrc(g, x);
                    if (j != o & j != 0 - 1) { continue; };
                    if (left == 1 & i >= onfrom) { } else { if (left == 1) { continue; }; };
                    kn[k] = x; used[i] = 1;
                    break;
                };
                if (kn[k] < 0) { return 2; };
            };
            ns = 0;
            for (i = 0; i < ncj; i++)
            {
                if (used[i] != 0) { continue; };
                j = sq_vd_termsrc(g, cj[i]);
                if (j == o) { role[i] = 1; if (left == 1 & i >= onfrom) { return 2; }; }
                else
                {
                    if (j == in2) { role[i] = 2; if (left == 1 & i < onfrom) { return 2; }; }
                    else
                    {
                        if (j != 0 - 2) { return 2; };
                        if (left == 1 & i < onfrom) { return 2; };
                        role[i] = 3;
                    };
                };
            };
            maxc[0] = 0 - 1; maxc[1] = 0 - 1;
            for (i = 0; i < g.nn; i++)
            {
                nd = @g.nodes[i];
                if (nd.kind != SQN_COL | nd.lvl != 0 | nd.owner != g.root_blk) { continue; };
                if (nd.src < 0 | nd.src > 1) { continue; };
                if (nd.col >= 0 & nd.col < b.src[nd.src].ti.ncols & nd.col != b.src[nd.src].ti.ipk & nd.col > maxc[nd.src]) { maxc[nd.src] = nd.col; };
            };
            n = b.nres;
            sq_vd_reset();
            init = sq_vd_op("Init\0", 0, 0, 0);
            VD_NMEM = 0; VD_NFREE = 0; VD_NH = 0; VD_NJ = 0; VD_IDXCUR = 0; VD_JXS = 0;
            a = sq_vd_op("OpenRead\0", o, so.root, 0);
            sq_vd_p4i(a, (i64)(maxc[o] + 1));
            if (cov == 0)
            {
                a = sq_vd_op("OpenRead\0", in2, si.root, 0);
                sq_vd_p4i(a, (i64)(maxc[in2] + 1));
            };
            a = sq_vd_op("OpenRead\0", 2, ix.root, 0);
            sq_sb_init(@kt);
            if (sq_vd_kinfo(@ix, @kt) != 0) { sq_sb_free(@kt); return 2; };
            sq_vd_p4s(a, kt.p, kt.n);
            sq_sb_free(@kt);
            VD_P5[a] = 2;
            rewo = sq_vd_op("Rewind\0", o, 0, 0);
            jlo = VD_NJ;
            VD_COLCUR = o; VD_IDXCUR = 0;
            for (i = 0; i < ncj; i++)
            {
                if (role[i] != 1) { continue; };
                if (sq_vd_where(g, so.ti, cj[i]) != 0) { return 2; };
            };
            jhi = VD_NJ;
            VD_NFREE = 0;
            if (left == 1)
            {
                VD_NMEM = VD_NMEM + 1;
                lflag = VD_NMEM;
                sq_vd_op("Integer\0", 0, lflag, 0);
            };
            k0 = VD_NMEM + 1;
            VD_NMEM = VD_NMEM + nkeys;
            for (k = 0; k < nkeys; k++)
            {
                kjmp[k] = 0 - 1;
                if (sq_vd_isconst(g, kn[k]))
                {
                    if (sq_vd_lit(g, kn[k], k0 + k) != 0) { return 2; };
                }
                else
                {
                    VD_COLCUR = o; VD_IDXCUR = 0;
                    if (sq_vd_expr(g, so.ti, kn[k], k0 + k) != 0) { return 2; };
                    kjmp[k] = sq_vd_op("IsNull\0", k0 + k, 0, 0);
                };
            };
            nxti = sq_vd_op("SeekGE\0", 2, 0, k0);
            sq_vd_p4i(nxti, (i64)nkeys);
            igt = sq_vd_op("IdxGT\0", 2, 0, k0);
            sq_vd_p4i(igt, (i64)nkeys);
            if (cov == 0) { sq_vd_op("DeferredSeek\0", 2, 0, in2); };
            VD_COLCUR = in2; VD_IDXCUR = 2; VD_JXS = in2 + 1;
            sq_vd_setix(@ix);
            k = VD_NJ;
            if (left == 1) { VD_NOHOIST = 1; };
            for (i = 0; i < ncj; i++)
            {
                if (role[i] == 2) { if (sq_vd_where(g, si.ti, cj[i]) != 0) { VD_JXS = 0; VD_NOHOIST = 0; return 2; }; };
                if (role[i] == 3) { if (sq_vd_colcmp(g, b, cj[i]) != 0) { VD_JXS = 0; return 2; }; };
            };
            VD_JXS = 0; VD_NOHOIST = 0;
            nfi = VD_NJ;
            VD_NFREE = 0;
            if (left == 1) { lint = sq_vd_op("Integer\0", 1, lflag, 0); };
            base = VD_NMEM + 1;
            VD_NMEM = VD_NMEM + n;
            for (i = 0; i < n; i++)
            {
                nd = @g.nodes[b.rc[i]];
                if (nd.kind == SQN_COL & (nd.src < 0 | nd.src > 1)) { return 2; };
                if (nd.kind == SQN_COL)
                {
                    VD_COLCUR = nd.src;
                    if (nd.src == in2) { VD_IDXCUR = 2; sq_vd_setix(@ix); } else { VD_IDXCUR = 0; };
                    if (sq_vd_expr(g, b.src[nd.src].ti, b.rc[i], base + i) != 0) { return 2; };
                }
                else
                {
                    VD_COLCUR = o; VD_IDXCUR = 0;
                    if (sq_vd_expr(g, so.ti, b.rc[i], base + i) != 0) { return 2; };
                };
            };
            sq_vd_op("ResultRow\0", base, n, 0);
            hasuniq = 0;
            if (ix.unique != 0 & nkeys == ix.nk) { hasuniq = 1; };
            x = VD_N;
            if (hasuniq == 0)
            {
                p5 = 0;
                if (nkeys == ix.nk) { p5 = 1; };
                a = sq_vd_op("Next\0", 2, igt, p5);
            };
            ifpos = VD_N;
            if (left == 1)
            {
                a = sq_vd_op("IfPos\0", lflag, 0, 0);
                if (cov == 0) { sq_vd_op("NullRow\0", in2, 0, 0); };
                sq_vd_op("NullRow\0", 2, 0, 0);
                sq_vd_op("Goto\0", 0, lint, 0);
                VD_P2[a] = VD_N;
            };
            nxto = VD_N;
            a = sq_vd_op("Next\0", o, rewo + 1, 0);
            VD_P5[a] = 1;
            VD_P2[rewo] = VD_N;
            if (left == 1) { j = ifpos; } else { j = nxto; };
            for (k = 0; k < nkeys; k++) { if (kjmp[k] >= 0) { VD_P2[kjmp[k]] = j; }; };
            VD_P2[nxti] = j; VD_P2[igt] = j;
            for (k = jlo; k < jhi; k++) { VD_P2[VD_JF[k]] = nxto; };
            if (hasuniq == 0) { j = x; } else { j = ifpos; if (left == 0) { j = nxto; }; };
            for (k = jhi; k < nfi; k++) { VD_P2[VD_JF[k]] = j; };
            sq_vd_op("Halt\0", 0, 0, 0);
            VD_P2[init] = VD_N;
            sq_vd_trans(g.db, 0);
            for (k = 0; k < VD_NH; k++) { sq_vd_lit(g, VD_HN[k], VD_HR[k]); };
            sq_vd_op("Goto\0", 0, 1, 0);
            return 0;
        };

        struct SQ_NLX
        {
            SQ_IDX[4] ix;
            SQ_EQP[4] pl;
        };

        global int[4] VD_SIXC;
        global int[512] VD_SIXM;

        // reads a column of a joined table through the index cursor that serves it when the index holds the column
        def sq_vd_rdc(SQ_BLK* b, int src, int col, int r) -> void
        {
            SQ_TI* t = b.src[src].ti;
            int p;
            if (col == t.ipk)
            {
                if (VD_SIXC[src] > 0) { sq_vd_op("IdxRowid\0", VD_SIXC[src], r, 0); } else { sq_vd_op("Rowid\0", src, r, 0); };
                return;
            };
            p = 0 - 1;
            if (VD_SIXC[src] > 0) { p = VD_SIXM[src * 128 + col]; };
            if (p >= 0) { sq_vd_op("Column\0", VD_SIXC[src], p, r); } else { sq_vd_op("Column\0", src, col, r); };
            if (t.aff[col] == 4) { sq_vd_op("RealAffinity\0", r, 0, 0); };
        };

        // points the expression coder at one joined table: its table cursor and, when it is read through an index, that index
        def sq_vd_pointat(SQ_BLK* b, int src, SQ_IDX* ixa) -> void
        {
            int i;
            VD_COLCUR = src;
            if (VD_SIXC[src] > 0)
            {
                VD_IDXCUR = VD_SIXC[src];
                for (i = 0; i < 128; i++) { VD_IXM[i] = VD_SIXM[src * 128 + i]; };
            }
            else { VD_IDXCUR = 0; };
        };

        // nested loops over 2 to 4 tables: every level is a scan, a covering index scan, a rowid seek or an index lookup
        def sq_vd_cntsrc(SQ_STMT* g, int ni, int s) -> int
        {
            SQ_NODE* nd;
            int r;
            if (ni < 0) { return 0; };
            nd = @g.nodes[ni];
            r = 0;
            if (nd.kind == SQN_COL) { if (nd.src == s & nd.lvl == 0) { r = 1; }; };
            if (nd.kind == SQN_SUBQ | nd.kind == SQN_EXISTS) { return r; };
            r = r + sq_vd_cntsrc(g, nd.a, s) + sq_vd_cntsrc(g, nd.b, s) + sq_vd_cntsrc(g, nd.c, s);
            return r;
        };

        def sq_vd_nl0(SQ_STMT* st, SQ_STMT* g, SQ_NLX* nlx) -> int
        {
            SQ_BLK* b = g.blks[g.root_blk];
            SQ_EQC* c;
            SQ_EQP ptmp;
            SQ_SRC* sr;
            SQ_NODE* nd;
            SQ_NODE* ln;
            SQ_NODE* rn;
            SQ_SB kt;
            int[4] ord, kind, cov, neq, icur, left, lflag, lint, rew, body, nxt, ifp, exl, uniq, sk, ig, sop;
            int[4] pos, jlo, jhi, nkj;
            int worn;
            SQ_IDX[12] ixw;
            int[4] ab2;
            byte[8] nb4;
            int[16] kn, kjm;
            int[20] cj, tlev, used, tm;
            int[4] maxc, used2;
            int[4] abl, akc, acn, abm, aone, arew, ife, lbody, akn, aopos;
            int[128] aused;
            int ak, ab, adst, akr, akb, aa, knum, bj, bhi, nix0, nix;
            SQ_IDX[12] ixs0;
            int ordm, dstm, jagg, onk, ond2, ooff, ooutr, obase, osn, oss, osd, dfound, drec, scur, pcur, ofs;
            int[8] okc, oks;
            int[32] rcs, rcc, rpos;
            SQ_SB okt;
            SQ_SB eqs;
            int tie, hk, ephno, la, sbeg, send, sgi, sgo, crossf, n, ns, i, j, k, L, s, ncj, onfrom, init, a, x, m, cnt, perm, pp, hasl, lim, nic, nres, base, hi, any, nxtix, key, tgt;
            double bestc, bestc2, cost, loops;
            int[4] bestord, avl, perm2;
            n = b.nsrc;
            if (n < 2 | n > 4 | b.cnext >= 0 | b.ngrp != 0 | b.having >= 0 | b.nwin != 0 | b.ncte != 0) { return 2; };
            if (b.nres < 1 | b.nres > 30) { return 2; };
            hasl = 0;
            if (b.limit_n >= 0)
            {
                if (g.nodes[b.limit_n].kind != SQN_INT | b.offset_n >= 0) { return 2; };
                if (g.nodes[b.limit_n].iv <= (i64)0) { return 2; };
                hasl = 1;
            };
            ordm = 0; dstm = 0; jagg = 0; scur = 0 - 1; dfound = 0 - 1; osn = 0 - 1;
            if (b.nord > 0) { ordm = 1; };
            if (b.distinct != 0) { dstm = 1; };
            if (b.has_agg != 0)
            {
                jagg = 1;
                if (hasl == 1 | dstm == 1 | ordm == 1) { return 2; };
                if (sq_vd_jagg_prep(st, g, b) != 0) { return 2; };
            };
            if (dstm == 1 & (ordm == 1 | hasl == 1 | b.nres > 30)) { return 2; };
            if (ordm == 1)
            {
                if (hasl == 1 | b.nord > 8 | b.nres > 30) { return 2; };
                onk = b.nord;
                for (i = 0; i < onk; i++)
                {
                    nd = @g.nodes[b.ord[i]];
                    if (nd.kind == SQN_RESREF) { nd = @g.nodes[b.rc[(int)nd.iv]]; };
                    if (nd.kind != SQN_COL | nd.src < 0 | nd.src >= b.nsrc | nd.col < 0 | b.ocoll[i] >= 0) { return 2; };
                    if (nd.col >= b.src[nd.src].ti.ncols | nd.col == b.src[nd.src].ti.ipk) { return 2; };
                    okc[i] = nd.col; oks[i] = nd.src;
                    for (j = 0; j < i; j++) { if (okc[j] == okc[i] & oks[j] == oks[i]) { return 2; }; };
                    // an index led by the order column lets SQLite skip the sorter
                    if (b.src[nd.src].kind == 1 & b.src[nd.src].tbl >= 0)
                    {
                        nix0 = sq_idx_list(b.src[nd.src].sdb, b.src[nd.src].tbl, b.src[nd.src].ti, @ixs0[0], 12);
                        for (j = 0; j < nix0; j++) { for (k = 0; k < ixs0[j].nk; k++) { if (ixs0[j].partial == 0 & ixs0[j].isx[k] == 0 & ixs0[j].col[k] == nd.col) { return 2; }; }; };
                    };
                };
                for (i = 0; i < b.nres; i++)
                {
                    nd = @g.nodes[b.rc[i]];
                    if (nd.kind != SQN_COL | nd.src < 0 | nd.src >= b.nsrc | nd.col < 0) { return 2; };
                    if (nd.col >= b.src[nd.src].ti.ncols | nd.col == b.src[nd.src].ti.ipk) { return 2; };
                    rcc[i] = nd.col; rcs[i] = nd.src;
                    for (j = 0; j < i; j++) { if (rcc[j] == rcc[i] & rcs[j] == rcs[i]) { return 2; }; };
                };
                ond2 = 0;
                for (i = 0; i < b.nres; i++)
                {
                    rpos[i] = 0 - 1;
