            for (i = 0; i < ne; i++)
            {
                for (j = i + 1; j < ne; j++)
                {
                    ln = @g.nodes[ekey[i]]; rn = @g.nodes[ekey[j]];
                    if (ln.src == rn.src & ln.col == rn.col) { if (sq_vd_gon(293) == 1) { sq_seterr(st, "EXPLAIN is not available for this join #293\0"); return 1; }; };
                    if (ecs[i] == ecs[j]) { if (sq_vd_gon(294) == 1) { sq_seterr(st, "EXPLAIN is not available for this join #294\0"); return 1; }; };
                    if (ecs[i] == efrom[j] & g.nodes[ekey[j]].col == b.src[ecs[i]].ti.ipk) { if (sq_vd_gon(295) == 1) { sq_seterr(st, "EXPLAIN is not available for this join #295\0"); return 1; }; };
                    if (ecs[j] == efrom[i] & g.nodes[ekey[i]].col == b.src[ecs[j]].ti.ipk) { if (sq_vd_gon(296) == 1) { sq_seterr(st, "EXPLAIN is not available for this join #296\0"); return 1; }; };
                };
            };
            if (ne != 0 & ne != ns - 1) { if (sq_vd_gon(297) == 1) { sq_seterr(st, "EXPLAIN is not available for this join #297\0"); return 1; }; };
            if (ne == 0 & ncj > 0) { if (sq_vd_gon(298) == 1) { sq_seterr(st, "EXPLAIN is not available for this join #298\0"); return 1; }; };
            // loop order
            root = 0;
            if (ne > 0)
            {
                root = 0 - 1;
                for (i = 0; i < ns; i++) { if (nin[i] == 0) { if (root >= 0) { if (sq_vd_gon(299) == 1) { sq_seterr(st, "EXPLAIN is not available for this join #299\0"); return 1; }; }; root = i; }; };
                if (root < 0) { if (sq_vd_gon(300) == 1) { sq_seterr(st, "EXPLAIN is not available for this join #300\0"); return 1; }; };
                for (i = 0; i < ns; i++) { if (nin[i] > 1) { if (sq_vd_gon(301) == 1) { sq_seterr(st, "EXPLAIN is not available for this join #301\0"); return 1; }; }; };
            };
            for (i = 0; i < ns; i++) { placed[i] = 0; sk[i] = 0 - 1; };
            ord[0] = root; placed[root] = 1; npl = 1;
            if (ne == 0) { for (i = 0; i < ns; i++) { ord[i] = i; }; npl = ns; };
            while (npl < ns)
            {
                cand = 0 - 1;
                for (i = 0; i < ns; i++)
                {
                    if (placed[i] != 0) { continue; };
                    for (j = 0; j < ne; j++) { if (ecs[j] == i & placed[efrom[j]] != 0) { cand = i; sk[i] = j; break; }; };
                    if (cand >= 0) { break; };
                };
                if (cand < 0) { if (sq_vd_gon(302) == 1) { sq_seterr(st, "EXPLAIN is not available for this join #302\0"); return 1; }; };
                ord[npl] = cand; placed[cand] = 1; npl++;
            };
            k = 0;
            if (ne > 0) { k = 1; };
            if (sq_vd_planchk(g, k, @ord[0], ns) != 0) { if (sq_vd_gon(303) == 1) { sq_seterr(st, "EXPLAIN is not available for this join #303\0"); return 1; }; };
            for (i = 0; i < ns; i++) { maxc[i] = 0 - 1; };
            for (i = 0; i < g.nn; i++)
            {
                nd = @g.nodes[i];
                if (nd.kind != SQN_COL | nd.lvl != 0 | nd.owner != g.root_blk) { continue; };
                if (nd.src < 0 | nd.src >= ns) { continue; };
                ti2 = b.src[nd.src].ti;
                if (nd.col >= 0 & nd.col < ti2.ncols & nd.col != ti2.ipk & nd.col > maxc[nd.src]) { maxc[nd.src] = nd.col; };
            };
            sq_vd_reset();
            init = sq_vd_op("Init\0", 0, 0, 0);
            VD_NMEM = 0; VD_NFREE = 0; VD_NH = 0; VD_NJ = 0; VD_IDXCUR = 0;
            for (l = 0; l < ns; l++)
            {
                cr = ord[l];
                a = sq_vd_op("OpenRead\0", cr, b.src[cr].root, 0);
                sq_vd_p4i(a, (i64)(maxc[cr] + 1));
            };
            ifm = sq_vd_op("IfEmpty\0", ord[ns - 1], 0, 0);
            for (l = 0; l < ns; l++)
            {
                cr = ord[l];
                jlo[l] = VD_NJ;
                if (ne == 0 | l == 0)
                {
                    rew[l] = sq_vd_op("Rewind\0", cr, 0, 0);
                    if (l == 0) { body0 = VD_N; };
                    if (ne == 0 & l == ns - 1) { body0 = VD_N; };
                }
                else
                {
                    rew[l] = 0 - 1;
                    nd = @g.nodes[ekey[sk[cr]]];
                    VD_NMEM = VD_NMEM + 1;
                    if (nd.col == b.src[nd.src].ti.ipk) { sq_vd_op("Rowid\0", nd.src, VD_NMEM, 0); } else { sq_vd_op("Column\0", nd.src, nd.col, VD_NMEM); };
                    if (nd.col != b.src[nd.src].ti.ipk) { if (b.src[nd.src].ti.aff[nd.col] == 4) { sq_vd_op("RealAffinity\0", VD_NMEM, 0, 0); }; };
                    a = sq_vd_op("SeekRowid\0", cr, 0, VD_NMEM);
                    VD_JF[VD_NJ] = a; VD_NJ++;
                };
                VD_COLCUR = cr;
                for (i = 0; i < ncj; i++)
                {
                    if (tsrc[i] != cr) { continue; };
                    if (sq_vd_where(g, b.src[cr].ti, cj[i]) != 0) { if (sq_vd_gon(304) == 1) { sq_seterr(st, "EXPLAIN is not available for this WHERE clause #304\0"); return 1; }; };
                };
                jhi[l] = VD_NJ;
            };
            base = VD_NMEM + 1;
            VD_NMEM = VD_NMEM + n;
            for (i = 0; i < n; i++)
            {
                nd = @g.nodes[b.rc[i]];
                VD_COLCUR = nd.src;
                if (sq_vd_expr(g, b.src[nd.src].ti, b.rc[i], base + i) != 0) { if (sq_vd_gon(305) == 1) { sq_seterr(st, "EXPLAIN is not available for this expression #305\0"); return 1; }; };
            };
            sq_vd_op("ResultRow\0", base, n, 0);
            if (ne == 0)
            {
                for (l = ns - 1; l >= 0; l--)
                {
                    nxt[l] = VD_N;
                    a = sq_vd_op("Next\0", ord[l], 0, 0);
                    VD_P5[a] = 1;
                    VD_P2[a] = rew[l] + 1;
                };
            }
            else
            {
                nxt[0] = VD_N;
                a = sq_vd_op("Next\0", root, body0, 0);
                VD_P5[a] = 1;
            };
            x = VD_N;
            VD_P2[ifm] = x;
            for (l = 0; l < ns; l++)
            {
                if (rew[l] >= 0) { VD_P2[rew[l]] = x; };
                for (k = jlo[l]; k < jhi[l]; k++)
                {
                    if (ne == 0) { VD_P2[VD_JF[k]] = nxt[l]; } else { VD_P2[VD_JF[k]] = nxt[0]; };
                };
            };
            sq_vd_op("Halt\0", 0, 0, 0);
            VD_P2[init] = VD_N;
            sq_vd_trans(g.db, 0);
            for (k = 0; k < VD_NH; k++) { sq_vd_lit(g, VD_HN[k], VD_HR[k]); };
            sq_vd_op("Goto\0", 0, 1, 0);
            return 0;
        };

        def sq_vd_unionall(SQ_STMT* st, SQ_STMT* g) -> int;
        def sq_vd_nameeq(byte* nm, byte* t, int ns, int nl) -> bool;
        def sq_vd_values(SQ_STMT* st, SQ_STMT* g) -> int;
        def sq_vd_compound(SQ_STMT* st, SQ_STMT* g) -> int;

        def sq_vd_nosub(SQ_STMT* g, int ni) -> bool
        {
            SQ_NODE* nd;
            if (ni < 0) { return true; };
            nd = @g.nodes[ni];
            if (nd.kind == SQN_SUBQ | nd.kind == SQN_EXISTS | nd.kind == SQN_PARAM) { return false; };
            if (nd.a >= 0) { if (sq_vd_nosub(g, nd.a) == false) { return false; }; };
            if (nd.b >= 0) { if (sq_vd_nosub(g, nd.b) == false) { return false; }; };
            if (nd.c >= 0) { if (sq_vd_nosub(g, nd.c) == false) { return false; }; };
            return true;
        };

        // marks the nodes below ni as belonging to block ob
        def sq_vd_reown(SQ_STMT* g, int ni, int ob) -> void
        {
            SQ_NODE* nd;
            if (ni < 0) { return; };
            nd = @g.nodes[ni];
            if (nd.kind == SQN_COL) { nd.owner = ob; };
            if (nd.kind == SQN_SUBQ | nd.kind == SQN_EXISTS) { return; };
            if (nd.a >= 0) { sq_vd_reown(g, nd.a, ob); };
            if (nd.b >= 0) { sq_vd_reown(g, nd.b, ob); };
            if (nd.c >= 0) { sq_vd_reown(g, nd.c, ob); };
        };

        // a simple view in the FROM clause is replaced by the table it selects from, as SQLite's query flattener does.
        // returns 1 when flattened, 0 when the query is not of that shape
        // number of sources in the statement that read CTE number ci
        def sq_vd_cerefs(SQ_STMT* g, int ci) -> int
        {
            int bj, sj, n;
            n = 0;
            for (bj = 0; bj < g.nblk; bj++)
            {
                for (sj = 0; sj < g.blks[bj].nsrc; sj++)
                {
                    if (g.blks[bj].src[sj].cte == ci & g.blks[bj].src[sj].kind == 2) { n++; };
                };
            };
            return n;
        };

        // number of sources still reading any CTE
        def sq_vd_cerefs_any(SQ_STMT* g) -> int
        {
            int bj, sj, n;
            n = 0;
            for (bj = 0; bj < g.nblk; bj++)
            {
                for (sj = 0; sj < g.blks[bj].nsrc; sj++)
                {
                    if (g.blks[bj].src[sj].cte >= 0 & g.blks[bj].src[sj].kind == 2) { n++; };
                };
            };
            return n;
        };

        def sq_vd_flat1(SQ_STMT* g, int bi) -> int
        {
            SQ_BLK* b = g.blks[bi];
            SQ_BLK* ib;
            SQ_NODE* nd;
            SQ_NODE* sn;
            int i, c, an, inner_w, nxt, wascte;
            if (b.nsrc != 1 | b.cnext >= 0 | (bi == g.root_blk) == false & b.nres < 0) { return 0; };
            if (b.src[0].kind != 2 | b.src[0].blk < 0) { return 0; };
            if (b.src[0].selfref != 0) { return 0; };
            if (b.src[0].cte >= 0) { if (sq_vd_cerefs(g, b.src[0].cte) != 1) { return 0; }; };
            ib = g.blks[b.src[0].blk];
            if (ib.nsrc != 1 | ib.cnext >= 0 | ib.distinct != 0 | ib.ngrp != 0 | ib.having >= 0 | ib.nord > 0 | ib.limit_n >= 0 | ib.has_agg != 0 | ib.nwin != 0 | ib.ncte != 0) { return 0; };
            if (ib.src[0].kind != 1 | (u64)ib.src[0].ti == (u64)0) { return 0; };
            for (c = 0; c < ib.nres; c++)
            {
                if (g.nodes[ib.rc[c]].kind != SQN_COL) { return 0; };
                if (g.nodes[ib.rc[c]].lvl != 0) { return 0; };
            };
            if (ib.where_n >= 0) { if (sq_vd_nosub(g, ib.where_n) == false) { return 0; }; };
            for (i = 0; i < g.nn; i++)
            {
                nd = @g.nodes[i];
                if (nd.kind != SQN_COL | nd.owner != bi | nd.lvl != 0) { continue; };
                if (nd.src != 0) { return 0; };
                if (nd.col < 0 | nd.col >= ib.nres) { return 0; };
            };
            for (i = 0; i < g.nn; i++)
            {
                nd = @g.nodes[i];
                if (nd.kind != SQN_COL | nd.owner != bi | nd.lvl != 0) { continue; };
                sn = @g.nodes[ib.rc[nd.col]];
                nxt = nd.next;
                g.nodes[i] = g.nodes[ib.rc[nd.col]];
                nd.next = nxt;
                nd.owner = bi;
            };
            wascte = b.src[0].cte;
            b.src[0] = ib.src[0];
            ib.nsrc = 0;
            if (wascte >= 0) { if (sq_vd_cerefs_any(g) == 0) { b.ncte = 0; }; };
            if (ib.where_n >= 0)
            {
                sq_vd_reown(g, ib.where_n, bi);
                if (b.where_n < 0) { b.where_n = ib.where_n; }
                else
                {
                    an = sq_newnode(g, SQN_BIN);
                    if (an < 0) { return 0; };
                    g.nodes[an].op = SQO_AND;
                    g.nodes[an].a = ib.where_n;
                    g.nodes[an].b = b.where_n;
                    b.where_n = an;
                };
            };
            return 1;
        };

        // flattens the view chain below block bi; returns the number of levels removed
        def sq_vd_flatten_blk(SQ_STMT* g, int bi) -> int
        {
            SQ_BLK* b = g.blks[bi];
            int d, ib;
            if (b.nsrc != 1) { return 0; };
            if (b.src[0].kind != 2 | b.src[0].blk < 0) { return 0; };
            ib = b.src[0].blk;
            d = 0;
            if (g.blks[ib].nsrc == 1) { if (g.blks[ib].src[0].kind == 2) { d = sq_vd_flatten_blk(g, ib); }; };
            if (sq_vd_flat1(g, bi) == 1) { return d + 1; };
            return 0;
        };

        def sq_vd_flatten(SQ_STMT* g) -> int
        {
            return sq_vd_flatten_blk(g, g.root_blk);
        };


        // position of a column in the key of an index, -1 when it is not part of it
        def sq_vd_inix(SQ_IDX* ix, int col) -> int
        {
            int i;
            for (i = 0; i < ix.nk; i++) { if (ix.col[i] == col) { return i; }; };
            return 0 - 1;
        };

        // aggregate items of a one-table SELECT whose loop is coded by sq_vd_select: validates them and numbers the accumulators
        def sq_vd_aggprep(SQ_STMT* g, SQ_BLK* b, SQ_TI* ti, int* fid, int* acc, int* first, int* pnacc, int* pshift) -> int
        {
            SQ_NODE* nd;
            SQ_NODE* ar;
            SQ_NODE* o;
            int i, j, k, n, same, nacc, shift;
            n = b.nres;
            VD_AGGNB = 0;
            if (b.nres < b.nagg | n > 15 | n < 1 | b.nord > 4 | b.ngrp > 0 | b.having >= 0 | b.distinct != 0) { return 1; };
            for (i = 0; i < n; i++)
            {
                nd = @g.nodes[b.rc[i]];
                if (nd.kind == SQN_COL & nd.lvl == 0)
                {
                    if (nd.col < 0 | nd.col >= ti.ncols | (nd.col == ti.ipk & sq_vd_gon(937) == 1)) { return 1; };
                    VD_AGGNB++;
                    fid[i] = 0 - 1;
                    continue;
                };
                if (nd.kind != SQN_FUNC) { return 1; };
                fid[i] = sq_func_id(@g.sql[nd.s], nd.sl, (int)nd.iv);
                if (fid[i] < 100 | fid[i] > 106 | nd.op == 1) { return 1; };

                if (nd.op == 2)
                {
                    if (fid[i] != 100) { return 1; };
                }
                else
                {
                    if (nd.iv != (i64)1 | nd.next >= 0) { return 1; };
                    ar = @g.nodes[nd.a];
                    if (ar.kind == SQN_ROWID | (ar.kind == SQN_COL & (ar.col == ti.ipk | ar.col == ti.ncols))) { }
                    else
                    {
                        if (ar.kind != SQN_COL | ar.col < 0 | ar.col >= ti.ncols) { return 1; };
                        if (ti.coll[ar.col] != 0) { return 1; };
                    };
                };
            };
            if (b.nres - VD_AGGNB != b.nagg) { return 1; };
            nacc = 0;
            for (i = 0; i < n; i++)
            {
                nd = @g.nodes[b.rc[i]];
                acc[i] = 0 - 1;
                if (fid[i] < 0) { acc[i] = 0 - 2; continue; };
                for (j = 0; j < nacc; j++)
                {
                    o = @g.nodes[b.rc[first[j]]];
                    same = 0;
                    if (fid[first[j]] == fid[i] & o.op == nd.op)
                    {
                        if (nd.op == 2) { same = 1; }
                        else { if (g.nodes[o.a].col == g.nodes[nd.a].col) { same = 1; }; };
                    };
                    if (same == 1) { acc[i] = j; break; };
                };
                if (acc[i] < 0) { acc[i] = nacc; first[nacc] = i; nacc++; };
            };
            VD_AGGNR = VD_AGGNB;
            if (b.nord > 0)
            {
                for (i = 0; i < b.nord; i++)
                {
                    o = @g.nodes[b.ord[i]];
                    if (o.kind != SQN_COL | o.lvl != 0 | o.col < 0 | o.col >= ti.ncols | (o.col == ti.ipk & sq_vd_gon(1002) == 1)) { return 1; };
                    k = 0;
                    for (j = 0; j < i; j++) { if (g.nodes[b.ord[j]].col == o.col) { k = 1; }; };
                    if (k == 1) { continue; };
                    for (j = 0; j < n; j++) { if (fid[j] < 0) { if (g.nodes[b.rc[j]].col == o.col) { return 1; }; }; };
                    for (j = 0; j < n; j++) { if (fid[j] >= 0) { if (g.nodes[b.rc[j]].op != 2) { if (g.nodes[g.nodes[b.rc[j]].a].col == o.col & sq_vd_gon(1003) == 1) { return 1; }; }; }; };
                    VD_AGGNB++;
                };
            };
            if (VD_AGGNB > 0)
            {
                for (i = 0; i < n; i++) { if (fid[i] == 104 | fid[i] == 105) { return 1; }; };
                if (nacc < 1) { return 1; };
            };
            if (nacc == 1 & b.where_n >= 0)
            {
                nd = @g.nodes[b.rc[first[0]]];
                if (fid[first[0]] == 104 | fid[first[0]] == 105)
                {
                    ar = @g.nodes[nd.a];
                    if (ti.wor != 0 | ar.kind != SQN_COL) { if (sq_vd_gon(660) == 1) { return 1; }; };
                    if (ar.col == ti.ipk | ar.col == ti.ncols) { if (sq_vd_gon(660) == 1) { return 1; }; };
                    if (sq_vd_leads(@b.src[0], ar.col) == 1) { if (sq_vd_gon(660) == 1) { return 1; }; };
                };
            };
            shift = 0;
            for (i = 0; i < n; i++)
            {
                nd = @g.nodes[b.rc[i]];
                if (nd.op == 2 | fid[i] < 0) { continue; };
                same = 0;
                for (j = 0; j < i; j++)
                {
                    o = @g.nodes[b.rc[j]];
                    if (o.op != 2 & fid[j] >= 0) { if (g.nodes[o.a].col == g.nodes[nd.a].col) { same = 1; }; };
                };
                if (same == 0) { shift++; };
            };
            shift--;
            if (VD_AGGNB > 0) { shift = shift + VD_AGGNB + 1; };
            *pnacc = nacc; *pshift = shift;
            return 0;
        };

        // one AggStep per accumulator for the current row, the arguments read from the index cursor when useix is 1
        def sq_vd_aggstep(SQ_STMT* g, SQ_BLK* b, SQ_TI* ti, int* fid, int* first, int nacc, int shift, int useix, SQ_IDX* ix) -> int
        {
            SQ_NODE* nd;
            SQ_NODE* ar;
            int i, j, k, a, reg, pos, nid;
            for (j = 0; j < nacc; j++)
            {
                i = first[j];
                nd = @g.nodes[b.rc[i]];
                reg = 0;
                if (nd.op != 2)
                {
                    ar = @g.nodes[nd.a];
                    reg = sq_vd_getreg();
                    if (useix == 1)
                    {
                        if (ar.kind == SQN_ROWID | ar.col == ti.ipk | ar.col == ti.ncols) { sq_vd_op("IdxRowid\0", VD_COLCUR, reg, 0); }
                        else
                        {
                            pos = 0 - 1;
                            for (k = 0; k < ix.nk; k++) { if (ix.col[k] == ar.col) { pos = k; break; }; };
                            if (pos < 0) { return 1; };
                            sq_vd_op("Column\0", VD_COLCUR, pos, reg);
                            if (ti.aff[ar.col] == 4) { sq_vd_op("RealAffinity\0", reg, 0, 0); };
                        };
                    }
                    else
                    {
                        if (sq_vd_expr(g, ti, nd.a, reg) != 0) { return 1; };
                    };
                    if (fid[i] == 104 | fid[i] == 105)
                    {
                        a = sq_vd_op("CollSeq\0", 0, 0, 0);
                        sq_vd_p4s(a, "BINARY-8\0", 8);
                    };
                };
                a = sq_vd_op("AggStep\0", 0, reg, j + 2 + shift);
                if (fid[i] == 100) { if (nd.op == 2) { sq_vd_p4s(a, "count(0)\0", 8); } else { sq_vd_p4s(a, "count(1)\0", 8); }; };
                if (fid[i] == 101) { sq_vd_p4s(a, "sum(1)\0", 6); };
                if (fid[i] == 102) { sq_vd_p4s(a, "total(1)\0", 8); };
                if (fid[i] == 103) { sq_vd_p4s(a, "avg(1)\0", 6); };
                if (fid[i] == 104) { sq_vd_p4s(a, "min(1)\0", 6); };
                if (fid[i] == 105) { sq_vd_p4s(a, "max(1)\0", 6); };
                if (fid[i] == 106) { sq_vd_p4s(a, "group_concat(1)\0", 15); };
                if (nd.op != 2) { VD_P5[a] = 1; sq_vd_putreg(reg); };
            };
            if (VD_AGGNB > 0)
            {
                reg = sq_vd_op("If\0", 1 + VD_AGGLO, 0, 0);
                a = 2 + VD_AGGLO;
                for (i = 0; i < b.nres + b.nord; i++)
                {
                    if (i < b.nres) { if (fid[i] >= 0) { continue; }; ar = @g.nodes[b.rc[i]]; nid = b.rc[i]; }
                    else
                    {
                        ar = @g.nodes[b.ord[i - b.nres]]; nid = b.ord[i - b.nres];
                        pos = 0;
                        for (k = 0; k < i - b.nres; k++) { if (g.nodes[b.ord[k]].col == ar.col) { pos = 1; }; };
                        if (pos == 1) { continue; };
                    };
                    if (useix == 1 & ar.col == ti.ipk & ti.ipk >= 0)
                    {
                        sq_vd_op("IdxRowid\0", VD_COLCUR, a, 0);
                    }
                    else if (useix == 1)
                    {
                        pos = 0 - 1;
                        for (k = 0; k < ix.nk; k++) { if (ix.col[k] == ar.col) { pos = k; break; }; };
                        if (pos < 0) { return 1; };
                        sq_vd_op("Column\0", VD_COLCUR, pos, a);
                        if (ti.aff[ar.col] == 4) { sq_vd_op("RealAffinity\0", a, 0, 0); };
                    }
                    else { if (sq_vd_expr(g, ti, nid, a) != 0) { return 1; }; };
                    a++;
                };
                VD_P2[reg] = VD_N;
                sq_vd_op("Integer\0", 1, 1 + VD_AGGLO, 0);
            };
            return 0;
        };

        // AggFinal for each accumulator, then the result row
        def sq_vd_aggfin(SQ_STMT* g, SQ_BLK* b, int* fid, int* acc, int* first, int nacc, int shift) -> void
        {
            SQ_NODE* nd;
            int i, j, a, run, rbase, n, k, ipx;
            int[16] srcr;
            n = b.nres;
            for (j = 0; j < nacc; j++)
            {
                i = first[j];
                nd = @g.nodes[b.rc[i]];
                a = sq_vd_op("AggFinal\0", j + 2 + shift, 0, 0);
                if (nd.op != 2) { VD_P2[a] = 1; };
                if (fid[i] == 100) { if (nd.op == 2) { sq_vd_p4s(a, "count(0)\0", 8); } else { sq_vd_p4s(a, "count(1)\0", 8); }; };
                if (fid[i] == 101) { sq_vd_p4s(a, "sum(1)\0", 6); };
                if (fid[i] == 102) { sq_vd_p4s(a, "total(1)\0", 8); };
                if (fid[i] == 103) { sq_vd_p4s(a, "avg(1)\0", 6); };
                if (fid[i] == 104) { sq_vd_p4s(a, "min(1)\0", 6); };
                if (fid[i] == 105) { sq_vd_p4s(a, "max(1)\0", 6); };
                if (fid[i] == 106) { sq_vd_p4s(a, "group_concat(1)\0", 15); };
            };
            ipx = 0 - 1;
            if (VD_AGGHO == 1) { ipx = sq_vd_op("IfPos\0", 2, 0, 1); };
            rbase = VD_NMEM + 1;
            k = 2 + VD_AGGLO;
            for (i = 0; i < n; i++)
            {
                if (acc[i] == 0 - 2) { srcr[i] = k; k++; } else { srcr[i] = acc[i] + 2 + shift; };
            };
            i = 0;
            while (i < n)
            {
                run = 0;
                while (i + run + 1 < n) { if (srcr[i + run + 1] == srcr[i + run] + 1) { run++; } else { break; }; };
                sq_vd_op("Copy\0", srcr[i], rbase + i, run);
                i = i + run + 1;
            };
            sq_vd_op("ResultRow\0", rbase, n, 0);
            if (VD_AGGHL == 1) { sq_vd_op("DecrJumpZero\0", 1, VD_N + 1, 0); };
            if (ipx >= 0) { VD_P2[ipx] = VD_N; };
        };



        // removes IS NULL / IS NOT NULL terms on the integer primary key from an AND tree; their constant results are recorded
        def sq_vd_dropipk(SQ_STMT* g, SQ_TI* ti, int ni) -> int
        {
            SQ_NODE* nd = @g.nodes[ni];
            SQ_NODE* l;
            int x, y, k;
            if (nd.kind == SQN_BIN & nd.op == SQO_AND)
            {
                x = sq_vd_dropipk(g, ti, nd.a);
                y = sq_vd_dropipk(g, ti, nd.b);
                if (x < 0) { return y; };
                if (y < 0) { return x; };
                nd.a = x; nd.b = y;
                return ni;
            };
            if (nd.kind == SQN_ISNULL & (nd.op == 1 | nd.op == 2) & VD_NCK < 8)
            {
                l = @g.nodes[nd.a];
                k = 0;
                if (l.kind == SQN_ROWID | (l.kind == SQN_COL & l.col == ti.ipk)) { k = 1; };
                if (l.kind == SQN_COL & ti.wor != 0 & sq_vd_gon(673) == 0) { for (x = 0; x < ti.npk; x++) { if (ti.pkc[x] == l.col) { k = 1; }; }; };
                if (k == 1)
                {
                    if (nd.op == 1) { VD_CKV[VD_NCK] = 0; } else { VD_CKV[VD_NCK] = 1; };
                    VD_CKCL[VD_NCK] = 0 - 9; if (l.kind == SQN_COL) { VD_CKCL[VD_NCK] = l.col; };
                    VD_NCK++;
                    return 0 - 1;
                };
            };
            return ni;
        };

        // removes the AND term whose right hand side is node rhs from the tree at ni; 1 when removed
        def sq_vd_dropterm(SQ_STMT* g, int ni, int rhs) -> int
        {
            SQ_NODE* nd = @g.nodes[ni];
            if (nd.kind != SQN_BIN | nd.op != SQO_AND) { return 0; };
            if (g.nodes[nd.a].kind == SQN_BIN & g.nodes[nd.a].op == SQO_EQ & g.nodes[nd.a].b == rhs) { g.nodes[ni] = g.nodes[nd.b]; return 1; };
            if (g.nodes[nd.b].kind == SQN_BIN & g.nodes[nd.b].op == SQO_EQ & g.nodes[nd.b].b == rhs) { g.nodes[ni] = g.nodes[nd.a]; return 1; };
            if (sq_vd_dropterm(g, nd.a, rhs) == 1) { return 1; };
            return sq_vd_dropterm(g, nd.b, rhs);
        };

        // removes the AND term comparing with the right hand side node rhs, whatever its operator
        def sq_vd_dropany(SQ_STMT* g, int ni, int rhs) -> int
        {
            SQ_NODE* nd = @g.nodes[ni];
            if (nd.kind != SQN_BIN | nd.op != SQO_AND) { return 0; };
            if (g.nodes[nd.a].kind == SQN_BIN & g.nodes[nd.a].b == rhs) { g.nodes[ni] = g.nodes[nd.b]; return 1; };
            if (g.nodes[nd.b].kind == SQN_BIN & g.nodes[nd.b].b == rhs) { g.nodes[ni] = g.nodes[nd.a]; return 1; };
            if (sq_vd_dropany(g, nd.a, rhs) == 1) { return 1; };
            return sq_vd_dropany(g, nd.b, rhs);
        };

        // two equalities of one column with constants: SQLite also tests the two constants against each other up front
        // returns 0 when there is no such pair, 1 with the right hand nodes in r[0] r[1] and the column in r[2], 2 when the pair is not handled
        def sq_vd_dupeq(SQ_STMT* g, SQ_TI* ti, int wn, int* r) -> int
        {
            int[16] cj;
            int n, i, j, found, ci, cjj, li, lj;
            SQ_NODE* x;
            SQ_NODE* y;
            n = 0;
            sq_vd_splitx(g, wn, @cj[0], @n);
            found = 0;
            for (i = 0; i < n; i++)
            {
                x = @g.nodes[cj[i]];
                if (x.kind != SQN_BIN | x.op != SQO_EQ) { continue; };
                li = g.nodes[x.a].kind;
                if (li != SQN_COL & li != SQN_ROWID) { continue; };
                if (li == SQN_COL) { if (g.nodes[x.a].lvl != 0 | g.nodes[x.a].owner != g.root_blk) { continue; }; };
                if (sq_vd_isconst(g, x.b) == false | g.nodes[x.b].kind == SQN_NULL) { continue; };
                ci = 0 - 1;
                if (li == SQN_COL) { ci = g.nodes[x.a].col; };
                if (li == SQN_ROWID | ci == ti.ipk | ci >= ti.ncols) { ci = ti.ncols; };
                for (j = i + 1; j < n; j++)
                {
                    y = @g.nodes[cj[j]];
                    if (y.kind != SQN_BIN | y.op != SQO_EQ) { continue; };
                    lj = g.nodes[y.a].kind;
                    if (lj != SQN_COL & lj != SQN_ROWID) { continue; };
                    if (lj == SQN_COL) { if (g.nodes[y.a].lvl != 0 | g.nodes[y.a].owner != g.root_blk) { continue; }; };
                    if (sq_vd_isconst(g, y.b) == false | g.nodes[y.b].kind == SQN_NULL) { continue; };
                    cjj = 0 - 1;
                    if (lj == SQN_COL) { cjj = g.nodes[y.a].col; };
                    if (lj == SQN_ROWID | cjj == ti.ipk | cjj >= ti.ncols) { cjj = ti.ncols; };
                    if (ci != cjj) { continue; };
                    if (found != 0) { return 2; };
                    found = 1;
                    r[0] = x.b; r[1] = y.b; r[2] = ci;
                    if (g.nodes[x.b].kind != g.nodes[y.b].kind) { return 2; };
                };
            };
            return found;
        };

        // an equality of an unindexed plain column with an integer constant plus one comparison of the same column with an integer constant:
        // SQLite tests the two constants against each other up front. r[0]=comparison rhs node, r[1]=equality rhs node, r[2]=column, r[3]=comparison op
        def sq_vd_eqrange(SQ_STMT* g, SQ_BLK* b, SQ_TI* ti, int wn, int* r) -> int
        {
            int[16] cj;
            int n, i, j, k, oth, ci, cjj;
            SQ_NODE* x;
            SQ_NODE* y;
            n = 0;
            if (ti.wor != 0 | b.nsrc != 1) { return 0; };
            sq_vd_splitx(g, wn, @cj[0], @n);
            if (n < 2 | n > 3) { return 0; };
            for (i = 0; i < n; i++)
            {
              for (j = 0; j < n; j++)
              {
                if (i == j) { continue; };
                x = @g.nodes[cj[i]];
                y = @g.nodes[cj[j]];
                if (x.kind != SQN_BIN | y.kind != SQN_BIN) { continue; };
                if (x.op != SQO_EQ | !(y.op == SQO_GT | y.op == SQO_GE | y.op == SQO_LT | y.op == SQO_LE)) { continue; };
                if (g.nodes[x.a].kind != SQN_COL | g.nodes[y.a].kind != SQN_COL) { continue; };
                if (g.nodes[x.a].lvl != 0 | g.nodes[y.a].lvl != 0 | g.nodes[x.a].owner != g.root_blk | g.nodes[y.a].owner != g.root_blk) { continue; };
                ci = g.nodes[x.a].col; cjj = g.nodes[y.a].col;
                if (ci != cjj | ci < 0 | ci >= ti.ncols | ci == ti.ipk) { continue; };
                if (g.nodes[x.b].kind != SQN_INT | g.nodes[y.b].kind != SQN_INT) { continue; };
                if (sq_vd_isconst(g, x.b) == false | sq_vd_isconst(g, y.b) == false) { continue; };
                if (sq_vd_inidx(@b.src[0], ci) != 0 | ti.pk[ci] != 0 | ti.aff[ci] == 4) { continue; };
                oth = 0;
                for (k = 0; k < n; k++) { if (k != i & k != j) { if (sq_vd_exprcol(g, cj[k]) == ci) { oth = 1; }; }; };
                if (oth == 1) { continue; };
                r[0] = y.b; r[1] = x.b; r[2] = ci; r[3] = y.op; r[4] = cj[j];
                return 1;
              };
            };
            return 0;
        };

        // an OR whose terms compare one column with the same literal: SQLite treats the column as constant
        def sq_vd_dupor(SQ_STMT* g, int ni) -> int
        {
            SQ_NODE* nd = @g.nodes[ni];
            int[8] tm;
            int n, i, c0;
            if (nd.kind == SQN_BIN & nd.op == SQO_AND) { if (sq_vd_dupor(g, nd.a) == 1) { return 1; }; return sq_vd_dupor(g, nd.b); };
            if (nd.kind != SQN_BIN | nd.op != SQO_OR) { return 0; };
            n = 0;
            sq_vd_orsplit(g, ni, @tm[0], @n);
            if (n < 2) { return 0; };
            c0 = 0 - 1;
            for (i = 0; i < n; i++)
            {
                if (g.nodes[tm[i]].kind != SQN_BIN | g.nodes[tm[i]].op != SQO_EQ) { return 0; };
                if (g.nodes[g.nodes[tm[i]].a].kind != SQN_COL) { return 0; };
                if (sq_vd_isconst(g, g.nodes[tm[i]].b) == false) { return 0; };
                if (c0 == 0 - 1) { c0 = g.nodes[g.nodes[tm[i]].a].col; } else { if (c0 != g.nodes[g.nodes[tm[i]].a].col) { return 0; }; };
                if (i > 0) { if (sq_vd_same(g, g.nodes[tm[0]].b, g.nodes[tm[i]].b) == false) { return 0; }; };
            };
            return 1;
        };

        global int[8] VD_ORI;
        global SQ_NODE[8] VD_ORS;

        // an OR of equalities of one column with constants is the IN list SQLite adds as a term for that column
        def sq_vd_orin(SQ_STMT* g, SQ_TI* ti, int ni) -> void
        {
            SQ_NODE* nd = @g.nodes[ni];
            int[8] tm;
            int n, i, c0, k0, lv, ok, rhs, prev;
            if (nd.kind == SQN_BIN & nd.op == SQO_AND)
            {
                sq_vd_orin(g, ti, nd.a);
                sq_vd_orin(g, ti, nd.b);
                return;
            };
            if (nd.kind != SQN_BIN | nd.op != SQO_OR) { return; };
            if (VD_ORN >= 8) { return; };
            n = 0;
            sq_vd_orsplit(g, ni, @tm[0], @n);
            if (n < 2) { return; };
            ok = 1;
            c0 = 0 - 1; k0 = 0;
            for (i = 0; i < n; i++)
            {
                if (g.nodes[tm[i]].kind != SQN_BIN | g.nodes[tm[i]].op != SQO_EQ) { ok = 0; break; };
                lv = g.nodes[tm[i]].a;
                if (g.nodes[lv].kind == SQN_COL)
                {
                    if (g.nodes[lv].lvl != 0 | g.nodes[lv].owner != g.root_blk) { ok = 0; break; };
                    k0 = 1;
                    if (c0 == 0 - 1) { c0 = g.nodes[lv].col; } else { if (c0 != g.nodes[lv].col) { ok = 0; break; }; };
                }
                else { ok = 0; break; };
                rhs = g.nodes[tm[i]].b;
                if (sq_vd_isconst(g, rhs) == false | g.nodes[rhs].kind == SQN_NULL) { ok = 0; break; };
            };
            if (ok == 0 | k0 == 0) { return; };
            VD_ORS[VD_ORN] = g.nodes[ni]; VD_ORI[VD_ORN] = ni; VD_ORN++;
            prev = 0 - 1;
            for (i = n - 1; i >= 0; i--)
            {
                rhs = g.nodes[tm[i]].b;
                g.nodes[rhs].next = prev;
                prev = rhs;
            };
            nd.kind = SQN_IN; nd.op = 1; nd.a = g.nodes[tm[0]].a; nd.b = prev; nd.blk = 0 - 1; nd.agg = 9;
        };

        def sq_vd_orin_undo(SQ_STMT* g) -> void
        {
            int i;
            for (i = 0; i < VD_ORN; i++) { g.nodes[VD_ORI[i]] = VD_ORS[i]; };
            VD_ORN = 0;
        };

        // the subroutine that loads an IN list into an ephemeral index, then the loop head over it: Rewind, Column, IsNull
        def sq_vd_insub(SQ_STMT* g, SQ_TI* ti, int innode, int col, int rowid, int ecur, int reg) -> int
        {
            int sub, val, rec, a, no, t1, affc, i;
            byte[2] nb;
            SQ_NODE* w = @g.nodes[innode];
            affc = 68;
            if (rowid == 0) { affc = sq_vd_affch(ti.aff[col]); };
            VD_NMEM++; sub = VD_NMEM;
            VD_NMEM++; val = VD_NMEM;
            VD_NMEM++; rec = VD_NMEM;
            a = sq_vd_op("BeginSubrtn\0", 0, sub, 0);
            no = sq_vd_op("Once\0", 0, 0, 0);
            sq_vd_op("OpenEphemeral\0", ecur, 1, 0);
            if (rowid == 1) { sq_vd_p4s(VD_N - 1, "k(1,)\0", 5); } else { sq_vd_p4s(VD_N - 1, "k(1,B)\0", 6); };
            for (i = w.b; i >= 0; i = g.nodes[i].next)
            {
                sq_vd_lit(g, i, val);
                t1 = sq_vd_op("MakeRecord\0", val, 1, rec);
                nb[0] = (byte)affc; nb[1] = (byte)0;
                sq_vd_p4s(t1, @nb[0], 1);
                t1 = sq_vd_op("IdxInsert\0", ecur, rec, val);
                sq_vd_p4i(t1, (i64)1);
            };
            sq_vd_op("NullRow\0", ecur, 0, 0);
            VD_P2[no] = VD_N;
            sq_vd_op("Return\0", sub, a + 1, 1);
            if (VD_INDESC == 1) { VD_INRW = sq_vd_op("Last\0", ecur, 0, 0); } else { VD_INRW = sq_vd_op("Rewind\0", ecur, 0, 0); };
            VD_INTOP = sq_vd_op("Column\0", ecur, 0, reg);
            VD_INNL = sq_vd_op("IsNull\0", reg, 0, 0);
            return 0;
        };

        // col IN (literal, literal, ...) on an unindexed aff-0 column: the literals go to an ephemeral index
        def sq_vd_inlist(SQ_STMT* st, SQ_STMT* g) -> int
        {
            SQ_BLK* b = g.blks[g.root_blk];
            SQ_SRC* sr = @b.src[0];
            SQ_TI* ti = sr.ti;
            SQ_NODE* w = @g.nodes[b.where_n];
            SQ_NODE* nd;
            int i, k, xcol, init, a, rew, body, once, nf, nxt, nres, ni, maxc, t1, nix0;
            SQ_IDX[12] ixs0;
            nd = @g.nodes[w.a];
            if (nd.kind != SQN_COL | nd.lvl != 0) { return 2; };
            xcol = nd.col;
            if (xcol < 0 | xcol >= ti.ncols | xcol == ti.ipk | ti.aff[xcol] != 0 | ti.coll[xcol] != 0) { return 2; };
            nix0 = sq_idx_list(sr.sdb, sr.tbl, ti, @ixs0[0], 12);
            for (i = 0; i < nix0; i++) { if (ixs0[i].partial == 0 & ixs0[i].isx[0] == 0 & ixs0[i].col[0] == xcol) { return 2; }; };
            nres = b.nres;
            if (nres < 1 | nres > 12) { return 2; };
            maxc = xcol;
            for (k = 0; k < nres; k++)
            {
                nd = @g.nodes[b.rc[k]];
                if (nd.kind != SQN_COL | nd.lvl != 0) { return 2; };
                if (nd.col < 0 | nd.col >= ti.ncols) { return 2; };
                if (nd.col != ti.ipk & nd.col > maxc) { maxc = nd.col; };
            };
            k = 0;
            for (i = w.b; i >= 0; i = g.nodes[i].next)
            {
                if (g.nodes[i].kind != SQN_INT) { return 2; };
                k++;
            };
            if (k < 3) { return 2; };
            sq_vd_reset();
            init = sq_vd_op("Init\0", 0, 0, 0);
            VD_NMEM = 3; VD_NFREE = 0; VD_NH = 0; VD_NH0 = 0; VD_NJ = 0; VD_COLCUR = 0; VD_IDXCUR = 0;
            a = sq_vd_op("OpenRead\0", 0, sr.root, 0);
            sq_vd_p4i(a, (i64)(maxc + 1));
            rew = sq_vd_op("Rewind\0", 0, 0, 0);
            body = sq_vd_op("BeginSubrtn\0", 0, 1, 0);
            once = sq_vd_op("Once\0", 0, 0, 0);
            a = sq_vd_op("OpenEphemeral\0", 1, 1, 0);
            sq_vd_p4s(a, "k(1,B)\0", 6);
            for (i = w.b; i >= 0; i = g.nodes[i].next)
            {
                if (sq_vd_lit(g, i, 2) != 0) { if (sq_vd_gon(306) == 1) { sq_seterr(st, "EXPLAIN is not available for this expression #306\0"); return 1; }; };
                t1 = sq_vd_op("MakeRecord\0", 2, 1, 3);
                sq_vd_p4s(t1, "A\0", 1);
                t1 = sq_vd_op("IdxInsert\0", 1, 3, 2);
                sq_vd_p4i(t1, (i64)1);
            };
            sq_vd_op("NullRow\0", 1, 0, 0);
            VD_P2[once] = VD_N;
            sq_vd_op("Return\0", 1, body + 1, 1);
            sq_vd_op("Column\0", 0, xcol, 4);
            a = sq_vd_op("Affinity\0", 4, 1, 0);
            sq_vd_p4s(a, "A\0", 1);
            ni = sq_vd_op("IsNull\0", 4, 0, 0);
            nf = sq_vd_op("NotFound\0", 1, 0, 4);
            sq_vd_p4i(nf, (i64)1);
            VD_NMEM = 4 + nres;
            for (k = 0; k < nres; k++)
            {
                if (sq_vd_expr(g, ti, b.rc[k], 5 + k) != 0) { if (sq_vd_gon(307) == 1) { sq_seterr(st, "EXPLAIN is not available for this expression #307\0"); return 1; }; };
            };
            sq_vd_op("ResultRow\0", 5, nres, 0);
            nxt = VD_N;
            a = sq_vd_op("Next\0", 0, body, 0);
            VD_P5[a] = 1;
            VD_P2[ni] = nxt; VD_P2[nf] = nxt;
            VD_P2[rew] = VD_N;
            sq_vd_op("Halt\0", 0, 0, 0);
            VD_P2[init] = VD_N;
            sq_vd_trans(st.db, 0);
            sq_vd_op("Goto\0", 0, 1, 0);
            return 0;
        };

        // col NOT IN (SELECT col2 FROM other) on an unindexed aff-0 column
        def sq_vd_notin(SQ_STMT* st, SQ_STMT* g) -> int
        {
            SQ_BLK* b = g.blks[g.root_blk];
            SQ_BLK* sb;
            SQ_SRC* sr = @b.src[0];
            SQ_SRC* s2;
            SQ_TI* ti = sr.ti;
            SQ_TI* t2;
            SQ_NODE* w = @g.nodes[b.where_n];
            SQ_NODE* nd;
            SQ_IDX cix;
            SQ_SB kt;
            int i, k, xcol, scol, init, a, rew, body, once, nxt, nres, ni, ucov, irew, ibody, sroot, pos, maxc, rwe, l2, l3, lres, fnd, nn, ne, g1, g2, rw2;
            SQ_IDX[12] lix;
            int nix, bi;
            nd = @g.nodes[w.a];
            if (nd.kind != SQN_COL | nd.lvl != 0) { return 2; };
            xcol = nd.col;
            if (xcol < 0 | xcol >= ti.ncols | xcol == ti.ipk | ti.aff[xcol] != 0 | ti.coll[xcol] != 0) { return 2; };
            sb = g.blks[w.blk];
            if (sb.nsrc != 1 | sb.nres != 1 | sb.where_n >= 0 | sb.cnext >= 0 | sb.distinct != 0 | sb.ngrp != 0 | sb.having >= 0 | sb.nord > 0 | sb.limit_n >= 0 | sb.has_agg != 0 | sb.nwin != 0 | sb.ncte != 0) { return 2; };
            s2 = @sb.src[0];
            if (s2.kind != 1 | s2.tbl < 0 | (u64)s2.ti == (u64)0) { return 2; };
            t2 = s2.ti;
            if (t2.wor != 0) { return 2; };
            nd = @g.nodes[sb.rc[0]];
            if (nd.kind != SQN_COL) { return 2; };
            scol = nd.col;
            if (scol < 0 | scol >= t2.ncols | scol == t2.ipk) { return 2; };
            if (t2.aff[scol] != 0 | t2.coll[scol] != 0) { return 2; };
            nres = b.nres;
            if (nres < 1 | nres > 12) { return 2; };
            maxc = xcol;
            for (k = 0; k < nres; k++)
            {
                nd = @g.nodes[b.rc[k]];
                if (nd.kind != SQN_COL | nd.lvl != 0) { return 2; };
                if (nd.col < 0 | nd.col >= ti.ncols) { return 2; };
                if (nd.col != ti.ipk & nd.col > maxc) { maxc = nd.col; };
            };
            nix = sq_idx_list(s2.sdb, s2.tbl, t2, @lix[0], 12);
            bi = 0 - 1;
            for (i = 0; i < nix; i++) { if (lix[i].isx[0] == 0 & lix[i].col[0] == scol & lix[i].partial == 0 & lix[i].coll[0] == 0 & lix[i].desc[0] == 0 & bi < 0) { bi = i; }; };
            if (bi >= 0)
            {
                sq_vd_reset();
                init = sq_vd_op("Init\0", 0, 0, 0);
                VD_NMEM = 1; VD_NFREE = 0; VD_NH = 0; VD_NH0 = 0; VD_NJ = 0; VD_COLCUR = 0; VD_IDXCUR = 0;
                a = sq_vd_op("OpenRead\0", 0, sr.root, 0);
                sq_vd_p4i(a, (i64)(maxc + 1));
                rew = sq_vd_op("Rewind\0", 0, 0, 0);
                body = sq_vd_op("Once\0", 0, 0, 0);
                a = sq_vd_op("OpenRead\0", 2, lix[bi].root, 0);
                sq_sb_init(@kt);
                if (sq_vd_kinfo(@lix[bi], @kt) != 0) { sq_sb_free(@kt); sq_seterr(st, "EXPLAIN is not available for this index collation\0"); return 1; };
                sq_vd_p4s(a, kt.p, kt.n);
                sq_sb_free(@kt);
                sq_vd_op("Integer\0", 0, 1, 0);
                rwe = sq_vd_op("Rewind\0", 2, 0, 0);
                a = sq_vd_op("Column\0", 2, 0, 1);
                VD_P5[a] = 128;
                VD_P2[rwe] = VD_N;
                VD_P2[body] = VD_N;
                sq_vd_op("Column\0", 0, xcol, 2);
                a = sq_vd_op("Affinity\0", 2, 1, 0);
                sq_vd_p4s(a, "A\0", 1);
                ni = sq_vd_op("IsNull\0", 2, 0, 0);
                fnd = sq_vd_op("Found\0", 2, 0, 2);
                sq_vd_p4i(fnd, (i64)1);
                nn = sq_vd_op("NotNull\0", 1, 0, 0);
                VD_P2[ni] = VD_N;
                rw2 = sq_vd_op("Rewind\0", 2, 0, 0);
                sq_vd_op("Column\0", 2, 0, 3);
                ne = sq_vd_op("Ne\0", 2, 0, 3);
                sq_vd_p4s(ne, "BINARY-8\0", 8);
                g1 = sq_vd_op("Goto\0", 0, 0, 0);
                VD_P2[fnd] = VD_N;
                g2 = sq_vd_op("Goto\0", 0, 0, 0);
                lres = VD_N;
                VD_P2[nn] = lres; VD_P2[rw2] = lres; VD_P2[ne] = lres;
                VD_NMEM = 3 + nres;
                for (k = 0; k < nres; k++)
                {
                    if (sq_vd_expr(g, ti, b.rc[k], 4 + k) != 0) { if (sq_vd_gon(308) == 1) { sq_seterr(st, "EXPLAIN is not available for this expression #308\0"); return 1; }; };
                };
                sq_vd_op("ResultRow\0", 4, nres, 0);
                nxt = VD_N;
                VD_P2[g1] = nxt; VD_P2[g2] = nxt;
                a = sq_vd_op("Next\0", 0, body - 0, 0);
                VD_P5[a] = 1;
                VD_P2[rew] = VD_N;
                sq_vd_op("Halt\0", 0, 0, 0);
                VD_P2[init] = VD_N;
                sq_vd_trans(st.db, 0);
                sq_vd_op("Goto\0", 0, 1, 0);
                return 0;
            };
            sroot = g.root_blk;
            g.root_blk = w.blk;
            ucov = sq_vd_cover(g, t2, s2, @cix, 0);
            g.root_blk = sroot;
            sq_vd_reset();
            init = sq_vd_op("Init\0", 0, 0, 0);
            VD_NMEM = 3; VD_NFREE = 0; VD_NH = 0; VD_NH0 = 0; VD_NJ = 0; VD_COLCUR = 0; VD_IDXCUR = 0;
            a = sq_vd_op("OpenRead\0", 0, sr.root, 0);
            sq_vd_p4i(a, (i64)(maxc + 1));
            rew = sq_vd_op("Rewind\0", 0, 0, 0);
            body = sq_vd_op("BeginSubrtn\0", 0, 2, 0);
            sq_vd_p4s(body, "subrtnsig:1,A\0", 13);
            once = sq_vd_op("Once\0", 0, 0, 3);
            a = sq_vd_op("OpenEphemeral\0", 2, 1, 0);
            sq_vd_p4s(a, "k(1,B)\0", 6);
            a = sq_vd_op("Blob\0", 10000, 3, 0);
            if (ucov == 1)
            {
                sq_sb_init(@kt);
                if (sq_vd_kinfo(@cix, @kt) != 0) { sq_sb_free(@kt); sq_seterr(st, "EXPLAIN is not available for this index collation\0"); return 1; };
                a = sq_vd_op("OpenRead\0", 3, cix.root, 0);
                sq_vd_p4s(a, kt.p, kt.n);
                sq_sb_free(@kt);
                irew = sq_vd_op("Rewind\0", 3, 0, 4);
                sq_vd_p4i(irew, (i64)0);
                pos = 0;
                for (i = 0; i < cix.nk; i++) { if (cix.col[i] == scol & pos == 0) { pos = i; }; };
                if (cix.col[0] == scol) { pos = 0; };
                ibody = sq_vd_op("Column\0", 3, pos, 4);
            }
            else
            {
                a = sq_vd_op("OpenRead\0", 3, s2.root, 0);
                sq_vd_p4i(a, (i64)(scol + 1));
                irew = sq_vd_op("Rewind\0", 3, 0, 0);
                ibody = sq_vd_op("Column\0", 3, scol, 4);
            };
            a = sq_vd_op("MakeRecord\0", 4, 1, 5);
            sq_vd_p4s(a, "A\0", 1);
            a = sq_vd_op("IdxInsert\0", 2, 5, 4);
            sq_vd_p4i(a, (i64)1);
            a = sq_vd_op("FilterAdd\0", 3, 0, 4);
            sq_vd_p4i(a, (i64)1);
            a = sq_vd_op("Next\0", 3, ibody, 0);
            VD_P5[a] = 1;
            VD_P2[irew] = VD_N;
            sq_vd_op("NullRow\0", 2, 0, 0);
            VD_P2[once] = VD_N;
            sq_vd_op("Return\0", 2, body + 1, 1);
            sq_vd_op("Integer\0", 0, 1, 0);
            rwe = sq_vd_op("Rewind\0", 2, 0, 0);
            a = sq_vd_op("Column\0", 2, 0, 1);
            VD_P5[a] = 128;
            VD_P2[rwe] = VD_N;
            sq_vd_op("Column\0", 0, xcol, 6);
            a = sq_vd_op("Affinity\0", 6, 1, 0);
            sq_vd_p4s(a, "A\0", 1);
            ni = sq_vd_op("IsNull\0", 6, 0, 0);
            fnd = sq_vd_op("Found\0", 2, 0, 6);
            sq_vd_p4i(fnd, (i64)1);
            nn = sq_vd_op("NotNull\0", 1, 0, 0);
            VD_P2[ni] = VD_N;
            rw2 = sq_vd_op("Rewind\0", 2, 0, 0);
            sq_vd_op("Column\0", 2, 0, 7);
            ne = sq_vd_op("Ne\0", 6, 0, 7);
            sq_vd_p4s(ne, "BINARY-8\0", 8);
            g1 = sq_vd_op("Goto\0", 0, 0, 0);
            VD_P2[fnd] = VD_N;
            g2 = sq_vd_op("Goto\0", 0, 0, 0);
            lres = VD_N;
            VD_P2[nn] = lres; VD_P2[rw2] = lres; VD_P2[ne] = lres;
            VD_NMEM = 7 + nres;
            for (k = 0; k < nres; k++)
            {
                if (sq_vd_expr(g, ti, b.rc[k], 8 + k) != 0) { if (sq_vd_gon(309) == 1) { sq_seterr(st, "EXPLAIN is not available for this expression #309\0"); return 1; }; };
            };
            sq_vd_op("ResultRow\0", 8, nres, 0);
            nxt = VD_N;
            VD_P2[g1] = nxt; VD_P2[g2] = nxt;
            a = sq_vd_op("Next\0", 0, body, 0);
            VD_P5[a] = 1;
            VD_P2[rew] = VD_N;
            sq_vd_op("Halt\0", 0, 0, 0);
            VD_P2[init] = VD_N;
            sq_vd_trans(st.db, 0);
            sq_vd_op("Goto\0", 0, 1, 0);
            return 0;
        };

        // unindexed col IN (SELECT rowid-alias FROM other): a SeekRowid probe per outer row
        def sq_vd_inrowid(SQ_STMT* st, SQ_STMT* g) -> int
        {
            SQ_BLK* b = g.blks[g.root_blk];
            SQ_BLK* sb;
            SQ_SRC* sr = @b.src[0];
            SQ_SRC* s2;
            SQ_TI* ti = sr.ti;
            SQ_TI* t2;
            SQ_NODE* w = @g.nodes[b.where_n];
            SQ_NODE* nd;
            int k, xcol, init, a, rew, once, nres, maxc, ni, sk, g1, g2, rw2, ne, g3, nxt;
            nd = @g.nodes[w.a];
            xcol = nd.col;
            sb = g.blks[w.blk];
            s2 = @sb.src[0];
            t2 = s2.ti;
            nres = b.nres;
            if (nres < 1 | nres > 12) { return 2; };
            maxc = xcol;
            for (k = 0; k < nres; k++)
            {
                nd = @g.nodes[b.rc[k]];
                if (nd.kind != SQN_COL | nd.lvl != 0) { return 2; };
                if (nd.col < 0 | nd.col >= ti.ncols) { return 2; };
                if (nd.col != ti.ipk & nd.col > maxc) { maxc = nd.col; };
            };
            sq_vd_reset();
            init = sq_vd_op("Init\0", 0, 0, 0);
            VD_NMEM = 2; VD_NFREE = 0; VD_NH = 0; VD_NH0 = 0; VD_NJ = 0; VD_COLCUR = 0; VD_IDXCUR = 0;
            a = sq_vd_op("OpenRead\0", 0, sr.root, 0);
            sq_vd_p4i(a, (i64)(maxc + 1));
            rew = sq_vd_op("Rewind\0", 0, 0, 0);
            once = sq_vd_op("Once\0", 0, 0, 0);
            a = sq_vd_op("OpenRead\0", 2, s2.root, 0);
            sq_vd_p4i(a, (i64)t2.ncols);
            VD_P2[once] = VD_N;
            sq_vd_op("Column\0", 0, xcol, 1);
            ni = sq_vd_op("IsNull\0", 1, 0, 0);
            sk = sq_vd_op("SeekRowid\0", 2, 0, 1);
            g1 = sq_vd_op("Goto\0", 0, 0, 0);
            g2 = sq_vd_op("Goto\0", 0, 0, 0);
            rw2 = sq_vd_op("Rewind\0", 2, 0, 0);
            sq_vd_op("Column\0", 2, 0, 2);
            ne = sq_vd_op("Ne\0", 1, 0, 2);
            sq_vd_p4s(ne, "BINARY-8\0", 8);
            g3 = sq_vd_op("Goto\0", 0, 0, 0);
            VD_P2[g1] = VD_N;
            VD_NMEM = 2 + nres;
            for (k = 0; k < nres; k++)
            {
                if (sq_vd_expr(g, ti, b.rc[k], 3 + k) != 0) { if (sq_vd_gon(310) == 1) { sq_seterr(st, "EXPLAIN is not available for this expression #310\0"); return 1; }; };
            };
            sq_vd_op("ResultRow\0", 3, nres, 0);
            nxt = VD_N;
            VD_P2[ni] = nxt; VD_P2[sk] = nxt; VD_P2[g2] = nxt; VD_P2[rw2] = nxt; VD_P2[ne] = nxt; VD_P2[g3] = nxt;
            a = sq_vd_op("Next\0", 0, once - 0, 0);
            VD_P5[a] = 1;
            VD_P2[rew] = VD_N;
            sq_vd_op("Halt\0", 0, 0, 0);
            VD_P2[init] = VD_N;
            sq_vd_trans(st.db, 0);
            sq_vd_op("Goto\0", 0, 1, 0);
            return 0;
        };

        // col IN (SELECT col2 FROM other) where an index covering the query leads on col: the set drives seeks into that index
        def sq_vd_inix(SQ_STMT* st, SQ_STMT* g) -> int
        {
            SQ_BLK* b = g.blks[g.root_blk];
            SQ_BLK* sb;
            SQ_SRC* sr = @b.src[0];
            SQ_SRC* s2;
            SQ_TI* ti = sr.ti;
            SQ_TI* t2;
            SQ_NODE* w = @g.nodes[b.where_n];
            SQ_NODE* nd;
            SQ_IDX cix;
            SQ_IDX dix;
            SQ_SB kt;
            int k, xcol, scol, init, a, rew, once, nres, body, ni, sk, ig, nxt, ucov, sroot, irew, ibody, lp, ln;
            nd = @g.nodes[w.a];
            xcol = nd.col;
            sb = g.blks[w.blk];
            s2 = @sb.src[0];
            t2 = s2.ti;
            scol = g.nodes[sb.rc[0]].col;
            if (t2.aff[scol] != 0 | t2.coll[scol] != 0) { return 2; };
            ucov = sq_vd_cover(g, ti, sr, @cix, 0);
            if (ucov != 1) { return 2; };
            if (cix.col[0] != xcol | cix.isx[0] != 0 | cix.partial != 0 | cix.coll[0] != 0 | cix.desc[0] != 0) { return 2; };
            sroot = g.root_blk;
            g.root_blk = w.blk;
            k = sq_vd_cover(g, t2, s2, @dix, 0);
            g.root_blk = sroot;
            if (k != 0) { return 2; };
            nres = b.nres;
            if (nres < 1 | nres > 12) { return 2; };
            sq_vd_reset();
            init = sq_vd_op("Init\0", 0, 0, 0);
            VD_NMEM = 1; VD_NFREE = 0; VD_NH = 0; VD_NH0 = 0; VD_NJ = 0; VD_COLCUR = 0; VD_IDXCUR = 0;
            a = sq_vd_op("OpenRead\0", 2, cix.root, 0);
            sq_sb_init(@kt);
            if (sq_vd_kinfo(@cix, @kt) != 0) { sq_sb_free(@kt); sq_seterr(st, "EXPLAIN is not available for this index collation\0"); return 1; };
            sq_vd_p4s(a, kt.p, kt.n);
            sq_sb_free(@kt);
            VD_P5[a] = 2;
            body = sq_vd_op("BeginSubrtn\0", 0, 2, 0);
            sq_vd_p4s(body, "subrtnsig:1,A\0", 13);
            once = sq_vd_op("Once\0", 0, 0, 0);
            a = sq_vd_op("OpenEphemeral\0", 3, 1, 0);
            sq_vd_p4s(a, "k(1,B)\0", 6);
            a = sq_vd_op("OpenRead\0", 1, s2.root, 0);
            sq_vd_p4i(a, (i64)(scol + 1));
            irew = sq_vd_op("Rewind\0", 1, 0, 0);
            ibody = sq_vd_op("Column\0", 1, scol, 3);
            a = sq_vd_op("MakeRecord\0", 3, 1, 4);
            sq_vd_p4s(a, "A\0", 1);
            a = sq_vd_op("IdxInsert\0", 3, 4, 3);
            sq_vd_p4i(a, (i64)1);
            a = sq_vd_op("Next\0", 1, ibody, 0);
            VD_P5[a] = 1;
            VD_P2[irew] = VD_N;
            sq_vd_op("NullRow\0", 3, 0, 0);
            VD_P2[once] = VD_N;
            sq_vd_op("Return\0", 2, body + 1, 1);
            rew = sq_vd_op("Rewind\0", 3, 0, 0);
            lp = sq_vd_op("Column\0", 3, 0, 1);
            ni = sq_vd_op("IsNull\0", 1, 0, 0);
            sk = sq_vd_op("SeekGE\0", 2, 0, 1);
            sq_vd_p4i(sk, (i64)1);
            ig = sq_vd_op("IdxGT\0", 2, 0, 1);
            sq_vd_p4i(ig, (i64)1);
            VD_NMEM = 4 + nres;
            VD_COLCUR = 2; VD_IDXCUR = 2;
            sq_vd_setix(@cix);
            for (k = 0; k < nres; k++)
            {
                if (sq_vd_expr(g, ti, b.rc[k], 5 + k) != 0) { if (sq_vd_gon(311) == 1) { sq_seterr(st, "EXPLAIN is not available for this expression #311\0"); return 1; }; };
            };
            sq_vd_op("ResultRow\0", 5, nres, 0);
            a = sq_vd_op("Next\0", 2, ig, 0);
            ln = VD_N;
            VD_P2[ni] = ln; VD_P2[sk] = ln; VD_P2[ig] = ln;
            a = sq_vd_op("Next\0", 3, lp, 0);
            VD_P2[rew] = VD_N;
            sq_vd_op("Halt\0", 0, 0, 0);
            VD_P2[init] = VD_N;
            sq_vd_trans(st.db, 0);
            sq_vd_op("Goto\0", 0, 1, 0);
            return 0;
        };

        // WHERE rowid = (SELECT max/min(col) FROM other): the scalar is computed once, then one rowid probe
        def sq_vd_scrk(SQ_STMT* st, SQ_STMT* g) -> int
        {
            SQ_BLK* b = g.blks[g.root_blk];
            SQ_BLK* sb;
            SQ_SRC* sr = @b.src[0];
            SQ_SRC* s2;
            SQ_TI* ti = sr.ti;
            SQ_TI* t2;
            SQ_NODE* w = @g.nodes[b.where_n];
            SQ_NODE* nd;
            SQ_NODE* fn;
            SQ_IDX cix;
            SQ_SB kt;
            int k, init, a, nres, maxc, fid, sroot, ucov, acol, pos, bs, once, lastp, body, gt, sk, miss, lead, dj, irew;
            sb = g.blks[g.nodes[w.b].blk];
            if (sb.nsrc != 1 | sb.nres != 1 | sb.where_n >= 0 | sb.cnext >= 0 | sb.distinct != 0 | sb.ngrp != 0 | sb.having >= 0 | sb.nord > 0 | sb.limit_n >= 0 | sb.nwin != 0 | sb.ncte != 0) { return 2; };
            s2 = @sb.src[0];
            if (s2.kind != 1 | s2.tbl < 0 | (u64)s2.ti == (u64)0) { return 2; };
            t2 = s2.ti;
            if (t2.wor != 0) { return 2; };
            fn = @g.nodes[sb.rc[0]];
            if (fn.kind != SQN_FUNC) { return 2; };
            fid = sq_func_id(@g.sql[fn.s], fn.sl, (int)fn.iv);
            if ((fid != 104 & fid != 105) | fn.op != 0) { return 2; };
            nd = @g.nodes[fn.a];
            if (nd.kind != SQN_COL | nd.lvl != 0) { return 2; };
            acol = nd.col;
            if (acol < 0 | acol >= t2.ncols | acol == t2.ipk | t2.coll[acol] != 0) { return 2; };
            nres = b.nres;
            if (nres < 1 | nres > 12) { return 2; };
            maxc = 0 - 1;
            for (k = 0; k < nres; k++)
            {
                nd = @g.nodes[b.rc[k]];
                if (nd.kind != SQN_COL | nd.lvl != 0) { return 2; };
                if (nd.col < 0 | nd.col >= ti.ncols) { return 2; };
                if (nd.col != ti.ipk & nd.col > maxc) { maxc = nd.col; };
            };
            sroot = g.root_blk;
            g.root_blk = g.nodes[w.b].blk;
            ucov = sq_vd_cover(g, t2, s2, @cix, 0);
            g.root_blk = sroot;
            if (ucov != 1) { return 2; };
            pos = 0 - 1;
            for (k = cix.nk - 1; k >= 0; k--) { if (cix.col[k] == acol) { pos = k; }; };
            if (pos < 0) { return 2; };
            lead = 0;
            if (pos == 0 & fid == 105) { lead = 1; };
            if (pos == 0 & fid == 104) { return 2; };
            sq_vd_reset();
            init = sq_vd_op("Init\0", 0, 0, 0);
            VD_NMEM = 7; VD_NFREE = 0; VD_NH = 0; VD_NH0 = 0; VD_NJ = 0; VD_COLCUR = 0; VD_IDXCUR = 0;
            a = sq_vd_op("OpenRead\0", 0, sr.root, 0);
            sq_vd_p4i(a, (i64)(maxc + 1));
            bs = sq_vd_op("BeginSubrtn\0", 0, 2, 0);
            once = sq_vd_op("Once\0", 0, 0, 0);
            sq_vd_op("Null\0", 0, 3, 3);
            sq_vd_op("Integer\0", 1, 4, 0);
            sq_vd_op("Null\0", 0, 5, 6);
            sq_sb_init(@kt);
            if (sq_vd_kinfo(@cix, @kt) != 0) { sq_sb_free(@kt); sq_seterr(st, "EXPLAIN is not available for this index collation\0"); return 1; };
            a = sq_vd_op("OpenRead\0", 2, cix.root, 0);
            sq_vd_p4s(a, kt.p, kt.n);
            sq_sb_free(@kt);
            if (lead == 1) { irew = sq_vd_op("Last\0", 2, 0, 7); } else { irew = sq_vd_op("Rewind\0", 3 - 1, 0, 7); };
            sq_vd_p4i(irew, (i64)0);
            body = sq_vd_op("Column\0", 2, pos, 7);
            a = sq_vd_op("CollSeq\0", 0, 0, 0);
            sq_vd_p4s(a, "BINARY-8\0", 8);
            if (fid == 105) { a = sq_vd_op("AggStep\0", 0, 7, 6); sq_vd_p4s(a, "max(1)\0", 6); } else { a = sq_vd_op("AggStep\0", 0, 7, 6); sq_vd_p4s(a, "min(1)\0", 6); };
            VD_P5[a] = 1;
            if (lead == 1)
            {
                dj = sq_vd_op("Goto\0", 0, 0, 0);
                a = sq_vd_op("Prev\0", 2, body, 0);
                VD_P5[a] = 1;
                VD_P2[irew] = VD_N; VD_P2[dj] = VD_N;
            }
            else
            {
                a = sq_vd_op("Next\0", 2, body, 0);
                VD_P5[a] = 1;
                VD_P2[irew] = VD_N;
            };
            if (fid == 105) { a = sq_vd_op("AggFinal\0", 6, 1, 0); sq_vd_p4s(a, "max(1)\0", 6); } else { a = sq_vd_op("AggFinal\0", 6, 1, 0); sq_vd_p4s(a, "min(1)\0", 6); };
            sq_vd_op("Copy\0", 6, 3, 0);
            a = sq_vd_op("DecrJumpZero\0", 4, 0, 0);
            VD_P2[a] = VD_N;
            VD_P2[once] = VD_N;
            sq_vd_op("Return\0", 2, bs + 1, 1);
            sk = sq_vd_op("SeekRowid\0", 0, 0, 3);
            VD_NMEM = 7 + nres;
            for (k = 0; k < nres; k++)
            {
                if (sq_vd_expr(g, ti, b.rc[k], 8 + k) != 0) { if (sq_vd_gon(312) == 1) { sq_seterr(st, "EXPLAIN is not available for this expression #312\0"); return 1; }; };
            };
            sq_vd_op("ResultRow\0", 8, nres, 0);
            VD_P2[sk] = VD_N;
            sq_vd_op("Halt\0", 0, 0, 0);
            VD_P2[init] = VD_N;
            sq_vd_trans(st.db, 0);
            sq_vd_op("Goto\0", 0, 1, 0);
            return 0;
        };

        // WHERE col OP (SELECT max/min(col2) | count(*) FROM other): the scalar is computed once per outer row by a subroutine run once
        def sq_vd_scal(SQ_STMT* st, SQ_STMT* g) -> int
        {
            SQ_BLK* b = g.blks[g.root_blk];
            SQ_BLK* sb;
            SQ_SRC* sr = @b.src[0];
            SQ_SRC* s2;
            SQ_TI* ti = sr.ti;
            SQ_TI* t2;
            SQ_NODE* w = @g.nodes[b.where_n];
            SQ_NODE* nd;
            SQ_NODE* fn;
            SQ_IDX cix;
            SQ_SB kt;
            int k, xcol, init, a, rew, nres, maxc, ni, fid, sroot, ucov, op, acol, pos, irew, ibody, rb, rbase, cmp, body, once;
            byte* nm;
            if (sr.kind != 1 | sr.tbl < 0 | (u64)ti == (u64)0) { return 2; };
            if (ti.wor != 0 | b.nsrc != 1 | b.cnext >= 0 | b.distinct != 0 | b.ngrp != 0 | b.having >= 0 | b.nord > 0 | b.limit_n >= 0 | b.has_agg != 0 | b.nwin != 0 | b.ncte != 0) { return 2; };
            nd = @g.nodes[w.a];
            if (nd.kind != SQN_COL | nd.lvl != 0) { return 2; };
            xcol = nd.col;
            if (xcol == ti.ipk & xcol >= 0 & w.op == SQO_EQ & g.nodes[w.b].kind == SQN_SUBQ & ti.coll[xcol] == 0) { return sq_vd_scrk(st, g); };
            if (xcol < 0 | xcol >= ti.ncols | xcol == ti.ipk | ti.aff[xcol] != 0 | ti.coll[xcol] != 0) { return 2; };
            if (g.nodes[w.b].kind != SQN_SUBQ) { return 2; };
            sb = g.blks[g.nodes[w.b].blk];
            if (sb.nsrc != 1 | sb.nres != 1 | sb.where_n >= 0 | sb.cnext >= 0 | sb.distinct != 0 | sb.ngrp != 0 | sb.having >= 0 | sb.nord > 0 | sb.limit_n >= 0 | sb.nwin != 0 | sb.ncte != 0) { return 2; };
            s2 = @sb.src[0];
            if (s2.kind != 1 | s2.tbl < 0 | (u64)s2.ti == (u64)0) { return 2; };
            t2 = s2.ti;
            if (t2.wor != 0) { return 2; };
            fn = @g.nodes[sb.rc[0]];
            if (fn.kind != SQN_FUNC) { return 2; };
            fid = sq_func_id(@g.sql[fn.s], fn.sl, (int)fn.iv);
            acol = 0 - 1;
            if (fid == 100)
            {
                if (fn.op != 2) { return 2; };
            }
            else
            {
                if (fid != 104 & fid != 105) { return 2; };
                if (fn.op != 0) { return 2; };
                nd = @g.nodes[fn.a];
                if (nd.kind != SQN_COL | nd.lvl != 0) { return 2; };
                acol = nd.col;
                if (acol < 0 | acol >= t2.ncols | acol == t2.ipk | t2.coll[acol] != 0) { return 2; };
            };
            op = w.op;
            if (op == SQO_EQ) { nm = "Ne\0"; };
            if (op == SQO_NE) { nm = "Eq\0"; };
            if (op == SQO_LT) { nm = "Ge\0"; };
            if (op == SQO_LE) { nm = "Gt\0"; };
            if (op == SQO_GT) { nm = "Le\0"; };
            if (op == SQO_GE) { nm = "Lt\0"; };
            nres = b.nres;
            if (nres < 1 | nres > 12) { return 2; };
            maxc = xcol;
            for (k = 0; k < nres; k++)
            {
                nd = @g.nodes[b.rc[k]];
                if (nd.kind != SQN_COL | nd.lvl != 0) { return 2; };
                if (nd.col < 0 | nd.col >= ti.ncols) { return 2; };
                if (nd.col != ti.ipk & nd.col > maxc) { maxc = nd.col; };
            };
            sroot = g.root_blk;
            g.root_blk = g.nodes[w.b].blk;
            if (fid == 100) { ucov = sq_vd_cover(g, t2, s2, @cix, 1); } else { ucov = sq_vd_cover(g, t2, s2, @cix, 0); };
            g.root_blk = sroot;
            if (ucov != 1) { return 2; };
            pos = 0 - 1;
            if (fid != 100)
            {
                for (k = cix.nk - 1; k >= 0; k--) { if (cix.col[k] == acol) { pos = k; }; };
                if (pos < 0) { return 2; };
            };
            sq_vd_reset();
            init = sq_vd_op("Init\0", 0, 0, 0);
            VD_NMEM = 2; VD_NFREE = 0; VD_NH = 0; VD_NH0 = 0; VD_NJ = 0; VD_COLCUR = 0; VD_IDXCUR = 0;
            a = sq_vd_op("OpenRead\0", 0, sr.root, 0);
            sq_vd_p4i(a, (i64)(maxc + 1));
            rew = sq_vd_op("Rewind\0", 0, 0, 0);
            body = sq_vd_op("Column\0", 0, xcol, 1);
            ni = sq_vd_op("IsNull\0", 1, 0, 0);
            a = sq_vd_op("BeginSubrtn\0", 0, 3, 0);
            once = sq_vd_op("Once\0", 0, 0, 0);
            sq_vd_op("Null\0", 0, 4, 4);
            sq_vd_op("Integer\0", 1, 5, 0);
            sq_sb_init(@kt);
            if (sq_vd_kinfo(@cix, @kt) != 0) { sq_sb_free(@kt); sq_seterr(st, "EXPLAIN is not available for this index collation\0"); return 1; };
            if (fid == 100)
            {
                k = sq_vd_op("OpenRead\0", 2, cix.root, 0);
                sq_vd_p4s(k, kt.p, kt.n);
                sq_vd_op("Count\0", 2, 6, 0);
                sq_vd_op("Close\0", 2, 0, 0);
                sq_vd_op("Copy\0", 6, 4, 0);
                rbase = 7;
            }
            else
            {
                sq_vd_op("Null\0", 0, 6, 7);
                k = sq_vd_op("OpenRead\0", 2, cix.root, 0);
                sq_vd_p4s(k, kt.p, kt.n);
                irew = sq_vd_op("Rewind\0", 2, 0, 8);
                sq_vd_p4i(irew, (i64)0);
                ibody = sq_vd_op("Column\0", 2, pos, 8);
                k = sq_vd_op("CollSeq\0", 0, 0, 0);
                sq_vd_p4s(k, "BINARY-8\0", 8);
                if (fid == 105) { k = sq_vd_op("AggStep\0", 0, 8, 7); sq_vd_p4s(k, "max(1)\0", 6); } else { k = sq_vd_op("AggStep\0", 0, 8, 7); sq_vd_p4s(k, "min(1)\0", 6); };
                VD_P5[k] = 1;
                k = sq_vd_op("Next\0", 2, ibody, 0);
                VD_P5[k] = 1;
                VD_P2[irew] = VD_N;
                if (fid == 105) { k = sq_vd_op("AggFinal\0", 7, 1, 0); sq_vd_p4s(k, "max(1)\0", 6); } else { k = sq_vd_op("AggFinal\0", 7, 1, 0); sq_vd_p4s(k, "min(1)\0", 6); };
                sq_vd_op("Copy\0", 7, 4, 0);
                rbase = 9;
            };
            sq_sb_free(@kt);
            k = sq_vd_op("DecrJumpZero\0", 5, 0, 0);
            VD_P2[k] = VD_N;
            VD_P2[once] = VD_N;
            sq_vd_op("Return\0", 3, a + 1, 1);
            cmp = sq_vd_op(nm, 4, 0, 1);
            sq_vd_p4s(cmp, "BINARY-8\0", 8);
            VD_P5[cmp] = 81;
            VD_NMEM = rbase - 1 + nres;
            for (k = 0; k < nres; k++)
            {
                if (sq_vd_expr(g, ti, b.rc[k], rbase + k) != 0) { if (sq_vd_gon(313) == 1) { sq_seterr(st, "EXPLAIN is not available for this expression #313\0"); return 1; }; };
            };
            sq_vd_op("ResultRow\0", rbase, nres, 0);
            VD_P2[ni] = VD_N; VD_P2[cmp] = VD_N;
            k = sq_vd_op("Next\0", 0, body, 0);
            VD_P5[k] = 1;
            VD_P2[rew] = VD_N;
            sq_vd_op("Halt\0", 0, 0, 0);
            VD_P2[init] = VD_N;
            sq_vd_trans(st.db, 0);
            sq_vd_op("Goto\0", 0, 1, 0);
            return 0;
        };

        // WHERE [NOT] EXISTS (SELECT .. FROM other [WHERE leadcol >|>= const]) with no correlation
        def sq_vd_exist(SQ_STMT* st, SQ_STMT* g) -> int
        {
            SQ_BLK* b = g.blks[g.root_blk];
            SQ_BLK* sb;
            SQ_SRC* sr = @b.src[0];
            SQ_SRC* s2;
            SQ_TI* ti = sr.ti;
            SQ_TI* t2;
            SQ_NODE* w = @g.nodes[b.where_n];
            SQ_NODE* nd;
            SQ_NODE* cw;
            SQ_IDX cix;
            SQ_IDX[12] lix;
            SQ_SB kt;
            int icx, k, i, init, a, rew, nres, maxc, neg, ex, ucov, sroot, nix, bi, col, body, sub, rd, rt, rn, rc, lo, ln, once, seek, dj, rb, nxt, r1, r2, mk;
            neg = 0;
            ex = b.where_n;
            if (w.kind == SQN_UNARY & w.op == 2) { neg = 1; ex = w.a; };
            if (g.nodes[ex].kind != SQN_EXISTS) { return 2; };
            w = @g.nodes[ex];
            sb = g.blks[w.blk];
            if (sr.kind != 1 | sr.tbl < 0 | (u64)ti == (u64)0) { return 2; };
            if (ti.wor != 0 | b.nsrc != 1 | b.cnext >= 0 | b.distinct != 0 | b.ngrp != 0 | b.having >= 0 | b.nord > 0 | b.limit_n >= 0 | b.has_agg != 0 | b.nwin != 0 | b.ncte != 0) { return 2; };
            if (sb.nsrc != 1 | sb.cnext >= 0 | sb.distinct != 0 | sb.ngrp != 0 | sb.having >= 0 | sb.nord > 0 | sb.limit_n >= 0 | sb.has_agg != 0 | sb.nwin != 0 | sb.ncte != 0) { return 2; };
            s2 = @sb.src[0];
            if (s2.kind != 1 | s2.tbl < 0 | (u64)s2.ti == (u64)0) { return 2; };
            t2 = s2.ti;
            if (t2.wor != 0) { return 2; };
            nres = b.nres;
            if (nres < 1 | nres > 12) { return 2; };
            maxc = 0 - 1;
            for (k = 0; k < nres; k++)
            {
                nd = @g.nodes[b.rc[k]];
                if (nd.kind != SQN_COL | nd.lvl != 0) { return 2; };
                if (nd.col < 0 | nd.col >= ti.ncols) { return 2; };
                if (nd.col != ti.ipk & nd.col > maxc) { maxc = nd.col; };
            };
            if (maxc < 0) { return 2; };
            if (sb.where_n < 0)
            {
                if (neg != 0) { return 2; };
                sroot = g.root_blk;
                g.root_blk = w.blk;
                ucov = sq_vd_cover(g, t2, s2, @cix, 1);
                g.root_blk = sroot;
                if (ucov != 1 & ucov != 0) { return 2; };
                sq_vd_reset();
                init = sq_vd_op("Init\0", 0, 0, 0);
                VD_NMEM = 1; VD_NFREE = 0; VD_NH = 0; VD_NH0 = 0; VD_NJ = 0; VD_COLCUR = 0; VD_IDXCUR = 0;
                ex = sq_vd_op("IfNot\0", 1, 0, 1);
                icx = 3;
                if (ucov == 1)
                {
                    sq_sb_init(@kt);
                    if (sq_vd_kinfo(@cix, @kt) != 0) { sq_sb_free(@kt); sq_seterr(st, "EXPLAIN is not available for this index collation\0"); return 1; };
                    a = sq_vd_op("OpenRead\0", 3, cix.root, 0);
                    sq_vd_p4s(a, kt.p, kt.n);
                    sq_sb_free(@kt);
                }
                else
                {
                    icx = 2;
                    a = sq_vd_op("OpenRead\0", 2, s2.root, 0);
                    sq_vd_p4i(a, (i64)0);
                };
                a = sq_vd_op("OpenRead\0", 0, sr.root, 0);
                sq_vd_p4i(a, (i64)(maxc + 1));
                if (ucov == 1) { rew = sq_vd_op("Rewind\0", 3, 0, 2); sq_vd_p4i(rew, (i64)0); } else { rew = sq_vd_op("Rewind\0", 2, 0, 0); };
                rn = sq_vd_op("Rewind\0", 0, 0, 0);
                body = VD_N;
                VD_NMEM = 1 + nres;
                for (k = 0; k < nres; k++)
                {
                    if (sq_vd_expr(g, ti, b.rc[k], 2 + k) != 0) { if (sq_vd_gon(314) == 1) { sq_seterr(st, "EXPLAIN is not available for this expression #314\0"); return 1; }; };
                };
                sq_vd_op("ResultRow\0", 2, nres, 0);
                a = sq_vd_op("Next\0", 0, body, 0);
                VD_P5[a] = 1;
                dj = sq_vd_op("Goto\0", 0, 0, 0);
                a = sq_vd_op("Next\0", icx, rn, 0);
                VD_P5[a] = 1;
                VD_P2[ex] = VD_N; VD_P2[rew] = VD_N; VD_P2[rn] = VD_N; VD_P2[dj] = VD_N;
                sq_vd_op("Halt\0", 0, 0, 0);
                VD_P2[init] = VD_N;
                sq_vd_trans(st.db, 0);
                sq_vd_op("Integer\0", 1, 1, 0);
                sq_vd_op("Goto\0", 0, 1, 0);
                return 0;
            };
            cw = @g.nodes[sb.where_n];
            if (cw.kind != SQN_BIN | (cw.op != SQO_GT & cw.op != SQO_GE)) { return 2; };
            if (g.nodes[cw.a].kind != SQN_COL | g.nodes[cw.b].kind != SQN_INT) { return 2; };
            col = g.nodes[cw.a].col;
            if (col < 0 | col >= t2.ncols | col == t2.ipk | t2.aff[col] != 0 & t2.aff[col] != 4 & t2.aff[col] != 1 & t2.aff[col] != 2 | t2.coll[col] != 0) { return 2; };
            nix = sq_idx_list(s2.sdb, s2.tbl, t2, @lix[0], 12);
            bi = 0 - 1;
            for (i = 0; i < nix; i++) { if (lix[i].isx[0] == 0 & lix[i].col[0] == col & lix[i].partial == 0 & lix[i].coll[0] == 0 & lix[i].desc[0] == 0 & bi < 0) { bi = i; }; };
            if (bi < 0) { return 2; };
            if (neg == 0)
            {
                sq_vd_reset();
                init = sq_vd_op("Init\0", 0, 0, 0);
                VD_NMEM = 2; VD_NFREE = 0; VD_NH = 0; VD_NH0 = 0; VD_NJ = 0; VD_COLCUR = 0; VD_IDXCUR = 0;
                ex = sq_vd_op("IfNot\0", 1, 0, 1);
                sq_sb_init(@kt);
                if (sq_vd_kinfo(@lix[bi], @kt) != 0) { sq_sb_free(@kt); sq_seterr(st, "EXPLAIN is not available for this index collation\0"); return 1; };
                a = sq_vd_op("OpenRead\0", 3, lix[bi].root, 0);
                sq_vd_p4s(a, kt.p, kt.n);
                sq_sb_free(@kt);
                a = sq_vd_op("OpenRead\0", 0, sr.root, 0);
                sq_vd_p4i(a, (i64)(maxc + 1));
                if (sq_vd_lit(g, cw.b, 2) != 0) { if (sq_vd_gon(315) == 1) { sq_seterr(st, "EXPLAIN is not available for this expression #315\0"); return 1; }; };
                if (cw.op == SQO_GT) { seek = sq_vd_op("SeekGT\0", 3, 0, 2); } else { seek = sq_vd_op("SeekGE\0", 3, 0, 2); };
                sq_vd_p4i(seek, (i64)1);
                rn = sq_vd_op("Rewind\0", 0, 0, 0);
                body = VD_N;
                VD_NMEM = 2 + nres;
                for (k = 0; k < nres; k++)
                {
                    if (sq_vd_expr(g, ti, b.rc[k], 3 + k) != 0) { if (sq_vd_gon(316) == 1) { sq_seterr(st, "EXPLAIN is not available for this expression #316\0"); return 1; }; };
                };
                sq_vd_op("ResultRow\0", 3, nres, 0);
                a = sq_vd_op("Next\0", 0, body, 0);
                VD_P5[a] = 1;
                dj = sq_vd_op("Goto\0", 0, 0, 0);
                a = sq_vd_op("Next\0", 3, rn, 0);
                VD_P2[ex] = VD_N; VD_P2[seek] = VD_N; VD_P2[rn] = VD_N; VD_P2[dj] = VD_N;
                sq_vd_op("Halt\0", 0, 0, 0);
                VD_P2[init] = VD_N;
                sq_vd_trans(st.db, 0);
                sq_vd_op("Integer\0", 1, 1, 0);
                sq_vd_op("Goto\0", 0, 1, 0);
                return 0;
            };
            sq_vd_reset();
            init = sq_vd_op("Init\0", 0, 0, 0);
            VD_NMEM = 6; VD_NFREE = 0; VD_NH = 0; VD_NH0 = 0; VD_NJ = 0; VD_COLCUR = 0; VD_IDXCUR = 0;
            a = sq_vd_op("OpenRead\0", 0, sr.root, 0);
            sq_vd_p4i(a, (i64)(maxc + 1));
            rew = sq_vd_op("Rewind\0", 0, 0, 0);
            sub = sq_vd_op("BeginSubrtn\0", 0, 2, 0);
            once = sq_vd_op("Once\0", 0, 0, 0);
            sq_vd_op("Integer\0", 0, 3, 0);
            sq_vd_op("Integer\0", 1, 4, 0);
            sq_sb_init(@kt);
            if (sq_vd_kinfo(@lix[bi], @kt) != 0) { sq_sb_free(@kt); sq_seterr(st, "EXPLAIN is not available for this index collation\0"); return 1; };
            a = sq_vd_op("OpenRead\0", 2, lix[bi].root, 0);
            sq_vd_p4s(a, kt.p, kt.n);
            sq_sb_free(@kt);
            if (sq_vd_lit(g, cw.b, 5) != 0) { if (sq_vd_gon(317) == 1) { sq_seterr(st, "EXPLAIN is not available for this expression #317\0"); return 1; }; };
            if (cw.op == SQO_GT) { seek = sq_vd_op("SeekGT\0", 2, 0, 5); } else { seek = sq_vd_op("SeekGE\0", 2, 0, 5); };
            sq_vd_p4i(seek, (i64)1);
            body = sq_vd_op("Integer\0", 1, 3, 0);
            a = sq_vd_op("DecrJumpZero\0", 4, 0, 0);
            rd = a;
            a = sq_vd_op("Next\0", 2, body, 0);
            VD_P2[seek] = VD_N; VD_P2[rd] = VD_N; VD_P2[once] = VD_N;
            sq_vd_op("Return\0", 2, sub + 1, 1);
            if (neg != 0) { rc = sq_vd_op("If\0", 3, 0, 1); } else { rc = sq_vd_op("IfNot\0", 3, 0, 1); };
            VD_NMEM = 6 + nres;
            for (k = 0; k < nres; k++)
            {
                if (sq_vd_expr(g, ti, b.rc[k], 7 + k) != 0) { if (sq_vd_gon(318) == 1) { sq_seterr(st, "EXPLAIN is not available for this expression #318\0"); return 1; }; };
            };
            sq_vd_op("ResultRow\0", 7, nres, 0);
            VD_P2[rc] = VD_N;
            a = sq_vd_op("Next\0", 0, sub, 0);
            VD_P5[a] = 1;
            VD_P2[rew] = VD_N;
            sq_vd_op("Halt\0", 0, 0, 0);
            VD_P2[init] = VD_N;
            sq_vd_trans(st.db, 0);
            sq_vd_op("Goto\0", 0, 1, 0);
            return 0;
        };

        // WITH RECURSIVE r(n) AS (SELECT k UNION [ALL] SELECT n op k FROM r WHERE n cmp k) SELECT n FROM r
        def sq_vd_recur(SQ_STMT* st, SQ_STMT* g) -> int
        {
            SQ_BLK* b = g.blks[g.root_blk];
            SQ_BLK* sb;
            SQ_BLK* ab;
            SQ_NODE* nd;
            SQ_NODE* ex;
            SQ_NODE* cw;
            int ci, k, init, a, qh, out, uni, endc, yl, hd, wop, aop, ic, ic2, f1, f2, cmpi;
            byte* cm;
            byte* ar;
            if (b.nsrc != 1 | b.src[0].kind != 2 | b.src[0].cte < 0 | b.src[0].selfref != 0) { return 2; };
            if (b.where_n >= 0 | b.cnext >= 0 | b.distinct != 0 | b.ngrp != 0 | b.having >= 0 | b.nord > 0 | b.limit_n >= 0 | b.has_agg != 0 | b.nwin != 0) { return 2; };
            if (b.nres != 1) { return 2; };
            nd = @g.nodes[b.rc[0]];
            if (nd.kind != SQN_COL | nd.lvl != 0 | nd.col != 0) { return 2; };
            ci = b.src[0].cte;
            sb = g.blks[b.src[0].blk];
            if (sb.rec != ci + 1) { return 2; };
            if (sb.cnext < 0 | sb.nsrc != 0 | sb.nres != 1 | sb.where_n >= 0) { return 2; };
            ab = g.blks[sb.cnext];
            if (ab.cnext >= 0 | (ab.cop != 1 & ab.cop != 2) | ab.nsrc != 1 | ab.nres != 1 | ab.where_n < 0) { return 2; };
            if (ab.src[0].selfref != 1 | ab.ngrp != 0 | ab.having >= 0 | ab.nord > 0 | ab.limit_n >= 0 | ab.distinct != 0 | ab.has_agg != 0) { return 2; };
            if (g.nodes[sb.rc[0]].kind != SQN_INT) { return 2; };
            ex = @g.nodes[ab.rc[0]];
            if (ex.kind != SQN_BIN | (ex.op != SQO_ADD & ex.op != SQO_SUB & ex.op != SQO_MUL)) { return 2; };
            if (g.nodes[ex.a].kind != SQN_COL | g.nodes[ex.b].kind != SQN_INT) { return 2; };
            cw = @g.nodes[ab.where_n];
            if (cw.kind != SQN_BIN | cw.op < SQO_LT | cw.op > SQO_GE) { return 2; };
            if (g.nodes[cw.a].kind != SQN_COL | g.nodes[cw.b].kind != SQN_INT) { return 2; };
            if (cw.op == SQO_LT) { cm = "Ge\0"; };
            if (cw.op == SQO_LE) { cm = "Gt\0"; };
            if (cw.op == SQO_GT) { cm = "Le\0"; };
            if (cw.op == SQO_GE) { cm = "Lt\0"; };
            if (ex.op == SQO_ADD) { ar = "Add\0"; };
            if (ex.op == SQO_SUB) { ar = "Subtract\0"; };
            if (ex.op == SQO_MUL) { ar = "Multiply\0"; };
            uni = 0;
            if (ab.cop == 1) { uni = 1; };
            sq_vd_reset();
            init = sq_vd_op("Init\0", 0, 0, 0);
            VD_NMEM = 9; VD_NFREE = 0; VD_NH = 0; VD_NH0 = 0; VD_NJ = 0; VD_COLCUR = 0; VD_IDXCUR = 0;
            endc = sq_vd_op("InitCoroutine\0", 1, 0, 0);
            VD_P3[endc] = VD_N;
            sq_vd_op("OpenPseudo\0", 1, 2, 1);
            sq_vd_op("OpenEphemeral\0", 2, 1, 0);
            if (uni == 1) { a = sq_vd_op("OpenEphemeral\0", 3, 1, 0); sq_vd_p4s(a, "k(1,B)\0", 6); };
            if (sq_vd_lit(g, sb.rc[0], 3) != 0) { if (sq_vd_gon(319) == 1) { sq_seterr(st, "EXPLAIN is not available for this expression #319\0"); return 1; }; };
            a = sq_vd_op("MakeRecord\0", 3, 1, 4);
            if (uni == 1)
            {
                f1 = sq_vd_op("Found\0", 3, 0, 4);
                sq_vd_p4i(f1, (i64)0);
                a = sq_vd_op("IdxInsert\0", 3, 4, 3);
                sq_vd_p4i(a, (i64)1);
            };
            sq_vd_op("NewRowid\0", 2, 5, 0);
            a = sq_vd_op("Insert\0", 2, 4, 5);
            VD_P5[a] = 8;
            if (uni == 1) { VD_P2[f1] = VD_N; };
            qh = sq_vd_op("Rewind\0", 2, 0, 0);
            hd = sq_vd_op("NullRow\0", 1, 0, 0);
            sq_vd_op("RowData\0", 2, 2, 0);
            sq_vd_op("Delete\0", 2, 0, 0);
            sq_vd_op("Column\0", 1, 0, 6);
            sq_vd_op("Yield\0", 1, 0, 0);
            sq_vd_op("Column\0", 1, 0, 4);
            cmpi = sq_vd_op(cm, 7, 0, 4);
            sq_vd_p4s(cmpi, "BINARY-8\0", 8);
            VD_P5[cmpi] = 80;
            sq_vd_op("Column\0", 1, 0, 4);
            sq_vd_op(ar, 8, 4, 3);
            sq_vd_op("MakeRecord\0", 3, 1, 4);
            if (uni == 1)
            {
                f2 = sq_vd_op("Found\0", 3, 0, 4);
                sq_vd_p4i(f2, (i64)0);
                a = sq_vd_op("IdxInsert\0", 3, 4, 3);
                sq_vd_p4i(a, (i64)1);
            };
            sq_vd_op("NewRowid\0", 2, 5, 0);
            a = sq_vd_op("Insert\0", 2, 4, 5);
            VD_P5[a] = 8;
            VD_P2[cmpi] = VD_N;
            if (uni == 1) { VD_P2[f2] = VD_N; };
            sq_vd_op("Goto\0", 0, qh, 0);
            VD_P2[qh] = VD_N;
            sq_vd_op("EndCoroutine\0", 1, 0, 0);
            VD_P2[endc] = VD_N;
            a = sq_vd_op("InitCoroutine\0", 1, 0, 2);
            yl = sq_vd_op("Yield\0", 1, 0, 0);
            a = sq_vd_op("Copy\0", 6, 9, 0);
            VD_P5[a] = 2;
            sq_vd_op("ResultRow\0", 9, 1, 0);
            sq_vd_op("Goto\0", 0, yl, 0);
            VD_P2[yl] = VD_N;
            sq_vd_op("Halt\0", 0, 0, 0);
            VD_P2[init] = VD_N;
            if (sq_vd_lit(g, cw.b, 7) != 0) { if (sq_vd_gon(320) == 1) { sq_seterr(st, "EXPLAIN is not available for this expression #320\0"); return 1; }; };
            if (sq_vd_lit(g, ex.b, 8) != 0) { if (sq_vd_gon(321) == 1) { sq_seterr(st, "EXPLAIN is not available for this expression #321\0"); return 1; }; };
            sq_vd_op("Goto\0", 0, 1, 0);
            return 0;
        };

        // col IN (SELECT col2 FROM other) with no index to serve as the set: the values go to an ephemeral index behind a bloom filter
        def sq_vd_insubE(SQ_STMT* st, SQ_STMT* g) -> int
        {
            SQ_BLK* b = g.blks[g.root_blk];
            SQ_BLK* sb;
            SQ_SRC* sr = @b.src[0];
            SQ_SRC* s2;
            SQ_TI* ti = sr.ti;
            SQ_TI* t2;
            SQ_NODE* w = @g.nodes[b.where_n];
            SQ_NODE* nd;
            SQ_IDX cix;
            SQ_SB kt;
            int i, k, xcol, scol, init, a, rew, body, once, nf, nxt, nres, ni, fl, ucov, irew, ibody, sroot, bl, pos, maxc, mc2, bsig;
            nd = @g.nodes[w.a];
            xcol = nd.col;
            sb = g.blks[w.blk];
            s2 = @sb.src[0];
            t2 = s2.ti;
            scol = g.nodes[sb.rc[0]].col;
            if (t2.aff[scol] != 0 | t2.coll[scol] != 0) { return 2; };
            nres = b.nres;
            if (nres < 1 | nres > 12) { return 2; };
            maxc = xcol;
            for (k = 0; k < nres; k++)
            {
                nd = @g.nodes[b.rc[k]];
                if (nd.kind != SQN_COL | nd.lvl != 0) { return 2; };
                if (nd.col < 0 | nd.col >= ti.ncols) { return 2; };
                if (nd.col != ti.ipk & nd.col > maxc) { maxc = nd.col; };
            };
            sroot = g.root_blk;
            g.root_blk = w.blk;
            ucov = sq_vd_cover(g, t2, s2, @cix, 0);
            g.root_blk = sroot;
            sq_vd_reset();
            init = sq_vd_op("Init\0", 0, 0, 0);
            VD_NMEM = 2; VD_NFREE = 0; VD_NH = 0; VD_NH0 = 0; VD_NJ = 0; VD_COLCUR = 0; VD_IDXCUR = 0;
            a = sq_vd_op("OpenRead\0", 0, sr.root, 0);
            sq_vd_p4i(a, (i64)(maxc + 1));
            rew = sq_vd_op("Rewind\0", 0, 0, 0);
            body = sq_vd_op("BeginSubrtn\0", 0, 1, 0);
            sq_vd_p4s(body, "subrtnsig:1,A\0", 13);
            once = sq_vd_op("Once\0", 0, 0, 2);
            a = sq_vd_op("OpenEphemeral\0", 2, 1, 0);
            sq_vd_p4s(a, "k(1,B)\0", 6);
            a = sq_vd_op("Blob\0", 10000, 2, 0);
            if (ucov == 1)
            {
                sq_sb_init(@kt);
                if (sq_vd_kinfo(@cix, @kt) != 0) { sq_sb_free(@kt); sq_seterr(st, "EXPLAIN is not available for this index collation\0"); return 1; };
                a = sq_vd_op("OpenRead\0", 3, cix.root, 0);
                sq_vd_p4s(a, kt.p, kt.n);
                sq_sb_free(@kt);
                irew = sq_vd_op("Rewind\0", 3, 0, 3);
                sq_vd_p4i(irew, (i64)0);
                pos = 0;
                for (i = 0; i < cix.nk; i++) { if (cix.col[i] == scol & pos == 0) { pos = i; }; };
                if (cix.col[0] == scol) { pos = 0; };
                ibody = sq_vd_op("Column\0", 3, pos, 3);
            }
            else
            {
                a = sq_vd_op("OpenRead\0", 3, s2.root, 0);
                sq_vd_p4i(a, (i64)(scol + 1));
                irew = sq_vd_op("Rewind\0", 3, 0, 0);
                ibody = sq_vd_op("Column\0", 3, scol, 3);
            };
            a = sq_vd_op("MakeRecord\0", 3, 1, 4);
            sq_vd_p4s(a, "A\0", 1);
            sq_vd_op("IdxInsert\0", 2, 4, 3);
            VD_P4[VD_N - 1] = 0;
            sq_vd_p4i(VD_N - 1, (i64)1);
            sq_vd_op("FilterAdd\0", 2, 0, 3);
            sq_vd_p4i(VD_N - 1, (i64)1);
            a = sq_vd_op("Next\0", 3, ibody, 0);
            VD_P5[a] = 1;
            VD_P2[irew] = VD_N;
            sq_vd_op("NullRow\0", 2, 0, 0);
            VD_P2[once] = VD_N;
            sq_vd_op("Return\0", 1, 4, 1);
            sq_vd_op("Column\0", 0, xcol, 5);
            a = sq_vd_op("Affinity\0", 5, 1, 0);
            sq_vd_p4s(a, "A\0", 1);
            ni = sq_vd_op("IsNull\0", 5, 0, 0);
            fl = sq_vd_op("Filter\0", 2, 0, 5);
            sq_vd_p4i(fl, (i64)1);
            nf = sq_vd_op("NotFound\0", 2, 0, 5);
            sq_vd_p4i(nf, (i64)1);
            VD_NMEM = 5 + nres;
            for (k = 0; k < nres; k++)
            {
                if (sq_vd_expr(g, ti, b.rc[k], 6 + k) != 0) { if (sq_vd_gon(322) == 1) { sq_seterr(st, "EXPLAIN is not available for this expression #322\0"); return 1; }; };
            };
            sq_vd_op("ResultRow\0", 6, nres, 0);
            nxt = VD_N;
            a = sq_vd_op("Next\0", 0, body, 0);
            VD_P5[a] = 1;
            VD_P2[ni] = nxt; VD_P2[fl] = nxt; VD_P2[nf] = nxt;
            VD_P2[rew] = VD_N;
            sq_vd_op("Halt\0", 0, 0, 0);
            VD_P2[init] = VD_N;
            sq_vd_trans(st.db, 0);
            sq_vd_op("Goto\0", 0, 1, 0);
            return 0;
        };

        // SELECT of plain columns from one table WHERE col IN (SELECT col2 FROM other) when col2 leads an index of the other table
        // and col has no index: the index is the membership set. 2 when the query is not of that shape
        // WHERE rowid IN (SELECT col FROM other): the subquery fills an ephemeral index, each of its values is looked up by rowid
        def sq_vd_inrk(SQ_STMT* st, SQ_STMT* g) -> int
        {
            SQ_BLK* b = g.blks[g.root_blk];
            SQ_BLK* sb;
            SQ_SRC* sr = @b.src[0];
            SQ_SRC* s2;
            SQ_TI* ti = sr.ti;
            SQ_TI* t2;
            SQ_NODE* w = @g.nodes[b.where_n];
            SQ_NODE* nd;
            SQ_IDX cix;
            SQ_SB kt;
            SQ_NODE* wn; int sh, sop, i, k, init, a, rew, once, nxt, nres, ni, ucov, irew, ibody, sroot, pos, maxc, scol, bs, sk, rb, tcn;
            tcn = 3;
            sb = g.blks[w.blk];
            s2 = @sb.src[0];
            t2 = s2.ti;
            scol = g.nodes[sb.rc[0]].col;
            if (t2.coll[scol] != 0) { return 2; };
            nres = b.nres;
            if (nres < 1 | nres > 12) { return 2; };
            maxc = 0 - 1;
            for (k = 0; k < nres; k++)
            {
                nd = @g.nodes[b.rc[k]];
                if (nd.kind != SQN_COL | nd.lvl != 0) { return 2; };
                if (nd.col < 0 | nd.col >= ti.ncols) { return 2; };
                if (nd.col != ti.ipk & nd.col > maxc) { maxc = nd.col; };
            };
            sroot = g.root_blk;
            g.root_blk = w.blk;
            ucov = sq_vd_cover(g, t2, s2, @cix, 0);
            g.root_blk = sroot;
            sh = 0; sop = 0;
            if (sb.where_n >= 0)
            {
                wn = @g.nodes[sb.where_n];
                if (ucov != 1 | wn.kind != SQN_BIN) { return 2; };
                if (wn.op == SQO_GT) { sop = 1; };
                if (wn.op == SQO_GE) { sop = 2; };
                if (sop == 0) { return 2; };
                if (g.nodes[wn.a].kind != SQN_COL) { return 2; };
                if (g.nodes[wn.a].col != cix.col[0] | cix.col[0] != scol) { return 2; };
                if (sq_vd_isconst(g, wn.b) == false | g.nodes[wn.b].kind != SQN_INT) { return 2; };
                if (t2.aff[scol] != 0 | cix.coll[0] != 0 | cix.desc[0] != 0 | cix.isx[0] != 0) { return 2; };
                sh = 1;
            };
            sq_vd_reset();
            init = sq_vd_op("Init\0", 0, 0, 0);
            VD_NMEM = 3; VD_NFREE = 0; VD_NH = 0; VD_NH0 = 0; VD_NJ = 0; VD_COLCUR = 0; VD_IDXCUR = 0;
            a = sq_vd_op("OpenRead\0", 0, sr.root, 0);
            sq_vd_p4i(a, (i64)(maxc + 1));
            bs = sq_vd_op("BeginSubrtn\0", 0, 2, 0);
            sq_vd_p4s(bs, "subrtnsig:1,C\0", 13);
            once = sq_vd_op("Once\0", 0, 0, 0);
            a = sq_vd_op("OpenEphemeral\0", 2, 1, 0);
            sq_vd_p4s(a, "k(1,B)\0", 6);
            if (ucov == 1)
            {
                sq_sb_init(@kt);
                if (sq_vd_kinfo(@cix, @kt) != 0) { sq_sb_free(@kt); sq_seterr(st, "EXPLAIN is not available for this index collation\0"); return 1; };
                a = sq_vd_op("OpenRead\0", 3, cix.root, 0);
                sq_vd_p4s(a, kt.p, kt.n);
                sq_sb_free(@kt);
                if (sh == 1)
                {
                    if (sq_vd_lit(g, wn.b, 3) != 0) { return 2; };
                    if (sop == 1) { irew = sq_vd_op("SeekGT\0", 3, 0, 3); } else { irew = sq_vd_op("SeekGE\0", 3, 0, 3); };
                    sq_vd_p4i(irew, (i64)1);
                }
                else
                {
                    irew = sq_vd_op("Rewind\0", 3, 0, 3);
                    sq_vd_p4i(irew, (i64)0);
                };
                pos = 0;
                for (i = cix.nk - 1; i >= 0; i--) { if (cix.col[i] == scol) { pos = i; }; };
                ibody = sq_vd_op("Column\0", 3, pos, 3 + sh);
            }
            else
            {
                tcn = 1;
                a = sq_vd_op("OpenRead\0", 1, s2.root, 0);
                sq_vd_p4i(a, (i64)(scol + 1));
                irew = sq_vd_op("Rewind\0", 1, 0, 0);
                ibody = sq_vd_op("Column\0", 1, scol, 3);
            };
            a = sq_vd_op("MakeRecord\0", 3 + sh, 1, 4 + sh);
            sq_vd_p4s(a, "C\0", 1);
            sq_vd_op("IdxInsert\0", 2, 4 + sh, 3 + sh);
            VD_P4[VD_N - 1] = 0;
            sq_vd_p4i(VD_N - 1, (i64)1);
            a = sq_vd_op("Next\0", tcn, ibody, 0);
            if (sh == 0) { VD_P5[a] = 1; };
            VD_P2[irew] = VD_N;
            sq_vd_op("NullRow\0", 2, 0, 0);
            VD_P2[once] = VD_N;
            sq_vd_op("Return\0", 2, bs + 1, 1);
            rew = sq_vd_op("Rewind\0", 2, 0, 0);
            ibody = sq_vd_op("Column\0", 2, 0, 1);
            ni = sq_vd_op("IsNull\0", 1, 0, 0);
            sk = sq_vd_op("SeekRowid\0", 0, 0, 1);
            rb = 5 + sh;
            VD_NMEM = 4 + sh + nres;
            for (k = 0; k < nres; k++)
            {
                if (sq_vd_expr(g, ti, b.rc[k], rb + k) != 0) { if (sq_vd_gon(323) == 1) { sq_seterr(st, "EXPLAIN is not available for this expression #323\0"); return 1; }; };
            };
            sq_vd_op("ResultRow\0", rb, nres, 0);
            nxt = VD_N;
            a = sq_vd_op("Next\0", 2, ibody, 0);
            VD_P2[ni] = nxt; VD_P2[sk] = nxt;
            VD_P2[rew] = VD_N;
            sq_vd_op("Halt\0", 0, 0, 0);
            VD_P2[init] = VD_N;
            sq_vd_trans(st.db, 0);
            sq_vd_op("Goto\0", 0, 1, 0);
            return 0;
        };

        def sq_vd_insub(SQ_STMT* st, SQ_STMT* g) -> int
        {
            SQ_BLK* b = g.blks[g.root_blk];
            SQ_BLK* sb;
            SQ_SRC* sr = @b.src[0];
            SQ_SRC* s2;
            SQ_TI* ti = sr.ti;
            SQ_TI* t2;
            SQ_NODE* w = @g.nodes[b.where_n];
            SQ_NODE* nd;
            SQ_IDX[12] ixs;
            SQ_IDX[12] oxs;
            SQ_SB kt;
            int i, j, k, nix, nox, bi, maxc, xcol, scol, init, a, rew, body, once, nf, nxt, nres, ni;
            if (w.kind == SQN_IN & w.blk < 0 & w.b >= 0 & w.op != 2 & sr.kind == 1 & sr.tbl >= 0 & (u64)ti != (u64)0) { if (ti.wor == 0 & b.nsrc == 1 & b.cnext < 0 & b.distinct == 0 & b.ngrp == 0 & b.having < 0 & b.nord == 0 & b.limit_n < 0 & b.has_agg == 0 & b.nwin == 0 & b.ncte == 0) { return sq_vd_inlist(st, g); }; };
            if (w.kind == SQN_IN & w.blk >= 0 & w.op == 2 & sr.kind == 1 & sr.tbl >= 0 & (u64)ti != (u64)0) { if (ti.wor == 0 & b.nsrc == 1 & b.cnext < 0 & b.distinct == 0 & b.ngrp == 0 & b.having < 0 & b.nord == 0 & b.limit_n < 0 & b.has_agg == 0 & b.nwin == 0 & b.ncte == 0) { return sq_vd_notin(st, g); }; };
            if (w.kind != SQN_IN | w.blk < 0 | w.op == 2 | sr.kind != 1 | sr.tbl < 0 | (u64)ti == (u64)0) { return 2; };
            if (ti.wor != 0 | b.nsrc != 1 | b.cnext >= 0 | b.distinct != 0 | b.ngrp != 0 | b.having >= 0 | b.nord > 0 | b.limit_n >= 0 | b.has_agg != 0 | b.nwin != 0 | b.ncte != 0) { return 2; };
            nd = @g.nodes[w.a];
            if (nd.kind != SQN_COL | nd.lvl != 0) { return 2; };
            xcol = nd.col;
            if (xcol < 0 | xcol >= ti.ncols | (xcol == ti.ipk & ti.ipk < 0) | (xcol != ti.ipk & ti.aff[xcol] != 0) | ti.coll[xcol] != 0) { return 2; };
            sb = g.blks[w.blk];
            if (sb.nsrc != 1 | sb.nres != 1 | (sb.where_n >= 0 & xcol != ti.ipk) | sb.cnext >= 0 | sb.distinct != 0 | sb.ngrp != 0 | sb.having >= 0 | sb.nord > 0 | sb.limit_n >= 0 | sb.has_agg != 0 | sb.nwin != 0 | sb.ncte != 0) { return 2; };
            s2 = @sb.src[0];
            if (s2.kind != 1 | s2.tbl < 0 | (u64)s2.ti == (u64)0) { return 2; };
            t2 = s2.ti;
            if (t2.wor != 0) { return 2; };
            nd = @g.nodes[sb.rc[0]];
            if (nd.kind != SQN_COL) { return 2; };
            scol = nd.col;
            if (xcol == ti.ipk) { if (scol < 0 | scol >= t2.ncols | scol == t2.ipk) { return 2; }; return sq_vd_inrk(st, g); };
            if (scol == t2.ipk & scol >= 0 & ti.aff[xcol] == 0 & ti.coll[xcol] == 0) { return sq_vd_inrowid(st, g); };
            if (scol < 0 | scol >= t2.ncols | scol == t2.ipk) { return 2; };
            nox = sq_idx_list(sr.sdb, sr.tbl, ti, @oxs[0], 12);
            for (i = 0; i < nox; i++) { if (oxs[i].isx[0] == 0 & oxs[i].col[0] == xcol) { return sq_vd_inix(st, g); }; };
            nix = sq_idx_list(s2.sdb, s2.tbl, t2, @ixs[0], 12);
            bi = 0 - 1;
            for (i = nix - 1; i >= 0 & bi < 0; i--)
            {
                if (ixs[i].partial != 0 | ixs[i].isx[0] != 0 | ixs[i].col[0] != scol | ixs[i].coll[0] != 0 | ixs[i].desc[0] != 0) { continue; };
                bi = i;
            };
            if (bi < 0) { return sq_vd_insubE(st, g); };
            nres = b.nres;
            if (nres < 1 | nres > 15) { return 2; };
            maxc = xcol;
            for (k = 0; k < nres; k++)
            {
                nd = @g.nodes[b.rc[k]];
                if (nd.kind != SQN_COL | nd.lvl != 0) { return 2; };
                if (nd.col < 0 | nd.col >= ti.ncols) { return 2; };
                if (nd.col != ti.ipk & nd.col > maxc) { maxc = nd.col; };
            };
            sq_vd_reset();
            init = sq_vd_op("Init\0", 0, 0, 0);
            VD_NMEM = 1; VD_NFREE = 0; VD_NH = 0; VD_NH0 = 0; VD_NJ = 0; VD_COLCUR = 0; VD_IDXCUR = 0;
            a = sq_vd_op("OpenRead\0", 0, sr.root, 0);
            sq_vd_p4i(a, (i64)(maxc + 1));
            rew = sq_vd_op("Rewind\0", 0, 0, 0);
            body = sq_vd_op("Once\0", 0, 0, 0);
            sq_sb_init(@kt);
            if (sq_vd_kinfo(@ixs[bi], @kt) != 0) { sq_sb_free(@kt); sq_seterr(st, "EXPLAIN is not available for this index collation\0"); return 1; };
            a = sq_vd_op("OpenRead\0", 2, ixs[bi].root, 0);
            sq_vd_p4s(a, kt.p, kt.n);
            sq_sb_free(@kt);
            VD_P2[body] = VD_N;
            sq_vd_op("Column\0", 0, xcol, 1);
            a = sq_vd_op("Affinity\0", 1, 1, 0);
            sq_vd_p4s(a, "A\0", 1);
            ni = sq_vd_op("IsNull\0", 1, 0, 0);
            nf = sq_vd_op("NotFound\0", 2, 0, 1);
            sq_vd_p4i(nf, (i64)1);
            VD_NMEM = 1 + nres;
            for (k = 0; k < nres; k++)
            {
                if (sq_vd_expr(g, ti, b.rc[k], 2 + k) != 0) { if (sq_vd_gon(324) == 1) { sq_seterr(st, "EXPLAIN is not available for this expression #324\0"); return 1; }; };
            };
            sq_vd_op("ResultRow\0", 2, nres, 0);
            nxt = VD_N;
            a = sq_vd_op("Next\0", 0, body, 0);
            VD_P5[a] = 1;
            VD_P2[ni] = nxt; VD_P2[nf] = nxt;
            VD_P2[rew] = VD_N;
            sq_vd_op("Halt\0", 0, 0, 0);
            VD_P2[init] = VD_N;
            sq_vd_trans(st.db, 0);
            sq_vd_op("Goto\0", 0, 1, 0);
            return 0;
        };

        // uncorrelated scalar subqueries (count(*), min, max over an indexed column) in the select list of one table
        def sq_vd_scsel(SQ_STMT* st, SQ_STMT* g) -> int
        {
            SQ_BLK* b = g.blks[g.root_blk];
            SQ_BLK* sb;
            SQ_SRC* sr = @b.src[0];
            SQ_SRC* s2;
            SQ_TI* ti = sr.ti;
            SQ_TI* t2;
            SQ_NODE* nd;
            SQ_NODE* fn;
            SQ_IDX cix;
            SQ_SB kt;
            SQ_IDX oix; SQ_IDX[12] lix; int ocv, oc, nlx, q;
            int[12] fidv;
            int[12] posv;
            int k, i, nres, nsub, maxc, init, a, rew, body, once, rs, rv, fl, cur, sroot, ucov, irew, ibody, fid, pos, acol, bs, nxt;
            if (sr.kind != 1 | sr.tbl < 0 | (u64)ti == (u64)0) { return 2; };
            if (ti.wor != 0 | b.nsrc != 1 | b.where_n >= 0 | b.cnext >= 0 | b.distinct != 0 | b.ngrp != 0 | b.having >= 0 | b.nord > 0 | b.limit_n >= 0 | b.has_agg != 0 | b.nwin != 0 | b.ncte != 0) { return 2; };
            nres = b.nres;
            if (nres < 1 | nres > 6) { return 2; };
            nsub = 0; maxc = 0 - 1;
            for (k = 0; k < nres; k++)
            {
                nd = @g.nodes[b.rc[k]];
                if (nd.kind == SQN_SUBQ) { nsub++; continue; };
                if (nd.kind != SQN_COL | nd.lvl != 0) { return 2; };
                if (nd.col < 0 | nd.col >= ti.ncols) { return 2; };
                if (nd.col != ti.ipk & nd.col > maxc) { maxc = nd.col; };
            };
            if (nsub < 1) { return 2; };
            ocv = sq_vd_cover(g, ti, sr, @oix, 0);
            sq_vd_reset();
            init = sq_vd_op("Init\0", 0, 0, 0);
            VD_NMEM = nres; VD_NFREE = 0; VD_NH = 0; VD_NH0 = 0; VD_NJ = 0; VD_COLCUR = 0; VD_IDXCUR = 0;
            cur = 1 + nsub;
            oc = 0;
            if (ocv == 1)
            {
                oc = cur; cur++;
                a = sq_vd_op("OpenRead\0", oc, oix.root, 0);
                sq_sb_init(@kt);
                if (sq_vd_kinfo(@oix, @kt) != 0) { sq_sb_free(@kt); sq_seterr(st, "EXPLAIN is not available for this index collation\0"); return 1; };
                sq_vd_p4s(a, kt.p, kt.n);
                sq_sb_free(@kt);
                rew = sq_vd_op("Rewind\0", oc, 0, 1);
                sq_vd_p4i(rew, (i64)0);
                VD_COLCUR = oc; VD_IDXCUR = oc;
                sq_vd_setix(@oix);
            }
            else
            {
                a = sq_vd_op("OpenRead\0", 0, sr.root, 0);
                sq_vd_p4i(a, (i64)(maxc + 1));
                rew = sq_vd_op("Rewind\0", 0, 0, 0);
            };
            body = VD_N;
            rs = nres + 1;
            for (k = 0; k < nres; k++)
            {
                nd = @g.nodes[b.rc[k]];
                if (nd.kind != SQN_SUBQ)
                {
                    if (sq_vd_expr(g, ti, b.rc[k], 1 + k) != 0) { if (sq_vd_gon(325) == 1) { sq_seterr(st, "EXPLAIN is not available for this expression #325\0"); return 1; }; };
                    continue;
                };
                sb = g.blks[nd.blk];
                if (sb.nsrc != 1 | sb.nres != 1 | sb.where_n >= 0 | sb.cnext >= 0 | sb.distinct != 0 | sb.ngrp != 0 | sb.having >= 0 | sb.nord > 0 | sb.limit_n >= 0 | sb.nwin != 0 | sb.ncte != 0) { return 2; };
                s2 = @sb.src[0];
                if (s2.kind != 1 | s2.tbl < 0 | (u64)s2.ti == (u64)0) { return 2; };
                t2 = s2.ti;
                if (t2.wor != 0) { return 2; };
                fn = @g.nodes[sb.rc[0]];
                if (fn.kind != SQN_FUNC) { return 2; };
                fid = sq_func_id(@g.sql[fn.s], fn.sl, (int)fn.iv);
                acol = 0 - 1;
                if (fid == 100) { if (fn.op != 2) { return 2; }; }
                else
                {
                    if (fid != 104 & fid != 105) { return 2; };
                    if (fn.op != 0) { return 2; };
                    nd = @g.nodes[fn.a];
                    if (nd.kind != SQN_COL | nd.lvl != 0) { return 2; };
                    acol = nd.col;
                    if (acol < 0 | acol >= t2.ncols | acol == t2.ipk | t2.coll[acol] != 0) { return 2; };
                    nlx = sq_idx_list(s2.sdb, s2.tbl, t2, @lix[0], 12);
                    for (q = 0; q < nlx; q++) { if (lix[q].partial == 0 & lix[q].nk > 0) { if (lix[q].col[0] == acol) { return 2; }; }; };
                };
                sroot = g.root_blk;
                g.root_blk = g.nodes[b.rc[k]].blk;
                if (fid == 100) { ucov = sq_vd_cover(g, t2, s2, @cix, 1); } else { ucov = sq_vd_cover(g, t2, s2, @cix, 0); };
                g.root_blk = sroot;
                if (ucov != 1) { return 2; };
                pos = 0 - 1;
                if (fid != 100)
                {
                    for (i = cix.nk - 1; i >= 0; i--) { if (cix.col[i] == acol) { pos = i; }; };
                    if (pos < 0) { return 2; };
                };
                rv = rs + 1; fl = rs + 2;
                bs = sq_vd_op("BeginSubrtn\0", 0, rs, 0);
                once = sq_vd_op("Once\0", 0, 0, 0);
                sq_vd_op("Null\0", 0, rv, rv);
                sq_vd_op("Integer\0", 1, fl, 0);
                sq_sb_init(@kt);
                if (sq_vd_kinfo(@cix, @kt) != 0) { sq_sb_free(@kt); sq_seterr(st, "EXPLAIN is not available for this index collation\0"); return 1; };
                if (fid == 100)
                {
                    a = sq_vd_op("OpenRead\0", cur, cix.root, 0);
                    sq_vd_p4s(a, kt.p, kt.n);
                    sq_vd_op("Count\0", cur, rs + 3, 0);
                    sq_vd_op("Close\0", cur, 0, 0);
                    sq_vd_op("Copy\0", rs + 3, rv, 0);
                    nxt = rs + 4;
                }
                else
                {
                    sq_vd_op("Null\0", 0, rs + 3, rs + 4);
                    a = sq_vd_op("OpenRead\0", cur, cix.root, 0);
                    sq_vd_p4s(a, kt.p, kt.n);
                    irew = sq_vd_op("Rewind\0", cur, 0, rs + 5);
                    sq_vd_p4i(irew, (i64)0);
                    ibody = sq_vd_op("Column\0", cur, pos, rs + 5);
                    a = sq_vd_op("CollSeq\0", 0, 0, 0);
                    sq_vd_p4s(a, "BINARY-8\0", 8);
                    if (fid == 105) { a = sq_vd_op("AggStep\0", 0, rs + 5, rs + 4); sq_vd_p4s(a, "max(1)\0", 6); } else { a = sq_vd_op("AggStep\0", 0, rs + 5, rs + 4); sq_vd_p4s(a, "min(1)\0", 6); };
                    VD_P5[a] = 1;
                    a = sq_vd_op("Next\0", cur, ibody, 0);
                    VD_P5[a] = 1;
                    VD_P2[irew] = VD_N;
                    if (fid == 105) { a = sq_vd_op("AggFinal\0", rs + 4, 1, 0); sq_vd_p4s(a, "max(1)\0", 6); } else { a = sq_vd_op("AggFinal\0", rs + 4, 1, 0); sq_vd_p4s(a, "min(1)\0", 6); };
                    sq_vd_op("Copy\0", rs + 4, rv, 0);
                    nxt = rs + 6;
                };
                sq_sb_free(@kt);
                a = sq_vd_op("DecrJumpZero\0", fl, 0, 0);
                VD_P2[a] = VD_N;
                VD_P2[once] = VD_N;
                sq_vd_op("Return\0", rs, bs + 1, 1);
                sq_vd_op("Copy\0", rv, 1 + k, 0);
                rs = nxt;
                cur++;
            };
            sq_vd_op("ResultRow\0", 1, nres, 0);
            a = sq_vd_op("Next\0", oc, body, 0);
            VD_P5[a] = 1;
            VD_P2[rew] = VD_N;
            sq_vd_op("Halt\0", 0, 0, 0);
            VD_P2[init] = VD_N;
            sq_vd_trans(st.db, 0);
            sq_vd_op("Goto\0", 0, 1, 0);
            return 0;
        };

        // x IN (single constant) is the same as x = constant: rewrite the node so every planner sees an equality
        def sq_vd_in1(SQ_STMT* g, int ni) -> void
        {
            SQ_NODE* nd;
            if (ni < 0) { return; };
            nd = @g.nodes[ni];
            if (nd.kind == SQN_BIN)
            {
                if (nd.op == SQO_AND | nd.op == SQO_OR) { sq_vd_in1(g, nd.a); sq_vd_in1(g, nd.b); };
                return;
            };
            if (nd.kind == SQN_IN)
            {
                if (nd.op != 1 | nd.blk >= 0 | nd.b < 0 | nd.a < 0) { return; };
                if (g.nodes[nd.b].next >= 0) { return; };
                if (sq_vd_isconst(g, nd.b) == false) { return; };
                if (g.nodes[nd.b].kind == SQN_NULL) { return; };
                if (g.nodes[nd.a].kind != SQN_COL & g.nodes[nd.a].kind != SQN_ROWID) { return; };
                nd.kind = SQN_BIN;
                nd.op = SQO_EQ;
            };
        };

        // more than one index could serve a range term and nothing is pinned: the cost choice is not modelled
        // 1 when the term holds no aggregate or subquery
        def sq_vd_noagg(SQ_STMT* g, int ni) -> int
        {
            SQ_NODE* nd;
            int i;
            if (ni < 0) { return 1; };
            nd = @g.nodes[ni];
            if (nd.kind == SQN_INT | nd.kind == SQN_STR | nd.kind == SQN_REAL | nd.kind == SQN_NULL | nd.kind == SQN_COL) { return 1; };
            if (nd.kind == SQN_BIN | nd.kind == SQN_ISNULL | nd.kind == SQN_BETWEEN | nd.kind == SQN_LIKE | (nd.kind == SQN_UNARY & nd.op == 2))
            {
                if (sq_vd_noagg(g, nd.a) == 0) { return 0; };
                if (sq_vd_noagg(g, nd.b) == 0) { return 0; };
                if (sq_vd_noagg(g, nd.c) == 0) { return 0; };
                return 1;
            };
            if (nd.kind == SQN_IN)
            {
                if (nd.blk >= 0) { return 0; };
                if (sq_vd_noagg(g, nd.a) == 0) { return 0; };
                for (i = nd.b; i >= 0; i = g.nodes[i].next) { if (sq_vd_noagg(g, i) == 0) { return 0; }; };
                return 1;
            };
            return 0;
        };

        // HAVING terms without aggregates are WHERE terms
        def sq_vd_havwhere(SQ_STMT* g, SQ_BLK* b) -> void
        {
            int[16] hj;
            int[16] mv;
            int[16] kp;
            int nh, nm, nk, i, cur, t;
            if (b.having < 0) { return; };
            nh = 0;
            sq_vd_split(g, b.having, @hj[0], @nh);
            nm = 0; nk = 0;
            for (i = 0; i < nh; i++)
            {
                if (sq_vd_noagg(g, hj[i]) == 1) { mv[nm] = hj[i]; nm++; } else { kp[nk] = hj[i]; nk++; };
            };
            if (nm == 0) { return; };
            cur = mv[0];
            for (i = 1; i < nm; i++)
            {
                t = sq_newnode(g, SQN_BIN);
                if (t < 0) { return; };
                g.nodes[t] = g.nodes[mv[0]]; g.nodes[t].kind = SQN_BIN; g.nodes[t].op = SQO_AND; g.nodes[t].a = cur; g.nodes[t].b = mv[i]; g.nodes[t].c = 0 - 1; g.nodes[t].next = 0 - 1;
                cur = t;
            };
            if (b.where_n < 0) { b.where_n = cur; }
            else
            {
                t = sq_newnode(g, SQN_BIN);
                if (t < 0) { return; };
                g.nodes[t] = g.nodes[cur]; g.nodes[t].kind = SQN_BIN; g.nodes[t].op = SQO_AND; g.nodes[t].a = b.where_n; g.nodes[t].b = cur; g.nodes[t].c = 0 - 1; g.nodes[t].next = 0 - 1;
                b.where_n = t;
            };
            if (nk == 0) { b.having = 0 - 1; return; };
            cur = kp[0];
            for (i = 1; i < nk; i++)
            {
                t = sq_newnode(g, SQN_BIN);
                if (t < 0) { return; };
                g.nodes[t] = g.nodes[kp[0]]; g.nodes[t].kind = SQN_BIN; g.nodes[t].op = SQO_AND; g.nodes[t].a = cur; g.nodes[t].b = kp[i]; g.nodes[t].c = 0 - 1; g.nodes[t].next = 0 - 1;
                cur = t;
            };
            b.having = cur;
        };

        // emit a residual term; two halves of one BETWEEN that are both residual are emitted as the BETWEEN
        def sq_vd_wherep(SQ_STMT* g, SQ_TI* ti, int* cj, int ncj, int* used, int* pi) -> int
        {
            int i, nb;
            i = *pi;
            if (i + 1 < ncj)
            {
                if (g.nodes[cj[i]].kind == SQN_BIN & g.nodes[cj[i]].iv == (i64)7771 & g.nodes[cj[i + 1]].iv == (i64)7772 & used[i + 1] == 0)
                {
                    nb = sq_newnode(g, SQN_BETWEEN);
                    if (nb >= 0)
                    {
                        g.nodes[nb] = g.nodes[cj[i]];
                        g.nodes[nb].kind = SQN_BETWEEN; g.nodes[nb].op = 1; g.nodes[nb].iv = (i64)0;
                        g.nodes[nb].a = g.nodes[cj[i]].a; g.nodes[nb].b = g.nodes[cj[i]].b; g.nodes[nb].c = g.nodes[cj[i + 1]].b;
                        *pi = i + 1;
                        return sq_vd_where(g, ti, nb);
                    };
                };
            };
            return sq_vd_where(g, ti, cj[i]);
        };

        // 1 when some index of the table holds the column
        def sq_vd_colinidx(SQ_SRC* sr, SQ_TI* ti, int col) -> int
        {
            SQ_IDX[12] ixl;
            int a, k, nix;
            nix = sq_idx_list(sr.sdb, sr.tbl, ti, @ixl[0], 12);
            for (a = 0; a < nix; a++)
            {
                for (k = 0; k < ixl[a].nk; k++) { if (ixl[a].col[k] == col) { return 1; }; };
            };
            return 0;
        };

        // a LIKE term next to rowid terms or terms on unindexed columns, on a query no index covers
        def sq_vd_likeok(SQ_STMT* g, SQ_BLK* b, int* wj, int n, int li) -> int
        {
            SQ_SRC* sr = @b.src[0];
            SQ_TI* ti = sr.ti;
            SQ_NODE* nd;
            SQ_IDX[12] ixl;
            int i, a, nix, lc, c;
            if (b.nsrc != 1 | sr.kind != 1 | sr.tbl < 0 | (u64)ti == (u64)0) { return 0; };
            if (ti.ipk < 0 | ti.wor != 0 | b.has_agg != 0 | b.nord != 0 | b.distinct != 0 | b.ngrp != 0) { return 0; };
            if (g.nodes[g.nodes[wj[li]].a].kind != SQN_COL) { return 0; };
            lc = g.nodes[g.nodes[wj[li]].a].col;
            if (lc == ti.ipk | lc >= ti.ncols) { return 0; };
            nix = sq_idx_list(sr.sdb, sr.tbl, ti, @ixl[0], 12);
            for (i = 0; i < n; i++)
            {
                if (i == li) { continue; };
                nd = @g.nodes[wj[i]];
                if (nd.kind != SQN_BIN & nd.kind != SQN_BETWEEN) { return 0; };
                if (g.nodes[nd.a].kind != SQN_COL) { return 0; };
                c = g.nodes[nd.a].col;
                if (c == ti.ipk) { continue; };
                if (c == lc) { return 0; };
                for (a = 0; a < nix; a++) { if (ixl[a].col[0] == c) { return 0; }; };
            };
            for (a = 0; a < nix; a++) { if (ixl[a].col[0] == lc & ixl[a].partial == 0) { if (sq_vd_covers1(g, ti, sr, @ixl[a]) == 1) { return 0; }; }; };
            return 1;
        };

        def sq_vd_ambig(SQ_STMT* g, SQ_TI* ti, SQ_SRC* sr, int wn) -> int
        {
            int[16] cj;
            int[16] rc;
            SQ_IDX[12] ixl;
            SQ_NODE* nd;
            int n, i, a, nr, nix, cand, pin, c;
            if (sr.tbl < 0) { return 0; };
            sq_vd_split(g, wn, @cj[0], @n);
            nr = 0; pin = 0;
            for (i = 0; i < n; i++)
            {
                nd = @g.nodes[cj[i]];
                c = 0 - 1;
                if (nd.kind == SQN_BETWEEN) { if (g.nodes[nd.a].kind == SQN_COL) { c = g.nodes[nd.a].col; }; if (c >= 0 & nr < 16) { rc[nr] = c; nr++; }; continue; };
                if (nd.kind == SQN_ISNULL | nd.kind == SQN_IN) { pin = 1; continue; };
                if (nd.kind != SQN_BIN) { continue; };
                if (g.nodes[nd.a].kind != SQN_COL) { continue; };
                c = g.nodes[nd.a].col;
                if (nd.op == SQO_EQ | nd.op == SQO_IS) { pin = 1; continue; };
                if (nd.op == SQO_GT | nd.op == SQO_GE | nd.op == SQO_LT | nd.op == SQO_LE) { if (nr < 16) { rc[nr] = c; nr++; }; };
            };
            if (pin == 1 | nr < 2) { return 0; };
            nix = sq_idx_list(sr.sdb, sr.tbl, ti, @ixl[0], 12);
            cand = 0;
            for (i = 0; i < nr; i++)
            {
                c = 0;
                for (a = 0; a < i; a++) { if (rc[a] == rc[i]) { c = 1; }; };
                if (c == 1) { continue; };
                if (rc[i] == ti.ipk) { cand++; continue; };
                for (a = 0; a < nix; a++) { if (ixl[a].partial == 0 & ixl[a].isx[0] == 0 & ixl[a].col[0] == rc[i]) { cand++; a = nix; }; };
            };
            if (cand >= 2 & cand == 2 & ti.ipk >= 0 & ti.wor == 0 & sq_vd_gon(786) == 0)
            {
                // rowid range against one indexed column range: a rowid range bounded on both sides always wins,
                // a one sided rowid range wins over a one sided index range
                a = 0; c = 0 - 1;
                for (i = 0; i < nr; i++) { if (rc[i] != ti.ipk) { c = rc[i]; }; };
                nr = 0; pin = 0;
                for (i = 0; i < n; i++)
                {
                    nd = @g.nodes[cj[i]];
                    if (nd.kind == SQN_BETWEEN) { if (g.nodes[nd.a].kind == SQN_COL) { if (g.nodes[nd.a].col == ti.ipk) { a = a | 3; }; if (g.nodes[nd.a].col == c) { pin = pin | 3; }; }; continue; };
                    if (nd.kind != SQN_BIN) { continue; };
                    if (g.nodes[nd.a].kind != SQN_COL) { continue; };
                    if (g.nodes[nd.a].col == ti.ipk) { if (nd.op == SQO_GT | nd.op == SQO_GE) { a = a | 1; }; if (nd.op == SQO_LT | nd.op == SQO_LE) { a = a | 2; }; };
                    if (g.nodes[nd.a].col == c) { if (nd.op == SQO_GT | nd.op == SQO_GE) { pin = pin | 1; }; if (nd.op == SQO_LT | nd.op == SQO_LE) { pin = pin | 2; }; };
                };
                nr = 0;
                if (g.blks[g.root_blk].nord > 0) { nr = 1; };
                for (i = 0; i < nix; i++) { if (ixl[i].col[0] == c & ixl[i].partial == 0) { if (sq_vd_covers1(g, ti, sr, @ixl[i]) == 1) { nr = 1; }; }; };
                if (nr == 0)
                {
                    if (a == 3) { return 0; };
                    if (pin != 3) { return 0; };
                };
            };
            if (cand >= 2) { return 1; };
            return 0;
        };

        // sorter items in read order: result columns that are not keys, then the keys; with a LIMIT the keys come first
        def sq_vd_srtitems(SQ_BLK* b, int sof, int srl, int* itn, int* itr) -> int
        {
            int i, n, sh;
            n = 0; sh = 1;
            if (srl == 1) { sh = 2; };
            if (srl == 1)
            {
                for (i = 0; i < VD_SK_NK; i++) { itn[n] = VD_SKN[i]; itr[n] = sof + 1 + i; n++; };
            };
            for (i = 0; i < b.nres; i++)
            {
                if (VD_SKP[i] >= VD_SK_NK) { itn[n] = b.rc[i]; itr[n] = sof + sh + VD_SKP[i]; n++; };
            };
            if (srl == 0)
            {
                for (i = 0; i < VD_SK_NK; i++) { itn[n] = VD_SKN[i]; itr[n] = sof + 1 + i; n++; };
            };
            return n;
        };

        // the bounded sorter: keep only the best LIMIT rows; returns the IdxLE instruction to patch
        def sq_vd_srtseq(int sof, int ho) -> int
        {
            int sq, ifn, ile, lim;
            sq = sq_vd_op("Sequence\0", 1, sof + VD_SK_NK + 1, 0);
            lim = 1;
            if (ho == 1) { lim = 3; };
            ifn = sq_vd_op("IfNotZero\0", lim, 0, 0);
            sq_vd_op("Last\0", 1, 0, 0);
            ile = sq_vd_op("IdxLE\0", 1, 0, sof + 1);
            sq_vd_p4i(ile, (i64)VD_SK_NK);
            sq_vd_op("Delete\0", 1, 0, 0);
            VD_P2[ifn] = VD_N;
            return ile;
        };

        // the output half of a sorter: run the sorted rows through ResultRow
        def sq_vd_srtout(SQ_BLK* b, int srl, int ho, int ors, int sof, int pcs) -> void
        {
            int i, ssr, sdn, obs, ip, a, ob;
            if (srl == 0)
            {
                obs = sof + VD_SK_NK + 1;
                sq_vd_op("OpenPseudo\0", pcs, ors + 1, VD_SK_NK + b.nres + 1);
                ssr = sq_vd_op("SorterSort\0", 1, 0, 0);
                sdn = sq_vd_op("SorterData\0", 1, ors + 1, pcs);
                for (i = b.nres - 1; i >= 0; i--) { sq_vd_op("Column\0", pcs, VD_SKP[i], obs + i); };
                sq_vd_op("ResultRow\0", obs, b.nres, 0);
                sq_vd_op("SorterNext\0", 1, sdn, 0);
                VD_P2[ssr] = VD_N;
                return;
            };
            ob = sof + VD_SK_NK + 2;
            ssr = sq_vd_op("Sort\0", 1, 0, 0);
            sdn = VD_N;
            ip = 0 - 1;
            if (ho == 1)
            {
                ip = sq_vd_op("IfPos\0", 2, 0, 1);
                sq_vd_op("AddImm\0", 1, 0 - 1, 0);
            };
            for (i = b.nres - 1; i >= 0; i--)
            {
                if (VD_SKP[i] < VD_SK_NK) { sq_vd_op("Column\0", 1, VD_SKP[i], ob + i); } else { sq_vd_op("Column\0", 1, VD_SKP[i] + 1, ob + i); };
            };
            sq_vd_op("ResultRow\0", ob, b.nres, 0);
            a = sq_vd_op("Next\0", 1, sdn, 0);
            if (ho == 1) { VD_P2[ip] = a; };
            VD_P2[ssr] = VD_N;
            return;
        };

        // col IN (SELECT x FROM u) where the outer table cannot be driven by an index: scan it and probe the IN list for every row
        def sq_vd_inprobe(SQ_STMT* st, SQ_STMT* g) -> int
        {
            SQ_BLK* b = g.blks[g.root_blk];
            SQ_BLK* sb = g.blks[VD_INSB];
            SQ_SRC* sr = @b.src[0];
            SQ_SRC* s2 = @sb.src[0];
            SQ_TI* ti = sr.ti;
            SQ_TI* t2 = s2.ti;
            SQ_NODE* nd;
            SQ_IDX cix;
            SQ_IDX[12] dix;
            SQ_IDX ocx;
            SQ_SB kt;
            byte[4] ab;
            int init, a, k, nres, maxc, lcol, la, ca, ia, nixd, nd2, dsel, c1, sroot, ucov, bg, on, rw, ra, sc, p, key, ocv, rbase, hlf, bl, nxa, nxb, nxc, rew0, direct, body;
            nres = b.nres;
            if (nres < 1 | nres > 12) { if (sq_vd_gon(326) == 1) { sq_seterr(st, "EXPLAIN is not available for this IN subquery #326\0"); return 1; }; };
            lcol = g.nodes[g.nodes[b.where_n].a].col;
            la = ti.aff[lcol]; ca = t2.aff[VD_INC];
            ia = 65;
            if (la >= 2 | ca >= 2) { ia = 67; };
            maxc = lcol;
            for (k = 0; k < nres; k++)
            {
                nd = @g.nodes[b.rc[k]];
                if (nd.kind != SQN_COL | nd.lvl != 0) { if (sq_vd_gon(327) == 1) { sq_seterr(st, "EXPLAIN is not available for this IN subquery #327\0"); return 1; }; };
                if (nd.col < 0 | nd.col >= ti.ncols) { if (sq_vd_gon(328) == 1) { sq_seterr(st, "EXPLAIN is not available for this IN subquery #328\0"); return 1; }; };
                if (nd.col != ti.ipk & nd.col > maxc) { maxc = nd.col; };
            };
            if (lcol == ti.ipk) { if (sq_vd_gon(329) == 1) { sq_seterr(st, "EXPLAIN is not available for this IN subquery #329\0"); return 1; }; };
            ocv = sq_vd_cover(g, ti, sr, @ocx, 0);
            if (ocv != 0) { if (sq_vd_gon(330) == 1) { sq_seterr(st, "EXPLAIN is not available for this IN subquery #330\0"); return 1; }; };
            // an index of the subquery table led by the selected column serves as the IN list directly
            nixd = sq_idx_list(s2.sdb, s2.tbl, t2, @dix[0], 12);
            nd2 = 0; dsel = 0 - 1;
            for (c1 = 0; c1 < nixd; c1++)
            {
                if (dix[c1].partial != 0 | dix[c1].isx[0] != 0 | dix[c1].col[0] != VD_INC | dix[c1].coll[0] != 0) { continue; };
                if (ia == 67 & ca < 2) { continue; };
                nd2++;
                if (dsel < 0) { dsel = c1; };
            };
            if (nd2 > 1) { if (sq_vd_gon(331) == 1) { sq_seterr(st, "EXPLAIN is not available for this IN subquery #331\0"); return 1; }; };
            direct = 0;
            if (dsel >= 0) { direct = 1; };
            ucov = 0;
            if (direct == 0)
            {
                sroot = g.root_blk;
                g.root_blk = VD_INSB;
                ucov = sq_vd_cover(g, t2, s2, @cix, 0);
                g.root_blk = sroot;
                if (ucov != 0 & ucov != 1) { if (sq_vd_gon(332) == 1) { sq_seterr(st, "EXPLAIN is not available for this IN subquery #332\0"); return 1; }; };
            };
            ab[0] = (byte)ia; ab[1] = (byte)0;
            sq_vd_reset();
            init = sq_vd_op("Init\0", 0, 0, 0);
            VD_NMEM = 0; VD_NFREE = 0; VD_NH = 0; VD_NH0 = 0; VD_NJ = 0; VD_COLCUR = 0; VD_IDXCUR = 0;
            a = sq_vd_op("OpenRead\0", 0, sr.root, 0);
            sq_vd_p4i(a, (i64)(maxc + 1));
            rew0 = sq_vd_op("Rewind\0", 0, 0, 0);
            body = VD_N;
            if (direct == 1)
            {
                key = 1;
                on = sq_vd_op("Once\0", 0, 0, 0);
                a = sq_vd_op("OpenRead\0", 2, dix[dsel].root, 0);
                sq_sb_init(@kt);
                if (sq_vd_kinfo(@dix[dsel], @kt) != 0) { sq_sb_free(@kt); sq_seterr(st, "EXPLAIN is not available for this index collation\0"); return 1; };
                sq_vd_p4s(a, kt.p, kt.n);
                sq_sb_free(@kt);
                VD_P2[on] = VD_N;
                VD_NMEM = 1;
            }
            else
            {
                key = 5;
                bg = sq_vd_op("BeginSubrtn\0", 0, 1, 0);
                sq_sb_init(@kt);
                sq_sb_lit(@kt, "subrtnsig:1,\0");
                sq_sb_add(@kt, @ab[0], 1);
                sq_vd_p4s(bg, kt.p, kt.n);
                sq_sb_free(@kt);
                on = sq_vd_op("Once\0", 0, 0, 2);
                a = sq_vd_op("OpenEphemeral\0", 2, 1, 0);
                sq_vd_p4s(a, "k(1,B)\0", 6);
                sq_vd_op("Blob\0", 10000, 2, 0);
                sc = 1;
                if (ucov == 1)
                {
                    sc = 3;
                    a = sq_vd_op("OpenRead\0", sc, cix.root, 0);
                    sq_sb_init(@kt);
                    if (sq_vd_kinfo(@cix, @kt) != 0) { sq_sb_free(@kt); sq_seterr(st, "EXPLAIN is not available for this index collation\0"); return 1; };
                    sq_vd_p4s(a, kt.p, kt.n);
                    sq_sb_free(@kt);
                    p = 0 - 1;
                    for (c1 = cix.nk - 1; c1 >= 0; c1--) { if (cix.col[c1] == VD_INC) { p = c1; }; };
                    if (p < 0) { if (sq_vd_gon(333) == 1) { sq_seterr(st, "EXPLAIN is not available for this subquery #333\0"); return 1; }; };
                    rw = sq_vd_op("Rewind\0", sc, 0, 3);
                    sq_vd_p4i(rw, (i64)0);
                }
                else
                {
                    a = sq_vd_op("OpenRead\0", sc, s2.root, 0);
                    sq_vd_p4i(a, (i64)(VD_INC + 1));
                    p = VD_INC;
                    rw = sq_vd_op("Rewind\0", sc, 0, 0);
                };
                ra = VD_N;
                sq_vd_op("Column\0", sc, p, 3);
                if (ucov == 0) { if (t2.aff[VD_INC] == 4) { sq_vd_op("RealAffinity\0", 3, 0, 0); }; };
                a = sq_vd_op("MakeRecord\0", 3, 1, 4);
                sq_vd_p4s(a, @ab[0], 1);
                a = sq_vd_op("IdxInsert\0", 2, 4, 3);
                sq_vd_p4i(a, (i64)1);
                a = sq_vd_op("FilterAdd\0", 2, 0, 3);
                sq_vd_p4i(a, (i64)1);
                a = sq_vd_op("Next\0", sc, ra, 0);
                VD_P5[a] = 1;
                VD_P2[rw] = VD_N;
                sq_vd_op("NullRow\0", 2, 0, 0);
                VD_P2[on] = VD_N;
                sq_vd_op("Return\0", 1, bg + 1, 1);
                VD_NMEM = 5;
            };
            sq_vd_colr2(ti, lcol, key);
            if (ti.aff[lcol] == 4) { sq_vd_op("RealAffinity\0", key, 0, 0); };
            a = sq_vd_op("Affinity\0", key, 1, 0);
            sq_vd_p4s(a, @ab[0], 1);
            nxa = sq_vd_op("IsNull\0", key, 0, 0);
            nxb = 0 - 1;
            if (direct == 0) { nxb = sq_vd_op("Filter\0", 2, 0, key); sq_vd_p4i(nxb, (i64)1); };
            nxc = sq_vd_op("NotFound\0", 2, 0, key);
            sq_vd_p4i(nxc, (i64)1);
            rbase = VD_NMEM + 1;
            VD_NMEM = VD_NMEM + nres;
            for (k = 0; k < nres; k++)
            {
                if (sq_vd_expr(g, ti, b.rc[k], rbase + k) != 0) { if (sq_vd_gon(334) == 1) { sq_seterr(st, "EXPLAIN is not available for this expression #334\0"); return 1; }; };
            };
            sq_vd_op("ResultRow\0", rbase, nres, 0);
            a = VD_N;
            VD_P2[nxa] = a; VD_P2[nxc] = a;
            if (nxb >= 0) { VD_P2[nxb] = a; };
            a = sq_vd_op("Next\0", 0, body, 0);
            VD_P5[a] = 1;
            VD_P2[rew0] = VD_N;
            sq_vd_op("Halt\0", 0, 0, 0);
            VD_P2[init] = VD_N;
            sq_vd_trans(st.db, 0);
            sq_vd_op("Goto\0", 0, 1, 0);
            return 0;
        };

        // t.col IN (SELECT x FROM u): SQLite fills an ephemeral index once and drives the outer table from it
        def sq_vd_inflat(SQ_STMT* st, SQ_STMT* g) -> int
        {
            SQ_BLK* b = g.blks[g.root_blk];
            SQ_BLK* sb;
            SQ_NODE* w;
            SQ_NODE* nd;
            SQ_NODE* lc;
            SQ_TI* ft;
            SQ_IDX[12] ixo;
            int sbi, kn, en, nixo, okx, i;
            VD_INSUB = 0;
            if (b.where_n < 0 | b.nsrc != 1 | b.cnext >= 0 | b.distinct != 0 | b.ngrp != 0 | b.having >= 0 | b.nord > 0 | b.limit_n >= 0 | b.has_agg != 0 | b.nwin != 0 | b.ncte != 0) { return 0; };
            if (b.src[0].kind != 1 | (u64)b.src[0].ti == (u64)0 | b.src[0].tbl < 0 | b.src[0].ti.wor != 0) { return 0; };
            w = @g.nodes[b.where_n];
            if (w.kind != SQN_IN | w.op == 2 | w.blk < 0) { return 0; };
            lc = @g.nodes[w.a];
            if (lc.kind != SQN_COL | lc.lvl != 0 | lc.src != 0 | lc.col < 0 | lc.col >= b.src[0].ti.ncols) { return 0; };
            sbi = w.blk;
            sb = g.blks[sbi];
            if (sb.is_corr != 0 | sb.nsrc != 1 | sb.cnext >= 0 | sb.distinct != 0 | sb.ngrp != 0 | sb.having >= 0 | sb.nord > 0 | sb.limit_n >= 0 | sb.has_agg != 0 | sb.nwin != 0 | sb.ncte != 0 | sb.where_n >= 0 | sb.nres != 1) { return 0; };
            if (sb.src[0].kind != 1 | (u64)sb.src[0].ti == (u64)0 | sb.src[0].tbl < 0 | sb.src[0].ti.wor != 0) { return 0; };
            nd = @g.nodes[sb.rc[0]];
            if (nd.kind != SQN_COL | nd.lvl != 0 | nd.col < 0 | nd.col >= sb.src[0].ti.ncols) { return 0; };
            if (nd.col == sb.src[0].ti.ipk) { return 2; };
            VD_INSB = sbi; VD_INC = nd.col;
            if (lc.col != b.src[0].ti.ipk)
            {
                nixo = sq_idx_list(b.src[0].sdb, b.src[0].tbl, b.src[0].ti, @ixo[0], 12);
                okx = 0;
                for (i = 0; i < nixo; i++)
                {
                    if (ixo[i].partial != 0 | ixo[i].isx[0] != 0 | ixo[i].col[0] != lc.col | ixo[i].coll[0] != 0) { continue; };
                    if ((b.src[0].ti.aff[lc.col] >= 2 | sb.src[0].ti.aff[nd.col] >= 2) & b.src[0].ti.aff[lc.col] < 2) { continue; };
                    okx = 1;
                };
                if (okx == 0) { return 3; };
            };
            ft = (SQ_TI*)fmalloc((u64)sizeof(SQ_TI));
            if ((u64)ft == (u64)0) { return 0; };
            sq_mcpy((byte*)ft, (byte*)sb.src[0].ti, (int)sizeof(SQ_TI));
            ft.base = (byte*)0;
            ft.ncols = 1; ft.ipk = 0 - 1; ft.rowid_alias = 0 - 1; ft.nix = 0; ft.wor = 0; ft.npk = 0; ft.ngen = 0;
            ft.aff[0] = 0; ft.coll[0] = sb.src[0].ti.coll[nd.col]; ft.notnull[0] = 0;
            sq_mcpy((byte*)@b.src[1], (byte*)@b.src[0], (int)sizeof(SQ_SRC));
            b.src[1].ti = ft; b.src[1].tbl = 0 - 1; b.src[1].jt = 1; b.src[1].on = 0 - 1; b.src[1].natural = 0; b.src[1].nusing = 0;
            b.src[1].root = 0; b.src[1].idxby = 0; b.src[1].as_l = 0; b.src[1].ts = 0; b.src[1].tl = 0;
            kn = sq_newnode(g, SQN_COL);
            g.nodes[kn].src = 1; g.nodes[kn].col = 0; g.nodes[kn].lvl = 0; g.nodes[kn].blk = g.root_blk; g.nodes[kn].owner = g.root_blk; g.nodes[kn].rblk = g.root_blk;
            g.nodes[kn].aff = ft.aff[0]; g.nodes[kn].coll = ft.coll[0];
            en = sq_newnode(g, SQN_BIN);
            g.nodes[en].op = SQO_EQ; g.nodes[en].a = b.where_n; g.nodes[en].b = kn;
            w = @g.nodes[b.where_n];
            g.nodes[en].a = w.a;
            g.nodes[en].aff = 0; g.nodes[en].coll = 0;
            b.nsrc = 2;
            b.where_n = en;
            VD_INSB = sbi; VD_INC = nd.col;
            VD_INSUB = 1;
            return 1;
        };

        // the subroutine that fills the ephemeral index for t.col IN (SELECT x FROM u); returns 0 or 1 (error set)
        def sq_vd_inemit(SQ_STMT* st, SQ_STMT* g, int ephno, int la) -> int
        {
            SQ_BLK* sb = g.blks[VD_INSB];
            SQ_SRC* s2 = @sb.src[0];
            SQ_TI* t2 = s2.ti;
            SQ_IDX cix;
            SQ_SB kt;
            byte[4] ab;
            int sroot, ucov, a, bg, on, rw, ra, ni, ra2, rr, p, ca, ia, c1, sc, nixd, nd2, dsel;
            SQ_IDX[12] dix;
            sroot = g.root_blk;
            g.root_blk = VD_INSB;
            ucov = sq_vd_cover(g, t2, s2, @cix, 0);
            g.root_blk = sroot;
            if (ucov != 0 & ucov != 1) { if (sq_vd_gon(335) == 1) { sq_seterr(st, "EXPLAIN is not available for this subquery #335\0"); return 1; }; };
            ca = t2.aff[VD_INC];
            ia = 65;
            if (la >= 2 | ca >= 2) { ia = 67; };
            VD_INDIR = 0;
            nixd = sq_idx_list(s2.sdb, s2.tbl, t2, @dix[0], 12);
            nd2 = 0; dsel = 0 - 1;
            for (c1 = 0; c1 < nixd; c1++)
            {
                if (dix[c1].partial != 0 | dix[c1].isx[0] != 0 | dix[c1].col[0] != VD_INC | dix[c1].coll[0] != 0) { continue; };
                if (ia == 67 & ca < 2) { continue; };
                if (dix[c1].unique == 0 | dix[c1].nk != 1) { continue; };
                nd2++;
                if (dsel < 0) { dsel = c1; };
            };
            if (nd2 > 1) { if (sq_vd_gon(336) == 1) { sq_seterr(st, "EXPLAIN is not available for this IN subquery #336\0"); return 1; }; };
            if (dsel >= 0)
            {
                VD_INDIR = 1;
                on = sq_vd_op("Once\0", 0, 0, 0);
                a = sq_vd_op("OpenRead\0", ephno, dix[dsel].root, 0);
                sq_sb_init(@kt);
                if (sq_vd_kinfo(@dix[dsel], @kt) != 0) { sq_sb_free(@kt); sq_seterr(st, "EXPLAIN is not available for this index collation\0"); return 1; };
                sq_vd_p4s(a, kt.p, kt.n);
                sq_sb_free(@kt);
                VD_P2[on] = VD_N;
                return 0;
            };
            bg = sq_vd_op("BeginSubrtn\0", 0, 2, 0);
            ab[0] = (byte)ia; ab[1] = (byte)0;
            sq_sb_init(@kt);
            sq_sb_lit(@kt, "subrtnsig:1,\0");
            sq_sb_add(@kt, @ab[0], 1);
            sq_vd_p4s(bg, kt.p, kt.n);
            sq_sb_free(@kt);
            on = sq_vd_op("Once\0", 0, 0, 0);
            a = sq_vd_op("OpenEphemeral\0", ephno, 1, 0);
            sq_sb_init(@kt);
            sq_sb_lit(@kt, "k(1,B)\0");
            sq_vd_p4s(a, kt.p, kt.n);
            sq_sb_free(@kt);
            sc = 1;
            if (ucov == 1)
            {
                sc = ephno + 1;
                a = sq_vd_op("OpenRead\0", sc, cix.root, 0);
                sq_sb_init(@kt);
                if (sq_vd_kinfo(@cix, @kt) != 0) { sq_sb_free(@kt); sq_seterr(st, "EXPLAIN is not available for this index collation\0"); return 1; };
                sq_vd_p4s(a, kt.p, kt.n);
                sq_sb_free(@kt);
                p = 0 - 1;
                for (c1 = cix.nk - 1; c1 >= 0; c1--) { if (cix.col[c1] == VD_INC) { p = c1; }; };
                if (p < 0) { if (sq_vd_gon(337) == 1) { sq_seterr(st, "EXPLAIN is not available for this subquery #337\0"); return 1; }; };
            }
            else
            {
                a = sq_vd_op("OpenRead\0", sc, s2.root, 0);
                sq_vd_p4i(a, (i64)(VD_INC + 1));
                p = VD_INC;
            };
            if (ucov == 1) { rw = sq_vd_op("Rewind\0", sc, 0, 3); sq_vd_p4i(rw, (i64)0); } else { rw = sq_vd_op("Rewind\0", sc, 0, 0); };
            ra = VD_N;
            sq_vd_op("Column\0", sc, p, 3);
            if (ucov == 0) { if (t2.aff[VD_INC] == 4) { sq_vd_op("RealAffinity\0", 3, 0, 0); }; };
            a = sq_vd_op("MakeRecord\0", 3, 1, 4);
            sq_vd_p4s(a, @ab[0], 1);
            a = sq_vd_op("IdxInsert\0", ephno, 4, 3);
            sq_vd_p4i(a, (i64)1);
            a = sq_vd_op("Next\0", sc, ra, 0);
            VD_P5[a] = 1;
            VD_P2[rw] = VD_N;
            sq_vd_op("NullRow\0", ephno, 0, 0);
            VD_P2[on] = VD_N;
            a = sq_vd_op("Return\0", 2, bg + 1, 1);
            return 0;
        };

        // 1 when the top level AND terms of the WHERE fix a whole unique key of the single table of the block with = and a literal
        def sq_vd_oneRow(SQ_STMT* g, SQ_BLK* b, int* wj, int nwj) -> int
        {
            SQ_TI* ti = b.src[0].ti;
            SQ_NODE* c;
            SQ_IDX[12] ixs;
            int[16] have;
            int i, j, k, nix, ok, ot, col;
            for (i = 0; i < 16; i++) { have[i] = 0; };
            for (j = 0; j < nwj; j++)
            {
                c = @g.nodes[wj[j]];
                if (c.kind != SQN_BIN | c.op != SQO_EQ) { continue; };
                if (g.nodes[c.a].kind != SQN_COL | g.nodes[c.a].lvl != 0) { continue; };
                ot = g.nodes[c.b].kind;
                if (ot != SQN_INT & ot != SQN_REAL & ot != SQN_STR) { continue; };
                col = g.nodes[c.a].col;
                if (col >= 0 & col < 16) { have[col] = 1; };
            };
            if (ti.ipk >= 0 & ti.ipk < 16) { if (have[ti.ipk] == 1) { return 1; }; };
            if (ti.wor != 0)
            {
                ok = 1;
                for (i = 0; i < ti.npk; i++) { if (ti.pkc[i] < 0 | ti.pkc[i] >= 16) { ok = 0; } else if (have[ti.pkc[i]] == 0) { ok = 0; }; };
                if (ok == 1 & ti.npk > 0) { return 1; };
            };
            if (b.src[0].tbl < 0) { return 0; };
            nix = sq_idx_list(b.src[0].sdb, b.src[0].tbl, ti, @ixs[0], 12);
            for (k = 0; k < nix; k++)
            {
                if (ixs[k].unique == 0 | ixs[k].partial != 0) { continue; };
                ok = 1;
                for (i = 0; i < ixs[k].nk; i++)
                {
                    if (ixs[k].isx[i] != 0 | ixs[k].coll[i] != 0 | ixs[k].col[i] < 0 | ixs[k].col[i] >= 16) { ok = 0; }
                    else if (have[ixs[k].col[i]] == 0) { ok = 0; };
                };
                if (ok == 1 & ixs[k].nk > 0) { return 1; };
            };
            return 0;
        };

        // a disjunction of equalities of one indexed column with distinct literals is planned by SQLite as an IN list
        def sq_vd_or2in(SQ_STMT* g) -> void
        {
            SQ_BLK* b = g.blks[g.root_blk];
            SQ_NODE* c;
            int[64] wj;
            int[64] lv;
            int[64] cn;
            int nwj, i, j, k, n, ok, col, ot, side, prev, head, nn2, same;
            if (b.nsrc != 1 | b.where_n < 0 | b.cnext >= 0) { return; };
            if (b.src[0].kind != 1 | (u64)b.src[0].ti == (u64)0) { return; };
            sq_vd_split(g, b.where_n, @wj[0], @nwj);
            for (i = 0; i < nwj; i++)
            {
                c = @g.nodes[wj[i]];
                if (c.kind != SQN_BIN | c.op != SQO_OR) { continue; };
                // flatten the OR chain into its leaves
                n = 0; ok = 1;
                lv[0] = wj[i]; k = 1;
                while (k > 0 & ok == 1)
                {
                    k--;
                    c = @g.nodes[lv[k]];
                    if (c.kind == SQN_BIN & c.op == SQO_OR)
                    {
                        if (k + 2 > 60) { ok = 0; } else { lv[k] = c.b; lv[k + 1] = c.a; k = k + 2; };
                    }
                    else { cn[n] = lv[k]; n++; if (n > 60) { ok = 0; }; };
                };
                if (ok == 0 | n < 2) { continue; };
                col = 0 - 1;
                for (j = 0; j < n & ok == 1; j++)
                {
                    c = @g.nodes[cn[j]];
                    if (c.kind != SQN_BIN | c.op != SQO_EQ) { ok = 0; continue; };
                    side = 0 - 1;
                    if (g.nodes[c.a].kind == SQN_COL | g.nodes[c.a].kind == SQN_ROWID) { ot = g.nodes[c.b].kind; if (ot == SQN_INT | ot == SQN_STR) { side = 0; }; };
                    if (side < 0 & (g.nodes[c.b].kind == SQN_COL | g.nodes[c.b].kind == SQN_ROWID)) { ot = g.nodes[c.a].kind; if (ot == SQN_INT | ot == SQN_STR) { side = 1; }; };
                    if (side < 0) { ok = 0; continue; };
                    if (side == 0) { k = c.a; } else { k = c.b; };
                    if (g.nodes[k].kind == SQN_COL) { if (g.nodes[k].lvl != 0 | g.nodes[k].owner != g.root_blk) { ok = 0; continue; }; };
                    ot = g.nodes[k].col;
                    if (g.nodes[k].kind == SQN_ROWID) { ot = b.src[0].ti.ipk; if (ot < 0) { ok = 0; continue; }; };
                    if (col < 0) { col = ot; } else { if (ot != col) { ok = 0; }; };
                };
                if (ok == 0 | col < 0) { continue; };
                // distinct literals only
                same = 0;
                for (j = 0; j < n; j++)
                {
                    for (k = 0; k < j; k++)
                    {
                        c = @g.nodes[cn[j]];
                        if (g.nodes[c.a].kind == SQN_COL | g.nodes[c.a].kind == SQN_ROWID) { ot = c.b; } else { ot = c.a; };
                        c = @g.nodes[cn[k]];
                        if (g.nodes[c.a].kind == SQN_COL | g.nodes[c.a].kind == SQN_ROWID) { prev = c.b; } else { prev = c.a; };
                        if (sq_vd_deq(g, ot, prev) == 1) { same = 1; };
                    };
                };
                if (same == 1) { continue; };
                if (sq_vd_leads(@b.src[0], col) == 0)
                {
                    if (b.src[0].ti.wor == 0) { continue; };
                    if (b.src[0].ti.pkc[0] != col) { continue; };
                };
                // build the IN node in place: lhs is the column node of the first term, then the literal chain
                c = @g.nodes[cn[0]];
                if (g.nodes[c.a].kind == SQN_COL | g.nodes[c.a].kind == SQN_ROWID) { k = c.a; } else { k = c.b; };
                head = 0 - 1; prev = 0 - 1;
                for (j = 0; j < n; j++)
                {
                    c = @g.nodes[cn[j]];
                    if (g.nodes[c.a].kind == SQN_COL | g.nodes[c.a].kind == SQN_ROWID) { ot = c.b; } else { ot = c.a; };
                    g.nodes[ot].next = 0 - 1;
                    if (prev >= 0) { g.nodes[prev].next = ot; } else { head = ot; };
                    prev = ot;
                };
                nn2 = sq_newnode(g, SQN_IN);
                g.nodes[wj[i]] = g.nodes[nn2];
                c = @g.nodes[wj[i]];
                c.op = 1; c.a = k; c.b = head; c.blk = 0 - 1;
            };
        };

        // ORDER BY terms on a column pinned by an equality to a literal (or IS NULL) are dropped by SQLite
        def sq_vd_ordpin(SQ_STMT* g) -> void
        {
            SQ_BLK* b = g.blks[g.root_blk];
            SQ_NODE* nd;
            SQ_NODE* c;
            int[64] wj;
            int nwj, i, j, k, nid, col, pin, o, ot, n0;
            n0 = b.nord;
            if (n0 < 1) { return; };
            for (i = 0; i < n0; i++) { VD_OO[i] = b.ord[i]; VD_OD[i] = b.odesc[i]; VD_OC[i] = b.ocoll[i]; VD_ON[i] = b.onull[i]; };
            if (b.nsrc != 1 | b.cnext >= 0 | (b.distinct != 0 & sq_vd_gon(1010) == 1) | b.ngrp != 0 | b.has_agg != 0 | b.nwin != 0 | b.ncte != 0 | b.where_n < 0 | b.nord < 1) { return; };
            if (b.src[0].kind != 1 | (u64)b.src[0].ti == (u64)0) { return; };
            sq_vd_split(g, b.where_n, @wj[0], @nwj);
            // equalities that fix every column of the rowid, the primary key of a WITHOUT ROWID table or a unique index select at most one row
            if (sq_vd_oneRow(g, b, wj, nwj) == 1) { b.nord = 0; VD_ORDPIN = n0; return; };
            o = 0;
            for (i = 0; i < b.nord; i++)
            {
                pin = 0;
                nid = b.ord[i];
                nd = @g.nodes[nid];
                if (nd.kind == SQN_RESREF) { nid = b.rc[(int)nd.iv]; nd = @g.nodes[nid]; };
                if (nd.kind == SQN_COL & b.ocoll[i] < 0 & nd.lvl == 0 & nd.owner == g.root_blk)
                {
                    col = nd.col;
                    for (j = 0; j < nwj; j++)
                    {
                        c = @g.nodes[wj[j]];
                        if (c.kind == SQN_ISNULL & c.op == 1)
                        {
                            if (g.nodes[c.a].kind == SQN_COL) { if (g.nodes[c.a].col == col & g.nodes[c.a].lvl == 0) { pin = 1; }; };
                        };
                        if (c.kind == SQN_BIN & (c.op == SQO_EQ | c.op == SQO_IS))
                        {
                            if (g.nodes[c.a].kind == SQN_COL & g.nodes[c.a].lvl == 0 & g.nodes[c.a].col == col)
                            {
                                ot = g.nodes[c.b].kind;
                                if (ot == SQN_INT | ot == SQN_REAL | ot == SQN_STR) { pin = 1; };
                            };
                        };
                    };
                };
                if (pin == 1 & b.distinct != 0 & (b.odesc[i] != 0 | n0 != 1)) { pin = 0; };
                if (pin == 1) { continue; };
                b.ord[o] = b.ord[i]; b.odesc[o] = b.odesc[i]; b.ocoll[o] = b.ocoll[i]; b.onull[o] = b.onull[i];
                o++;
            };
            b.nord = o;
            if (o == 0) { VD_ORDPIN = n0; };
            if (o > 0 & o < n0) { VD_PINPART = n0; };
        };

        // X op (Y COLLATE c) compares with the collation c exactly as (X COLLATE c) op Y does
        def sq_vd_colsw(SQ_STMT* g) -> int
        {
            SQ_NODE* nd;
            SQ_NODE* r;
            int i, n0, cn, inner;
            n0 = g.nn;
            for (i = 0; i < n0; i++)
            {
                nd = @g.nodes[i];
                if (nd.kind != SQN_BIN) { continue; };
                if (nd.op == SQO_EQ | nd.op == SQO_NE | nd.op == SQO_LT | nd.op == SQO_LE | nd.op == SQO_GT | nd.op == SQO_GE)
                {
                    if (g.nodes[nd.a].kind == SQN_COLLATE & g.nodes[nd.b].kind != SQN_COLLATE)
                    {
                        if (g.nodes[g.nodes[nd.a].a].kind == SQN_COL)
                        {
                            if (g.nodes[g.nodes[nd.a].a].coll == (int)g.nodes[nd.a].iv) { nd.a = g.nodes[nd.a].a; continue; };
                        };
                    };
                };
                if (nd.op != SQO_EQ & nd.op != SQO_NE & nd.op != SQO_LT & nd.op != SQO_LE & nd.op != SQO_GT & nd.op != SQO_GE) { continue; };
                if (g.nodes[nd.b].kind != SQN_COLLATE | g.nodes[nd.a].kind == SQN_COLLATE) { continue; };
                if (g.nodes[nd.a].kind == SQN_COL)
                {
                    if (g.nodes[nd.a].coll == (int)g.nodes[nd.b].iv) { return 1; };
                };
                cn = sq_newnode(g, SQN_COLLATE);
                nd = @g.nodes[i];
                r = @g.nodes[nd.b];
                inner = r.a;
                g.nodes[cn].iv = r.iv; g.nodes[cn].coll = r.coll; g.nodes[cn].a = nd.a; g.nodes[cn].s = r.s; g.nodes[cn].sl = r.sl;
                g.nodes[cn].aff = g.nodes[nd.a].aff; g.nodes[cn].blk = r.blk; g.nodes[cn].owner = r.owner;
                nd.a = cn; nd.b = inner;
            };
            return 0;
        };

        // a correlated EXISTS over one plain table is planned by SQLite as a nested loop that leaves the inner loop at the first match
        def sq_vd_semi(SQ_STMT* st, SQ_STMT* g) -> int
        {
            SQ_BLK* b = g.blks[g.root_blk];
            SQ_BLK* sb;
            SQ_NODE* w;
            SQ_NODE* nd;
            int ex, other, i, nw, sbi;
            int[16] wjs;
            VD_SEMI = 0;
            if (b.where_n < 0 | b.nsrc != 1 | b.cnext >= 0 | b.distinct != 0 | b.ngrp != 0 | b.having >= 0 | b.nord > 0 | b.limit_n >= 0 | b.has_agg != 0 | b.nwin != 0 | b.ncte != 0) { return 0; };
            if (b.src[0].kind != 1 | (u64)b.src[0].ti == (u64)0 | b.src[0].tbl < 0) { return 0; };
            ex = 0 - 1; other = 0 - 1;
            w = @g.nodes[b.where_n];
            if (w.kind == SQN_EXISTS) { ex = b.where_n; }
            else if (w.kind == SQN_BIN)
            {
                if (w.op == SQO_AND)
                {
                    if (g.nodes[w.a].kind == SQN_EXISTS & g.nodes[w.b].kind == SQN_BIN) { if (g.nodes[w.b].op != SQO_AND & g.nodes[w.b].op != SQO_OR) { ex = w.a; other = w.b; }; };
                    if (g.nodes[w.b].kind == SQN_EXISTS & g.nodes[w.a].kind == SQN_BIN) { if (g.nodes[w.a].op != SQO_AND & g.nodes[w.a].op != SQO_OR) { ex = w.b; other = w.a; }; };
                };
            };
            if (ex < 0) { return 0; };
            sbi = g.nodes[ex].blk;
            if (sbi < 0) { return 0; };
            sb = g.blks[sbi];
            if (sb.is_corr == 0 | sb.nsrc != 1 | sb.cnext >= 0 | sb.distinct != 0 | sb.ngrp != 0 | sb.having >= 0 | sb.nord > 0 | sb.limit_n >= 0 | sb.has_agg != 0 | sb.nwin != 0 | sb.ncte != 0 | sb.where_n < 0) { return 0; };
            if (sb.src[0].kind != 1 | (u64)sb.src[0].ti == (u64)0 | sb.src[0].tbl < 0) { return 0; };
            if (sb.src[0].ti.wor != 0 | b.src[0].ti.wor != 0) { return 0; };
            if (sq_vd_gon(764) == 1)
            {
                nw = 0;
                sq_vd_split(g, sb.where_n, @wjs[0], @nw);
                if (nw > 1) { return 0; };
            };
            for (i = 0; i < g.nn; i++)
            {
                nd = @g.nodes[i];
                if (nd.kind != SQN_COL | nd.owner != sbi) { continue; };
                if (nd.lvl > 1) { return 0; };
            };
            for (i = 0; i < g.nn; i++)
            {
                nd = @g.nodes[i];
                if (nd.kind != SQN_COL | nd.owner != sbi) { continue; };
                if (nd.lvl == 0) { nd.src = 1; nd.rblk = g.root_blk; } else { nd.lvl = 0; };
                nd.owner = g.root_blk;
            };
            sq_mcpy((byte*)@b.src[1], (byte*)@sb.src[0], (int)sizeof(SQ_SRC));
            b.src[1].jt = 3; b.src[1].on = 0 - 1; b.src[1].natural = 0; b.src[1].nusing = 0;
            b.nsrc = 2;
            sb.nsrc = 0;
            if (other < 0) { b.where_n = sb.where_n; }
            else
            {
                nw = sq_newnode(g, SQN_BIN);
                g.nodes[nw].op = SQO_AND; g.nodes[nw].a = other; g.nodes[nw].b = sb.where_n;
                b.where_n = nw;
            };
            VD_SEMI = 1;
            return 1;
        };

        // guard switch: a comment of the form /*G3,7*/ in the statement disables the guards numbered 3 and 7
        def sq_vd_gon(int n) -> int
        {
            int i;
            for (i = 0; i < VD_GOFFN; i++) { if (VD_GOFF[i] == n + 1000) { return 1; }; };
            if (n == 414 | n == 640 | n == 670 | n == 671 | n == 672 | n == 673 | n == 674 | n == 675 | n == 676 | n == 677 | n == 678 | n == 679 | n == 7 | n == 680 | n == 681 | n == 682 | n == 683 | n == 684 | n == 685 | n == 686 | n == 687 | n == 688 | n == 689 | n == 690 | n == 691 | n == 692 | n == 693 | n == 694 | n == 695 | n == 697 | n == 698 | n == 699 | n == 700 | n == 701 | n == 702 | n == 703 | n == 704 | n == 705 | n == 707 | n == 708 | n == 709 | n == 710 | n == 711 | n == 712 | n == 713 | n == 714 | n == 716 | n == 717 | n == 718 | n == 1012 | n == 1011 | n == 1010 | n == 354 | n == 149 | n == 415 | n == 139 | n == 352 | n == 142 | n == 1004 | n == 808 | n == 808 | n == 356 | n == 177 | n == 22 | n == 19 | n == 401 | n == 1002 | n == 1001 | n == 1000 | n == 999 | n == 998 | n == 997 | n == 995 | n == 996 | n == 992 | n == 993 | n == 990 | n == 989 | n == 988 | n == 987 | n == 986 | n == 985 | n == 983 | n == 984 | n == 982 | n == 979 | n == 980 | n == 981 | n == 978 | n == 977 | n == 976 | n == 975 | n == 974 | n == 973 | n == 970 | n == 969 | n == 968 | n == 967 | n == 966 | n == 965 | n == 964 | n == 962 | n == 961 | n == 960 | n == 959 | n == 958 | n == 957 | n == 956 | n == 955 | n == 379 | n == 954 | n == 952 | n == 951 | n == 950 | n == 949 | n == 948 | n == 947 | n == 946 | n == 945 | n == 944 | n == 943 | n == 941 | n == 940 | n == 939 | n == 938 | n == 937 | n == 936 | n == 935 | n == 934 | n == 932 | n == 931 | n == 930 | n == 929 | n == 360 | n == 147 | n == 928 | n == 927 | n == 749 | n == 926 | n == 925 | n == 924 | n == 923 | n == 922 | n == 921 | n == 915 | n == 914 | n == 913 | n == 912 | n == 911 | n == 910 | n == 908 | n == 909 | n == 907 | n == 752 | n == 136 | n == 169 | n == 904 | n == 903 | n == 119 | n == 347 | n == 379 | n == 376 | n == 357 | n == 112 | n == 111 | n == 804 |   n == 775 | n == 768 | n == 799 | n == 798 | n == 797 | n == 796 | n == 795 | n == 794 | n == 793 | n == 791 | n == 790 | n == 789 | n == 788 | n == 355 | n == 787 | n == 786 | n == 344 | n == 781 | n == 780 | n == 777 | n == 766 | n == 765 | n == 763 | n == 761 | n == 762 | n == 758 | n == 754 | n == 755 | n == 757 | n == 175 | n == 176 | n == 738 | n == 732 | n == 728 | n == 725 | n == 722 | n == 350 | n == 351 | n == 641 | n == 30 | n == 620 | n == 377 | n == 610 | n == 163 | n == 164 | n == 601 | n == 602 | n == 2 | n == 16 | n == 17 | n == 18 | n == 31 | n == 33 | n == 358 | n == 144 | n == 138 | n == 348 | n == 134 | n == 341 | n == 190 | n == 137 | n == 133 | n == 345 | n == 212 | n == 224 | n == 234 | n == 216 | n == 230 | n == 220 | n == 231) { return 0; };
            for (i = 0; i < VD_GOFFN; i++) { if (VD_GOFF[i] == n) { return 0; }; };
            VD_LASTG = n;
            return 1;
        };

        def sq_vd_gparse(SQ_STMT* g) -> void
        {
            int i, v, st0, off;
            VD_GOFFN = 0;
            i = 0;
            while (g.sql[i] != (byte)0)
            {
                if (g.sql[i] == (byte)47 & g.sql[i + 1] == (byte)42 & (g.sql[i + 2] == (byte)71 | g.sql[i + 2] == (byte)69))
                {
                    off = 0;
                    if (g.sql[i + 2] == (byte)69) { off = 1000; };
                    i = i + 3;
                    v = 0; st0 = 0;
                    while (g.sql[i] != (byte)0 & g.sql[i] != (byte)42)
                    {
                        if (g.sql[i] >= (byte)48 & g.sql[i] <= (byte)57) { v = v * 10 + (int)g.sql[i] - 48; st0 = 1; }
                        else { if (st0 == 1 & VD_GOFFN < 64) { VD_GOFF[VD_GOFFN] = v + off; VD_GOFFN++; }; v = 0; st0 = 0; };
                        i++;
                    };
                    if (st0 == 1 & VD_GOFFN < 64) { VD_GOFF[VD_GOFFN] = v + off; VD_GOFFN++; };
                }
                else { i++; };
            };
        };

        // 1 when every column the expression reads is held by the index cursor (or is the rowid)
        def sq_vd_idxeval(SQ_STMT* g, SQ_TI* ti, int ni, int depth) -> int
        {
            SQ_NODE* nd;
            int x;
            if (ni < 0) { return 1; };
            if (depth > 12) { return 0; };
            nd = @g.nodes[ni];
            if (nd.kind == SQN_ROWID) { return 1; };
            if (nd.kind == SQN_COL)
            {
                if (nd.lvl != 0 | nd.owner != g.root_blk) { return 0; };
                if (nd.col == ti.ipk | nd.col == ti.ncols) { return 1; };
                if (sq_vd_ixpos(nd.col) >= 0) { return 1; };
                return 0;
            };
            if (sq_vd_idxeval(g, ti, nd.a, depth + 1) == 0) { return 0; };
            for (x = nd.b; x >= 0; x = g.nodes[x].next) { if (sq_vd_idxeval(g, ti, x, depth + 1) == 0) { return 0; }; };
            return 1;
        };

        // 1 when a term that the index alone answers follows a term that needs the table row
        def sq_vd_resord(SQ_STMT* g, SQ_TI* ti, int* cj, int n, int* used) -> int
        {
            int i, seen;
            seen = 0;
            for (i = 0; i < n; i++)
            {
                if (used != (int*)0) { if (used[i] != 0) { continue; }; };
                if (sq_vd_idxeval(g, ti, cj[i], 0) == 1) { if (seen == 1) { return 1; }; } else { seen = 1; };
            };
            return 0;
        };

        // 1 when an OR branch could be answered by an index on the rowid or the leading column of an index
        def sq_vd_orbr(SQ_STMT* g, SQ_TI* ti, SQ_IDX* ixl, int nix, int ni) -> int
        {
            SQ_NODE* nd;
            int k, c;
            if (ni < 0) { return 0; };
            nd = @g.nodes[ni];
            if (nd.kind == SQN_BIN & nd.op == SQO_AND) { if (sq_vd_orbr(g, ti, ixl, nix, nd.a) == 1) { return 1; }; return sq_vd_orbr(g, ti, ixl, nix, nd.b); };
            if (nd.kind == SQN_BIN & (nd.op == SQO_OR | nd.op == SQO_NE)) { return 0; };
            if (nd.kind != SQN_BIN & nd.kind != SQN_ISNULL & nd.kind != SQN_IN & nd.kind != SQN_BETWEEN) { return 0; };
            if (nd.a < 0) { return 0; };
            if (g.nodes[nd.a].kind == SQN_ROWID) { return 1; };
            if (g.nodes[nd.a].kind != SQN_COL) { return 0; };
            c = g.nodes[nd.a].col;
            if (c == ti.ipk | c == ti.ncols) { return 1; };
            for (k = 0; k < nix; k++) { if (ixl[k].partial == 0 & ixl[k].nk > 0 & ixl[k].col[0] == c) { return 1; }; };
            return 0;
        };

        // 1 when every term of an OR in the conjunction could use an index
        def sq_vd_orall(SQ_STMT* g, SQ_TI* ti, SQ_IDX* ixl, int nix, int ni) -> int
        {
            int[8] ot;
            int no, i, ok;
            SQ_NODE* nd;
            if (ni < 0) { return 0; };
            nd = @g.nodes[ni];
            if (nd.kind == SQN_BIN & nd.op == SQO_AND) { if (sq_vd_orall(g, ti, ixl, nix, nd.a) == 1) { return 1; }; return sq_vd_orall(g, ti, ixl, nix, nd.b); };
            if (nd.kind != SQN_BIN | nd.op != SQO_OR) { return 0; };
            no = 0;
            sq_vd_orsplit(g, ni, @ot[0], @no);
            ok = 1;
            for (i = 0; i < no; i++) { if (sq_vd_orbr(g, ti, ixl, nix, ot[i]) == 0) { ok = 0; }; };
            return ok;
        };

        // 1 when the expression tree holds the integer literal 1
        def sq_vd_hasone(SQ_STMT* g, int ni, int depth) -> int
        {
            SQ_NODE* nd;
            int x;
            if (ni < 0 | depth > 12) { return 0; };
            nd = @g.nodes[ni];
            if (nd.kind == SQN_INT & nd.iv == (i64)1) { return 1; };
            if (sq_vd_hasone(g, nd.a, depth + 1) == 1) { return 1; };
            for (x = nd.b; x >= 0; x = g.nodes[x].next) { if (sq_vd_hasone(g, x, depth + 1) == 1) { return 1; }; };
            return 0;
        };

        // 1 when an IS NULL / IS NOT NULL term changes the plan in a way the generic scan does not model
        // 1 when a conjunct other than number skip is an equality or IS NULL test of column col
        def sq_vd_sameq(SQ_STMT* g, int* wj, int nw, int skip, int col) -> int
        {
            int i;
            SQ_NODE* x;
            for (i = 0; i < nw; i++)
            {
                if (i == skip) { continue; };
                x = @g.nodes[wj[i]];
                if (x.kind == SQN_ISNULL) { if (sq_vd_exprcol(g, wj[i]) == col) { return 1; }; };
                if (x.kind != SQN_BIN) { continue; };
                if (x.op != SQO_EQ & x.op != SQO_IS) { continue; };
                if (sq_vd_exprcol(g, wj[i]) == col) { return 1; };
            };
            return 0;
        };

        // 1 when a conjunct other than number skip reads column col
        def sq_vd_ipkother(SQ_STMT* g, SQ_BLK* b, int* wj, int nw, int skip, int col) -> int
        {
            int i, ec;
            for (i = 0; i < nw; i++)
            {
                if (i == skip) { continue; };
                ec = sq_vd_exprcol(g, wj[i]);
                if (sq_vd_gon(990) == 0) { ec = sq_vd_tcol(g, wj[i]); };
                if (ec == col) { return 1; };
                if (ec < 0 | (sq_vd_inidx(@b.src[0], ec) != 0 & (sq_vd_gon(989) == 1 | sq_vd_leads(@b.src[0], ec) != 0) & !(sq_vd_gon(991) == 0 & g.nodes[wj[i]].kind == SQN_ISNULL & g.nodes[wj[i]].op == 1 & ec >= 0 & ec < b.src[0].ti.ncols))) { return 1; };
                if (g.nodes[wj[i]].kind != SQN_BIN & g.nodes[wj[i]].kind != SQN_ISNULL) { return 1; };
                if (g.nodes[wj[i]].kind == SQN_BIN) { if (g.nodes[wj[i]].op == SQO_OR) { return 1; }; };
            };
            return 0;
        };

        // 1 when col is a plain unindexed non-key non-real column of a block with no aggregate, order, distinct or group
        def sq_vd_plaincol(SQ_STMT* g, SQ_BLK* b, SQ_TI* ti, int col) -> int
        {
            if (col < 0 | col >= ti.ncols) { return 0; };
            if (col == ti.ipk | ti.pk[col] != 0 | (ti.aff[col] == 4 & sq_vd_gon(949) == 1)) { return 0; };
            if ((b.has_agg != 0 & sq_vd_gon(950) == 1) | (b.nord != 0 & sq_vd_gon(951) == 1) | (b.distinct != 0 & sq_vd_gon(952) == 1) | b.ngrp != 0) { return 0; };
            if (sq_vd_inidx(@b.src[0], col) != 0) { return 0; };
            return 1;
        };

        def sq_vd_plaincol2(SQ_STMT* g, SQ_BLK* b, SQ_TI* ti, int col) -> int
        {
            if (sq_vd_plaincol(g, b, ti, col) == 0) { return 0; };
            if (ti.aff[col] == 4) { return 0; };
            return 1;
        };

        // 1 when every column the WHERE reads (through OR and AND) is a plain unindexed column
        def sq_vd_allplain2(SQ_STMT* g, SQ_BLK* b, SQ_TI* ti) -> int
        {
            int[8] ot;
            int n, i;
            SQ_NODE* x;
            if (b.where_n < 0) { return 0; };
            n = 0;
            sq_vd_orsplit(g, b.where_n, @ot[0], @n);
            for (i = 0; i < n; i++)
            {
                x = @g.nodes[ot[i]];
                if (x.kind != SQN_IN & x.kind != SQN_LIKE & x.kind != SQN_BIN & x.kind != SQN_BETWEEN & x.kind != SQN_ISNULL) { return 0; };
                if (x.kind == SQN_BIN) { if (x.op == SQO_AND | x.op == SQO_OR) { return 0; }; };
                if (x.a < 0) { return 0; };
                if (g.nodes[x.a].kind != SQN_COL) { return 0; };
                if (sq_vd_plaincol(g, b, ti, g.nodes[x.a].col) == 0) { return 0; };
            };
            return 1;
        };

        // 1 when the whole WHERE is one OR of terms that each have an index (the multi-index OR code can take it)
        def sq_vd_morok(SQ_STMT* g, SQ_BLK* b) -> int
        {
            if (b.where_n < 0) { return 0; };
            if (g.nodes[b.where_n].kind != SQN_BIN) { return 0; };
            if (g.nodes[b.where_n].op != SQO_OR) { return 0; };
            if (sq_vd_dupor(g, b.where_n) == 1) { return 0; };
            return 1;
        };

        // 1 when every conjunct of the WHERE is a term on a plain unindexed column
        def sq_vd_allplain(SQ_STMT* g, SQ_BLK* b, SQ_TI* ti) -> int
        {
            int[16] cj;
            int n, i;
            SQ_NODE* x;
            if (b.where_n < 0) { return 0; };
            n = 0;
            sq_vd_split(g, b.where_n, @cj[0], @n);
            for (i = 0; i < n; i++)
            {
                x = @g.nodes[cj[i]];
                if (x.kind != SQN_IN & x.kind != SQN_LIKE & x.kind != SQN_BIN & x.kind != SQN_BETWEEN & x.kind != SQN_ISNULL) { return 0; };
                if (x.a < 0) { return 0; };
                if (g.nodes[x.a].kind != SQN_COL) { return 0; };
                if (sq_vd_plaincol(g, b, ti, g.nodes[x.a].col) == 0) { return 0; };
            };
            return 1;
        };

        def sq_vd_nullgate(SQ_STMT* g, SQ_BLK* b, SQ_TI* ti, SQ_SRC* sr) -> int
        {
            int[16] wj;
            SQ_IDX[12] ixl;
            int nw, i, k, c, nix, cl;
            SQ_NODE* nd;
            SQ_NODE* l;
            nw = 0;
            if (b.where_n >= 0) { sq_vd_split(g, b.where_n, @wj[0], @nw); };
            nix = 0 - 1;
            // a real literal equality with ORDER BY and LIMIT: the sort versus index choice differs
            if (b.limit_n >= 0 & b.nord >= 1 & sq_vd_gon(742) == 1)
            {
                for (i = 0; i < nw; i++)
                {
                    nd = @g.nodes[wj[i]];
                    if (nd.kind != SQN_BIN | nd.op != SQO_EQ) { continue; };
                    if (g.nodes[nd.a].kind == SQN_REAL | g.nodes[nd.b].kind == SQN_REAL) { { VD_NGW = 11015; return 1; }; };
                };
            };
            // LIMIT 1 with an ORDER BY term pinned by equality: the sort versus index choice differs
            if (b.limit_n >= 0 & (VD_PINPART > 0 | VD_ORDPIN > 0) & sq_vd_gon(743) == 1)
            {
