                {
                    if (ixs[k].isx[i] != 0 | ixs[k].coll[i] != 0 | ixs[k].col[i] < 0 | ixs[k].col[i] >= 16) { ok = 0; continue; };
                    col = ixs[k].col[i];
                    if (have[col] == 1) { continue; };
                    if (inres[col] == 0) { ok = 0; continue; };
                    if (ti.notnull[col] != 1) { ok = 0; };
                };
                if (ok == 1 & ixs[k].nk > 0) { return 1; };
            };
            return 0;
        };

