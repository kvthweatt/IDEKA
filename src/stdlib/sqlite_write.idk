        // index of the column named t[ps..ps+pl) in ti, or -1
        def sq_vd_cfind(SQ_TI* ti, byte* t, int ps, int pl) -> int
        {
            int k, j, m;
            for (k = 0; k < ti.ncols; k++)
            {
                if (ti.cl[k] != pl) { continue; };
                m = 1;
                for (j = 0; j < pl; j++) { if (sq_lc(ti.base[ti.cs[k] + j]) != sq_lc(t[ps + j])) { m = 0; }; };
                if (m == 1) { return k; };
            };
            return 0 - 1;
        };

        // loads the table named t[ns..ns+nl) for ALTER TABLE; returns its schema position or -1 (message set)
        def sq_vd_ldtab(SQ_STMT* st, byte* t, int ns, int nl, SQ_TI** pti) -> int
        {
            int j, found;
            byte* sqlt;
            SQ_TI* ti;
            found = 0 - 1;
            for (j = 0; j < st.db.nschema; j++)
            {
                if (st.db.schema[j].kind != 1) { continue; };
                if (sq_vd_nameeq(st.db.schema[j].name, t, ns, nl)) { found = j; };
            };
            if (found < 0) { sq_seterr(st, "EXPLAIN is not available for this ALTER TABLE\0"); return 0 - 1; };
            sqlt = st.db.schema[found].sql;
            if ((u64)sqlt == (u64)0) { sq_seterr(st, "EXPLAIN is not available for this ALTER TABLE\0"); return 0 - 1; };
            ti = (SQ_TI*)fmalloc((u64)(sizeof(SQ_TI) / 8 + 4096));
            if ((u64)ti == (u64)0) { sq_seterr(st, "out of memory\0"); return 0 - 1; };
            if (sq_ti_load(ti, sqlt) != 0) { ffree((u64)ti); sq_seterr(st, "EXPLAIN is not available for this ALTER TABLE\0"); return 0 - 1; };
            if (ti.wor != 0 | ti.ngen != 0) { ffree((u64)ti); sq_seterr(st, "EXPLAIN is not available for this table\0"); return 0 - 1; };
            *pti = ti;
            return found;
        };

        // ALTER TABLE t RENAME [COLUMN] a TO b
