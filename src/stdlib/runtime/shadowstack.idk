// Author: Karac V. Thweatt

// IDEKA Shadow Stack
// Provides a hardware-assisted shadow return-address stack to protect against
// stack-smashing / return-address overwrite attacks.
//
// Activated by defining IDEKA_SHADOW_STACK before importing standard.idk:
//
//   #def IDEKA_SHADOW_STACK 1;
//   #import "standard.idk";
//
// When active, a function marked with the FSS_Protect_Frame contract copies
// its real return address, read through the @-> operator, into a separately
// allocated shadow region. FSS_Cleanup_Frame reads the return address from the
// stack again before the function returns and compares it with the copy.
//
// If tampering is detected the process is aborted immediately.

#ifndef IDEKA_SHADOW_STACK_IMPL
#def IDEKA_SHADOW_STACK_IMPL 1;

#ifndef IDEKA_STANDARD_TYPES
#import <..\types.idk>;
#endif;

#ifndef IDEKA_STANDARD_MEMORY
#import "memory.idk";
#endif;

// ============================================================================
// Shadow stack record - one per protected frame
// ============================================================================
struct FSSFrame
{
    u64 canary,       // Random canary value XOR'd with the saved return address
        saved_ra,     // Return address read from the real stack at frame entry (XOR'd with canary)
        saved_slot;   // Address of the stack slot that held it, unique to this live frame
};

// ============================================================================
// Shadow stack globals
//
// FSS_BASE   - pointer to the heap-allocated shadow page
// FSS_TOP    - current push index (grows upward)
// FSS_CAP    - maximum number of frames the page can hold
// FSS_CANARY - process-lifetime random seed mixed into every frame
// ============================================================================
global FSSFrame* FSS_BASE      = (FSSFrame*)NULL;
global u64       FSS_TOP       = 0;
global u64       FSS_CAP       = 0;
global u64       FSS_CANARY    = 0;

// ============================================================================
// Platform externs (Windows only for now)
// ============================================================================
#ifdef __WINDOWS__
extern
{
    // VirtualAlloc(lpAddress, dwSize, flAllocationType, flProtect) -> void*
    stdcall !!
        VirtualAlloc(void*, u64, u32, u32) -> void*,
        VirtualFree(void*, u64, u32)       -> i32,
        VirtualProtect(void*, u64, u32, u32*) -> i32;

    // For generating the canary: use the timestamp counter as entropy source
    // We also pull in QueryPerformanceCounter for additional entropy
    stdcall !!
        QueryPerformanceCounter(u64*) -> i32;

    stdcall !!
        ExitProcess(u32 uExitCode) -> void;
};

// MEM_COMMIT | MEM_RESERVE
#def FSS_MEM_COMMIT_RESERVE 0x3000;
// PAGE_READWRITE
#def FSS_PAGE_READWRITE 0x04;
// PAGE_NOACCESS - applied after init so the page cannot be executed or written freely
#def FSS_PAGE_NOACCESS  0x01;
// MEM_RELEASE
#def FSS_MEM_RELEASE    0x8000;

// Number of frames the shadow region holds (64 KB / 24 bytes per frame)
#def FSS_FRAME_CAPACITY 2730;
// Size in bytes of the shadow allocation
#def FSS_PAGE_SIZE 65536;

namespace standard
{
    namespace runtime
    {
        namespace shadow_stack
        {
            // ----------------------------------------------------------------
            // fss_rdtsc() - Read the hardware timestamp counter.
            // Used as a cheap entropy source when seeding the canary.
            // ----------------------------------------------------------------
            def fss_rdtsc() -> u64
            {
                u64 result = 0;
                volatile asm
                {
                    rdtsc
                    shlq $$32, %rdx
                    orq %rdx, %rax
                    movq %rax, $0
                } : : "m"(result) : "rax", "rdx";
                return result;
            };

            // ----------------------------------------------------------------
            // fss_init() - Allocate and prepare the shadow stack page.
            //
            // Must be called before any frame is pushed.
            // Returns true on success, false if allocation failed.
            // ----------------------------------------------------------------
            def fss_init() -> bool
            {
                // Allocate one committed, read-write page for the shadow frames
                void* page = VirtualAlloc(
                    ulong((void*)NULL),
                    (u64)FSS_PAGE_SIZE,
                    (u32)FSS_MEM_COMMIT_RESERVE,
                    (u32)FSS_PAGE_READWRITE
                );

                if (page == (void*)NULL)
                {
                    return false;
                };

                FSS_BASE = (FSSFrame*)page;
                FSS_TOP  = 0;
                FSS_CAP  = (u64)FSS_FRAME_CAPACITY;

                // Build the process-lifetime canary from two entropy sources:
                // the hardware timestamp counter and QueryPerformanceCounter,
                // then XOR them together and mix with a constant to avoid a
                // zero canary.
                u64 t0 = fss_rdtsc();
                u64 qpc = 0;
                QueryPerformanceCounter(@qpc);
                FSS_CANARY = t0 ^| (qpc << 17) ^| (qpc >> 47) ^| 0xA3B4C5D6E7F80192u;

                return true;
            };

            // ----------------------------------------------------------------
            // fss_push(ra, ra_slot) - Save a return address and where it lives.
            //
            // ra      - the return address to protect, read through @->
            // ra_slot - the address of the stack slot holding it (@->)
            //
            // The saved_ra field is stored XOR'd with FSS_CANARY so a simple
            // linear scan of the shadow page does not reveal the raw address.
            // Returns the frame index (slot) used, or U64MAXVAL on overflow.
            // ----------------------------------------------------------------
            def fss_push(u64 ra, u64 ra_slot) -> u64
            {
                if (FSS_TOP >= FSS_CAP)
                {
                    return U64MAXVAL;
                };

                FSSFrame* frame = FSS_BASE + FSS_TOP;
                frame.canary    = FSS_CANARY;
                frame.saved_ra  = ra ^| FSS_CANARY;
                frame.saved_slot = ra_slot;

                FSS_TOP = FSS_TOP + 1;
                return FSS_TOP - 1;
            };

            // ----------------------------------------------------------------
            // fss_verify(slot, ra, ra_slot) - Validate a previously pushed frame.
            //
            // slot    - the frame index returned by fss_push()
            // ra      - the return address currently in the real stack slot
            // ra_slot - the address of that slot, read through @->
            //
            // Returns true if both the canary and return address are intact.
            // ----------------------------------------------------------------
            def fss_verify(u64 slot, u64 ra, u64 ra_slot) -> bool
            {
                if (slot >= FSS_TOP)
                {
                    return false;
                };

                FSSFrame* frame = FSS_BASE + slot;

                // The canary field must be exactly FSS_CANARY
                if (frame.canary != FSS_CANARY)
                {
                    return false;
                };

                // Decode and compare return address
                u64 expected_ra = frame.saved_ra ^| FSS_CANARY;
                if (expected_ra != ra)
                {
                    return false;
                };

                // The slot must be the one this frame owns
                if (frame.saved_slot != ra_slot)
                {
                    return false;
                };

                return true;
            };

            // ----------------------------------------------------------------
            // fss_pop_to(slot) - Pop and clear every frame from the top down to
            // and including slot.
            //
            // Frames above slot belong to calls that never reached their
            // cleanup (an unwound exception, a longjmp), so they go with it.
            // ----------------------------------------------------------------
            def fss_pop_to(u64 slot) -> void
            {
                FSSFrame* frame;
                while (FSS_TOP > slot)
                {
                    FSS_TOP = FSS_TOP - 1;
                    frame = FSS_BASE + FSS_TOP;

                    // Zero out the frame so it cannot be replayed
                    frame.canary     = 0;
                    frame.saved_ra   = 0;
                    frame.saved_slot = 0;
                };

                return;
            };

            // ----------------------------------------------------------------
            // fss_abort() - Called when tampering is detected.
            //
            // Prints a diagnostic then terminates the process immediately.
            // Uses the low-level console printer to avoid any heap usage,
            // since the stack may be in an untrusted state.
            // ----------------------------------------------------------------
            def fss_abort() -> void
            {
                standard::io::console::print("FATAL: shadow stack violation detected - aborting\n\0");
                standard::io::console::flush();
                ExitProcess((u32)1);
                noreturn;
            };

            // ----------------------------------------------------------------
            // fss_teardown() - Free the shadow stack page.
            //
            // Called after successful verification, before normal process exit.
            // ----------------------------------------------------------------
            def fss_teardown() -> void
            {
                if (FSS_BASE == (FSSFrame*)NULL)
                {
                    return;
                };

                VirtualFree(ulong((void*)FSS_BASE), (u64)0, (u32)FSS_MEM_RELEASE);
                FSS_BASE   = (FSSFrame*)NULL;
                FSS_TOP    = 0;
                FSS_CAP    = 0;
                FSS_CANARY = 0;
                return;
            };
        };
    };
};

using standard::runtime::shadow_stack;

// ============================================================================
// Shadow Stack Contracts
//
// Usage:
//   def vulnerable(byte* buf, int len) -> void : FSS_Protect_Frame
//   {
//       // ...
//   } : FSS_Cleanup_Frame;
//
// FSS_Protect_Frame pushes a shadow frame on entry.
// FSS_Cleanup_Frame verifies and pops it before every return.
// If the canary is corrupted, fss_abort() is called immediately.
// ============================================================================

contract FSS_Protect_Frame,
         FSS_Cleanup_Frame;

contract FSS_Protect_Frame
{
    volatile u64 __fss_frame_slot;
    volatile bool __fss_frame_active;
    if (FSS_BASE != (FSSFrame*)NULL)
    {
        // @-> is the stack slot holding this function's return address
        u64* __fss_ra_slot = @->;
        __fss_frame_slot = fss_push(*__fss_ra_slot, (u64)__fss_ra_slot);
        if (__fss_frame_slot == U64MAXVAL) { fss_abort(); };
        __fss_frame_active = true;
    };
} # binding {this : FSS_Cleanup_Frame};

contract FSS_Cleanup_Frame
{
    if (__fss_frame_active)
    {
        // The slot is read again here, so the check never trusts a value kept in this frame
        u64* __fss_ra_now = @->;
        if (fss_verify(__fss_frame_slot, *__fss_ra_now, (u64)__fss_ra_now))
        {
            fss_pop_to(__fss_frame_slot);
        }
        else
        {
            fss_abort();
        };
    };
} # binding {FSS_Protect_Frame : this};

#endif; // __WINDOWS__

#ifdef __LINUX__

extern
{
    def !! abort() -> void;
};

// PROT_READ | PROT_WRITE
#def FSS_PROT_RW        0x03;
// MAP_PRIVATE | MAP_ANONYMOUS
#def FSS_MAP_PRIVATE_ANON 0x22;
// MAP_FAILED sentinel (-1 cast to pointer)
#def FSS_MAP_FAILED     0xFFFFFFFFFFFFFFFFu;

// Number of frames the shadow region holds (64 KB / 24 bytes per frame)
#def FSS_FRAME_CAPACITY 2730;
// Size in bytes of the shadow allocation
#def FSS_PAGE_SIZE 65536;

namespace standard
{
    namespace runtime
    {
        namespace shadow_stack
        {
            // ----------------------------------------------------------------
            // fss_mmap() - Allocate an anonymous private page via mmap(2).
            // Returns MAP_FAILED (all-ones) on error, otherwise the page ptr.
            // ----------------------------------------------------------------
            def fss_mmap(u64 length) -> void*
            {
                void* result;
                volatile asm
                {
                    movq $$9,   %rax
                    xorq %rdi,  %rdi
                    movq $0,    %rsi
                    movq $$3,   %rdx
                    movq $$34,  %r10
                    movq $$-1,  %r8
                    xorq %r9,   %r9
                    syscall
                    movq %rax, $1
                } : : "r"(length), "m"(result) : "rax", "rdi", "rsi", "rdx", "r10", "r8", "r9", "rcx", "r11", "memory";
                return result;
            };

            // ----------------------------------------------------------------
            // fss_munmap() - Release a previously mapped page via munmap(2).
            // ----------------------------------------------------------------
            def fss_munmap(void* addr, u64 length) -> void
            {
                volatile asm
                {
                    movq $$11,  %rax
                    movq $0,    %rdi
                    movq $1,    %rsi
                    syscall
                } : : "r"(addr), "r"(length) : "rax", "rdi", "rsi", "rcx", "r11", "memory";
                return;
            };

            // ----------------------------------------------------------------
            // fss_rdtsc() - Read the hardware timestamp counter.
            // Used as a cheap entropy source when seeding the canary.
            // ----------------------------------------------------------------
            def fss_rdtsc() -> u64
            {
                u64 result = 0;
                volatile asm
                {
                    rdtsc
                    shlq $$32, %rdx
                    orq %rdx, %rax
                    movq %rax, $0
                } : : "m"(result) : "rax", "rdx";
                return result;
            };

            // ----------------------------------------------------------------
            // fss_getrandom() - Fill a u64 with kernel entropy via getrandom(2).
            // Falls back to rdtsc on syscall failure.
            // ----------------------------------------------------------------
            def fss_getrandom() -> u64
            {
                u64 buf = 0;
                i64 ret = 0;
                volatile asm
                {
                    movq $$318, %rax
                    leaq $0, %rdi
                    movq $$8,   %rsi
                    xorq %rdx,  %rdx
                    syscall
                    movq %rax, $1
                } : : "m"(buf), "m"(ret) : "rax", "rdi", "rsi", "rdx", "rcx", "r11", "memory";
                if (ret != 8)
                {
                    return fss_rdtsc();
                };
                return buf;
            };

            // ----------------------------------------------------------------
            // fss_init() - Allocate and prepare the shadow stack page.
            //
            // Must be called before any frame is pushed.
            // Returns true on success, false if allocation failed.
            // ----------------------------------------------------------------
            def fss_init() -> bool
            {
                void* page = fss_mmap((u64)FSS_PAGE_SIZE);

                if ((u64)page == (u64)FSS_MAP_FAILED)
                {
                    return false;
                };

                FSS_BASE = (FSSFrame*)page;
                FSS_TOP  = 0;
                FSS_CAP  = (u64)FSS_FRAME_CAPACITY;

                // Build the process-lifetime canary from two entropy sources:
                // the hardware timestamp counter and getrandom(2),
                // then XOR them together and mix with a constant to avoid a
                // zero canary.
                u64 t0  = fss_rdtsc();
                u64 rng = fss_getrandom();
                FSS_CANARY = t0 ^| (rng << 17) ^| (rng >> 47) ^| 0xA3B4C5D6E7F80192u;

                return true;
            };

            // ----------------------------------------------------------------
            // fss_push(ra, ra_slot) - Save a return address and where it lives.
            //
            // ra      - the return address to protect, read through @->
            // ra_slot - the address of the stack slot holding it (@->)
            //
            // The saved_ra field is stored XOR'd with FSS_CANARY so a simple
            // linear scan of the shadow page does not reveal the raw address.
            // Returns the frame index (slot) used, or U64MAXVAL on overflow.
            // ----------------------------------------------------------------
            def fss_push(u64 ra, u64 ra_slot) -> u64
            {
                if (FSS_TOP >= FSS_CAP)
                {
                    return U64MAXVAL;
                };

                FSSFrame* frame = FSS_BASE + FSS_TOP;
                frame.canary    = FSS_CANARY;
                frame.saved_ra  = ra ^| FSS_CANARY;
                frame.saved_slot = ra_slot;

                FSS_TOP = FSS_TOP + 1;
                return FSS_TOP - 1;
            };

            // ----------------------------------------------------------------
            // fss_verify(slot, ra, ra_slot) - Validate a previously pushed frame.
            //
            // slot    - the frame index returned by fss_push()
            // ra      - the return address currently in the real stack slot
            // ra_slot - the address of that slot, read through @->
            //
            // Returns true if both the canary and return address are intact.
            // ----------------------------------------------------------------
            def fss_verify(u64 slot, u64 ra, u64 ra_slot) -> bool
            {
                if (slot >= FSS_TOP)
                {
                    return false;
                };

                FSSFrame* frame = FSS_BASE + slot;

                // The canary field must be exactly FSS_CANARY
                if (frame.canary != FSS_CANARY)
                {
                    return false;
                };

                // Decode and compare return address
                u64 expected_ra = frame.saved_ra ^| FSS_CANARY;
                if (expected_ra != ra)
                {
                    return false;
                };

                // The slot must be the one this frame owns
                if (frame.saved_slot != ra_slot)
                {
                    return false;
                };

                return true;
            };

            // ----------------------------------------------------------------
            // fss_pop_to(slot) - Pop and clear every frame from the top down to
            // and including slot.
            //
            // Frames above slot belong to calls that never reached their
            // cleanup (an unwound exception, a longjmp), so they go with it.
            // ----------------------------------------------------------------
            def fss_pop_to(u64 slot) -> void
            {
                while (FSS_TOP > slot)
                {
                    FSS_TOP = FSS_TOP - 1;
                    FSSFrame* frame = FSS_BASE + FSS_TOP;

                    // Zero out the frame so it cannot be replayed
                    frame.canary     = 0;
                    frame.saved_ra   = 0;
                    frame.saved_slot = 0;
                };

                return;
            };

            // ----------------------------------------------------------------
            // fss_abort() - Called when tampering is detected.
            //
            // Prints a diagnostic then terminates the process immediately.
            // Uses the low-level console printer to avoid any heap usage,
            // since the stack may be in an untrusted state.
            // ----------------------------------------------------------------
            def fss_abort() -> void
            {
                standard::io::console::print("FATAL: shadow stack violation detected - aborting\n\0");
                standard::io::console::flush();
                abort();
                noreturn;
            };

            // ----------------------------------------------------------------
            // fss_teardown() - Free the shadow stack page.
            //
            // Called after successful verification, before normal process exit.
            // ----------------------------------------------------------------
            def fss_teardown() -> void
            {
                if (FSS_BASE == (FSSFrame*)NULL)
                {
                    return;
                };

                fss_munmap((void*)FSS_BASE, (u64)FSS_PAGE_SIZE);
                FSS_BASE   = (FSSFrame*)NULL;
                FSS_TOP    = 0;
                FSS_CAP    = 0;
                FSS_CANARY = 0;
                return;
            };
        };
    };
};

using standard::runtime::shadow_stack;

// ============================================================================
// Shadow Stack Contracts
//
// Usage:
//   def vulnerable(byte* buf, int len) -> void : FSS_Protect_Frame
//   {
//       // ...
//   } : FSS_Cleanup_Frame;
//
// FSS_Protect_Frame pushes a shadow frame on entry.
// FSS_Cleanup_Frame verifies and pops it before every return.
// If the canary is corrupted, fss_abort() is called immediately.
// ============================================================================

contract FSS_Protect_Frame
{
    volatile u64 __fss_frame_slot;
    volatile bool __fss_frame_active;
    if (FSS_BASE != (FSSFrame*)NULL)
    {
        // @-> is the stack slot holding this function's return address
        u64* __fss_ra_slot = @->;
        __fss_frame_slot = fss_push(*__fss_ra_slot, (u64)__fss_ra_slot);
        if (__fss_frame_slot == U64MAXVAL) { fss_abort(); };
        __fss_frame_active = true;
    };
};

contract FSS_Cleanup_Frame
{
    if (__fss_frame_active)
    {
        // The slot is read again here, so the check never trusts a value kept in this frame
        u64* __fss_ra_now = @->;
        if (fss_verify(__fss_frame_slot, *__fss_ra_now, (u64)__fss_ra_now))
        {
            fss_pop_to(__fss_frame_slot);
        }
        else
        {
            fss_abort();
        };
    };
};

#endif; // __LINUX__
#endif; // IDEKA_SHADOW_STACK_IMPL
