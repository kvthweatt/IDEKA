                    if (prec > 1) { px = prec; };
                    ln = sl * px;
                    pad = width - px;
                    if (pad > 0 & flagleft == 0) { while (pad > 0) { r[o] = (byte)32; o++; pad--; }; };
                    for (k = 0; k < px; k++) { for (ii = 0; ii < sl; ii++) { r[o] = num[ii]; o++; }; };
                    if (pad > 0 & flagleft == 1) { while (pad > 0) { r[o] = (byte)32; o++; pad--; }; };
                    appended = 1;
                    continue;
                };
