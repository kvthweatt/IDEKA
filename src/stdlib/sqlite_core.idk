                                    c = 0;
                                    if (i < fn) { c = (int)fp[i]; };
                                };
                                width = wx;
                                if (c != 46 & c != 108) { done = 1; } else { i--; };
                            }
                            else
                            {
                                if (c == 42)
                                {
                                    width = 0;
                                    if (ai < argc) { sq_cast((SQ_ARENA*)0, @args[ai], 3, @t); width = (int)t.i; };
                                    ai++;
                                    if (width < 0) { flagleft = 1; width = 0 - width; };
                                    if (width > 1000000) { width = 1000000; };
                                    k = 0;
                                    if (i + 1 < fn) { k = (int)fp[i + 1]; };
                                    if (k != 46 & k != 108) { i++; c = 0; if (i < fn) { c = (int)fp[i]; }; done = 1; };
                                }
                                else
                                {
                                    if (c == 46)
                                    {
                                        i++;
                                        c = 0;
                                        if (i < fn) { c = (int)fp[i]; };
