                    {
                        for (k = 0; k < ii; k++) { if (((int)t.p[k] `& 192) == 128) { pad++; }; };
                    };
                    if (pad > 0 & flagleft == 0) { while (pad > 0) { r[o] = (byte)32; o++; pad--; }; };
                    if (need == 1) { r[o] = (byte)cv; o++; };
                    for (k = 0; k < ii; k++)
                    {
                        r[o] = t.p[k]; o++;
