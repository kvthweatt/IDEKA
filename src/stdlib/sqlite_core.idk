// Author: Karac V. Thweatt

// sqlite_core.idk - SQL engine over sqlite.idk: lexer, parser, binder, expression evaluator and the SELECT executor.
//
//   sq_prep_query(SQ_STMT*, SQLITE_DB*, byte* sql) -> int     0 on success, otherwise st.err holds the message
//   sq_step_query(SQ_STMT*) -> int                            1 row available, 0 done, -1 error
//   sq_column_count / sq_column_name / sq_column_type / sq_column_int / sq_column_real / sq_column_bytes
//   sq_column_ptr / sq_column_text, sq_bind_int / sq_bind_real / sq_bind_text / sq_bind_blob / sq_bind_null
//
// The public entry points sq_prepare, sq_step, sq_exec and sq_finalize live in sqlite_sql.idk.

#ifndef IDEKA_STANDARD_SQLITE
#import <sqlite.idk>;
#endif;

#ifndef IDEKA_STANDARD_MATH
#import <math.idk>;
#endif;

#ifndef IDEKA_DATETIME
#import <datetime.idk>;
#endif;

#ifndef IDEKA_STANDARD_ENCODING
#import <encodings.idk>;
#endif;

#ifndef IDEKA_STANDARD_SQLITE_CORE
#def IDEKA_STANDARD_SQLITE_CORE 1;

namespace standard
{
    namespace sqlite
    {
        // node kinds
        global int SQN_INT = 1, SQN_REAL = 2, SQN_STR = 3, SQN_NULL = 4, SQN_COL = 5, SQN_UNARY = 6,
                   SQN_BIN = 7, SQN_FUNC = 8, SQN_ISNULL = 9, SQN_IN = 10, SQN_BETWEEN = 11,
                   SQN_LIKE = 12, SQN_ROWID = 13, SQN_STAR = 14, SQN_BLOB = 15, SQN_CASE = 16,
                   SQN_CAST = 17, SQN_COLLATE = 18, SQN_SUBQ = 19, SQN_EXISTS = 20, SQN_PARAM = 21,
                   SQN_WHEN = 22, SQN_RESREF = 23;

        // binary operator codes
        global int SQO_ADD = 1, SQO_SUB = 2, SQO_MUL = 3, SQO_DIV = 4, SQO_MOD = 5, SQO_EQ = 6, SQO_NE = 7,
                   SQO_LT = 8, SQO_LE = 9, SQO_GT = 10, SQO_GE = 11, SQO_AND = 12, SQO_OR = 13, SQO_CAT = 14,
                   SQO_BAND = 15, SQO_BOR = 16, SQO_SHL = 17, SQO_SHR = 18, SQO_IS = 19, SQO_ISNOT = 20;

        // collations
        global int SQC_BINARY = 0, SQC_NOCASE = 1, SQC_RTRIM = 2;

        struct SQ_VAL
        {
            int t, n;
            i64 i;
            double r;
            byte* p;
        };

        // ---- arena: stable chunked allocation ----

        struct SQ_ARENA
        {
            byte*[1024] ch;
            int[1024] cap;
            int n, used;
        };

        // ---- small helpers ----

        def sq_lc(byte c) -> byte
        {
            if (c >= (byte)65 & c <= (byte)90) { return c + (byte)32; };
            return c;
        };

        def sq_isalpha(byte c) -> bool
        {
            if (c >= (byte)97 & c <= (byte)122) { return true; };
            if (c >= (byte)65 & c <= (byte)90) { return true; };
            if (c == (byte)95 | c >= (byte)128) { return true; };
            return false;
        };

        def sq_isdigit(byte c) -> bool
        {
            return c >= (byte)48 & c <= (byte)57;
        };

        // case-insensitive compare of p[0..n) with a zero terminated lowercase literal
        def sq_ieq(byte* p, int n, byte* lit) -> bool
        {
            int i = 0;
            while (i < n)
            {
                if (lit[i] == (byte)0) { return false; };
                if (sq_lc(p[i]) != lit[i]) { return false; };
                i++;
            };
            return lit[i] == (byte)0;
        };


        def sq_itoa(i64 v, byte* buf) -> int
        {
            byte[24] tmp;
            int n = 0;
            int k = 0;
            u64 u;
            if (v < (i64)0)
            {
                buf[k] = (byte)45;
                k++;
                u = (u64)0 - (u64)v;
            }
            else { u = (u64)v; };
            if (u == (u64)0) { tmp[0] = (byte)48; n = 1; };
            while (u != (u64)0)
            {
                tmp[n] = (byte)(48 + (int)(u % (u64)10));
                u = u / (u64)10;
                n++;
            };
            while (n > 0) { n--; buf[k] = tmp[n]; k++; };
            buf[k] = (byte)0;
            return k;
        };

        def sq_ishex(byte c) -> bool
        {
            if (c >= (byte)48 & c <= (byte)57) { return true; };
            if (c >= (byte)97 & c <= (byte)102) { return true; };
            if (c >= (byte)65 & c <= (byte)70) { return true; };
            return false;
        };

        def sq_hexval(byte* p, int n) -> u64
        {
            u64 v = (u64)0;
            int i, d;
            byte c;
            for (i = 0; i < n; i++)
            {
                c = p[i];
                d = 0;
                if (c >= (byte)48 & c <= (byte)57) { d = (int)c - 48; }
                else { if (c >= (byte)97 & c <= (byte)102) { d = (int)c - 87; } else { d = (int)c - 55; }; };
                v = v * (u64)16 + (u64)d;
            };
            return v;
        };
        // ---- values ----

        def sq_val_null(SQ_VAL* v) -> void
        {
            v.t = SQ_NULL; v.n = 0; v.i = (i64)0; v.r = 0.0; v.p = (byte*)0;
        };

        def sq_val_int(SQ_VAL* v, i64 x) -> void
        {
            v.t = SQ_INTEGER; v.n = 0; v.i = x; v.r = 0.0; v.p = (byte*)0;
        };

        def sq_val_real(SQ_VAL* v, double x) -> void
        {
            v.t = SQ_REAL; v.n = 0; v.i = (i64)0; v.r = x; v.p = (byte*)0;
        };

        def sq_val_copy(SQ_VAL* d, SQ_VAL* s) -> void
        {
            d.t = s.t; d.n = s.n; d.i = s.i; d.r = s.r; d.p = s.p;
        };

        def sq_ar_init(SQ_ARENA* a) -> void
        {
            a.n = 0;
            a.used = 0;
        };

        def sq_ar_free(SQ_ARENA* a) -> void
        {
            int i;
            for (i = 0; i < a.n; i++)
            {
                ffree((u64)a.ch[i]);
                a.ch[i] = (byte*)0;
            };
            a.n = 0;
            a.used = 0;
        };

        // keeps the first chunk
        def sq_ar_reset(SQ_ARENA* a) -> void
        {
            int i;
            for (i = 1; i < a.n; i++)
            {
                ffree((u64)a.ch[i]);
                a.ch[i] = (byte*)0;
            };
            if (a.n > 1) { a.n = 1; };
            a.used = 0;
        };

        def sq_ar_alloc(SQ_ARENA* a, int n) -> byte*
        {
            byte* r;
            int cap, k;
            if (n % 8 != 0) { n = n + 8 - (n % 8); };
            if (n == 0) { n = 8; };
            if (a.n > 0)
            {
                if (a.used + n <= a.cap[a.n - 1])
                {
                    r = @a.ch[a.n - 1][a.used];
                    a.used = a.used + n;
                    return r;
                };
            };
            if (a.n >= 1024) { return (byte*)0; };
            k = a.n;
            if (k > 6) { k = 6; };
            cap = 65536;
            while (k > 0) { cap = cap * 2; k--; };
            if (n > cap) { cap = n; };
            a.ch[a.n] = (byte*)fmalloc((u64)cap);
            if ((u64)a.ch[a.n] == (u64)0) { return (byte*)0; };
            a.cap[a.n] = cap;
            a.n++;
            a.used = n;
            return a.ch[a.n - 1];
        };

        // copies p[0..n) into the arena, appending a zero byte that is not counted
        def sq_ar_copy(SQ_ARENA* a, byte* p, int n) -> byte*
        {
            byte* r = sq_ar_alloc(a, n + 1);
            int i;
            if ((u64)r == (u64)0) { return r; };
            for (i = 0; i < n; i++) { r[i] = p[i]; };
            r[n] = (byte)0;
            return r;
        };

        // copies a value so that it no longer depends on its source memory
        def sq_val_own(SQ_ARENA* a, SQ_VAL* v) -> void
        {
            byte* c;
            if (v.t != SQ_TEXT & v.t != SQ_BLOB) { return; };
            c = sq_ar_copy(a, v.p, v.n);
            if ((u64)c == (u64)0) { sq_val_null(v); return; };
            v.p = c;
        };

        // ---- floating point conversion (the algorithms SQLite uses for REAL <-> TEXT) ----

        // high 64 bits of a*b, low 64 bits in *lo
        def sq_mul128(u64 a, u64 b, u64* lo) -> u64
        {
            u64 a0, a1, b0, b1, a0b0, a1b1, a0b1, a1b0, t, m32;
            m32 = (u64)4294967295;
            a0 = a `& m32;
            a1 = a >> (u64)32;
            b0 = b `& m32;
            b1 = b >> (u64)32;
            a0b0 = a0 * b0;
            a1b1 = a1 * b1;
            a0b1 = a0 * b1;
            a1b0 = a1 * b0;
            t = (a0b0 >> (u64)32) + (a0b1 `& m32) + (a1b0 `& m32);
            *lo = (a0b0 `& m32) | (t << (u64)32);
            return a1b1 + (a0b1 >> (u64)32) + (a1b0 >> (u64)32) + (t >> (u64)32);
        };

        // upper 96 bits of the 160 bitm product of (a<<32)+aLo and b: top 64 bits returned, next 32 in *plo
        def sq_mul160(u64 a, u64 aLo, u64 b, u64* plo) -> u64
        {
            u64 m32, x2, x1, x0, y1, y0, x2y1, r4, x2y0, x1y1, r3, x1y0, x0y1, r2, x0y0, r1;
            m32 = (u64)4294967295;
            x2 = a >> (u64)32;
            x1 = a `& m32;
            x0 = aLo;
            y1 = b >> (u64)32;
            y0 = b `& m32;
            x2y1 = x2 * y1;
            r4 = x2y1 >> (u64)32;
            x2y0 = x2 * y0;
            x1y1 = x1 * y1;
            r3 = (x2y1 `& m32) + (x2y0 >> (u64)32) + (x1y1 >> (u64)32);
            x1y0 = x1 * y0;
            x0y1 = x0 * y1;
            r2 = (x2y0 `& m32) + (x1y1 `& m32) + (x1y0 >> (u64)32) + (x0y1 >> (u64)32);
            x0y0 = x0 * y0;
            r1 = (x1y0 `& m32) + (x0y1 `& m32) + (x0y0 >> (u64)32);
            r2 = r2 + (r1 >> (u64)32);
            r3 = r3 + (r2 >> (u64)32);
            *plo = r2 `& m32;
            return (r4 << (u64)32) + r3;
        };

        def sq_clz64(u64 m) -> int
        {
            int n = 0;
            while (n < 64)
            {
                if ((m >> (u64)(63 - n)) `& (u64)1 != (u64)0) { return n; };
                n++;
            };
            return 64;
        };

        // floor(p * 108853 / 32768) and floor(p * 78913 / 262144)
        def sq_pwr10to2(int p) -> int
        {
            int v = p * 108853;
            int q = v / 32768;
            if (v % 32768 < 0) { q = q - 1; };
            return q;
        };

        def sq_pwr2to10(int p) -> int
        {
            int v = p * 78913;
            int q = v / 262144;
            if (v % 262144 < 0) { q = q - 1; };
            return q;
        };

        // most significant 64 bits of 10**p (p from -348 to 347), the next 32 bits in *plo
        def sq_pow10_64(int p, u64* plo) -> u64
        {
            const u64[27] aBase = [
                0x8000000000000000u, 0xA000000000000000u, 0xC800000000000000u, 0xFA00000000000000u,
                0x9C40000000000000u, 0xC350000000000000u, 0xF424000000000000u, 0x9896800000000000u,
                0xBEBC200000000000u, 0xEE6B280000000000u, 0x9502F90000000000u, 0xBA43B74000000000u,
                0xE8D4A51000000000u, 0x9184E72A00000000u, 0xB5E620F480000000u, 0xE35FA931A0000000u,
                0x8E1BC9BF04000000u, 0xB1A2BC2EC5000000u, 0xDE0B6B3A76400000u, 0x8AC7230489E80000u,
                0xAD78EBC5AC620000u, 0xD8D726B7177A8000u, 0x878678326EAC9000u, 0xA968163F0A57B400u,
                0xD3C21BCECCEDA100u, 0x84595161401484A0u, 0xA56FA5B99019A5C8u
            ];
            const u64[26] aScale = [
                0x8049A4AC0C5811AEu, 0xCF42894A5DCE35EAu, 0xA76C582338ED2621u, 0x873E4F75E2224E68u,
                0xDA7F5BF590966848u, 0xB080392CC4349DECu, 0x8E938662882AF53Eu, 0xE65829B3046B0AFAu,
                0xBA121A4650E4DDEBu, 0x964E858C91BA2655u, 0xF2D56790AB41C2A2u, 0xC428D05AA4751E4Cu,
                0x9E74D1B791E07E48u, 0xCCCCCCCCCCCCCCCCu, 0xCECB8F27F4200F3Au, 0xA70C3C40A64E6C51u,
                0x86F0AC99B4E8DAFDu, 0xDA01EE641A708DE9u, 0xB01AE745B101E9E4u, 0x8E41ADE9FBEBC27Du,
                0xE5D3EF282A242E81u, 0xB9A74A0637CE2EE1u, 0x95F83D0A1FB69CD9u, 0xF24A01A73CF2DCCFu,
                0xC3B8358109E84F07u, 0x9E19DB92B4E31BA9u
            ];
            const u64[26] aScaleLo = [
                0x205B896Du, 0x52064CADu, 0xAF2AF2B8u, 0x5A7744A7u, 0xAF39A475u, 0xBD8D794Eu,
                0x547EB47Bu, 0x0CB4A5A3u, 0x92F34D62u, 0x3A6A07F9u, 0xFAE27299u, 0xAA97E14Cu,
                0x775EA265u, 0xCCCCCCCCu, 0x00000000u, 0x999090B6u, 0x69A028BBu, 0xE80E6F48u,
                0x5EC05DD0u, 0x14588F14u, 0x8F1668C9u, 0x6D953E2Cu, 0x4ABDAF10u, 0xBC633B39u,
                0x0A862F81u, 0x6C07A2C2u
            ];
            int g, n;
            u64 s, x, lo;
            if (p < 0)
            {
                if (p == 0 - 1)
                {
                    *plo = aScaleLo[13];
                    return aScale[13];
                };
                g = p / 27;
                n = p % 27;
                if (n != 0)
                {
                    g = g - 1;
                    n = n + 27;
                };
            }
            else
            {
                if (p < 27)
                {
                    *plo = (u64)0;
                    return aBase[p];
                };
                g = p / 27;
                n = p % 27;
            };
            s = aScale[g + 13];
            if (n == 0)
            {
                *plo = aScaleLo[g + 13];
                return s;
            };
            x = sq_mul160(s, aScaleLo[g + 13], aBase[n], @lo);
            if ((x >> (u64)63) == (u64)0)
            {
                x = (x << (u64)1) | ((lo >> (u64)31) `& (u64)1);
                lo = ((lo << (u64)1) | (u64)1) `& (u64)4294967295;
            };
            *plo = lo;
            return x;
        };

        // m * 2**e as m10 * 10**exp10 with n significant digits (m has its top bitm set)
        def sq_fp2conv10(u64 m, int e, int n, u64* pD, int* pP) -> void
        {
            int p, sh;
            u64 h, d1, d2;
            p = n - 1 - sq_pwr2to10(e + 63);
            h = sq_mul128(m, sq_pow10_64(p, @d2), @d1);
            if (n == 18)
            {
                sh = 0 - (e + sq_pwr10to2(p) + 2);
                h = h >> (u64)sh;
                *pD = (h + ((h << (u64)1) `& (u64)2)) >> (u64)1;
            }
            else
            {
                sh = 0 - (e + sq_pwr10to2(p) + 1);
                *pD = h >> (u64)sh;
            };
            *pP = 0 - p;
        };

        // the double nearest d * 10**p
        def sq_fp10conv2(u64 d, int p) -> double
        {
            int bl, lp, ex2, adj, sh;
            u64 pwr10l, mid1, mid2, pwr10h, xx, hi, lo, sticky, uu, mm, m32, bitm;
            double r = 0.0;
            double* dp;
            u64* bp;
            m32 = (u64)4294967295;
            if (p < 0 - 348) { return 0.0; };
            if (p > 347) { return 1.0e308 * 10.0; };
            bl = 64 - sq_clz64(d);
            lp = sq_pwr10to2(p);
            ex2 = 53 - bl - lp;
            if (ex2 > 1074)
            {
                if (ex2 >= 1130) { return 0.0; };
                ex2 = 1074;
            };
            sh = 0 - (ex2 - (64 - bl) + lp + 3);
            pwr10h = sq_pow10_64(p, @pwr10l);
            if (pwr10l != (u64)0)
            {
                pwr10h = pwr10h + (u64)1;
                pwr10l = pwr10l ^| m32;
            };
            xx = d << (u64)(64 - bl);
            hi = sq_mul128(xx, pwr10h, @lo);
            mid1 = lo >> (u64)32;
            sticky = (u64)1;
            bitm = (u64)1 << (u64)sh;
            if ((hi `& (bitm - (u64)1)) == (u64)0)
            {
                mid2 = sq_mul128(xx, pwr10l << (u64)32, @lo) >> (u64)32;
                mid2 = mid2 `& m32;
                if (((mid1 - mid2) `& m32) > (u64)1) { sticky = (u64)1; } else { sticky = (u64)0; };
                if (mid1 < mid2) { hi = hi - (u64)1; };
            };
            uu = (hi >> (u64)sh) | sticky;
            adj = 0;
            if (uu >= (((u64)1 << (u64)55) - (u64)2)) { adj = 1; };
            if (adj == 1)
            {
                uu = (uu >> (u64)1) | (uu `& (u64)1);
                ex2 = ex2 - 1;
            };
            mm = (uu + (u64)1 + ((uu >> (u64)2) `& (u64)1)) >> (u64)2;
            if (ex2 <= 0 - 972) { return 1.0e308 * 10.0; };
            if ((mm `& ((u64)1 << (u64)52)) != (u64)0)
            {
                mm = (mm ^| ((u64)1 << (u64)52)) | ((u64)(1075 - ex2) << (u64)52);
            };
            r = 0.0;
            dp = @r;
            bp = (u64*)dp;
            *bp = mm;
            return *dp;
        };

        // The decimal digits SQLite shows for the positive finite double r with precision 17: digits go to z[0..n),
        // the decimal point sits after iDP digits. buf must hold 48 bytes.
        def sq_fp_decode17(double r, byte* buf, int* pn, int* piDP) -> void
        {
            u64 v, vv, fr, v2;
            u64* bp;
            double* dp;
            double rr;
            int e, nn, exp10, i, n, zi, iRound, jj, kk, j, k;
            byte[24] tmp;
            rr = r;
            dp = @rr;
            bp = (u64*)dp;
            v = *bp;
            e = (int)((v >> (u64)52) `& (u64)2047);
            v = v `& (u64)4503599627370495;
            if (e == 0)
            {
                nn = sq_clz64(v);
                v = v << (u64)nn;
                e = 0 - 1074 - nn;
            }
            else
            {
                v = (v << (u64)11) | ((u64)1 << (u64)63);
                e = e - 1086;
            };
            sq_fp2conv10(v, e, 18, @vv, @exp10);
            // digits of vv, right aligned into tmp
            i = 24;
            while (vv >= (u64)10)
            {
                i--;
                tmp[i] = (byte)(48 + (int)(vv % (u64)10));
                vv = vv / (u64)10;
            };
            if (vv != (u64)0) { i--; tmp[i] = (byte)(48 + (int)vv); };
            n = 24 - i;
            zi = 8;
            for (k = 0; k < n; k++) { buf[zi + k] = tmp[i + k]; };
            *piDP = n + exp10;
            iRound = 17;
            if (iRound < n)
            {
                if (buf[zi + 15] == (byte)57 & buf[zi + 14] == (byte)57)
                {
                    jj = 14;
                    while (jj > 0)
                    {
                        if (buf[zi + jj - 1] == (byte)57) { jj--; } else { break; };
                    };
                    if (jj == 0) { v2 = (u64)1; }
                    else
                    {
                        v2 = (u64)((int)buf[zi] - 48);
                        for (kk = 1; kk < jj; kk++) { v2 = v2 * (u64)10 + (u64)((int)buf[zi + kk] - 48); };
                        v2 = v2 + (u64)1;
                    };
                    if (r == sq_fp10conv2(v2, exp10 + n - jj)) { iRound = jj + 1; };
                }
                else
                {
                    if (*piDP >= n | (buf[zi + 15] == (byte)48 & buf[zi + 14] == (byte)48 & buf[zi + 13] == (byte)48))
                    {
                        jj = 13;
                        while (jj > 1)
                        {
                            if (buf[zi + jj - 1] == (byte)48) { jj--; } else { break; };
                        };
                        v2 = (u64)((int)buf[zi] - 48);
                        for (kk = 1; kk < jj; kk++) { v2 = v2 * (u64)10 + (u64)((int)buf[zi + kk] - 48); };
                        if (r == sq_fp10conv2(v2, exp10 + n - jj)) { iRound = jj + 1; };
                    };
                };
                n = iRound;
                if (buf[zi + iRound] >= (byte)53)
                {
                    j = iRound - 1;
                    while (true)
                    {
                        buf[zi + j] = (byte)((int)buf[zi + j] + 1);
                        if (buf[zi + j] <= (byte)57) { break; };
                        buf[zi + j] = (byte)48;
                        if (j == 0)
                        {
                            zi--;
                            buf[zi] = (byte)49;
                            n++;
                            *piDP = *piDP + 1;
                            break;
                        }
                        else { j--; };
                    };
                };
            };
            while (n > 1)
            {
                if (buf[zi + n - 1] == (byte)48) { n--; } else { break; };
            };
            // move the digits to the start of buf
            for (k = 0; k < n; k++) { buf[k] = buf[zi + k]; };
            *pn = n;
        };

        // ---- exact REAL to text (the %!.15g form of SQLite) ----

        def sq_big_mul(u64* big, int nb, u64 m) -> int
        {
            int i;
            u64 carry, x;
            carry = (u64)0;
            for (i = 0; i < nb; i++)
            {
                x = big[i] * m + carry;
                big[i] = x % (u64)1000000000;
                carry = x / (u64)1000000000;
            };
            while (carry != (u64)0)
            {
                big[nb] = carry % (u64)1000000000;
                carry = carry / (u64)1000000000;
                nb++;
            };
            return nb;
        };

        // Exact decimal expansion of m * 2^e2 (m > 0): digits in dig, most significant first, trailing zeros removed;
        // *Xo is the decimal exponent of the first digit.
        def sq_exact_mant(u64 m, int e2, byte* dig, int* ndo, int* Xo) -> void
        {
            u64[200] big;
            byte[12] tmp;
            u64 limb, p5, p2;
            int nb, nd, i, j, k, shift;
            nb = 0;
            while (m != (u64)0)
            {
                big[nb] = m % (u64)1000000000;
                m = m / (u64)1000000000;
                nb++;
            };
            shift = 0;
            if (e2 > 0)
            {
                while (e2 >= 29) { nb = sq_big_mul(@big[0], nb, (u64)536870912); e2 = e2 - 29; };
                p2 = (u64)1;
                while (e2 > 0) { p2 = p2 * (u64)2; e2--; };
                nb = sq_big_mul(@big[0], nb, p2);
            };
            if (e2 < 0)
            {
                k = 0 - e2;
                shift = k;
                while (k >= 12) { nb = sq_big_mul(@big[0], nb, (u64)244140625); k = k - 12; };
                p5 = (u64)1;
                while (k > 0) { p5 = p5 * (u64)5; k--; };
                nb = sq_big_mul(@big[0], nb, p5);
            };
            nd = 0;
            limb = big[nb - 1];
            j = 0;
            while (limb != (u64)0) { tmp[j] = (byte)(48 + (int)(limb % (u64)10)); limb = limb / (u64)10; j++; };
            while (j > 0) { j--; dig[nd] = tmp[j]; nd++; };
            for (i = nb - 2; i >= 0; i--)
            {
                limb = big[i];
                for (j = 8; j >= 0; j--)
                {
                    dig[nd + j] = (byte)(48 + (int)(limb % (u64)10));
                    limb = limb / (u64)10;
                };
                nd = nd + 9;
            };
            *Xo = nd - 1 - shift;
            while (nd > 1)
            {
                if (dig[nd - 1] == (byte)48) { nd--; } else { break; };
            };
            *ndo = nd;
        };

        // Exact expansion of a finite double. Returns the sign (1 negative, 0 positive), or 2 infinity, 3 NaN, 4 zero.
        def sq_real_exact(double r, byte* dig, int* ndo, int* Xo) -> int
        {
            double dd;
            u64* bp;
            u64 bits, frac, m;
            int neg, e, e2;
            dd = r;
            bp = (u64*)@dd;
            bits = *bp;
            neg = (int)(bits >> 63);
            e = (int)((bits >> 52) `& (u64)2047);
            frac = bits `& (u64)4503599627370495;
            if (e == 2047)
            {
                if (frac != (u64)0) { return 3; };
                return 2;
            };
            if (e == 0 & frac == (u64)0) { return 4; };
            if (e == 0) { m = frac; e2 = 0 - 1074; } else { m = frac | (u64)4503599627370496; e2 = e - 1075; };
            sq_exact_mant(m, e2, dig, ndo, Xo);
            return neg;
        };

        // compares two positive decimals given as digit strings with the exponent of their first digit
        def sq_cmp_dec(byte* a, int na, int Xa, byte* b, int nb, int Xb) -> int
        {
            int i, n;
            byte x, y;
            if (Xa != Xb) { if (Xa > Xb) { return 1; }; return 0 - 1; };
            n = na;
            if (nb > n) { n = nb; };
            for (i = 0; i < n; i++)
            {
                x = (byte)48;
                y = (byte)48;
                if (i < na) { x = a[i]; };
                if (i < nb) { y = b[i]; };
                if (x != y) { if (x > y) { return 1; }; return 0 - 1; };
            };
            return 0;
        };

        // rounds the digit string to keep digits [0,keep) (round half up on the exact expansion); returns the new X
        def sq_round_digits(byte* dig, int* nd, int X, int keep) -> int
        {
            int k, i;
            if (keep < 0) { *nd = 0; return X; };
            if (*nd <= keep) { return X; };
            if (dig[keep] >= (byte)53)
            {
                k = keep - 1;
                while (k >= 0)
                {
                    if (dig[k] == (byte)57) { dig[k] = (byte)48; k--; }
                    else { dig[k] = dig[k] + (byte)1; break; };
                };
                if (k < 0)
                {
                    // carried out of the top digit: 99.. becomes 100..
                    dig[0] = (byte)49;
                    for (i = 1; i < keep; i++) { dig[i] = (byte)48; };
                    X++;
                    *nd = keep;
                    if (keep == 0) { *nd = 1; };
                    return X;
                };
            };
            *nd = keep;
            return X;
        };

        // true when the decimal d (nd digits, exponent X) converts back to the double bits exactly
        def sq_roundtrip(double r, byte* d, int nd, int X) -> bool
        {
            byte[1300] hi;
            byte[1300] lo;
            double dd;
            u64* bp;
            u64 bits, frac, m;
            int e, e2, nhi, nlo, Xhi, Xlo, c1, c2, even;
            dd = r;
            if (dd < 0.0) { dd = 0.0 - dd; };
            bp = (u64*)@dd;
            bits = *bp;
            e = (int)((bits >> 52) `& (u64)2047);
            frac = bits `& (u64)4503599627370495;
            if (e == 0)
            {
                if (frac == (u64)0) { return false; };
                m = frac;
                e2 = 0 - 1074;
            }
            else
            {
                m = frac | (u64)4503599627370496;
                e2 = e - 1075;
            };
            sq_exact_mant(m * (u64)2 + (u64)1, e2 - 1, @hi[0], @nhi, @Xhi);
            if (frac == (u64)0 & e > 1) { sq_exact_mant(m * (u64)4 - (u64)1, e2 - 2, @lo[0], @nlo, @Xlo); }
            else { sq_exact_mant(m * (u64)2 - (u64)1, e2 - 1, @lo[0], @nlo, @Xlo); };
            even = 0;
            if (m % (u64)2 == (u64)0) { even = 1; };
            c1 = sq_cmp_dec(d, nd, X, @hi[0], nhi, Xhi);
            c2 = sq_cmp_dec(d, nd, X, @lo[0], nlo, Xlo);
            if (c1 > 0 | c2 < 0) { return false; };
            if (c1 == 0 & even == 0) { return false; };
            if (c2 == 0 & even == 0) { return false; };
            return true;
        };

        // %!.17g of SQLite: 17 digits, reduced when a shorter form reads back as the same double
        def sq_real_text(double r, byte* out) -> int
        {
            byte[1300] dig;
            byte[64] dbuf;
            byte[24] ex;
            int neg, nd, X, o, i, en, kk, ndg, Xf, dp17;
            byte* ds;
            neg = sq_real_exact(r, @dig[0], @nd, @X);
            o = 0;
            if (neg == 3) { out[0] = (byte)78; out[1] = (byte)97; out[2] = (byte)78; out[3] = (byte)0; return 3; };
            if (neg == 4)
            {
                out[0] = (byte)48; out[1] = (byte)46; out[2] = (byte)48; out[3] = (byte)0;
                return 3;
            };
            if (neg == 2)
            {
                if (r < 0.0) { out[0] = (byte)45; o = 1; };
                out[o] = (byte)73; out[o + 1] = (byte)110; out[o + 2] = (byte)102; out[o + 3] = (byte)0;
                return o + 3;
            };
            if (neg == 1) { out[o] = (byte)45; o++; };
            if (r < 0.0) { sq_fp_decode17(0.0 - r, @dbuf[0], @ndg, @dp17); }
            else { sq_fp_decode17(r, @dbuf[0], @ndg, @dp17); };
            ds = @dbuf[0];
            Xf = dp17 - 1;
            while (ndg > 1)
            {
                if (ds[ndg - 1] == (byte)48) { ndg--; } else { break; };
            };
            X = Xf;
            if (X < 0 - 4 | X >= 17)
            {
                out[o] = ds[0]; o++;
                out[o] = (byte)46; o++;
                if (ndg == 1) { out[o] = (byte)48; o++; }
                else { for (i = 1; i < ndg; i++) { out[o] = ds[i]; o++; }; };
                out[o] = (byte)101; o++;
                kk = X;
                if (kk < 0) { out[o] = (byte)45; kk = 0 - kk; } else { out[o] = (byte)43; };
                o++;
                en = 0;
                if (kk >= 100) { ex[en] = (byte)(48 + kk / 100); en++; kk = kk % 100; ex[en] = (byte)(48 + kk / 10); en++; ex[en] = (byte)(48 + kk % 10); en++; }
                else { ex[en] = (byte)(48 + kk / 10); en++; ex[en] = (byte)(48 + kk % 10); en++; };
                for (i = 0; i < en; i++) { out[o] = ex[i]; o++; };
                out[o] = (byte)0;
                return o;
            };
            if (X >= 0)
            {
                for (i = 0; i <= X; i++)
                {
                    if (i < ndg) { out[o] = ds[i]; } else { out[o] = (byte)48; };
                    o++;
                };
                out[o] = (byte)46; o++;
                if (ndg > X + 1) { for (i = X + 1; i < ndg; i++) { out[o] = ds[i]; o++; }; }
                else { out[o] = (byte)48; o++; };
                out[o] = (byte)0;
                return o;
            };
            out[o] = (byte)48; o++;
            out[o] = (byte)46; o++;
            for (i = 0; i < 0 - X - 1; i++) { out[o] = (byte)48; o++; };
            for (i = 0; i < ndg; i++) { out[o] = ds[i]; o++; };
            out[o] = (byte)0;
            return o;
        };


        def sq_p10(int k) -> double
        {
            double r = 1.0;
            double b = 10.0;
            while (k > 0)
            {
                if (k % 2 == 1) { r = r * b; };
                b = b * b;
                k = k / 2;
            };
            return r;
        };

        // Conversion of the decimal digits dg[0..nd) with exponent X of the first digit, the way sqlite3AtoF does it:
        // at most about 19 digits contribute, the rest are dropped.
        def sq_dec2dbl(byte* dg, int nd, int X) -> double
        {
            u64 s, lim;
            int k;
            while (nd > 0)
            {
                if (dg[0] == (byte)48) { dg = @dg[1]; nd--; X--; } else { break; };
            };
            if (nd == 0) { return 0.0; };
            lim = (u64)1844674407370955160;
            s = (u64)0;
            k = 0;
            while (k < nd)
            {
                if (s >= lim) { break; };
                s = s * (u64)10 + (u64)((int)dg[k] - 48);
                k++;
            };
            if (s == (u64)0) { return 0.0; };
            return sq_fp10conv2(s, X - (k - 1));
        };
        // Parses a numeric prefix of text (leading spaces allowed) into an integer or real value.
        def sq_str2num(byte* p, int n, SQ_VAL* o) -> void
        {
            int i = 0;
            int neg = 0;
            int ovf = 0;
            int isreal = 0;
            int fexp = 0;
            int e = 0;
            int eneg = 0;
            int k;
            u64 m = (u64)0;
            double d = 0.0;
            byte[800] dg;
            int ndg = 0;
            int nint = 0;
            while (i < n)
            {
                if (p[i] == (byte)32 | p[i] == (byte)9 | p[i] == (byte)10 | p[i] == (byte)13) { i++; } else { break; };
            };
            if (i < n)
            {
                if (p[i] == (byte)45) { neg = 1; i++; }
                else { if (p[i] == (byte)43) { i++; }; };
            };
            while (i < n)
            {
                if (sq_isdigit(p[i]) == false) { break; };
                if (ovf == 0)
                {
                    if (m > (u64)922337203685477580) { ovf = 1; }
                    else
                    {
                        if (m == (u64)922337203685477580 & (int)p[i] - 48 > 7) { ovf = 1; }
                        else { m = m * (u64)10 + (u64)((int)p[i] - 48); };
                    };
                };
                if (ndg < 780) { dg[ndg] = p[i]; ndg++; };
                nint++;
                i++;
            };
            if (i < n)
            {
                if (p[i] == (byte)46)
                {
                    isreal = 1;
                    i++;
                    while (i < n)
                    {
                        if (sq_isdigit(p[i]) == false) { break; };
                        if (ndg < 780) { dg[ndg] = p[i]; ndg++; };
                        fexp--;
                        i++;
                    };
                };
            };
            if (i < n)
            {
                if (p[i] == (byte)101 | p[i] == (byte)69)
                {
                    k = i + 1;
                    if (k < n)
                    {
                        if (p[k] == (byte)45) { eneg = 1; k++; }
                        else { if (p[k] == (byte)43) { k++; }; };
                    };
                    if (k < n)
                    {
                        if (sq_isdigit(p[k]))
                        {
                            isreal = 1;
                            while (k < n)
                            {
                                if (sq_isdigit(p[k]) == false) { break; };
                                if (e < 10000) { e = e * 10 + ((int)p[k] - 48); };
                                k++;
                            };
                            if (eneg == 1) { e = 0 - e; };
                        };
                    };
                };
            };
            if (isreal == 0 & ovf == 0)
            {
                if (neg == 1) { sq_val_int(o, (i64)0 - (i64)m); } else { sq_val_int(o, (i64)m); };
                return;
            };
            d = sq_dec2dbl(@dg[0], ndg, nint - 1 + e);
            if (neg == 1) { d = 0.0 - d; };
            sq_val_real(o, d);
        };

        // Numeric view of a value (text and blobs are parsed, null stays null).
        def sq_tonum(SQ_VAL* v, SQ_VAL* o) -> void
        {
            if (v.t == SQ_INTEGER | v.t == SQ_REAL) { sq_val_copy(o, v); return; };
            if (v.t == SQ_NULL) { sq_val_null(o); return; };
            sq_str2num(v.p, v.n, o);
        };

        def sq_as_double(SQ_VAL* v) -> double
        {
            SQ_VAL t;
            sq_tonum(v, @t);
            if (t.t == SQ_INTEGER) { return (double)t.i; };
            if (t.t == SQ_REAL) { return t.r; };
            return 0.0;
        };

        // -1 null, 0 false, 1 true
        def sq_truth(SQ_VAL* v) -> int
        {
            SQ_VAL t;
            if (v.t == SQ_NULL) { return 0 - 1; };
            sq_tonum(v, @t);
            if (t.t == SQ_INTEGER) { if (t.i != (i64)0) { return 1; }; return 0; };
            if (t.r != 0.0) { return 1; };
            return 0;
        };

        // Text form of a value allocated from the arena (null stays null).
        def sq_val_text(SQ_ARENA* a, SQ_VAL* v, SQ_VAL* o) -> void
        {
            byte[64] buf;
            int n;
            if (v.t == SQ_NULL) { sq_val_null(o); return; };
            if (v.t == SQ_TEXT) { sq_val_copy(o, v); return; };
            if (v.t == SQ_BLOB)
            {
                o.t = SQ_TEXT; o.n = v.n; o.p = v.p; o.i = (i64)0; o.r = 0.0;
                return;
            };
            if (v.t == SQ_INTEGER) { n = sq_itoa(v.i, @buf[0]); } else { n = sq_real_text(v.r, @buf[0]); };
            o.t = SQ_TEXT; o.n = n; o.i = (i64)0; o.r = 0.0;
            o.p = sq_ar_copy(a, @buf[0], n);
            if ((u64)o.p == (u64)0) { sq_val_null(o); };
        };

        def sq_mem_eq(byte* a, byte* b, int n) -> bool
        {
            int i;
            for (i = 0; i < n; i++) { if (a[i] != b[i]) { return false; }; };
            return true;
        };

        def sq_atoi(byte* p, int n) -> i64
        {
            SQ_VAL v;
            sq_str2num(p, n, @v);
            if (v.t == SQ_INTEGER) { return v.i; };
            return (i64)v.r;
        };

        def sq_utoa(u64 u, byte* buf) -> int
        {
            byte[24] tmp;
            int n = 0;
            int k = 0;
            if (u == (u64)0) { buf[0] = (byte)48; buf[1] = (byte)0; return 1; };
            while (u != (u64)0) { tmp[n] = (byte)(48 + (int)(u % (u64)10)); u = u / (u64)10; n++; };
            while (n > 0) { n--; buf[k] = tmp[n]; k++; };
            buf[k] = (byte)0;
            return k;
        };

        def sq_numtext(byte* p, int n, SQ_VAL* o) -> bool
        {
            int i, e, j, k, digits;
            i = 0;
            e = n;
            while (i < e)
            {
                if (p[i] == (byte)32 | p[i] == (byte)9 | p[i] == (byte)10 | p[i] == (byte)13) { i++; } else { break; };
            };
            while (e > i)
            {
                if (p[e - 1] == (byte)32 | p[e - 1] == (byte)9 | p[e - 1] == (byte)10 | p[e - 1] == (byte)13) { e--; } else { break; };
            };
            if (i >= e) { return false; };
            j = i;
            if (p[j] == (byte)43 | p[j] == (byte)45) { j++; };
            digits = 0;
            while (j < e)
            {
                if (sq_isdigit(p[j])) { j++; digits++; } else { break; };
            };
            if (j < e)
            {
                if (p[j] == (byte)46)
                {
                    j++;
                    while (j < e)
                    {
                        if (sq_isdigit(p[j])) { j++; digits++; } else { break; };
                    };
                };
            };
            if (digits == 0) { return false; };
            if (j < e)
            {
                if (p[j] == (byte)101 | p[j] == (byte)69)
                {
                    j++;
                    if (j < e)
                    {
                        if (p[j] == (byte)43 | p[j] == (byte)45) { j++; };
                    };
                    k = j;
                    while (j < e)
                    {
                        if (sq_isdigit(p[j])) { j++; } else { break; };
                    };
                    if (j == k) { return false; };
                };
            };
            if (j != e) { return false; };
            sq_str2num(@p[i], e - i, o);
            return true;
        };
        def sq_class(SQ_VAL* v) -> int
        {
            if (v.t == SQ_NULL) { return 0; };
            if (v.t == SQ_INTEGER | v.t == SQ_REAL) { return 1; };
            if (v.t == SQ_TEXT) { return 2; };
            return 3;
        };

        def sq_cmp_text(byte* a, int na, byte* b, int nb, int coll) -> int
        {
            int i, n;
            byte x, y;
            if (coll == SQC_RTRIM)
            {
                while (na > 0) { if (a[na - 1] == (byte)32) { na--; } else { break; }; };
                while (nb > 0) { if (b[nb - 1] == (byte)32) { nb--; } else { break; }; };
            };
            n = na;
            if (nb < n) { n = nb; };
            for (i = 0; i < n; i++)
            {
                x = a[i];
                y = b[i];
                if (coll == SQC_NOCASE) { x = sq_lc(x); y = sq_lc(y); };
                if (x != y)
                {
                    if (x < y) { return 0 - 1; };
                    return 1;
                };
            };
            if (na < nb) { return 0 - 1; };
            if (na > nb) { return 1; };
            return 0;
        };

        // SQLite ordering: null < numbers < text < blob; text uses the collation
        def sq_val_cmpc(SQ_VAL* a, SQ_VAL* b, int coll) -> int
        {
            int ca = sq_class(a);
            int cb = sq_class(b);
            double x, y;
            if (ca != cb) { if (ca < cb) { return 0 - 1; }; return 1; };
            if (ca == 0) { return 0; };
            if (ca == 1)
            {
                if (a.t == SQ_INTEGER & b.t == SQ_INTEGER)
                {
                    if (a.i < b.i) { return 0 - 1; };
                    if (a.i > b.i) { return 1; };
                    return 0;
                };
                x = sq_as_double(a);
                y = sq_as_double(b);
                if (x < y) { return 0 - 1; };
                if (x > y) { return 1; };
                return 0;
            };
            if (ca == 3) { return sq_cmp_text(a.p, a.n, b.p, b.n, 0); };
            return sq_cmp_text(a.p, a.n, b.p, b.n, coll);
        };

        def sq_val_cmp(SQ_VAL* a, SQ_VAL* b) -> int
        {
            return sq_val_cmpc(a, b, 0);
        };

        // Applies column affinity (0 none, 1 text, 2 numeric, 3 integer, 4 real) to v.
        def sq_apply_aff(SQ_ARENA* ar, int aff, SQ_VAL* v) -> void
        {
            SQ_VAL t;
            if (v.t == SQ_NULL | aff == 0) { return; };
            if (aff == 1)
            {
                if (v.t == SQ_INTEGER | v.t == SQ_REAL)
                {
                    sq_val_text(ar, v, @t);
                    sq_val_copy(v, @t);
                };
                return;
            };
            if (aff == 4)
            {
                if (v.t == SQ_INTEGER) { sq_val_real(v, (double)v.i); return; };
                if (v.t == SQ_TEXT)
                {
                    if (sq_numtext(v.p, v.n, @t))
                    {
                        if (t.t == SQ_INTEGER) { sq_val_real(v, (double)t.i); } else { sq_val_copy(v, @t); };
                    };
                };
                return;
            };
            if (v.t == SQ_TEXT)
            {
                if (sq_numtext(v.p, v.n, @t)) { sq_val_copy(v, @t); };
            };
            if (v.t == SQ_REAL)
            {
                if (v.r > 0.0 - 9.2e18 & v.r < 9.2e18)
                {
                    if (v.r == (double)((i64)v.r)) { sq_val_int(v, (i64)v.r); };
                };
            };
        };

        // integer prefix of text (spaces, sign, digits); out of range values clamp
        def sq_int_prefix(byte* p, int n, SQ_VAL* o) -> void
        {
            int i = 0;
            int neg = 0;
            u64 m = (u64)0;
            u64 lim;
            int ovf = 0;
            while (i < n)
            {
                if (p[i] == (byte)32 | p[i] == (byte)9 | p[i] == (byte)10 | p[i] == (byte)13) { i++; } else { break; };
            };
            if (i < n)
            {
                if (p[i] == (byte)45) { neg = 1; i++; }
                else { if (p[i] == (byte)43) { i++; }; };
            };
            lim = ((u64)1 << 63) - (u64)1;
            while (i < n)
            {
                if (sq_isdigit(p[i]) == false) { break; };
                if (ovf == 0)
                {
                    if (m > (lim - (u64)((int)p[i] - 48)) / (u64)10) { ovf = 1; }
                    else { m = m * (u64)10 + (u64)((int)p[i] - 48); };
                };
                i++;
            };
            if (ovf == 1)
            {
                if (neg == 1) { sq_val_int(o, (i64)0 - (i64)9223372036854775807 - (i64)1); } else { sq_val_int(o, (i64)9223372036854775807); };
                return;
            };
            if (neg == 1) { sq_val_int(o, (i64)0 - (i64)m); } else { sq_val_int(o, (i64)m); };
        };

        // CAST: ty 0 blob, 1 text, 2 numeric, 3 integer, 4 real
        def sq_cast(SQ_ARENA* ar, SQ_VAL* v, int ty, SQ_VAL* o) -> void
        {
            SQ_VAL t;
            if (v.t == SQ_NULL) { sq_val_null(o); return; };
            if (ty == 1) { sq_val_text(ar, v, o); return; };
            if (ty == 0)
            {
                sq_val_text(ar, v, @t);
                sq_val_copy(o, @t);
                o.t = SQ_BLOB;
                return;
            };
            if (ty == 4) { sq_val_real(o, sq_as_double(v)); return; };
            if (ty == 3 & (v.t == SQ_TEXT | v.t == SQ_BLOB))
            {
                // text converts through its integer prefix only
                sq_int_prefix(v.p, v.n, o);
                return;
            };
            sq_tonum(v, @t);
            if (ty == 3)
            {
                if (t.t == SQ_INTEGER) { sq_val_copy(o, @t); return; };
                if (t.r >= 9.2233720368547758e18) { sq_val_int(o, (i64)9223372036854775807); return; };
                if (t.r <= 0.0 - 9.2233720368547758e18) { sq_val_int(o, (i64)0 - (i64)9223372036854775807 - (i64)1); return; };
                sq_val_int(o, (i64)t.r);
                return;
            };
            // numeric: a real that is a whole number becomes an integer
            sq_val_copy(o, @t);
            sq_apply_aff(ar, 2, o);
        };

        def sq_bitop(int op, SQ_VAL* x, SQ_VAL* y, SQ_VAL* o) -> void
        {
            SQ_VAL a, b;
            i64 p, q;
            int sh;
            if (x.t == SQ_NULL | y.t == SQ_NULL) { sq_val_null(o); return; };
            sq_cast((SQ_ARENA*)0, x, 3, @a);
            sq_cast((SQ_ARENA*)0, y, 3, @b);
            p = a.i;
            q = b.i;
            if (op == SQO_BAND) { sq_val_int(o, (i64)((u64)p `& (u64)q)); return; };
            if (op == SQO_BOR) { sq_val_int(o, (i64)((u64)p | (u64)q)); return; };
            sh = (int)q;
            if (op == SQO_SHR) { sh = 0 - sh; };
            // SQO_SHL: positive shifts left, negative shifts right
            if (sh >= 64) { sq_val_int(o, (i64)0); return; };
            if (sh <= 0 - 64)
            {
                if (p < (i64)0) { sq_val_int(o, (i64)0 - (i64)1); } else { sq_val_int(o, (i64)0); };
                return;
            };
            if (sh >= 0) { sq_val_int(o, (i64)((u64)p << sh)); return; };
            sh = 0 - sh;
            if (p >= (i64)0) { sq_val_int(o, (i64)((u64)p >> sh)); return; };
            sq_val_int(o, (i64)0 - (i64)1 - (i64)(((u64)0 - (u64)p - (u64)1) >> sh));
        };

        def sq_arith(int op, SQ_VAL* x, SQ_VAL* y, SQ_VAL* o) -> void
        {
            SQ_VAL a, b;
            double da, db2;
            i64 r;
            if (x.t == SQ_NULL | y.t == SQ_NULL) { sq_val_null(o); return; };
            sq_tonum(x, @a);
            sq_tonum(y, @b);
            if (a.t == SQ_INTEGER & b.t == SQ_INTEGER)
            {
                if (op == SQO_ADD)
                {
                    r = a.i + b.i;
                    if ((a.i >= (i64)0) == (b.i >= (i64)0) & (r >= (i64)0) != (a.i >= (i64)0)) { sq_val_real(o, (double)a.i + (double)b.i); return; };
                    sq_val_int(o, r);
                    return;
                };
                if (op == SQO_SUB)
                {
                    r = a.i - b.i;
                    if ((a.i >= (i64)0) != (b.i >= (i64)0) & (r >= (i64)0) != (a.i >= (i64)0)) { sq_val_real(o, (double)a.i - (double)b.i); return; };
                    sq_val_int(o, r);
                    return;
                };
                if (op == SQO_MUL)
                {
                    if (a.i == (i64)0 | b.i == (i64)0) { sq_val_int(o, (i64)0); return; };
                    if (a.i == (i64)0 - (i64)1 | b.i == (i64)0 - (i64)1)
                    {
                        r = a.i;
                        if (a.i == (i64)0 - (i64)1) { r = b.i; };
                        if (r == (i64)0 - (i64)9223372036854775807 - (i64)1) { sq_val_real(o, 9223372036854775808.0); return; };
                        sq_val_int(o, (i64)0 - r);
                        return;
                    };
                    r = (i64)((u64)a.i * (u64)b.i);
                    if (r / a.i != b.i) { sq_val_real(o, (double)a.i * (double)b.i); return; };
                    sq_val_int(o, r);
                    return;
                };
                if (b.i == (i64)0) { sq_val_null(o); return; };
                if (b.i == (i64)0 - (i64)1)
                {
                    if (op == SQO_DIV) { sq_val_int(o, (i64)0 - a.i); return; };
                    sq_val_int(o, (i64)0);
                    return;
                };
                if (op == SQO_DIV) { sq_val_int(o, a.i / b.i); return; };
                sq_val_int(o, a.i % b.i);
                return;
            };
            da = sq_as_double(@a);
            db2 = sq_as_double(@b);
            if (op == SQO_ADD) { sq_val_real(o, da + db2); return; };
            if (op == SQO_SUB) { sq_val_real(o, da - db2); return; };
            if (op == SQO_MUL) { sq_val_real(o, da * db2); return; };
            if (op == SQO_DIV)
            {
                if (db2 == 0.0) { sq_val_null(o); return; };
                sq_val_real(o, da / db2);
                return;
            };
            // modulo on reals works on the integer parts
            i64 ia = (i64)da;
            i64 ib = (i64)db2;
            if (ib == (i64)0) { sq_val_null(o); return; };
            if (ib == (i64)0 - (i64)1) { sq_val_real(o, 0.0); return; };
            sq_val_real(o, (double)(ia % ib));
        };

        def sq_utf8_len(byte* p, int n) -> int
        {
            int i, c;
            c = 0;
            for (i = 0; i < n; i++)
            {
                if (p[i] < (byte)128 | p[i] >= (byte)192) { c++; };
            };
            return c;
        };

        // byte offset of character index ci (clamped to n)
        def sq_utf8_off(byte* p, int n, int ci) -> int
        {
            int i = 0;
            int c = 0;
            while (i < n)
            {
                if (p[i] < (byte)128 | p[i] >= (byte)192)
                {
                    if (c == ci) { return i; };
                    c++;
                };
                i++;
            };
            return n;
        };
        // LIKE with optional escape character (esc < 0 when none); ASCII case folding
        def sq_like(byte* p, int pl, byte* s, int sl, int esc) -> bool
        {
            int pi = 0;
            int si = 0;
            int star = 0 - 1;
            int mark = 0;
            int kind, lit, step;
            bool ok;
            while (si < sl)
            {
                ok = false;
                if (pi < pl)
                {
                    kind = 2;
                    lit = (int)p[pi];
                    step = 1;
                    if (esc >= 0 & lit == esc & pi + 1 < pl) { lit = (int)p[pi + 1]; step = 2; }
                    else
                    {
                        if (p[pi] == (byte)37) { kind = 0; };
                        if (p[pi] == (byte)95) { kind = 1; };
                    };
                    if (kind == 0)
                    {
                        star = pi;
                        mark = si;
                        pi++;
                        continue;
                    };
                    if (kind == 1)
                    {
                        pi++;
                        si++;
                        while (si < sl)
                        {
                            if (s[si] >= (byte)128 & s[si] < (byte)192) { si++; } else { break; };
                        };
                        ok = true;
                    }
                    else
                    {
                        if (sq_lc((byte)lit) == sq_lc(s[si])) { pi = pi + step; si++; ok = true; };
                    };
                };
                if (ok == false)
                {
                    if (star >= 0)
                    {
                        pi = star + 1;
                        mark++;
                        si = mark;
                    }
                    else { return false; };
                };
            };
            while (pi < pl)
            {
                if (p[pi] == (byte)37) { pi++; } else { break; };
            };
            return pi == pl;
        };

        // GLOB: * ? [set] [^set], case sensitive
        def sq_glob(byte* p, int pl, byte* s, int sl) -> bool
        {
            int pi = 0;
            int si = 0;
            int star = 0 - 1;
            int mark = 0;
            int j, neg;
            bool ok, hit;
            byte c, lo, hi;
            while (si < sl)
            {
                ok = false;
                if (pi < pl)
                {
                    c = p[pi];
                    if (c == (byte)42)
                    {
                        star = pi;
                        mark = si;
                        pi++;
                        continue;
                    };
                    if (c == (byte)63)
                    {
                        pi++;
                        si++;
                        while (si < sl)
                        {
                            if (s[si] >= (byte)128 & s[si] < (byte)192) { si++; } else { break; };
                        };
                        ok = true;
                    }
                    else
                    {
                        if (c == (byte)91)
                        {
                            j = pi + 1;
                            neg = 0;
                            if (j < pl)
                            {
                                if (p[j] == (byte)94) { neg = 1; j++; };
                            };
                            hit = false;
                            if (j < pl)
                            {
                                // a leading ] is a member
                                if (p[j] == (byte)93)
                                {
                                    if (s[si] == (byte)93) { hit = true; };
                                    j++;
                                };
                            };
                            while (j < pl)
                            {
                                if (p[j] == (byte)93) { break; };
                                lo = p[j];
                                hi = lo;
                                if (j + 2 < pl)
                                {
                                    if (p[j + 1] == (byte)45 & p[j + 2] != (byte)93) { hi = p[j + 2]; j = j + 2; };
                                };
                                if (s[si] >= lo & s[si] <= hi) { hit = true; };
                                j++;
                            };
                            if (j < pl)
                            {
                                if (hit == (neg == 0)) { pi = j + 1; si++; ok = true; };
                            };
                        }
                        else
                        {
                            if (c == s[si]) { pi++; si++; ok = true; };
                        };
                    };
                };
                if (ok == false)
                {
                    if (star >= 0)
                    {
                        pi = star + 1;
                        mark++;
                        si = mark;
                    }
                    else { return false; };
                };
            };
            while (pi < pl)
            {
                if (p[pi] == (byte)42) { pi++; } else { break; };
            };
            return pi == pl;
        };

        def sq_mcpy(byte* d, byte* s, int n) -> void
        {
            int i;
            for (i = 0; i < n; i++) { d[i] = s[i]; };
        };

        struct SQ_NODE
        {
            int kind, op, a, b, c, next, s, sl, col, qs, ql;
            int blk, src, lvl, aff, agg, coll, owner, hasc;
            i64 iv;
            double rv;
        };

        // column information of a table (or the result columns of a derived source)
        struct SQ_TI
        {
            byte* base;
            int ncols, ipk, autoinc, nchk, npk, nuq, rowid_alias;
            int[128] cs, cl, aff, coll, notnull, pk, uniq, hid, dfs, dfl, chs, chl, ity;
            int[16] ks, kl;
            int[16] pkc;
            int[8] uqn;
            int[128] uqc;
            int nix;
            int[8] ixn, ixpk;
            int[64] ixc;
        };

        // rowset: ncols values per row, strings live in the arena
        struct SQ_RS
        {
            int nc, vis, n, cap;
            SQ_VAL* d;
            SQ_ARENA ar;
        };

        struct SQ_SRC
        {
            int kind, jt, natural, nusing, on, tbl, root, blk, ts, tl, as_s, as_l, ncols;
            int[16] us, ul, uls, ulc, urc;
            SQ_TI* ti;
            SQ_RS* rs;
            int rs_shared;
            int cte;
            // index scan hints produced by the planner
            int plan, pcol, pexpr, pexpr2, pop, pop2;
        };

        struct SQ_SET
        {
            int nk, n, cap, bsize;
            SQ_VAL* keys;
            int* bucket;
            int* nxt;
            int* hs;
            int isnew;
            int[16] coll;
            SQ_ARENA ar;
        };

        struct SQ_ACC
        {
            i64 n, si;
            double sr, se;
            int isreal, seen, ovf;
            SQ_VAL v;
            byte* gc;
            int gcn, gccap;
            SQ_SET* dset;
        };

        struct SQ_GRP
        {
            SQ_VAL* key;
            SQ_ACC* acc;
            int[8] rep;
            SQ_VAL* rep0;
            int hnext;
        };

        struct SQ_BLK
        {
            int nsrc, nres, distinct, where_n, ngrp, having, nord, limit_n, offset_n;
            int cop, cnext, parent, nagg, has_agg, ncte, bidx, star_cnt, bdone;
            int is_corr;
            SQ_SRC* src;
            int[128] rc, rns, rnl;
            int[16] grp;
            int[16] ord, odesc, ocoll, onull;
            int[32] aggn;
            int[32] wcn, wcl;
            int nwc, nminmax, stream, bare;
            SQ_CURSOR scur;
            // run state
            int[8] cur;
            SQ_ARENA scr;
            SQ_VAL* aggv;
            SQ_RS* out;
            SQ_GRP* groups;
            int ngroups, gcap;
            int* hbuck;
            int hsize;
            SQ_ARENA gar;
            int* hrun;
            int rjmax;
            u64[8] rfl;
            int[4] pad;
        };

        struct SQ_ARM
        {
            SQ_RS* rs;
            SQ_VAL[160] vals;
            i64 skip, lim;
            int count, nres, nkeys, stop, err, sorted;
            SQ_SET dset;
            int use_dset;
        };

        struct SQ_CTE
        {
            int ns, nl, blk, ncols, ncn;
            int[32] cns, cnl;
            SQ_RS* rs;
        };

        struct SQ_STMT
        {
            SQLITE_DB* db;
            byte[262144] sql;
            int sqllen, lim;
            // lexer
            int pos, tk, ts, tl, tq, tcode, tend, prevend;
            // syntax tree
            SQ_NODE* nodes;
            int nn, ncap;
            SQ_BLK*[64] blks;
            int nblk;
            SQ_CTE[16] ctes;
            int ncte;
            int kind, root_blk, nres, curblk, pcount, bn;
            // parameters
            int nparam;
            SQ_VAL[64] pv;
            int[64] pns, pnl;
            SQ_ARENA par;
            // execution
            int state, ri;
            SQ_RS* res;
            SQ_ARENA ar;
            int ncols_out;
            i64 last_rowid;
            int changes;
            SQ_VAL[128] out;
            byte[160] err;
            // DML helpers filled by sqlite_write.idk
            int dml_tbl, dml_root;
            int pad;
            // rows produced by RETURNING (kind 3) and the text used to name their columns
            SQ_RS* ret;
            byte* retsql;
            int ret_s, ret_e;
        };

        def sq_seterr(SQ_STMT* st, byte* msg) -> void
        {
            int i = 0;
            if (st.err[0] != (byte)0) { return; };
            while (msg[i] != (byte)0 & i < 150) { st.err[i] = msg[i]; i++; };
            st.err[i] = (byte)0;
        };

        // formats "<msg> <name>" where name is st.sql[s..s+l)
        def sq_seterr_n(SQ_STMT* st, byte* msg, int s, int l) -> void
        {
            int i = 0;
            int k;
            if (st.err[0] != (byte)0) { return; };
            while (msg[i] != (byte)0 & i < 120) { st.err[i] = msg[i]; i++; };
            st.err[i] = (byte)58; i++;
            st.err[i] = (byte)32; i++;
            for (k = 0; k < l & i < 158; k++) { st.err[i] = st.sql[s + k]; i++; };
            st.err[i] = (byte)0;
        };


        // element strides in bytes (sizeof counts bits and ignores padding, so the stride is measured)
        def sq_nsz() -> int
        {
            SQ_NODE[2] a;
            return (int)((u64)@a[1] - (u64)@a[0]);
        };

        def sq_vsz() -> int
        {
            SQ_VAL[2] a;
            return (int)((u64)@a[1] - (u64)@a[0]);
        };

        def sq_gsz() -> int
        {
            SQ_GRP[2] a;
            return (int)((u64)@a[1] - (u64)@a[0]);
        };
        // ---- lexer ----

        def sq_next(SQ_STMT* st) -> void
        {
            byte* s = @st.sql[0];
            int i = st.pos;
            int n = st.lim;
            int j;
            byte c, c2;
            st.prevend = st.tend;
            while (i < n)
            {
                c = s[i];
                if (c == (byte)32 | c == (byte)9 | c == (byte)10 | c == (byte)13) { i++; }
                else
                {
                    if (c == (byte)45 & s[i + 1] == (byte)45)
                    {
                        while (i < n & s[i] != (byte)10) { i++; };
                    }
                    else
                    {
                        if (c == (byte)47 & s[i + 1] == (byte)42)
                        {
                            i = i + 2;
                            while (i < n)
                            {
                                if (s[i] == (byte)42 & s[i + 1] == (byte)47) { i = i + 2; break; };
                                i++;
                            };
                        }
                        else { break; };
                    };
                };
            };
            st.ts = i;
            st.tq = 0;
            st.tcode = 0;
            if (i >= n) { st.tk = 0; st.tl = 0; st.tend = i; st.pos = i; return; };
            c = s[i];
            if ((c == (byte)120 | c == (byte)88) & s[i + 1] == (byte)39)
            {
                j = i + 2;
                while (j < n & s[j] != (byte)39) { j++; };
                st.tk = 6; st.ts = i + 2; st.tl = j - i - 2;
                if (j < n) { j++; };
                st.tend = j; st.pos = j;
                return;
            };
            if (sq_isalpha(c))
            {
                j = i;
                while (j < n)
                {
                    if (sq_isalpha(s[j]) | sq_isdigit(s[j]) | s[j] == (byte)36) { j++; } else { break; };
                };
                st.tk = 1; st.tl = j - i; st.tend = j; st.pos = j;
                return;
            };
            if (c == (byte)34 | c == (byte)96 | c == (byte)91)
            {
                c2 = c;
                if (c == (byte)91) { c2 = (byte)93; };
                j = i + 1;
                while (j < n & s[j] != c2) { j++; };
                st.tk = 1; st.tq = 1; st.ts = i + 1; st.tl = j - i - 1;
                if (j < n) { j++; };
                st.tend = j; st.pos = j;
                return;
            };
            if (c == (byte)48 & (s[i + 1] == (byte)120 | s[i + 1] == (byte)88) & sq_ishex(s[i + 2]))
            {
                j = i + 2;
                while (j < n)
                {
                    if (sq_ishex(s[j])) { j++; } else { break; };
                };
                st.tk = 2; st.tl = j - i; st.tend = j; st.pos = j;
                return;
            };
            if (sq_isdigit(c) | (c == (byte)46 & sq_isdigit(s[i + 1])))
            {
                j = i;
                while (j < n)
                {
                    if (sq_isdigit(s[j]) | s[j] == (byte)46) { j++; } else { break; };
                };
                if (j < n)
                {
                    if (s[j] == (byte)101 | s[j] == (byte)69)
                    {
                        c2 = s[j + 1];
                        if (sq_isdigit(c2)) { j = j + 1; while (j < n & sq_isdigit(s[j])) { j++; }; }
                        else
                        {
                            if ((c2 == (byte)43 | c2 == (byte)45) & sq_isdigit(s[j + 2]))
                            {
                                j = j + 2;
                                while (j < n & sq_isdigit(s[j])) { j++; };
                            };
                        };
                    };
                };
                st.tk = 2; st.tl = j - i; st.tend = j; st.pos = j;
                return;
            };
            if (c == (byte)39)
            {
                j = i + 1;
                while (j < n)
                {
                    if (s[j] == (byte)39)
                    {
                        if (s[j + 1] == (byte)39) { j = j + 2; } else { break; };
                    }
                    else { j++; };
                };
                st.tk = 4; st.ts = i + 1; st.tl = j - i - 1;
                if (j < n) { j++; };
                st.tend = j; st.pos = j;
                return;
            };
            if (c == (byte)63 | ((c == (byte)58 | c == (byte)64 | c == (byte)36) & sq_isalpha(s[i + 1])))
            {
                j = i + 1;
                if (c == (byte)63) { while (j < n & sq_isdigit(s[j])) { j++; }; }
                else { while (j < n & (sq_isalpha(s[j]) | sq_isdigit(s[j]))) { j++; }; };
                st.tk = 7; st.tl = j - i; st.tend = j; st.pos = j;
                return;
            };
            st.tk = 5;
            st.tcode = (int)c;
            st.tl = 1;
            c2 = s[i + 1];
            if (c == (byte)60 & c2 == (byte)61) { st.tcode = 76; st.tl = 2; };
            if (c == (byte)62 & c2 == (byte)61) { st.tcode = 71; st.tl = 2; };
            if (c == (byte)60 & c2 == (byte)62) { st.tcode = 78; st.tl = 2; };
            if (c == (byte)33 & c2 == (byte)61) { st.tcode = 78; st.tl = 2; };
            if (c == (byte)61 & c2 == (byte)61) { st.tcode = 61; st.tl = 2; };
            if (c == (byte)124 & c2 == (byte)124) { st.tcode = 67; st.tl = 2; };
            if (c == (byte)60 & c2 == (byte)60) { st.tcode = 80; st.tl = 2; };
            if (c == (byte)62 & c2 == (byte)62) { st.tcode = 81; st.tl = 2; };
            st.tend = i + st.tl;
            st.pos = i + st.tl;
        };

        def sq_is_op(SQ_STMT* st, int code) -> bool
        {
            return st.tk == 5 & st.tcode == code;
        };

        def sq_is_kw(SQ_STMT* st, byte* kw) -> bool
        {
            if (st.tk != 1 | st.tq != 0) { return false; };
            return sq_ieq(@st.sql[st.ts], st.tl, kw);
        };

        // true when the token after the current one is the operator code
        def sq_peek_op(SQ_STMT* st, int code) -> bool
        {
            int p0 = st.pos, k0 = st.tk, s0 = st.ts, l0 = st.tl, q0 = st.tq, c0 = st.tcode, e0 = st.tend, v0 = st.prevend;
            bool r;
            sq_next(st);
            r = sq_is_op(st, code);
            st.pos = p0; st.tk = k0; st.ts = s0; st.tl = l0; st.tq = q0; st.tcode = c0; st.tend = e0; st.prevend = v0;
            return r;
        };

        def sq_peek_kw(SQ_STMT* st, byte* kw) -> bool
        {
            int p0 = st.pos, k0 = st.tk, s0 = st.ts, l0 = st.tl, q0 = st.tq, c0 = st.tcode, e0 = st.tend, v0 = st.prevend;
            bool r;
            sq_next(st);
            r = sq_is_kw(st, kw);
            st.pos = p0; st.tk = k0; st.ts = s0; st.tl = l0; st.tq = q0; st.tcode = c0; st.tend = e0; st.prevend = v0;
            return r;
        };
        // end of the column definition starting at i: index of a top level ',' or ')'
        def sq_seg_end(byte* s, int i) -> int
        {
            int depth = 0;
            byte c, q;
            while (s[i] != (byte)0)
            {
                c = s[i];
                if (c == (byte)39 | c == (byte)34 | c == (byte)96)
                {
                    q = c;
                    i++;
                    while (s[i] != (byte)0 & s[i] != q) { i++; };
                    if (s[i] != (byte)0) { i++; };
                }
                else
                {
                    if (c == (byte)40) { depth++; };
                    if (c == (byte)41)
                    {
                        if (depth == 0) { return i; };
                        depth--;
                    };
                    if (c == (byte)44 & depth == 0) { return i; };
                    i++;
                };
            };
            return i;
        };

        // Reads the next word in s[i..end). Returns the index after it; ws/wl describe it (wl 0 when none).
        def sq_word(byte* s, int i, int end, int* ws, int* wl) -> int
        {
            byte c, q;
            int j;
            while (i < end)
            {
                if (s[i] == (byte)32 | s[i] == (byte)9 | s[i] == (byte)10 | s[i] == (byte)13) { i++; } else { break; };
            };
            *ws = i;
            *wl = 0;
            if (i >= end) { return i; };
            c = s[i];
            if (c == (byte)34 | c == (byte)96 | c == (byte)91)
            {
                q = c;
                if (c == (byte)91) { q = (byte)93; };
                j = i + 1;
                while (j < end & s[j] != q) { j++; };
                *ws = i + 1;
                *wl = j - i - 1;
                if (j < end) { j++; };
                return j;
            };
            if (sq_isalpha(c) | sq_isdigit(c))
            {
                j = i;
                while (j < end)
                {
                    if (sq_isalpha(s[j]) | sq_isdigit(s[j])) { j++; } else { break; };
                };
                *wl = j - i;
                return j;
            };
            if (c == (byte)40)
            {
                // skip a parenthesised group such as (10,2)
                j = sq_seg_end(s, i + 1);
                *wl = 1;
                if (j < end) { return j + 1; };
                return j;
            };
            *wl = 1;
            return i + 1;
        };

        // true when lowercase literal lit occurs in s[0..n)
        def sq_has(byte* s, int n, byte* lit) -> bool
        {
            int i, k, m;
            m = 0;
            while (lit[m] != (byte)0) { m++; };
            for (i = 0; i + m <= n; i++)
            {
                k = 0;
                while (k < m)
                {
                    if (s[i + k] != lit[k]) { break; };
                    k++;
                };
                if (k == m) { return true; };
            };
            return false;
        };

        // ---- parser: nodes ----

        def sq_newnode(SQ_STMT* st, int kind) -> int
        {
            int n = st.nn;
            SQ_NODE* nw;
            int cap;
            if (n >= st.ncap)
            {
                cap = st.ncap * 2;
                if (cap < 256) { cap = 256; };
                nw = (SQ_NODE*)fmalloc((u64)cap * (u64)sizeof(SQ_NODE));
                if ((u64)nw == (u64)0) { sq_seterr(st, "out of memory\0"); return 0 - 1; };
                if (n > 0) { sq_mcpy((byte*)nw, (byte*)st.nodes, n * sq_nsz()); };
                if ((u64)st.nodes != (u64)0) { ffree((u64)st.nodes); };
                st.nodes = nw;
                st.ncap = cap;
            };
            st.nn = n + 1;
            st.nodes[n].kind = kind;
            st.nodes[n].op = 0;
            st.nodes[n].a = 0 - 1;
            st.nodes[n].b = 0 - 1;
            st.nodes[n].c = 0 - 1;
            st.nodes[n].next = 0 - 1;
            st.nodes[n].s = 0;
            st.nodes[n].sl = 0;
            st.nodes[n].col = 0 - 1;
            st.nodes[n].qs = 0;
            st.nodes[n].ql = 0;
            st.nodes[n].blk = 0 - 1;
            st.nodes[n].src = 0 - 1;
            st.nodes[n].lvl = 0;
            st.nodes[n].aff = 0;
            st.nodes[n].agg = 0 - 1;
            st.nodes[n].coll = 0;
            st.nodes[n].owner = st.curblk;
            st.nodes[n].hasc = 0;
            st.nodes[n].iv = (i64)0;
            st.nodes[n].rv = 0.0;
            return n;
        };

        def sq_stop_word(SQ_STMT* st) -> bool
        {
            if (st.tk != 1 | st.tq != 0) { return false; };
            return sq_is_kw(st, "from\0") | sq_is_kw(st, "where\0") | sq_is_kw(st, "order\0") | sq_is_kw(st, "limit\0") | sq_is_kw(st, "group\0") | sq_is_kw(st, "having\0") | sq_is_kw(st, "union\0") | sq_is_kw(st, "intersect\0") | sq_is_kw(st, "except\0") | sq_is_kw(st, "join\0") | sq_is_kw(st, "natural\0") | sq_is_kw(st, "left\0") | sq_is_kw(st, "right\0") | sq_is_kw(st, "full\0") | sq_is_kw(st, "inner\0") | sq_is_kw(st, "cross\0") | sq_is_kw(st, "on\0") | sq_is_kw(st, "using\0") | sq_is_kw(st, "offset\0") | sq_is_kw(st, "window\0") | sq_is_kw(st, "outer\0") | sq_is_kw(st, "set\0") | sq_is_kw(st, "values\0") | sq_is_kw(st, "returning\0");
        };

        def sq_parse_expr(SQ_STMT* st) -> int;
        def sq_parse_select(SQ_STMT* st, int parent) -> int;

        // type name to a CAST/affinity code: 0 blob, 1 text, 2 numeric, 3 integer, 4 real
        def sq_type_code(byte* p, int n) -> int
        {
            byte[48] ty;
            int i, tn;
            tn = 0;
            for (i = 0; i < n & tn < 46; i++) { ty[tn] = sq_lc(p[i]); tn++; };
            ty[tn] = (byte)0;
            if (sq_has(@ty[0], tn, "int\0")) { return 3; };
            if (sq_has(@ty[0], tn, "char\0") | sq_has(@ty[0], tn, "clob\0") | sq_has(@ty[0], tn, "text\0")) { return 1; };
            if (tn == 0 | sq_has(@ty[0], tn, "blob\0")) { return 0; };
            if (sq_has(@ty[0], tn, "real\0") | sq_has(@ty[0], tn, "floa\0") | sq_has(@ty[0], tn, "doub\0")) { return 4; };
            return 2;
        };

        def sq_coll_id(byte* p, int n) -> int
        {
            if (sq_ieq(p, n, "binary\0")) { return SQC_BINARY; };
            if (sq_ieq(p, n, "nocase\0")) { return SQC_NOCASE; };
            if (sq_ieq(p, n, "rtrim\0")) { return SQC_RTRIM; };
            return 0 - 1;
        };

        def sq_param_node(SQ_STMT* st) -> int
        {
            int n, idx, k, found;
            byte* s = @st.sql[st.ts];
            n = sq_newnode(st, SQN_PARAM);
            if (n < 0) { return n; };
            if (s[0] == (byte)63)
            {
                if (st.tl == 1) { st.pcount++; idx = st.pcount; }
                else { idx = (int)sq_atoi(@s[1], st.tl - 1); if (idx > st.pcount) { st.pcount = idx; }; };
            }
            else
            {
                found = 0;
                idx = 0;
                for (k = 1; k <= st.pcount; k++)
                {
                    if (st.pnl[k - 1] == st.tl)
                    {
                        if (sq_mem_eq(@st.sql[st.pns[k - 1]], s, st.tl)) { found = k; };
                    };
                };
                if (found > 0) { idx = found; }
                else
                {
                    st.pcount++;
                    idx = st.pcount;
                    if (idx <= 64) { st.pns[idx - 1] = st.ts; st.pnl[idx - 1] = st.tl; };
                };
            };
            if (idx < 1 | idx > 64) { sq_seterr(st, "parameter index out of range\0"); return 0 - 1; };
            if (idx > st.nparam) { st.nparam = idx; };
            st.nodes[n].iv = (i64)idx;
            sq_next(st);
            return n;
        };

        def sq_parse_case(SQ_STMT* st) -> int
        {
            int n, w, last, c, r;
            n = sq_newnode(st, SQN_CASE);
            if (n < 0) { return n; };
            sq_next(st);
            if (sq_is_kw(st, "when\0") == false)
            {
                c = sq_parse_expr(st);
                if (c < 0) { return c; };
                st.nodes[n].a = c;
            };
            last = 0 - 1;
            while (sq_is_kw(st, "when\0"))
            {
                sq_next(st);
                c = sq_parse_expr(st);
                if (c < 0) { return c; };
                if (sq_is_kw(st, "then\0") == false) { sq_seterr(st, "expected THEN\0"); return 0 - 1; };
                sq_next(st);
                r = sq_parse_expr(st);
                if (r < 0) { return r; };
                w = sq_newnode(st, SQN_WHEN);
                if (w < 0) { return w; };
                st.nodes[w].a = c;
                st.nodes[w].b = r;
                if (last < 0) { st.nodes[n].b = w; } else { st.nodes[last].next = w; };
                last = w;
            };
            if (last < 0) { sq_seterr(st, "CASE needs a WHEN\0"); return 0 - 1; };
            if (sq_is_kw(st, "else\0"))
            {
                sq_next(st);
                r = sq_parse_expr(st);
                if (r < 0) { return r; };
                st.nodes[n].c = r;
            };
            if (sq_is_kw(st, "end\0") == false) { sq_seterr(st, "expected END\0"); return 0 - 1; };
            sq_next(st);
            return n;
        };

        def sq_parse_primary(SQ_STMT* st) -> int
        {
            int n, a, last, argc, b, ts0, tl0;
            SQ_VAL v;
            if (st.tk == 2)
            {
                if (st.tl > 2 & st.sql[st.ts] == (byte)48 & (st.sql[st.ts + 1] == (byte)120 | st.sql[st.ts + 1] == (byte)88))
                {
                    if (st.tl > 18) { sq_seterr(st, "hex literal too big\0"); return 0 - 1; };
                    n = sq_newnode(st, SQN_INT);
                    if (n < 0) { return n; };
                    st.nodes[n].iv = (i64)sq_hexval(@st.sql[st.ts + 2], st.tl - 2);
                    sq_next(st);
                    return n;
                };
                sq_str2num(@st.sql[st.ts], st.tl, @v);
                if (v.t == SQ_INTEGER) { n = sq_newnode(st, SQN_INT); if (n < 0) { return n; }; st.nodes[n].iv = v.i; }
                else { n = sq_newnode(st, SQN_REAL); if (n < 0) { return n; }; st.nodes[n].rv = v.r; };
                sq_next(st);
                return n;
            };
            if (st.tk == 4)
            {
                n = sq_newnode(st, SQN_STR);
                if (n < 0) { return n; };
                st.nodes[n].s = st.ts;
                st.nodes[n].sl = st.tl;
                sq_next(st);
                return n;
            };
            if (st.tk == 6)
            {
                n = sq_newnode(st, SQN_BLOB);
                if (n < 0) { return n; };
                st.nodes[n].s = st.ts;
                st.nodes[n].sl = st.tl;
                sq_next(st);
                return n;
            };
            if (st.tk == 7) { return sq_param_node(st); };
            if (sq_is_op(st, 40))
            {
                sq_next(st);
                if (sq_is_kw(st, "select\0") | sq_is_kw(st, "with\0") | sq_is_kw(st, "values\0"))
                {
                    n = sq_newnode(st, SQN_SUBQ);
                    if (n < 0) { return n; };
                    b = sq_parse_select(st, st.curblk);
                    if (b < 0) { return 0 - 1; };
                    st.nodes[n].blk = b;
                    if (sq_is_op(st, 41) == false) { sq_seterr(st, "expected ) after subquery\0"); return 0 - 1; };
                    sq_next(st);
                    return n;
                };
                n = sq_parse_expr(st);
                if (n < 0) { return n; };
                if (sq_is_op(st, 41) == false) { sq_seterr(st, "expected )\0"); return 0 - 1; };
                sq_next(st);
                return n;
            };
            if (st.tk == 1)
            {
                if (st.tq == 0)
                {
                    if (sq_is_kw(st, "null\0")) { n = sq_newnode(st, SQN_NULL); sq_next(st); return n; };
                    if (sq_is_kw(st, "true\0")) { n = sq_newnode(st, SQN_INT); if (n < 0) { return n; }; st.nodes[n].iv = (i64)1; sq_next(st); return n; };
                    if (sq_is_kw(st, "false\0")) { n = sq_newnode(st, SQN_INT); if (n < 0) { return n; }; st.nodes[n].iv = (i64)0; sq_next(st); return n; };
                    if (sq_is_kw(st, "case\0")) { return sq_parse_case(st); };
                    if (sq_is_kw(st, "exists\0") & sq_peek_op(st, 40))
                    {
                        sq_next(st);
                        sq_next(st);
                        n = sq_newnode(st, SQN_EXISTS);
                        if (n < 0) { return n; };
                        b = sq_parse_select(st, st.curblk);
                        if (b < 0) { return 0 - 1; };
                        st.nodes[n].blk = b;
                        if (sq_is_op(st, 41) == false) { sq_seterr(st, "expected ) after EXISTS\0"); return 0 - 1; };
                        sq_next(st);
                        return n;
                    };
                    if (sq_is_kw(st, "cast\0") & sq_peek_op(st, 40))
                    {
                        sq_next(st);
                        sq_next(st);
                        n = sq_newnode(st, SQN_CAST);
                        if (n < 0) { return n; };
                        a = sq_parse_expr(st);
                        if (a < 0) { return a; };
                        st.nodes[n].a = a;
                        if (sq_is_kw(st, "as\0") == false) { sq_seterr(st, "expected AS in CAST\0"); return 0 - 1; };
                        sq_next(st);
                        ts0 = st.ts;
                        tl0 = 0;
                        while (st.tk == 1)
                        {
                            tl0 = st.tend - ts0;
                            sq_next(st);
                        };
                        if (sq_is_op(st, 40))
                        {
                            while (sq_is_op(st, 41) == false & st.tk != 0) { sq_next(st); };
                            sq_next(st);
                        };
                        st.nodes[n].iv = (i64)sq_type_code(@st.sql[ts0], tl0);
                        if (sq_is_op(st, 41) == false) { sq_seterr(st, "expected ) after CAST\0"); return 0 - 1; };
                        sq_next(st);
                        return n;
                    };
                    if (sq_is_kw(st, "current_timestamp\0") | sq_is_kw(st, "current_date\0") | sq_is_kw(st, "current_time\0"))
                    {
                        n = sq_newnode(st, SQN_FUNC);
                        if (n < 0) { return n; };
                        st.nodes[n].s = st.ts;
                        st.nodes[n].sl = st.tl;
                        sq_next(st);
                        return n;
                    };
                };
                n = sq_newnode(st, SQN_COL);
                if (n < 0) { return n; };
                st.nodes[n].s = st.ts;
                st.nodes[n].sl = st.tl;
                if (sq_peek_op(st, 40) & st.tq == 0)
                {
                    st.nodes[n].kind = SQN_FUNC;
                    sq_next(st);
                    sq_next(st);
                    last = 0 - 1;
                    argc = 0;
                    if (sq_is_kw(st, "distinct\0")) { st.nodes[n].op = 1; sq_next(st); };
                    if (sq_is_op(st, 42))
                    {
                        st.nodes[n].op = 2;
                        sq_next(st);
                    }
                    else
                    {
                        if (sq_is_op(st, 41) == false)
                        {
                            while (true)
                            {
                                a = sq_parse_expr(st);
                                if (a < 0) { return a; };
                                if (last < 0) { st.nodes[n].a = a; } else { st.nodes[last].next = a; };
                                last = a;
                                argc++;
                                if (sq_is_op(st, 44)) { sq_next(st); } else { break; };
                            };
                        };
                    };
                    if (sq_is_op(st, 41) == false) { sq_seterr(st, "expected ) after function arguments\0"); return 0 - 1; };
                    sq_next(st);
                    st.nodes[n].iv = (i64)argc;
                    return n;
                };
                sq_next(st);
                if (sq_is_op(st, 46))
                {
                    sq_next(st);
                    if (st.tk != 1) { sq_seterr(st, "expected column name after .\0"); return 0 - 1; };
                    st.nodes[n].qs = st.nodes[n].s;
                    st.nodes[n].ql = st.nodes[n].sl;
                    st.nodes[n].s = st.ts;
                    st.nodes[n].sl = st.tl;
                    sq_next(st);
                    if (sq_is_op(st, 46))
                    {
                        // schema.table.column: the first part is the schema name
                        sq_next(st);
                        if (st.tk != 1) { sq_seterr(st, "expected column name after .\0"); return 0 - 1; };
                        st.nodes[n].qs = st.nodes[n].s;
                        st.nodes[n].ql = st.nodes[n].sl;
                        st.nodes[n].s = st.ts;
                        st.nodes[n].sl = st.tl;
                        sq_next(st);
                    };
                };
                return n;
            };
            sq_seterr(st, "syntax error in expression\0");
            return 0 - 1;
        };

        def sq_parse_unary(SQ_STMT* st) -> int
        {
            int n, a;
            if (sq_is_op(st, 45))
            {
                sq_next(st);
                a = sq_parse_unary(st);
                if (a < 0) { return a; };
                if (st.nodes[a].kind == SQN_INT) { st.nodes[a].iv = (i64)0 - st.nodes[a].iv; return a; };
                if (st.nodes[a].kind == SQN_REAL) { st.nodes[a].rv = 0.0 - st.nodes[a].rv; return a; };
                n = sq_newnode(st, SQN_UNARY);
                if (n < 0) { return n; };
                st.nodes[n].op = 1;
                st.nodes[n].a = a;
                return n;
            };
            if (sq_is_op(st, 43))
            {
                sq_next(st);
                return sq_parse_unary(st);
            };
            if (sq_is_op(st, 126))
            {
                sq_next(st);
                a = sq_parse_unary(st);
                if (a < 0) { return a; };
                n = sq_newnode(st, SQN_UNARY);
                if (n < 0) { return n; };
                st.nodes[n].op = 3;
                st.nodes[n].a = a;
                return n;
            };
            a = sq_parse_primary(st);
            if (a < 0) { return a; };
            while (sq_is_kw(st, "collate\0"))
            {
                sq_next(st);
                if (st.tk != 1) { sq_seterr(st, "expected collation name\0"); return 0 - 1; };
                n = sq_newnode(st, SQN_COLLATE);
                if (n < 0) { return n; };
                st.nodes[n].iv = (i64)sq_coll_id(@st.sql[st.ts], st.tl);
                if (st.nodes[n].iv < (i64)0) { sq_seterr_n(st, "no such collation sequence\0", st.ts, st.tl); return 0 - 1; };
                st.nodes[n].a = a;
                sq_next(st);
                a = n;
            };
            return a;
        };

        def sq_mkbin(SQ_STMT* st, int op, int a, int b) -> int
        {
            int n = sq_newnode(st, SQN_BIN);
            if (n < 0) { return n; };
            st.nodes[n].op = op;
            st.nodes[n].a = a;
            st.nodes[n].b = b;
            return n;
        };

        def sq_parse_concat(SQ_STMT* st) -> int
        {
            int a, b;
            a = sq_parse_unary(st);
            if (a < 0) { return a; };
            while (sq_is_op(st, 67))
            {
                sq_next(st);
                b = sq_parse_unary(st);
                if (b < 0) { return b; };
                a = sq_mkbin(st, SQO_CAT, a, b);
                if (a < 0) { return a; };
            };
            return a;
        };

        def sq_parse_mul(SQ_STMT* st) -> int
        {
            int a, b, op;
            a = sq_parse_concat(st);
            if (a < 0) { return a; };
            while (sq_is_op(st, 42) | sq_is_op(st, 47) | sq_is_op(st, 37))
            {
                op = SQO_MUL;
                if (sq_is_op(st, 47)) { op = SQO_DIV; };
                if (sq_is_op(st, 37)) { op = SQO_MOD; };
                sq_next(st);
                b = sq_parse_concat(st);
                if (b < 0) { return b; };
                a = sq_mkbin(st, op, a, b);
                if (a < 0) { return a; };
            };
            return a;
        };

        def sq_parse_add(SQ_STMT* st) -> int
        {
            int a, b, op;
            a = sq_parse_mul(st);
            if (a < 0) { return a; };
            while (sq_is_op(st, 43) | sq_is_op(st, 45))
            {
                op = SQO_ADD;
                if (sq_is_op(st, 45)) { op = SQO_SUB; };
                sq_next(st);
                b = sq_parse_mul(st);
                if (b < 0) { return b; };
                a = sq_mkbin(st, op, a, b);
                if (a < 0) { return a; };
            };
            return a;
        };

        def sq_parse_bit(SQ_STMT* st) -> int
        {
            int a, b, op;
            a = sq_parse_add(st);
            if (a < 0) { return a; };
            while (sq_is_op(st, 38) | sq_is_op(st, 124) | sq_is_op(st, 80) | sq_is_op(st, 81))
            {
                op = SQO_BAND;
                if (sq_is_op(st, 124)) { op = SQO_BOR; };
                if (sq_is_op(st, 80)) { op = SQO_SHL; };
                if (sq_is_op(st, 81)) { op = SQO_SHR; };
                sq_next(st);
                b = sq_parse_add(st);
                if (b < 0) { return b; };
                a = sq_mkbin(st, op, a, b);
                if (a < 0) { return a; };
            };
            return a;
        };

        def sq_parse_cmp(SQ_STMT* st) -> int
        {
            int a, b, op;
            a = sq_parse_bit(st);
            if (a < 0) { return a; };
            while (sq_is_op(st, 60) | sq_is_op(st, 62) | sq_is_op(st, 76) | sq_is_op(st, 71))
            {
                op = SQO_LT;
                if (sq_is_op(st, 76)) { op = SQO_LE; };
                if (sq_is_op(st, 62)) { op = SQO_GT; };
                if (sq_is_op(st, 71)) { op = SQO_GE; };
                sq_next(st);
                b = sq_parse_bit(st);
                if (b < 0) { return b; };
                a = sq_mkbin(st, op, a, b);
                if (a < 0) { return a; };
            };
            return a;
        };

        def sq_parse_eq(SQ_STMT* st) -> int
        {
            int a, b, c, n, op, neg, last, esc, isglob;
            a = sq_parse_cmp(st);
            if (a < 0) { return a; };
            while (true)
            {
                if (sq_is_op(st, 61) | sq_is_op(st, 78))
                {
                    op = SQO_EQ;
                    if (sq_is_op(st, 78)) { op = SQO_NE; };
                    sq_next(st);
                    b = sq_parse_cmp(st);
                    if (b < 0) { return b; };
                    a = sq_mkbin(st, op, a, b);
                    if (a < 0) { return a; };
                }
                else
                {
                    neg = 1;
                    if (sq_is_kw(st, "isnull\0"))
                    {
                        sq_next(st);
                        n = sq_newnode(st, SQN_ISNULL);
                        if (n < 0) { return n; };
                        st.nodes[n].op = 1;
                        st.nodes[n].a = a;
                        a = n;
                    }
                    else
                    {
                        if (sq_is_kw(st, "notnull\0"))
                        {
                            sq_next(st);
                            n = sq_newnode(st, SQN_ISNULL);
                            if (n < 0) { return n; };
                            st.nodes[n].op = 2;
                            st.nodes[n].a = a;
                            a = n;
                        }
                        else
                        {
                            if (sq_is_kw(st, "is\0"))
                            {
                                sq_next(st);
                                op = SQO_IS;
                                if (sq_is_kw(st, "not\0")) { op = SQO_ISNOT; sq_next(st); };
                                if (sq_is_kw(st, "null\0"))
                                {
                                    sq_next(st);
                                    n = sq_newnode(st, SQN_ISNULL);
                                    if (n < 0) { return n; };
                                    st.nodes[n].op = 1;
                                    if (op == SQO_ISNOT) { st.nodes[n].op = 2; };
                                    st.nodes[n].a = a;
                                    a = n;
                                }
                                else
                                {
                                    b = sq_parse_cmp(st);
                                    if (b < 0) { return b; };
                                    a = sq_mkbin(st, op, a, b);
                                    if (a < 0) { return a; };
                                };
                            }
                            else
                            {
                                if (sq_is_kw(st, "not\0"))
                                {
                                    if (sq_peek_kw(st, "in\0") | sq_peek_kw(st, "like\0") | sq_peek_kw(st, "glob\0") | sq_peek_kw(st, "between\0") | sq_peek_kw(st, "null\0"))
                                    {
                                        neg = 2;
                                        sq_next(st);
                                    }
                                    else { break; };
                                };
                                if (sq_is_kw(st, "null\0") & neg == 2)
                                {
                                    sq_next(st);
                                    n = sq_newnode(st, SQN_ISNULL);
                                    if (n < 0) { return n; };
                                    st.nodes[n].op = 2;
                                    st.nodes[n].a = a;
                                    a = n;
                                }
                                else
                                {
                                    if (sq_is_kw(st, "in\0"))
                                    {
                                        sq_next(st);
                                        if (sq_is_op(st, 40) == false) { sq_seterr(st, "expected ( after IN\0"); return 0 - 1; };
                                        sq_next(st);
                                        n = sq_newnode(st, SQN_IN);
                                        if (n < 0) { return n; };
                                        st.nodes[n].op = neg;
                                        st.nodes[n].a = a;
                                        if (sq_is_kw(st, "select\0") | sq_is_kw(st, "with\0") | sq_is_kw(st, "values\0"))
                                        {
                                            b = sq_parse_select(st, st.curblk);
                                            if (b < 0) { return 0 - 1; };
                                            st.nodes[n].blk = b;
                                        }
                                        else
                                        {
                                            last = 0 - 1;
                                            if (sq_is_op(st, 41) == false)
                                            {
                                                while (true)
                                                {
                                                    b = sq_parse_expr(st);
                                                    if (b < 0) { return b; };
                                                    if (last < 0) { st.nodes[n].b = b; } else { st.nodes[last].next = b; };
                                                    last = b;
                                                    if (sq_is_op(st, 44)) { sq_next(st); } else { break; };
                                                };
                                            };
                                        };
                                        if (sq_is_op(st, 41) == false) { sq_seterr(st, "expected ) after IN list\0"); return 0 - 1; };
                                        sq_next(st);
                                        a = n;
                                    }
                                    else
                                    {
                                        if (sq_is_kw(st, "like\0") | sq_is_kw(st, "glob\0"))
                                        {
                                            isglob = 0;
                                            if (sq_is_kw(st, "glob\0")) { isglob = 1; };
                                            sq_next(st);
                                            b = sq_parse_cmp(st);
                                            if (b < 0) { return b; };
                                            esc = 0 - 1;
                                            if (sq_is_kw(st, "escape\0"))
                                            {
                                                sq_next(st);
                                                esc = sq_parse_cmp(st);
                                                if (esc < 0) { return esc; };
                                            };
                                            n = sq_newnode(st, SQN_LIKE);
                                            if (n < 0) { return n; };
                                            st.nodes[n].op = neg;
                                            st.nodes[n].a = a;
                                            st.nodes[n].b = b;
                                            st.nodes[n].c = esc;
                                            st.nodes[n].iv = (i64)isglob;
                                            a = n;
                                        }
                                        else
                                        {
                                            if (sq_is_kw(st, "between\0"))
                                            {
                                                sq_next(st);
                                                b = sq_parse_cmp(st);
                                                if (b < 0) { return b; };
                                                if (sq_is_kw(st, "and\0") == false) { sq_seterr(st, "expected AND in BETWEEN\0"); return 0 - 1; };
                                                sq_next(st);
                                                c = sq_parse_cmp(st);
                                                if (c < 0) { return c; };
                                                n = sq_newnode(st, SQN_BETWEEN);
                                                if (n < 0) { return n; };
                                                st.nodes[n].op = neg;
                                                st.nodes[n].a = a;
                                                st.nodes[n].b = b;
                                                st.nodes[n].c = c;
                                                a = n;
                                            }
                                            else { break; };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };
            return a;
        };

        def sq_parse_not(SQ_STMT* st) -> int
        {
            int a, n;
            if (sq_is_kw(st, "not\0"))
            {
                sq_next(st);
                a = sq_parse_not(st);
                if (a < 0) { return a; };
                n = sq_newnode(st, SQN_UNARY);
                if (n < 0) { return n; };
                st.nodes[n].op = 2;
                st.nodes[n].a = a;
                return n;
            };
            return sq_parse_eq(st);
        };

        def sq_parse_and(SQ_STMT* st) -> int
        {
            int a, b;
            a = sq_parse_not(st);
            if (a < 0) { return a; };
            while (sq_is_kw(st, "and\0"))
            {
                sq_next(st);
                b = sq_parse_not(st);
                if (b < 0) { return b; };
                a = sq_mkbin(st, SQO_AND, a, b);
                if (a < 0) { return a; };
            };
            return a;
        };

        def sq_parse_expr(SQ_STMT* st) -> int
        {
            int a, b;
            a = sq_parse_and(st);
            if (a < 0) { return a; };
            while (sq_is_kw(st, "or\0"))
            {
                sq_next(st);
                b = sq_parse_and(st);
                if (b < 0) { return b; };
                a = sq_mkbin(st, SQO_OR, a, b);
                if (a < 0) { return a; };
            };
            return a;
        };

        // ---- table definitions ----

        // token scanner for CREATE TABLE text. kind: 1 word, 2 quoted name, 3 string, 4 paren group, 5 punctuation, 6 number
        def sq_tok2(byte* s, int i, int end, int* ts, int* tl, int* kind) -> int
        {
            byte c, q;
            int j, d;
            while (i < end)
            {
                if (s[i] == (byte)32 | s[i] == (byte)9 | s[i] == (byte)10 | s[i] == (byte)13) { i++; } else { break; };
            };
            *ts = i;
            *tl = 0;
            *kind = 0;
            if (i >= end) { return i; };
            c = s[i];
            if (c == (byte)34 | c == (byte)96 | c == (byte)91 | c == (byte)39)
            {
                q = c;
                if (c == (byte)91) { q = (byte)93; };
                j = i + 1;
                while (j < end & s[j] != q) { j++; };
                if (j < end) { j++; };
                *tl = j - i;
                *kind = 2;
                if (c == (byte)39) { *kind = 3; };
                return j;
            };
            if (c == (byte)40)
            {
                d = 0;
                j = i;
                while (j < end)
                {
                    if (s[j] == (byte)39 | s[j] == (byte)34 | s[j] == (byte)96)
                    {
                        q = s[j];
                        j++;
                        while (j < end & s[j] != q) { j++; };
                        if (j < end) { j++; };
                    }
                    else
                    {
                        if (s[j] == (byte)40) { d++; };
                        if (s[j] == (byte)41) { d--; };
                        j++;
                        if (d == 0) { break; };
                    };
                };
                *tl = j - i;
                *kind = 4;
                return j;
            };
            if (sq_isalpha(c))
            {
                j = i;
                while (j < end)
                {
                    if (sq_isalpha(s[j]) | sq_isdigit(s[j])) { j++; } else { break; };
                };
                *tl = j - i;
                *kind = 1;
                return j;
            };
            if (sq_isdigit(c) | (c == (byte)46 & sq_isdigit(s[i + 1])))
            {
                j = i;
                while (j < end)
                {
                    if (sq_isdigit(s[j]) | s[j] == (byte)46) { j++; } else { break; };
                };
                if (j < end)
                {
                    if (s[j] == (byte)101 | s[j] == (byte)69)
                    {
                        j++;
                        if (j < end) { if (s[j] == (byte)43 | s[j] == (byte)45) { j++; }; };
                        while (j < end & sq_isdigit(s[j])) { j++; };
                    };
                };
                *tl = j - i;
                *kind = 6;
                return j;
            };
            *tl = 1;
            *kind = 5;
            return i + 1;
        };

        // name token compare (quoted names compare their inside text)
        def sq_tname_eq(byte* a, int as_, int al, byte* b, int bs, int bl) -> bool
        {
            int i;
            if (al != bl) { return false; };
            for (i = 0; i < al; i++)
            {
                if (sq_lc(a[as_ + i]) != sq_lc(b[bs + i])) { return false; };
            };
            return true;
        };

        def sq_is_cons_word(byte* p, int n) -> bool
        {
            return sq_ieq(p, n, "primary\0") | sq_ieq(p, n, "not\0") | sq_ieq(p, n, "null\0") | sq_ieq(p, n, "unique\0") | sq_ieq(p, n, "check\0") | sq_ieq(p, n, "default\0") | sq_ieq(p, n, "collate\0") | sq_ieq(p, n, "references\0") | sq_ieq(p, n, "generated\0") | sq_ieq(p, n, "constraint\0") | sq_ieq(p, n, "as\0");
        };

        // index of the column named p[s..s+l) or -1
        def sq_ti_find(SQ_TI* ti, byte* p, int s, int l) -> int
        {
            int k;
            for (k = 0; k < ti.ncols; k++)
            {
                if (sq_tname_eq(ti.base, ti.cs[k], ti.cl[k], p, s, l)) { return k; };
            };
            return 0 - 1;
        };

        // Reads the column list "(a, b DESC, c)" of a table constraint into column indexes. Returns the count.
        def sq_ti_collist(SQ_TI* ti, int gs, int gl, int* out, int maxn) -> int
        {
            byte* s = ti.base;
            int i, end, ts, tl, kind, n, c;
            i = gs + 1;
            end = gs + gl - 1;
            n = 0;
            while (i < end)
            {
                i = sq_tok2(s, i, end, @ts, @tl, @kind);
                if (kind == 0) { break; };
                if (kind == 1 | kind == 2)
                {
                    if (kind == 2) { c = sq_ti_find(ti, s, ts + 1, tl - 2); } else { c = sq_ti_find(ti, s, ts, tl); };
                    if (c >= 0 & n < maxn) { out[n] = c; n++; };
                    // skip the rest of this item
                    while (i < end)
                    {
                        if (s[i] == (byte)44) { break; };
                        i++;
                    };
                };
            };
            return n;
        };

        def sq_aff_of_type(byte* s, int a, int b) -> int
        {
            return sq_type_code(@s[a], b - a);
        };

        // appends an implicit index over the given columns unless an identical one exists
        def sq_ti_add_ix(SQ_TI* ti, int* cols, int n, bool ispk) -> void
        {
            int i, j, off, same;
            if (n < 1 | ti.nix >= 8) { return; };
            off = 0;
            for (i = 0; i < ti.nix; i++)
            {
                if (ti.ixn[i] == n)
                {
                    same = 1;
                    for (j = 0; j < n; j++) { if (ti.ixc[off + j] != cols[j]) { same = 0; }; };
                    if (same == 1)
                    {
                        if (ispk) { ti.ixpk[i] = 1; };
                        return;
                    };
                };
                off = off + ti.ixn[i];
            };
            if (off + n > 64) { return; };
            for (j = 0; j < n; j++) { ti.ixc[off + j] = cols[j]; };
            ti.ixn[ti.nix] = n;
            ti.ixpk[ti.nix] = 0;
            if (ispk) { ti.ixpk[ti.nix] = 1; };
            ti.nix++;
        };

        // Fills ti from the CREATE TABLE text (zero terminated, owned by the caller for the life of ti).
        def sq_ti_load(SQ_TI* ti, byte* s) -> int
        {
            int i, segend, ws, wl, kind, j, k, tstart, tend, cons, colhit, c, d0, d1, n2, g;
            int ts, tl, kd, isint, pkseen, ncols0, ev1, ev2, pkdesc, nn2;
            byte[48] ty;
            int tn;
            ti.base = s;
            ti.ncols = 0; ti.ipk = 0 - 1; ti.autoinc = 0; ti.nchk = 0; ti.npk = 0; ti.nuq = 0; ti.rowid_alias = 0 - 1; ti.nix = 0;
            i = 0;
            while (s[i] != (byte)0 & s[i] != (byte)40) { i++; };
            if (s[i] == (byte)0) { return 1; };
            i++;
            while (s[i] != (byte)0)
            {
                segend = sq_seg_end(s, i);
                j = sq_tok2(s, i, segend, @ws, @wl, @kind);
                if (kind == 0) { break; };
                cons = 0;
                if (kind == 1)
                {
                    if (sq_ieq(@s[ws], wl, "primary\0") | sq_ieq(@s[ws], wl, "unique\0") | sq_ieq(@s[ws], wl, "check\0") | sq_ieq(@s[ws], wl, "foreign\0") | sq_ieq(@s[ws], wl, "constraint\0")) { cons = 1; };
                };
                if (cons == 0 & ti.ncols < 128)
                {
                    k = ti.ncols;
                    if (kind == 2) { ti.cs[k] = ws + 1; ti.cl[k] = wl - 2; } else { ti.cs[k] = ws; ti.cl[k] = wl; };
                    ti.aff[k] = 0; ti.coll[k] = 0; ti.notnull[k] = 0; ti.pk[k] = 0; ti.uniq[k] = 0; ti.hid[k] = 0;
                    ti.dfs[k] = 0; ti.dfl[k] = 0; ti.chs[k] = 0; ti.chl[k] = 0; ti.ity[k] = 0;
                    // type words
                    tn = 0;
                    while (true)
                    {
                        d0 = j;
                        d1 = sq_tok2(s, j, segend, @ts, @tl, @kd);
                        if (kd == 0) { break; };
                        if (kd == 1)
                        {
                            if (sq_is_cons_word(@s[ts], tl)) { break; };
                            for (g = 0; g < tl; g++) { if (tn < 46) { ty[tn] = sq_lc(s[ts + g]); tn++; }; };
                        };
                        if (kd == 4) { j = d1; continue; };
                        if (kd != 1) { break; };
                        j = d1;
                    };
                    ty[tn] = (byte)0;
                    ti.aff[k] = sq_type_code(@ty[0], tn);
                    isint = 0;
                    if (sq_ieq(@ty[0], tn, "integer\0")) { isint = 1; ti.ity[k] = 1; };
                    // constraints
                    pkseen = 0;
                    ev1 = 0; ev2 = 0; pkdesc = 0;
                    while (true)
                    {
                        j = sq_tok2(s, j, segend, @ts, @tl, @kd);
                        if (kd == 0) { break; };
                        if (kd != 1) { continue; };
                        if (sq_ieq(@s[ts], tl, "primary\0"))
                        {
                            j = sq_tok2(s, j, segend, @ts, @tl, @kd);
                            ti.pk[k] = 1;
                            pkseen = 1;
                            if (ev1 == 0) { ev1 = 1; } else { ev2 = 1; };
                        };
                        if (sq_ieq(@s[ts], tl, "desc\0")) { if (pkseen == 1) { pkdesc = 1; }; };
                        if (sq_ieq(@s[ts], tl, "autoincrement\0")) { ti.autoinc = 1; };
                        if (sq_ieq(@s[ts], tl, "unique\0"))
                        {
                            ti.uniq[k] = 1;
                            if (ev1 == 0) { ev1 = 2; } else { ev2 = 2; };
                        };
                        if (sq_ieq(@s[ts], tl, "not\0"))
                        {
                            j = sq_tok2(s, j, segend, @ts, @tl, @kd);
                            if (kd == 1) { if (sq_ieq(@s[ts], tl, "null\0")) { ti.notnull[k] = 1; }; };
                        };
                        if (sq_ieq(@s[ts], tl, "collate\0"))
                        {
                            j = sq_tok2(s, j, segend, @ts, @tl, @kd);
                            if (kd == 1) { c = sq_coll_id(@s[ts], tl); if (c > 0) { ti.coll[k] = c; }; };
                        };
                        if (sq_ieq(@s[ts], tl, "check\0"))
                        {
                            j = sq_tok2(s, j, segend, @ts, @tl, @kd);
                            if (kd == 4) { ti.chs[k] = ts + 1; ti.chl[k] = tl - 2; };
                        };
                        if (sq_ieq(@s[ts], tl, "default\0"))
                        {
                            tstart = j;
                            j = sq_tok2(s, j, segend, @ts, @tl, @kd);
                            if (kd == 5)
                            {
                                // sign followed by a number
                                d0 = ts;
                                j = sq_tok2(s, j, segend, @ts, @tl, @kd);
                                ti.dfs[k] = d0;
                                ti.dfl[k] = ts + tl - d0;
                            }
                            else
                            {
                                ti.dfs[k] = ts;
                                ti.dfl[k] = tl;
                                if (kd == 4) { ti.dfs[k] = ts + 1; ti.dfl[k] = tl - 2; };
                            };
                        };
                        if (sq_ieq(@s[ts], tl, "references\0"))
                        {
                            // skip the referenced table and optional column list
                            j = sq_tok2(s, j, segend, @ts, @tl, @kd);
                            d0 = sq_tok2(s, j, segend, @ts, @tl, @kd);
                            if (kd == 4) { j = d0; };
                        };
                        if (sq_ieq(@s[ts], tl, "generated\0") | sq_ieq(@s[ts], tl, "as\0"))
                        {
                            return 2;
                        };
                    };
                    if (pkseen == 1 & isint == 1 & ti.ipk < 0 & ti.npk == 0 & pkdesc == 0)
                    {
                        // an INTEGER PRIMARY KEY (not DESC) aliases the rowid
                        ti.ipk = k;
                    };
                    // implicit indexes in the order SQLite creates them
                    for (g = 0; g < 2; g++)
                    {
                        c = ev1;
                        if (g == 1) { c = ev2; };
                        if (c == 0) { continue; };
                        if (c == 1 & ti.ipk == k) { continue; };
                        sq_ti_add_ix(ti, @k, 1, c == 1);
                    };
                    if (pkseen == 1)
                    {
                        if (ti.npk < 16) { ti.pkc[ti.npk] = k; ti.npk++; };
                    };
                    ti.ncols = k + 1;
                }
                else
                {
                    if (cons == 1)
                    {
                        // table constraint
                        if (sq_ieq(@s[ws], wl, "constraint\0"))
                        {
                            j = sq_tok2(s, j, segend, @ws, @wl, @kind);
                            j = sq_tok2(s, j, segend, @ws, @wl, @kind);
                        };
                        if (sq_ieq(@s[ws], wl, "primary\0"))
                        {
                            j = sq_tok2(s, j, segend, @ts, @tl, @kd);
                            j = sq_tok2(s, j, segend, @ts, @tl, @kd);
                            if (kd == 4)
                            {
                                n2 = sq_ti_collist(ti, ts, tl, @ti.pkc[0], 16);
                                // a single INTEGER column keeps the rowid alias; otherwise the key needs an index
                                nn2 = 0;
                                if (n2 == 1)
                                {
                                    c = ti.pkc[0];
                                    ti.pk[c] = 1;
                                    if (ti.ity[c] == 1)
                                    {
                                        if (ti.ipk < 0) { ti.ipk = c; nn2 = 1; };
                                    };
                                }
                                else
                                {
                                    for (g = 0; g < n2; g++) { ti.pk[ti.pkc[g]] = 1; };
                                };
                                ti.npk = n2;
                                if (nn2 == 0) { sq_ti_add_ix(ti, @ti.pkc[0], n2, true); };
                            };
                        };
                        if (sq_ieq(@s[ws], wl, "unique\0"))
                        {
                            j = sq_tok2(s, j, segend, @ts, @tl, @kd);
                            if (kd == 4 & ti.nuq < 8)
                            {
                                g = 0;
                                for (c = 0; c < ti.nuq; c++) { g = g + ti.uqn[c]; };
                                n2 = sq_ti_collist(ti, ts, tl, @ti.uqc[g], 16);
                                ti.uqn[ti.nuq] = n2;
                                ti.nuq++;
                                sq_ti_add_ix(ti, @ti.uqc[g], n2, false);
                            };
                        };
                        if (sq_ieq(@s[ws], wl, "check\0"))
                        {
                            j = sq_tok2(s, j, segend, @ts, @tl, @kd);
                            if (kd == 4 & ti.nchk < 16)
                            {
                                ti.ks[ti.nchk] = ts + 1;
                                ti.kl[ti.nchk] = tl - 2;
                                ti.nchk++;
                            };
                        };
                    };
                };
                i = segend;
                if (s[i] == (byte)44) { i++; } else { break; };
            };
            return 0;
        };

        // ---- parser: SELECT ----

        def sq_newblk(SQ_STMT* st, int parent) -> int
        {
            SQ_BLK* b;
            int n = st.nblk;
            int i;
            if (n >= 64) { sq_seterr(st, "query is too complex\0"); return 0 - 1; };
            b = (SQ_BLK*)fmalloc((u64)sizeof(SQ_BLK));
            if ((u64)b == (u64)0) { sq_seterr(st, "out of memory\0"); return 0 - 1; };
            b.src = (SQ_SRC*)fmalloc((u64)(8 * sizeof(SQ_SRC)));
            if ((u64)b.src == (u64)0) { ffree((u64)b); sq_seterr(st, "out of memory\0"); return 0 - 1; };
            st.blks[n] = b;
            st.nblk = n + 1;
            b.nsrc = 0; b.nres = 0; b.distinct = 0; b.where_n = 0 - 1; b.ngrp = 0; b.having = 0 - 1; b.nord = 0;
            b.limit_n = 0 - 1; b.offset_n = 0 - 1; b.cop = 0; b.cnext = 0 - 1; b.parent = parent; b.nagg = 0;
            b.has_agg = 0; b.ncte = 0; b.bidx = n; b.star_cnt = 0; b.is_corr = 0; b.bdone = 0;
            for (i = 0; i < 8; i++) { b.cur[i] = 0 - 1; };
            sq_ar_init(@b.scr);
            sq_ar_init(@b.gar);
            b.aggv = (SQ_VAL*)0;
            b.out = (SQ_RS*)0;
            b.groups = (SQ_GRP*)0;
            b.ngroups = 0; b.gcap = 0;
            b.hbuck = (int*)0; b.hsize = 0;
            b.hrun = (int*)0;
            b.rjmax = 0;
            return n;
        };

        def sq_lex_save(SQ_STMT* st, int* sv) -> void
        {
            sv[0] = st.pos; sv[1] = st.tk; sv[2] = st.ts; sv[3] = st.tl; sv[4] = st.tq; sv[5] = st.tcode; sv[6] = st.tend; sv[7] = st.prevend;
        };

        def sq_lex_restore(SQ_STMT* st, int* sv) -> void
        {
            st.pos = sv[0]; st.tk = sv[1]; st.ts = sv[2]; st.tl = sv[3]; st.tq = sv[4]; st.tcode = sv[5]; st.tend = sv[6]; st.prevend = sv[7];
        };

        def sq_cstrlen(byte* p) -> int
        {
            int n = 0;
            while (p[n] != (byte)0) { n++; };
            return n;
        };

        // schema object lookup by name, kind 1 table, 3 view. Returns the schema index or -1.
        def sq_find_obj(SQLITE_DB* db, byte* p, int s, int l, int kind) -> int
        {
            int i;
            for (i = 0; i < db.nschema; i++)
            {
                if (db.schema[i].kind != kind) { continue; };
                if (sq_tname_eq(@db.schema[i].name[0], 0, sq_cstrlen(@db.schema[i].name[0]), p, s, l)) { return i; };
            };
            return 0 - 1;
        };

        def sq_ti_alloc(SQ_STMT* st) -> SQ_TI*
        {
            SQ_TI* t = (SQ_TI*)fmalloc((u64)sizeof(SQ_TI));
            if ((u64)t == (u64)0) { sq_seterr(st, "out of memory\0"); };
            return t;
        };

        // heap copy of a schema SQL text
        def sq_sql_copy(byte* p) -> byte*
        {
            int n = sq_cstrlen(p);
            byte* r = (byte*)fmalloc((u64)(n + 1));
            int i;
            if ((u64)r == (u64)0) { return r; };
            for (i = 0; i < n; i++) { r[i] = p[i]; };
            r[n] = (byte)0;
            return r;
        };

        def sq_parse_ident_pos(SQ_STMT* st) -> bool
        {
            return st.tk == 1;
        };

        // Parses "CREATE VIEW name [(cols)] AS select" stored in the schema into a block.
        def sq_expand_view(SQ_STMT* st, int sidx, int parent) -> int
        {
            byte* vs;
            int n, base, b, i, sv0, lim0, ci;
            int[8] sv;
            int[32] cs, cl;
            vs = st.db.schema[sidx].sql;
            if ((u64)vs == (u64)0) { sq_seterr(st, "view has no definition\0"); return 0 - 1; };
            n = sq_cstrlen(vs);
            base = st.sqllen + 1;
            if (base + n + 2 >= 262144) { sq_seterr(st, "statement too large\0"); return 0 - 1; };
            for (i = 0; i < n; i++) { st.sql[base + i] = vs[i]; };
            st.sql[base + n] = (byte)0;
            sq_lex_save(st, @sv[0]);
            lim0 = st.lim;
            st.lim = base + n;
            st.sqllen = base + n;
            st.pos = base;
            st.tend = base;
            sq_next(st);
            ci = 0;
            // CREATE [TEMP] VIEW [IF NOT EXISTS] name [(cols)] AS
            while (st.tk != 0 & sq_is_kw(st, "as\0") == false)
            {
                if (sq_is_op(st, 40))
                {
                    sq_next(st);
                    while (st.tk != 0 & sq_is_op(st, 41) == false)
                    {
                        if (st.tk == 1 & ci < 32) { cs[ci] = st.ts; cl[ci] = st.tl; ci++; };
                        sq_next(st);
                    };
                };
                sq_next(st);
            };
            if (st.tk == 0) { sq_seterr(st, "malformed view definition\0"); return 0 - 1; };
            sq_next(st);
            b = sq_parse_select(st, parent);
            if (b >= 0)
            {
                for (i = 0; i < ci; i++)
                {
                    if (i < st.blks[b].nres) { st.blks[b].rns[i] = cs[i]; st.blks[b].rnl[i] = cl[i]; };
                };
            };
            st.lim = lim0;
            sq_lex_restore(st, @sv[0]);
            return b;
        };

        def sq_add_src(SQ_STMT* st, SQ_BLK* b) -> SQ_SRC*
        {
            SQ_SRC* sr;
            int k;
            if (b.nsrc >= 8) { sq_seterr(st, "too many tables in a join\0"); return (SQ_SRC*)0; };
            sr = @b.src[b.nsrc];
            b.nsrc++;
            sr.kind = 0; sr.jt = 0; sr.natural = 0; sr.nusing = 0; sr.on = 0 - 1; sr.tbl = 0 - 1; sr.root = 0;
            sr.blk = 0 - 1; sr.ts = 0; sr.tl = 0; sr.as_s = 0; sr.as_l = 0; sr.ncols = 0;
            sr.ti = (SQ_TI*)0; sr.rs = (SQ_RS*)0; sr.rs_shared = 0; sr.cte = 0 - 1;
            sr.plan = 0; sr.pcol = 0 - 1; sr.pexpr = 0 - 1; sr.pexpr2 = 0 - 1; sr.pop = 0; sr.pop2 = 0;
            return sr;
        };

        // one FROM item: table, view, CTE or parenthesised subquery
        def sq_parse_source(SQ_STMT* st, int bi) -> int
        {
            SQ_BLK* b = st.blks[bi];
            SQ_SRC* sr;
            int k, sidx, sb, n, found;
            byte* tsql;
            if (sq_is_op(st, 40))
            {
                sq_next(st);
                if ((sq_is_kw(st, "select\0") | sq_is_kw(st, "with\0") | sq_is_kw(st, "values\0")) == false)
                {
                    sq_seterr(st, "only subqueries may be parenthesised in FROM\0");
                    return 1;
                };
                sb = sq_parse_select(st, bi);
                if (sb < 0) { return 1; };
                if (sq_is_op(st, 41) == false) { sq_seterr(st, "expected ) after subquery\0"); return 1; };
                sq_next(st);
                sr = sq_add_src(st, b);
                if ((u64)sr == (u64)0) { return 1; };
                sr.kind = 2;
                sr.blk = sb;
            }
            else
            {
                if (st.tk != 1) { sq_seterr(st, "expected table name\0"); return 1; };
                sr = sq_add_src(st, b);
                if ((u64)sr == (u64)0) { return 1; };
                sr.ts = st.ts;
                sr.tl = st.tl;
                sq_next(st);
                if (sq_is_op(st, 46))
                {
                    // schema.table: only main is understood
                    sq_next(st);
                    if (st.tk != 1) { sq_seterr(st, "expected table name\0"); return 1; };
                    sr.ts = st.ts;
                    sr.tl = st.tl;
                    sq_next(st);
                };
                found = 0;
                for (k = st.ncte - 1; k >= 0; k--)
                {
                    if (sq_tname_eq(@st.sql[0], st.ctes[k].ns, st.ctes[k].nl, @st.sql[0], sr.ts, sr.tl))
                    {
                        sr.kind = 2;
                        sr.cte = k;
                        sr.blk = st.ctes[k].blk;
                        found = 1;
                        break;
                    };
                };
                if (found == 0)
                {
                    sidx = sq_find_obj(st.db, @st.sql[0], sr.ts, sr.tl, 1);
                    if (sidx >= 0)
                    {
                        sr.kind = 1;
                        sr.tbl = sidx;
                        sr.root = st.db.schema[sidx].rootpage;
                        found = 1;
                    }
                    else
                    {
                        sidx = sq_find_obj(st.db, @st.sql[0], sr.ts, sr.tl, 3);
                        if (sidx >= 0)
                        {
                            sb = sq_expand_view(st, sidx, bi);
                            if (sb < 0) { return 1; };
                            sr.kind = 2;
                            sr.blk = sb;
                            found = 1;
                        };
                    };
                };
                if (found == 0)
                {
                    if (sq_ieq(@st.sql[sr.ts], sr.tl, "sqlite_master\0") | sq_ieq(@st.sql[sr.ts], sr.tl, "sqlite_schema\0"))
                    {
                        sr.kind = 1;
                        sr.tbl = 0 - 1;
                        sr.root = 1;
                        found = 1;
                    };
                };
                if (found == 0) { sq_seterr_n(st, "no such table\0", sr.ts, sr.tl); return 1; };
            };
            // alias
            if (sq_is_kw(st, "as\0"))
            {
                sq_next(st);
                if (st.tk != 1) { sq_seterr(st, "expected alias after AS\0"); return 1; };
                sr.as_s = st.ts; sr.as_l = st.tl;
                sq_next(st);
            }
            else
            {
                if (st.tk == 1 & sq_stop_word(st) == false)
                {
                    sr.as_s = st.ts; sr.as_l = st.tl;
                    sq_next(st);
                };
            };
            if (sr.kind == 2 & sr.as_l == 0 & sr.cte < 0)
            {
                sr.as_s = 0; sr.as_l = 0;
            };
            return 0;
        };

        def sq_parse_from(SQ_STMT* st, int bi) -> int
        {
            SQ_BLK* b = st.blks[bi];
            SQ_SRC* sr;
            int jt, nat, e, last, ui;
            if (sq_parse_source(st, bi) != 0) { return 1; };
            while (true)
            {
                jt = 0;
                nat = 0;
                if (sq_is_op(st, 44)) { jt = 3; sq_next(st); }
                else
                {
                    if (sq_is_kw(st, "natural\0")) { nat = 1; sq_next(st); };
                    jt = 1;
                    if (sq_is_kw(st, "left\0")) { jt = 2; sq_next(st); if (sq_is_kw(st, "outer\0")) { sq_next(st); }; }
                    else
                    {
                        if (sq_is_kw(st, "inner\0")) { sq_next(st); }
                        else
                        {
                            if (sq_is_kw(st, "cross\0")) { jt = 3; sq_next(st); }
                            else
                            {
                                if (sq_is_kw(st, "right\0")) { jt = 4; sq_next(st); if (sq_is_kw(st, "outer\0")) { sq_next(st); }; }
                                else
                                {
                                    if (sq_is_kw(st, "full\0")) { jt = 5; sq_next(st); if (sq_is_kw(st, "outer\0")) { sq_next(st); }; };
                                };
                            };
                        };
                    };
                    if (sq_is_kw(st, "join\0") == false)
                    {
                        if (nat == 1 | jt != 1) { sq_seterr(st, "expected JOIN\0"); return 1; };
                        break;
                    };
                    sq_next(st);
                };
                if (sq_parse_source(st, bi) != 0) { return 1; };
                sr = @b.src[b.nsrc - 1];
                sr.jt = jt;
                sr.natural = nat;
                if (sq_is_kw(st, "on\0"))
                {
                    sq_next(st);
                    st.curblk = bi;
                    e = sq_parse_expr(st);
                    if (e < 0) { return 1; };
                    sr.on = e;
                }
                else
                {
                    if (sq_is_kw(st, "using\0"))
                    {
                        sq_next(st);
                        if (sq_is_op(st, 40) == false) { sq_seterr(st, "expected ( after USING\0"); return 1; };
                        sq_next(st);
                        ui = 0;
                        while (st.tk == 1 & ui < 16)
                        {
                            sr.us[ui] = st.ts;
                            sr.ul[ui] = st.tl;
                            ui++;
                            sq_next(st);
                            if (sq_is_op(st, 44)) { sq_next(st); } else { break; };
                        };
                        sr.nusing = ui;
                        if (sq_is_op(st, 41) == false) { sq_seterr(st, "expected ) after USING\0"); return 1; };
                        sq_next(st);
                    };
                };
            };
            return 0;
        };

        // one SELECT arm (after the SELECT keyword) or a VALUES row set head
        def sq_parse_core(SQ_STMT* st, int bi) -> int
        {
            SQ_BLK* b = st.blks[bi];
            int tstart, nodeIdx, last, e, sv0;
            int[8] sv;
            st.curblk = bi;
            if (sq_is_kw(st, "distinct\0")) { b.distinct = 1; sq_next(st); }
            else { if (sq_is_kw(st, "all\0")) { sq_next(st); }; };
            while (true)
            {
                if (b.nres >= 128) { sq_seterr(st, "too many result columns\0"); return 1; };
                tstart = st.ts;
                if (st.tk == 4) { tstart = st.ts - 1; };
                if (st.tk == 6) { tstart = st.ts - 2; };
                nodeIdx = 0 - 1;
                if (sq_is_op(st, 42))
                {
                    nodeIdx = sq_newnode(st, SQN_STAR);
                    if (nodeIdx < 0) { return 1; };
                    sq_next(st);
                }
                else
                {
                    if (st.tk == 1)
                    {
                        sq_lex_save(st, @sv[0]);
                        sq_next(st);
                        if (sq_is_op(st, 46))
                        {
                            sq_next(st);
                            if (sq_is_op(st, 42))
                            {
                                nodeIdx = sq_newnode(st, SQN_STAR);
                                if (nodeIdx < 0) { return 1; };
                                st.nodes[nodeIdx].qs = st.nodes[nodeIdx].s;
                                sq_lex_restore(st, @sv[0]);
                                st.nodes[nodeIdx].qs = st.ts;
                                st.nodes[nodeIdx].ql = st.tl;
                                sq_next(st);
                                sq_next(st);
                                sq_next(st);
                            };
                        };
                        if (nodeIdx < 0) { sq_lex_restore(st, @sv[0]); };
                    };
                    if (nodeIdx < 0)
                    {
                        nodeIdx = sq_parse_expr(st);
                        if (nodeIdx < 0) { return 1; };
                    };
                };
                b.rc[b.nres] = nodeIdx;
                b.rns[b.nres] = tstart;
                b.rnl[b.nres] = st.prevend - tstart;
                if (st.nodes[nodeIdx].kind == SQN_COL) { b.rnl[b.nres] = 0 - 1; };
                if (sq_is_kw(st, "as\0"))
                {
                    sq_next(st);
                    if (st.tk != 1 & st.tk != 4) { sq_seterr(st, "expected alias after AS\0"); return 1; };
                    b.rns[b.nres] = st.ts;
                    b.rnl[b.nres] = st.tl;
                    sq_next(st);
                }
                else
                {
                    if ((st.tk == 1 & sq_stop_word(st) == false) | st.tk == 4)
                    {
                        b.rns[b.nres] = st.ts;
                        b.rnl[b.nres] = st.tl;
                        sq_next(st);
                    };
                };
                b.nres++;
                if (sq_is_op(st, 44)) { sq_next(st); } else { break; };
            };
            if (sq_is_kw(st, "from\0"))
            {
                sq_next(st);
                if (sq_parse_from(st, bi) != 0) { return 1; };
            };
            st.curblk = bi;
            if (sq_is_kw(st, "where\0"))
            {
                sq_next(st);
                e = sq_parse_expr(st);
                if (e < 0) { return 1; };
                b.where_n = e;
            };
            if (sq_is_kw(st, "group\0"))
            {
                sq_next(st);
                if (sq_is_kw(st, "by\0") == false) { sq_seterr(st, "expected BY after GROUP\0"); return 1; };
                sq_next(st);
                while (true)
                {
                    if (b.ngrp >= 16) { sq_seterr(st, "too many GROUP BY terms\0"); return 1; };
                    e = sq_parse_expr(st);
                    if (e < 0) { return 1; };
                    b.grp[b.ngrp] = e;
                    b.ngrp++;
                    if (sq_is_op(st, 44)) { sq_next(st); } else { break; };
                };
            };
            if (sq_is_kw(st, "having\0"))
            {
                sq_next(st);
                e = sq_parse_expr(st);
                if (e < 0) { return 1; };
                b.having = e;
            };
            return 0;
        };

        // VALUES (..), (..): one arm per row
        def sq_parse_values(SQ_STMT* st, int head, int parent) -> int
        {
            SQ_BLK* b;
            int bi, prev, e, tstart;
            bi = head;
            prev = 0 - 1;
            while (true)
            {
                if (bi < 0)
                {
                    bi = sq_newblk(st, parent);
                    if (bi < 0) { return 1; };
                };
                b = st.blks[bi];
                st.curblk = bi;
                if (sq_is_op(st, 40) == false) { sq_seterr(st, "expected ( in VALUES\0"); return 1; };
                sq_next(st);
                while (true)
                {
                    if (b.nres >= 128) { sq_seterr(st, "too many columns\0"); return 1; };
                    tstart = st.ts;
                    e = sq_parse_expr(st);
                    if (e < 0) { return 1; };
                    b.rc[b.nres] = e;
                    b.rns[b.nres] = tstart;
                    b.rnl[b.nres] = st.prevend - tstart;
                    b.nres++;
                    if (sq_is_op(st, 44)) { sq_next(st); } else { break; };
                };
                if (sq_is_op(st, 41) == false) { sq_seterr(st, "expected ) in VALUES\0"); return 1; };
                sq_next(st);
                if (prev >= 0) { st.blks[prev].cnext = bi; b.cop = 2; };
                prev = bi;
                if (sq_is_op(st, 44)) { sq_next(st); bi = 0 - 1; } else { break; };
            };
            return 0;
        };

        def sq_parse_cte_list(SQ_STMT* st, int parent) -> int
        {
            SQ_CTE* c;
            int sb, ci, i;
            if (sq_is_kw(st, "recursive\0")) { sq_seterr(st, "recursive CTEs are not supported\0"); return 1; };
            while (true)
            {
                if (st.ncte >= 16) { sq_seterr(st, "too many CTEs\0"); return 1; };
                if (st.tk != 1) { sq_seterr(st, "expected CTE name\0"); return 1; };
                c = @st.ctes[st.ncte];
                c.ns = st.ts; c.nl = st.tl; c.ncn = 0; c.rs = (SQ_RS*)0;
                sq_next(st);
                if (sq_is_op(st, 40))
                {
                    sq_next(st);
                    while (st.tk == 1)
                    {
                        if (c.ncn < 32) { c.cns[c.ncn] = st.ts; c.cnl[c.ncn] = st.tl; c.ncn++; };
                        sq_next(st);
                        if (sq_is_op(st, 44)) { sq_next(st); } else { break; };
                    };
                    if (sq_is_op(st, 41) == false) { sq_seterr(st, "expected ) after CTE columns\0"); return 1; };
                    sq_next(st);
                };
                if (sq_is_kw(st, "as\0") == false) { sq_seterr(st, "expected AS in WITH\0"); return 1; };
                sq_next(st);
                if (sq_is_kw(st, "not\0")) { sq_next(st); };
                if (sq_is_kw(st, "materialized\0")) { sq_next(st); };
                if (sq_is_op(st, 40) == false) { sq_seterr(st, "expected ( after AS\0"); return 1; };
                sq_next(st);
                sb = sq_parse_select(st, 0 - 1);
                if (sb < 0) { return 1; };
                c = @st.ctes[st.ncte];
                c.blk = sb;
                for (i = 0; i < c.ncn; i++)
                {
                    if (i < st.blks[sb].nres) { st.blks[sb].rns[i] = c.cns[i]; st.blks[sb].rnl[i] = c.cnl[i]; };
                };
                st.ncte++;
                if (sq_is_op(st, 41) == false) { sq_seterr(st, "expected ) after CTE\0"); return 1; };
                sq_next(st);
                if (sq_is_op(st, 44)) { sq_next(st); } else { break; };
            };
            return 0;
        };

        // Parses a full query expression (with WITH, compounds, ORDER BY, LIMIT). Returns the head block or -1.
        def sq_parse_select(SQ_STMT* st, int parent) -> int
        {
            int head, bi, prev, cop, e, curb0;
            SQ_BLK* h;
            curb0 = st.curblk;
            if (sq_is_kw(st, "with\0"))
            {
                sq_next(st);
                if (sq_parse_cte_list(st, parent) != 0) { return 0 - 1; };
            };
            head = sq_newblk(st, parent);
            if (head < 0) { return head; };
            prev = head;
            bi = head;
            while (true)
            {
                if (sq_is_kw(st, "values\0"))
                {
                    sq_next(st);
                    if (sq_parse_values(st, bi, parent) != 0) { return 0 - 1; };
                    // find the last arm created
                    prev = bi;
                    while (st.blks[prev].cnext >= 0) { prev = st.blks[prev].cnext; };
                }
                else
                {
                    if (sq_is_kw(st, "select\0") == false) { sq_seterr(st, "expected SELECT\0"); return 0 - 1; };
                    sq_next(st);
                    if (sq_parse_core(st, bi) != 0) { return 0 - 1; };
                    prev = bi;
                };
                cop = 0;
                if (sq_is_kw(st, "union\0"))
                {
                    sq_next(st);
                    cop = 1;
                    if (sq_is_kw(st, "all\0")) { sq_next(st); cop = 2; };
                }
                else
                {
                    if (sq_is_kw(st, "intersect\0")) { sq_next(st); cop = 3; }
                    else { if (sq_is_kw(st, "except\0")) { sq_next(st); cop = 4; }; };
                };
                if (cop == 0) { break; };
                bi = sq_newblk(st, parent);
                if (bi < 0) { return 0 - 1; };
                st.blks[bi].cop = cop;
                st.blks[prev].cnext = bi;
            };
            h = st.blks[head];
            st.curblk = head;
            if (sq_is_kw(st, "order\0"))
            {
                sq_next(st);
                if (sq_is_kw(st, "by\0") == false) { sq_seterr(st, "expected BY after ORDER\0"); return 0 - 1; };
                sq_next(st);
                while (true)
                {
                    if (h.nord >= 16) { sq_seterr(st, "too many ORDER BY terms\0"); return 0 - 1; };
                    e = sq_parse_expr(st);
                    if (e < 0) { return 0 - 1; };
                    h.ord[h.nord] = e;
                    h.odesc[h.nord] = 0;
                    h.onull[h.nord] = 0;
                    h.ocoll[h.nord] = 0 - 1;
                    if (sq_is_kw(st, "asc\0")) { sq_next(st); }
                    else { if (sq_is_kw(st, "desc\0")) { h.odesc[h.nord] = 1; sq_next(st); }; };
                    if (sq_is_kw(st, "nulls\0"))
                    {
                        sq_next(st);
                        if (sq_is_kw(st, "first\0")) { h.onull[h.nord] = 1; sq_next(st); }
                        else { if (sq_is_kw(st, "last\0")) { h.onull[h.nord] = 2; sq_next(st); }; };
                    };
                    h.nord++;
                    if (sq_is_op(st, 44)) { sq_next(st); } else { break; };
                };
            };
            if (sq_is_kw(st, "limit\0"))
            {
                sq_next(st);
                e = sq_parse_expr(st);
                if (e < 0) { return 0 - 1; };
                h.limit_n = e;
                if (sq_is_kw(st, "offset\0"))
                {
                    sq_next(st);
                    e = sq_parse_expr(st);
                    if (e < 0) { return 0 - 1; };
                    h.offset_n = e;
                }
                else
                {
                    if (sq_is_op(st, 44))
                    {
                        // LIMIT offset, count
                        sq_next(st);
                        e = sq_parse_expr(st);
                        if (e < 0) { return 0 - 1; };
                        h.offset_n = h.limit_n;
                        h.limit_n = e;
                    };
                };
            };
            st.curblk = curb0;
            return head;
        };

        // ---- binder ----

        // function ids (scalar 1..99, aggregates 100..)
        def sq_func_id(byte* p, int n, int argc) -> int
        {
            if (sq_ieq(p, n, "count\0")) { return 100; };
            if (sq_ieq(p, n, "sum\0")) { return 101; };
            if (sq_ieq(p, n, "total\0")) { return 102; };
            if (sq_ieq(p, n, "avg\0")) { return 103; };
            if (sq_ieq(p, n, "min\0")) { if (argc == 1) { return 104; }; return 11; };
            if (sq_ieq(p, n, "max\0")) { if (argc == 1) { return 105; }; return 12; };
            if (sq_ieq(p, n, "group_concat\0")) { return 106; };
            if (sq_ieq(p, n, "coalesce\0")) { return 1; };
            if (sq_ieq(p, n, "ifnull\0")) { return 2; };
            if (sq_ieq(p, n, "typeof\0")) { return 3; };
            if (sq_ieq(p, n, "abs\0")) { return 4; };
            if (sq_ieq(p, n, "length\0")) { return 5; };
            if (sq_ieq(p, n, "upper\0")) { return 6; };
            if (sq_ieq(p, n, "lower\0")) { return 7; };
            if (sq_ieq(p, n, "substr\0") | sq_ieq(p, n, "substring\0")) { return 8; };
            if (sq_ieq(p, n, "nullif\0")) { return 9; };
            if (sq_ieq(p, n, "round\0")) { return 10; };
            if (sq_ieq(p, n, "hex\0")) { return 13; };
            if (sq_ieq(p, n, "replace\0")) { return 14; };
            if (sq_ieq(p, n, "trim\0")) { return 15; };
            if (sq_ieq(p, n, "ltrim\0")) { return 16; };
            if (sq_ieq(p, n, "rtrim\0")) { return 17; };
            if (sq_ieq(p, n, "instr\0")) { return 18; };
            if (sq_ieq(p, n, "printf\0") | sq_ieq(p, n, "format\0")) { return 19; };
            if (sq_ieq(p, n, "quote\0")) { return 20; };
            if (sq_ieq(p, n, "char\0")) { return 21; };
            if (sq_ieq(p, n, "unicode\0")) { return 22; };
            if (sq_ieq(p, n, "random\0")) { return 23; };
            if (sq_ieq(p, n, "randomblob\0")) { return 24; };
            if (sq_ieq(p, n, "zeroblob\0")) { return 25; };
            if (sq_ieq(p, n, "sign\0")) { return 26; };
            if (sq_ieq(p, n, "iif\0")) { return 27; };
            if (sq_ieq(p, n, "like\0")) { return 28; };
            if (sq_ieq(p, n, "glob\0")) { return 29; };
            if (sq_ieq(p, n, "date\0")) { return 31; };
            if (sq_ieq(p, n, "time\0")) { return 32; };
            if (sq_ieq(p, n, "datetime\0")) { return 33; };
            if (sq_ieq(p, n, "julianday\0")) { return 34; };
            if (sq_ieq(p, n, "strftime\0")) { return 35; };
            if (sq_ieq(p, n, "unixepoch\0")) { return 36; };
            if (sq_ieq(p, n, "current_timestamp\0")) { return 37; };
            if (sq_ieq(p, n, "current_date\0")) { return 38; };
            if (sq_ieq(p, n, "current_time\0")) { return 39; };
            if (sq_ieq(p, n, "last_insert_rowid\0")) { return 40; };
            if (sq_ieq(p, n, "changes\0")) { return 41; };
            if (sq_ieq(p, n, "total_changes\0")) { return 42; };
            if (sq_ieq(p, n, "sqlite_version\0")) { return 43; };
            if (sq_ieq(p, n, "ceil\0") | sq_ieq(p, n, "ceiling\0")) { return 44; };
            if (sq_ieq(p, n, "floor\0")) { return 45; };
            if (sq_ieq(p, n, "sqrt\0")) { return 46; };
            if (sq_ieq(p, n, "pow\0") | sq_ieq(p, n, "power\0")) { return 47; };
            if (sq_ieq(p, n, "mod\0")) { return 48; };
            if (sq_ieq(p, n, "exp\0")) { return 49; };
            if (sq_ieq(p, n, "ln\0")) { return 50; };
            if (sq_ieq(p, n, "log\0") | sq_ieq(p, n, "log10\0")) { return 51; };
            if (sq_ieq(p, n, "log2\0")) { return 52; };
            if (sq_ieq(p, n, "pi\0")) { return 53; };
            if (sq_ieq(p, n, "sin\0")) { return 54; };
            if (sq_ieq(p, n, "cos\0")) { return 55; };
            if (sq_ieq(p, n, "tan\0")) { return 56; };
            if (sq_ieq(p, n, "atan\0")) { return 57; };
            if (sq_ieq(p, n, "atan2\0")) { return 58; };
            if (sq_ieq(p, n, "max_len\0")) { return 0 - 1; };
            if (sq_ieq(p, n, "likely\0") | sq_ieq(p, n, "unlikely\0") | sq_ieq(p, n, "likelihood\0")) { return 59; };
            if (sq_ieq(p, n, "ltrim\0")) { return 16; };
            if (sq_ieq(p, n, "lastrowid\0")) { return 0 - 1; };
            return 0 - 1;
        };

        // name of result column i of block b: returns the text base and sets s, l
        def sq_res_name(SQ_STMT* st, SQ_BLK* b, int i, int* s, int* l) -> byte*
        {
            SQ_NODE* nd;
            SQ_SRC* sr;
            if (b.rnl[i] >= 0)
            {
                *s = b.rns[i];
                *l = b.rnl[i];
                return @st.sql[0];
            };
            nd = @st.nodes[b.rc[i]];
            if (nd.src >= 0 & nd.kind == SQN_COL & nd.lvl == 0)
            {
                sr = @b.src[nd.src];
                if ((u64)sr.ti != (u64)0 & nd.col == sr.ti.ncols & sr.ti.ipk >= 0)
                {
                    *s = sr.ti.cs[sr.ti.ipk];
                    *l = sr.ti.cl[sr.ti.ipk];
                    return sr.ti.base;
                };
                if ((u64)sr.ti != (u64)0 & nd.col < sr.ti.ncols)
                {
                    *s = sr.ti.cs[nd.col];
                    *l = sr.ti.cl[nd.col];
                    return sr.ti.base;
                };
                *s = nd.s;
                *l = nd.sl;
                return @st.sql[0];
            };
            *s = nd.s;
            *l = nd.sl;
            return @st.sql[0];
        };

        // "ambiguous column name: <name>" for a name that lives in a table text
        def sq_seterr_amb(SQ_STMT* st, byte* base, int s, int l) -> void
        {
            int i = 0;
            int k;
            byte* msg = "ambiguous column name: \0";
            if (st.err[0] != (byte)0) { return; };
            while (msg[i] != (byte)0) { st.err[i] = msg[i]; i++; };
            for (k = 0; k < l & i < 150; k++) { st.err[i] = base[s + k]; i++; };
            st.err[i] = (byte)0;
        };

        // "ambiguous reference to <name> in USING()"
        def sq_seterr_ref(SQ_STMT* st, byte* base, int s, int l) -> void
        {
            int i = 0;
            int k;
            byte* msg = "ambiguous reference to \0";
            if (st.err[0] != (byte)0) { return; };
            while (msg[i] != (byte)0) { st.err[i] = msg[i]; i++; };
            for (k = 0; k < l & i < 120; k++) { st.err[i] = base[s + k]; i++; };
            msg = " in USING()\0";
            k = 0;
            while (msg[k] != (byte)0) { st.err[i] = msg[k]; i++; k++; };
            st.err[i] = (byte)0;
        };

        def sq_bind_block_a(SQ_STMT* st, int bi) -> int;
        def sq_set_alts(SQ_STMT* st, SQ_BLK* b, int ni) -> void;

        // builds column info for a derived source from its block
        def sq_derive_ti(SQ_STMT* st, SQ_SRC* sr) -> int
        {
            SQ_BLK* sb = st.blks[sr.blk];
            SQ_TI* t;
            int i, s, l;
            byte* base;
            if (sq_bind_block_a(st, sr.blk) != 0) { return 1; };
            t = sq_ti_alloc(st);
            if ((u64)t == (u64)0) { return 1; };
            t.base = @st.sql[0];
            t.ncols = sb.nres;
            t.ipk = 0 - 1; t.autoinc = 0; t.nchk = 0; t.npk = 0; t.nuq = 0;
            for (i = 0; i < sb.nres; i++)
            {
                base = sq_res_name(st, sb, i, @s, @l);
                if ((u64)base != (u64)t.base)
                {
                    // names that live in another table text are copied into the statement buffer
                    if (st.sqllen + l + 2 >= 262144) { sq_seterr(st, "statement too large\0"); return 1; };
                    sq_mcpy(@st.sql[st.sqllen + 1], @base[s], l);
                    s = st.sqllen + 1;
                    st.sqllen = st.sqllen + l + 1;
                    st.lim = st.sqllen;
                };
                t.cs[i] = s; t.cl[i] = l; t.aff[i] = 0; t.coll[i] = 0; t.notnull[i] = 0; t.pk[i] = 0; t.uniq[i] = 0; t.hid[i] = 0;
                t.dfs[i] = 0; t.dfl[i] = 0; t.chs[i] = 0; t.chl[i] = 0; t.ity[i] = 0;
            };
            sr.ti = t;
            sr.ncols = sb.nres;
            return 0;
        };

        global byte* SQ_MASTER_SQL = "CREATE TABLE sqlite_master(type text,name text,tbl_name text,rootpage integer,sql text)\0";

        def sq_src_find_col(SQ_STMT* st, SQ_SRC* sr, byte* p, int s, int l, int allow_hid) -> int
        {
            int k;
            SQ_TI* ti = sr.ti;
            if ((u64)ti == (u64)0) { return 0 - 1; };
            for (k = 0; k < ti.ncols; k++)
            {
                if (ti.hid[k] == 1 & allow_hid == 0) { continue; };
                if (sq_tname_eq(ti.base, ti.cs[k], ti.cl[k], p, s, l)) { return k; };
            };
            return 0 - 1;
        };

        def sq_is_rowid_name(byte* p, int l) -> bool
        {
            return sq_ieq(p, l, "rowid\0") | sq_ieq(p, l, "_rowid_\0") | sq_ieq(p, l, "oid\0");
        };

        def sq_bind_block_a(SQ_STMT* st, int bi) -> int
        {
            SQ_BLK* b = st.blks[bi];
            SQ_SRC* sr;
            SQ_SRC* o;
            SQ_NODE* nd;
            int j, k, i, m, s, l, q, ncol, nn0, ni, found, jt, c, qs0, ql0, anyrf;
            byte* tsql;
            byte* base;
            if (b.bdone != 0) { return 0; };
            b.bdone = 1;
            for (j = 0; j < b.nsrc; j++)
            {
                sr = @b.src[j];
                if (sr.kind == 2)
                {
                    if (sq_derive_ti(st, sr) != 0) { return 1; };
                    if (sr.cte >= 0) { sr.rs_shared = 1; };
                }
                else
                {
                    sr.ti = sq_ti_alloc(st);
                    if ((u64)sr.ti == (u64)0) { return 1; };
                    if (sr.tbl >= 0)
                    {
                        tsql = sq_sql_copy(st.db.schema[sr.tbl].sql);
                        if ((u64)tsql == (u64)0) { sq_seterr(st, "out of memory\0"); return 1; };
                    }
                    else { tsql = sq_sql_copy(SQ_MASTER_SQL); };
                    if (sq_ti_load(sr.ti, tsql) != 0) { sq_seterr(st, "cannot read table definition\0"); return 1; };
                    sr.ncols = sr.ti.ncols;
                };
            };
            // USING and NATURAL joins
            anyrf = 0;
            for (j = 1; j < b.nsrc; j++) { if (b.src[j].jt >= 4) { anyrf = 1; }; };
            for (j = 1; j < b.nsrc; j++)
            {
                sr = @b.src[j];
                if (sr.natural == 1)
                {
                    sr.nusing = 0;
                    for (k = 0; k < sr.ti.ncols; k++)
                    {
                        found = 0;
                        for (i = 0; i < j; i++)
                        {
                            o = @b.src[i];
                            c = sq_src_find_col(st, o, sr.ti.base, sr.ti.cs[k], sr.ti.cl[k], 0);
                            if (c >= 0)
                            {
                                found++;
                                if (found == 2 & anyrf == 1) { sq_seterr_ref(st, sr.ti.base, sr.ti.cs[k], sr.ti.cl[k]); return 1; };
                                if (found == 1 & sr.nusing < 16)
                                {
                                    sr.uls[sr.nusing] = i; sr.ulc[sr.nusing] = c; sr.urc[sr.nusing] = k;
                                    sr.nusing++;
                                };
                            };
                        };
                    };
                    for (k = 0; k < sr.nusing; k++) { sr.ti.hid[sr.urc[k]] = 1; };
                }
                else
                {
                    if (sr.nusing > 0)
                    {
                        for (k = 0; k < sr.nusing; k++)
                        {
                            found = 0;
                            for (i = 0; i < j; i++)
                            {
                                o = @b.src[i];
                                c = sq_src_find_col(st, o, @st.sql[0], sr.us[k], sr.ul[k], 0);
                                if (c >= 0)
                                {
                                    if (found == 1 & anyrf == 1) { sq_seterr_ref(st, @st.sql[0], sr.us[k], sr.ul[k]); return 1; };
                                    if (found == 0) { sr.uls[k] = i; sr.ulc[k] = c; };
                                    found = 1;
                                };
                            };
                            c = sq_src_find_col(st, sr, @st.sql[0], sr.us[k], sr.ul[k], 0);
                            if (found == 0 | c < 0) { sq_seterr_n(st, "cannot join using column\0", sr.us[k], sr.ul[k]); return 1; };
                            sr.urc[k] = c;
                            sr.ti.hid[c] = 1;
                        };
                    };
                };
            };
            // expand * and t.*
            i = 0;
            while (i < b.nres)
            {
                nd = @st.nodes[b.rc[i]];
                if (nd.kind != SQN_STAR) { i++; continue; };
                qs0 = nd.qs;
                ql0 = nd.ql;
                ncol = 0;
                for (j = 0; j < b.nsrc; j++)
                {
                    sr = @b.src[j];
                    if (ql0 > 0)
                    {
                        if (sr.as_l > 0)
                        {
                            if (sq_tname_eq(@st.sql[0], sr.as_s, sr.as_l, @st.sql[0], qs0, ql0) == false) { continue; };
                        }
                        else
                        {
                            if (sq_tname_eq(@st.sql[0], sr.ts, sr.tl, @st.sql[0], qs0, ql0) == false) { continue; };
                        };
                    };
                    for (k = 0; k < sr.ti.ncols; k++)
                    {
                        if (sr.ti.hid[k] == 1 & ql0 == 0) { continue; };
                        ncol++;
                    };
                };
                if (ncol == 0) { sq_seterr(st, "no tables specified or no matching columns for *\0"); return 1; };
                if (b.nres - 1 + ncol > 128) { sq_seterr(st, "too many result columns\0"); return 1; };
                // shift the tail
                for (m = b.nres - 1; m > i; m--)
                {
                    b.rc[m + ncol - 1] = b.rc[m];
                    b.rns[m + ncol - 1] = b.rns[m];
                    b.rnl[m + ncol - 1] = b.rnl[m];
                };
                b.nres = b.nres - 1 + ncol;
                q = i;
                for (j = 0; j < b.nsrc; j++)
                {
                    sr = @b.src[j];
                    if (ql0 > 0)
                    {
                        if (sr.as_l > 0)
                        {
                            if (sq_tname_eq(@st.sql[0], sr.as_s, sr.as_l, @st.sql[0], qs0, ql0) == false) { continue; };
                        }
                        else
                        {
                            if (sq_tname_eq(@st.sql[0], sr.ts, sr.tl, @st.sql[0], qs0, ql0) == false) { continue; };
                        };
                    };
                    for (k = 0; k < sr.ti.ncols; k++)
                    {
                        if (sr.ti.hid[k] == 1 & ql0 == 0) { continue; };
                        ni = sq_newnode(st, SQN_COL);
                        if (ni < 0) { return 1; };
                        st.nodes[ni].owner = bi;
                        st.nodes[ni].src = j;
                        st.nodes[ni].col = k;
                        st.nodes[ni].lvl = 0;
                        st.nodes[ni].aff = sr.ti.aff[k];
                        st.nodes[ni].coll = sr.ti.coll[k];
                        sq_set_alts(st, b, ni);
                        if (st.nodes[ni].iv != (i64)0)
                        {
                            // a merged USING column clashes with a visible column of the same name elsewhere
                            for (m = 0; m < b.nsrc; m++)
                            {
                                if (m == j) { continue; };
                                if (sq_src_find_col(st, @b.src[m], sr.ti.base, sr.ti.cs[k], sr.ti.cl[k], 0) >= 0)
                                {
                                    sq_seterr_amb(st, sr.ti.base, sr.ti.cs[k], sr.ti.cl[k]);
                                    return 1;
                                };
                            };
                        };
                        b.rc[q] = ni;
                        b.rnl[q] = 0 - 1;
                        q++;
                    };
                };
                i = i + ncol;
            };
            if (b.cnext >= 0) { if (sq_bind_block_a(st, b.cnext) != 0) { return 1; }; };
            return 0;
        };

        // matches a qualifier against a source
        def sq_src_is(SQ_STMT* st, SQ_SRC* sr, int qs, int ql) -> bool
        {
            if (sr.as_l > 0) { return sq_tname_eq(@st.sql[0], sr.as_s, sr.as_l, @st.sql[0], qs, ql); };
            return sq_tname_eq(@st.sql[0], sr.ts, sr.tl, @st.sql[0], qs, ql);
        };

        // a column that is one side of a USING / NATURAL join with a RIGHT or FULL joined source reads the other side when it is NULL
        def sq_set_alts(SQ_STMT* st, SQ_BLK* b, int ni) -> void
        {
            SQ_NODE* nd = @st.nodes[ni];
            SQ_SRC* sr;
            int k, u, n, a, anyrf;
            i64 pk;
            pk = (i64)0;
            n = 0;
            anyrf = 0;
            for (k = 1; k < b.nsrc; k++) { if (b.src[k].jt >= 4) { anyrf = 1; }; };
            if (anyrf == 0) { nd.iv = pk; return; };
            for (k = nd.src + 1; k < b.nsrc; k++)
            {
                sr = @b.src[k];
                for (u = 0; u < sr.nusing; u++)
                {
                    if (sr.uls[u] == nd.src & sr.ulc[u] == nd.col & n < 2)
                    {
                        a = k * 256 + sr.urc[u] + 1;
                        pk = pk | ((i64)a << (i64)(16 * n));
                        n++;
                    };
                };
            };
            nd.iv = pk;
        };

        def sq_bind_col(SQ_STMT* st, int ni) -> int
        {
            SQ_NODE* nd = @st.nodes[ni];
            SQ_BLK* b;
            SQ_SRC* sr;
            int bi, lvl, j, c, hits, hj, hc, hh, k, ai, saved, prev, skipb;
            byte* nm = @st.sql[nd.s];
            bi = nd.owner;
            lvl = 0;
            prev = 0 - 1;
            while (bi >= 0)
            {
                b = st.blks[bi];
                hits = 0; hj = 0 - 1; hc = 0 - 1;
                // a subquery in a FROM clause cannot see the other items of that clause
                skipb = 0;
                if (prev >= 0)
                {
                    for (j = 0; j < b.nsrc; j++)
                    {
                        if (b.src[j].kind == 2 & b.src[j].blk == prev) { skipb = 1; };
                    };
                };
                for (j = 0; j < b.nsrc; j++)
                {
                    if (skipb == 1) { break; };
                    sr = @b.src[j];
                    if (nd.ql > 0)
                    {
                        if (sq_src_is(st, sr, nd.qs, nd.ql) == false) { continue; };
                    };
                    c = sq_src_find_col(st, sr, @st.sql[0], nd.s, nd.sl, 0);
                    if (c < 0 & nd.ql > 0) { c = sq_src_find_col(st, sr, @st.sql[0], nd.s, nd.sl, 1); };
                    if (c < 0)
                    {
                        if (sq_is_rowid_name(nm, nd.sl) & sr.kind == 1) { c = sr.ti.ncols; };
                    };
                    if (c >= 0)
                    {
                        hits++;
                        if (hj < 0) { hj = j; hc = c; };
                    };
                };
                if (hits > 1)
                {
                    sq_seterr_n(st, "ambiguous column name\0", nd.s, nd.sl);
                    return 1;
                };
                if (hits == 1)
                {
                    nd.src = hj;
                    nd.col = hc;
                    nd.lvl = lvl;
                    if (nd.ql == 0) { sq_set_alts(st, b, ni); };
                    sr = @b.src[hj];
                    if (hc < sr.ti.ncols) { nd.aff = sr.ti.aff[hc]; nd.coll = sr.ti.coll[hc]; }
                    else { nd.aff = 3; nd.coll = 0; };
                    if (lvl > 0)
                    {
                        // every block between the use and the definition depends on an outer row
                        k = nd.owner;
                        while (k >= 0 & k != bi)
                        {
                            st.blks[k].is_corr = 1;
                            k = st.blks[k].parent;
                        };
                    };
                    return 0;
                };
                if (nd.ql == 0 & lvl == 0)
                {
                    // a result column alias
                    b = st.blks[nd.owner];
                    for (ai = 0; ai < b.nres; ai++)
                    {
                        if (b.rnl[ai] > 0)
                        {
                            if (sq_tname_eq(@st.sql[0], b.rns[ai], b.rnl[ai], @st.sql[0], nd.s, nd.sl) & st.nodes[b.rc[ai]].kind != SQN_COL)
                            {
                                saved = nd.next;
                                sq_mcpy((byte*)nd, (byte*)@st.nodes[b.rc[ai]], sq_nsz());
                                nd.next = saved;
                                return 0;
                            };
                        };
                    };
                };
                prev = bi;
                bi = st.blks[bi].parent;
                lvl++;
            };
            if (nd.ql > 0)
            {
                if (nd.qs + nd.ql + 1 == nd.s) { sq_seterr_n(st, "no such column\0", nd.qs, nd.ql + 1 + nd.sl); return 1; };
            };
            sq_seterr_n(st, "no such column\0", nd.s, nd.sl);
            return 1;
        };

        // argument count check for scalar functions
        def sq_arity_ok(int id, int argc) -> bool
        {
            if (id == 1) { return argc >= 2; };
            if (id == 2 | id == 9 | id == 28 | id == 29 | id == 47 | id == 48 | id == 58 | id == 18) { return argc == 2; };
            if (id == 3 | id == 4 | id == 5 | id == 6 | id == 7 | id == 13 | id == 20 | id == 22 | id == 24 | id == 25 | id == 26) { return argc == 1; };
            if (id == 44 | id == 45 | id == 46 | id == 49 | id == 50 | id == 51 | id == 52 | id == 54 | id == 55 | id == 56 | id == 57 | id == 59) { return argc >= 1 & argc <= 2; };
            if (id == 8) { return argc == 2 | argc == 3; };
            if (id == 10) { return argc == 1 | argc == 2; };
            if (id == 11 | id == 12) { return argc >= 2; };
            if (id == 14 | id == 27) { return argc == 3; };
            if (id == 15 | id == 16 | id == 17) { return argc == 1 | argc == 2; };
            if (id == 19) { return argc >= 1; };
            if (id == 21) { return true; };
            if (id == 23 | id == 40 | id == 41 | id == 42 | id == 43 | id == 53 | id == 37 | id == 38 | id == 39) { return argc == 0; };
            if (id >= 31 & id <= 36) { return true; };
            return true;
        };

        def sq_agg_arity_ok(int id, int argc, int star) -> bool
        {
            if (id == 100) { return star == 1 | argc == 1; };
            if (id == 106) { return argc == 1 | argc == 2; };
            return argc == 1;
        };

        // ordinal and result-column terms of ORDER BY / GROUP BY
        def sq_fix_terms(SQ_STMT* st, int bi) -> int
        {
            SQ_BLK* b = st.blks[bi];
            SQ_NODE* nd;
            int i, k, saved, n, found, s, l;
            byte* base;
            if (b.star_cnt == 1) { return 0; };
            b.star_cnt = 1;
            for (i = 0; i < b.nord; i++)
            {
                nd = @st.nodes[b.ord[i]];
                if (nd.kind == SQN_COLLATE)
                {
                    b.ocoll[i] = (int)nd.iv;
                    b.ord[i] = nd.a;
                    nd = @st.nodes[b.ord[i]];
                };
                if (b.cnext >= 0)
                {
                    // compound: the term must name a result column
                    found = 0 - 1;
                    if (nd.kind == SQN_INT)
                    {
                        if (nd.iv >= (i64)1 & nd.iv <= (i64)b.nres) { found = (int)nd.iv - 1; };
                    };
                    if (nd.kind == SQN_COL & nd.ql == 0)
                    {
                        for (k = 0; k < b.nres; k++)
                        {
                            base = sq_res_name(st, b, k, @s, @l);
                            if (sq_tname_eq(base, s, l, @st.sql[0], nd.s, nd.sl)) { found = k; break; };
                        };
                    };
                    if (found < 0) { sq_seterr(st, "ORDER BY term does not match any column in the result set\0"); return 1; };
                    nd.kind = SQN_RESREF;
                    nd.iv = (i64)found;
                }
                else
                {
                    if (nd.kind == SQN_COL & nd.ql == 0)
                    {
                        // an ORDER BY name matches a result alias before any table column
                        for (k = 0; k < b.nres; k++)
                        {
                            if (b.rnl[k] > 0)
                            {
                                if (sq_tname_eq(@st.sql[0], b.rns[k], b.rnl[k], @st.sql[0], nd.s, nd.sl))
                                {
                                    saved = nd.next;
                                    sq_mcpy((byte*)nd, (byte*)@st.nodes[b.rc[k]], sq_nsz());
                                    nd.next = saved;
                                    break;
                                };
                            };
                        };
                    };
                    if (nd.kind == SQN_INT)
                    {
                        if (nd.iv < (i64)1 | nd.iv > (i64)b.nres) { sq_seterr(st, "ORDER BY term out of range\0"); return 1; };
                        k = (int)nd.iv - 1;
                        saved = nd.next;
                        sq_mcpy((byte*)nd, (byte*)@st.nodes[b.rc[k]], sq_nsz());
                        nd.next = saved;
                    };
                };
            };
            for (i = 0; i < b.ngrp; i++)
            {
                nd = @st.nodes[b.grp[i]];
                if (nd.kind == SQN_INT)
                {
                    if (nd.iv < (i64)1 | nd.iv > (i64)b.nres) { sq_seterr(st, "GROUP BY term out of range\0"); return 1; };
                    k = (int)nd.iv - 1;
                    saved = nd.next;
                    sq_mcpy((byte*)nd, (byte*)@st.nodes[b.rc[k]], sq_nsz());
                    nd.next = saved;
                };
            };
            return 0;
        };

        // Binds every block and every node of the statement. Safe to call again after more nodes were added.
        def sq_bind_all(SQ_STMT* st) -> int
        {
            int bi, ni, id, argc, ob, star, ai;
            SQ_NODE* nd;
            SQ_BLK* b;
            for (bi = 0; bi < st.nblk; bi++)
            {
                if (sq_bind_block_a(st, bi) != 0) { return 1; };
            };
            for (bi = 0; bi < st.nblk; bi++)
            {
                if (st.blks[bi].nord > 0 | st.blks[bi].ngrp > 0)
                {
                    if (st.blks[bi].nres > 0 | st.blks[bi].cnext >= 0)
                    {
                        if (sq_fix_terms(st, bi) != 0) { return 1; };
                    };
                };
            };
            for (ni = st.bn; ni < st.nn; ni++)
            {
                nd = @st.nodes[ni];
                if (nd.kind == SQN_COL & nd.src < 0)
                {
                    if (sq_bind_col(st, ni) != 0) { return 1; };
                };
                nd = @st.nodes[ni];
                if (nd.kind == SQN_FUNC)
                {
                    argc = (int)nd.iv;
                    id = sq_func_id(@st.sql[nd.s], nd.sl, argc);
                    if (id < 0) { sq_seterr_n(st, "no such function\0", nd.s, nd.sl); return 1; };
                    nd.col = id;
                    if (id >= 100)
                    {
                        star = 0;
                        if (nd.op == 2) { star = 1; };
                        if (sq_agg_arity_ok(id, argc, star) == false) { sq_seterr_n(st, "wrong number of arguments to function\0", nd.s, nd.sl); return 1; };
                        b = st.blks[nd.owner];
                        if (b.nagg >= 32) { sq_seterr(st, "too many aggregates\0"); return 1; };
                        b.aggn[b.nagg] = ni;
                        nd.agg = b.nagg;
                        b.nagg++;
                        b.has_agg = 1;
                    }
                    else
                    {
                        if (sq_arity_ok(id, argc) == false) { sq_seterr_n(st, "wrong number of arguments to function\0", nd.s, nd.sl); return 1; };
                    };
                };
            };
            st.bn = st.nn;
            return 0;
        };

        // ---- evaluation ----

        def sq_eval(SQ_STMT* st, SQ_BLK* b, int ni, SQ_VAL* out) -> void;
        def sq_run_block(SQ_STMT* st, int bi, int maxrows) -> SQ_RS*;
        def sq_rs_free(SQ_RS* rs) -> void;
        def sq_rs_done(SQ_STMT* st, int bi, SQ_RS* rs) -> void;

        def sq_scr(SQ_BLK* b, int n) -> byte*
        {
            return sq_ar_alloc(@b.scr, n);
        };

        def sq_val_tri(SQ_VAL* o, int t) -> void
        {
            if (t < 0) { sq_val_null(o); } else { sq_val_int(o, (i64)t); };
        };

        def sq_val_bool(SQ_VAL* o, bool t) -> void
        {
            if (t) { sq_val_int(o, (i64)1); } else { sq_val_int(o, (i64)0); };
        };

        // affinity of an expression for comparisons
        def sq_eaff(SQ_STMT* st, int ni) -> int
        {
            SQ_NODE* nd = @st.nodes[ni];
            if (nd.kind == SQN_COL) { return nd.aff; };
            if (nd.kind == SQN_CAST) { return (int)nd.iv; };
            if (nd.kind == SQN_COLLATE) { return sq_eaff(st, nd.a); };
            return 0;
        };

        def sq_ecoll(SQ_STMT* st, int ni) -> int
        {
            SQ_NODE* nd = @st.nodes[ni];
            if (nd.kind == SQN_COLLATE) { return (int)nd.iv; };
            if (nd.kind == SQN_COL) { return nd.coll; };
            return 0;
        };

        // true when the node tree contains an explicit COLLATE or a column (for collation lookup)
        def sq_cmp_coll(SQ_STMT* st, int a, int b) -> int
        {
            int c = sq_ecoll(st, a);
            if (c != 0) { return c; };
            return sq_ecoll(st, b);
        };

        // applies the comparison affinity rules to the two values
        def sq_cmp_aff(SQ_STMT* st, SQ_BLK* blk, int na, int nb, SQ_VAL* x, SQ_VAL* y) -> void
        {
            int ea = sq_eaff(st, na);
            int eb = sq_eaff(st, nb);
            if (ea >= 2 & eb < 2) { if (y.t == SQ_TEXT) { sq_apply_aff(@blk.scr, 2, y); }; return; };
            if (eb >= 2 & ea < 2) { if (x.t == SQ_TEXT) { sq_apply_aff(@blk.scr, 2, x); }; return; };
            if (ea == 1 & eb == 0) { sq_apply_aff(@blk.scr, 1, y); return; };
            if (eb == 1 & ea == 0) { sq_apply_aff(@blk.scr, 1, x); return; };
        };

        // text view of a value for LIKE, || and string functions
        def sq_as_text(SQ_BLK* b, SQ_VAL* v, SQ_VAL* o) -> void
        {
            sq_val_text(@b.scr, v, o);
        };

        def sq_unquote(SQ_BLK* b, byte* p, int n, SQ_VAL* out) -> void
        {
            int i, k, dbl;
            byte* r;
            dbl = 0;
            for (i = 0; i + 1 < n; i++) { if (p[i] == (byte)39 & p[i + 1] == (byte)39) { dbl = 1; break; }; };
            out.t = SQ_TEXT; out.i = (i64)0; out.r = 0.0;
            if (dbl == 0) { out.p = p; out.n = n; return; };
            r = sq_scr(b, n + 1);
            if ((u64)r == (u64)0) { sq_val_null(out); return; };
            k = 0;
            i = 0;
            while (i < n)
            {
                r[k] = p[i];
                k++;
                if (p[i] == (byte)39 & i + 1 < n) { if (p[i + 1] == (byte)39) { i++; }; };
                i++;
            };
            out.p = r; out.n = k;
        };

        def sq_hexv(byte c) -> int
        {
            if (c >= (byte)48 & c <= (byte)57) { return (int)c - 48; };
            if (c >= (byte)97 & c <= (byte)102) { return (int)c - 87; };
            if (c >= (byte)65 & c <= (byte)70) { return (int)c - 55; };
            return 0;
        };

        // column value from a source row
        def sq_colv(SQ_STMT* st, SQ_BLK* b, SQ_NODE* nd, SQ_VAL* out) -> void
        {
            SQ_BLK* blk = b;
            SQ_SRC* sr;
            SQ_RS* rs;
            int lvl = nd.lvl;
            int r;
            while (lvl > 0)
            {
                if (blk.parent < 0) { sq_val_null(out); return; };
                blk = st.blks[blk.parent];
                lvl--;
            };
            sr = @blk.src[nd.src];
            r = blk.cur[nd.src];
            rs = sr.rs;
            if (r < 0 | (u64)rs == (u64)0) { sq_val_null(out); return; };
            sq_val_copy(out, @rs.d[r * rs.nc + nd.col]);
        };

        // the column of a USING / NATURAL join that is merged with the same named columns of RIGHT and FULL joined sources
        def sq_colv_alts(SQ_STMT* st, SQ_BLK* b, SQ_NODE* nd, SQ_VAL* out) -> void
        {
            SQ_BLK* blk = b;
            SQ_SRC* sr;
            SQ_RS* rs;
            int lvl = nd.lvl;
            int k, alt, r, a2;
            i64 pk;
            while (lvl > 0)
            {
                if (blk.parent < 0) { return; };
                blk = st.blks[blk.parent];
                lvl--;
            };
            pk = nd.iv;
            for (k = 0; k < 2; k++)
            {
                if (out.t != SQ_NULL) { return; };
                alt = (int)(pk `& (i64)65535) - 1;
                pk = pk >> (i64)16;
                if (alt < 0) { return; };
                a2 = alt / 256;
                sr = @blk.src[a2];
                r = blk.cur[a2];
                rs = sr.rs;
                if (r < 0 | (u64)rs == (u64)0) { continue; };
                sq_val_copy(out, @rs.d[r * rs.nc + (alt % 256)]);
            };
        };

        // runs a subquery block and returns the first value; found is set to 1 when a row existed
        def sq_subq_first(SQ_STMT* st, SQ_BLK* b, int bi, SQ_VAL* out, int* found) -> void
        {
            SQ_RS* rs = sq_run_block(st, bi, 1);
            *found = 0;
            sq_val_null(out);
            if ((u64)rs == (u64)0) { return; };
            if (rs.n > 0 & rs.nc > 0)
            {
                *found = 1;
                sq_val_copy(out, @rs.d[0]);
                sq_val_own(@b.scr, out);
            };
            sq_rs_done(st, bi, rs);
        };

        def sq_eval_cmp(SQ_STMT* st, SQ_BLK* b, SQ_NODE* nd, SQ_VAL* out) -> void
        {
            SQ_VAL x, y;
            int op = nd.op;
            int na = nd.a;
            int nb = nd.b;
            int c, coll;
            sq_eval(st, b, na, @x);
            sq_eval(st, b, nb, @y);
            if (op == SQO_IS | op == SQO_ISNOT)
            {
                if (x.t == SQ_NULL | y.t == SQ_NULL)
                {
                    c = 0;
                    if (x.t == SQ_NULL & y.t == SQ_NULL) { c = 1; };
                }
                else
                {
                    sq_cmp_aff(st, b, na, nb, @x, @y);
                    coll = sq_cmp_coll(st, na, nb);
                    c = 0;
                    if (sq_val_cmpc(@x, @y, coll) == 0) { c = 1; };
                };
                if (op == SQO_ISNOT) { c = 1 - c; };
                sq_val_int(out, (i64)c);
                return;
            };
            if (x.t == SQ_NULL | y.t == SQ_NULL) { sq_val_null(out); return; };
            sq_cmp_aff(st, b, na, nb, @x, @y);
            coll = sq_cmp_coll(st, na, nb);
            c = sq_val_cmpc(@x, @y, coll);
            if (op == SQO_EQ) { sq_val_bool(out, c == 0); return; };
            if (op == SQO_NE) { sq_val_bool(out, c != 0); return; };
            if (op == SQO_LT) { sq_val_bool(out, c < 0); return; };
            if (op == SQO_LE) { sq_val_bool(out, c <= 0); return; };
            if (op == SQO_GT) { sq_val_bool(out, c > 0); return; };
            sq_val_bool(out, c >= 0);
        };

        // equality used by IN and CASE, with affinity rules; 1 equal, 0 not equal, -1 null involved
        def sq_eq_nodes(SQ_STMT* st, SQ_BLK* b, int na, int nb, SQ_VAL* x0, SQ_VAL* y0) -> int
        {
            SQ_VAL x, y;
            sq_val_copy(@x, x0);
            sq_val_copy(@y, y0);
            if (x.t == SQ_NULL | y.t == SQ_NULL) { return 0 - 1; };
            sq_cmp_aff(st, b, na, nb, @x, @y);
            if (sq_val_cmpc(@x, @y, sq_cmp_coll(st, na, nb)) == 0) { return 1; };
            return 0;
        };

        def sq_call_func(SQ_STMT* st, SQ_BLK* b, SQ_NODE* nd, SQ_VAL* out) -> void;
        def sq_call_datetime(SQ_STMT* st, SQ_BLK* blk, int id, SQ_VAL* a, int argc, SQ_VAL* out) -> void;

        def sq_eval(SQ_STMT* st, SQ_BLK* b, int ni, SQ_VAL* out) -> void
        {
            SQ_NODE* nd = @st.nodes[ni];
            SQ_VAL x, y, z, t;
            int k, c, found, seen, e, w;
            byte* r;
            int kind = nd.kind;
            if (kind == SQN_COL)
            {
                sq_colv(st, b, nd, out);
                if (nd.iv != (i64)0) { sq_colv_alts(st, b, nd, out); };
                return;
            };
            if (kind == SQN_INT) { sq_val_int(out, nd.iv); return; };
            if (kind == SQN_REAL) { sq_val_real(out, nd.rv); return; };
            if (kind == SQN_NULL) { sq_val_null(out); return; };
            if (kind == SQN_STR) { sq_unquote(b, @st.sql[nd.s], nd.sl, out); return; };
            if (kind == SQN_BLOB)
            {
                r = sq_scr(b, nd.sl / 2 + 1);
                if ((u64)r == (u64)0) { sq_val_null(out); return; };
                for (k = 0; k + 1 < nd.sl; k = k + 2)
                {
                    r[k / 2] = (byte)(sq_hexv(st.sql[nd.s + k]) * 16 + sq_hexv(st.sql[nd.s + k + 1]));
                };
                out.t = SQ_BLOB; out.p = r; out.n = nd.sl / 2; out.i = (i64)0; out.r = 0.0;
                return;
            };
            if (kind == SQN_PARAM)
            {
                k = (int)nd.iv - 1;
                sq_val_copy(out, @st.pv[k]);
                return;
            };
            if (kind == SQN_COLLATE) { sq_eval(st, b, nd.a, out); return; };
            if (kind == SQN_UNARY)
            {
                sq_eval(st, b, nd.a, @x);
                if (nd.op == 2)
                {
                    c = sq_truth(@x);
                    if (c < 0) { sq_val_null(out); } else { sq_val_int(out, (i64)(1 - c)); };
                    return;
                };
                if (x.t == SQ_NULL) { sq_val_null(out); return; };
                sq_tonum(@x, @y);
                if (nd.op == 3)
                {
                    sq_cast((SQ_ARENA*)0, @x, 3, @y);
                    sq_val_int(out, (i64)0 - y.i - (i64)1);
                    return;
                };
                if (y.t == SQ_INTEGER)
                {
                    if (y.i == (i64)0 - (i64)9223372036854775807 - (i64)1) { sq_val_real(out, 9223372036854775808.0); return; };
                    sq_val_int(out, (i64)0 - y.i);
                    return;
                };
                sq_val_real(out, 0.0 - y.r);
                return;
            };
            if (kind == SQN_BIN)
            {
                c = nd.op;
                if (c == SQO_AND | c == SQO_OR)
                {
                    sq_eval(st, b, nd.a, @x);
                    k = sq_truth(@x);
                    if (c == SQO_AND)
                    {
                        if (k == 0) { sq_val_int(out, (i64)0); return; };
                        sq_eval(st, b, nd.b, @y);
                        e = sq_truth(@y);
                        if (e == 0) { sq_val_int(out, (i64)0); return; };
                        if (k < 0 | e < 0) { sq_val_null(out); return; };
                        sq_val_int(out, (i64)1);
                        return;
                    };
                    if (k == 1) { sq_val_int(out, (i64)1); return; };
                    sq_eval(st, b, nd.b, @y);
                    e = sq_truth(@y);
                    if (e == 1) { sq_val_int(out, (i64)1); return; };
                    if (k < 0 | e < 0) { sq_val_null(out); return; };
                    sq_val_int(out, (i64)0);
                    return;
                };
                if (c >= SQO_EQ & c <= SQO_GE) { sq_eval_cmp(st, b, nd, out); return; };
                if (c == SQO_IS | c == SQO_ISNOT) { sq_eval_cmp(st, b, nd, out); return; };
                sq_eval(st, b, nd.a, @x);
                sq_eval(st, b, nd.b, @y);
                if (c == SQO_CAT)
                {
                    if (x.t == SQ_NULL | y.t == SQ_NULL) { sq_val_null(out); return; };
                    sq_val_text(@b.scr, @x, @z);
                    sq_val_text(@b.scr, @y, @t);
                    r = sq_scr(b, z.n + t.n + 1);
                    if ((u64)r == (u64)0) { sq_val_null(out); return; };
                    sq_mcpy(r, z.p, z.n);
                    sq_mcpy(@r[z.n], t.p, t.n);
                    out.t = SQ_TEXT; out.p = r; out.n = z.n + t.n; out.i = (i64)0; out.r = 0.0;
                    return;
                };
                if (c >= SQO_BAND) { sq_bitop(c, @x, @y, out); return; };
                sq_arith(c, @x, @y, out);
                return;
            };
            if (kind == SQN_ISNULL)
            {
                sq_eval(st, b, nd.a, @x);
                if (nd.op == 1) { sq_val_bool(out, x.t == SQ_NULL); } else { sq_val_bool(out, x.t != SQ_NULL); };
                return;
            };
            if (kind == SQN_IN)
            {
                sq_eval(st, b, nd.a, @x);
                if (x.t == SQ_NULL)
                {
                    // NULL IN (empty set) is false, otherwise NULL
                    sq_val_null(out);
                    if (nd.blk < 0 & nd.b < 0) { sq_val_bool(out, nd.op == 2); };
                    return;
                };
                found = 0;
                seen = 0;
                if (nd.blk >= 0)
                {
                    SQ_RS* rs = sq_run_block(st, nd.blk, 0 - 1);
                    if ((u64)rs != (u64)0)
                    {
                        for (k = 0; k < rs.n; k++)
                        {
                            sq_val_copy(@y, @rs.d[k * rs.nc]);
                            e = sq_eq_nodes(st, b, nd.a, nd.blk, @x, @y);
                            if (e == 1) { found = 1; break; };
                            if (e < 0) { seen = 1; };
                        };
                        sq_rs_done(st, nd.blk, rs);
                    };
                }
                else
                {
                    w = nd.b;
                    while (w >= 0)
                    {
                        sq_eval(st, b, w, @y);
                        e = sq_eq_nodes(st, b, nd.a, w, @x, @y);
                        if (e == 1) { found = 1; break; };
                        if (e < 0) { seen = 1; };
                        w = st.nodes[w].next;
                    };
                };
                if (found == 1) { if (nd.op == 2) { sq_val_int(out, (i64)0); } else { sq_val_int(out, (i64)1); }; return; };
                if (seen == 1) { sq_val_null(out); return; };
                if (nd.op == 2) { sq_val_int(out, (i64)1); } else { sq_val_int(out, (i64)0); };
                return;
            };
            if (kind == SQN_BETWEEN)
            {
                sq_eval(st, b, nd.a, @x);
                sq_eval(st, b, nd.b, @y);
                sq_eval(st, b, nd.c, @z);
                k = 0 - 1;
                e = 0 - 1;
                if (x.t != SQ_NULL & y.t != SQ_NULL)
                {
                    sq_val_copy(@t, @x);
                    w = sq_eq_nodes(st, b, nd.a, nd.b, @x, @y);
                    sq_val_copy(@t, @x);
                    sq_cmp_aff(st, b, nd.a, nd.b, @t, @y);
                    if (sq_val_cmpc(@t, @y, sq_cmp_coll(st, nd.a, nd.b)) >= 0) { k = 1; } else { k = 0; };
                };
                if (x.t != SQ_NULL & z.t != SQ_NULL)
                {
                    sq_val_copy(@t, @x);
                    sq_cmp_aff(st, b, nd.a, nd.c, @t, @z);
                    if (sq_val_cmpc(@t, @z, sq_cmp_coll(st, nd.a, nd.c)) <= 0) { e = 1; } else { e = 0; };
                };
                // k AND e
                if (k == 0 | e == 0) { c = 0; }
                else
                {
                    if (k < 0 | e < 0) { c = 0 - 1; } else { c = 1; };
                };
                if (c >= 0 & nd.op == 2) { c = 1 - c; };
                sq_val_tri(out, c);
                return;
            };
            if (kind == SQN_LIKE)
            {
                sq_eval(st, b, nd.a, @x);
                sq_eval(st, b, nd.b, @y);
                if (x.t == SQ_NULL | y.t == SQ_NULL) { sq_val_null(out); return; };
                k = 0 - 1;
                if (nd.c >= 0)
                {
                    sq_eval(st, b, nd.c, @z);
                    if (z.t == SQ_NULL) { sq_val_null(out); return; };
                    sq_val_text(@b.scr, @z, @t);
                    if (t.n > 0) { k = (int)t.p[0]; };
                };
                sq_val_text(@b.scr, @x, @z);
                sq_val_text(@b.scr, @y, @t);
                if (nd.iv == (i64)1) { c = 0; if (sq_glob(t.p, t.n, z.p, z.n)) { c = 1; }; }
                else { c = 0; if (sq_like(t.p, t.n, z.p, z.n, k)) { c = 1; }; };
                if (nd.op == 2) { c = 1 - c; };
                sq_val_int(out, (i64)c);
                return;
            };
            if (kind == SQN_CASE)
            {
                w = nd.b;
                if (nd.a >= 0) { sq_eval(st, b, nd.a, @x); };
                while (w >= 0)
                {
                    sq_eval(st, b, st.nodes[w].a, @y);
                    if (nd.a >= 0) { c = sq_eq_nodes(st, b, nd.a, st.nodes[w].a, @x, @y); }
                    else { c = sq_truth(@y); };
                    if (c == 1) { sq_eval(st, b, st.nodes[w].b, out); return; };
                    w = st.nodes[w].next;
                };
                if (nd.c >= 0) { sq_eval(st, b, nd.c, out); return; };
                sq_val_null(out);
                return;
            };
            if (kind == SQN_CAST)
            {
                sq_eval(st, b, nd.a, @x);
                sq_cast(@b.scr, @x, (int)nd.iv, out);
                return;
            };
            if (kind == SQN_SUBQ)
            {
                sq_subq_first(st, b, nd.blk, out, @found);
                return;
            };
            if (kind == SQN_EXISTS)
            {
                sq_subq_first(st, b, nd.blk, @x, @found);
                sq_val_int(out, (i64)found);
                return;
            };
            if (kind == SQN_FUNC)
            {
                if (nd.col >= 100)
                {
                    if ((u64)b.aggv == (u64)0) { sq_val_null(out); return; };
                    sq_val_copy(out, @b.aggv[nd.agg]);
                    return;
                };
                sq_call_func(st, b, nd, out);
                return;
            };
            sq_val_null(out);
        };

        // copy of a literal into scratch memory (literals in frames can dangle)
        def sq_lit(SQ_BLK* b, byte* lit, SQ_VAL* out) -> void
        {
            int n = sq_cstrlen(lit);
            byte* r = sq_scr(b, n + 1);
            if ((u64)r == (u64)0) { sq_val_null(out); return; };
            sq_mcpy(r, lit, n);
            r[n] = (byte)0;
            out.t = SQ_TEXT; out.p = r; out.n = n; out.i = (i64)0; out.r = 0.0;
        };

        def sq_mk_text(SQ_BLK* b, int n, SQ_VAL* out) -> byte*
        {
            byte* r = sq_scr(b, n + 1);
            if ((u64)r == (u64)0) { sq_val_null(out); return r; };
            r[n] = (byte)0;
            out.t = SQ_TEXT; out.p = r; out.n = n; out.i = (i64)0; out.r = 0.0;
            return r;
        };

        // ---- number formatting for printf ----

        // writes the body of a formatted double (no sign) into out and returns its length.
        // conv: 102 f, 101 e, 103 g (lower case only; the caller upper-cases for E and G)
        def sq_fmt_double(byte* out, double v, int conv, int prec, int alt) -> int
        {
            byte[1300] dig;
            byte[24] ex;
            int nd, X, neg, o, i, keep, P, ndg, kk, en, useexp, fprec;
            double av;
            av = v;
            if (av < 0.0) { av = 0.0 - av; };
            neg = sq_real_exact(av, @dig[0], @nd, @X);
            o = 0;
            if (neg == 3) { out[0] = (byte)78; out[1] = (byte)97; out[2] = (byte)78; return 3; };
            if (neg == 2) { out[0] = (byte)73; out[1] = (byte)110; out[2] = (byte)102; return 3; };
            if (neg == 4) { dig[0] = (byte)48; nd = 1; X = 0; };
            if (conv == 103)
            {
                P = prec;
                if (P == 0) { P = 1; };
                if (neg != 4) { X = sq_round_digits(@dig[0], @nd, X, P); };
                if (X < 0 - 4 | X >= P) { conv = 101; prec = P - 1; }
                else { conv = 102; prec = P - 1 - X; };
                // trailing zeros are removed unless the alternate form was asked for
                if (alt == 0) { useexp = 1; } else { useexp = 0; };
                if (useexp == 1)
                {
                    ndg = nd;
                    while (ndg > 1) { if (dig[ndg - 1] == (byte)48) { ndg--; } else { break; }; };
                    if (conv == 101) { prec = ndg - 1; } else { prec = ndg - 1 - X; if (prec < 0) { prec = 0; }; };
                };
            };
            if (conv == 101)
            {
                if (neg != 4) { X = sq_round_digits(@dig[0], @nd, X, prec + 1); };
                out[o] = dig[0]; o++;
                if (prec > 0 | alt == 1) { out[o] = (byte)46; o++; };
                for (i = 1; i <= prec; i++)
                {
                    if (i < nd) { out[o] = dig[i]; } else { out[o] = (byte)48; };
                    o++;
                };
                out[o] = (byte)101; o++;
                kk = X;
                if (neg == 4) { kk = 0; };
                if (kk < 0) { out[o] = (byte)45; kk = 0 - kk; } else { out[o] = (byte)43; };
                o++;
                en = 0;
                if (kk >= 100) { ex[en] = (byte)(48 + kk / 100); en++; kk = kk % 100; };
                ex[en] = (byte)(48 + kk / 10); en++;
                ex[en] = (byte)(48 + kk % 10); en++;
                for (i = 0; i < en; i++) { out[o] = ex[i]; o++; };
                return o;
            };
            // fixed notation
            if (neg != 4)
            {
                keep = X + 1 + prec;
                if (keep < 0)
                {
                    nd = 0;
                }
                else
                {
                    if (keep == 0)
                    {
                        // only the rounding digit decides between 0 and one unit in the last place
                        if (dig[0] >= (byte)53) { dig[0] = (byte)49; nd = 1; X++; keep = 1; }
                        else { nd = 0; };
                    }
                    else { X = sq_round_digits(@dig[0], @nd, X, keep); };
                };
            };
            if (nd == 0 | neg == 4)
            {
                out[o] = (byte)48; o++;
                if (prec > 0 | alt == 1) { out[o] = (byte)46; o++; };
                for (i = 0; i < prec; i++) { out[o] = (byte)48; o++; };
                return o;
            };
            // integer part
            if (X < 0) { out[o] = (byte)48; o++; }
            else
            {
                for (i = 0; i <= X; i++)
                {
                    if (i < nd) { out[o] = dig[i]; } else { out[o] = (byte)48; };
                    o++;
                };
            };
            if (prec > 0 | alt == 1) { out[o] = (byte)46; o++; };
            for (i = 1; i <= prec; i++)
            {
                // fraction digit i has digit index X + i
                kk = X + i;
                if (kk >= 0 & kk < nd) { out[o] = dig[kk]; } else { out[o] = (byte)48; };
                o++;
            };
            return o;
        };

        def sq_utf8_put(byte* out, int cp) -> int
        {
            if (cp < 128) { out[0] = (byte)cp; return 1; };
            if (cp < 2048) { out[0] = (byte)(192 + cp / 64); out[1] = (byte)(128 + cp % 64); return 2; };
            if (cp < 65536)
            {
                out[0] = (byte)(224 + cp / 4096);
                out[1] = (byte)(128 + (cp / 64) % 64);
                out[2] = (byte)(128 + cp % 64);
                return 3;
            };
            out[0] = (byte)(240 + cp / 262144);
            out[1] = (byte)(128 + (cp / 4096) % 64);
            out[2] = (byte)(128 + (cp / 64) % 64);
            out[3] = (byte)(128 + cp % 64);
            return 4;
        };

        def sq_utf8_get(byte* p, int n, int* len) -> int
        {
            int c;
            if (n <= 0) { *len = 0; return 0; };
            c = (int)p[0];
            if (c < 128) { *len = 1; return c; };
            if (c >= 240 & n >= 4) { *len = 4; return ((c - 240) * 262144) + (((int)p[1] - 128) * 4096) + (((int)p[2] - 128) * 64) + ((int)p[3] - 128); };
            if (c >= 224 & n >= 3) { *len = 3; return ((c - 224) * 4096) + (((int)p[1] - 128) * 64) + ((int)p[2] - 128); };
            if (c >= 192 & n >= 2) { *len = 2; return ((c - 192) * 64) + ((int)p[1] - 128); };
            *len = 1;
            return c;
        };

        // printf: format in args[0], values in args[1..argc)
        def sq_printf(SQ_BLK* b, SQ_VAL* args, int argc, SQ_VAL* out) -> void
        {
            SQ_VAL f, v, t;
            byte* fp;
            byte* r;
            byte[1400] num;
            int fn, i, o, cap, ai, minus, plus, space, zero, alt, width, prec, hasprec, conv, nl, pad, neg, k, sl, c, extra, qn, ql;
            i64 iv;
            u64 uv;
            double dv;
            byte[24] db;
            if (args[0].t == SQ_NULL) { sq_val_null(out); return; };
            sq_val_text(@b.scr, @args[0], @f);
            fp = f.p;
            fn = f.n;
            cap = fn * 4 + 64;
            for (i = 0; i < fn; i++) { if (fp[i] == (byte)37) { cap = cap + 700; }; };
            for (i = 1; i < argc; i++)
            {
                if (args[i].t == SQ_TEXT | args[i].t == SQ_BLOB) { cap = cap + args[i].n * 2 + 8; };
                cap = cap + 400;
            };
            r = sq_scr(b, cap);
            if ((u64)r == (u64)0) { sq_val_null(out); return; };
            o = 0;
            ai = 1;
            i = 0;
            while (i < fn)
            {
                if (fp[i] != (byte)37) { r[o] = fp[i]; o++; i++; continue; };
                i++;
                if (i >= fn) { break; };
                minus = 0; plus = 0; space = 0; zero = 0; alt = 0;
                while (i < fn)
                {
                    if (fp[i] == (byte)45) { minus = 1; }
                    else { if (fp[i] == (byte)43) { plus = 1; }
                    else { if (fp[i] == (byte)32) { space = 1; }
                    else { if (fp[i] == (byte)48) { zero = 1; }
                    else { if (fp[i] == (byte)35) { alt = 1; } else { break; }; }; }; }; };
                    i++;
                };
                width = 0;
                if (i < fn & fp[i] == (byte)42)
                {
                    if (ai < argc) { sq_cast((SQ_ARENA*)0, @args[ai], 3, @t); width = (int)t.i; ai++; };
                    if (width < 0) { minus = 1; width = 0 - width; };
                    i++;
                }
                else
                {
                    while (i < fn & sq_isdigit(fp[i])) { width = width * 10 + ((int)fp[i] - 48); i++; };
                };
                hasprec = 0;
                prec = 0;
                if (i < fn & fp[i] == (byte)46)
                {
                    hasprec = 1;
                    i++;
                    if (i < fn & fp[i] == (byte)42)
                    {
                        if (ai < argc) { sq_cast((SQ_ARENA*)0, @args[ai], 3, @t); prec = (int)t.i; ai++; };
                        i++;
                    }
                    else
                    {
                        while (i < fn & sq_isdigit(fp[i])) { prec = prec * 10 + ((int)fp[i] - 48); i++; };
                    };
                };
                while (i < fn & (fp[i] == (byte)108 | fp[i] == (byte)104)) { i++; };
                if (i >= fn) { break; };
                conv = (int)fp[i];
                i++;
                if (width > 300) { width = 300; };
                if (prec > 300) { prec = 300; };
                if (conv == 37) { r[o] = (byte)37; o++; continue; };
                nl = 0;
                neg = 0;
                if (conv == 100 | conv == 105)
                {
                    iv = (i64)0;
                    if (ai < argc) { sq_cast((SQ_ARENA*)0, @args[ai], 3, @t); iv = t.i; };
                    ai++;
                    if (iv < (i64)0) { neg = 1; uv = (u64)0 - (u64)iv; } else { uv = (u64)iv; };
                    nl = sq_utoa(uv, @num[0]);
                    if (hasprec == 1) { while (nl < prec) { for (k = nl; k > 0; k--) { num[k] = num[k - 1]; }; num[0] = (byte)48; nl++; }; };
                    if (neg == 0 & plus == 1) { neg = 2; };
                    if (neg == 0 & space == 1) { neg = 3; };
                }
                else
                {
                    if (conv == 117 | conv == 120 | conv == 88 | conv == 111)
                    {
                        uv = (u64)0;
                        if (ai < argc) { sq_cast((SQ_ARENA*)0, @args[ai], 3, @t); uv = (u64)t.i; };
                        ai++;
                        if (conv == 117) { nl = sq_utoa(uv, @num[0]); }
                        else
                        {
                            k = 16;
                            if (conv == 111) { k = 8; };
                            nl = 0;
                            if (uv == (u64)0) { num[0] = (byte)48; nl = 1; };
                            while (uv != (u64)0)
                            {
                                c = (int)(uv % (u64)k);
                                if (c < 10) { num[nl] = (byte)(48 + c); }
                                else { if (conv == 88) { num[nl] = (byte)(55 + c); } else { num[nl] = (byte)(87 + c); }; };
                                nl++;
                                uv = uv / (u64)k;
                            };
                            for (k = 0; k < nl / 2; k++) { c = (int)num[k]; num[k] = num[nl - 1 - k]; num[nl - 1 - k] = (byte)c; };
                        };
                        if (hasprec == 1) { while (nl < prec) { for (k = nl; k > 0; k--) { num[k] = num[k - 1]; }; num[0] = (byte)48; nl++; }; };
                    }
                    else
                    {
                        if (conv == 102 | conv == 101 | conv == 69 | conv == 103 | conv == 71)
                        {
                            dv = 0.0;
                            if (ai < argc) { dv = sq_as_double(@args[ai]); };
                            ai++;
                            if (hasprec == 0) { prec = 6; };
                            if (dv < 0.0) { neg = 1; } else { if (plus == 1) { neg = 2; } else { if (space == 1) { neg = 3; }; }; };
                            k = conv;
                            if (conv == 69) { k = 101; };
                            if (conv == 71) { k = 103; };
                            nl = sq_fmt_double(@num[0], dv, k, prec, alt);
                            if (conv == 69 | conv == 71)
                            {
                                for (k = 0; k < nl; k++) { if (num[k] == (byte)101) { num[k] = (byte)69; }; };
                            };
                        }
                        else
                        {
                            if (conv == 115 | conv == 113 | conv == 81 | conv == 119 | conv == 99)
                            {
                                // string-like conversions are produced straight into the output
                                sq_val_null(@v);
                                if (ai < argc) { sq_val_copy(@v, @args[ai]); };
                                ai++;
                                if (conv == 99)
                                {
                                    sq_val_text(@b.scr, @v, @t);
                                    nl = 0;
                                    if (t.n > 0)
                                    {
                                        nl = 1;
                                        while (nl < t.n)
                                        {
                                            if (((int)t.p[nl] `& 192) == 128) { nl++; } else { break; };
                                        };
                                        sq_mcpy(@num[0], t.p, nl);
                                    };
                                    pad = width - 1;
                                    if (minus == 0) { while (pad > 0) { r[o] = (byte)32; o++; pad--; }; };
                                    for (k = 0; k < nl; k++) { r[o] = num[k]; o++; };
                                    if (minus == 1) { while (pad > 0) { r[o] = (byte)32; o++; pad--; }; };
                                    continue;
                                };
                                if (conv == 81 & v.t == SQ_NULL)
                                {
                                    sq_mcpy(@num[0], "NULL\0", 4);
                                    sl = 4;
                                    sq_val_null(@t);
                                    t.t = SQ_TEXT; t.p = @num[0]; t.n = 4;
                                    sq_mcpy(@r[o], @num[0], 4);
                                    o = o + 4;
                                    continue;
                                };
                                sq_val_text(@b.scr, @v, @t);
                                if (v.t == SQ_NULL) { t.t = SQ_TEXT; t.n = 0; t.p = @num[0]; };
                                sl = t.n;
                                if (hasprec == 1 & conv == 115)
                                {
                                    // precision counts characters
                                    k = sq_utf8_off(t.p, t.n, prec);
                                    sl = k;
                                };
                                qn = 0;
                                if (conv != 115) { for (k = 0; k < sl; k++) { if (t.p[k] == (byte)39 | (conv == 119 & t.p[k] == (byte)34)) { qn++; }; }; };
                                extra = 0;
                                if (conv == 81) { extra = 2; };
                                ql = sl + qn + extra;
                                pad = width - sq_utf8_len(t.p, sl) - qn - extra;
                                if (minus == 0) { while (pad > 0) { r[o] = (byte)32; o++; pad--; }; };
                                if (conv == 81) { r[o] = (byte)39; o++; };
                                for (k = 0; k < sl; k++)
                                {
                                    if (conv != 115)
                                    {
                                        if (t.p[k] == (byte)39 & conv != 119) { r[o] = (byte)39; o++; };
                                        if (conv == 119 & (t.p[k] == (byte)34)) { r[o] = (byte)34; o++; };
                                    };
                                    r[o] = t.p[k];
                                    o++;
                                };
                                if (conv == 81) { r[o] = (byte)39; o++; };
                                if (minus == 1) { while (pad > 0) { r[o] = (byte)32; o++; pad--; }; };
                                continue;
                            }
                            else { continue; };
                        };
                    };
                };
                // numeric padding
                k = nl;
                if (neg != 0) { k++; };
                pad = width - k;
                if (minus == 0 & zero == 0) { while (pad > 0) { r[o] = (byte)32; o++; pad--; }; };
                if (neg == 1) { r[o] = (byte)45; o++; };
                if (neg == 2) { r[o] = (byte)43; o++; };
                if (neg == 3) { r[o] = (byte)32; o++; };
                if (minus == 0 & zero == 1 & hasprec == 0) { while (pad > 0) { r[o] = (byte)48; o++; pad--; }; };
                for (k = 0; k < nl; k++) { r[o] = num[k]; o++; };
                if (minus == 1) { while (pad > 0) { r[o] = (byte)32; o++; pad--; }; };
            };
            r[o] = (byte)0;
            out.t = SQ_TEXT; out.p = r; out.n = o; out.i = (i64)0; out.r = 0.0;
        };

        // ---- date and time functions ----

        struct SQ_DT
        {
            i64 jd;
            int Y, M, D, h, m, vjd, vymd, vhms, err, raw, subsec;
            double s, rawv;
        };

        def sq_dt_compute_jd(SQ_DT* d) -> void
        {
            int Y, M, D, A, B, X1, X2;
            if (d.vjd == 1) { return; };
            if (d.vymd == 1) { Y = d.Y; M = d.M; D = d.D; } else { Y = 2000; M = 1; D = 1; };
            if (M <= 2) { Y--; M = M + 12; };
            A = Y / 100;
            B = 2 - A + (A / 4);
            X1 = (int)(36525 * (Y + 4716) / 100);
            X2 = (int)(306001 * (M + 1) / 10000);
            d.jd = (i64)(((double)(X1 + X2 + D + B) - 1524.5) * 86400000.0);
            d.vjd = 1;
            if (d.vhms == 1)
            {
                d.jd = d.jd + (i64)(d.h * 3600000 + d.m * 60000) + (i64)(d.s * 1000.0 + 0.5);
            };
        };

        def sq_dt_compute_ymd(SQ_DT* d) -> void
        {
            int Z, A, B, C, D, E, X1, alpha;
            if (d.vymd == 1) { return; };
            if (d.vjd == 0) { d.Y = 2000; d.M = 1; d.D = 1; d.vymd = 1; return; };
            Z = (int)((d.jd + (i64)43200000) / (i64)86400000);
            alpha = (int)(((double)Z - 1867216.25) / 36524.25);
            A = Z + 1 + alpha - (alpha / 4);
            B = A + 1524;
            C = (int)(((double)B - 122.1) / 365.25);
            D = (int)((36525 * (C `& 32767)) / 100);
            E = (int)(((double)(B - D)) / 30.6001);
            X1 = (int)(30.6001 * (double)E);
            d.D = B - D - X1;
            if (E < 14) { d.M = E - 1; } else { d.M = E - 13; };
            if (d.M > 2) { d.Y = C - 4716; } else { d.Y = C - 4715; };
            d.vymd = 1;
        };

        def sq_dt_compute_hms(SQ_DT* d) -> void
        {
            i64 ms;
            int sec;
            if (d.vhms == 1) { return; };
            sq_dt_compute_jd(d);
            ms = (d.jd + (i64)43200000) % (i64)86400000;
            if (ms < (i64)0) { ms = ms + (i64)86400000; };
            d.s = (double)(ms % (i64)60000) / 1000.0;
            sec = (int)(ms / (i64)1000);
            d.h = sec / 3600;
            sec = sec - d.h * 3600;
            d.m = sec / 60;
            d.vhms = 1;
        };

        def sq_dt_clear(SQ_DT* d) -> void
        {
            d.vjd = 0; d.vymd = 0; d.vhms = 0; d.err = 0; d.raw = 0; d.subsec = 0; d.jd = (i64)0; d.rawv = 0.0;
            d.Y = 2000; d.M = 1; d.D = 1; d.h = 0; d.m = 0; d.s = 0.0;
        };

        def sq_dt_num(byte* p, int n, int pos, int digits, int* val) -> bool
        {
            int i, v;
            v = 0;
            if (pos + digits > n) { return false; };
            for (i = 0; i < digits; i++)
            {
                if (sq_isdigit(p[pos + i]) == false) { return false; };
                v = v * 10 + ((int)p[pos + i] - 48);
            };
            *val = v;
            return true;
        };

        // HH:MM[:SS[.fff]] followed by an optional zone; returns false when malformed
        def sq_dt_parse_time(SQ_DT* d, byte* p, int n, int pos) -> bool
        {
            int h, m, s, sg, tzh, tzm, k;
            double frac, sc;
            i64 adj;
            if (sq_dt_num(p, n, pos, 2, @h) == false) { return false; };
            if (pos + 2 >= n) { return false; };
            if (p[pos + 2] != (byte)58) { return false; };
            if (sq_dt_num(p, n, pos + 3, 2, @m) == false) { return false; };
            pos = pos + 5;
            s = 0;
            frac = 0.0;
            if (pos < n)
            {
                if (p[pos] == (byte)58)
                {
                    if (sq_dt_num(p, n, pos + 1, 2, @s) == false) { return false; };
                    pos = pos + 3;
                    if (pos < n)
                    {
                        if (p[pos] == (byte)46)
                        {
                            pos++;
                            sc = 0.1;
                            while (pos < n & sq_isdigit(p[pos]))
                            {
                                frac = frac + sc * (double)((int)p[pos] - 48);
                                sc = sc / 10.0;
                                pos++;
                            };
                        };
                    };
                };
            };
            while (pos < n & p[pos] == (byte)32) { pos++; };
            adj = (i64)0;
            if (pos < n)
            {
                if (p[pos] == (byte)90 | p[pos] == (byte)122) { pos++; }
                else
                {
                    if (p[pos] == (byte)43 | p[pos] == (byte)45)
                    {
                        sg = 1;
                        if (p[pos] == (byte)45) { sg = 0 - 1; };
                        if (sq_dt_num(p, n, pos + 1, 2, @tzh) == false) { return false; };
                        if (pos + 3 >= n) { return false; };
                        if (p[pos + 3] != (byte)58) { return false; };
                        if (sq_dt_num(p, n, pos + 4, 2, @tzm) == false) { return false; };
                        adj = (i64)(sg * (tzh * 60 + tzm)) * (i64)60000;
                        pos = pos + 6;
                    };
                };
            };
            if (pos != n) { return false; };
            if (h > 24 | m > 59 | s > 59) { return false; };
            d.h = h; d.m = m; d.s = (double)s + frac; d.vhms = 1;
            d.vjd = 0;
            if (adj != (i64)0)
            {
                sq_dt_compute_jd(d);
                d.jd = d.jd - adj;
                d.vymd = 0; d.vhms = 0;
            };
            return true;
        };

        def sq_dt_now(SQ_DT* d) -> void
        {
            standard::datetime::DateTime t = standard::datetime::dt_now_utc();
            sq_dt_clear(d);
            d.Y = t.year; d.M = t.month; d.D = t.day; d.h = t.hour; d.m = t.minute;
            d.s = (double)t.second + (double)t.ms / 1000.0;
            d.vymd = 1; d.vhms = 1;
            sq_dt_compute_jd(d);
        };

        // parses the time value argument; returns false on error
        def sq_dt_parse_val(SQ_DT* d, SQ_VAL* v) -> bool
        {
            SQ_VAL t;
            byte* p;
            int n, Y, M, D, pos, neg;
            double r;
            sq_dt_clear(d);
            if (v.t == SQ_NULL) { return false; };
            if (v.t == SQ_INTEGER | v.t == SQ_REAL)
            {
                r = sq_as_double(v);
                d.raw = 1; d.rawv = r;
                d.jd = (i64)(r * 86400000.0 + 0.5);
                d.vjd = 1;
                return true;
            };
            p = v.p;
            n = v.n;
            if (sq_ieq(p, n, "now\0")) { sq_dt_now(d); return true; };
            neg = 0;
            pos = 0;
            if (n > 0) { if (p[0] == (byte)45) { neg = 1; pos = 1; }; };
            if (sq_dt_num(p, n, pos, 4, @Y) & pos + 10 <= n)
            {
                if (p[pos + 4] == (byte)45 & p[pos + 7] == (byte)45)
                {
                    if (sq_dt_num(p, n, pos + 5, 2, @M) & sq_dt_num(p, n, pos + 8, 2, @D))
                    {
                        if (M < 1 | M > 12 | D < 1 | D > 31) { return false; };
                        d.Y = Y; d.M = M; d.D = D; d.vymd = 1;
                        if (neg == 1) { d.Y = 0 - Y; };
                        pos = pos + 10;
                        while (pos < n & (p[pos] == (byte)32 | p[pos] == (byte)84)) { pos++; };
                        if (pos >= n) { return true; };
                        return sq_dt_parse_time(d, p, n, pos);
                    };
                };
            };
            if (sq_dt_num(p, n, 0, 2, @Y))
            {
                if (n > 2) { if (p[2] == (byte)58) { return sq_dt_parse_time(d, p, n, 0); }; };
            };
            if (sq_numtext(p, n, @t))
            {
                r = sq_as_double(@t);
                d.raw = 1; d.rawv = r;
                d.jd = (i64)(r * 86400000.0 + 0.5);
                d.vjd = 1;
                return true;
            };
            return false;
        };

        def sq_dt_valid(SQ_DT* d) -> bool
        {
            if (d.vjd == 1)
            {
                if (d.jd < (i64)0 | d.jd > (i64)464269060799999) { return false; };
            };
            return true;
        };

        def sq_dt_modifier(SQ_BLK* blk, SQ_DT* d, SQ_VAL* m) -> bool
        {
            SQ_VAL t;
            byte[40] w;
            byte* p;
            int n, i, k, unit, neg, wd, cur, ndays;
            double r, sc;
            i64 ms;
            if (m.t == SQ_NULL) { return false; };
            sq_val_text(@blk.scr, m, @t);
            p = t.p;
            n = t.n;
            while (n > 0 & p[n - 1] == (byte)32) { n--; };
            while (n > 0 & p[0] == (byte)32) { p = @p[1]; n--; };
            if (sq_ieq(p, n, "localtime\0") | sq_ieq(p, n, "utc\0")) { return true; };
            if (sq_ieq(p, n, "subsec\0") | sq_ieq(p, n, "subsecond\0")) { d.subsec = 1; return true; };
            if (sq_ieq(p, n, "ceiling\0") | sq_ieq(p, n, "floor\0")) { return true; };
            if (sq_ieq(p, n, "julianday\0")) { return true; };
            if (sq_ieq(p, n, "unixepoch\0") | sq_ieq(p, n, "auto\0"))
            {
                if (d.raw != 1) { return false; };
                if (sq_ieq(p, n, "auto\0"))
                {
                    if (d.rawv >= 0.0 & d.rawv < 5373484.5) { return true; };
                    if (d.rawv < 0.0 - 210866760000.0 | d.rawv > 253402300799.0) { return false; };
                };
                d.jd = (i64)(d.rawv * 1000.0 + 0.5) + (i64)210866760000000;
                d.vjd = 1; d.vymd = 0; d.vhms = 0; d.raw = 0;
                return true;
            };
            if (n > 9)
            {
                // "start of month|year|day"
                byte[32] hd;
                for (i = 0; i < 9; i++) { hd[i] = sq_lc(p[i]); };
                hd[9] = (byte)0;
                if (sq_ieq(@hd[0], 9, "start of \0") | (hd[0] == (byte)115 & hd[1] == (byte)116 & hd[2] == (byte)97 & hd[3] == (byte)114 & hd[4] == (byte)116 & hd[5] == (byte)32 & hd[6] == (byte)111 & hd[7] == (byte)102 & hd[8] == (byte)32))
                {
                    sq_dt_compute_ymd(d);
                    sq_dt_compute_hms(d);
                    d.h = 0; d.m = 0; d.s = 0.0; d.vjd = 0; d.vhms = 1;
                    if (sq_ieq(@p[9], n - 9, "month\0")) { d.D = 1; }
                    else
                    {
                        if (sq_ieq(@p[9], n - 9, "year\0")) { d.M = 1; d.D = 1; }
                        else { if (sq_ieq(@p[9], n - 9, "day\0") == false) { return false; }; };
                    };
                    sq_dt_compute_jd(d);
                    d.vymd = 0; d.vhms = 0;
                    return true;
                };
            };
            if (n > 8)
            {
                if (n > 8)
                {
                    k = 0;
                    for (i = 0; i < 8; i++) { w[i] = sq_lc(p[i]); };
                    if (w[0] == (byte)119 & w[1] == (byte)101 & w[2] == (byte)101 & w[3] == (byte)107 & w[4] == (byte)100 & w[5] == (byte)97 & w[6] == (byte)121 & w[7] == (byte)32)
                    {
                        sq_str2num(@p[8], n - 8, @t);
                        wd = (int)sq_as_double(@t);
                        if (wd < 0 | wd > 6) { return false; };
                        sq_dt_compute_jd(d);
                        d.vymd = 0; d.vhms = 0;
                        // weekday of the current day: (jd + 1.5 days) mod 7
                        cur = (int)(((d.jd + (i64)129600000) / (i64)86400000) % (i64)7);
                        ndays = (wd - cur + 7) % 7;
                        d.jd = d.jd + (i64)ndays * (i64)86400000;
                        return true;
                    };
                };
            };
            // [+-]NNN.NNN unit
            i = 0;
            neg = 0;
            if (i < n) { if (p[i] == (byte)43) { i++; } else { if (p[i] == (byte)45) { neg = 1; i++; }; }; };
            if (i >= n) { return false; };
            if (sq_isdigit(p[i]) == false) { return false; };
            r = 0.0;
            while (i < n & sq_isdigit(p[i])) { r = r * 10.0 + (double)((int)p[i] - 48); i++; };
            if (i < n)
            {
                if (p[i] == (byte)46)
                {
                    i++;
                    sc = 0.1;
                    while (i < n & sq_isdigit(p[i])) { r = r + sc * (double)((int)p[i] - 48); sc = sc / 10.0; i++; };
                };
            };
            if (neg == 1) { r = 0.0 - r; };
            while (i < n & p[i] == (byte)32) { i++; };
            n = n - i;
            p = @p[i];
            if (n > 1) { if (p[n - 1] == (byte)115 | p[n - 1] == (byte)83) { n--; }; };
            unit = 0;
            if (sq_ieq(p, n, "second\0")) { unit = 1; };
            if (sq_ieq(p, n, "minute\0")) { unit = 2; };
            if (sq_ieq(p, n, "hour\0")) { unit = 3; };
            if (sq_ieq(p, n, "day\0")) { unit = 4; };
            if (sq_ieq(p, n, "month\0")) { unit = 5; };
            if (sq_ieq(p, n, "year\0")) { unit = 6; };
            if (unit == 0) { return false; };
            if (unit <= 4)
            {
                sq_dt_compute_jd(d);
                ms = (i64)1000;
                if (unit == 2) { ms = (i64)60000; };
                if (unit == 3) { ms = (i64)3600000; };
                if (unit == 4) { ms = (i64)86400000; };
                if (r < 0.0) { d.jd = d.jd + (i64)(r * (double)ms - 0.5); } else { d.jd = d.jd + (i64)(r * (double)ms + 0.5); };
                d.vymd = 0; d.vhms = 0;
                return true;
            };
            sq_dt_compute_ymd(d);
            sq_dt_compute_hms(d);
            if (unit == 5)
            {
                k = (int)r;
                d.M = d.M + k;
                if (d.M > 0) { cur = (d.M - 1) / 12; } else { cur = (d.M - 12) / 12; };
                d.Y = d.Y + cur;
                d.M = d.M - cur * 12;
                r = r - (double)k;
            }
            else
            {
                k = (int)r;
                d.Y = d.Y + k;
                r = r - (double)k;
            };
            d.vjd = 0;
            sq_dt_compute_jd(d);
            d.vymd = 0; d.vhms = 0;
            if (r != 0.0)
            {
                sc = 365.0;
                if (unit == 5) { sc = 30.0; };
                d.jd = d.jd + (i64)(r * 86400000.0 * sc + 0.5);
            };
            return true;
        };

        def sq_dt_put2(byte* o, int v) -> void
        {
            o[0] = (byte)(48 + (v / 10) % 10);
            o[1] = (byte)(48 + v % 10);
        };

        def sq_dt_year(byte* o, int y) -> int
        {
            int k = 0;
            if (y < 0) { o[0] = (byte)45; k = 1; y = 0 - y; };
            o[k] = (byte)(48 + (y / 1000) % 10);
            o[k + 1] = (byte)(48 + (y / 100) % 10);
            o[k + 2] = (byte)(48 + (y / 10) % 10);
            o[k + 3] = (byte)(48 + y % 10);
            return k + 4;
        };

        def sq_call_datetime(SQ_STMT* st, SQ_BLK* blk, int id, SQ_VAL* a, int argc, SQ_VAL* out) -> void
        {
            SQ_DT d;
            SQ_DT y0;
            SQ_VAL t;
            byte* r;
            int i, k, c, first, sec, ms, wk, doy;
            double jdv;
            first = 0;
            if (id == 37 | id == 38 | id == 39)
            {
                sq_dt_now(@d);
                if (id == 37) { k = 33; } else { if (id == 38) { k = 31; } else { k = 32; }; };
                id = k;
            }
            else
            {
                if (id == 35)
                {
                    // strftime(format, time, modifiers...)
                    if (argc < 1) { sq_val_null(out); return; };
                    first = 1;
                };
                if (argc <= first) { sq_dt_now(@d); }
                else
                {
                    if (sq_dt_parse_val(@d, @a[first]) == false) { sq_val_null(out); return; };
                    for (i = first + 1; i < argc; i++)
                    {
                        if (sq_dt_modifier(blk, @d, @a[i]) == false) { sq_val_null(out); return; };
                    };
                };
            };
            if (sq_dt_valid(@d) == false) { sq_val_null(out); return; };
            sq_dt_compute_jd(@d);
            if (id == 34)
            {
                jdv = (double)d.jd / 86400000.0;
                sq_val_real(out, jdv);
                return;
            };
            if (id == 36)
            {
                sq_val_int(out, (d.jd - (i64)210866760000000) / (i64)1000);
                if (d.jd - (i64)210866760000000 < (i64)0 & (d.jd - (i64)210866760000000) % (i64)1000 != (i64)0) { out.i = out.i - (i64)1; };
                return;
            };
            sq_dt_compute_ymd(@d);
            sq_dt_compute_hms(@d);
            if (id == 31)
            {
                r = sq_mk_text(blk, 12, out);
                if ((u64)r == (u64)0) { return; };
                k = sq_dt_year(r, d.Y);
                r[k] = (byte)45; sq_dt_put2(@r[k + 1], d.M);
                r[k + 3] = (byte)45; sq_dt_put2(@r[k + 4], d.D);
                out.n = k + 6;
                return;
            };
            if (id == 32 | id == 33)
            {
                r = sq_mk_text(blk, 40, out);
                if ((u64)r == (u64)0) { return; };
                k = 0;
                if (id == 33)
                {
                    k = sq_dt_year(r, d.Y);
                    r[k] = (byte)45; sq_dt_put2(@r[k + 1], d.M);
                    r[k + 3] = (byte)45; sq_dt_put2(@r[k + 4], d.D);
                    r[k + 6] = (byte)32;
                    k = k + 7;
                };
                sq_dt_put2(@r[k], d.h);
                r[k + 2] = (byte)58; sq_dt_put2(@r[k + 3], d.m);
                r[k + 5] = (byte)58;
                sec = (int)d.s;
                sq_dt_put2(@r[k + 6], sec);
                k = k + 8;
                if (d.subsec == 1)
                {
                    ms = (int)((d.s - (double)sec) * 1000.0 + 0.5);
                    r[k] = (byte)46;
                    r[k + 1] = (byte)(48 + (ms / 100) % 10);
                    r[k + 2] = (byte)(48 + (ms / 10) % 10);
                    r[k + 3] = (byte)(48 + ms % 10);
                    k = k + 4;
                };
                out.n = k;
                return;
            };
            // strftime
            sq_val_text(@blk.scr, @a[0], @t);
            r = sq_mk_text(blk, t.n * 12 + 64, out);
            if ((u64)r == (u64)0) { return; };
            k = 0;
            i = 0;
            sec = (int)d.s;
            while (i < t.n)
            {
                if (t.p[i] != (byte)37 | i + 1 >= t.n) { r[k] = t.p[i]; k++; i++; continue; };
                i++;
                c = (int)t.p[i];
                i++;
                if (c == 100) { sq_dt_put2(@r[k], d.D); k = k + 2; continue; };
                if (c == 109) { sq_dt_put2(@r[k], d.M); k = k + 2; continue; };
                if (c == 72) { sq_dt_put2(@r[k], d.h); k = k + 2; continue; };
                if (c == 77) { sq_dt_put2(@r[k], d.m); k = k + 2; continue; };
                if (c == 83) { sq_dt_put2(@r[k], sec); k = k + 2; continue; };
                if (c == 89) { k = k + sq_dt_year(@r[k], d.Y); continue; };
                if (c == 37) { r[k] = (byte)37; k++; continue; };
                if (c == 70)
                {
                    k = k + sq_dt_year(@r[k], d.Y);
                    r[k] = (byte)45; sq_dt_put2(@r[k + 1], d.M); r[k + 3] = (byte)45; sq_dt_put2(@r[k + 4], d.D);
                    k = k + 6;
                    continue;
                };
                if (c == 84)
                {
                    sq_dt_put2(@r[k], d.h); r[k + 2] = (byte)58; sq_dt_put2(@r[k + 3], d.m); r[k + 5] = (byte)58; sq_dt_put2(@r[k + 6], sec);
                    k = k + 8;
                    continue;
                };
                if (c == 82)
                {
                    sq_dt_put2(@r[k], d.h); r[k + 2] = (byte)58; sq_dt_put2(@r[k + 3], d.m);
                    k = k + 5;
                    continue;
                };
                if (c == 102)
                {
                    ms = (int)((d.s - (double)sec) * 1000.0 + 0.5);
                    sq_dt_put2(@r[k], sec); r[k + 2] = (byte)46;
                    r[k + 3] = (byte)(48 + (ms / 100) % 10); r[k + 4] = (byte)(48 + (ms / 10) % 10); r[k + 5] = (byte)(48 + ms % 10);
                    k = k + 6;
                    continue;
                };
                if (c == 115) { k = k + sq_itoa((d.jd - (i64)210866760000000) / (i64)1000, @r[k]); continue; };
                if (c == 74) { k = k + sq_real_text((double)d.jd / 86400000.0, @r[k]); continue; };
                if (c == 119 | c == 117)
                {
                    wk = (int)(((d.jd + (i64)129600000) / (i64)86400000) % (i64)7);
                    if (c == 117 & wk == 0) { wk = 7; };
                    r[k] = (byte)(48 + wk); k++;
                    continue;
                };
                if (c == 106 | c == 87)
                {
                    sq_dt_clear(@y0);
                    y0.Y = d.Y; y0.M = 1; y0.D = 1; y0.vymd = 1;
                    sq_dt_compute_jd(@y0);
                    doy = (int)((d.jd - y0.jd) / (i64)86400000);
                    if (c == 106)
                    {
                        doy = doy + 1;
                        r[k] = (byte)(48 + doy / 100); r[k + 1] = (byte)(48 + (doy / 10) % 10); r[k + 2] = (byte)(48 + doy % 10);
                        k = k + 3;
                    }
                    else
                    {
                        wk = (int)(((d.jd + (i64)129600000) / (i64)86400000) % (i64)7);
                        sq_dt_put2(@r[k], (doy + 7 - ((wk + 6) % 7)) / 7);
                        k = k + 2;
                    };
                    continue;
                };
                sq_val_null(out);
                return;
            };
            r[k] = (byte)0;
            out.n = k;
        };

        // ---- scalar functions ----

        global u64 SQ_RNG = (u64)88172645463325252;

        def sq_rand64() -> u64
        {
            u64 x = SQ_RNG;
            x = x `^| (x << 13);
            x = x `^| (x >> 7);
            x = x `^| (x << 17);
            SQ_RNG = x;
            return x;
        };

        def sq_trim_match(byte* set, int sn, byte* p, int pn, int fwd) -> int
        {
            // returns the byte length of the set character found at p (forward) or ending at p+pn (backward), 0 when none
            int i, l, cl, k;
            i = 0;
            while (i < sn)
            {
                sq_utf8_get(@set[i], sn - i, @l);
                if (l <= pn)
                {
                    if (fwd == 1)
                    {
                        if (sq_mem_eq(@set[i], p, l)) { return l; };
                    }
                    else
                    {
                        if (sq_mem_eq(@set[i], @p[pn - l], l)) { return l; };
                    };
                };
                i = i + l;
            };
            return 0;
        };

        def sq_do_trim(SQ_BLK* b, SQ_VAL* x, byte* set, int sn, int mode, SQ_VAL* out) -> void
        {
            int s0, e0, l;
            SQ_VAL t;
            sq_val_text(@b.scr, x, @t);
            s0 = 0;
            e0 = t.n;
            if (mode == 1 | mode == 3)
            {
                while (s0 < e0)
                {
                    l = sq_trim_match(set, sn, @t.p[s0], e0 - s0, 1);
                    if (l == 0) { break; };
                    s0 = s0 + l;
                };
            };
            if (mode == 2 | mode == 3)
            {
                while (e0 > s0)
                {
                    l = sq_trim_match(set, sn, @t.p[s0], e0 - s0, 0);
                    if (l == 0) { break; };
                    e0 = e0 - l;
                };
            };
            out.t = SQ_TEXT; out.p = @t.p[s0]; out.n = e0 - s0; out.i = (i64)0; out.r = 0.0;
        };

        def sq_round_real(double x, int n) -> double
        {
            byte[1300] dig;
            byte[1400] buf;
            int nd, X, neg, o, i, keep, kk;
            SQ_VAL v;
            if (n > 30) { n = 30; };
            if (n < 0) { n = 0; };
            if (n == 0)
            {
                if (x < 4503599627370496.0 & x > 0.0 - 4503599627370496.0)
                {
                    if (x < 0.0) { return (double)((i64)(x - 0.5)); };
                    return (double)((i64)(x + 0.5));
                };
                return x;
            };
            neg = sq_real_exact(x, @dig[0], @nd, @X);
            if (neg >= 2) { return x; };
            o = sq_fmt_double(@buf[0], x, 102, n, 0);
            if (x < 0.0) { for (i = o; i > 0; i--) { buf[i] = buf[i - 1]; }; buf[0] = (byte)45; o++; };
            buf[o] = (byte)0;
            sq_str2num(@buf[0], o, @v);
            if (v.t == SQ_INTEGER) { return (double)v.i; };
            return v.r;
        };

        def sq_call_func(SQ_STMT* st, SQ_BLK* b, SQ_NODE* nd, SQ_VAL* out) -> void
        {
            SQ_VAL[16] a;
            SQ_VAL x, y, z, t;
            int id = nd.col;
            int argc = (int)nd.iv;
            int i, k, n, w, p1, p2, e, l, c, s0;
            int ai;
            byte* r;
            i64 iv;
            double dv, dw;
            if (argc > 16) { sq_seterr(st, "too many function arguments\0"); sq_val_null(out); return; };
            // lazy forms
            if (id == 1)
            {
                w = nd.a;
                while (w >= 0)
                {
                    sq_eval(st, b, w, @x);
                    if (x.t != SQ_NULL) { sq_val_copy(out, @x); return; };
                    w = st.nodes[w].next;
                };
                sq_val_null(out);
                return;
            };
            if (id == 2)
            {
                sq_eval(st, b, nd.a, @x);
                if (x.t != SQ_NULL) { sq_val_copy(out, @x); return; };
                sq_eval(st, b, st.nodes[nd.a].next, out);
                return;
            };
            if (id == 27)
            {
                sq_eval(st, b, nd.a, @x);
                if (sq_truth(@x) == 1) { sq_eval(st, b, st.nodes[nd.a].next, out); return; };
                sq_eval(st, b, st.nodes[st.nodes[nd.a].next].next, out);
                return;
            };
            // evaluate all arguments
            w = nd.a;
            i = 0;
            while (w >= 0)
            {
                sq_eval(st, b, w, @a[i]);
                w = st.nodes[w].next;
                i++;
            };
            if (id == 3)
            {
                if (a[0].t == SQ_NULL) { sq_lit(b, "null\0", out); return; };
                if (a[0].t == SQ_INTEGER) { sq_lit(b, "integer\0", out); return; };
                if (a[0].t == SQ_REAL) { sq_lit(b, "real\0", out); return; };
                if (a[0].t == SQ_TEXT) { sq_lit(b, "text\0", out); return; };
                sq_lit(b, "blob\0", out);
                return;
            };
            if (id == 4)
            {
                if (a[0].t == SQ_NULL) { sq_val_null(out); return; };
                sq_tonum(@a[0], @x);
                if (x.t == SQ_INTEGER)
                {
                    if (x.i < (i64)0)
                    {
                        if (x.i == (i64)0 - (i64)9223372036854775807 - (i64)1) { sq_seterr(st, "integer overflow\0"); sq_val_null(out); return; };
                        sq_val_int(out, (i64)0 - x.i);
                    }
                    else { sq_val_int(out, x.i); };
                    return;
                };
                if (x.r < 0.0) { sq_val_real(out, 0.0 - x.r); } else { sq_val_real(out, x.r); };
                return;
            };
            if (id == 5)
            {
                if (a[0].t == SQ_NULL) { sq_val_null(out); return; };
                if (a[0].t == SQ_BLOB) { sq_val_int(out, (i64)a[0].n); return; };
                sq_val_text(@b.scr, @a[0], @x);
                // text stops at the first NUL
                n = 0;
                while (n < x.n) { if (x.p[n] == (byte)0) { break; }; n++; };
                sq_val_int(out, (i64)sq_utf8_len(x.p, n));
                return;
            };
            if (id == 6 | id == 7)
            {
                if (a[0].t == SQ_NULL) { sq_val_null(out); return; };
                sq_val_text(@b.scr, @a[0], @x);
                r = sq_mk_text(b, x.n, out);
                if ((u64)r == (u64)0) { return; };
                for (i = 0; i < x.n; i++)
                {
                    c = (int)x.p[i];
                    if (id == 6 & c >= 97 & c <= 122) { c = c - 32; };
                    if (id == 7 & c >= 65 & c <= 90) { c = c + 32; };
                    r[i] = (byte)c;
                };
                return;
            };
            if (id == 8)
            {
                if (a[0].t == SQ_NULL | a[1].t == SQ_NULL) { sq_val_null(out); return; };
                if (argc == 3) { if (a[2].t == SQ_NULL) { sq_val_null(out); return; }; };
                sq_cast((SQ_ARENA*)0, @a[1], 3, @y);
                p1 = (int)y.i;
                p2 = 2147483647;
                if (argc == 3) { sq_cast((SQ_ARENA*)0, @a[2], 3, @z); p2 = (int)z.i; };
                if (a[0].t == SQ_BLOB) { x = a[0]; l = x.n; } else { sq_val_text(@b.scr, @a[0], @x); l = sq_utf8_len(x.p, x.n); };
                c = 0;
                if (p2 < 0) { p2 = 0 - p2; c = 1; };
                if (p1 < 0)
                {
                    p1 = p1 + l;
                    if (p1 < 0) { p2 = p2 + p1; if (p2 < 0) { p2 = 0; }; p1 = 0; };
                }
                else
                {
                    if (p1 > 0) { p1--; } else { if (p2 > 0) { p2--; }; };
                };
                if (c == 1)
                {
                    p1 = p1 - p2;
                    if (p1 < 0) { p2 = p2 + p1; p1 = 0; };
                };
                if (p1 > l) { p1 = l; };
                if (p2 > l - p1) { p2 = l - p1; };
                if (a[0].t == SQ_BLOB)
                {
                    out.t = SQ_BLOB; out.p = @x.p[p1]; out.n = p2; out.i = (i64)0; out.r = 0.0;
                    return;
                };
                s0 = sq_utf8_off(x.p, x.n, p1);
                e = sq_utf8_off(x.p, x.n, p1 + p2);
                out.t = SQ_TEXT; out.p = @x.p[s0]; out.n = e - s0; out.i = (i64)0; out.r = 0.0;
                return;
            };
            if (id == 9)
            {
                if (a[0].t == SQ_NULL) { sq_val_null(out); return; };
                if (a[1].t != SQ_NULL)
                {
                    if (sq_val_cmpc(@a[0], @a[1], sq_ecoll(st, nd.a)) == 0) { sq_val_null(out); return; };
                };
                sq_val_copy(out, @a[0]);
                return;
            };
            if (id == 10)
            {
                if (a[0].t == SQ_NULL) { sq_val_null(out); return; };
                n = 0;
                if (argc == 2) { sq_cast((SQ_ARENA*)0, @a[1], 3, @y); n = (int)y.i; };
                sq_val_real(out, sq_round_real(sq_as_double(@a[0]), n));
                return;
            };
            if (id == 11 | id == 12)
            {
                for (i = 0; i < argc; i++) { if (a[i].t == SQ_NULL) { sq_val_null(out); return; }; };
                k = 0;
                for (i = 1; i < argc; i++)
                {
                    c = sq_val_cmpc(@a[i], @a[k], 0);
                    if (id == 11 & c < 0) { k = i; };
                    if (id == 12 & c > 0) { k = i; };
                };
                sq_val_copy(out, @a[k]);
                return;
            };
            if (id == 13)
            {
                if (a[0].t == SQ_NULL) { sq_val_text(@b.scr, @a[0], @x); sq_lit(b, "\0", out); return; };
                if (a[0].t == SQ_BLOB) { x = a[0]; } else { sq_val_text(@b.scr, @a[0], @x); };
                r = sq_mk_text(b, x.n * 2, out);
                if ((u64)r == (u64)0) { return; };
                for (i = 0; i < x.n; i++)
                {
                    c = (int)x.p[i] / 16;
                    if (c < 10) { r[i * 2] = (byte)(48 + c); } else { r[i * 2] = (byte)(55 + c); };
                    c = (int)x.p[i] % 16;
                    if (c < 10) { r[i * 2 + 1] = (byte)(48 + c); } else { r[i * 2 + 1] = (byte)(55 + c); };
                };
                return;
            };
            if (id == 14)
            {
                if (a[0].t == SQ_NULL | a[1].t == SQ_NULL | a[2].t == SQ_NULL) { sq_val_null(out); return; };
                sq_val_text(@b.scr, @a[0], @x);
                sq_val_text(@b.scr, @a[1], @y);
                sq_val_text(@b.scr, @a[2], @z);
                if (y.n == 0) { sq_val_copy(out, @x); return; };
                // count matches to size the result
                n = 0;
                i = 0;
                while (i + y.n <= x.n)
                {
                    if (sq_mem_eq(@x.p[i], y.p, y.n)) { n++; i = i + y.n; } else { i++; };
                };
                r = sq_mk_text(b, x.n + n * (z.n - y.n) + 1, out);
                if ((u64)r == (u64)0) { return; };
                k = 0;
                i = 0;
                while (i < x.n)
                {
                    if (i + y.n <= x.n)
                    {
                        if (sq_mem_eq(@x.p[i], y.p, y.n))
                        {
                            sq_mcpy(@r[k], z.p, z.n);
                            k = k + z.n;
                            i = i + y.n;
                            continue;
                        };
                    };
                    r[k] = x.p[i];
                    k++;
                    i++;
                };
                out.n = k;
                return;
            };
            if (id == 15 | id == 16 | id == 17)
            {
                if (a[0].t == SQ_NULL) { sq_val_null(out); return; };
                k = 3;
                if (id == 16) { k = 1; };
                if (id == 17) { k = 2; };
                if (argc == 2)
                {
                    if (a[1].t == SQ_NULL) { sq_val_null(out); return; };
                    sq_val_text(@b.scr, @a[1], @y);
                    sq_do_trim(b, @a[0], y.p, y.n, k, out);
                }
                else
                {
                    sq_do_trim(b, @a[0], " \0", 1, k, out);
                };
                return;
            };
            if (id == 18)
            {
                if (a[0].t == SQ_NULL | a[1].t == SQ_NULL) { sq_val_null(out); return; };
                if (a[0].t == SQ_BLOB & a[1].t == SQ_BLOB) { x = a[0]; y = a[1]; k = 1; }
                else { sq_val_text(@b.scr, @a[0], @x); sq_val_text(@b.scr, @a[1], @y); k = 0; };
                if (y.n == 0) { sq_val_int(out, (i64)1); return; };
                i = 0;
                while (i + y.n <= x.n)
                {
                    if (sq_mem_eq(@x.p[i], y.p, y.n))
                    {
                        if (k == 1) { sq_val_int(out, (i64)(i + 1)); } else { sq_val_int(out, (i64)(sq_utf8_len(x.p, i) + 1)); };
                        return;
                    };
                    i++;
                };
                sq_val_int(out, (i64)0);
                return;
            };
            if (id == 19) { sq_printf(b, @a[0], argc, out); return; };
            if (id == 20)
            {
                if (a[0].t == SQ_NULL) { sq_lit(b, "NULL\0", out); return; };
                if (a[0].t == SQ_INTEGER | a[0].t == SQ_REAL) { sq_val_text(@b.scr, @a[0], out); return; };
                if (a[0].t == SQ_BLOB)
                {
                    r = sq_mk_text(b, a[0].n * 2 + 3, out);
                    if ((u64)r == (u64)0) { return; };
                    r[0] = (byte)88; r[1] = (byte)39;
                    for (i = 0; i < a[0].n; i++)
                    {
                        c = (int)a[0].p[i] / 16;
                        if (c < 10) { r[2 + i * 2] = (byte)(48 + c); } else { r[2 + i * 2] = (byte)(55 + c); };
                        c = (int)a[0].p[i] % 16;
                        if (c < 10) { r[3 + i * 2] = (byte)(48 + c); } else { r[3 + i * 2] = (byte)(55 + c); };
                    };
                    r[2 + a[0].n * 2] = (byte)39;
                    return;
                };
                n = 2;
                for (i = 0; i < a[0].n; i++) { n++; if (a[0].p[i] == (byte)39) { n++; }; };
                r = sq_mk_text(b, n, out);
                if ((u64)r == (u64)0) { return; };
                k = 0;
                r[k] = (byte)39; k++;
                for (i = 0; i < a[0].n; i++)
                {
                    if (a[0].p[i] == (byte)39) { r[k] = (byte)39; k++; };
                    r[k] = a[0].p[i]; k++;
                };
                r[k] = (byte)39;
                return;
            };
            if (id == 21)
            {
                r = sq_mk_text(b, argc * 4, out);
                if ((u64)r == (u64)0) { return; };
                k = 0;
                for (i = 0; i < argc; i++)
                {
                    sq_cast((SQ_ARENA*)0, @a[i], 3, @y);
                    c = (int)y.i;
                    if (c < 0 | c > 1114111) { c = 65533; };
                    k = k + sq_utf8_put(@r[k], c);
                };
                out.n = k;
                return;
            };
            if (id == 22)
            {
                if (a[0].t == SQ_NULL) { sq_val_null(out); return; };
                sq_val_text(@b.scr, @a[0], @x);
                if (x.n == 0) { sq_val_null(out); return; };
                sq_val_int(out, (i64)sq_utf8_get(x.p, x.n, @l));
                return;
            };
            if (id == 23)
            {
                sq_val_int(out, (i64)sq_rand64());
                return;
            };
            if (id == 24 | id == 25)
            {
                if (a[0].t == SQ_NULL) { sq_val_null(out); return; };
                sq_cast((SQ_ARENA*)0, @a[0], 3, @y);
                n = (int)y.i;
                if (n < 1 & id == 24) { n = 1; };
                if (n < 0) { n = 0; };
                r = sq_scr(b, n + 1);
                if ((u64)r == (u64)0) { sq_val_null(out); return; };
                for (i = 0; i < n; i++)
                {
                    if (id == 24) { r[i] = (byte)(sq_rand64() `& (u64)255); } else { r[i] = (byte)0; };
                };
                out.t = SQ_BLOB; out.p = r; out.n = n; out.i = (i64)0; out.r = 0.0;
                return;
            };
            if (id == 26)
            {
                if (a[0].t == SQ_NULL) { sq_val_null(out); return; };
                if (a[0].t == SQ_TEXT)
                {
                    if (sq_numtext(a[0].p, a[0].n, @x) == false) { sq_val_null(out); return; };
                }
                else { sq_tonum(@a[0], @x); };
                dv = sq_as_double(@x);
                if (dv > 0.0) { sq_val_int(out, (i64)1); }
                else { if (dv < 0.0) { sq_val_int(out, (i64)0 - (i64)1); } else { sq_val_int(out, (i64)0); }; };
                return;
            };
            if (id == 28 | id == 29)
            {
                if (a[0].t == SQ_NULL | a[1].t == SQ_NULL) { sq_val_null(out); return; };
                sq_val_text(@b.scr, @a[0], @y);
                sq_val_text(@b.scr, @a[1], @x);
                if (id == 29) { c = (int)sq_glob(y.p, y.n, x.p, x.n); } else { c = (int)sq_like(y.p, y.n, x.p, x.n, 0 - 1); };
                sq_val_int(out, (i64)c);
                return;
            };
            if (id >= 31 & id <= 39) { sq_call_datetime(st, b, id, @a[0], argc, out); return; };
            if (id == 40) { sq_val_int(out, st.last_rowid); return; };
            if (id == 41 | id == 42) { sq_val_int(out, (i64)st.changes); return; };
            if (id == 43) { sq_lit(b, "3.46.0\0", out); return; };
            if (id == 59) { sq_val_copy(out, @a[0]); return; };
            // math
            if (id >= 44 & id <= 58)
            {
                if (id == 53) { sq_val_real(out, 3.141592653589793); return; };
                for (i = 0; i < argc; i++) { if (a[i].t == SQ_NULL) { sq_val_null(out); return; }; };
                if (id == 44 | id == 45)
                {
                    sq_tonum(@a[0], @x);
                    if (x.t == SQ_INTEGER) { sq_val_copy(out, @x); return; };
                    dv = x.r;
                    if (dv > 9.0e18 | dv < 0.0 - 9.0e18) { sq_val_real(out, dv); return; };
                    dw = (double)((i64)dv);
                    if (id == 45) { if (dw > dv) { dw = dw - 1.0; }; } else { if (dw < dv) { dw = dw + 1.0; }; };
                    sq_val_real(out, dw);
                    return;
                };
                dv = sq_as_double(@a[0]);
                dw = 0.0;
                if (argc >= 2) { dw = sq_as_double(@a[1]); };
                if (id == 46) { if (dv < 0.0) { sq_val_null(out); return; }; sq_val_real(out, standard::math::sqrt(dv)); return; };
                if (id == 47) { sq_val_real(out, standard::math::pow(dv, dw)); return; };
                if (id == 48)
                {
                    if (dw == 0.0) { sq_val_null(out); return; };
                    sq_val_real(out, standard::math::fmod(dv, dw));
                    return;
                };
                if (id == 49) { sq_val_real(out, standard::math::exp(dv)); return; };
                if (id == 50) { if (dv <= 0.0) { sq_val_null(out); return; }; sq_val_real(out, standard::math::log(dv)); return; };
                if (id == 51)
                {
                    if (argc == 2)
                    {
                        if (dv <= 0.0 | dw <= 0.0) { sq_val_null(out); return; };
                        sq_val_real(out, standard::math::log(dw) / standard::math::log(dv));
                        return;
                    };
                    if (dv <= 0.0) { sq_val_null(out); return; };
                    sq_val_real(out, standard::math::log10(dv));
                    return;
                };
                if (id == 52) { if (dv <= 0.0) { sq_val_null(out); return; }; sq_val_real(out, standard::math::log2(dv)); return; };
                if (id == 54) { sq_val_real(out, standard::math::sin(dv)); return; };
                if (id == 55) { sq_val_real(out, standard::math::cos(dv)); return; };
                if (id == 56) { sq_val_real(out, standard::math::tan(dv)); return; };
                if (id == 57) { sq_val_real(out, standard::math::atan(dv)); return; };
                sq_val_real(out, standard::math::atan2(dv, dw));
                return;
            };
            sq_val_null(out);
        };

        // ---- rowsets ----

        def sq_rs_new(int nc, int vis) -> SQ_RS*
        {
            SQ_RS* rs = (SQ_RS*)fmalloc((u64)sizeof(SQ_RS));
            if ((u64)rs == (u64)0) { return rs; };
            rs.nc = nc; rs.vis = vis; rs.n = 0; rs.cap = 0; rs.d = (SQ_VAL*)0;
            sq_ar_init(@rs.ar);
            return rs;
        };

        def sq_rs_free(SQ_RS* rs) -> void
        {
            if ((u64)rs == (u64)0) { return; };
            if ((u64)rs.d != (u64)0) { ffree((u64)rs.d); };
            sq_ar_free(@rs.ar);
            ffree((u64)rs);
        };

        // makes room for one more row and returns a pointer to it (columns uninitialised)
        def sq_rs_row(SQ_RS* rs) -> SQ_VAL*
        {
            SQ_VAL* nd;
            int cap;
            if (rs.n >= rs.cap)
            {
                cap = rs.cap * 2;
                if (cap < 16) { cap = 16; };
                nd = (SQ_VAL*)fmalloc((u64)cap * (u64)rs.nc * (u64)sizeof(SQ_VAL));
                if ((u64)nd == (u64)0) { return nd; };
                if (rs.n > 0) { sq_mcpy((byte*)nd, (byte*)rs.d, rs.n * rs.nc * sq_vsz()); };
                if ((u64)rs.d != (u64)0) { ffree((u64)rs.d); };
                rs.d = nd;
                rs.cap = cap;
            };
            rs.n++;
            return @rs.d[(rs.n - 1) * rs.nc];
        };

        // appends a row copying the strings into the rowset arena
        def sq_rs_add(SQ_RS* rs, SQ_VAL* vals) -> bool
        {
            SQ_VAL* row = sq_rs_row(rs);
            int i;
            if ((u64)row == (u64)0) { return false; };
            for (i = 0; i < rs.nc; i++)
            {
                sq_val_copy(@row[i], @vals[i]);
                sq_val_own(@rs.ar, @row[i]);
            };
            return true;
        };

        // ---- sets of value tuples ----

        def sq_set_init(SQ_SET* s, int nk) -> void
        {
            int i;
            s.nk = nk; s.n = 0; s.cap = 0; s.bsize = 0;
            s.keys = (SQ_VAL*)0; s.bucket = (int*)0; s.nxt = (int*)0; s.hs = (int*)0;
            s.isnew = 0;
            for (i = 0; i < 16; i++) { s.coll[i] = 0; };
            sq_ar_init(@s.ar);
        };

        def sq_set_free(SQ_SET* s) -> void
        {
            if ((u64)s.keys != (u64)0) { ffree((u64)s.keys); };
            if ((u64)s.bucket != (u64)0) { ffree((u64)s.bucket); };
            if ((u64)s.nxt != (u64)0) { ffree((u64)s.nxt); };
            if ((u64)s.hs != (u64)0) { ffree((u64)s.hs); };
            s.keys = (SQ_VAL*)0; s.bucket = (int*)0; s.nxt = (int*)0; s.hs = (int*)0;
            sq_ar_free(@s.ar);
            s.n = 0; s.cap = 0;
        };

        def sq_val_hash(SQ_VAL* v, int coll) -> int
        {
            u64 h = (u64)1469598103934665603;
            int i, n;
            double d;
            u64* bp;
            if (v.t == SQ_NULL) { return 7; };
            if (v.t == SQ_INTEGER | v.t == SQ_REAL)
            {
                d = sq_as_double(v);
                if (d == 0.0) { d = 0.0; };
                bp = (u64*)@d;
                h = (*bp) * (u64)11400714819323198485;
                return (int)((h >> 33) `& (u64)2147483647);
            };
            n = v.n;
            if (coll == SQC_RTRIM & v.t == SQ_TEXT)
            {
                while (n > 0) { if (v.p[n - 1] == (byte)32) { n--; } else { break; }; };
            };
            for (i = 0; i < n; i++)
            {
                if (coll == SQC_NOCASE & v.t == SQ_TEXT) { h = (h `^| (u64)sq_lc(v.p[i])) * (u64)1099511628211; }
                else { h = (h `^| (u64)v.p[i]) * (u64)1099511628211; };
            };
            if (v.t == SQ_BLOB) { h = h + (u64)3; };
            return (int)((h >> 33) `& (u64)2147483647);
        };

        def sq_set_hash(SQ_SET* s, SQ_VAL* vals) -> int
        {
            int i;
            u64 h = (u64)17;
            for (i = 0; i < s.nk; i++) { h = h * (u64)31 + (u64)sq_val_hash(@vals[i], s.coll[i]); };
            return (int)(h `& (u64)2147483647);
        };

        def sq_set_eq(SQ_SET* s, int idx, SQ_VAL* vals) -> bool
        {
            int i;
            for (i = 0; i < s.nk; i++)
            {
                if (sq_val_cmpc(@s.keys[idx * s.nk + i], @vals[i], s.coll[i]) != 0) { return false; };
            };
            return true;
        };

        // index of the tuple or -1
        def sq_set_find(SQ_SET* s, SQ_VAL* vals) -> int
        {
            int h, k;
            if (s.bsize == 0) { return 0 - 1; };
            h = sq_set_hash(s, vals);
            k = s.bucket[h % s.bsize];
            while (k >= 0)
            {
                if (s.hs[k] == h) { if (sq_set_eq(s, k, vals)) { return k; }; };
                k = s.nxt[k];
            };
            return 0 - 1;
        };

        // index of the tuple, inserting it when new (isnew tells which); -1 on memory failure
        def sq_set_add(SQ_SET* s, SQ_VAL* vals) -> int
        {
            int h, k, i, ncap, nb;
            SQ_VAL* nk;
            int* nn;
            int* nh;
            int* bk;
            k = sq_set_find(s, vals);
            s.isnew = 0;
            if (k >= 0) { return k; };
            h = sq_set_hash(s, vals);
            if (s.n >= s.cap)
            {
                ncap = s.cap * 2;
                if (ncap < 64) { ncap = 64; };
                nk = (SQ_VAL*)fmalloc((u64)ncap * (u64)(s.nk + 1) * (u64)sizeof(SQ_VAL));
                nn = (int*)fmalloc((u64)ncap * (u64)4);
                nh = (int*)fmalloc((u64)ncap * (u64)4);
                nb = ncap * 2;
                bk = (int*)fmalloc((u64)nb * (u64)4);
                if ((u64)nk == (u64)0 | (u64)nn == (u64)0 | (u64)nh == (u64)0 | (u64)bk == (u64)0) { return 0 - 1; };
                if (s.n > 0)
                {
                    sq_mcpy((byte*)nk, (byte*)s.keys, s.n * s.nk * sq_vsz());
                    sq_mcpy((byte*)nh, (byte*)s.hs, s.n * 4);
                };
                if ((u64)s.keys != (u64)0) { ffree((u64)s.keys); };
                if ((u64)s.nxt != (u64)0) { ffree((u64)s.nxt); };
                if ((u64)s.hs != (u64)0) { ffree((u64)s.hs); };
                if ((u64)s.bucket != (u64)0) { ffree((u64)s.bucket); };
                s.keys = nk; s.nxt = nn; s.hs = nh; s.bucket = bk; s.cap = ncap; s.bsize = nb;
                for (i = 0; i < nb; i++) { bk[i] = 0 - 1; };
                for (i = 0; i < s.n; i++)
                {
                    nn[i] = bk[nh[i] % nb];
                    bk[nh[i] % nb] = i;
                };
            };
            k = s.n;
            s.n++;
            for (i = 0; i < s.nk; i++)
            {
                sq_val_copy(@s.keys[k * s.nk + i], @vals[i]);
                sq_val_own(@s.ar, @s.keys[k * s.nk + i]);
            };
            s.hs[k] = h;
            s.nxt[k] = s.bucket[h % s.bsize];
            s.bucket[h % s.bsize] = k;
            s.isnew = 1;
            return k;
        };

        // ---- sorting ----

        struct SQ_SORT
        {
            SQ_RS* rs;
            int nt;
            int[16] col, desc, coll, nul;
        };

        def sq_sort_cmp(SQ_SORT* so, int ia, int ib) -> int
        {
            int t, c, na, nb2;
            SQ_VAL* a;
            SQ_VAL* b;
            for (t = 0; t < so.nt; t++)
            {
                a = @so.rs.d[ia * so.rs.nc + so.col[t]];
                b = @so.rs.d[ib * so.rs.nc + so.col[t]];
                na = 0;
                nb2 = 0;
                if (a.t == SQ_NULL) { na = 1; };
                if (b.t == SQ_NULL) { nb2 = 1; };
                if (na == 1 | nb2 == 1)
                {
                    if (na == 1 & nb2 == 1) { continue; };
                    // a null sorts before everything unless NULLS LAST was asked for, and descending reverses the default
                    c = 0 - 1;
                    if (nb2 == 1) { c = 1; };
                    if (so.nul[t] == 1) { return c; };
                    if (so.nul[t] == 2) { return 0 - c; };
                    if (so.desc[t] == 1) { return 0 - c; };
                    return c;
                };
                c = sq_val_cmpc(a, b, so.coll[t]);
                if (c != 0)
                {
                    if (so.desc[t] == 1) { return 0 - c; };
                    return c;
                };
            };
            return 0;
        };

        // stable merge sort of the rows; rebuilds the data array in order
        def sq_sort_rs(SQ_SORT* so) -> int
        {
            SQ_RS* rs = so.rs;
            int* perm;
            int* tmp;
            int n = rs.n;
            int width, i, lo, mid, hi, a, b, k;
            SQ_VAL* nd;
            if (n < 2) { return 0; };
            perm = (int*)fmalloc((u64)n * (u64)4);
            tmp = (int*)fmalloc((u64)n * (u64)4);
            if ((u64)perm == (u64)0 | (u64)tmp == (u64)0) { return 1; };
            for (i = 0; i < n; i++) { perm[i] = i; };
            width = 1;
            while (width < n)
            {
                lo = 0;
                while (lo < n)
                {
                    mid = lo + width;
                    if (mid > n) { mid = n; };
                    hi = lo + 2 * width;
                    if (hi > n) { hi = n; };
                    a = lo; b = mid; k = lo;
                    while (a < mid & b < hi)
                    {
                        if (sq_sort_cmp(so, perm[b], perm[a]) < 0) { tmp[k] = perm[b]; b++; } else { tmp[k] = perm[a]; a++; };
                        k++;
                    };
                    while (a < mid) { tmp[k] = perm[a]; a++; k++; };
                    while (b < hi) { tmp[k] = perm[b]; b++; k++; };
                    lo = hi;
                };
                for (i = 0; i < n; i++) { perm[i] = tmp[i]; };
                width = width * 2;
            };
            nd = (SQ_VAL*)fmalloc((u64)n * (u64)rs.nc * (u64)sizeof(SQ_VAL));
            if ((u64)nd == (u64)0) { ffree((u64)perm); ffree((u64)tmp); return 1; };
            for (i = 0; i < n; i++)
            {
                sq_mcpy((byte*)@nd[i * rs.nc], (byte*)@rs.d[perm[i] * rs.nc], rs.nc * sq_vsz());
            };
            ffree((u64)rs.d);
            rs.d = nd;
            rs.cap = n;
            ffree((u64)perm);
            ffree((u64)tmp);
            return 0;
        };

        // ---- indexes: description, record decoding, read cursor ----

        // key columns of an index; col == ncols of the table means the rowid
        struct SQ_IDX
        {
            int root, nk, unique, ispk, ok, schema_pos, tbl_pos;
            int[16] col, desc, coll;
            byte[64] name;
        };

        // payload size kept on the cell page of an index b-tree page
        def sq_ilocal(SQLITE_DB* db, int total) -> int
        {
            int U, X, M, K;
            U = db.usable;
            X = ((U - 12) * 64 / 255) - 23;
            if (total <= X) { return total; };
            M = ((U - 12) * 32 / 255) - 23;
            K = M + ((total - M) % (U - 4));
            if (K <= X) { return K; };
            return M;
        };

        // Decodes a record into values that point into the payload. Returns the number of values.
        def sq_rec_decode(byte* pay, int plen, SQ_VAL* out, int maxv) -> int
        {
            u64 hsz, st;
            int n, pos, hend, off, col, ln, k;
            u64 u;
            double dv;
            u64* bp;
            n = sq_varint(pay, @hsz);
            hend = (int)hsz;
            if (hend > plen) { return 0 - 1; };
            pos = n;
            off = hend;
            col = 0;
            while (pos < hend & col < maxv)
            {
                n = sq_varint(@pay[pos], @st);
                pos = pos + n;
                if (st == (u64)0) { sq_val_null(@out[col]); }
                else
                {
                    if (st == (u64)8) { sq_val_int(@out[col], (i64)0); }
                    else
                    {
                        if (st == (u64)9) { sq_val_int(@out[col], (i64)1); }
                        else
                        {
                            if (st <= (u64)6 | st == (u64)7)
                            {
                                ln = 0;
                                if (st == (u64)1) { ln = 1; };
                                if (st == (u64)2) { ln = 2; };
                                if (st == (u64)3) { ln = 3; };
                                if (st == (u64)4) { ln = 4; };
                                if (st == (u64)5) { ln = 6; };
                                if (st == (u64)6 | st == (u64)7) { ln = 8; };
                                if (off + ln > plen) { return 0 - 1; };
                                u = (u64)0;
                                for (k = 0; k < ln; k++) { u = (u << 8) | (u64)pay[off + k]; };
                                if (st == (u64)7)
                                {
                                    bp = (u64*)@dv;
                                    *bp = u;
                                    sq_val_real(@out[col], dv);
                                }
                                else
                                {
                                    if (ln < 8 & ((u >> (u64)(8 * ln - 1)) `& (u64)1) == (u64)1) { u = u | ((u64)0 - ((u64)1 << (u64)(8 * ln))); };
                                    sq_val_int(@out[col], (i64)u);
                                };
                                off = off + ln;
                            }
                            else
                            {
                                ln = ((int)st - 12) / 2;
                                if ((st `& (u64)1) == (u64)1) { ln = ((int)st - 13) / 2; };
                                if (off + ln > plen) { return 0 - 1; };
                                out[col].n = ln;
                                out[col].p = @pay[off];
                                out[col].i = (i64)0;
                                out[col].r = 0.0;
                                if ((st `& (u64)1) == (u64)1) { out[col].t = SQ_TEXT; } else { out[col].t = SQ_BLOB; };
                                off = off + ln;
                            };
                        };
                    };
                };
                col++;
            };
            return col;
        };

        // True when text a (la bytes) equals text b ignoring case.
        def sq_ieq2(byte* a, int la, byte* b, int lb) -> bool
        {
            int i;
            if (la != lb) { return false; };
            for (i = 0; i < la; i++) { if (sq_lc(a[i]) != sq_lc(b[i])) { return false; }; };
            return true;
        };

        // Parses "CREATE [UNIQUE] INDEX name ON tbl (col [COLLATE c] [ASC|DESC], ...)" into ix. ok is 0 when the index
        // uses expressions or a WHERE clause (such indexes cannot be maintained here).
        def sq_idx_parse(SQ_TI* ti, byte* s, SQ_IDX* ix) -> int
        {
            int i, j, end, ts, tl, kd, a, b, c, n, pend;
            int gs, gl, e2, itend, cs2, cl2, k, col, dsc, cl, depth;
            byte q;
            ix.ok = 1;
            ix.nk = 0;
            ix.unique = 0;
            end = 0;
            while (s[end] != (byte)0) { end++; };
            i = sq_tok2(s, 0, end, @ts, @tl, @kd);
            i = sq_tok2(s, i, end, @ts, @tl, @kd);
            if (sq_ieq(@s[ts], tl, "unique\0")) { ix.unique = 1; i = sq_tok2(s, i, end, @ts, @tl, @kd); };
            if (sq_ieq(@s[ts], tl, "index\0") == false) { ix.ok = 0; return 1; };
            i = sq_tok2(s, i, end, @ts, @tl, @kd);
            if (sq_ieq(@s[ts], tl, "if\0"))
            {
                i = sq_tok2(s, i, end, @ts, @tl, @kd);
                i = sq_tok2(s, i, end, @ts, @tl, @kd);
                i = sq_tok2(s, i, end, @ts, @tl, @kd);
            };
            // schema-qualified names are not produced by this library
            i = sq_tok2(s, i, end, @ts, @tl, @kd);
            if (sq_ieq(@s[ts], tl, "on\0") == false) { ix.ok = 0; return 1; };
            i = sq_tok2(s, i, end, @ts, @tl, @kd);
            i = sq_tok2(s, i, end, @gs, @gl, @kd);
            if (kd != 4) { ix.ok = 0; return 1; };
            // items
            j = gs + 1;
            pend = gs + gl - 1;
            while (j < pend)
            {
                itend = j;
                depth = 0;
                while (itend < pend)
                {
                    if (s[itend] == (byte)40) { depth++; };
                    if (s[itend] == (byte)41) { depth--; };
                    if (s[itend] == (byte)39 | s[itend] == (byte)34 | s[itend] == (byte)96)
                    {
                        q = s[itend];
                        itend++;
                        while (itend < pend & s[itend] != q) { itend++; };
                    };
                    if (s[itend] == (byte)44 & depth == 0) { break; };
                    itend++;
                };
                k = sq_tok2(s, j, itend, @ts, @tl, @kd);
                col = 0 - 1;
                if (kd == 1) { col = sq_ti_find(ti, s, ts, tl); };
                if (kd == 2) { col = sq_ti_find(ti, s, ts + 1, tl - 2); };
                if (col < 0)
                {
                    // rowid by name is a plain key column too
                    if (kd == 1) { if (sq_is_rowid_name(@s[ts], tl)) { col = ti.ncols; }; };
                };
                if (col < 0) { ix.ok = 0; return 0; };
                if (ix.nk >= 16) { ix.ok = 0; return 0; };
                ix.col[ix.nk] = col;
                ix.desc[ix.nk] = 0;
                ix.coll[ix.nk] = 0;
                if (col < ti.ncols) { ix.coll[ix.nk] = ti.coll[col]; };
                while (true)
                {
                    k = sq_tok2(s, k, itend, @ts, @tl, @kd);
                    if (kd == 0) { break; };
                    if (kd != 1) { ix.ok = 0; return 0; };
                    if (sq_ieq(@s[ts], tl, "desc\0")) { ix.desc[ix.nk] = 1; continue; };
                    if (sq_ieq(@s[ts], tl, "asc\0")) { continue; };
                    if (sq_ieq(@s[ts], tl, "collate\0"))
                    {
                        k = sq_tok2(s, k, itend, @ts, @tl, @kd);
                        c = sq_coll_id(@s[ts], tl);
                        if (c < 0) { ix.ok = 0; return 0; };
                        ix.coll[ix.nk] = c;
                        continue;
                    };
                    ix.ok = 0;
                    return 0;
                };
                ix.nk++;
                j = itend + 1;
            };
            // anything after the column list (a WHERE clause) makes the index partial
            k = sq_tok2(s, gs + gl, end, @ts, @tl, @kd);
            if (kd != 0) { ix.ok = 0; };
            return 0;
        };

        // Finds the table's indexes in the schema. Returns the count.
        def sq_idx_list(SQLITE_DB* db, int tblpos, SQ_TI* ti, SQ_IDX* out, int maxn) -> int
        {
            int i, n, ln, nm, k, p, off, j, pos;
            byte* tn;
            n = 0;
            tn = db.schema[tblpos].name;
            for (i = 0; i < db.nschema; i++)
            {
                if (db.schema[i].kind != 2) { continue; };
                if (sq_streq(db.schema[i].tbl_name, tn) == false) { continue; };
                if (n >= maxn) { break; };
                out[n].root = db.schema[i].rootpage;
                out[n].schema_pos = i;
                out[n].tbl_pos = tblpos;
                out[n].ispk = 0;
                for (k = 0; k < 64; k++) { out[n].name[k] = db.schema[i].name[k]; };
                if ((u64)db.schema[i].sql == (u64)0)
                {
                    // automatic index: sqlite_autoindex_<table>_<N>
                    ln = 0;
                    while (out[n].name[ln] != (byte)0) { ln++; };
                    p = ln;
                    while (p > 0 & sq_isdigit(out[n].name[p - 1])) { p--; };
                    nm = (int)sq_atoi(@out[n].name[p], ln - p);
                    out[n].ok = 0;
                    out[n].unique = 1;
                    out[n].nk = 0;
                    if (nm >= 1 & nm <= ti.nix)
                    {
                        off = 0;
                        for (j = 0; j < nm - 1; j++) { off = off + ti.ixn[j]; };
                        out[n].nk = ti.ixn[nm - 1];
                        for (j = 0; j < out[n].nk; j++)
                        {
                            out[n].col[j] = ti.ixc[off + j];
                            out[n].desc[j] = 0;
                            out[n].coll[j] = ti.coll[ti.ixc[off + j]];
                        };
                        out[n].ispk = ti.ixpk[nm - 1];
                        out[n].ok = 1;
                    };
                }
                else { sq_idx_parse(ti, db.schema[i].sql, @out[n]); };
                n++;
            };
            return n;
        };

        // ---- read cursor over an index b-tree ----


        struct SQ_ICUR
        {
            SQLITE_DB* db;
            SQ_IDX* ix;
            int depth, valid;
            int[20] pg;
            int[20] ci;
            byte* pay;
            int pcap, plen, nv;
            SQ_VAL[18] v;
        };

        def sq_icur_settle(SQ_ICUR* c) -> int;

        def sq_icur_open(SQ_ICUR* c, SQLITE_DB* db, SQ_IDX* ix) -> void
        {
            c.db = db; c.ix = ix; c.depth = 0; c.valid = 0;
            c.pay = (byte*)0; c.pcap = 0; c.plen = 0; c.nv = 0;
        };

        def sq_icur_close(SQ_ICUR* c) -> void
        {
            if ((u64)c.pay != (u64)0) { ffree((u64)c.pay); c.pay = (byte*)0; };
            c.pcap = 0;
            c.valid = 0;
        };

        // loads the entry of cell ci on page pgno (leaf or interior index page) and decodes it
        def sq_icur_load(SQ_ICUR* c, int pgno, int ci) -> int
        {
            SQLITE_DB* db = c.db;
            byte* page = sq_page(db, pgno);
            byte* op;
            u64 psz;
            int ho, t, hsz, cp, n, total, lcl, copied, ovf, chunk, i, U, cap;
            byte* nb;
            if ((u64)page == (u64)0) { return 1; };
            ho = sq_hdr_off(pgno);
            t = (int)page[ho];
            hsz = 8;
            if (t == 2) { hsz = 12; };
            cp = sq_be16(@page[ho + hsz + 2 * ci]);
            if (cp >= db.page_size) { return 1; };
            if (t == 2) { cp = cp + 4; };
            n = sq_varint(@page[cp], @psz);
            cp = cp + n;
            total = (int)psz;
            lcl = sq_ilocal(db, total);
            if (total + 16 > c.pcap)
            {
                cap = c.pcap;
                if (cap < 4096) { cap = 4096; };
                while (cap < total + 16) { cap = cap * 2; };
                nb = (byte*)fmalloc((u64)cap);
                if ((u64)nb == (u64)0) { return 1; };
                if ((u64)c.pay != (u64)0) { ffree((u64)c.pay); };
                c.pay = nb;
                c.pcap = cap;
            };
            if (cp + lcl > db.page_size) { return 1; };
            for (i = 0; i < lcl; i++) { c.pay[i] = page[cp + i]; };
            copied = lcl;
            U = db.usable;
            if (lcl < total)
            {
                ovf = sq_be32(@page[cp + lcl]);
                while (copied < total & ovf != 0)
                {
                    op = sq_page(db, ovf);
                    if ((u64)op == (u64)0) { return 1; };
                    chunk = total - copied;
                    if (chunk > U - 4) { chunk = U - 4; };
                    for (i = 0; i < chunk; i++) { c.pay[copied + i] = op[4 + i]; };
                    copied = copied + chunk;
                    ovf = sq_be32(op);
                };
                if (copied < total) { return 1; };
            };
            c.plen = total;
            c.nv = sq_rec_decode(c.pay, total, @c.v[0], 18);
            if (c.nv < 0) { return 1; };
            return 0;
        };

        // compares the first n key values of an entry with probe values: <0 entry before probe, 0 equal, >0 after
        def sq_icmp(SQ_IDX* ix, SQ_VAL* ev, int nev, SQ_VAL* probe, int n) -> int
        {
            int k, c;
            for (k = 0; k < n; k++)
            {
                if (k >= nev) { return 0 - 1; };
                c = sq_val_cmpc(@ev[k], @probe[k], ix.coll[k]);
                if (c != 0)
                {
                    if (ix.desc[k] == 1) { return 0 - c; };
                    return c;
                };
            };
            return 0;
        };

        // Positions at the first entry that is not before the probe (the first entry after the probe when after is 1).
        // Returns 1 on an entry, 0 when none, -1 on error.
        def sq_icur_seek(SQ_ICUR* c, SQ_VAL* probe, int n, int after) -> int
        {
            SQLITE_DB* db = c.db;
            byte* page;
            int pgno, d, ho, t, nc, hsz, lo, hi, mid, cmp, child, cp;
            pgno = c.ix.root;
            c.depth = 0;
            c.valid = 0;
            while (true)
            {
                if (c.depth >= 20) { return 0 - 1; };
                page = sq_page(db, pgno);
                if ((u64)page == (u64)0) { return 0 - 1; };
                ho = sq_hdr_off(pgno);
                t = (int)page[ho];
                nc = sq_be16(@page[ho + 3]);
                hsz = 8;
                if (t == 2) { hsz = 12; };
                if (t != 2 & t != 10) { return 0 - 1; };
                lo = 0;
                hi = nc;
                while (lo < hi)
                {
                    mid = (lo + hi) / 2;
                    if (sq_icur_load(c, pgno, mid) != 0) { return 0 - 1; };
                    cmp = sq_icmp(c.ix, @c.v[0], c.nv, probe, n);
                    if (cmp < 0 | (cmp == 0 & after == 1)) { lo = mid + 1; } else { hi = mid; };
                    page = sq_page(db, pgno);
                    if ((u64)page == (u64)0) { return 0 - 1; };
                };
                d = c.depth;
                c.pg[d] = pgno;
                c.ci[d] = lo;
                c.depth = d + 1;
                if (t == 10)
                {
                    return sq_icur_settle(c);
                };
                if (lo < nc) { child = sq_be32(@page[sq_be16(@page[ho + 12 + 2 * lo])]); }
                else { child = sq_be32(@page[ho + 8]); };
                pgno = child;
            };
            return 0 - 1;
        };

        // The top of the stack is a leaf position (maybe past the last cell) or an interior cell: load the entry or climb.
        def sq_icur_settle(SQ_ICUR* c) -> int
        {
            SQLITE_DB* db = c.db;
            byte* page;
            int d, pgno, ho, nc, ci;
            while (c.depth > 0)
            {
                d = c.depth - 1;
                pgno = c.pg[d];
                page = sq_page(db, pgno);
                if ((u64)page == (u64)0) { return 0 - 1; };
                ho = sq_hdr_off(pgno);
                nc = sq_be16(@page[ho + 3]);
                ci = c.ci[d];
                if (ci < nc)
                {
                    if (sq_icur_load(c, pgno, ci) != 0) { return 0 - 1; };
                    c.valid = 1;
                    return 1;
                };
                c.depth = d;
            };
            c.valid = 0;
            return 0;
        };

        // pushes the leftmost path below child and settles on its first entry
        def sq_icur_descend_left(SQ_ICUR* c, int pgno) -> int
        {
            SQLITE_DB* db = c.db;
            byte* page;
            int ho, t, nc, d;
            while (true)
            {
                if (c.depth >= 20) { return 0 - 1; };
                page = sq_page(db, pgno);
                if ((u64)page == (u64)0) { return 0 - 1; };
                ho = sq_hdr_off(pgno);
                t = (int)page[ho];
                nc = sq_be16(@page[ho + 3]);
                d = c.depth;
                c.pg[d] = pgno;
                c.ci[d] = 0;
                c.depth = d + 1;
                if (t == 10) { return sq_icur_settle(c); };
                if (t != 2) { return 0 - 1; };
                if (nc == 0) { pgno = sq_be32(@page[ho + 8]); }
                else { pgno = sq_be32(@page[sq_be16(@page[ho + 12])]); };
            };
            return 0 - 1;
        };

        def sq_icur_first(SQ_ICUR* c) -> int
        {
            c.depth = 0;
            c.valid = 0;
            return sq_icur_descend_left(c, c.ix.root);
        };

        def sq_icur_next(SQ_ICUR* c) -> int
        {
            SQLITE_DB* db = c.db;
            byte* page;
            int d, pgno, ho, t, nc, child;
            if (c.valid == 0) { return 0; };
            d = c.depth - 1;
            pgno = c.pg[d];
            page = sq_page(db, pgno);
            if ((u64)page == (u64)0) { return 0 - 1; };
            ho = sq_hdr_off(pgno);
            t = (int)page[ho];
            nc = sq_be16(@page[ho + 3]);
            if (t == 10)
            {
                c.ci[d] = c.ci[d] + 1;
                return sq_icur_settle(c);
            };
            // interior entry: the next entry is the leftmost one in the child to its right
            c.ci[d] = c.ci[d] + 1;
            if (c.ci[d] < nc) { child = sq_be32(@page[sq_be16(@page[ho + 12 + 2 * c.ci[d]])]); }
            else { child = sq_be32(@page[ho + 8]); };
            return sq_icur_descend_left(c, child);
        };

        // rowid of the current entry (the last record value)
        def sq_icur_rowid(SQ_ICUR* c) -> i64
        {
            if (c.nv < 1) { return (i64)0; };
            return c.v[c.nv - 1].i;
        };

        // ---- table cursor: seek by rowid ----

        // 1 positioned on the row, 0 no such row, -1 error. The cursor can continue with sq_cur_next afterwards.
        def sq_cur_seek(SQ_CURSOR* cur, i64 rowid) -> int
        {
            SQLITE_DB* db = cur.db;
            byte* page;
            int pgno, ho, t, nc, lo, hi, mid, cp, n, child;
            u64 a, b;
            cur.depth = 0;
            cur.valid = 0;
            pgno = cur.root;
            while (true)
            {
                if (cur.depth >= SQ_MAX_DEPTH) { return 0 - 1; };
                page = sq_page(db, pgno);
                if ((u64)page == (u64)0) { return 0 - 1; };
                ho = sq_hdr_off(pgno);
                t = (int)page[ho];
                nc = sq_be16(@page[ho + 3]);
                lo = 0;
                hi = nc;
                if (t == 13)
                {
                    while (lo < hi)
                    {
                        mid = (lo + hi) / 2;
                        cp = sq_be16(@page[ho + 8 + 2 * mid]);
                        n = sq_varint(@page[cp], @a);
                        sq_varint(@page[cp + n], @b);
                        if ((i64)b < rowid) { lo = mid + 1; } else { hi = mid; };
                    };
                    cur.pg[cur.depth] = pgno;
                    cur.ci[cur.depth] = lo;
                    cur.depth++;
                    if (lo >= nc) { cur.valid = 0; return 0; };
                    cp = sq_be16(@page[ho + 8 + 2 * lo]);
                    n = sq_varint(@page[cp], @a);
                    sq_varint(@page[cp + n], @b);
                    if ((i64)b != rowid) { cur.valid = 0; return 0; };
                    if (sq_load_cell(cur, pgno, lo) != 0) { return 0 - 1; };
                    cur.valid = 1;
                    return 1;
                };
                if (t != 5) { return 0 - 1; };
                while (lo < hi)
                {
                    mid = (lo + hi) / 2;
                    cp = sq_be16(@page[ho + 12 + 2 * mid]);
                    sq_varint(@page[cp + 4], @b);
                    if ((i64)b < rowid) { lo = mid + 1; } else { hi = mid; };
                };
                cur.pg[cur.depth] = pgno;
                cur.ci[cur.depth] = lo;
                cur.depth++;
                if (lo < nc) { child = sq_be32(@page[sq_be16(@page[ho + 12 + 2 * lo])]); }
                else { child = sq_be32(@page[ho + 8]); };
                pgno = child;
            };
            return 0 - 1;
        };

        // ---- executor: sources ----

        // value used for a column that is missing from an old row (ALTER TABLE ADD COLUMN) or omitted in an INSERT
        def sq_default_val(SQ_TI* ti, int c, SQ_ARENA* ar, SQ_VAL* out) -> void
        {
            byte* s = ti.base;
            int a, l, neg;
            SQ_VAL t;
            sq_val_null(out);
            if (ti.dfl[c] <= 0) { return; };
            a = ti.dfs[c];
            l = ti.dfl[c];
            if (s[a] == (byte)39)
            {
                // quoted string: the text between the quotes, doubled quotes collapsed
                byte* r = sq_ar_alloc(ar, l);
                int i = 1;
                int k = 0;
                if ((u64)r == (u64)0) { return; };
                while (i < l - 1)
                {
                    r[k] = s[a + i];
                    k++;
                    if (s[a + i] == (byte)39 & s[a + i + 1] == (byte)39) { i++; };
                    i++;
                };
                out.t = SQ_TEXT; out.p = r; out.n = k; out.i = (i64)0; out.r = 0.0;
                return;
            };
            if (sq_ieq(@s[a], l, "null\0")) { return; };
            if (sq_ieq(@s[a], l, "true\0")) { sq_val_int(out, (i64)1); return; };
            if (sq_ieq(@s[a], l, "false\0")) { sq_val_int(out, (i64)0); return; };
            if (sq_numtext(@s[a], l, @t)) { sq_val_copy(out, @t); sq_apply_aff(ar, ti.aff[c], out); return; };
        };

        // decodes the cursor row into row[0..ncols] (last value is the rowid)
        def sq_fill_row(SQ_STMT* st, SQ_SRC* sr, SQ_CURSOR* cur, SQ_RS* rs, SQ_VAL* row) -> void
        {
            SQ_TI* ti = sr.ti;
            int c, k, nc;
            byte* p;
            nc = ti.ncols;
            for (c = 0; c < nc; c++)
            {
                if (c == ti.ipk) { sq_val_int(@row[c], cur.rowid); continue; };
                if (c >= cur.ncols) { sq_default_val(ti, c, @rs.ar, @row[c]); continue; };
                k = sq_col_type(cur, c);
                if (k == SQ_INTEGER)
                {
                    if (ti.aff[c] == 4) { sq_val_real(@row[c], (double)sq_col_int(cur, c)); }
                    else { sq_val_int(@row[c], sq_col_int(cur, c)); };
                    continue;
                };
                if (k == SQ_REAL) { sq_val_real(@row[c], sq_col_real(cur, c)); continue; };
                if (k == SQ_TEXT | k == SQ_BLOB)
                {
                    row[c].t = k; row[c].n = sq_col_bytes(cur, c); row[c].i = (i64)0; row[c].r = 0.0;
                    p = sq_ar_copy(@rs.ar, sq_col_ptr(cur, c), row[c].n);
                    if ((u64)p == (u64)0) { sq_val_null(@row[c]); } else { row[c].p = p; };
                    continue;
                };
                sq_val_null(@row[c]);
            };
            sq_val_int(@row[nc], cur.rowid);
        };

        // materialises source j of block b
        def sq_load_source(SQ_STMT* st, SQ_BLK* b, int j) -> int
        {
            SQ_SRC* sr = @b.src[j];
            SQ_CURSOR cur;
            SQ_VAL* row;
            SQ_RS* rs;
            int ok, nc;
            if (sr.kind == 2)
            {
                if (sr.cte >= 0)
                {
                    if ((u64)st.ctes[sr.cte].rs == (u64)0)
                    {
                        st.ctes[sr.cte].rs = sq_run_block(st, sr.blk, 0 - 1);
                        if ((u64)st.ctes[sr.cte].rs == (u64)0) { return 1; };
                    };
                    sr.rs = st.ctes[sr.cte].rs;
                    sr.rs_shared = 1;
                    return 0;
                };
                sr.rs = sq_run_block(st, sr.blk, 0 - 1);
                sr.rs_shared = 0;
                if ((u64)sr.rs == (u64)0) { return 1; };
                if ((u64)st.blks[sr.blk].out == (u64)sr.rs) { sr.rs_shared = 1; };
                return 0;
            };
            nc = sr.ti.ncols;
            rs = sq_rs_new(nc + 1, nc + 1);
            if ((u64)rs == (u64)0) { sq_seterr(st, "out of memory\0"); return 1; };
            sr.rs = rs;
            sr.rs_shared = 0;
            cur.payload = (byte*)0;
            cur.pcap = 0;
            sq_cur_open(@cur, st.db, sr.root);
            ok = sq_cur_first(@cur);
            while (ok == 1)
            {
                row = sq_rs_row(rs);
                if ((u64)row == (u64)0) { sq_cur_close(@cur); sq_seterr(st, "out of memory\0"); return 1; };
                sq_fill_row(st, sr, @cur, rs, row);
                ok = sq_cur_next(@cur);
            };
            sq_cur_close(@cur);
            return 0;
        };

        def sq_free_sources(SQ_STMT* st, SQ_BLK* b) -> void
        {
            int j;
            SQ_SRC* sr;
            for (j = 0; j < b.nsrc; j++)
            {
                sr = @b.src[j];
                if ((u64)sr.rs != (u64)0 & sr.rs_shared == 0) { sq_rs_free(sr.rs); };
                sr.rs = (SQ_RS*)0;
            };
        };

        // highest source index that the expression reads at this block level; -1 when constant, 99 when unsafe to move
        def sq_node_level(SQ_STMT* st, int ni, int depth) -> int
        {
            SQ_NODE* nd;
            int m, l, c;
            if (ni < 0) { return 0 - 1; };
            nd = @st.nodes[ni];
            m = 0 - 1;
            if (nd.kind == SQN_SUBQ | nd.kind == SQN_EXISTS) { return 99; };
            if (nd.kind == SQN_IN) { if (nd.blk >= 0) { return 99; }; };
            if (nd.kind == SQN_COL)
            {
                if (nd.lvl == 0) { return nd.src; };
                return 99;
            };
            if (nd.kind == SQN_FUNC) { if (nd.col >= 100) { return 99; }; if (nd.col == 23) { return 99; }; };
            c = nd.a;
            while (c >= 0)
            {
                l = sq_node_level(st, c, depth + 1);
                if (l > m) { m = l; };
                c = st.nodes[c].next;
            };
            c = nd.b;
            while (c >= 0)
            {
                l = sq_node_level(st, c, depth + 1);
                if (l > m) { m = l; };
                c = st.nodes[c].next;
            };
            c = nd.c;
            while (c >= 0)
            {
                l = sq_node_level(st, c, depth + 1);
                if (l > m) { m = l; };
                c = st.nodes[c].next;
            };
            return m;
        };

        // splits the WHERE tree into AND conjuncts and assigns each one the earliest level it can be tested at
        def sq_split_where(SQ_STMT* st, SQ_BLK* b, int ni) -> void
        {
            SQ_NODE* nd;
            int l;
            if (ni < 0) { return; };
            nd = @st.nodes[ni];
            if (nd.kind == SQN_BIN & nd.op == SQO_AND & b.nwc < 29)
            {
                sq_split_where(st, b, nd.a);
                sq_split_where(st, b, nd.b);
                return;
            };
            l = sq_node_level(st, ni, 0);
            if (l < 0) { l = 0 - 1; };
            if (l >= b.nsrc) { l = b.nsrc - 1; };
            b.wcn[b.nwc] = ni;
            b.wcl[b.nwc] = l;
            b.nwc++;
        };

        // ---- executor: rows ----

        def sq_emit(SQ_STMT* st, SQ_BLK* b, SQ_ARM* ar) -> int
        {
            int i, nres, t;
            SQ_VAL* v = @ar.vals[0];
            nres = ar.nres;
            for (i = 0; i < nres; i++) { sq_eval(st, b, b.rc[i], @v[i]); };
            for (t = 0; t < ar.nkeys; t++) { sq_eval(st, b, b.ord[t], @v[nres + t]); };
            if (ar.use_dset == 1)
            {
                // DISTINCT on the visible columns
                ar.dset.nk = nres;
                if (sq_set_add(@ar.dset, v) < 0) { ar.err = 1; return 1; };
                if (ar.dset.isnew == 0) { return 0; };
            };
            if (ar.sorted == 0)
            {
                if (ar.skip > (i64)0) { ar.skip = ar.skip - (i64)1; return 0; };
            };
            if (sq_rs_add(ar.rs, v) == false) { ar.err = 1; sq_seterr(st, "out of memory\0"); return 1; };
            ar.count++;
            if (ar.sorted == 0 & ar.lim >= (i64)0)
            {
                if ((i64)ar.count >= ar.lim) { ar.stop = 1; return 1; };
            };
            return 0;
        };

        // ---- aggregates ----

        // keeps a copy of the streamed row so that bare columns can be read after the scan moved on
        def sq_snap(SQ_STMT* st, SQ_BLK* b, SQ_GRP* g) -> int
        {
            SQ_RS* rs;
            int i;
            if (b.stream != 1) { return 0; };
            if (b.cur[0] < 0) { return 0; };
            rs = b.src[0].rs;
            g.rep0 = (SQ_VAL*)sq_ar_alloc(@b.gar, rs.nc * sizeof(SQ_VAL));
            if ((u64)g.rep0 == (u64)0) { return 1; };
            for (i = 0; i < rs.nc; i++)
            {
                sq_val_copy(@g.rep0[i], @rs.d[i]);
                sq_val_own(@b.gar, @g.rep0[i]);
            };
            return 0;
        };

        def sq_group_new(SQ_STMT* st, SQ_BLK* b, SQ_SET* gs, int gi) -> int
        {
            SQ_GRP* ng;
            int cap, k;
            SQ_ACC* acc;
            if (gi >= b.gcap)
            {
                cap = b.gcap * 2;
                if (cap < 64) { cap = 64; };
                ng = (SQ_GRP*)fmalloc((u64)cap * (u64)sizeof(SQ_GRP));
                if ((u64)ng == (u64)0) { return 1; };
                if (b.ngroups > 0) { sq_mcpy((byte*)ng, (byte*)b.groups, b.ngroups * sq_gsz()); };
                if ((u64)b.groups != (u64)0) { ffree((u64)b.groups); };
                b.groups = ng;
                b.gcap = cap;
            };
            acc = (SQ_ACC*)sq_ar_alloc(@b.gar, (b.nagg + 1) * sizeof(SQ_ACC));
            if ((u64)acc == (u64)0) { return 1; };
            for (k = 0; k < b.nagg; k++)
            {
                acc[k].n = (i64)0; acc[k].si = (i64)0; acc[k].sr = 0.0; acc[k].se = 0.0; acc[k].isreal = 0; acc[k].seen = 0; acc[k].ovf = 0;
                sq_val_null(@acc[k].v);
                acc[k].gc = (byte*)0; acc[k].gcn = 0; acc[k].gccap = 0; acc[k].dset = (SQ_SET*)0;
            };
            b.groups[gi].acc = acc;
            b.groups[gi].key = (SQ_VAL*)0;
            for (k = 0; k < 8; k++) { b.groups[gi].rep[k] = b.cur[k]; };
            b.groups[gi].rep0 = (SQ_VAL*)0;
            b.ngroups = gi + 1;
            return sq_snap(st, b, @b.groups[gi]);
        };

        def sq_agg_update(SQ_STMT* st, SQ_BLK* b, SQ_GRP* g, SQ_SET* gs) -> int
        {
            int k, id, an, w, c, sl, argc, star;
            SQ_NODE* nd;
            SQ_ACC* ac;
            SQ_VAL x, y, t;
            byte* nb;
            for (k = 0; k < b.nagg; k++)
            {
                nd = @st.nodes[b.aggn[k]];
                ac = @g.acc[k];
                id = nd.col;
                argc = (int)nd.iv;
                star = 0;
                if (nd.op == 2) { star = 1; };
                if (id == 100 & star == 1) { ac.n = ac.n + (i64)1; continue; };
                sq_eval(st, b, nd.a, @x);
                if (x.t == SQ_NULL) { continue; };
                if (nd.op == 1)
                {
                    // DISTINCT aggregate: skip values already seen in this group
                    if ((u64)ac.dset == (u64)0)
                    {
                        ac.dset = (SQ_SET*)fmalloc((u64)sizeof(SQ_SET));
                        if ((u64)ac.dset == (u64)0) { return 1; };
                        sq_set_init(ac.dset, 1);
                    };
                    if (sq_set_add(ac.dset, @x) < 0) { return 1; };
                    if (ac.dset.isnew == 0) { continue; };
                };
                if (id == 100) { ac.n = ac.n + (i64)1; continue; };
                if (id == 101 | id == 102 | id == 103)
                {
                    sq_tonum(@x, @y);
                    if (x.t == SQ_TEXT)
                    {
                        // text that is not wholly a number makes the sum approximate, as in SQLite
                        if (sq_numtext(x.p, x.n, @t) == false) { sq_val_real(@y, sq_as_double(@y)); };
                    };
                    if (x.t == SQ_BLOB) { sq_val_real(@y, sq_as_double(@y)); };
                    ac.n = ac.n + (i64)1;
                    ac.seen = 1;
                    if (y.t == SQ_REAL) { ac.isreal = 1; };
                    if (ac.isreal == 1 | ac.ovf == 1)
                    {
                        if (ac.ovf == 0)
                        {
                            ac.sr = (double)ac.si;
                            ac.ovf = 1;
                        };
                        // Kahan-Babuska-Neumaier summation, as SQLite does
                        {
                            double rr = sq_as_double(@y);
                            double ss = ac.sr;
                            double tt = ss + rr;
                            double fa = ss; double fb = rr;
                            if (fa < 0.0) { fa = 0.0 - fa; };
                            if (fb < 0.0) { fb = 0.0 - fb; };
                            if (fa > fb) { ac.se = ac.se + ((ss - tt) + rr); } else { ac.se = ac.se + ((rr - tt) + ss); };
                            ac.sr = tt;
                        };
                    }
                    else
                    {
                        t.i = ac.si + y.i;
                        if ((ac.si >= (i64)0) == (y.i >= (i64)0) & (t.i >= (i64)0) != (ac.si >= (i64)0))
                        {
                            ac.sr = (double)ac.si + (double)y.i;
                            ac.ovf = 1;
                        }
                        else { ac.si = t.i; };
                    };
                    continue;
                };
                if (id == 104 | id == 105)
                {
                    if (ac.seen == 0)
                    {
                        ac.seen = 1;
                        sq_val_copy(@ac.v, @x);
                        sq_val_own(@b.gar, @ac.v);
                        if (b.nminmax == 1) { for (c = 0; c < 8; c++) { g.rep[c] = b.cur[c]; }; if (sq_snap(st, b, g) != 0) { return 1; }; };
                    }
                    else
                    {
                        c = sq_val_cmpc(@x, @ac.v, sq_ecoll(st, nd.a));
                        if ((id == 104 & c < 0) | (id == 105 & c > 0))
                        {
                            sq_val_copy(@ac.v, @x);
                            sq_val_own(@b.gar, @ac.v);
                            if (b.nminmax == 1) { for (c = 0; c < 8; c++) { g.rep[c] = b.cur[c]; }; if (sq_snap(st, b, g) != 0) { return 1; }; };
                        };
                    };
                    continue;
                };
                if (id == 106)
                {
                    sq_val_text(@b.scr, @x, @y);
                    sl = 1;
                    nb = ",";
                    t.t = SQ_TEXT; t.p = nb; t.n = 1;
                    if (argc == 2)
                    {
                        w = st.nodes[nd.a].next;
                        sq_eval(st, b, w, @t);
                        sq_val_text(@b.scr, @t, @t);
                    };
                    if (t.t == SQ_NULL) { t.t = SQ_TEXT; t.n = 0; };
                    sl = y.n;
                    if (ac.seen == 1) { sl = sl + t.n; };
                    if (ac.gcn + sl + 1 > ac.gccap)
                    {
                        w = ac.gccap * 2;
                        if (w < ac.gcn + sl + 1) { w = ac.gcn + sl + 1 + 64; };
                        nb = sq_ar_alloc(@b.gar, w);
                        if ((u64)nb == (u64)0) { return 1; };
                        if (ac.gcn > 0) { sq_mcpy(nb, ac.gc, ac.gcn); };
                        ac.gc = nb;
                        ac.gccap = w;
                    };
                    if (ac.seen == 1) { sq_mcpy(@ac.gc[ac.gcn], t.p, t.n); ac.gcn = ac.gcn + t.n; };
                    sq_mcpy(@ac.gc[ac.gcn], y.p, y.n);
                    ac.gcn = ac.gcn + y.n;
                    ac.seen = 1;
                };
            };
            return 0;
        };

        // value of aggregate k of a group, built into out
        def sq_agg_final(SQ_STMT* st, SQ_BLK* b, SQ_ACC* ac, int id, SQ_VAL* out) -> void
        {
            if (id == 100) { sq_val_int(out, ac.n); return; };
            if (id == 101)
            {
                if (ac.seen == 0) { sq_val_null(out); return; };
                if (ac.isreal == 1 | ac.ovf == 1) { sq_val_real(out, ac.sr + ac.se); } else { sq_val_int(out, ac.si); };
                return;
            };
            if (id == 102)
            {
                if (ac.seen == 0) { sq_val_real(out, 0.0); return; };
                if (ac.isreal == 1 | ac.ovf == 1) { sq_val_real(out, ac.sr + ac.se); } else { sq_val_real(out, (double)ac.si); };
                return;
            };
            if (id == 103)
            {
                if (ac.seen == 0) { sq_val_null(out); return; };
                if (ac.isreal == 1 | ac.ovf == 1) { sq_val_real(out, (ac.sr + ac.se) / (double)ac.n); } else { sq_val_real(out, (double)ac.si / (double)ac.n); };
                return;
            };
            if (id == 104 | id == 105) { sq_val_copy(out, @ac.v); return; };
            if (ac.seen == 0) { sq_val_null(out); return; };
            out.t = SQ_TEXT; out.p = ac.gc; out.n = ac.gcn; out.i = (i64)0; out.r = 0.0;
        };

        def sq_free_groups(SQ_STMT* st, SQ_BLK* b) -> void
        {
            int g, k;
            for (g = 0; g < b.ngroups; g++)
            {
                for (k = 0; k < b.nagg; k++)
                {
                    if ((u64)b.groups[g].acc[k].dset != (u64)0)
                    {
                        sq_set_free(b.groups[g].acc[k].dset);
                        ffree((u64)b.groups[g].acc[k].dset);
                    };
                };
            };
            if ((u64)b.groups != (u64)0) { ffree((u64)b.groups); };
            b.groups = (SQ_GRP*)0;
            b.ngroups = 0;
            b.gcap = 0;
            sq_ar_free(@b.gar);
        };

        // ---- executor: joins ----

        def sq_join(SQ_STMT* st, SQ_BLK* b, int j, SQ_ARM* ar, SQ_SET* gs) -> int;

        def sq_leaf(SQ_STMT* st, SQ_BLK* b, SQ_ARM* ar, SQ_SET* gs) -> int
        {
            SQ_VAL[16] kv;
            int i, gi;
            if (b.has_agg == 1 | b.ngrp > 0)
            {
                for (i = 0; i < b.ngrp; i++) { sq_eval(st, b, b.grp[i], @kv[i]); };
                gi = sq_set_add(gs, @kv[0]);
                if (gi < 0) { ar.err = 1; sq_seterr(st, "out of memory\0"); return 1; };
                if (gs.isnew == 1)
                {
                    if (sq_group_new(st, b, gs, gi) != 0) { ar.err = 1; sq_seterr(st, "out of memory\0"); return 1; };
                };
                if (sq_agg_update(st, b, @b.groups[gi], gs) != 0) { ar.err = 1; sq_seterr(st, "out of memory\0"); return 1; };
                if (b.bare == 1 & b.nminmax != 1)
                {
                    // bare columns report the most recent row of the group
                    for (i = 0; i < 8; i++) { b.groups[gi].rep[i] = b.cur[i]; };
                    if (sq_snap(st, b, @b.groups[gi]) != 0) { ar.err = 1; sq_seterr(st, "out of memory\0"); return 1; };
                };
                return 0;
            };
            return sq_emit(st, b, ar);
        };

        def sq_where_upto(SQ_STMT* st, SQ_BLK* b, int j) -> int;

        def sq_join_after(SQ_STMT* st, SQ_BLK* b, int j, SQ_ARM* ar, SQ_SET* gs) -> int
        {
            int w;
            SQ_VAL x;
            if (b.rjmax > 0)
            {
                // with RIGHT or FULL joins no conjunct may filter before the last such join has produced its rows
                if (j < b.rjmax) { return sq_join(st, b, j + 1, ar, gs); };
                if (sq_where_upto(st, b, j) != 0) { return 0; };
                return sq_join(st, b, j + 1, ar, gs);
            };
            for (w = 0; w < b.nwc; w++)
            {
                if (b.wcl[w] != j) { continue; };
                sq_eval(st, b, b.wcn[w], @x);
                if (sq_truth(@x) != 1) { return 0; };
            };
            return sq_join(st, b, j + 1, ar, gs);
        };

        // 0 when every conjunct that belongs to the sources 0..j holds
        def sq_where_upto(SQ_STMT* st, SQ_BLK* b, int j) -> int
        {
            int w;
            SQ_VAL x;
            for (w = 0; w < b.nwc; w++)
            {
                if (b.wcl[w] < 0 | b.wcl[w] > j) { continue; };
                sq_eval(st, b, b.wcn[w], @x);
                if (sq_truth(@x) != 1) { return 1; };
            };
            return 0;
        };

        // rows of RIGHT and FULL joined sources that never matched, joined to NULL rows on the left
        def sq_join_right_pass(SQ_STMT* st, SQ_BLK* b, SQ_ARM* ar, SQ_SET* gs) -> int
        {
            SQ_SRC* sr;
            byte* fl;
            int jr, i, k, rc;
            for (jr = 1; jr < b.nsrc; jr++)
            {
                sr = @b.src[jr];
                if (sr.jt < 4) { continue; };
                fl = (byte*)b.rfl[jr];
                if ((u64)fl == (u64)0) { continue; };
                for (i = 0; i < sr.rs.n; i++)
                {
                    if (fl[i] != (byte)0) { continue; };
                    for (k = 0; k < jr; k++) { b.cur[k] = 0 - 1; };
                    b.cur[jr] = i;
                    sq_ar_reset(@b.scr);
                    if (jr == b.rjmax) { if (sq_where_upto(st, b, jr) != 0) { continue; }; };
                    rc = sq_join(st, b, jr + 1, ar, gs);
                    if (rc != 0) { return rc; };
                };
            };
            return 0;
        };

        def sq_join_one(SQ_STMT* st, SQ_BLK* b, int j, SQ_ARM* ar, SQ_SET* gs, int* matched) -> int
        {
            SQ_SRC* sr = @b.src[j];
            SQ_VAL x, y;
            int u, ls, lr, k2, u2;
            SQ_SRC* ol;
            SQ_RS* lrs;
            if (j > 0)
            {
                if (sr.on >= 0)
                {
                    sq_eval(st, b, sr.on, @x);
                    if (sq_truth(@x) != 1) { return 0; };
                };
                for (u = 0; u < sr.nusing; u++)
                {
                    ls = sr.uls[u];
                    ol = @b.src[ls];
                    lrs = ol.rs;
                    lr = b.cur[ls];
                    sq_val_null(@x);
                    if (lr >= 0) { sq_val_copy(@x, @lrs.d[lr * lrs.nc + sr.ulc[u]]); };
                    if (x.t == SQ_NULL)
                    {
                        // the merged column of earlier RIGHT / FULL joins
                        for (k2 = 1; k2 < j; k2++)
                        {
                            ol = @b.src[k2];
                            if (ol.jt < 4) { continue; };
                            for (u2 = 0; u2 < ol.nusing; u2++)
                            {
                                if (ol.uls[u2] == ls & ol.ulc[u2] == sr.ulc[u] & b.cur[k2] >= 0)
                                {
                                    sq_val_copy(@x, @ol.rs.d[b.cur[k2] * ol.rs.nc + ol.urc[u2]]);
                                };
                            };
                        };
                    };
                    if (lr < 0 & x.t == SQ_NULL) { return 0; };
                    sq_val_copy(@y, @sr.rs.d[b.cur[j] * sr.rs.nc + sr.urc[u]]);
                    if (x.t == SQ_NULL | y.t == SQ_NULL) { return 0; };
                    if (sq_val_cmpc(@x, @y, 0) != 0) { return 0; };
                };
            };
            *matched = 1;
            return sq_join_after(st, b, j, ar, gs);
        };

        // Planner for the first source of a block: an equality between one of its columns and a constant narrows the scan to the
        // matching rows (rowid / integer primary key seek, or a scan of the matching index entries). The WHERE clause is still
        // evaluated on every row that is produced, so the plan only has to return a superset of the matching rows.
        // Returns -1 when no plan applies, otherwise the result of the scan.
        def sq_scan0_planned(SQ_STMT* st, SQ_BLK* b, SQ_SRC* sr, SQ_RS* rs, SQ_ARM* ar, SQ_SET* gs) -> int
        {
            SQ_NODE* nd;
            SQ_NODE* na;
            SQ_NODE* nb;
            SQ_NODE* cn;
            SQ_NODE* kn;
            SQ_ARENA pa;
            SQ_VAL probe;
            SQ_IDX[20] ixs;
            SQ_ICUR icur;
            int w, colx, kx, n, k, ix, rc, ok, matched, mode, eq;
            i64 rid;
            if (sr.kind != 1 | sr.tbl < 0 | (u64)sr.ti == (u64)0) { return 0 - 1; };
            if (b.rjmax > 0) { return 0 - 1; };
            colx = 0 - 1;
            kx = 0 - 1;
            for (w = 0; w < b.nwc; w++)
            {
                if (b.wcl[w] != 0) { continue; };
                nd = @st.nodes[b.wcn[w]];
                if (nd.kind != SQN_BIN | nd.op != SQO_EQ) { continue; };
                na = @st.nodes[nd.a];
                nb = @st.nodes[nd.b];
                cn = (SQ_NODE*)0;
                kn = (SQ_NODE*)0;
                if (na.kind == SQN_COL & na.src == 0 & na.lvl == 0)
                {
                    if (nb.kind == SQN_INT | nb.kind == SQN_REAL | nb.kind == SQN_STR | nb.kind == SQN_PARAM) { cn = na; kn = nb; kx = nd.b; };
                };
                if ((u64)cn == (u64)0)
                {
                    if (nb.kind == SQN_COL & nb.src == 0 & nb.lvl == 0)
                    {
                        if (na.kind == SQN_INT | na.kind == SQN_REAL | na.kind == SQN_STR | na.kind == SQN_PARAM) { cn = nb; kn = na; kx = nd.a; };
                    };
                };
                if ((u64)cn == (u64)0) { continue; };
                colx = cn.col;
                break;
            };
            if (colx < 0) { return 0 - 1; };
            sq_ar_init(@pa);
            sq_eval(st, b, kx, @probe);
            if (probe.t == SQ_NULL) { return 0 - 1; };
            // the constant is converted by the affinity of the column, as in a comparison
            if (probe.t == SQ_TEXT | probe.t == SQ_BLOB)
            {
                k = sr.ti.aff[0];
                if (colx < sr.ti.ncols) { k = sr.ti.aff[colx]; };
                if (colx == sr.ti.ncols) { k = 3; };
                if (probe.t == SQ_TEXT & k >= 2) { sq_apply_aff(@pa, 2, @probe); };
            };
            if (probe.t == SQ_TEXT | probe.t == SQ_BLOB)
            {
                kn = (SQ_NODE*)0;
                // keep the bytes beyond the per-row reset of the scratch arena
                {
                    byte* cp = sq_ar_copy(@pa, probe.p, probe.n);
                    if ((u64)cp == (u64)0) { sq_ar_free(@pa); return 0 - 1; };
                    probe.p = cp;
                };
            };
            matched = 0;
            mode = 0;
            if (colx == sr.ti.ncols | colx == sr.ti.ipk)
            {
                if (probe.t == SQ_INTEGER) { rid = probe.i; mode = 1; };
                if (probe.t == SQ_REAL)
                {
                    rid = (i64)probe.r;
                    if ((double)rid == probe.r) { mode = 1; };
                };
                if (mode == 0) { sq_ar_free(@pa); return 0 - 1; };
                sq_cur_open(@b.scur, st.db, sr.root);
                b.cur[0] = 0;
                rc = sq_cur_seek(@b.scur, rid);
                if (rc == 1)
                {
                    sq_ar_reset(@rs.ar);
                    sq_ar_reset(@b.scr);
                    sq_fill_row(st, sr, @b.scur, rs, @rs.d[0]);
                    rc = sq_join_one(st, b, 0, ar, gs, @matched);
                }
                else { if (rc < 0) { rc = 1; } else { rc = 0; }; };
                sq_cur_close(@b.scur);
                sq_ar_free(@pa);
                return rc;
            };
            n = sq_idx_list(st.db, sr.tbl, sr.ti, @ixs[0], 20);
            ix = 0 - 1;
            for (k = 0; k < n; k++)
            {
                if (ixs[k].ok != 1 | ixs[k].nk < 1) { continue; };
                if (ixs[k].col[0] != colx) { continue; };
                if (ixs[k].coll[0] != sr.ti.coll[colx]) { continue; };
                ix = k;
                break;
            };
            if (ix < 0) { sq_ar_free(@pa); return 0 - 1; };
            sq_cur_open(@b.scur, st.db, sr.root);
            sq_icur_open(@icur, st.db, @ixs[ix]);
            b.cur[0] = 0;
            rc = 0;
            ok = sq_icur_seek(@icur, @probe, 1, 0);
            while (ok == 1)
            {
                eq = sq_val_cmpc(@icur.v[0], @probe, ixs[ix].coll[0]);
                if (eq != 0) { break; };
                if (sq_cur_seek(@b.scur, sq_icur_rowid(@icur)) == 1)
                {
                    sq_ar_reset(@rs.ar);
                    sq_ar_reset(@b.scr);
                    sq_fill_row(st, sr, @b.scur, rs, @rs.d[0]);
                    rc = sq_join_one(st, b, 0, ar, gs, @matched);
                    if (rc != 0) { break; };
                };
                ok = sq_icur_next(@icur);
            };
            if (ok < 0 & rc == 0) { rc = 1; };
            sq_icur_close(@icur);
            sq_cur_close(@b.scur);
            sq_ar_free(@pa);
            return rc;
        };

        def sq_join(SQ_STMT* st, SQ_BLK* b, int j, SQ_ARM* ar, SQ_SET* gs) -> int
        {
            SQ_SRC* sr;
            SQ_RS* rs;
            SQ_VAL* row;
            int i, rc, matched, ok, mi;
            if (j >= b.nsrc) { return sq_leaf(st, b, ar, gs); };
            sr = @b.src[j];
            rs = sr.rs;
            matched = 0;
            if (j == 0 & b.stream == 1)
            {
                rc = sq_scan0_planned(st, b, sr, rs, ar, gs);
                if (rc >= 0) { return rc; };
                sq_cur_open(@b.scur, st.db, sr.root);
                ok = sq_cur_first(@b.scur);
                b.cur[0] = 0;
                while (ok == 1)
                {
                    sq_ar_reset(@rs.ar);
                    sq_ar_reset(@b.scr);
                    sq_fill_row(st, sr, @b.scur, rs, @rs.d[0]);
                    rc = sq_join_one(st, b, 0, ar, gs, @matched);
                    if (rc != 0) { sq_cur_close(@b.scur); return rc; };
                    ok = sq_cur_next(@b.scur);
                };
                sq_cur_close(@b.scur);
                return 0;
            };
            for (i = 0; i < rs.n; i++)
            {
                b.cur[j] = i;
                sq_ar_reset(@b.scr);
                mi = 0;
                rc = sq_join_one(st, b, j, ar, gs, @mi);
                if (mi == 1)
                {
                    matched = 1;
                    if (sr.jt >= 4) { ((byte*)b.rfl[j])[i] = (byte)1; };
                };
                if (rc != 0) { return rc; };
            };
            if ((sr.jt == 2 | sr.jt == 5) & matched == 0)
            {
                b.cur[j] = 0 - 1;
                sq_ar_reset(@b.scr);
                return sq_join_after(st, b, j, ar, gs);
            };
            return 0;
        };

        // ---- executor: blocks ----

        def sq_has_bare(SQ_STMT* st, int ni) -> bool
        {
            SQ_NODE* nd;
            int c;
            if (ni < 0) { return false; };
            nd = @st.nodes[ni];
            if (nd.kind == SQN_FUNC) { if (nd.col >= 100) { return false; }; };
            if (nd.kind == SQN_COL) { if (nd.lvl == 0) { return true; }; return false; };
            if (nd.kind == SQN_SUBQ | nd.kind == SQN_EXISTS) { return false; };
            c = nd.a;
            while (c >= 0) { if (sq_has_bare(st, c)) { return true; }; c = st.nodes[c].next; };
            c = nd.b;
            while (c >= 0) { if (sq_has_bare(st, c)) { return true; }; c = st.nodes[c].next; };
            c = nd.c;
            while (c >= 0) { if (sq_has_bare(st, c)) { return true; }; c = st.nodes[c].next; };
            return false;
        };

        def sq_eval_i64(SQ_STMT* st, SQ_BLK* b, int ni, i64 dflt) -> i64
        {
            SQ_VAL x, y;
            if (ni < 0) { return dflt; };
            sq_eval(st, b, ni, @x);
            if (x.t == SQ_NULL) { return dflt; };
            sq_cast((SQ_ARENA*)0, @x, 3, @y);
            return y.i;
        };

        def sq_run_arm(SQ_STMT* st, int bi, int keys, i64 skip, i64 lim, int sorted) -> SQ_RS*
        {
            SQ_BLK* b = st.blks[bi];
            SQ_ARM* ar;
            SQ_RS* rs;
            SQ_RS* rs2;
            SQ_SET gs;
            SQ_SORT so;
            SQ_VAL x;
            SQ_VAL[16] zk;
            SQ_VAL* av;
            SQ_GRP* g;
            int j, w, k, nres, nkeys, aggmode, rc, gi, ncol, order_n, skipall, t;
            int* ord;
            SQ_SRC* sr;
            nres = b.nres;
            nkeys = 0;
            if (keys == 1) { nkeys = b.nord; };
            ar = (SQ_ARM*)fmalloc((u64)sizeof(SQ_ARM));
            if ((u64)ar == (u64)0) { sq_seterr(st, "out of memory\0"); return (SQ_RS*)0; };
            rs = sq_rs_new(nres + nkeys, nres);
            if ((u64)rs == (u64)0) { ffree((u64)ar); sq_seterr(st, "out of memory\0"); return rs; };
            ar.rs = rs; ar.nres = nres; ar.nkeys = nkeys; ar.skip = skip; ar.lim = lim; ar.sorted = sorted;
            ar.count = 0; ar.stop = 0; ar.err = 0;
            ar.use_dset = b.distinct;
            if (b.distinct == 1) { sq_set_init(@ar.dset, nres); };
            for (j = 0; j < 8; j++) { b.cur[j] = 0 - 1; };
            b.stream = 0;
            b.aggv = (SQ_VAL*)0;
            skipall = 0;
            // sources
            for (j = 0; j < b.nsrc; j++)
            {
                sr = @b.src[j];
                if (j == 0 & sr.kind == 1)
                {
                    b.stream = 1;
                    sr.rs = sq_rs_new(sr.ti.ncols + 1, sr.ti.ncols + 1);
                    sr.rs_shared = 0;
                    if ((u64)sr.rs == (u64)0) { sq_seterr(st, "out of memory\0"); skipall = 2; break; };
                    if ((u64)sq_rs_row(sr.rs) == (u64)0) { sq_seterr(st, "out of memory\0"); skipall = 2; break; };
                    continue;
                };
                if (sq_load_source(st, b, j) != 0) { skipall = 2; break; };
            };
            if (skipall != 2)
            {
                b.nwc = 0;
                sq_split_where(st, b, b.where_n);
                b.nminmax = 0;
                for (k = 0; k < b.nagg; k++)
                {
                    if (st.nodes[b.aggn[k]].col == 104 | st.nodes[b.aggn[k]].col == 105) { b.nminmax++; };
                };
                b.bare = 0;
                for (k = 0; k < nres; k++) { if (sq_has_bare(st, b.rc[k])) { b.bare = 1; }; };
                if (sq_has_bare(st, b.having)) { b.bare = 1; };
                for (k = 0; k < b.nord; k++) { if (sq_has_bare(st, b.ord[k])) { b.bare = 1; }; };
                // conjuncts that do not depend on this block's rows
                for (w = 0; w < b.nwc; w++)
                {
                    if (b.wcl[w] < 0)
                    {
                        sq_eval(st, b, b.wcn[w], @x);
                        if (sq_truth(@x) != 1) { skipall = 1; };
                        b.wcl[w] = 0 - 2;
                    };
                };
                if (b.nsrc == 0) { for (w = 0; w < b.nwc; w++) { b.wcl[w] = 0 - 2; }; };
                aggmode = 0;
                if (b.has_agg == 1 | b.ngrp > 0) { aggmode = 1; };
                sq_set_init(@gs, b.ngrp);
                for (k = 0; k < b.ngrp; k++) { if (k < 16) { gs.coll[k] = sq_ecoll(st, b.grp[k]); }; };
                if (aggmode == 1 & b.ngrp == 0)
                {
                    // the single implicit group exists even without input rows
                    gi = sq_set_add(@gs, @zk[0]);
                    if (gi < 0) { sq_seterr(st, "out of memory\0"); skipall = 2; }
                    else
                    {
                        if (sq_group_new(st, b, @gs, gi) != 0) { sq_seterr(st, "out of memory\0"); skipall = 2; };
                    };
                };
                rc = 0;
                if (sorted == 0 & lim == (i64)0) { skipall = 1; };
                b.rjmax = 0;
                for (j = 1; j < 8; j++) { b.rfl[j] = (u64)0; };
                for (j = 1; j < b.nsrc; j++)
                {
                    if (b.src[j].jt >= 4)
                    {
                        b.rjmax = j;
                        b.rfl[j] = (u64)fmalloc((u64)(b.src[j].rs.n + 8));
                        if (b.rfl[j] == (u64)0) { sq_seterr(st, "out of memory\0"); skipall = 2; break; };
                        for (k = 0; k < b.src[j].rs.n + 8; k++) { ((byte*)b.rfl[j])[k] = (byte)0; };
                    };
                };
                if (skipall == 0) { rc = sq_join(st, b, 0, ar, @gs); };
                if (skipall == 0 & rc == 0 & b.rjmax > 0) { rc = sq_join_right_pass(st, b, ar, @gs); };
                for (j = 1; j < 8; j++)
                {
                    if (b.rfl[j] != (u64)0) { ffree(b.rfl[j]); b.rfl[j] = (u64)0; };
                };
                b.rjmax = 0;
                if (aggmode == 1 & skipall != 2 & ar.err == 0 & ar.stop == 0)
                {
                    // groups in key order
                    ord = (int*)fmalloc((u64)(b.ngroups + 1) * (u64)4);
                    if ((u64)ord == (u64)0) { ar.err = 1; sq_seterr(st, "out of memory\0"); }
                    else
                    {
                        for (gi = 0; gi < b.ngroups; gi++) { ord[gi] = gi; };
                        if (b.ngrp > 0 & b.ngroups > 1)
                        {
                            rs2 = sq_rs_new(b.ngrp + 1, b.ngrp + 1);
                            if ((u64)rs2 != (u64)0)
                            {
                                for (gi = 0; gi < b.ngroups; gi++)
                                {
                                    av = sq_rs_row(rs2);
                                    for (k = 0; k < b.ngrp; k++) { sq_val_copy(@av[k], @gs.keys[gi * b.ngrp + k]); };
                                    sq_val_int(@av[b.ngrp], (i64)gi);
                                };
                                so.rs = rs2; so.nt = b.ngrp;
                                for (k = 0; k < b.ngrp; k++) { so.col[k] = k; so.desc[k] = 0; so.coll[k] = sq_ecoll(st, b.grp[k]); so.nul[k] = 0; };
                                if (sq_sort_rs(@so) == 0)
                                {
                                    for (gi = 0; gi < b.ngroups; gi++) { ord[gi] = (int)rs2.d[gi * rs2.nc + b.ngrp].i; };
                                };
                                sq_rs_free(rs2);
                            };
                        };
                        av = (SQ_VAL*)sq_ar_alloc(@b.gar, (b.nagg + 1) * sizeof(SQ_VAL));
                        for (t = 0; t < b.ngroups; t++)
                        {
                            gi = ord[t];
                            g = @b.groups[gi];
                            for (k = 0; k < b.nagg; k++) { sq_agg_final(st, b, @g.acc[k], st.nodes[b.aggn[k]].col, @av[k]); };
                            b.aggv = av;
                            for (k = 0; k < 8; k++) { b.cur[k] = g.rep[k]; };
                            if (b.stream == 1)
                            {
                                if ((u64)g.rep0 != (u64)0)
                                {
                                    sq_mcpy((byte*)b.src[0].rs.d, (byte*)g.rep0, b.src[0].rs.nc * sq_vsz());
                                    b.cur[0] = 0;
                                }
                                else { b.cur[0] = 0 - 1; };
                            };
                            sq_ar_reset(@b.scr);
                            if (b.having >= 0)
                            {
                                sq_eval(st, b, b.having, @x);
                                if (sq_truth(@x) != 1) { continue; };
                            };
                            if (sq_emit(st, b, ar) != 0) { break; };
                        };
                        ffree((u64)ord);
                    };
                };
                sq_set_free(@gs);
                b.aggv = (SQ_VAL*)0;
                sq_free_groups(st, b);
            };
            sq_free_sources(st, b);
            sq_ar_reset(@b.scr);
            if (b.distinct == 1) { sq_set_free(@ar.dset); };
            if (ar.err != 0 | skipall == 2 | st.err[0] != (byte)0)
            {
                sq_rs_free(rs);
                ffree((u64)ar);
                return (SQ_RS*)0;
            };
            ffree((u64)ar);
            return rs;
        };

        // keeps rows [off, off+lim) in place
        def sq_rs_trim(SQ_RS* rs, i64 off, i64 lim) -> void
        {
            int o, n, i;
            if (off > (i64)rs.n) { off = (i64)rs.n; };
            o = (int)off;
            n = rs.n - o;
            if (lim >= (i64)0 & lim < (i64)n) { n = (int)lim; };
            if (o > 0 & n > 0) { sq_mcpy((byte*)rs.d, (byte*)@rs.d[o * rs.nc], n * rs.nc * sq_vsz()); };
            rs.n = n;
        };

        def sq_rs_done(SQ_STMT* st, int bi, SQ_RS* rs) -> void
        {
            if (st.blks[bi].is_corr == 1) { sq_rs_free(rs); return; };
            // an uncorrelated block keeps its result for later evaluations
        };

        def sq_rs_all_cols(SQ_SORT* so, SQ_RS* rs) -> void
        {
            int k;
            so.rs = rs;
            so.nt = rs.vis;
            if (so.nt > 16) { so.nt = 16; };
            for (k = 0; k < so.nt; k++) { so.col[k] = k; so.desc[k] = 0; so.coll[k] = 0; so.nul[k] = 0; };
        };

        def sq_run_block(SQ_STMT* st, int bi, int maxrows) -> SQ_RS*
        {
            SQ_BLK* h = st.blks[bi];
            SQ_RS* rs;
            SQ_RS* rb;
            SQ_RS* rc;
            SQ_SORT so;
            SQ_SET set1, set2;
            SQ_VAL* row;
            i64 lim, off;
            int a, k, t, sorted, cop;
            if (h.is_corr == 0 & (u64)h.out != (u64)0) { return h.out; };
            sq_ar_reset(@h.scr);
            lim = sq_eval_i64(st, h, h.limit_n, (i64)0 - (i64)1);
            off = sq_eval_i64(st, h, h.offset_n, (i64)0);
            if (lim < (i64)0) { lim = (i64)0 - (i64)1; };
            if (off < (i64)0) { off = (i64)0; };
            if (h.cnext < 0)
            {
                sorted = 0;
                if (h.nord > 0) { sorted = 1; };
                if (sorted == 1)
                {
                    rs = sq_run_arm(st, bi, 1, (i64)0, (i64)0 - (i64)1, 1);
                }
                else
                {
                    // rows needed: offset plus limit (or just the first row for a probe)
                    if (maxrows >= 0)
                    {
                        if (lim < (i64)0 | (i64)maxrows < lim) { lim = (i64)maxrows; };
                    };
                    rs = sq_run_arm(st, bi, 0, off, lim, 0);
                };
                if ((u64)rs == (u64)0) { return rs; };
                if (sorted == 1)
                {
                    so.rs = rs; so.nt = h.nord;
                    for (k = 0; k < h.nord; k++)
                    {
                        so.col[k] = h.nres + k;
                        so.desc[k] = h.odesc[k];
                        so.nul[k] = h.onull[k];
                        so.coll[k] = h.ocoll[k];
                        if (so.coll[k] < 0) { so.coll[k] = sq_ecoll(st, h.ord[k]); };
                    };
                    if (sq_sort_rs(@so) != 0) { sq_rs_free(rs); sq_seterr(st, "out of memory\0"); return (SQ_RS*)0; };
                    if (maxrows >= 0)
                    {
                        if (lim < (i64)0 | (i64)maxrows < lim) { lim = (i64)maxrows; };
                    };
                    sq_rs_trim(rs, off, lim);
                };
            }
            else
            {
                rs = sq_run_arm(st, bi, 0, (i64)0, (i64)0 - (i64)1, 1);
                if ((u64)rs == (u64)0) { return rs; };
                a = h.cnext;
                while (a >= 0)
                {
                    cop = st.blks[a].cop;
                    if (st.blks[a].nres != h.nres)
                    {
                        sq_rs_free(rs);
                        sq_seterr(st, "SELECTs to the left and right of a compound operator do not have the same number of result columns\0");
                        return (SQ_RS*)0;
                    };
                    rb = sq_run_arm(st, a, 0, (i64)0, (i64)0 - (i64)1, 1);
                    if ((u64)rb == (u64)0) { sq_rs_free(rs); return rb; };
                    if (cop == 2)
                    {
                        for (t = 0; t < rb.n; t++) { sq_rs_add(rs, @rb.d[t * rb.nc]); };
                        sq_rs_free(rb);
                    }
                    else
                    {
                        rc = sq_rs_new(h.nres, h.nres);
                        sq_set_init(@set1, h.nres);
                        sq_set_init(@set2, h.nres);
                        if (cop == 1)
                        {
                            for (t = 0; t < rs.n; t++) { sq_set_add(@set1, @rs.d[t * rs.nc]); if (set1.isnew == 1) { sq_rs_add(rc, @rs.d[t * rs.nc]); }; };
                            for (t = 0; t < rb.n; t++) { sq_set_add(@set1, @rb.d[t * rb.nc]); if (set1.isnew == 1) { sq_rs_add(rc, @rb.d[t * rb.nc]); }; };
                        }
                        else
                        {
                            for (t = 0; t < rb.n; t++) { sq_set_add(@set2, @rb.d[t * rb.nc]); };
                            for (t = 0; t < rs.n; t++)
                            {
                                k = sq_set_find(@set2, @rs.d[t * rs.nc]);
                                if (cop == 3 & k < 0) { continue; };
                                if (cop == 4 & k >= 0) { continue; };
                                sq_set_add(@set1, @rs.d[t * rs.nc]);
                                if (set1.isnew == 1) { sq_rs_add(rc, @rs.d[t * rs.nc]); };
                            };
                        };
                        sq_set_free(@set1);
                        sq_set_free(@set2);
                        sq_rs_free(rs);
                        sq_rs_free(rb);
                        rs = rc;
                        // the dedupe leaves the rows ordered by value
                        sq_rs_all_cols(@so, rs);
                        sq_sort_rs(@so);
                    };
                    a = st.blks[a].cnext;
                };
                if (h.nord > 0)
                {
                    so.rs = rs; so.nt = h.nord;
                    for (k = 0; k < h.nord; k++)
                    {
                        so.col[k] = (int)st.nodes[h.ord[k]].iv;
                        so.desc[k] = h.odesc[k];
                        so.nul[k] = h.onull[k];
                        so.coll[k] = h.ocoll[k];
                        if (so.coll[k] < 0) { so.coll[k] = 0; };
                    };
                    sq_sort_rs(@so);
                };
                if (maxrows >= 0)
                {
                    if (lim < (i64)0 | (i64)maxrows < lim) { lim = (i64)maxrows; };
                };
                sq_rs_trim(rs, off, lim);
            };
            if (h.is_corr == 0) { h.out = rs; };
            return rs;
        };

        // ---- statement lifecycle ----

        def sq_stmt_init(SQ_STMT* st, SQLITE_DB* db, byte* sql) -> void
        {
            int n, i;
            st.db = db;
            n = 0;
            while (sql[n] != (byte)0 & n < 200000) { st.sql[n] = sql[n]; n++; };
            st.sql[n] = (byte)0;
            st.sqllen = n;
            st.lim = n;
            st.pos = 0; st.tk = 0; st.ts = 0; st.tl = 0; st.tq = 0; st.tcode = 0; st.tend = 0; st.prevend = 0;
            st.nodes = (SQ_NODE*)0; st.nn = 0; st.ncap = 0; st.bn = 0;
            st.nblk = 0; st.ncte = 0; st.kind = 0; st.root_blk = 0 - 1; st.nres = 0; st.curblk = 0 - 1;
            st.pcount = 0; st.nparam = 0;
            for (i = 0; i < 64; i++) { sq_val_null(@st.pv[i]); st.pns[i] = 0; st.pnl[i] = 0; };
            sq_ar_init(@st.par);
            sq_ar_init(@st.ar);
            st.state = 0; st.ri = 0; st.res = (SQ_RS*)0; st.ncols_out = 0;
            st.err[0] = (byte)0;
            st.changes = 0;
            st.last_rowid = (i64)0;
            st.dml_tbl = 0 - 1; st.dml_root = 0;
            st.ret = (SQ_RS*)0; st.retsql = (byte*)0; st.ret_s = 0 - 1; st.ret_e = 0 - 1;
        };

        def sq_clear_caches(SQ_STMT* st) -> void
        {
            int i;
            for (i = 0; i < st.nblk; i++)
            {
                if ((u64)st.blks[i].out != (u64)0) { sq_rs_free(st.blks[i].out); st.blks[i].out = (SQ_RS*)0; };
            };
            for (i = 0; i < st.ncte; i++) { st.ctes[i].rs = (SQ_RS*)0; };
            st.res = (SQ_RS*)0;
        };

        def sq_reset(SQ_STMT* st) -> void
        {
            sq_clear_caches(st);
            st.state = 0;
            st.ri = 0;
            st.err[0] = (byte)0;
        };

        def sq_finalize(SQ_STMT* st) -> void
        {
            int i, j;
            SQ_BLK* b;
            SQ_SRC* sr;
            if ((u64)st.res != (u64)0 & st.kind == 2) { sq_rs_free(st.res); st.res = (SQ_RS*)0; };
            if ((u64)st.ret != (u64)0) { sq_rs_free(st.ret); st.ret = (SQ_RS*)0; if (st.kind == 3) { st.res = (SQ_RS*)0; }; };
            if ((u64)st.retsql != (u64)0) { ffree((u64)st.retsql); st.retsql = (byte*)0; };
            sq_clear_caches(st);
            for (i = 0; i < st.nblk; i++)
            {
                b = st.blks[i];
                for (j = 0; j < b.nsrc; j++)
                {
                    sr = @b.src[j];
                    if ((u64)sr.ti != (u64)0)
                    {
                        if (sr.kind == 1) { if ((u64)sr.ti.base != (u64)0) { ffree((u64)sr.ti.base); }; };
                        ffree((u64)sr.ti);
                        sr.ti = (SQ_TI*)0;
                    };
                };
                sq_ar_free(@b.scr);
                sq_ar_free(@b.gar);
                ffree((u64)b.src);
                ffree((u64)b);
                st.blks[i] = (SQ_BLK*)0;
            };
            st.nblk = 0;
            if ((u64)st.nodes != (u64)0) { ffree((u64)st.nodes); st.nodes = (SQ_NODE*)0; };
            st.nn = 0; st.ncap = 0;
            sq_ar_free(@st.par);
            sq_ar_free(@st.ar);
        };

        // ---- parameters ----

        def sq_bind_null(SQ_STMT* st, int idx) -> int
        {
            if (idx < 1 | idx > 64) { return 1; };
            sq_val_null(@st.pv[idx - 1]);
            return 0;
        };

        def sq_bind_int(SQ_STMT* st, int idx, i64 v) -> int
        {
            if (idx < 1 | idx > 64) { return 1; };
            sq_val_int(@st.pv[idx - 1], v);
            return 0;
        };

        def sq_bind_real(SQ_STMT* st, int idx, double v) -> int
        {
            if (idx < 1 | idx > 64) { return 1; };
            sq_val_real(@st.pv[idx - 1], v);
            return 0;
        };

        def sq_bind_bytes(SQ_STMT* st, int idx, byte* p, int n, int ty) -> int
        {
            byte* c;
            if (idx < 1 | idx > 64) { return 1; };
            c = sq_ar_copy(@st.par, p, n);
            if ((u64)c == (u64)0) { return 1; };
            st.pv[idx - 1].t = ty; st.pv[idx - 1].p = c; st.pv[idx - 1].n = n; st.pv[idx - 1].i = (i64)0; st.pv[idx - 1].r = 0.0;
            return 0;
        };

        def sq_bind_text(SQ_STMT* st, int idx, byte* p, int n) -> int
        {
            return sq_bind_bytes(st, idx, p, n, SQ_TEXT);
        };

        def sq_bind_blob(SQ_STMT* st, int idx, byte* p, int n) -> int
        {
            return sq_bind_bytes(st, idx, p, n, SQ_BLOB);
        };

        // index of a named parameter (":name", "@name" or "$name" including the prefix) or 0
        def sq_param_index(SQ_STMT* st, byte* name) -> int
        {
            int k, n;
            n = sq_cstrlen(name);
            for (k = 1; k <= st.nparam; k++)
            {
                if (st.pnl[k - 1] == n)
                {
                    if (sq_mem_eq(@st.sql[st.pns[k - 1]], name, n)) { return k; };
                };
            };
            return 0;
        };

        def sq_params_reset(SQ_STMT* st) -> void
        {
            int i;
            for (i = 0; i < 64; i++) { sq_val_null(@st.pv[i]); };
            sq_ar_free(@st.par);
        };

        // ---- SELECT entry points ----

        def sq_end_stmt(SQ_STMT* st) -> int
        {
            if (sq_is_op(st, 59)) { sq_next(st); };
            if (st.tk != 0) { sq_seterr(st, "unexpected text after the end of the statement\0"); return 1; };
            return 0;
        };

        def sq_prep_query(SQ_STMT* st, SQLITE_DB* db, byte* sql) -> int
        {
            int b;
            sq_stmt_init(st, db, sql);
            sq_next(st);
            b = sq_parse_select(st, 0 - 1);
            if (b < 0) { if (st.err[0] == (byte)0) { sq_seterr(st, "syntax error\0"); }; return 1; };
            st.root_blk = b;
            if (sq_end_stmt(st) != 0) { return 1; };
            if (sq_bind_all(st) != 0) { return 1; };
            st.nres = st.blks[b].nres;
            st.kind = 1;
            return 0;
        };

        def sq_step_query(SQ_STMT* st) -> int
        {
            if (st.state == 2) { return 0; };
            if (st.kind == 3)
            {
                if (st.state == 0)
                {
                    st.res = st.ret;
                    st.ri = 0;
                    st.state = 1;
                    if ((u64)st.res == (u64)0) { st.state = 2; return 0; };
                }
                else { st.ri++; };
                if (st.ri >= st.res.n) { st.state = 2; return 0; };
                return 1;
            };
            if (st.state == 0)
            {
                st.res = sq_run_block(st, st.root_blk, 0 - 1);
                if ((u64)st.res == (u64)0) { st.state = 2; return 0 - 1; };
                st.ri = 0;
                st.state = 1;
            }
            else { st.ri++; };
            if (st.ri >= st.res.n) { st.state = 2; return 0; };
            return 1;
        };

        def sq_column_count(SQ_STMT* st) -> int
        {
            return st.nres;
        };

        def sq_column_name(SQ_STMT* st, int i, byte* out, int cap) -> int
        {
            int s, l, k;
            byte* base;
            if (i < 0 | i >= st.nres) { out[0] = (byte)0; return 0; };
            base = sq_res_name(st, st.blks[st.root_blk], i, @s, @l);
            k = 0;
            while (k < l & k < cap - 1) { out[k] = base[s + k]; k++; };
            out[k] = (byte)0;
            return k;
        };

        def sq_cell(SQ_STMT* st, int i) -> SQ_VAL*
        {
            if ((u64)st.res == (u64)0 | st.state != 1) { return (SQ_VAL*)0; };
            if (i < 0 | i >= st.nres) { return (SQ_VAL*)0; };
            return @st.res.d[st.ri * st.res.nc + i];
        };

        def sq_column_type(SQ_STMT* st, int i) -> int
        {
            SQ_VAL* v = sq_cell(st, i);
            if ((u64)v == (u64)0) { return SQ_NULL; };
            return v.t;
        };

        def sq_column_int(SQ_STMT* st, int i) -> i64
        {
            SQ_VAL* v = sq_cell(st, i);
            SQ_VAL t;
            if ((u64)v == (u64)0) { return (i64)0; };
            sq_cast((SQ_ARENA*)0, v, 3, @t);
            if (t.t == SQ_INTEGER) { return t.i; };
            return (i64)0;
        };

        def sq_column_real(SQ_STMT* st, int i) -> double
        {
            SQ_VAL* v = sq_cell(st, i);
            if ((u64)v == (u64)0) { return 0.0; };
            return sq_as_double(v);
        };

        def sq_column_bytes(SQ_STMT* st, int i) -> int
        {
            SQ_VAL* v = sq_cell(st, i);
            byte[64] buf;
            if ((u64)v == (u64)0) { return 0; };
            if (v.t == SQ_TEXT | v.t == SQ_BLOB) { return v.n; };
            if (v.t == SQ_INTEGER) { return sq_itoa(v.i, @buf[0]); };
            if (v.t == SQ_REAL) { return sq_real_text(v.r, @buf[0]); };
            return 0;
        };

        def sq_column_ptr(SQ_STMT* st, int i) -> byte*
        {
            SQ_VAL* v = sq_cell(st, i);
            SQ_VAL t;
            if ((u64)v == (u64)0) { return (byte*)0; };
            if (v.t == SQ_TEXT | v.t == SQ_BLOB) { return v.p; };
            if (v.t == SQ_INTEGER | v.t == SQ_REAL)
            {
                sq_val_text(@st.ar, v, @t);
                return t.p;
            };
            return (byte*)0;
        };

        // copies the value as text (numbers are formatted), zero terminates and returns the length
        def sq_column_text(SQ_STMT* st, int i, byte* out, int cap) -> int
        {
            SQ_VAL* v = sq_cell(st, i);
            byte[64] buf;
            byte* p;
            int n, k;
            if ((u64)v == (u64)0 | cap <= 0) { if (cap > 0) { out[0] = (byte)0; }; return 0; };
            if (v.t == SQ_TEXT | v.t == SQ_BLOB) { p = v.p; n = v.n; }
            else
            {
                if (v.t == SQ_INTEGER) { n = sq_itoa(v.i, @buf[0]); p = @buf[0]; }
                else
                {
                    if (v.t == SQ_REAL) { n = sq_real_text(v.r, @buf[0]); p = @buf[0]; }
                    else { out[0] = (byte)0; return 0; };
                };
            };
            k = 0;
            while (k < n & k < cap - 1) { out[k] = p[k]; k++; };
            out[k] = (byte)0;
            return k;
        };

    }; // sqlite
}; // standard

#endif; // IDEKA_STANDARD_SQLITE_CORE

        // ---- helpers for the write layer ----

        // a statement object on the heap (the structure is large)
        def sq_stmt_new() -> SQ_STMT*
        {
            return (SQ_STMT*)fmalloc((u64)(sizeof(SQ_STMT) / 8 + 4096));
        };

        def sq_stmt_del(SQ_STMT* st) -> void
        {
            sq_finalize(st);
            ffree((u64)st);
        };

        // Evaluates a constant expression "select <text>" and returns its first value, text owned by ar. 0 on success.
        def sq_eval_text(SQLITE_DB* db, byte* p, int n, SQ_ARENA* ar, SQ_VAL* out) -> int
        {
            SQ_STMT* st;
            byte* buf;
            int rc, i;
            sq_val_null(out);
            buf = (byte*)fmalloc((u64)(n + 16));
            if ((u64)buf == (u64)0) { return 1; };
            sq_mcpy(buf, "select \0", 7);
            for (i = 0; i < n; i++) { buf[7 + i] = p[i]; };
            buf[7 + n] = (byte)0;
            st = sq_stmt_new();
            if ((u64)st == (u64)0) { ffree((u64)buf); return 1; };
            rc = sq_prep_query(st, db, buf);
            ffree((u64)buf);
            if (rc != 0) { sq_stmt_del(st); return 1; };
            if (sq_step_query(st) == 1)
            {
                sq_val_copy(out, sq_cell(st, 0));
                sq_val_own(ar, out);
            }
            else { rc = 1; };
            sq_stmt_del(st);
            return rc;
        };
