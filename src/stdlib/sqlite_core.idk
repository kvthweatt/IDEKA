                Y = d2.Y - d1.Y;
                if (Y != 0) { d1.Y = d2.Y; sq_dt_rejd(@d1); };
                M = d2.M - d1.M;
                if (M < 0) { Y--; M = M + 12; };
                if (M != 0) { d1.M = d2.M; sq_dt_rejd(@d1); };
                while (d1.jd > d2.jd)
                {
                    M--;
                    if (M < 0) { M = 11; Y--; };
                    d1.M--;
                    if (d1.M < 1) { d1.M = 12; d1.Y--; };
                    sq_dt_rejd(@d1);
