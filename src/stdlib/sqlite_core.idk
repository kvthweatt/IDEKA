                    {
                        if (ordk == 0) { r[o] = (byte)116; o++; r[o] = (byte)104; o++; }
                        else { if (ordk == 1) { r[o] = (byte)115; o++; r[o] = (byte)116; o++; }
                        else { if (ordk == 2) { r[o] = (byte)110; o++; r[o] = (byte)100; o++; }
                        else { r[o] = (byte)114; o++; r[o] = (byte)100; o++; }; }; };
                    };
                    if (pad > 0 & flagleft == 1) { while (pad > 0) { r[o] = (byte)32; o++; pad--; }; };
                    appended = 1;
                    continue;
                };
                if (c == 102 | c == 101 | c == 69 | c == 103 | c == 71)
                {
                    dv = 0.0;
                    if (ai < argc) { dv = sq_as_double(@args[ai]); };
                    ai++;
                    k = 1;
                    if (c == 101 | c == 69) { k = 2; };
                    if (c == 103 | c == 71) { k = 3; };
                    ln = sq_fmt_fp(@num[0], dv, k, (c == 69 | c == 71), prec, flagpre, flagalt, flagalt2, zeropad, thousand, @sg);
