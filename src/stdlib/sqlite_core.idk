            if (id == 73)
            {
                if (a[1].t != SQ_REAL) { sq_seterr(st, "second argument to likelihood() must be a constant between 0.0 and 1.0\0"); sq_val_null(out); return; };
                dw = a[1].r;
                if (dw < 0.0 | dw > 1.0) { sq_seterr(st, "second argument to likelihood() must be a constant between 0.0 and 1.0\0"); sq_val_null(out); return; };
                sq_val_copy(out, @a[0]);
                return;
            };
            // math
            if ((id >= 44 & id <= 58) | (id >= 61 & id <= 71) | id == 74)
            {
                if (id == 53) { sq_val_real(out, 3.141592653589793); return; };
                for (i = 0; i < argc; i++) { if (a[i].t == SQ_NULL) { sq_val_null(out); return; }; };
                if (sq_numtype(@a[0], @n0) == 0) { sq_val_null(out); return; };
                if (argc >= 2) { if (sq_numtype(@a[1], @n1) == 0) { sq_val_null(out); return; }; };
                if (id == 44 | id == 45 | id == 71)
                {
                    x = n0;
                    if (x.t == SQ_INTEGER) { sq_val_copy(out, @x); return; };
                    dv = x.r;
                    if (dv > 9.0e18 | dv < 0.0 - 9.0e18) { sq_val_real(out, dv); return; };
                    dw = (double)((i64)dv);
                    if (id == 45) { if (dw > dv) { dw = dw - 1.0; }; };
                    if (id == 44) { if (dw < dv) { dw = dw + 1.0; }; };
                    sq_val_real(out, dw);
                    return;
                };
                if (n0.t == SQ_INTEGER) { dv = (double)n0.i; } else { dv = n0.r; };
                dw = 0.0;
                if (argc >= 2) { if (n1.t == SQ_INTEGER) { dw = (double)n1.i; } else { dw = n1.r; }; };
                if (id == 46) { if (dv < 0.0) { sq_val_null(out); return; }; sq_val_real(out, standard::math::sqrt(dv)); return; };
                if (id == 47) { bad = 0; dz = sq_dd_pow(dv, dw, @bad); if (bad != 0) { sq_val_null(out); return; }; sq_val_real(out, dz); return; };
                if (id == 48)
                {
                    if (dw == 0.0) { sq_val_null(out); return; };
                    sq_val_real(out, standard::math::fmod(dv, dw));
                    return;
                };
                if (id == 49) { sq_val_real(out, sq_dd_expd(dv)); return; };
                if (id == 50) { if (dv <= 0.0) { sq_val_null(out); return; }; sq_val_real(out, sq_dd_ln(dv)); return; };
                if (id == 51 | id == 74)
                {
                    if (argc == 2)
                    {
                        if (dv <= 0.0 | dw <= 0.0) { sq_val_null(out); return; };
                        sq_val_real(out, sq_dd_ln(dw) / sq_dd_ln(dv));
                        return;
                    };
                    if (dv <= 0.0) { sq_val_null(out); return; };
                    sq_val_real(out, sq_dd_log10(dv));
                    return;
                };
                if (id == 52) { if (dv <= 0.0) { sq_val_null(out); return; }; sq_val_real(out, sq_dd_log2(dv)); return; };
                if (id == 54) { if (sq_dd_trig(dv, 1, @dz) != 0) { sq_val_real(out, dz); } else { sq_val_real(out, standard::math::sin(dv)); }; return; };
                if (id == 55) { if (sq_dd_trig(dv, 2, @dz) != 0) { sq_val_real(out, dz); } else { sq_val_real(out, standard::math::cos(dv)); }; return; };
                if (id == 56) { if (sq_dd_trig(dv, 3, @dz) != 0) { sq_val_real(out, dz); } else { sq_val_real(out, standard::math::tan(dv)); }; return; };
                if (id == 57) { sq_dd_atan2(dv, 1.0, @dz); sq_val_real(out, dz); return; };
                if (id == 61 | id == 62)
                {
                    if (dv > 1.0 | dv < 0.0 - 1.0) { sq_val_null(out); return; };
                    sq_val_real(out, sq_dd_asin(dv, id - 60));
                    return;
                };
                if (id == 63 | id == 64 | id == 65) { sq_val_real(out, sq_dd_hyp(dv, id - 62)); return; };
                if (id == 66) { sq_val_real(out, sq_dd_ahyp(dv, 1)); return; };
                if (id == 67)
                {
                    if (dv < 1.0) { sq_val_null(out); return; };
                    sq_val_real(out, sq_dd_ahyp(dv, 2));
                    return;
                };
                if (id == 68)
                {
                    if (dv > 1.0 | dv < 0.0 - 1.0) { sq_val_null(out); return; };
                    if (dv == 1.0) { dz = 1.0e308; sq_val_real(out, dz * 10.0); return; };
                    if (dv == 0.0 - 1.0) { dz = 1.0e308; sq_val_real(out, 0.0 - dz * 10.0); return; };
                    sq_val_real(out, sq_dd_ahyp(dv, 3));
                    return;
                };
                if (id == 69) { sq_val_real(out, dv * (180.0 / 3.141592653589793)); return; };
                if (id == 70) { sq_val_real(out, dv * (3.141592653589793 / 180.0)); return; };

                sq_dd_atan2(dv, dw, @dz);
                sq_val_real(out, dz);
                return;
            };
            sq_val_null(out);
        };

        // ---- rowsets ----

        def sq_rs_new(int nc, int vis) -> SQ_RS*
        {
            SQ_RS* rs = (SQ_RS*)fmalloc((u64)sizeof(SQ_RS));
            if ((u64)rs == (u64)0) { return rs; };
            rs.nc = nc; rs.vis = vis; rs.n = 0; rs.cap = 0; rs.d = (SQ_VAL*)0;
            rs.spon = 0; rs.base = 0; rs.wn = 0; rs.spsealed = 0; rs.spf = (void*)0; rs.sppath = (byte*)0; rs.spbytes = (i64)0;
            sq_ar_init(@rs.ar);
            return rs;
        };

        def sq_rs_free(SQ_RS* rs) -> void
        {
            if ((u64)rs == (u64)0) { return; };
            if ((u64)rs.d != (u64)0) { ffree((u64)rs.d); };
            sq_ar_free(@rs.ar);
            if ((u64)rs.spf != (u64)0) { fclose(rs.spf); };
            if ((u64)rs.sppath != (u64)0) { remove(rs.sppath); ffree((u64)rs.sppath); };
            ffree((u64)rs);
        };

        // makes room for one more row and returns a pointer to it (columns uninitialised)
        def sq_rs_row(SQ_RS* rs) -> SQ_VAL*
        {
            SQ_VAL* nd;
            int cap;
            if (rs.n - rs.base >= rs.cap)
            {
                cap = rs.cap * 2;
                if (cap < 16) { cap = 16; };
                nd = (SQ_VAL*)fmalloc((u64)cap * (u64)rs.nc * (u64)sizeof(SQ_VAL));
                if ((u64)nd == (u64)0) { return nd; };
                if (rs.n - rs.base > 0) { sq_mcpy((byte*)nd, (byte*)rs.d, (rs.n - rs.base) * rs.nc * sq_vsz()); };
                if ((u64)rs.d != (u64)0) { ffree((u64)rs.d); };
                rs.d = nd;
                rs.cap = cap;
            };
            rs.n++;
            return @rs.d[(rs.n - 1 - rs.base) * rs.nc];
        };

        // writes the rows held in memory to the temporary file and empties the window
        global int SQ_SPILLN = 0;
        global byte[330] SQ_SPILLP;

        def sq_rs_flush(SQ_RS* rs) -> bool
        {
            int i, j, cnt, n, k, m;
            byte[16] dg;
            SQ_VAL* v;
            if ((u64)rs.spf == (u64)0)
            {
                SQ_SPILLN++;
                n = sq_cstrlen(@SQ_SPILLP[0]);
                rs.sppath = (byte*)fmalloc((u64)(n + 24));
                if ((u64)rs.sppath == (u64)0) { rs.spon = 0; return true; };
                for (i = 0; i < n; i++) { rs.sppath[i] = SQ_SPILLP[i]; };
                rs.sppath[n] = (byte)45;
                k = SQ_SPILLN;
                m = 0;
                while (k > 0) { dg[m] = (byte)(48 + k % 10); k = k / 10; m++; };
                for (i = 0; i < m; i++) { rs.sppath[n + 1 + i] = dg[m - 1 - i]; };
                rs.sppath[n + 1 + m] = (byte)0;
                rs.spf = fopen(rs.sppath, "w+b\0");
                if ((u64)rs.spf == (u64)0) { ffree((u64)rs.sppath); rs.sppath = (byte*)0; rs.spon = 0; return true; };
            };
            fseek(rs.spf, 0, 2);
            cnt = rs.n - rs.base;
            for (i = 0; i < cnt; i++)
            {
                for (j = 0; j < rs.nc; j++)
                {
                    v = @rs.d[i * rs.nc + j];
                    if (fwrite((byte*)v, 1, sq_vsz(), rs.spf) != sq_vsz()) { return false; };
                    if ((v.t == SQ_TEXT | v.t == SQ_BLOB) & v.n > 0)
                    {
                        if (fwrite(v.p, 1, v.n, rs.spf) != v.n) { return false; };
                    };
                };
            };
            rs.base = rs.n;
            rs.spbytes = (i64)0;
            sq_ar_free(@rs.ar);
            sq_ar_init(@rs.ar);
            return true;
        };

        // after the last row was added: the rest of the rows go to the file too and reading starts at the first row
        def sq_rs_seal(SQ_RS* rs) -> bool
        {
            if ((u64)rs.spf == (u64)0) { return true; };
            if (rs.n > rs.base) { if (sq_rs_flush(rs) == false) { return false; }; };
            if ((u64)rs.d != (u64)0) { ffree((u64)rs.d); rs.d = (SQ_VAL*)0; };
            rs.cap = 0;
            rs.base = 0;
            rs.wn = 0;
            rs.spsealed = 1;
            fflush(rs.spf);
            fseek(rs.spf, 0, 0);
            return true;
        };

        // reads the next window of rows back from the file
        def sq_rs_load(SQ_RS* rs) -> bool
        {
            int i, j, want;
            SQ_VAL* v;
            byte* p;
            rs.base = rs.base + rs.wn;
            rs.wn = 0;
            want = rs.n - rs.base;
            if (want > 2048) { want = 2048; };
            sq_ar_free(@rs.ar);
            sq_ar_init(@rs.ar);
            if ((u64)rs.d == (u64)0)
            {
                rs.d = (SQ_VAL*)fmalloc((u64)2048 * (u64)rs.nc * (u64)sizeof(SQ_VAL));
                if ((u64)rs.d == (u64)0) { return false; };
            };
            for (i = 0; i < want; i++)
            {
                for (j = 0; j < rs.nc; j++)
                {
                    v = @rs.d[i * rs.nc + j];
                    if (fread((byte*)v, 1, sq_vsz(), rs.spf) != sq_vsz()) { return false; };
                    if ((v.t == SQ_TEXT | v.t == SQ_BLOB) & v.n > 0)
                    {
                        p = sq_ar_alloc(@rs.ar, v.n + 1);
                        if ((u64)p == (u64)0) { return false; };
                        if (fread(p, 1, v.n, rs.spf) != v.n) { return false; };
                        v.p = p;
                    }
                    else { v.p = (byte*)0; };
                };
            };
            rs.wn = want;
            return true;
        };

        // row i of a result set that may live in a file; rows are read in order
        def sq_rs_at(SQ_RS* rs, int i) -> SQ_VAL*
        {
            if ((u64)rs.spf == (u64)0) { return @rs.d[i * rs.nc]; };
            if (i < rs.base)
            {
                rs.base = 0; rs.wn = 0;
                fseek(rs.spf, 0, 0);
            };
            while (i >= rs.base + rs.wn)
            {
                if (sq_rs_load(rs) == false) { return (SQ_VAL*)0; };
            };
            return @rs.d[(i - rs.base) * rs.nc];
        };

        // appends a row copying the strings into the rowset arena
        def sq_rs_add(SQ_RS* rs, SQ_VAL* vals) -> bool
        {
            SQ_VAL* row = sq_rs_row(rs);
            int i;
            if ((u64)row == (u64)0) { return false; };
            for (i = 0; i < rs.nc; i++)
            {
                sq_val_copy(@row[i], @vals[i]);
                sq_val_own(@rs.ar, @row[i]);
                if (row[i].t == SQ_TEXT | row[i].t == SQ_BLOB) { rs.spbytes = rs.spbytes + (i64)row[i].n; };
            };
            rs.spbytes = rs.spbytes + (i64)(rs.nc * 32);
            if (rs.spon == 1 & rs.spbytes > (i64)33554432) { if (sq_rs_flush(rs) == false) { return false; }; };
            return true;
        };

        // ---- sets of value tuples ----

        def sq_set_init(SQ_SET* s, int nk) -> void
        {
            int i;
            s.nk = nk; s.n = 0; s.cap = 0; s.bsize = 0;
            s.keys = (SQ_VAL*)0; s.bucket = (int*)0; s.nxt = (int*)0; s.hs = (int*)0;
            s.isnew = 0;
            for (i = 0; i < 16; i++) { s.coll[i] = 0; };
            sq_ar_init(@s.ar);
        };

        def sq_set_free(SQ_SET* s) -> void
        {
            if ((u64)s.keys != (u64)0) { ffree((u64)s.keys); };
            if ((u64)s.bucket != (u64)0) { ffree((u64)s.bucket); };
            if ((u64)s.nxt != (u64)0) { ffree((u64)s.nxt); };
            if ((u64)s.hs != (u64)0) { ffree((u64)s.hs); };
            s.keys = (SQ_VAL*)0; s.bucket = (int*)0; s.nxt = (int*)0; s.hs = (int*)0;
            sq_ar_free(@s.ar);
            s.n = 0; s.cap = 0;
        };

        def sq_val_hash(SQ_VAL* v, int coll) -> int
        {
            u64 h = (u64)1469598103934665603;
            int i, n;
            double d;
            u64* bp;
            if (v.t == SQ_NULL) { return 7; };
            if (v.t == SQ_INTEGER | v.t == SQ_REAL)
            {
                d = sq_as_double(v);
                if (d == 0.0) { d = 0.0; };
                bp = (u64*)@d;
                h = (*bp) * (u64)11400714819323198485;
                return (int)((h >> 33) `& (u64)2147483647);
            };
            n = v.n;
            if (coll == SQC_RTRIM & v.t == SQ_TEXT)
            {
                while (n > 0) { if (v.p[n - 1] == (byte)32) { n--; } else { break; }; };
            };
            for (i = 0; i < n; i++)
            {
                if (coll == SQC_NOCASE & v.t == SQ_TEXT) { h = (h `^| (u64)sq_lc(v.p[i])) * (u64)1099511628211; }
                else { h = (h `^| (u64)v.p[i]) * (u64)1099511628211; };
            };
            if (v.t == SQ_BLOB) { h = h + (u64)3; };
            return (int)((h >> 33) `& (u64)2147483647);
        };

        def sq_set_hash(SQ_SET* s, SQ_VAL* vals) -> int
        {
            int i;
            u64 h = (u64)17;
            for (i = 0; i < s.nk; i++) { h = h * (u64)31 + (u64)sq_val_hash(@vals[i], s.coll[i]); };
            return (int)(h `& (u64)2147483647);
        };

        def sq_set_eq(SQ_SET* s, int idx, SQ_VAL* vals) -> bool
        {
            int i;
            for (i = 0; i < s.nk; i++)
            {
                if (sq_val_cmpc(@s.keys[idx * s.nk + i], @vals[i], s.coll[i]) != 0) { return false; };
            };
            return true;
        };

        // index of the tuple or -1
        def sq_set_find(SQ_SET* s, SQ_VAL* vals) -> int
        {
            int h, k;
            if (s.bsize == 0) { return 0 - 1; };
            h = sq_set_hash(s, vals);
            k = s.bucket[h % s.bsize];
            while (k >= 0)
            {
                if (s.hs[k] == h) { if (sq_set_eq(s, k, vals)) { return k; }; };
                k = s.nxt[k];
            };
            return 0 - 1;
        };

        // index of the tuple, inserting it when new (isnew tells which); -1 on memory failure
        def sq_set_add(SQ_SET* s, SQ_VAL* vals) -> int
        {
            int h, k, i, ncap, nb;
            SQ_VAL* nk;
            int* nn;
            int* nh;
            int* bk;
            k = sq_set_find(s, vals);
            s.isnew = 0;
            if (k >= 0) { return k; };
            h = sq_set_hash(s, vals);
            if (s.n >= s.cap)
            {
                ncap = s.cap * 2;
                if (ncap < 64) { ncap = 64; };
                nk = (SQ_VAL*)fmalloc((u64)ncap * (u64)(s.nk + 1) * (u64)sizeof(SQ_VAL));
                nn = (int*)fmalloc((u64)ncap * (u64)4);
                nh = (int*)fmalloc((u64)ncap * (u64)4);
                nb = ncap * 2;
                bk = (int*)fmalloc((u64)nb * (u64)4);
                if ((u64)nk == (u64)0 | (u64)nn == (u64)0 | (u64)nh == (u64)0 | (u64)bk == (u64)0) { return 0 - 1; };
                if (s.n > 0)
                {
                    sq_mcpy((byte*)nk, (byte*)s.keys, s.n * s.nk * sq_vsz());
                    sq_mcpy((byte*)nh, (byte*)s.hs, s.n * 4);
                };
                if ((u64)s.keys != (u64)0) { ffree((u64)s.keys); };
                if ((u64)s.nxt != (u64)0) { ffree((u64)s.nxt); };
                if ((u64)s.hs != (u64)0) { ffree((u64)s.hs); };
                if ((u64)s.bucket != (u64)0) { ffree((u64)s.bucket); };
                s.keys = nk; s.nxt = nn; s.hs = nh; s.bucket = bk; s.cap = ncap; s.bsize = nb;
                for (i = 0; i < nb; i++) { bk[i] = 0 - 1; };
                for (i = 0; i < s.n; i++)
                {
                    nn[i] = bk[nh[i] % nb];
                    bk[nh[i] % nb] = i;
                };
            };
            k = s.n;
            s.n++;
            for (i = 0; i < s.nk; i++)
            {
                sq_val_copy(@s.keys[k * s.nk + i], @vals[i]);
                sq_val_own(@s.ar, @s.keys[k * s.nk + i]);
            };
            s.hs[k] = h;
            s.nxt[k] = s.bucket[h % s.bsize];
            s.bucket[h % s.bsize] = k;
            s.isnew = 1;
            return k;
        };

        // ---- sorting ----

        struct SQ_SORT
        {
            SQ_RS* rs;
            int nt;
            int[16] col, desc, coll, nul;
        };

        def sq_sort_cmp(SQ_SORT* so, int ia, int ib) -> int
        {
            int t, c, na, nb2;
            SQ_VAL* a;
            SQ_VAL* b;
            for (t = 0; t < so.nt; t++)
            {
                a = @so.rs.d[ia * so.rs.nc + so.col[t]];
                b = @so.rs.d[ib * so.rs.nc + so.col[t]];
                na = 0;
                nb2 = 0;
                if (a.t == SQ_NULL) { na = 1; };
                if (b.t == SQ_NULL) { nb2 = 1; };
                if (na == 1 | nb2 == 1)
                {
                    if (na == 1 & nb2 == 1) { continue; };
                    // a null sorts before everything unless NULLS LAST was asked for, and descending reverses the default
                    c = 0 - 1;
                    if (nb2 == 1) { c = 1; };
                    if (so.nul[t] == 1) { return c; };
                    if (so.nul[t] == 2) { return 0 - c; };
                    if (so.desc[t] == 1) { return 0 - c; };
                    return c;
                };
                c = sq_val_cmpc(a, b, so.coll[t]);
                if (c != 0)
                {
                    if (so.desc[t] == 1) { return 0 - c; };
                    return c;
                };
            };
            return 0;
        };

        // stable merge sort of the rows; rebuilds the data array in order
        def sq_sort_rs(SQ_SORT* so) -> int
        {
            SQ_RS* rs = so.rs;
            int* perm;
            int* tmp;
            int n = rs.n;
            int width, i, lo, mid, hi, a, b, k;
            SQ_VAL* nd;
            if (n < 2) { return 0; };
            perm = (int*)fmalloc((u64)n * (u64)4);
            tmp = (int*)fmalloc((u64)n * (u64)4);
            if ((u64)perm == (u64)0 | (u64)tmp == (u64)0) { return 1; };
            for (i = 0; i < n; i++) { perm[i] = i; };
            width = 1;
            while (width < n)
            {
                lo = 0;
                while (lo < n)
                {
                    mid = lo + width;
                    if (mid > n) { mid = n; };
                    hi = lo + 2 * width;
                    if (hi > n) { hi = n; };
                    a = lo; b = mid; k = lo;
                    while (a < mid & b < hi)
                    {
                        if (sq_sort_cmp(so, perm[b], perm[a]) < 0) { tmp[k] = perm[b]; b++; } else { tmp[k] = perm[a]; a++; };
                        k++;
                    };
                    while (a < mid) { tmp[k] = perm[a]; a++; k++; };
                    while (b < hi) { tmp[k] = perm[b]; b++; k++; };
                    lo = hi;
                };
                for (i = 0; i < n; i++) { perm[i] = tmp[i]; };
                width = width * 2;
            };
            nd = (SQ_VAL*)fmalloc((u64)n * (u64)rs.nc * (u64)sizeof(SQ_VAL));
            if ((u64)nd == (u64)0) { ffree((u64)perm); ffree((u64)tmp); return 1; };
            for (i = 0; i < n; i++)
            {
                sq_mcpy((byte*)@nd[i * rs.nc], (byte*)@rs.d[perm[i] * rs.nc], rs.nc * sq_vsz());
            };
            ffree((u64)rs.d);
            rs.d = nd;
            rs.cap = n;
            ffree((u64)perm);
            ffree((u64)tmp);
            return 0;
        };

        // ---- indexes: description, record decoding, read cursor ----

        // key columns of an index; col == ncols of the table means the rowid
        struct SQ_IDX
        {
            int root, nk, unique, ispk, ok, schema_pos, tbl_pos, partial, ne, wok, ws, wl, ntl, ncmp, nrc, slot, uqnn;
            int[16] tlc;
            int[16] isx, xs, xl;
            u64 est;
            int[16] col, desc, coll;
            byte[64] name;
        };

        // payload size kept on the cell page of an index b-tree page
        def sq_ilocal(SQLITE_DB* db, int total) -> int
        {
            int U, X, M, K;
            U = db.usable;
            X = ((U - 12) * 64 / 255) - 23;
            if (total <= X) { return total; };
            M = ((U - 12) * 32 / 255) - 23;
            K = M + ((total - M) % (U - 4));
            if (K <= X) { return K; };
            return M;
        };

        // Decodes a record into values that point into the payload. Returns the number of values.
        def sq_rec_decode_sc(byte* pay, int plen, SQ_VAL* out, int maxv, byte* sc) -> int
        {
            u64 hsz, st;
            int n, pos, hend, off, col, ln, k, so;
            so = 0;
            u64 u;
            double dv;
            u64* bp;
            n = sq_varint(pay, @hsz);
            hend = (int)hsz;
            if (hend > plen) { return 0 - 1; };
            pos = n;
            off = hend;
            col = 0;
            while (pos < hend & col < maxv)
            {
                n = sq_varint(@pay[pos], @st);
                pos = pos + n;
                if (st == (u64)0) { sq_val_null(@out[col]); }
                else
                {
                    if (st == (u64)8) { sq_val_int(@out[col], (i64)0); }
                    else
                    {
                        if (st == (u64)9) { sq_val_int(@out[col], (i64)1); }
                        else
                        {
                            if (st <= (u64)6 | st == (u64)7)
                            {
                                ln = 0;
                                if (st == (u64)1) { ln = 1; };
                                if (st == (u64)2) { ln = 2; };
                                if (st == (u64)3) { ln = 3; };
                                if (st == (u64)4) { ln = 4; };
                                if (st == (u64)5) { ln = 6; };
                                if (st == (u64)6 | st == (u64)7) { ln = 8; };
                                if (off + ln > plen) { return 0 - 1; };
                                u = (u64)0;
                                for (k = 0; k < ln; k++) { u = (u << 8) | (u64)pay[off + k]; };
                                if (st == (u64)7)
                                {
                                    bp = (u64*)@dv;
                                    *bp = u;
                                    sq_val_real(@out[col], dv);
                                }
                                else
                                {
                                    if (ln < 8 & ((u >> (u64)(8 * ln - 1)) `& (u64)1) == (u64)1) { u = u | ((u64)0 - ((u64)1 << (u64)(8 * ln))); };
                                    sq_val_int(@out[col], (i64)u);
                                };
                                off = off + ln;
                            }
                            else
                            {
                                ln = ((int)st - 12) / 2;
                                if ((st `& (u64)1) == (u64)1) { ln = ((int)st - 13) / 2; };
                                if (off + ln > plen) { return 0 - 1; };
                                out[col].n = ln;
                                out[col].p = @pay[off];
                                out[col].i = (i64)0;
                                out[col].r = 0.0;
                                if ((st `& (u64)1) == (u64)1) { out[col].t = SQ_TEXT; } else { out[col].t = SQ_BLOB; };
                                if (out[col].t == SQ_TEXT & SQ_ENC != 1 & (u64)sc != (u64)0)
                                {
                                    out[col].n = sq_u16_to_u8(@pay[off], ln, @sc[so]);
                                    out[col].p = @sc[so];
                                    so = so + out[col].n + 1;
                                };
                                off = off + ln;
                            };
                        };
                    };
                };
                col++;
            };
            return col;
        };

        def sq_rec_decode(byte* pay, int plen, SQ_VAL* out, int maxv) -> int
        {
            return sq_rec_decode_sc(pay, plen, out, maxv, (byte*)0);
        };

        // scratch buffers for the converted text of decoded records (only used with a UTF-16 database)
        global byte*[4] SQ_DSC;
        global int[4] SQ_DSCN;

        def sq_dscr(int which, int need) -> byte*
        {
            byte* nb;
            if (SQ_ENC == 1) { return (byte*)0; };
            if (need > SQ_DSCN[which])
            {
                nb = (byte*)fmalloc((u64)(need + 4096));
                if ((u64)nb == (u64)0) { return (byte*)0; };
                if ((u64)SQ_DSC[which] != (u64)0) { ffree((u64)SQ_DSC[which]); };
                SQ_DSC[which] = nb;
                SQ_DSCN[which] = need + 4096;
            };
            return SQ_DSC[which];
        };

        def sq_rec_decode_w(byte* pay, int plen, SQ_VAL* out, int maxv, int which) -> int
        {
            return sq_rec_decode_sc(pay, plen, out, maxv, sq_dscr(which, plen * 2 + 16));
        };

        // True when text a (la bytes) equals text b ignoring case.
        def sq_ieq2(byte* a, int la, byte* b, int lb) -> bool
        {
            int i;
            if (la != lb) { return false; };
            for (i = 0; i < la; i++) { if (sq_lc(a[i]) != sq_lc(b[i])) { return false; }; };
            return true;
        };

        // Parses "CREATE [UNIQUE] INDEX name ON tbl (col [COLLATE c] [ASC|DESC], ...)" into ix. ok is 0 when the index
        // uses expressions or a WHERE clause (such indexes cannot be maintained here).
        def sq_idx_parse(SQ_TI* ti, byte* s, SQ_IDX* ix) -> int
        {
            int i, j, end, ts, tl, kd, a, b, c, n, pend;
            int gs, gl, e2, itend, cs2, cl2, k, col, dsc, cl, depth, simple, nt;
            int[64] tpos, tend, tkd;
            byte q;
            ix.ok = 1;
            ix.wok = 1; ix.ne = 0; ix.ws = 0; ix.wl = 0; ix.est = (u64)0; ix.partial = 0;
            ix.nk = 0;
            ix.unique = 0;
            end = 0;
            while (s[end] != (byte)0) { end++; };
            i = sq_tok2(s, 0, end, @ts, @tl, @kd);
            i = sq_tok2(s, i, end, @ts, @tl, @kd);
            if (sq_ieq(@s[ts], tl, "unique\0")) { ix.unique = 1; i = sq_tok2(s, i, end, @ts, @tl, @kd); };
            if (sq_ieq(@s[ts], tl, "index\0") == false) { ix.ok = 0; ix.wok = 0; return 1; };
            i = sq_tok2(s, i, end, @ts, @tl, @kd);
            if (sq_ieq(@s[ts], tl, "if\0"))
            {
                i = sq_tok2(s, i, end, @ts, @tl, @kd);
                i = sq_tok2(s, i, end, @ts, @tl, @kd);
                i = sq_tok2(s, i, end, @ts, @tl, @kd);
            };
            // schema-qualified names are not produced by this library
            i = sq_tok2(s, i, end, @ts, @tl, @kd);
            if (sq_ieq(@s[ts], tl, "on\0") == false) { ix.ok = 0; ix.wok = 0; return 1; };
            i = sq_tok2(s, i, end, @ts, @tl, @kd);
            i = sq_tok2(s, i, end, @gs, @gl, @kd);
            if (kd != 4) { ix.ok = 0; ix.wok = 0; return 1; };
            // items
            j = gs + 1;
            pend = gs + gl - 1;
            while (j < pend)
            {
                itend = j;
                depth = 0;
                while (itend < pend)
                {
                    if (s[itend] == (byte)40) { depth++; };
                    if (s[itend] == (byte)41) { depth--; };
                    if (s[itend] == (byte)39 | s[itend] == (byte)34 | s[itend] == (byte)96)
                    {
                        q = s[itend];
                        itend++;
                        while (itend < pend & s[itend] != q) { itend++; };
                    };
                    if (s[itend] == (byte)44 & depth == 0) { break; };
                    itend++;
                };
                if (ix.nk >= 16) { ix.ok = 0; ix.wok = 0; return 0; };
                k = sq_tok2(s, j, itend, @ts, @tl, @kd);
                col = 0 - 1;
                if (kd == 1) { col = sq_ti_find(ti, s, ts, tl); };
                if (kd == 2) { col = sq_ti_find(ti, s, ts + 1, tl - 2); };
                if (col < 0)
                {
                    // rowid by name is a plain key column too
                    if (kd == 1) { if (sq_is_rowid_name(@s[ts], tl)) { col = ti.ncols; }; };
                };
                simple = 1;
                if (col < 0) { simple = 0; };
                ix.desc[ix.nk] = 0;
                ix.coll[ix.nk] = 0;
                ix.isx[ix.nk] = 0;
                if (simple == 1)
                {
                    ix.col[ix.nk] = col;
                    if (col < ti.ncols) { ix.coll[ix.nk] = ti.coll[col]; };
                    while (true)
                    {
                        k = sq_tok2(s, k, itend, @ts, @tl, @kd);
                        if (kd == 0) { break; };
                        if (kd != 1) { simple = 0; break; };
                        if (sq_ieq(@s[ts], tl, "desc\0")) { ix.desc[ix.nk] = 1; continue; };
                        if (sq_ieq(@s[ts], tl, "asc\0")) { continue; };
                        if (sq_ieq(@s[ts], tl, "collate\0"))
                        {
                            k = sq_tok2(s, k, itend, @ts, @tl, @kd);
                            c = sq_coll_id(@s[ts], tl);
                            if (c < 0) { simple = 0; break; };
                            ix.coll[ix.nk] = c;
                            continue;
                        };
                        simple = 0;
                        break;
                    };
                };
                if (simple == 0)
                {
                    // an expression: strip a trailing ASC / DESC and COLLATE name
                    ix.ok = 0;
                    ix.desc[ix.nk] = 0;
                    ix.coll[ix.nk] = 0;
                    nt = 0;
                    k = j;
                    while (nt < 63)
                    {
                        k = sq_tok2(s, k, itend, @ts, @tl, @kd);
                        if (kd == 0) { break; };
                        tpos[nt] = ts;
                        tend[nt] = ts + tl;
                        tkd[nt] = kd;
                        nt++;
                    };
                    if (nt == 0) { ix.wok = 0; return 0; };
                    if (sq_ieq(@s[tpos[nt - 1]], tend[nt - 1] - tpos[nt - 1], "desc\0") & tkd[nt - 1] == 1) { ix.desc[ix.nk] = 1; nt--; }
                    else { if (sq_ieq(@s[tpos[nt - 1]], tend[nt - 1] - tpos[nt - 1], "asc\0") & tkd[nt - 1] == 1) { nt--; }; };
                    if (nt >= 2)
                    {
                        if (sq_ieq(@s[tpos[nt - 2]], tend[nt - 2] - tpos[nt - 2], "collate\0") & tkd[nt - 2] == 1)
                        {
                            c = sq_coll_id(@s[tpos[nt - 1]], tend[nt - 1] - tpos[nt - 1]);
                            if (c < 0) { ix.wok = 0; return 0; };
                            ix.coll[ix.nk] = c;
                            nt = nt - 2;
                        };
                    };
                    if (nt == 0) { ix.wok = 0; return 0; };
                    ix.col[ix.nk] = 0 - 2;
                    ix.isx[ix.nk] = 1;
                    ix.xs[ix.nk] = tpos[0];
                    ix.xl[ix.nk] = tend[nt - 1] - tpos[0];
                    ix.ne++;
                };
                ix.nk++;
                j = itend + 1;
            };
            // a WHERE clause makes the index partial
            k = sq_tok2(s, gs + gl, end, @ts, @tl, @kd);
            if (kd != 0)
            {
                ix.ok = 0;
                if (kd == 1 & sq_ieq(@s[ts], tl, "where\0"))
                {
                    ix.ws = k;
                    ix.wl = end - k;
                    while (ix.wl > 0 & (s[ix.ws + ix.wl - 1] == (byte)32 | s[ix.ws + ix.wl - 1] == (byte)59 | s[ix.ws + ix.wl - 1] == (byte)10 | s[ix.ws + ix.wl - 1] == (byte)13 | s[ix.ws + ix.wl - 1] == (byte)9)) { ix.wl--; };
                    ix.partial = 1;
                }
                else { ix.wok = 0; };
            };
            return 0;
        };

        // Finds the table's indexes in the schema. Returns the count.
        // Entries of an index end in the rowid; in a WITHOUT ROWID table they end in the key columns of the table that the
        // index does not already hold. Sets ntl, tlc (column or -1 for the rowid), ncmp and nrc, and the collation and
        // direction of the added fields.
        def sq_idx_tail(SQ_TI* ti, SQ_IDX* ix) -> void
        {
            int g, j, dup, k;
            if (ti.wor == 0)
            {
                ix.ntl = 1; ix.tlc[0] = 0 - 1;
                ix.ncmp = ix.nk + 1; ix.nrc = ix.nk + 1;
                ix.coll[ix.nk] = 0; ix.desc[ix.nk] = 0;
                return;
            };
            ix.ntl = 0;
            for (g = 0; g < ti.npk; g++)
            {
                dup = 0;
                for (j = 0; j < ix.nk; j++)
                {
                    if (ix.isx[j] == 0 & ix.col[j] == ti.pkc[g] & ix.coll[j] == ti.pkcl[g]) { dup = 1; };
                };
                if (dup == 1) { continue; };
                k = ix.nk + ix.ntl;
                if (k >= 16) { break; };
                ix.tlc[ix.ntl] = ti.pkc[g];
                ix.coll[k] = ti.pkcl[g];
                ix.desc[k] = ti.pkd[g];
                ix.ntl++;
            };
            ix.ncmp = ix.nk + ix.ntl;
            ix.nrc = ix.nk + ix.ntl;
        };

        def sq_idx_list(SQLITE_DB* db, int tblpos, SQ_TI* ti, SQ_IDX* out, int maxn) -> int
        {
            int i, n, ln, nm, k, p, off, j, pos;
            byte* tn;
            n = 0;
            tn = db.schema[tblpos].name;
            for (i = 0; i < db.nschema; i++)
            {
                if (db.schema[i].kind != 2) { continue; };
                if (sq_streq(db.schema[i].tbl_name, tn) == false) { continue; };
                if (n >= maxn) { break; };
                out[n].root = db.schema[i].rootpage;
                out[n].schema_pos = i;
                out[n].tbl_pos = tblpos;
                out[n].ispk = 0;
                out[n].slot = 0;
                for (k = 0; k < 64; k++) { out[n].name[k] = db.schema[i].name[k]; };
                if ((u64)db.schema[i].sql == (u64)0)
                {
                    // automatic index: sqlite_autoindex_<table>_<N>
                    ln = 0;
                    while (out[n].name[ln] != (byte)0) { ln++; };
                    p = ln;
                    while (p > 0 & sq_isdigit(out[n].name[p - 1])) { p--; };
                    nm = (int)sq_atoi(@out[n].name[p], ln - p);
                    out[n].slot = nm;
                    out[n].ok = 0;
                    out[n].wok = 1; out[n].ne = 0; out[n].wl = 0; out[n].partial = 0; out[n].est = (u64)0;
                    out[n].unique = 1;
                    out[n].nk = 0;
                    if (nm >= 1 & nm <= ti.nix)
                    {
                        off = 0;
                        for (j = 0; j < nm - 1; j++) { off = off + ti.ixn[j]; };
                        out[n].nk = ti.ixn[nm - 1];
                        for (j = 0; j < out[n].nk; j++)
                        {
                            out[n].col[j] = ti.ixc[off + j];
                            out[n].desc[j] = 0;
                            out[n].coll[j] = ti.coll[ti.ixc[off + j]];
                        };
                        out[n].ispk = ti.ixpk[nm - 1];
                        out[n].ok = 1;
                    };
                }
                else { sq_idx_parse(ti, db.schema[i].sql, @out[n]); };
                sq_idx_tail(ti, @out[n]);
                if (ti.wor == 1) { out[n].ok = 0; };
                // a unique index whose key columns are all NOT NULL keeps the rowid out of its comparison key
                out[n].uqnn = 0;
                if (out[n].unique != 0 & out[n].nk > 0 & out[n].ok != 0)
                {
                    out[n].uqnn = 1;
                    for (j = 0; j < out[n].nk; j++)
                    {
                        if (out[n].isx[j] != 0) { out[n].uqnn = 0; }
                        else { if (out[n].col[j] != ti.ipk & ti.notnull[out[n].col[j]] == 0) { out[n].uqnn = 0; }; };
                    };
                };
                n++;
            };
            return n;
        };

        // ---- read cursor over an index b-tree ----


        struct SQ_ICUR
        {
            SQLITE_DB* db;
            SQ_IDX* ix;
            int depth, valid;
            int[20] pg;
            int[20] ci;
            byte* pay;
            int pcap, plen, nv;
            byte* sc;
            SQ_VAL[18] v;
        };

        def sq_icur_settle(SQ_ICUR* c) -> int;

        def sq_icur_open(SQ_ICUR* c, SQLITE_DB* db, SQ_IDX* ix) -> void
        {
            c.db = db; c.ix = ix; c.depth = 0; c.valid = 0;
            c.pay = (byte*)0; c.pcap = 0; c.plen = 0; c.nv = 0; c.sc = (byte*)0;
        };

        def sq_icur_close(SQ_ICUR* c) -> void
        {
            if ((u64)c.pay != (u64)0) { ffree((u64)c.pay); c.pay = (byte*)0; };
            if ((u64)c.sc != (u64)0) { ffree((u64)c.sc); c.sc = (byte*)0; };
            c.pcap = 0;
            c.valid = 0;
        };

        // loads the entry of cell ci on page pgno (leaf or interior index page) and decodes it
        def sq_icur_load(SQ_ICUR* c, int pgno, int ci) -> int
        {
            SQLITE_DB* db = c.db;
            byte* page = sq_page(db, pgno);
            byte* op;
            u64 psz;
            int ho, t, hsz, cp, n, total, lcl, copied, ovf, chunk, i, U, cap;
            byte* nb;
            if ((u64)page == (u64)0) { return 1; };
            ho = sq_hdr_off(pgno);
            t = (int)page[ho];
            hsz = 8;
            if (t == 2) { hsz = 12; };
            cp = sq_be16(@page[ho + hsz + 2 * ci]);
            if (cp >= db.page_size) { return 1; };
            if (t == 2) { cp = cp + 4; };
            n = sq_varint(@page[cp], @psz);
            cp = cp + n;
            total = (int)psz;
            lcl = sq_ilocal(db, total);
            if (total + 16 > c.pcap)
            {
                cap = c.pcap;
                if (cap < 4096) { cap = 4096; };
                while (cap < total + 16) { cap = cap * 2; };
                nb = (byte*)fmalloc((u64)cap);
                if ((u64)nb == (u64)0) { return 1; };
                if ((u64)c.pay != (u64)0) { ffree((u64)c.pay); };
                c.pay = nb;
                c.pcap = cap;
                if (SQ_ENC != 1)
                {
                    if ((u64)c.sc != (u64)0) { ffree((u64)c.sc); };
                    c.sc = (byte*)fmalloc((u64)(cap * 2));
                    if ((u64)c.sc == (u64)0) { return 1; };
                };
            };
            if (cp + lcl > db.page_size) { return 1; };
            for (i = 0; i < lcl; i++) { c.pay[i] = page[cp + i]; };
            copied = lcl;
            U = db.usable;
            if (lcl < total)
            {
                ovf = sq_be32(@page[cp + lcl]);
                while (copied < total & ovf != 0)
                {
                    op = sq_page(db, ovf);
                    if ((u64)op == (u64)0) { return 1; };
                    chunk = total - copied;
                    if (chunk > U - 4) { chunk = U - 4; };
                    for (i = 0; i < chunk; i++) { c.pay[copied + i] = op[4 + i]; };
                    copied = copied + chunk;
                    ovf = sq_be32(op);
                };
                if (copied < total) { return 1; };
            };
            c.plen = total;
            c.nv = sq_rec_decode_sc(c.pay, total, @c.v[0], 18, c.sc);
            if (c.nv < 0) { return 1; };
            return 0;
        };

        // compares the first n key values of an entry with probe values: <0 entry before probe, 0 equal, >0 after
        def sq_icmp(SQ_IDX* ix, SQ_VAL* ev, int nev, SQ_VAL* probe, int n) -> int
        {
            int k, c;
            for (k = 0; k < n; k++)
            {
                if (k >= nev) { return 0 - 1; };
                c = sq_val_cmpc(@ev[k], @probe[k], ix.coll[k]);
                if (c != 0)
                {
                    if (ix.desc[k] == 1) { return 0 - c; };
                    return c;
                };
            };
            return 0;
        };

        // Positions at the first entry that is not before the probe (the first entry after the probe when after is 1).
        // Returns 1 on an entry, 0 when none, -1 on error.
        def sq_icur_seek(SQ_ICUR* c, SQ_VAL* probe, int n, int after) -> int
        {
            SQLITE_DB* db = c.db;
            byte* page;
            int pgno, d, ho, t, nc, hsz, lo, hi, mid, cmp, child, cp;
            pgno = c.ix.root;
            c.depth = 0;
            c.valid = 0;
            while (true)
            {
                if (c.depth >= 20) { return 0 - 1; };
                page = sq_page(db, pgno);
                if ((u64)page == (u64)0) { return 0 - 1; };
                ho = sq_hdr_off(pgno);
                t = (int)page[ho];
                nc = sq_be16(@page[ho + 3]);
                hsz = 8;
                if (t == 2) { hsz = 12; };
                if (t != 2 & t != 10) { return 0 - 1; };
                lo = 0;
                hi = nc;
                while (lo < hi)
                {
                    mid = (lo + hi) / 2;
                    if (sq_icur_load(c, pgno, mid) != 0) { return 0 - 1; };
                    cmp = sq_icmp(c.ix, @c.v[0], c.nv, probe, n);
                    if (cmp < 0 | (cmp == 0 & after == 1)) { lo = mid + 1; } else { hi = mid; };
                    page = sq_page(db, pgno);
                    if ((u64)page == (u64)0) { return 0 - 1; };
                };
                d = c.depth;
                c.pg[d] = pgno;
                c.ci[d] = lo;
                c.depth = d + 1;
                if (t == 10)
                {
                    return sq_icur_settle(c);
                };
                if (lo < nc) { child = sq_be32(@page[sq_be16(@page[ho + 12 + 2 * lo])]); }
                else { child = sq_be32(@page[ho + 8]); };
                pgno = child;
            };
            return 0 - 1;
        };

        // The top of the stack is a leaf position (maybe past the last cell) or an interior cell: load the entry or climb.
        def sq_icur_settle(SQ_ICUR* c) -> int
        {
            SQLITE_DB* db = c.db;
            byte* page;
            int d, pgno, ho, nc, ci;
            while (c.depth > 0)
            {
                d = c.depth - 1;
                pgno = c.pg[d];
                page = sq_page(db, pgno);
                if ((u64)page == (u64)0) { return 0 - 1; };
                ho = sq_hdr_off(pgno);
                nc = sq_be16(@page[ho + 3]);
                ci = c.ci[d];
                if (ci < nc)
                {
                    if (sq_icur_load(c, pgno, ci) != 0) { return 0 - 1; };
                    c.valid = 1;
                    return 1;
                };
                c.depth = d;
            };
            c.valid = 0;
            return 0;
        };

        // pushes the leftmost path below child and settles on its first entry
        def sq_icur_descend_left(SQ_ICUR* c, int pgno) -> int
        {
            SQLITE_DB* db = c.db;
            byte* page;
            int ho, t, nc, d;
            while (true)
            {
                if (c.depth >= 20) { return 0 - 1; };
                page = sq_page(db, pgno);
                if ((u64)page == (u64)0) { return 0 - 1; };
                ho = sq_hdr_off(pgno);
                t = (int)page[ho];
                nc = sq_be16(@page[ho + 3]);
                d = c.depth;
                c.pg[d] = pgno;
                c.ci[d] = 0;
                c.depth = d + 1;
                if (t == 10) { return sq_icur_settle(c); };
                if (t != 2) { return 0 - 1; };
                if (nc == 0) { pgno = sq_be32(@page[ho + 8]); }
                else { pgno = sq_be32(@page[sq_be16(@page[ho + 12])]); };
            };
            return 0 - 1;
        };

        def sq_icur_first(SQ_ICUR* c) -> int
        {
            c.depth = 0;
            c.valid = 0;
            return sq_icur_descend_left(c, c.ix.root);
        };

        def sq_icur_next(SQ_ICUR* c) -> int
        {
            SQLITE_DB* db = c.db;
            byte* page;
            int d, pgno, ho, t, nc, child;
            if (c.valid == 0) { return 0; };
            d = c.depth - 1;
            pgno = c.pg[d];
            page = sq_page(db, pgno);
            if ((u64)page == (u64)0) { return 0 - 1; };
            ho = sq_hdr_off(pgno);
            t = (int)page[ho];
            nc = sq_be16(@page[ho + 3]);
            if (t == 10)
            {
                c.ci[d] = c.ci[d] + 1;
                return sq_icur_settle(c);
            };
            // interior entry: the next entry is the leftmost one in the child to its right
            c.ci[d] = c.ci[d] + 1;
            if (c.ci[d] < nc) { child = sq_be32(@page[sq_be16(@page[ho + 12 + 2 * c.ci[d]])]); }
            else { child = sq_be32(@page[ho + 8]); };
            return sq_icur_descend_left(c, child);
        };

        // rowid of the current entry (the last record value)
        def sq_icur_rowid(SQ_ICUR* c) -> i64
        {
            if (c.nv < 1) { return (i64)0; };
            return c.v[c.nv - 1].i;
        };

        // ---- table cursor: seek by rowid ----

        // 1 positioned on the row, 0 no such row, -1 error. The cursor can continue with sq_cur_next afterwards.
        def sq_cur_seek(SQ_CURSOR* cur, i64 rowid) -> int
        {
            SQLITE_DB* db = cur.db;
            byte* page;
            int pgno, ho, t, nc, lo, hi, mid, cp, n, child;
            u64 a, b;
            cur.depth = 0;
            cur.valid = 0;
            pgno = cur.root;
            while (true)
            {
                if (cur.depth >= SQ_MAX_DEPTH) { return 0 - 1; };
                page = sq_page(db, pgno);
                if ((u64)page == (u64)0) { return 0 - 1; };
                ho = sq_hdr_off(pgno);
                t = (int)page[ho];
                nc = sq_be16(@page[ho + 3]);
                lo = 0;
                hi = nc;
                if (t == 13)
                {
                    while (lo < hi)
                    {
                        mid = (lo + hi) / 2;
                        cp = sq_be16(@page[ho + 8 + 2 * mid]);
                        n = sq_varint(@page[cp], @a);
                        sq_varint(@page[cp + n], @b);
                        if ((i64)b < rowid) { lo = mid + 1; } else { hi = mid; };
                    };
                    cur.pg[cur.depth] = pgno;
                    cur.ci[cur.depth] = lo;
                    cur.depth++;
                    if (lo >= nc) { cur.valid = 0; return 0; };
                    cp = sq_be16(@page[ho + 8 + 2 * lo]);
                    n = sq_varint(@page[cp], @a);
                    sq_varint(@page[cp + n], @b);
                    if ((i64)b != rowid) { cur.valid = 0; return 0; };
                    if (sq_load_cell(cur, pgno, lo) != 0) { return 0 - 1; };
                    cur.valid = 1;
                    return 1;
                };
                if (t != 5) { return 0 - 1; };
                while (lo < hi)
                {
                    mid = (lo + hi) / 2;
                    cp = sq_be16(@page[ho + 12 + 2 * mid]);
                    sq_varint(@page[cp + 4], @b);
                    if ((i64)b < rowid) { lo = mid + 1; } else { hi = mid; };
                };
                cur.pg[cur.depth] = pgno;
                cur.ci[cur.depth] = lo;
                cur.depth++;
                if (lo < nc) { child = sq_be32(@page[sq_be16(@page[ho + 12 + 2 * lo])]); }
                else { child = sq_be32(@page[ho + 8]); };
                pgno = child;
            };
            return 0 - 1;
        };

        // Positions the cursor on the first row whose rowid is at least the given one. Returns 1 when a row is loaded, 0 at the end.
        def sq_cur_seek_ge(SQ_CURSOR* cur, i64 rowid) -> int
        {
            SQLITE_DB* db = cur.db;
            byte* page;
            int d, ho, nc, pgno, r;
            r = sq_cur_seek(cur, rowid);
            if (r != 0) { return r; };
            d = cur.depth - 1;
            pgno = cur.pg[d];
            page = sq_page(db, pgno);
            if ((u64)page == (u64)0) { return 0 - 1; };
            ho = sq_hdr_off(pgno);
            nc = sq_be16(@page[ho + 3]);
            if (nc == 0) { cur.valid = 0; return 0; };
            if (cur.ci[d] < nc)
            {
                if (sq_load_cell(cur, pgno, cur.ci[d]) != 0) { return 0 - 1; };
                cur.valid = 1;
                return 1;
            };
            cur.ci[d] = nc - 1;
            cur.valid = 1;
            return sq_cur_next(cur);
        };

        // ---- json_each / json_tree table-valued functions ----
        // columns: 0 key, 1 value, 2 type, 3 atom, 4 id, 5 parent, 6 fullkey, 7 path, 8 json (hidden), 9 root (hidden)

        def sq_jt_txt(SQ_RS* rs, SQ_VAL* o, byte* s, int n) -> void
        {
            byte* c = sq_ar_copy(@rs.ar, s, n);
            if ((u64)c == (u64)0) { sq_val_null(o); return; };
            o.t = SQ_TEXT; o.p = c; o.n = n; o.i = (i64)0; o.r = 0.0;
        };

        def sq_jt_simple(byte* s, int n) -> bool
        {
            int i;
            if (n < 1) { return false; };
            if (sq_jp_isalpha((int)s[0]) == false) { return false; };
            for (i = 1; i < n; i++)
            {
                if (sq_jp_isalpha((int)s[i]) == false & sq_jp_isdig((int)s[i]) == false) { return false; };
            };
            return true;
        };

        // fullkey of a child: the parent key plus the component for an array index (lab null) or an object label
        def sq_jt_child(SQ_RS* rs, byte* fk, int fkl, int idx, byte* lab, int ll, int* outl) -> byte*
        {
            byte[24] nb;
            byte* r;
            int k, l, q;
            r = sq_ar_alloc(@rs.ar, fkl + ll + 28);
            if ((u64)r == (u64)0) { *outl = 0; return fk; };
            sq_mcpy(r, fk, fkl);
            l = fkl;
            if ((u64)lab == (u64)0)
            {
                r[l] = (byte)91; l++;
                k = sq_itoa((i64)idx, @nb[0]);
                sq_mcpy(@r[l], @nb[0], k); l = l + k;
                r[l] = (byte)93; l++;
            }
            else
            {
                r[l] = (byte)46; l++;
                if (sq_jt_simple(lab, ll) == false) { r[l] = (byte)34; l++; };
                sq_mcpy(@r[l], lab, ll); l = l + ll;
                if (sq_jt_simple(lab, ll) == false) { r[l] = (byte)34; l++; };
            };
            r[l] = (byte)0;
            *outl = l;
            return r;
        };

        def sq_jt_row(SQ_STMT* st, SQ_BLK* b, SQ_RS* rs, byte* p, int n, int i, int idv, SQ_VAL* key, byte* fk, int fkl, byte* pth, int pl, int par, SQ_VAL* jv, SQ_VAL* rv) -> int
        {
            SQ_VAL* row;
            int t, hs, ps;
            byte* tn;
            row = sq_rs_row(rs);
            if ((u64)row == (u64)0) { sq_seterr(st, "out of memory\0"); return 1; };
            if (sq_jb_node(p, n, i, @t, @hs, @ps) == false) { sq_seterr(st, "malformed JSON\0"); return 1; };
            sq_val_copy(@row[0], key);
            if (sq_jf_elem(st, b, p, n, i, 0, @row[1]) != 0) { return 1; };
            sq_val_own(@rs.ar, @row[1]);
            tn = "null\0";
            if (t == 1) { tn = "true\0"; };
            if (t == 2) { tn = "false\0"; };
            if (t == 3 | t == 4) { tn = "integer\0"; };
            if (t == 5 | t == 6) { tn = "real\0"; };
            if (t >= 7 & t <= 10) { tn = "text\0"; };
            if (t == 11) { tn = "array\0"; };
            if (t == 12) { tn = "object\0"; };
            sq_jt_txt(rs, @row[2], tn, sq_cstrlen(tn));
            if (t == 11 | t == 12) { sq_val_null(@row[3]); } else { sq_val_copy(@row[3], @row[1]); };
            if (t == 0) { sq_val_null(@row[3]); };
            sq_val_int(@row[4], (i64)idv);
            if (par < 0) { sq_val_null(@row[5]); } else { sq_val_int(@row[5], (i64)par); };
            sq_jt_txt(rs, @row[6], fk, fkl);
            sq_jt_txt(rs, @row[7], pth, pl);
            sq_val_copy(@row[8], jv);
            sq_val_copy(@row[9], rv);
            return 0;
        };

        def sq_jt_kids(SQ_STMT* st, SQ_BLK* b, SQ_RS* rs, byte* p, int n, int i, int cid, byte* fk, int fkl, int tree, SQ_VAL* jv, SQ_VAL* rv) -> int
        {
            int t, hs, ps, e, k, idx, ve, ct, ch, cp, kt, kh, kp, ko, vk, fl, ll, par;
            byte* nf;
            byte* lab;
            SQ_VAL key;
            if (sq_jb_node(p, n, i, @t, @hs, @ps) == false) { return 0; };
            e = i + hs + ps;
            k = i + hs;
            idx = 0;
            par = 0 - 1;
            if (tree == 1) { par = cid; };
            while (k < e)
            {
                if (t == 11)
                {
                    if (sq_jb_node(p, n, k, @ct, @ch, @cp) == false) { return 0; };
                    ve = k + ch + cp;
                    sq_val_int(@key, (i64)idx);
                    nf = sq_jt_child(rs, fk, fkl, idx, (byte*)0, 0, @fl);
                    if (sq_jt_row(st, b, rs, p, n, k, k, @key, nf, fl, fk, fkl, par, jv, rv) != 0) { return 1; };
                    if (tree == 1 & (ct == 11 | ct == 12))
                    {
                        if (sq_jt_kids(st, b, rs, p, n, k, k, nf, fl, 1, jv, rv) != 0) { return 1; };
                    };
                    idx++;
                    k = ve;
                }
                else
                {
                    ko = k;
                    if (sq_jb_node(p, n, ko, @kt, @kh, @kp) == false) { return 0; };
                    vk = ko + kh + kp;
                    if (sq_jb_node(p, n, vk, @ct, @ch, @cp) == false) { return 0; };
                    ve = vk + ch + cp;
                    lab = sq_jk_text(b, p, n, ko, @ll);
                    sq_val_null(@key);
                    key.t = SQ_TEXT; key.p = lab; key.n = ll; key.i = (i64)0; key.r = 0.0;
                    sq_val_own(@rs.ar, @key);
                    nf = sq_jt_child(rs, fk, fkl, 0, key.p, ll, @fl);
                    if (sq_jt_row(st, b, rs, p, n, vk, ko, @key, nf, fl, fk, fkl, par, jv, rv) != 0) { return 1; };
                    if (tree == 1 & (ct == 11 | ct == 12))
                    {
                        if (sq_jt_kids(st, b, rs, p, n, vk, ko, nf, fl, 1, jv, rv) != 0) { return 1; };
                    };
                    k = ve;
                };
            };
            return 0;
        };

        // pragma functions are answered by the write library through this hook (set when a statement is executed)
        global u64 SQ_PRFN = 0;

        def sq_stmt_new() -> SQ_STMT*;
        def sq_stmt_del(SQ_STMT* st) -> void;
        def sq_prep_query(SQ_STMT* st, SQLITE_DB* db, byte* sql) -> int;
        def sq_step_query(SQ_STMT* st) -> int;
        def sq_column_count(SQ_STMT* st) -> int;
        def sq_cell(SQ_STMT* st, int i) -> SQ_VAL*;

        def sq_ptvf_fill(SQ_STMT* st, SQ_BLK* b, SQ_SRC* sr) -> int
        {
            SQ_RS* rs = sr.rs;
            SQ_STMT* g;
            SQ_VAL x1, x2, ax, sx, t1;
            SQ_VAL* row;
            byte* pq;
            byte* ap;
            byte[200] sql;
            int hid, nargs, nvis, nc, c, rc, al, step, i;
            sq_ar_reset(@rs.ar);
            rs.n = 0;
            hid = sq_ptvf_hid(sr.tdef);
            nargs = 0;
            if (hid == 3) { nargs = 2; };
            if (hid == 1 | hid == 2) { nargs = 1; };
            if (sr.ntarg > nargs)
            {
                sq_seterr(st, "too many arguments on pragma function\0");
                return 1;
            };
            sq_val_null(@ax);
            sq_val_null(@sx);
            if (sr.ntarg >= 1)
            {
                sq_eval(st, b, sr.targ, @x1);
                if (hid == 3) { sq_val_copy(@ax, @x1); } else { sq_val_copy(@sx, @x1); };
            };
            if (sr.ntarg >= 2)
            {
                sq_eval(st, b, st.nodes[sr.targ].next, @x2);
                sq_val_copy(@sx, @x2);
            };
            if (sx.t != SQ_NULL)
            {
                sq_val_text(@b.scr, @sx, @t1);
                if (sq_ieq(t1.p, t1.n, "main\0") == false) { return 0; };
            };
            if (SQ_PRFN == (u64)0) { sq_seterr(st, "no such table\0"); return 1; };
            ap = (byte*)0;
            al = 0;
            if (ax.t != SQ_NULL)
            {
                sq_val_text(@b.scr, @ax, @t1);
                ap = t1.p;
                al = t1.n;
            }
            else { if (hid == 3 & sr.ntarg >= 1) { return 0; }; };
            pq = (byte*)0;
            {
                def{}* hk(SQ_STMT*, byte*, int, byte*, int, byte**) -> int = (byte*)SQ_PRFN;
                rc = hk(st, @st.sql[sr.ts + 7], sr.tl - 7, ap, al, @pq);
            };
            if (rc != 0) { return 1; };
            if ((u64)pq == (u64)0) { return 0; };
            g = sq_stmt_new();
            if ((u64)g == (u64)0) { ffree((u64)pq); sq_seterr(st, "out of memory\0"); return 1; };
            rc = sq_prep_query(g, st.db, pq);
            ffree((u64)pq);
            if (rc != 0)
            {
                for (i = 0; i < 150; i++) { st.err[i] = g.err[i]; if (g.err[i] == (byte)0) { break; }; };
                sq_stmt_del(g);
                return 1;
            };
            nc = sr.ti.ncols;
            nvis = nc;
            if (hid == 3) { nvis = nc - 2; };
            if (hid == 1 | hid == 2) { nvis = nc - 1; };
            while (true)
            {
                step = sq_step_query(g);
                if (step != 1) { break; };
                row = sq_rs_row(rs);
                if ((u64)row == (u64)0) { sq_stmt_del(g); sq_seterr(st, "out of memory\0"); return 1; };
                for (c = 0; c < nvis; c++)
                {
                    if (c < sq_column_count(g)) { sq_val_copy(@row[c], sq_cell(g, c)); sq_val_own(@rs.ar, @row[c]); }
                    else { sq_val_null(@row[c]); };
                };
                if (hid == 3) { sq_val_copy(@row[nc - 2], @ax); sq_val_own(@rs.ar, @row[nc - 2]); sq_val_copy(@row[nc - 1], @sx); sq_val_own(@rs.ar, @row[nc - 1]); };
                if (hid == 2) { sq_val_copy(@row[nc - 1], @sx); sq_val_own(@rs.ar, @row[nc - 1]); };
            };
            if (step < 0)
            {
                for (i = 0; i < 150; i++) { st.err[i] = g.err[i]; if (g.err[i] == (byte)0) { break; }; };
                sq_stmt_del(g);
                return 1;
            };
            sq_stmt_del(g);
            return 0;
        };

        // rebuilds the rows of a json_each / json_tree source for the current outer row
        def sq_tvf_fill(SQ_STMT* st, SQ_BLK* b, SQ_SRC* sr) -> int
        {
            SQ_RS* rs = sr.rs;
            SQ_VAL x, pv, jv, rv, key, tx;
            SQ_JPATH pth;
            SQ_JPATH pth2;
            int t2, hs2, ps2;
            byte* p;
            byte* pz;
            byte* pc;
            int pn, i, rid, t, hs, ps, d, q, kl, v, pl;
            byte[160] msg;
            if (sr.tvf == 3) { return sq_ptvf_fill(st, b, sr); };
            sq_ar_reset(@rs.ar);
            rs.n = 0;
            if (sr.ntarg > 2)
            {
                if (sr.tvf == 1) { sq_seterr(st, "too many arguments on json_each() - max 2\0"); } else { sq_seterr(st, "too many arguments on json_tree() - max 2\0"); };
                return 1;
            };
            if (sr.ntarg < 1) { return 0; };
            sq_eval(st, b, sr.targ, @x);
            if (x.t == SQ_NULL) { return 0; };
            pl = 1;
            pc = "$\0";
            sq_val_null(@pv);
            if (sr.ntarg == 2)
            {
                sq_eval(st, b, st.nodes[sr.targ].next, @pv);
                if (pv.t == SQ_NULL) { return 0; };
                sq_val_text(@b.scr, @pv, @tx);
                pc = sq_ar_copy(@rs.ar, tx.p, tx.n);
                if ((u64)pc == (u64)0) { sq_seterr(st, "out of memory\0"); return 1; };
                pl = tx.n;
            };
            if (sq_jpath_parse(pc, pl, @pth) != 0 & pth.bad == 2) { sq_jf_patherr(st, pc, pl); return 1; };
            if (sq_jf_load(st, b, @x, @p, @pn) != 0) { return 1; };
            rid = sq_jpath_find(b, p, pn, 0, @pth, pc);
            if (rid == 0 - 2) { sq_jf_patherr(st, pc, pl); return 1; };
            if (rid < 0) { return 0; };
            sq_val_copy(@jv, @x);
            sq_val_own(@rs.ar, @jv);
            sq_jt_txt(rs, @rv, pc, pl);
            v = rid;
            if (pth.lko >= 0) { v = pth.lko; };
            sq_jb_node(p, pn, rid, @t, @hs, @ps);
            if (sr.tvf == 1)
            {
                if (t == 11 | t == 12) { return sq_jt_kids(st, b, rs, p, pn, rid, v, pc, pl, 0, @jv, @rv); };
                sq_val_null(@key);
                return sq_jt_row(st, b, rs, p, pn, rid, v, @key, pc, pl, pc, pl, 0 - 1, @jv, @rv);
            };
            // json_tree: the root row takes its key and path from the last component of the path text
            sq_val_null(@key);
            d = pl;
            while (d > 1)
            {
                d--;
                if (pc[d] == (byte)91 | pc[d] == (byte)46)
                {
                    if (sq_jpath_parse(pc, d, @pth2) != 0) { continue; };
                    q = sq_jpath_find(b, p, pn, 0, @pth2, pc);
                    if (q < 0) { continue; };
                    sq_jb_node(p, pn, q, @t2, @hs2, @ps2);
                    if (q + hs2 == v) { break; };
                };
            };
            i = d;
            kl = pl - d;
            if (pl > 1 & kl > 0)
            {
                if (pc[d] == (byte)91)
                {
                    q = d + 1;
                    hs2 = 0;
                    while (q < pl) { if (sq_jp_isdig((int)pc[q])) { hs2 = hs2 * 10 + ((int)pc[q] - 48); q++; } else { break; }; };
                    sq_val_int(@key, (i64)hs2);
                }
                else
                {
                    if (pc[d + 1] == (byte)34 & kl >= 3) { key.t = SQ_TEXT; key.p = @pc[d + 2]; key.n = kl - 3; }
                    else { key.t = SQ_TEXT; key.p = @pc[d + 1]; key.n = kl - 1; };
                    key.i = (i64)0; key.r = 0.0;
                    sq_val_own(@rs.ar, @key);
                };
            };
            if (sq_jt_row(st, b, rs, p, pn, rid, v, @key, pc, pl, pc, i, 0 - 1, @jv, @rv) != 0) { return 1; };
            if (t == 11 | t == 12) { return sq_jt_kids(st, b, rs, p, pn, rid, v, pc, pl, 1, @jv, @rv); };
            return 0;
        };
        // ---- executor: sources ----

        def sq_eval_i64(SQ_STMT* st, SQ_BLK* b, int ni, i64 dflt) -> i64;

        // value used for a column that is missing from an old row (ALTER TABLE ADD COLUMN) or omitted in an INSERT
        def sq_default_val(SQ_TI* ti, int c, SQ_ARENA* ar, SQ_VAL* out) -> void
        {
            byte* s = ti.base;
            int a, l, neg;
            SQ_VAL t;
            sq_val_null(out);
            if (ti.dfl[c] <= 0) { return; };
            a = ti.dfs[c];
            l = ti.dfl[c];
            if (s[a] == (byte)39)
            {
                // quoted string: the text between the quotes, doubled quotes collapsed
                byte* r = sq_ar_alloc(ar, l);
                int i = 1;
                int k = 0;
                if ((u64)r == (u64)0) { return; };
                while (i < l - 1)
                {
                    r[k] = s[a + i];
                    k++;
                    if (s[a + i] == (byte)39 & s[a + i + 1] == (byte)39) { i++; };
                    i++;
                };
                out.t = SQ_TEXT; out.p = r; out.n = k; out.i = (i64)0; out.r = 0.0;
                return;
            };
            if (sq_ieq(@s[a], l, "null\0")) { return; };
            if (sq_ieq(@s[a], l, "true\0")) { sq_val_int(out, (i64)1); return; };
            if (sq_ieq(@s[a], l, "false\0")) { sq_val_int(out, (i64)0); return; };
            if (sq_numtext(@s[a], l, @t)) { sq_val_copy(out, @t); sq_apply_aff(ar, ti.aff[c], out); return; };
        };

        def sq_gen_row(SQ_STMT* st, SQ_TI* ti, SQ_ARENA* ar, SQ_VAL* row, int mode) -> int;

        // decodes the cursor row into row[0..ncols] (last value is the rowid)
        def sq_fill_row(SQ_STMT* st, SQ_SRC* sr, SQ_CURSOR* cur, SQ_RS* rs, SQ_VAL* row) -> void
        {
            SQ_TI* ti = sr.ti;
            int c, k, nc;
            byte* p;
            nc = ti.ncols;
            for (c = 0; c < nc; c++)
            {
                if (c == ti.ipk) { sq_val_int(@row[c], cur.rowid); continue; };
                if (ti.gen[c] == 1) { sq_val_null(@row[c]); continue; };
                if (ti.ri[c] >= cur.ncols) { sq_default_val(ti, c, @rs.ar, @row[c]); continue; };
                k = sq_col_type(cur, ti.ri[c]);
                if (k == SQ_INTEGER)
                {
                    if (ti.aff[c] == 4) { sq_val_real(@row[c], (double)sq_col_int(cur, ti.ri[c])); }
                    else { sq_val_int(@row[c], sq_col_int(cur, ti.ri[c])); };
                    continue;
                };
                if (k == SQ_REAL) { sq_val_real(@row[c], sq_col_real(cur, ti.ri[c])); continue; };
                if (k == SQ_TEXT | k == SQ_BLOB)
                {
                    row[c].t = k; row[c].n = sq_col_bytes(cur, ti.ri[c]); row[c].i = (i64)0; row[c].r = 0.0;
                    p = sq_ar_copy(@rs.ar, sq_col_ptr(cur, ti.ri[c]), row[c].n);
                    if ((u64)p == (u64)0) { sq_val_null(@row[c]); } else { row[c].p = p; };
                    continue;
                };
                sq_val_null(@row[c]);
            };
            sq_val_int(@row[nc], cur.rowid);
            if (ti.ngen > 0) { sq_gen_row(st, ti, @rs.ar, row, 1); };
        };

        // materialises source j of block b
        // a covering index that replaces the table scan of a lone rowid-table source (the smallest one wins, as in SQLite)
        def sq_cov_ix(SQ_STMT* st, SQ_BLK* b, int j, SQ_IDX* out) -> int
        {
            SQ_SRC* sr = @b.src[j];
            SQ_NODE* nd;
            SQ_IDX[20] ixs;
            byte[132] need;
            int i, k, n, t, m, ok, best, bn, ts;
            if (b.nsrc != 1 | sr.kind != 1 | sr.tbl < 0) { return 0; };
            if ((u64)sr.ti == (u64)0) { return 0; };
            if (sr.ti.wor != 0 | sr.idxby == 2) { return 0; };
            if (b.ngrp > 0 | b.nord > 0 | b.distinct == 1) { return 0; };
            for (i = 0; i < 132; i++) { need[i] = (byte)0; };
            for (i = 0; i < st.nn; i++)
            {
                nd = @st.nodes[i];
                if (nd.kind != SQN_COL) { continue; };
                if (nd.lvl == 0) { if (nd.owner != b.bidx) { continue; }; } else { if (nd.rblk != b.bidx) { continue; }; };
                if (nd.src != j) { continue; };
                if (nd.col < 0 | nd.col >= 130) { continue; };
                need[nd.col] = (byte)1;
            };
            n = sq_idx_list(sr.sdb, sr.tbl, sr.ti, @ixs[0], 20);
            best = 0 - 1; bn = 1000;
            for (k = 0; k < n; k++)
            {
                if (ixs[k].partial != 0) { continue; };
                if (sr.idxby == 1)
                {
                    t = 0;
                    while (ixs[k].name[t] != (byte)0) { t++; };
                    ok = 0;
                    if (t == sr.ixs_l)
                    {
                        ok = 1;
                        for (m = 0; m < t; m++) { if (sq_lc(ixs[k].name[m]) != sq_lc(st.sql[sr.ixs_s + m])) { ok = 0; }; };
                    };
                    if (ok == 1) { best = k; break; };
                    continue;
                };
                ok = 1;
                for (t = 0; t < ixs[k].nk; t++) { if (ixs[k].isx[t] != 0) { ok = 0; }; };
                if (ok == 0) { continue; };
                for (i = 0; i < sr.ti.ncols; i++)
                {
                    if (need[i] == (byte)0) { continue; };
                    if (i == sr.ti.ipk) { continue; };
                    m = 0;
                    for (t = 0; t < ixs[k].nk; t++) { if (ixs[k].col[t] == i) { m = 1; }; };
                    if (m == 0) { ok = 0; };
                };
                if (ok == 0) { continue; };
                if (ixs[k].nk <= bn) { bn = ixs[k].nk; best = k; };
            };
            if (best < 0) { return 0; };
            *out = ixs[best];
            return 1;
        };

        def sq_load_source(SQ_STMT* st, SQ_BLK* b, int j) -> int
        {
            SQ_SRC* sr = @b.src[j];
            SQ_CURSOR cur;
            SQ_VAL* row;
            SQ_RS* rs;
            int ok, nc;
            i64 lim0, off0;
            SQ_IDX cix;
            SQ_ICUR icur;
            if (sr.kind == 2)
            {
                if (sr.selfref == 1)
                {
                    sr.rs = st.ctes[sr.cte].work;
                    sr.rs_shared = 1;
                    return 0;
                };
                if (sr.cte >= 0)
                {
                    if (st.ctes[sr.cte].rec == 1 & b.nsrc == 1 & b.where_n < 0 & b.ngrp == 0 & b.having < 0 & b.nord == 0 & b.has_agg == 0 & b.distinct == 0 & b.cnext < 0 & b.cop == 0 & b.limit_n >= 0)
                    {
                        // an endless recursive CTE can only be read through the outer LIMIT, so stop it there
                        lim0 = sq_eval_i64(st, b, b.limit_n, (i64)0 - (i64)1);
                        off0 = sq_eval_i64(st, b, b.offset_n, (i64)0);
                        if (lim0 >= (i64)0 & off0 >= (i64)0)
                        {
                            sr.rs = sq_run_block(st, sr.blk, (int)(lim0 + off0));
                            sr.rs_shared = 0;
                            if ((u64)sr.rs == (u64)0) { return 1; };
                            return 0;
                        };
                    };
                    if ((u64)st.ctes[sr.cte].rs == (u64)0)
                    {
                        st.ctes[sr.cte].rs = sq_run_block(st, sr.blk, 0 - 1);
                        if ((u64)st.ctes[sr.cte].rs == (u64)0) { return 1; };
                    };
                    sr.rs = st.ctes[sr.cte].rs;
                    sr.rs_shared = 1;
                    return 0;
                };
                sr.rs = sq_run_block(st, sr.blk, 0 - 1);
                sr.rs_shared = 0;
                if ((u64)sr.rs == (u64)0) { return 1; };
                if ((u64)st.blks[sr.blk].out == (u64)sr.rs) { sr.rs_shared = 1; };
                return 0;
            };
            if (sr.kind == 3)
            {
                rs = sq_rs_new(sr.ti.ncols, sr.ti.ncols);
                if ((u64)rs == (u64)0) { sq_seterr(st, "out of memory\0"); return 1; };
                sr.rs = rs;
                sr.rs_shared = 0;
                return 0;
            };
            nc = sr.ti.ncols;
            rs = sq_rs_new(nc + 1, nc + 1);
            if ((u64)rs == (u64)0) { sq_seterr(st, "out of memory\0"); return 1; };
            sr.rs = rs;
            sr.rs_shared = 0;
            cur.payload = (byte*)0;
            cur.pcap = 0;
            sq_cur_open(@cur, sr.sdb, sr.root);
            if (sq_cov_ix(st, b, j, @cix) == 1)
            {
                sq_icur_open(@icur, sr.sdb, @cix);
                ok = sq_icur_first(@icur);
                while (ok == 1)
                {
                    if (sq_cur_seek(@cur, sq_icur_rowid(@icur)) == 1)
                    {
                        row = sq_rs_row(rs);
                        if ((u64)row == (u64)0) { sq_icur_close(@icur); sq_cur_close(@cur); sq_seterr(st, "out of memory\0"); return 1; };
                        sq_fill_row(st, sr, @cur, rs, row);
                    };
                    ok = sq_icur_next(@icur);
                };
                sq_icur_close(@icur);
                sq_cur_close(@cur);
                return 0;
            };
            ok = sq_cur_first(@cur);
            while (ok == 1)
            {
                row = sq_rs_row(rs);
                if ((u64)row == (u64)0) { sq_cur_close(@cur); sq_seterr(st, "out of memory\0"); return 1; };
                sq_fill_row(st, sr, @cur, rs, row);
                ok = sq_cur_next(@cur);
            };
            sq_cur_close(@cur);
            return 0;
        };

        def sq_free_sources(SQ_STMT* st, SQ_BLK* b) -> void
        {
            int j;
            SQ_SRC* sr;
            for (j = 0; j < b.nsrc; j++)
            {
                sr = @b.src[j];
                if ((u64)sr.rs != (u64)0 & sr.rs_shared == 0) { sq_rs_free(sr.rs); };
                sr.rs = (SQ_RS*)0;
            };
        };

        // highest source index that the expression reads at this block level; -1 when constant, 99 when unsafe to move
        def sq_node_level(SQ_STMT* st, int ni, int depth) -> int
        {
            SQ_NODE* nd;
            int m, l, c;
            if (ni < 0) { return 0 - 1; };
            nd = @st.nodes[ni];
            m = 0 - 1;
            if (nd.kind == SQN_SUBQ | nd.kind == SQN_EXISTS) { return 99; };
            if (nd.kind == SQN_IN) { if (nd.blk >= 0) { return 99; }; };
            if (nd.kind == SQN_COL)
            {
                if (nd.lvl == 0) { return nd.src; };
                return 99;
            };
            if (nd.kind == SQN_FUNC) { if (nd.col >= 100) { return 99; }; if (nd.col == 23) { return 99; }; };
            c = nd.a;
            while (c >= 0)
            {
                l = sq_node_level(st, c, depth + 1);
                if (l > m) { m = l; };
                c = st.nodes[c].next;
            };
            c = nd.b;
            while (c >= 0)
            {
                l = sq_node_level(st, c, depth + 1);
                if (l > m) { m = l; };
                c = st.nodes[c].next;
            };
            c = nd.c;
            while (c >= 0)
            {
                l = sq_node_level(st, c, depth + 1);
                if (l > m) { m = l; };
                c = st.nodes[c].next;
            };
            return m;
        };

        // splits the WHERE tree into AND conjuncts and assigns each one the earliest level it can be tested at
        def sq_split_where(SQ_STMT* st, SQ_BLK* b, int ni) -> void
        {
            SQ_NODE* nd;
            int l;
            if (ni < 0) { return; };
            nd = @st.nodes[ni];
            if (nd.kind == SQN_BIN & nd.op == SQO_AND & b.nwc < 29)
            {
                sq_split_where(st, b, nd.a);
                sq_split_where(st, b, nd.b);
                return;
            };
            l = sq_node_level(st, ni, 0);
            if (l < 0) { l = 0 - 1; };
            if (l >= b.nsrc) { l = b.nsrc - 1; };
            b.wcn[b.nwc] = ni;
            b.wcl[b.nwc] = l;
            b.nwc++;
        };

        // ---- executor: rows ----

        def sq_wrec(SQ_STMT* st, SQ_BLK* b, SQ_ARM* ar) -> int;

        def sq_emit(SQ_STMT* st, SQ_BLK* b, SQ_ARM* ar) -> int
        {
            int i, nres, t;
            SQ_VAL* v = @ar.vals[0];
            if (b.nwin > 0 & b.wphase == 0) { return sq_wrec(st, b, ar); };
            nres = ar.nres;
            for (i = 0; i < nres; i++) { sq_eval(st, b, b.rc[i], @v[i]); };
            for (t = 0; t < ar.nkeys; t++) { sq_eval(st, b, b.ord[t], @v[nres + t]); };
            if (ar.use_dset == 1)
            {
                // DISTINCT on the visible columns
                ar.dset.nk = nres;
                if (sq_set_add(@ar.dset, v) < 0) { ar.err = 1; return 1; };
                if (ar.dset.isnew == 0) { return 0; };
            };
            if (ar.sorted == 0)
            {
                if (ar.skip > (i64)0) { ar.skip = ar.skip - (i64)1; return 0; };
            };
            if (sq_rs_add(ar.rs, v) == false) { ar.err = 1; sq_seterr(st, "out of memory\0"); return 1; };
            ar.count++;
            if (ar.sorted == 0 & ar.lim >= (i64)0)
            {
                if ((i64)ar.count >= ar.lim) { ar.stop = 1; return 1; };
            };
            return 0;
        };

        // ---- aggregates ----

        // keeps a copy of the streamed row so that bare columns can be read after the scan moved on
        def sq_snap(SQ_STMT* st, SQ_BLK* b, SQ_GRP* g) -> int
        {
            SQ_RS* rs;
            int i;
            if (b.stream != 1) { return 0; };
            if (b.cur[0] < 0) { return 0; };
            rs = b.src[0].rs;
            g.rep0 = (SQ_VAL*)sq_ar_alloc(@b.gar, rs.nc * sizeof(SQ_VAL));
            if ((u64)g.rep0 == (u64)0) { return 1; };
            for (i = 0; i < rs.nc; i++)
            {
                sq_val_copy(@g.rep0[i], @rs.d[i]);
                sq_val_own(@b.gar, @g.rep0[i]);
            };
            return 0;
        };

        def sq_group_new(SQ_STMT* st, SQ_BLK* b, SQ_SET* gs, int gi) -> int
        {
            SQ_GRP* ng;
            int cap, k;
            SQ_ACC* acc;
            if (gi >= b.gcap)
            {
                cap = b.gcap * 2;
                if (cap < 64) { cap = 64; };
                ng = (SQ_GRP*)fmalloc((u64)cap * (u64)sizeof(SQ_GRP));
                if ((u64)ng == (u64)0) { return 1; };
                if (b.ngroups > 0) { sq_mcpy((byte*)ng, (byte*)b.groups, b.ngroups * sq_gsz()); };
                if ((u64)b.groups != (u64)0) { ffree((u64)b.groups); };
                b.groups = ng;
                b.gcap = cap;
            };
            acc = (SQ_ACC*)sq_ar_alloc(@b.gar, (b.nagg + 1) * sizeof(SQ_ACC));
            if ((u64)acc == (u64)0) { return 1; };
            for (k = 0; k < b.nagg; k++)
            {
                acc[k].n = (i64)0; acc[k].si = (i64)0; acc[k].sr = 0.0; acc[k].se = 0.0; acc[k].isreal = 0; acc[k].seen = 0; acc[k].ovf = 0;
                sq_val_null(@acc[k].v);
                acc[k].gc = (byte*)0; acc[k].gcn = 0; acc[k].gccap = 0; acc[k].dset = (SQ_SET*)0;
                acc[k].ob = (SQ_VAL*)0; acc[k].obn = 0; acc[k].obcap = 0;
            };
            b.groups[gi].acc = acc;
            b.groups[gi].key = (SQ_VAL*)0;
            for (k = 0; k < 8; k++) { b.groups[gi].rep[k] = b.cur[k]; };
            b.groups[gi].rep0 = (SQ_VAL*)0;
            b.groups[gi].snapd = 0;
            b.ngroups = gi + 1;
            return sq_snap(st, b, @b.groups[gi]);
        };

        // ---- percentile family: 108 median, 109 percentile, 110 percentile_cont, 111 percentile_disc ----
        def sq_pct_err(SQ_STMT* st, int id, int kind) -> void
        {
            byte[160] m;
            int i, k, l;
            i = 0;
            if (kind == 0) { sq_mcpy(@m[0], "input to \0", 9); i = 9; }
            else { sq_mcpy(@m[0], "the fraction argument to \0", 25); i = 25; };
            if (id == 108) { sq_mcpy(@m[i], "median\0", 6); i = i + 6; };
            if (id == 109) { sq_mcpy(@m[i], "percentile\0", 10); i = i + 10; };
            if (id == 110) { sq_mcpy(@m[i], "percentile_cont\0", 15); i = i + 15; };
            if (id == 111) { sq_mcpy(@m[i], "percentile_disc\0", 15); i = i + 15; };
            if (kind == 0) { sq_mcpy(@m[i], "() is not numeric\0", 18); i = i + 18; };
            if (kind == 1)
            {
                if (id == 109) { sq_mcpy(@m[i], "() is not between 0.0 and 100.0\0", 32); i = i + 32; }
                else { sq_mcpy(@m[i], "() is not between 0.0 and 1.0\0", 30); i = i + 30; };
            };
            if (kind == 2) { sq_mcpy(@m[i], "() is not the same for all input rows\0", 38); i = i + 38; };
            m[i] = (byte)0;
            sq_seterr(st, @m[0]);
        };

        // one input row; x is the value, pv the fraction (ignored for median); returns 1 on error
        def sq_pct_step(SQ_STMT* st, SQ_BLK* b, SQ_ACC* ac, int id, SQ_VAL* x, SQ_VAL* pv) -> int
        {
            SQ_VAL n0;
            double rp, dv;
            int w;
            byte* nb;
            double* dp;
            rp = 0.5;
            if (id != 108)
            {
                if (sq_numtype(pv, @n0) == 0) { sq_pct_err(st, id, 1); return 1; };
                if (n0.t == SQ_INTEGER) { rp = (double)n0.i; } else { rp = n0.r; };
                if (id == 109)
                {
                    if (rp < 0.0 | rp > 100.0) { sq_pct_err(st, id, 1); return 1; };
                    rp = rp / 100.0;
                }
                else
                {
                    if (rp < 0.0 | rp > 1.0) { sq_pct_err(st, id, 1); return 1; };
                };
            };
            if (ac.seen == 1)
            {
                if (ac.sr != rp) { sq_pct_err(st, id, 2); return 1; };
            }
            else { ac.seen = 1; ac.sr = rp; };
            if (x.t == SQ_NULL) { return 0; };
            if (x.t != SQ_INTEGER & x.t != SQ_REAL) { sq_pct_err(st, id, 0); return 1; };
            dv = sq_as_double(x);
            if (ac.gcn + 8 > ac.gccap)
            {
                w = ac.gccap * 2;
                if (w < ac.gcn + 8) { w = ac.gcn + 8 + 256; };
                nb = sq_ar_alloc(@b.gar, w);
                if ((u64)nb == (u64)0) { sq_seterr(st, "out of memory\0"); return 1; };
                if (ac.gcn > 0) { sq_mcpy(nb, ac.gc, ac.gcn); };
                ac.gc = nb;
                ac.gccap = w;
            };
            dp = (double*)@ac.gc[ac.gcn];
            *dp = dv;
            ac.gcn = ac.gcn + 8;
            ac.n = ac.n + (i64)1;
            return 0;
        };

        def sq_pct_final(SQ_ACC* ac, int id, SQ_VAL* out) -> void
        {
            double* a;
            double t, ix, v1, v2;
            int n, i, j, gap, i1, i2;
            if (ac.n == (i64)0) { sq_val_null(out); return; };
            a = (double*)ac.gc;
            n = (int)ac.n;
            gap = n / 2;
            while (gap > 0)
            {
                for (i = gap; i < n; i++)
                {
                    t = a[i];
                    j = i;
                    while (j >= gap)
                    {
                        if (a[j - gap] > t) { a[j] = a[j - gap]; j = j - gap; } else { break; };
                    };
                    a[j] = t;
                };
                gap = gap / 2;
            };
            ix = ac.sr * (double)(n - 1);
            i1 = (int)ix;
            if (id == 111) { sq_val_real(out, a[i1]); return; };
            i2 = i1 + 1;
            if (ix == (double)i1 | i1 == n - 1) { i2 = i1; };
            v1 = a[i1];
            v2 = a[i2];
            sq_val_real(out, v1 + (v2 - v1) * (ix - (double)i1));
        };

        def sq_acc_feed(SQ_STMT* st, SQ_BLK* b, SQ_ACC* ac, int id, SQ_VAL* x, SQ_VAL* sep, int coll) -> int;

        // ---- aggregates with ORDER BY: rows of (keys..., arg0, arg1) are kept and replayed in order ----

        def sq_ord_cmp(SQ_STMT* st, int tn, int nk, SQ_VAL* r1, SQ_VAL* r2) -> int
        {
            int t, c, fl, nfirst, ni;
            SQ_VAL* x;
            SQ_VAL* y;
            ni = tn;
            for (t = 0; t < nk; t++)
            {
                x = @r1[t];
                y = @r2[t];
                fl = st.nodes[ni].oflg;
                nfirst = 0;
                if ((fl `& 2) != 0) { nfirst = 1; };
                if ((fl `& 6) == 0 & (fl `& 1) == 0) { nfirst = 1; };
                if (x.t == SQ_NULL & y.t == SQ_NULL) { ni = st.nodes[ni].next; continue; };
                if (x.t == SQ_NULL) { if (nfirst == 1) { return 0 - 1; }; return 1; };
                if (y.t == SQ_NULL) { if (nfirst == 1) { return 1; }; return 0 - 1; };
                c = sq_val_cmpc(x, y, sq_ecoll(st, ni));
                if ((fl `& 1) != 0) { c = 0 - c; };
                if (c != 0) { return c; };
                ni = st.nodes[ni].next;
            };
            return 0;
        };

        def sq_ord_flush(SQ_STMT* st, SQ_BLK* b, SQ_ACC* ac, int ni) -> int
        {
            SQ_NODE* nd = @st.nodes[ni];
            int nk, kk, n, i, j, w, wd, m, a0, c, id, star, argc;
            int* idx;
            int* tmp;
            SQ_VAL* x;
            SQ_VAL* y;
            SQ_VAL sepv;
            if (ac.obn == 0) { return 0; };
            nk = 0;
            c = nd.b;
            while (c >= 0) { nk++; c = st.nodes[c].next; };
            kk = nk + 2;
            n = ac.obn;
            idx = (int*)fmalloc((u64)n * (u64)4);
            tmp = (int*)fmalloc((u64)n * (u64)4);
            if ((u64)idx == (u64)0 | (u64)tmp == (u64)0) { return 1; };
            for (i = 0; i < n; i++) { idx[i] = i; };
            w = 1;
            while (w < n)
            {
                i = 0;
                while (i < n)
                {
                    m = i + w;
                    if (m > n) { m = n; };
                    wd = i + 2 * w;
                    if (wd > n) { wd = n; };
                    a0 = i; j = m; c = i;
                    while (a0 < m & j < wd)
                    {
                        if (sq_ord_cmp(st, nd.b, nk, @ac.ob[idx[j] * kk], @ac.ob[idx[a0] * kk]) < 0) { tmp[c] = idx[j]; j++; } else { tmp[c] = idx[a0]; a0++; };
                        c++;
                    };
                    while (a0 < m) { tmp[c] = idx[a0]; a0++; c++; };
                    while (j < wd) { tmp[c] = idx[j]; j++; c++; };
                    i = i + 2 * w;
                };
                for (i = 0; i < n; i++) { idx[i] = tmp[i]; };
                w = w * 2;
            };
            id = nd.col;
            argc = (int)nd.iv;
            for (i = 0; i < n; i++)
            {
                x = @ac.ob[idx[i] * kk + nk];
                y = @ac.ob[idx[i] * kk + nk + 1];
                if (id >= 108 & id <= 111)
                {
                    if (sq_pct_step(st, b, ac, id, x, y) != 0) { ffree((u64)idx); ffree((u64)tmp); return 1; };
                    continue;
                };
                if (id >= 112 & id <= 115)
                {
                    if (sq_jagg_step(st, b, ac, id, x, y) != 0) { ffree((u64)idx); ffree((u64)tmp); return 1; };
                    continue;
                };
                if (x.t == SQ_NULL) { continue; };
                sepv.t = SQ_TEXT; sepv.p = ","; sepv.n = 1; sepv.i = (i64)0; sepv.r = 0.0;
                if (argc >= 2) { sq_val_copy(@sepv, y); };
                if (sq_acc_feed(st, b, ac, id, x, @sepv, sq_ecoll(st, nd.a)) != 0) { ffree((u64)idx); ffree((u64)tmp); return 1; };
            };
            ffree((u64)idx);
            ffree((u64)tmp);
            ffree((u64)ac.ob);
            ac.ob = (SQ_VAL*)0;
            ac.obn = 0;
            ac.obcap = 0;
            return 0;
        };

        def sq_ord_add(SQ_STMT* st, SQ_BLK* b, SQ_ACC* ac, SQ_NODE* nd, SQ_VAL* x, SQ_VAL* y) -> int
        {
            int nk, kk, c, cap;
            SQ_VAL* row;
            SQ_VAL* nb;
            SQ_VAL kv;
            nk = 0;
            c = nd.b;
            while (c >= 0) { nk++; c = st.nodes[c].next; };
            kk = nk + 2;
            if (ac.obn >= ac.obcap)
            {
                cap = ac.obcap * 2;
                if (cap < 16) { cap = 16; };
                nb = (SQ_VAL*)fmalloc((u64)cap * (u64)kk * (u64)sizeof(SQ_VAL));
                if ((u64)nb == (u64)0) { return 1; };
                if (ac.obn > 0) { sq_mcpy((byte*)nb, (byte*)ac.ob, ac.obn * kk * sq_vsz()); };
                if ((u64)ac.ob != (u64)0) { ffree((u64)ac.ob); };
                ac.ob = nb;
                ac.obcap = cap;
            };
            row = @ac.ob[ac.obn * kk];
            c = nd.b;
            nk = 0;
            while (c >= 0)
            {
                sq_eval(st, b, c, @kv);
                sq_val_copy(@row[nk], @kv);
                sq_val_own(@b.gar, @row[nk]);
                nk++;
                c = st.nodes[c].next;
            };
            sq_val_copy(@row[nk], x);
            sq_val_own(@b.gar, @row[nk]);
            sq_val_copy(@row[nk + 1], y);
            sq_val_own(@b.gar, @row[nk + 1]);
            ac.obn++;
            return 0;
        };

        def sq_agg_update(SQ_STMT* st, SQ_BLK* b, SQ_GRP* g, SQ_SET* gs) -> int
        {
            int k, id, an, w, c, sl, argc, star;
            SQ_NODE* nd;
            SQ_ACC* ac;
            SQ_VAL x, y, t;
            byte* nb;
            for (k = 0; k < b.nagg; k++)
            {
                nd = @st.nodes[b.aggn[k]];
                ac = @g.acc[k];
                id = nd.col;
                argc = (int)nd.iv;
                star = 0;
                if (nd.op == 2) { star = 1; };
                if (nd.c >= 0)
                {
                    sq_eval(st, b, nd.c, @x);
                    if (sq_truth(@x) != 1) { continue; };
                };
                if (id == 100 & star == 1) { ac.n = ac.n + (i64)1; continue; };
                if (nd.b >= 0)
                {
                    sq_eval(st, b, nd.a, @x);
                    sq_val_null(@y);
                    if (argc >= 2) { sq_eval(st, b, st.nodes[nd.a].next, @y); };
                    if (nd.op == 1 & x.t != SQ_NULL)
                    {
                        if ((u64)ac.dset == (u64)0)
                        {
                            ac.dset = (SQ_SET*)fmalloc((u64)sizeof(SQ_SET));
                            if ((u64)ac.dset == (u64)0) { return 1; };
                            sq_set_init(ac.dset, 1);
                        };
                        if (sq_set_add(ac.dset, @x) < 0) { return 1; };
                        if (ac.dset.isnew == 0) { continue; };
                    };
                    if (sq_ord_add(st, b, ac, nd, @x, @y) != 0) { return 1; };
                    continue;
                };
                if (id >= 108 & id <= 111)
                {
                    sq_eval(st, b, nd.a, @x);
                    sq_val_null(@y);
                    if (id >= 109) { sq_eval(st, b, st.nodes[nd.a].next, @y); };
                    if (nd.op == 1 & x.t != SQ_NULL)
                    {
                        if ((u64)ac.dset == (u64)0)
                        {
                            ac.dset = (SQ_SET*)fmalloc((u64)sizeof(SQ_SET));
                            if ((u64)ac.dset == (u64)0) { return 1; };
                            sq_set_init(ac.dset, 1);
                        };
                        if (sq_set_add(ac.dset, @x) < 0) { return 1; };
                        if (ac.dset.isnew == 0) { continue; };
                    };
                    if (sq_pct_step(st, b, ac, id, @x, @y) != 0) { return 1; };
                    continue;
                };
                if (id >= 112 & id <= 115)
                {
                    sq_eval(st, b, nd.a, @x);
                    sq_val_null(@y);
                    if (id >= 114) { sq_eval(st, b, st.nodes[nd.a].next, @y); };
                    if (nd.op == 1)
                    {
                        if ((u64)ac.dset == (u64)0)
                        {
                            ac.dset = (SQ_SET*)fmalloc((u64)sizeof(SQ_SET));
                            if ((u64)ac.dset == (u64)0) { return 1; };
                            sq_set_init(ac.dset, 1);
                        };
                        if (sq_set_add(ac.dset, @x) < 0) { return 1; };
                        if (ac.dset.isnew == 0) { continue; };
                    };
                    if (sq_jagg_step(st, b, ac, id, @x, @y) != 0) { return 1; };
                    continue;
                };
                sq_eval(st, b, nd.a, @x);
                if (x.t == SQ_NULL) { continue; };
                if (nd.op == 1)
                {
                    // DISTINCT aggregate: skip values already seen in this group
                    if ((u64)ac.dset == (u64)0)
                    {
                        ac.dset = (SQ_SET*)fmalloc((u64)sizeof(SQ_SET));
                        if ((u64)ac.dset == (u64)0) { return 1; };
                        sq_set_init(ac.dset, 1);
                    };
                    if (sq_set_add(ac.dset, @x) < 0) { return 1; };
                    if (ac.dset.isnew == 0) { continue; };
                };
                if (id == 100) { ac.n = ac.n + (i64)1; continue; };
                if (id == 101 | id == 102 | id == 103)
                {
                    sq_tonum(@x, @y);
                    if (x.t == SQ_TEXT)
                    {
                        // text that is not wholly a number makes the sum approximate, as in SQLite
                        if (sq_numtext(x.p, x.n, @t) == false) { sq_val_real(@y, sq_as_double(@y)); };
                    };
                    if (x.t == SQ_BLOB) { sq_val_real(@y, sq_as_double(@y)); };
                    ac.n = ac.n + (i64)1;
                    ac.seen = 1;
                    if (y.t == SQ_REAL) { ac.isreal = 1; };
                    if (ac.isreal == 1 | ac.ovf == 1)
                    {
                        if (ac.ovf == 0)
                        {
                            ac.sr = (double)ac.si;
                            ac.ovf = 1;
                        };
                        // Kahan-Babuska-Neumaier summation, as SQLite does
                        {
                            double rr = sq_as_double(@y);
                            double ss = ac.sr;
                            double tt = ss + rr;
                            double fa = ss; double fb = rr;
                            if (fa < 0.0) { fa = 0.0 - fa; };
                            if (fb < 0.0) { fb = 0.0 - fb; };
                            if (fa > fb) { ac.se = ac.se + ((ss - tt) + rr); } else { ac.se = ac.se + ((rr - tt) + ss); };
                            ac.sr = tt;
                        };
                    }
                    else
                    {
                        t.i = ac.si + y.i;
                        if ((ac.si >= (i64)0) == (y.i >= (i64)0) & (t.i >= (i64)0) != (ac.si >= (i64)0))
                        {
                            ac.sr = (double)ac.si + (double)y.i;
                            ac.ovf = 1;
                        }
                        else { ac.si = t.i; };
                    };
                    continue;
                };
                if (id == 104 | id == 105)
                {
                    if (ac.seen == 0)
                    {
                        ac.seen = 1;
                        sq_val_copy(@ac.v, @x);
                        sq_val_own(@b.gar, @ac.v);
                        if (b.nminmax == 1) { for (c = 0; c < 8; c++) { g.rep[c] = b.cur[c]; }; if (sq_snap(st, b, g) != 0) { return 1; }; };
                    }
                    else
                    {
                        c = sq_val_cmpc(@x, @ac.v, sq_ecoll(st, nd.a));
                        if ((id == 104 & c < 0) | (id == 105 & c > 0))
                        {
                            sq_val_copy(@ac.v, @x);
                            sq_val_own(@b.gar, @ac.v);
                            if (b.nminmax == 1) { for (c = 0; c < 8; c++) { g.rep[c] = b.cur[c]; }; if (sq_snap(st, b, g) != 0) { return 1; }; };
                        };
                    };
                    continue;
                };
                if (id == 106 | id == 107)
                {
                    sq_val_text(@b.scr, @x, @y);
                    sl = 1;
                    nb = ",";
                    t.t = SQ_TEXT; t.p = nb; t.n = 1;
                    if (argc == 2)
                    {
                        w = st.nodes[nd.a].next;
                        sq_eval(st, b, w, @t);
                        sq_val_text(@b.scr, @t, @t);
                    };
                    if (t.t == SQ_NULL) { t.t = SQ_TEXT; t.n = 0; };
                    sl = y.n;
                    if (ac.seen == 1) { sl = sl + t.n; };
                    if (ac.gcn + sl + 1 > ac.gccap)
                    {
                        w = ac.gccap * 2;
                        if (w < ac.gcn + sl + 1) { w = ac.gcn + sl + 1 + 64; };
                        nb = sq_ar_alloc(@b.gar, w);
                        if ((u64)nb == (u64)0) { return 1; };
                        if (ac.gcn > 0) { sq_mcpy(nb, ac.gc, ac.gcn); };
                        ac.gc = nb;
                        ac.gccap = w;
                    };
                    if (ac.seen == 1) { sq_mcpy(@ac.gc[ac.gcn], t.p, t.n); ac.gcn = ac.gcn + t.n; };
                    sq_mcpy(@ac.gc[ac.gcn], y.p, y.n);
                    ac.gcn = ac.gcn + y.n;
                    ac.seen = 1;
                };
            };
            return 0;
        };

        // value of aggregate k of a group, built into out
        def sq_agg_final(SQ_STMT* st, SQ_BLK* b, SQ_ACC* ac, int id, SQ_VAL* out) -> void
        {
            if (id == 100) { sq_val_int(out, ac.n); return; };
            if (id == 101)
            {
                if (ac.seen == 0) { sq_val_null(out); return; };
                if (ac.isreal == 1 | ac.ovf == 1) { sq_val_real(out, ac.sr + ac.se); } else { sq_val_int(out, ac.si); };
                return;
            };
            if (id == 102)
            {
                if (ac.seen == 0) { sq_val_real(out, 0.0); return; };
                if (ac.isreal == 1 | ac.ovf == 1) { sq_val_real(out, ac.sr + ac.se); } else { sq_val_real(out, (double)ac.si); };
                return;
            };
            if (id == 103)
            {
                if (ac.seen == 0) { sq_val_null(out); return; };
                if (ac.isreal == 1 | ac.ovf == 1) { sq_val_real(out, (ac.sr + ac.se) / (double)ac.n); } else { sq_val_real(out, (double)ac.si / (double)ac.n); };
                return;
            };
            if (id == 104 | id == 105) { sq_val_copy(out, @ac.v); return; };
            if (id >= 108 & id <= 111) { sq_pct_final(ac, id, out); return; };
            if (id >= 112 & id <= 115) { sq_jagg_final(st, b, ac, id, out); return; };
            if (ac.seen == 0) { sq_val_null(out); return; };
            out.t = SQ_TEXT; out.p = ac.gc; out.n = ac.gcn; out.i = (i64)0; out.r = 0.0;
        };

        def sq_agg_final_n(SQ_STMT* st, SQ_BLK* b, SQ_ACC* ac, int ni, SQ_VAL* out) -> void
        {
            if (st.nodes[ni].b >= 0)
            {
                if (sq_ord_flush(st, b, ac, ni) != 0) { sq_seterr(st, "out of memory\0"); sq_val_null(out); return; };
            };
            sq_agg_final(st, b, ac, st.nodes[ni].col, out);
        };

        def sq_free_groups(SQ_STMT* st, SQ_BLK* b) -> void
        {
            int g, k;
            for (g = 0; g < b.ngroups; g++)
            {
                for (k = 0; k < b.nagg; k++)
                {
                    if ((u64)b.groups[g].acc[k].ob != (u64)0) { ffree((u64)b.groups[g].acc[k].ob); b.groups[g].acc[k].ob = (SQ_VAL*)0; };
                    if ((u64)b.groups[g].acc[k].dset != (u64)0)
                    {
                        sq_set_free(b.groups[g].acc[k].dset);
                        ffree((u64)b.groups[g].acc[k].dset);
                    };
                };
            };
            if ((u64)b.groups != (u64)0) { ffree((u64)b.groups); };
            b.groups = (SQ_GRP*)0;
            b.ngroups = 0;
            b.gcap = 0;
            sq_ar_free(@b.gar);
        };

        // ---- executor: joins ----

        def sq_join(SQ_STMT* st, SQ_BLK* b, int j, SQ_ARM* ar, SQ_SET* gs) -> int;

        def sq_leaf(SQ_STMT* st, SQ_BLK* b, SQ_ARM* ar, SQ_SET* gs) -> int
        {
            SQ_VAL[16] kv;
            int i, gi;
            if (b.has_agg == 1 | b.ngrp > 0)
            {
                for (i = 0; i < b.ngrp; i++) { sq_eval(st, b, b.grp[i], @kv[i]); };
                gi = sq_set_add(gs, @kv[0]);
                if (gi < 0) { ar.err = 1; sq_seterr(st, "out of memory\0"); return 1; };
                if (gs.isnew == 1)
                {
                    if (sq_group_new(st, b, gs, gi) != 0) { ar.err = 1; sq_seterr(st, "out of memory\0"); return 1; };
                };
                if (sq_agg_update(st, b, @b.groups[gi], gs) != 0) { ar.err = 1; sq_seterr(st, "out of memory\0"); return 1; };
                if (b.ngrp == 0 & b.bare == 1 & b.nminmax != 1 & b.groups[gi].snapd == 0)
                {
                    // the implicit group reports bare columns of its first row
                    b.groups[gi].snapd = 1;
                    for (i = 0; i < 8; i++) { b.groups[gi].rep[i] = b.cur[i]; };
                    if (sq_snap(st, b, @b.groups[gi]) != 0) { ar.err = 1; sq_seterr(st, "out of memory\0"); return 1; };
                };
                return 0;
            };
            return sq_emit(st, b, ar);
        };

        def sq_where_upto(SQ_STMT* st, SQ_BLK* b, int j) -> int;

        def sq_join_after(SQ_STMT* st, SQ_BLK* b, int j, SQ_ARM* ar, SQ_SET* gs) -> int
        {
            int w;
            SQ_VAL x;
            if (b.rjmax > 0)
            {
                // with RIGHT or FULL joins no conjunct may filter before the last such join has produced its rows
                if (j < b.rjmax) { return sq_join(st, b, j + 1, ar, gs); };
                if (sq_where_upto(st, b, j) != 0) { return 0; };
                return sq_join(st, b, j + 1, ar, gs);
            };
            for (w = 0; w < b.nwc; w++)
            {
                if (b.wcl[w] != j) { continue; };
                sq_eval(st, b, b.wcn[w], @x);
                if (sq_truth(@x) != 1) { return 0; };
            };
            return sq_join(st, b, j + 1, ar, gs);
        };

        // 0 when every conjunct that belongs to the sources 0..j holds
        def sq_where_upto(SQ_STMT* st, SQ_BLK* b, int j) -> int
        {
            int w;
            SQ_VAL x;
            for (w = 0; w < b.nwc; w++)
            {
                if (b.wcl[w] < 0 | b.wcl[w] > j) { continue; };
                sq_eval(st, b, b.wcn[w], @x);
                if (sq_truth(@x) != 1) { return 1; };
            };
            return 0;
        };

        // rows of RIGHT and FULL joined sources that never matched, joined to NULL rows on the left
        def sq_join_right_pass(SQ_STMT* st, SQ_BLK* b, SQ_ARM* ar, SQ_SET* gs) -> int
        {
            SQ_SRC* sr;
            byte* fl;
            int jr, i, k, rc;
            for (jr = 1; jr < b.nsrc; jr++)
            {
                sr = @b.src[jr];
                if (sr.jt < 4) { continue; };
                fl = (byte*)b.rfl[jr];
                if ((u64)fl == (u64)0) { continue; };
                for (i = 0; i < sr.rs.n; i++)
                {
                    if (fl[i] != (byte)0) { continue; };
                    for (k = 0; k < jr; k++) { b.cur[k] = 0 - 1; };
                    b.cur[jr] = i;
                    sq_ar_reset(@b.scr);
                    if (jr == b.rjmax) { if (sq_where_upto(st, b, jr) != 0) { continue; }; };
                    rc = sq_join(st, b, jr + 1, ar, gs);
                    if (rc != 0) { return rc; };
                };
            };
            return 0;
        };

        def sq_join_one(SQ_STMT* st, SQ_BLK* b, int j, SQ_ARM* ar, SQ_SET* gs, int* matched) -> int
        {
            SQ_SRC* sr = @b.src[j];
            SQ_VAL x, y;
            int u, ls, lr, k2, u2;
            SQ_SRC* ol;
            SQ_RS* lrs;
            if (j > 0)
            {
                if (sr.on >= 0)
                {
                    sq_eval(st, b, sr.on, @x);
                    if (sq_truth(@x) != 1) { return 0; };
                };
                for (u = 0; u < sr.nusing; u++)
                {
                    ls = sr.uls[u];
                    ol = @b.src[ls];
                    lrs = ol.rs;
                    lr = b.cur[ls];
                    sq_val_null(@x);
                    if (lr >= 0) { sq_val_copy(@x, @lrs.d[lr * lrs.nc + sr.ulc[u]]); };
                    if (x.t == SQ_NULL)
                    {
                        // the merged column of earlier RIGHT / FULL joins
                        for (k2 = 1; k2 < j; k2++)
                        {
                            ol = @b.src[k2];
                            if (ol.jt < 4) { continue; };
                            for (u2 = 0; u2 < ol.nusing; u2++)
                            {
                                if (ol.uls[u2] == ls & ol.ulc[u2] == sr.ulc[u] & b.cur[k2] >= 0)
                                {
                                    sq_val_copy(@x, @ol.rs.d[b.cur[k2] * ol.rs.nc + ol.urc[u2]]);
                                };
                            };
                        };
                    };
                    if (lr < 0 & x.t == SQ_NULL) { return 0; };
                    sq_val_copy(@y, @sr.rs.d[b.cur[j] * sr.rs.nc + sr.urc[u]]);
                    if (x.t == SQ_NULL | y.t == SQ_NULL) { return 0; };
                    if (sq_val_cmpc(@x, @y, 0) != 0) { return 0; };
                };
            };
            *matched = 1;
            return sq_join_after(st, b, j, ar, gs);
        };

        // Planner for the first source of a block: an equality between one of its columns and a constant narrows the scan to the
        // matching rows (rowid / integer primary key seek, or a scan of the matching index entries). The WHERE clause is still
        // evaluated on every row that is produced, so the plan only has to return a superset of the matching rows.
        // Returns -1 when no plan applies, otherwise the result of the scan.
        // loads the record of a WITHOUT ROWID table entry found by an index cursor into the table cursor
        def sq_wor_load_entry(SQ_CURSOR* cur, SQ_ICUR* ic) -> int
        {
            if (sq_payload_reserve(cur, ic.plen + 8) != 0) { return 1; };
            sq_mcpy(cur.payload, ic.pay, ic.plen);
            cur.plen = ic.plen;
            if (sq_parse_record(cur) != 0) { return 1; };
            cur.rowid = (i64)0;
            return 0;
        };

        def sq_scan0_planned(SQ_STMT* st, SQ_BLK* b, SQ_SRC* sr, SQ_RS* rs, SQ_ARM* ar, SQ_SET* gs) -> int
        {
            SQ_NODE* nd;
            SQ_NODE* na;
            SQ_NODE* nb;
            SQ_NODE* cn;
            SQ_NODE* kn;
            SQ_ARENA pa;
            SQ_VAL probe;
            SQ_IDX[20] ixs;
            SQ_IDX pkx;
            SQ_ICUR icur;
            SQ_ICUR icur2;
            SQ_VAL[16] pkv;
            int w, colx, kx, n, k, ix, rc, ok, matched, mode, eq;
            i64 rid;
            if (sr.kind != 1 | sr.tbl < 0 | (u64)sr.ti == (u64)0) { return 0 - 1; };
            if (b.rjmax > 0) { return 0 - 1; };
            colx = 0 - 1;
            kx = 0 - 1;
            for (w = 0; w < b.nwc; w++)
            {
                if (b.wcl[w] != 0) { continue; };
                nd = @st.nodes[b.wcn[w]];
                if (nd.kind != SQN_BIN | nd.op != SQO_EQ) { continue; };
                na = @st.nodes[nd.a];
                nb = @st.nodes[nd.b];
                cn = (SQ_NODE*)0;
                kn = (SQ_NODE*)0;
                if (na.kind == SQN_COL & na.src == 0 & na.lvl == 0)
                {
                    if (nb.kind == SQN_INT | nb.kind == SQN_REAL | nb.kind == SQN_STR | nb.kind == SQN_PARAM) { cn = na; kn = nb; kx = nd.b; };
                };
                if ((u64)cn == (u64)0)
                {
                    if (nb.kind == SQN_COL & nb.src == 0 & nb.lvl == 0)
                    {
                        if (na.kind == SQN_INT | na.kind == SQN_REAL | na.kind == SQN_STR | na.kind == SQN_PARAM) { cn = nb; kn = na; kx = nd.a; };
                    };
                };
                if ((u64)cn == (u64)0) { continue; };
                colx = cn.col;
                break;
            };
            if (colx < 0) { return 0 - 1; };
            sq_ar_init(@pa);
            sq_eval(st, b, kx, @probe);
            if (probe.t == SQ_NULL) { return 0 - 1; };
            // the constant is converted by the affinity of the column, as in a comparison
            k = sr.ti.aff[0];
            if (colx < sr.ti.ncols) { k = sr.ti.aff[colx]; };
            if (colx == sr.ti.ncols) { k = 3; };
            if (probe.t == SQ_TEXT & k >= 2) { sq_apply_aff(@pa, 2, @probe); };
            if ((probe.t == SQ_INTEGER | probe.t == SQ_REAL) & k == 1) { sq_apply_aff(@pa, 1, @probe); };
            if (probe.t == SQ_TEXT | probe.t == SQ_BLOB)
            {
                kn = (SQ_NODE*)0;
                // keep the bytes beyond the per-row reset of the scratch arena
                {
                    byte* cp = sq_ar_copy(@pa, probe.p, probe.n);
                    if ((u64)cp == (u64)0) { sq_ar_free(@pa); return 0 - 1; };
                    probe.p = cp;
                };
            };
            matched = 0;
            mode = 0;
            if (colx == sr.ti.ncols | colx == sr.ti.ipk)
            {
                if (probe.t == SQ_INTEGER) { rid = probe.i; mode = 1; };
                if (probe.t == SQ_REAL)
                {
                    rid = (i64)probe.r;
                    if ((double)rid == probe.r) { mode = 1; };
                };
                if (mode == 0) { sq_ar_free(@pa); return 0 - 1; };
                sq_cur_open(@b.scur, sr.sdb, sr.root);
                b.cur[0] = 0;
                rc = sq_cur_seek(@b.scur, rid);
                if (rc == 1)
                {
                    sq_ar_reset(@rs.ar);
                    sq_ar_reset(@b.scr);
                    sq_fill_row(st, sr, @b.scur, rs, @rs.d[0]);
                    rc = sq_join_one(st, b, 0, ar, gs, @matched);
                }
                else { if (rc < 0) { rc = 1; } else { rc = 0; }; };
                sq_cur_close(@b.scur);
                sq_ar_free(@pa);
                return rc;
            };
            if (sr.ti.wor == 1 & sr.ti.npk >= 1 & colx == sr.ti.pkc[0])
            {
                // a WITHOUT ROWID table is its own primary key index
                if (sr.ti.pkcl[0] != sr.ti.coll[colx]) { sq_ar_free(@pa); return 0 - 1; };
                pkx.root = sr.root; pkx.nk = sr.ti.npk; pkx.ncmp = sr.ti.npk;
                for (k = 0; k < sr.ti.npk; k++)
                {
                    pkx.col[k] = sr.ti.pkc[k]; pkx.desc[k] = sr.ti.pkd[k]; pkx.coll[k] = sr.ti.pkcl[k]; pkx.isx[k] = 0;
                };
                sq_cur_open(@b.scur, sr.sdb, sr.root);
                sq_icur_open(@icur, sr.sdb, @pkx);
                b.cur[0] = 0;
                rc = 0;
                ok = sq_icur_seek(@icur, @probe, 1, 0);
                while (ok == 1)
                {
                    eq = sq_val_cmpc(@icur.v[0], @probe, pkx.coll[0]);
                    if (eq != 0) { break; };
                    if (sq_wor_load_entry(@b.scur, @icur) != 0) { rc = 1; break; };
                    sq_ar_reset(@rs.ar);
                    sq_ar_reset(@b.scr);
                    sq_fill_row(st, sr, @b.scur, rs, @rs.d[0]);
                    rc = sq_join_one(st, b, 0, ar, gs, @matched);
                    if (rc != 0) { break; };
                    ok = sq_icur_next(@icur);
                };
                if (ok < 0 & rc == 0) { rc = 1; };
                sq_icur_close(@icur);
                sq_cur_close(@b.scur);
                sq_ar_free(@pa);
                return rc;
            };
            n = sq_idx_list(sr.sdb, sr.tbl, sr.ti, @ixs[0], 20);
            ix = 0 - 1;
            if (sr.ti.wor == 1)
            {
                // a secondary index of a WITHOUT ROWID table: its entries end with the primary key of the row
                for (k = 0; k < n; k++)
                {
                    if (ixs[k].wok != 1 | ixs[k].partial != 0 | ixs[k].ne != 0 | ixs[k].nk < 1) { continue; };
                    if (ixs[k].isx[0] != 0 | ixs[k].col[0] != colx) { continue; };
                    if (ixs[k].coll[0] != sr.ti.coll[colx]) { continue; };
                    ix = k;
                    break;
                };
                if (ix < 0) { sq_ar_free(@pa); return 0 - 1; };
                pkx.root = sr.root; pkx.nk = sr.ti.npk; pkx.ncmp = sr.ti.npk;
                for (k = 0; k < sr.ti.npk; k++)
                {
                    pkx.col[k] = sr.ti.pkc[k]; pkx.desc[k] = sr.ti.pkd[k]; pkx.coll[k] = sr.ti.pkcl[k]; pkx.isx[k] = 0;
                };
                sq_cur_open(@b.scur, sr.sdb, sr.root);
                sq_icur_open(@icur, sr.sdb, @ixs[ix]);
                sq_icur_open(@icur2, sr.sdb, @pkx);
                b.cur[0] = 0;
                rc = 0;
                ok = sq_icur_seek(@icur, @probe, 1, 0);
                while (ok == 1)
                {
                    eq = sq_val_cmpc(@icur.v[0], @probe, ixs[ix].coll[0]);
                    if (eq != 0) { break; };
                    // key of the table row, taken from the entry
                    for (w = 0; w < sr.ti.npk; w++)
                    {
                        kx = 0 - 1;
                        for (mode = 0; mode < ixs[ix].ntl; mode++) { if (ixs[ix].tlc[mode] == sr.ti.pkc[w]) { kx = ixs[ix].nk + mode; }; };
                        if (kx < 0) { for (mode = 0; mode < ixs[ix].nk; mode++) { if (ixs[ix].isx[mode] == 0 & ixs[ix].col[mode] == sr.ti.pkc[w]) { kx = mode; }; }; };
                        if (kx < 0 | kx >= icur.nv) { sq_val_null(@pkv[w]); } else { sq_val_copy(@pkv[w], @icur.v[kx]); };
                    };
                    matched = 0;
                    k = sq_icur_seek(@icur2, @pkv[0], sr.ti.npk, 0);
                    if (k < 0) { rc = 1; break; };
                    if (k == 1)
                    {
                        if (sq_icmp(@pkx, @icur2.v[0], icur2.nv, @pkv[0], sr.ti.npk) == 0)
                        {
                            if (sq_wor_load_entry(@b.scur, @icur2) != 0) { rc = 1; break; };
                            sq_ar_reset(@rs.ar);
                            sq_ar_reset(@b.scr);
                            sq_fill_row(st, sr, @b.scur, rs, @rs.d[0]);
                            rc = sq_join_one(st, b, 0, ar, gs, @matched);
                            if (rc != 0) { break; };
                        };
                    };
                    ok = sq_icur_next(@icur);
                };
                if (ok < 0 & rc == 0) { rc = 1; };
                sq_icur_close(@icur);
                sq_icur_close(@icur2);
                sq_cur_close(@b.scur);
                sq_ar_free(@pa);
                return rc;
            };
            for (k = 0; k < n; k++)
            {
                if (ixs[k].ok != 1 | ixs[k].nk < 1) { continue; };
                if (ixs[k].col[0] != colx) { continue; };
                if (ixs[k].coll[0] != sr.ti.coll[colx]) { continue; };
                ix = k;
                break;
            };
            if (ix < 0) { sq_ar_free(@pa); return 0 - 1; };
            sq_cur_open(@b.scur, sr.sdb, sr.root);
            sq_icur_open(@icur, sr.sdb, @ixs[ix]);
            b.cur[0] = 0;
            rc = 0;
            ok = sq_icur_seek(@icur, @probe, 1, 0);
            while (ok == 1)
            {
                eq = sq_val_cmpc(@icur.v[0], @probe, ixs[ix].coll[0]);
                if (eq != 0) { break; };
                if (sq_cur_seek(@b.scur, sq_icur_rowid(@icur)) == 1)
                {
                    sq_ar_reset(@rs.ar);
                    sq_ar_reset(@b.scr);
                    sq_fill_row(st, sr, @b.scur, rs, @rs.d[0]);
                    rc = sq_join_one(st, b, 0, ar, gs, @matched);
                    if (rc != 0) { break; };
                };
                ok = sq_icur_next(@icur);
            };
            if (ok < 0 & rc == 0) { rc = 1; };
            sq_icur_close(@icur);
            sq_cur_close(@b.scur);
            sq_ar_free(@pa);
            return rc;
        };


        // Evaluates a constant bound for the column colx and converts it the way a comparison with that column would. Returns 1
        // when the value cannot be used to position an index (NULL, or a type the index order would not agree with).
        def sq_plan_probe(SQ_STMT* st, SQ_BLK* b, SQ_SRC* sr, int colx, int kx, SQ_ARENA* pa, SQ_VAL* probe) -> int
        {
            int k;
            sq_eval(st, b, kx, probe);
            if (probe.t == SQ_NULL) { return 1; };
            k = sr.ti.aff[0];
            if (colx < sr.ti.ncols) { k = sr.ti.aff[colx]; };
            if (colx == sr.ti.ncols) { k = 3; };
            if (probe.t == SQ_TEXT & k >= 2) { sq_apply_aff(pa, 2, probe); };
            if ((probe.t == SQ_INTEGER | probe.t == SQ_REAL) & k == 1) { sq_apply_aff(pa, 1, probe); };
            if (probe.t == SQ_TEXT | probe.t == SQ_BLOB)
            {
                byte* cp = sq_ar_copy(pa, probe.p, probe.n);
                if ((u64)cp == (u64)0) { return 1; };
                probe.p = cp;
            };
            return 0;
        };

        // The column of source 0 a node refers to, or -1
        def sq_plan_col(SQ_STMT* st, int n) -> int
        {
            SQ_NODE* nd = @st.nodes[n];
            if (nd.kind == SQN_COL & nd.src == 0 & nd.lvl == 0) { return nd.col; };
            return 0 - 1;
        };

        def sq_plan_const(SQ_STMT* st, int n) -> bool
        {
            int k = st.nodes[n].kind;
            return k == SQN_INT | k == SQN_REAL | k == SQN_STR | k == SQN_PARAM;
        };

        // Range, BETWEEN and IN lookups on the rowid or on an index. Like the equality plan this only has to produce a superset of
        // the rows (the WHERE clause is evaluated again for each one) in the order SQLite's index scan would give them.
        def sq_scan0_range(SQ_STMT* st, SQ_BLK* b, SQ_SRC* sr, SQ_RS* rs, SQ_ARM* ar, SQ_SET* gs) -> int
        {
            SQ_NODE* nd;
            SQ_ARENA pa;
            SQ_VAL lo, hi, cur0;
            SQ_VAL[32] lst;
            SQ_IDX[20] ixs;
            SQ_ICUR icur;
            int w, colx, n, k, ix, rc, ok, matched, haslo, hasi, loinc, hiinc, lonode, hinode, inhead, nin, i, j, cm, isrow, t, e;
            int a, c1;
            i64 rid;
            if (sr.kind != 1 | sr.tbl < 0 | (u64)sr.ti == (u64)0) { return 0 - 1; };
            if (b.rjmax > 0 | sr.ti.wor == 1 | SQ_NORANGE == 1) { return 0 - 1; };
            colx = 0 - 1; lonode = 0 - 1; hinode = 0 - 1; inhead = 0 - 1; loinc = 0; hiinc = 0;
            n = sq_idx_list(sr.sdb, sr.tbl, sr.ti, @ixs[0], 20);
            // pick the first conjunct that constrains a column with an index (or the rowid)
            for (w = 0; w < b.nwc; w++)
            {
                if (b.wcl[w] != 0) { continue; };
                nd = @st.nodes[b.wcn[w]];
                c1 = 0 - 1;
                if (nd.kind == SQN_BETWEEN & nd.op != 2) { if (sq_plan_const(st, nd.b) & sq_plan_const(st, nd.c)) { c1 = sq_plan_col(st, nd.a); }; };
                if (nd.kind == SQN_IN & nd.op != 2 & nd.blk < 0 & nd.b >= 0)
                {
                    c1 = sq_plan_col(st, nd.a);
                    k = nd.b;
                    while (k >= 0) { if (sq_plan_const(st, k) == false) { c1 = 0 - 1; }; k = st.nodes[k].next; };
                };
                if (nd.kind == SQN_BIN)
                {
                    if (nd.op == SQO_LT | nd.op == SQO_LE | nd.op == SQO_GT | nd.op == SQO_GE)
                    {
                        if (sq_plan_col(st, nd.a) >= 0 & sq_plan_const(st, nd.b)) { c1 = sq_plan_col(st, nd.a); };
                        if (c1 < 0) { if (sq_plan_col(st, nd.b) >= 0 & sq_plan_const(st, nd.a)) { c1 = sq_plan_col(st, nd.b); }; };
                    };
                };
                if (c1 < 0) { continue; };
                if (c1 == sr.ti.ncols | c1 == sr.ti.ipk) { colx = c1; break; };
                for (k = 0; k < n; k++)
                {
                    if (ixs[k].ok != 1 | ixs[k].nk < 1) { continue; };
                    if (ixs[k].col[0] != c1) { continue; };
                    if (ixs[k].coll[0] != sr.ti.coll[c1]) { continue; };
                    colx = c1;
                    break;
                };
                if (colx >= 0) { break; };
            };
            if (colx < 0) { return 0 - 1; };
            // collect the bounds of that column from all conjuncts
            nin = 0;
            for (w = 0; w < b.nwc; w++)
            {
                if (b.wcl[w] != 0) { continue; };
                nd = @st.nodes[b.wcn[w]];
                if (nd.kind == SQN_BETWEEN & nd.op != 2)
                {
                    if (sq_plan_col(st, nd.a) == colx & sq_plan_const(st, nd.b) & sq_plan_const(st, nd.c))
                    {
                        if (lonode < 0) { lonode = nd.b; loinc = 1; };
                        if (hinode < 0) { hinode = nd.c; hiinc = 1; };
                    };
                };
                if (nd.kind == SQN_IN & nd.op != 2 & nd.blk < 0 & nd.b >= 0 & inhead < 0)
                {
                    if (sq_plan_col(st, nd.a) == colx)
                    {
                        e = 1;
                        k = nd.b;
                        while (k >= 0) { if (sq_plan_const(st, k) == false) { e = 0; }; k = st.nodes[k].next; };
                        if (e == 1) { inhead = nd.b; };
                    };
                };
                if (nd.kind == SQN_BIN)
                {
                    if (nd.op == SQO_LT | nd.op == SQO_LE | nd.op == SQO_GT | nd.op == SQO_GE)
                    {
                        a = 0 - 1;
                        if (sq_plan_col(st, nd.a) == colx & sq_plan_const(st, nd.b))
                        {
                            // col OP const
                            if (nd.op == SQO_GT | nd.op == SQO_GE) { if (lonode < 0) { lonode = nd.b; loinc = 0; if (nd.op == SQO_GE) { loinc = 1; }; }; }
                            else { if (hinode < 0) { hinode = nd.b; hiinc = 0; if (nd.op == SQO_LE) { hiinc = 1; }; }; };
                        }
                        else
                        {
                            if (sq_plan_col(st, nd.b) == colx & sq_plan_const(st, nd.a))
                            {
                                // const OP col is col (flipped OP) const
                                if (nd.op == SQO_LT | nd.op == SQO_LE) { if (lonode < 0) { lonode = nd.a; loinc = 0; if (nd.op == SQO_LE) { loinc = 1; }; }; }
                                else { if (hinode < 0) { hinode = nd.a; hiinc = 0; if (nd.op == SQO_GE) { hiinc = 1; }; }; };
                            };
                        };
                    };
                };
            };
            if (lonode < 0 & hinode < 0 & inhead < 0) { return 0 - 1; };
            isrow = 0;
            if (colx == sr.ti.ncols | colx == sr.ti.ipk) { isrow = 1; };
            ix = 0 - 1;
            if (isrow == 0)
            {
                for (k = 0; k < n; k++)
                {
                    if (ixs[k].ok != 1 | ixs[k].nk < 1) { continue; };
                    if (ixs[k].col[0] != colx) { continue; };
                    if (ixs[k].coll[0] != sr.ti.coll[colx]) { continue; };
                    ix = k;
                    break;
                };
                if (ix < 0) { return 0 - 1; };
            };
            sq_ar_init(@pa);
            haslo = 0; hasi = 0;
            if (inhead < 0)
            {
                if (lonode >= 0) { if (sq_plan_probe(st, b, sr, colx, lonode, @pa, @lo) != 0) { sq_ar_free(@pa); return 0 - 1; }; haslo = 1; };
                if (hinode >= 0) { if (sq_plan_probe(st, b, sr, colx, hinode, @pa, @hi) != 0) { sq_ar_free(@pa); return 0 - 1; }; hasi = 1; };
            }
            else
            {
                k = inhead;
                while (k >= 0)
                {
                    if (nin >= 32) { sq_ar_free(@pa); return 0 - 1; };
                    if (sq_plan_probe(st, b, sr, colx, k, @pa, @lst[nin]) != 0) { sq_ar_free(@pa); return 0 - 1; };
                    nin++;
                    k = st.nodes[k].next;
                };
                // ascending and without duplicates, like SQLite's IN operator
                for (i = 1; i < nin; i++)
                {
                    cur0 = lst[i];
                    j = i - 1;
                    while (j >= 0)
                    {
                        if (sq_val_cmpc(@lst[j], @cur0, 0) > 0) { lst[j + 1] = lst[j]; j--; } else { break; };
                    };
                    lst[j + 1] = cur0;
                };
            };
            matched = 0;
            rc = 0;
            if (isrow == 1)
            {
                // integer keys only: anything else is left to the full scan
                if (inhead < 0)
                {
                    if (haslo == 1) { if (lo.t != SQ_INTEGER) { sq_ar_free(@pa); return 0 - 1; }; };
                    if (hasi == 1) { if (hi.t != SQ_INTEGER) { sq_ar_free(@pa); return 0 - 1; }; };
                }
                else { for (i = 0; i < nin; i++) { if (lst[i].t != SQ_INTEGER) { sq_ar_free(@pa); return 0 - 1; }; }; };
                sq_cur_open(@b.scur, sr.sdb, sr.root);
                b.cur[0] = 0;
                if (inhead >= 0)
                {
                    for (i = 0; i < nin; i++)
                    {
                        if (i > 0) { if (lst[i].i == lst[i - 1].i) { continue; }; };
                        t = sq_cur_seek(@b.scur, lst[i].i);
                        if (t < 0) { rc = 1; break; };
                        if (t == 1)
                        {
                            sq_ar_reset(@rs.ar);
                            sq_ar_reset(@b.scr);
                            sq_fill_row(st, sr, @b.scur, rs, @rs.d[0]);
                            rc = sq_join_one(st, b, 0, ar, gs, @matched);
                            if (rc != 0) { break; };
                        };
                    };
                }
                else
                {
                    if (haslo == 1)
                    {
                        rid = lo.i;
                        if (loinc == 0) { if (rid == (i64)9223372036854775807) { sq_cur_close(@b.scur); sq_ar_free(@pa); return 0; }; rid = rid + (i64)1; };
                        ok = sq_cur_seek_ge(@b.scur, rid);
                    }
                    else { ok = sq_cur_first(@b.scur); };
                    while (ok == 1)
                    {
                        if (hasi == 1)
                        {
                            if (b.scur.rowid > hi.i) { break; };
                            if (hiinc == 0) { if (b.scur.rowid == hi.i) { break; }; };
                        };
                        sq_ar_reset(@rs.ar);
                        sq_ar_reset(@b.scr);
                        sq_fill_row(st, sr, @b.scur, rs, @rs.d[0]);
                        rc = sq_join_one(st, b, 0, ar, gs, @matched);
                        if (rc != 0) { break; };
                        ok = sq_cur_next(@b.scur);
                    };
                    if (ok < 0 & rc == 0) { rc = 1; };
                };
                sq_cur_close(@b.scur);
                sq_ar_free(@pa);
                return rc;
            };
            sq_cur_open(@b.scur, sr.sdb, sr.root);
            sq_icur_open(@icur, sr.sdb, @ixs[ix]);
            b.cur[0] = 0;
            if (inhead >= 0)
            {
                for (i = 0; i < nin & rc == 0; i++)
                {
                    if (i > 0) { if (sq_val_cmpc(@lst[i], @lst[i - 1], ixs[ix].coll[0]) == 0) { continue; }; };
                    ok = sq_icur_seek(@icur, @lst[i], 1, 0);
                    while (ok == 1)
                    {
                        if (sq_val_cmpc(@icur.v[0], @lst[i], ixs[ix].coll[0]) != 0) { break; };
                        if (sq_cur_seek(@b.scur, sq_icur_rowid(@icur)) == 1)
                        {
                            sq_ar_reset(@rs.ar);
                            sq_ar_reset(@b.scr);
                            sq_fill_row(st, sr, @b.scur, rs, @rs.d[0]);
                            rc = sq_join_one(st, b, 0, ar, gs, @matched);
                            if (rc != 0) { break; };
                        };
                        ok = sq_icur_next(@icur);
                    };
                    if (ok < 0 & rc == 0) { rc = 1; };
                };
            }
            else
            {
                if (haslo == 1) { ok = sq_icur_seek(@icur, @lo, 1, 1 - loinc); }
                else { sq_val_null(@cur0); ok = sq_icur_seek(@icur, @cur0, 1, 1); };
                while (ok == 1)
                {
                    if (hasi == 1)
                    {
                        cm = sq_val_cmpc(@icur.v[0], @hi, ixs[ix].coll[0]);
                        if (cm > 0) { break; };
                        if (cm == 0 & hiinc == 0) { break; };
                    };
                    if (sq_cur_seek(@b.scur, sq_icur_rowid(@icur)) == 1)
                    {
                        sq_ar_reset(@rs.ar);
                        sq_ar_reset(@b.scr);
                        sq_fill_row(st, sr, @b.scur, rs, @rs.d[0]);
                        rc = sq_join_one(st, b, 0, ar, gs, @matched);
                        if (rc != 0) { break; };
                    };
                    ok = sq_icur_next(@icur);
                };
                if (ok < 0 & rc == 0) { rc = 1; };
            };
            sq_icur_close(@icur);
            sq_cur_close(@b.scur);
            sq_ar_free(@pa);
            return rc;
        };

        def sq_join(SQ_STMT* st, SQ_BLK* b, int j, SQ_ARM* ar, SQ_SET* gs) -> int
        {
            SQ_SRC* sr;
            SQ_RS* rs;
            SQ_VAL* row;
            SQ_IDX cix;
            SQ_ICUR icur;
            int i, rc, matched, ok, mi;
            if (j >= b.nsrc) { return sq_leaf(st, b, ar, gs); };
            sr = @b.src[j];
            if (sr.kind == 3)
            {
                if (sq_tvf_fill(st, b, sr) != 0) { ar.err = 1; return 1; };
            };
            rs = sr.rs;
            matched = 0;
            if (j == 0 & b.stream == 1)
            {
                rc = sq_scan0_planned(st, b, sr, rs, ar, gs);
                if (rc >= 0) { return rc; };
                rc = sq_scan0_range(st, b, sr, rs, ar, gs);
                if (rc >= 0) { return rc; };
                sq_cur_open(@b.scur, sr.sdb, sr.root);
                if (sq_cov_ix(st, b, 0, @cix) == 1)
                {
                    sq_icur_open(@icur, sr.sdb, @cix);
                    b.cur[0] = 0;
                    ok = sq_icur_first(@icur);
                    while (ok == 1)
                    {
                        if (sq_cur_seek(@b.scur, sq_icur_rowid(@icur)) == 1)
                        {
                            sq_ar_reset(@rs.ar);
                            sq_ar_reset(@b.scr);
                            sq_fill_row(st, sr, @b.scur, rs, @rs.d[0]);
                            rc = sq_join_one(st, b, 0, ar, gs, @matched);
                            if (rc != 0) { sq_icur_close(@icur); sq_cur_close(@b.scur); return rc; };
                        };
                        ok = sq_icur_next(@icur);
                    };
                    sq_icur_close(@icur);
                    sq_cur_close(@b.scur);
                    return 0;
                };
                ok = sq_cur_first(@b.scur);
                b.cur[0] = 0;
                while (ok == 1)
                {
                    sq_ar_reset(@rs.ar);
                    sq_ar_reset(@b.scr);
                    sq_fill_row(st, sr, @b.scur, rs, @rs.d[0]);
                    rc = sq_join_one(st, b, 0, ar, gs, @matched);
                    if (rc != 0) { sq_cur_close(@b.scur); return rc; };
                    ok = sq_cur_next(@b.scur);
                };
                sq_cur_close(@b.scur);
                return 0;
            };
            for (i = 0; i < rs.n; i++)
            {
                b.cur[j] = i;
                sq_ar_reset(@b.scr);
                mi = 0;
                rc = sq_join_one(st, b, j, ar, gs, @mi);
                if (mi == 1)
                {
                    matched = 1;
                    if (sr.jt >= 4) { ((byte*)b.rfl[j])[i] = (byte)1; };
                };
                if (rc != 0) { return rc; };
            };
            if ((sr.jt == 2 | sr.jt == 5) & matched == 0)
            {
                b.cur[j] = 0 - 1;
                sq_ar_reset(@b.scr);
                return sq_join_after(st, b, j, ar, gs);
            };
            return 0;
        };

        // ---- executor: window functions ----
        // Phase 1 records one entry per output row (join position or group). The window values are then computed over all
        // entries, and phase 2 emits the rows again with those values available to the window function nodes.

        def sq_wrec(SQ_STMT* st, SQ_BLK* b, SQ_ARM* ar) -> int
        {
            int* ne;
            int cap, i;
            if (b.wnent >= b.wcap)
            {
                cap = b.wcap * 2;
                if (cap < 64) { cap = 64; };
                ne = (int*)fmalloc((u64)cap * (u64)36);
                if ((u64)ne == (u64)0) { ar.err = 1; sq_seterr(st, "out of memory\0"); return 1; };
                if (b.wnent > 0) { sq_mcpy((byte*)ne, (byte*)b.went, b.wnent * 36); };
                if ((u64)b.went != (u64)0) { ffree((u64)b.went); };
                b.went = ne;
                b.wcap = cap;
            };
            for (i = 0; i < 8; i++) { b.went[b.wnent * 9 + i] = b.cur[i]; };
            b.went[b.wnent * 9 + 8] = b.wgrp;
            b.wnent++;
            return 0;
        };

        // makes entry i the current row again
        def sq_wctx(SQ_STMT* st, SQ_BLK* b, int i, SQ_VAL* av) -> void
        {
            int k, gi;
            SQ_GRP* g;
            gi = b.went[i * 9 + 8];
            if (gi >= 0)
            {
                g = @b.groups[gi];
                for (k = 0; k < b.nagg; k++) { sq_agg_final_n(st, b, @g.acc[k], b.aggn[k], @av[k]); };
                b.aggv = av;
                for (k = 0; k < 8; k++) { b.cur[k] = g.rep[k]; };
                if (b.stream == 1)
                {
                    if ((u64)g.rep0 != (u64)0)
                    {
                        sq_mcpy((byte*)b.src[0].rs.d, (byte*)g.rep0, b.src[0].rs.nc * sq_vsz());
                        b.cur[0] = 0;
                    }
                    else { b.cur[0] = 0 - 1; };
                };
            }
            else
            {
                for (k = 0; k < 8; k++) { b.cur[k] = b.went[i * 9 + k]; };
            };
            sq_ar_reset(@b.scr);
        };

        def sq_acc_init(SQ_ACC* ac) -> void
        {
            ac.n = (i64)0; ac.si = (i64)0; ac.sr = 0.0; ac.se = 0.0; ac.isreal = 0; ac.seen = 0; ac.ovf = 0;
            sq_val_null(@ac.v);
            ac.gc = (byte*)0; ac.gcn = 0; ac.gccap = 0; ac.dset = (SQ_SET*)0;
        };

        // adds value x (not NULL) to the aggregate id; sep is the group_concat separator
        def sq_acc_feed(SQ_STMT* st, SQ_BLK* b, SQ_ACC* ac, int id, SQ_VAL* x, SQ_VAL* sep, int coll) -> int
        {
            SQ_VAL y, t;
            int c, w, sl;
            byte* nb;
            if (id == 100) { ac.n = ac.n + (i64)1; return 0; };
            if (id == 101 | id == 102 | id == 103)
            {
                sq_tonum(x, @y);
                if (x.t == SQ_TEXT)
                {
                    if (sq_numtext(x.p, x.n, @t) == false) { sq_val_real(@y, sq_as_double(@y)); };
                };
                if (x.t == SQ_BLOB) { sq_val_real(@y, sq_as_double(@y)); };
                ac.n = ac.n + (i64)1;
                ac.seen = 1;
                if (y.t == SQ_REAL) { ac.isreal = 1; };
                if (ac.isreal == 1 | ac.ovf == 1)
                {
                    if (ac.ovf == 0)
                    {
                        ac.sr = (double)ac.si;
                        ac.ovf = 1;
                    };
                    {
                        double rr = sq_as_double(@y);
                        double ss = ac.sr;
                        double tt = ss + rr;
                        double fa = ss; double fb = rr;
                        if (fa < 0.0) { fa = 0.0 - fa; };
                        if (fb < 0.0) { fb = 0.0 - fb; };
                        if (fa > fb) { ac.se = ac.se + ((ss - tt) + rr); } else { ac.se = ac.se + ((rr - tt) + ss); };
                        ac.sr = tt;
                    };
                }
                else
                {
                    t.i = ac.si + y.i;
                    if ((ac.si >= (i64)0) == (y.i >= (i64)0) & (t.i >= (i64)0) != (ac.si >= (i64)0))
                    {
                        ac.sr = (double)ac.si + (double)y.i;
                        ac.ovf = 1;
                    }
                    else { ac.si = t.i; };
                };
                return 0;
            };
            if (id == 104 | id == 105)
            {
                if (ac.seen == 0)
                {
                    ac.seen = 1;
                    sq_val_copy(@ac.v, x);
                    sq_val_own(@b.gar, @ac.v);
                }
                else
                {
                    c = sq_val_cmpc(x, @ac.v, coll);
                    if ((id == 104 & c < 0) | (id == 105 & c > 0))
                    {
                        sq_val_copy(@ac.v, x);
                        sq_val_own(@b.gar, @ac.v);
                    };
                };
                return 0;
            };
            if (id == 106 | id == 107)
            {
                sq_val_text(@b.scr, x, @y);
                if (sep.t == SQ_NULL) { t.t = SQ_TEXT; t.p = ","; t.n = 0; }
                else { sq_val_text(@b.scr, sep, @t); };
                sl = y.n;
                if (ac.seen == 1) { sl = sl + t.n; };
                if (ac.gcn + sl + 1 > ac.gccap)
                {
                    w = ac.gccap * 2;
                    if (w < ac.gcn + sl + 1) { w = ac.gcn + sl + 1 + 64; };
                    nb = sq_ar_alloc(@b.gar, w);
                    if ((u64)nb == (u64)0) { return 1; };
                    if (ac.gcn > 0) { sq_mcpy(nb, ac.gc, ac.gcn); };
                    ac.gc = nb;
                    ac.gccap = w;
                };
                if (ac.seen == 1) { sq_mcpy(@ac.gc[ac.gcn], t.p, t.n); ac.gcn = ac.gcn + t.n; };
                sq_mcpy(@ac.gc[ac.gcn], y.p, y.n);
                ac.gcn = ac.gcn + y.n;
                ac.seen = 1;
            };
            return 0;
        };

        // keys of entries a and b over columns [from, to) of the key matrix are equal (NULLs equal each other)
        def sq_wkeq(SQ_VAL* m, int kk, int a, int bb, int c0, int c1, int* colls) -> bool
        {
            int c;
            SQ_VAL* x;
            SQ_VAL* y;
            for (c = c0; c < c1; c++)
            {
                x = @m[a * kk + c];
                y = @m[bb * kk + c];
                if (x.t == SQ_NULL & y.t == SQ_NULL) { continue; };
                if (x.t == SQ_NULL | y.t == SQ_NULL) { return false; };
                if (sq_val_cmpc(x, y, colls[c]) != 0) { return false; };
            };
            return true;
        };

        // ordering of range keys: NULL is smaller than any value
        def sq_wkcmp(SQ_VAL* x, SQ_VAL* y, int coll) -> int
        {
            if (x.t == SQ_NULL & y.t == SQ_NULL) { return 0; };
            if (x.t == SQ_NULL) { return 0 - 1; };
            if (y.t == SQ_NULL) { return 1; };
            return sq_val_cmpc(x, y, coll);
        };

        def sq_wnum_err(SQ_STMT* st, byte* m) -> void
        {
            sq_seterr(st, m);
        };

        // computes the values of window function number wf into b.winv[wf * n ..]
        def sq_win_one(SQ_STMT* st, SQ_BLK* b, int wf, SQ_VAL* av, int* ordr) -> int
        {
            SQ_NODE* nd;
            SQ_WIN* w;
            SQ_VAL* m;
            SQ_VAL x, y, z, sepv;
            SQ_VAL ox, snv, env;
            SQ_ACC ac;
            SQ_RS* rs;
            SQ_VAL* row;
            SQ_SORT so;
            int* perm;
            int* pst;
            int* pen;
            int* gs;
            int* ge;
            int* gno;
            int[16] colls;
            int n, np, no, argc, kk, filtc, i, j, c, id, p, e, ps, pe, fs, fe, q, a, star, ok, dummy;
            int ft, sk, ek, excl, gcur, lo, hi, cnt, nth, tgt, size, isagg;
            i64 sn, en, nv, qq, rr, off;
            double dv;
            nd = @st.nodes[b.winn[wf]];
            w = @st.wins[nd.win];
            id = nd.col;
            n = b.wnent;
            np = w.np;
            no = w.no;
            argc = (int)nd.iv;
            star = 0;
            if (nd.op == 2) { star = 1; };
            isagg = 0;
            if (id < 200) { isagg = 1; };
            kk = np + no + argc + 1;
            filtc = kk - 1;
            m = (SQ_VAL*)fmalloc((u64)n * (u64)kk * (u64)sq_vsz() + (u64)64);
            perm = (int*)fmalloc((u64)n * (u64)4 * (u64)6 + (u64)64);
            if ((u64)m == (u64)0 | (u64)perm == (u64)0) { sq_seterr(st, "out of memory\0"); return 1; };
            pst = @perm[n]; pen = @perm[2 * n]; gs = @perm[3 * n]; ge = @perm[4 * n]; gno = @perm[5 * n];
            for (j = 0; j < np; j++) { colls[j] = sq_ecoll(st, w.part[j]); };
            for (j = 0; j < no; j++) { colls[np + j] = sq_ecoll(st, w.ord[j]); };
            // inputs of every entry
            for (i = 0; i < n; i++)
            {
                sq_wctx(st, b, i, av);
                c = 0;
                for (j = 0; j < np; j++) { sq_eval(st, b, w.part[j], @m[i * kk + c]); sq_val_own(@b.gar, @m[i * kk + c]); c++; };
                for (j = 0; j < no; j++) { sq_eval(st, b, w.ord[j], @m[i * kk + c]); sq_val_own(@b.gar, @m[i * kk + c]); c++; };
                a = nd.a;
                for (j = 0; j < argc; j++)
                {
                    sq_eval(st, b, a, @m[i * kk + c]);
                    sq_val_own(@b.gar, @m[i * kk + c]);
                    c++;
                    a = st.nodes[a].next;
                };
                if (nd.c >= 0)
                {
                    sq_eval(st, b, nd.c, @x);
                    if (sq_truth(@x) == 1) { sq_val_int(@m[i * kk + filtc], (i64)1); } else { sq_val_int(@m[i * kk + filtc], (i64)0); };
                }
                else { sq_val_int(@m[i * kk + filtc], (i64)1); };
            };
            // frame offsets (constant expressions)
            sn = (i64)0; en = (i64)0;
            sq_val_int(@snv, (i64)0); sq_val_int(@env, (i64)0);
            sq_val_null(@sepv);
            ft = w.ftype; sk = w.sk; ek = w.ek; excl = w.excl;
            if (ft == 0) { ft = 2; sk = 0; ek = 2; };
            if (n > 0)
            {
                sq_wctx(st, b, 0, av);
                if (w.sn >= 0)
                {
                    sq_eval(st, b, w.sn, @ox);
                    if (ft == 2)
                    {
                        sq_tonum(@ox, @x);
                        if (x.t == SQ_NULL) { sq_seterr(st, "frame starting offset must be a non-negative number\0"); return 1; };
                        if (sq_as_double(@x) < 0.0) { sq_seterr(st, "frame starting offset must be a non-negative number\0"); return 1; };
                        sq_val_copy(@snv, @x);
                    }
                    else
                    {
                        sq_cast((SQ_ARENA*)0, @ox, 3, @x);
                        if (ox.t == SQ_NULL | x.i < (i64)0) { sq_seterr(st, "frame starting offset must be a non-negative integer\0"); return 1; };
                        sn = x.i;
                    };
                };
                if (w.en >= 0)
                {
                    sq_eval(st, b, w.en, @ox);
                    if (ft == 2)
                    {
                        sq_tonum(@ox, @x);
                        if (x.t == SQ_NULL) { sq_seterr(st, "frame ending offset must be a non-negative number\0"); return 1; };
                        if (sq_as_double(@x) < 0.0) { sq_seterr(st, "frame ending offset must be a non-negative number\0"); return 1; };
                        sq_val_copy(@env, @x);
                    }
                    else
                    {
                        sq_cast((SQ_ARENA*)0, @ox, 3, @x);
                        if (ox.t == SQ_NULL | x.i < (i64)0) { sq_seterr(st, "frame ending offset must be a non-negative integer\0"); return 1; };
                        en = x.i;
                    };
                };
            };
            if (ft == 2 & (sk == 1 | sk == 3 | ek == 1 | ek == 3))
            {
                if (no != 1) { sq_seterr(st, "RANGE with offset PRECEDING/FOLLOWING requires one ORDER BY expression\0"); return 1; };
            };
            // sort by partition and order keys
            rs = sq_rs_new(np + no + 1, np + no + 1);
            if ((u64)rs == (u64)0) { sq_seterr(st, "out of memory\0"); return 1; };
            for (j = 0; j < n; j++)
            {
                i = ordr[j];
                row = sq_rs_row(rs);
                if ((u64)row == (u64)0) { sq_seterr(st, "out of memory\0"); return 1; };
                for (c = 0; c < np + no; c++) { sq_val_copy(@row[c], @m[i * kk + c]); };
                sq_val_int(@row[np + no], (i64)i);
            };
            if (np + no > 0)
            {
                so.rs = rs; so.nt = np + no;
                for (c = 0; c < np; c++) { so.col[c] = c; so.desc[c] = 0; so.nul[c] = 0; so.coll[c] = colls[c]; };
                for (c = 0; c < no; c++) { so.col[np + c] = np + c; so.desc[np + c] = w.odesc[c]; so.nul[np + c] = w.onull[c]; so.coll[np + c] = colls[np + c]; };
                if (sq_sort_rs(@so) != 0) { sq_seterr(st, "out of memory\0"); return 1; };
            };
            for (i = 0; i < n; i++) { perm[i] = (int)rs.d[i * rs.nc + np + no].i; };
            sq_rs_free(rs);
            if (np + no > 0) { for (i = 0; i < n; i++) { ordr[i] = perm[i]; }; };
            // partitions and peer groups, by sorted position
            i = 0;
            while (i < n)
            {
                j = i + 1;
                while (j < n)
                {
                    if (sq_wkeq(m, kk, perm[i], perm[j], 0, np, colls) == false) { break; };
                    j++;
                };
                for (q = i; q < j; q++) { pst[q] = i; pen[q] = j; };
                // peer groups inside [i, j)
                a = i;
                c = 0;
                while (a < j)
                {
                    e = a + 1;
                    while (e < j)
                    {
                        if (sq_wkeq(m, kk, perm[a], perm[e], np, np + no, colls) == false) { break; };
                        e++;
                    };
                    for (q = a; q < e; q++) { gs[q] = a; ge[q] = e; gno[q] = c; };
                    c++;
                    a = e;
                };
                i = j;
            };
            // values
            for (p = 0; p < n; p++)
            {
                e = perm[p];
                ps = pst[p]; pe = pen[p];
                size = pe - ps;
                z.t = SQ_NULL;
                sq_val_null(@z);
                if (id == 200) { sq_val_int(@z, (i64)(p - ps + 1)); }
                else { if (id == 201) { sq_val_int(@z, (i64)(gs[p] - ps + 1)); }
                else { if (id == 202) { sq_val_int(@z, (i64)(gno[p] + 1)); }
                else { if (id == 203)
                {
                    if (size <= 1) { sq_val_real(@z, 0.0); } else { sq_val_real(@z, (double)(gs[p] - ps) / (double)(size - 1)); };
                }
                else { if (id == 204) { sq_val_real(@z, (double)(ge[p] - ps) / (double)size); }
                else { if (id == 205)
                {
                    sq_cast((SQ_ARENA*)0, @m[e * kk + np + no], 3, @x);
                    if (m[e * kk + np + no].t == SQ_NULL | x.i <= (i64)0) { sq_seterr(st, "argument of ntile must be a positive integer\0"); return 1; };
                    nv = x.i;
                    qq = (i64)size / nv;
                    rr = (i64)size % nv;
                    i = p - ps;
                    if (qq == (i64)0) { sq_val_int(@z, (i64)(i + 1)); }
                    else
                    {
                        if ((i64)i < rr * (qq + (i64)1)) { sq_val_int(@z, (i64)i / (qq + (i64)1) + (i64)1); }
                        else { sq_val_int(@z, rr + ((i64)i - rr * (qq + (i64)1)) / qq + (i64)1); };
                    };
                }
                else { if (id == 206 | id == 207)
                {
                    off = (i64)1;
                    ok = 1;
                    if (argc >= 2)
                    {
                        sq_cast((SQ_ARENA*)0, @m[e * kk + np + no + 1], 3, @x);
                        if (m[e * kk + np + no + 1].t == SQ_NULL) { ok = 0; };
                        if (m[e * kk + np + no + 1].t == SQ_REAL)
                        {
                            if ((double)x.i != m[e * kk + np + no + 1].r) { ok = 0; };
                        };
                        off = x.i;
                    };
                    tgt = 0 - 1;
                    if (ok == 1)
                    {
                        if (id == 206) { if ((i64)p - off >= (i64)ps & (i64)p - off < (i64)pe) { tgt = p - (int)off; }; }
                        else { if ((i64)p + off < (i64)pe & (i64)p + off >= (i64)ps) { tgt = p + (int)off; }; };
                    };
                    if (tgt >= 0) { sq_val_copy(@z, @m[perm[tgt] * kk + np + no]); }
                    else { if (argc >= 3) { sq_val_copy(@z, @m[e * kk + np + no + 2]); }; };
                }
                else
                {
                    // frame of this row, as positions [fs, fe)
                    fs = ps; fe = pe;
                    if (sk == 0) { fs = ps; }
                    else
                    {
                        if (ft == 1)
                        {
                            if (sk == 1) { if ((i64)p - sn < (i64)ps) { fs = ps; } else { fs = p - (int)sn; }; };
                            if (sk == 2) { fs = p; };
                            if (sk == 3) { if ((i64)p + sn > (i64)pe) { fs = pe; } else { fs = p + (int)sn; }; };
                            if (sk == 4) { fs = pe; };
                        };
                        if (ft == 3)
                        {
                            gcur = gno[p];
                            if (sk == 2) { fs = gs[p]; };
                            if (sk == 1 | sk == 3)
                            {
                                if (sk == 1) { nv = (i64)gcur - sn; } else { nv = (i64)gcur + sn; };
                                fs = pe;
                                if (nv < (i64)0) { fs = ps; }
                                else
                                {
                                    for (q = ps; q < pe; q++) { if ((i64)gno[q] == nv) { fs = q; break; }; };
                                    if (fs == pe & nv < (i64)gcur) { fs = ps; };
                                };
                            };
                            if (sk == 4) { fs = pe; };
                        };
                        if (ft == 2)
                        {
                            if (sk == 2) { fs = gs[p]; };
                            if (sk == 4) { fs = pe; };
                            if (sk == 1 | sk == 3)
                            {
                                fs = gs[p];
                                if (m[e * kk + np].t != SQ_NULL)
                                {
                                    if ((sk == 1 & w.odesc[0] == 0) | (sk == 3 & w.odesc[0] == 1)) { sq_arith(SQO_SUB, @m[e * kk + np], @snv, @x); }
                                    else { sq_arith(SQO_ADD, @m[e * kk + np], @snv, @x); };
                                    fs = pe;
                                    for (q = ps; q < pe; q++)
                                    {
                                        c = sq_wkcmp(@m[perm[q] * kk + np], @x, colls[np]);
                                        if (w.odesc[0] == 1) { c = 0 - c; };
                                        if (c >= 0) { fs = q; break; };
                                    };
                                };
                            };
                        };
                    };
                    if (ek == 4) { fe = pe; }
                    else
                    {
                        if (ft == 1)
                        {
                            if (ek == 1) { if ((i64)p - en + (i64)1 < (i64)ps) { fe = ps; } else { fe = p - (int)en + 1; }; };
                            if (ek == 2) { fe = p + 1; };
                            if (ek == 3) { if ((i64)p + en + (i64)1 > (i64)pe) { fe = pe; } else { fe = p + (int)en + 1; }; };
                            if (ek == 0) { fe = ps; };
                        };
                        if (ft == 3)
                        {
                            gcur = gno[p];
                            if (ek == 2) { fe = ge[p]; };
                            if (ek == 0) { fe = ps; };
                            if (ek == 1 | ek == 3)
                            {
                                if (ek == 1) { nv = (i64)gcur - en; } else { nv = (i64)gcur + en; };
                                fe = ps;
                                if (nv >= (i64)0)
                                {
                                    fe = pe;
                                    for (q = pe - 1; q >= ps; q--) { if ((i64)gno[q] == nv) { fe = q + 1; break; }; if (q == ps) { break; }; };
                                    if (nv < (i64)gcur & fe == pe) { fe = ps; };
                                };
                            };
                        };
                        if (ft == 2)
                        {
                            if (ek == 2) { fe = ge[p]; };
                            if (ek == 0) { fe = ps; };
                            if (ek == 1 | ek == 3)
                            {
                                fe = ge[p];
                                if (m[e * kk + np].t != SQ_NULL)
                                {
                                    if ((ek == 1 & w.odesc[0] == 0) | (ek == 3 & w.odesc[0] == 1)) { sq_arith(SQO_SUB, @m[e * kk + np], @env, @x); }
                                    else { sq_arith(SQO_ADD, @m[e * kk + np], @env, @x); };
                                    fe = ps;
                                    for (q = ps; q < pe; q++)
                                    {
                                        c = sq_wkcmp(@m[perm[q] * kk + np], @x, colls[np]);
                                        if (w.odesc[0] == 1) { c = 0 - c; };
                                        if (c <= 0) { fe = q + 1; };
                                    };
                                };
                            };
                        };
                    };
                    if (fs < ps) { fs = ps; };
                    if (fe > pe) { fe = pe; };
                    if (fs > fe) { fs = ps; fe = ps; };
                    if (isagg == 1)
                    {
                        sq_acc_init(@ac);
                        sepv.t = SQ_TEXT; sepv.p = ","; sepv.n = 1; sepv.i = (i64)0; sepv.r = 0.0;
                        if (argc >= 2) { sq_val_copy(@sepv, @m[e * kk + np + no + 1]); };
                        for (q = fs; q < fe; q++)
                        {
                            if (excl == 1 & q == p) { continue; };
                            if (excl == 2 & q >= gs[p] & q < ge[p]) { continue; };
                            if (excl == 3 & q >= gs[p] & q < ge[p] & q != p) { continue; };
                            c = perm[q];
                            if (m[c * kk + filtc].i == (i64)0) { continue; };
                            if (id == 100 & star == 1) { ac.n = ac.n + (i64)1; continue; };
                            if (id >= 108 & id <= 111)
                            {
                                if (argc >= 2) { sq_val_copy(@sepv, @m[c * kk + np + no + 1]); };
                                if (sq_pct_step(st, b, @ac, id, @m[c * kk + np + no], @sepv) != 0) { return 1; };
                                continue;
                            };
                            if (id >= 112 & id <= 115)
                            {
                                if (argc >= 2) { sq_val_copy(@sepv, @m[c * kk + np + no + 1]); };
                                if (sq_jagg_step(st, b, @ac, id, @m[c * kk + np + no], @sepv) != 0) { return 1; };
                                continue;
                            };
                            if (m[c * kk + np + no].t == SQ_NULL) { continue; };
                            if (sq_acc_feed(st, b, @ac, id, @m[c * kk + np + no], @sepv, sq_ecoll(st, nd.a)) != 0)
                            {
                                sq_seterr(st, "out of memory\0"); return 1;
                            };
                        };
                        sq_agg_final(st, b, @ac, id, @z);
                    }
                    else
                    {
                        // first_value, last_value, nth_value over the frame
                        nth = 1;
                        if (id == 210)
                        {
                            sq_cast((SQ_ARENA*)0, @m[e * kk + np + no + 1], 3, @x);
                            if (m[e * kk + np + no + 1].t == SQ_NULL | x.i <= (i64)0)
                            {
                                sq_seterr(st, "second argument to nth_value must be a positive integer\0");
                                return 1;
                            };
                            nth = (int)x.i;
                        };
                        cnt = 0;
                        tgt = 0 - 1;
                        for (q = fs; q < fe; q++)
                        {
                            if (excl == 1 & q == p) { continue; };
                            if (excl == 2 & q >= gs[p] & q < ge[p]) { continue; };
                            if (excl == 3 & q >= gs[p] & q < ge[p] & q != p) { continue; };
                            cnt++;
                            if (id == 208 & cnt == 1) { tgt = q; break; };
                            if (id == 210 & cnt == nth) { tgt = q; break; };
                            if (id == 209) { tgt = q; };
                        };
                        if (tgt >= 0) { sq_val_copy(@z, @m[perm[tgt] * kk + np + no]); };
                    };
                };
                }; }; }; }; }; };
                sq_val_copy(@b.winv[wf * n + e], @z);
                sq_val_own(@b.gar, @b.winv[wf * n + e]);
            };
            ffree((u64)m);
            ffree((u64)perm);
            return 0;
        };

        // evaluates all window functions over the recorded entries, then emits the rows
        def sq_win_run(SQ_STMT* st, SQ_BLK* b, SQ_ARM* ar) -> int
        {
            SQ_VAL* av;
            int* ordr;
            int wf, i, n, k;
            n = b.wnent;
            b.wphase = 1;
            av = (SQ_VAL*)sq_ar_alloc(@b.gar, (b.nagg + 1) * sq_vsz());
            b.winv = (SQ_VAL*)sq_ar_alloc(@b.gar, (b.nwin * n + 1) * sq_vsz());
            if ((u64)av == (u64)0 | (u64)b.winv == (u64)0) { ar.err = 1; sq_seterr(st, "out of memory\0"); return 1; };
            ordr = (int*)fmalloc((u64)(n + 1) * (u64)4);
            if ((u64)ordr == (u64)0) { ar.err = 1; sq_seterr(st, "out of memory\0"); return 1; };
            for (i = 0; i < n; i++) { ordr[i] = i; };
            // windows are processed last to first; each stable sort leaves the rows in that window's order
            for (wf = b.nwin - 1; wf >= 0; wf--)
            {
                if (sq_win_one(st, b, wf, av, ordr) != 0) { ar.err = 1; ffree((u64)ordr); return 1; };
            };
            for (k = 0; k < n; k++)
            {
                i = ordr[k];
                sq_wctx(st, b, i, av);
                b.wcur = i;
                if (sq_emit(st, b, ar) != 0) { break; };
            };
            ffree((u64)ordr);
            return 0;
        };

        def sq_win_end(SQ_STMT* st, SQ_BLK* b) -> void
        {
            if ((u64)b.went != (u64)0) { ffree((u64)b.went); };
            b.went = (int*)0;
            b.wnent = 0;
            b.wcap = 0;
            b.winv = (SQ_VAL*)0;
            b.wphase = 0;
        };

        // ---- executor: blocks ----

        def sq_has_bare(SQ_STMT* st, int ni) -> bool
        {
            SQ_NODE* nd;
            int c;
            if (ni < 0) { return false; };
            nd = @st.nodes[ni];
            if (nd.kind == SQN_FUNC) { if (nd.col >= 100) { return false; }; };
            if (nd.kind == SQN_COL) { if (nd.lvl == 0) { return true; }; return false; };
            if (nd.kind == SQN_SUBQ | nd.kind == SQN_EXISTS) { return false; };
            c = nd.a;
            while (c >= 0) { if (sq_has_bare(st, c)) { return true; }; c = st.nodes[c].next; };
            c = nd.b;
            while (c >= 0) { if (sq_has_bare(st, c)) { return true; }; c = st.nodes[c].next; };
            c = nd.c;
            while (c >= 0) { if (sq_has_bare(st, c)) { return true; }; c = st.nodes[c].next; };
            return false;
        };

        def sq_eval_i64(SQ_STMT* st, SQ_BLK* b, int ni, i64 dflt) -> i64
        {
            SQ_VAL x, y;
            if (ni < 0) { return dflt; };
            sq_eval(st, b, ni, @x);
            if (x.t == SQ_NULL) { return dflt; };
            sq_cast((SQ_ARENA*)0, @x, 3, @y);
            return y.i;
        };

        def sq_run_arm(SQ_STMT* st, int bi, int keys, i64 skip, i64 lim, int sorted) -> SQ_RS*
        {
            SQ_BLK* b = st.blks[bi];
            SQ_ARM* ar;
            SQ_RS* rs;
            SQ_RS* rs2;
            SQ_SET gs;
            SQ_SORT so;
            SQ_VAL x;
            SQ_VAL[16] zk;
            SQ_VAL* av;
            SQ_GRP* g;
            int j, w, k, nres, nkeys, aggmode, rc, gi, ncol, order_n, skipall, t;
            int* ord;
            SQ_SRC* sr;
            nres = b.nres;
            nkeys = 0;
            if (keys == 1) { nkeys = b.nord; };
            ar = (SQ_ARM*)fmalloc((u64)sizeof(SQ_ARM));
            if ((u64)ar == (u64)0) { sq_seterr(st, "out of memory\0"); return (SQ_RS*)0; };
            rs = sq_rs_new(nres + nkeys, nres);
            if ((u64)rs == (u64)0) { ffree((u64)ar); sq_seterr(st, "out of memory\0"); return rs; };
            if (st.spill == 1 & bi == st.root_blk & sorted == 0 & keys == 0 & b.nwin == 0) { rs.spon = 1; };
            ar.rs = rs; ar.nres = nres; ar.nkeys = nkeys; ar.skip = skip; ar.lim = lim; ar.sorted = sorted;
            ar.count = 0; ar.stop = 0; ar.err = 0;
            ar.use_dset = b.distinct;
            if (b.distinct == 1) { sq_set_init(@ar.dset, nres); };
            for (j = 0; j < 8; j++) { b.cur[j] = 0 - 1; };
            b.stream = 0;
            b.aggv = (SQ_VAL*)0;
            b.wphase = 0; b.wnent = 0; b.wgrp = 0 - 1; b.wcur = 0;
            skipall = 0;
            // sources
            for (j = 0; j < b.nsrc; j++)
            {
                sr = @b.src[j];
                if (j == 0 & sr.kind == 1 & b.nwin == 0)
                {
                    b.stream = 1;
                    sr.rs = sq_rs_new(sr.ti.ncols + 1, sr.ti.ncols + 1);
                    sr.rs_shared = 0;
                    if ((u64)sr.rs == (u64)0) { sq_seterr(st, "out of memory\0"); skipall = 2; break; };
                    if ((u64)sq_rs_row(sr.rs) == (u64)0) { sq_seterr(st, "out of memory\0"); skipall = 2; break; };
                    continue;
                };
                if (sq_load_source(st, b, j) != 0) { skipall = 2; break; };
            };
            if (skipall != 2)
            {
                b.nwc = 0;
                sq_split_where(st, b, b.where_n);
                b.nminmax = 0;
                for (k = 0; k < b.nagg; k++)
                {
                    if (st.nodes[b.aggn[k]].col == 104 | st.nodes[b.aggn[k]].col == 105) { b.nminmax++; };
                };
                b.bare = 0;
                for (k = 0; k < nres; k++) { if (sq_has_bare(st, b.rc[k])) { b.bare = 1; }; };
                if (sq_has_bare(st, b.having)) { b.bare = 1; };
                if (b.nwin > 0) { b.bare = 1; };
                for (k = 0; k < b.nord; k++) { if (sq_has_bare(st, b.ord[k])) { b.bare = 1; }; };
                // conjuncts that do not depend on this block's rows
                for (w = 0; w < b.nwc; w++)
                {
                    if (b.wcl[w] < 0)
                    {
                        sq_eval(st, b, b.wcn[w], @x);
                        if (sq_truth(@x) != 1) { skipall = 1; };
                        b.wcl[w] = 0 - 2;
                    };
                };
                if (b.nsrc == 0) { for (w = 0; w < b.nwc; w++) { b.wcl[w] = 0 - 2; }; };
                aggmode = 0;
                if (b.has_agg == 1 | b.ngrp > 0) { aggmode = 1; };
                sq_set_init(@gs, b.ngrp);
                for (k = 0; k < b.ngrp; k++) { if (k < 16) { gs.coll[k] = sq_ecoll(st, b.grp[k]); }; };
                if (aggmode == 1 & b.ngrp == 0)
                {
                    // the single implicit group exists even without input rows
                    gi = sq_set_add(@gs, @zk[0]);
                    if (gi < 0) { sq_seterr(st, "out of memory\0"); skipall = 2; }
                    else
                    {
                        if (sq_group_new(st, b, @gs, gi) != 0) { sq_seterr(st, "out of memory\0"); skipall = 2; };
                    };
                };
                rc = 0;
                if (sorted == 0 & lim == (i64)0) { skipall = 1; };
                b.rjmax = 0;
                for (j = 1; j < 8; j++) { b.rfl[j] = (u64)0; };
                for (j = 1; j < b.nsrc; j++)
                {
                    if (b.src[j].jt >= 4)
                    {
                        b.rjmax = j;
                        b.rfl[j] = (u64)fmalloc((u64)(b.src[j].rs.n + 8));
                        if (b.rfl[j] == (u64)0) { sq_seterr(st, "out of memory\0"); skipall = 2; break; };
                        for (k = 0; k < b.src[j].rs.n + 8; k++) { ((byte*)b.rfl[j])[k] = (byte)0; };
                    };
                };
                if (skipall == 0) { rc = sq_join(st, b, 0, ar, @gs); };
                if (skipall == 0 & rc == 0 & b.rjmax > 0) { rc = sq_join_right_pass(st, b, ar, @gs); };
                for (j = 1; j < 8; j++)
                {
                    if (b.rfl[j] != (u64)0) { ffree(b.rfl[j]); b.rfl[j] = (u64)0; };
                };
                b.rjmax = 0;
                if (aggmode == 1 & skipall != 2 & ar.err == 0 & ar.stop == 0)
                {
                    // groups in key order
                    ord = (int*)fmalloc((u64)(b.ngroups + 1) * (u64)4);
                    if ((u64)ord == (u64)0) { ar.err = 1; sq_seterr(st, "out of memory\0"); }
                    else
                    {
                        for (gi = 0; gi < b.ngroups; gi++) { ord[gi] = gi; };
                        if (b.ngrp > 0 & b.ngroups > 1)
                        {
                            rs2 = sq_rs_new(b.ngrp + 1, b.ngrp + 1);
                            if ((u64)rs2 != (u64)0)
                            {
                                for (gi = 0; gi < b.ngroups; gi++)
                                {
                                    av = sq_rs_row(rs2);
                                    for (k = 0; k < b.ngrp; k++) { sq_val_copy(@av[k], @gs.keys[gi * b.ngrp + k]); };
                                    sq_val_int(@av[b.ngrp], (i64)gi);
                                };
                                so.rs = rs2; so.nt = b.ngrp;
                                for (k = 0; k < b.ngrp; k++) { so.col[k] = k; so.desc[k] = 0; so.coll[k] = sq_ecoll(st, b.grp[k]); so.nul[k] = 0; };
                                if (sq_sort_rs(@so) == 0)
                                {
                                    for (gi = 0; gi < b.ngroups; gi++) { ord[gi] = (int)rs2.d[gi * rs2.nc + b.ngrp].i; };
                                };
                                sq_rs_free(rs2);
                            };
                        };
                        av = (SQ_VAL*)sq_ar_alloc(@b.gar, (b.nagg + 1) * sizeof(SQ_VAL));
                        for (t = 0; t < b.ngroups; t++)
                        {
                            gi = ord[t];
                            g = @b.groups[gi];
                            for (k = 0; k < b.nagg; k++) { sq_agg_final_n(st, b, @g.acc[k], b.aggn[k], @av[k]); };
                            b.aggv = av;
                            for (k = 0; k < 8; k++) { b.cur[k] = g.rep[k]; };
                            if (b.stream == 1)
                            {
                                if ((u64)g.rep0 != (u64)0)
                                {
                                    sq_mcpy((byte*)b.src[0].rs.d, (byte*)g.rep0, b.src[0].rs.nc * sq_vsz());
                                    b.cur[0] = 0;
                                }
                                else { b.cur[0] = 0 - 1; };
                            };
                            sq_ar_reset(@b.scr);
                            if (b.having >= 0)
                            {
                                sq_eval(st, b, b.having, @x);
                                if (sq_truth(@x) != 1) { continue; };
                            };
                            b.wgrp = gi;
                            if (sq_emit(st, b, ar) != 0) { break; };
                        };
                        ffree((u64)ord);
                    };
                };
                if (b.nwin > 0 & skipall != 2 & ar.err == 0 & st.err[0] == (byte)0) { sq_win_run(st, b, ar); };
                sq_set_free(@gs);
                b.aggv = (SQ_VAL*)0;
                sq_win_end(st, b);
                sq_free_groups(st, b);
            };
            sq_free_sources(st, b);
            sq_ar_reset(@b.scr);
            if (b.distinct == 1) { sq_set_free(@ar.dset); };
            if (ar.err != 0 | skipall == 2 | st.err[0] != (byte)0)
            {
                sq_rs_free(rs);
                ffree((u64)ar);
                return (SQ_RS*)0;
            };
            ffree((u64)ar);
            return rs;
        };

        // keeps rows [off, off+lim) in place
        def sq_rs_trim(SQ_RS* rs, i64 off, i64 lim) -> void
        {
            int o, n, i;
            if (off > (i64)rs.n) { off = (i64)rs.n; };
            o = (int)off;
            n = rs.n - o;
            if (lim >= (i64)0 & lim < (i64)n) { n = (int)lim; };
            if (o > 0 & n > 0) { sq_mcpy((byte*)rs.d, (byte*)@rs.d[o * rs.nc], n * rs.nc * sq_vsz()); };
            rs.n = n;
        };

        def sq_rs_done(SQ_STMT* st, int bi, SQ_RS* rs) -> void
        {
            if (st.blks[bi].is_corr == 1) { sq_rs_free(rs); return; };
            // an uncorrelated block keeps its result for later evaluations
        };

        def sq_rs_all_cols(SQ_SORT* so, SQ_RS* rs) -> void
        {
            int k;
            so.rs = rs;
            so.nt = rs.vis;
            if (so.nt > 16) { so.nt = 16; };
            for (k = 0; k < so.nt; k++) { so.col[k] = k; so.desc[k] = 0; so.coll[k] = 0; so.nul[k] = 0; };
        };

        // recursive CTE: base rows seed a queue; rows are popped into the result and fed to the recursive arms
        def sq_run_rec(SQ_STMT* st, int bi, int ci, int maxrows) -> SQ_RS*
        {
            SQ_BLK* h = st.blks[bi];
            SQ_RS* q;
            SQ_RS* q2;
            SQ_RS* out;
            SQ_RS* rb;
            SQ_RS* work;
            SQ_SET seen;
            SQ_SORT so;
            i64 lim, off, need;
            int a, t, k, qh, chunk, dedupe, firstrec, ordered, nr, ok, prevb, svn, svc;
            int svl, svo;
            sq_ar_reset(@h.scr);
            lim = sq_eval_i64(st, h, h.limit_n, (i64)0 - (i64)1);
            off = sq_eval_i64(st, h, h.offset_n, (i64)0);
            if (lim < (i64)0) { lim = (i64)0 - (i64)1; };
            if (off < (i64)0) { off = (i64)0; };
            if (maxrows >= 0)
            {
                if (lim < (i64)0 | (i64)maxrows < lim) { lim = (i64)maxrows; };
            };
            nr = h.nres;
            // arms: base arms come first, recursive arms (those naming the CTE) follow
            dedupe = 0;
            a = h.cnext;
            firstrec = 0 - 1;
            prevb = bi;
            while (a >= 0)
            {
                if (st.blks[a].nres != nr)
                {
                    sq_seterr(st, "SELECTs to the left and right of a compound operator do not have the same number of result columns\0");
                    return (SQ_RS*)0;
                };
                if (st.blks[a].refself == 1 & firstrec < 0) { firstrec = a; };
                if (firstrec >= 0)
                {
                    if (st.blks[a].cop == 1) { dedupe = 1; };
                    if (st.blks[a].cop > 2)
                    {
                        sq_seterr(st, "recursive CTE supports only UNION and UNION ALL\0");
                        return (SQ_RS*)0;
                    };
                };
                if (firstrec < 0) { prevb = a; };
                a = st.blks[a].cnext;
            };
            ordered = 0;
            if (h.nord > 0) { ordered = 1; };
            q = sq_rs_new(nr, nr);
            out = sq_rs_new(nr, nr);
            if ((u64)q == (u64)0 | (u64)out == (u64)0) { sq_seterr(st, "out of memory\0"); return (SQ_RS*)0; };
            sq_set_init(@seen, nr);
            // base rows: the compound of the arms before the first recursive arm
            svn = h.nord; svl = h.limit_n; svo = h.offset_n; svc = st.blks[prevb].cnext;
            h.nord = 0; h.limit_n = 0 - 1; h.offset_n = 0 - 1; h.rec = 0;
            st.blks[prevb].cnext = 0 - 1;
            rb = sq_run_block(st, bi, 0 - 1);
            st.blks[prevb].cnext = svc;
            h.nord = svn; h.limit_n = svl; h.offset_n = svo; h.rec = ci + 1;
            h.out = (SQ_RS*)0;
            if ((u64)rb == (u64)0) { sq_set_free(@seen); sq_rs_free(q); sq_rs_free(out); return rb; };
            for (t = 0; t < rb.n; t++)
            {
                if (dedupe == 1) { sq_set_add(@seen, @rb.d[t * rb.nc]); if (seen.isnew == 0) { continue; }; };
                sq_rs_add(q, @rb.d[t * rb.nc]);
            };
            sq_rs_free(rb);
            if (ordered == 1)
            {
                so.rs = q; so.nt = h.nord;
                for (k = 0; k < h.nord; k++)
                {
                    so.col[k] = (int)st.nodes[h.ord[k]].iv; so.desc[k] = h.odesc[k]; so.nul[k] = h.onull[k]; so.coll[k] = h.ocoll[k];
                    if (so.coll[k] < 0) { so.coll[k] = 0; };
                };
                sq_sort_rs(@so);
            };
            qh = 0;
            ok = 1;
            while (qh < q.n & ok == 1)
            {
                need = (i64)q.n - (i64)qh;
                if (lim >= (i64)0)
                {
                    need = off + lim - (i64)out.n;
                    if (need <= (i64)0) { break; };
                };
                chunk = q.n - qh;
                if (ordered == 1) { chunk = 1; };
                if ((i64)chunk > need) { chunk = (int)need; };
                work = sq_rs_new(nr, nr);
                if ((u64)work == (u64)0) { ok = 0; break; };
                for (t = 0; t < chunk; t++)
                {
                    sq_rs_add(out, @q.d[(qh + t) * q.nc]);
                    sq_rs_add(work, @q.d[(qh + t) * q.nc]);
                };
                qh = qh + chunk;
                st.ctes[ci].work = work;
                a = firstrec;
                while (a >= 0)
                {
                    rb = sq_run_arm(st, a, 0, (i64)0, (i64)0 - (i64)1, 1);
                    if ((u64)rb == (u64)0) { ok = 0; break; };
                    for (t = 0; t < rb.n; t++)
                    {
                        if (dedupe == 1) { sq_set_add(@seen, @rb.d[t * rb.nc]); if (seen.isnew == 0) { continue; }; };
                        sq_rs_add(q, @rb.d[t * rb.nc]);
                    };
                    sq_rs_free(rb);
                    a = st.blks[a].cnext;
                };
                st.ctes[ci].work = (SQ_RS*)0;
                sq_rs_free(work);
                if (ok == 1 & ordered == 1 & qh < q.n)
                {
                    q2 = sq_rs_new(nr, nr);
                    for (t = qh; t < q.n; t++) { sq_rs_add(q2, @q.d[t * q.nc]); };
                    sq_rs_free(q);
                    q = q2;
                    qh = 0;
                    so.rs = q;
                    sq_sort_rs(@so);
                };
            };
            sq_set_free(@seen);
            sq_rs_free(q);
            if (ok == 0) { sq_rs_free(out); return (SQ_RS*)0; };
            if (maxrows >= 0)
            {
                if (lim < (i64)0 | (i64)maxrows < lim) { lim = (i64)maxrows; };
            };
            sq_rs_trim(out, off, lim);
            if (h.is_corr == 0 & maxrows < 0) { h.out = out; };
            return out;
        };

        // ORDER BY rowid (or the INTEGER PRIMARY KEY) ascending over a plain scan of one table: the scan already
        // returns the rows in that order, so the sort can be skipped
        def sq_order_by_rowid(SQ_STMT* st, SQ_BLK* h) -> bool
        {
            SQ_NODE* nd;
            SQ_SRC* sr;
            if (h.cnext >= 0 | h.nsrc != 1 | h.nagg > 0 | h.has_agg != 0 | h.ngrp > 0 | h.nwin > 0 | h.distinct != 0) { return false; };
            sr = @h.src[0];
            if (sr.kind != 1 | (u64)sr.ti == (u64)0) { return false; };
            if (sr.ti.wor == 1) { return false; };
            if (h.odesc[0] != 0) { return false; };
            nd = @st.nodes[h.ord[0]];
            if (nd.kind != SQN_COL) { return false; };
            if (nd.src != 0 | nd.lvl != 0) { return false; };
            if (nd.col == sr.ti.ncols) { return true; };
            if (sr.ti.ipk >= 0 & nd.col == sr.ti.ipk) { return true; };
            return false;
        };

        def sq_run_block(SQ_STMT* st, int bi, int maxrows) -> SQ_RS*
        {
            SQ_BLK* h = st.blks[bi];
            SQ_RS* rs;
            SQ_RS* rb;
            SQ_RS* rc;
            SQ_SORT so;
            SQ_SET set1, set2;
            SQ_VAL* row;
            i64 lim, off;
            int a, k, t, sorted, cop;
            if (h.is_corr == 0 & (u64)h.out != (u64)0) { return h.out; };
            if (h.rec > 0) { return sq_run_rec(st, bi, h.rec - 1, maxrows); };
            sq_ar_reset(@h.scr);
            lim = sq_eval_i64(st, h, h.limit_n, (i64)0 - (i64)1);
            off = sq_eval_i64(st, h, h.offset_n, (i64)0);
            if (lim < (i64)0) { lim = (i64)0 - (i64)1; };
            if (off < (i64)0) { off = (i64)0; };
            if (h.cnext < 0)
            {
                sorted = 0;
                if (h.nord > 0) { sorted = 1; };
                if (sorted == 1) { if (sq_order_by_rowid(st, h)) { sorted = 0; }; };
                if (sorted == 1)
                {
                    rs = sq_run_arm(st, bi, 1, (i64)0, (i64)0 - (i64)1, 1);
                }
                else
                {
                    // rows needed: offset plus limit (or just the first row for a probe)
                    if (maxrows >= 0)
                    {
                        if (lim < (i64)0 | (i64)maxrows < lim) { lim = (i64)maxrows; };
                    };
                    rs = sq_run_arm(st, bi, 0, off, lim, 0);
                };
                if ((u64)rs == (u64)0) { return rs; };
                if (sorted == 1)
                {
                    so.rs = rs; so.nt = h.nord;
                    for (k = 0; k < h.nord; k++)
                    {
                        so.col[k] = h.nres + k;
                        so.desc[k] = h.odesc[k];
                        so.nul[k] = h.onull[k];
                        so.coll[k] = h.ocoll[k];
                        if (so.coll[k] < 0) { so.coll[k] = sq_ecoll(st, h.ord[k]); };
                    };
                    if (sq_sort_rs(@so) != 0) { sq_rs_free(rs); sq_seterr(st, "out of memory\0"); return (SQ_RS*)0; };
                    if (maxrows >= 0)
                    {
                        if (lim < (i64)0 | (i64)maxrows < lim) { lim = (i64)maxrows; };
                    };
                    sq_rs_trim(rs, off, lim);
                };
            }
            else
            {
                rs = sq_run_arm(st, bi, 0, (i64)0, (i64)0 - (i64)1, 1);
                if ((u64)rs == (u64)0) { return rs; };
                a = h.cnext;
                while (a >= 0)
                {
                    cop = st.blks[a].cop;
                    if (st.blks[a].nres != h.nres)
                    {
                        sq_rs_free(rs);
                        sq_seterr(st, "SELECTs to the left and right of a compound operator do not have the same number of result columns\0");
                        return (SQ_RS*)0;
                    };
                    rb = sq_run_arm(st, a, 0, (i64)0, (i64)0 - (i64)1, 1);
                    if ((u64)rb == (u64)0) { sq_rs_free(rs); return rb; };
                    if (cop == 2)
                    {
                        for (t = 0; t < rb.n; t++) { sq_rs_add(rs, @rb.d[t * rb.nc]); };
                        sq_rs_free(rb);
                    }
                    else
                    {
                        rc = sq_rs_new(h.nres, h.nres);
                        sq_set_init(@set1, h.nres);
                        sq_set_init(@set2, h.nres);
                        if (cop == 1)
                        {
                            for (t = 0; t < rs.n; t++) { sq_set_add(@set1, @rs.d[t * rs.nc]); if (set1.isnew == 1) { sq_rs_add(rc, @rs.d[t * rs.nc]); }; };
                            for (t = 0; t < rb.n; t++) { sq_set_add(@set1, @rb.d[t * rb.nc]); if (set1.isnew == 1) { sq_rs_add(rc, @rb.d[t * rb.nc]); }; };
                        }
                        else
                        {
                            for (t = 0; t < rb.n; t++) { sq_set_add(@set2, @rb.d[t * rb.nc]); };
                            for (t = 0; t < rs.n; t++)
                            {
                                k = sq_set_find(@set2, @rs.d[t * rs.nc]);
                                if (cop == 3 & k < 0) { continue; };
                                if (cop == 4 & k >= 0) { continue; };
                                sq_set_add(@set1, @rs.d[t * rs.nc]);
                                if (set1.isnew == 1) { sq_rs_add(rc, @rs.d[t * rs.nc]); };
                            };
                        };
                        sq_set_free(@set1);
                        sq_set_free(@set2);
                        sq_rs_free(rs);
                        sq_rs_free(rb);
                        rs = rc;
                        // the dedupe leaves the rows ordered by value
                        sq_rs_all_cols(@so, rs);
                        sq_sort_rs(@so);
                    };
                    a = st.blks[a].cnext;
                };
                if (h.nord > 0)
                {
                    so.rs = rs; so.nt = h.nord;
                    for (k = 0; k < h.nord; k++)
                    {
                        so.col[k] = (int)st.nodes[h.ord[k]].iv;
                        so.desc[k] = h.odesc[k];
                        so.nul[k] = h.onull[k];
                        so.coll[k] = h.ocoll[k];
                        if (so.coll[k] < 0) { so.coll[k] = 0; };
                    };
                    sq_sort_rs(@so);
                };
                if (maxrows >= 0)
                {
                    if (lim < (i64)0 | (i64)maxrows < lim) { lim = (i64)maxrows; };
                };
                sq_rs_trim(rs, off, lim);
            };
            if (h.is_corr == 0) { h.out = rs; };
            return rs;
        };

        // ---- statement lifecycle ----

        def sq_att_wis(byte* sql, int s, int e, byte* w) -> bool
        {
            int j;
            byte c;
            for (j = 0; j < e - s; j++)
            {
                if (w[j] == (byte)0) { return false; };
                c = sql[s + j];
                if (c >= (byte)65 & c <= (byte)90) { c = c + (byte)32; };
                if (c != w[j]) { return false; };
            };
            return w[e - s] == (byte)0;
        };

        // the private database that holds TEMP objects, created on first use as an attached database named temp
        def sq_att_temp(SQLITE_DB* db) -> SQLITE_DB*
        {
            SQLITE_DB* d2;
            byte[330] path;
            int k, i, n;
            if ((u64)db.home != (u64)0) { db = (SQLITE_DB*)db.home; };
            if (db.natt > 0)
            {
                if (db.attn[0] == (byte)116 & db.attn[1] == (byte)101 & db.attn[2] == (byte)109 & db.attn[3] == (byte)112 & db.attn[4] == (byte)0) { return (SQLITE_DB*)db.att[0]; };
            };
            if (db.natt >= 10) { return db; };
            k = 0;
            while (db.path[k] != (byte)0 & k < 300) { path[k] = db.path[k]; k++; };
            path[k] = (byte)45; path[k + 1] = (byte)116; path[k + 2] = (byte)109; path[k + 3] = (byte)112; path[k + 4] = (byte)0;
            remove(@path[0]);
            d2 = (SQLITE_DB*)fmalloc((u64)(sizeof(SQLITE_DB) / 8 + 4096));
            if ((u64)d2 == (u64)0) { return db; };
            if (sq_open_rw(d2, @path[0], 1) != 0) { ffree((u64)d2); return db; };
            if (sq_schema_load(d2) < 0) { sq_close(d2); ffree((u64)d2); remove(@path[0]); return db; };
            d2.home = (void*)db;
            for (n = db.natt; n > 0; n--)
            {
                db.att[n] = db.att[n - 1];
                db.attm[n] = db.attm[n - 1];
                for (i = 0; i < 32; i++) { db.attn[n * 32 + i] = db.attn[(n - 1) * 32 + i]; };
            };
            db.att[0] = (void*)d2;
            db.attm[0] = 1;
            db.attn[0] = (byte)116; db.attn[1] = (byte)101; db.attn[2] = (byte)109; db.attn[3] = (byte)112; db.attn[4] = (byte)0;
            db.natt = db.natt + 1;
            return d2;
        };

        def sq_att_wis(byte* sql, int s, int e, byte* w) -> bool
        {
            int j;
            byte c;
            for (j = 0; j < e - s; j++)
            {
                if (w[j] == (byte)0) { return false; };
                c = sql[s + j];
                if (c >= (byte)65 & c <= (byte)90) { c = c + (byte)32; };
                if (c != w[j]) { return false; };
            };
            return w[e - s] == (byte)0;
        };

        def sq_att_isid(byte c) -> bool
        {
            return (c >= (byte)65 & c <= (byte)90) | (c >= (byte)97 & c <= (byte)122) | c == (byte)95 | (c >= (byte)48 & c <= (byte)57);
        };

        // the database that holds the named object, looking in temp, main and then the attached ones
        def sq_att_where(SQLITE_DB* db, SQLITE_DB* own, byte* sql, int s, int e, int k1, int k2) -> SQLITE_DB*
        {
            int k;
            SQLITE_DB* d;
            if ((u64)own != (u64)db)
            {
                if (sq_find_obj(own, sql, s, e - s, k1) >= 0) { return own; };
                if (k2 > 0) { if (sq_find_obj(own, sql, s, e - s, k2) >= 0) { return own; }; };
            };
            if (db.natt > 0)
            {
                if (db.attn[0] == (byte)116 & db.attn[1] == (byte)101 & db.attn[2] == (byte)109 & db.attn[3] == (byte)112 & db.attn[4] == (byte)0)
                {
                    d = (SQLITE_DB*)db.att[0];
                    if (sq_find_obj(d, sql, s, e - s, k1) >= 0) { return d; };
                    if (k2 > 0) { if (sq_find_obj(d, sql, s, e - s, k2) >= 0) { return d; }; };
                };
            };
            if (sq_find_obj(db, sql, s, e - s, k1) >= 0) { return db; };
            if (k2 > 0) { if (sq_find_obj(db, sql, s, e - s, k2) >= 0) { return db; }; };
            for (k = 0; k < db.natt; k++)
            {
                d = (SQLITE_DB*)db.att[k];
                if (sq_find_obj(d, sql, s, e - s, k1) >= 0) { return d; };
                if (k2 > 0) { if (sq_find_obj(d, sql, s, e - s, k2) >= 0) { return d; }; };
            };
            return own;
        };

        // Chooses the database a statement runs against (strip 0) and removes the schema words that only the choice needed
        // (strip 1). A query names its databases in FROM and is left alone. The target of any other statement is named by
        // "schema." right after its own keywords, by the word TEMP in CREATE TEMP, by a schema name after ANALYZE or
        // VACUUM, or by nothing: then the object is looked for in temp, main and the attached databases in that order.
        def sq_att_scan(SQLITE_DB* db, byte* sql, int strip) -> SQLITE_DB*
        {
            int i, s, e, k, j, q, same, mk, st0, k2, ps, pe, fs, fe, tg, s2, e2, k1, kb, ok, istrig;
            byte c;
            SQLITE_DB* d;
            SQLITE_DB* own;
            own = db;
            if ((u64)db.home != (u64)0) { db = (SQLITE_DB*)db.home; };
            if (strip == 1) { if ((u64)own.home == (u64)0) { SQ_QUALN = 0; }; };
            i = 0;
            while (sql[i] == (byte)32 | sql[i] == (byte)9 | sql[i] == (byte)10 | sql[i] == (byte)13) { i++; };
            fs = i;
            while (sq_att_isid(sql[i])) { i++; };
            fe = i;
            if (fe == fs) { return own; };
            if (sq_att_wis(sql, fs, fe, "select\0") | sq_att_wis(sql, fs, fe, "with\0") | sq_att_wis(sql, fs, fe, "values\0")) { return own; };
            // CREATE TEMP ..., ANALYZE name, VACUUM name
            j = i;
            while (sql[j] == (byte)32 | sql[j] == (byte)9 | sql[j] == (byte)10 | sql[j] == (byte)13) { j++; };
            s2 = j;
            while (sq_att_isid(sql[j])) { j++; };
            e2 = j;
            if (e2 > s2)
            {
                if (sq_att_wis(sql, fs, fe, "create\0") & (sq_att_wis(sql, s2, e2, "temp\0") | sq_att_wis(sql, s2, e2, "temporary\0")))
                {
                    if (strip == 1)
                    {
                        k2 = e2;
                        while (sql[k2] == (byte)32 | sql[k2] == (byte)9 | sql[k2] == (byte)10 | sql[k2] == (byte)13) { k2++; };
                        j = s2;
                        while (sql[k2] != (byte)0) { sql[j] = sql[k2]; j++; k2++; };
                        sql[j] = (byte)0;
                        return own;
                    };
                    return sq_att_temp(db);
                };
                if (sq_att_wis(sql, fs, fe, "analyze\0") | sq_att_wis(sql, fs, fe, "vacuum\0") | sq_att_wis(sql, fs, fe, "reindex\0"))
                {
                    k2 = j;
                    while (sql[k2] == (byte)32 | sql[k2] == (byte)9 | sql[k2] == (byte)10 | sql[k2] == (byte)13) { k2++; };
                    if (sql[k2] != (byte)46)
                    {
                        for (k = 0; k < db.natt; k++)
                        {
                            same = 1;
                            if (e2 - s2 > 31) { same = 0; };
                            for (q = 0; q < e2 - s2 & same == 1; q++)
                            {
                                c = sql[s2 + q];
                                if (c >= (byte)65 & c <= (byte)90) { c = c + (byte)32; };
                                if (c != db.attn[k * 32 + q]) { same = 0; };
                            };
                            if (same == 1 & db.attn[k * 32 + (e2 - s2)] == (byte)0)
                            {
                                if (strip == 1)
                                {
                                    k2 = e2;
                                    j = s2;
                                    while (sql[k2] != (byte)0) { sql[j] = sql[k2]; j++; k2++; };
                                    sql[j] = (byte)0;
                                    return own;
                                };
                                return (SQLITE_DB*)db.att[k];
                            };
                        };
                    };
                };
            };
            ps = 0; pe = 0;
            // inside CREATE TRIGGER only the trigger's own name can carry a schema
            istrig = 0;
            if (sq_att_wis(sql, fs, fe, "create\0"))
            {
                if (sq_att_wis(sql, s2, e2, "trigger\0")) { istrig = 1; };
                if (sq_att_wis(sql, s2, e2, "temp\0") | sq_att_wis(sql, s2, e2, "temporary\0"))
                {
                    j = e2;
                    while (sql[j] == (byte)32 | sql[j] == (byte)9 | sql[j] == (byte)10 | sql[j] == (byte)13) { j++; };
                    k2 = j;
                    while (sq_att_isid(sql[j])) { j++; };
                    if (sq_att_wis(sql, k2, j, "trigger\0")) { istrig = 1; };
                };
            };
            i = fe;
            while (sql[i] != (byte)0)
            {
                c = sql[i];
                if (c == (byte)39)
                {
                    i++;
                    while (sql[i] != (byte)0)
                    {
                        if (sql[i] == (byte)39) { if (sql[i + 1] == (byte)39) { i = i + 2; continue; }; break; };
                        i++;
                    };
                    if (sql[i] != (byte)0) { i++; };
                    continue;
                };
                if (c == (byte)45 & sql[i + 1] == (byte)45)
                {
                    while (sql[i] != (byte)0 & sql[i] != (byte)10) { i++; };
                    continue;
                };
                if (c == (byte)47 & sql[i + 1] == (byte)42)
                {
                    i = i + 2;
                    while (sql[i] != (byte)0 & (sql[i] != (byte)42 | sql[i + 1] != (byte)47)) { i++; };
                    if (sql[i] != (byte)0) { i = i + 2; };
                    continue;
                };
                q = 0;
                if (c == (byte)34 | c == (byte)96)
                {
                    q = 1;
                    s = i + 1;
                    e = s;
                    while (sql[e] != (byte)0 & sql[e] != c) { e++; };
                    i = e;
                    if (sql[i] != (byte)0) { i++; };
                }
                else
                {
                    if (sq_att_isid(c) & (c < (byte)48 | c > (byte)57))
                    {
                        s = i;
                        e = i;
                        while (sq_att_isid(sql[e])) { e++; };
                        i = e;
                    }
                    else { i++; continue; };
                };
                // is this word the target of the statement
                tg = 0;
                if (pe > ps)
                {
                    if (sq_att_wis(sql, ps, pe, "into\0") | sq_att_wis(sql, ps, pe, "update\0") | sq_att_wis(sql, ps, pe, "table\0") | sq_att_wis(sql, ps, pe, "index\0") | sq_att_wis(sql, ps, pe, "view\0") | sq_att_wis(sql, ps, pe, "trigger\0") | sq_att_wis(sql, ps, pe, "exists\0") | sq_att_wis(sql, ps, pe, "pragma\0") | sq_att_wis(sql, ps, pe, "reindex\0") | sq_att_wis(sql, ps, pe, "analyze\0")) { tg = 1; };
                    if (sq_att_wis(sql, ps, pe, "from\0") & sq_att_wis(sql, fs, fe, "delete\0")) { tg = 1; };
                    if (sq_att_wis(sql, fs, fe, "update\0") & (sq_att_wis(sql, ps, pe, "replace\0") | sq_att_wis(sql, ps, pe, "abort\0") | sq_att_wis(sql, ps, pe, "fail\0") | sq_att_wis(sql, ps, pe, "ignore\0") | sq_att_wis(sql, ps, pe, "rollback\0"))) { tg = 1; };
                    if (sq_att_wis(sql, ps, pe, "on\0") & sq_att_wis(sql, fs, fe, "create\0")) { tg = 2; };
                    if (istrig == 1 & tg != 2) { tg = 0; if (sq_att_wis(sql, ps, pe, "trigger\0") | sq_att_wis(sql, ps, pe, "exists\0")) { tg = 1; }; };
                }
                else
                {
                    if (sq_att_wis(sql, fs, fe, "pragma\0") | sq_att_wis(sql, fs, fe, "update\0") | sq_att_wis(sql, fs, fe, "reindex\0") | sq_att_wis(sql, fs, fe, "analyze\0")) { tg = 1; };
                };
                if (sql[i] == (byte)46 & tg == 1)
                {
                    mk = 0 - 1;
                    same = 0;
                    if (e - s == 4)
                    {
                        same = 1;
                        c = sql[s]; if (c >= (byte)65 & c <= (byte)90) { c = c + (byte)32; }; if (c != (byte)109) { same = 0; };
                        c = sql[s + 1]; if (c >= (byte)65 & c <= (byte)90) { c = c + (byte)32; }; if (c != (byte)97) { same = 0; };
                        c = sql[s + 2]; if (c >= (byte)65 & c <= (byte)90) { c = c + (byte)32; }; if (c != (byte)105) { same = 0; };
                        c = sql[s + 3]; if (c >= (byte)65 & c <= (byte)90) { c = c + (byte)32; }; if (c != (byte)110) { same = 0; };
                    };
                    for (k = 0; k < db.natt; k++)
                    {
                        ok = 1;
                        if (e - s > 31) { ok = 0; };
                        for (j = 0; j < e - s & ok == 1; j++)
                        {
                            c = sql[s + j];
                            if (c >= (byte)65 & c <= (byte)90) { c = c + (byte)32; };
                            if (c != db.attn[k * 32 + j]) { ok = 0; };
                        };
                        if (ok == 1 & db.attn[k * 32 + (e - s)] == (byte)0) { mk = k; break; };
                    };
                    if (sq_att_wis(sql, s, e, "temporary\0")) { if (db.natt > 0) { if (db.attn[0] == (byte)116 & db.attn[4] == (byte)0) { mk = 0; }; }; };
                    if (mk >= 0 | same == 1)
                    {
                        if (strip == 1)
                        {
                            if (e - s < 38 & mk >= 0 & db.attm[mk] == 0) { for (j = 0; j < e - s; j++) { SQ_QUAL[j] = sql[s + j]; }; SQ_QUALN = e - s; };
                            st0 = s;
                            if (sql[s - 1] == (byte)34 | sql[s - 1] == (byte)96) { st0 = s - 1; };
                            k2 = i + 1;
                            j = st0;
                            while (sql[k2] != (byte)0) { sql[j] = sql[k2]; j++; k2++; };
                            sql[j] = (byte)0;
                            return own;
                        };
                        if (mk >= 0) { return (SQLITE_DB*)db.att[mk]; };
                        return own;
                    };
                    ps = s; pe = e;
                    continue;
                };
                if (sql[i] != (byte)46 & tg > 0 & strip == 0)
                {
                    // no schema written: the object decides
                    k1 = 1; kb = 3;
                    if (sq_att_wis(sql, fs, fe, "drop\0"))
                    {
                        if (sq_att_wis(sql, ps, pe, "index\0")) { k1 = 2; kb = 0; };
                        if (sq_att_wis(sql, ps, pe, "view\0")) { k1 = 3; kb = 0; };
                        if (sq_att_wis(sql, ps, pe, "trigger\0")) { k1 = 4; kb = 0; };
                        if (sq_att_wis(sql, ps, pe, "table\0")) { kb = 0; };
                        if (sq_att_wis(sql, ps, pe, "exists\0")) { kb = 0; };
                    };
                    if (sq_att_wis(sql, fs, fe, "reindex\0")) { k1 = 2; kb = 1; };
                    ok = 0;
                    if (sq_att_wis(sql, fs, fe, "insert\0") | sq_att_wis(sql, fs, fe, "replace\0") | sq_att_wis(sql, fs, fe, "update\0") | sq_att_wis(sql, fs, fe, "delete\0") | sq_att_wis(sql, fs, fe, "drop\0") | sq_att_wis(sql, fs, fe, "alter\0") | sq_att_wis(sql, fs, fe, "reindex\0") | sq_att_wis(sql, fs, fe, "analyze\0")) { ok = 1; };
                    if (sq_att_wis(sql, fs, fe, "create\0") & tg == 2) { ok = 1; };
                    if (ok == 1 & sq_att_wis(sql, fs, fe, "drop\0") & sq_att_wis(sql, ps, pe, "exists\0"))
                    {
                        // DROP x IF EXISTS: the kind is whatever followed DROP
                        k1 = 1; kb = 3;
                    };
                    if (ok == 1)
                    {
                        d = sq_att_where(db, own, sql, s, e, k1, kb);
                        return d;
                    };
                };
                ps = s; pe = e;
            };
            return own;
        };

        def sq_stmt_init(SQ_STMT* st, SQLITE_DB* db, byte* sql) -> void
        {
            int n, i;
            n = 0;
            while (sql[n] != (byte)0 & n < 200000) { st.sql[n] = sql[n]; n++; };
            st.sql[n] = (byte)0;
            st.db = sq_att_scan(db, @st.sql[0], 0);
            sq_att_scan(db, @st.sql[0], 1);
            n = 0;
            while (st.sql[n] != (byte)0) { n++; };
            st.sqllen = n;
            st.lim = n;
            st.pos = 0; st.tk = 0; st.ts = 0; st.tl = 0; st.tq = 0; st.tcode = 0; st.tend = 0; st.prevend = 0;
            st.nodes = (SQ_NODE*)0; st.nn = 0; st.ncap = 0; st.bn = 0;
            st.nblk = 0; st.ncte = 0; st.nwin = 0; st.nwdef = 0; st.kind = 0; st.root_blk = 0 - 1; st.nres = 0; st.curblk = 0 - 1;
            st.pcount = 0; st.nparam = 0;
            for (i = 0; i < 64; i++) { sq_val_null(@st.pv[i]); st.pns[i] = 0; st.pnl[i] = 0; };
            sq_ar_init(@st.par);
            sq_ar_init(@st.ar);
            st.state = 0; st.ri = 0; st.res = (SQ_RS*)0; st.ncols_out = 0;
            st.err[0] = (byte)0;
            st.changes = 0;
            st.last_rowid = (i64)0;
            st.dml_tbl = 0 - 1; st.dml_root = 0;
            st.ret = (SQ_RS*)0; st.retsql = (byte*)0; st.ret_s = 0 - 1; st.ret_e = 0 - 1;
        };

        def sq_clear_caches(SQ_STMT* st) -> void
        {
            int i;
            for (i = 0; i < st.nblk; i++)
            {
                if ((u64)st.blks[i].out != (u64)0) { sq_rs_free(st.blks[i].out); st.blks[i].out = (SQ_RS*)0; };
            };
            for (i = 0; i < st.ncte; i++) { st.ctes[i].rs = (SQ_RS*)0; };
            st.res = (SQ_RS*)0;
        };

        def sq_reset(SQ_STMT* st) -> void
        {
            sq_clear_caches(st);
            st.state = 0;
            st.ri = 0;
            st.err[0] = (byte)0;
        };

        def sq_stmt_del(SQ_STMT* st) -> void;

        def sq_finalize(SQ_STMT* st) -> void
        {
            int i, j;
            SQ_BLK* b;
            SQ_SRC* sr;
            if ((u64)st.res != (u64)0 & st.kind == 2) { sq_rs_free(st.res); st.res = (SQ_RS*)0; };
            if ((u64)st.ret != (u64)0) { sq_rs_free(st.ret); st.ret = (SQ_RS*)0; if (st.kind == 3) { st.res = (SQ_RS*)0; }; };
            if ((u64)st.retsql != (u64)0) { ffree((u64)st.retsql); st.retsql = (byte*)0; };
            sq_clear_caches(st);
            for (i = 0; i < st.nblk; i++)
            {
                b = st.blks[i];
                for (j = 0; j < b.nsrc; j++)
                {
                    sr = @b.src[j];
                    if ((u64)sr.ti != (u64)0)
                    {
                        if (sr.kind == 1 | sr.kind == 3) { if ((u64)sr.ti.base != (u64)0) { ffree((u64)sr.ti.base); }; };
                        if (sr.ti.gst != (u64)0) { sq_stmt_del((SQ_STMT*)sr.ti.gst); sr.ti.gst = (u64)0; };
                        ffree((u64)sr.ti);
                        sr.ti = (SQ_TI*)0;
                    };
                };
                sq_ar_free(@b.scr);
                sq_ar_free(@b.gar);
                ffree((u64)b.src);
                ffree((u64)b);
                st.blks[i] = (SQ_BLK*)0;
            };
            st.nblk = 0;
            if ((u64)st.nodes != (u64)0) { ffree((u64)st.nodes); st.nodes = (SQ_NODE*)0; };
            st.nn = 0; st.ncap = 0;
            sq_ar_free(@st.par);
            sq_ar_free(@st.ar);
        };

        // ---- parameters ----

        def sq_bind_null(SQ_STMT* st, int idx) -> int
        {
            if (idx < 1 | idx > 64) { return 1; };
            sq_val_null(@st.pv[idx - 1]);
            return 0;
        };

        def sq_bind_int(SQ_STMT* st, int idx, i64 v) -> int
        {
            if (idx < 1 | idx > 64) { return 1; };
            sq_val_int(@st.pv[idx - 1], v);
            return 0;
        };

        def sq_bind_real(SQ_STMT* st, int idx, double v) -> int
        {
            if (idx < 1 | idx > 64) { return 1; };
            sq_val_real(@st.pv[idx - 1], v);
            return 0;
        };

        def sq_bind_bytes(SQ_STMT* st, int idx, byte* p, int n, int ty) -> int
        {
            byte* c;
            if (idx < 1 | idx > 64) { return 1; };
            c = sq_ar_copy(@st.par, p, n);
            if ((u64)c == (u64)0) { return 1; };
            st.pv[idx - 1].t = ty; st.pv[idx - 1].p = c; st.pv[idx - 1].n = n; st.pv[idx - 1].i = (i64)0; st.pv[idx - 1].r = 0.0;
            return 0;
        };

        def sq_bind_text(SQ_STMT* st, int idx, byte* p, int n) -> int
        {
            return sq_bind_bytes(st, idx, p, n, SQ_TEXT);
        };

        def sq_bind_blob(SQ_STMT* st, int idx, byte* p, int n) -> int
        {
            return sq_bind_bytes(st, idx, p, n, SQ_BLOB);
        };

        // index of a named parameter (":name", "@name" or "$name" including the prefix) or 0
        def sq_param_index(SQ_STMT* st, byte* name) -> int
        {
            int k, n;
            n = sq_cstrlen(name);
            for (k = 1; k <= st.nparam; k++)
            {
                if (st.pnl[k - 1] == n)
                {
                    if (sq_mem_eq(@st.sql[st.pns[k - 1]], name, n)) { return k; };
                };
            };
            return 0;
        };

        def sq_params_reset(SQ_STMT* st) -> void
        {
            int i;
            for (i = 0; i < 64; i++) { sq_val_null(@st.pv[i]); };
            sq_ar_free(@st.par);
        };

        // ---- SELECT entry points ----

        def sq_end_stmt(SQ_STMT* st) -> int
        {
            if (sq_is_op(st, 59)) { sq_next(st); };
            if (st.tk != 0) { sq_seterr(st, "unexpected text after the end of the statement\0"); return 1; };
            return 0;
        };

        def sq_prep_query(SQ_STMT* st, SQLITE_DB* db, byte* sql) -> int
        {
            int b;
            sq_stmt_init(st, db, sql);
            sq_next(st);
            b = sq_parse_select(st, 0 - 1);
            if (b < 0) { if (st.err[0] == (byte)0) { sq_seterr(st, "syntax error\0"); }; return 1; };
            st.root_blk = b;
            if (sq_end_stmt(st) != 0) { return 1; };
            if (sq_bind_all(st) != 0) { return 1; };
            st.nres = st.blks[b].nres;
            st.kind = 1;
            return 0;
        };

        // a query holds a read lock on the database it runs in and on every database attached to the same connection
        def sq_rd_begin_all(SQLITE_DB* db) -> int
        {
            SQLITE_DB* h;
            SQLITE_DB* d;
            int k, n;
            h = db;
            if ((u64)db.home != (u64)0) { h = (SQLITE_DB*)db.home; };
            if (sq_read_begin(db) != 0) { return 1; };
            if (h.natt == 0 & (u64)db.home == (u64)0) { return 0; };
            if ((u64)h != (u64)db) { if (sq_read_begin(h) != 0) { sq_read_end(db); return 1; }; };
            for (k = 0; k < h.natt; k++)
            {
                d = (SQLITE_DB*)h.att[k];
                if ((u64)d == (u64)db) { continue; };
                if (sq_read_begin(d) != 0)
                {
                    for (n = 0; n < k; n++) { if ((u64)h.att[n] != (u64)db) { sq_read_end((SQLITE_DB*)h.att[n]); }; };
                    if ((u64)h != (u64)db) { sq_read_end(h); };
                    sq_read_end(db);
                    return 1;
                };
            };
            return 0;
        };

        def sq_rd_end_all(SQLITE_DB* db) -> void
        {
            SQLITE_DB* h;
            int k;
            h = db;
            if ((u64)db.home != (u64)0) { h = (SQLITE_DB*)db.home; };
            for (k = 0; k < h.natt; k++)
            {
                if ((u64)h.att[k] != (u64)db) { sq_read_end((SQLITE_DB*)h.att[k]); };
            };
            if ((u64)h != (u64)db) { sq_read_end(h); };
            sq_read_end(db);
        };

        def sq_step_query(SQ_STMT* st) -> int
        {
            if (st.state == 2) { return 0; };
            if (st.kind == 3)
            {
                if (st.state == 0)
                {
                    st.res = st.ret;
                    st.ri = 0;
                    st.state = 1;
                    if ((u64)st.res == (u64)0) { st.state = 2; return 0; };
                }
                else { st.ri++; };
                if (st.ri >= st.res.n) { st.state = 2; return 0; };
                return 1;
            };
            if (st.state == 0)
            {
                st.db.busy = 0;
                if (sq_rd_begin_all(st.db) != 0)
                {
                    sq_seterr(st, "database is locked\0");
                    st.db.busy = 0;
                    st.state = 2;
                    return 0 - 1;
                };
                st.res = sq_run_block(st, st.root_blk, 0 - 1);
                sq_rd_end_all(st.db);
                if ((u64)st.res == (u64)0) { st.state = 2; return 0 - 1; };
                st.ri = 0;
                st.state = 1;
            }
            else { st.ri++; };
            if (st.ri >= st.res.n) { st.state = 2; return 0; };
            return 1;
        };

        def sq_column_count(SQ_STMT* st) -> int
        {
            return st.nres;
        };

        def sq_column_name(SQ_STMT* st, int i, byte* out, int cap) -> int
        {
            int s, l, k;
            byte* base;
            if (i < 0 | i >= st.nres) { out[0] = (byte)0; return 0; };
            base = sq_res_name(st, st.blks[st.root_blk], i, @s, @l);
            k = 0;
            while (k < l & k < cap - 1) { out[k] = base[s + k]; k++; };
            out[k] = (byte)0;
            return k;
        };

        def sq_cell(SQ_STMT* st, int i) -> SQ_VAL*
        {
            if ((u64)st.res == (u64)0 | st.state != 1) { return (SQ_VAL*)0; };
            if (i < 0 | i >= st.nres) { return (SQ_VAL*)0; };
            return @st.res.d[st.ri * st.res.nc + i];
        };

        def sq_column_type(SQ_STMT* st, int i) -> int
        {
            SQ_VAL* v = sq_cell(st, i);
            if ((u64)v == (u64)0) { return SQ_NULL; };
            return v.t;
        };

        def sq_column_int(SQ_STMT* st, int i) -> i64
        {
            SQ_VAL* v = sq_cell(st, i);
            SQ_VAL t;
            if ((u64)v == (u64)0) { return (i64)0; };
            sq_cast((SQ_ARENA*)0, v, 3, @t);
            if (t.t == SQ_INTEGER) { return t.i; };
            return (i64)0;
        };

        def sq_column_real(SQ_STMT* st, int i) -> double
        {
            SQ_VAL* v = sq_cell(st, i);
            if ((u64)v == (u64)0) { return 0.0; };
            return sq_as_double(v);
        };

        def sq_column_bytes(SQ_STMT* st, int i) -> int
        {
            SQ_VAL* v = sq_cell(st, i);
            byte[64] buf;
            if ((u64)v == (u64)0) { return 0; };
            if (v.t == SQ_TEXT | v.t == SQ_BLOB) { return v.n; };
            if (v.t == SQ_INTEGER) { return sq_itoa(v.i, @buf[0]); };
            if (v.t == SQ_REAL) { return sq_real_text(v.r, @buf[0]); };
            return 0;
        };

        def sq_column_ptr(SQ_STMT* st, int i) -> byte*
        {
            SQ_VAL* v = sq_cell(st, i);
            SQ_VAL t;
            if ((u64)v == (u64)0) { return (byte*)0; };
            if (v.t == SQ_TEXT | v.t == SQ_BLOB) { return v.p; };
            if (v.t == SQ_INTEGER | v.t == SQ_REAL)
            {
                sq_val_text(@st.ar, v, @t);
                return t.p;
            };
            return (byte*)0;
        };

        // copies the value as text (numbers are formatted), zero terminates and returns the length
        def sq_column_text(SQ_STMT* st, int i, byte* out, int cap) -> int
        {
            SQ_VAL* v = sq_cell(st, i);
            byte[64] buf;
            byte* p;
            int n, k;
            if ((u64)v == (u64)0 | cap <= 0) { if (cap > 0) { out[0] = (byte)0; }; return 0; };
            if (v.t == SQ_TEXT | v.t == SQ_BLOB) { p = v.p; n = v.n; }
            else
            {
                if (v.t == SQ_INTEGER) { n = sq_itoa(v.i, @buf[0]); p = @buf[0]; }
                else
                {
                    if (v.t == SQ_REAL) { n = sq_real_text(v.r, @buf[0]); p = @buf[0]; }
                    else { out[0] = (byte)0; return 0; };
                };
            };
            k = 0;
            while (k < n & k < cap - 1) { out[k] = p[k]; k++; };
            out[k] = (byte)0;
            return k;
        };

        // ---- helpers for the write layer ----

        // a statement object on the heap (the structure is large)
        def sq_stmt_new() -> SQ_STMT*
        {
            return (SQ_STMT*)fmalloc((u64)(sizeof(SQ_STMT) / 8 + 4096));
        };

        def sq_stmt_del(SQ_STMT* st) -> void
        {
            sq_finalize(st);
            ffree((u64)st);
        };

        // Evaluates a constant expression "select <text>" and returns its first value, text owned by ar. 0 on success.
        def sq_eval_text(SQLITE_DB* db, byte* p, int n, SQ_ARENA* ar, SQ_VAL* out) -> int
        {
            SQ_STMT* st;
            byte* buf;
            int rc, i;
            sq_val_null(out);
            buf = (byte*)fmalloc((u64)(n + 16));
            if ((u64)buf == (u64)0) { return 1; };
            sq_mcpy(buf, "select \0", 7);
            for (i = 0; i < n; i++) { buf[7 + i] = p[i]; };
            buf[7 + n] = (byte)0;
            st = sq_stmt_new();
            if ((u64)st == (u64)0) { ffree((u64)buf); return 1; };
            rc = sq_prep_query(st, db, buf);
            ffree((u64)buf);
            if (rc != 0) { sq_stmt_del(st); return 1; };
            if (sq_step_query(st) == 1)
            {
                sq_val_copy(out, sq_cell(st, 0));
                sq_val_own(ar, out);
            }
            else { rc = 1; };
            sq_stmt_del(st);
            return rc;
        };

        // ---- generated columns ----


        // builds the evaluator statement "select (e1), (e2) from (select ?1 as c1, ?2 as c2, ...)"
        def sq_gen_open(SQ_STMT* st, SQ_TI* ti) -> int
        {
            int c, n, i, cap, rc;
            byte* buf;
            byte* lit;
            SQ_STMT* g;
            cap = 64;
            for (c = 0; c < ti.ncols; c++) { cap = cap + ti.gl[c] + ti.cl[c] * 2 + 48; };
            buf = (byte*)fmalloc((u64)cap);
            if ((u64)buf == (u64)0) { sq_seterr(st, "out of memory\0"); return 1; };
            n = 0;
            lit = "select \0";
            for (i = 0; lit[i] != (byte)0; i++) { buf[n] = lit[i]; n++; };
            rc = 0;
            for (c = 0; c < ti.ncols; c++)
            {
                if (ti.gen[c] == 0) { continue; };
                if (rc > 0) { buf[n] = (byte)44; n++; buf[n] = (byte)32; n++; };
                rc++;
                buf[n] = (byte)40; n++;
                for (i = 0; i < ti.gl[c]; i++) { buf[n] = ti.base[ti.gs[c] + i]; n++; };
                buf[n] = (byte)41; n++;
            };
            lit = " from (select \0";
            for (i = 0; lit[i] != (byte)0; i++) { buf[n] = lit[i]; n++; };
            for (c = 0; c < ti.ncols; c++)
            {
                if (c > 0) { buf[n] = (byte)44; n++; buf[n] = (byte)32; n++; };
                buf[n] = (byte)63; n++;
                if (c + 1 >= 100) { buf[n] = (byte)(48 + (c + 1) / 100); n++; };
                if (c + 1 >= 10) { buf[n] = (byte)(48 + ((c + 1) / 10) % 10); n++; };
                buf[n] = (byte)(48 + (c + 1) % 10); n++;
                lit = " as \"\0";
                for (i = 0; lit[i] != (byte)0; i++) { buf[n] = lit[i]; n++; };
                for (i = 0; i < ti.cl[c]; i++)
                {
                    if (ti.base[ti.cs[c] + i] == (byte)34) { buf[n] = (byte)34; n++; };
                    buf[n] = ti.base[ti.cs[c] + i]; n++;
                };
                buf[n] = (byte)34; n++;
            };
            buf[n] = (byte)41; n++;
            buf[n] = (byte)0;
            g = sq_stmt_new();
            if ((u64)g == (u64)0) { ffree((u64)buf); sq_seterr(st, "out of memory\0"); return 1; };
            rc = sq_prep_query(g, st.db, buf);
            ffree((u64)buf);
            if (rc != 0)
            {
                sq_seterr(st, @g.err[0]);
                sq_stmt_del(g);
                return 1;
            };
            ti.gst = (u64)g;
            return 0;
        };

        // computes every generated column of row[0..ncols) from the other columns. Text results live in ar. 0 ok, 1 error.
        def sq_gen_row(SQ_STMT* st, SQ_TI* ti, SQ_ARENA* ar, SQ_VAL* row, int mode) -> int
        {
            SQ_STMT* g;
            SQ_VAL* v;
            SQ_VAL* cv;
            int pass, passes, c, m, r;
            byte* p;
            if (ti.gst == (u64)0) { if (sq_gen_open(st, ti) != 0) { return 1; }; };
            g = (SQ_STMT*)ti.gst;
            passes = 1;
            if (ti.ngen > 1) { passes = ti.ngen; };
            for (pass = 0; pass < passes; pass++)
            {
                sq_reset(g);
                sq_params_reset(g);
                for (c = 0; c < ti.ncols; c++)
                {
                    v = @row[c];
                    if (v.t == SQ_NULL) { sq_bind_null(g, c + 1); };
                    if (v.t == SQ_INTEGER) { sq_bind_int(g, c + 1, v.i); };
                    if (v.t == SQ_REAL) { sq_bind_real(g, c + 1, v.r); };
                    if (v.t == SQ_TEXT) { sq_bind_text(g, c + 1, v.p, v.n); };
                    if (v.t == SQ_BLOB) { sq_bind_blob(g, c + 1, v.p, v.n); };
                };
                r = sq_step_query(g);
                if (r != 1) { sq_seterr(st, @g.err[0]); return 1; };
                m = 0;
                for (c = 0; c < ti.ncols; c++)
                {
                    if (ti.gen[c] == 0) { continue; };
                    cv = sq_cell(g, m);
                    m++;
                    if (mode == 1 & ti.gen[c] == 2) { continue; };
                    if (cv.t == SQ_TEXT | cv.t == SQ_BLOB)
                    {
                        row[c].t = cv.t; row[c].n = cv.n; row[c].i = (i64)0; row[c].r = 0.0;
                        p = sq_ar_copy(ar, cv.p, cv.n);
                        if ((u64)p == (u64)0) { sq_val_null(@row[c]); } else { row[c].p = p; };
                    }
                    else { sq_val_copy(@row[c], cv); };
                    sq_apply_aff(ar, ti.aff[c], @row[c]);
                };
            };
            return 0;
        };


    }; // sqlite
}; // standard

#endif; // IDEKA_STANDARD_SQLITE_CORE
