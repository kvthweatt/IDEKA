            if (sq_dt_parse_val(@d1, @a[0]) == false) { sq_val_null(out); return; };
            if (sq_dt_parse_val(@d2, @a[1]) == false) { sq_val_null(out); return; };
            if (sq_dt_valid(@d1) == false | sq_dt_valid(@d2) == false) { sq_val_null(out); return; };
            sq_dt_compute_jd(@d1); sq_dt_compute_jd(@d2);
            sq_dt_compute_ymd(@d1); sq_dt_compute_hms(@d1);
            sq_dt_compute_ymd(@d2); sq_dt_compute_hms(@d2);
            if (d1.jd >= d2.jd)
            {
                sign = 43;
                Y = d1.Y - d2.Y;
                if (Y != 0) { d2.Y = d1.Y; sq_dt_rejd(@d2); };
                M = d1.M - d2.M;
                if (M < 0) { Y--; M = M + 12; };
                if (M != 0) { d2.M = d1.M; sq_dt_rejd(@d2); };
                while (d1.jd < d2.jd)
