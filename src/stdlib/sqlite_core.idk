                    ln = nd + zl + nc + plen;
                    if (flagalt == 1)
                    {
                        if (c == 120 | c == 88 | c == 112) { ln = ln + 2; };
                        if (c == 111) { ln = ln + 1; };
                    };
                    if (c == 114) { ln = ln + 2; };
                    pad = width - ln;
                    if (pad > 0 & flagleft == 0) { while (pad > 0) { r[o] = (byte)32; o++; pad--; }; };
                    if (flagalt == 1)
                    {
                        if (c == 120 | c == 112) { r[o] = (byte)48; o++; r[o] = (byte)120; o++; };
                        if (c == 88) { r[o] = (byte)48; o++; r[o] = (byte)88; o++; };
                        if (c == 111) { r[o] = (byte)48; o++; };
                    };
                    if (cv != 0) { r[o] = (byte)cv; o++; };
