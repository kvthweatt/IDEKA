        // ---- JSON: parsing, JSONB blobs, rendering ----
        // JSONB element: first byte low nibble = type (0 null, 1 true, 2 false, 3 int, 4 int5, 5 float, 6 float5,
        // 7 text, 8 textj, 9 text5, 10 textraw, 11 array, 12 object), high nibble = payload size or a size-of-size code.

        struct SQ_JB
        {
            byte* p;
            int n, cap, err, errpos, n5, oom, depth;
            SQ_BLK* b;
        };

        global i64 SQ_JSUB = 1246973774;

        def sq_jb_init(SQ_JB* j, SQ_BLK* b, int cap) -> void
        {
            if (cap < 64) { cap = 64; };
            j.b = b;
            j.p = sq_scr(b, cap);
            j.n = 0;
            j.cap = cap;
            j.err = 0; j.errpos = 0; j.n5 = 0; j.oom = 0; j.depth = 0;
            if ((u64)j.p == (u64)0) { j.oom = 1; j.cap = 0; };
        };

        def sq_jb_need(SQ_JB* j, int extra) -> bool
        {
            byte* np;
            int nc;
            if (j.oom == 1) { return false; };
            if (j.n + extra <= j.cap) { return true; };
            nc = j.cap * 2;
            if (nc < j.n + extra + 64) { nc = j.n + extra + 64; };
            np = sq_scr(j.b, nc);
            if ((u64)np == (u64)0) { j.oom = 1; return false; };
            if (j.n > 0) { sq_mcpy(np, j.p, j.n); };
            j.p = np;
            j.cap = nc;
            return true;
        };

        def sq_jb_put(SQ_JB* j, int c) -> void
        {
            if (sq_jb_need(j, 1) == false) { return; };
            j.p[j.n] = (byte)c;
            j.n++;
        };

        def sq_jb_putn(SQ_JB* j, byte* s, int n) -> void
        {
            if (n <= 0) { return; };
            if (sq_jb_need(j, n) == false) { return; };
            sq_mcpy(@j.p[j.n], s, n);
            j.n = j.n + n;
        };

        def sq_jb_puts(SQ_JB* j, byte* s) -> void
        {
            sq_jb_putn(j, s, sq_cstrlen(s));
        };

        // number of extra header bytes for a payload size
        def sq_jb_extra(int sz) -> int
        {
            if (sz <= 11) { return 0; };
            if (sz <= 255) { return 1; };
            if (sz <= 65535) { return 2; };
            return 4;
        };

        // writes the header for type t and payload size sz at dst (dst has room); returns its length
        def sq_jb_wrhdr(byte* dst, int t, int sz) -> int
        {
            int x = sq_jb_extra(sz);
            if (x == 0) { dst[0] = (byte)((sz << 4) | t); return 1; };
            if (x == 1) { dst[0] = (byte)(192 | t); dst[1] = (byte)sz; return 2; };
            if (x == 2) { dst[0] = (byte)(208 | t); dst[1] = (byte)(sz >> 8); dst[2] = (byte)(sz `& 255); return 3; };
            dst[0] = (byte)(224 | t);
            dst[1] = (byte)((sz >> 24) `& 255); dst[2] = (byte)((sz >> 16) `& 255); dst[3] = (byte)((sz >> 8) `& 255); dst[4] = (byte)(sz `& 255);
            return 5;
        };

        // starts an element of type t whose payload follows; returns the offset of its header
        def sq_jb_open(SQ_JB* j, int t) -> int
        {
            int i = j.n;
            sq_jb_put(j, t);
            return i;
        };

        // copies overlapping memory towards higher addresses
        def sq_mcpy_back(byte* d, byte* s, int n) -> void
        {
            int k = n - 1;
            while (k >= 0) { d[k] = s[k]; k--; };
        };

        // fixes the header of the element opened at offset i once its payload is complete
        def sq_jb_close(SQ_JB* j, int i) -> void
        {
            int sz, x, t;
            if (j.oom == 1) { return; };
            sz = j.n - i - 1;
            t = (int)j.p[i] `& 15;
            x = sq_jb_extra(sz);
            if (x > 0)
            {
                if (sq_jb_need(j, x) == false) { return; };
                sq_mcpy_back(@j.p[i + 1 + x], @j.p[i + 1], sz);
                j.n = j.n + x;
            };
            sq_jb_wrhdr(@j.p[i], t, sz);
        };

        // a whole leaf: header then payload bytes
        def sq_jb_leaf(SQ_JB* j, int t, byte* s, int n) -> void
        {
            byte[8] h;
            int hl = sq_jb_wrhdr(@h[0], t, n);
            sq_jb_putn(j, @h[0], hl);
            sq_jb_putn(j, s, n);
        };

        // decodes the header at offset i of a blob of n bytes
        def sq_jb_node(byte* p, int n, int i, int* typ, int* hsz, int* psz) -> bool
        {
            int c, x, sz, k;
            if (i < 0 | i >= n) { return false; };
            c = (int)p[i];
            *typ = c `& 15;
            x = c >> 4;
            if (x <= 11) { *hsz = 1; sz = x; }
            else
            {
                if (x == 12) { if (i + 2 > n) { return false; }; *hsz = 2; sz = (int)p[i + 1]; }
                else
                {
                    if (x == 13) { if (i + 3 > n) { return false; }; *hsz = 3; sz = ((int)p[i + 1] << 8) | (int)p[i + 2]; }
                    else
                    {
                        if (x == 14) { if (i + 5 > n) { return false; }; *hsz = 5; sz = ((int)p[i + 1] << 24) | ((int)p[i + 2] << 16) | ((int)p[i + 3] << 8) | (int)p[i + 4]; if (sz < 0) { return false; }; }
                        else
                        {
                            if (i + 9 > n) { return false; };
                            *hsz = 9;
                            for (k = 1; k <= 4; k++) { if (p[i + k] != (byte)0) { return false; }; };
                            sz = ((int)p[i + 5] << 24) | ((int)p[i + 6] << 16) | ((int)p[i + 7] << 8) | (int)p[i + 8];
                            if (sz < 0) { return false; };
                        };
                    };
                };
            };
            *psz = sz;
            if (i + *hsz + sz > n) { return false; };
            return true;
        };

        // ---- parser ----

        def sq_jp_isalpha(int c) -> bool
        {
            return (c >= 65 & c <= 90) | (c >= 97 & c <= 122);
        };

        def sq_jp_isdig(int c) -> bool
        {
            return c >= 48 & c <= 57;
        };

        // skips white space and comments; returns 1 when a comment is left open
        def sq_jp_ws(SQ_JB* j, byte* z, int n, int* pi) -> int
        {
            int i, c, k;
            i = *pi;
            while (i < n)
            {
                c = (int)z[i];
                if (c == 32 | c == 9 | c == 10 | c == 13) { i++; continue; };
                if (c == 11 | c == 12) { j.n5 = 1; i++; continue; };
                if (c == 47)
                {
                    if (i + 1 < n)
                    {
                        if (z[i + 1] == (byte)42)
                        {
                            k = i + 2;
                            while (k + 1 < n) { if (z[k] == (byte)42 & z[k + 1] == (byte)47) { break; }; k++; };
                            if (k + 1 >= n) { *pi = i; return 1; };
                            j.n5 = 1;
                            i = k + 2;
                            continue;
                        };
                        if (z[i + 1] == (byte)47)
                        {
                            k = i + 2;
                            while (k < n) { if (z[k] == (byte)10 | z[k] == (byte)13) { break; }; k++; };
                            j.n5 = 1;
                            i = k;
                            continue;
                        };
                    };
                    break;
                };
                if (c == 194 & i + 1 < n) { if (z[i + 1] == (byte)160) { j.n5 = 1; i = i + 2; continue; }; };
                if (c == 239 & i + 2 < n) { if (z[i + 1] == (byte)187 & z[i + 2] == (byte)191) { j.n5 = 1; i = i + 3; continue; }; };
                if (c == 225 & i + 2 < n) { if (z[i + 1] == (byte)154 & z[i + 2] == (byte)128) { j.n5 = 1; i = i + 3; continue; }; };
                if (c == 226 & i + 2 < n)
                {
                    if (z[i + 1] == (byte)128)
                    {
                        k = (int)z[i + 2];
                        if ((k >= 128 & k <= 138) | k == 168 | k == 169 | k == 175) { j.n5 = 1; i = i + 3; continue; };
                    };
                    if (z[i + 1] == (byte)129 & z[i + 2] == (byte)159) { j.n5 = 1; i = i + 3; continue; };
                };
                if (c == 227 & i + 2 < n) { if (z[i + 1] == (byte)128 & z[i + 2] == (byte)128) { j.n5 = 1; i = i + 3; continue; }; };
                break;
            };
            *pi = i;
            return 0;
        };

        def sq_jp_fail(SQ_JB* j, int i) -> int
        {
            if (j.err == 0) { j.err = 1; j.errpos = i + 1; };
            return 1;
        };

        // case-insensitive match of a word at z[i]
        def sq_jp_word(byte* z, int n, int i, byte* w) -> bool
        {
            int l = sq_cstrlen(w);
            int k, a, b;
            if (i + l > n) { return false; };
            for (k = 0; k < l; k++)
            {
                a = (int)z[i + k]; b = (int)w[k];
                if (a >= 65 & a <= 90) { a = a + 32; };
                if (a != b) { return false; };
            };
            return true;
        };

        def sq_jp_hex4(byte* z, int n, int i) -> bool
        {
            int k, c;
            if (i + 4 > n) { return false; };
            for (k = 0; k < 4; k++)
            {
                c = (int)z[i + k];
                if (!((c >= 48 & c <= 57) | (c >= 97 & c <= 102) | (c >= 65 & c <= 70))) { return false; };
            };
            return true;
        };

        // string starting at the delimiter at z[*pi]; appends a text element; returns 0 or 1
        def sq_jp_string(SQ_JB* j, byte* z, int n, int* pi, int iskey) -> int
        {
            int i, d, c, t, s0, k, nx, x5, e;
            i = *pi;
            d = (int)z[i];
            s0 = i + 1;
            k = s0;
            t = 7;
            x5 = 0;
            while (true)
            {
                if (k >= n) { return sq_jp_fail(j, *pi); };
                c = (int)z[k];
                if (c == d) { break; };
                if (c == 92)
                {
                    k++;
                    if (k >= n) { return sq_jp_fail(j, *pi); };
                    e = (int)z[k];
                    if (e == 34 | e == 92 | e == 47 | e == 98 | e == 102 | e == 110 | e == 114 | e == 116)
                    {
                        if (t == 7) { t = 8; };
                        k++;
                        continue;
                    };
                    if (e == 117)
                    {
                        if (sq_jp_hex4(z, n, k + 1) == false) { return sq_jp_fail(j, k); };
                        if (t == 7) { t = 8; };
                        k = k + 5;
                        continue;
                    };
                    if (e == 39 | e == 118)
                    {
                        t = 9; x5 = 1; k++;
                        continue;
                    };
                    if (e == 48)
                    {
                        if (k + 1 < n) { if (sq_jp_isdig((int)z[k + 1])) { return sq_jp_fail(j, k); }; };
                        t = 9; x5 = 1; k++;
                        continue;
                    };
                    if (e == 120)
                    {
                        if (k + 3 > n) { return sq_jp_fail(j, k); };
                        c = (int)z[k + 1]; nx = (int)z[k + 2];
                        if (!((c >= 48 & c <= 57) | (c >= 97 & c <= 102) | (c >= 65 & c <= 70))) { return sq_jp_fail(j, k); };
                        if (!((nx >= 48 & nx <= 57) | (nx >= 97 & nx <= 102) | (nx >= 65 & nx <= 70))) { return sq_jp_fail(j, k); };
                        t = 9; x5 = 1; k = k + 3;
                        continue;
                    };
                    if (e == 10) { t = 9; x5 = 1; k++; continue; };
                    if (e == 13)
                    {
                        t = 9; x5 = 1; k++;
                        if (k < n) { if (z[k] == (byte)10) { k++; }; };
                        continue;
                    };
                    if (e == 226 & k + 2 < n)
                    {
                        if (z[k + 1] == (byte)128 & (z[k + 2] == (byte)168 | z[k + 2] == (byte)169)) { t = 9; x5 = 1; k = k + 3; continue; };
                    };
                    return sq_jp_fail(j, k);
                };
                if (c <= 31)
                {
                    if (c == 0) { return sq_jp_fail(j, k); };
                    t = 9; x5 = 1;
                    k++;
                    continue;
                };
                k++;
            };
            if (d == 39) { x5 = 1; };
            if (d == 39 & t == 8)
            {
                for (e = s0; e < k; e++) { if (z[e] == (byte)34) { t = 9; }; };
            };
            if (x5 == 1) { j.n5 = 1; };
            sq_jb_leaf(j, t, @z[s0], k - s0);
            *pi = k + 1;
            return 0;
        };

        def sq_jp_isidstart(int c) -> bool
        {
            return sq_jp_isalpha(c) | c == 95 | c == 36 | c >= 128 | c == 92;
        };

        def sq_jp_isidch(int c) -> bool
        {
            return sq_jp_isalpha(c) | sq_jp_isdig(c) | c == 95 | c == 36 | c >= 128 | c == 92;
        };

        // unquoted object key
        def sq_jp_ident(SQ_JB* j, byte* z, int n, int* pi) -> int
        {
            int i, k, c, t;
            i = *pi;
            k = i;
            t = 7;
            while (k < n)
            {
                c = (int)z[k];
                if (c == 92)
                {
                    if (k + 1 < n)
                    {
                        if (z[k + 1] == (byte)117)
                        {
                            if (sq_jp_hex4(z, n, k + 2) == false) { return sq_jp_fail(j, k); };
                            t = 8; k = k + 6; continue;
                        };
                    };
                    return sq_jp_fail(j, k);
                };
                if (sq_jp_isidch(c)) { k++; continue; };
                break;
            };
            j.n5 = 1;
            sq_jb_leaf(j, t, @z[i], k - i);
            *pi = k;
            return 0;
        };

        def sq_jp_number(SQ_JB* j, byte* z, int n, int* pi) -> int
        {
            int i, s0, k, c, sg, t, hx, nd, fr, ex, lead0;
            byte[4] none;
            i = *pi;
            k = i;
            sg = 0;
            t = 3;
            c = (int)z[k];
            if (c == 45 | c == 43)
            {
                sg = c;
                k++;
                if (k >= n) { return sq_jp_fail(j, i); };
                c = (int)z[k];
                if (sq_jp_word(z, n, k, "infinity\0") | sq_jp_word(z, n, k, "nan\0"))
                {
                    if (sq_jp_word(z, n, k, "nan\0")) { return sq_jp_fail(j, i); };
                    if (k + 8 < n) { if (sq_jp_isidch((int)z[k + 8])) { return sq_jp_fail(j, i); }; };
                    j.n5 = 1;
                    if (sg == 45) { sq_jb_leaf(j, 5, "-9e999\0", 6); } else { sq_jb_leaf(j, 5, "9e999\0", 5); };
                    *pi = k + 8;
                    return 0;
                };
            };
            s0 = k;
            if (c == 48 & k + 1 < n)
            {
                if (z[k + 1] == (byte)120 | z[k + 1] == (byte)88)
                {
                    k = k + 2;
                    hx = k;
                    while (k < n)
                    {
                        c = (int)z[k];
                        if ((c >= 48 & c <= 57) | (c >= 97 & c <= 102) | (c >= 65 & c <= 70)) { k++; } else { break; };
                    };
                    if (k == hx) { return sq_jp_fail(j, i); };
                    j.n5 = 1;
                    if (sg == 45) { sq_jb_leaf(j, 4, @z[i], k - i); } else { sq_jb_leaf(j, 4, @z[s0], k - s0); };
                    *pi = k;
                    return 0;
                };
            };
            nd = 0; fr = 0; ex = 0;
            lead0 = 0;
            if (c == 48) { lead0 = 1; };
            while (k < n)
            {
                if (sq_jp_isdig((int)z[k])) { nd++; k++; } else { break; };
            };
            if (lead0 == 1 & nd > 1) { return sq_jp_fail(j, i); };
            if (k < n)
            {
                if (z[k] == (byte)46)
                {
                    t = 5;
                    k++;
                    while (k < n) { if (sq_jp_isdig((int)z[k])) { fr++; k++; } else { break; }; };
                    if (nd == 0 & fr == 0) { return sq_jp_fail(j, i); };
                    if (nd == 0 | fr == 0) { t = 6; j.n5 = 1; };
                };
            };
            if (nd == 0 & t == 3) { return sq_jp_fail(j, i); };
            if (k < n)
            {
                if (z[k] == (byte)101 | z[k] == (byte)69)
                {
                    k++;
                    if (k < n) { if (z[k] == (byte)43 | z[k] == (byte)45) { k++; }; };
                    c = k;
                    while (k < n) { if (sq_jp_isdig((int)z[k])) { ex++; k++; } else { break; }; };
                    if (ex == 0) { return sq_jp_fail(j, i); };
                    if (t == 3) { t = 5; };
                };
            };
            if (sg == 43) { j.n5 = 1; };
            if (sg == 45) { sq_jb_leaf(j, t, @z[i], k - i); } else { sq_jb_leaf(j, t, @z[s0], k - s0); };
            *pi = k;
            return 0;
        };

        def sq_jp_value(SQ_JB* j, byte* z, int n, int* pi, int depth) -> int
        {
            int i, c, h, rc, st0, first;
            if (depth > 1000) { return sq_jp_fail(j, *pi); };
            if (sq_jp_ws(j, z, n, pi) != 0) { return sq_jp_fail(j, *pi); };
            i = *pi;
            if (i >= n) { return sq_jp_fail(j, i); };
            c = (int)z[i];
            if (c == 123)
            {
                h = sq_jb_open(j, 12);
                i++;
                first = 1;
                while (true)
                {
                    *pi = i;
                    if (sq_jp_ws(j, z, n, pi) != 0) { return sq_jp_fail(j, *pi); };
                    i = *pi;
                    if (i >= n) { return sq_jp_fail(j, i); };
                    if (z[i] == (byte)125)
                    {
                        if (first == 0) { j.n5 = 1; };
                        i++;
                        break;
                    };
                    if (z[i] == (byte)34 | z[i] == (byte)39)
                    {
                        if (sq_jp_string(j, z, n, @i, 1) != 0) { return 1; };
                    }
                    else
                    {
                        if (sq_jp_isidstart((int)z[i]))
                        {
                            if (sq_jp_ident(j, z, n, @i) != 0) { return 1; };
                        }
                        else { return sq_jp_fail(j, i); };
                    };
                    *pi = i;
                    if (sq_jp_ws(j, z, n, pi) != 0) { return sq_jp_fail(j, *pi); };
                    i = *pi;
                    if (i >= n) { return sq_jp_fail(j, i); };
                    if (z[i] != (byte)58) { return sq_jp_fail(j, i); };
                    i++;
                    *pi = i;
                    if (sq_jp_value(j, z, n, pi, depth + 1) != 0) { return 1; };
                    i = *pi;
                    if (sq_jp_ws(j, z, n, pi) != 0) { return sq_jp_fail(j, *pi); };
                    i = *pi;
                    if (i >= n) { return sq_jp_fail(j, i); };
                    first = 0;
                    if (z[i] == (byte)44) { i++; continue; };
                    if (z[i] == (byte)125) { i++; break; };
                    return sq_jp_fail(j, i);
                };
                sq_jb_close(j, h);
                *pi = i;
                return 0;
            };
            if (c == 91)
            {
                h = sq_jb_open(j, 11);
                i++;
                first = 1;
                while (true)
                {
                    *pi = i;
                    if (sq_jp_ws(j, z, n, pi) != 0) { return sq_jp_fail(j, *pi); };
                    i = *pi;
                    if (i >= n) { return sq_jp_fail(j, i); };
                    if (z[i] == (byte)93)
                    {
                        if (first == 0) { j.n5 = 1; };
                        i++;
                        break;
                    };
                    *pi = i;
                    if (sq_jp_value(j, z, n, pi, depth + 1) != 0) { return 1; };
                    i = *pi;
                    if (sq_jp_ws(j, z, n, pi) != 0) { return sq_jp_fail(j, *pi); };
                    i = *pi;
                    if (i >= n) { return sq_jp_fail(j, i); };
                    first = 0;
                    if (z[i] == (byte)44) { i++; continue; };
                    if (z[i] == (byte)93) { i++; break; };
                    return sq_jp_fail(j, i);
                };
                sq_jb_close(j, h);
                *pi = i;
                return 0;
            };
            if (c == 34 | c == 39) { return sq_jp_string(j, z, n, pi, 0); };
            if (c == 45 | c == 43 | c == 46 | sq_jp_isdig(c)) { return sq_jp_number(j, z, n, pi); };
            if (c == 116 & sq_jp_word(z, n, i, "true\0"))
            {
                if (i + 4 < n) { if (sq_jp_isidch((int)z[i + 4])) { return sq_jp_fail(j, i); }; };
                sq_jb_put(j, 1); *pi = i + 4; return 0;
            };
            if (c == 102 & sq_jp_word(z, n, i, "false\0"))
            {
                if (i + 5 < n) { if (sq_jp_isidch((int)z[i + 5])) { return sq_jp_fail(j, i); }; };
                sq_jb_put(j, 2); *pi = i + 5; return 0;
            };
            if (c == 110 & sq_jp_word(z, n, i, "null\0"))
            {
                if (i + 4 < n) { if (sq_jp_isidch((int)z[i + 4])) { return sq_jp_fail(j, i); }; };
                sq_jb_put(j, 0); *pi = i + 4; return 0;
            };
            if (sq_jp_word(z, n, i, "nan\0"))
            {
                if (i + 3 < n) { if (sq_jp_isidch((int)z[i + 3])) { return sq_jp_fail(j, i); }; };
                j.n5 = 1;
                sq_jb_put(j, 0); *pi = i + 3; return 0;
            };
            if (sq_jp_word(z, n, i, "infinity\0"))
            {
                if (i + 8 < n) { if (sq_jp_isidch((int)z[i + 8])) { return sq_jp_fail(j, i); }; };
                j.n5 = 1;
                sq_jb_leaf(j, 5, "9e999\0", 5);
                *pi = i + 8;
                return 0;
            };
            return sq_jp_fail(j, i);
        };

        // parses JSON or JSON5 text into a blob; returns 0 on success
        def sq_json_parse(SQ_JB* j, byte* z, int n) -> int
        {
            int i;
            i = 0;
            if (sq_jp_value(j, z, n, @i, 0) != 0) { return 1; };
            if (sq_jp_ws(j, z, n, @i) != 0) { return sq_jp_fail(j, 0); };
            if (i < n) { return sq_jp_fail(j, 0); };
            return 0;
        };

        // ---- rendering ----

        def sq_jr_hex(SQ_JB* j, int v) -> void
        {
            v = v `& 15;
            if (v < 10) { sq_jb_put(j, 48 + v); } else { sq_jb_put(j, 87 + v); };
        };

        // appends the character c as the body of a JSON string
        def sq_jr_esc(SQ_JB* j, int c) -> void
        {
            if (c == 34) { sq_jb_put(j, 92); sq_jb_put(j, 34); return; };
            if (c == 92) { sq_jb_put(j, 92); sq_jb_put(j, 92); return; };
            if (c == 8) { sq_jb_put(j, 92); sq_jb_put(j, 98); return; };
            if (c == 12) { sq_jb_put(j, 92); sq_jb_put(j, 102); return; };
            if (c == 10) { sq_jb_put(j, 92); sq_jb_put(j, 110); return; };
            if (c == 13) { sq_jb_put(j, 92); sq_jb_put(j, 114); return; };
            if (c == 9) { sq_jb_put(j, 92); sq_jb_put(j, 116); return; };
            if (c < 32)
            {
                sq_jb_put(j, 92); sq_jb_put(j, 117); sq_jb_put(j, 48); sq_jb_put(j, 48);
                sq_jr_hex(j, c >> 4); sq_jr_hex(j, c);
                return;
            };
            sq_jb_put(j, c);
        };

        // raw text as a quoted JSON string
        def sq_jr_quote(SQ_JB* j, byte* s, int n) -> void
        {
            int i;
            sq_jb_put(j, 34);
            for (i = 0; i < n; i++) { sq_jr_esc(j, (int)s[i]); };
            sq_jb_put(j, 34);
        };

        // JSON5 string payload turned into the body of a standard JSON string
        def sq_jr_text5(SQ_JB* j, byte* s, int n) -> void
        {
            int i, c, e;
            sq_jb_put(j, 34);
            i = 0;
            while (i < n)
            {
                c = (int)s[i];
                if (c != 92) { sq_jr_esc(j, c); i++; continue; };
                i++;
                if (i >= n) { break; };
                e = (int)s[i];
                if (e == 39) { sq_jb_put(j, 39); i++; continue; };
                if (e == 118) { sq_jb_putn(j, "\\u000b\0", 6); i++; continue; };
                if (e == 48) { sq_jb_putn(j, "\\u0000\0", 6); i++; continue; };
                if (e == 120)
                {
                    sq_jb_putn(j, "\\u00\0", 4);
                    if (i + 2 < n) { sq_jb_put(j, (int)s[i + 1]); sq_jb_put(j, (int)s[i + 2]); };
                    i = i + 3;
                    continue;
                };
                if (e == 10) { i++; continue; };
                if (e == 13) { i++; if (i < n) { if (s[i] == (byte)10) { i++; }; }; continue; };
                if (e == 226 & i + 2 < n)
                {
                    if (s[i + 1] == (byte)128 & (s[i + 2] == (byte)168 | s[i + 2] == (byte)169)) { i = i + 3; continue; };
                };
                sq_jb_put(j, 92);
                sq_jb_put(j, e);
                i++;
            };
            sq_jb_put(j, 34);
        };

        // unsigned decimal of a hex integer payload
        def sq_jr_int5(SQ_JB* j, byte* s, int n) -> void
        {
            int i, c, neg;
            u64 v;
            byte[24] buf;
            int k;
            i = 0;
            neg = 0;
            if (n > 0) { if (s[0] == (byte)45) { neg = 1; i = 1; }; };
            if (n > i) { if (s[i] == (byte)43) { i++; }; };
            if (i + 1 < n) { i = i + 2; };
            v = (u64)0;
            while (i < n)
            {
                c = (int)s[i];
                if (c >= 97) { c = c - 87; } else { if (c >= 65) { c = c - 55; } else { c = c - 48; }; };
                v = v * (u64)16 + (u64)c;
                i++;
            };
            if (neg == 1) { sq_jb_put(j, 45); };
            k = 24;
            if (v == (u64)0) { k--; buf[k] = (byte)48; };
            while (v != (u64)0)
            {
                k--;
                buf[k] = (byte)(48 + (int)(v % (u64)10));
                v = v / (u64)10;
            };
            sq_jb_putn(j, @buf[k], 24 - k);
        };

        def sq_jr_float5(SQ_JB* j, byte* s, int n) -> void
        {
            int i, c, sawdot, prevdig;
            i = 0;
            if (n > 0) { if (s[0] == (byte)45) { sq_jb_put(j, 45); i = 1; }; };
            if (n > i) { if (s[i] == (byte)43) { i++; }; };
            if (i < n) { if (s[i] == (byte)46) { sq_jb_put(j, 48); }; };
            prevdig = 0;
            while (i < n)
            {
                c = (int)s[i];
                sq_jb_put(j, c);
                if (c == 46)
                {
                    if (i + 1 >= n) { sq_jb_put(j, 48); }
                    else { if (s[i + 1] == (byte)101 | s[i + 1] == (byte)69) { sq_jb_put(j, 48); }; };
                };
                i++;
            };
        };

        // writes the element at offset i; ind is the indent string (len il) or il < 0 for compact output
        // returns the offset after the element or -1 when the blob is malformed
        def sq_jr_node(SQ_JB* j, byte* p, int n, int i, byte* ind, int il, int lvl) -> int
        {
            int t, hs, ps, e, k, cnt, isobj, v, kt, kh, kp, ke;
            if (sq_jb_node(p, n, i, @t, @hs, @ps) == false) { return 0 - 1; };
            e = i + hs + ps;
            if (t == 0) { sq_jb_putn(j, "null\0", 4); return e; };
            if (t == 1) { sq_jb_putn(j, "true\0", 4); return e; };
            if (t == 2) { sq_jb_putn(j, "false\0", 5); return e; };
            if (t == 3 | t == 5) { sq_jb_putn(j, @p[i + hs], ps); return e; };
            if (t == 4) { sq_jr_int5(j, @p[i + hs], ps); return e; };
            if (t == 6) { sq_jr_float5(j, @p[i + hs], ps); return e; };
            if (t == 7 | t == 10) { sq_jr_quote(j, @p[i + hs], ps); return e; };
            if (t == 8) { sq_jb_put(j, 34); sq_jb_putn(j, @p[i + hs], ps); sq_jb_put(j, 34); return e; };
            if (t == 9) { sq_jr_text5(j, @p[i + hs], ps); return e; };
            if (t != 11 & t != 12) { return 0 - 1; };
            isobj = 0;
            if (t == 12) { isobj = 1; };
            k = i + hs;
            if (isobj == 1) { sq_jb_put(j, 123); } else { sq_jb_put(j, 91); };
            cnt = 0;
            while (k < e)
            {
                if (cnt > 0) { sq_jb_put(j, 44); };
                if (il >= 0)
                {
                    sq_jb_put(j, 10);
                    for (v = 0; v <= lvl; v++) { sq_jb_putn(j, ind, il); };
                };
                if (isobj == 1)
                {
                    if (sq_jb_node(p, n, k, @kt, @kh, @kp) == false) { return 0 - 1; };
                    if (kt < 7 | kt > 10) { return 0 - 1; };
                    k = sq_jr_node(j, p, n, k, ind, il, lvl + 1);
                    if (k < 0) { return 0 - 1; };
                    sq_jb_put(j, 58);
                    if (il >= 0) { sq_jb_put(j, 32); };
                    if (k >= e) { return 0 - 1; };
                };
                k = sq_jr_node(j, p, n, k, ind, il, lvl + 1);
                if (k < 0) { return 0 - 1; };
                cnt++;
            };
            if (k != e) { return 0 - 1; };
            if (il >= 0 & cnt > 0)
            {
                sq_jb_put(j, 10);
                for (v = 0; v < lvl; v++) { sq_jb_putn(j, ind, il); };
            };
            if (isobj == 1) { sq_jb_put(j, 125); } else { sq_jb_put(j, 93); };
            return e;
        };

        // validity of a JSONB blob: one element spanning the whole blob, every nested element well formed
        def sq_jb_check(byte* p, int n, int i, int strict) -> int
        {
            int t, hs, ps, e, k, c, cnt, r;
            if (sq_jb_node(p, n, i, @t, @hs, @ps) == false) { return 0 - 1; };
            e = i + hs + ps;
            if (t > 12) { return 0 - 1; };
            if (t == 0 | t == 1 | t == 2) { if (ps != 0) { return 0 - 1; }; };
            if (strict == 1)
            {
                if (t == 3 | t == 5)
                {
                    if (ps == 0) { return 0 - 1; };
                };
                if (t == 4 | t == 6) { if (ps == 0) { return 0 - 1; }; };
            };
            if (t == 11 | t == 12)
            {
                k = i + hs;
                cnt = 0;
                while (k < e)
                {
                    r = sq_jb_check(p, e, k, strict);
                    if (r < 0) { return 0 - 1; };
                    if (t == 12)
                    {
                        if (cnt % 2 == 0)
                        {
                            c = (int)p[k] `& 15;
                            if (c < 7 | c > 10) { return 0 - 1; };
                        };
                    };
                    cnt++;
                    k = r;
                };
                if (t == 12 & cnt % 2 == 1) { return 0 - 1; };
            };
            return e;
        };

        // ---- text of JSON strings ----

        def sq_jk_hexv(int c) -> int
        {
            if (c >= 48 & c <= 57) { return c - 48; };
            if (c >= 97 & c <= 102) { return c - 87; };
            if (c >= 65 & c <= 70) { return c - 55; };
            return 0;
        };

        // decodes the escapes of a TEXTJ or TEXT5 payload into out (at most n bytes); returns the length
        def sq_jk_decode(byte* s, int n, byte* out) -> int
        {
            int i, o, c, e, cp, lo;
            i = 0; o = 0;
            while (i < n)
            {
                c = (int)s[i];
                if (c != 92) { out[o] = s[i]; o++; i++; continue; };
                i++;
                if (i >= n) { break; };
                e = (int)s[i];
                i++;
                if (e == 110) { out[o] = (byte)10; o++; continue; };
                if (e == 116) { out[o] = (byte)9; o++; continue; };
                if (e == 114) { out[o] = (byte)13; o++; continue; };
                if (e == 98) { out[o] = (byte)8; o++; continue; };
                if (e == 102) { out[o] = (byte)12; o++; continue; };
                if (e == 118) { out[o] = (byte)11; o++; continue; };
                if (e == 48) { out[o] = (byte)0; o++; continue; };
                if (e == 120)
                {
                    if (i + 1 < n)
                    {
                        cp = sq_jk_hexv((int)s[i]) * 16 + sq_jk_hexv((int)s[i + 1]);
                        i = i + 2;
                        o = o + sq_utf8_put(@out[o], cp);
                    };
                    continue;
                };
                if (e == 117)
                {
                    if (i + 3 < n)
                    {
                        cp = (sq_jk_hexv((int)s[i]) << 12) | (sq_jk_hexv((int)s[i + 1]) << 8) | (sq_jk_hexv((int)s[i + 2]) << 4) | sq_jk_hexv((int)s[i + 3]);
                        i = i + 4;
                        if (cp >= 55296 & cp <= 56319 & i + 5 < n)
                        {
                            if (s[i] == (byte)92 & s[i + 1] == (byte)117)
                            {
                                lo = (sq_jk_hexv((int)s[i + 2]) << 12) | (sq_jk_hexv((int)s[i + 3]) << 8) | (sq_jk_hexv((int)s[i + 4]) << 4) | sq_jk_hexv((int)s[i + 5]);
                                if (lo >= 56320 & lo <= 57343)
                                {
                                    cp = 65536 + ((cp - 55296) << 10) + (lo - 56320);
                                    i = i + 6;
                                };
                            };
                        };
                        if (cp == 0) { out[o] = (byte)0; o++; }
                        else { o = o + sq_utf8_put(@out[o], cp); };
                    };
                    continue;
                };
                if (e == 10) { continue; };
                if (e == 13) { if (i < n) { if (s[i] == (byte)10) { i++; }; }; continue; };
                if (e == 226 & i + 1 < n)
                {
                    if (s[i] == (byte)128 & (s[i + 1] == (byte)168 | s[i + 1] == (byte)169)) { i = i + 2; continue; };
                };
                out[o] = (byte)e; o++;
            };
            return o;
        };

        // text of the string element at offset i; returns a pointer into the blob or a decoded copy in scratch memory
        def sq_jk_text(SQ_BLK* b, byte* p, int n, int i, int* len) -> byte*
        {
            int t, hs, ps;
            byte* r;
            if (sq_jb_node(p, n, i, @t, @hs, @ps) == false) { *len = 0; return p; };
            if (t == 7 | t == 10) { *len = ps; return @p[i + hs]; };
            r = sq_scr(b, ps + 8);
            if ((u64)r == (u64)0) { *len = 0; return p; };
            *len = sq_jk_decode(@p[i + hs], ps, r);
            return r;
        };

        // key element at offset ko equals the label
        def sq_jk_eq(SQ_BLK* b, byte* p, int n, int ko, byte* lab, int ll) -> bool
        {
            int t, hs, ps, k, l;
            byte* tx;
            if (sq_jb_node(p, n, ko, @t, @hs, @ps) == false) { return false; };
            if (t == 7 | t == 10)
            {
                if (ps != ll) { return false; };
                for (k = 0; k < ll; k++) { if (p[ko + hs + k] != lab[k]) { return false; }; };
                return true;
            };
            tx = sq_jk_text(b, p, n, ko, @l);
            if (l != ll) { return false; };
            for (k = 0; k < ll; k++) { if (tx[k] != lab[k]) { return false; }; };
            return true;
        };

        // ---- SQL values to and from JSON ----

        // the value text of a number-like element as an SQL value
        def sq_jv_tosql(SQ_BLK* b, byte* p, int n, int i, SQ_VAL* out) -> int
        {
            int t, hs, ps, l, k, e, c, neg;
            byte* tx;
            byte* r;
            SQ_VAL v;
            u64 u;
            if (sq_jb_node(p, n, i, @t, @hs, @ps) == false) { sq_val_null(out); return 1; };
            e = i + hs + ps;
            if (t == 0) { sq_val_null(out); return 0; };
            if (t == 1) { sq_val_int(out, (i64)1); return 0; };
            if (t == 2) { sq_val_int(out, (i64)0); return 0; };
            if (t == 3 | t == 5 | t == 6)
            {
                r = sq_scr(b, ps + 4);
                if ((u64)r == (u64)0) { sq_val_null(out); return 1; };
                sq_mcpy(r, @p[i + hs], ps);
                r[ps] = (byte)0;
                if (t == 6)
                {
                    // normalise the JSON5 forms before conversion
                    sq_val_null(@v);
                    c = 0;
                    if (ps > 0) { if (r[0] == (byte)45 | r[0] == (byte)43) { c = 1; }; };
                };
                sq_str2num(r, ps, @v);
                if (v.t == SQ_NULL) { sq_val_real(out, 0.0); return 0; };
                sq_val_copy(out, @v);
                return 0;
            };
            if (t == 4)
            {
                neg = 0; k = 0;
                tx = @p[i + hs];
                if (ps > 0) { if (tx[0] == (byte)45) { neg = 1; k = 1; }; };
                if (k < ps) { if (tx[k] == (byte)43) { k++; }; };
                k = k + 2;
                u = (u64)0;
                while (k < ps)
                {
                    u = u * (u64)16 + (u64)sq_jk_hexv((int)tx[k]);
                    k++;
                };
                if (neg == 1) { sq_val_int(out, (i64)0 - (i64)u); } else { sq_val_int(out, (i64)u); };
                return 0;
            };
            if (t >= 7 & t <= 10)
            {
                tx = sq_jk_text(b, p, n, i, @l);
                r = sq_mk_text(b, l, out);
                if ((u64)r == (u64)0) { return 1; };
                sq_mcpy(r, tx, l);
                out.n = l;
                return 0;
            };
            return 2;
        };

        // appends the SQL value v as a JSON element; mode 0 for json_array/object (strings as TEXT/TEXTJ), 1 for edit values (TEXTRAW)
        // returns 0, or 1 with an error message set
        def sq_jv_append(SQ_STMT* st, SQ_JB* j, SQ_VAL* v, int mode) -> int
        {
            SQ_VAL t;
            SQ_JB q;
            byte* tx;
            int i, c, need, ty, hs, ps;
            double d;
            if (v.t == SQ_NULL) { sq_jb_put(j, 0); return 0; };
            if (v.t == SQ_INTEGER)
            {
                sq_val_text(@j.b.scr, v, @t);
                sq_jb_leaf(j, 3, t.p, t.n);
                return 0;
            };
            if (v.t == SQ_REAL)
            {
                d = v.r;
                if (d != d) { sq_jb_put(j, 0); return 0; };
                if (d > 1.7976931348623157e308) { sq_jb_leaf(j, 5, "9.0e+999\0", 8); return 0; };
                if (d < 0.0 - 1.7976931348623157e308) { sq_jb_leaf(j, 5, "-9.0e+999\0", 9); return 0; };
                if (d == 0.0) { sq_jb_leaf(j, 5, "0.0\0", 3); return 0; };
                sq_val_text(@j.b.scr, v, @t);
                {
                    SQ_VAL[2] fa;
                    fa[0].t = SQ_TEXT; fa[0].p = "%!.15g\0"; fa[0].n = 6; fa[0].i = (i64)0; fa[0].r = 0.0;
                    sq_val_copy(@fa[1], v);
                    sq_printf2(j.b, @fa[0], 2, @t);
                };
                sq_jb_leaf(j, 5, t.p, t.n);
                return 0;
            };
            if (v.t == SQ_BLOB)
            {
                if (sq_jb_check(v.p, v.n, 0, 0) == v.n & v.n > 0)
                {
                    sq_jb_putn(j, v.p, v.n);
                    return 0;
                };
                sq_seterr(st, "JSON cannot hold BLOB values\0");
                return 1;
            };
            if (v.i == SQ_JSUB)
            {
                i = 0;
                c = j.n5;
                if (sq_jp_value(j, v.p, v.n, @i, 0) != 0) { sq_seterr(st, "malformed JSON\0"); return 1; };
                if (sq_jp_ws(j, v.p, v.n, @i) != 0) { sq_seterr(st, "malformed JSON\0"); return 1; };
                if (i < v.n) { sq_seterr(st, "malformed JSON\0"); return 1; };
                j.n5 = c;
                return 0;
            };
            if (mode == 1) { sq_jb_leaf(j, 10, v.p, v.n); return 0; };
            need = 0;
            for (i = 0; i < v.n; i++)
            {
                c = (int)v.p[i];
                if (c < 32 | c == 34 | c == 92) { need = 1; };
            };
            if (need == 0) { sq_jb_leaf(j, 7, v.p, v.n); return 0; };
            // escaped payload as a TEXTJ element
            sq_jb_init(@q, j.b, v.n * 6 + 16);
            for (i = 0; i < v.n; i++) { sq_jr_esc(@q, (int)v.p[i]); };
            sq_jb_leaf(j, 8, q.p, q.n);
            return 0;
        };

        // ---- paths ----

        struct SQ_JPATH
        {
            int n, bad, badc, zl, lko;
            int[40] kind, ks, kl, idx, ss;
        };

        // kind: 0 key (ks,kl locate the label in the path text), 1 index, 2 from the end (#-idx), 3 append (#)
        def sq_jpath_parse(byte* z, int n, SQ_JPATH* pp) -> int
        {
            int i, c, k, v, st0, ok;
            pp.n = 0; pp.bad = 0; pp.badc = 0; pp.zl = n;
            if (n < 1) { pp.bad = 2; return 1; };
            if (z[0] != (byte)36) { pp.bad = 2; return 1; };
            i = 1;
            while (i < n)
            {
                if (pp.n >= 40) { pp.bad = 1; return 1; };
                c = (int)z[i];
                pp.badc = c;
                pp.ss[pp.n] = i;
                if (c == 46)
                {
                    i++;
                    if (i >= n) { pp.bad = 1; return 1; };
                    if (z[i] == (byte)34)
                    {
                        i++;
                        st0 = i;
                        while (i < n) { if (z[i] == (byte)34) { break; }; i++; };
                        if (i >= n) { pp.bad = 1; return 1; };
                        pp.kind[pp.n] = 0; pp.ks[pp.n] = st0; pp.kl[pp.n] = i - st0;
                        pp.n++;
                        i++;
                    }
                    else
                    {
                        st0 = i;
                        while (i < n) { if (z[i] == (byte)46 | z[i] == (byte)91) { break; }; i++; };
                        if (i == st0) { pp.bad = 1; return 1; };
                        pp.kind[pp.n] = 0; pp.ks[pp.n] = st0; pp.kl[pp.n] = i - st0;
                        pp.n++;
                    };
                    continue;
                };
                if (c == 91)
                {
                    i++;
                    if (i >= n) { pp.bad = 1; return 1; };
                    if (z[i] == (byte)35)
                    {
                        i++;
                        if (i >= n) { pp.bad = 1; return 1; };
                        if (z[i] == (byte)93) { pp.kind[pp.n] = 3; pp.idx[pp.n] = 0; pp.n++; i++; continue; };
                        if (z[i] != (byte)45) { pp.bad = 1; return 1; };
                        i++;
                        v = 0; ok = 0;
                        while (i < n)
                        {
                            if (sq_jp_isdig((int)z[i])) { ok = 1; v = v * 10 + ((int)z[i] - 48); if (v > 1000000000) { v = 1000000000; }; i++; } else { break; };
                        };
                        if (ok == 0) { pp.bad = 1; return 1; };
                        if (i >= n) { pp.bad = 1; return 1; };
                        if (z[i] != (byte)93) { pp.bad = 1; return 1; };
                        i++;
                        pp.kind[pp.n] = 2; pp.idx[pp.n] = v; pp.n++;
                        continue;
                    };
                    v = 0; ok = 0;
                    while (i < n)
                    {
                        if (sq_jp_isdig((int)z[i])) { ok = 1; v = v * 10 + ((int)z[i] - 48); if (v > 1000000000) { v = 1000000000; }; i++; } else { break; };
                    };
                    if (ok == 0) { pp.bad = 1; return 1; };
                    if (i >= n) { pp.bad = 1; return 1; };
                    if (z[i] != (byte)93) { pp.bad = 1; return 1; };
                    i++;
                    pp.kind[pp.n] = 1; pp.idx[pp.n] = v; pp.n++;
                    continue;
                };
                pp.bad = 1; return 1;
            };
            return 0;
        };

        // number of elements of the array or object at offset i
        def sq_jb_count(byte* p, int n, int i) -> int
        {
            int t, hs, ps, k, e, c, kt, kh, kp;
            if (sq_jb_node(p, n, i, @t, @hs, @ps) == false) { return 0; };
            e = i + hs + ps;
            k = i + hs;
            c = 0;
            while (k < e)
            {
                if (sq_jb_node(p, n, k, @kt, @kh, @kp) == false) { return c; };
                k = k + kh + kp;
                c++;
            };
            if (t == 12) { return c / 2; };
            return c;
        };

        // offset of the element reached by the path steps from offset i, or -1
        def sq_jpath_find(SQ_BLK* b, byte* p, int n, int i, SQ_JPATH* pp, byte* pz) -> int
        {
            int s, t, hs, ps, e, k, cnt, pos, kt, kh, kp, vo, want;
            pp.lko = 0 - 1;
            for (s = 0; s < pp.n; s++)
            {
                if (sq_jb_node(p, n, i, @t, @hs, @ps) == false) { return 0 - 1; };
                e = i + hs + ps;
                if (pp.kind[s] == 0)
                {
                    if (t != 12) { return 0 - 1; };
                    k = i + hs;
                    vo = 0 - 1;
                    while (k < e)
                    {
                        if (sq_jb_node(p, n, k, @kt, @kh, @kp) == false) { return 0 - 1; };
                        if (sq_jk_eq(b, p, n, k, @pz[pp.ks[s]], pp.kl[s]))
                        {
                            vo = k + kh + kp;
                            pp.lko = k;
                            break;
                        };
                        k = k + kh + kp;
                        if (sq_jb_node(p, n, k, @kt, @kh, @kp) == false) { return 0 - 1; };
                        k = k + kh + kp;
                    };
                    if (vo < 0) { return 0 - 1; };
                    i = vo;
                }
                else
                {
                    if (t != 11) { return 0 - 1; };
                    cnt = sq_jb_count(p, n, i);
                    want = pp.idx[s];
                    if (pp.kind[s] == 2) { want = cnt - pp.idx[s]; };
                    if (pp.kind[s] == 3) { want = cnt; };
                    if (want < 0 | want >= cnt) { return 0 - 1; };
                    k = i + hs;
                    pos = 0;
                    while (k < e)
                    {
                        if (pos == want) { break; };
                        if (sq_jb_node(p, n, k, @kt, @kh, @kp) == false) { return 0 - 1; };
                        k = k + kh + kp;
                        pos++;
                    };
                    if (k >= e) { return 0 - 1; };
                    pp.lko = 0 - 1;
                    i = k;
                };
            };
            if (pp.bad == 1)
            {
                if (sq_jb_node(p, n, i, @t, @hs, @ps) == false) { return 0 - 1; };
                if (pp.badc == 46 & t != 12) { return 0 - 1; };
                if (pp.badc == 91 & t != 11) { return 0 - 1; };
                return 0 - 2;
            };
            return i;
        };

        // ---- editing ----
        // mode: 0 set, 1 insert, 2 replace, 3 remove, 4 array_insert

        def sq_je_create(SQ_JB* o, SQ_JPATH* pp, byte* pz, int s, byte* nv, int nl) -> int
        {
            int oi, r;
            if (s >= pp.n)
            {
                if (pp.bad == 1) { return 2; };
                sq_jb_putn(o, nv, nl);
                return 0;
            };
            if (pp.kind[s] == 0)
            {
                oi = sq_jb_open(o, 12);
                sq_jb_leaf(o, 10, @pz[pp.ks[s]], pp.kl[s]);
                r = sq_je_create(o, pp, pz, s + 1, nv, nl);
                if (r != 0) { return r; };
                sq_jb_close(o, oi);
            }
            else
            {
                if (pp.kind[s] == 2) { return 4; };
                if (pp.kind[s] == 1 & pp.idx[s] != 0) { return 4; };
                oi = sq_jb_open(o, 11);
                r = sq_je_create(o, pp, pz, s + 1, nv, nl);
                if (r != 0) { return r; };
                sq_jb_close(o, oi);
            };
            return 0;
        };

        // rebuilds the element at offset i; returns 0, 1 malformed, 2 bad path, 3 not an array element, 4 no change
        def sq_je_apply(SQ_JB* o, byte* p, int n, int i, SQ_JPATH* pp, byte* pz, int s, int mode, byte* nv, int nl) -> int
        {
            int t, hs, ps, e, k, oi, found, last, cnt, want, pos, kt, kh, kp, vt, vh, vp, vk, ve, ko, r;
            if (sq_jb_node(p, n, i, @t, @hs, @ps) == false) { return 1; };
            e = i + hs + ps;
            if (s >= pp.n)
            {
                if (pp.bad == 1)
                {
                    if (pp.badc == 46 & t != 12) { sq_jb_putn(o, @p[i], e - i); return 0; };
                    if (pp.badc == 91 & t != 11) { sq_jb_putn(o, @p[i], e - i); return 0; };
                    return 2;
                };
                if (mode == 0 | mode == 2) { sq_jb_putn(o, nv, nl); } else { sq_jb_putn(o, @p[i], e - i); };
                return 0;
            };
            last = 0;
            if (s == pp.n - 1 & pp.bad == 0) { last = 1; };
            if (pp.kind[s] == 0)
            {
                if (t != 12) { sq_jb_putn(o, @p[i], e - i); return 0; };
                oi = sq_jb_open(o, 12);
                k = i + hs;
                found = 0;
                while (k < e)
                {
                    ko = k;
                    if (sq_jb_node(p, n, k, @kt, @kh, @kp) == false) { return 1; };
                    vk = ko + kh + kp;
                    if (sq_jb_node(p, n, vk, @vt, @vh, @vp) == false) { return 1; };
                    ve = vk + vh + vp;
                    if (found == 0 & sq_jk_eq(o.b, p, n, ko, @pz[pp.ks[s]], pp.kl[s]))
                    {
                        found = 1;
                        if (last == 1)
                        {
                            if (mode == 4) { return 3; };
                            if (mode == 0 | mode == 2) { sq_jb_putn(o, @p[ko], vk - ko); sq_jb_putn(o, nv, nl); };
                            if (mode == 1) { sq_jb_putn(o, @p[ko], ve - ko); };
                        }
                        else
                        {
                            sq_jb_putn(o, @p[ko], vk - ko);
                            r = sq_je_apply(o, p, n, vk, pp, pz, s + 1, mode, nv, nl);
                            if (r != 0) { return r; };
                        };
                    }
                    else { sq_jb_putn(o, @p[ko], ve - ko); };
                    k = ve;
                };
                if (found == 0 & (mode == 0 | mode == 1))
                {
                    sq_jb_leaf(o, 10, @pz[pp.ks[s]], pp.kl[s]);
                    if (last == 1) { sq_jb_putn(o, nv, nl); }
                    else
                    {
                        r = sq_je_create(o, pp, pz, s + 1, nv, nl);
                        if (r != 0) { return r; };
                    };
                };
                sq_jb_close(o, oi);
                return 0;
            };
            if (t != 11) { sq_jb_putn(o, @p[i], e - i); return 0; };
            cnt = sq_jb_count(p, n, i);
            want = pp.idx[s];
            if (pp.kind[s] == 2) { want = cnt - pp.idx[s]; };
            if (pp.kind[s] == 3) { want = cnt; };
            if (want < 0 | want > cnt) { sq_jb_putn(o, @p[i], e - i); return 0; };
            oi = sq_jb_open(o, 11);
            k = i + hs;
            pos = 0;
            while (k < e)
            {
                if (sq_jb_node(p, n, k, @vt, @vh, @vp) == false) { return 1; };
                ve = k + vh + vp;
                if (pos == want)
                {
                    if (last == 1)
                    {
                        if (mode == 0 | mode == 2) { sq_jb_putn(o, nv, nl); };
                        if (mode == 1) { sq_jb_putn(o, @p[k], ve - k); };
                        if (mode == 4) { sq_jb_putn(o, nv, nl); sq_jb_putn(o, @p[k], ve - k); };
                    }
                    else
                    {
                        r = sq_je_apply(o, p, n, k, pp, pz, s + 1, mode, nv, nl);
                        if (r != 0) { return r; };
                    };
                }
                else { sq_jb_putn(o, @p[k], ve - k); };
                pos++;
                k = ve;
            };
            if (want == cnt)
            {
                if (last == 1 & (mode == 0 | mode == 1 | mode == 4)) { sq_jb_putn(o, nv, nl); };
                if (last == 0 & (mode == 0 | mode == 1))
                {
                    r = sq_je_create(o, pp, pz, s + 1, nv, nl);
                    if (r != 0) { return r; };
                };
            };
            sq_jb_close(o, oi);
            return 0;
        };

        // ---- merge patch (RFC 7396) ----

        def sq_jm_keyeq(SQ_BLK* b, byte* p1, int n1, int k1, byte* p2, int n2, int k2) -> bool
        {
            int l1, l2, k;
            byte* t1;
            byte* t2;
            t1 = sq_jk_text(b, p1, n1, k1, @l1);
            t2 = sq_jk_text(b, p2, n2, k2, @l2);
            if (l1 != l2) { return false; };
            for (k = 0; k < l1; k++) { if (t1[k] != t2[k]) { return false; }; };
            return true;
        };

        def sq_jm_patch(SQ_JB* o, byte* tp, int tn, int ti, byte* pp, int pn, int pi) -> int
        {
            int pt, ph, ps, tt, th, ts, oi, k, pe, te, ko, kt, kh, kp, vk, vt, vh, vp, ve, q, qk, qv, qe, found, pvt, pvh, pvp, m;
            if (sq_jb_node(pp, pn, pi, @pt, @ph, @ps) == false) { return 1; };
            pe = pi + ph + ps;
            if (pt != 12) { sq_jb_putn(o, @pp[pi], pe - pi); return 0; };
            tt = 0 - 1; te = 0;
            if (ti >= 0)
            {
                if (sq_jb_node(tp, tn, ti, @tt, @th, @ts) == false) { return 1; };
                te = ti + th + ts;
            };
            oi = sq_jb_open(o, 12);
            if (tt == 12)
            {
                k = ti + th;
                while (k < te)
                {
                    ko = k;
                    if (sq_jb_node(tp, tn, k, @kt, @kh, @kp) == false) { return 1; };
                    vk = ko + kh + kp;
                    if (sq_jb_node(tp, tn, vk, @vt, @vh, @vp) == false) { return 1; };
                    ve = vk + vh + vp;
                    found = 0;
                    q = pi + ph;
                    while (q < pe)
                    {
                        if (sq_jb_node(pp, pn, q, @kt, @m, @kp) == false) { return 1; };
                        qv = q + m + kp;
                        if (sq_jb_node(pp, pn, qv, @pvt, @pvh, @pvp) == false) { return 1; };
                        qe = qv + pvh + pvp;
                        if (sq_jm_keyeq(o.b, tp, tn, ko, pp, pn, q)) { found = 1; break; };
                        q = qe;
                    };
                    if (found == 0) { sq_jb_putn(o, @tp[ko], ve - ko); }
                    else
                    {
                        if (pvt != 0)
                        {
                            sq_jb_putn(o, @tp[ko], vk - ko);
                            if (sq_jm_patch(o, tp, tn, vk, pp, pn, qv) != 0) { return 1; };
                        };
                    };
                    k = ve;
                };
            };
            q = pi + ph;
            while (q < pe)
            {
                if (sq_jb_node(pp, pn, q, @kt, @m, @kp) == false) { return 1; };
                qv = q + m + kp;
                if (sq_jb_node(pp, pn, qv, @pvt, @pvh, @pvp) == false) { return 1; };
                qe = qv + pvh + pvp;
                found = 0;
                if (tt == 12)
                {
                    k = ti + th;
                    while (k < te)
                    {
                        if (sq_jb_node(tp, tn, k, @kt, @kh, @kp) == false) { return 1; };
                        vk = k + kh + kp;
                        if (sq_jb_node(tp, tn, vk, @vt, @vh, @vp) == false) { return 1; };
                        if (sq_jm_keyeq(o.b, tp, tn, k, pp, pn, q)) { found = 1; break; };
                        k = vk + vh + vp;
                    };
                };
                if (found == 0 & pvt != 0)
                {
                    sq_jb_putn(o, @pp[q], qv - q);
                    if (sq_jm_patch(o, tp, tn, 0 - 1, pp, pn, qv) != 0) { return 1; };
                };
                q = qe;
            };
            sq_jb_close(o, oi);
            return 0;
        };

        // ---- SQL function layer ----

        def sq_jf_blobout(SQ_BLK* b, byte* p, int n, SQ_VAL* out) -> void
        {
            byte* r = sq_scr(b, n + 1);
            if ((u64)r == (u64)0) { sq_val_null(out); return; };
            sq_mcpy(r, p, n);
            out.t = SQ_BLOB; out.p = r; out.n = n; out.i = (i64)0; out.r = 0.0;
        };

        // renders the element at offset i as JSON text with the JSON subtype; ind/il select pretty printing
        def sq_jf_text(SQ_STMT* st, SQ_BLK* b, byte* p, int n, int i, byte* ind, int il, SQ_VAL* out) -> int
        {
            SQ_JB q;
            byte* r;
            sq_jb_init(@q, b, n * 2 + 64);
            if (sq_jr_node(@q, p, n, i, ind, il, 0) < 0) { sq_seterr(st, "malformed JSON\0"); return 1; };
            if (q.oom == 1) { sq_seterr(st, "out of memory\0"); return 1; };
            r = sq_mk_text(b, q.n, out);
            if ((u64)r == (u64)0) { return 1; };
            sq_mcpy(r, q.p, q.n);
            out.i = SQ_JSUB;
            return 0;
        };

        // loads a JSON argument as a JSONB blob (p, n); returns 0 or 1 with an error set
        def sq_jf_load(SQ_STMT* st, SQ_BLK* b, SQ_VAL* a, byte** pp, int* pn) -> int
        {
            SQ_VAL x;
            SQ_JB q;
            if (a.t == SQ_BLOB)
            {
                if (a.n > 0)
                {
                    if (sq_jb_check(a.p, a.n, 0, 0) == a.n) { *pp = a.p; *pn = a.n; return 0; };
                };
                sq_seterr(st, "malformed JSON\0");
                return 1;
            };
            sq_val_text(@b.scr, a, @x);
            sq_jb_init(@q, b, x.n * 2 + 64);
            if (sq_json_parse(@q, x.p, x.n) != 0 | q.oom == 1) { sq_seterr(st, "malformed JSON\0"); return 1; };
            *pp = q.p; *pn = q.n;
            return 0;
        };

        def sq_jf_path(SQ_STMT* st, SQ_BLK* b, SQ_VAL* a, SQ_JPATH* pp, byte** pz) -> int
        {
            SQ_VAL x;
            byte[160] msg;
            int k, l;
            sq_val_text(@b.scr, a, @x);
            if (sq_jpath_parse(x.p, x.n, pp) != 0 & pp.bad == 2)
            {
                sq_mcpy(@msg[0], "bad JSON path: '\0", 16);
                l = x.n;
                if (l > 120) { l = 120; };
                sq_mcpy(@msg[16], x.p, l);
                msg[16 + l] = (byte)39;
                msg[17 + l] = (byte)0;
                sq_seterr(st, @msg[0]);
                return 1;
            };
            *pz = x.p;
            return 0;
        };

        def sq_jf_patherr(SQ_STMT* st, byte* z, int zl) -> void
        {
            byte[160] msg;
            int l = zl;
            if (l > 120) { l = 120; };
            sq_mcpy(@msg[0], "bad JSON path: '\0", 16);
            sq_mcpy(@msg[16], z, l);
            msg[16 + l] = (byte)39;
            msg[17 + l] = (byte)0;
            sq_seterr(st, @msg[0]);
        };

        // the element at offset i as an SQL value (containers become JSON text)
        def sq_jf_elem(SQ_STMT* st, SQ_BLK* b, byte* p, int n, int i, int jb, SQ_VAL* out) -> int
        {
            int r, t, hs, ps;
            if (sq_jb_node(p, n, i, @t, @hs, @ps) == false) { sq_seterr(st, "malformed JSON\0"); return 1; };
            if (t == 11 | t == 12)
            {
                if (jb == 1) { sq_jf_blobout(b, @p[i], hs + ps, out); return 0; };
                return sq_jf_text(st, b, p, n, i, "\0", 0 - 1, out);
            };
            r = sq_jv_tosql(b, p, n, i, out);
            if (r == 1) { sq_seterr(st, "malformed JSON\0"); return 1; };
            return 0;
        };

        def sq_jf_name(int op, int jb, byte* out) -> void
        {
            byte* nm = "json_set\0";
            if (jb == 1) { nm = "jsonb_set\0"; };
            if (op == 12) { nm = "json_insert\0"; if (jb == 1) { nm = "jsonb_insert\0"; }; };
            if (op == 13) { nm = "json_replace\0"; if (jb == 1) { nm = "jsonb_replace\0"; }; };
            if (op == 15) { nm = "json_array_insert\0"; if (jb == 1) { nm = "jsonb_array_insert\0"; }; };
            sq_mcpy(out, nm, sq_cstrlen(nm) + 1);
        };

        def sq_json_call(SQ_STMT* st, SQ_BLK* b, int fid, SQ_VAL* a, int argc, SQ_VAL* out) -> void
        {
            int op, jb, i, k, r, t, hs, ps, pn, fl, found, mode, il, oi, cnt;
            byte* p;
            byte* pz;
            byte* r2;
            SQ_JPATH pth;
            SQ_JB o;
            SQ_JB nv;
            SQ_VAL x, y;
            byte[80] nm;
            byte[96] emsg;
            jb = 0; op = fid;
            if (fid >= 100) { jb = 1; op = fid - 100; };
            sq_val_null(out);
            if (op == 1)
            {
                if (a[0].t == SQ_NULL) { return; };
                if (sq_jf_load(st, b, @a[0], @p, @pn) != 0) { return; };
                if (jb == 1) { sq_jf_blobout(b, p, pn, out); return; };
                sq_jf_text(st, b, p, pn, 0, "\0", 0 - 1, out);
                return;
            };
            if (op == 2)
            {
                if (a[0].t == SQ_NULL) { return; };
                fl = 1;
                if (argc == 2)
                {
                    if (a[1].t == SQ_NULL) { return; };
                    fl = (int)((i64)sq_as_double(@a[1]));
                    if (fl < 1 | fl > 15) { sq_seterr(st, "FLAGS parameter to json_valid() must be between 1 and 15\0"); return; };
                };
                sq_val_int(out, (i64)0);
                if (a[0].t == SQ_BLOB)
                {
                    if (a[0].n > 0)
                    {
                        if ((fl `& 8) != 0) { if (sq_jb_check(a[0].p, a[0].n, 0, 1) == a[0].n) { out.i = (i64)1; }; };
                        if ((fl `& 4) != 0) { if (sq_jb_check(a[0].p, a[0].n, 0, 0) == a[0].n) { out.i = (i64)1; }; };
                    };
                    return;
                };
                if ((fl `& 3) == 0) { return; };
                sq_val_text(@b.scr, @a[0], @x);
                sq_jb_init(@o, b, x.n * 2 + 64);
                if (sq_json_parse(@o, x.p, x.n) != 0) { return; };
                if (o.n5 == 0) { if ((fl `& 3) != 0) { out.i = (i64)1; }; }
                else { if ((fl `& 2) != 0) { out.i = (i64)1; }; };
                return;
            };
            if (op == 3)
            {
                sq_jb_init(@o, b, 64);
                if (sq_jv_append(st, @o, @a[0], 0) != 0) { return; };
                if (jb == 1) { sq_jf_blobout(b, o.p, o.n, out); return; };
                sq_jf_text(st, b, o.p, o.n, 0, "\0", 0 - 1, out);
                return;
            };
            if (op == 4 | op == 5)
            {
                if (a[0].t == SQ_NULL) { return; };
                if (sq_jf_load(st, b, @a[0], @p, @pn) != 0) { return; };
                i = 0;
                if (argc == 2)
                {
                    if (a[1].t == SQ_NULL) { return; };
                    if (sq_jf_path(st, b, @a[1], @pth, @pz) != 0) { return; };
                    i = sq_jpath_find(b, p, pn, 0, @pth, pz);
                    if (i == 0 - 2) { sq_jf_patherr(st, pz, pth.zl); return; };
                    if (i < 0) { return; };
                };
                sq_jb_node(p, pn, i, @t, @hs, @ps);
                if (op == 5)
                {
                    if (t == 11) { sq_val_int(out, (i64)sq_jb_count(p, pn, i)); } else { sq_val_int(out, (i64)0); };
                    return;
                };
                pz = "null\0";
                if (t == 1) { pz = "true\0"; };
                if (t == 2) { pz = "false\0"; };
                if (t == 3 | t == 4) { pz = "integer\0"; };
                if (t == 5 | t == 6) { pz = "real\0"; };
                if (t >= 7 & t <= 10) { pz = "text\0"; };
                if (t == 11) { pz = "array\0"; };
                if (t == 12) { pz = "object\0"; };
                k = sq_cstrlen(pz);
                r2 = sq_mk_text(b, k, out);
                if ((u64)r2 == (u64)0) { return; };
                sq_mcpy(r2, pz, k);
                return;
            };
            if (op == 6 | op == 7)
            {
                if (op == 7)
                {
                    if (argc % 2 == 1) { sq_seterr(st, "json_object() requires an even number of arguments\0"); return; };
                };
                sq_jb_init(@o, b, 64);
                if (op == 6) { oi = sq_jb_open(@o, 11); } else { oi = sq_jb_open(@o, 12); };
                for (i = 0; i < argc; i++)
                {
                    if (op == 7 & i % 2 == 0)
                    {
                        if (a[i].t != SQ_TEXT) { sq_seterr(st, "json_object() labels must be TEXT\0"); return; };
                    };
                    if (sq_jv_append(st, @o, @a[i], 0) != 0) { return; };
                };
                sq_jb_close(@o, oi);
                if (jb == 1) { sq_jf_blobout(b, o.p, o.n, out); return; };
                sq_jf_text(st, b, o.p, o.n, 0, "\0", 0 - 1, out);
                return;
            };
            if (op == 8 | op == 9 | op == 10)
            {
                if (a[0].t == SQ_NULL) { return; };
                if (a[1].t == SQ_NULL) { return; };
                if (sq_jf_load(st, b, @a[0], @p, @pn) != 0) { return; };
                if (op == 8 & argc == 1) { sq_seterr(st, "json_extract() needs at least 2 arguments\0"); return; };
                if (op == 8)
                {
                    if (argc == 2)
                    {
                        if (sq_jf_path(st, b, @a[1], @pth, @pz) != 0) { return; };
                        i = sq_jpath_find(b, p, pn, 0, @pth, pz);
                        if (i == 0 - 2) { sq_jf_patherr(st, pz, pth.zl); return; };
                        if (i < 0) { return; };
                        sq_jf_elem(st, b, p, pn, i, jb, out);
                        return;
                    };
                    sq_jb_init(@o, b, 64);
                    oi = sq_jb_open(@o, 11);
                    for (k = 1; k < argc; k++)
                    {
                        if (a[k].t == SQ_NULL) { return; };
                        if (sq_jf_path(st, b, @a[k], @pth, @pz) != 0) { return; };
                        i = sq_jpath_find(b, p, pn, 0, @pth, pz);
                        if (i == 0 - 2) { sq_jf_patherr(st, pz, pth.zl); return; };
                        if (i < 0) { sq_jb_put(@o, 0); }
                        else
                        {
                            sq_jb_node(p, pn, i, @t, @hs, @ps);
                            sq_jb_putn(@o, @p[i], hs + ps);
                        };
                    };
                    sq_jb_close(@o, oi);
                    if (jb == 1) { sq_jf_blobout(b, o.p, o.n, out); return; };
                    sq_jf_text(st, b, o.p, o.n, 0, "\0", 0 - 1, out);
                    return;
                };
                // -> and ->>
                if (a[1].t == SQ_INTEGER)
                {
                    pth.n = 1; pth.bad = 0;
                    if (a[1].i >= (i64)0) { pth.kind[0] = 1; pth.idx[0] = (int)a[1].i; }
                    else { pth.kind[0] = 2; pth.idx[0] = (int)((i64)0 - a[1].i); };
                    pz = "\0";
                }
                else
                {
                    sq_val_text(@b.scr, @a[1], @y);
                    if (y.n > 0 & y.p[0] == (byte)36)
                    {
                        if (sq_jf_path(st, b, @y, @pth, @pz) != 0) { return; };
                    }
                    else
                    {
                        pth.n = 1; pth.bad = 0; pth.kind[0] = 0; pth.ks[0] = 0; pth.kl[0] = y.n;
                        pz = y.p;
                    };
                };
                i = sq_jpath_find(b, p, pn, 0, @pth, pz);
                if (i == 0 - 2) { sq_jf_patherr(st, pz, pth.zl); return; };
                if (i < 0) { return; };
                if (op == 9)
                {
                    sq_jf_text(st, b, p, pn, i, "\0", 0 - 1, out);
                    return;
                };
                sq_jf_elem(st, b, p, pn, i, 0, out);
                return;
            };
            if (op >= 11 & op <= 15)
            {
                if (a[0].t == SQ_NULL) { return; };
                mode = op - 11;
                if (op == 14) { mode = 3; };
                if (op == 15) { mode = 4; };
                if (op != 14)
                {
                    if (argc % 2 == 0)
                    {
                        sq_jf_name(op, jb, @nm[0]);
                        k = sq_cstrlen(@nm[0]);
                        sq_mcpy(@emsg[0], @nm[0], k);
                        sq_mcpy(@emsg[k], "() needs an odd number of arguments\0", 36);
                        sq_seterr(st, @emsg[0]);
                        return;
                    };
                };
                if (sq_jf_load(st, b, @a[0], @p, @pn) != 0) { return; };
                i = 1;
                while (i < argc)
                {
                    if (a[i].t == SQ_NULL)
                    {
                        if (op == 14) { return; };
                        i = i + 2;
                        continue;
                    };
                    if (sq_jf_path(st, b, @a[i], @pth, @pz) != 0) { return; };
                    sq_jb_init(@o, b, pn * 2 + 64);
                    if (op == 14)
                    {
                        if (pth.n == 0) { return; };
                        r = sq_je_apply(@o, p, pn, 0, @pth, pz, 0, 3, p, 0);
                        if (r == 1) { sq_seterr(st, "malformed JSON\0"); return; };
                        if (r == 2) { sq_jf_patherr(st, pz, pth.zl); return; };
                        if (r == 0) { p = o.p; pn = o.n; };
                        i = i + 1;
                        continue;
                    };
                    sq_jb_init(@nv, b, 64);
                    if (sq_jv_append(st, @nv, @a[i + 1], 1) != 0) { return; };
                    r = sq_je_apply(@o, p, pn, 0, @pth, pz, 0, mode, nv.p, nv.n);
                    if (r == 1) { sq_seterr(st, "malformed JSON\0"); return; };
                    if (r == 2) { sq_jf_patherr(st, pz, pth.zl); return; };
                    if (r == 3)
                    {
                        sq_mcpy(@emsg[0], "not an array element: '\0", 24);
                        k = pth.zl;
                        if (k > 60) { k = 60; };
                        sq_mcpy(@emsg[24], pz, k);
                        emsg[24 + k] = (byte)39;
                        emsg[25 + k] = (byte)0;
                        sq_seterr(st, @emsg[0]);
                        return;
                    };
                    if (r == 0) { p = o.p; pn = o.n; };
                    i = i + 2;
                };
                if (jb == 1) { sq_jf_blobout(b, p, pn, out); return; };
                sq_jf_text(st, b, p, pn, 0, "\0", 0 - 1, out);
                return;
            };
            if (op == 16)
            {
                if (a[0].t == SQ_NULL | a[1].t == SQ_NULL) { return; };
                if (sq_jf_load(st, b, @a[0], @p, @pn) != 0) { return; };
                if (sq_jf_load(st, b, @a[1], @pz, @k) != 0) { return; };
                sq_jb_init(@o, b, pn + k + 64);
                if (sq_jm_patch(@o, p, pn, 0, pz, k, 0) != 0) { sq_seterr(st, "malformed JSON\0"); return; };
                if (jb == 1) { sq_jf_blobout(b, o.p, o.n, out); return; };
                sq_jf_text(st, b, o.p, o.n, 0, "\0", 0 - 1, out);
                return;
            };
            if (op == 17)
            {
                if (a[0].t == SQ_NULL) { return; };
                if (sq_jf_load(st, b, @a[0], @p, @pn) != 0) { return; };
                if (argc == 2)
                {
                    sq_val_text(@b.scr, @a[1], @y);
                    sq_jf_text(st, b, p, pn, 0, y.p, y.n, out);
                }
                else { sq_jf_text(st, b, p, pn, 0, "    \0", 4, out); };
                return;
            };
            if (op == 18)
            {
                if (a[0].t == SQ_NULL) { return; };
                if (a[0].t == SQ_BLOB)
                {
                    if (a[0].n > 0) { if (sq_jb_check(a[0].p, a[0].n, 0, 0) == a[0].n) { sq_val_int(out, (i64)0); return; }; };
                    sq_val_int(out, (i64)1);
                    return;
                };
                sq_val_text(@b.scr, @a[0], @x);
                sq_jb_init(@o, b, x.n * 2 + 64);
                if (sq_json_parse(@o, x.p, x.n) == 0) { sq_val_int(out, (i64)0); return; };
                sq_val_int(out, (i64)o.errpos);
                return;
            };
        };

        // ---- JSON aggregates: the group buffer holds the concatenated elements ----

        def sq_jagg_step(SQ_STMT* st, SQ_BLK* b, SQ_ACC* ac, int id, SQ_VAL* x, SQ_VAL* y) -> int
        {
            SQ_JB q;
            SQ_VAL kv;
            int w;
            byte* nb;
            sq_jb_init(@q, b, 64);
            if (id == 114 | id == 115)
            {
                if (x.t == SQ_NULL) { return 0; };
                sq_val_text(@b.scr, x, @kv);
                kv.i = (i64)0;
                if (sq_jv_append(st, @q, @kv, 0) != 0) { return 1; };
                if (sq_jv_append(st, @q, y, 0) != 0) { return 1; };
            }
            else
            {
                if (sq_jv_append(st, @q, x, 0) != 0) { return 1; };
            };
            if (q.oom == 1) { return 1; };
            if (ac.gcn + q.n + 1 > ac.gccap)
            {
                w = ac.gccap * 2;
                if (w < ac.gcn + q.n + 1) { w = ac.gcn + q.n + 1 + 64; };
                nb = sq_ar_alloc(@b.gar, w);
                if ((u64)nb == (u64)0) { return 1; };
                if (ac.gcn > 0) { sq_mcpy(nb, ac.gc, ac.gcn); };
                ac.gc = nb;
                ac.gccap = w;
            };
            sq_mcpy(@ac.gc[ac.gcn], q.p, q.n);
            ac.gcn = ac.gcn + q.n;
            ac.seen = 1;
            return 0;
        };

        def sq_jagg_final(SQ_STMT* st, SQ_BLK* b, SQ_ACC* ac, int id, SQ_VAL* out) -> void
        {
            SQ_JB o;
            int oi;
            sq_jb_init(@o, b, ac.gcn + 16);
            if (id == 112 | id == 113) { oi = sq_jb_open(@o, 11); } else { oi = sq_jb_open(@o, 12); };
            if (ac.gcn > 0) { sq_jb_putn(@o, ac.gc, ac.gcn); };
            sq_jb_close(@o, oi);
            if (id == 113 | id == 115) { sq_jf_blobout(b, o.p, o.n, out); return; };
            sq_jf_text(st, b, o.p, o.n, 0, "\0", 0 - 1, out);
        };
        // ---- date and time functions ----

        struct SQ_DT
        {
            i64 jd;
            int Y, M, D, h, m, vjd, vymd, vhms, err, raw, subsec;
            double s, rawv;
        };

        def sq_dt_compute_jd(SQ_DT* d) -> void
        {
            int Y, M, D, A, B, X1, X2;
            if (d.vjd == 1) { return; };
            if (d.vymd == 1) { Y = d.Y; M = d.M; D = d.D; } else { Y = 2000; M = 1; D = 1; };
            if (M <= 2) { Y--; M = M + 12; };
            A = Y / 100;
            B = 2 - A + (A / 4);
            X1 = (int)(36525 * (Y + 4716) / 100);
            X2 = (int)(306001 * (M + 1) / 10000);
            d.jd = (i64)(((double)(X1 + X2 + D + B) - 1524.5) * 86400000.0);
            d.vjd = 1;
            if (d.vhms == 1)
            {
                d.jd = d.jd + (i64)(d.h * 3600000 + d.m * 60000) + (i64)(d.s * 1000.0 + 0.5);
            };
        };

        def sq_dt_compute_ymd(SQ_DT* d) -> void
        {
            int Z, A, B, C, D, E, X1, alpha;
            if (d.vymd == 1) { return; };
            if (d.vjd == 0) { d.Y = 2000; d.M = 1; d.D = 1; d.vymd = 1; return; };
            Z = (int)((d.jd + (i64)43200000) / (i64)86400000);
            alpha = (int)(((double)Z - 1867216.25) / 36524.25);
            A = Z + 1 + alpha - (alpha / 4);
            B = A + 1524;
            C = (int)(((double)B - 122.1) / 365.25);
            D = (int)((36525 * (C `& 32767)) / 100);
            E = (int)(((double)(B - D)) / 30.6001);
            X1 = (int)(30.6001 * (double)E);
            d.D = B - D - X1;
            if (E < 14) { d.M = E - 1; } else { d.M = E - 13; };
            if (d.M > 2) { d.Y = C - 4716; } else { d.Y = C - 4715; };
            d.vymd = 1;
        };

        def sq_dt_compute_hms(SQ_DT* d) -> void
        {
            i64 ms;
            int sec;
            if (d.vhms == 1) { return; };
            sq_dt_compute_jd(d);
            ms = (d.jd + (i64)43200000) % (i64)86400000;
            if (ms < (i64)0) { ms = ms + (i64)86400000; };
            d.s = (double)(ms % (i64)60000) / 1000.0;
            sec = (int)(ms / (i64)1000);
            d.h = sec / 3600;
            sec = sec - d.h * 3600;
            d.m = sec / 60;
            d.vhms = 1;
        };

        def sq_dt_clear(SQ_DT* d) -> void
        {
            d.vjd = 0; d.vymd = 0; d.vhms = 0; d.err = 0; d.raw = 0; d.subsec = 0; d.jd = (i64)0; d.rawv = 0.0;
            d.Y = 2000; d.M = 1; d.D = 1; d.h = 0; d.m = 0; d.s = 0.0;
        };

        def sq_dt_num(byte* p, int n, int pos, int digits, int* val) -> bool
        {
            int i, v;
            v = 0;
            if (pos + digits > n) { return false; };
            for (i = 0; i < digits; i++)
            {
                if (sq_isdigit(p[pos + i]) == false) { return false; };
                v = v * 10 + ((int)p[pos + i] - 48);
            };
            *val = v;
            return true;
        };

        // HH:MM[:SS[.fff]] followed by an optional zone; returns false when malformed
        def sq_dt_parse_time(SQ_DT* d, byte* p, int n, int pos) -> bool
        {
            int h, m, s, sg, tzh, tzm, k;
            double frac, sc;
            i64 adj;
            if (sq_dt_num(p, n, pos, 2, @h) == false) { return false; };
            if (pos + 2 >= n) { return false; };
            if (p[pos + 2] != (byte)58) { return false; };
            if (sq_dt_num(p, n, pos + 3, 2, @m) == false) { return false; };
            pos = pos + 5;
            s = 0;
            frac = 0.0;
            if (pos < n)
            {
                if (p[pos] == (byte)58)
                {
                    if (sq_dt_num(p, n, pos + 1, 2, @s) == false) { return false; };
                    pos = pos + 3;
                    if (pos < n)
                    {
                        if (p[pos] == (byte)46)
                        {
                            pos++;
                            sc = 0.1;
                            while (pos < n & sq_isdigit(p[pos]))
                            {
                                frac = frac + sc * (double)((int)p[pos] - 48);
                                sc = sc / 10.0;
                                pos++;
                            };
                        };
                    };
                };
            };
            while (pos < n & p[pos] == (byte)32) { pos++; };
            adj = (i64)0;
            if (pos < n)
            {
                if (p[pos] == (byte)90 | p[pos] == (byte)122) { pos++; }
                else
                {
                    if (p[pos] == (byte)43 | p[pos] == (byte)45)
                    {
                        sg = 1;
                        if (p[pos] == (byte)45) { sg = 0 - 1; };
                        if (sq_dt_num(p, n, pos + 1, 2, @tzh) == false) { return false; };
                        if (pos + 3 >= n) { return false; };
                        if (p[pos + 3] != (byte)58) { return false; };
                        if (sq_dt_num(p, n, pos + 4, 2, @tzm) == false) { return false; };
                        adj = (i64)(sg * (tzh * 60 + tzm)) * (i64)60000;
                        pos = pos + 6;
                    };
                };
            };
            if (pos != n) { return false; };
            if (h > 24 | m > 59 | s > 59) { return false; };
            d.h = h; d.m = m; d.s = (double)s + frac; d.vhms = 1;
            d.vjd = 0;
            if (adj != (i64)0)
            {
                sq_dt_compute_jd(d);
                d.jd = d.jd - adj;
                d.vymd = 0; d.vhms = 0;
            };
            return true;
        };

        def sq_dt_now(SQ_DT* d) -> void
        {
            standard::datetime::DateTime t = standard::datetime::dt_now_utc();
            sq_dt_clear(d);
            d.Y = t.year; d.M = t.month; d.D = t.day; d.h = t.hour; d.m = t.minute;
            d.s = (double)t.second + (double)t.ms / 1000.0;
            d.vymd = 1; d.vhms = 1;
            sq_dt_compute_jd(d);
        };

        // parses the time value argument; returns false on error
        def sq_dt_parse_val(SQ_DT* d, SQ_VAL* v) -> bool
        {
            SQ_VAL t;
            byte* p;
            int n, Y, M, D, pos, neg;
            double r;
            sq_dt_clear(d);
            if (v.t == SQ_NULL) { return false; };
            if (v.t == SQ_INTEGER | v.t == SQ_REAL)
            {
                r = sq_as_double(v);
                d.raw = 1; d.rawv = r;
                d.jd = (i64)(r * 86400000.0 + 0.5);
                d.vjd = 1;
                return true;
            };
            p = v.p;
            n = v.n;
            if (sq_ieq(p, n, "now\0")) { sq_dt_now(d); return true; };
            neg = 0;
            pos = 0;
            if (n > 0) { if (p[0] == (byte)45) { neg = 1; pos = 1; }; };
            if (sq_dt_num(p, n, pos, 4, @Y) & pos + 10 <= n)
            {
                if (p[pos + 4] == (byte)45 & p[pos + 7] == (byte)45)
                {
                    if (sq_dt_num(p, n, pos + 5, 2, @M) & sq_dt_num(p, n, pos + 8, 2, @D))
                    {
                        if (M < 1 | M > 12 | D < 1 | D > 31) { return false; };
                        d.Y = Y; d.M = M; d.D = D; d.vymd = 1;
                        if (neg == 1) { d.Y = 0 - Y; };
                        pos = pos + 10;
                        while (pos < n & (p[pos] == (byte)32 | p[pos] == (byte)84)) { pos++; };
                        if (pos >= n) { return true; };
                        return sq_dt_parse_time(d, p, n, pos);
                    };
                };
            };
            if (sq_dt_num(p, n, 0, 2, @Y))
            {
                if (n > 2) { if (p[2] == (byte)58) { return sq_dt_parse_time(d, p, n, 0); }; };
            };
            if (sq_numtext(p, n, @t))
            {
                r = sq_as_double(@t);
                d.raw = 1; d.rawv = r;
                d.jd = (i64)(r * 86400000.0 + 0.5);
                d.vjd = 1;
                return true;
            };
            return false;
        };

        def sq_dt_valid(SQ_DT* d) -> bool
        {
            if (d.vjd == 1)
            {
                if (d.jd < (i64)0 | d.jd > (i64)464269060799999) { return false; };
            };
            return true;
        };

        def sq_dt_modifier(SQ_BLK* blk, SQ_DT* d, SQ_VAL* m) -> bool
        {
            SQ_VAL t;
            byte[40] w;
            byte* p;
            int n, i, k, unit, neg, wd, cur, ndays;
            double r, sc;
            i64 ms;
            if (m.t == SQ_NULL) { return false; };
            sq_val_text(@blk.scr, m, @t);
            p = t.p;
            n = t.n;
            while (n > 0 & p[n - 1] == (byte)32) { n--; };
            while (n > 0 & p[0] == (byte)32) { p = @p[1]; n--; };
            if (sq_ieq(p, n, "localtime\0") | sq_ieq(p, n, "utc\0")) { return true; };
            if (sq_ieq(p, n, "subsec\0") | sq_ieq(p, n, "subsecond\0")) { d.subsec = 1; return true; };
            if (sq_ieq(p, n, "ceiling\0") | sq_ieq(p, n, "floor\0")) { return true; };
            if (sq_ieq(p, n, "julianday\0")) { return true; };
            if (sq_ieq(p, n, "unixepoch\0") | sq_ieq(p, n, "auto\0"))
            {
                if (d.raw != 1) { return false; };
                if (sq_ieq(p, n, "auto\0"))
                {
                    if (d.rawv >= 0.0 & d.rawv < 5373484.5) { return true; };
                    if (d.rawv < 0.0 - 210866760000.0 | d.rawv > 253402300799.0) { return false; };
                };
                d.jd = (i64)(d.rawv * 1000.0 + 0.5) + (i64)210866760000000;
                d.vjd = 1; d.vymd = 0; d.vhms = 0; d.raw = 0;
                return true;
            };
            if (n > 9)
            {
                // "start of month|year|day"
                byte[32] hd;
                for (i = 0; i < 9; i++) { hd[i] = sq_lc(p[i]); };
                hd[9] = (byte)0;
                if (sq_ieq(@hd[0], 9, "start of \0") | (hd[0] == (byte)115 & hd[1] == (byte)116 & hd[2] == (byte)97 & hd[3] == (byte)114 & hd[4] == (byte)116 & hd[5] == (byte)32 & hd[6] == (byte)111 & hd[7] == (byte)102 & hd[8] == (byte)32))
                {
                    sq_dt_compute_ymd(d);
                    sq_dt_compute_hms(d);
                    d.h = 0; d.m = 0; d.s = 0.0; d.vjd = 0; d.vhms = 1;
                    if (sq_ieq(@p[9], n - 9, "month\0")) { d.D = 1; }
                    else
                    {
                        if (sq_ieq(@p[9], n - 9, "year\0")) { d.M = 1; d.D = 1; }
                        else { if (sq_ieq(@p[9], n - 9, "day\0") == false) { return false; }; };
                    };
                    sq_dt_compute_jd(d);
                    d.vymd = 0; d.vhms = 0;
                    return true;
                };
            };
            if (n > 8)
            {
                if (n > 8)
                {
                    k = 0;
                    for (i = 0; i < 8; i++) { w[i] = sq_lc(p[i]); };
                    if (w[0] == (byte)119 & w[1] == (byte)101 & w[2] == (byte)101 & w[3] == (byte)107 & w[4] == (byte)100 & w[5] == (byte)97 & w[6] == (byte)121 & w[7] == (byte)32)
                    {
                        sq_str2num(@p[8], n - 8, @t);
                        wd = (int)sq_as_double(@t);
                        if (wd < 0 | wd > 6) { return false; };
                        sq_dt_compute_jd(d);
                        d.vymd = 0; d.vhms = 0;
                        // weekday of the current day: (jd + 1.5 days) mod 7
                        cur = (int)(((d.jd + (i64)129600000) / (i64)86400000) % (i64)7);
                        ndays = (wd - cur + 7) % 7;
                        d.jd = d.jd + (i64)ndays * (i64)86400000;
                        return true;
                    };
                };
            };
            // [+-]NNN.NNN unit
            i = 0;
            neg = 0;
            if (i < n) { if (p[i] == (byte)43) { i++; } else { if (p[i] == (byte)45) { neg = 1; i++; }; }; };
            if (i >= n) { return false; };
            if (sq_isdigit(p[i]) == false) { return false; };
            r = 0.0;
            while (i < n & sq_isdigit(p[i])) { r = r * 10.0 + (double)((int)p[i] - 48); i++; };
            if (i < n)
            {
                if (p[i] == (byte)46)
                {
                    i++;
                    sc = 0.1;
                    while (i < n & sq_isdigit(p[i])) { r = r + sc * (double)((int)p[i] - 48); sc = sc / 10.0; i++; };
                };
            };
            if (neg == 1) { r = 0.0 - r; };
            while (i < n & p[i] == (byte)32) { i++; };
            n = n - i;
            p = @p[i];
            if (n > 1) { if (p[n - 1] == (byte)115 | p[n - 1] == (byte)83) { n--; }; };
            unit = 0;
            if (sq_ieq(p, n, "second\0")) { unit = 1; };
            if (sq_ieq(p, n, "minute\0")) { unit = 2; };
            if (sq_ieq(p, n, "hour\0")) { unit = 3; };
            if (sq_ieq(p, n, "day\0")) { unit = 4; };
            if (sq_ieq(p, n, "month\0")) { unit = 5; };
            if (sq_ieq(p, n, "year\0")) { unit = 6; };
            if (unit == 0) { return false; };
            if (unit <= 4)
            {
                sq_dt_compute_jd(d);
                ms = (i64)1000;
                if (unit == 2) { ms = (i64)60000; };
                if (unit == 3) { ms = (i64)3600000; };
                if (unit == 4) { ms = (i64)86400000; };
                if (r < 0.0) { d.jd = d.jd + (i64)(r * (double)ms - 0.5); } else { d.jd = d.jd + (i64)(r * (double)ms + 0.5); };
                d.vymd = 0; d.vhms = 0;
                return true;
            };
            sq_dt_compute_ymd(d);
            sq_dt_compute_hms(d);
            if (unit == 5)
            {
                k = (int)r;
                d.M = d.M + k;
                if (d.M > 0) { cur = (d.M - 1) / 12; } else { cur = (d.M - 12) / 12; };
                d.Y = d.Y + cur;
                d.M = d.M - cur * 12;
                r = r - (double)k;
