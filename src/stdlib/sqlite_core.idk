                            c = 0;
                            if (i < fn) { c = (int)fp[i]; };
                            if (c == 108) { i++; c = 0; if (i < fn) { c = (int)fp[i]; }; flaglong = 2; };
                            done = 1;
                        }
                        else
                        {
                            if (c >= 49 & c <= 57)
                            {
                                wx = c - 48;
                                i++;
                                c = 0;
                                if (i < fn) { c = (int)fp[i]; };
