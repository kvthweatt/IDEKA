                            {
                                num[0] = t.p[0];
                                sl = 1;
                                if (((int)t.p[0] `& 192) == 192)
                                {
                                    while (sl < 4 & sl < t.n)
                                    {
                                        if (((int)t.p[sl] `& 192) == 128) { num[sl] = t.p[sl]; sl++; } else { break; };
                                    };
                                };
                            }
                            else { num[0] = (byte)0; sl = 1; };
                        }
                        else { num[0] = (byte)0; sl = 1; };
