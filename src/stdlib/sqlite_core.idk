                        while (k < ln) { r[o] = num[k]; o++; k++; };
                        appended = 1;
                        continue;
                    };
                    if (pad > 0 & flagleft == 0) { while (pad > 0) { r[o] = (byte)32; o++; pad--; }; };
                    for (k = 0; k < ln; k++) { r[o] = num[k]; o++; };
                    if (pad > 0 & flagleft == 1) { while (pad > 0) { r[o] = (byte)32; o++; pad--; }; };
                    appended = 1;
                    continue;
                };
                if (c == 37)
                {
                    pad = width - 1;
                    if (pad > 0 & flagleft == 0) { while (pad > 0) { r[o] = (byte)32; o++; pad--; }; };
                    r[o] = (byte)37; o++;
