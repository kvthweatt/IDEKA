// Author: Karac V. Thweatt

// sqlite_core.idk - SQL engine over sqlite.idk: lexer, parser, binder, expression evaluator and the SELECT executor.
//
//   sq_prep_query(SQ_STMT*, SQLITE_DB*, byte* sql) -> int     0 on success, otherwise st.err holds the message
//   sq_step_query(SQ_STMT*) -> int                            1 row available, 0 done, -1 error
//   sq_column_count / sq_column_name / sq_column_type / sq_column_int / sq_column_real / sq_column_bytes
//   sq_column_ptr / sq_column_text, sq_bind_int / sq_bind_real / sq_bind_text / sq_bind_blob / sq_bind_null
//
// The public entry points sq_prepare, sq_step, sq_exec and sq_finalize live in sqlite_sql.idk.

#ifndef IDEKA_STANDARD_SQLITE
#import <sqlite.idk>;
#endif;

#ifndef IDEKA_STANDARD_MATH
#import <math.idk>;
#endif;

#ifndef IDEKA_DATETIME
#import <datetime.idk>;
#endif;

#ifndef IDEKA_STANDARD_ENCODING
#import <encodings.idk>;
#endif;

#ifndef IDEKA_STANDARD_SQLITE_CORE
#def IDEKA_STANDARD_SQLITE_CORE 1;

namespace standard
{
    namespace sqlite
    {
        // node kinds
        global int SQN_INT = 1, SQN_REAL = 2, SQN_STR = 3, SQN_NULL = 4, SQN_COL = 5, SQN_UNARY = 6,
                   SQN_BIN = 7, SQN_FUNC = 8, SQN_ISNULL = 9, SQN_IN = 10, SQN_BETWEEN = 11,
                   SQN_LIKE = 12, SQN_ROWID = 13, SQN_STAR = 14, SQN_BLOB = 15, SQN_CASE = 16,
                   SQN_CAST = 17, SQN_COLLATE = 18, SQN_SUBQ = 19, SQN_EXISTS = 20, SQN_PARAM = 21,
                   SQN_WHEN = 22, SQN_RESREF = 23, SQN_ROW = 24;

        // binary operator codes
        global int SQO_ADD = 1, SQO_SUB = 2, SQO_MUL = 3, SQO_DIV = 4, SQO_MOD = 5, SQO_EQ = 6, SQO_NE = 7,
                   SQO_LT = 8, SQO_LE = 9, SQO_GT = 10, SQO_GE = 11, SQO_AND = 12, SQO_OR = 13, SQO_CAT = 14,
                   SQO_BAND = 15, SQO_BOR = 16, SQO_SHL = 17, SQO_SHR = 18, SQO_IS = 19, SQO_ISNOT = 20;

        // collations
        // set while UPDATE and DELETE collect their rows: SQLite visits those in rowid order, so no index range scan may reorder them
        global int SQ_NORANGE = 0;
        global int SQC_BINARY = 0, SQC_NOCASE = 1, SQC_RTRIM = 2;
        global int SQ_TRIG_DEPTH = 0, SQ_RAISE = 0, SQ_RPAD = 0;

        struct SQ_VAL
        {
            int t, n;
            i64 i;
            double r;
            byte* p;
        };

        // ---- arena: stable chunked allocation ----

        struct SQ_ARENA
        {
            byte*[1024] ch;
            int[1024] cap;
            int n, used;
        };

        // ---- small helpers ----

        def sq_lc(byte c) -> byte
        {
            if (c >= (byte)65 & c <= (byte)90) { return c + (byte)32; };
            return c;
        };

        def sq_isalpha(byte c) -> bool
        {
            if (c >= (byte)97 & c <= (byte)122) { return true; };
            if (c >= (byte)65 & c <= (byte)90) { return true; };
            if (c == (byte)95 | c >= (byte)128) { return true; };
            return false;
        };

        def sq_isdigit(byte c) -> bool
        {
            return c >= (byte)48 & c <= (byte)57;
        };

        // case-insensitive compare of p[0..n) with a zero terminated lowercase literal
        def sq_ieq(byte* p, int n, byte* lit) -> bool
        {
            int i = 0;
            while (i < n)
            {
                if (lit[i] == (byte)0) { return false; };
                if (sq_lc(p[i]) != lit[i]) { return false; };
                i++;
            };
            return lit[i] == (byte)0;
        };


        def sq_itoa(i64 v, byte* buf) -> int
        {
            byte[24] tmp;
            int n = 0;
            int k = 0;
            u64 u;
            if (v < (i64)0)
            {
                buf[k] = (byte)45;
                k++;
                u = (u64)0 - (u64)v;
            }
            else { u = (u64)v; };
            if (u == (u64)0) { tmp[0] = (byte)48; n = 1; };
            while (u != (u64)0)
            {
                tmp[n] = (byte)(48 + (int)(u % (u64)10));
                u = u / (u64)10;
                n++;
            };
            while (n > 0) { n--; buf[k] = tmp[n]; k++; };
            buf[k] = (byte)0;
            return k;
        };

        def sq_ishex(byte c) -> bool
        {
            if (c >= (byte)48 & c <= (byte)57) { return true; };
            if (c >= (byte)97 & c <= (byte)102) { return true; };
            if (c >= (byte)65 & c <= (byte)70) { return true; };
            return false;
        };

        def sq_hexval(byte* p, int n) -> u64
        {
            u64 v = (u64)0;
            int i, d;
            byte c;
            for (i = 0; i < n; i++)
            {
                c = p[i];
                d = 0;
                if (c >= (byte)48 & c <= (byte)57) { d = (int)c - 48; }
                else { if (c >= (byte)97 & c <= (byte)102) { d = (int)c - 87; } else { d = (int)c - 55; }; };
                v = v * (u64)16 + (u64)d;
            };
            return v;
        };
        // ---- values ----

        def sq_val_null(SQ_VAL* v) -> void
        {
            v.t = SQ_NULL; v.n = 0; v.i = (i64)0; v.r = 0.0; v.p = (byte*)0;
        };

        def sq_val_int(SQ_VAL* v, i64 x) -> void
        {
            v.t = SQ_INTEGER; v.n = 0; v.i = x; v.r = 0.0; v.p = (byte*)0;
        };

        def sq_val_real(SQ_VAL* v, double x) -> void
        {
            v.t = SQ_REAL; v.n = 0; v.i = (i64)0; v.r = x; v.p = (byte*)0;
        };

        def sq_val_copy(SQ_VAL* d, SQ_VAL* s) -> void
        {
            d.t = s.t; d.n = s.n; d.i = s.i; d.r = s.r; d.p = s.p;
        };

        def sq_ar_init(SQ_ARENA* a) -> void
        {
            a.n = 0;
            a.used = 0;
        };

        def sq_ar_free(SQ_ARENA* a) -> void
        {
            int i;
            for (i = 0; i < a.n; i++)
            {
                ffree((u64)a.ch[i]);
                a.ch[i] = (byte*)0;
            };
            a.n = 0;
            a.used = 0;
        };

        // keeps the first chunk
        def sq_ar_reset(SQ_ARENA* a) -> void
        {
            int i;
            for (i = 1; i < a.n; i++)
            {
                ffree((u64)a.ch[i]);
                a.ch[i] = (byte*)0;
            };
            if (a.n > 1) { a.n = 1; };
            a.used = 0;
        };

        def sq_ar_alloc(SQ_ARENA* a, int n) -> byte*
        {
            byte* r;
            int cap, k;
            if (n % 8 != 0) { n = n + 8 - (n % 8); };
            if (n == 0) { n = 8; };
            if (a.n > 0)
            {
                if (a.used + n <= a.cap[a.n - 1])
                {
                    r = @a.ch[a.n - 1][a.used];
                    a.used = a.used + n;
                    return r;
                };
            };
            if (a.n >= 1024) { return (byte*)0; };
            k = a.n;
            if (k > 6) { k = 6; };
            cap = 65536;
            while (k > 0) { cap = cap * 2; k--; };
            if (n > cap) { cap = n; };
            a.ch[a.n] = (byte*)fmalloc((u64)cap);
            if ((u64)a.ch[a.n] == (u64)0) { return (byte*)0; };
            a.cap[a.n] = cap;
            a.n++;
            a.used = n;
            return a.ch[a.n - 1];
        };

        // copies p[0..n) into the arena, appending a zero byte that is not counted
        def sq_ar_copy(SQ_ARENA* a, byte* p, int n) -> byte*
        {
            byte* r = sq_ar_alloc(a, n + 1);
            int i;
            if ((u64)r == (u64)0) { return r; };
            for (i = 0; i < n; i++) { r[i] = p[i]; };
            r[n] = (byte)0;
            return r;
        };

        // copies a value so that it no longer depends on its source memory
        def sq_val_own(SQ_ARENA* a, SQ_VAL* v) -> void
        {
            byte* c;
            if (v.t != SQ_TEXT & v.t != SQ_BLOB) { return; };
            c = sq_ar_copy(a, v.p, v.n);
            if ((u64)c == (u64)0) { sq_val_null(v); return; };
            v.p = c;
        };

        // ---- floating point conversion (the algorithms SQLite uses for REAL <-> TEXT) ----

        // high 64 bits of a*b, low 64 bits in *lo
        def sq_mul128(u64 a, u64 b, u64* lo) -> u64
        {
            u64 a0, a1, b0, b1, a0b0, a1b1, a0b1, a1b0, t, m32;
            m32 = (u64)4294967295;
            a0 = a `& m32;
            a1 = a >> (u64)32;
            b0 = b `& m32;
            b1 = b >> (u64)32;
            a0b0 = a0 * b0;
            a1b1 = a1 * b1;
            a0b1 = a0 * b1;
            a1b0 = a1 * b0;
            t = (a0b0 >> (u64)32) + (a0b1 `& m32) + (a1b0 `& m32);
            *lo = (a0b0 `& m32) | (t << (u64)32);
            return a1b1 + (a0b1 >> (u64)32) + (a1b0 >> (u64)32) + (t >> (u64)32);
        };

        // upper 96 bits of the 160 bitm product of (a<<32)+aLo and b: top 64 bits returned, next 32 in *plo
        def sq_mul160(u64 a, u64 aLo, u64 b, u64* plo) -> u64
        {
            u64 m32, x2, x1, x0, y1, y0, x2y1, r4, x2y0, x1y1, r3, x1y0, x0y1, r2, x0y0, r1;
            m32 = (u64)4294967295;
            x2 = a >> (u64)32;
            x1 = a `& m32;
            x0 = aLo;
            y1 = b >> (u64)32;
            y0 = b `& m32;
            x2y1 = x2 * y1;
            r4 = x2y1 >> (u64)32;
            x2y0 = x2 * y0;
            x1y1 = x1 * y1;
            r3 = (x2y1 `& m32) + (x2y0 >> (u64)32) + (x1y1 >> (u64)32);
            x1y0 = x1 * y0;
            x0y1 = x0 * y1;
            r2 = (x2y0 `& m32) + (x1y1 `& m32) + (x1y0 >> (u64)32) + (x0y1 >> (u64)32);
            x0y0 = x0 * y0;
            r1 = (x1y0 `& m32) + (x0y1 `& m32) + (x0y0 >> (u64)32);
            r2 = r2 + (r1 >> (u64)32);
            r3 = r3 + (r2 >> (u64)32);
            *plo = r2 `& m32;
            return (r4 << (u64)32) + r3;
        };

        def sq_clz64(u64 m) -> int
        {
            int n = 0;
            while (n < 64)
            {
                if ((m >> (u64)(63 - n)) `& (u64)1 != (u64)0) { return n; };
                n++;
            };
            return 64;
        };

        // floor(p * 108853 / 32768) and floor(p * 78913 / 262144)
        def sq_pwr10to2(int p) -> int
        {
            int v = p * 108853;
            int q = v / 32768;
            if (v % 32768 < 0) { q = q - 1; };
            return q;
        };

        def sq_pwr2to10(int p) -> int
        {
            int v = p * 78913;
            int q = v / 262144;
            if (v % 262144 < 0) { q = q - 1; };
            return q;
        };

        // most significant 64 bits of 10**p (p from -348 to 347), the next 32 bits in *plo
        def sq_pow10_64(int p, u64* plo) -> u64
        {
            const u64[27] aBase = [
                0x8000000000000000u, 0xA000000000000000u, 0xC800000000000000u, 0xFA00000000000000u,
                0x9C40000000000000u, 0xC350000000000000u, 0xF424000000000000u, 0x9896800000000000u,
                0xBEBC200000000000u, 0xEE6B280000000000u, 0x9502F90000000000u, 0xBA43B74000000000u,
                0xE8D4A51000000000u, 0x9184E72A00000000u, 0xB5E620F480000000u, 0xE35FA931A0000000u,
                0x8E1BC9BF04000000u, 0xB1A2BC2EC5000000u, 0xDE0B6B3A76400000u, 0x8AC7230489E80000u,
                0xAD78EBC5AC620000u, 0xD8D726B7177A8000u, 0x878678326EAC9000u, 0xA968163F0A57B400u,
                0xD3C21BCECCEDA100u, 0x84595161401484A0u, 0xA56FA5B99019A5C8u
            ];
            const u64[26] aScale = [
                0x8049A4AC0C5811AEu, 0xCF42894A5DCE35EAu, 0xA76C582338ED2621u, 0x873E4F75E2224E68u,
                0xDA7F5BF590966848u, 0xB080392CC4349DECu, 0x8E938662882AF53Eu, 0xE65829B3046B0AFAu,
                0xBA121A4650E4DDEBu, 0x964E858C91BA2655u, 0xF2D56790AB41C2A2u, 0xC428D05AA4751E4Cu,
                0x9E74D1B791E07E48u, 0xCCCCCCCCCCCCCCCCu, 0xCECB8F27F4200F3Au, 0xA70C3C40A64E6C51u,
                0x86F0AC99B4E8DAFDu, 0xDA01EE641A708DE9u, 0xB01AE745B101E9E4u, 0x8E41ADE9FBEBC27Du,
                0xE5D3EF282A242E81u, 0xB9A74A0637CE2EE1u, 0x95F83D0A1FB69CD9u, 0xF24A01A73CF2DCCFu,
                0xC3B8358109E84F07u, 0x9E19DB92B4E31BA9u
            ];
            const u64[26] aScaleLo = [
                0x205B896Du, 0x52064CADu, 0xAF2AF2B8u, 0x5A7744A7u, 0xAF39A475u, 0xBD8D794Eu,
                0x547EB47Bu, 0x0CB4A5A3u, 0x92F34D62u, 0x3A6A07F9u, 0xFAE27299u, 0xAA97E14Cu,
                0x775EA265u, 0xCCCCCCCCu, 0x00000000u, 0x999090B6u, 0x69A028BBu, 0xE80E6F48u,
                0x5EC05DD0u, 0x14588F14u, 0x8F1668C9u, 0x6D953E2Cu, 0x4ABDAF10u, 0xBC633B39u,
                0x0A862F81u, 0x6C07A2C2u
            ];
            int g, n;
            u64 s, x, lo;
            if (p < 0)
            {
                if (p == 0 - 1)
                {
                    *plo = aScaleLo[13];
                    return aScale[13];
                };
                g = p / 27;
                n = p % 27;
                if (n != 0)
                {
                    g = g - 1;
                    n = n + 27;
                };
            }
            else
            {
                if (p < 27)
                {
                    *plo = (u64)0;
                    return aBase[p];
                };
                g = p / 27;
                n = p % 27;
            };
            s = aScale[g + 13];
            if (n == 0)
            {
                *plo = aScaleLo[g + 13];
                return s;
            };
            x = sq_mul160(s, aScaleLo[g + 13], aBase[n], @lo);
            if ((x >> (u64)63) == (u64)0)
            {
                x = (x << (u64)1) | ((lo >> (u64)31) `& (u64)1);
                lo = ((lo << (u64)1) | (u64)1) `& (u64)4294967295;
            };
            *plo = lo;
            return x;
        };

        // m * 2**e as m10 * 10**exp10 with n significant digits (m has its top bitm set)
        def sq_fp2conv10(u64 m, int e, int n, u64* pD, int* pP) -> void
        {
            int p, sh;
            u64 h, d1, d2;
            p = n - 1 - sq_pwr2to10(e + 63);
            h = sq_mul128(m, sq_pow10_64(p, @d2), @d1);
            if (n == 18)
            {
                sh = 0 - (e + sq_pwr10to2(p) + 2);
                h = h >> (u64)sh;
                *pD = (h + ((h << (u64)1) `& (u64)2)) >> (u64)1;
            }
            else
            {
                sh = 0 - (e + sq_pwr10to2(p) + 1);
                *pD = h >> (u64)sh;
            };
            *pP = 0 - p;
        };

        // the double nearest d * 10**p
        def sq_fp10conv2(u64 d, int p) -> double
        {
            int bl, lp, ex2, adj, sh;
            u64 pwr10l, mid1, mid2, pwr10h, xx, hi, lo, sticky, uu, mm, m32, bitm;
            double r = 0.0;
            double* dp;
            u64* bp;
            m32 = (u64)4294967295;
            if (p < 0 - 348) { return 0.0; };
            if (p > 347) { return 1.0e308 * 10.0; };
            bl = 64 - sq_clz64(d);
            lp = sq_pwr10to2(p);
            ex2 = 53 - bl - lp;
            if (ex2 > 1074)
            {
                if (ex2 >= 1130) { return 0.0; };
                ex2 = 1074;
            };
            sh = 0 - (ex2 - (64 - bl) + lp + 3);
            pwr10h = sq_pow10_64(p, @pwr10l);
            if (pwr10l != (u64)0)
            {
                pwr10h = pwr10h + (u64)1;
                pwr10l = pwr10l ^| m32;
            };
            xx = d << (u64)(64 - bl);
            hi = sq_mul128(xx, pwr10h, @lo);
            mid1 = lo >> (u64)32;
            sticky = (u64)1;
            bitm = (u64)1 << (u64)sh;
            if ((hi `& (bitm - (u64)1)) == (u64)0)
            {
                mid2 = sq_mul128(xx, pwr10l << (u64)32, @lo) >> (u64)32;
                mid2 = mid2 `& m32;
                if (((mid1 - mid2) `& m32) > (u64)1) { sticky = (u64)1; } else { sticky = (u64)0; };
                if (mid1 < mid2) { hi = hi - (u64)1; };
            };
            uu = (hi >> (u64)sh) | sticky;
            adj = 0;
            if (uu >= (((u64)1 << (u64)55) - (u64)2)) { adj = 1; };
            if (adj == 1)
            {
                uu = (uu >> (u64)1) | (uu `& (u64)1);
                ex2 = ex2 - 1;
            };
            mm = (uu + (u64)1 + ((uu >> (u64)2) `& (u64)1)) >> (u64)2;
            if (ex2 <= 0 - 972) { return 1.0e308 * 10.0; };
            if ((mm `& ((u64)1 << (u64)52)) != (u64)0)
            {
                mm = (mm ^| ((u64)1 << (u64)52)) | ((u64)(1075 - ex2) << (u64)52);
            };
            r = 0.0;
            dp = @r;
            bp = (u64*)dp;
            *bp = mm;
            return *dp;
        };

        // The decimal digits SQLite shows for the positive finite double r with precision 17: digits go to z[0..n),
        // the decimal point sits after iDP digits. buf must hold 48 bytes.
        def sq_fp_decode17(double r, byte* buf, int* pn, int* piDP) -> void
        {
            u64 v, vv, fr, v2;
            u64* bp;
            double* dp;
            double rr;
            int e, nn, exp10, i, n, zi, iRound, jj, kk, j, k;
            byte[24] tmp;
            rr = r;
            dp = @rr;
            bp = (u64*)dp;
            v = *bp;
            e = (int)((v >> (u64)52) `& (u64)2047);
            v = v `& (u64)4503599627370495;
            if (e == 0)
            {
                nn = sq_clz64(v);
                v = v << (u64)nn;
                e = 0 - 1074 - nn;
            }
            else
            {
                v = (v << (u64)11) | ((u64)1 << (u64)63);
                e = e - 1086;
            };
            sq_fp2conv10(v, e, 18, @vv, @exp10);
            // digits of vv, right aligned into tmp
            i = 24;
            while (vv >= (u64)10)
            {
                i--;
                tmp[i] = (byte)(48 + (int)(vv % (u64)10));
                vv = vv / (u64)10;
            };
            if (vv != (u64)0) { i--; tmp[i] = (byte)(48 + (int)vv); };
            n = 24 - i;
            zi = 8;
            for (k = 0; k < n; k++) { buf[zi + k] = tmp[i + k]; };
            *piDP = n + exp10;
            iRound = 17;
            if (iRound < n)
            {
                if (buf[zi + 15] == (byte)57 & buf[zi + 14] == (byte)57)
                {
                    jj = 14;
                    while (jj > 0)
                    {
                        if (buf[zi + jj - 1] == (byte)57) { jj--; } else { break; };
                    };
                    if (jj == 0) { v2 = (u64)1; }
                    else
                    {
                        v2 = (u64)((int)buf[zi] - 48);
                        for (kk = 1; kk < jj; kk++) { v2 = v2 * (u64)10 + (u64)((int)buf[zi + kk] - 48); };
                        v2 = v2 + (u64)1;
                    };
                    if (r == sq_fp10conv2(v2, exp10 + n - jj)) { iRound = jj + 1; };
                }
                else
                {
                    if (*piDP >= n | (buf[zi + 15] == (byte)48 & buf[zi + 14] == (byte)48 & buf[zi + 13] == (byte)48))
                    {
                        jj = 13;
                        while (jj > 1)
                        {
                            if (buf[zi + jj - 1] == (byte)48) { jj--; } else { break; };
                        };
                        v2 = (u64)((int)buf[zi] - 48);
                        for (kk = 1; kk < jj; kk++) { v2 = v2 * (u64)10 + (u64)((int)buf[zi + kk] - 48); };
                        if (r == sq_fp10conv2(v2, exp10 + n - jj)) { iRound = jj + 1; };
                    };
                };
                n = iRound;
                if (buf[zi + iRound] >= (byte)53)
                {
                    j = iRound - 1;
                    while (true)
                    {
                        buf[zi + j] = (byte)((int)buf[zi + j] + 1);
                        if (buf[zi + j] <= (byte)57) { break; };
                        buf[zi + j] = (byte)48;
                        if (j == 0)
                        {
                            zi--;
                            buf[zi] = (byte)49;
                            n++;
                            *piDP = *piDP + 1;
                            break;
                        }
                        else { j--; };
                    };
                };
            };
            while (n > 1)
            {
                if (buf[zi + n - 1] == (byte)48) { n--; } else { break; };
            };
            // move the digits to the start of buf
            for (k = 0; k < n; k++) { buf[k] = buf[zi + k]; };
            *pn = n;
        };

        // ---- double-double math: correctly rounded results for the SQL math functions ----

        struct SQ_DD
        {
            double h, l;
        };

        def sq_dd_fromu(u64 bb) -> double
        {
            double* dp;
            dp = (double*)@bb;
            return *dp;
        };

        def sq_dd_pow2(int k) -> double
        {
            u64 bb;
            double* dp;
            if (k < 0 - 1022) { k = 0 - 1022; };
            if (k > 1023) { k = 1023; };
            bb = (u64)(k + 1023) << (u64)52;
            dp = (double*)@bb;
            return *dp;
        };

        def sq_dd_twosum(double a, double b, double* s, double* e) -> void
        {
            double ss, bb;
            ss = a + b;
            bb = ss - a;
            *e = (a - (ss - bb)) + (b - bb);
            *s = ss;
        };

        def sq_dd_qsum(double a, double b, double* s, double* e) -> void
        {
            double ss;
            ss = a + b;
            *e = b - (ss - a);
            *s = ss;
        };

        def sq_dd_split(double a, double* hi, double* lo) -> void
        {
            double t, h;
            t = 134217729.0 * a;
            h = t - (t - a);
            *hi = h;
            *lo = a - h;
        };

        def sq_dd_twoprod(double a, double b, double* p, double* e) -> void
        {
            double pp, ah, al, bh, bl;
            pp = a * b;
            sq_dd_split(a, @ah, @al);
            sq_dd_split(b, @bh, @bl);
            *e = ((ah * bh - pp) + ah * bl + al * bh) + al * bl;
            *p = pp;
        };

        def sq_dd_set(SQ_DD* r, double h, double l) -> void
        {
            r.h = h;
            r.l = l;
        };

        def sq_dd_add(SQ_DD* a, SQ_DD* b, SQ_DD* r) -> void
        {
            double s, e, t, f;
            sq_dd_twosum(a.h, b.h, @s, @e);
            sq_dd_twosum(a.l, b.l, @t, @f);
            e = e + t;
            sq_dd_qsum(s, e, @s, @e);
            e = e + f;
            sq_dd_qsum(s, e, @s, @e);
            r.h = s;
            r.l = e;
        };

        def sq_dd_neg(SQ_DD* a, SQ_DD* r) -> void
        {
            r.h = 0.0 - a.h;
            r.l = 0.0 - a.l;
        };

        def sq_dd_sub(SQ_DD* a, SQ_DD* b, SQ_DD* r) -> void
        {
            SQ_DD nb;
            sq_dd_neg(b, @nb);
            sq_dd_add(a, @nb, r);
        };

        def sq_dd_mul(SQ_DD* a, SQ_DD* b, SQ_DD* r) -> void
        {
            double p, e;
            sq_dd_twoprod(a.h, b.h, @p, @e);
            e = e + (a.h * b.l + a.l * b.h);
            sq_dd_qsum(p, e, @p, @e);
            r.h = p;
            r.l = e;
        };

        def sq_dd_muld(SQ_DD* a, double b, SQ_DD* r) -> void
        {
            double p, e;
            sq_dd_twoprod(a.h, b, @p, @e);
            e = e + a.l * b;
            sq_dd_qsum(p, e, @p, @e);
            r.h = p;
            r.l = e;
        };

        def sq_dd_div(SQ_DD* a, SQ_DD* b, SQ_DD* r) -> void
        {
            double q1, q2, q3;
            SQ_DD t, rem;
            q1 = a.h / b.h;
            sq_dd_muld(b, q1, @t);
            sq_dd_sub(a, @t, @rem);
            q2 = rem.h / b.h;
            sq_dd_muld(b, q2, @t);
            sq_dd_sub(@rem, @t, @rem);
            q3 = rem.h / b.h;
            sq_dd_qsum(q1, q2, @q1, @q2);
            sq_dd_set(@t, q1, q2);
            rem.h = q3;
            rem.l = 0.0;
            sq_dd_add(@t, @rem, r);
        };

        def sq_dd_sqrt(SQ_DD* a, SQ_DD* r) -> void
        {
            double x, ax, ph, pl;
            SQ_DD t, u, v;
            if (a.h <= 0.0) { sq_dd_set(r, 0.0, 0.0); return; };
            x = 1.0 / standard::math::sqrt(a.h);
            ax = a.h * x;
            sq_dd_twoprod(ax, ax, @ph, @pl);
            sq_dd_set(@t, ph, pl);
            sq_dd_sub(a, @t, @u);
            v.h = u.h * (x * 0.5);
            v.l = 0.0;
            sq_dd_set(@t, ax, 0.0);
            sq_dd_add(@t, @v, r);
        };

        // exp of a double-double; the result is scaled by 2^k
        def sq_dd_exp(SQ_DD* a, SQ_DD* r) -> void
        {
            double kd;
            int k, i, ex;
            SQ_DD ln2, t, s, term, sum, nt;
            if (a.h > 709.8) { kd = 1.0e308; kd = kd * 10.0; sq_dd_set(r, kd, 0.0); return; };
            if (a.h < 0.0 - 745.2) { sq_dd_set(r, 0.0, 0.0); return; };
            sq_dd_set(@ln2, sq_dd_fromu(0x3FE62E42FEFA39EFu), sq_dd_fromu(0x3C7ABC9E3B39803Fu));
            kd = a.h / sq_dd_fromu(0x3FE62E42FEFA39EFu);
            if (kd >= 0.0) { kd = (double)((i64)(kd + 0.5)); } else { kd = (double)((i64)(kd - 0.5)); };
            k = (int)kd;
            sq_dd_muld(@ln2, kd, @t);
            sq_dd_sub(a, @t, @s);
            s.h = s.h * 0.00390625;
            s.l = s.l * 0.00390625;
            sq_dd_set(@sum, 1.0, 0.0);
            sq_dd_set(@term, 1.0, 0.0);
            for (i = 1; i < 16; i++)
            {
                sq_dd_mul(@term, @s, @term);
                sq_dd_set(@nt, (double)i, 0.0);
                sq_dd_div(@term, @nt, @term);
                sq_dd_add(@sum, @term, @sum);
            };
            for (i = 0; i < 8; i++) { sq_dd_mul(@sum, @sum, @sum); };
            ex = k;
            if (ex > 1000) { sum.h = sum.h * sq_dd_pow2(1000); sum.l = sum.l * sq_dd_pow2(1000); ex = ex - 1000; };
            if (ex < 0 - 1000)
            {
                sum.h = sum.h * sq_dd_pow2(0 - 1000); sum.l = sum.l * sq_dd_pow2(0 - 1000); ex = ex + 1000;
            };
            sum.h = sum.h * sq_dd_pow2(ex);
            sum.l = sum.l * sq_dd_pow2(ex);
            r.h = sum.h;
            r.l = sum.l;
        };

        // natural log of a positive double-double
        def sq_dd_log(SQ_DD* a, SQ_DD* r) -> void
        {
            double m, z, z2, y0, tm;
            int e, i;
            u64 bits;
            u64* bp;
            double* dp;
            SQ_DD y, ex, num, den, q, ln2, mm, two, t;
            m = a.h;
            e = 0;
            bits = (u64)0;
            dp = @m;
            bp = (u64*)dp;
            bits = *bp;
            e = (int)((bits >> (u64)52) `& (u64)2047);
            if (e == 0)
            {
                m = m * 18014398509481984.0;
                dp = @m;
                bp = (u64*)dp;
                bits = *bp;
                e = (int)((bits >> (u64)52) `& (u64)2047) - 54;
            };
            e = e - 1023;
            bits = (bits `& (u64)4503599627370495) | ((u64)1023 << (u64)52);
            *bp = bits;
            // m in [1,2); bring into [0.707,1.414)
            if (m > 1.4142135623730951) { m = m * 0.5; e = e + 1; };
            tm = m;
            // the same scaling applies to the low word
            mm.h = a.h;
            mm.l = a.l;
            mm.h = tm;
            mm.l = a.l * (tm / a.h);
            z = (tm - 1.0) / (tm + 1.0);
            z2 = z * z;
            y0 = 2.0 * z * (1.0 + z2 * (0.3333333333333333 + z2 * (0.2 + z2 * (0.14285714285714285 + z2 * (0.1111111111111111 + z2 * (0.09090909090909091 + z2 * (0.07692307692307693 + z2 * (0.06666666666666667 + z2 * 0.058823529411764705))))))));
            sq_dd_set(@y, y0, 0.0);
            sq_dd_set(@two, 2.0, 0.0);
            for (i = 0; i < 3; i++)
            {
                sq_dd_exp(@y, @ex);
                sq_dd_sub(@mm, @ex, @num);
                sq_dd_add(@mm, @ex, @den);
                sq_dd_div(@num, @den, @q);
                sq_dd_mul(@q, @two, @q);
                sq_dd_add(@y, @q, @y);
            };
            sq_dd_set(@ln2, sq_dd_fromu(0x3FE62E42FEFA39EFu), sq_dd_fromu(0x3C7ABC9E3B39803Fu));
            sq_dd_muld(@ln2, (double)e, @t);
            sq_dd_add(@y, @t, r);
        };

        // x ^ y for doubles; flag 1 in *bad when the result is not a number
        def sq_dd_pow(double x, double y, int* bad) -> double
        {
            SQ_DD lx, t, ex, ax, yy;
            double ay, fy, h, res;
            int odd, yint;
            i64 iy;
            *bad = 0;
            if (y == 0.0) { return 1.0; };
            if (x == 1.0) { return 1.0; };
            odd = 0; yint = 0;
            ay = y;
            if (ay < 0.0) { ay = 0.0 - ay; };
            if (ay < 9007199254740992.0)
            {
                iy = (i64)ay;
                fy = (double)iy;
                if (fy == ay)
                {
                    yint = 1;
                    if ((iy `& (i64)1) != (i64)0) { odd = 1; };
                };
            }
            else { yint = 1; };
            if (x == 0.0)
            {
                if (y > 0.0) { if (odd == 1) { return x; }; return 0.0; };
                h = 1.0e308;
                return h * 10.0;
            };
            h = x;
            if (h < 0.0)
            {
                if (yint == 0) { *bad = 1; return 0.0; };
                h = 0.0 - h;
            };
            if (h == 1.0)
            {
                if (x < 0.0 & odd == 1) { return 0.0 - 1.0; };
                return 1.0;
            };
            sq_dd_set(@ax, h, 0.0);
            sq_dd_log(@ax, @lx);
            sq_dd_set(@yy, y, 0.0);
            sq_dd_mul(@lx, @yy, @t);
            sq_dd_exp(@t, @ex);
            res = ex.h + ex.l;
            if (x < 0.0 & odd == 1) { res = 0.0 - res; };
            return res;
        };

        // sin and cos of a double-double r with |r| <= pi/4 (kernel)
        def sq_dd_sincos_k(SQ_DD* r, SQ_DD* s, SQ_DD* c) -> void
        {
            int i;
            SQ_DD r2, term, sum, nt, one;
            sq_dd_mul(r, r, @r2);
            // sin
            sq_dd_set(@term, r.h, r.l);
            sq_dd_set(@sum, r.h, r.l);
            for (i = 1; i < 16; i++)
            {
                sq_dd_mul(@term, @r2, @term);
                sq_dd_set(@nt, (double)((2 * i) * (2 * i + 1)), 0.0);
                sq_dd_div(@term, @nt, @term);
                sq_dd_neg(@term, @term);
                sq_dd_add(@sum, @term, @sum);
            };
            sq_dd_set(s, sum.h, sum.l);
            // cos
            sq_dd_set(@term, 1.0, 0.0);
            sq_dd_set(@sum, 1.0, 0.0);
            for (i = 1; i < 16; i++)
            {
                sq_dd_mul(@term, @r2, @term);
                sq_dd_set(@nt, (double)((2 * i - 1) * (2 * i)), 0.0);
                sq_dd_div(@term, @nt, @term);
                sq_dd_neg(@term, @term);
                sq_dd_add(@sum, @term, @sum);
            };
            sq_dd_set(c, sum.h, sum.l);
        };

        global byte* SQ_TWOPI = "\0";

        def sq_dd_getb(u64* pa, int pos) -> int
        {
            return (int)((pa[pos / 32] >> (u64)(pos % 32)) `& (u64)1);
        };

        // Payne-Hanek reduction of a large double modulo pi/2 with 2/pi held to 1440 bits
        def sq_dd_bigreduce(double ax, int* q, SQ_DD* r) -> int
        {
            u64 bits, m, m0, m1, mj, carry, cur, val;
            u64[8] wl;
            u64[12] pa;
            double ad, scale, fc;
            double* dp;
            u64* bp;
            int e11, ee, ks, i, j, k, t, nib, v, bitv, pos, qq, c, jj;
            SQ_DD fr, tmp, pio2, one;
            ad = ax;
            dp = @ad;
            bp = (u64*)dp;
            bits = *bp;
            e11 = (int)((bits >> (u64)52) `& (u64)2047);
            if (e11 == 0 | e11 == 2047) { return 0; };
            m = (bits `& (u64)4503599627370495) | (u64)4503599627370496;
            ee = e11 - 1075;
            ks = ee - 1;
            if (ks < 1) { ks = 1; };
            for (i = 0; i < 8; i++) { wl[i] = (u64)0; };
            for (i = 0; i < 12; i++) { pa[i] = (u64)0; };
            for (i = 0; i < 256; i++)
            {
                k = ks + i;
                nib = (k - 1) / 4;
                v = (int)SQ_TWOPI[nib];
                if (v >= 97) { v = v - 87; } else { v = v - 48; };
                bitv = (v >> (3 - ((k - 1) % 4))) `& 1;
                if (bitv == 1)
                {
                    pos = 255 - i;
                    wl[pos / 32] = wl[pos / 32] | ((u64)1 << (u64)(pos % 32));
                };
            };
            m0 = m `& (u64)4294967295;
            m1 = m >> (u64)32;
            for (j = 0; j < 2; j++)
            {
                if (j == 0) { mj = m0; } else { mj = m1; };
                carry = (u64)0;
                for (i = 0; i < 8; i++)
                {
                    cur = pa[i + j] + mj * wl[i] + carry;
                    pa[i + j] = cur `& (u64)4294967295;
                    carry = cur >> (u64)32;
                };
                pa[8 + j] = pa[8 + j] + carry;
            };
            t = 256 + ks - ee - 1;
            qq = sq_dd_getb(@pa[0], t) + 2 * sq_dd_getb(@pa[0], t + 1);
            sq_dd_set(@fr, 0.0, 0.0);
            for (c = 0; c < 4; c++)
            {
                val = (u64)0;
                for (jj = 0; jj < 53; jj++)
                {
                    pos = t - 1 - (c * 53 + jj);
                    val = val * (u64)2 + (u64)sq_dd_getb(@pa[0], pos);
                };
                fc = (double)((i64)val);
                scale = sq_dd_pow2(0 - (c * 53 + 53));
                sq_dd_set(@tmp, fc * scale, 0.0);
                sq_dd_add(@fr, @tmp, @fr);
            };
            if (fr.h >= 0.5)
            {
                sq_dd_set(@one, 1.0, 0.0);
                sq_dd_sub(@fr, @one, @fr);
                qq++;
            };
            *q = qq `& 3;
            sq_dd_set(@pio2, 1.5707963267948966, 6.123233995736766e-17);
            sq_dd_mul(@fr, @pio2, r);
            return 1;
        };

        // reduces x modulo pi/2: returns the quadrant in *q and the remainder in r; 0 when x is too large
        def sq_dd_reduce(double x, int* q, SQ_DD* r) -> int
        {
            double ax, kd, p1, p2, p3, ph, pl;
            SQ_DD t, u, a;
            i64 k;
            ax = x;
            if (ax < 0.0) { ax = 0.0 - ax; };
            if (ax > 1.0e15) { return sq_dd_bigreduce(ax, q, r); };
            p1 = 1.5707963267948966;
            p2 = 6.123233995736766e-17;
            p3 = 0.0 - 1.4973849048591698e-33;
            kd = ax * 0.6366197723675814;
            kd = (double)((i64)(kd + 0.5));
            k = (i64)kd;
            sq_dd_set(@a, ax, 0.0);
            sq_dd_twoprod(kd, p1, @ph, @pl);
            sq_dd_set(@t, ph, pl);
            sq_dd_sub(@a, @t, @u);
            sq_dd_twoprod(kd, p2, @ph, @pl);
            sq_dd_set(@t, ph, pl);
            sq_dd_sub(@u, @t, @u);
            t.h = kd * p3;
            t.l = 0.0;
            sq_dd_sub(@u, @t, @u);
            sq_dd_set(r, u.h, u.l);
            *q = (int)(k `& (i64)3);
            return 1;
        };

        // 1 sin, 2 cos, 3 tan; returns 0 when the argument is out of range
        def sq_dd_trig(double x, int which, double* out) -> int
        {
            int q, ok;
            SQ_DD r, s, c, res, rr;
            double sg;
            sg = 1.0;
            if (x < 0.0) { sg = 0.0 - 1.0; };
            ok = sq_dd_reduce(x, @q, @r);
            if (ok == 0) { return 0; };
            sq_dd_sincos_k(@r, @s, @c);
            if (which == 1)
            {
                if (q == 0) { sq_dd_set(@res, s.h, s.l); };
                if (q == 1) { sq_dd_set(@res, c.h, c.l); };
                if (q == 2) { sq_dd_neg(@s, @res); };
                if (q == 3) { sq_dd_neg(@c, @res); };
                *out = (res.h + res.l) * sg;
                return 1;
            };
            if (which == 2)
            {
                if (q == 0) { sq_dd_set(@res, c.h, c.l); };
                if (q == 1) { sq_dd_neg(@s, @res); };
                if (q == 2) { sq_dd_neg(@c, @res); };
                if (q == 3) { sq_dd_set(@res, s.h, s.l); };
                *out = res.h + res.l;
                return 1;
            };
            if (q == 0 | q == 2) { sq_dd_div(@s, @c, @res); } else { sq_dd_div(@c, @s, @res); sq_dd_neg(@res, @res); };
            *out = (res.h + res.l) * sg;
            return 1;
        };

        // arctangent of a double-double
        def sq_dd_atan(SQ_DD* a, SQ_DD* r) -> void
        {
            int i, inv, neg;
            SQ_DD x, one, x2, y, t, term, sum, nt, pio2, d;
            sq_dd_set(@one, 1.0, 0.0);
            neg = 0; inv = 0;
            sq_dd_set(@x, a.h, a.l);
            if (x.h < 0.0) { neg = 1; sq_dd_neg(@x, @x); };
            if (x.h > 1.0)
            {
                inv = 1;
                sq_dd_div(@one, @x, @x);
            };
            for (i = 0; i < 3; i++)
            {
                sq_dd_mul(@x, @x, @x2);
                sq_dd_add(@x2, @one, @t);
                sq_dd_sqrt(@t, @t);
                sq_dd_add(@t, @one, @t);
                sq_dd_div(@x, @t, @x);
            };
            sq_dd_mul(@x, @x, @x2);
            sq_dd_set(@term, x.h, x.l);
            sq_dd_set(@sum, x.h, x.l);
            for (i = 1; i < 24; i++)
            {
                sq_dd_mul(@term, @x2, @term);
                sq_dd_neg(@term, @term);
                sq_dd_set(@nt, (double)(2 * i + 1), 0.0);
                sq_dd_div(@term, @nt, @d);
                sq_dd_add(@sum, @d, @sum);
                sq_dd_set(@term, term.h, term.l);
            };
            sq_dd_muld(@sum, 8.0, @y);
            if (inv == 1)
            {
                sq_dd_set(@pio2, 1.5707963267948966, 6.123233995736766e-17);
                sq_dd_sub(@pio2, @y, @y);
            };
            if (neg == 1) { sq_dd_neg(@y, @y); };
            sq_dd_set(r, y.h, y.l);
        };

        // arctangent of y/x with the quadrant of the pair
        def sq_dd_atan2(double y, double x, double* out) -> void
        {
            SQ_DD a, b, q, r, pi;
            sq_dd_set(@pi, 3.141592653589793, 1.2246467991473532e-16);
            if (x == 0.0)
            {
                if (y == 0.0) { *out = 0.0; return; };
                sq_dd_set(@r, 1.5707963267948966, 6.123233995736766e-17);
                if (y < 0.0) { sq_dd_neg(@r, @r); };
                *out = r.h + r.l;
                return;
            };
            if (y == 0.0)
            {
                if (x > 0.0) { *out = y; return; };
                sq_dd_set(@r, pi.h, pi.l);
                if (1.0 / y < 0.0) { sq_dd_neg(@r, @r); };
                *out = r.h + r.l;
                return;
            };
            sq_dd_set(@a, y, 0.0);
            sq_dd_set(@b, x, 0.0);
            sq_dd_div(@a, @b, @q);
            sq_dd_atan(@q, @r);
            if (x < 0.0)
            {
                if (y > 0.0) { sq_dd_add(@r, @pi, @r); } else { sq_dd_sub(@r, @pi, @r); };
            };
            *out = r.h + r.l;
        };

        def sq_dd_ln(double x) -> double
        {
            SQ_DD a, r;
            sq_dd_set(@a, x, 0.0);
            sq_dd_log(@a, @r);
            return r.h + r.l;
        };

        def sq_dd_log10(double x) -> double
        {
            SQ_DD a, r, l10;
            sq_dd_set(@a, x, 0.0);
            sq_dd_log(@a, @r);
            sq_dd_set(@l10, sq_dd_fromu(0x40026BB1BBB55516u), sq_dd_fromu(0xBCAF48AD494EA3E9u));
            sq_dd_div(@r, @l10, @r);
            return r.h + r.l;
        };

        def sq_dd_log2(double x) -> double
        {
            SQ_DD a, r, l2;
            sq_dd_set(@a, x, 0.0);
            sq_dd_log(@a, @r);
            sq_dd_set(@l2, sq_dd_fromu(0x3FE62E42FEFA39EFu), sq_dd_fromu(0x3C7ABC9E3B39803Fu));
            sq_dd_div(@r, @l2, @r);
            return r.h + r.l;
        };

        def sq_dd_expd(double x) -> double
        {
            SQ_DD a, r;
            sq_dd_set(@a, x, 0.0);
            sq_dd_exp(@a, @r);
            return r.h + r.l;
        };

        def sq_dd_hiw(double x) -> int
        {
            double xx;
            double* dp;
            u64* bp;
            xx = x;
            dp = @xx;
            bp = (u64*)dp;
            return (int)((*bp) >> (u64)32);
        };

        // expm1 through double-double exp
        def sq_dd_expm1(double x) -> double
        {
            SQ_DD a, e, one, r;
            sq_dd_set(@a, x, 0.0);
            sq_dd_exp(@a, @e);
            sq_dd_set(@one, 1.0, 0.0);
            sq_dd_sub(@e, @one, @r);
            return r.h + r.l;
        };

        // hyperbolic functions: 1 sinh, 2 cosh, 3 tanh
        def sq_dd_hyp(double x, int which) -> double
        {
            SQ_DD a, ex, enx, s, d, h, one, t2;
            double ax, x2, t, w, ovf, hh;
            int ix;
            ax = x;
            if (ax < 0.0) { ax = 0.0 - ax; };
            if (which == 1 | which == 2)
            {
                // fdlibm / glibc forms
                ix = sq_dd_hiw(ax);
                ovf = sq_dd_fromu(0x408633CE8FB9F87Du);
                hh = 0.5;
                if (which == 1 & x < 0.0) { hh = 0.0 - 0.5; };
                if (ix < 1077149696)
                {
                    if (which == 1)
                    {
                        if (ix < 1043333120) { return x; };
                        t = sq_dd_expm1(ax);
                        if (ix < 1072693248) { return hh * (2.0 * t - t * t / (t + 1.0)); };
                        return hh * (t + t / (t + 1.0));
                    };
                    if (ix < 1071001155)
                    {
                        t = sq_dd_expm1(ax);
                        w = 1.0 + t;
                        if (ix < 1015021568) { return w; };
                        return 1.0 + (t * t) / (w + w);
                    };
                    t = sq_dd_expd(ax);
                    return 0.5 * t + 0.5 / t;
                };
                if (ix < 1082535490)
                {
                    return hh * sq_dd_expd(ax);
                };
                if (ax <= ovf)
                {
                    w = sq_dd_expd(0.5 * ax);
                    t = hh * w;
                    return t * w;
                };
                if (which == 1)
                {
                    if (x < 0.0) { return 0.0 - sq_dd_fromu(0x7FF0000000000000u); };
                };
                return sq_dd_fromu(0x7FF0000000000000u);
            };
            if (which != 2 & ax < 1.0e-5)
            {
                x2 = x * x;
                if (which == 1) { return x + x * x2 / 6.0; };
                return x - x * x2 / 3.0;
            };
            if (which == 3 & ax > 20.0) { if (x < 0.0) { return 0.0 - 1.0; }; return 1.0; };
            sq_dd_set(@a, x, 0.0);
            sq_dd_exp(@a, @ex);
            sq_dd_set(@one, 1.0, 0.0);
            sq_dd_div(@one, @ex, @enx);
            sq_dd_sub(@ex, @enx, @d);
            sq_dd_add(@ex, @enx, @s);
            sq_dd_div(@d, @s, @h);
            return h.h + h.l;
        };

        def sq_dd_sethi(double x, int hi) -> double
        {
            double xx;
            double* dp;
            u64* bp;
            xx = x;
            dp = @xx;
            bp = (u64*)dp;
            *bp = ((*bp) `& (u64)4294967295) | (((u64)hi `& (u64)4294967295) << (u64)32);
            return xx;
        };

        // log1p as the C library computes it (fdllibm algorithm)
        def sq_dd_fdlog1p(double x) -> double
        {
            double hfsq, f, c, s, z, r, u, kd, ln2hi, ln2lo, lp1, lp2, lp3, lp4, lp5, lp6, lp7;
            int k, hx, hu, ax;
            ln2hi = sq_dd_fromu(0x3FE62E42FEE00000u);
            ln2lo = sq_dd_fromu(0x3DEA39EF35793C76u);
            lp1 = sq_dd_fromu(0x3FE5555555555593u); lp2 = sq_dd_fromu(0x3FD999999997FA04u); lp3 = sq_dd_fromu(0x3FD2492494229359u);
            lp4 = sq_dd_fromu(0x3FCC71C51D8E78AFu); lp5 = sq_dd_fromu(0x3FC7466496CB03DEu); lp6 = sq_dd_fromu(0x3FC39A09D078C69Fu);
            lp7 = sq_dd_fromu(0x3FC2F112DF3E5244u);
            hx = sq_dd_hiw(x);
            ax = hx `& 2147483647;
            k = 1;
            f = 0.0; hu = 0; c = 0.0; u = 0.0;
            if (hx < 1071644282)
            {
                if (ax >= 1072693248) { if (x == 0.0 - 1.0) { kd = 1.0e308; return 0.0 - kd * 10.0; }; kd = 0.0; return kd / kd; };
                if (ax < 1042284544)
                {
                    if (ax < 1015021568) { return x; };
                    return x - x * x * 0.5;
                };
                if (hx > 0 | hx <= (0 - 1076707644)) { k = 0; f = x; hu = 1; };
            };
            if (hx >= 2146435072) { return x + x; };
            if (k != 0)
            {
                if (hx < 1128267776)
                {
                    u = 1.0 + x;
                    hu = sq_dd_hiw(u);
                    k = (hu >> 20) - 1023;
                    if (k > 0) { c = 1.0 - (u - x); } else { c = x - (u - 1.0); };
                    c = c / u;
                }
                else
                {
                    u = x;
                    hu = sq_dd_hiw(u);
                    k = (hu >> 20) - 1023;
                    c = 0.0;
                };
                hu = hu `& 1048575;
                if (hu < 434334)
                {
                    u = sq_dd_sethi(u, hu | 1072693248);
                }
                else
                {
                    k = k + 1;
                    u = sq_dd_sethi(u, hu | 1071644672);
                    hu = (1048576 - hu) >> 2;
                };
                f = u - 1.0;
            };
            hfsq = 0.5 * f * f;
            kd = (double)k;
            if (hu == 0)
            {
                if (f == 0.0)
                {
                    if (k == 0) { return 0.0; };
                    c = c + kd * ln2lo;
                    return kd * ln2hi + c;
                };
                r = hfsq * (1.0 - sq_dd_fromu(0x3FE5555555555555u) * f);
                if (k == 0) { return f - r; };
                return kd * ln2hi - ((r - (kd * ln2lo + c)) - f);
            };
            s = f / (2.0 + f);
            z = s * s;
            r = z * (lp1 + z * (lp2 + z * (lp3 + z * (lp4 + z * (lp5 + z * (lp6 + z * lp7))))));
            if (k == 0) { return f - (hfsq - s * (hfsq + r)); };
            return kd * ln2hi - ((hfsq - (s * (hfsq + r) + (kd * ln2lo + c))) - f);
        };

        // log1p of a double, correctly rounded
        def sq_dd_log1p(double u) -> double
        {
            SQ_DD a, r;
            double sh, se;
            sq_dd_twosum(1.0, u, @sh, @se);
            sq_dd_set(@a, sh, se);
            if (sh <= 0.0) { return 0.0; };
            sq_dd_log(@a, @r);
            return r.h + r.l;
        };

        // inverse hyperbolic functions with the argument forms of the C library: 1 asinh, 2 acosh, 3 atanh
        def sq_dd_ahyp(double x, int which) -> double
        {
            double ax, t, w, r;
            ax = x;
            if (ax < 0.0) { ax = 0.0 - ax; };
            if (which == 1)
            {
                if (ax < 3.725290298461914e-09) { return x; };
                if (ax > 268435456.0) { w = sq_dd_ln(ax) + 0.6931471805599453; }
                else
                {
                    if (ax > 2.0)
                    {
                        w = sq_dd_ln(2.0 * ax + 1.0 / (standard::math::sqrt(x * x + 1.0) + ax));
                    }
                    else
                    {
                        t = x * x;
                        w = sq_dd_fdlog1p(ax + t / (1.0 + standard::math::sqrt(1.0 + t)));
                    };
                };
                if (x < 0.0) { return 0.0 - w; };
                return w;
            };
            if (which == 2)
            {
                if (ax == 1.0) { return 0.0; };
                if (ax >= 268435456.0) { return sq_dd_ln(ax) + 0.6931471805599453; };
                if (ax > 2.0)
                {
                    t = ax * ax;
                    return sq_dd_ln(2.0 * ax - 1.0 / (ax + standard::math::sqrt(t - 1.0)));
                };
                t = ax - 1.0;
                return sq_dd_fdlog1p(t + standard::math::sqrt(2.0 * t + t * t));
            };
            if (ax < 3.725290298461914e-09) { return x; };
            if (ax < 0.5)
            {
                t = ax + ax;
                w = 0.5 * sq_dd_fdlog1p(t + t * ax / (1.0 - ax));
            }
            else
            {
                w = 0.5 * sq_dd_fdlog1p((ax + ax) / (1.0 - ax));
            };
            if (x < 0.0) { return 0.0 - w; };
            return w;
        };

        // 1 asin, 2 acos for |x| <= 1
        def sq_dd_asin(double x, int which) -> double
        {
            SQ_DD a, one, t, s, b, r, pio2;
            double o;
            if (x == 1.0 | x == 0.0 - 1.0)
            {
                sq_dd_set(@pio2, 1.5707963267948966, 6.123233995736766e-17);
                if (which == 1) { if (x < 0.0) { return 0.0 - pio2.h; }; return pio2.h; };
                if (x > 0.0) { return 0.0; };
                return 3.141592653589793;
            };
            sq_dd_set(@a, x, 0.0);
            sq_dd_set(@one, 1.0, 0.0);
            sq_dd_mul(@a, @a, @t);
            sq_dd_sub(@one, @t, @t);
            sq_dd_sqrt(@t, @s);
            if (which == 1)
            {
                if (x == 0.0) { return x; };
                sq_dd_div(@a, @s, @b);
                sq_dd_atan(@b, @r);
                return r.h + r.l;
            };
            if (x == 0.0)
            {
                return 1.5707963267948966;
            };
            sq_dd_div(@s, @a, @b);
            sq_dd_atan(@b, @r);
            if (x < 0.0)
            {
                sq_dd_set(@pio2, 3.141592653589793, 1.2246467991473532e-16);
                sq_dd_add(@r, @pio2, @r);
            };
            return r.h + r.l;
        };
        // ---- exact REAL to text (the %!.15g form of SQLite) ----

        def sq_big_mul(u64* big, int nb, u64 m) -> int
        {
            int i;
            u64 carry, x;
            carry = (u64)0;
            for (i = 0; i < nb; i++)
            {
                x = big[i] * m + carry;
                big[i] = x % (u64)1000000000;
                carry = x / (u64)1000000000;
            };
            while (carry != (u64)0)
            {
                big[nb] = carry % (u64)1000000000;
                carry = carry / (u64)1000000000;
                nb++;
            };
            return nb;
        };

        // Exact decimal expansion of m * 2^e2 (m > 0): digits in dig, most significant first, trailing zeros removed;
        // *Xo is the decimal exponent of the first digit.
        def sq_exact_mant(u64 m, int e2, byte* dig, int* ndo, int* Xo) -> void
        {
            u64[200] big;
            byte[12] tmp;
            u64 limb, p5, p2;
            int nb, nd, i, j, k, shift;
            nb = 0;
            while (m != (u64)0)
            {
                big[nb] = m % (u64)1000000000;
                m = m / (u64)1000000000;
                nb++;
            };
            shift = 0;
            if (e2 > 0)
            {
                while (e2 >= 29) { nb = sq_big_mul(@big[0], nb, (u64)536870912); e2 = e2 - 29; };
                p2 = (u64)1;
                while (e2 > 0) { p2 = p2 * (u64)2; e2--; };
                nb = sq_big_mul(@big[0], nb, p2);
            };
            if (e2 < 0)
            {
                k = 0 - e2;
                shift = k;
                while (k >= 12) { nb = sq_big_mul(@big[0], nb, (u64)244140625); k = k - 12; };
                p5 = (u64)1;
                while (k > 0) { p5 = p5 * (u64)5; k--; };
                nb = sq_big_mul(@big[0], nb, p5);
            };
            nd = 0;
            limb = big[nb - 1];
            j = 0;
            while (limb != (u64)0) { tmp[j] = (byte)(48 + (int)(limb % (u64)10)); limb = limb / (u64)10; j++; };
            while (j > 0) { j--; dig[nd] = tmp[j]; nd++; };
            for (i = nb - 2; i >= 0; i--)
            {
                limb = big[i];
                for (j = 8; j >= 0; j--)
                {
                    dig[nd + j] = (byte)(48 + (int)(limb % (u64)10));
                    limb = limb / (u64)10;
                };
                nd = nd + 9;
            };
            *Xo = nd - 1 - shift;
            while (nd > 1)
            {
                if (dig[nd - 1] == (byte)48) { nd--; } else { break; };
            };
            *ndo = nd;
        };

        // Exact expansion of a finite double. Returns the sign (1 negative, 0 positive), or 2 infinity, 3 NaN, 4 zero.
        def sq_real_exact(double r, byte* dig, int* ndo, int* Xo) -> int
        {
            double dd;
            u64* bp;
            u64 bits, frac, m;
            int neg, e, e2;
            dd = r;
            bp = (u64*)@dd;
            bits = *bp;
            neg = (int)(bits >> 63);
            e = (int)((bits >> 52) `& (u64)2047);
            frac = bits `& (u64)4503599627370495;
            if (e == 2047)
            {
                if (frac != (u64)0) { return 3; };
                return 2;
            };
            if (e == 0 & frac == (u64)0) { return 4; };
            if (e == 0) { m = frac; e2 = 0 - 1074; } else { m = frac | (u64)4503599627370496; e2 = e - 1075; };
            sq_exact_mant(m, e2, dig, ndo, Xo);
            return neg;
        };

        // compares two positive decimals given as digit strings with the exponent of their first digit
        def sq_cmp_dec(byte* a, int na, int Xa, byte* b, int nb, int Xb) -> int
        {
            int i, n;
            byte x, y;
            if (Xa != Xb) { if (Xa > Xb) { return 1; }; return 0 - 1; };
            n = na;
            if (nb > n) { n = nb; };
            for (i = 0; i < n; i++)
            {
                x = (byte)48;
                y = (byte)48;
                if (i < na) { x = a[i]; };
                if (i < nb) { y = b[i]; };
                if (x != y) { if (x > y) { return 1; }; return 0 - 1; };
            };
            return 0;
        };

        // rounds the digit string to keep digits [0,keep) (round half up on the exact expansion); returns the new X
        def sq_round_digits(byte* dig, int* nd, int X, int keep) -> int
        {
            int k, i;
            if (keep < 0) { *nd = 0; return X; };
            if (*nd <= keep) { return X; };
            if (dig[keep] >= (byte)53)
            {
                k = keep - 1;
                while (k >= 0)
                {
                    if (dig[k] == (byte)57) { dig[k] = (byte)48; k--; }
                    else { dig[k] = dig[k] + (byte)1; break; };
                };
                if (k < 0)
                {
                    // carried out of the top digit: 99.. becomes 100..
                    dig[0] = (byte)49;
                    for (i = 1; i < keep; i++) { dig[i] = (byte)48; };
                    X++;
                    *nd = keep;
                    if (keep == 0) { *nd = 1; };
                    return X;
                };
            };
            *nd = keep;
            return X;
        };

        // true when the decimal d (nd digits, exponent X) converts back to the double bits exactly
        def sq_roundtrip(double r, byte* d, int nd, int X) -> bool
        {
            byte[1300] hi;
            byte[1300] lo;
            double dd;
            u64* bp;
            u64 bits, frac, m;
            int e, e2, nhi, nlo, Xhi, Xlo, c1, c2, even;
            dd = r;
            if (dd < 0.0) { dd = 0.0 - dd; };
            bp = (u64*)@dd;
            bits = *bp;
            e = (int)((bits >> 52) `& (u64)2047);
            frac = bits `& (u64)4503599627370495;
            if (e == 0)
            {
                if (frac == (u64)0) { return false; };
                m = frac;
                e2 = 0 - 1074;
            }
            else
            {
                m = frac | (u64)4503599627370496;
                e2 = e - 1075;
            };
            sq_exact_mant(m * (u64)2 + (u64)1, e2 - 1, @hi[0], @nhi, @Xhi);
            if (frac == (u64)0 & e > 1) { sq_exact_mant(m * (u64)4 - (u64)1, e2 - 2, @lo[0], @nlo, @Xlo); }
            else { sq_exact_mant(m * (u64)2 - (u64)1, e2 - 1, @lo[0], @nlo, @Xlo); };
            even = 0;
            if (m % (u64)2 == (u64)0) { even = 1; };
            c1 = sq_cmp_dec(d, nd, X, @hi[0], nhi, Xhi);
            c2 = sq_cmp_dec(d, nd, X, @lo[0], nlo, Xlo);
            if (c1 > 0 | c2 < 0) { return false; };
            if (c1 == 0 & even == 0) { return false; };
            if (c2 == 0 & even == 0) { return false; };
            return true;
        };

        // %!.17g of SQLite: 17 digits, reduced when a shorter form reads back as the same double
        def sq_real_text(double r, byte* out) -> int
        {
            byte[1300] dig;
            byte[64] dbuf;
            byte[24] ex;
            int neg, nd, X, o, i, en, kk, ndg, Xf, dp17;
            byte* ds;
            neg = sq_real_exact(r, @dig[0], @nd, @X);
            o = 0;
            if (neg == 3) { out[0] = (byte)78; out[1] = (byte)97; out[2] = (byte)78; out[3] = (byte)0; return 3; };
            if (neg == 4)
            {
                out[0] = (byte)48; out[1] = (byte)46; out[2] = (byte)48; out[3] = (byte)0;
                return 3;
            };
            if (neg == 2)
            {
                if (r < 0.0) { out[0] = (byte)45; o = 1; };
                out[o] = (byte)73; out[o + 1] = (byte)110; out[o + 2] = (byte)102; out[o + 3] = (byte)0;
                return o + 3;
            };
            if (neg == 1) { out[o] = (byte)45; o++; };
            if (r < 0.0) { sq_fp_decode17(0.0 - r, @dbuf[0], @ndg, @dp17); }
            else { sq_fp_decode17(r, @dbuf[0], @ndg, @dp17); };
            ds = @dbuf[0];
            Xf = dp17 - 1;
            while (ndg > 1)
            {
                if (ds[ndg - 1] == (byte)48) { ndg--; } else { break; };
            };
            X = Xf;
            if (X < 0 - 4 | X >= 17)
            {
                out[o] = ds[0]; o++;
                out[o] = (byte)46; o++;
                if (ndg == 1) { out[o] = (byte)48; o++; }
                else { for (i = 1; i < ndg; i++) { out[o] = ds[i]; o++; }; };
                out[o] = (byte)101; o++;
                kk = X;
                if (kk < 0) { out[o] = (byte)45; kk = 0 - kk; } else { out[o] = (byte)43; };
                o++;
                en = 0;
                if (kk >= 100) { ex[en] = (byte)(48 + kk / 100); en++; kk = kk % 100; ex[en] = (byte)(48 + kk / 10); en++; ex[en] = (byte)(48 + kk % 10); en++; }
                else { ex[en] = (byte)(48 + kk / 10); en++; ex[en] = (byte)(48 + kk % 10); en++; };
                for (i = 0; i < en; i++) { out[o] = ex[i]; o++; };
                out[o] = (byte)0;
                return o;
            };
            if (X >= 0)
            {
                for (i = 0; i <= X; i++)
                {
                    if (i < ndg) { out[o] = ds[i]; } else { out[o] = (byte)48; };
                    o++;
                };
                out[o] = (byte)46; o++;
                if (ndg > X + 1) { for (i = X + 1; i < ndg; i++) { out[o] = ds[i]; o++; }; }
                else { out[o] = (byte)48; o++; };
                out[o] = (byte)0;
                return o;
            };
            out[o] = (byte)48; o++;
            out[o] = (byte)46; o++;
            for (i = 0; i < 0 - X - 1; i++) { out[o] = (byte)48; o++; };
            for (i = 0; i < ndg; i++) { out[o] = ds[i]; o++; };
            out[o] = (byte)0;
            return o;
        };


        // %.16g of SQLite as shown for a Real P4: 16 significant digits, trailing zeros removed
        def sq_real_g16(double r, byte* out) -> int
        {
            byte[1300] dig;
            byte[24] d;
            int neg, nd, X, o, i, k, up, kk, en;
            byte[8] ex;
            neg = sq_real_exact(r, @dig[0], @nd, @X);
            o = 0;
            if (neg == 4) { out[0] = (byte)48; out[1] = (byte)0; return 1; };
            if (neg == 3) { out[0] = (byte)78; out[1] = (byte)97; out[2] = (byte)78; out[3] = (byte)0; return 3; };
            if (neg == 2)
            {
                if (r < 0.0) { out[0] = (byte)45; o = 1; };
                out[o] = (byte)73; out[o + 1] = (byte)110; out[o + 2] = (byte)102; out[o + 3] = (byte)0;
                return o + 3;
            };
            if (neg == 1) { out[o] = (byte)45; o++; };
            for (i = 0; i < 17; i++) { if (i < nd) { d[i] = dig[i]; } else { d[i] = (byte)48; }; };
            up = 0;
            if (d[16] > (byte)53) { up = 1; };
            if (d[16] == (byte)53)
            {
                up = 0;
                for (i = 17; i < nd; i++) { if (dig[i] != (byte)48) { up = 1; }; };
                if (up == 0) { if ((d[15] - (byte)48) % (byte)2 == (byte)1) { up = 1; }; };
            };
            if (up == 1)
            {
                k = 15;
                while (k >= 0)
                {
                    if (d[k] == (byte)57) { d[k] = (byte)48; k--; }
                    else { d[k] = d[k] + (byte)1; break; };
                };
                if (k < 0) { d[0] = (byte)49; X = X + 1; };
            };
            nd = 16;
            while (nd > 1) { if (d[nd - 1] == (byte)48) { nd--; } else { break; }; };
            if (X < 0 - 4 | X >= 16)
            {
                out[o] = d[0]; o++;
                if (nd > 1) { out[o] = (byte)46; o++; for (i = 1; i < nd; i++) { out[o] = d[i]; o++; }; };
                out[o] = (byte)101; o++;
                kk = X;
                if (kk < 0) { out[o] = (byte)45; kk = 0 - kk; } else { out[o] = (byte)43; };
                o++;
                en = 0;
                if (kk >= 100) { ex[en] = (byte)(48 + kk / 100); en++; kk = kk % 100; };
                ex[en] = (byte)(48 + kk / 10); en++; ex[en] = (byte)(48 + kk % 10); en++;
                for (i = 0; i < en; i++) { out[o] = ex[i]; o++; };
                out[o] = (byte)0;
                return o;
            };
            if (X >= 0)
            {
                for (i = 0; i <= X; i++) { if (i < nd) { out[o] = d[i]; } else { out[o] = (byte)48; }; o++; };
                if (nd > X + 1) { out[o] = (byte)46; o++; for (i = X + 1; i < nd; i++) { out[o] = d[i]; o++; }; };
                out[o] = (byte)0;
                return o;
            };
            out[o] = (byte)48; o++;
            out[o] = (byte)46; o++;
            for (i = 0; i < 0 - X - 1; i++) { out[o] = (byte)48; o++; };
            for (i = 0; i < nd; i++) { out[o] = d[i]; o++; };
            out[o] = (byte)0;
            return o;
        };

        def sq_p10(int k) -> double
        {
            double r = 1.0;
            double b = 10.0;
            while (k > 0)
            {
                if (k % 2 == 1) { r = r * b; };
                b = b * b;
                k = k / 2;
            };
            return r;
        };

        // Conversion of the decimal digits dg[0..nd) with exponent X of the first digit, the way sqlite3AtoF does it:
        // at most about 19 digits contribute, the rest are dropped.
        def sq_dec2dbl(byte* dg, int nd, int X) -> double
        {
            u64 s, lim;
            int k;
            while (nd > 0)
            {
                if (dg[0] == (byte)48) { dg = @dg[1]; nd--; X--; } else { break; };
            };
            if (nd == 0) { return 0.0; };
            lim = (u64)1844674407370955160;
            s = (u64)0;
            k = 0;
            while (k < nd)
            {
                if (s >= lim) { break; };
                s = s * (u64)10 + (u64)((int)dg[k] - 48);
                k++;
            };
            if (s == (u64)0) { return 0.0; };
            return sq_fp10conv2(s, X - (k - 1));
        };
        // Parses a numeric prefix of text (leading spaces allowed) into an integer or real value.
        def sq_str2num(byte* p, int n, SQ_VAL* o) -> void
        {
            int i = 0;
            int neg = 0;
            int ovf = 0;
            int isreal = 0;
            int fexp = 0;
            int e = 0;
            int eneg = 0;
            int k;
            u64 m = (u64)0;
            double d = 0.0;
            byte[800] dg;
            int ndg = 0;
            int nint = 0;
            while (i < n)
            {
                if (p[i] == (byte)32 | p[i] == (byte)9 | p[i] == (byte)10 | p[i] == (byte)13) { i++; } else { break; };
            };
            if (i < n)
            {
                if (p[i] == (byte)45) { neg = 1; i++; }
                else { if (p[i] == (byte)43) { i++; }; };
            };
            while (i < n)
            {
                if (sq_isdigit(p[i]) == false) { break; };
                if (ovf == 0)
                {
                    if (m > (u64)922337203685477580) { ovf = 1; }
                    else
                    {
                        if (m == (u64)922337203685477580 & (int)p[i] - 48 > 7) { ovf = 1; }
                        else { m = m * (u64)10 + (u64)((int)p[i] - 48); };
                    };
                };
                if (ndg < 780) { dg[ndg] = p[i]; ndg++; };
                nint++;
                i++;
            };
            if (i < n)
            {
                if (p[i] == (byte)46)
                {
                    isreal = 1;
                    i++;
                    while (i < n)
                    {
                        if (sq_isdigit(p[i]) == false) { break; };
                        if (ndg < 780) { dg[ndg] = p[i]; ndg++; };
                        fexp--;
                        i++;
                    };
                };
            };
            if (i < n)
            {
                if (p[i] == (byte)101 | p[i] == (byte)69)
                {
                    k = i + 1;
                    if (k < n)
                    {
                        if (p[k] == (byte)45) { eneg = 1; k++; }
                        else { if (p[k] == (byte)43) { k++; }; };
                    };
                    if (k < n)
                    {
                        if (sq_isdigit(p[k]))
                        {
                            isreal = 1;
                            while (k < n)
                            {
                                if (sq_isdigit(p[k]) == false) { break; };
                                if (e < 10000) { e = e * 10 + ((int)p[k] - 48); };
                                k++;
                            };
                            if (eneg == 1) { e = 0 - e; };
                        };
                    };
                };
            };
            if (isreal == 0 & ovf == 0)
            {
                if (neg == 1) { sq_val_int(o, (i64)0 - (i64)m); } else { sq_val_int(o, (i64)m); };
                return;
            };
            d = sq_dec2dbl(@dg[0], ndg, nint - 1 + e);
            if (neg == 1) { d = 0.0 - d; };
            sq_val_real(o, d);
        };

        // Numeric view of a value (text and blobs are parsed, null stays null).
        def sq_tonum(SQ_VAL* v, SQ_VAL* o) -> void
        {
            if (v.t == SQ_INTEGER | v.t == SQ_REAL) { sq_val_copy(o, v); return; };
            if (v.t == SQ_NULL) { sq_val_null(o); return; };
            sq_str2num(v.p, v.n, o);
        };

        def sq_as_double(SQ_VAL* v) -> double
        {
            SQ_VAL t;
            sq_tonum(v, @t);
            if (t.t == SQ_INTEGER) { return (double)t.i; };
            if (t.t == SQ_REAL) { return t.r; };
            return 0.0;
        };

        // -1 null, 0 false, 1 true
        def sq_truth(SQ_VAL* v) -> int
        {
            SQ_VAL t;
            if (v.t == SQ_NULL) { return 0 - 1; };
            sq_tonum(v, @t);
            if (t.t == SQ_INTEGER) { if (t.i != (i64)0) { return 1; }; return 0; };
            if (t.r != 0.0) { return 1; };
            return 0;
        };

        // Text form of a value allocated from the arena (null stays null).
        def sq_val_text(SQ_ARENA* a, SQ_VAL* v, SQ_VAL* o) -> void
        {
            byte[64] buf;
            int n;
            if (v.t == SQ_NULL) { sq_val_null(o); return; };
            if (v.t == SQ_TEXT) { sq_val_copy(o, v); return; };
            if (v.t == SQ_BLOB)
            {
                o.t = SQ_TEXT; o.n = v.n; o.p = v.p; o.i = (i64)0; o.r = 0.0;
                return;
            };
            if (v.t == SQ_INTEGER) { n = sq_itoa(v.i, @buf[0]); } else { n = sq_real_text(v.r, @buf[0]); };
            o.t = SQ_TEXT; o.n = n; o.i = (i64)0; o.r = 0.0;
            o.p = sq_ar_copy(a, @buf[0], n);
            if ((u64)o.p == (u64)0) { sq_val_null(o); };
        };

        def sq_mem_eq(byte* a, byte* b, int n) -> bool
        {
            int i;
            for (i = 0; i < n; i++) { if (a[i] != b[i]) { return false; }; };
            return true;
        };

        def sq_atoi(byte* p, int n) -> i64
        {
            SQ_VAL v;
            sq_str2num(p, n, @v);
            if (v.t == SQ_INTEGER) { return v.i; };
            return (i64)v.r;
        };

        def sq_utoa(u64 u, byte* buf) -> int
        {
            byte[24] tmp;
            int n = 0;
            int k = 0;
            if (u == (u64)0) { buf[0] = (byte)48; buf[1] = (byte)0; return 1; };
            while (u != (u64)0) { tmp[n] = (byte)(48 + (int)(u % (u64)10)); u = u / (u64)10; n++; };
            while (n > 0) { n--; buf[k] = tmp[n]; k++; };
            buf[k] = (byte)0;
            return k;
        };

        def sq_numtext(byte* p, int n, SQ_VAL* o) -> bool
        {
            int i, e, j, k, digits;
            i = 0;
            e = n;
            while (i < e)
            {
                if (p[i] == (byte)32 | p[i] == (byte)9 | p[i] == (byte)10 | p[i] == (byte)13) { i++; } else { break; };
            };
            while (e > i)
            {
                if (p[e - 1] == (byte)32 | p[e - 1] == (byte)9 | p[e - 1] == (byte)10 | p[e - 1] == (byte)13) { e--; } else { break; };
            };
            if (i >= e) { return false; };
            j = i;
            if (p[j] == (byte)43 | p[j] == (byte)45) { j++; };
            digits = 0;
            while (j < e)
            {
                if (sq_isdigit(p[j])) { j++; digits++; } else { break; };
            };
            if (j < e)
            {
                if (p[j] == (byte)46)
                {
                    j++;
                    while (j < e)
                    {
                        if (sq_isdigit(p[j])) { j++; digits++; } else { break; };
                    };
                };
            };
            if (digits == 0) { return false; };
            if (j < e)
            {
                if (p[j] == (byte)101 | p[j] == (byte)69)
                {
                    j++;
                    if (j < e)
                    {
                        if (p[j] == (byte)43 | p[j] == (byte)45) { j++; };
                    };
                    k = j;
                    while (j < e)
                    {
                        if (sq_isdigit(p[j])) { j++; } else { break; };
                    };
                    if (j == k) { return false; };
                };
            };
            if (j != e) { return false; };
            sq_str2num(@p[i], e - i, o);
            return true;
        };
        def sq_class(SQ_VAL* v) -> int
        {
            if (v.t == SQ_NULL) { return 0; };
            if (v.t == SQ_INTEGER | v.t == SQ_REAL) { return 1; };
            if (v.t == SQ_TEXT) { return 2; };
            return 3;
        };

        // In a UTF-16 database SQLite orders text by the bytes of its UTF-16 form, which differs from UTF-8 order for non-ASCII text.
        def sq_cmp_text16(byte* a, int na, byte* b, int nb, int coll) -> int
        {
            byte* ba;
            byte* bb;
            int la, lb, i, n, r;
            byte x, y;
            la = sq_u8_to_u16(a, na, (byte*)0);
            lb = sq_u8_to_u16(b, nb, (byte*)0);
            ba = (byte*)fmalloc((u64)(la + 1));
            bb = (byte*)fmalloc((u64)(lb + 1));
            if ((u64)ba == (u64)0 | (u64)bb == (u64)0) { if ((u64)ba != (u64)0) { ffree((u64)ba); }; if ((u64)bb != (u64)0) { ffree((u64)bb); }; return 0; };
            sq_u8_to_u16(a, na, ba);
            sq_u8_to_u16(b, nb, bb);
            if (coll == SQC_RTRIM)
            {
                while (la > 0) { if (ba[la - 1] == (byte)32) { la--; } else { break; }; };
                while (lb > 0) { if (bb[lb - 1] == (byte)32) { lb--; } else { break; }; };
            };
            n = la;
            if (lb < n) { n = lb; };
            r = 0;
            for (i = 0; i < n; i++)
            {
                x = ba[i]; y = bb[i];
                if (coll == SQC_NOCASE) { x = sq_lc(x); y = sq_lc(y); };
                if (x != y) { if (x < y) { r = 0 - 1; } else { r = 1; }; break; };
            };
            if (r == 0) { if (la < lb) { r = 0 - 1; }; if (la > lb) { r = 1; }; };
            ffree((u64)ba);
            ffree((u64)bb);
            return r;
        };

        def sq_cmp_text(byte* a, int na, byte* b, int nb, int coll) -> int
        {
            int i, n;
            byte x, y;
            if (SQ_ENC != 1 & coll == 0) { return sq_cmp_text16(a, na, b, nb, coll); };
            if (coll == SQC_RTRIM)
            {
                while (na > 0) { if (a[na - 1] == (byte)32) { na--; } else { break; }; };
                while (nb > 0) { if (b[nb - 1] == (byte)32) { nb--; } else { break; }; };
            };
            n = na;
            if (nb < n) { n = nb; };
            for (i = 0; i < n; i++)
            {
                x = a[i];
                y = b[i];
                if (coll == SQC_NOCASE) { x = sq_lc(x); y = sq_lc(y); };
                if (x != y)
                {
                    if (x < y) { return 0 - 1; };
                    return 1;
                };
            };
            if (na < nb) { return 0 - 1; };
            if (na > nb) { return 1; };
            return 0;
        };

        // SQLite ordering: null < numbers < text < blob; text uses the collation
        def sq_val_cmpc(SQ_VAL* a, SQ_VAL* b, int coll) -> int
        {
            int ca = sq_class(a);
            int cb = sq_class(b);
            double x, y;
            if (ca != cb) { if (ca < cb) { return 0 - 1; }; return 1; };
            if (ca == 0) { return 0; };
            if (ca == 1)
            {
                if (a.t == SQ_INTEGER & b.t == SQ_INTEGER)
                {
                    if (a.i < b.i) { return 0 - 1; };
                    if (a.i > b.i) { return 1; };
                    return 0;
                };
                x = sq_as_double(a);
                y = sq_as_double(b);
                if (x < y) { return 0 - 1; };
                if (x > y) { return 1; };
                return 0;
            };
            if (ca == 3) { return sq_cmp_text(a.p, a.n, b.p, b.n, 9); };
            return sq_cmp_text(a.p, a.n, b.p, b.n, coll);
        };

        def sq_val_cmp(SQ_VAL* a, SQ_VAL* b) -> int
        {
            return sq_val_cmpc(a, b, 0);
        };

        // Applies column affinity (0 none, 1 text, 2 numeric, 3 integer, 4 real) to v.
        def sq_apply_aff(SQ_ARENA* ar, int aff, SQ_VAL* v) -> void
        {
            SQ_VAL t;
            if (v.t == SQ_NULL | aff == 0) { return; };
            if (aff == 1)
            {
                if (v.t == SQ_INTEGER | v.t == SQ_REAL)
                {
                    sq_val_text(ar, v, @t);
                    sq_val_copy(v, @t);
                };
                return;
            };
            if (aff == 4)
            {
                if (v.t == SQ_INTEGER) { sq_val_real(v, (double)v.i); return; };
                if (v.t == SQ_TEXT)
                {
                    if (sq_numtext(v.p, v.n, @t))
                    {
                        if (t.t == SQ_INTEGER) { sq_val_real(v, (double)t.i); } else { sq_val_copy(v, @t); };
                    };
                };
                return;
            };
            if (v.t == SQ_TEXT)
            {
                if (sq_numtext(v.p, v.n, @t)) { sq_val_copy(v, @t); };
            };
            if (v.t == SQ_REAL)
            {
                if (v.r > 0.0 - 9.2e18 & v.r < 9.2e18)
                {
                    if (v.r == (double)((i64)v.r)) { sq_val_int(v, (i64)v.r); };
                };
            };
        };

        // integer prefix of text (spaces, sign, digits); out of range values clamp
        def sq_int_prefix(byte* p, int n, SQ_VAL* o) -> void
        {
            int i = 0;
            int neg = 0;
            u64 m = (u64)0;
            u64 lim;
            int ovf = 0;
            while (i < n)
            {
                if (p[i] == (byte)32 | p[i] == (byte)9 | p[i] == (byte)10 | p[i] == (byte)13) { i++; } else { break; };
            };
            if (i < n)
            {
                if (p[i] == (byte)45) { neg = 1; i++; }
                else { if (p[i] == (byte)43) { i++; }; };
            };
            lim = ((u64)1 << 63) - (u64)1;
            while (i < n)
            {
                if (sq_isdigit(p[i]) == false) { break; };
                if (ovf == 0)
                {
                    if (m > (lim - (u64)((int)p[i] - 48)) / (u64)10) { ovf = 1; }
                    else { m = m * (u64)10 + (u64)((int)p[i] - 48); };
                };
                i++;
            };
            if (ovf == 1)
            {
                if (neg == 1) { sq_val_int(o, (i64)0 - (i64)9223372036854775807 - (i64)1); } else { sq_val_int(o, (i64)9223372036854775807); };
                return;
            };
            if (neg == 1) { sq_val_int(o, (i64)0 - (i64)m); } else { sq_val_int(o, (i64)m); };
        };

        // CAST: ty 0 blob, 1 text, 2 numeric, 3 integer, 4 real
        def sq_cast(SQ_ARENA* ar, SQ_VAL* v, int ty, SQ_VAL* o) -> void
        {
            SQ_VAL t;
            if (v.t == SQ_NULL) { sq_val_null(o); return; };
            if (ty == 1)
            {
                if (v.t == SQ_BLOB & SQ_ENC != 1 & (u64)ar != (u64)0)
                {
                    byte* q = sq_ar_alloc(ar, v.n * 2 + 8);
                    if ((u64)q != (u64)0)
                    {
                        o.n = sq_u16_to_u8(v.p, v.n, q);
                        q[o.n] = (byte)0;
                        o.t = SQ_TEXT; o.p = q; o.i = (i64)0; o.r = 0.0;
                        return;
                    };
                };
                sq_val_text(ar, v, o);
                return;
            };
            if (ty == 0)
            {
                sq_val_text(ar, v, @t);
                if (t.t == SQ_TEXT & SQ_ENC != 1 & (u64)ar != (u64)0)
                {
                    int n16 = sq_u8_to_u16(t.p, t.n, (byte*)0);
                    byte* q2 = sq_ar_alloc(ar, n16 + 1);
                    if ((u64)q2 != (u64)0) { sq_u8_to_u16(t.p, t.n, q2); t.p = q2; t.n = n16; };
                };
                sq_val_copy(o, @t);
                o.t = SQ_BLOB;
                return;
            };
            if (ty == 4) { sq_val_real(o, sq_as_double(v)); return; };
            if (ty == 3 & (v.t == SQ_TEXT | v.t == SQ_BLOB))
            {
                // text converts through its integer prefix only
                sq_int_prefix(v.p, v.n, o);
                return;
            };
            sq_tonum(v, @t);
            if (ty == 3)
            {
                if (t.t == SQ_INTEGER) { sq_val_copy(o, @t); return; };
                if (t.r >= 9.2233720368547758e18) { sq_val_int(o, (i64)9223372036854775807); return; };
                if (t.r <= 0.0 - 9.2233720368547758e18) { sq_val_int(o, (i64)0 - (i64)9223372036854775807 - (i64)1); return; };
                sq_val_int(o, (i64)t.r);
                return;
            };
            // numeric: a real that is a whole number becomes an integer
            sq_val_copy(o, @t);
            sq_apply_aff(ar, 2, o);
        };

        def sq_bitop(int op, SQ_VAL* x, SQ_VAL* y, SQ_VAL* o) -> void
        {
            SQ_VAL a, b;
            i64 p, q;
            int sh;
            if (x.t == SQ_NULL | y.t == SQ_NULL) { sq_val_null(o); return; };
            sq_cast((SQ_ARENA*)0, x, 3, @a);
            sq_cast((SQ_ARENA*)0, y, 3, @b);
            p = a.i;
            q = b.i;
            if (op == SQO_BAND) { sq_val_int(o, (i64)((u64)p `& (u64)q)); return; };
            if (op == SQO_BOR) { sq_val_int(o, (i64)((u64)p | (u64)q)); return; };
            sh = (int)q;
            if (op == SQO_SHR) { sh = 0 - sh; };
            // SQO_SHL: positive shifts left, negative shifts right
            if (sh >= 64) { sq_val_int(o, (i64)0); return; };
            if (sh <= 0 - 64)
            {
                if (p < (i64)0) { sq_val_int(o, (i64)0 - (i64)1); } else { sq_val_int(o, (i64)0); };
                return;
            };
            if (sh >= 0) { sq_val_int(o, (i64)((u64)p << sh)); return; };
            sh = 0 - sh;
            if (p >= (i64)0) { sq_val_int(o, (i64)((u64)p >> sh)); return; };
            sq_val_int(o, (i64)0 - (i64)1 - (i64)(((u64)0 - (u64)p - (u64)1) >> sh));
        };

        def sq_arith(int op, SQ_VAL* x, SQ_VAL* y, SQ_VAL* o) -> void
        {
            SQ_VAL a, b;
            double da, db2;
            i64 r;
            if (x.t == SQ_NULL | y.t == SQ_NULL) { sq_val_null(o); return; };
            sq_tonum(x, @a);
            sq_tonum(y, @b);
            if (a.t == SQ_INTEGER & b.t == SQ_INTEGER)
            {
                if (op == SQO_ADD)
                {
                    r = a.i + b.i;
                    if ((a.i >= (i64)0) == (b.i >= (i64)0) & (r >= (i64)0) != (a.i >= (i64)0)) { sq_val_real(o, (double)a.i + (double)b.i); return; };
                    sq_val_int(o, r);
                    return;
                };
                if (op == SQO_SUB)
                {
                    r = a.i - b.i;
                    if ((a.i >= (i64)0) != (b.i >= (i64)0) & (r >= (i64)0) != (a.i >= (i64)0)) { sq_val_real(o, (double)a.i - (double)b.i); return; };
                    sq_val_int(o, r);
                    return;
                };
                if (op == SQO_MUL)
                {
                    if (a.i == (i64)0 | b.i == (i64)0) { sq_val_int(o, (i64)0); return; };
                    if (a.i == (i64)0 - (i64)1 | b.i == (i64)0 - (i64)1)
                    {
                        r = a.i;
                        if (a.i == (i64)0 - (i64)1) { r = b.i; };
                        if (r == (i64)0 - (i64)9223372036854775807 - (i64)1) { sq_val_real(o, 9223372036854775808.0); return; };
                        sq_val_int(o, (i64)0 - r);
                        return;
                    };
                    r = (i64)((u64)a.i * (u64)b.i);
                    if (r / a.i != b.i) { sq_val_real(o, (double)a.i * (double)b.i); return; };
                    sq_val_int(o, r);
                    return;
                };
                if (b.i == (i64)0) { sq_val_null(o); return; };
                if (b.i == (i64)0 - (i64)1)
                {
                    if (op == SQO_DIV) { sq_val_int(o, (i64)0 - a.i); return; };
                    sq_val_int(o, (i64)0);
                    return;
                };
                if (op == SQO_DIV) { sq_val_int(o, a.i / b.i); return; };
                sq_val_int(o, a.i % b.i);
                return;
            };
            da = sq_as_double(@a);
            db2 = sq_as_double(@b);
            if (op == SQO_ADD) { sq_val_real(o, da + db2); return; };
            if (op == SQO_SUB) { sq_val_real(o, da - db2); return; };
            if (op == SQO_MUL) { sq_val_real(o, da * db2); return; };
            if (op == SQO_DIV)
            {
                if (db2 == 0.0) { sq_val_null(o); return; };
                sq_val_real(o, da / db2);
                return;
            };
            // modulo on reals works on the integer parts
            i64 ia = (i64)da;
            i64 ib = (i64)db2;
            if (ib == (i64)0) { sq_val_null(o); return; };
            if (ib == (i64)0 - (i64)1) { sq_val_real(o, 0.0); return; };
            sq_val_real(o, (double)(ia % ib));
        };

        def sq_utf8_len(byte* p, int n) -> int
        {
            int i, c;
            c = 0;
            for (i = 0; i < n; i++)
            {
                if (p[i] < (byte)128 | p[i] >= (byte)192) { c++; };
            };
            return c;
        };

        // byte offset of character index ci (clamped to n)
        def sq_utf8_off(byte* p, int n, int ci) -> int
        {
            int i = 0;
            int c = 0;
            while (i < n)
            {
                if (p[i] < (byte)128 | p[i] >= (byte)192)
                {
                    if (c == ci) { return i; };
                    c++;
                };
                i++;
            };
            return n;
        };
        // LIKE with optional escape character (esc < 0 when none); ASCII case folding
        def sq_like(byte* p, int pl, byte* s, int sl, int esc) -> bool
        {
            int pi = 0;
            int si = 0;
            int star = 0 - 1;
            int mark = 0;
            int kind, lit, step;
            bool ok;
            while (si < sl)
            {
                ok = false;
                if (pi < pl)
                {
                    kind = 2;
                    lit = (int)p[pi];
                    step = 1;
                    if (esc >= 0 & lit == esc & pi + 1 < pl) { lit = (int)p[pi + 1]; step = 2; }
                    else
                    {
                        if (p[pi] == (byte)37) { kind = 0; };
                        if (p[pi] == (byte)95) { kind = 1; };
                    };
                    if (kind == 0)
                    {
                        star = pi;
                        mark = si;
                        pi++;
                        continue;
                    };
                    if (kind == 1)
                    {
                        pi++;
                        si++;
                        while (si < sl)
                        {
                            if (s[si] >= (byte)128 & s[si] < (byte)192) { si++; } else { break; };
                        };
                        ok = true;
                    }
                    else
                    {
                        if (sq_lc((byte)lit) == sq_lc(s[si])) { pi = pi + step; si++; ok = true; };
                    };
                };
                if (ok == false)
                {
                    if (star >= 0)
                    {
                        pi = star + 1;
                        mark++;
                        si = mark;
                    }
                    else { return false; };
                };
            };
            while (pi < pl)
            {
                if (p[pi] == (byte)37) { pi++; } else { break; };
            };
            return pi == pl;
        };

        // GLOB: * ? [set] [^set], case sensitive
        def sq_glob(byte* p, int pl, byte* s, int sl) -> bool
        {
            int pi = 0;
            int si = 0;
            int star = 0 - 1;
            int mark = 0;
            int j, neg;
            bool ok, hit;
            byte c, lo, hi;
            while (si < sl)
            {
                ok = false;
                if (pi < pl)
                {
                    c = p[pi];
                    if (c == (byte)42)
                    {
                        star = pi;
                        mark = si;
                        pi++;
                        continue;
                    };
                    if (c == (byte)63)
                    {
                        pi++;
                        si++;
                        while (si < sl)
                        {
                            if (s[si] >= (byte)128 & s[si] < (byte)192) { si++; } else { break; };
                        };
                        ok = true;
                    }
                    else
                    {
                        if (c == (byte)91)
                        {
                            j = pi + 1;
                            neg = 0;
                            if (j < pl)
                            {
                                if (p[j] == (byte)94) { neg = 1; j++; };
                            };
                            hit = false;
                            if (j < pl)
                            {
                                // a leading ] is a member
                                if (p[j] == (byte)93)
                                {
                                    if (s[si] == (byte)93) { hit = true; };
                                    j++;
                                };
                            };
                            while (j < pl)
                            {
                                if (p[j] == (byte)93) { break; };
                                lo = p[j];
                                hi = lo;
                                if (j + 2 < pl)
                                {
                                    if (p[j + 1] == (byte)45 & p[j + 2] != (byte)93) { hi = p[j + 2]; j = j + 2; };
                                };
                                if (s[si] >= lo & s[si] <= hi) { hit = true; };
                                j++;
                            };
                            if (j < pl)
                            {
                                if (hit == (neg == 0)) { pi = j + 1; si++; ok = true; };
                            };
                        }
                        else
                        {
                            if (c == s[si]) { pi++; si++; ok = true; };
                        };
                    };
                };
                if (ok == false)
                {
                    if (star >= 0)
                    {
                        pi = star + 1;
                        mark++;
                        si = mark;
                    }
                    else { return false; };
                };
            };
            while (pi < pl)
            {
                if (p[pi] == (byte)42) { pi++; } else { break; };
            };
            return pi == pl;
        };

        def sq_mcpy(byte* d, byte* s, int n) -> void
        {
            int i;
            for (i = 0; i < n; i++) { d[i] = s[i]; };
        };

        struct SQ_NODE
        {
            int kind, op, a, b, c, next, s, sl, col, qs, ql;
            int blk, src, lvl, aff, agg, coll, owner, hasc, win, rblk, oflg;
            i64 iv;
            double rv;
        };

        // column information of a table (or the result columns of a derived source)
        struct SQ_TI
        {
            byte* base;
            int ncols, ipk, autoinc, nchk, npk, nuq, rowid_alias;
            int[128] cs, cl, aff, coll, notnull, pk, uniq, hid, dfs, dfl, chs, chl, ity, gen, gs, gl, ri, tys, tyl;
            int ngen, nrec, wor;
            int[16] pkd, pkcl;
            int[128] rc;
            u64 gst;
            int[16] ks, kl;
            int[16] pkc;
            int[8] uqn;
            int[128] uqc;
            int nix;
            int[8] ixn, ixpk;
            int[64] ixc;
        };

        // rowset: ncols values per row, strings live in the arena
        struct SQ_RS
        {
            int nc, vis, n, cap;
            SQ_VAL* d;
            SQ_ARENA ar;
            // paged result sets: when spon is 1 the rows that no longer fit in memory go to a temporary file. base is the
            // number of the first row held in memory and wn the number of rows read back from the file.
            int spon, base, wn, spsealed;
            void* spf;
            byte* sppath;
            i64 spbytes;
        };

        // window specification of one OVER clause (frame kinds: 0 unbounded preceding, 1 N preceding, 2 current row,
        // 3 N following, 4 unbounded following)
        struct SQ_WIN
        {
            int np, no, ftype, sk, ek, sn, en, excl, hasbase, bs, bl, dns, dnl;
            int[8] part, ord, odesc, onull;
        };

        struct SQ_SRC
        {
            int kind, jt, natural, nusing, on, tbl, root, blk, ts, tl, as_s, as_l, ncols;
            int[16] us, ul, uls, ulc, urc;
            SQ_TI* ti;
            SQLITE_DB* sdb;
            SQ_RS* rs;
            int rs_shared;
            int cte, selfref;
            int ixs_s, ixs_l, idxby;
            int tvf, targ, ntarg, tdef;
            // index scan hints produced by the planner
            int plan, pcol, pexpr, pexpr2, pop, pop2;
        };

        struct SQ_SET
        {
            int nk, n, cap, bsize;
            SQ_VAL* keys;
            int* bucket;
            int* nxt;
            int* hs;
            int isnew;
            int[16] coll;
            SQ_ARENA ar;
        };

        struct SQ_ACC
        {
            i64 n, si;
            double sr, se;
            int isreal, seen, ovf;
            SQ_VAL v;
            byte* gc;
            int gcn, gccap;
            SQ_SET* dset;
            SQ_VAL* ob;
            int obn, obcap;
        };

        struct SQ_GRP
        {
            SQ_VAL* key;
            SQ_ACC* acc;
            int[8] rep;
            SQ_VAL* rep0;
            int hnext, snapd;
        };

        struct SQ_BLK
        {
            int nsrc, nres, distinct, where_n, ngrp, having, nord, limit_n, offset_n;
            int cop, cnext, parent, nagg, has_agg, ncte, bidx, star_cnt, bdone;
            int is_corr, rec, refself, isvals;
            int nwin, wphase, wnent, wcap, wcur, wgrp;
            int[16] winn;
            int* went;
            SQ_VAL* winv;
            SQ_SRC* src;
            int[128] rc, rns, rnl;
            int[16] grp;
            int[16] ord, odesc, ocoll, onull;
            int[32] aggn;
            int[32] wcn, wcl;
            int nwc, nminmax, stream, bare;
            SQ_CURSOR scur;
            // run state
            int[8] cur;
            SQ_ARENA scr;
            SQ_VAL* aggv;
            SQ_RS* out;
            SQ_GRP* groups;
            int ngroups, gcap;
            int* hbuck;
            int hsize;
            SQ_ARENA gar;
            int* hrun;
            int rjmax;
            u64[8] rfl;
            int[4] pad;
        };

        struct SQ_ARM
        {
            SQ_RS* rs;
            SQ_VAL[160] vals;
            i64 skip, lim;
            int count, nres, nkeys, stop, err, sorted;
            SQ_SET dset;
            int use_dset;
        };

        struct SQ_CTE
        {
            int ns, nl, blk, ncols, ncn, rec;
            int[32] cns, cnl;
            SQ_RS* rs;
            SQ_RS* work;
        };

        struct SQ_STMT
        {
            SQLITE_DB* db;
            byte[262144] sql;
            int sqllen, lim;
            // lexer
            int pos, tk, ts, tl, tq, tcode, tend, prevend;
            // syntax tree
            SQ_NODE* nodes;
            int nn, ncap;
            SQ_BLK*[512] blks;
            int nblk, spill;
            SQ_CTE[16] ctes;
            int ncte;
            SQ_WIN[32] wins;
            SQ_WIN[8] wdefs;
            int nwin, nwdef;
            int kind, root_blk, nres, curblk, pcount, bn, wp_s, wp_e;
            // parameters
            int nparam;
            SQ_VAL[64] pv;
            int[64] pns, pnl;
            SQ_ARENA par;
            // execution
            int state, ri;
            SQ_RS* res;
            SQ_ARENA ar;
            int ncols_out;
            i64 last_rowid;
            int changes;
            SQ_VAL[128] out;
            byte[160] err;
            // DML helpers filled by sqlite_write.idk
            int dml_tbl, dml_root;
            int pad;
            // rows produced by RETURNING (kind 3) and the text used to name their columns
            SQ_RS* ret;
            byte* retsql;
            int ret_s, ret_e;
        };

        def sq_seterr(SQ_STMT* st, byte* msg) -> void
        {
            int i = 0;
            if (st.err[0] != (byte)0) { return; };
            while (msg[i] != (byte)0 & i < 150) { st.err[i] = msg[i]; i++; };
            st.err[i] = (byte)0;
        };

        // set while a statement is prepared whose expressions may not contain aggregates (VALUES rows, UPDATE SET)
        global int SQ_NOAGG = 0;

        // the schema name that was written in front of the target of the running statement, if it named an attached database
        global byte[40] SQ_QUAL;
        global int SQ_QUALN = 0;

        // formats "<msg> <name>" where name is st.sql[s..s+l)
        def sq_seterr_n(SQ_STMT* st, byte* msg, int s, int l) -> void
        {
            int i = 0;
            int k;
            if (st.err[0] != (byte)0) { return; };
            while (msg[i] != (byte)0 & i < 120) { st.err[i] = msg[i]; i++; };
            st.err[i] = (byte)58; i++;
            st.err[i] = (byte)32; i++;
            if (SQ_QUALN > 0 & i == 15 & msg[8] == (byte)116 & msg[9] == (byte)97 & msg[10] == (byte)98)
            {
                for (k = 0; k < SQ_QUALN; k++) { st.err[i] = SQ_QUAL[k]; i++; };
                st.err[i] = (byte)46; i++;
            };
            for (k = 0; k < l & i < 158; k++) { st.err[i] = st.sql[s + k]; i++; };
            st.err[i] = (byte)0;
        };


        // "sub-select returns N columns - expected M"
        def sq_seterr_cols(SQ_STMT* st, int got, int want) -> void
        {
            int i = 0;
            int k = 0;
            byte[24] nb;
            byte* m1 = "sub-select returns \0";
            byte* m2 = " columns - expected \0";
            if (st.err[0] != (byte)0) { return; };
            while (m1[k] != (byte)0) { st.err[i] = m1[k]; i++; k++; };
            k = sq_itoa((i64)got, @nb[0]);
            nb[k] = (byte)0;
            k = 0;
            while (nb[k] != (byte)0) { st.err[i] = nb[k]; i++; k++; };
            k = 0;
            while (m2[k] != (byte)0) { st.err[i] = m2[k]; i++; k++; };
            k = sq_itoa((i64)want, @nb[0]);
            nb[k] = (byte)0;
            k = 0;
            while (nb[k] != (byte)0) { st.err[i] = nb[k]; i++; k++; };
            st.err[i] = (byte)0;
        };

        // "IN(...) element has N terms - expected M"
        def sq_seterr_terms(SQ_STMT* st, int got, int want) -> void
        {
            int i = 0;
            int k = 0;
            byte[24] nb;
            byte* m1 = "IN(...) element has \0";
            byte* m2 = " terms - expected \0";
            if (st.err[0] != (byte)0) { return; };
            while (m1[k] != (byte)0) { st.err[i] = m1[k]; i++; k++; };
            k = sq_itoa((i64)got, @nb[0]);
            nb[k] = (byte)0;
            k = 0;
            while (nb[k] != (byte)0) { st.err[i] = nb[k]; i++; k++; };
            k = 0;
            while (m2[k] != (byte)0) { st.err[i] = m2[k]; i++; k++; };
            k = sq_itoa((i64)want, @nb[0]);
            nb[k] = (byte)0;
            k = 0;
            while (nb[k] != (byte)0) { st.err[i] = nb[k]; i++; k++; };
            st.err[i] = (byte)0;
        };

        // "N columns assigned M values"
        def sq_seterr_asg(SQ_STMT* st, int cols, int vals) -> void
        {
            int i = 0;
            int k = 0;
            byte[24] nb;
            byte* m2 = " columns assigned \0";
            byte* m3 = " values\0";
            if (st.err[0] != (byte)0) { return; };
            k = sq_itoa((i64)cols, @nb[0]);
            nb[k] = (byte)0;
            k = 0;
            while (nb[k] != (byte)0) { st.err[i] = nb[k]; i++; k++; };
            k = 0;
            while (m2[k] != (byte)0) { st.err[i] = m2[k]; i++; k++; };
            k = sq_itoa((i64)vals, @nb[0]);
            nb[k] = (byte)0;
            k = 0;
            while (nb[k] != (byte)0) { st.err[i] = nb[k]; i++; k++; };
            k = 0;
            while (m3[k] != (byte)0) { st.err[i] = m3[k]; i++; k++; };
            st.err[i] = (byte)0;
        };

        // element strides in bytes (sizeof counts bits and ignores padding, so the stride is measured)
        def sq_nsz() -> int
        {
            SQ_NODE[2] a;
            return (int)((u64)@a[1] - (u64)@a[0]);
        };

        def sq_vsz() -> int
        {
            SQ_VAL[2] a;
            return (int)((u64)@a[1] - (u64)@a[0]);
        };

        def sq_gsz() -> int
        {
            SQ_GRP[2] a;
            return (int)((u64)@a[1] - (u64)@a[0]);
        };
        // ---- lexer ----

        def sq_next(SQ_STMT* st) -> void
        {
            byte* s = @st.sql[0];
            int i = st.pos;
            int n = st.lim;
            int j;
            byte c, c2;
            st.prevend = st.tend;
            while (i < n)
            {
                c = s[i];
                if (c == (byte)32 | c == (byte)9 | c == (byte)10 | c == (byte)13) { i++; }
                else
                {
                    if (c == (byte)45 & s[i + 1] == (byte)45)
                    {
                        while (i < n & s[i] != (byte)10) { i++; };
                    }
                    else
                    {
                        if (c == (byte)47 & s[i + 1] == (byte)42)
                        {
                            i = i + 2;
                            while (i < n)
                            {
                                if (s[i] == (byte)42 & s[i + 1] == (byte)47) { i = i + 2; break; };
                                i++;
                            };
                        }
                        else { break; };
                    };
                };
            };
            st.ts = i;
            st.tq = 0;
            st.tcode = 0;
            if (i >= n) { st.tk = 0; st.tl = 0; st.tend = i; st.pos = i; return; };
            c = s[i];
            if ((c == (byte)120 | c == (byte)88) & s[i + 1] == (byte)39)
            {
                j = i + 2;
                while (j < n & s[j] != (byte)39) { j++; };
                st.tk = 6; st.ts = i + 2; st.tl = j - i - 2;
                if (j < n) { j++; };
                st.tend = j; st.pos = j;
                return;
            };
            if (sq_isalpha(c))
            {
                j = i;
                while (j < n)
                {
                    if (sq_isalpha(s[j]) | sq_isdigit(s[j]) | s[j] == (byte)36) { j++; } else { break; };
                };
                st.tk = 1; st.tl = j - i; st.tend = j; st.pos = j;
                return;
            };
            if (c == (byte)34 | c == (byte)96 | c == (byte)91)
            {
                c2 = c;
                if (c == (byte)91) { c2 = (byte)93; };
                j = i + 1;
                while (j < n & s[j] != c2) { j++; };
                st.tk = 1; st.tq = 1; st.ts = i + 1; st.tl = j - i - 1;
                if (j < n) { j++; };
                st.tend = j; st.pos = j;
                return;
            };
            if (c == (byte)48 & (s[i + 1] == (byte)120 | s[i + 1] == (byte)88) & sq_ishex(s[i + 2]))
            {
                j = i + 2;
                while (j < n)
                {
                    if (sq_ishex(s[j])) { j++; } else { break; };
                };
                st.tk = 2; st.tl = j - i; st.tend = j; st.pos = j;
                return;
            };
            if (sq_isdigit(c) | (c == (byte)46 & sq_isdigit(s[i + 1])))
            {
                j = i;
                while (j < n)
                {
                    if (sq_isdigit(s[j]) | s[j] == (byte)46) { j++; } else { break; };
                };
                if (j < n)
                {
                    if (s[j] == (byte)101 | s[j] == (byte)69)
                    {
                        c2 = s[j + 1];
                        if (sq_isdigit(c2)) { j = j + 1; while (j < n & sq_isdigit(s[j])) { j++; }; }
                        else
                        {
                            if ((c2 == (byte)43 | c2 == (byte)45) & sq_isdigit(s[j + 2]))
                            {
                                j = j + 2;
                                while (j < n & sq_isdigit(s[j])) { j++; };
                            };
                        };
                    };
                };
                st.tk = 2; st.tl = j - i; st.tend = j; st.pos = j;
                return;
            };
            if (c == (byte)39)
            {
                j = i + 1;
                while (j < n)
                {
                    if (s[j] == (byte)39)
                    {
                        if (s[j + 1] == (byte)39) { j = j + 2; } else { break; };
                    }
                    else { j++; };
                };
                st.tk = 4; st.ts = i + 1; st.tl = j - i - 1;
                if (j < n) { j++; };
                st.tend = j; st.pos = j;
                return;
            };
            if (c == (byte)63 | ((c == (byte)58 | c == (byte)64 | c == (byte)36) & sq_isalpha(s[i + 1])))
            {
                j = i + 1;
                if (c == (byte)63) { while (j < n & sq_isdigit(s[j])) { j++; }; }
                else { while (j < n & (sq_isalpha(s[j]) | sq_isdigit(s[j]))) { j++; }; };
                st.tk = 7; st.tl = j - i; st.tend = j; st.pos = j;
                return;
            };
            st.tk = 5;
            st.tcode = (int)c;
            st.tl = 1;
            c2 = s[i + 1];
            if (c == (byte)60 & c2 == (byte)61) { st.tcode = 76; st.tl = 2; };
            if (c == (byte)62 & c2 == (byte)61) { st.tcode = 71; st.tl = 2; };
            if (c == (byte)60 & c2 == (byte)62) { st.tcode = 78; st.tl = 2; };
            if (c == (byte)33 & c2 == (byte)61) { st.tcode = 78; st.tl = 2; };
            if (c == (byte)61 & c2 == (byte)61) { st.tcode = 61; st.tl = 2; };
            if (c == (byte)124 & c2 == (byte)124) { st.tcode = 67; st.tl = 2; };
            if (c == (byte)60 & c2 == (byte)60) { st.tcode = 80; st.tl = 2; };
            if (c == (byte)62 & c2 == (byte)62) { st.tcode = 81; st.tl = 2; };
            if (c == (byte)45 & c2 == (byte)62)
            {
                st.tcode = 82; st.tl = 2;
                if (s[i + 2] == (byte)62) { st.tcode = 83; st.tl = 3; };
            };
            st.tend = i + st.tl;
            st.pos = i + st.tl;
        };

        def sq_is_op(SQ_STMT* st, int code) -> bool
        {
            return st.tk == 5 & st.tcode == code;
        };

        def sq_is_kw(SQ_STMT* st, byte* kw) -> bool
        {
            if (st.tk != 1 | st.tq != 0) { return false; };
            return sq_ieq(@st.sql[st.ts], st.tl, kw);
        };

        // true when the token after the current one is the operator code
        def sq_peek_op(SQ_STMT* st, int code) -> bool
        {
            int p0 = st.pos, k0 = st.tk, s0 = st.ts, l0 = st.tl, q0 = st.tq, c0 = st.tcode, e0 = st.tend, v0 = st.prevend;
            bool r;
            sq_next(st);
            r = sq_is_op(st, code);
            st.pos = p0; st.tk = k0; st.ts = s0; st.tl = l0; st.tq = q0; st.tcode = c0; st.tend = e0; st.prevend = v0;
            return r;
        };

        def sq_peek_kw(SQ_STMT* st, byte* kw) -> bool
        {
            int p0 = st.pos, k0 = st.tk, s0 = st.ts, l0 = st.tl, q0 = st.tq, c0 = st.tcode, e0 = st.tend, v0 = st.prevend;
            bool r;
            sq_next(st);
            r = sq_is_kw(st, kw);
            st.pos = p0; st.tk = k0; st.ts = s0; st.tl = l0; st.tq = q0; st.tcode = c0; st.tend = e0; st.prevend = v0;
            return r;
        };
        // end of the column definition starting at i: index of a top level ',' or ')'
        def sq_seg_end(byte* s, int i) -> int
        {
            int depth = 0;
            byte c, q;
            while (s[i] != (byte)0)
            {
                c = s[i];
                if (c == (byte)39 | c == (byte)34 | c == (byte)96)
                {
                    q = c;
                    i++;
                    while (s[i] != (byte)0 & s[i] != q) { i++; };
                    if (s[i] != (byte)0) { i++; };
                }
                else
                {
                    if (c == (byte)40) { depth++; };
                    if (c == (byte)41)
                    {
                        if (depth == 0) { return i; };
                        depth--;
                    };
                    if (c == (byte)44 & depth == 0) { return i; };
                    i++;
                };
            };
            return i;
        };

        // Reads the next word in s[i..end). Returns the index after it; ws/wl describe it (wl 0 when none).
        def sq_word(byte* s, int i, int end, int* ws, int* wl) -> int
        {
            byte c, q;
            int j;
            while (i < end)
            {
                if (s[i] == (byte)32 | s[i] == (byte)9 | s[i] == (byte)10 | s[i] == (byte)13) { i++; } else { break; };
            };
            *ws = i;
            *wl = 0;
            if (i >= end) { return i; };
            c = s[i];
            if (c == (byte)34 | c == (byte)96 | c == (byte)91)
            {
                q = c;
                if (c == (byte)91) { q = (byte)93; };
                j = i + 1;
                while (j < end & s[j] != q) { j++; };
                *ws = i + 1;
                *wl = j - i - 1;
                if (j < end) { j++; };
                return j;
            };
            if (sq_isalpha(c) | sq_isdigit(c))
            {
                j = i;
                while (j < end)
                {
                    if (sq_isalpha(s[j]) | sq_isdigit(s[j])) { j++; } else { break; };
                };
                *wl = j - i;
                return j;
            };
            if (c == (byte)40)
            {
                // skip a parenthesised group such as (10,2)
                j = sq_seg_end(s, i + 1);
                *wl = 1;
                if (j < end) { return j + 1; };
                return j;
            };
            *wl = 1;
            return i + 1;
        };

        // true when lowercase literal lit occurs in s[0..n)
        def sq_has(byte* s, int n, byte* lit) -> bool
        {
            int i, k, m;
            m = 0;
            while (lit[m] != (byte)0) { m++; };
            for (i = 0; i + m <= n; i++)
            {
                k = 0;
                while (k < m)
                {
                    if (s[i + k] != lit[k]) { break; };
                    k++;
                };
                if (k == m) { return true; };
            };
            return false;
        };

        // ---- parser: nodes ----

        def sq_newnode(SQ_STMT* st, int kind) -> int
        {
            int n = st.nn;
            SQ_NODE* nw;
            int cap;
            if (n >= st.ncap)
            {
                cap = st.ncap * 2;
                if (cap < 256) { cap = 256; };
                nw = (SQ_NODE*)fmalloc((u64)cap * (u64)sizeof(SQ_NODE));
                if ((u64)nw == (u64)0) { sq_seterr(st, "out of memory\0"); return 0 - 1; };
                if (n > 0) { sq_mcpy((byte*)nw, (byte*)st.nodes, n * sq_nsz()); };
                if ((u64)st.nodes != (u64)0) { ffree((u64)st.nodes); };
                st.nodes = nw;
                st.ncap = cap;
            };
            st.nn = n + 1;
            st.nodes[n].kind = kind;
            st.nodes[n].op = 0;
            st.nodes[n].a = 0 - 1;
            st.nodes[n].b = 0 - 1;
            st.nodes[n].c = 0 - 1;
            st.nodes[n].next = 0 - 1;
            st.nodes[n].s = 0;
            st.nodes[n].sl = 0;
            st.nodes[n].col = 0 - 1;
            st.nodes[n].rblk = 0 - 1;
            st.nodes[n].qs = 0;
            st.nodes[n].ql = 0;
            st.nodes[n].blk = 0 - 1;
            st.nodes[n].src = 0 - 1;
            st.nodes[n].lvl = 0;
            st.nodes[n].aff = 0;
            st.nodes[n].agg = 0 - 1;
            st.nodes[n].coll = 0;
            st.nodes[n].owner = st.curblk;
            st.nodes[n].hasc = 0;
            st.nodes[n].win = 0 - 1;
            st.nodes[n].oflg = 0;
            st.nodes[n].iv = (i64)0;
            st.nodes[n].rv = 0.0;
            return n;
        };

        def sq_stop_word(SQ_STMT* st) -> bool
        {
            if (st.tk != 1 | st.tq != 0) { return false; };
            return sq_is_kw(st, "from\0") | sq_is_kw(st, "where\0") | sq_is_kw(st, "order\0") | sq_is_kw(st, "limit\0") | sq_is_kw(st, "group\0") | sq_is_kw(st, "having\0") | sq_is_kw(st, "union\0") | sq_is_kw(st, "intersect\0") | sq_is_kw(st, "except\0") | sq_is_kw(st, "join\0") | sq_is_kw(st, "natural\0") | sq_is_kw(st, "left\0") | sq_is_kw(st, "right\0") | sq_is_kw(st, "full\0") | sq_is_kw(st, "inner\0") | sq_is_kw(st, "cross\0") | sq_is_kw(st, "on\0") | sq_is_kw(st, "using\0") | sq_is_kw(st, "offset\0") | sq_is_kw(st, "window\0") | sq_is_kw(st, "outer\0") | sq_is_kw(st, "set\0") | sq_is_kw(st, "values\0") | sq_is_kw(st, "returning\0");
        };

        def sq_parse_expr(SQ_STMT* st) -> int;
        def sq_parse_select(SQ_STMT* st, int parent) -> int;

        // type name to a CAST/affinity code: 0 blob, 1 text, 2 numeric, 3 integer, 4 real
        def sq_type_code(byte* p, int n) -> int
        {
            byte[48] ty;
            int i, tn;
            tn = 0;
            for (i = 0; i < n & tn < 46; i++) { ty[tn] = sq_lc(p[i]); tn++; };
            ty[tn] = (byte)0;
            if (sq_has(@ty[0], tn, "int\0")) { return 3; };
            if (sq_has(@ty[0], tn, "char\0") | sq_has(@ty[0], tn, "clob\0") | sq_has(@ty[0], tn, "text\0")) { return 1; };
            if (tn == 0 | sq_has(@ty[0], tn, "blob\0")) { return 0; };
            if (sq_has(@ty[0], tn, "real\0") | sq_has(@ty[0], tn, "floa\0") | sq_has(@ty[0], tn, "doub\0")) { return 4; };
            return 2;
        };

        def sq_coll_id(byte* p, int n) -> int
        {
            if (sq_ieq(p, n, "binary\0")) { return SQC_BINARY; };
            if (sq_ieq(p, n, "nocase\0")) { return SQC_NOCASE; };
            if (sq_ieq(p, n, "rtrim\0")) { return SQC_RTRIM; };
            return 0 - 1;
        };

        def sq_param_node(SQ_STMT* st) -> int
        {
            int n, idx, k, found;
            byte* s = @st.sql[st.ts];
            n = sq_newnode(st, SQN_PARAM);
            if (n < 0) { return n; };
            if (s[0] == (byte)63)
            {
                if (st.tl == 1) { st.pcount++; idx = st.pcount; }
                else { idx = (int)sq_atoi(@s[1], st.tl - 1); if (idx > st.pcount) { st.pcount = idx; }; };
            }
            else
            {
                found = 0;
                idx = 0;
                for (k = 1; k <= st.pcount; k++)
                {
                    if (st.pnl[k - 1] == st.tl)
                    {
                        if (sq_mem_eq(@st.sql[st.pns[k - 1]], s, st.tl)) { found = k; };
                    };
                };
                if (found > 0) { idx = found; }
                else
                {
                    st.pcount++;
                    idx = st.pcount;
                    if (idx <= 64) { st.pns[idx - 1] = st.ts; st.pnl[idx - 1] = st.tl; };
                };
            };
            if (idx < 1 | idx > 64) { sq_seterr(st, "parameter index out of range\0"); return 0 - 1; };
            if (idx > st.nparam) { st.nparam = idx; };
            st.nodes[n].iv = (i64)idx;
            sq_next(st);
            return n;
        };

        // ---- window specifications ----

        def sq_win_init(SQ_WIN* w) -> void
        {
            w.np = 0; w.no = 0; w.ftype = 0; w.sk = 0; w.ek = 2; w.sn = 0 - 1; w.en = 0 - 1; w.excl = 0;
            w.hasbase = 0; w.bs = 0; w.bl = 0; w.dns = 0; w.dnl = 0;
        };

        // frame bound: returns 0 and sets kind/node
        def sq_parse_fbound(SQ_STMT* st, int* kind, int* node) -> int
        {
            int e;
            *node = 0 - 1;
            if (sq_is_kw(st, "unbounded\0"))
            {
                sq_next(st);
                if (sq_is_kw(st, "preceding\0")) { *kind = 0; sq_next(st); return 0; };
                if (sq_is_kw(st, "following\0")) { *kind = 4; sq_next(st); return 0; };
                sq_seterr(st, "expected PRECEDING or FOLLOWING\0");
                return 1;
            };
            if (sq_is_kw(st, "current\0"))
            {
                sq_next(st);
                if (sq_is_kw(st, "row\0") == false) { sq_seterr(st, "expected ROW\0"); return 1; };
                sq_next(st);
                *kind = 2;
                return 0;
            };
            e = sq_parse_expr(st);
            if (e < 0) { return 1; };
            *node = e;
            if (sq_is_kw(st, "preceding\0")) { *kind = 1; sq_next(st); return 0; };
            if (sq_is_kw(st, "following\0")) { *kind = 3; sq_next(st); return 0; };
            sq_seterr(st, "expected PRECEDING or FOLLOWING\0");
            return 1;
        };

        // parses the inside of a window definition, after the opening parenthesis, up to and including the closing one
        def sq_parse_wspec(SQ_STMT* st, SQ_WIN* w) -> int
        {
            int e, k, sk, ek, sn, en;
            if (st.tk == 1 & st.tq == 0 & sq_is_kw(st, "partition\0") == false & sq_is_kw(st, "order\0") == false & sq_is_kw(st, "rows\0") == false & sq_is_kw(st, "range\0") == false & sq_is_kw(st, "groups\0") == false)
            {
                w.hasbase = 1; w.bs = st.ts; w.bl = st.tl;
                sq_next(st);
            };
            if (sq_is_kw(st, "partition\0"))
            {
                sq_next(st);
                if (sq_is_kw(st, "by\0") == false) { sq_seterr(st, "expected BY after PARTITION\0"); return 1; };
                sq_next(st);
                while (true)
                {
                    if (w.np >= 8) { sq_seterr(st, "too many PARTITION BY terms\0"); return 1; };
                    e = sq_parse_expr(st);
                    if (e < 0) { return 1; };
                    w.part[w.np] = e; w.np++;
                    if (sq_is_op(st, 44)) { sq_next(st); } else { break; };
                };
            };
            if (sq_is_kw(st, "order\0"))
            {
                sq_next(st);
                if (sq_is_kw(st, "by\0") == false) { sq_seterr(st, "expected BY after ORDER\0"); return 1; };
                sq_next(st);
                while (true)
                {
                    if (w.no >= 8) { sq_seterr(st, "too many ORDER BY terms\0"); return 1; };
                    e = sq_parse_expr(st);
                    if (e < 0) { return 1; };
                    w.ord[w.no] = e; w.odesc[w.no] = 0; w.onull[w.no] = 0;
                    if (sq_is_kw(st, "asc\0")) { sq_next(st); }
                    else { if (sq_is_kw(st, "desc\0")) { w.odesc[w.no] = 1; sq_next(st); }; };
                    if (sq_is_kw(st, "nulls\0"))
                    {
                        sq_next(st);
                        if (sq_is_kw(st, "first\0")) { w.onull[w.no] = 1; sq_next(st); }
                        else { if (sq_is_kw(st, "last\0")) { w.onull[w.no] = 2; sq_next(st); }; };
                    };
                    w.no++;
                    if (sq_is_op(st, 44)) { sq_next(st); } else { break; };
                };
            };
            k = 0;
            if (sq_is_kw(st, "rows\0")) { k = 1; };
            if (sq_is_kw(st, "range\0")) { k = 2; };
            if (sq_is_kw(st, "groups\0")) { k = 3; };
            if (k > 0)
            {
                sq_next(st);
                w.ftype = k;
                if (sq_is_kw(st, "between\0"))
                {
                    sq_next(st);
                    if (sq_parse_fbound(st, @sk, @sn) != 0) { return 1; };
                    if (sq_is_kw(st, "and\0") == false) { sq_seterr(st, "expected AND in frame\0"); return 1; };
                    sq_next(st);
                    if (sq_parse_fbound(st, @ek, @en) != 0) { return 1; };
                }
                else
                {
                    if (sq_parse_fbound(st, @sk, @sn) != 0) { return 1; };
                    ek = 2; en = 0 - 1;
                };
                w.sk = sk; w.sn = sn; w.ek = ek; w.en = en;
                if (sq_is_kw(st, "exclude\0"))
                {
                    sq_next(st);
                    if (sq_is_kw(st, "no\0")) { sq_next(st); if (sq_is_kw(st, "others\0") == false) { sq_seterr(st, "expected OTHERS\0"); return 1; }; sq_next(st); w.excl = 0; }
                    else
                    {
                        if (sq_is_kw(st, "current\0")) { sq_next(st); if (sq_is_kw(st, "row\0") == false) { sq_seterr(st, "expected ROW\0"); return 1; }; sq_next(st); w.excl = 1; }
                        else
                        {
                            if (sq_is_kw(st, "group\0")) { sq_next(st); w.excl = 2; }
                            else
                            {
                                if (sq_is_kw(st, "ties\0")) { sq_next(st); w.excl = 3; }
                                else { sq_seterr(st, "expected NO OTHERS, CURRENT ROW, GROUP or TIES\0"); return 1; };
                            };
                        };
                    };
                };
            };
            if (sq_is_op(st, 41) == false) { sq_seterr(st, "expected ) after window definition\0"); return 1; };
            sq_next(st);
            return 0;
        };

        // after a function call: optional FILTER (WHERE ..) and OVER window
        def sq_parse_over(SQ_STMT* st, int n) -> int
        {
            int e, wi;
            SQ_WIN* w;
            if (sq_is_kw(st, "filter\0"))
            {
                sq_next(st);
                if (sq_is_op(st, 40) == false) { sq_seterr(st, "expected ( after FILTER\0"); return 0 - 1; };
                sq_next(st);
                if (sq_is_kw(st, "where\0") == false) { sq_seterr(st, "expected WHERE in FILTER\0"); return 0 - 1; };
                sq_next(st);
                e = sq_parse_expr(st);
                if (e < 0) { return e; };
                if (sq_is_op(st, 41) == false) { sq_seterr(st, "expected ) after FILTER\0"); return 0 - 1; };
                sq_next(st);
                st.nodes[n].c = e;
            };
            if (sq_is_kw(st, "over\0"))
            {
                sq_next(st);
                if (st.nwin >= 32) { sq_seterr(st, "too many window functions\0"); return 0 - 1; };
                wi = st.nwin;
                st.nwin++;
                w = @st.wins[wi];
                sq_win_init(w);
                if (sq_is_op(st, 40))
                {
                    sq_next(st);
                    if (sq_parse_wspec(st, w) != 0) { return 0 - 1; };
                }
                else
                {
                    if (st.tk != 1) { sq_seterr(st, "expected window name or definition after OVER\0"); return 0 - 1; };
                    w.hasbase = 1; w.bs = st.ts; w.bl = st.tl;
                    w.ftype = 0 - 1;
                    sq_next(st);
                };
                st.nodes[n].win = wi;
            };
            return n;
        };

        def sq_parse_case(SQ_STMT* st) -> int
        {
            int n, w, last, c, r;
            n = sq_newnode(st, SQN_CASE);
            if (n < 0) { return n; };
            sq_next(st);
            if (sq_is_kw(st, "when\0") == false)
            {
                c = sq_parse_expr(st);
                if (c < 0) { return c; };
                st.nodes[n].a = c;
            };
            last = 0 - 1;
            while (sq_is_kw(st, "when\0"))
            {
                sq_next(st);
                c = sq_parse_expr(st);
                if (c < 0) { return c; };
                if (sq_is_kw(st, "then\0") == false) { sq_seterr(st, "expected THEN\0"); return 0 - 1; };
                sq_next(st);
                r = sq_parse_expr(st);
                if (r < 0) { return r; };
                w = sq_newnode(st, SQN_WHEN);
                if (w < 0) { return w; };
                st.nodes[w].a = c;
                st.nodes[w].b = r;
                if (last < 0) { st.nodes[n].b = w; } else { st.nodes[last].next = w; };
                last = w;
            };
            if (last < 0) { sq_seterr(st, "CASE needs a WHEN\0"); return 0 - 1; };
            if (sq_is_kw(st, "else\0"))
            {
                sq_next(st);
                r = sq_parse_expr(st);
                if (r < 0) { return r; };
                st.nodes[n].c = r;
            };
            if (sq_is_kw(st, "end\0") == false) { sq_seterr(st, "expected END\0"); return 0 - 1; };
            sq_next(st);
            return n;
        };

        def sq_parse_primary(SQ_STMT* st) -> int
        {
            int n, a, last, argc, b, ts0, tl0, rw, rl;
            SQ_VAL v;
            if (st.tk == 2)
            {
                if (st.tl > 2 & st.sql[st.ts] == (byte)48 & (st.sql[st.ts + 1] == (byte)120 | st.sql[st.ts + 1] == (byte)88))
                {
                    if (st.tl > 18) { sq_seterr(st, "hex literal too big\0"); return 0 - 1; };
                    n = sq_newnode(st, SQN_INT);
                    if (n < 0) { return n; };
                    st.nodes[n].iv = (i64)sq_hexval(@st.sql[st.ts + 2], st.tl - 2);
                    sq_next(st);
                    return n;
                };
                sq_str2num(@st.sql[st.ts], st.tl, @v);
                if (v.t == SQ_INTEGER) { n = sq_newnode(st, SQN_INT); if (n < 0) { return n; }; st.nodes[n].iv = v.i; }
                else { n = sq_newnode(st, SQN_REAL); if (n < 0) { return n; }; st.nodes[n].rv = v.r; st.nodes[n].s = st.ts; st.nodes[n].sl = st.tl; };
                sq_next(st);
                return n;
            };
            if (st.tk == 4)
            {
                n = sq_newnode(st, SQN_STR);
                if (n < 0) { return n; };
                st.nodes[n].s = st.ts;
                st.nodes[n].sl = st.tl;
                sq_next(st);
                return n;
            };
            if (st.tk == 6)
            {
                n = sq_newnode(st, SQN_BLOB);
                if (n < 0) { return n; };
                st.nodes[n].s = st.ts;
                st.nodes[n].sl = st.tl;
                sq_next(st);
                return n;
            };
            if (st.tk == 7) { return sq_param_node(st); };
            if (sq_is_op(st, 40))
            {
                sq_next(st);
                if (sq_is_kw(st, "select\0") | sq_is_kw(st, "with\0") | sq_is_kw(st, "values\0"))
                {
                    n = sq_newnode(st, SQN_SUBQ);
                    if (n < 0) { return n; };
                    b = sq_parse_select(st, st.curblk);
                    if (b < 0) { return 0 - 1; };
                    st.nodes[n].blk = b;
                    if (sq_is_op(st, 41) == false) { sq_seterr(st, "expected ) after subquery\0"); return 0 - 1; };
                    sq_next(st);
                    return n;
                };
                n = sq_parse_expr(st);
                if (n < 0) { return n; };
                if (sq_is_op(st, 44))
                {
                    rw = sq_newnode(st, SQN_ROW);
                    if (rw < 0) { return rw; };
                    st.nodes[rw].a = n;
                    st.nodes[rw].iv = (i64)1;
                    rl = n;
                    while (sq_is_op(st, 44))
                    {
                        sq_next(st);
                        n = sq_parse_expr(st);
                        if (n < 0) { return n; };
                        st.nodes[rl].next = n;
                        rl = n;
                        st.nodes[rw].iv = st.nodes[rw].iv + (i64)1;
                    };
                    n = rw;
                };
                if (sq_is_op(st, 41) == false) { sq_seterr(st, "expected )\0"); return 0 - 1; };
                sq_next(st);
                return n;
            };
            if (st.tk == 1)
            {
                if (st.tq == 0)
                {
                    if (sq_is_kw(st, "__subcol\0"))
                    {
                        // internal: __subcol(N, select ...) yields column N of a scalar subquery
                        sq_next(st);
                        if (sq_is_op(st, 40) == false) { sq_seterr(st, "expected (\0"); return 0 - 1; };
                        sq_next(st);
                        if (st.tk != 2) { sq_seterr(st, "expected column number\0"); return 0 - 1; };
                        a = (int)sq_atoi(@st.sql[st.ts], st.tl);
                        sq_next(st);
                        if (sq_is_op(st, 44) == false) { sq_seterr(st, "expected ,\0"); return 0 - 1; };
                        sq_next(st);
                        if (st.tk != 2) { sq_seterr(st, "expected column count\0"); return 0 - 1; };
                        last = (int)sq_atoi(@st.sql[st.ts], st.tl);
                        sq_next(st);
                        if (sq_is_op(st, 44) == false) { sq_seterr(st, "expected ,\0"); return 0 - 1; };
                        sq_next(st);
                        n = sq_newnode(st, SQN_SUBQ);
                        if (n < 0) { return n; };
                        st.nodes[n].op = last;
                        b = sq_parse_select(st, st.curblk);
                        if (b < 0) { return 0 - 1; };
                        st.nodes[n].blk = b;
                        st.nodes[n].iv = (i64)a;
                        if (sq_is_op(st, 41) == false) { sq_seterr(st, "expected )\0"); return 0 - 1; };
                        sq_next(st);
                        return n;
                    };
                    if (sq_is_kw(st, "raise\0") & sq_peek_op(st, 40))
                    {
                        // RAISE(IGNORE) or RAISE(ROLLBACK | ABORT | FAIL, message)
                        n = sq_newnode(st, SQN_FUNC);
                        if (n < 0) { return n; };
                        st.nodes[n].s = st.ts;
                        st.nodes[n].sl = st.tl;
                        sq_next(st);
                        sq_next(st);
                        argc = 0;
                        if (sq_is_kw(st, "ignore\0")) { argc = 1; }
                        else
                        {
                            if (sq_is_kw(st, "rollback\0")) { argc = 2; }
                            else
                            {
                                if (sq_is_kw(st, "abort\0")) { argc = 3; }
                                else
                                {
                                    if (sq_is_kw(st, "fail\0")) { argc = 4; }
                                    else { sq_seterr(st, "syntax error\0"); return 0 - 1; };
                                };
                            };
                        };
                        st.nodes[n].qs = argc;
                        sq_next(st);
                        st.nodes[n].iv = (i64)0;
                        if (argc != 1)
                        {
                            if (sq_is_op(st, 44) == false) { sq_seterr(st, "syntax error\0"); return 0 - 1; };
                            sq_next(st);
                            a = sq_parse_expr(st);
                            if (a < 0) { return a; };
                            st.nodes[n].a = a;
                            st.nodes[n].iv = (i64)1;
                        };
                        if (sq_is_op(st, 41) == false) { sq_seterr(st, "syntax error\0"); return 0 - 1; };
                        sq_next(st);
                        return n;
                    };
                    if (sq_is_kw(st, "null\0")) { n = sq_newnode(st, SQN_NULL); sq_next(st); return n; };
                    if (sq_is_kw(st, "true\0")) { n = sq_newnode(st, SQN_INT); if (n < 0) { return n; }; st.nodes[n].iv = (i64)1; sq_next(st); return n; };
                    if (sq_is_kw(st, "false\0")) { n = sq_newnode(st, SQN_INT); if (n < 0) { return n; }; st.nodes[n].iv = (i64)0; sq_next(st); return n; };
                    if (sq_is_kw(st, "case\0")) { return sq_parse_case(st); };
                    if (sq_is_kw(st, "exists\0") & sq_peek_op(st, 40))
                    {
                        sq_next(st);
                        sq_next(st);
                        n = sq_newnode(st, SQN_EXISTS);
                        if (n < 0) { return n; };
                        b = sq_parse_select(st, st.curblk);
                        if (b < 0) { return 0 - 1; };
                        st.nodes[n].blk = b;
                        if (sq_is_op(st, 41) == false) { sq_seterr(st, "expected ) after EXISTS\0"); return 0 - 1; };
                        sq_next(st);
                        return n;
                    };
                    if (sq_is_kw(st, "cast\0") & sq_peek_op(st, 40))
                    {
                        sq_next(st);
                        sq_next(st);
                        n = sq_newnode(st, SQN_CAST);
                        if (n < 0) { return n; };
                        a = sq_parse_expr(st);
                        if (a < 0) { return a; };
                        st.nodes[n].a = a;
                        if (sq_is_kw(st, "as\0") == false) { sq_seterr(st, "expected AS in CAST\0"); return 0 - 1; };
                        sq_next(st);
                        ts0 = st.ts;
                        tl0 = 0;
                        while (st.tk == 1)
                        {
                            tl0 = st.tend - ts0;
                            sq_next(st);
                        };
                        if (sq_is_op(st, 40))
                        {
                            while (sq_is_op(st, 41) == false & st.tk != 0) { sq_next(st); };
                            sq_next(st);
                        };
                        st.nodes[n].iv = (i64)sq_type_code(@st.sql[ts0], tl0);
                        if (sq_is_op(st, 41) == false) { sq_seterr(st, "expected ) after CAST\0"); return 0 - 1; };
                        sq_next(st);
                        return n;
                    };
                    if (sq_is_kw(st, "current_timestamp\0") | sq_is_kw(st, "current_date\0") | sq_is_kw(st, "current_time\0"))
                    {
                        n = sq_newnode(st, SQN_FUNC);
                        if (n < 0) { return n; };
                        st.nodes[n].s = st.ts;
                        st.nodes[n].sl = st.tl;
                        sq_next(st);
                        return n;
                    };
                };
                n = sq_newnode(st, SQN_COL);
                if (n < 0) { return n; };
                st.nodes[n].s = st.ts;
                st.nodes[n].sl = st.tl;
                if (sq_peek_op(st, 40) & st.tq == 0)
                {
                    st.nodes[n].kind = SQN_FUNC;
                    sq_next(st);
                    sq_next(st);
                    last = 0 - 1;
                    argc = 0;
                    if (sq_is_kw(st, "distinct\0")) { st.nodes[n].op = 1; sq_next(st); };
                    if (sq_is_op(st, 42))
                    {
                        st.nodes[n].op = 2;
                        sq_next(st);
                    }
                    else
                    {
                        if (sq_is_op(st, 41) == false)
                        {
                            while (true)
                            {
                                a = sq_parse_expr(st);
                                if (a < 0) { return a; };
                                if (last < 0) { st.nodes[n].a = a; } else { st.nodes[last].next = a; };
                                last = a;
                                argc++;
                                if (sq_is_op(st, 44)) { sq_next(st); } else { break; };
                            };
                        };
                    };
                    if (st.nodes[n].op != 2 & sq_is_kw(st, "order\0") & sq_peek_kw(st, "by\0"))
                    {
                        sq_next(st);
                        sq_next(st);
                        last = 0 - 1;
                        while (true)
                        {
                            a = sq_parse_expr(st);
                            if (a < 0) { return a; };
                            if (sq_is_kw(st, "asc\0")) { sq_next(st); }
                            else { if (sq_is_kw(st, "desc\0")) { st.nodes[a].oflg = st.nodes[a].oflg | 1; sq_next(st); }; };
                            if (sq_is_kw(st, "nulls\0"))
                            {
                                sq_next(st);
                                if (sq_is_kw(st, "first\0")) { st.nodes[a].oflg = st.nodes[a].oflg | 2; sq_next(st); }
                                else
                                {
                                    if (sq_is_kw(st, "last\0")) { st.nodes[a].oflg = st.nodes[a].oflg | 4; sq_next(st); }
                                    else { sq_seterr(st, "syntax error\0"); return 0 - 1; };
                                };
                            };
                            if (last < 0) { st.nodes[n].b = a; } else { st.nodes[last].next = a; };
                            last = a;
                            if (sq_is_op(st, 44)) { sq_next(st); } else { break; };
                        };
                    };
                    if (sq_is_op(st, 41) == false) { sq_seterr(st, "expected ) after function arguments\0"); return 0 - 1; };
                    sq_next(st);
                    st.nodes[n].iv = (i64)argc;
                    return sq_parse_over(st, n);
                };
                sq_next(st);
                if (sq_is_op(st, 46))
                {
                    sq_next(st);
                    if (st.tk != 1) { sq_seterr(st, "expected column name after .\0"); return 0 - 1; };
                    st.nodes[n].qs = st.nodes[n].s;
                    st.nodes[n].ql = st.nodes[n].sl;
                    st.nodes[n].s = st.ts;
                    st.nodes[n].sl = st.tl;
                    sq_next(st);
                    if (sq_is_op(st, 46))
                    {
                        // schema.table.column: the first part is the schema name
                        sq_next(st);
                        if (st.tk != 1) { sq_seterr(st, "expected column name after .\0"); return 0 - 1; };
                        st.nodes[n].qs = st.nodes[n].s;
                        st.nodes[n].ql = st.nodes[n].sl;
                        st.nodes[n].s = st.ts;
                        st.nodes[n].sl = st.tl;
                        sq_next(st);
                    };
                };
                return n;
            };
            sq_seterr(st, "syntax error in expression\0");
            return 0 - 1;
        };

        def sq_parse_unary(SQ_STMT* st) -> int
        {
            int n, a;
            if (sq_is_op(st, 45))
            {
                sq_next(st);
                a = sq_parse_unary(st);
                if (a < 0) { return a; };
                if (st.nodes[a].kind == SQN_INT)
                {
                    if (st.nodes[a].iv == (i64)0 - (i64)9223372036854775807 - (i64)1)
                    {
                        st.nodes[a].kind = SQN_REAL;
                        st.nodes[a].rv = 9223372036854775808.0;
                        return a;
                    };
                    st.nodes[a].iv = (i64)0 - st.nodes[a].iv;
                    return a;
                };
                if (st.nodes[a].kind == SQN_REAL)
                {
                    // the one integer literal that only fits when negated
                    if (st.nodes[a].sl == 19)
                    {
                        if (sq_ieq(@st.sql[st.nodes[a].s], 19, "9223372036854775808\0"))
                        {
                            st.nodes[a].kind = SQN_INT;
                            st.nodes[a].iv = (i64)0 - (i64)9223372036854775807 - (i64)1;
                            return a;
                        };
                    };
                    st.nodes[a].rv = 0.0 - st.nodes[a].rv;
                    return a;
                };
                n = sq_newnode(st, SQN_UNARY);
                if (n < 0) { return n; };
                st.nodes[n].op = 1;
                st.nodes[n].a = a;
                return n;
            };
            if (sq_is_op(st, 43))
            {
                sq_next(st);
                a = sq_parse_unary(st);
                if (a < 0) { return a; };
                if (st.nodes[a].kind == SQN_INT | st.nodes[a].kind == SQN_REAL) { return a; };
                n = sq_newnode(st, SQN_UNARY);
                if (n < 0) { return n; };
                st.nodes[n].op = 4;
                st.nodes[n].a = a;
                return n;
            };
            if (sq_is_op(st, 126))
            {
                sq_next(st);
                a = sq_parse_unary(st);
                if (a < 0) { return a; };
                n = sq_newnode(st, SQN_UNARY);
                if (n < 0) { return n; };
                st.nodes[n].op = 3;
                st.nodes[n].a = a;
                return n;
            };
            a = sq_parse_primary(st);
            if (a < 0) { return a; };
            while (sq_is_kw(st, "collate\0"))
            {
                sq_next(st);
                if (st.tk != 1) { sq_seterr(st, "expected collation name\0"); return 0 - 1; };
                n = sq_newnode(st, SQN_COLLATE);
                if (n < 0) { return n; };
                st.nodes[n].iv = (i64)sq_coll_id(@st.sql[st.ts], st.tl);
                if (st.nodes[n].iv < (i64)0) { sq_seterr_n(st, "no such collation sequence\0", st.ts, st.tl); return 0 - 1; };
                st.nodes[n].a = a;
                sq_next(st);
                a = n;
            };
            return a;
        };

        def sq_mkbin_raw(SQ_STMT* st, int op, int a, int b) -> int
        {
            int n = sq_newnode(st, SQN_BIN);
            if (n < 0) { return n; };
            st.nodes[n].op = op;
            st.nodes[n].a = a;
            st.nodes[n].b = b;
            return n;
        };

        // row value comparison, expanded into per-element comparisons
        def sq_mkbin(SQ_STMT* st, int op, int a, int b) -> int
        {
            int i, cnt, acc, t, u, ea, eb, strict, last;
            int[16] ia, ib;
            if (st.nodes[a].kind != SQN_ROW & st.nodes[b].kind != SQN_ROW) { return sq_mkbin_raw(st, op, a, b); };
            if (st.nodes[a].kind != SQN_ROW | st.nodes[b].kind != SQN_ROW | st.nodes[a].iv != st.nodes[b].iv | st.nodes[a].iv > (i64)16
                | op < SQO_EQ | op > SQO_GE | op == SQO_AND | op == SQO_OR)
            {
                sq_seterr(st, "row value misused\0");
                return 0 - 1;
            };
            cnt = (int)st.nodes[a].iv;
            ea = st.nodes[a].a;
            eb = st.nodes[b].a;
            for (i = 0; i < cnt; i++)
            {
                ia[i] = ea;
                ib[i] = eb;
                ea = st.nodes[ea].next;
                eb = st.nodes[eb].next;
            };
            st.nodes[a].op = 1;
            st.nodes[b].op = 1;
            if (op == SQO_EQ | op == SQO_NE)
            {
                acc = sq_mkbin_raw(st, op, ia[cnt - 1], ib[cnt - 1]);
                if (acc < 0) { return acc; };
                for (i = cnt - 2; i >= 0; i--)
                {
                    t = sq_mkbin_raw(st, op, ia[i], ib[i]);
                    if (t < 0) { return t; };
                    if (op == SQO_EQ) { acc = sq_mkbin_raw(st, SQO_AND, t, acc); } else { acc = sq_mkbin_raw(st, SQO_OR, t, acc); };
                    if (acc < 0) { return acc; };
                };
                return acc;
            };
            strict = SQO_LT;
            if (op == SQO_GT | op == SQO_GE) { strict = SQO_GT; };
            acc = sq_mkbin_raw(st, op, ia[cnt - 1], ib[cnt - 1]);
            if (acc < 0) { return acc; };
            for (i = cnt - 2; i >= 0; i--)
            {
                t = sq_mkbin_raw(st, strict, ia[i], ib[i]);
                u = sq_mkbin_raw(st, SQO_EQ, ia[i], ib[i]);
                if (t < 0 | u < 0) { return 0 - 1; };
                u = sq_mkbin_raw(st, SQO_AND, u, acc);
                if (u < 0) { return u; };
                acc = sq_mkbin_raw(st, SQO_OR, t, u);
                if (acc < 0) { return acc; };
            };
            return acc;
        };

        def sq_parse_concat(SQ_STMT* st) -> int
        {
            int a, b, ts1, tl1, n1;
            a = sq_parse_unary(st);
            if (a < 0) { return a; };
            while (sq_is_op(st, 67) | sq_is_op(st, 82) | sq_is_op(st, 83))
            {
                if (sq_is_op(st, 67))
                {
                    sq_next(st);
                    b = sq_parse_unary(st);
                    if (b < 0) { return b; };
                    a = sq_mkbin(st, SQO_CAT, a, b);
                    if (a < 0) { return a; };
                }
                else
                {
                    ts1 = st.ts; tl1 = st.tl;
                    sq_next(st);
                    b = sq_parse_unary(st);
                    if (b < 0) { return b; };
                    n1 = sq_newnode(st, SQN_FUNC);
                    if (n1 < 0) { return n1; };
                    st.nodes[n1].s = ts1;
                    st.nodes[n1].sl = tl1;
                    st.nodes[n1].a = a;
                    st.nodes[a].next = b;
                    st.nodes[n1].iv = (i64)2;
                    a = n1;
                };
            };
            return a;
        };

        def sq_parse_mul(SQ_STMT* st) -> int
        {
            int a, b, op;
            a = sq_parse_concat(st);
            if (a < 0) { return a; };
            while (sq_is_op(st, 42) | sq_is_op(st, 47) | sq_is_op(st, 37))
            {
                op = SQO_MUL;
                if (sq_is_op(st, 47)) { op = SQO_DIV; };
                if (sq_is_op(st, 37)) { op = SQO_MOD; };
                sq_next(st);
                b = sq_parse_concat(st);
                if (b < 0) { return b; };
                a = sq_mkbin(st, op, a, b);
                if (a < 0) { return a; };
            };
            return a;
        };

        def sq_parse_add(SQ_STMT* st) -> int
        {
            int a, b, op;
            a = sq_parse_mul(st);
            if (a < 0) { return a; };
            while (sq_is_op(st, 43) | sq_is_op(st, 45))
            {
                op = SQO_ADD;
                if (sq_is_op(st, 45)) { op = SQO_SUB; };
                sq_next(st);
                b = sq_parse_mul(st);
                if (b < 0) { return b; };
                a = sq_mkbin(st, op, a, b);
                if (a < 0) { return a; };
            };
            return a;
        };

        def sq_parse_bit(SQ_STMT* st) -> int
        {
            int a, b, op;
            a = sq_parse_add(st);
            if (a < 0) { return a; };
            while (sq_is_op(st, 38) | sq_is_op(st, 124) | sq_is_op(st, 80) | sq_is_op(st, 81))
            {
                op = SQO_BAND;
                if (sq_is_op(st, 124)) { op = SQO_BOR; };
                if (sq_is_op(st, 80)) { op = SQO_SHL; };
                if (sq_is_op(st, 81)) { op = SQO_SHR; };
                sq_next(st);
                b = sq_parse_add(st);
                if (b < 0) { return b; };
                a = sq_mkbin(st, op, a, b);
                if (a < 0) { return a; };
            };
            return a;
        };

        def sq_parse_cmp(SQ_STMT* st) -> int
        {
            int a, b, op;
            a = sq_parse_bit(st);
            if (a < 0) { return a; };
            while (sq_is_op(st, 60) | sq_is_op(st, 62) | sq_is_op(st, 76) | sq_is_op(st, 71))
            {
                op = SQO_LT;
                if (sq_is_op(st, 76)) { op = SQO_LE; };
                if (sq_is_op(st, 62)) { op = SQO_GT; };
                if (sq_is_op(st, 71)) { op = SQO_GE; };
                sq_next(st);
                b = sq_parse_bit(st);
                if (b < 0) { return b; };
                a = sq_mkbin(st, op, a, b);
                if (a < 0) { return a; };
            };
            return a;
        };

        def sq_parse_eq(SQ_STMT* st) -> int
        {
            int a, b, c, n, op, neg, last, esc, isglob;
            a = sq_parse_cmp(st);
            if (a < 0) { return a; };
            while (true)
            {
                if (sq_is_op(st, 61) | sq_is_op(st, 78))
                {
                    op = SQO_EQ;
                    if (sq_is_op(st, 78)) { op = SQO_NE; };
                    sq_next(st);
                    b = sq_parse_cmp(st);
                    if (b < 0) { return b; };
                    a = sq_mkbin(st, op, a, b);
                    if (a < 0) { return a; };
                }
                else
                {
                    neg = 1;
                    if (sq_is_kw(st, "isnull\0"))
                    {
                        sq_next(st);
                        n = sq_newnode(st, SQN_ISNULL);
                        if (n < 0) { return n; };
                        st.nodes[n].op = 1;
                        st.nodes[n].a = a;
                        a = n;
                    }
                    else
                    {
                        if (sq_is_kw(st, "notnull\0"))
                        {
                            sq_next(st);
                            n = sq_newnode(st, SQN_ISNULL);
                            if (n < 0) { return n; };
                            st.nodes[n].op = 2;
                            st.nodes[n].a = a;
                            a = n;
                        }
                        else
                        {
                            if (sq_is_kw(st, "is\0"))
                            {
                                sq_next(st);
                                op = SQO_IS;
                                if (sq_is_kw(st, "not\0")) { op = SQO_ISNOT; sq_next(st); };
                                if (sq_is_kw(st, "null\0"))
                                {
                                    sq_next(st);
                                    n = sq_newnode(st, SQN_ISNULL);
                                    if (n < 0) { return n; };
                                    st.nodes[n].op = 1;
                                    if (op == SQO_ISNOT) { st.nodes[n].op = 2; };
                                    st.nodes[n].a = a;
                                    a = n;
                                }
                                else
                                {
                                    b = sq_parse_cmp(st);
                                    if (b < 0) { return b; };
                                    a = sq_mkbin(st, op, a, b);
                                    if (a < 0) { return a; };
                                };
                            }
                            else
                            {
                                if (sq_is_kw(st, "not\0"))
                                {
                                    if (sq_peek_kw(st, "in\0") | sq_peek_kw(st, "like\0") | sq_peek_kw(st, "glob\0") | sq_peek_kw(st, "between\0") | sq_peek_kw(st, "null\0"))
                                    {
                                        neg = 2;
                                        sq_next(st);
                                    }
                                    else { break; };
                                };
                                if (sq_is_kw(st, "null\0") & neg == 2)
                                {
                                    sq_next(st);
                                    n = sq_newnode(st, SQN_ISNULL);
                                    if (n < 0) { return n; };
                                    st.nodes[n].op = 2;
                                    st.nodes[n].a = a;
                                    a = n;
                                }
                                else
                                {
                                    if (sq_is_kw(st, "in\0"))
                                    {
                                        sq_next(st);
                                        if (sq_is_op(st, 40) == false) { sq_seterr(st, "expected ( after IN\0"); return 0 - 1; };
                                        sq_next(st);
                                        n = sq_newnode(st, SQN_IN);
                                        if (n < 0) { return n; };
                                        st.nodes[n].op = neg;
                                        st.nodes[n].a = a;
                                        if (st.nodes[a].kind == SQN_ROW) { st.nodes[a].op = 1; };
                                        if (sq_is_kw(st, "select\0") | sq_is_kw(st, "with\0") | sq_is_kw(st, "values\0"))
                                        {
                                            b = sq_parse_select(st, st.curblk);
                                            if (b < 0) { return 0 - 1; };
                                            st.nodes[n].blk = b;
                                        }
                                        else
                                        {
                                            last = 0 - 1;
                                            if (sq_is_op(st, 41) == false)
                                            {
                                                while (true)
                                                {
                                                    b = sq_parse_expr(st);
                                                    if (b < 0) { return b; };
                                                    if (last < 0) { st.nodes[n].b = b; } else { st.nodes[last].next = b; };
                                                    last = b;
                                                    if (sq_is_op(st, 44)) { sq_next(st); } else { break; };
                                                };
                                            };
                                        };
                                        if (sq_is_op(st, 41) == false) { sq_seterr(st, "expected ) after IN list\0"); return 0 - 1; };
                                        sq_next(st);
                                        if (st.nodes[a].kind == SQN_ROW & st.nodes[n].blk < 0)
                                        {
                                            // (a,b) IN ((..),(..)) expands to an OR of row equalities
                                            if (st.nodes[n].b < 0) { sq_seterr(st, "row value misused\0"); return 0 - 1; };
                                            b = st.nodes[n].b;
                                            while (b >= 0)
                                            {
                                                if (st.nodes[b].kind != SQN_ROW) { sq_seterr(st, "row value misused\0"); return 0 - 1; };
                                                if (st.nodes[b].iv != st.nodes[a].iv) { sq_seterr_terms(st, (int)st.nodes[b].iv, (int)st.nodes[a].iv); return 0 - 1; };
                                                b = st.nodes[b].next;
                                            };
                                            c = 0 - 1;
                                            b = st.nodes[n].b;
                                            while (b >= 0)
                                            {
                                                last = sq_mkbin(st, SQO_EQ, a, b);
                                                if (last < 0) { return last; };
                                                if (c < 0) { c = last; } else { c = sq_mkbin_raw(st, SQO_OR, c, last); if (c < 0) { return c; }; };
                                                b = st.nodes[b].next;
                                            };
                                            if (neg == 2)
                                            {
                                                last = sq_newnode(st, SQN_UNARY);
                                                if (last < 0) { return last; };
                                                st.nodes[last].op = 2;
                                                st.nodes[last].a = c;
                                                c = last;
                                            };
                                            a = c;
                                        }
                                        else { a = n; };
                                    }
                                    else
                                    {
                                        if (sq_is_kw(st, "like\0") | sq_is_kw(st, "glob\0"))
                                        {
                                            isglob = 0;
                                            if (sq_is_kw(st, "glob\0")) { isglob = 1; };
                                            sq_next(st);
                                            b = sq_parse_cmp(st);
                                            if (b < 0) { return b; };
                                            esc = 0 - 1;
                                            if (sq_is_kw(st, "escape\0"))
                                            {
                                                sq_next(st);
                                                esc = sq_parse_cmp(st);
                                                if (esc < 0) { return esc; };
                                            };
                                            n = sq_newnode(st, SQN_LIKE);
                                            if (n < 0) { return n; };
                                            st.nodes[n].op = neg;
                                            st.nodes[n].a = a;
                                            st.nodes[n].b = b;
                                            st.nodes[n].c = esc;
                                            st.nodes[n].iv = (i64)isglob;
                                            a = n;
                                        }
                                        else
                                        {
                                            if (sq_is_kw(st, "between\0"))
                                            {
                                                sq_next(st);
                                                b = sq_parse_cmp(st);
                                                if (b < 0) { return b; };
                                                if (sq_is_kw(st, "and\0") == false) { sq_seterr(st, "expected AND in BETWEEN\0"); return 0 - 1; };
                                                sq_next(st);
                                                c = sq_parse_cmp(st);
                                                if (c < 0) { return c; };
                                                n = sq_newnode(st, SQN_BETWEEN);
                                                if (n < 0) { return n; };
                                                st.nodes[n].op = neg;
                                                st.nodes[n].a = a;
                                                st.nodes[n].b = b;
                                                st.nodes[n].c = c;
                                                a = n;
                                            }
                                            else { break; };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };
            return a;
        };

        def sq_parse_not(SQ_STMT* st) -> int
        {
            int a, n;
            if (sq_is_kw(st, "not\0"))
            {
                sq_next(st);
                a = sq_parse_not(st);
                if (a < 0) { return a; };
                n = sq_newnode(st, SQN_UNARY);
                if (n < 0) { return n; };
                st.nodes[n].op = 2;
                st.nodes[n].a = a;
                return n;
            };
            return sq_parse_eq(st);
        };

        def sq_parse_and(SQ_STMT* st) -> int
        {
            int a, b;
            a = sq_parse_not(st);
            if (a < 0) { return a; };
            while (sq_is_kw(st, "and\0"))
            {
                sq_next(st);
                b = sq_parse_not(st);
                if (b < 0) { return b; };
                a = sq_mkbin(st, SQO_AND, a, b);
                if (a < 0) { return a; };
            };
            return a;
        };

        def sq_parse_expr(SQ_STMT* st) -> int
        {
            int a, b;
            a = sq_parse_and(st);
            if (a < 0) { return a; };
            while (sq_is_kw(st, "or\0"))
            {
                sq_next(st);
                b = sq_parse_and(st);
                if (b < 0) { return b; };
                a = sq_mkbin(st, SQO_OR, a, b);
                if (a < 0) { return a; };
            };
            return a;
        };

        // ---- table definitions ----

        // token scanner for CREATE TABLE text. kind: 1 word, 2 quoted name, 3 string, 4 paren group, 5 punctuation, 6 number
        def sq_tok2(byte* s, int i, int end, int* ts, int* tl, int* kind) -> int
        {
            byte c, q;
            int j, d;
            while (i < end)
            {
                if (s[i] == (byte)32 | s[i] == (byte)9 | s[i] == (byte)10 | s[i] == (byte)13) { i++; } else { break; };
            };
            *ts = i;
            *tl = 0;
            *kind = 0;
            if (i >= end) { return i; };
            c = s[i];
            if (c == (byte)34 | c == (byte)96 | c == (byte)91 | c == (byte)39)
            {
                q = c;
                if (c == (byte)91) { q = (byte)93; };
                j = i + 1;
                while (j < end)
                {
                    if (s[j] == q)
                    {
                        if (j + 1 < end & c != (byte)91) { if (s[j + 1] == q) { j = j + 2; continue; }; };
                        break;
                    };
                    j++;
                };
                if (j < end) { j++; };
                *tl = j - i;
                *kind = 2;
                if (c == (byte)39) { *kind = 3; };
                return j;
            };
            if (c == (byte)40)
            {
                d = 0;
                j = i;
                while (j < end)
                {
                    if (s[j] == (byte)39 | s[j] == (byte)34 | s[j] == (byte)96)
                    {
                        q = s[j];
                        j++;
                        while (j < end & s[j] != q) { j++; };
                        if (j < end) { j++; };
                    }
                    else
                    {
                        if (s[j] == (byte)40) { d++; };
                        if (s[j] == (byte)41) { d--; };
                        j++;
                        if (d == 0) { break; };
                    };
                };
                *tl = j - i;
                *kind = 4;
                return j;
            };
            if (sq_isalpha(c))
            {
                j = i;
                while (j < end)
                {
                    if (sq_isalpha(s[j]) | sq_isdigit(s[j])) { j++; } else { break; };
                };
                *tl = j - i;
                *kind = 1;
                return j;
            };
            if (sq_isdigit(c) | (c == (byte)46 & sq_isdigit(s[i + 1])))
            {
                j = i;
                while (j < end)
                {
                    if (sq_isdigit(s[j]) | s[j] == (byte)46) { j++; } else { break; };
                };
                if (j < end)
                {
                    if (s[j] == (byte)101 | s[j] == (byte)69)
                    {
                        j++;
                        if (j < end) { if (s[j] == (byte)43 | s[j] == (byte)45) { j++; }; };
                        while (j < end & sq_isdigit(s[j])) { j++; };
                    };
                };
                *tl = j - i;
                *kind = 6;
                return j;
            };
            *tl = 1;
            *kind = 5;
            return i + 1;
        };

        // name token compare (quoted names compare their inside text)
        def sq_tname_eq(byte* a, int as_, int al, byte* b, int bs, int bl) -> bool
        {
            int i;
            if (al != bl) { return false; };
            for (i = 0; i < al; i++)
            {
                if (sq_lc(a[as_ + i]) != sq_lc(b[bs + i])) { return false; };
            };
            return true;
        };

        def sq_is_cons_word(byte* p, int n) -> bool
        {
            return sq_ieq(p, n, "primary\0") | sq_ieq(p, n, "not\0") | sq_ieq(p, n, "null\0") | sq_ieq(p, n, "unique\0") | sq_ieq(p, n, "check\0") | sq_ieq(p, n, "default\0") | sq_ieq(p, n, "collate\0") | sq_ieq(p, n, "references\0") | sq_ieq(p, n, "generated\0") | sq_ieq(p, n, "constraint\0") | sq_ieq(p, n, "as\0");
        };

        // index of the column named p[s..s+l) or -1
        def sq_ti_find(SQ_TI* ti, byte* p, int s, int l) -> int
        {
            int k;
            for (k = 0; k < ti.ncols; k++)
            {
                if (sq_tname_eq(ti.base, ti.cs[k], ti.cl[k], p, s, l)) { return k; };
            };
            return 0 - 1;
        };

        // Reads the column list "(a, b DESC, c)" of a table constraint into column indexes. Returns the count.
        def sq_ti_collist(SQ_TI* ti, int gs, int gl, int* out, int maxn) -> int
        {
            byte* s = ti.base;
            int i, end, ts, tl, kind, n, c;
            i = gs + 1;
            end = gs + gl - 1;
            n = 0;
            while (i < end)
            {
                i = sq_tok2(s, i, end, @ts, @tl, @kind);
                if (kind == 0) { break; };
                if (kind == 1 | kind == 2)
                {
                    if (kind == 2) { c = sq_ti_find(ti, s, ts + 1, tl - 2); } else { c = sq_ti_find(ti, s, ts, tl); };
                    if (c >= 0 & n < maxn) { out[n] = c; n++; };
                    // skip the rest of this item
                    while (i < end)
                    {
                        if (s[i] == (byte)44) { break; };
                        i++;
                    };
                };
            };
            return n;
        };

        def sq_aff_of_type(byte* s, int a, int b) -> int
        {
            return sq_type_code(@s[a], b - a);
        };

        // appends an implicit index over the given columns unless an identical one exists
        def sq_ti_add_ix(SQ_TI* ti, int* cols, int n, bool ispk) -> void
        {
            int i, j, off, same;
            if (n < 1 | ti.nix >= 8) { return; };
            off = 0;
            for (i = 0; i < ti.nix; i++)
            {
                if (ti.ixn[i] == n)
                {
                    same = 1;
                    for (j = 0; j < n; j++) { if (ti.ixc[off + j] != cols[j]) { same = 0; }; };
                    if (same == 1)
                    {
                        if (ispk) { ti.ixpk[i] = 1; };
                        return;
                    };
                };
                off = off + ti.ixn[i];
            };
            if (off + n > 64) { return; };
            for (j = 0; j < n; j++) { ti.ixc[off + j] = cols[j]; };
            ti.ixn[ti.nix] = n;
            ti.ixpk[ti.nix] = 0;
            if (ispk) { ti.ixpk[ti.nix] = 1; };
            ti.nix++;
        };

        // Fills ti from the CREATE TABLE text (zero terminated, owned by the caller for the life of ti).
        // true when the table text ends in WITHOUT ROWID
        def sq_ti_is_wor(byte* s) -> bool
        {
            int e, p;
            e = 0;
            while (s[e] != (byte)0) { e++; };
            while (e > 0 & (s[e - 1] == (byte)32 | s[e - 1] == (byte)9 | s[e - 1] == (byte)10 | s[e - 1] == (byte)13 | s[e - 1] == (byte)59)) { e--; };
            if (e < 13) { return false; };
            if (sq_lc(s[e - 1]) != (byte)100 | sq_lc(s[e - 2]) != (byte)105 | sq_lc(s[e - 3]) != (byte)119 | sq_lc(s[e - 4]) != (byte)111 | sq_lc(s[e - 5]) != (byte)114) { return false; };
            p = e - 5;
            if (p < 1) { return false; };
            if (s[p - 1] != (byte)32 & s[p - 1] != (byte)9 & s[p - 1] != (byte)10 & s[p - 1] != (byte)13) { return false; };
            while (p > 0 & (s[p - 1] == (byte)32 | s[p - 1] == (byte)9 | s[p - 1] == (byte)10 | s[p - 1] == (byte)13)) { p--; };
            if (p < 7) { return false; };
            if (sq_lc(s[p - 1]) != (byte)116 | sq_lc(s[p - 2]) != (byte)117 | sq_lc(s[p - 3]) != (byte)111 | sq_lc(s[p - 4]) != (byte)104 | sq_lc(s[p - 5]) != (byte)116 | sq_lc(s[p - 6]) != (byte)105 | sq_lc(s[p - 7]) != (byte)119) { return false; };
            return true;
        };

        // direction and collation of the items of a PRIMARY KEY (...) list
        def sq_ti_pkitems(SQ_TI* ti, int gs, int gl, int n) -> void
        {
            byte* s = ti.base;
            int i, end, ts, tl, kind, k, c, first;
            i = gs + 1;
            end = gs + gl - 1;
            k = 0;
            first = 1;
            while (i < end)
            {
                i = sq_tok2(s, i, end, @ts, @tl, @kind);
                if (kind == 0) { break; };
                if (kind == 3) { continue; };
                if (first == 1)
                {
                    if (k < n) { ti.pkd[k] = 0; ti.pkcl[k] = ti.coll[ti.pkc[k]]; };
                    first = 0;
                    continue;
                };
                if (kind == 1)
                {
                    if (sq_ieq(@s[ts], tl, "desc\0")) { if (k < n) { ti.pkd[k] = 1; }; };
                    if (sq_ieq(@s[ts], tl, "collate\0"))
                    {
                        i = sq_tok2(s, i, end, @ts, @tl, @kind);
                        c = sq_coll_id(@s[ts], tl);
                        if (c > 0 & k < n) { ti.pkcl[k] = c; };
                    };
                };
                if (kind == 5)
                {
                    if (s[ts] == (byte)44) { k++; first = 1; };
                };
            };
        };

        def sq_ti_load(SQ_TI* ti, byte* s) -> int
        {
            int i, segend, ws, wl, kind, j, k, tstart, tend, cons, colhit, c, d0, d1, n2, g;
            int ts, tl, kd, isint, pkseen, ncols0, ev1, ev2, pkdesc, nn2;
            byte[48] ty;
            int tn, tfirst, tlast;
            ti.base = s;
            ti.ncols = 0; ti.ipk = 0 - 1; ti.autoinc = 0; ti.nchk = 0; ti.npk = 0; ti.nuq = 0; ti.rowid_alias = 0 - 1; ti.nix = 0; ti.ngen = 0; ti.nrec = 0; ti.gst = (u64)0;
            ti.wor = 0;
            if (sq_ti_is_wor(s)) { ti.wor = 1; };
            i = 0;
            while (s[i] != (byte)0 & s[i] != (byte)40) { i++; };
            if (s[i] == (byte)0) { return 1; };
            i++;
            while (s[i] != (byte)0)
            {
                segend = sq_seg_end(s, i);
                j = sq_tok2(s, i, segend, @ws, @wl, @kind);
                if (kind == 0) { break; };
                cons = 0;
                if (kind == 1)
                {
                    if (sq_ieq(@s[ws], wl, "primary\0") | sq_ieq(@s[ws], wl, "unique\0") | sq_ieq(@s[ws], wl, "check\0") | sq_ieq(@s[ws], wl, "foreign\0") | sq_ieq(@s[ws], wl, "constraint\0")) { cons = 1; };
                };
                if (cons == 0 & ti.ncols < 128)
                {
                    k = ti.ncols;
                    if (kind == 2) { ti.cs[k] = ws + 1; ti.cl[k] = wl - 2; } else { ti.cs[k] = ws; ti.cl[k] = wl; };
                    ti.aff[k] = 0; ti.coll[k] = 0; ti.notnull[k] = 0; ti.pk[k] = 0; ti.uniq[k] = 0; ti.hid[k] = 0;
                    ti.dfs[k] = 0; ti.dfl[k] = 0; ti.chs[k] = 0; ti.chl[k] = 0; ti.ity[k] = 0; ti.gen[k] = 0; ti.gs[k] = 0; ti.gl[k] = 0; ti.tys[k] = 0; ti.tyl[k] = 0;
                    // type words
                    tn = 0;
                    tfirst = 0 - 1;
                    tlast = 0;
                    while (true)
                    {
                        d0 = j;
                        d1 = sq_tok2(s, j, segend, @ts, @tl, @kd);
                        if (kd == 0) { break; };
                        if (kd == 1)
                        {
                            if (sq_is_cons_word(@s[ts], tl)) { break; };
                            for (g = 0; g < tl; g++) { if (tn < 46) { ty[tn] = sq_lc(s[ts + g]); tn++; }; };
                            if (tfirst < 0) { tfirst = ts; };
                            tlast = ts + tl;
                        };
                        if (kd == 4) { if (tfirst >= 0) { tlast = ts + tl; }; j = d1; continue; };
                        if (kd != 1) { break; };
                        j = d1;
                    };
                    if (tfirst >= 0) { ti.tys[k] = tfirst; ti.tyl[k] = tlast - tfirst; };
                    ty[tn] = (byte)0;
                    ti.aff[k] = sq_type_code(@ty[0], tn);
                    isint = 0;
                    if (sq_ieq(@ty[0], tn, "integer\0")) { isint = 1; ti.ity[k] = 1; };
                    // constraints
                    pkseen = 0;
                    ev1 = 0; ev2 = 0; pkdesc = 0;
                    while (true)
                    {
                        j = sq_tok2(s, j, segend, @ts, @tl, @kd);
                        if (kd == 0) { break; };
                        if (kd != 1) { continue; };
                        if (sq_ieq(@s[ts], tl, "primary\0"))
                        {
                            j = sq_tok2(s, j, segend, @ts, @tl, @kd);
                            ti.pk[k] = 1;
                            pkseen = 1;
                            if (ev1 == 0) { ev1 = 1; } else { ev2 = 1; };
                        };
                        if (sq_ieq(@s[ts], tl, "desc\0")) { if (pkseen == 1) { pkdesc = 1; }; };
                        if (sq_ieq(@s[ts], tl, "autoincrement\0")) { ti.autoinc = 1; };
                        if (sq_ieq(@s[ts], tl, "unique\0"))
                        {
                            ti.uniq[k] = 1;
                            if (ev1 == 0) { ev1 = 2; } else { ev2 = 2; };
                        };
                        if (sq_ieq(@s[ts], tl, "not\0"))
                        {
                            j = sq_tok2(s, j, segend, @ts, @tl, @kd);
                            if (kd == 1) { if (sq_ieq(@s[ts], tl, "null\0")) { ti.notnull[k] = 1; }; };
                        };
                        if (sq_ieq(@s[ts], tl, "collate\0"))
                        {
                            j = sq_tok2(s, j, segend, @ts, @tl, @kd);
                            if (kd == 1) { c = sq_coll_id(@s[ts], tl); if (c > 0) { ti.coll[k] = c; }; };
                        };
                        if (sq_ieq(@s[ts], tl, "check\0"))
                        {
                            j = sq_tok2(s, j, segend, @ts, @tl, @kd);
                            if (kd == 4) { ti.chs[k] = ts + 1; ti.chl[k] = tl - 2; };
                        };
                        if (sq_ieq(@s[ts], tl, "default\0"))
                        {
                            tstart = j;
                            j = sq_tok2(s, j, segend, @ts, @tl, @kd);
                            if (kd == 5)
                            {
                                // sign followed by a number
                                d0 = ts;
                                j = sq_tok2(s, j, segend, @ts, @tl, @kd);
                                ti.dfs[k] = d0;
                                ti.dfl[k] = ts + tl - d0;
                            }
                            else
                            {
                                ti.dfs[k] = ts;
                                ti.dfl[k] = tl;
                                if (kd == 4) { ti.dfs[k] = ts + 1; ti.dfl[k] = tl - 2; };
                                if (kd != 4 & kd != 2 & kd != 3)
                                {
                                    d1 = ts + tl;
                                    if (tl == 1 & d1 < segend)
                                    {
                                        if ((s[ts] == (byte)120 | s[ts] == (byte)88) & s[d1] == (byte)39)
                                        {
                                            d1++;
                                            while (d1 < segend & s[d1] != (byte)39) { d1++; };
                                            if (d1 < segend) { d1++; };
                                            ti.dfl[k] = d1 - ts;
                                            j = d1;
                                        };
                                        if (s[ts] == (byte)48 & (s[d1] == (byte)120 | s[d1] == (byte)88))
                                        {
                                            d1++;
                                            while (d1 < segend & (sq_isdigit(s[d1]) | (s[d1] >= (byte)97 & s[d1] <= (byte)102) | (s[d1] >= (byte)65 & s[d1] <= (byte)70))) { d1++; };
                                            ti.dfl[k] = d1 - ts;
                                            j = d1;
                                        };
                                    };
                                };
                            };
                        };
                        if (sq_ieq(@s[ts], tl, "references\0"))
                        {
                            // skip the referenced table and optional column list
                            j = sq_tok2(s, j, segend, @ts, @tl, @kd);
                            d0 = sq_tok2(s, j, segend, @ts, @tl, @kd);
                            if (kd == 4) { j = d0; };
                        };
                        if (sq_ieq(@s[ts], tl, "generated\0"))
                        {
                            // GENERATED ALWAYS AS (expr) [STORED | VIRTUAL]
                            j = sq_tok2(s, j, segend, @ts, @tl, @kd);
                            if (sq_ieq(@s[ts], tl, "always\0")) { j = sq_tok2(s, j, segend, @ts, @tl, @kd); };
                        };
                        if (sq_ieq(@s[ts], tl, "as\0"))
                        {
                            j = sq_tok2(s, j, segend, @ts, @tl, @kd);
                            if (kd != 4) { return 2; };
                            ti.gen[k] = 1;
                            ti.gs[k] = ts + 1;
                            ti.gl[k] = tl - 2;
                        };
                        if (sq_ieq(@s[ts], tl, "stored\0")) { if (ti.gen[k] != 0) { ti.gen[k] = 2; }; };
                    };
                    if (pkseen == 1 & isint == 1 & ti.ipk < 0 & ti.npk == 0 & pkdesc == 0 & ti.wor == 0)
                    {
                        // an INTEGER PRIMARY KEY (not DESC) aliases the rowid
                        ti.ipk = k;
                    };
                    // implicit indexes in the order SQLite creates them
                    for (g = 0; g < 2; g++)
                    {
                        c = ev1;
                        if (g == 1) { c = ev2; };
                        if (c == 0) { continue; };
                        if (c == 1 & ti.ipk == k) { continue; };
                        sq_ti_add_ix(ti, @k, 1, c == 1);
                    };
                    if (pkseen == 1)
                    {
                        if (ti.npk < 16) { ti.pkc[ti.npk] = k; ti.pkd[ti.npk] = pkdesc; ti.pkcl[ti.npk] = ti.coll[k]; ti.npk++; };
                    };
                    ti.ncols = k + 1;
                }
                else
                {
                    if (cons == 1)
                    {
                        // table constraint
                        if (sq_ieq(@s[ws], wl, "constraint\0"))
                        {
                            j = sq_tok2(s, j, segend, @ws, @wl, @kind);
                            j = sq_tok2(s, j, segend, @ws, @wl, @kind);
                        };
                        if (sq_ieq(@s[ws], wl, "primary\0"))
                        {
                            j = sq_tok2(s, j, segend, @ts, @tl, @kd);
                            j = sq_tok2(s, j, segend, @ts, @tl, @kd);
                            if (kd == 4)
                            {
                                n2 = sq_ti_collist(ti, ts, tl, @ti.pkc[0], 16);
                                // a single INTEGER column keeps the rowid alias; otherwise the key needs an index
                                nn2 = 0;
                                if (n2 == 1)
                                {
                                    c = ti.pkc[0];
                                    ti.pk[c] = 1;
                                    if (ti.ity[c] == 1 & ti.wor == 0)
                                    {
                                        if (ti.ipk < 0) { ti.ipk = c; nn2 = 1; };
                                    };
                                }
                                else
                                {
                                    for (g = 0; g < n2; g++) { ti.pk[ti.pkc[g]] = 1; };
                                };
                                ti.npk = n2;
                                sq_ti_pkitems(ti, ts, tl, n2);
                                if (nn2 == 0) { sq_ti_add_ix(ti, @ti.pkc[0], n2, true); };
                            };
                        };
                        if (sq_ieq(@s[ws], wl, "unique\0"))
                        {
                            j = sq_tok2(s, j, segend, @ts, @tl, @kd);
                            if (kd == 4 & ti.nuq < 8)
                            {
                                g = 0;
                                for (c = 0; c < ti.nuq; c++) { g = g + ti.uqn[c]; };
                                n2 = sq_ti_collist(ti, ts, tl, @ti.uqc[g], 16);
                                ti.uqn[ti.nuq] = n2;
                                ti.nuq++;
                                sq_ti_add_ix(ti, @ti.uqc[g], n2, false);
                            };
                        };
                        if (sq_ieq(@s[ws], wl, "check\0"))
                        {
                            j = sq_tok2(s, j, segend, @ts, @tl, @kd);
                            if (kd == 4 & ti.nchk < 16)
                            {
                                ti.ks[ti.nchk] = ts + 1;
                                ti.kl[ti.nchk] = tl - 2;
                                ti.nchk++;
                            };
                        };
                    };
                };
                i = segend;
                if (s[i] == (byte)44) { i++; } else { break; };
            };
            ti.nrec = 0;
            if (ti.wor == 1)
            {
                // the key columns come first in a WITHOUT ROWID record, then the rest in table order
                for (k = 0; k < ti.ncols; k++) { ti.ri[k] = 0 - 2; };
                for (g = 0; g < ti.npk; g++)
                {
                    k = ti.pkc[g];
                    ti.notnull[k] = 1;
                    if (ti.ri[k] == 0 - 2) { ti.ri[k] = ti.nrec; ti.rc[ti.nrec] = k; ti.nrec++; };
                };
                for (k = 0; k < ti.ncols; k++)
                {
                    if (ti.ri[k] != 0 - 2) { continue; };
                    if (ti.gen[k] == 1) { ti.ri[k] = 0 - 1; ti.ngen++; continue; };
                    ti.ri[k] = ti.nrec; ti.rc[ti.nrec] = k; ti.nrec++;
                    if (ti.gen[k] == 2) { ti.ngen++; };
                };
                return 0;
            };
            for (k = 0; k < ti.ncols; k++)
            {
                if (ti.gen[k] == 1) { ti.ri[k] = 0 - 1; ti.ngen++; }
                else
                {
                    ti.ri[k] = ti.nrec;
                    ti.nrec++;
                    if (ti.gen[k] == 2) { ti.ngen++; };
                };
            };
            return 0;
        };

        // ---- parser: SELECT ----

        def sq_newblk(SQ_STMT* st, int parent) -> int
        {
            SQ_BLK* b;
            int n = st.nblk;
            int i;
            if (n >= 512) { sq_seterr(st, "query is too complex\0"); return 0 - 1; };
            b = (SQ_BLK*)fmalloc((u64)sizeof(SQ_BLK));
            if ((u64)b == (u64)0) { sq_seterr(st, "out of memory\0"); return 0 - 1; };
            b.src = (SQ_SRC*)fmalloc((u64)(8 * sizeof(SQ_SRC)));
            if ((u64)b.src == (u64)0) { ffree((u64)b); sq_seterr(st, "out of memory\0"); return 0 - 1; };
            st.blks[n] = b;
            st.nblk = n + 1;
            b.nsrc = 0; b.nres = 0; b.distinct = 0; b.where_n = 0 - 1; b.ngrp = 0; b.having = 0 - 1; b.nord = 0;
            b.limit_n = 0 - 1; b.offset_n = 0 - 1; b.cop = 0; b.cnext = 0 - 1; b.parent = parent; b.nagg = 0;
            b.has_agg = 0; b.ncte = 0; b.bidx = n; b.star_cnt = 0; b.is_corr = 0; b.bdone = 0; b.rec = 0; b.refself = 0; b.isvals = 0; b.nwin = 0; b.wphase = 0; b.wnent = 0; b.wcap = 0; b.wcur = 0; b.wgrp = 0 - 1; b.went = (int*)0; b.winv = (SQ_VAL*)0;
            for (i = 0; i < 8; i++) { b.cur[i] = 0 - 1; };
            sq_ar_init(@b.scr);
            sq_ar_init(@b.gar);
            b.aggv = (SQ_VAL*)0;
            b.out = (SQ_RS*)0;
            b.groups = (SQ_GRP*)0;
            b.ngroups = 0; b.gcap = 0;
            b.hbuck = (int*)0; b.hsize = 0;
            b.hrun = (int*)0;
            b.rjmax = 0;
            return n;
        };

        def sq_lex_save(SQ_STMT* st, int* sv) -> void
        {
            sv[0] = st.pos; sv[1] = st.tk; sv[2] = st.ts; sv[3] = st.tl; sv[4] = st.tq; sv[5] = st.tcode; sv[6] = st.tend; sv[7] = st.prevend;
        };

        def sq_lex_restore(SQ_STMT* st, int* sv) -> void
        {
            st.pos = sv[0]; st.tk = sv[1]; st.ts = sv[2]; st.tl = sv[3]; st.tq = sv[4]; st.tcode = sv[5]; st.tend = sv[6]; st.prevend = sv[7];
        };

        def sq_cstrlen(byte* p) -> int
        {
            int n = 0;
            while (p[n] != (byte)0) { n++; };
            return n;
        };

        // schema object lookup by name, kind 1 table, 3 view. Returns the schema index or -1.
        // the database whose view is being expanded; names inside it are looked up there first
        global u64 SQ_VCTX = 0;

        def sq_find_obj(SQLITE_DB* db, byte* p, int s, int l, int kind) -> int
        {
            int i;
            for (i = 0; i < db.nschema; i++)
            {
                if (db.schema[i].kind != kind) { continue; };
                if (sq_tname_eq(@db.schema[i].name[0], 0, sq_cstrlen(@db.schema[i].name[0]), p, s, l)) { return i; };
            };
            return 0 - 1;
        };

        def sq_att_temp(SQLITE_DB* db) -> SQLITE_DB*;

        def sq_att_find(SQLITE_DB* db, byte* nm, int nl) -> int
        {
            int k, j, same;
            byte c;
            for (k = 0; k < db.natt; k++)
            {
                same = 1;
                for (j = 0; j < nl; j++)
                {
                    c = nm[j];
                    if (c >= (byte)65 & c <= (byte)90) { c = c + (byte)32; };
                    if (c != db.attn[k * 32 + j]) { same = 0; break; };
                };
                if (same == 1 & db.attn[k * 32 + nl] == (byte)0) { return k; };
            };
            return 0 - 1;
        };

        def sq_ti_alloc(SQ_STMT* st) -> SQ_TI*
        {
            SQ_TI* t = (SQ_TI*)fmalloc((u64)sizeof(SQ_TI));
            if ((u64)t == (u64)0) { sq_seterr(st, "out of memory\0"); };
            return t;
        };

        // heap copy of a schema SQL text
        def sq_sql_copy(byte* p) -> byte*
        {
            int n = sq_cstrlen(p);
            byte* r = (byte*)fmalloc((u64)(n + 1));
            int i;
            if ((u64)r == (u64)0) { return r; };
            for (i = 0; i < n; i++) { r[i] = p[i]; };
            r[n] = (byte)0;
            return r;
        };

        def sq_parse_ident_pos(SQ_STMT* st) -> bool
        {
            return st.tk == 1;
        };

        // Parses "CREATE VIEW name [(cols)] AS select" stored in the schema into a block.
        def sq_expand_view(SQ_STMT* st, SQLITE_DB* vdb, int sidx, int parent) -> int
        {
            byte* vs;
            int n, base, b, i, sv0, lim0, ci;
            u64 vsave;
            int[8] sv;
            int[32] cs, cl;
            vs = vdb.schema[sidx].sql;
            if ((u64)vs == (u64)0) { sq_seterr(st, "view has no definition\0"); return 0 - 1; };
            n = sq_cstrlen(vs);
            base = st.sqllen + 1;
            if (base + n + 2 >= 262144) { sq_seterr(st, "statement too large\0"); return 0 - 1; };
            for (i = 0; i < n; i++) { st.sql[base + i] = vs[i]; };
            st.sql[base + n] = (byte)0;
            sq_lex_save(st, @sv[0]);
            lim0 = st.lim;
            st.lim = base + n;
            st.sqllen = base + n;
            st.pos = base;
            st.tend = base;
            sq_next(st);
            ci = 0;
            // CREATE [TEMP] VIEW [IF NOT EXISTS] name [(cols)] AS
            while (st.tk != 0 & sq_is_kw(st, "as\0") == false)
            {
                if (sq_is_op(st, 40))
                {
                    sq_next(st);
                    while (st.tk != 0 & sq_is_op(st, 41) == false)
                    {
                        if (st.tk == 1 & ci < 32) { cs[ci] = st.ts; cl[ci] = st.tl; ci++; };
                        sq_next(st);
                    };
                };
                sq_next(st);
            };
            if (st.tk == 0) { sq_seterr(st, "malformed view definition\0"); return 0 - 1; };
            sq_next(st);
            vsave = SQ_VCTX;
            SQ_VCTX = (u64)vdb;
            b = sq_parse_select(st, parent);
            SQ_VCTX = vsave;
            if (b >= 0)
            {
                for (i = 0; i < ci; i++)
                {
                    if (i < st.blks[b].nres) { st.blks[b].rns[i] = cs[i]; st.blks[b].rnl[i] = cl[i]; };
                };
            };
            st.lim = lim0;
            sq_lex_restore(st, @sv[0]);
            return b;
        };

        // pragma table-valued functions: definition code of "pragma_NAME" (0 when unknown)
        def sq_ptvf_def(byte* p, int n) -> int
        {
            if (n < 8) { return 0; };
            if (sq_ieq(p, 7, "pragma_\0") == false)
            {
                if (p[0] != (byte)112 & p[0] != (byte)80) { return 0; };
                if (p[1] != (byte)114 & p[1] != (byte)82) { return 0; };
                if (p[2] != (byte)97 & p[2] != (byte)65) { return 0; };
                if (p[3] != (byte)103 & p[3] != (byte)71) { return 0; };
                if (p[4] != (byte)109 & p[4] != (byte)77) { return 0; };
                if (p[5] != (byte)97 & p[5] != (byte)65) { return 0; };
                if (p[6] != (byte)95) { return 0; };
            };
            p = @p[7];
            n = n - 7;
            if (sq_ieq(p, n, "table_info\0")) { return 1; };
            if (sq_ieq(p, n, "table_xinfo\0")) { return 2; };
            if (sq_ieq(p, n, "index_list\0")) { return 3; };
            if (sq_ieq(p, n, "index_info\0")) { return 4; };
            if (sq_ieq(p, n, "index_xinfo\0")) { return 5; };
            if (sq_ieq(p, n, "foreign_key_list\0")) { return 6; };
            if (sq_ieq(p, n, "collation_list\0")) { return 7; };
            if (sq_ieq(p, n, "database_list\0")) { return 8; };
            if (sq_ieq(p, n, "page_count\0")) { return 9; };
            if (sq_ieq(p, n, "page_size\0")) { return 10; };
            if (sq_ieq(p, n, "journal_mode\0")) { return 11; };
            if (sq_ieq(p, n, "freelist_count\0")) { return 12; };
            if (sq_ieq(p, n, "user_version\0")) { return 13; };
            if (sq_ieq(p, n, "schema_version\0")) { return 14; };
            if (sq_ieq(p, n, "encoding\0")) { return 15; };
            if (sq_ieq(p, n, "application_id\0")) { return 16; };
            if (sq_ieq(p, n, "foreign_keys\0")) { return 17; };
            if (sq_ieq(p, n, "cache_size\0")) { return 18; };
            if (sq_ieq(p, n, "synchronous\0")) { return 19; };
            if (sq_ieq(p, n, "auto_vacuum\0")) { return 20; };
            if (sq_ieq(p, n, "max_page_count\0")) { return 21; };
            if (sq_ieq(p, n, "temp_store\0")) { return 22; };
            if (sq_ieq(p, n, "secure_delete\0")) { return 23; };
            if (sq_ieq(p, n, "recursive_triggers\0")) { return 24; };
            if (sq_ieq(p, n, "locking_mode\0")) { return 25; };
            if (sq_ieq(p, n, "integrity_check\0")) { return 26; };
            if (sq_ieq(p, n, "quick_check\0")) { return 27; };
            if (sq_ieq(p, n, "foreign_key_check\0")) { return 28; };
            return 0;
        };

        // CREATE TABLE text giving the columns of a pragma function; the last hidden ones are arg and/or schema
        def sq_ptvf_create(int d) -> byte*
        {
            if (d == 1) { return "CREATE TABLE x(\"cid\",\"name\",\"type\",\"notnull\",\"dflt_value\",\"pk\",\"arg\",\"schema\")\0"; };
            if (d == 2) { return "CREATE TABLE x(\"cid\",\"name\",\"type\",\"notnull\",\"dflt_value\",\"pk\",\"hidden\",\"arg\",\"schema\")\0"; };
            if (d == 3) { return "CREATE TABLE x(\"seq\",\"name\",\"unique\",\"origin\",\"partial\",\"arg\",\"schema\")\0"; };
            if (d == 4) { return "CREATE TABLE x(\"seqno\",\"cid\",\"name\",\"arg\",\"schema\")\0"; };
            if (d == 5) { return "CREATE TABLE x(\"seqno\",\"cid\",\"name\",\"desc\",\"coll\",\"key\",\"arg\",\"schema\")\0"; };
            if (d == 6) { return "CREATE TABLE x(\"id\",\"seq\",\"table\",\"from\",\"to\",\"on_update\",\"on_delete\",\"match\",\"arg\",\"schema\")\0"; };
            if (d == 7) { return "CREATE TABLE x(\"seq\",\"name\")\0"; };
            if (d == 8) { return "CREATE TABLE x(\"seq\",\"name\",\"file\")\0"; };
            if (d == 9) { return "CREATE TABLE x(\"page_count\",\"schema\")\0"; };
            if (d == 10) { return "CREATE TABLE x(\"page_size\",\"schema\")\0"; };
            if (d == 11) { return "CREATE TABLE x(\"journal_mode\",\"schema\")\0"; };
            if (d == 12) { return "CREATE TABLE x(\"freelist_count\")\0"; };
            if (d == 13) { return "CREATE TABLE x(\"user_version\")\0"; };
            if (d == 14) { return "CREATE TABLE x(\"schema_version\")\0"; };
            if (d == 15) { return "CREATE TABLE x(\"encoding\")\0"; };
            if (d == 16) { return "CREATE TABLE x(\"application_id\")\0"; };
            if (d == 17) { return "CREATE TABLE x(\"foreign_keys\")\0"; };
            if (d == 18) { return "CREATE TABLE x(\"cache_size\",\"schema\")\0"; };
            if (d == 19) { return "CREATE TABLE x(\"synchronous\",\"schema\")\0"; };
            if (d == 20) { return "CREATE TABLE x(\"auto_vacuum\",\"schema\")\0"; };
            if (d == 21) { return "CREATE TABLE x(\"max_page_count\",\"schema\")\0"; };
            if (d == 22) { return "CREATE TABLE x(\"temp_store\")\0"; };
            if (d == 23) { return "CREATE TABLE x(\"secure_delete\")\0"; };
            if (d == 24) { return "CREATE TABLE x(\"recursive_triggers\")\0"; };
            if (d == 25) { return "CREATE TABLE x(\"locking_mode\",\"schema\")\0"; };
            if (d == 26) { return "CREATE TABLE x(\"integrity_check\",\"arg\",\"schema\")\0"; };
            if (d == 27) { return "CREATE TABLE x(\"quick_check\",\"arg\",\"schema\")\0"; };
            return "CREATE TABLE x(\"table\",\"rowid\",\"parent\",\"fkid\",\"arg\",\"schema\")\0";
        };

        // hidden columns of a definition: bit 0 arg, bit 1 schema
        def sq_ptvf_hid(int d) -> int
        {
            if (d >= 1 & d <= 6) { return 3; };
            if (d == 7 | d == 8 | d == 12 | d == 13 | d == 14 | d == 15 | d == 16 | d == 17 | d == 22 | d == 23 | d == 24) { return 0; };
            if (d >= 26) { return 3; };
            return 2;
        };

        def sq_add_src(SQ_STMT* st, SQ_BLK* b) -> SQ_SRC*
        {
            SQ_SRC* sr;
            int k;
            if (b.nsrc >= 8) { sq_seterr(st, "too many tables in a join\0"); return (SQ_SRC*)0; };
            sr = @b.src[b.nsrc];
            b.nsrc++;
            sr.kind = 0; sr.jt = 0; sr.natural = 0; sr.nusing = 0; sr.on = 0 - 1; sr.tbl = 0 - 1; sr.root = 0;
            sr.blk = 0 - 1; sr.ts = 0; sr.tl = 0; sr.as_s = 0; sr.as_l = 0; sr.ncols = 0;
            sr.ti = (SQ_TI*)0; sr.sdb = st.db; sr.rs = (SQ_RS*)0; sr.rs_shared = 0; sr.cte = 0 - 1; sr.selfref = 0;
            sr.plan = 0; sr.pcol = 0 - 1; sr.pexpr = 0 - 1; sr.pexpr2 = 0 - 1; sr.pop = 0; sr.pop2 = 0;
            sr.ixs_s = 0; sr.ixs_l = 0; sr.idxby = 0;
            sr.tvf = 0; sr.targ = 0 - 1; sr.ntarg = 0; sr.tdef = 0;
            return sr;
        };

        // one FROM item: table, view, CTE or parenthesised subquery
        def sq_parse_source(SQ_STMT* st, int bi) -> int
        {
            SQ_BLK* b = st.blks[bi];
            SQ_SRC* sr;
            int k, sidx, sb, n, found, qs0, ql0, ndb, di, tvfk, tvl;
            SQLITE_DB* qdb;
            SQLITE_DB* hdb;
            SQLITE_DB* cdb;
            SQLITE_DB*[12] cl;
            byte* tsql;
            if (sq_is_op(st, 40))
            {
                sq_next(st);
                if ((sq_is_kw(st, "select\0") | sq_is_kw(st, "with\0") | sq_is_kw(st, "values\0")) == false)
                {
                    sq_seterr(st, "only subqueries may be parenthesised in FROM\0");
                    return 1;
                };
                sb = sq_parse_select(st, bi);
                if (sb < 0) { return 1; };
                if (sq_is_op(st, 41) == false) { sq_seterr(st, "expected ) after subquery\0"); return 1; };
                sq_next(st);
                sr = sq_add_src(st, b);
                if ((u64)sr == (u64)0) { return 1; };
                sr.kind = 2;
                sr.blk = sb;
            }
            else
            {
                if (st.tk != 1) { sq_seterr(st, "expected table name\0"); return 1; };
                sr = sq_add_src(st, b);
                if ((u64)sr == (u64)0) { return 1; };
                sr.ts = st.ts;
                sr.tl = st.tl;
                sq_next(st);
                tvfk = 0;
                if (sq_is_op(st, 40))
                {
                    if (sq_ieq(@st.sql[sr.ts], sr.tl, "json_each\0")) { tvfk = 1; };
                    if (sq_ieq(@st.sql[sr.ts], sr.tl, "json_tree\0")) { tvfk = 2; };
                };
                di = sq_ptvf_def(@st.sql[sr.ts], sr.tl);
                if (di > 0 & tvfk == 0) { tvfk = 3; sr.tdef = di; };
                if (tvfk > 0)
                {
                    sr.kind = 3;
                    sr.tvf = tvfk;
                    tvl = 0 - 1;
                    if (sq_is_op(st, 40))
                    {
                        sq_next(st);
                        if (sq_is_op(st, 41) == false)
                        {
                            while (true)
                            {
                                k = sq_parse_expr(st);
                                if (k < 0) { return 1; };
                                if (tvl < 0) { sr.targ = k; } else { st.nodes[tvl].next = k; };
                                tvl = k;
                                sr.ntarg++;
                                if (sq_is_op(st, 44)) { sq_next(st); } else { break; };
                            };
                        };
                        if (sq_is_op(st, 41) == false) { sq_seterr(st, "syntax error\0"); return 1; };
                        sq_next(st);
                    };
                }
                else
                {
                qdb = (SQLITE_DB*)0;
                hdb = st.db;
                if ((u64)hdb.home != (u64)0) { hdb = (SQLITE_DB*)hdb.home; };
                if (sq_is_op(st, 46))
                {
                    // schema.table: main, temp (as main) or the name of an attached database
                    qs0 = sr.ts;
                    ql0 = sr.tl;
                    if (sq_ieq(@st.sql[qs0], ql0, "main\0")) { qdb = hdb; }
                    else
                    {
                        k = sq_att_find(hdb, @st.sql[qs0], ql0);
                        if (sq_ieq(@st.sql[qs0], ql0, "temporary\0")) { k = sq_att_find(hdb, "temp\0", 4); };
                        if (k >= 0) { qdb = (SQLITE_DB*)hdb.att[k]; };
                    };
                    sq_next(st);
                    if (st.tk != 1) { sq_seterr(st, "expected table name\0"); return 1; };
                    sr.ts = st.ts;
                    sr.tl = st.tl;
                    sq_next(st);
                    if ((u64)qdb == (u64)0)
                    {
                        sq_seterr_n(st, "no such table\0", qs0, sr.ts + sr.tl - qs0);
                        return 1;
                    };
                };
                found = 0;
                for (k = st.ncte - 1; k >= 0; k--)
                {
                    if ((u64)qdb != (u64)0) { break; };
                    if (sq_tname_eq(@st.sql[0], st.ctes[k].ns, st.ctes[k].nl, @st.sql[0], sr.ts, sr.tl))
                    {
                        sr.kind = 2;
                        sr.cte = k;
                        sr.blk = st.ctes[k].blk;
                        if (st.ctes[k].blk < 0) { sr.selfref = 1; b.refself = 1; };
                        found = 1;
                        break;
                    };
                };
                // unqualified names are looked up in the statement's own database first, then main, then the attached ones
                ndb = 0;
                cl[0] = st.db; ndb = 1;
                if (SQ_VCTX != (u64)0) { cl[0] = (SQLITE_DB*)SQ_VCTX; };
                if ((u64)hdb != (u64)cl[0]) { cl[ndb] = hdb; ndb++; };
                for (di = 0; di < hdb.natt; di++)
                {
                    if ((u64)hdb.att[di] != (u64)cl[0]) { cl[ndb] = (SQLITE_DB*)hdb.att[di]; ndb++; };
                };
                for (di = 0; di < ndb; di++)
                {
                    if (found == 1) { break; };
                    if ((u64)qdb != (u64)0) { cdb = qdb; if (di > 0) { break; }; }
                    else { cdb = cl[di]; };
                    sidx = sq_find_obj(cdb, @st.sql[0], sr.ts, sr.tl, 1);
                    if (sidx >= 0)
                    {
                        sr.kind = 1;
                        sr.tbl = sidx;
                        sr.sdb = cdb;
                        sr.root = cdb.schema[sidx].rootpage;
                        found = 1;
                    }
                    else
                    {
                        sidx = sq_find_obj(cdb, @st.sql[0], sr.ts, sr.tl, 3);
                        if (sidx >= 0)
                        {
                            sb = sq_expand_view(st, cdb, sidx, bi);
                            if (sb < 0) { return 1; };
                            sr.kind = 2;
                            sr.blk = sb;
                            found = 1;
                        };
                    };
                };
                if (found == 0)
                {
                    if (sq_ieq(@st.sql[sr.ts], sr.tl, "sqlite_master\0") | sq_ieq(@st.sql[sr.ts], sr.tl, "sqlite_schema\0"))
                    {
                        sr.kind = 1;
                        sr.tbl = 0 - 1;
                        sr.root = 1;
                        if ((u64)qdb != (u64)0) { sr.sdb = qdb; };
                        found = 1;
                    };
                    if (sq_ieq(@st.sql[sr.ts], sr.tl, "sqlite_temp_master\0") | sq_ieq(@st.sql[sr.ts], sr.tl, "sqlite_temp_schema\0"))
                    {
                        sr.kind = 1;
                        sr.tbl = 0 - 1;
                        sr.root = 1;
                        sr.sdb = sq_att_temp(hdb);
                        found = 1;
                    };
                };
                if (found == 0)
                {
                    if ((u64)qdb != (u64)0) { sq_seterr_n(st, "no such table\0", qs0, sr.ts + sr.tl - qs0); }
                    else { sq_seterr_n(st, "no such table\0", sr.ts, sr.tl); };
                    return 1;
                };
            };
            };
            // alias
            if (sq_is_kw(st, "as\0"))
            {
                sq_next(st);
                if (st.tk != 1) { sq_seterr(st, "expected alias after AS\0"); return 1; };
                sr.as_s = st.ts; sr.as_l = st.tl;
                sq_next(st);
            }
            else
            {
                if (st.tk == 1 & sq_stop_word(st) == false & sq_is_kw(st, "indexed\0") == false & !(sq_is_kw(st, "not\0") & sq_peek_kw(st, "indexed\0")))
                {
                    sr.as_s = st.ts; sr.as_l = st.tl;
                    sq_next(st);
                };
            };
            // INDEXED BY name | NOT INDEXED
            if (sq_is_kw(st, "indexed\0"))
            {
                sq_next(st);
                if (sq_is_kw(st, "by\0") == false) { sq_seterr(st, "expected BY after INDEXED\0"); return 1; };
                sq_next(st);
                if (st.tk != 1) { sq_seterr(st, "expected index name\0"); return 1; };
                sr.ixs_s = st.ts; sr.ixs_l = st.tl; sr.idxby = 1;
                sq_next(st);
                found = 0;
                if (sr.kind == 1 & sr.tbl >= 0)
                {
                    for (k = 0; k < sr.sdb.nschema; k++)
                    {
                        if (sr.sdb.schema[k].kind != 2) { continue; };
                        if (sq_streq(sr.sdb.schema[k].tbl_name, sr.sdb.schema[sr.tbl].name) == false) { continue; };
                        n = 0;
                        while (sr.sdb.schema[k].name[n] != (byte)0) { n++; };
                        if (n == sr.ixs_l)
                        {
                            di = 1;
                            for (sidx = 0; sidx < n; sidx++) { if (sq_lc(sr.sdb.schema[k].name[sidx]) != sq_lc(st.sql[sr.ixs_s + sidx])) { di = 0; }; };
                            if (di == 1) { found = 1; };
                        };
                    };
                };
                if (found == 0) { sq_seterr_n(st, "no such index\0", sr.ixs_s, sr.ixs_l); return 1; };
            }
            else
            {
                if (sq_is_kw(st, "not\0") & sq_peek_kw(st, "indexed\0"))
                {
                    sq_next(st);
                    sq_next(st);
                    sr.idxby = 2;
                };
            };
            if (sr.kind == 2 & sr.as_l == 0 & sr.cte < 0)
            {
                sr.as_s = 0; sr.as_l = 0;
            };
            return 0;
        };

        def sq_parse_from(SQ_STMT* st, int bi) -> int
        {
            SQ_BLK* b = st.blks[bi];
            SQ_SRC* sr;
            int jt, nat, e, last, ui;
            if (sq_parse_source(st, bi) != 0) { return 1; };
            while (true)
            {
                jt = 0;
                nat = 0;
                if (sq_is_op(st, 44)) { jt = 3; sq_next(st); }
                else
                {
                    if (sq_is_kw(st, "natural\0")) { nat = 1; sq_next(st); };
                    jt = 1;
                    if (sq_is_kw(st, "left\0")) { jt = 2; sq_next(st); if (sq_is_kw(st, "outer\0")) { sq_next(st); }; }
                    else
                    {
                        if (sq_is_kw(st, "inner\0")) { sq_next(st); }
                        else
                        {
                            if (sq_is_kw(st, "cross\0")) { jt = 3; sq_next(st); }
                            else
                            {
                                if (sq_is_kw(st, "right\0")) { jt = 4; sq_next(st); if (sq_is_kw(st, "outer\0")) { sq_next(st); }; }
                                else
                                {
                                    if (sq_is_kw(st, "full\0")) { jt = 5; sq_next(st); if (sq_is_kw(st, "outer\0")) { sq_next(st); }; };
                                };
                            };
                        };
                    };
                    if (sq_is_kw(st, "join\0") == false)
                    {
                        if (nat == 1 | jt != 1) { sq_seterr(st, "expected JOIN\0"); return 1; };
                        break;
                    };
                    sq_next(st);
                };
                if (sq_parse_source(st, bi) != 0) { return 1; };
                sr = @b.src[b.nsrc - 1];
                sr.jt = jt;
                sr.natural = nat;
                if (sq_is_kw(st, "on\0"))
                {
                    sq_next(st);
                    st.curblk = bi;
                    e = sq_parse_expr(st);
                    if (e < 0) { return 1; };
                    sr.on = e;
                }
                else
                {
                    if (sq_is_kw(st, "using\0"))
                    {
                        sq_next(st);
                        if (sq_is_op(st, 40) == false) { sq_seterr(st, "expected ( after USING\0"); return 1; };
                        sq_next(st);
                        ui = 0;
                        while (st.tk == 1 & ui < 16)
                        {
                            sr.us[ui] = st.ts;
                            sr.ul[ui] = st.tl;
                            ui++;
                            sq_next(st);
                            if (sq_is_op(st, 44)) { sq_next(st); } else { break; };
                        };
                        sr.nusing = ui;
                        if (sq_is_op(st, 41) == false) { sq_seterr(st, "expected ) after USING\0"); return 1; };
                        sq_next(st);
                    };
                };
            };
            return 0;
        };

        // one SELECT arm (after the SELECT keyword) or a VALUES row set head
        // first window-function call inside an expression, or -1
        def sq_find_win(SQ_STMT* st, int ni) -> int
        {
            SQ_NODE* nd;
            int c, r;
            if (ni < 0) { return 0 - 1; };
            nd = @st.nodes[ni];
            if (nd.kind == SQN_FUNC) { if (nd.win >= 0) { return ni; }; };
            if (nd.kind == SQN_SUBQ | nd.kind == SQN_EXISTS) { return 0 - 1; };
            c = nd.a;
            while (c >= 0) { r = sq_find_win(st, c); if (r >= 0) { return r; }; c = st.nodes[c].next; };
            c = nd.b;
            while (c >= 0) { r = sq_find_win(st, c); if (r >= 0) { return r; }; c = st.nodes[c].next; };
            c = nd.c;
            while (c >= 0) { r = sq_find_win(st, c); if (r >= 0) { return r; }; c = st.nodes[c].next; };
            return 0 - 1;
        };

        def sq_seterr_win(SQ_STMT* st, byte* pre, int ni, byte* post) -> void
        {
            int i = 0;
            int k = 0;
            if (st.err[0] != (byte)0) { return; };
            while (pre[k] != (byte)0) { st.err[i] = pre[k]; i++; k++; };
            for (k = 0; k < st.nodes[ni].sl & i < 150; k++) { st.err[i] = st.sql[st.nodes[ni].s + k]; i++; };
            k = 0;
            while (post[k] != (byte)0) { st.err[i] = post[k]; i++; k++; };
            st.err[i] = (byte)0;
        };

        def sq_win_misuse(SQ_STMT* st, int e) -> int
        {
            int w = sq_find_win(st, e);
            if (w < 0) { return 0; };
            sq_seterr_win(st, "misuse of window function \0", w, "()\0");
            return 1;
        };

        def sq_parse_core(SQ_STMT* st, int bi) -> int
        {
            SQ_BLK* b = st.blks[bi];
            int tstart, nodeIdx, last, e, sv0;
            int[8] sv;
            st.curblk = bi;
            if (sq_is_kw(st, "distinct\0")) { b.distinct = 1; sq_next(st); }
            else { if (sq_is_kw(st, "all\0")) { sq_next(st); }; };
            while (true)
            {
                if (b.nres >= 128) { sq_seterr(st, "too many result columns\0"); return 1; };
                tstart = st.ts;
                if (st.tk == 4) { tstart = st.ts - 1; };
                if (st.tk == 6) { tstart = st.ts - 2; };
                nodeIdx = 0 - 1;
                if (sq_is_op(st, 42))
                {
                    nodeIdx = sq_newnode(st, SQN_STAR);
                    if (nodeIdx < 0) { return 1; };
                    sq_next(st);
                }
                else
                {
                    if (st.tk == 1)
                    {
                        sq_lex_save(st, @sv[0]);
                        sq_next(st);
                        if (sq_is_op(st, 46))
                        {
                            sq_next(st);
                            if (sq_is_op(st, 42))
                            {
                                nodeIdx = sq_newnode(st, SQN_STAR);
                                if (nodeIdx < 0) { return 1; };
                                st.nodes[nodeIdx].qs = st.nodes[nodeIdx].s;
                                sq_lex_restore(st, @sv[0]);
                                st.nodes[nodeIdx].qs = st.ts;
                                st.nodes[nodeIdx].ql = st.tl;
                                sq_next(st);
                                sq_next(st);
                                sq_next(st);
                            };
                        };
                        if (nodeIdx < 0) { sq_lex_restore(st, @sv[0]); };
                    };
                    if (nodeIdx < 0)
                    {
                        nodeIdx = sq_parse_expr(st);
                        if (nodeIdx < 0) { return 1; };
                    };
                };
                b.rc[b.nres] = nodeIdx;
                b.rns[b.nres] = tstart;
                b.rnl[b.nres] = st.prevend - tstart;
                if (st.nodes[nodeIdx].kind == SQN_COL) { b.rnl[b.nres] = 0 - 1; };
                if (sq_is_kw(st, "as\0"))
                {
                    sq_next(st);
                    if (st.tk != 1 & st.tk != 4) { sq_seterr(st, "expected alias after AS\0"); return 1; };
                    b.rns[b.nres] = st.ts;
                    b.rnl[b.nres] = st.tl;
                    sq_next(st);
                }
                else
                {
                    if ((st.tk == 1 & sq_stop_word(st) == false) | st.tk == 4)
                    {
                        b.rns[b.nres] = st.ts;
                        b.rnl[b.nres] = st.tl;
                        sq_next(st);
                    };
                };
                b.nres++;
                if (sq_is_op(st, 44)) { sq_next(st); } else { break; };
            };
            if (sq_is_kw(st, "from\0"))
            {
                sq_next(st);
                if (sq_parse_from(st, bi) != 0) { return 1; };
            };
            st.curblk = bi;
            if (sq_is_kw(st, "where\0"))
            {
                sq_next(st);
                e = sq_parse_expr(st);
                if (e < 0) { return 1; };
                if (sq_win_misuse(st, e) != 0) { return 1; };
                b.where_n = e;
            };
            if (sq_is_kw(st, "group\0"))
            {
                sq_next(st);
                if (sq_is_kw(st, "by\0") == false) { sq_seterr(st, "expected BY after GROUP\0"); return 1; };
                sq_next(st);
                while (true)
                {
                    if (b.ngrp >= 16) { sq_seterr(st, "too many GROUP BY terms\0"); return 1; };
                    e = sq_parse_expr(st);
                    if (e < 0) { return 1; };
                    if (sq_win_misuse(st, e) != 0) { return 1; };
                    b.grp[b.ngrp] = e;
                    b.ngrp++;
                    if (sq_is_op(st, 44)) { sq_next(st); } else { break; };
                };
            };
            if (sq_is_kw(st, "having\0"))
            {
                sq_next(st);
                e = sq_parse_expr(st);
                if (e < 0) { return 1; };
                if (sq_win_misuse(st, e) != 0) { return 1; };
                b.having = e;
            };
            if (sq_is_kw(st, "window\0"))
            {
                sq_next(st);
                while (true)
                {
                    if (st.nwdef >= 8) { sq_seterr(st, "too many named windows\0"); return 1; };
                    if (st.tk != 1) { sq_seterr(st, "expected window name\0"); return 1; };
                    sq_win_init(@st.wdefs[st.nwdef]);
                    st.wdefs[st.nwdef].dns = st.ts; st.wdefs[st.nwdef].dnl = st.tl;
                    sq_next(st);
                    if (sq_is_kw(st, "as\0") == false) { sq_seterr(st, "expected AS in WINDOW\0"); return 1; };
                    sq_next(st);
                    if (sq_is_op(st, 40) == false) { sq_seterr(st, "expected ( in WINDOW\0"); return 1; };
                    sq_next(st);
                    st.nwdef++;
                    if (sq_parse_wspec(st, @st.wdefs[st.nwdef - 1]) != 0) { return 1; };
                    if (sq_is_op(st, 44)) { sq_next(st); } else { break; };
                };
            };
            return 0;
        };

        // VALUES (..), (..): one arm per row
        def sq_parse_values(SQ_STMT* st, int head, int parent) -> int
        {
            SQ_BLK* b;
            int bi, prev, e, tstart;
            bi = head;
            prev = 0 - 1;
            while (true)
            {
                if (bi < 0)
                {
                    bi = sq_newblk(st, parent);
                    if (bi < 0) { return 1; };
                };
                b = st.blks[bi];
                st.curblk = bi;
                b.isvals = 1;
                if (sq_is_op(st, 40) == false) { sq_seterr(st, "expected ( in VALUES\0"); return 1; };
                sq_next(st);
                while (true)
                {
                    if (b.nres >= 128) { sq_seterr(st, "too many columns\0"); return 1; };
                    tstart = st.ts;
                    e = sq_parse_expr(st);
                    if (e < 0) { return 1; };
                    b.rc[b.nres] = e;
                    b.rns[b.nres] = tstart;
                    b.rnl[b.nres] = st.prevend - tstart;
                    b.nres++;
                    if (sq_is_op(st, 44)) { sq_next(st); } else { break; };
                };
                if (sq_is_op(st, 41) == false) { sq_seterr(st, "expected ) in VALUES\0"); return 1; };
                sq_next(st);
                if (prev >= 0) { st.blks[prev].cnext = bi; b.cop = 2; };
                prev = bi;
                if (sq_is_op(st, 44)) { sq_next(st); bi = 0 - 1; } else { break; };
            };
            return 0;
        };

        def sq_parse_cte_list(SQ_STMT* st, int parent) -> int
        {
            SQ_CTE* c;
            int sb, ci, i, rec, bj, sj, ab;
            rec = 0;
            if (sq_is_kw(st, "recursive\0")) { sq_next(st); rec = 1; };
            while (true)
            {
                if (st.ncte >= 16) { sq_seterr(st, "too many CTEs\0"); return 1; };
                if (st.tk != 1) { sq_seterr(st, "expected CTE name\0"); return 1; };
                ci = st.ncte;
                c = @st.ctes[st.ncte];
                c.ns = st.ts; c.nl = st.tl; c.ncn = 0; c.rs = (SQ_RS*)0; c.work = (SQ_RS*)0; c.rec = 0; c.blk = 0 - 1;
                sq_next(st);
                if (sq_is_op(st, 40))
                {
                    sq_next(st);
                    while (st.tk == 1)
                    {
                        if (c.ncn < 32) { c.cns[c.ncn] = st.ts; c.cnl[c.ncn] = st.tl; c.ncn++; };
                        sq_next(st);
                        if (sq_is_op(st, 44)) { sq_next(st); } else { break; };
                    };
                    if (sq_is_op(st, 41) == false) { sq_seterr(st, "expected ) after CTE columns\0"); return 1; };
                    sq_next(st);
                };
                if (sq_is_kw(st, "as\0") == false) { sq_seterr(st, "expected AS in WITH\0"); return 1; };
                sq_next(st);
                if (sq_is_kw(st, "not\0")) { sq_next(st); };
                if (sq_is_kw(st, "materialized\0")) { sq_next(st); };
                if (sq_is_op(st, 40) == false) { sq_seterr(st, "expected ( after AS\0"); return 1; };
                sq_next(st);
                if (rec == 1) { st.ncte++; };
                sb = sq_parse_select(st, 0 - 1);
                if (sb < 0) { return 1; };
                c = @st.ctes[ci];
                c.blk = sb;
                if (rec == 1)
                {
                    // sources that referred to the CTE while its body was being parsed
                    for (bj = 0; bj < st.nblk; bj++)
                    {
                        for (sj = 0; sj < st.blks[bj].nsrc; sj++)
                        {
                            if (st.blks[bj].src[sj].selfref == 1 & st.blks[bj].src[sj].cte == ci) { st.blks[bj].src[sj].blk = sb; };
                        };
                    };
                    if (st.blks[sb].refself == 1)
                    {
                        sq_seterr_n(st, "circular reference\0", c.ns, c.nl);
                        return 1;
                    };
                    ab = st.blks[sb].cnext;
                    while (ab >= 0)
                    {
                        if (st.blks[ab].refself == 1) { st.blks[sb].rec = ci + 1; c.rec = 1; }
                        else
                        {
                            if (c.rec == 1) { sq_seterr_n(st, "circular reference\0", c.ns, c.nl); return 1; };
                        };
                        ab = st.blks[ab].cnext;
                    };
                };
                for (i = 0; i < c.ncn; i++)
                {
                    if (i < st.blks[sb].nres) { st.blks[sb].rns[i] = c.cns[i]; st.blks[sb].rnl[i] = c.cnl[i]; };
                };
                if (rec == 0) { st.ncte++; };
                if (sq_is_op(st, 41) == false) { sq_seterr(st, "expected ) after CTE\0"); return 1; };
                sq_next(st);
                if (sq_is_op(st, 44)) { sq_next(st); } else { break; };
            };
            return 0;
        };

        // Parses a full query expression (with WITH, compounds, ORDER BY, LIMIT). Returns the head block or -1.
        def sq_parse_select(SQ_STMT* st, int parent) -> int
        {
            int head, bi, prev, cop, e, curb0;
            SQ_BLK* h;
            curb0 = st.curblk;
            if (sq_is_kw(st, "with\0"))
            {
                sq_next(st);
                if (sq_parse_cte_list(st, parent) != 0) { return 0 - 1; };
            };
            head = sq_newblk(st, parent);
            if (head < 0) { return head; };
            prev = head;
            bi = head;
            while (true)
            {
                if (sq_is_kw(st, "values\0"))
                {
                    sq_next(st);
                    if (sq_parse_values(st, bi, parent) != 0) { return 0 - 1; };
                    // find the last arm created
                    prev = bi;
                    while (st.blks[prev].cnext >= 0) { prev = st.blks[prev].cnext; };
                }
                else
                {
                    if (sq_is_kw(st, "select\0") == false) { sq_seterr(st, "expected SELECT\0"); return 0 - 1; };
                    sq_next(st);
                    if (sq_parse_core(st, bi) != 0) { return 0 - 1; };
                    prev = bi;
                };
                cop = 0;
                if (sq_is_kw(st, "union\0"))
                {
                    sq_next(st);
                    cop = 1;
                    if (sq_is_kw(st, "all\0")) { sq_next(st); cop = 2; };
                }
                else
                {
                    if (sq_is_kw(st, "intersect\0")) { sq_next(st); cop = 3; }
                    else { if (sq_is_kw(st, "except\0")) { sq_next(st); cop = 4; }; };
                };
                if (cop == 0) { break; };
                bi = sq_newblk(st, parent);
                if (bi < 0) { return 0 - 1; };
                st.blks[bi].cop = cop;
                st.blks[prev].cnext = bi;
            };
            h = st.blks[head];
            st.curblk = head;
            if (sq_is_kw(st, "order\0"))
            {
                sq_next(st);
                if (sq_is_kw(st, "by\0") == false) { sq_seterr(st, "expected BY after ORDER\0"); return 0 - 1; };
                sq_next(st);
                while (true)
                {
                    if (h.nord >= 16) { sq_seterr(st, "too many ORDER BY terms\0"); return 0 - 1; };
                    e = sq_parse_expr(st);
                    if (e < 0) { return 0 - 1; };
                    h.ord[h.nord] = e;
                    h.odesc[h.nord] = 0;
                    h.onull[h.nord] = 0;
                    h.ocoll[h.nord] = 0 - 1;
                    if (sq_is_kw(st, "asc\0")) { sq_next(st); }
                    else { if (sq_is_kw(st, "desc\0")) { h.odesc[h.nord] = 1; sq_next(st); }; };
                    if (sq_is_kw(st, "nulls\0"))
                    {
                        sq_next(st);
                        if (sq_is_kw(st, "first\0")) { h.onull[h.nord] = 1; sq_next(st); }
                        else { if (sq_is_kw(st, "last\0")) { h.onull[h.nord] = 2; sq_next(st); }; };
                    };
                    h.nord++;
                    if (sq_is_op(st, 44)) { sq_next(st); } else { break; };
                };
            };
            if (sq_is_kw(st, "limit\0"))
            {
                sq_next(st);
                e = sq_parse_expr(st);
                if (e < 0) { return 0 - 1; };
                h.limit_n = e;
                if (sq_is_kw(st, "offset\0"))
                {
                    sq_next(st);
                    e = sq_parse_expr(st);
                    if (e < 0) { return 0 - 1; };
                    h.offset_n = e;
                }
                else
                {
                    if (sq_is_op(st, 44))
                    {
                        // LIMIT offset, count
                        sq_next(st);
                        e = sq_parse_expr(st);
                        if (e < 0) { return 0 - 1; };
                        h.offset_n = h.limit_n;
                        h.limit_n = e;
                    };
                };
            };
            st.curblk = curb0;
            return head;
        };

        // ---- binder ----

        // function ids (scalar 1..99, aggregates 100..)
        global int SQ_JFID = 0;

        // JSON scalar functions share one function id (89); the sub-id selects the function (see sq_json_call)
        def sq_json_fid(byte* p, int n) -> int
        {
            if (n == 2) { if (p[0] == (byte)45 & p[1] == (byte)62) { return 9; }; };
            if (n == 3) { if (p[0] == (byte)45 & p[1] == (byte)62 & p[2] == (byte)62) { return 10; }; };
            if (n < 4) { return 0; };
            if (sq_ieq(p, n, "json\0")) { return 1; };
            if (sq_ieq(p, n, "jsonb\0")) { return 101; };
            if (sq_ieq(p, n, "json_valid\0")) { return 2; };
            if (sq_ieq(p, n, "json_quote\0")) { return 3; };
            if (sq_ieq(p, n, "json_type\0")) { return 4; };
            if (sq_ieq(p, n, "json_array_length\0")) { return 5; };
            if (sq_ieq(p, n, "json_array\0")) { return 6; };
            if (sq_ieq(p, n, "jsonb_array\0")) { return 106; };
            if (sq_ieq(p, n, "json_object\0")) { return 7; };
            if (sq_ieq(p, n, "jsonb_object\0")) { return 107; };
            if (sq_ieq(p, n, "json_extract\0")) { return 8; };
            if (sq_ieq(p, n, "jsonb_extract\0")) { return 108; };
            if (sq_ieq(p, n, "json_set\0")) { return 11; };
            if (sq_ieq(p, n, "jsonb_set\0")) { return 111; };
            if (sq_ieq(p, n, "json_insert\0")) { return 12; };
            if (sq_ieq(p, n, "jsonb_insert\0")) { return 112; };
            if (sq_ieq(p, n, "json_replace\0")) { return 13; };
            if (sq_ieq(p, n, "jsonb_replace\0")) { return 113; };
            if (sq_ieq(p, n, "json_remove\0")) { return 14; };
            if (sq_ieq(p, n, "jsonb_remove\0")) { return 114; };
            if (sq_ieq(p, n, "json_array_insert\0")) { return 15; };
            if (sq_ieq(p, n, "jsonb_array_insert\0")) { return 115; };
            if (sq_ieq(p, n, "json_patch\0")) { return 16; };
            if (sq_ieq(p, n, "jsonb_patch\0")) { return 116; };
            if (sq_ieq(p, n, "json_pretty\0")) { return 17; };
            if (sq_ieq(p, n, "json_error_position\0")) { return 18; };
            return 0;
        };

        def sq_json_arity_ok(int fid, int argc) -> bool
        {
            int op = fid % 100;
            if (op == 1 | op == 3 | op == 18) { return argc == 1; };
            if (op == 2 | op == 4 | op == 5 | op == 17) { return argc == 1 | argc == 2; };
            if (op == 6 | op == 7) { return argc >= 0; };
            if (op == 9 | op == 10 | op == 16) { return argc == 2; };
            return argc >= 1;
        };

        def sq_func_id(byte* p, int n, int argc) -> int
        {
            SQ_JFID = sq_json_fid(p, n);
            if (SQ_JFID > 0) { return 89; };
            if (sq_ieq(p, n, "json_group_array\0")) { return 112; };
            if (sq_ieq(p, n, "jsonb_group_array\0")) { return 113; };
            if (sq_ieq(p, n, "json_group_object\0")) { return 114; };
            if (sq_ieq(p, n, "jsonb_group_object\0")) { return 115; };
            if (sq_ieq(p, n, "count\0")) { return 100; };
            if (sq_ieq(p, n, "sum\0")) { return 101; };
            if (sq_ieq(p, n, "total\0")) { return 102; };
            if (sq_ieq(p, n, "avg\0")) { return 103; };
            if (sq_ieq(p, n, "min\0")) { if (argc == 1) { return 104; }; return 11; };
            if (sq_ieq(p, n, "max\0")) { if (argc == 1) { return 105; }; return 12; };
            if (sq_ieq(p, n, "group_concat\0")) { return 106; };
            if (sq_ieq(p, n, "string_agg\0")) { return 107; };
            if (sq_ieq(p, n, "median\0")) { return 108; };
            if (sq_ieq(p, n, "percentile\0")) { return 109; };
            if (sq_ieq(p, n, "percentile_cont\0")) { return 110; };
            if (sq_ieq(p, n, "percentile_disc\0")) { return 111; };
            if (sq_ieq(p, n, "coalesce\0")) { return 1; };
            if (sq_ieq(p, n, "ifnull\0")) { return 2; };
            if (sq_ieq(p, n, "typeof\0")) { return 3; };
            if (sq_ieq(p, n, "abs\0")) { return 4; };
            if (sq_ieq(p, n, "length\0")) { return 5; };
            if (sq_ieq(p, n, "upper\0")) { return 6; };
            if (sq_ieq(p, n, "lower\0")) { return 7; };
            if (sq_ieq(p, n, "substr\0") | sq_ieq(p, n, "substring\0")) { return 8; };
            if (sq_ieq(p, n, "nullif\0")) { return 9; };
            if (sq_ieq(p, n, "round\0")) { return 10; };
            if (sq_ieq(p, n, "hex\0")) { return 13; };
            if (sq_ieq(p, n, "replace\0")) { return 14; };
            if (sq_ieq(p, n, "trim\0")) { return 15; };
            if (sq_ieq(p, n, "ltrim\0")) { return 16; };
            if (sq_ieq(p, n, "rtrim\0")) { return 17; };
            if (sq_ieq(p, n, "instr\0")) { return 18; };
            if (sq_ieq(p, n, "printf\0") | sq_ieq(p, n, "format\0")) { return 19; };
            if (sq_ieq(p, n, "quote\0")) { return 20; };
            if (sq_ieq(p, n, "char\0")) { return 21; };
            if (sq_ieq(p, n, "unicode\0")) { return 22; };
            if (sq_ieq(p, n, "random\0")) { return 23; };
            if (sq_ieq(p, n, "randomblob\0")) { return 24; };
            if (sq_ieq(p, n, "zeroblob\0")) { return 25; };
            if (sq_ieq(p, n, "sign\0")) { return 26; };
            if (sq_ieq(p, n, "iif\0") | sq_ieq(p, n, "if\0")) { return 27; };
            if (sq_ieq(p, n, "concat\0")) { return 75; };
            if (sq_ieq(p, n, "concat_ws\0")) { return 76; };
            if (sq_ieq(p, n, "octet_length\0")) { return 77; };
            if (sq_ieq(p, n, "unhex\0")) { return 78; };
            if (sq_ieq(p, n, "timediff\0")) { return 79; };
            if (sq_ieq(p, n, "unistr\0")) { return 80; };
            if (sq_ieq(p, n, "unistr_quote\0")) { return 81; };
            if (sq_ieq(p, n, "subtype\0")) { return 82; };
            if (sq_ieq(p, n, "sqlite_compileoption_used\0")) { return 83; };
            if (sq_ieq(p, n, "sqlite_compileoption_get\0")) { return 84; };
            if (sq_ieq(p, n, "sqlite_source_id\0")) { return 85; };
            if (sq_ieq(p, n, "sqlite_log\0")) { return 86; };
            if (sq_ieq(p, n, "load_extension\0")) { return 87; };
            if (sq_ieq(p, n, "match\0")) { return 88; };
            if (sq_ieq(p, n, "like\0")) { return 28; };
            if (sq_ieq(p, n, "glob\0")) { return 29; };
            if (sq_ieq(p, n, "date\0")) { return 31; };
            if (sq_ieq(p, n, "time\0")) { return 32; };
            if (sq_ieq(p, n, "datetime\0")) { return 33; };
            if (sq_ieq(p, n, "julianday\0")) { return 34; };
            if (sq_ieq(p, n, "strftime\0")) { return 35; };
            if (sq_ieq(p, n, "unixepoch\0")) { return 36; };
            if (sq_ieq(p, n, "current_timestamp\0")) { return 37; };
            if (sq_ieq(p, n, "current_date\0")) { return 38; };
            if (sq_ieq(p, n, "current_time\0")) { return 39; };
            if (sq_ieq(p, n, "last_insert_rowid\0")) { return 40; };
            if (sq_ieq(p, n, "changes\0")) { return 41; };
            if (sq_ieq(p, n, "total_changes\0")) { return 42; };
            if (sq_ieq(p, n, "sqlite_version\0")) { return 43; };
            if (sq_ieq(p, n, "ceil\0") | sq_ieq(p, n, "ceiling\0")) { return 44; };
            if (sq_ieq(p, n, "floor\0")) { return 45; };
            if (sq_ieq(p, n, "sqrt\0")) { return 46; };
            if (sq_ieq(p, n, "pow\0") | sq_ieq(p, n, "power\0")) { return 47; };
            if (sq_ieq(p, n, "mod\0")) { return 48; };
            if (sq_ieq(p, n, "exp\0")) { return 49; };
            if (sq_ieq(p, n, "ln\0")) { return 50; };
            if (sq_ieq(p, n, "log\0")) { return 51; };
            if (sq_ieq(p, n, "log10\0")) { return 74; };
            if (sq_ieq(p, n, "log2\0")) { return 52; };
            if (sq_ieq(p, n, "pi\0")) { return 53; };
            if (sq_ieq(p, n, "sin\0")) { return 54; };
            if (sq_ieq(p, n, "cos\0")) { return 55; };
            if (sq_ieq(p, n, "tan\0")) { return 56; };
            if (sq_ieq(p, n, "atan\0")) { return 57; };
            if (sq_ieq(p, n, "atan2\0")) { return 58; };
            if (sq_ieq(p, n, "raise\0")) { return 60; };
            if (sq_ieq(p, n, "asin\0")) { return 61; };
            if (sq_ieq(p, n, "acos\0")) { return 62; };
            if (sq_ieq(p, n, "sinh\0")) { return 63; };
            if (sq_ieq(p, n, "cosh\0")) { return 64; };
            if (sq_ieq(p, n, "tanh\0")) { return 65; };
            if (sq_ieq(p, n, "asinh\0")) { return 66; };
            if (sq_ieq(p, n, "acosh\0")) { return 67; };
            if (sq_ieq(p, n, "atanh\0")) { return 68; };
            if (sq_ieq(p, n, "degrees\0")) { return 69; };
            if (sq_ieq(p, n, "radians\0")) { return 70; };
            if (sq_ieq(p, n, "trunc\0")) { return 71; };
            if (sq_ieq(p, n, "max_len\0")) { return 0 - 1; };
            if (sq_ieq(p, n, "likely\0")) { return 59; };
            if (sq_ieq(p, n, "unlikely\0")) { return 72; };
            if (sq_ieq(p, n, "likelihood\0")) { return 73; };
            if (sq_ieq(p, n, "ltrim\0")) { return 16; };
            if (sq_ieq(p, n, "lastrowid\0")) { return 0 - 1; };
            return 0 - 1;
        };

        // window-only functions (ids 200..)
        def sq_wfunc_id(byte* p, int n) -> int
        {
            if (sq_ieq(p, n, "row_number\0")) { return 200; };
            if (sq_ieq(p, n, "rank\0")) { return 201; };
            if (sq_ieq(p, n, "dense_rank\0")) { return 202; };
            if (sq_ieq(p, n, "percent_rank\0")) { return 203; };
            if (sq_ieq(p, n, "cume_dist\0")) { return 204; };
            if (sq_ieq(p, n, "ntile\0")) { return 205; };
            if (sq_ieq(p, n, "lag\0")) { return 206; };
            if (sq_ieq(p, n, "lead\0")) { return 207; };
            if (sq_ieq(p, n, "first_value\0")) { return 208; };
            if (sq_ieq(p, n, "last_value\0")) { return 209; };
            if (sq_ieq(p, n, "nth_value\0")) { return 210; };
            return 0 - 1;
        };

        def sq_warity_ok(int id, int argc) -> bool
        {
            if (id >= 200 & id <= 204) { return argc == 0; };
            if (id == 205 | id == 208 | id == 209) { return argc == 1; };
            if (id == 206 | id == 207) { return argc >= 1 & argc <= 3; };
            if (id == 210) { return argc == 2; };
            return false;
        };

        def sq_col_name(SQ_STMT* st, SQ_BLK* b, SQ_NODE* nd, int* s, int* l) -> byte*;

        // name of result column i of block b: returns the text base and sets s, l
        def sq_res_name(SQ_STMT* st, SQ_BLK* b, int i, int* s, int* l) -> byte*
        {
            SQ_NODE* nd;
            SQ_SRC* sr;
            if (b.rnl[i] >= 0)
            {
                *s = b.rns[i];
                *l = b.rnl[i];
                return @st.sql[0];
            };
            return sq_col_name(st, b, @st.nodes[b.rc[i]], s, l);
        };

        // name of a bound column reference node
        def sq_col_name(SQ_STMT* st, SQ_BLK* b, SQ_NODE* nd, int* s, int* l) -> byte*
        {
            SQ_SRC* sr;
            if (nd.src >= 0 & nd.kind == SQN_COL & nd.lvl == 0)
            {
                sr = @b.src[nd.src];
                if ((u64)sr.ti != (u64)0 & nd.col == sr.ti.ncols & sr.ti.ipk >= 0)
                {
                    *s = sr.ti.cs[sr.ti.ipk];
                    *l = sr.ti.cl[sr.ti.ipk];
                    return sr.ti.base;
                };
                if ((u64)sr.ti != (u64)0 & nd.col < sr.ti.ncols)
                {
                    *s = sr.ti.cs[nd.col];
                    *l = sr.ti.cl[nd.col];
                    return sr.ti.base;
                };
                *s = nd.s;
                *l = nd.sl;
                return @st.sql[0];
            };
            *s = nd.s;
            *l = nd.sl;
            return @st.sql[0];
        };

        // "ambiguous column name: <name>" for a name that lives in a table text
        def sq_seterr_amb(SQ_STMT* st, byte* base, int s, int l) -> void
        {
            int i = 0;
            int k;
            byte* msg = "ambiguous column name: \0";
            if (st.err[0] != (byte)0) { return; };
            while (msg[i] != (byte)0) { st.err[i] = msg[i]; i++; };
            for (k = 0; k < l & i < 150; k++) { st.err[i] = base[s + k]; i++; };
            st.err[i] = (byte)0;
        };

        // "ambiguous reference to <name> in USING()"
        def sq_seterr_ref(SQ_STMT* st, byte* base, int s, int l) -> void
        {
            int i = 0;
            int k;
            byte* msg = "ambiguous reference to \0";
            if (st.err[0] != (byte)0) { return; };
            while (msg[i] != (byte)0) { st.err[i] = msg[i]; i++; };
            for (k = 0; k < l & i < 120; k++) { st.err[i] = base[s + k]; i++; };
            msg = " in USING()\0";
            k = 0;
            while (msg[k] != (byte)0) { st.err[i] = msg[k]; i++; k++; };
            st.err[i] = (byte)0;
        };

        def sq_bind_block_a(SQ_STMT* st, int bi) -> int;
        def sq_set_alts(SQ_STMT* st, SQ_BLK* b, int ni) -> void;

        // builds column info for a derived source from its block
        def sq_derive_ti(SQ_STMT* st, SQ_SRC* sr) -> int
        {
            SQ_BLK* sb = st.blks[sr.blk];
            SQ_TI* t;
            SQ_NODE* cn;
            int i, s, l, j, k, dup, stem, cnt, ns, nl;
            byte* base;
            if (sq_bind_block_a(st, sr.blk) != 0) { return 1; };
            t = sq_ti_alloc(st);
            if ((u64)t == (u64)0) { return 1; };
            t.base = @st.sql[0];
            t.ncols = sb.nres;
            t.ipk = 0 - 1; t.autoinc = 0; t.nchk = 0; t.npk = 0; t.nuq = 0;
            for (i = 0; i < sb.nres; i++)
            {
                base = sq_res_name(st, sb, i, @s, @l);
                // an unaliased column wrapped in COLLATE is named after the column
                if (sb.rnl[i] >= 0 & st.nodes[sb.rc[i]].kind == SQN_COLLATE)
                {
                    cn = @st.nodes[sb.rc[i]];
                    while (cn.kind == SQN_COLLATE) { cn = @st.nodes[cn.a]; };
                    if (cn.kind == SQN_COL & sb.rns[i] <= cn.s) { base = sq_col_name(st, sb, cn, @s, @l); };
                };
                if ((u64)base != (u64)t.base)
                {
                    // names that live in another table text are copied into the statement buffer
                    if (st.sqllen + l + 2 >= 262144) { sq_seterr(st, "statement too large\0"); return 1; };
                    sq_mcpy(@st.sql[st.sqllen + 1], @base[s], l);
                    s = st.sqllen + 1;
                    st.sqllen = st.sqllen + l + 1;
                    st.lim = st.sqllen;
                };
                // duplicate names get a ":N" suffix
                dup = 0;
                for (j = 0; j < i; j++) { if (sq_tname_eq(t.base, t.cs[j], t.cl[j], t.base, s, l)) { dup = 1; }; };
                if (dup == 1)
                {
                    stem = l;
                    k = l - 1;
                    while (k > 0 & t.base[s + k] >= (byte)48 & t.base[s + k] <= (byte)57) { k--; };
                    if (k > 0 & k < l - 1 & t.base[s + k] == (byte)58) { stem = k; };
                    cnt = 0;
                    while (dup == 1)
                    {
                        cnt++;
                        if (st.sqllen + stem + 24 >= 262144) { sq_seterr(st, "statement too large\0"); return 1; };
                        ns = st.sqllen + 1;
                        sq_mcpy(@st.sql[ns], @t.base[s], stem);
                        nl = stem;
                        st.sql[ns + nl] = (byte)58;
                        nl++;
                        nl = nl + sq_itoa((i64)cnt, @st.sql[ns + nl]);
                        dup = 0;
                        for (j = 0; j < i; j++) { if (sq_tname_eq(t.base, t.cs[j], t.cl[j], t.base, ns, nl)) { dup = 1; }; };
                    };
                    st.sqllen = ns + nl;
                    st.lim = st.sqllen;
                    s = ns; l = nl;
                };
                t.cs[i] = s; t.cl[i] = l; t.aff[i] = 0; t.coll[i] = 0; t.notnull[i] = 0; t.pk[i] = 0; t.uniq[i] = 0; t.hid[i] = 0;
                t.dfs[i] = 0; t.dfl[i] = 0; t.chs[i] = 0; t.chl[i] = 0; t.ity[i] = 0;
            };
            sr.ti = t;
            sr.ncols = sb.nres;
            return 0;
        };

        global byte* SQ_MASTER_SQL = "CREATE TABLE sqlite_master(type text,name text,tbl_name text,rootpage integer,sql text)\0";

        def sq_src_find_col(SQ_STMT* st, SQ_SRC* sr, byte* p, int s, int l, int allow_hid) -> int
        {
            int k;
            SQ_TI* ti = sr.ti;
            if ((u64)ti == (u64)0) { return 0 - 1; };
            for (k = 0; k < ti.ncols; k++)
            {
                if (ti.hid[k] == 1 & allow_hid == 0 & sr.kind != 3) { continue; };
                if (sq_tname_eq(ti.base, ti.cs[k], ti.cl[k], p, s, l)) { return k; };
            };
            return 0 - 1;
        };

        def sq_is_rowid_name(byte* p, int l) -> bool
        {
            return sq_ieq(p, l, "rowid\0") | sq_ieq(p, l, "_rowid_\0") | sq_ieq(p, l, "oid\0");
        };

        def sq_bind_block_a(SQ_STMT* st, int bi) -> int
        {
            SQ_BLK* b = st.blks[bi];
            SQ_SRC* sr;
            SQ_SRC* o;
            SQ_NODE* nd;
            int j, k, i, m, s, l, q, ncol, nn0, ni, found, jt, c, qs0, ql0, anyrf;
            byte* tsql;
            byte* base;
            if (b.bdone != 0) { return 0; };
            b.bdone = 1;
            for (j = 0; j < b.nsrc; j++)
            {
                sr = @b.src[j];
                if (sr.kind == 3)
                {
                    sr.ti = sq_ti_alloc(st);
                    if ((u64)sr.ti == (u64)0) { return 1; };
                    if (sr.tvf == 3) { tsql = sq_sql_copy(sq_ptvf_create(sr.tdef)); }
                    else { tsql = sq_sql_copy("CREATE TABLE x(\"key\",\"value\",\"type\",\"atom\",\"id\",\"parent\",\"fullkey\",\"path\",\"json\",\"root\")\0"); };
                    if ((u64)tsql == (u64)0) { sq_seterr(st, "out of memory\0"); return 1; };
                    if (sq_ti_load(sr.ti, tsql) != 0) { sq_seterr(st, "cannot read table definition\0"); return 1; };
                    if (sr.tvf == 3)
                    {
                        m = sq_ptvf_hid(sr.tdef);
                        if (m == 3) { sr.ti.hid[sr.ti.ncols - 1] = 1; sr.ti.hid[sr.ti.ncols - 2] = 1; };
                        if (m == 2 | m == 1) { sr.ti.hid[sr.ti.ncols - 1] = 1; };
                    }
                    else { sr.ti.hid[8] = 1; sr.ti.hid[9] = 1; };
                    sr.ncols = sr.ti.ncols;
                    continue;
                };
                if (sr.kind == 2)
                {
                    if (sq_derive_ti(st, sr) != 0) { return 1; };
                    if (sr.cte >= 0) { sr.rs_shared = 1; };
                }
                else
                {
                    sr.ti = sq_ti_alloc(st);
                    if ((u64)sr.ti == (u64)0) { return 1; };
                    if (sr.tbl >= 0)
                    {
                        tsql = sq_sql_copy(sr.sdb.schema[sr.tbl].sql);
                        if ((u64)tsql == (u64)0) { sq_seterr(st, "out of memory\0"); return 1; };
                    }
                    else { tsql = sq_sql_copy(SQ_MASTER_SQL); };
                    if (sq_ti_load(sr.ti, tsql) != 0) { sq_seterr(st, "cannot read table definition\0"); return 1; };
                    sr.ncols = sr.ti.ncols;
                };
            };
            // USING and NATURAL joins
            anyrf = 0;
            for (j = 1; j < b.nsrc; j++) { if (b.src[j].jt >= 4) { anyrf = 1; }; };
            for (j = 1; j < b.nsrc; j++)
            {
                sr = @b.src[j];
                if (sr.natural == 1)
                {
                    sr.nusing = 0;
                    for (k = 0; k < sr.ti.ncols; k++)
                    {
                        found = 0;
                        for (i = 0; i < j; i++)
                        {
                            o = @b.src[i];
                            c = sq_src_find_col(st, o, sr.ti.base, sr.ti.cs[k], sr.ti.cl[k], 0);
                            if (c >= 0)
                            {
                                found++;
                                if (found == 2 & anyrf == 1) { sq_seterr_ref(st, sr.ti.base, sr.ti.cs[k], sr.ti.cl[k]); return 1; };
                                if (found == 1 & sr.nusing < 16)
                                {
                                    sr.uls[sr.nusing] = i; sr.ulc[sr.nusing] = c; sr.urc[sr.nusing] = k;
                                    sr.nusing++;
                                };
                            };
                        };
                    };
                    for (k = 0; k < sr.nusing; k++) { sr.ti.hid[sr.urc[k]] = 1; };
                }
                else
                {
                    if (sr.nusing > 0)
                    {
                        for (k = 0; k < sr.nusing; k++)
                        {
                            found = 0;
                            for (i = 0; i < j; i++)
                            {
                                o = @b.src[i];
                                c = sq_src_find_col(st, o, @st.sql[0], sr.us[k], sr.ul[k], 0);
                                if (c >= 0)
                                {
                                    if (found == 1 & anyrf == 1) { sq_seterr_ref(st, @st.sql[0], sr.us[k], sr.ul[k]); return 1; };
                                    if (found == 0) { sr.uls[k] = i; sr.ulc[k] = c; };
                                    found = 1;
                                };
                            };
                            c = sq_src_find_col(st, sr, @st.sql[0], sr.us[k], sr.ul[k], 0);
                            if (found == 0 | c < 0) { sq_seterr_n(st, "cannot join using column\0", sr.us[k], sr.ul[k]); return 1; };
                            sr.urc[k] = c;
                            sr.ti.hid[c] = 1;
                        };
                    };
                };
            };
            // expand * and t.*
            i = 0;
            while (i < b.nres)
            {
                nd = @st.nodes[b.rc[i]];
                if (nd.kind != SQN_STAR) { i++; continue; };
                qs0 = nd.qs;
                ql0 = nd.ql;
                ncol = 0;
                for (j = 0; j < b.nsrc; j++)
                {
                    sr = @b.src[j];
                    if (ql0 > 0)
                    {
                        if (sr.as_l > 0)
                        {
                            if (sq_tname_eq(@st.sql[0], sr.as_s, sr.as_l, @st.sql[0], qs0, ql0) == false) { continue; };
                        }
                        else
                        {
                            if (sq_tname_eq(@st.sql[0], sr.ts, sr.tl, @st.sql[0], qs0, ql0) == false) { continue; };
                        };
                    };
                    for (k = 0; k < sr.ti.ncols; k++)
                    {
                        if (sr.ti.hid[k] == 1 & ql0 == 0) { continue; };
                        ncol++;
                    };
                };
                if (ncol == 0) { sq_seterr(st, "no tables specified or no matching columns for *\0"); return 1; };
                if (b.nres - 1 + ncol > 128) { sq_seterr(st, "too many result columns\0"); return 1; };
                // shift the tail
                for (m = b.nres - 1; m > i; m--)
                {
                    b.rc[m + ncol - 1] = b.rc[m];
                    b.rns[m + ncol - 1] = b.rns[m];
                    b.rnl[m + ncol - 1] = b.rnl[m];
                };
                b.nres = b.nres - 1 + ncol;
                q = i;
                for (j = 0; j < b.nsrc; j++)
                {
                    sr = @b.src[j];
                    if (ql0 > 0)
                    {
                        if (sr.as_l > 0)
                        {
                            if (sq_tname_eq(@st.sql[0], sr.as_s, sr.as_l, @st.sql[0], qs0, ql0) == false) { continue; };
                        }
                        else
                        {
                            if (sq_tname_eq(@st.sql[0], sr.ts, sr.tl, @st.sql[0], qs0, ql0) == false) { continue; };
                        };
                    };
                    for (k = 0; k < sr.ti.ncols; k++)
                    {
                        if (sr.ti.hid[k] == 1 & ql0 == 0) { continue; };
                        ni = sq_newnode(st, SQN_COL);
                        if (ni < 0) { return 1; };
                        st.nodes[ni].owner = bi;
                        st.nodes[ni].src = j;
                        st.nodes[ni].col = k;
                        st.nodes[ni].lvl = 0;
                        st.nodes[ni].aff = sr.ti.aff[k];
                        st.nodes[ni].coll = sr.ti.coll[k];
                        sq_set_alts(st, b, ni);
                        if (st.nodes[ni].iv != (i64)0)
                        {
                            // a merged USING column clashes with a visible column of the same name elsewhere
                            for (m = 0; m < b.nsrc; m++)
                            {
                                if (m == j) { continue; };
                                if (sq_src_find_col(st, @b.src[m], sr.ti.base, sr.ti.cs[k], sr.ti.cl[k], 0) >= 0)
                                {
                                    sq_seterr_amb(st, sr.ti.base, sr.ti.cs[k], sr.ti.cl[k]);
                                    return 1;
                                };
                            };
                        };
                        b.rc[q] = ni;
                        b.rnl[q] = 0 - 1;
                        q++;
                    };
                };
                i = i + ncol;
            };
            if (b.cnext >= 0) { if (sq_bind_block_a(st, b.cnext) != 0) { return 1; }; };
            return 0;
        };

        // matches a qualifier against a source
        def sq_src_is(SQ_STMT* st, SQ_SRC* sr, int qs, int ql) -> bool
        {
            if (sr.as_l > 0) { return sq_tname_eq(@st.sql[0], sr.as_s, sr.as_l, @st.sql[0], qs, ql); };
            return sq_tname_eq(@st.sql[0], sr.ts, sr.tl, @st.sql[0], qs, ql);
        };

        // a column that is one side of a USING / NATURAL join with a RIGHT or FULL joined source reads the other side when it is NULL
        def sq_set_alts(SQ_STMT* st, SQ_BLK* b, int ni) -> void
        {
            SQ_NODE* nd = @st.nodes[ni];
            SQ_SRC* sr;
            int k, u, n, a, anyrf;
            i64 pk;
            pk = (i64)0;
            n = 0;
            anyrf = 0;
            for (k = 1; k < b.nsrc; k++) { if (b.src[k].jt >= 4) { anyrf = 1; }; };
            if (anyrf == 0) { nd.iv = pk; return; };
            for (k = nd.src + 1; k < b.nsrc; k++)
            {
                sr = @b.src[k];
                for (u = 0; u < sr.nusing; u++)
                {
                    if (sr.uls[u] == nd.src & sr.ulc[u] == nd.col & n < 2)
                    {
                        a = k * 256 + sr.urc[u] + 1;
                        pk = pk | ((i64)a << (i64)(16 * n));
                        n++;
                    };
                };
            };
            nd.iv = pk;
        };

        def sq_bind_col(SQ_STMT* st, int ni) -> int
        {
            SQ_NODE* nd = @st.nodes[ni];
            SQ_BLK* b;
            SQ_SRC* sr;
            int bi, lvl, j, c, hits, hj, hc, hh, k, ai, saved, prev, skipb;
            byte* nm = @st.sql[nd.s];
            bi = nd.owner;
            lvl = 0;
            prev = 0 - 1;
            while (bi >= 0)
            {
                b = st.blks[bi];
                hits = 0; hj = 0 - 1; hc = 0 - 1;
                // a subquery in a FROM clause cannot see the other items of that clause
                skipb = 0;
                if (prev >= 0)
                {
                    for (j = 0; j < b.nsrc; j++)
                    {
                        if (b.src[j].kind == 2 & b.src[j].blk == prev) { skipb = 1; };
                    };
                };
                for (j = 0; j < b.nsrc; j++)
                {
                    if (skipb == 1) { break; };
                    sr = @b.src[j];
                    if (nd.ql > 0)
                    {
                        if (sq_src_is(st, sr, nd.qs, nd.ql) == false) { continue; };
                    };
                    c = sq_src_find_col(st, sr, @st.sql[0], nd.s, nd.sl, 0);
                    if (c < 0 & nd.ql > 0) { c = sq_src_find_col(st, sr, @st.sql[0], nd.s, nd.sl, 1); };
                    if (c < 0)
                    {
                        if (sq_is_rowid_name(nm, nd.sl) & sr.kind == 1) { if (sr.ti.wor == 0) { c = sr.ti.ncols; }; };
                    };
                    if (c >= 0)
                    {
                        hits++;
                        if (hj < 0) { hj = j; hc = c; };
                    };
                };
                if (hits > 1)
                {
                    sq_seterr_n(st, "ambiguous column name\0", nd.s, nd.sl);
                    return 1;
                };
                if (hits == 1)
                {
                    nd.src = hj;
                    nd.col = hc;
                    nd.lvl = lvl;
                    nd.rblk = bi;
                    if (nd.ql == 0) { sq_set_alts(st, b, ni); };
                    sr = @b.src[hj];
                    if (hc < sr.ti.ncols) { nd.aff = sr.ti.aff[hc]; nd.coll = sr.ti.coll[hc]; }
                    else { nd.aff = 3; nd.coll = 0; };
                    if (lvl > 0)
                    {
                        // every block between the use and the definition depends on an outer row
                        k = nd.owner;
                        while (k >= 0 & k != bi)
                        {
                            st.blks[k].is_corr = 1;
                            k = st.blks[k].parent;
                        };
                    };
                    return 0;
                };
                if (nd.ql == 0 & lvl == 0)
                {
                    // a result column alias
                    b = st.blks[nd.owner];
                    for (ai = 0; ai < b.nres; ai++)
                    {
                        if (b.rnl[ai] > 0)
                        {
                            if (sq_tname_eq(@st.sql[0], b.rns[ai], b.rnl[ai], @st.sql[0], nd.s, nd.sl) & st.nodes[b.rc[ai]].kind != SQN_COL)
                            {
                                saved = nd.next;
                                sq_mcpy((byte*)nd, (byte*)@st.nodes[b.rc[ai]], sq_nsz());
                                nd.next = saved;
                                return 0;
                            };
                        };
                    };
                };
                prev = bi;
                bi = st.blks[bi].parent;
                lvl++;
            };
            if (nd.ql > 0)
            {
                if (nd.qs + nd.ql + 1 == nd.s) { sq_seterr_n(st, "no such column\0", nd.qs, nd.ql + 1 + nd.sl); return 1; };
            };
            sq_seterr_n(st, "no such column\0", nd.s, nd.sl);
            return 1;
        };

        // argument count check for scalar functions
        def sq_arity_ok(int id, int argc) -> bool
        {
            if (id == 1) { return argc >= 2; };
            if (id == 2 | id == 9 | id == 29 | id == 47 | id == 48 | id == 58 | id == 18) { return argc == 2; };
            if (id == 3 | id == 4 | id == 5 | id == 6 | id == 7 | id == 13 | id == 20 | id == 22 | id == 24 | id == 25 | id == 26) { return argc == 1; };
            if (id == 44 | id == 45 | id == 46 | id == 49 | id == 50 | id == 52 | id == 54 | id == 55 | id == 56 | id == 57 | id == 72 | id == 74) { return argc == 1; };
            if (id == 28) { return argc == 2 | argc == 3; };
            if (id == 75) { return argc >= 1; };
            if (id == 76) { return argc >= 2; };
            if (id == 77 | id == 80 | id == 81 | id == 82 | id == 83 | id == 84) { return argc == 1; };
            if (id == 78 | id == 87) { return argc == 1 | argc == 2; };
            if (id == 79 | id == 86 | id == 88) { return argc == 2; };
            if (id == 85) { return argc == 0; };
            if (id == 51) { return argc == 1 | argc == 2; };
            if (id == 59) { return argc == 1; };
            if (id == 73) { return argc == 2; };
            if (id >= 61 & id <= 71) { return argc == 1; };
            if (id == 8) { return argc == 2 | argc == 3; };
            if (id == 10) { return argc == 1 | argc == 2; };
            if (id == 11 | id == 12) { return argc >= 2; };
            if (id == 14) { return argc == 3; };
            if (id == 27) { return argc >= 2; };
            if (id == 15 | id == 16 | id == 17) { return argc == 1 | argc == 2; };
            if (id == 19) { return argc >= 1; };
            if (id == 21) { return true; };
            if (id == 23 | id == 40 | id == 41 | id == 42 | id == 43 | id == 53 | id == 37 | id == 38 | id == 39) { return argc == 0; };
            if (id >= 31 & id <= 36) { return true; };
            return true;
        };

        def sq_agg_arity_ok(int id, int argc, int star) -> bool
        {
            if (id == 100) { return star == 1 | argc == 1; };
            if (id == 106) { return argc == 1 | argc == 2; };
            if (id == 107 | id == 109 | id == 110 | id == 111 | id == 114 | id == 115) { return argc == 2; };
            return argc == 1;
        };

        // ordinal and result-column terms of ORDER BY / GROUP BY
        def sq_fix_terms(SQ_STMT* st, int bi) -> int
        {
            SQ_BLK* b = st.blks[bi];
            SQ_NODE* nd;
            int i, k, saved, n, found, s, l, arm;
            byte* base;
            if (b.star_cnt == 1) { return 0; };
            b.star_cnt = 1;
            for (i = 0; i < b.nord; i++)
            {
                nd = @st.nodes[b.ord[i]];
                if (nd.kind == SQN_COLLATE)
                {
                    b.ocoll[i] = (int)nd.iv;
                    b.ord[i] = nd.a;
                    nd = @st.nodes[b.ord[i]];
                };
                if (b.cnext >= 0)
                {
                    // compound: the term must name a result column
                    found = 0 - 1;
                    if (nd.kind == SQN_INT)
                    {
                        if (nd.iv >= (i64)1 & nd.iv <= (i64)b.nres) { found = (int)nd.iv - 1; };
                    };
                    if (nd.kind == SQN_COL & nd.ql == 0)
                    {
                        for (k = 0; k < b.nres; k++)
                        {
                            base = sq_res_name(st, b, k, @s, @l);
                            if (sq_tname_eq(base, s, l, @st.sql[0], nd.s, nd.sl)) { found = k; break; };
                        };
                        // names given in the later arms of the compound also match
                        arm = b.cnext;
                        while (found < 0 & arm >= 0)
                        {
                            for (k = 0; k < st.blks[arm].nres & k < b.nres; k++)
                            {
                                base = sq_res_name(st, st.blks[arm], k, @s, @l);
                                if (sq_tname_eq(base, s, l, @st.sql[0], nd.s, nd.sl)) { found = k; break; };
                            };
                            arm = st.blks[arm].cnext;
                        };
                    };
                    if (found < 0) { sq_seterr(st, "ORDER BY term does not match any column in the result set\0"); return 1; };
                    nd.kind = SQN_RESREF;
                    nd.iv = (i64)found;
                }
                else
                {
                    if (nd.kind == SQN_COL & nd.ql == 0)
                    {
                        // an ORDER BY name matches a result alias before any table column
                        for (k = 0; k < b.nres; k++)
                        {
                            if (b.rnl[k] > 0)
                            {
                                if (sq_tname_eq(@st.sql[0], b.rns[k], b.rnl[k], @st.sql[0], nd.s, nd.sl))
                                {
                                    saved = nd.next;
                                    sq_mcpy((byte*)nd, (byte*)@st.nodes[b.rc[k]], sq_nsz());
                                    nd.next = saved;
                                    break;
                                };
                            };
                        };
                    };
                    if (nd.kind == SQN_INT)
                    {
                        if (nd.iv < (i64)1 | nd.iv > (i64)b.nres) { sq_seterr(st, "ORDER BY term out of range\0"); return 1; };
                        k = (int)nd.iv - 1;
                        saved = nd.next;
                        sq_mcpy((byte*)nd, (byte*)@st.nodes[b.rc[k]], sq_nsz());
                        nd.next = saved;
                    };
                };
            };
            for (i = 0; i < b.ngrp; i++)
            {
                nd = @st.nodes[b.grp[i]];
                if (nd.kind == SQN_INT)
                {
                    if (nd.iv < (i64)1 | nd.iv > (i64)b.nres) { sq_seterr(st, "GROUP BY term out of range\0"); return 1; };
                    k = (int)nd.iv - 1;
                    saved = nd.next;
                    sq_mcpy((byte*)nd, (byte*)@st.nodes[b.rc[k]], sq_nsz());
                    nd.next = saved;
                };
            };
            return 0;
        };

        // Binds every block and every node of the statement. Safe to call again after more nodes were added.
        def sq_win_err(SQ_STMT* st, byte* pre, int s, int l) -> void
        {
            int i = 0;
            int k = 0;
            if (st.err[0] != (byte)0) { return; };
            while (pre[k] != (byte)0) { st.err[i] = pre[k]; i++; k++; };
            for (k = 0; k < l & i < 150; k++) { st.err[i] = st.sql[s + k]; i++; };
            st.err[i] = (byte)0;
        };

        // folds the base window d into w
        def sq_win_apply(SQ_STMT* st, SQ_WIN* w, SQ_WIN* d, int pure) -> int
        {
            int i;
            if (pure == 1)
            {
                w.np = d.np; w.no = d.no; w.ftype = d.ftype; w.sk = d.sk; w.ek = d.ek; w.sn = d.sn; w.en = d.en; w.excl = d.excl;
                for (i = 0; i < 8; i++) { w.part[i] = d.part[i]; w.ord[i] = d.ord[i]; w.odesc[i] = d.odesc[i]; w.onull[i] = d.onull[i]; };
                w.hasbase = 0;
                return 0;
            };
            if (w.np > 0) { sq_win_err(st, "cannot override PARTITION clause of window: \0", w.bs, w.bl); return 1; };
            w.np = d.np;
            for (i = 0; i < 8; i++) { w.part[i] = d.part[i]; };
            if (w.no > 0)
            {
                if (d.no > 0) { sq_win_err(st, "cannot override ORDER BY clause of window: \0", w.bs, w.bl); return 1; };
            }
            else
            {
                w.no = d.no;
                for (i = 0; i < 8; i++) { w.ord[i] = d.ord[i]; w.odesc[i] = d.odesc[i]; w.onull[i] = d.onull[i]; };
            };
            if (w.ftype > 0)
            {
                if (d.ftype > 0) { sq_win_err(st, "cannot override frame specification of window: \0", w.bs, w.bl); return 1; };
            }
            else
            {
                w.ftype = d.ftype; w.sk = d.sk; w.ek = d.ek; w.sn = d.sn; w.en = d.en; w.excl = d.excl;
            };
            w.hasbase = 0;
            return 0;
        };

        def sq_win_find(SQ_STMT* st, int s, int l, int upto) -> int
        {
            int k;
            for (k = 0; k < upto; k++)
            {
                if (sq_tname_eq(@st.sql[0], st.wdefs[k].dns, st.wdefs[k].dnl, @st.sql[0], s, l)) { return k; };
            };
            return 0 - 1;
        };

        def sq_win_resolve(SQ_STMT* st) -> int
        {
            int i, k;
            SQ_WIN* w;
            for (i = 0; i < st.nwdef; i++)
            {
                w = @st.wdefs[i];
                if (w.hasbase == 1)
                {
                    k = sq_win_find(st, w.bs, w.bl, i);
                    if (k < 0) { sq_win_err(st, "no such window: \0", w.bs, w.bl); return 1; };
                    if (sq_win_apply(st, w, @st.wdefs[k], 0) != 0) { return 1; };
                };
            };
            for (i = 0; i < st.nwin; i++)
            {
                w = @st.wins[i];
                if (w.hasbase == 1)
                {
                    k = sq_win_find(st, w.bs, w.bl, st.nwdef);
                    if (k < 0) { sq_win_err(st, "no such window: \0", w.bs, w.bl); return 1; };
                    if (w.ftype < 0) { w.ftype = 0; if (sq_win_apply(st, w, @st.wdefs[k], 1) != 0) { return 1; }; }
                    else { if (sq_win_apply(st, w, @st.wdefs[k], 0) != 0) { return 1; }; };
                };
            };
            return 0;
        };

        // first plain aggregate call inside an expression (subqueries excluded), or -1
        def sq_find_aggfn(SQ_STMT* st, int ni) -> int
        {
            SQ_NODE* nd;
            int c, r, id;
            if (ni < 0) { return 0 - 1; };
            nd = @st.nodes[ni];
            if (nd.kind == SQN_FUNC)
            {
                if (nd.win < 0)
                {
                    id = sq_func_id(@st.sql[nd.s], nd.sl, (int)nd.iv);
                    if (id >= 100) { return ni; };
                };
            };
            if (nd.kind == SQN_SUBQ | nd.kind == SQN_EXISTS) { return 0 - 1; };
            c = nd.a;
            while (c >= 0) { r = sq_find_aggfn(st, c); if (r >= 0) { return r; }; c = st.nodes[c].next; };
            c = nd.b;
            while (c >= 0) { r = sq_find_aggfn(st, c); if (r >= 0) { return r; }; c = st.nodes[c].next; };
            c = nd.c;
            while (c >= 0) { r = sq_find_aggfn(st, c); if (r >= 0) { return r; }; c = st.nodes[c].next; };
            return 0 - 1;
        };

        // counts column references of an expression that belong to its own query level and to outer levels
        def sq_count_refs(SQ_STMT* st, int ni, int* loc, int* outer) -> void
        {
            SQ_NODE* nd;
            int c;
            if (ni < 0) { return; };
            nd = @st.nodes[ni];
            if (nd.kind == SQN_COL)
            {
                if (nd.lvl > 0) { *outer = *outer + 1; } else { *loc = *loc + 1; };
            };
            if (nd.kind == SQN_SUBQ | nd.kind == SQN_EXISTS) { return; };
            c = nd.a;
            while (c >= 0) { sq_count_refs(st, c, loc, outer); c = st.nodes[c].next; };
            c = nd.b;
            while (c >= 0) { sq_count_refs(st, c, loc, outer); c = st.nodes[c].next; };
            c = nd.c;
            while (c >= 0) { sq_count_refs(st, c, loc, outer); c = st.nodes[c].next; };
        };

        // aggregates may not nest and may not appear in WHERE, ON or GROUP BY
        def sq_check_agg_use(SQ_STMT* st) -> int
        {
            int ni, bi, c, r, j, id, k;
            SQ_NODE* nd;
            SQ_BLK* b;
            for (ni = 0; ni < st.nn; ni++)
            {
                nd = @st.nodes[ni];
                if (nd.kind != SQN_FUNC) { continue; };
                if (nd.win >= 0) { continue; };
                id = sq_func_id(@st.sql[nd.s], nd.sl, (int)nd.iv);
                if (id < 100) { continue; };
                if (nd.owner < 0) { sq_seterr_win(st, "misuse of aggregate function \0", ni, "()\0"); return 1; };
                j = 0; k = 0;
                c = nd.a;
                while (c >= 0) { sq_count_refs(st, c, @j, @k); c = st.nodes[c].next; };
                if (k > 0 & j == 0) { sq_seterr(st, "an aggregate that refers only to outer columns is not supported\0"); return 1; };
                c = nd.a;
                while (c >= 0)
                {
                    r = sq_find_aggfn(st, c);
                    if (r >= 0) { sq_seterr_win(st, "misuse of aggregate function \0", r, "()\0"); return 1; };
                    c = st.nodes[c].next;
                };
                if (nd.c >= 0)
                {
                    r = sq_find_aggfn(st, nd.c);
                    if (r >= 0) { sq_seterr_win(st, "misuse of aggregate function \0", r, "()\0"); return 1; };
                };
                c = nd.b;
                while (c >= 0)
                {
                    r = sq_find_aggfn(st, c);
                    if (r >= 0) { sq_seterr_win(st, "misuse of aggregate function \0", r, "()\0"); return 1; };
                    c = st.nodes[c].next;
                };
            };
            if (SQ_NOAGG == 1 & st.root_blk >= 0)
            {
                b = @st.blks[st.root_blk];
                for (k = 0; k < b.nres; k++)
                {
                    r = sq_find_aggfn(st, b.rc[k]);
                    if (r >= 0) { sq_seterr_win(st, "misuse of aggregate function \0", r, "()\0"); return 1; };
                };
            };
            for (bi = 0; bi < st.nblk; bi++)
            {
                b = @st.blks[bi];
                if (b.where_n >= 0)
                {
                    r = sq_find_aggfn(st, b.where_n);
                    if (r >= 0) { sq_seterr_win(st, "misuse of aggregate function \0", r, "()\0"); return 1; };
                };
                if (b.limit_n >= 0)
                {
                    r = sq_find_aggfn(st, b.limit_n);
                    if (r >= 0) { sq_seterr_win(st, "misuse of aggregate function \0", r, "()\0"); return 1; };
                };
                if (b.offset_n >= 0)
                {
                    r = sq_find_aggfn(st, b.offset_n);
                    if (r >= 0) { sq_seterr_win(st, "misuse of aggregate function \0", r, "()\0"); return 1; };
                };
                for (k = 0; k < b.ngrp; k++)
                {
                    r = sq_find_aggfn(st, b.grp[k]);
                    if (r >= 0) { sq_seterr(st, "aggregate functions are not allowed in the GROUP BY clause\0"); return 1; };
                };
                for (j = 0; j < b.nsrc; j++)
                {
                    if (b.src[j].on >= 0)
                    {
                        r = sq_find_aggfn(st, b.src[j].on);
                        if (r >= 0) { sq_seterr_win(st, "misuse of aggregate function \0", r, "()\0"); return 1; };
                    };
                };
            };
            return 0;
        };

        def sq_bind_all(SQ_STMT* st) -> int
        {
            int bi, ni, id, argc, ob, star, ai;
            SQ_NODE* nd;
            SQ_BLK* b;
            if (st.bn == 0) { if (sq_win_resolve(st) != 0) { return 1; }; };
            for (bi = 0; bi < st.nblk; bi++)
            {
                if (sq_bind_block_a(st, bi) != 0) { return 1; };
            };
            for (bi = 0; bi < st.nblk; bi++)
            {
                if (st.blks[bi].nord > 0 | st.blks[bi].ngrp > 0)
                {
                    if (st.blks[bi].nres > 0 | st.blks[bi].cnext >= 0)
                    {
                        if (sq_fix_terms(st, bi) != 0) { return 1; };
                    };
                };
            };
            for (ni = st.bn; ni < st.nn; ni++)
            {
                nd = @st.nodes[ni];
                if (nd.kind == SQN_COL & nd.src < 0)
                {
                    if (sq_bind_col(st, ni) != 0) { return 1; };
                };
                nd = @st.nodes[ni];
                if (nd.kind == SQN_ROW & nd.op == 0) { sq_seterr(st, "row value misused\0"); return 1; };
                if (nd.kind == SQN_SUBQ & nd.op > 0)
                {
                    if (st.blks[nd.blk].nres < nd.op) { sq_seterr_asg(st, nd.op, st.blks[nd.blk].nres); return 1; };
                };
                if (nd.kind == SQN_IN & nd.blk >= 0)
                {
                    if (st.nodes[nd.a].kind == SQN_ROW)
                    {
                        if (st.blks[nd.blk].nres != (int)st.nodes[nd.a].iv)
                        {
                            sq_seterr_cols(st, st.blks[nd.blk].nres, (int)st.nodes[nd.a].iv);
                            return 1;
                        };
                    }
                    else
                    {
                        if (st.blks[nd.blk].nres > 1) { sq_seterr_cols(st, st.blks[nd.blk].nres, 1); return 1; };
                    };
                };
                if (nd.kind == SQN_FUNC)
                {
                    argc = (int)nd.iv;
                    id = sq_func_id(@st.sql[nd.s], nd.sl, argc);
                    if (id < 0)
                    {
                        id = sq_wfunc_id(@st.sql[nd.s], nd.sl);
                        if (id >= 0 & nd.win < 0) { sq_seterr_win(st, "misuse of window function \0", ni, "()\0"); return 1; };
                    };
                    if (id < 0) { sq_seterr_n(st, "no such function\0", nd.s, nd.sl); return 1; };
                    if (id == 60 & SQ_TRIG_DEPTH == 0) { sq_seterr(st, "RAISE() may only be used within a trigger-program\0"); return 1; };
                    nd.col = id;
                    if (id == 89) { nd.ql = SQ_JFID; };
                    if (nd.b >= 0 & (id < 100 | nd.win >= 0)) { sq_seterr_win(st, "ORDER BY may not be used with non-aggregate \0", ni, "()\0"); return 1; };
                    if (nd.win >= 0)
                    {
                        if (id < 100) { sq_seterr_win(st, "\0", ni, "() may not be used as a window function\0"); return 1; };
                        if (nd.op == 1) { sq_seterr(st, "DISTINCT is not supported for window functions\0"); return 1; };
                        if (id >= 200)
                        {
                            if (sq_warity_ok(id, argc) == false) { sq_seterr_win(st, "wrong number of arguments to function \0", ni, "()\0"); return 1; };
                        }
                        else
                        {
                            star = 0;
                            if (nd.op == 2) { star = 1; };
                            if (sq_agg_arity_ok(id, argc, star) == false) { sq_seterr_win(st, "wrong number of arguments to function \0", ni, "()\0"); return 1; };
                        };
                        b = st.blks[nd.owner];
                        if (b.nwin >= 16) { sq_seterr(st, "too many window functions\0"); return 1; };
                        b.winn[b.nwin] = ni;
                        nd.agg = b.nwin;
                        b.nwin++;
                        continue;
                    };
                    if (id >= 100)
                    {
                        star = 0;
                        if (nd.op == 2) { star = 1; };
                        if (sq_agg_arity_ok(id, argc, star) == false) { sq_seterr_n(st, "wrong number of arguments to function\0", nd.s, nd.sl); return 1; };
                        if (nd.op == 1 & argc != 1) { sq_seterr(st, "DISTINCT aggregates must have exactly one argument\0"); return 1; };
                        b = st.blks[nd.owner];
                        if (b.nagg >= 32) { sq_seterr(st, "too many aggregates\0"); return 1; };
                        b.aggn[b.nagg] = ni;
                        nd.agg = b.nagg;
                        b.nagg++;
                        b.has_agg = 1;
                    }
                    else
                    {
                        if (id == 89)
                        {
                            if (sq_json_arity_ok(nd.ql, argc) == false) { sq_seterr_n(st, "wrong number of arguments to function\0", nd.s, nd.sl); return 1; };
                        }
                        else
                        {
                            if (sq_arity_ok(id, argc) == false) { sq_seterr_n(st, "wrong number of arguments to function\0", nd.s, nd.sl); return 1; };
                        };
                    };
                };
            };
            if (sq_check_agg_use(st) != 0) { return 1; };
            st.bn = st.nn;
            return 0;
        };

        // ---- evaluation ----

        def sq_eval(SQ_STMT* st, SQ_BLK* b, int ni, SQ_VAL* out) -> void;
        def sq_run_block(SQ_STMT* st, int bi, int maxrows) -> SQ_RS*;
        def sq_rs_free(SQ_RS* rs) -> void;
        def sq_rs_done(SQ_STMT* st, int bi, SQ_RS* rs) -> void;

        def sq_scr(SQ_BLK* b, int n) -> byte*
        {
            return sq_ar_alloc(@b.scr, n);
        };

        def sq_val_tri(SQ_VAL* o, int t) -> void
        {
            if (t < 0) { sq_val_null(o); } else { sq_val_int(o, (i64)t); };
        };

        def sq_val_bool(SQ_VAL* o, bool t) -> void
        {
            if (t) { sq_val_int(o, (i64)1); } else { sq_val_int(o, (i64)0); };
        };

        // affinity of an expression for comparisons
        def sq_eaff(SQ_STMT* st, int ni) -> int
        {
            SQ_NODE* nd = @st.nodes[ni];
            if (nd.kind == SQN_COL) { return nd.aff; };
            if (nd.kind == SQN_CAST) { return (int)nd.iv; };
            if (nd.kind == SQN_COLLATE) { return sq_eaff(st, nd.a); };
            return 0;
        };

        def sq_ecoll(SQ_STMT* st, int ni) -> int
        {
            SQ_NODE* nd = @st.nodes[ni];
            if (nd.kind == SQN_COLLATE) { return (int)nd.iv; };
            if (nd.kind == SQN_COL) { return nd.coll; };
            return 0;
        };

        // true when the node tree contains an explicit COLLATE or a column (for collation lookup)
        def sq_cmp_coll(SQ_STMT* st, int a, int b) -> int
        {
            int c = sq_ecoll(st, a);
            if (c != 0) { return c; };
            return sq_ecoll(st, b);
        };

        // applies the comparison affinity rules to the two values
        def sq_cmp_aff(SQ_STMT* st, SQ_BLK* blk, int na, int nb, SQ_VAL* x, SQ_VAL* y) -> void
        {
            int ea = sq_eaff(st, na);
            int eb = sq_eaff(st, nb);
            if (ea >= 2 & eb < 2) { if (y.t == SQ_TEXT) { sq_apply_aff(@blk.scr, 2, y); }; return; };
            if (eb >= 2 & ea < 2) { if (x.t == SQ_TEXT) { sq_apply_aff(@blk.scr, 2, x); }; return; };
            if (ea == 1 & eb == 0) { sq_apply_aff(@blk.scr, 1, y); return; };
            if (eb == 1 & ea == 0) { sq_apply_aff(@blk.scr, 1, x); return; };
        };

        // text view of a value for LIKE, || and string functions
        def sq_as_text(SQ_BLK* b, SQ_VAL* v, SQ_VAL* o) -> void
        {
            sq_val_text(@b.scr, v, o);
        };

        def sq_unquote(SQ_BLK* b, byte* p, int n, SQ_VAL* out) -> void
        {
            int i, k, dbl;
            byte* r;
            dbl = 0;
            for (i = 0; i + 1 < n; i++) { if (p[i] == (byte)39 & p[i + 1] == (byte)39) { dbl = 1; break; }; };
            out.t = SQ_TEXT; out.i = (i64)0; out.r = 0.0;
            if (dbl == 0) { out.p = p; out.n = n; return; };
            r = sq_scr(b, n + 1);
            if ((u64)r == (u64)0) { sq_val_null(out); return; };
            k = 0;
            i = 0;
            while (i < n)
            {
                r[k] = p[i];
                k++;
                if (p[i] == (byte)39 & i + 1 < n) { if (p[i + 1] == (byte)39) { i++; }; };
                i++;
            };
            out.p = r; out.n = k;
        };

        def sq_hexv(byte c) -> int
        {
            if (c >= (byte)48 & c <= (byte)57) { return (int)c - 48; };
            if (c >= (byte)97 & c <= (byte)102) { return (int)c - 87; };
            if (c >= (byte)65 & c <= (byte)70) { return (int)c - 55; };
            return 0;
        };

        // column value from a source row
        def sq_colv(SQ_STMT* st, SQ_BLK* b, SQ_NODE* nd, SQ_VAL* out) -> void
        {
            SQ_BLK* blk = b;
            SQ_SRC* sr;
            SQ_RS* rs;
            int lvl = nd.lvl;
            int r;
            while (lvl > 0)
            {
                if (blk.parent < 0) { sq_val_null(out); return; };
                blk = st.blks[blk.parent];
                lvl--;
            };
            sr = @blk.src[nd.src];
            r = blk.cur[nd.src];
            rs = sr.rs;
            if (r < 0 | (u64)rs == (u64)0) { sq_val_null(out); return; };
            sq_val_copy(out, @rs.d[r * rs.nc + nd.col]);
        };

        // the column of a USING / NATURAL join that is merged with the same named columns of RIGHT and FULL joined sources
        def sq_colv_alts(SQ_STMT* st, SQ_BLK* b, SQ_NODE* nd, SQ_VAL* out) -> void
        {
            SQ_BLK* blk = b;
            SQ_SRC* sr;
            SQ_RS* rs;
            int lvl = nd.lvl;
            int k, alt, r, a2;
            i64 pk;
            while (lvl > 0)
            {
                if (blk.parent < 0) { return; };
                blk = st.blks[blk.parent];
                lvl--;
            };
            pk = nd.iv;
            for (k = 0; k < 2; k++)
            {
                if (out.t != SQ_NULL) { return; };
                alt = (int)(pk `& (i64)65535) - 1;
                pk = pk >> (i64)16;
                if (alt < 0) { return; };
                a2 = alt / 256;
                sr = @blk.src[a2];
                r = blk.cur[a2];
                rs = sr.rs;
                if (r < 0 | (u64)rs == (u64)0) { continue; };
                sq_val_copy(out, @rs.d[r * rs.nc + (alt % 256)]);
            };
        };

        // runs a subquery block and returns the first value; found is set to 1 when a row existed
        def sq_subq_first(SQ_STMT* st, SQ_BLK* b, int bi, SQ_VAL* out, int* found, int ci) -> void
        {
            SQ_RS* rs = sq_run_block(st, bi, 1);
            *found = 0;
            sq_val_null(out);
            if ((u64)rs == (u64)0) { return; };
            if (rs.n > 0 & rs.nc > ci)
            {
                *found = 1;
                sq_val_copy(out, @rs.d[ci]);
                sq_val_own(@b.scr, out);
            };
            sq_rs_done(st, bi, rs);
        };

        def sq_eval_cmp(SQ_STMT* st, SQ_BLK* b, SQ_NODE* nd, SQ_VAL* out) -> void
        {
            SQ_VAL x, y;
            int op = nd.op;
            int na = nd.a;
            int nb = nd.b;
            int c, coll;
            sq_eval(st, b, na, @x);
            sq_eval(st, b, nb, @y);
            if (op == SQO_IS | op == SQO_ISNOT)
            {
                if (x.t == SQ_NULL | y.t == SQ_NULL)
                {
                    c = 0;
                    if (x.t == SQ_NULL & y.t == SQ_NULL) { c = 1; };
                }
                else
                {
                    sq_cmp_aff(st, b, na, nb, @x, @y);
                    coll = sq_cmp_coll(st, na, nb);
                    c = 0;
                    if (sq_val_cmpc(@x, @y, coll) == 0) { c = 1; };
                };
                if (op == SQO_ISNOT) { c = 1 - c; };
                sq_val_int(out, (i64)c);
                return;
            };
            if (x.t == SQ_NULL | y.t == SQ_NULL) { sq_val_null(out); return; };
            sq_cmp_aff(st, b, na, nb, @x, @y);
            coll = sq_cmp_coll(st, na, nb);
            c = sq_val_cmpc(@x, @y, coll);
            if (op == SQO_EQ) { sq_val_bool(out, c == 0); return; };
            if (op == SQO_NE) { sq_val_bool(out, c != 0); return; };
            if (op == SQO_LT) { sq_val_bool(out, c < 0); return; };
            if (op == SQO_LE) { sq_val_bool(out, c <= 0); return; };
            if (op == SQO_GT) { sq_val_bool(out, c > 0); return; };
            sq_val_bool(out, c >= 0);
        };

        // equality used by IN and CASE, with affinity rules; 1 equal, 0 not equal, -1 null involved
        def sq_eq_nodes(SQ_STMT* st, SQ_BLK* b, int na, int nb, SQ_VAL* x0, SQ_VAL* y0) -> int
        {
            SQ_VAL x, y;
            sq_val_copy(@x, x0);
            sq_val_copy(@y, y0);
            if (x.t == SQ_NULL | y.t == SQ_NULL) { return 0 - 1; };
            sq_cmp_aff(st, b, na, nb, @x, @y);
            if (sq_val_cmpc(@x, @y, sq_cmp_coll(st, na, nb)) == 0) { return 1; };
            return 0;
        };

        def sq_call_func(SQ_STMT* st, SQ_BLK* b, SQ_NODE* nd, SQ_VAL* out) -> void;
        def sq_call_datetime(SQ_STMT* st, SQ_BLK* blk, int id, SQ_VAL* a, int argc, SQ_VAL* out) -> void;

        def sq_eval_rowin(SQ_STMT* st, SQ_BLK* b, SQ_NODE* nd, SQ_VAL* out) -> void
        {
            SQ_VAL[16] xs;
            SQ_VAL y;
            int i, n, e, r, seen, found, el, anynull, q;
            int[16] en;
            SQ_RS* rs;
            n = (int)st.nodes[nd.a].iv;
            el = st.nodes[nd.a].a;
            for (i = 0; i < n; i++)
            {
                sq_eval(st, b, el, @xs[i]);
                en[i] = el;
                el = st.nodes[el].next;
            };
            found = 0;
            seen = 0;
            rs = sq_run_block(st, nd.blk, 0 - 1);
            if ((u64)rs != (u64)0)
            {
                for (r = 0; r < rs.n; r++)
                {
                    anynull = 0;
                    e = 1;
                    for (i = 0; i < n; i++)
                    {
                        sq_val_copy(@y, @rs.d[r * rs.nc + i]);
                        q = sq_eq_nodes(st, b, en[i], en[i], @xs[i], @y);
                        if (q == 0) { e = 0; break; };
                        if (q < 0) { anynull = 1; };
                    };
                    if (e == 1 & anynull == 0) { found = 1; break; };
                    if (e == 1 & anynull == 1) { seen = 1; };
                };
                sq_rs_done(st, nd.blk, rs);
            };
            if (found == 1) { if (nd.op == 2) { sq_val_int(out, (i64)0); } else { sq_val_int(out, (i64)1); }; return; };
            if (seen == 1) { sq_val_null(out); return; };
            if (nd.op == 2) { sq_val_int(out, (i64)1); } else { sq_val_int(out, (i64)0); };
        };

        def sq_eval(SQ_STMT* st, SQ_BLK* b, int ni, SQ_VAL* out) -> void
        {
            SQ_NODE* nd = @st.nodes[ni];
            SQ_VAL x, y, z, t;
            int k, c, found, seen, e, w;
            byte* r;
            int kind = nd.kind;
            if (kind == SQN_COL)
            {
                sq_colv(st, b, nd, out);
                if (nd.iv != (i64)0) { sq_colv_alts(st, b, nd, out); };
                return;
            };
            if (kind == SQN_INT) { sq_val_int(out, nd.iv); return; };
            if (kind == SQN_REAL) { sq_val_real(out, nd.rv); return; };
            if (kind == SQN_NULL) { sq_val_null(out); return; };
            if (kind == SQN_STR) { sq_unquote(b, @st.sql[nd.s], nd.sl, out); return; };
            if (kind == SQN_BLOB)
            {
                r = sq_scr(b, nd.sl / 2 + 1);
                if ((u64)r == (u64)0) { sq_val_null(out); return; };
                for (k = 0; k + 1 < nd.sl; k = k + 2)
                {
                    r[k / 2] = (byte)(sq_hexv(st.sql[nd.s + k]) * 16 + sq_hexv(st.sql[nd.s + k + 1]));
                };
                out.t = SQ_BLOB; out.p = r; out.n = nd.sl / 2; out.i = (i64)0; out.r = 0.0;
                return;
            };
            if (kind == SQN_PARAM)
            {
                k = (int)nd.iv - 1;
                sq_val_copy(out, @st.pv[k]);
                return;
            };
            if (kind == SQN_COLLATE) { sq_eval(st, b, nd.a, out); return; };
            if (kind == SQN_UNARY)
            {
                sq_eval(st, b, nd.a, @x);
                if (nd.op == 4) { sq_val_copy(out, @x); return; };
                if (nd.op == 2)
                {
                    c = sq_truth(@x);
                    if (c < 0) { sq_val_null(out); } else { sq_val_int(out, (i64)(1 - c)); };
                    return;
                };
                if (x.t == SQ_NULL) { sq_val_null(out); return; };
                sq_tonum(@x, @y);
                if (nd.op == 3)
                {
                    sq_cast((SQ_ARENA*)0, @x, 3, @y);
                    sq_val_int(out, (i64)0 - y.i - (i64)1);
                    return;
                };
                if (y.t == SQ_INTEGER)
                {
                    if (y.i == (i64)0 - (i64)9223372036854775807 - (i64)1) { sq_val_real(out, 9223372036854775808.0); return; };
                    sq_val_int(out, (i64)0 - y.i);
                    return;
                };
                sq_val_real(out, 0.0 - y.r);
                return;
            };
            if (kind == SQN_BIN)
            {
                c = nd.op;
                if (c == SQO_AND | c == SQO_OR)
                {
                    sq_eval(st, b, nd.a, @x);
                    k = sq_truth(@x);
                    if (c == SQO_AND)
                    {
                        if (k == 0) { sq_val_int(out, (i64)0); return; };
                        sq_eval(st, b, nd.b, @y);
                        e = sq_truth(@y);
                        if (e == 0) { sq_val_int(out, (i64)0); return; };
                        if (k < 0 | e < 0) { sq_val_null(out); return; };
                        sq_val_int(out, (i64)1);
                        return;
                    };
                    if (k == 1) { sq_val_int(out, (i64)1); return; };
                    sq_eval(st, b, nd.b, @y);
                    e = sq_truth(@y);
                    if (e == 1) { sq_val_int(out, (i64)1); return; };
                    if (k < 0 | e < 0) { sq_val_null(out); return; };
                    sq_val_int(out, (i64)0);
                    return;
                };
                if (c >= SQO_EQ & c <= SQO_GE) { sq_eval_cmp(st, b, nd, out); return; };
                if (c == SQO_IS | c == SQO_ISNOT) { sq_eval_cmp(st, b, nd, out); return; };
                sq_eval(st, b, nd.a, @x);
                sq_eval(st, b, nd.b, @y);
                if (c == SQO_CAT)
                {
                    if (x.t == SQ_NULL | y.t == SQ_NULL) { sq_val_null(out); return; };
                    sq_val_text(@b.scr, @x, @z);
                    sq_val_text(@b.scr, @y, @t);
                    r = sq_scr(b, z.n + t.n + 1);
                    if ((u64)r == (u64)0) { sq_val_null(out); return; };
                    sq_mcpy(r, z.p, z.n);
                    sq_mcpy(@r[z.n], t.p, t.n);
                    out.t = SQ_TEXT; out.p = r; out.n = z.n + t.n; out.i = (i64)0; out.r = 0.0;
                    return;
                };
                if (c >= SQO_BAND) { sq_bitop(c, @x, @y, out); return; };
                sq_arith(c, @x, @y, out);
                return;
            };
            if (kind == SQN_ISNULL)
            {
                sq_eval(st, b, nd.a, @x);
                if (nd.op == 1) { sq_val_bool(out, x.t == SQ_NULL); } else { sq_val_bool(out, x.t != SQ_NULL); };
                return;
            };
            if (kind == SQN_IN)
            {
                if (st.nodes[nd.a].kind == SQN_ROW) { sq_eval_rowin(st, b, nd, out); return; };
                sq_eval(st, b, nd.a, @x);
                if (x.t == SQ_NULL)
                {
                    // NULL IN (empty set) is false, otherwise NULL
                    sq_val_null(out);
                    if (nd.blk < 0 & nd.b < 0) { sq_val_bool(out, nd.op == 2); };
                    return;
                };
                found = 0;
                seen = 0;
                if (nd.blk >= 0)
                {
                    SQ_RS* rs = sq_run_block(st, nd.blk, 0 - 1);
                    if ((u64)rs != (u64)0)
                    {
                        for (k = 0; k < rs.n; k++)
                        {
                            sq_val_copy(@y, @rs.d[k * rs.nc]);
                            e = sq_eq_nodes(st, b, nd.a, nd.blk, @x, @y);
                            if (e == 1) { found = 1; break; };
                            if (e < 0) { seen = 1; };
                        };
                        sq_rs_done(st, nd.blk, rs);
                    };
                }
                else
                {
                    w = nd.b;
                    while (w >= 0)
                    {
                        sq_eval(st, b, w, @y);
                        e = sq_eq_nodes(st, b, nd.a, w, @x, @y);
                        if (e == 1) { found = 1; break; };
                        if (e < 0) { seen = 1; };
                        w = st.nodes[w].next;
                    };
                };
                if (found == 1) { if (nd.op == 2) { sq_val_int(out, (i64)0); } else { sq_val_int(out, (i64)1); }; return; };
                if (seen == 1) { sq_val_null(out); return; };
                if (nd.op == 2) { sq_val_int(out, (i64)1); } else { sq_val_int(out, (i64)0); };
                return;
            };
            if (kind == SQN_BETWEEN)
            {
                sq_eval(st, b, nd.a, @x);
                sq_eval(st, b, nd.b, @y);
                sq_eval(st, b, nd.c, @z);
                k = 0 - 1;
                e = 0 - 1;
                if (x.t != SQ_NULL & y.t != SQ_NULL)
                {
                    sq_val_copy(@t, @x);
                    w = sq_eq_nodes(st, b, nd.a, nd.b, @x, @y);
                    sq_val_copy(@t, @x);
                    sq_cmp_aff(st, b, nd.a, nd.b, @t, @y);
                    if (sq_val_cmpc(@t, @y, sq_cmp_coll(st, nd.a, nd.b)) >= 0) { k = 1; } else { k = 0; };
                };
                if (x.t != SQ_NULL & z.t != SQ_NULL)
                {
                    sq_val_copy(@t, @x);
                    sq_cmp_aff(st, b, nd.a, nd.c, @t, @z);
                    if (sq_val_cmpc(@t, @z, sq_cmp_coll(st, nd.a, nd.c)) <= 0) { e = 1; } else { e = 0; };
                };
                // k AND e
                if (k == 0 | e == 0) { c = 0; }
                else
                {
                    if (k < 0 | e < 0) { c = 0 - 1; } else { c = 1; };
                };
                if (c >= 0 & nd.op == 2) { c = 1 - c; };
                sq_val_tri(out, c);
                return;
            };
            if (kind == SQN_LIKE)
            {
                sq_eval(st, b, nd.a, @x);
                sq_eval(st, b, nd.b, @y);
                if (x.t == SQ_NULL | y.t == SQ_NULL) { sq_val_null(out); return; };
                k = 0 - 1;
                if (nd.c >= 0)
                {
                    sq_eval(st, b, nd.c, @z);
                    if (z.t == SQ_NULL) { sq_val_null(out); return; };
                    sq_val_text(@b.scr, @z, @t);
                    if (t.n > 0) { k = (int)t.p[0]; };
                };
                sq_val_text(@b.scr, @x, @z);
                sq_val_text(@b.scr, @y, @t);
                if (nd.iv == (i64)1) { c = 0; if (sq_glob(t.p, t.n, z.p, z.n)) { c = 1; }; }
                else { c = 0; if (sq_like(t.p, t.n, z.p, z.n, k)) { c = 1; }; };
                if (nd.op == 2) { c = 1 - c; };
                sq_val_int(out, (i64)c);
                return;
            };
            if (kind == SQN_CASE)
            {
                w = nd.b;
                if (nd.a >= 0) { sq_eval(st, b, nd.a, @x); };
                while (w >= 0)
                {
                    sq_eval(st, b, st.nodes[w].a, @y);
                    if (nd.a >= 0) { c = sq_eq_nodes(st, b, nd.a, st.nodes[w].a, @x, @y); }
                    else { c = sq_truth(@y); };
                    if (c == 1) { sq_eval(st, b, st.nodes[w].b, out); return; };
                    w = st.nodes[w].next;
                };
                if (nd.c >= 0) { sq_eval(st, b, nd.c, out); return; };
                sq_val_null(out);
                return;
            };
            if (kind == SQN_CAST)
            {
                sq_eval(st, b, nd.a, @x);
                sq_cast(@b.scr, @x, (int)nd.iv, out);
                return;
            };
            if (kind == SQN_SUBQ)
            {
                sq_subq_first(st, b, nd.blk, out, @found, (int)nd.iv);
                return;
            };
            if (kind == SQN_EXISTS)
            {
                sq_subq_first(st, b, nd.blk, @x, @found, 0);
                sq_val_int(out, (i64)found);
                return;
            };
            if (kind == SQN_FUNC)
            {
                if (nd.win >= 0)
                {
                    sq_val_copy(out, @b.winv[nd.agg * b.wnent + b.wcur]);
                    return;
                };
                if (nd.col >= 100)
                {
                    if ((u64)b.aggv == (u64)0) { sq_val_null(out); return; };
                    sq_val_copy(out, @b.aggv[nd.agg]);
                    return;
                };
                sq_call_func(st, b, nd, out);
                return;
            };
            sq_val_null(out);
        };

        // copy of a literal into scratch memory (literals in frames can dangle)
        def sq_lit(SQ_BLK* b, byte* lit, SQ_VAL* out) -> void
        {
            int n = sq_cstrlen(lit);
            byte* r = sq_scr(b, n + 1);
            if ((u64)r == (u64)0) { sq_val_null(out); return; };
            sq_mcpy(r, lit, n);
            r[n] = (byte)0;
            out.t = SQ_TEXT; out.p = r; out.n = n; out.i = (i64)0; out.r = 0.0;
        };

        def sq_mk_text(SQ_BLK* b, int n, SQ_VAL* out) -> byte*
        {
            byte* r = sq_scr(b, n + 1);
            if ((u64)r == (u64)0) { sq_val_null(out); return r; };
            r[n] = (byte)0;
            out.t = SQ_TEXT; out.p = r; out.n = n; out.i = (i64)0; out.r = 0.0;
            return r;
        };

        // ---- number formatting for printf ----

        // writes the body of a formatted double (no sign) into out and returns its length.
        // conv: 102 f, 101 e, 103 g (lower case only; the caller upper-cases for E and G)
        def sq_fmt_double(byte* out, double v, int conv, int prec, int alt) -> int
        {
            byte[1300] dig;
            byte[24] ex;
            int nd, X, neg, o, i, keep, P, ndg, kk, en, useexp, fprec;
            double av;
            av = v;
            if (av < 0.0) { av = 0.0 - av; };
            neg = sq_real_exact(av, @dig[0], @nd, @X);
            o = 0;
            if (neg == 3) { out[0] = (byte)78; out[1] = (byte)97; out[2] = (byte)78; return 3; };
            if (neg == 2) { out[0] = (byte)73; out[1] = (byte)110; out[2] = (byte)102; return 3; };
            if (neg == 4) { dig[0] = (byte)48; nd = 1; X = 0; };
            if (conv == 103)
            {
                P = prec;
                if (P == 0) { P = 1; };
                if (neg != 4) { X = sq_round_digits(@dig[0], @nd, X, P); };
                if (X < 0 - 4 | X >= P) { conv = 101; prec = P - 1; }
                else { conv = 102; prec = P - 1 - X; };
                // trailing zeros are removed unless the alternate form was asked for
                if (alt == 0) { useexp = 1; } else { useexp = 0; };
                if (useexp == 1)
                {
                    ndg = nd;
                    while (ndg > 1) { if (dig[ndg - 1] == (byte)48) { ndg--; } else { break; }; };
                    if (conv == 101) { prec = ndg - 1; } else { prec = ndg - 1 - X; if (prec < 0) { prec = 0; }; };
                };
            };
            if (conv == 101)
            {
                if (neg != 4) { X = sq_round_digits(@dig[0], @nd, X, prec + 1); };
                out[o] = dig[0]; o++;
                if (prec > 0 | alt == 1) { out[o] = (byte)46; o++; };
                for (i = 1; i <= prec; i++)
                {
                    if (i < nd) { out[o] = dig[i]; } else { out[o] = (byte)48; };
                    o++;
                };
                out[o] = (byte)101; o++;
                kk = X;
                if (neg == 4) { kk = 0; };
                if (kk < 0) { out[o] = (byte)45; kk = 0 - kk; } else { out[o] = (byte)43; };
                o++;
                en = 0;
                if (kk >= 100) { ex[en] = (byte)(48 + kk / 100); en++; kk = kk % 100; };
                ex[en] = (byte)(48 + kk / 10); en++;
                ex[en] = (byte)(48 + kk % 10); en++;
                for (i = 0; i < en; i++) { out[o] = ex[i]; o++; };
                return o;
            };
            // fixed notation
            if (neg != 4)
            {
                keep = X + 1 + prec;
                if (keep < 0)
                {
                    nd = 0;
                }
                else
                {
                    if (keep == 0)
                    {
                        // only the rounding digit decides between 0 and one unit in the last place
                        if (dig[0] >= (byte)53) { dig[0] = (byte)49; nd = 1; X++; keep = 1; }
                        else { nd = 0; };
                    }
                    else { X = sq_round_digits(@dig[0], @nd, X, keep); };
                };
            };
            if (nd == 0 | neg == 4)
            {
                out[o] = (byte)48; o++;
                if (prec > 0 | alt == 1) { out[o] = (byte)46; o++; };
                for (i = 0; i < prec; i++) { out[o] = (byte)48; o++; };
                return o;
            };
            // integer part
            if (X < 0) { out[o] = (byte)48; o++; }
            else
            {
                for (i = 0; i <= X; i++)
                {
                    if (i < nd) { out[o] = dig[i]; } else { out[o] = (byte)48; };
                    o++;
                };
            };
            if (prec > 0 | alt == 1) { out[o] = (byte)46; o++; };
            for (i = 1; i <= prec; i++)
            {
                // fraction digit i has digit index X + i
                kk = X + i;
                if (kk >= 0 & kk < nd) { out[o] = dig[kk]; } else { out[o] = (byte)48; };
                o++;
            };
            return o;
        };

        def sq_utf8_put(byte* out, int cp) -> int
        {
            if (cp < 128) { out[0] = (byte)cp; return 1; };
            if (cp < 2048) { out[0] = (byte)(192 + cp / 64); out[1] = (byte)(128 + cp % 64); return 2; };
            if (cp < 65536)
            {
                out[0] = (byte)(224 + cp / 4096);
                out[1] = (byte)(128 + (cp / 64) % 64);
                out[2] = (byte)(128 + cp % 64);
                return 3;
            };
            out[0] = (byte)(240 + cp / 262144);
            out[1] = (byte)(128 + (cp / 4096) % 64);
            out[2] = (byte)(128 + (cp / 64) % 64);
            out[3] = (byte)(128 + cp % 64);
            return 4;
        };

        def sq_utf8_get(byte* p, int n, int* len) -> int
        {
            int c;
            if (n <= 0) { *len = 0; return 0; };
            c = (int)p[0];
            if (c < 128) { *len = 1; return c; };
            if (c >= 240 & n >= 4) { *len = 4; return ((c - 240) * 262144) + (((int)p[1] - 128) * 4096) + (((int)p[2] - 128) * 64) + ((int)p[3] - 128); };
            if (c >= 224 & n >= 3) { *len = 3; return ((c - 224) * 4096) + (((int)p[1] - 128) * 64) + ((int)p[2] - 128); };
            if (c >= 192 & n >= 2) { *len = 2; return ((c - 192) * 64) + ((int)p[1] - 128); };
            *len = 1;
            return c;
        };

        // printf: format in args[0], values in args[1..argc)
        def sq_printf(SQ_BLK* b, SQ_VAL* args, int argc, SQ_VAL* out) -> void
        {
            SQ_VAL f, v, t;
            byte* fp;
            byte* r;
            byte[1400] num;
            int fn, i, o, cap, ai, minus, plus, space, zero, alt, width, prec, hasprec, conv, nl, pad, neg, k, sl, c, extra, qn, ql;
            i64 iv;
            u64 uv;
            double dv;
            byte[24] db;
            if (args[0].t == SQ_NULL) { sq_val_null(out); return; };
            sq_val_text(@b.scr, @args[0], @f);
            fp = f.p;
            fn = f.n;
            cap = fn * 4 + 64;
            for (i = 0; i < fn; i++)
            {
                if (fp[i] == (byte)37)
                {
                    cap = cap + 700;
                    // a literal width adds its own size; a * width takes the limit
                    k = i + 1;
                    pad = 0;
                    while (k < fn)
                    {
                        if (sq_isdigit(fp[k])) { pad = pad * 10 + ((int)fp[k] - 48); if (pad > 100000) { pad = 100000; }; }
                        else
                        {
                            if (fp[k] == (byte)42) { pad = 100000; }
                            else { if (fp[k] != (byte)46 & fp[k] != (byte)45 & fp[k] != (byte)43 & fp[k] != (byte)32 & fp[k] != (byte)35) { break; }; };
                        };
                        k++;
                    };
                    cap = cap + pad;
                };
            };
            for (i = 1; i < argc; i++)
            {
                if (args[i].t == SQ_TEXT | args[i].t == SQ_BLOB) { cap = cap + args[i].n * 2 + 8; };
                cap = cap + 400;
            };
            r = sq_scr(b, cap);
            if ((u64)r == (u64)0) { sq_val_null(out); return; };
            o = 0;
            ai = 1;
            i = 0;
            while (i < fn)
            {
                if (fp[i] != (byte)37) { r[o] = fp[i]; o++; i++; continue; };
                i++;
                if (i >= fn) { break; };
                minus = 0; plus = 0; space = 0; zero = 0; alt = 0;
                while (i < fn)
                {
                    if (fp[i] == (byte)45) { minus = 1; }
                    else { if (fp[i] == (byte)43) { plus = 1; }
                    else { if (fp[i] == (byte)32) { space = 1; }
                    else { if (fp[i] == (byte)48) { zero = 1; }
                    else { if (fp[i] == (byte)35) { alt = 1; } else { break; }; }; }; }; };
                    i++;
                };
                width = 0;
                if (i < fn & fp[i] == (byte)42)
                {
                    if (ai < argc) { sq_cast((SQ_ARENA*)0, @args[ai], 3, @t); width = (int)t.i; ai++; };
                    if (width < 0) { minus = 1; width = 0 - width; };
                    i++;
                }
                else
                {
                    while (i < fn & sq_isdigit(fp[i])) { width = width * 10 + ((int)fp[i] - 48); i++; };
                };
                hasprec = 0;
                prec = 0;
                if (i < fn & fp[i] == (byte)46)
                {
                    hasprec = 1;
                    i++;
                    if (i < fn & fp[i] == (byte)42)
                    {
                        if (ai < argc) { sq_cast((SQ_ARENA*)0, @args[ai], 3, @t); prec = (int)t.i; ai++; };
                        i++;
                    }
                    else
                    {
                        while (i < fn & sq_isdigit(fp[i])) { prec = prec * 10 + ((int)fp[i] - 48); i++; };
                    };
                };
                while (i < fn & (fp[i] == (byte)108 | fp[i] == (byte)104)) { i++; };
                if (i >= fn) { break; };
                conv = (int)fp[i];
                i++;
                if (width > 100000) { width = 100000; };
                if (prec > 300) { prec = 300; };
                if (conv == 37) { r[o] = (byte)37; o++; continue; };
                nl = 0;
                neg = 0;
                if (conv == 100 | conv == 105)
                {
                    iv = (i64)0;
                    if (ai < argc) { sq_cast((SQ_ARENA*)0, @args[ai], 3, @t); iv = t.i; };
                    ai++;
                    if (iv < (i64)0) { neg = 1; uv = (u64)0 - (u64)iv; } else { uv = (u64)iv; };
                    nl = sq_utoa(uv, @num[0]);
                    if (hasprec == 1) { while (nl < prec) { for (k = nl; k > 0; k--) { num[k] = num[k - 1]; }; num[0] = (byte)48; nl++; }; };
                    if (neg == 0 & plus == 1) { neg = 2; };
                    if (neg == 0 & space == 1) { neg = 3; };
                }
                else
                {
                    if (conv == 117 | conv == 120 | conv == 88 | conv == 111)
                    {
                        uv = (u64)0;
                        if (ai < argc) { sq_cast((SQ_ARENA*)0, @args[ai], 3, @t); uv = (u64)t.i; };
                        ai++;
                        if (conv == 117) { nl = sq_utoa(uv, @num[0]); }
                        else
                        {
                            k = 16;
                            if (conv == 111) { k = 8; };
                            nl = 0;
                            if (uv == (u64)0) { num[0] = (byte)48; nl = 1; };
                            while (uv != (u64)0)
                            {
                                c = (int)(uv % (u64)k);
                                if (c < 10) { num[nl] = (byte)(48 + c); }
                                else { if (conv == 88) { num[nl] = (byte)(55 + c); } else { num[nl] = (byte)(87 + c); }; };
                                nl++;
                                uv = uv / (u64)k;
                            };
                            for (k = 0; k < nl / 2; k++) { c = (int)num[k]; num[k] = num[nl - 1 - k]; num[nl - 1 - k] = (byte)c; };
                        };
                        if (hasprec == 1) { while (nl < prec) { for (k = nl; k > 0; k--) { num[k] = num[k - 1]; }; num[0] = (byte)48; nl++; }; };
                    }
                    else
                    {
                        if (conv == 102 | conv == 101 | conv == 69 | conv == 103 | conv == 71)
                        {
                            dv = 0.0;
                            if (ai < argc) { dv = sq_as_double(@args[ai]); };
                            ai++;
                            if (hasprec == 0) { prec = 6; };
                            if (dv < 0.0) { neg = 1; } else { if (plus == 1) { neg = 2; } else { if (space == 1) { neg = 3; }; }; };
                            k = conv;
                            if (conv == 69) { k = 101; };
                            if (conv == 71) { k = 103; };
                            nl = sq_fmt_double(@num[0], dv, k, prec, alt);
                            if (conv == 69 | conv == 71)
                            {
                                for (k = 0; k < nl; k++) { if (num[k] == (byte)101) { num[k] = (byte)69; }; };
                            };
                        }
                        else
                        {
                            if (conv == 115 | conv == 113 | conv == 81 | conv == 119 | conv == 99)
                            {
                                // string-like conversions are produced straight into the output
                                sq_val_null(@v);
                                if (ai < argc) { sq_val_copy(@v, @args[ai]); };
                                ai++;
                                if (conv == 99)
                                {
                                    sq_val_text(@b.scr, @v, @t);
                                    nl = 0;
                                    if (t.n > 0)
                                    {
                                        nl = 1;
                                        while (nl < t.n)
                                        {
                                            if (((int)t.p[nl] `& 192) == 128) { nl++; } else { break; };
                                        };
                                        sq_mcpy(@num[0], t.p, nl);
                                    };
                                    pad = width - 1;
                                    if (minus == 0) { while (pad > 0) { r[o] = (byte)32; o++; pad--; }; };
                                    for (k = 0; k < nl; k++) { r[o] = num[k]; o++; };
                                    if (minus == 1) { while (pad > 0) { r[o] = (byte)32; o++; pad--; }; };
                                    continue;
                                };
                                if (conv == 81 & v.t == SQ_NULL)
                                {
                                    sq_mcpy(@num[0], "NULL\0", 4);
                                    sl = 4;
                                    sq_val_null(@t);
                                    t.t = SQ_TEXT; t.p = @num[0]; t.n = 4;
                                    sq_mcpy(@r[o], @num[0], 4);
                                    o = o + 4;
                                    continue;
                                };
                                sq_val_text(@b.scr, @v, @t);
                                if (v.t == SQ_NULL) { t.t = SQ_TEXT; t.n = 0; t.p = @num[0]; };
                                sl = t.n;
                                if (hasprec == 1 & conv == 115)
                                {
                                    // precision counts characters
                                    k = sq_utf8_off(t.p, t.n, prec);
                                    sl = k;
                                };
                                qn = 0;
                                if (conv != 115) { for (k = 0; k < sl; k++) { if (t.p[k] == (byte)39 | (conv == 119 & t.p[k] == (byte)34)) { qn++; }; }; };
                                extra = 0;
                                if (conv == 81) { extra = 2; };
                                ql = sl + qn + extra;
                                pad = width - sq_utf8_len(t.p, sl) - qn - extra;
                                if (minus == 0) { while (pad > 0) { r[o] = (byte)32; o++; pad--; }; };
                                if (conv == 81) { r[o] = (byte)39; o++; };
                                for (k = 0; k < sl; k++)
                                {
                                    if (conv != 115)
                                    {
                                        if (t.p[k] == (byte)39 & conv != 119) { r[o] = (byte)39; o++; };
                                        if (conv == 119 & (t.p[k] == (byte)34)) { r[o] = (byte)34; o++; };
                                    };
                                    r[o] = t.p[k];
                                    o++;
                                };
                                if (conv == 81) { r[o] = (byte)39; o++; };
                                if (minus == 1) { while (pad > 0) { r[o] = (byte)32; o++; pad--; }; };
                                continue;
                            }
                            else { continue; };
                        };
                    };
                };
                // numeric padding
                k = nl;
                if (neg != 0) { k++; };
                pad = width - k;
                if (minus == 0 & zero == 0) { while (pad > 0) { r[o] = (byte)32; o++; pad--; }; };
                if (neg == 1) { r[o] = (byte)45; o++; };
                if (neg == 2) { r[o] = (byte)43; o++; };
                if (neg == 3) { r[o] = (byte)32; o++; };
                if (minus == 0 & zero == 1 & hasprec == 0) { while (pad > 0) { r[o] = (byte)48; o++; pad--; }; };
                for (k = 0; k < nl; k++) { r[o] = num[k]; o++; };
                if (minus == 1) { while (pad > 0) { r[o] = (byte)32; o++; pad--; }; };
            };
            r[o] = (byte)0;
            out.t = SQ_TEXT; out.p = r; out.n = o; out.i = (i64)0; out.r = 0.0;
        };


        // decimal digits of a positive finite double rounded the way sqlite3FpDecode does it; returns the count in *pn and the decimal point position in *pdp
        def sq_fpdecode(double r, int iRound, int mxRound, byte* z, int* pn, int* pdp) -> void
        {
            u64 v, vv;
            u64* bp;
            double* dp;
            double rr;
            int e, nn, exp10, i, n, zi, j, k;
            byte[40] tmp;
            byte[48] buf;
            rr = r;
            dp = @rr;
            bp = (u64*)dp;
            v = *bp;
            e = (int)((v >> (u64)52) `& (u64)2047);
            v = v `& (u64)4503599627370495;
            if (e == 0)
            {
                nn = sq_clz64(v);
                v = v << (u64)nn;
                e = 0 - 1074 - nn;
            }
            else
            {
                v = (v << (u64)11) | ((u64)1 << (u64)63);
                e = e - 1086;
            };
            sq_fp2conv10(v, e, 18, @vv, @exp10);
            i = 40;
            while (vv >= (u64)10)
            {
                i--;
                tmp[i] = (byte)(48 + (int)(vv % (u64)10));
                vv = vv / (u64)10;
            };
            if (vv != (u64)0) { i--; tmp[i] = (byte)(48 + (int)vv); };
            n = 40 - i;
            zi = 4;
            for (k = 0; k < n; k++) { buf[zi + k] = tmp[i + k]; };
            *pdp = n + exp10;
            if (iRound <= 0)
            {
                iRound = *pdp - iRound;
                if (iRound == 0 & buf[zi] >= (byte)53)
                {
                    iRound = 1;
                    zi--;
                    buf[zi] = (byte)48;
                    n++;
                    *pdp = *pdp + 1;
                };
            };
            if (iRound > 0 & (iRound < n | n > mxRound))
            {
                if (iRound > mxRound) { iRound = mxRound; };
                n = iRound;
                if (buf[zi + iRound] >= (byte)53)
                {
                    j = iRound - 1;
                    while (true)
                    {
                        buf[zi + j] = (byte)((int)buf[zi + j] + 1);
                        if (buf[zi + j] <= (byte)57) { break; };
                        buf[zi + j] = (byte)48;
                        if (j == 0)
                        {
                            zi--;
                            buf[zi] = (byte)49;
                            n++;
                            *pdp = *pdp + 1;
                            break;
                        }
                        else { j--; };
                    };
                };
            };
            while (n > 0)
            {
                if (buf[zi + n - 1] == (byte)48) { n--; } else { break; };
            };
            for (k = 0; k < n; k++) { z[k] = buf[zi + k]; };
            *pn = n;
        };

        // float conversions of printf (%f %e %g): xtype 1 f, 2 e, 3 g. Output has the sign first; *psign is 1 when one was written
        def sq_fmt_fp(byte* out, double dv, int xtype, int upper, int precision, int flagprefix, int alt, int alt2, int zeropad, int thousand, int* psign) -> int
        {
            byte[48] z;
            int n, dp, iRound, special, o, e2, j, rtz, flagdp, ex, prefix, mx, k;
            double av;
            u64 bits;
            u64* bp;
            double* dpp;
            double tmpd;
            *psign = 0;
            prefix = 0;
            av = dv;
            tmpd = dv;
            dpp = @tmpd;
            bp = (u64*)dpp;
            bits = *bp;
            special = 0;
            if (((bits >> (u64)52) `& (u64)2047) == (u64)2047)
            {
                special = 1;
                if ((bits `& (u64)4503599627370495) != (u64)0) { special = 2; };
            };
            if (precision < 0) { precision = 6; };
            if (xtype == 1) { iRound = 0 - precision; }
            else
            {
                if (xtype == 3) { if (precision == 0) { precision = 1; }; iRound = precision; }
                else { iRound = precision + 1; };
            };
            mx = 16;
            if (alt2 == 1) { mx = 26; };
            o = 0;
            if (special == 2)
            {
                if (zeropad == 1) { sq_mcpy(out, "null\0", 4); return 4; };
                sq_mcpy(out, "NaN\0", 3);
                return 3;
            };
            if ((bits >> (u64)63) != (u64)0 & dv != 0.0) { prefix = 45; }
            else { prefix = flagprefix; };
            if (dv == 0.0)
            {
                z[0] = (byte)48; n = 1; dp = 1;
            }
            else
            {
                if (dv < 0.0) { av = 0.0 - dv; };
                if (special == 1)
                {
                    if (zeropad == 1) { z[0] = (byte)57; n = 1; dp = 1000; }
                    else
                    {
                        if (prefix == 45) { sq_mcpy(out, "-Inf\0", 4); return 4; };
                        if (flagprefix != 0) { out[0] = (byte)flagprefix; sq_mcpy(@out[1], "Inf\0", 3); return 4; };
                        sq_mcpy(out, "Inf\0", 3);
                        return 3;
                    };
                }
                else { sq_fpdecode(av, iRound, mx, @z[0], @n, @dp); };
            };
            ex = dp - 1;
            if (xtype == 3 & precision > 0) { precision--; };
            if (xtype == 3)
            {
                rtz = 1;
                if (alt == 1) { rtz = 0; };
                if (ex < 0 - 4 | ex > precision) { xtype = 2; }
                else { precision = precision - ex; xtype = 1; };
            }
            else { rtz = alt2; };
            if (xtype == 2) { e2 = 0; } else { e2 = dp - 1; };
            flagdp = 0;
            if (precision > 0 | alt == 1 | alt2 == 1) { flagdp = 1; };
            if (prefix != 0) { out[o] = (byte)prefix; o++; *psign = 1; };
            j = 0;
            if (e2 < 0) { out[o] = (byte)48; o++; }
            else
            {
                while (e2 >= 0)
                {
                    if (j < n) { out[o] = z[j]; j++; } else { out[o] = (byte)48; };
                    o++;
                    if (thousand == 1 & (e2 % 3) == 0 & e2 > 1) { out[o] = (byte)44; o++; };
                    e2--;
                };
            };
            if (flagdp == 1) { out[o] = (byte)46; o++; };
            e2++;
            while (e2 < 0 & precision > 0) { out[o] = (byte)48; o++; precision--; e2++; };
            while (precision > 0)
            {
                if (j < n) { out[o] = z[j]; j++; } else { out[o] = (byte)48; };
                o++;
                precision--;
            };
            if (rtz == 1 & flagdp == 1)
            {
                while (out[o - 1] == (byte)48) { o--; };
                if (out[o - 1] == (byte)46)
                {
                    if (alt2 == 1) { out[o] = (byte)48; o++; } else { o--; };
                };
            };
            if (xtype == 2)
            {
                ex = dp - 1;
                if (upper == 1) { out[o] = (byte)69; } else { out[o] = (byte)101; };
                o++;
                if (ex < 0) { out[o] = (byte)45; o++; ex = 0 - ex; } else { out[o] = (byte)43; o++; };
                if (ex >= 100) { out[o] = (byte)(48 + ex / 100); o++; ex = ex % 100; };
                out[o] = (byte)(48 + ex / 10); o++;
                out[o] = (byte)(48 + ex % 10); o++;
            };
            return o;
        };

        // printf as SQLite's sqlite3_str_vappendf runs it for the SQL function
        def sq_printf2(SQ_BLK* b, SQ_VAL* args, int argc, SQ_VAL* out) -> void
        {
            SQ_VAL f, v, t;
            byte* fp;
            byte* r;
            byte* sp;
            byte[1500] num;
            int fn, i, o, cap, ai, c, k, width, prec, flagleft, flagpre, flagalt, flagalt2, zeropad, thousand, flaglong, done, wx, px, sl, appended, pad, plen, nd, zl, nc, sg, l2, ln, qn, ii, need;
            i64 iv;
            u64 uv;
            double dv;
            int cv, sn, ordk;
            if (args[0].t == SQ_NULL) { sq_val_null(out); return; };
            sq_val_text(@b.scr, @args[0], @f);
            fp = f.p;
            fn = f.n;
            // the format ends at its first NUL
            k = 0;
            while (k < fn) { if (fp[k] == (byte)0) { break; }; k++; };
            fn = k;
            cap = fn * 4 + 64;
