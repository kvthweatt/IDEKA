            if (mode == 2 | mode == 3)
            {
                while (e0 > s0)
                {
                    l = sq_trim_match(set, sn, @t.p[s0], e0 - s0, 0);
                    if (l == 0) { break; };
                    e0 = e0 - l;
                };
