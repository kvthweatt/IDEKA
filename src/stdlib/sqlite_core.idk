                                            if (ai < argc) { sq_cast((SQ_ARENA*)0, @args[ai], 3, @t); prec = (int)t.i; };
                                            ai++;
                                            if (prec < 0) { prec = 0 - prec; };
                                            i++;
                                            c = 0;
                                            if (i < fn) { c = (int)fp[i]; };
                                        }
                                        else
                                        {
                                            px = 0;
                                            while (c >= 48 & c <= 57)
                                            {
                                                px = px * 10 + (c - 48);
                                                if (px > 1000000) { px = 1000000; };
                                                i++;
                                                c = 0;
                                                if (i < fn) { c = (int)fp[i]; };
                                            };
                                            prec = px;
                                        };
                                        if (c == 108) { i--; } else { done = 1; };
                                    }
                                    else { done = 1; };
                                };
                            };
                        };
                    }; }; }; }; }; }; };
                    if (done == 1) { break; };
