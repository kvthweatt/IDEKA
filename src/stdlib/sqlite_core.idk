            {
                if (fp[i] == (byte)37)
                {
                    cap = cap + 1500;
                    k = i + 1;
                    pad = 0;
                    while (k < fn)
                    {
                        if (sq_isdigit(fp[k])) { pad = pad * 10 + ((int)fp[k] - 48); if (pad > 100000) { pad = 100000; }; }
                        else
                        {
                            if (fp[k] == (byte)42) { pad = 100000; }
                            else { if (fp[k] != (byte)46 & fp[k] != (byte)45 & fp[k] != (byte)43 & fp[k] != (byte)32 & fp[k] != (byte)35 & fp[k] != (byte)33 & fp[k] != (byte)44) { break; }; };
                        };
                        k++;
                    };
                    cap = cap + pad * 2;
                };
            };
            for (i = 1; i < argc; i++)
            {
                if (args[i].t == SQ_TEXT | args[i].t == SQ_BLOB) { cap = cap + args[i].n * 3 + 16; };
                cap = cap + 600;
            };
            r = sq_scr(b, cap);
            if ((u64)r == (u64)0) { sq_val_null(out); return; };
            o = 0;
            ai = 1;
            i = 0;
            appended = 0;
            while (i < fn)
            {
                if (fp[i] != (byte)37)
                {
                    k = i;
                    while (k < fn) { if (fp[k] == (byte)37) { break; }; k++; };
                    while (i < k) { r[o] = fp[i]; o++; i++; };
                    appended = 1;
                    continue;
                };
                i++;
