byte[18] SCHANNEL_NAME_W = [
    0x53,0x00,0x63,0x00,0x68,0x00,0x61,0x00,  // S c h a
    0x6E,0x00,0x6E,0x00,0x65,0x00,0x6C,0x00,  // n n e l
