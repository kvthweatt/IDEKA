byte[38] BLOB_TYPE_RSAFULLPRIVATE = [
    0x52,0x00,0x53,0x00,0x41,0x00,0x46,0x00,  // R S A F
    0x55,0x00,0x4C,0x00,0x4C,0x00,0x50,0x00,  // U L L P
