                    0x63, 0x7C, 0x77, 0x7B, 0xF2, 0x6B, 0x6F, 0xC5, 0x30, 0x01, 0x67, 0x2B, 0xFE, 0xD7, 0xAB, 0x76,
                    0xCA, 0x82, 0xC9, 0x7D, 0xFA, 0x59, 0x47, 0xF0, 0xAD, 0xD4, 0xA2, 0xAF, 0x9C, 0xA4, 0x72, 0xC0,
                    0xB7, 0xFD, 0x93, 0x26, 0x36, 0x3F, 0xF7, 0xCC, 0x34, 0xA5, 0xE5, 0xF1, 0x71, 0xD8, 0x31, 0x15,
                    0x04, 0xC7, 0x23, 0xC3, 0x18, 0x96, 0x05, 0x9A, 0x07, 0x12, 0x80, 0xE2, 0xEB, 0x27, 0xB2, 0x75,
                    0x09, 0x83, 0x2C, 0x1A, 0x1B, 0x6E, 0x5A, 0xA0, 0x52, 0x3B, 0xD6, 0xB3, 0x29, 0xE3, 0x2F, 0x84,
                    0x53, 0xD1, 0x00, 0xED, 0x20, 0xFC, 0xB1, 0x5B, 0x6A, 0xCB, 0xBE, 0x39, 0x4A, 0x4C, 0x58, 0xCF,
                    0xD0, 0xEF, 0xAA, 0xFB, 0x43, 0x4D, 0x33, 0x85, 0x45, 0xF9, 0x02, 0x7F, 0x50, 0x3C, 0x9F, 0xA8,
                    0x51, 0xA3, 0x40, 0x8F, 0x92, 0x9D, 0x38, 0xF5, 0xBC, 0xB6, 0xDA, 0x21, 0x10, 0xFF, 0xF3, 0xD2,
                    0xCD, 0x0C, 0x13, 0xEC, 0x5F, 0x97, 0x44, 0x17, 0xC4, 0xA7, 0x7E, 0x3D, 0x64, 0x5D, 0x19, 0x73,
                    0x60, 0x81, 0x4F, 0xDC, 0x22, 0x2A, 0x90, 0x88, 0x46, 0xEE, 0xB8, 0x14, 0xDE, 0x5E, 0x0B, 0xDB,
                    0xE0, 0x32, 0x3A, 0x0A, 0x49, 0x06, 0x24, 0x5C, 0xC2, 0xD3, 0xAC, 0x62, 0x91, 0x95, 0xE4, 0x79,
                    0xE7, 0xC8, 0x37, 0x6D, 0x8D, 0xD5, 0x4E, 0xA9, 0x6C, 0x56, 0xF4, 0xEA, 0x65, 0x7A, 0xAE, 0x08,
                    0xBA, 0x78, 0x25, 0x2E, 0x1C, 0xA6, 0xB4, 0xC6, 0xE8, 0xDD, 0x74, 0x1F, 0x4B, 0xBD, 0x8B, 0x8A,
                    0x70, 0x3E, 0xB5, 0x66, 0x48, 0x03, 0xF6, 0x0E, 0x61, 0x35, 0x57, 0xB9, 0x86, 0xC1, 0x1D, 0x9E,
                    0xE1, 0xF8, 0x98, 0x11, 0x69, 0xD9, 0x8E, 0x94, 0x9B, 0x1E, 0x87, 0xE9, 0xCE, 0x55, 0x28, 0xDF,
                    0x8C, 0xA1, 0x89, 0x0D, 0xBF, 0xE6, 0x42, 0x68, 0x41, 0x99, 0x2D, 0x0F, 0xB0, 0x54, 0xBB, 0x16
                ];
                
                // Inverse S-Box (for decryption)
                const byte[256] INV_SBOX = [
                    0x52, 0x09, 0x6A, 0xD5, 0x30, 0x36, 0xA5, 0x38, 0xBF, 0x40, 0xA3, 0x9E, 0x81, 0xF3, 0xD7, 0xFB,
                    0x7C, 0xE3, 0x39, 0x82, 0x9B, 0x2F, 0xFF, 0x87, 0x34, 0x8E, 0x43, 0x44, 0xC4, 0xDE, 0xE9, 0xCB,
                    0x54, 0x7B, 0x94, 0x32, 0xA6, 0xC2, 0x23, 0x3D, 0xEE, 0x4C, 0x95, 0x0B, 0x42, 0xFA, 0xC3, 0x4E,
                    0x08, 0x2E, 0xA1, 0x66, 0x28, 0xD9, 0x24, 0xB2, 0x76, 0x5B, 0xA2, 0x49, 0x6D, 0x8B, 0xD1, 0x25,
                    0x72, 0xF8, 0xF6, 0x64, 0x86, 0x68, 0x98, 0x16, 0xD4, 0xA4, 0x5C, 0xCC, 0x5D, 0x65, 0xB6, 0x92,
                    0x6C, 0x70, 0x48, 0x50, 0xFD, 0xED, 0xB9, 0xDA, 0x5E, 0x15, 0x46, 0x57, 0xA7, 0x8D, 0x9D, 0x84,
                    0x90, 0xD8, 0xAB, 0x00, 0x8C, 0xBC, 0xD3, 0x0A, 0xF7, 0xE4, 0x58, 0x05, 0xB8, 0xB3, 0x45, 0x06,
                    0xD0, 0x2C, 0x1E, 0x8F, 0xCA, 0x3F, 0x0F, 0x02, 0xC1, 0xAF, 0xBD, 0x03, 0x01, 0x13, 0x8A, 0x6B,
                    0x3A, 0x91, 0x11, 0x41, 0x4F, 0x67, 0xDC, 0xEA, 0x97, 0xF2, 0xCF, 0xCE, 0xF0, 0xB4, 0xE6, 0x73,
                    0x96, 0xAC, 0x74, 0x22, 0xE7, 0xAD, 0x35, 0x85, 0xE2, 0xF9, 0x37, 0xE8, 0x1C, 0x75, 0xDF, 0x6E,
                    0x47, 0xF1, 0x1A, 0x71, 0x1D, 0x29, 0xC5, 0x89, 0x6F, 0xB7, 0x62, 0x0E, 0xAA, 0x18, 0xBE, 0x1B,
                    0xFC, 0x56, 0x3E, 0x4B, 0xC6, 0xD2, 0x79, 0x20, 0x9A, 0xDB, 0xC0, 0xFE, 0x78, 0xCD, 0x5A, 0xF4,
                    0x1F, 0xDD, 0xA8, 0x33, 0x88, 0x07, 0xC7, 0x31, 0xB1, 0x12, 0x10, 0x59, 0x27, 0x80, 0xEC, 0x5F,
                    0x60, 0x51, 0x7F, 0xA9, 0x19, 0xB5, 0x4A, 0x0D, 0x2D, 0xE5, 0x7A, 0x9F, 0x93, 0xC9, 0x9C, 0xEF,
                    0xA0, 0xE0, 0x3B, 0x4D, 0xAE, 0x2A, 0xF5, 0xB0, 0xC8, 0xEB, 0xBB, 0x3C, 0x83, 0x53, 0x99, 0x61,
                    0x17, 0x2B, 0x04, 0x7E, 0xBA, 0x77, 0xD6, 0x26, 0xE1, 0x69, 0x14, 0x63, 0x55, 0x21, 0x0C, 0x7D
                ];
                
                // Round constants for key expansion
                const u32[10] RCON = [
                    0x01000000, 0x02000000, 0x04000000, 0x08000000,
                    0x10000000, 0x20000000, 0x40000000, 0x80000000,
                    0x1B000000, 0x36000000
                ];
                
                // Galois Field multiplication by 2
                def gmul2(byte b) -> byte
                {
                    if ((b & 0x80) != 0)
                    {
                        return (byte)((b << 1) ^| 0x1B);
                    }
                    else
                    {
                        return (byte)(b << 1);
                    };
                    return '\0';
                };
                
                // Galois Field multiplication by 3
                def gmul3(byte b) -> byte
                {
                    return gmul2(b) ^| b;
                };
                
                // SubBytes transformation
                def sub_bytes(byte* state) -> void
                {
                    u32 i;
                    for (i = 0; i < 16; i++)
                    {
                        state[i] = (byte)(SBOX[(state[i] & 0xFF)] & 0xFF);
                    };
                    return;
                };
                
                // Inverse SubBytes transformation
                def inv_sub_bytes(byte* state) -> void
                {
                    u32 i;
                    for (i = 0; i < 16; i++)
                    {
                        state[i] = (byte)(INV_SBOX[(state[i] & 0xFF)] & 0xFF);
                    };
                    return;
                };
                
                // ShiftRows transformation
                def shift_rows(byte* state) -> void
                {
                    byte temp;
                    
                    // Row 1: shift left by 1
                    temp = state[1];
                    state[1] = state[5];
                    state[5] = state[9];
                    state[9] = state[13];
                    state[13] = temp;
                    
                    // Row 2: shift left by 2
                    temp = state[2];
                    state[2] = state[10];
                    state[10] = temp;
                    temp = state[6];
                    state[6] = state[14];
                    state[14] = temp;
                    
                    // Row 3: shift left by 3
                    temp = state[15];
                    state[15] = state[11];
                    state[11] = state[7];
                    state[7] = state[3];
                    state[3] = temp;
                    return;
                };
                
                // Inverse ShiftRows transformation
                def inv_shift_rows(byte* state) -> void
                {
                    byte temp;
                    
                    // Row 1: shift right by 1
                    temp = state[13];
                    state[13] = state[9];
                    state[9] = state[5];
                    state[5] = state[1];
                    state[1] = temp;
                    
                    // Row 2: shift right by 2
                    temp = state[2];
                    state[2] = state[10];
                    state[10] = temp;
                    temp = state[6];
                    state[6] = state[14];
                    state[14] = temp;
                    
                    // Row 3: shift right by 3
                    temp = state[3];
                    state[3] = state[7];
                    state[7] = state[11];
                    state[11] = state[15];
                    state[15] = temp;
                    return;
                };
                
                // MixColumns transformation
                def mix_columns(byte* state) -> void
                {
                    byte[4] temp;
                    u32 base;
                    
                    // Mix each column
                    for (u32 col; col < 4; col++)
                    {
                        base = col * 4;
                        temp[0..3] = [state[base + 0], state[base + 1], state[base + 2], state[base + 3]];
                        
                        state[base + 0] = gmul2(temp[0]) ^| gmul3(temp[1]) ^| temp[2] ^| temp[3];
                        state[base + 1] = temp[0] ^| gmul2(temp[1]) ^| gmul3(temp[2]) ^| temp[3];
                        state[base + 2] = temp[0] ^| temp[1] ^| gmul2(temp[2]) ^| gmul3(temp[3]);
                        state[base + 3] = gmul3(temp[0]) ^| temp[1] ^| temp[2] ^| gmul2(temp[3]);
                    };
                    return;
                };
                
                // Inverse MixColumns transformation
                def inv_mix_columns(byte* state) -> void
                {
                    byte[4] temp;
                    u32 base;
                    
                    // Mix each column
                    for (u32 col; col < 4; col++)
                    {
                        base = col * 4;
                        temp[0..3] = [state[base + 0], state[base + 1], state[base + 2], state[base + 3]];

                        // Multiply by inverse matrix in GF(2^8)
                        // 0x0E, 0x0B, 0x0D, 0x09
                        state[base + 0] = (byte)(
                            gmul2(gmul2(gmul2(temp[0]))) ^| gmul2(gmul2(temp[0])) ^| gmul2(temp[0]) ^|  // 0x0E
                            gmul2(gmul2(gmul2(temp[1]))) ^| gmul2(temp[1]) ^| temp[1] ^|                // 0x0B
                            gmul2(gmul2(gmul2(temp[2]))) ^| gmul2(gmul2(temp[2])) ^| temp[2] ^|         // 0x0D
                            gmul2(gmul2(gmul2(temp[3]))) ^| temp[3]                                      // 0x09
                        );
                        
                        state[base + 1] = (byte)(
                            gmul2(gmul2(gmul2(temp[0]))) ^| temp[0] ^|
                            gmul2(gmul2(gmul2(temp[1]))) ^| gmul2(gmul2(temp[1])) ^| gmul2(temp[1]) ^|
                            gmul2(gmul2(gmul2(temp[2]))) ^| gmul2(temp[2]) ^| temp[2] ^|
                            gmul2(gmul2(gmul2(temp[3]))) ^| gmul2(gmul2(temp[3])) ^| temp[3]
                        );
                        
                        state[base + 2] = (byte)(
                            gmul2(gmul2(gmul2(temp[0]))) ^| gmul2(gmul2(temp[0])) ^| temp[0] ^|
                            gmul2(gmul2(gmul2(temp[1]))) ^| temp[1] ^|
                            gmul2(gmul2(gmul2(temp[2]))) ^| gmul2(gmul2(temp[2])) ^| gmul2(temp[2]) ^|
                            gmul2(gmul2(gmul2(temp[3]))) ^| gmul2(temp[3]) ^| temp[3]
                        );
                        
                        state[base + 3] = (byte)(
                            gmul2(gmul2(gmul2(temp[0]))) ^| gmul2(temp[0]) ^| temp[0] ^|
                            gmul2(gmul2(gmul2(temp[1]))) ^| gmul2(gmul2(temp[1])) ^| temp[1] ^|
                            gmul2(gmul2(gmul2(temp[2]))) ^| temp[2] ^|
                            gmul2(gmul2(gmul2(temp[3]))) ^| gmul2(gmul2(temp[3])) ^| gmul2(temp[3])
                        );
                    };
                    return;
                };
                
                // AddRoundKey transformation
                def add_round_key(byte* state, u32* round_key) -> void
                {
                    u32 base;
                    // Each round_key word corresponds to a column
                    for (u32 col; col < 4; col++)
                    {
                        base = col * 4;
                        state[base + 0] = state[base + 0] ^| (byte)((round_key[col] >> 24) & 0xFF);
                        state[base + 1] = state[base + 1] ^| (byte)((round_key[col] >> 16) & 0xFF);
                        state[base + 2] = state[base + 2] ^| (byte)((round_key[col] >> 8) & 0xFF);
                        state[base + 3] = state[base + 3] ^| (byte)(round_key[col] & 0xFF);
                    };
                    return;
                };
                
                // SubWord - apply S-box to each byte of a word
                def sub_word(u32 word) -> u32
                {
                    return (((u32)(SBOX[((word >> 24) & 0xFF)] & 0xFF)) << 24) |
                           (((u32)(SBOX[((word >> 16) & 0xFF)] & 0xFF)) << 16) |
                           (((u32)(SBOX[((word >> 8) & 0xFF)] & 0xFF)) << 8) |
                           ((u32)(SBOX[(word & 0xFF)] & 0xFF));
                };
                
                // RotWord - rotate word left by 8 bits
                def rot_word(u32 word) -> u32
                {
                    return ((word << 8) | (word >> 24));
                };
                
                // Key expansion for AES-128
                def aes_key_expansion(AES_CTX* ctx, byte* key) -> void
                {
                    u32 i, temp;
                    
                    // First 4 words are the key itself
                    for (i = 0; i < 4; i++)
                    {
                        ctx.round_keys[i] = (((u32)key[i * 4] & 0xFF) << 24) |
                                            (((u32)key[i * 4 + 1] & 0xFF) << 16) |
                                            (((u32)key[i * 4 + 2] & 0xFF) << 8) |
                                            ((u32)key[i * 4 + 3] & 0xFF);
                    };
                    
                    // Generate remaining round keys
                    for (i = 4; i < 44; i++)
                    {
                        temp = ctx.round_keys[i - 1];
                        
                        if ((i % 4) == 0)
                        {
                            temp = sub_word(rot_word(temp)) ^| RCON[i / 4 - 1];
                        };
                        
                        ctx.round_keys[i] = ctx.round_keys[i - 4] ^| temp;
                    };
                    
                    ctx.nr = 10;
                    return;
                };
                
                // Key expansion for AES-256 (32 byte key, 14 rounds)
                def aes_key_expansion_256(AES_CTX* ctx, byte* key) -> void
                {
                    u32 i, temp;

                    for (i = 0; i < 8; i++)
                    {
                        ctx.round_keys[i] = (((u32)key[i * 4] & 0xFF) << 24) |
                                            (((u32)key[i * 4 + 1] & 0xFF) << 16) |
                                            (((u32)key[i * 4 + 2] & 0xFF) << 8) |
                                            ((u32)key[i * 4 + 3] & 0xFF);
                    };

                    for (i = 8; i < 60; i++)
                    {
                        temp = ctx.round_keys[i - 1];

                        if ((i % 8) == 0)
                        {
                            temp = sub_word(rot_word(temp)) ^| RCON[i / 8 - 1];
                        };
                        if ((i % 8) == 4)
                        {
                            temp = sub_word(temp);
                        };

                        ctx.round_keys[i] = ctx.round_keys[i - 8] ^| temp;
                    };

                    ctx.nr = 14;
                    return;
                };

                // AES-128 encryption
                def aes_encrypt_block(AES_CTX* ctx, byte* plaintext, byte* ciphertext) -> void
                {
                    byte[16] state;
                    u32 i;
                    u32 round;
                    
                    // Copy plaintext to state
                    for (i = 0; i < 16; i++)
                    {
                        state[i] = plaintext[i];
                    };
                    
                    // Initial round key addition
                    add_round_key(state, @ctx.round_keys[0]);
                    
                    // Main rounds
                    for (round = 1; round < ctx.nr; round++)
                    {
                        sub_bytes(state);
                        shift_rows(state);
                        mix_columns(state);
                        add_round_key(state, @ctx.round_keys[round * 4]);
                    };
                    
                    // Final round (no MixColumns)
                    sub_bytes(state);
                    shift_rows(state);
                    add_round_key(state, @ctx.round_keys[ctx.nr * 4]);
                    
                    // Copy state to ciphertext
                    for (i = 0; i < 16; i++)
                    {
                        ciphertext[i] = state[i];
                    };
                    return;
                };
                
                // AES-128 decryption
                def aes_decrypt_block(AES_CTX* ctx, byte* ciphertext, byte* plaintext) -> void
                {
                    byte[16] state;
                    u32 i;
                    u32 round;
                    
                    // Copy ciphertext to state
                    for (i = 0; i < 16; i++)
                    {
                        state[i] = ciphertext[i];
                    };
                    
                    // Initial round key addition
                    add_round_key(state, @ctx.round_keys[ctx.nr * 4]);
                    
                    // Main rounds in reverse
                    for (round = ctx.nr - 1; round > 0; round--)
                    {
                        inv_shift_rows(state);
                        inv_sub_bytes(state);
                        add_round_key(state, @ctx.round_keys[round * 4]);
                        inv_mix_columns(state);
                    };
                    
                    // Final round (no InvMixColumns)
                    inv_shift_rows(state);
                    inv_sub_bytes(state);
                    add_round_key(state, @ctx.round_keys[0]);
                    
                    // Copy state to plaintext
                    for (i = 0; i < 16; i++)
                    {
                        plaintext[i] = state[i];
                    };
                    return;
                };

                // =====================================================================
                // AES-GCM  (Galois/Counter Mode)
                //
                // Provides authenticated encryption with associated data (AEAD).
                // Supports AES-128 (gcm_init) and AES-256 (gcm_init_256).
                //
                // GCM builds on two primitives:
                //   CTR mode  -- stream cipher using AES-ECB on an incrementing counter
                //   GHASH     -- polynomial authentication over GF(2^128)
                //
                // The GF(2^128) field uses the reduction polynomial:
                //   x^128 + x^7 + x^2 + x + 1   (0xE1 in the "reflected" representation)
                //
                // Public API:
                //   gcm_init(GCM_CTX*, key[16])
                //   gcm_encrypt(GCM_CTX*, iv[12], aad, aad_len, plain, plain_len, cipher, tag[16])
                //   gcm_decrypt(GCM_CTX*, iv[12], aad, aad_len, cipher, cipher_len, plain, tag[16]) -> int
                //     returns 1 if tag verifies, 0 if tampered
                // =====================================================================

                // GCM context — stores expanded key and the GHASH subkey H
                struct GCM_CTX
                {
                    AES_CTX aes;        // AES key schedule
                    byte[16] H;         // GHASH subkey: AES_K(0^128)
                };

                // ------------------------------------------------------------------
                // ghash_mul: X = X * Y  in GF(2^128)
                //
                // Uses the standard "shift-and-XOR" algorithm with the GCM
                // reduction polynomial 0xE1000000_00000000_00000000_00000000
                // (MSB-first bit ordering as per NIST SP 800-38D).
                //
                // Both X and Y are 16-byte big-endian blocks.
                // Result is written back into X.
                // ------------------------------------------------------------------
                def ghash_mul(byte* X, byte* Y) -> void
                {
                    byte[16] Z, V;
                    int i, j, k;
                    byte lsb;

                    // Z = 0 (result accumulator), V = Y
                    for (i = 0; i < 16; i++)
                    {
                        Z[i] = '\0';
                        V[i] = Y[i];
                    };

                    // Process each bit of X, MSB first
                    for (i = 0; i < 16; i++)
                    {
                        for (j = 7; j >= 0; j--)
                        {
                            // If bit (i*8 + (7-j)) of X is set, Z ^= V
                            if ((((u32)(X[i] & 0xFF) >> j) & 1) != 0)
                            {
                                for (k = 0; k < 16; k++)
                                {
                                    Z[k] = Z[k] ^| V[k];
                                };
                            };

                            // V = V >> 1 in GF(2^128), then reduce if LSB(V) was 1
                            lsb = V[15] & 1;

                            // Shift V right by one bit (big-endian: byte[0] is MSB)
                            for (k = 15; k > 0; k--)
                            {
                                V[k] = (byte)(((u32)(V[k] & 0xFF) >> 1) | ((u32)(V[k - 1] & 1) << 7));
                            };
                            V[0] = (byte)((u32)(V[0] & 0xFF) >> 1);

                            // If the bit shifted out was 1, XOR with reduction polynomial
                            if (lsb != 0)
                            {
                                V[0] = V[0] ^| (byte)0xE1;
                            };
                        };
                    };

                    for (i = 0; i < 16; i++)
                    {
                        X[i] = Z[i];
                    };
                    return;
                };

                // ------------------------------------------------------------------
                // ghash: Compute GHASH_H(A) over a sequence of blocks.
                //
                //   H    : 16-byte GHASH subkey
                //   input: byte stream (need not be block-aligned)
                //   len  : byte length of input
                //   tag  : running 16-byte accumulator (in/out)
                //
                // Pads the final partial block with zeros before hashing.
                // ------------------------------------------------------------------
                def ghash_update(byte* H, byte* input, int len, byte* tag) -> void
                {
                    byte[16] block;
                    int i, blocks, rem, b, offset;

                    blocks = len / 16;
                    rem    = len - (blocks * 16);

                    // Full blocks
                    for (b = 0; b < blocks; b++)
                    {
                        offset = b * 16;
                        for (i = 0; i < 16; i++)
                        {
                            tag[i] = tag[i] ^| input[offset + i];
                        };
                        ghash_mul(tag, H);
                    };

                    // Final partial block (zero-padded)
                    if (rem > 0)
                    {
                        for (i = 0; i < 16; i++)
                        {
                            block[i] = '\0';
                        };
                        offset = blocks * 16;
                        for (i = 0; i < rem; i++)
                        {
                            block[i] = input[offset + i];
                        };
                        for (i = 0; i < 16; i++)
                        {
                            tag[i] = tag[i] ^| block[i];
                        };
                        ghash_mul(tag, H);
                    };
                    return;
                };

                // ------------------------------------------------------------------
                // gcm_inc32: increment the 32-bit counter in bytes [12..15]
                //            of a 16-byte counter block (big-endian).
                // ------------------------------------------------------------------
                def gcm_inc32(byte* ctr) -> void
                {
                    int i;
                    for (i = 15; i >= 12; i--)
                    {
                        ctr[i] = (byte)(ctr[i] + 1);
                        if (ctr[i] != '\0')
                        {
                            return;
                        };
                    };
                    return;
                };

                // ------------------------------------------------------------------
                // gcm_init: Prepare a GCM_CTX from a 16-byte AES-128 key.
                //
                //   Expands the key schedule and computes H = AES_K(0^128).
                // ------------------------------------------------------------------
                def gcm_init(GCM_CTX* ctx, byte* key) -> void
                {
                    byte[16] zero_block;
                    int i;

                    aes_key_expansion(@ctx.aes, key);

                    for (i = 0; i < 16; i++)
                    {
                        zero_block[i] = '\0';
                    };

                    aes_encrypt_block(@ctx.aes, @zero_block[0], @ctx.H[0]);
                    return;
                };

                // ------------------------------------------------------------------
                // gcm_init_256: Prepare a GCM_CTX from a 32-byte AES-256 key.
                //   gcm_encrypt and gcm_decrypt work unchanged, the context carries the round count.
                // ------------------------------------------------------------------
                def gcm_init_256(GCM_CTX* ctx, byte* key) -> void
                {
                    byte[16] zero_block;
                    int i;

                    aes_key_expansion_256(@ctx.aes, key);

                    for (i = 0; i < 16; i++)
                    {
                        zero_block[i] = '\0';
                    };

                    aes_encrypt_block(@ctx.aes, @zero_block[0], @ctx.H[0]);
                    return;
                };

                // ------------------------------------------------------------------
                // gcm_encrypt: Encrypt and authenticate with AES-128-GCM.
                //
                //   ctx      : initialised GCM_CTX
                //   iv       : 12-byte IV (96-bit nonce, per NIST recommendation)
                //   aad      : additional authenticated data (may be null if aad_len==0)
                //   aad_len  : byte length of aad
                //   plain    : plaintext input
                //   plain_len: byte length of plaintext
                //   cipher   : output buffer for ciphertext (same length as plaintext)
                //   tag      : output buffer for 16-byte authentication tag
                // ------------------------------------------------------------------
                def gcm_encrypt(GCM_CTX* ctx,
                                byte* iv,
                                byte* aad,      int aad_len,
                                byte* plain,    int plain_len,
                                byte* cipher,
                                byte* tag) -> void
                {
                    byte[16] J0, ctr, ks, auth_tag;
                    byte[16] len_block;
                    int i, full_blocks, rem, b, offset;
                    u64 aad_bits, plain_bits;

                    // Build J0 = IV || 0x00000001  (96-bit IV + 32-bit counter = 1)
                    for (i = 0; i < 12; i++)
                    {
                        J0[i] = iv[i];
                    };
                    J0[12..15] = "\x00\x00\x00\x01";

                    // ctr = J0 incremented once for the first keystream block
                    for (i = 0; i < 16; i++)
                    {
                        ctr[i] = J0[i];
                    };
                    gcm_inc32(@ctr[0]);

                    // auth_tag accumulator starts at zero
                    for (i = 0; i < 16; i++)
                    {
                        auth_tag[i] = '\0';
                    };

                    // GHASH over AAD
                    if (aad_len > 0)
                    {
                        ghash_update(@ctx.H[0], aad, aad_len, @auth_tag[0]);
                    };

                    // CTR encryption + GHASH over ciphertext
                    full_blocks = plain_len / 16;
                    rem         = plain_len - (full_blocks * 16);

                    for (b = 0; b < full_blocks; b++)
                    {
                        offset = b * 16;
                        aes_encrypt_block(@ctx.aes, @ctr[0], @ks[0]);
                        gcm_inc32(@ctr[0]);
                        for (i = 0; i < 16; i++)
                        {
                            cipher[offset + i] = plain[offset + i] ^| ks[i];
                        };
                    };

                    if (rem > 0)
                    {
                        offset = full_blocks * 16;
                        aes_encrypt_block(@ctx.aes, @ctr[0], @ks[0]);
                        for (i = 0; i < rem; i++)
                        {
                            cipher[offset + i] = plain[offset + i] ^| ks[i];
                        };
                    };

                    // GHASH over ciphertext
                    if (plain_len > 0)
                    {
                        ghash_update(@ctx.H[0], cipher, plain_len, @auth_tag[0]);
                    };

                    // GHASH over lengths: len(AAD) || len(ciphertext) in bits, big-endian 64-bit each
                    aad_bits   = (u64)aad_len   * 8u;
                    plain_bits = (u64)plain_len * 8u;

                    len_block[0..7]  = (byte[8])(be64)aad_bits;
                    len_block[8..15] = (byte[8])(be64)plain_bits;

                    for (i = 0; i < 16; i++)
                    {
                        auth_tag[i] = auth_tag[i] ^| len_block[i];
                    };
                    ghash_mul(@auth_tag[0], @ctx.H[0]);

                    // tag = GCTR(K, J0, auth_tag) = AES_K(J0) XOR auth_tag
                    aes_encrypt_block(@ctx.aes, @J0[0], @ks[0]);
                    for (i = 0; i < 16; i++)
                    {
                        tag[i] = auth_tag[i] ^| ks[i];
                    };
                    return;
                };

                // ------------------------------------------------------------------
                // gcm_decrypt: Decrypt and verify with AES-128-GCM.
                //
                //   ctx       : initialised GCM_CTX
                //   iv        : 12-byte IV used during encryption
                //   aad       : additional authenticated data
                //   aad_len   : byte length of aad
                //   cipher    : ciphertext input
                //   cipher_len: byte length of ciphertext
                //   plain     : output buffer for plaintext (same length as ciphertext)
                //   tag       : 16-byte tag to verify against
                //
                // Returns 1 if the tag is valid, 0 if the message has been tampered.
                // The plaintext output is always written; caller must discard it on failure.
                // ------------------------------------------------------------------
                def gcm_decrypt(GCM_CTX* ctx,
                                byte* iv,
                                byte* aad,       int aad_len,
                                byte* cipher,    int cipher_len,
                                byte* plain,
                                byte* tag) -> int
                {
                    byte[16] J0, ctr, ks, auth_tag, expected_tag;
                    byte[16] len_block;
                    int i, full_blocks, rem, b, offset, diff;
                    u64 aad_bits, cipher_bits;

                    // Build J0 = IV || 0x00000001
                    for (i = 0; i < 12; i++)
                    {
                        J0[i] = iv[i];
                    };
                    J0[12..15] = "\x00\x00\x00\x01";

                    // ctr starts at J0+1
                    for (i = 0; i < 16; i++)
                    {
                        ctr[i] = J0[i];
                    };
                    gcm_inc32(@ctr[0]);

                    for (i = 0; i < 16; i++)
                    {
                        auth_tag[i] = '\0';
                    };

                    // GHASH over AAD
                    if (aad_len > 0)
                    {
                        ghash_update(@ctx.H[0], aad, aad_len, @auth_tag[0]);
                    };

                    // GHASH over ciphertext (before decryption)
                    if (cipher_len > 0)
                    {
                        ghash_update(@ctx.H[0], cipher, cipher_len, @auth_tag[0]);
                    };

                    // GHASH over lengths
                    aad_bits    = (u64)aad_len    * 8u;
                    cipher_bits = (u64)cipher_len * 8u;

                    len_block[0..7]  = (byte[8])(be64)aad_bits;
                    len_block[8..15] = (byte[8])(be64)cipher_bits;

                    for (i = 0; i < 16; i++)
                    {
                        auth_tag[i] = auth_tag[i] ^| len_block[i];
                    };
                    ghash_mul(@auth_tag[0], @ctx.H[0]);

                    // expected_tag = AES_K(J0) XOR auth_tag
                    aes_encrypt_block(@ctx.aes, @J0[0], @ks[0]);
                    for (i = 0; i < 16; i++)
                    {
                        expected_tag[i] = auth_tag[i] ^| ks[i];
                    };

                    // Constant-time tag comparison (prevent timing side-channels)
                    diff = 0;
                    for (i = 0; i < 16; i++)
                    {
                        diff = diff | ((int)(expected_tag[i] ^| tag[i]));
                    };

                    // CTR decryption (always performed; caller discards on diff != 0)
                    full_blocks = cipher_len / 16;
                    rem         = cipher_len - (full_blocks * 16);

                    for (b = 0; b < full_blocks; b++)
                    {
                        offset = b * 16;
                        aes_encrypt_block(@ctx.aes, @ctr[0], @ks[0]);
                        gcm_inc32(@ctr[0]);
                        for (i = 0; i < 16; i++)
                        {
                            plain[offset + i] = cipher[offset + i] ^| ks[i];
                        };
                    };

                    if (rem > 0)
                    {
                        offset = full_blocks * 16;
                        aes_encrypt_block(@ctx.aes, @ctr[0], @ks[0]);
                        for (i = 0; i < rem; i++)
                        {
                            plain[offset + i] = cipher[offset + i] ^| ks[i];
                        };
                    };

                    return (diff == 0) ? 1 : 0;
                };
            };

            // =====================================================================
            // ChaCha20-Poly1305 (RFC 8439)
            //
            //   chacha20_xor(key[32], counter, nonce[12], in, len, out) -> void
            //   poly1305_mac(key[32], msg, len, tag[16]) -> void
            //   chachapoly_encrypt(key[32], nonce[12], aad, aad_len, plain, plain_len, cipher, tag[16]) -> void
            //   chachapoly_decrypt(key[32], nonce[12], aad, aad_len, cipher, cipher_len, plain, tag[16]) -> int
            //        returns 1 when the tag is valid, 0 otherwise (nothing is written to plain on failure)
            // =====================================================================
            namespace ChaCha20Poly1305
            {
                def cc_rotl(u32 x, u32 n) -> u32
                {
                    return (x << n) `| (x >> (32u - n));
                };

                def cc_le32(byte* p) -> u32
                {
                    return (u32)p[0] `| ((u32)p[1] << 8u) `| ((u32)p[2] << 16u) `| ((u32)p[3] << 24u);
                };

                def cc_put32(byte* p, u32 v) -> void
                {
                    p[0] = (byte)(v `& 255u);
                    p[1] = (byte)((v >> 8u) `& 255u);
                    p[2] = (byte)((v >> 16u) `& 255u);
                    p[3] = (byte)((v >> 24u) `& 255u);
                };

                def cc_qr(u32* x, int a, int b, int c, int d) -> void
                {
                    x[a] = x[a] + x[b]; x[d] = cc_rotl(x[d] ^| x[a], 16u);
                    x[c] = x[c] + x[d]; x[b] = cc_rotl(x[b] ^| x[c], 12u);
                    x[a] = x[a] + x[b]; x[d] = cc_rotl(x[d] ^| x[a], 8u);
                    x[c] = x[c] + x[d]; x[b] = cc_rotl(x[b] ^| x[c], 7u);
                };

                // One 64 byte keystream block.
                def chacha20_block(byte* key, u32 counter, byte* nonce, byte* out) -> void
                {
                    u32[16] st, x;
                    int i;
                    st[0] = 1634760805u; st[1] = 857760878u; st[2] = 2036477234u; st[3] = 1797285236u;
                    for (i = 0; i < 8; i++) { st[4 + i] = cc_le32(key + i * 4); };
                    st[12] = counter;
                    st[13] = cc_le32(nonce);
                    st[14] = cc_le32(nonce + 4);
                    st[15] = cc_le32(nonce + 8);
                    for (i = 0; i < 16; i++) { x[i] = st[i]; };
                    for (i = 0; i < 10; i++)
                    {
                        cc_qr(@x[0], 0, 4, 8, 12);
                        cc_qr(@x[0], 1, 5, 9, 13);
                        cc_qr(@x[0], 2, 6, 10, 14);
                        cc_qr(@x[0], 3, 7, 11, 15);
                        cc_qr(@x[0], 0, 5, 10, 15);
                        cc_qr(@x[0], 1, 6, 11, 12);
                        cc_qr(@x[0], 2, 7, 8, 13);
                        cc_qr(@x[0], 3, 4, 9, 14);
                    };
                    for (i = 0; i < 16; i++) { cc_put32(out + i * 4, x[i] + st[i]); };
                };

                // XORs len bytes of in with the keystream starting at block counter. in and out may alias.
                def chacha20_xor(byte* key, u32 counter, byte* nonce, byte* inp, int len, byte* out) -> void
                {
                    byte[64] ks;
                    int off = 0;
                    int i, n;
                    while (off < len)
                    {
                        chacha20_block(key, counter, nonce, @ks[0]);
                        counter = counter + 1u;
                        n = len - off;
                        if (n > 64) { n = 64; };
                        for (i = 0; i < n; i++) { out[off + i] = inp[off + i] ^| ks[i]; };
                        off = off + n;
                    };
                };

                // Poly1305 with 26 bit limbs (the 32 bit "donna" layout).
                struct POLY1305
                {
                    u64 r0, r1, r2, r3, r4;
                    u64 h0, h1, h2, h3, h4;
                    u64 pad0, pad1, pad2, pad3;
                    byte[16] buf;
                    int buflen;
                };

                def poly_init(POLY1305* p, byte* key) -> void
                {
                    // clamp r and split into 26 bit limbs
                    p.r0 = (u64)(cc_le32(key) `& 67108863u);
                    p.r1 = (u64)((cc_le32(key + 3) >> 2u) `& 67108611u);
                    p.r2 = (u64)((cc_le32(key + 6) >> 4u) `& 67092735u);
                    p.r3 = (u64)((cc_le32(key + 9) >> 6u) `& 66076671u);
                    p.r4 = (u64)((cc_le32(key + 12) >> 8u) `& 1048575u);
                    p.h0 = (u64)0; p.h1 = (u64)0; p.h2 = (u64)0; p.h3 = (u64)0; p.h4 = (u64)0;
                    p.pad0 = (u64)cc_le32(key + 16);
                    p.pad1 = (u64)cc_le32(key + 20);
                    p.pad2 = (u64)cc_le32(key + 24);
                    p.pad3 = (u64)cc_le32(key + 28);
                    p.buflen = 0;
                };

                // hibit is 16777216 for a full block, 0 for the final padded block
                def poly_block(POLY1305* p, byte* m, u64 hibit) -> void
                {
                    u64 mask = (u64)67108863;
                    u64 s1 = p.r1 * (u64)5;
                    u64 s2 = p.r2 * (u64)5;
                    u64 s3 = p.r3 * (u64)5;
                    u64 s4 = p.r4 * (u64)5;
                    u64 h0, h1, h2, h3, h4, d0, d1, d2, d3, d4, c;

                    h0 = p.h0 + ((u64)cc_le32(m) `& mask);
                    h1 = p.h1 + ((u64)(cc_le32(m + 3) >> 2u) `& mask);
                    h2 = p.h2 + ((u64)(cc_le32(m + 6) >> 4u) `& mask);
                    h3 = p.h3 + ((u64)(cc_le32(m + 9) >> 6u) `& mask);
                    h4 = p.h4 + ((u64)(cc_le32(m + 12) >> 8u) `| hibit);

                    d0 = h0 * p.r0 + h1 * s4 + h2 * s3 + h3 * s2 + h4 * s1;
                    d1 = h0 * p.r1 + h1 * p.r0 + h2 * s4 + h3 * s3 + h4 * s2;
                    d2 = h0 * p.r2 + h1 * p.r1 + h2 * p.r0 + h3 * s4 + h4 * s3;
                    d3 = h0 * p.r3 + h1 * p.r2 + h2 * p.r1 + h3 * p.r0 + h4 * s4;
                    d4 = h0 * p.r4 + h1 * p.r3 + h2 * p.r2 + h3 * p.r1 + h4 * p.r0;

                    c = d0 >> (u64)26; h0 = d0 `& mask;
                    d1 = d1 + c; c = d1 >> (u64)26; h1 = d1 `& mask;
                    d2 = d2 + c; c = d2 >> (u64)26; h2 = d2 `& mask;
                    d3 = d3 + c; c = d3 >> (u64)26; h3 = d3 `& mask;
                    d4 = d4 + c; c = d4 >> (u64)26; h4 = d4 `& mask;
                    h0 = h0 + c * (u64)5; c = h0 >> (u64)26; h0 = h0 `& mask;
                    h1 = h1 + c;

                    p.h0 = h0; p.h1 = h1; p.h2 = h2; p.h3 = h3; p.h4 = h4;
                };

                def poly_update(POLY1305* p, byte* m, int len) -> void
                {
                    int i;
                    int off = 0;
                    if (p.buflen > 0)
                    {
                        while (p.buflen < 16 & off < len) { p.buf[p.buflen] = m[off]; p.buflen++; off++; };
                        if (p.buflen < 16) { return; };
                        poly_block(p, @p.buf[0], (u64)16777216);
                        p.buflen = 0;
                    };
                    while (len - off >= 16)
                    {
                        poly_block(p, m + off, (u64)16777216);
                        off = off + 16;
                    };
                    while (off < len) { p.buf[p.buflen] = m[off]; p.buflen++; off++; };
                };

                def poly_final(POLY1305* p, byte* tag) -> void
                {
                    u64 mask = (u64)67108863;
                    u64 h0, h1, h2, h3, h4, c, g0, g1, g2, g3, g4, nmask, f;
                    u32 w0, w1, w2, w3;
                    int i;

                    if (p.buflen > 0)
                    {
                        p.buf[p.buflen] = (byte)1;
                        for (i = p.buflen + 1; i < 16; i++) { p.buf[i] = (byte)0; };
                        poly_block(p, @p.buf[0], (u64)0);
                    };

                    h0 = p.h0; h1 = p.h1; h2 = p.h2; h3 = p.h3; h4 = p.h4;

                    c = h1 >> (u64)26; h1 = h1 `& mask;
                    h2 = h2 + c; c = h2 >> (u64)26; h2 = h2 `& mask;
                    h3 = h3 + c; c = h3 >> (u64)26; h3 = h3 `& mask;
                    h4 = h4 + c; c = h4 >> (u64)26; h4 = h4 `& mask;
                    h0 = h0 + c * (u64)5; c = h0 >> (u64)26; h0 = h0 `& mask;
                    h1 = h1 + c;

                    // compute h + -p, select h when h < p
                    g0 = h0 + (u64)5; c = g0 >> (u64)26; g0 = g0 `& mask;
                    g1 = h1 + c; c = g1 >> (u64)26; g1 = g1 `& mask;
                    g2 = h2 + c; c = g2 >> (u64)26; g2 = g2 `& mask;
                    g3 = h3 + c; c = g3 >> (u64)26; g3 = g3 `& mask;
                    g4 = h4 + c - (u64)67108864;

                    // g4 wrapped (bit 63 set) means h < p: keep h
                    nmask = (g4 >> (u64)63) - (u64)1;     // all ones when h >= p, zero when h < p
                    g0 = g0 `& nmask; g1 = g1 `& nmask; g2 = g2 `& nmask; g3 = g3 `& nmask; g4 = g4 `& nmask;
                    nmask = `!nmask;
                    h0 = (h0 `& nmask) `| g0;
                    h1 = (h1 `& nmask) `| g1;
                    h2 = (h2 `& nmask) `| g2;
                    h3 = (h3 `& nmask) `| g3;
                    h4 = (h4 `& nmask) `| g4;

                    // h = h % 2^128 as four 32 bit words
                    w0 = (u32)((h0 `| (h1 << (u64)26)) `& (u64)4294967295);
                    w1 = (u32)(((h1 >> (u64)6) `| (h2 << (u64)20)) `& (u64)4294967295);
                    w2 = (u32)(((h2 >> (u64)12) `| (h3 << (u64)14)) `& (u64)4294967295);
                    w3 = (u32)(((h3 >> (u64)18) `| (h4 << (u64)8)) `& (u64)4294967295);

                    // mac = (h + pad) % 2^128
                    f = (u64)w0 + p.pad0;                       cc_put32(tag, (u32)(f `& (u64)4294967295));
                    f = (u64)w1 + p.pad1 + (f >> (u64)32);      cc_put32(tag + 4, (u32)(f `& (u64)4294967295));
                    f = (u64)w2 + p.pad2 + (f >> (u64)32);      cc_put32(tag + 8, (u32)(f `& (u64)4294967295));
                    f = (u64)w3 + p.pad3 + (f >> (u64)32);      cc_put32(tag + 12, (u32)(f `& (u64)4294967295));
                };

                def poly1305_mac(byte* key, byte* msg, int len, byte* tag) -> void
                {
                    POLY1305 p;
                    poly_init(@p, key);
                    poly_update(@p, msg, len);
                    poly_final(@p, tag);
                };

                // MAC over aad || pad || cipher || pad || le64(aad_len) || le64(cipher_len)
                def chachapoly_tag(byte* key, byte* nonce, byte* aad, int aad_len, byte* cipher, int cipher_len, byte* tag) -> void
                {
                    byte[64] block0;
                    byte[16] zeros, lens;
                    POLY1305 p;
                    int i;
                    for (i = 0; i < 16; i++) { zeros[i] = (byte)0; };
                    chacha20_block(key, 0u, nonce, @block0[0]);
                    poly_init(@p, @block0[0]);
                    poly_update(@p, aad, aad_len);
                    if (aad_len % 16 != 0) { poly_update(@p, @zeros[0], 16 - aad_len % 16); };
                    poly_update(@p, cipher, cipher_len);
                    if (cipher_len % 16 != 0) { poly_update(@p, @zeros[0], 16 - cipher_len % 16); };
                    for (i = 0; i < 8; i++)
                    {
                        lens[i] = (byte)(((u64)aad_len >> (u64)(8 * i)) `& (u64)255);
                        lens[8 + i] = (byte)(((u64)cipher_len >> (u64)(8 * i)) `& (u64)255);
                    };
                    poly_update(@p, @lens[0], 16);
                    poly_final(@p, tag);
                };

                def chachapoly_encrypt(byte* key, byte* nonce, byte* aad, int aad_len,
                                       byte* plain, int plain_len, byte* cipher, byte* tag) -> void
                {
                    chacha20_xor(key, 1u, nonce, plain, plain_len, cipher);
                    chachapoly_tag(key, nonce, aad, aad_len, cipher, plain_len, tag);
                };

                def chachapoly_decrypt(byte* key, byte* nonce, byte* aad, int aad_len,
                                       byte* cipher, int cipher_len, byte* plain, byte* tag) -> int
                {
                    byte[16] expect;
                    int i;
                    int diff = 0;
                    chachapoly_tag(key, nonce, aad, aad_len, cipher, cipher_len, @expect[0]);
                    for (i = 0; i < 16; i++) { diff = diff `| ((int)expect[i] ^| (int)tag[i]); };
                    if (diff != 0) { return 0; };
                    chacha20_xor(key, 1u, nonce, cipher, cipher_len, plain);
                    return 1;
                };
            };
        };

        namespace ECDH
        {
            namespace X25519
            {
                // =========================================================================
                // X25519 Elliptic Curve Diffie-Hellman
                //
                // Curve: y² = x³ + 486662x² + x  over  GF(p),  p = 2^255 - 19
                //
                // Uses BigInt arithmetic mod p. p = 2^255 - 19 is represented as a
                // BigInt with 8 uint limbs (256 bits, upper bit always 0 after reduction).
                //
                // Public API:
                //   x25519(out[32], scalar[32], point[32])  -- DH shared secret
                //   x25519_pubkey(out[32], scalar[32])       -- scalar x base point
                // =========================================================================

                // ---- Load/store ----

                // Load 32 little-endian bytes into a BigInt.
                def fe_from_bytes(BigInt* out, byte* src) -> void
                {
                    uint i, j;
                    uint* d = @out.digits[0];
                    for (i = 0; i < 9; i++) { d[i] = 0; };
                    for (i = 0; i < 8; i++)
                    {
                        j = i * 4;
                        d[i] = *(le32*)@src[j];
                    };
                    out.length = 8;
                    out.negative = false;
                    math::bigint::bigint_normalize(out);
                    // Clear high bit (RFC 7748: mask u-coordinate MSB)
                    if (out.length == 8) { d[7] = d[7] & 0x7FFFFFFF; };
                    math::bigint::bigint_normalize(out);
                    return;
                };

                // Store a BigInt to 32 little-endian bytes (already reduced mod p).
                def fe_to_bytes(byte* dst, BigInt* src) -> void
                {
                    uint i, j;
                    uint* d = @src.digits[0];
                    uint word;
                    for (i = 0; i < 8; i++)
                    {
                        j = i * 4;
                        word = (i < src.length) ? d[i] : 0u;
                        dst[j]     = (byte)(word & 0xFF);
                        dst[j + 1] = (byte)((word >> 8)  & 0xFF);
                        dst[j + 2] = (byte)((word >> 16) & 0xFF);
                        dst[j + 3] = (byte)((word >> 24) & 0xFF);
                    };
                    return;
                };

                // ---- Field operations ----
                // All operations reduce mod p where needed.
                // p is built at call time from the known constant.

                def fe_set_p(BigInt* p) -> void
                {
                    // p = 2^255 - 19
                    // = 0x7FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF ED
                    // In 8 uint limbs LE:
                    //   limbs 0..6: 0xFFFFFFFF
                    //   limb 7:     0x7FFFFFFF
                    // Then subtract 18 from limb 0 (since 2^255 - 19 = 0x7FFF...FFED)
                    // Actually: -19 = 0xFFFF...FFED in the low bits.
                    // 2^255 - 19:
                    //   low 32 bits: 0xFFFFFFED (= 4294967277)
                    //   next 6 words: 0xFFFFFFFF
                    //   top word (bits 224-255): 0x7FFFFFFF
                    uint* pd = @p.digits[0];

                    pd = [0xFFFFFFEDu, 0xFFFFFFFFu, 0xFFFFFFFFu, 0xFFFFFFFFu,
                          0xFFFFFFFFu, 0xFFFFFFFFu, 0xFFFFFFFFu, 0x7FFFFFFF];

                    p.length = 8;
                    p.negative = false;
                    return;
                };

                def fe_add(BigInt* out, BigInt* a, BigInt* b) -> void
                {
                    BigInt p, tmp;
                    fe_set_p(@p);
                    math::bigint::bigint_add(@tmp, a, b);
                    math::bigint::bigint_mod(out, @tmp, @p);
                    return;
                };

                def fe_sub(BigInt* out, BigInt* a, BigInt* b) -> void
                {
                    BigInt p, tmp;
                    fe_set_p(@p);
                    math::bigint::bigint_sub(@tmp, a, b);
                    // If negative, add p
                    if (tmp.negative)
                    {
                        math::bigint::bigint_add(out, @tmp, @p);
                        // May still be negative if a was 0 and b was large; add p again
                        if (out.negative)
                        {
                            math::bigint::bigint_add(@tmp, out, @p);
                            math::bigint::bigint_copy(out, @tmp);
                        };
                    }
                    else
                    {
                        math::bigint::bigint_mod(out, @tmp, @p);
                    };
                    return;
                };

                def fe_mul(BigInt* out, BigInt* a, BigInt* b) -> void
                {
                    BigInt p, tmp;
                    fe_set_p(@p);
                    math::bigint::bigint_mul(@tmp, a, b);
                    math::bigint::bigint_mod(out, @tmp, @p);
                    return;
                };

                def fe_sq(BigInt* out, BigInt* a) -> void
                {
                    fe_mul(out, a, a);
                    return;
                };

                // Constant-time conditional swap (not truly CT but correct)
                def fe_cswap(BigInt* a, BigInt* b, u64 cond) -> void
                {
                    BigInt tmp;
                    if (cond != 0u)
                    {
                        math::bigint::bigint_copy(@tmp, a);
                        math::bigint::bigint_copy(a, b);
                        math::bigint::bigint_copy(b, @tmp);
                    };
                    return;
                };

                // Invert: out = a^(p-2) mod p  (Fermat's little theorem)
                def fe_invert(BigInt* out, BigInt* a) -> void
                {
                    // p - 2 = 2^255 - 21
                    // Square-and-multiply: standard binary exponentiation
                    BigInt p, exp, base, result, tmp, bit_val, zero;
                    uint i, j;
                    u64 limb;

                    fe_set_p(@p);

                    // exp = p - 2: subtract 2 from p
                    math::bigint::bigint_from_uint(@tmp, 2);
                    math::bigint::bigint_sub(@exp, @p, @tmp);

                    // result = 1
                    math::bigint::bigint_one(@result);
                    math::bigint::bigint_copy(@base, a);

                    // Binary exponentiation: iterate over bits of exp from LSB
                    // exp has 8 uint limbs
                    uint* expd = @exp.digits[0];
                    uint exp_len = exp.length,
                         word;

                    for (i = 0; i < exp_len; i++)
                    {
                        word = expd[i];
                        for (j = 0; j < 32; j++)
                        {
                            if ((word & 1) != 0)
                            {
                                fe_mul(@tmp, @result, @base);
                                math::bigint::bigint_copy(@result, @tmp);
                            };
                            word = word >> 1;
                            fe_sq(@tmp, @base);
                            math::bigint::bigint_copy(@base, @tmp);
                        };
                    };

                    math::bigint::bigint_copy(out, @result);
                    return;
                };

                // ---- Montgomery ladder ----
                def x25519(byte* out, byte* scalar, byte* point) -> void
                {
                    BigInt x1, x2, z2, x3, z3;
                    BigInt A, AA, B, BB, E, C, D, DA, CB, tmp, a24;
                    byte[32] e;
                    u32 i, j;
                    u64 bit, swap;

                    // Clamp scalar
                    while (j < 32) { e[j] = scalar[j]; j++; };
                    e[0]  = e[0]  & (byte)248;
                    e[31] = e[31] & (byte)127;
                    e[31] = e[31] | (byte)64;

                    // Load u-coordinate (mask high bit)
                    fe_from_bytes(@x1, point);

                    // x2 = 1, z2 = 0
                    math::bigint::bigint_one(@x2);
                    math::bigint::bigint_zero(@z2);
                    // x3 = x1, z3 = 1
                    math::bigint::bigint_copy(@x3, @x1);
                    math::bigint::bigint_one(@z3);

                    // a24 = 121665
                    math::bigint::bigint_from_uint(@a24, 121665);

                    i = 254;
                    while (i <= 254)
                    {
                        bit  = (u64)((e[i >> 3] >> (i & 7)) & 1);
                        swap = swap `^| bit;
                        fe_cswap(@x2, @x3, swap);
                        fe_cswap(@z2, @z3, swap);
                        swap = bit;

                        fe_add(@A,  @x2, @z2);  fe_sq(@AA, @A);
                        fe_sub(@B,  @x2, @z2);  fe_sq(@BB, @B);
                        fe_sub(@E,  @AA, @BB);
                        fe_add(@C,  @x3, @z3);
                        fe_sub(@D,  @x3, @z3);
                        fe_mul(@DA, @D,  @A);
                        fe_mul(@CB, @C,  @B);
                        fe_add(@tmp, @DA, @CB);  fe_sq(@x3, @tmp);
                        fe_sub(@tmp, @DA, @CB);  fe_sq(@z3, @tmp);
                        fe_mul(@z3, @x1, @z3);
                        fe_mul(@x2, @AA, @BB);
                        fe_mul(@tmp, @a24, @E);
                        fe_add(@tmp, @AA, @tmp);
                        fe_mul(@z2, @E, @tmp);

                        switch (i == 0) { case (1) { break; } default {}; };
                        i--;
                    };

                    fe_cswap(@x2, @x3, swap);
                    fe_cswap(@z2, @z3, swap);

                    fe_invert(@z2, @z2);
                    fe_mul(@x2, @x2, @z2);
                    fe_to_bytes(out, @x2);
                    return;
                };

                def x25519_pubkey(byte* out, byte* scalar) -> void
                {
                    byte[32] base;
                    u32 i;
                    i = 0;
                    while (i < 32) { base[i] = (byte)0; i++; };
                    base[0] = (byte)9;
                    x25519(out, scalar, @base[0]);
                    return;
                };

            };  // namespace X25519
        };

        // =====================================================================
        // Ed25519 (RFC 8032)
        //
        //   ed25519_publickey(seed[32], pub[32]) -> void
        //   ed25519_sign(seed[32], msg, msg_len, sig[64]) -> void
        //   ed25519_verify(pub[32], msg, msg_len, sig[64]) -> int       1 when valid, else 0
        //
        // Field arithmetic is mod 2^255-19 on 8 limbs of 32 bits held in u64 slots.
        // A field element is u64[8], a point is u64[32]: X, Y, Z, T (extended coordinates).
        // =====================================================================
        namespace Ed25519
        {
            global u64[8] ED_D, ED_D2, ED_SQRTM1;
            global u64[32] ED_BASE;
            global int ed_ready;

            // ---- field ----

            def fe_copy(u64* r, u64* a) -> void
            {
                int i;
                for (i = 0; i < 8; i++) { r[i] = a[i]; };
            };

            def fe_zero(u64* r) -> void
            {
                int i;
                for (i = 0; i < 8; i++) { r[i] = (u64)0; };
            };

            def fe_one(u64* r) -> void
            {
                fe_zero(r);
                r[0] = (u64)1;
            };

            // folds a carry c out of bit 256 back in (2^256 = 38 mod p), three rounds always
            def fe_fold(u64* r, u64 c) -> void
            {
                int i, k;
                u64 t;
                for (k = 0; k < 3; k++)
                {
                    t = c * (u64)38;
                    c = (u64)0;
                    for (i = 0; i < 8; i++)
                    {
                        t = r[i] + t;
                        r[i] = t `& (u64)4294967295;
                        t = t >> (u64)32;
                    };
                    c = t;
                };
            };

            def fe_add(u64* r, u64* a, u64* b) -> void
            {
                int i;
                u64 t = (u64)0;
                for (i = 0; i < 8; i++)
                {
                    t = a[i] + b[i] + t;
                    r[i] = t `& (u64)4294967295;
                    t = t >> (u64)32;
                };
                fe_fold(r, t);
            };

            def fe_sub(u64* r, u64* a, u64* b) -> void
            {
                int i, k;
                u64 t, br, d;
                br = (u64)0;
                for (i = 0; i < 8; i++)
                {
                    d = a[i] + (u64)4294967296 - b[i] - br;
                    r[i] = d `& (u64)4294967295;
                    br = (u64)1 - (d >> (u64)32);
                };
                // a borrow means the result wrapped by 2^256, which is 38 mod p: take 38 away
                for (k = 0; k < 3; k++)
                {
                    t = br * (u64)38;
                    br = (u64)0;
                    for (i = 0; i < 8; i++)
                    {
                        d = r[i] + (u64)4294967296 - t;
                        r[i] = d `& (u64)4294967295;
                        t = (u64)1 - (d >> (u64)32);
                    };
                    br = t;
                };
            };

            def fe_mul(u64* r, u64* a, u64* b) -> void
            {
                u64[17] t;
                int i, j;
                u64 p, c;
                for (i = 0; i < 17; i++) { t[i] = (u64)0; };
                for (i = 0; i < 8; i++)
                {
                    for (j = 0; j < 8; j++)
                    {
                        p = a[i] * b[j];
                        t[i + j] = t[i + j] + (p `& (u64)4294967295);
                        t[i + j + 1] = t[i + j + 1] + (p >> (u64)32);
                    };
                };
                c = (u64)0;
                for (i = 0; i < 16; i++)
                {
                    t[i] = t[i] + c;
                    c = t[i] >> (u64)32;
                    t[i] = t[i] `& (u64)4294967295;
                };
                // value = lo + 2^256 * hi, and 2^256 = 38 mod p
                c = (u64)0;
                for (i = 0; i < 8; i++)
                {
                    p = t[i] + t[i + 8] * (u64)38 + c;
                    r[i] = p `& (u64)4294967295;
                    c = p >> (u64)32;
                };
                fe_fold(r, c);
            };

            def fe_sq(u64* r, u64* a) -> void
            {
                fe_mul(r, a, a);
            };

            def fe_neg(u64* r, u64* a) -> void
            {
                u64[8] z;
                fe_zero(@z[0]);
                fe_sub(r, @z[0], a);
            };

            // canonical reduction into 32 little endian bytes
            def fe_tobytes(byte* out, u64* a) -> void
            {
                u64[8] v, w;
                u64 b, c, q, mk;
                int i;
                fe_copy(@v[0], a);
                // fold bit 255: v = (v mod 2^255) + 19 * bit
                b = v[7] >> (u64)31;
                v[7] = v[7] `& (u64)2147483647;
                c = b * (u64)19;
                for (i = 0; i < 8; i++)
                {
                    c = v[i] + c;
                    v[i] = c `& (u64)4294967295;
                    c = c >> (u64)32;
                };
                // now v < 2^255 + 19: compute v + 19, if that reaches 2^255 then v >= p
                c = (u64)19;
                for (i = 0; i < 8; i++)
                {
                    c = v[i] + c;
                    w[i] = c `& (u64)4294967295;
                    c = c >> (u64)32;
                };
                q = w[7] >> (u64)31;
                w[7] = w[7] `& (u64)2147483647;
                mk = (u64)0 - q;
                for (i = 0; i < 8; i++) { v[i] = (v[i] `& `!mk) `| (w[i] `& mk); };
                for (i = 0; i < 8; i++)
                {
                    out[i * 4] = (byte)(v[i] `& (u64)255);
                    out[i * 4 + 1] = (byte)((v[i] >> (u64)8) `& (u64)255);
                    out[i * 4 + 2] = (byte)((v[i] >> (u64)16) `& (u64)255);
                    out[i * 4 + 3] = (byte)((v[i] >> (u64)24) `& (u64)255);
                };
            };

            // reads 32 bytes, ignoring bit 255
            def fe_frombytes(u64* r, byte* inp) -> void
            {
                int i;
                for (i = 0; i < 8; i++)
                {
                    r[i] = (u64)inp[i * 4] `| ((u64)inp[i * 4 + 1] << (u64)8) `| ((u64)inp[i * 4 + 2] << (u64)16) `| ((u64)inp[i * 4 + 3] << (u64)24);
                };
                r[7] = r[7] `& (u64)2147483647;
            };

            def fe_isneg(u64* a) -> int
            {
                byte[32] b;
                fe_tobytes(@b[0], a);
                return (int)(b[0] `& (byte)1);
            };

            def fe_equal(u64* a, u64* b) -> int
            {
                byte[32] x, y;
                int i, d;
                d = 0;
                fe_tobytes(@x[0], a);
                fe_tobytes(@y[0], b);
                for (i = 0; i < 32; i++) { d = d `| ((int)x[i] ^| (int)y[i]); };
                if (d == 0) { return 1; };
                return 0;
            };

            def fe_sqk(u64* r, u64* a, int k) -> void
            {
                int i;
                fe_sq(r, a);
                for (i = 1; i < k; i++) { fe_sq(r, r); };
            };

            // r = z^(2^250 - 1), and t11 = z^11 for the caller
            def fe_pow250(u64* r, u64* t11, u64* z) -> void
            {
                u64[8] t0, t1, t2, t3;
                fe_sq(@t0[0], z);
                fe_sqk(@t1[0], @t0[0], 2);
                fe_mul(@t1[0], z, @t1[0]);
                fe_mul(@t0[0], @t0[0], @t1[0]);
                fe_copy(t11, @t0[0]);
                fe_sq(@t2[0], @t0[0]);
                fe_mul(@t1[0], @t1[0], @t2[0]);
                fe_sqk(@t2[0], @t1[0], 5);
                fe_mul(@t1[0], @t2[0], @t1[0]);
                fe_sqk(@t2[0], @t1[0], 10);
                fe_mul(@t2[0], @t2[0], @t1[0]);
                fe_sqk(@t3[0], @t2[0], 20);
                fe_mul(@t2[0], @t3[0], @t2[0]);
                fe_sqk(@t2[0], @t2[0], 10);
                fe_mul(@t1[0], @t2[0], @t1[0]);
                fe_sqk(@t2[0], @t1[0], 50);
                fe_mul(@t2[0], @t2[0], @t1[0]);
                fe_sqk(@t3[0], @t2[0], 100);
                fe_mul(@t2[0], @t3[0], @t2[0]);
                fe_sqk(@t2[0], @t2[0], 50);
                fe_mul(r, @t2[0], @t1[0]);
            };

            // r = z^(p-2)
            def fe_invert(u64* r, u64* z) -> void
            {
                u64[8] t, t11;
                fe_pow250(@t[0], @t11[0], z);
                fe_sqk(@t[0], @t[0], 5);
                fe_mul(r, @t[0], @t11[0]);
            };

            // r = z^((p-5)/8) = z^(2^252 - 3)
            def fe_pow22523(u64* r, u64* z) -> void
            {
                u64[8] t, t11;
                fe_pow250(@t[0], @t11[0], z);
                fe_sqk(@t[0], @t[0], 2);
                fe_mul(r, @t[0], z);
            };

            def fe_small(u64* r, u64 v) -> void
            {
                fe_zero(r);
                r[0] = v;
            };

            // ---- points ----

            def pt_add(u64* r, u64* p, u64* q) -> void
            {
                u64[8] a, b, c, d, e, f, g, h, t1, t2;
                // A = (Y1-X1)(Y2-X2), B = (Y1+X1)(Y2+X2), C = T1*2d*T2, D = 2*Z1*Z2
                fe_sub(@t1[0], p + 8, p);
                fe_sub(@t2[0], q + 8, q);
                fe_mul(@a[0], @t1[0], @t2[0]);
                fe_add(@t1[0], p + 8, p);
                fe_add(@t2[0], q + 8, q);
                fe_mul(@b[0], @t1[0], @t2[0]);
                fe_mul(@t1[0], p + 24, q + 24);
                fe_mul(@c[0], @t1[0], @ED_D2[0]);
                fe_mul(@t1[0], p + 16, q + 16);
                fe_add(@d[0], @t1[0], @t1[0]);
                fe_sub(@e[0], @b[0], @a[0]);
                fe_sub(@f[0], @d[0], @c[0]);
                fe_add(@g[0], @d[0], @c[0]);
                fe_add(@h[0], @b[0], @a[0]);
                fe_mul(r, @e[0], @f[0]);
                fe_mul(r + 8, @g[0], @h[0]);
                fe_mul(r + 16, @f[0], @g[0]);
                fe_mul(r + 24, @e[0], @h[0]);
            };

            def pt_copy(u64* r, u64* p) -> void
            {
                int i;
                for (i = 0; i < 32; i++) { r[i] = p[i]; };
            };

            def pt_identity(u64* r) -> void
            {
                fe_zero(r);
                fe_one(r + 8);
                fe_one(r + 16);
                fe_zero(r + 24);
            };

            def pt_neg(u64* r, u64* p) -> void
            {
                fe_neg(r, p);
                fe_copy(r + 8, p + 8);
                fe_copy(r + 16, p + 16);
                fe_neg(r + 24, p + 24);
            };

            // r = k * p for a 32 byte little endian scalar, the control flow does not depend on k
            def pt_scalarmult(u64* r, byte* k, u64* p) -> void
            {
                u64[32] acc, sum;
                int i, j, bit;
                u64 mk;
                pt_identity(@acc[0]);
                for (i = 255; i >= 0; i--)
                {
                    pt_add(@acc[0], @acc[0], @acc[0]);
                    pt_add(@sum[0], @acc[0], p);
                    bit = ((int)k[i / 8] >> (i % 8)) `& 1;
                    mk = (u64)0 - (u64)bit;
                    for (j = 0; j < 32; j++) { acc[j] = (acc[j] `& `!mk) `| (sum[j] `& mk); };
                };
                pt_copy(r, @acc[0]);
            };

            def pt_encode(byte* out, u64* p) -> void
            {
                u64[8] zi, x, y;
                fe_invert(@zi[0], p + 16);
                fe_mul(@x[0], p, @zi[0]);
                fe_mul(@y[0], p + 8, @zi[0]);
                fe_tobytes(out, @y[0]);
                out[31] = out[31] ^| (byte)(fe_isneg(@x[0]) << 7);
            };

            // returns 1 on success
            def pt_decode(u64* r, byte* inp) -> int
            {
                u64[8] y, y2, u, v, v3, v7, x, vxx, t, one;
                int sign;
                sign = (int)(inp[31] >> (byte)7);
                fe_frombytes(@y[0], inp);
                fe_one(@one[0]);
                fe_sq(@y2[0], @y[0]);
                fe_sub(@u[0], @y2[0], @one[0]);
                fe_mul(@v[0], @y2[0], @ED_D[0]);
                fe_add(@v[0], @v[0], @one[0]);
                fe_sq(@v3[0], @v[0]);
                fe_mul(@v3[0], @v3[0], @v[0]);
                fe_sq(@v7[0], @v3[0]);
                fe_mul(@v7[0], @v7[0], @v[0]);
                fe_mul(@t[0], @u[0], @v7[0]);
                fe_pow22523(@t[0], @t[0]);
                fe_mul(@x[0], @t[0], @u[0]);
                fe_mul(@x[0], @x[0], @v3[0]);
                fe_sq(@vxx[0], @x[0]);
                fe_mul(@vxx[0], @vxx[0], @v[0]);
                if (fe_equal(@vxx[0], @u[0]) == 0)
                {
                    fe_neg(@t[0], @u[0]);
                    if (fe_equal(@vxx[0], @t[0]) == 0) { return 0; };
                    fe_mul(@x[0], @x[0], @ED_SQRTM1[0]);
                };
                if (fe_isneg(@x[0]) != sign) { fe_neg(@x[0], @x[0]); };
                // x = 0 with the sign bit set is not a valid encoding
                fe_zero(@t[0]);
                if (fe_equal(@x[0], @t[0]) == 1 & sign == 1) { return 0; };
                fe_copy(r, @x[0]);
                fe_copy(r + 8, @y[0]);
                fe_one(r + 16);
                fe_mul(r + 24, @x[0], @y[0]);
                return 1;
            };

            def ed_init() -> void
            {
                u64[8] a, b, t;
                byte[32] enc;
                int i;
                if (ed_ready != 0) { return; };
                // d = -121665 / 121666
                fe_small(@a[0], (u64)121665);
                fe_neg(@a[0], @a[0]);
                fe_small(@b[0], (u64)121666);
                fe_invert(@b[0], @b[0]);
                fe_mul(@ED_D[0], @a[0], @b[0]);
                fe_add(@ED_D2[0], @ED_D[0], @ED_D[0]);
                // sqrt(-1) = 2^((p-1)/4)
                fe_small(@a[0], (u64)2);
                fe_pow22523(@t[0], @a[0]);          // 2^((p-5)/8)
                fe_sq(@t[0], @t[0]);                // 2^((p-5)/4)
                fe_mul(@ED_SQRTM1[0], @t[0], @a[0]);// 2^((p-1)/4)
                // base point: y = 4/5, x positive
                enc[0] = (byte)88;
                for (i = 1; i < 32; i++) { enc[i] = (byte)102; };
                ed_ready = 1;
                pt_decode(@ED_BASE[0], @enc[0]);
            };

            // ---- scalars mod L = 2^252 + 27742317777372353535851937790883648493 ----

            def sc_geq_l(u64* a) -> int
            {
                int i;
                u64[8] l;
                l[0] = (u64)1559614445; l[1] = (u64)1477600026; l[2] = (u64)2734136534; l[3] = (u64)350157278;
                l[4] = (u64)0; l[5] = (u64)0; l[6] = (u64)0; l[7] = (u64)268435456;
                for (i = 7; i >= 0; i--)
                {
                    if (a[i] > l[i]) { return 1; };
                    if (a[i] < l[i]) { return 0; };
                };
                return 1;
            };

            def sc_sub_l(u64* a) -> void
            {
                int i;
                u64[8] l;
                u64 br, d;
                l[0] = (u64)1559614445; l[1] = (u64)1477600026; l[2] = (u64)2734136534; l[3] = (u64)350157278;
                l[4] = (u64)0; l[5] = (u64)0; l[6] = (u64)0; l[7] = (u64)268435456;
                br = (u64)0;
                for (i = 0; i < 8; i++)
                {
                    d = a[i] + (u64)4294967296 - l[i] - br;
                    a[i] = d `& (u64)4294967295;
                    br = (u64)1 - (d >> (u64)32);
                };
            };

            // reduces a 512 bit little endian number (16 limbs of 32 bits) mod L into 8 limbs
            def sc_reduce(u64* inp16, u64* out8) -> void
            {
                int i, b, j;
                u64 c, bit;
                for (i = 0; i < 8; i++) { out8[i] = (u64)0; };
                for (b = 511; b >= 0; b--)
                {
                    bit = (inp16[b / 32] >> (u64)(b % 32)) `& (u64)1;
                    c = bit;
                    for (j = 0; j < 8; j++)
                    {
                        c = (out8[j] << (u64)1) `| c;
                        out8[j] = c `& (u64)4294967295;
                        c = c >> (u64)32;
                    };
                    if (sc_geq_l(out8) == 1) { sc_sub_l(out8); };
                };
            };

            def sc_from_bytes(u64* out16, byte* inp, int n) -> void
            {
                int i;
                for (i = 0; i < 16; i++) { out16[i] = (u64)0; };
                for (i = 0; i < n; i++) { out16[i / 4] = out16[i / 4] `| ((u64)inp[i] << (u64)(8 * (i % 4))); };
            };

            def sc_to_bytes(byte* out, u64* a8) -> void
            {
                int i;
                for (i = 0; i < 32; i++) { out[i] = (byte)((a8[i / 4] >> (u64)(8 * (i % 4))) `& (u64)255); };
            };

            // r = (a * b + c) mod L, all 8 limb scalars
            def sc_muladd(u64* r, u64* a, u64* b, u64* c) -> void
            {
                u64[17] t;
                u64[16] full;
                int i, j;
                u64 p, cr;
                for (i = 0; i < 17; i++) { t[i] = (u64)0; };
                for (i = 0; i < 8; i++)
                {
                    for (j = 0; j < 8; j++)
                    {
                        p = a[i] * b[j];
                        t[i + j] = t[i + j] + (p `& (u64)4294967295);
                        t[i + j + 1] = t[i + j + 1] + (p >> (u64)32);
                    };
                };
                for (i = 0; i < 8; i++) { t[i] = t[i] + c[i]; };
                cr = (u64)0;
                for (i = 0; i < 16; i++)
                {
                    t[i] = t[i] + cr;
                    cr = t[i] >> (u64)32;
                    full[i] = t[i] `& (u64)4294967295;
                };
                sc_reduce(@full[0], r);
            };

            // ---- API ----

            def ed_expand(byte* seed, byte* a, byte* prefix) -> void
            {
                byte[64] h;
                int i;
                SHA384::sha512(seed, (u64)32, @h[0]);
                for (i = 0; i < 32; i++) { a[i] = h[i]; prefix[i] = h[32 + i]; };
                a[0] = a[0] `& (byte)248;
                a[31] = a[31] `& (byte)127;
                a[31] = a[31] `| (byte)64;
            };

            def ed25519_publickey(byte* seed, byte* pub) -> void
            {
                byte[32] a, prefix;
                u64[32] A;
                ed_init();
                ed_expand(seed, @a[0], @prefix[0]);
                pt_scalarmult(@A[0], @a[0], @ED_BASE[0]);
                pt_encode(pub, @A[0]);
            };

            def ed25519_sign(byte* seed, byte* msg, int msg_len, byte* sig) -> void
            {
                byte[32] a, prefix, pub, rb, kb;
                byte[64] h;
                u64[32] R, A;
                u64[16] wide;
                u64[8] r, k, sa, s, zero;
                SHA384_CTX ctx;
                int i;
                ed_init();
                ed_expand(seed, @a[0], @prefix[0]);
                pt_scalarmult(@A[0], @a[0], @ED_BASE[0]);
                pt_encode(@pub[0], @A[0]);

                SHA384::sha512_init(@ctx);
                SHA384::sha512_update(@ctx, @prefix[0], (u64)32);
                SHA384::sha512_update(@ctx, msg, (u64)msg_len);
                SHA384::sha512_final(@ctx, @h[0]);
                sc_from_bytes(@wide[0], @h[0], 64);
                sc_reduce(@wide[0], @r[0]);
                sc_to_bytes(@kb[0], @r[0]);
                pt_scalarmult(@R[0], @kb[0], @ED_BASE[0]);
                pt_encode(@rb[0], @R[0]);

                SHA384::sha512_init(@ctx);
                SHA384::sha512_update(@ctx, @rb[0], (u64)32);
                SHA384::sha512_update(@ctx, @pub[0], (u64)32);
                SHA384::sha512_update(@ctx, msg, (u64)msg_len);
                SHA384::sha512_final(@ctx, @h[0]);
                sc_from_bytes(@wide[0], @h[0], 64);
                sc_reduce(@wide[0], @k[0]);

                // S = (r + k * a) mod L
                sc_from_bytes(@wide[0], @a[0], 32);
                for (i = 0; i < 8; i++) { sa[i] = wide[i]; };
                sc_muladd(@s[0], @k[0], @sa[0], @r[0]);

                for (i = 0; i < 32; i++) { sig[i] = rb[i]; };
                sc_to_bytes(sig + 32, @s[0]);
            };

            def ed25519_verify(byte* pub, byte* msg, int msg_len, byte* sig) -> int
            {
                byte[32] kb, sb, chk;
                byte[64] h;
                u64[32] A, nA, SB, kA, R2;
                u64[16] wide;
                u64[8] k, s;
                SHA384_CTX ctx;
                int i, d;
                ed_init();
                // S must be below L
                sc_from_bytes(@wide[0], sig + 32, 32);
                for (i = 0; i < 8; i++) { s[i] = wide[i]; };
                if (sc_geq_l(@s[0]) == 1) { return 0; };
                if (pt_decode(@A[0], pub) == 0) { return 0; };

                SHA384::sha512_init(@ctx);
                SHA384::sha512_update(@ctx, sig, (u64)32);
                SHA384::sha512_update(@ctx, pub, (u64)32);
                SHA384::sha512_update(@ctx, msg, (u64)msg_len);
                SHA384::sha512_final(@ctx, @h[0]);
                sc_from_bytes(@wide[0], @h[0], 64);
                sc_reduce(@wide[0], @k[0]);
                sc_to_bytes(@kb[0], @k[0]);
                sc_to_bytes(@sb[0], @s[0]);

                // R' = S*B - k*A must encode to the R in the signature
                pt_scalarmult(@SB[0], @sb[0], @ED_BASE[0]);
                pt_neg(@nA[0], @A[0]);
                pt_scalarmult(@kA[0], @kb[0], @nA[0]);
                pt_add(@R2[0], @SB[0], @kA[0]);
                pt_encode(@chk[0], @R2[0]);
                d = 0;
                for (i = 0; i < 32; i++) { d = d `| ((int)chk[i] ^| (int)sig[i]); };
                if (d == 0) { return 1; };
                return 0;
            };
        };

        namespace KDF
        {
            namespace HKDF
            {

                #def HKDF_HASHLEN 32;
                #def HKDF_BLOCKLEN 64;

                // ------------------------------------------------------------------
                // Internal: HMAC-SHA256(key[key_len], msg[msg_len]) -> out[32]
                //
                // Laid out inline here so HKDF has no external dependency beyond
                // the SHA-256 primitives already in cryptography.idk.
                // ------------------------------------------------------------------
                def hmac_sha256(byte* key, int key_len,
                                byte* msg, int msg_len,
                                byte* out) -> void
                {
                    byte[64] ipad_key, opad_key;
                    byte[32] inner_hash, hashed_key;
                    SHA256_CTX inner_ctx, outer_ctx, key_ctx;
                    byte* effective_key;
                    int effective_key_len, i;
                    byte k;

                    // RFC 2104 §2: if key is longer than block size, hash it first
                    if (key_len > 64)
                    {
                        SHA256::sha256_init(@key_ctx);
                        SHA256::sha256_update(@key_ctx, key, (u64)key_len);
                        SHA256::sha256_final(@key_ctx, @hashed_key[0]);
                        effective_key = @hashed_key[0];
                        effective_key_len = 32;
                    }
                    else
                    {
                        effective_key = key;
                        effective_key_len = key_len;
                    };

                    for (i = 0; i < 64; i++)
                    {
                        k = (i < effective_key_len) ? effective_key[i] : (byte)0;
                        ipad_key[i] = k ^| (byte)0x36;
                        opad_key[i] = k ^| (byte)0x5C;
                    };

                    SHA256::sha256_init(@inner_ctx);
                    SHA256::sha256_update(@inner_ctx, @ipad_key[0], 64);
                    SHA256::sha256_update(@inner_ctx, msg, (u64)msg_len);
                    SHA256::sha256_final(@inner_ctx, @inner_hash[0]);

                    SHA256::sha256_init(@outer_ctx);
                    SHA256::sha256_update(@outer_ctx, @opad_key[0], 64);
                    SHA256::sha256_update(@outer_ctx, @inner_hash[0], 32);
                    SHA256::sha256_final(@outer_ctx, out);
                };

                // ------------------------------------------------------------------
                // HKDF-Extract
                //
                //   PRK = HMAC-SHA256(salt, ikm)
                //
                //   salt     : pointer to salt bytes; may be null
                //   salt_len : byte length of salt; ignored when salt is null
                //   ikm      : input keying material
                //   ikm_len  : byte length of ikm
                //   prk      : output buffer, must be >= 32 bytes
                // ------------------------------------------------------------------
                def hkdf_extract(byte* salt, int salt_len,
                                 byte* ikm,  int ikm_len,
                                 byte* prk) -> void
                {
                    // RFC 5869 §2.2: if salt is not provided, set to HashLen zero bytes
                    byte[32] zero_salt;
                    byte* effective_salt;
                    int effective_salt_len;

                    if (salt == (byte*)0)
                    {
                        effective_salt = @zero_salt[0];
                        effective_salt_len = 32;
                    }
                    else
                    {
                        effective_salt = salt;
                        effective_salt_len = salt_len;
                    };

                    hmac_sha256(effective_salt, effective_salt_len, ikm, ikm_len, prk);
                };

                // ------------------------------------------------------------------
                // HKDF-Expand
                //
                //   OKM = T(1) || T(2) || ... truncated to L bytes
                //   T(i) = HMAC-SHA256(PRK, T(i-1) || info || i)
                //
                //   prk      : pseudorandom key from hkdf_extract (32 bytes)
                //   info     : context-specific info string; may be null
                //   info_len : byte length of info; ignored when info is null
                //   okm      : output key material buffer
                //   okm_len  : requested output length in bytes (<= 8160)
                //
                // Returns 1 on success, 0 if okm_len > 255 * HKDF_HASHLEN.
                // ------------------------------------------------------------------
                def hkdf_expand(byte* prk,
                                byte* info,  int info_len,
                                byte* okm,   int okm_len) -> int
                {
                    // T(i-1): starts empty, then holds the previous 32-byte block
                    byte[32] t_prev, t_cur;
                    // HMAC input: T(i-1) || info || counter_byte
                    // Max size: 32 + info_len + 1 — but info_len is caller-controlled.
                    // We build it on the heap to handle arbitrary info lengths safely.
                    // For TLS 1.3 labels the info is always small (<= ~255 bytes),
                    // so a 320-byte stack buffer is enough and avoids fmalloc.
                    byte[320] hmac_in;
                    int n, i, j, offset, prev_len, copy_len, built;
                    byte counter;

                    if (okm_len > (255 * 32))
                    {
                        return 0;
                    };

                    // n = ceil(okm_len / HashLen)
                    n = (okm_len + 31) / 32;

                    for (i = 1; i <= n; i++)
                    {
                        // Build HMAC input: T(i-1) || info || i
                        built = 0;
                        prev_len = (i == 1) ? 0 : 32;

                        for (j = 0; j < prev_len; j++)
                        {
                            hmac_in[built] = t_prev[j];
                            built = built + 1;
                        };

                        if (info != (byte*)0)
                        {
                            for (j = 0; j < info_len; j++)
                            {
                                hmac_in[built] = info[j];
                                built = built + 1;
                            };
                        };

                        counter = (byte)i;
                        hmac_in[built] = counter;
                        built = built + 1;

                        hmac_sha256(prk, 32, @hmac_in[0], built, @t_cur[0]);

                        // Copy min(32, okm_len - offset) bytes to output
                        copy_len = okm_len - offset;
                        if (copy_len > 32)
                        {
                            copy_len = 32;
                        };

                        for (j = 0; j < copy_len; j++)
                        {
                            okm[offset + j] = t_cur[j];
                        };
                        offset = offset + copy_len;

                        // Promote t_cur -> t_prev for next iteration
                        for (j = 0; j < 32; j++)
                        {
                            t_prev[j] = t_cur[j];
                        };
                    };

                    return 1;
                };

                // ------------------------------------------------------------------
                // Convenience: full HKDF in one call
                //
                //   Combines Extract + Expand.
                //
                //   salt / salt_len : may pass null / 0 to use zero-byte salt
                //   ikm  / ikm_len  : input keying material
                //   info / info_len : context label; may pass null / 0
                //   okm  / okm_len  : output buffer and requested byte count
                //
                // Returns 1 on success, 0 on length violation.
                // ------------------------------------------------------------------
                def hkdf(byte* salt, int salt_len,
                         byte* ikm,  int ikm_len,
                         byte* info, int info_len,
                         byte* okm,  int okm_len) -> int
                {
                    byte[32] prk;

                    hkdf_extract(salt, salt_len, ikm, ikm_len, @prk[0]);
                    return hkdf_expand(@prk[0], info, info_len, okm, okm_len);
                };

                // ------------------------------------------------------------------
                // HMAC-SHA384 and HMAC-SHA512 (block size 128 bytes)
                // ------------------------------------------------------------------
                def hmac_sha2_128(byte* key, int key_len,
                                  byte* msg, int msg_len,
                                  byte* out, bool is384) -> void
                {
                    byte[128] ipad_key, opad_key;
                    byte[64] inner_hash, hashed_key;
                    SHA384_CTX inner_ctx, outer_ctx, key_ctx;
                    byte* effective_key;
                    int effective_key_len, i, dlen;
                    byte k;

                    dlen = is384 ? 48 : 64;

                    if (key_len > 128)
                    {
                        if (is384) { SHA384::sha384_init(@key_ctx); } else { SHA384::sha512_init(@key_ctx); };
                        SHA384::sha384_update(@key_ctx, key, (u64)key_len);
                        if (is384) { SHA384::sha384_final(@key_ctx, @hashed_key[0]); } else { SHA384::sha512_final(@key_ctx, @hashed_key[0]); };
                        effective_key = @hashed_key[0];
                        effective_key_len = dlen;
                    }
                    else
                    {
                        effective_key = key;
                        effective_key_len = key_len;
                    };

                    for (i = 0; i < 128; i++)
                    {
                        k = (i < effective_key_len) ? effective_key[i] : (byte)0;
                        ipad_key[i] = k ^| (byte)0x36;
                        opad_key[i] = k ^| (byte)0x5C;
                    };

                    if (is384) { SHA384::sha384_init(@inner_ctx); } else { SHA384::sha512_init(@inner_ctx); };
                    SHA384::sha384_update(@inner_ctx, @ipad_key[0], (u64)128);
                    SHA384::sha384_update(@inner_ctx, msg, (u64)msg_len);
                    if (is384) { SHA384::sha384_final(@inner_ctx, @inner_hash[0]); } else { SHA384::sha512_final(@inner_ctx, @inner_hash[0]); };

                    if (is384) { SHA384::sha384_init(@outer_ctx); } else { SHA384::sha512_init(@outer_ctx); };
                    SHA384::sha384_update(@outer_ctx, @opad_key[0], (u64)128);
                    SHA384::sha384_update(@outer_ctx, @inner_hash[0], (u64)dlen);
                    if (is384) { SHA384::sha384_final(@outer_ctx, out); } else { SHA384::sha512_final(@outer_ctx, out); };
                };

                def hmac_sha384(byte* key, int key_len, byte* msg, int msg_len, byte* out) -> void
                {
                    hmac_sha2_128(key, key_len, msg, msg_len, out, true);
                };

                def hmac_sha512(byte* key, int key_len, byte* msg, int msg_len, byte* out) -> void
                {
                    hmac_sha2_128(key, key_len, msg, msg_len, out, false);
                };

                // ------------------------------------------------------------------
                // HKDF over SHA-384 (HashLen 48), as used by TLS_AES_256_GCM_SHA384
                // ------------------------------------------------------------------
                def hkdf_extract_sha384(byte* salt, int salt_len,
                                        byte* ikm,  int ikm_len,
                                        byte* prk) -> void
                {
                    byte[48] zero_salt;
                    int i;

                    if (salt == (byte*)0)
                    {
                        for (i = 0; i < 48; i++) { zero_salt[i] = (byte)0; };
                        hmac_sha384(@zero_salt[0], 48, ikm, ikm_len, prk);
                    }
                    else
                    {
                        hmac_sha384(salt, salt_len, ikm, ikm_len, prk);
                    };
                };

                // Returns 1 on success, 0 if okm_len > 255 * 48
                def hkdf_expand_sha384(byte* prk,
                                       byte* info, int info_len,
                                       byte* okm,  int okm_len) -> int
                {
                    byte[48] t_prev, t_cur;
                    byte[320] hmac_in;
                    int n, i, j, offset, prev_len, copy_len, built;

                    if (okm_len > (255 * 48)) { return 0; };
                    if (info_len > 270) { return 0; };

                    offset = 0;
                    n = (okm_len + 47) / 48;

                    for (i = 1; i <= n; i++)
                    {
                        built = 0;
                        prev_len = (i == 1) ? 0 : 48;
                        for (j = 0; j < prev_len; j++)
                        {
                            hmac_in[built] = t_prev[j];
                            built = built + 1;
                        };
                        if (info != (byte*)0)
                        {
                            for (j = 0; j < info_len; j++)
                            {
                                hmac_in[built] = info[j];
                                built = built + 1;
                            };
                        };
                        hmac_in[built] = (byte)i;
                        built = built + 1;

                        hmac_sha384(prk, 48, @hmac_in[0], built, @t_cur[0]);

                        copy_len = okm_len - offset;
                        if (copy_len > 48) { copy_len = 48; };
                        for (j = 0; j < copy_len; j++) { okm[offset + j] = t_cur[j]; };
                        offset = offset + copy_len;
                        for (j = 0; j < 48; j++) { t_prev[j] = t_cur[j]; };
                    };

                    return 1;
                };

            }; // HKDF

            // =================================================================
            // PBKDF2 (RFC 8018) with HMAC-SHA256 or HMAC-SHA512
            //
            //   pbkdf2_sha256(pw, pw_len, salt, salt_len, iterations, out, out_len) -> bool
            //   pbkdf2_sha512(pw, pw_len, salt, salt_len, iterations, out, out_len) -> bool
            //
            // Returns false when salt_len is above 256 or iterations is below 1.
            // =================================================================
            namespace PBKDF2
            {
                // sbuf holds the salt followed by 4 spare bytes, which are overwritten with the block counter.
                def pbkdf2_buf(byte* pw, int pw_len, byte* sbuf, int salt_len, int iterations,
                               byte* out, int out_len, bool wide) -> bool
                {
                    byte[64] u, t;
                    int hlen, blocks, bi, i, j, n;
                    if (iterations < 1 | out_len < 1) { return false; };
                    hlen = 32;
                    if (wide) { hlen = 64; };
                    blocks = (out_len + hlen - 1) / hlen;
                    for (bi = 1; bi <= blocks; bi++)
                    {
                        sbuf[salt_len] = (byte)((bi >> 24) `& 255);
                        sbuf[salt_len + 1] = (byte)((bi >> 16) `& 255);
                        sbuf[salt_len + 2] = (byte)((bi >> 8) `& 255);
                        sbuf[salt_len + 3] = (byte)(bi `& 255);
                        if (wide) { HKDF::hmac_sha512(pw, pw_len, sbuf, salt_len + 4, @u[0]); }
                        else { HKDF::hmac_sha256(pw, pw_len, sbuf, salt_len + 4, @u[0]); };
                        for (i = 0; i < hlen; i++) { t[i] = u[i]; };
                        for (j = 1; j < iterations; j++)
                        {
                            if (wide) { HKDF::hmac_sha512(pw, pw_len, @u[0], hlen, @u[0]); }
                            else { HKDF::hmac_sha256(pw, pw_len, @u[0], hlen, @u[0]); };
                            for (i = 0; i < hlen; i++) { t[i] = t[i] ^| u[i]; };
                        };
                        n = out_len - (bi - 1) * hlen;
                        if (n > hlen) { n = hlen; };
                        for (i = 0; i < n; i++) { out[(bi - 1) * hlen + i] = t[i]; };
                    };
                    return true;
                };

                def pbkdf2_core(byte* pw, int pw_len, byte* salt, int salt_len, int iterations,
                                byte* out, int out_len, bool wide) -> bool
                {
                    byte[320] sblock;
                    int i;
                    if (salt_len > 256) { return false; };
                    for (i = 0; i < salt_len; i++) { sblock[i] = salt[i]; };
                    return pbkdf2_buf(pw, pw_len, @sblock[0], salt_len, iterations, out, out_len, wide);
                };

                def pbkdf2_sha256(byte* pw, int pw_len, byte* salt, int salt_len, int iterations,
                                  byte* out, int out_len) -> bool
                {
                    return pbkdf2_core(pw, pw_len, salt, salt_len, iterations, out, out_len, false);
                };

                def pbkdf2_sha512(byte* pw, int pw_len, byte* salt, int salt_len, int iterations,
                                  byte* out, int out_len) -> bool
                {
                    return pbkdf2_core(pw, pw_len, salt, salt_len, iterations, out, out_len, true);
                };
            }; // PBKDF2

            // =================================================================
            // scrypt (RFC 7914)
            //
            //   scrypt_work_size(N, r, p) -> u64          bytes of scratch the caller must supply
            //   scrypt(pw, pw_len, salt, salt_len, N, r, p, work, out, out_len) -> bool
            //
            // N must be a power of two above 1, r and p at least 1, salt_len at most 256.
            // work is the scratch buffer of scrypt_work_size bytes (no allocator is used).
            // Typical interactive parameters: N = 16384, r = 8, p = 1 (16 MiB of scratch).
            // =================================================================
            namespace Scrypt
            {
                def sc_rotl(u32 x, u32 n) -> u32
                {
                    return (x << n) `| (x >> (32u - n));
                };

                def sc_le32(byte* p) -> u32
                {
                    return (u32)p[0] `| ((u32)p[1] << 8u) `| ((u32)p[2] << 16u) `| ((u32)p[3] << 24u);
                };

                def sc_put32(byte* p, u32 v) -> void
                {
                    p[0] = (byte)(v `& 255u);
                    p[1] = (byte)((v >> 8u) `& 255u);
                    p[2] = (byte)((v >> 16u) `& 255u);
                    p[3] = (byte)((v >> 24u) `& 255u);
                };

                // Salsa20/8 core on 64 bytes in place
                def salsa20_8(byte* b) -> void
                {
                    u32[16] x, in16;
                    int i;
                    for (i = 0; i < 16; i++) { in16[i] = sc_le32(b + i * 4); x[i] = in16[i]; };
                    for (i = 0; i < 8; i = i + 2)
                    {
                        x[4] = x[4] ^| sc_rotl(x[0] + x[12], 7u);   x[8] = x[8] ^| sc_rotl(x[4] + x[0], 9u);
                        x[12] = x[12] ^| sc_rotl(x[8] + x[4], 13u); x[0] = x[0] ^| sc_rotl(x[12] + x[8], 18u);
                        x[9] = x[9] ^| sc_rotl(x[5] + x[1], 7u);    x[13] = x[13] ^| sc_rotl(x[9] + x[5], 9u);
                        x[1] = x[1] ^| sc_rotl(x[13] + x[9], 13u);  x[5] = x[5] ^| sc_rotl(x[1] + x[13], 18u);
                        x[14] = x[14] ^| sc_rotl(x[10] + x[6], 7u); x[2] = x[2] ^| sc_rotl(x[14] + x[10], 9u);
                        x[6] = x[6] ^| sc_rotl(x[2] + x[14], 13u);  x[10] = x[10] ^| sc_rotl(x[6] + x[2], 18u);
                        x[3] = x[3] ^| sc_rotl(x[15] + x[11], 7u);  x[7] = x[7] ^| sc_rotl(x[3] + x[15], 9u);
                        x[11] = x[11] ^| sc_rotl(x[7] + x[3], 13u); x[15] = x[15] ^| sc_rotl(x[11] + x[7], 18u);
                        x[1] = x[1] ^| sc_rotl(x[0] + x[3], 7u);    x[2] = x[2] ^| sc_rotl(x[1] + x[0], 9u);
                        x[3] = x[3] ^| sc_rotl(x[2] + x[1], 13u);   x[0] = x[0] ^| sc_rotl(x[3] + x[2], 18u);
                        x[6] = x[6] ^| sc_rotl(x[5] + x[4], 7u);    x[7] = x[7] ^| sc_rotl(x[6] + x[5], 9u);
                        x[4] = x[4] ^| sc_rotl(x[7] + x[6], 13u);   x[5] = x[5] ^| sc_rotl(x[4] + x[7], 18u);
                        x[11] = x[11] ^| sc_rotl(x[10] + x[9], 7u); x[8] = x[8] ^| sc_rotl(x[11] + x[10], 9u);
                        x[9] = x[9] ^| sc_rotl(x[8] + x[11], 13u);  x[10] = x[10] ^| sc_rotl(x[9] + x[8], 18u);
                        x[12] = x[12] ^| sc_rotl(x[15] + x[14], 7u); x[13] = x[13] ^| sc_rotl(x[12] + x[15], 9u);
                        x[14] = x[14] ^| sc_rotl(x[13] + x[12], 13u); x[15] = x[15] ^| sc_rotl(x[14] + x[13], 18u);
                    };
                    for (i = 0; i < 16; i++) { sc_put32(b + i * 4, x[i] + in16[i]); };
                };

                // BlockMix over 2r 64 byte blocks, y is scratch of the same size, result left in b
                def block_mix(byte* b, byte* y, int r) -> void
                {
                    byte[64] x;
                    int i, k;
                    for (k = 0; k < 64; k++) { x[k] = b[(2 * r - 1) * 64 + k]; };
                    for (i = 0; i < 2 * r; i++)
                    {
                        for (k = 0; k < 64; k++) { x[k] = x[k] ^| b[i * 64 + k]; };
                        salsa20_8(@x[0]);
                        // even blocks go first, odd blocks second
                        if (i % 2 == 0) { for (k = 0; k < 64; k++) { y[(i / 2) * 64 + k] = x[k]; }; }
                        else { for (k = 0; k < 64; k++) { y[(r + i / 2) * 64 + k] = x[k]; }; };
                    };
                    for (k = 0; k < 128 * r; k++) { b[k] = y[k]; };
                };

                def scrypt_work_size(u64 N, int r, int p) -> u64
                {
                    // V (N * 128 * r) + X (128 * r) + Y (128 * r) + B (p * 128 * r) + 4 spare bytes
                    return N * (u64)128 * (u64)r + (u64)(128 * r) * (u64)(2 + p) + (u64)4;
                };

                def romix(byte* b, int r, u64 N, byte* v, byte* x, byte* y) -> void
                {
                    u64 i, j;
                    int k;
                    int blen = 128 * r;
                    for (k = 0; k < blen; k++) { x[k] = b[k]; };
                    for (i = (u64)0; i < N; i++)
                    {
                        for (k = 0; k < blen; k++) { v[i * (u64)blen + (u64)k] = x[k]; };
                        block_mix(x, y, r);
                    };
                    for (i = (u64)0; i < N; i++)
                    {
                        // Integerify: first 8 bytes of the last 64 byte block, little endian
                        j = (u64)sc_le32(x + (2 * r - 1) * 64) `| ((u64)sc_le32(x + (2 * r - 1) * 64 + 4) << (u64)32);
                        j = j `& (N - (u64)1);
                        for (k = 0; k < blen; k++) { x[k] = x[k] ^| v[j * (u64)blen + (u64)k]; };
                        block_mix(x, y, r);
                    };
                    for (k = 0; k < blen; k++) { b[k] = x[k]; };
                };

                def scrypt(byte* pw, int pw_len, byte* salt, int salt_len, u64 N, int r, int p,
                           byte* work, byte* out, int out_len) -> bool
                {
                    byte* v;
                    byte* x;
                    byte* y;
                    byte* b;
                    int i;
                    int blen = 128 * r;
                    if (N < (u64)2 | (N `& (N - (u64)1)) != (u64)0 | r < 1 | p < 1) { return false; };
                    v = work;
                    x = work + N * (u64)blen;
                    y = x + blen;
                    b = y + blen;
                    if (!PBKDF2::pbkdf2_sha256(pw, pw_len, salt, salt_len, 1, b, p * blen)) { return false; };
                    for (i = 0; i < p; i++) { romix(b + i * blen, r, N, v, x, y); };
                    // the final PBKDF2 uses B as its salt, with 4 spare bytes after it in work
                    return PBKDF2::pbkdf2_buf(pw, pw_len, b, p * blen, 1, out, out_len, false);
                };
            }; // Scrypt
        }; // kdf

        namespace ECDSA
        {
            // =========================================================================
            // ECDSA over P-256 (secp256r1 / prime256v1)
            //
            // Curve:  y² = x³ - 3x + b  over  GF(p)
            //
            //   p  = 2^256 - 2^224 + 2^192 + 2^96 - 1
            //   n  = FFFFFFFF00000000FFFFFFFFFFFFFFFFBCE6FAADA7179E84F3B9CAC2FC632551
            //   b  = 5AC635D8AA3A93E7B3EBBD55769886BC651D06B0CC53B0F63BCE3C3E27D2604B
            //   Gx = 6B17D1F2E12C4247F8BCE6E563A440F277037D812DEB33A0F4A13945D898C296
            //   Gy = 4FE342E2FE1A7F9B8EE7EB4A7C0F9E162BCE33576B315ECECBB6406837BF51F5
            //
            // Public API:
            //   ecdsa_p256_load_scalar(BigInt* out, byte* src_be32)
            //   ecdsa_p256_store_scalar(byte* dst_be32, BigInt* src)
            //   ecdsa_p256_point_mul(BigInt* rx, BigInt* ry, BigInt* k, BigInt* px, BigInt* py)
            //   ecdsa_p256_pubkey(byte* qx32, byte* qy32, byte* privkey32)
            //   ecdsa_p256_sign(byte* sig_r32, byte* sig_s32, byte* privkey32,
            //                   byte* hash32, byte* nonce32) -> bool
            //   ecdsa_p256_verify(byte* sig_r32, byte* sig_s32, byte* pubx32, byte* puby32,
            //                     byte* hash32) -> bool
            //   ecdsa_p256_encode_der(byte* der_out, int* der_len, byte* r32, byte* s32)
            //   ecdsa_p256_decode_der(byte* r32, byte* s32, byte* der_in, int der_len) -> bool
            // =========================================================================

            // ---- Curve constants (global so they are not zero-initialized away) ----

            // p = FFFFFFFF 00000001 00000000 00000000 00000000 FFFFFFFF FFFFFFFF FFFFFFFF
            global uint[8] P256_P = [
                0xFFFFFFFFu, 0xFFFFFFFFu, 0xFFFFFFFFu, 0x00000000u,
                0x00000000u, 0x00000000u, 0x00000001u, 0xFFFFFFFFu
            ];

            // n = FFFFFFFF 00000000 FFFFFFFF FFFFFFFF BCE6FAAD A7179E84 F3B9CAC2 FC632551
            global uint[8] P256_N = [
                0xFC632551u, 0xF3B9CAC2u, 0xA7179E84u, 0xBCE6FAADu,
                0xFFFFFFFFu, 0xFFFFFFFFu, 0x00000000u, 0xFFFFFFFFu
            ];

            // b = 5AC635D8 AA3A93E7 B3EBBD55 769886BC 651D06B0 CC53B0F6 3BCE3C3E 27D2604B
            global uint[8] P256_B = [
                0x27D2604Bu, 0x3BCE3C3Eu, 0xCC53B0F6u, 0x651D06B0u,
                0x769886BCu, 0xB3EBBD55u, 0xAA3A93E7u, 0x5AC635D8u
            ];

            // Gx = 6B17D1F2 E12C4247 F8BCE6E5 63A440F2 77037D81 2DEB33A0 F4A13945 D898C296
            global uint[8] P256_GX = [
                0xD898C296u, 0xF4A13945u, 0x2DEB33A0u, 0x77037D81u,
                0x63A440F2u, 0xF8BCE6E5u, 0xE12C4247u, 0x6B17D1F2u
            ];

            // Gy = 4FE342E2 FE1A7F9B 8EE7EB4A 7C0F9E16 2BCE3357 6B315ECE CBB64068 37BF51F5
            global uint[8] P256_GY = [
                0x37BF51F5u, 0xCBB64068u, 0x6B315ECEu, 0x2BCE3357u,
                0x7C0F9E16u, 0x8EE7EB4Au, 0xFE1A7F9Bu, 0x4FE342E2u
            ];

            // ---- Load / store (big-endian 32-byte scalars, per ECDSA convention) ----

            def ecdsa_p256_load_scalar(BigInt* out, byte* src) -> void
            {
                uint i, j;
                uint* d = @out.digits[0];
                for (i = 0; i < 9; i++) { d[i] = 0; };
                // 32 bytes big-endian -> 8 uint32 little-endian limbs
                for (i = 0; i < 8; i++)
                {
                    j = (7 - i) * 4;
                    d[i] = ((uint)src[j]     << 24) |
                           ((uint)src[j + 1] << 16) |
                           ((uint)src[j + 2] << 8)  |
                            (uint)src[j + 3];
                };
                out.length = 8;
                out.negative = false;
                math::bigint::bigint_normalize(out);
                return;
            };

            def ecdsa_p256_store_scalar(byte* dst, BigInt* src) -> void
            {
                uint i, j;
                uint* d = @src.digits[0];
                uint word;
                for (i = 0; i < 8; i++)
                {
                    j = (7 - i) * 4;
                    word = (i < src.length) ? d[i] : 0u;
                    dst[j]     = (byte)((word >> 24) & 0xFF);
                    dst[j + 1] = (byte)((word >> 16) & 0xFF);
                    dst[j + 2] = (byte)((word >> 8)  & 0xFF);
                    dst[j + 3] = (byte)(word & 0xFF);
                };
                return;
            };

            // ---- Field helpers (mod p) ----

            def p256_set_p(BigInt* out) -> void
            {
                uint* d = @out.digits[0];
                uint* s = @P256_P[0];
                uint i;
                for (i = 0; i < 8; i++) { d[i] = s[i]; };
                out.length = 8;
                out.negative = false;
                math::bigint::bigint_normalize(out);
                return;
            };

            def p256_set_n(BigInt* out) -> void
            {
                uint* d = @out.digits[0];
                uint* s = @P256_N[0];
                uint i;
                for (i = 0; i < 8; i++) { d[i] = s[i]; };
                out.length = 8;
                out.negative = false;
                math::bigint::bigint_normalize(out);
                return;
            };

            def p256_fp_add(BigInt* out, BigInt* a, BigInt* b) -> void
            {
                BigInt p, tmp;
                p256_set_p(@p);
                math::bigint::bigint_add(@tmp, a, b);
                math::bigint::bigint_mod(out, @tmp, @p);
                return;
            };

            def p256_fp_sub(BigInt* out, BigInt* a, BigInt* b) -> void
            {
                BigInt p, tmp;
                p256_set_p(@p);
                math::bigint::bigint_sub(@tmp, a, b);
                if (tmp.negative)
                {
                    math::bigint::bigint_add(@tmp, @tmp, @p);
                    if (tmp.negative)
                    {
                        math::bigint::bigint_add(out, @tmp, @p);
                    }
                    else
                    {
                        math::bigint::bigint_copy(out, @tmp);
                    };
                }
                else
                {
                    math::bigint::bigint_mod(out, @tmp, @p);
                };
                return;
            };

            def p256_fp_mul(BigInt* out, BigInt* a, BigInt* b) -> void
            {
                BigInt p, tmp;
                p256_set_p(@p);
                math::bigint::bigint_mul(@tmp, a, b);
                math::bigint::bigint_mod(out, @tmp, @p);
                return;
            };

            def p256_fp_sq(BigInt* out, BigInt* a) -> void
            {
                p256_fp_mul(out, a, a);
                return;
            };

            // Modular inverse in GF(p): out = a^(p-2) mod p  (Fermat's little theorem)
            def p256_fp_inv(BigInt* out, BigInt* a) -> void
            {
                BigInt p, exp, two, tmp;
                uint i, j;
                uint word;
                uint* expd;

                p256_set_p(@p);
                math::bigint::bigint_from_uint(@two, 2);
                math::bigint::bigint_sub(@exp, @p, @two);

                math::bigint::bigint_one(out);
                math::bigint::bigint_copy(@tmp, a);

                expd = @exp.digits[0];
                for (i = 0; i < exp.length; i++)
                {
                    word = expd[i];
                    for (j = 0; j < 32; j++)
                    {
                        if ((word & 1) != 0)
                        {
                            p256_fp_mul(out, out, @tmp);
                        };
                        word = word >> 1;
                        p256_fp_sq(@tmp, @tmp);
                    };
                };
                return;
            };

            // ---- Projective (Jacobian) point arithmetic ----
            //
            // A Jacobian point (X:Y:Z) represents affine (X/Z², Y/Z³).
            // The point at infinity is represented as Z = 0.

            // Point double in Jacobian coordinates over P-256.
            // Algorithm: standard Jacobian doubling for a = -3 curves.
            def p256_point_dbl(BigInt* rx, BigInt* ry, BigInt* rz,
                               BigInt* px, BigInt* py, BigInt* pz) -> void
            {
                // Copy inputs to locals first to handle in-place calls (rx==px etc.)
                BigInt X, Y, Z, t1, t2, t3, t4, t5, three, two;

                // If Z = 0 the point is at infinity, return as-is
                if (math::bigint::bigint_is_zero(pz))
                {
                    math::bigint::bigint_copy(rx, px);
                    math::bigint::bigint_copy(ry, py);
                    math::bigint::bigint_copy(rz, pz);
                    return;
                };

                math::bigint::bigint_copy(@X, px);
                math::bigint::bigint_copy(@Y, py);
                math::bigint::bigint_copy(@Z, pz);

                // Standard Jacobian doubling for a = -3 curve (P-256)
                // Reference: NIST SP 800-186, Appendix D, or
                //   https://hyperelliptic.org/EFD/g1p/auto-shortw-jacobian-3.html#doubling-dbl-2001-b
                //
                // delta = Z^2
                // gamma = Y^2
                // beta  = X * gamma
                // alpha = 3 * (X - delta) * (X + delta)   [uses a=-3]
                // X3    = alpha^2 - 8*beta
                // Z3    = (Y + Z)^2 - gamma - delta
                // Y3    = alpha * (4*beta - X3) - 8*gamma^2
                //
                // t1 = delta = Z^2
                p256_fp_sq(@t1, @Z);
                // t2 = gamma = Y^2
                p256_fp_sq(@t2, @Y);
                // t3 = beta = X * gamma
                p256_fp_mul(@t3, @X, @t2);
                // t4 = X - delta
                p256_fp_sub(@t4, @X, @t1);
                // t5 = X + delta
                p256_fp_add(@t5, @X, @t1);
                // t4 = (X - delta)(X + delta)
                p256_fp_mul(@t4, @t4, @t5);
                // t4 = alpha = 3 * (X - delta)(X + delta)
                math::bigint::bigint_from_uint(@three, 3);
                p256_fp_mul(@t4, @three, @t4);
                // rz = Z3 = (Y + Z)^2 - gamma - delta
                p256_fp_add(@t5, @Y, @Z);
                p256_fp_sq(@t5, @t5);
                p256_fp_sub(@t5, @t5, @t2);
                p256_fp_sub(rz, @t5, @t1);
                // t5 = 8 * beta
                math::bigint::bigint_from_uint(@two, 8);
                p256_fp_mul(@t5, @t3, @two);
                // rx = X3 = alpha^2 - 8*beta
                p256_fp_sq(@t1, @t4);
                p256_fp_sub(rx, @t1, @t5);
                // t3 = 4*beta - X3
                math::bigint::bigint_from_uint(@two, 4);
                p256_fp_mul(@t3, @t3, @two);
                p256_fp_sub(@t3, @t3, rx);
                // t2 = 8 * gamma^2
                p256_fp_sq(@t2, @t2);
                math::bigint::bigint_from_uint(@two, 8);
                p256_fp_mul(@t2, @t2, @two);
                // ry = Y3 = alpha * (4*beta - X3) - 8*gamma^2
                p256_fp_mul(@t3, @t4, @t3);
                p256_fp_sub(ry, @t3, @t2);
                return;
            };

            // Point add in Jacobian coordinates (P + Q, both may be the point at infinity).
            // Uses the standard Jacobian mixed / unified add formula.
            def p256_point_add(BigInt* rx, BigInt* ry, BigInt* rz,
                               BigInt* px, BigInt* py, BigInt* pz,
                               BigInt* qx, BigInt* qy, BigInt* qz) -> void
            {
                // Copy all inputs to locals first to handle in-place calls
                BigInt PX, PY, PZ, QX, QY, QZ;
                BigInt u1, u2, s1, s2, h, r, h2, h3, u1h2, tmp, two;
                BigInt dbl_t1, dbl_t2, dbl_t3, dbl_t4, dbl_three, dbl_two, dbl_t5;

                // Handle infinity inputs
                if (math::bigint::bigint_is_zero(pz))
                {
                    math::bigint::bigint_copy(rx, qx);
                    math::bigint::bigint_copy(ry, qy);
                    math::bigint::bigint_copy(rz, qz);
                    return;
                };
                if (math::bigint::bigint_is_zero(qz))
                {
                    math::bigint::bigint_copy(rx, px);
                    math::bigint::bigint_copy(ry, py);
                    math::bigint::bigint_copy(rz, pz);
                    return;
                };

                math::bigint::bigint_copy(@PX, px);
                math::bigint::bigint_copy(@PY, py);
                math::bigint::bigint_copy(@PZ, pz);
                math::bigint::bigint_copy(@QX, qx);
                math::bigint::bigint_copy(@QY, qy);
                math::bigint::bigint_copy(@QZ, qz);

                math::bigint::bigint_from_uint(@two, 2);

                // u1 = px * qz²
                p256_fp_sq(@tmp, @QZ);
                p256_fp_mul(@u1, @PX, @tmp);
                // u2 = qx * pz²
                p256_fp_sq(@tmp, @PZ);
                p256_fp_mul(@u2, @QX, @tmp);
                // s1 = py * qz³
                p256_fp_sq(@tmp, @QZ);
                p256_fp_mul(@s1, @tmp, @QZ);
                p256_fp_mul(@s1, @PY, @s1);
                // s2 = qy * pz³
                p256_fp_sq(@tmp, @PZ);
                p256_fp_mul(@s2, @tmp, @PZ);
                p256_fp_mul(@s2, @QY, @s2);
                // h = u2 - u1
                p256_fp_sub(@h, @u2, @u1);
                // r = s2 - s1
                p256_fp_sub(@r, @s2, @s1);

                // If h = 0: either equal points (double inline) or P = -Q (return infinity)
                if (math::bigint::bigint_is_zero(@h))
                {
                    if (math::bigint::bigint_is_zero(@r))
                    {
                        // P = Q: inline double (same formula as p256_point_dbl)
                        // dbl_t1=delta, dbl_t2=gamma, dbl_t3=beta, dbl_t4=alpha
                        p256_fp_sq(@dbl_t1, @PZ);
                        p256_fp_sq(@dbl_t2, @PY);
                        p256_fp_mul(@dbl_t3, @PX, @dbl_t2);
                        p256_fp_sub(@dbl_t4, @PX, @dbl_t1);
                        p256_fp_add(@dbl_t5, @PX, @dbl_t1);
                        p256_fp_mul(@dbl_t4, @dbl_t4, @dbl_t5);
                        math::bigint::bigint_from_uint(@dbl_three, 3);
                        p256_fp_mul(@dbl_t4, @dbl_three, @dbl_t4);
                        p256_fp_add(@dbl_t5, @PY, @PZ);
                        p256_fp_sq(@dbl_t5, @dbl_t5);
                        p256_fp_sub(@dbl_t5, @dbl_t5, @dbl_t2);
                        p256_fp_sub(rz, @dbl_t5, @dbl_t1);
                        math::bigint::bigint_from_uint(@dbl_two, 8);
                        p256_fp_mul(@dbl_t5, @dbl_t3, @dbl_two);
                        p256_fp_sq(@dbl_t1, @dbl_t4);
                        p256_fp_sub(rx, @dbl_t1, @dbl_t5);
                        math::bigint::bigint_from_uint(@dbl_two, 4);
                        p256_fp_mul(@dbl_t3, @dbl_t3, @dbl_two);
                        p256_fp_sub(@dbl_t3, @dbl_t3, rx);
                        p256_fp_sq(@dbl_t2, @dbl_t2);
                        math::bigint::bigint_from_uint(@dbl_two, 8);
                        p256_fp_mul(@dbl_t2, @dbl_t2, @dbl_two);
                        p256_fp_mul(@dbl_t3, @dbl_t4, @dbl_t3);
                        p256_fp_sub(ry, @dbl_t3, @dbl_t2);
                    }
                    else
                    {
                        // P = -Q: return infinity
                        math::bigint::bigint_zero(rx);
                        math::bigint::bigint_zero(ry);
                        math::bigint::bigint_zero(rz);
                    };
                    return;
                };

                // h2 = h²,  h3 = h³
                p256_fp_sq(@h2, @h);
                p256_fp_mul(@h3, @h2, @h);
                // u1h2 = u1 * h²
                p256_fp_mul(@u1h2, @u1, @h2);

                // rz = pz * qz * h
                p256_fp_mul(@tmp, pz, qz);
                p256_fp_mul(rz, @tmp, @h);

                // rx = r² - h³ - 2*u1h2
                p256_fp_sq(@tmp, @r);
                p256_fp_sub(rx, @tmp, @h3);
                p256_fp_mul(@tmp, @u1h2, @two);
                p256_fp_sub(rx, rx, @tmp);

                // ry = r*(u1h2 - rx) - s1*h3
                p256_fp_sub(@tmp, @u1h2, rx);
                p256_fp_mul(ry, @r, @tmp);
                p256_fp_mul(@tmp, @s1, @h3);
                p256_fp_sub(ry, ry, @tmp);
                return;
            };

            // Scalar multiplication: R = k * P  (double-and-add, left-to-right)
            // Result returned in affine coordinates (rx, ry); returns false if result
            // is the point at infinity.
            def ecdsa_p256_point_mul(BigInt* rx, BigInt* ry,
                                     BigInt* k,
                                     BigInt* px, BigInt* py) -> bool
            {
                BigInt qx, qy, qz, tx, ty, tz, one, zinv, zinv2, zinv3;
                uint i, j;
                uint word, bit;
                uint* kd;

                math::bigint::bigint_zero(@qx);
                math::bigint::bigint_zero(@qy);
                math::bigint::bigint_zero(@qz);   // infinity

                // tx/ty/tz = input point in Jacobian (Z = 1)
                math::bigint::bigint_copy(@tx, px);
                math::bigint::bigint_copy(@ty, py);
                math::bigint::bigint_one(@tz);

                kd = @k.digits[0];

                // Iterate from MSB of k down to LSB
                i = k.length;
                while (i > 0)
                {
                    i--;
                    word = kd[i];
                    j = 32;
                    while (j > 0)
                    {
                        j--;
                        bit = (word >> j) & 1;

                        // Always double
                        p256_point_dbl(@qx, @qy, @qz, @qx, @qy, @qz);

                        // Conditionally add
                        if (bit != 0)
                        {
                            p256_point_add(@qx, @qy, @qz,
                                           @qx, @qy, @qz,
                                           @tx, @ty, @tz);
                        };
                    };
                };

                // Check for infinity
                if (math::bigint::bigint_is_zero(@qz))
                {
                    math::bigint::bigint_zero(rx);
                    math::bigint::bigint_zero(ry);
                    return false;
                };

                // Convert Jacobian -> affine: x = X*Z^(-2), y = Y*Z^(-3)
                p256_fp_inv(@zinv, @qz);
                p256_fp_sq(@zinv2, @zinv);
                p256_fp_mul(@zinv3, @zinv2, @zinv);
                p256_fp_mul(rx, @qx, @zinv2);
                p256_fp_mul(ry, @qy, @zinv3);
                return true;
            };

            // ---- Public key derivation ----

            // Compute public key Q = d*G from 32-byte big-endian private key.
            // Writes 32-byte big-endian qx and qy.
            def ecdsa_p256_pubkey(byte* qx32, byte* qy32, byte* privkey32) -> bool
            {
                BigInt d, gx, gy, rx, ry;
                uint* gxd, gyd, pgx, pgy;
                uint i;

                ecdsa_p256_load_scalar(@d, privkey32);

                // Load generator directly from little-endian limb arrays
                gxd = @gx.digits[0];
                gyd = @gy.digits[0];
                pgx = @P256_GX[0];
                pgy = @P256_GY[0];
                for (i = 0; i < 8; i++) { gxd[i] = pgx[i]; };
                for (i = 0; i < 8; i++) { gyd[i] = pgy[i]; };
                gx.length = 8; gx.negative = false;
                gy.length = 8; gy.negative = false;
                math::bigint::bigint_normalize(@gx);
                math::bigint::bigint_normalize(@gy);

                if (!ecdsa_p256_point_mul(@rx, @ry, @d, @gx, @gy))
                {
                    return false;
                };

                ecdsa_p256_store_scalar(qx32, @rx);
                ecdsa_p256_store_scalar(qy32, @ry);
                return true;
            };

            // ---- Sign ----

            // Sign a 32-byte hash with a 32-byte big-endian private key and nonce k.
            // nonce32 must be a secret, uniformly random value in [1, n-1].
            // Writes 32-byte big-endian r and s.
            // Returns false if signing fails (r or s is zero — resample nonce).
            def ecdsa_p256_sign(byte* sig_r32, byte* sig_s32,
                                byte* privkey32,
                                byte* hash32,
                                byte* nonce32) -> bool
            {
                BigInt k, d, z, n, gx, gy, rx, ry;
                BigInt r, s, kinv, tmp;
                uint* gxd, gyd, pgx, pgy;
                uint i;

                ecdsa_p256_load_scalar(@k, nonce32);
                ecdsa_p256_load_scalar(@d, privkey32);
                ecdsa_p256_load_scalar(@z, hash32);
                p256_set_n(@n);

                // Load generator
                gxd = @gx.digits[0];
                gyd = @gy.digits[0];
                pgx = @P256_GX[0];
                pgy = @P256_GY[0];
                for (i = 0; i < 8; i++) { gxd[i] = pgx[i]; };
                for (i = 0; i < 8; i++) { gyd[i] = pgy[i]; };
                gx.length = 8; gx.negative = false;
                gy.length = 8; gy.negative = false;
                math::bigint::bigint_normalize(@gx);
                math::bigint::bigint_normalize(@gy);

                // (rx, ry) = k * G
                if (!ecdsa_p256_point_mul(@rx, @ry, @k, @gx, @gy))
                {
                    return false;
                };

                // r = rx mod n
                math::bigint::bigint_mod(@r, @rx, @n);
                if (math::bigint::bigint_is_zero(@r))
                {
                    return false;
                };

                // s = k^(-1) * (z + r*d) mod n
                if (!math::bigint::bigint_modinv(@kinv, @k, @n))
                {
                    return false;
                };

                math::bigint::bigint_mul(@tmp, @r, @d);
                math::bigint::bigint_mod(@tmp, @tmp, @n);
                math::bigint::bigint_add(@tmp, @z, @tmp);
                math::bigint::bigint_mod(@tmp, @tmp, @n);
                math::bigint::bigint_mul(@s, @kinv, @tmp);
                math::bigint::bigint_mod(@s, @s, @n);

                if (math::bigint::bigint_is_zero(@s))
                {
                    return false;
                };

                ecdsa_p256_store_scalar(sig_r32, @r);
                ecdsa_p256_store_scalar(sig_s32, @s);
                return true;
            };

            // ---- Verify ----

            // Verify an ECDSA-P256 signature.
            // pubx32, puby32 : 32-byte big-endian affine public key coordinates.
            // sig_r32, sig_s32 : 32-byte big-endian signature components.
            // hash32 : 32-byte message hash.
            // Returns true if the signature is valid.
            def ecdsa_p256_verify(byte* sig_r32, byte* sig_s32,
                                  byte* pubx32,  byte* puby32,
                                  byte* hash32) -> bool
            {
                BigInt r, s, z, n, qx, qy, gx, gy;
                BigInt sinv, u1, u2;
                BigInt r1x, r1y, r2x, r2y, rx, ry;
                BigInt one, ax, ay, az, bx, by, bz, outx, outy, outz, zinv, zinv2;
                uint* gxd, gyd, pgx, pgy;
                uint i;

                ecdsa_p256_load_scalar(@r, sig_r32);
                ecdsa_p256_load_scalar(@s, sig_s32);
                ecdsa_p256_load_scalar(@z, hash32);
                ecdsa_p256_load_scalar(@qx, pubx32);
                ecdsa_p256_load_scalar(@qy, puby32);
                p256_set_n(@n);

                // Reject r or s outside [1, n-1]
                if (math::bigint::bigint_is_zero(@r)) { return false; };
                if (math::bigint::bigint_is_zero(@s)) { return false; };
                if (math::bigint::bigint_cmp(@r, @n) >= 0) { return false; };
                if (math::bigint::bigint_cmp(@s, @n) >= 0) { return false; };

                // sinv = s^(-1) mod n
                if (!math::bigint::bigint_modinv(@sinv, @s, @n))
                {
                    return false;
                };

                // u1 = z * sinv mod n
                math::bigint::bigint_mul(@u1, @z, @sinv);
                math::bigint::bigint_mod(@u1, @u1, @n);

                // u2 = r * sinv mod n
                math::bigint::bigint_mul(@u2, @r, @sinv);
                math::bigint::bigint_mod(@u2, @u2, @n);

                // Load generator
                gxd = @gx.digits[0];
                gyd = @gy.digits[0];
                pgx = @P256_GX[0];
                pgy = @P256_GY[0];
                for (i = 0; i < 8; i++) { gxd[i] = pgx[i]; };
                for (i = 0; i < 8; i++) { gyd[i] = pgy[i]; };
                gx.length = 8; gx.negative = false;
                gy.length = 8; gy.negative = false;
                math::bigint::bigint_normalize(@gx);
                math::bigint::bigint_normalize(@gy);

                // R1 = u1 * G,  R2 = u2 * Q
                if (!ecdsa_p256_point_mul(@r1x, @r1y, @u1, @gx, @gy)) { return false; };
                if (!ecdsa_p256_point_mul(@r2x, @r2y, @u2, @qx, @qy)) { return false; };

                // R = R1 + R2  (affine add via Jacobian with Z=1)
                math::bigint::bigint_one(@one);
                math::bigint::bigint_copy(@ax, @r1x);
                math::bigint::bigint_copy(@ay, @r1y);
                math::bigint::bigint_one(@az);
                math::bigint::bigint_copy(@bx, @r2x);
                math::bigint::bigint_copy(@by, @r2y);
                math::bigint::bigint_one(@bz);
                p256_point_add(@outx, @outy, @outz,
                               @ax, @ay, @az,
                               @bx, @by, @bz);

                if (math::bigint::bigint_is_zero(@outz)) { return false; };

                // Convert to affine
                p256_fp_inv(@zinv, @outz);
                p256_fp_sq(@zinv2, @zinv);
                p256_fp_mul(@rx, @outx, @zinv2);

                // rx mod n == r?
                math::bigint::bigint_mod(@rx, @rx, @n);
                return (math::bigint::bigint_cmp(@rx, @r) == 0);
            };

            // ---- DER encoding / decoding ----

            // Encode (r, s) as a DER SEQUENCE { INTEGER r, INTEGER s }.
            // der_out must be at least 72 bytes.
            // der_len receives the actual encoded length.
            def ecdsa_p256_encode_der(byte* der_out, int* der_len, byte* r32, byte* s32) -> void
            {
                // Each 32-byte scalar may need a leading 0x00 pad if high bit is set.
                byte[33] rbuf, sbuf;
                int rlen, slen, total, i;

                // Copy r, inserting leading zero if MSB is set
                rlen = 32;
                if ((r32[0] & (byte)0x80) != (byte)0)
                {
                    rbuf[0] = (byte)0;
                    for (i = 0; i < 32; i++) { rbuf[i + 1] = r32[i]; };
                    rlen = 33;
                }
                else
                {
                    for (i = 0; i < 32; i++) { rbuf[i] = r32[i]; };
                };

                // Copy s, inserting leading zero if MSB is set
                slen = 32;
                if ((s32[0] & (byte)0x80) != (byte)0)
                {
                    sbuf[0] = (byte)0;
                    for (i = 0; i < 32; i++) { sbuf[i + 1] = s32[i]; };
                    slen = 33;
                }
                else
                {
                    for (i = 0; i < 32; i++) { sbuf[i] = s32[i]; };
                };

                // SEQUENCE { INTEGER(rbuf[0..rlen-1]), INTEGER(sbuf[0..slen-1]) }
                total = 2 + rlen + 2 + slen;
                int pos;
                der_out[pos] = (byte)0x30;         // SEQUENCE tag
                pos = 1;
                der_out[pos] = (byte)total;
                pos = 2;
                der_out[pos] = (byte)0x02;         // INTEGER tag
                pos = 3;
                der_out[pos] = (byte)rlen;
                pos = 4;
                for (i = 0; i < rlen; i++) { der_out[pos] = rbuf[i]; pos = pos + 1; };
                der_out[pos] = (byte)0x02;         // INTEGER tag
                pos = pos + 1;
                der_out[pos] = (byte)slen;
                pos = pos + 1;
                for (i = 0; i < slen; i++) { der_out[pos] = sbuf[i]; pos = pos + 1; };

                *der_len = 2 + total;
                return;
            };

            // Decode a DER-encoded signature into raw 32-byte big-endian r and s.
            // Returns false if the encoding is malformed.
            def ecdsa_p256_decode_der(byte* r32, byte* s32, byte* der_in, int der_len) -> bool
            {
                int pos, seq_len, tag, ilen, pad, i;

                if (der_len < 8) { return false; };

                // SEQUENCE tag
                if (der_in[pos] != (byte)0x30) { return false; };
                pos = 1;
                seq_len = (int)der_in[pos];
                pos = 2;
                if (seq_len + 2 != der_len) { return false; };

                // First INTEGER (r)
                if (der_in[pos] != (byte)0x02) { return false; };
                pos = pos + 1;
                ilen = (int)der_in[pos];
                pos = pos + 1;
                if (ilen < 1 | ilen > 33) { return false; };

                // Strip optional leading zero pad
                pad = 0;
                if (ilen == 33)
                {
                    if (der_in[pos] != (byte)0) { return false; };
                    pad = 1;
                    ilen = 32;
                    pos = pos + 1;
                };

                // Zero-fill r32 then copy (right-aligned if fewer than 32 bytes)
                for (i = 0; i < 32; i++) { r32[i] = (byte)0; };
                int roff = 32 - ilen;
                for (i = 0; i < ilen; i++) { r32[roff + i] = der_in[pos + i]; };
                pos = pos + ilen;

                // Second INTEGER (s)
                if (der_in[pos] != (byte)0x02) { return false; };
                pos = pos + 1;
                ilen = (int)der_in[pos];
                pos = pos + 1;
                if (ilen < 1 | ilen > 33) { return false; };

                pad = 0;
                if (ilen == 33)
                {
                    if (der_in[pos] != (byte)0) { return false; };
                    pad = 1;
                    ilen = 32;
                    pos = pos + 1;
                };

                for (i = 0; i < 32; i++) { s32[i] = (byte)0; };
                int soff = 32 - ilen;
                for (i = 0; i < ilen; i++) { s32[soff + i] = der_in[pos + i]; };

                return true;
            };

        }; // ECDSA

        namespace RSA
        {
            // =========================================================================
            // RSA (RFC 8017) up to 4096 bit moduli
            //
            // Arithmetic runs on little endian 32 bit limb arrays with Montgomery
            // multiplication, independent of the 4096 bit BigInt type so that a 4096 bit
            // modulus (which squares to 8192 bits) works. All byte interfaces are big
            // endian, as on the wire.
            //
            // Hash identifiers used by the signature schemes:
            //   RSA_HASH_SHA256 = 1, RSA_HASH_SHA384 = 2, RSA_HASH_SHA512 = 3
            //
            // Public API:
            //   rsa_public_op(out, in, n, n_len, e, e_len) -> bool
            //   rsa_private_op(out, in, n, n_len, d, d_len) -> bool
            //   rsa_private_crt_op(out, in, n, n_len, p, p_len, q, q_len,
            //                      dp, dp_len, dq, dq_len, qinv, qinv_len) -> bool
            //   rsa_pkcs1_verify(n, n_len, e, e_len, hash_id, digest, sig, sig_len) -> bool
            //   rsa_pkcs1_sign_crt(sig, hash_id, digest, key parts...) -> bool
            //   rsa_pss_verify(n, n_len, e, e_len, hash_id, digest, sig, sig_len) -> bool
            //   rsa_pss_sign_crt(sig, hash_id, digest, salt, key parts...) -> bool
            //
            // The modular exponentiation is not constant time. Do not expose private
            // key operations to an attacker who can measure their timing.
            // =========================================================================

            global const int RSA_HASH_SHA256 = 1,
                             RSA_HASH_SHA384 = 2,
                             RSA_HASH_SHA512 = 3;

            // Montgomery context for one odd modulus
            struct RSA_MONT
            {
                uint[128] n;        // modulus
                uint[128] rr;       // R^2 mod n, R = 2^(32 * len)
                uint[128] one;      // R mod n, the Montgomery form of 1
                uint n0inv;         // -n^-1 mod 2^32
                int len;            // limbs in use
            };

            // ---- byte and limb conversion ----

            // Big endian bytes to little endian limbs, zero filling up to nlimbs
            def rsa_be_to_limbs(uint* out, int nlimbs, byte* src, int srclen) -> void
            {
                int i, li, sh;
                for (i = 0; i < nlimbs; i++) { out[i] = 0u; };
                for (i = 0; i < srclen; i++)
                {
                    li = i / 4;
                    sh = (i % 4) * 8;
                    if (li < nlimbs)
                    {
                        out[li] = out[li] `| ((uint)src[srclen - 1 - i] << (uint)sh);
                    };
                };
            };

            // Little endian limbs to exactly dstlen big endian bytes
            def rsa_limbs_to_be(byte* dst, int dstlen, uint* limbs, int nlimbs) -> void
            {
                int i, li, sh;
                for (i = 0; i < dstlen; i++)
                {
                    li = i / 4;
                    sh = (i % 4) * 8;
                    if (li < nlimbs)
                    {
                        dst[dstlen - 1 - i] = (byte)((limbs[li] >> (uint)sh) `& 0xFFu);
                    }
                    else
                    {
                        dst[dstlen - 1 - i] = (byte)0;
                    };
                };
            };

            // Number of significant bytes after leading zeros
            def rsa_byte_len(byte* v, int len) -> int
            {
                int i = 0;
                while (i < len & v[i] == (byte)0) { i++; };
                return len - i;
            };

            // Number of limbs actually used (index of top nonzero limb + 1)
            def rsa_limb_len(uint* a, int nlimbs) -> int
            {
                int n = nlimbs;
                while (n > 0 & a[n - 1] == 0u) { n--; };
                return n;
            };

            // ---- limb arithmetic ----

            // Compare equal length arrays, -1 / 0 / 1
            def rsa_cmp(uint* a, uint* b, int n) -> int
            {
                int i;
                for (i = n - 1; i >= 0; i--)
                {
                    if (a[i] > b[i]) { return 1; };
                    if (a[i] < b[i]) { return -1; };
                };
                return 0;
            };

            // r = a - b over n limbs, returns the borrow
            def rsa_sub(uint* r, uint* a, uint* b, int n) -> uint
            {
                int i;
                u64 d;
                uint borrow = 0u;
                for (i = 0; i < n; i++)
                {
                    d = (u64)a[i] - (u64)b[i] - (u64)borrow;
                    r[i] = (uint)d;
                    borrow = (uint)((d >> 63u) `& (u64)1);
                };
                return borrow;
            };

            // r = a + b over n limbs, returns the carry
            def rsa_add(uint* r, uint* a, uint* b, int n) -> uint
            {
                int i;
                u64 s;
                uint carry = 0u;
                for (i = 0; i < n; i++)
                {
                    s = (u64)a[i] + (u64)b[i] + (u64)carry;
                    r[i] = (uint)s;
                    carry = (uint)(s >> 32u);
                };
                return carry;
            };

            // r = a mod m by bitwise long division. a has alen limbs, m has mlen limbs
            // (top limb nonzero), r has mlen limbs.
            def rsa_mod(uint* r, uint* a, int alen, uint* m, int mlen) -> void
            {
                int i, b, j;
                uint bit, carry, newcarry;
                for (j = 0; j < mlen; j++) { r[j] = 0u; };
                for (i = alen - 1; i >= 0; i--)
                {
                    for (b = 31; b >= 0; b--)
                    {
                        bit = (a[i] >> (uint)b) `& 1u;
                        carry = bit;
                        for (j = 0; j < mlen; j++)
                        {
                            newcarry = r[j] >> 31u;
                            r[j] = (r[j] << 1u) `| carry;
                            carry = newcarry;
                        };
                        if (carry != 0u | rsa_cmp(r, m, mlen) >= 0)
                        {
                            rsa_sub(r, r, m, mlen);
                        };
                    };
                };
            };

            // ---- Montgomery ----

            // Prepare the context for modulus n (odd, len limbs, top limb nonzero)
            def rsa_mont_init(RSA_MONT* m, uint* n, int len) -> void
            {
                int i, k;
                uint x, carry, newcarry;
                uint[128] v;

                m.len = len;
                for (i = 0; i < 128; i++) { m.n[i] = 0u; m.rr[i] = 0u; m.one[i] = 0u; };
                for (i = 0; i < len; i++) { m.n[i] = n[i]; };

                // Newton iteration for n^-1 mod 2^32, then negate
                x = n[0];
                for (i = 0; i < 5; i++) { x = x * (2u - n[0] * x); };
                m.n0inv = 0u - x;

                // v = 2^k mod n by repeated doubling, first k = 32 * len gives R mod n
                for (i = 0; i < 128; i++) { v[i] = 0u; };
                v[0] = 1u;
                for (k = 0; k < 64 * len; k++)
                {
                    carry = 0u;
                    for (i = 0; i < len; i++)
                    {
                        newcarry = v[i] >> 31u;
                        v[i] = (v[i] << 1u) `| carry;
                        carry = newcarry;
                    };
                    if (carry != 0u | rsa_cmp(@v[0], n, len) >= 0)
                    {
                        rsa_sub(@v[0], @v[0], n, len);
                    };
                    if (k == 32 * len - 1)
                    {
                        for (i = 0; i < len; i++) { m.one[i] = v[i]; };
                    };
                };
                for (i = 0; i < len; i++) { m.rr[i] = v[i]; };
            };

            // r = a * b * R^-1 mod n (CIOS). a, b < n. r may alias a or b.
            def rsa_mont_mul(RSA_MONT* m, uint* r, uint* a, uint* b) -> void
            {
                uint[132] t;
                int i, j, n;
                u64 s, c;
                uint mm;

                n = m.len;
                for (i = 0; i < n + 2; i++) { t[i] = 0u; };

                for (i = 0; i < n; i++)
                {
                    c = (u64)0;
                    for (j = 0; j < n; j++)
                    {
                        s = (u64)t[j] + (u64)a[j] * (u64)b[i] + c;
                        t[j] = (uint)s;
                        c = s >> 32u;
                    };
                    s = (u64)t[n] + c;
                    t[n] = (uint)s;
                    t[n + 1] = (uint)(s >> 32u);

                    mm = t[0] * m.n0inv;
                    s = (u64)t[0] + (u64)mm * (u64)m.n[0];
                    c = s >> 32u;
                    for (j = 1; j < n; j++)
                    {
                        s = (u64)t[j] + (u64)mm * (u64)m.n[j] + c;
                        t[j - 1] = (uint)s;
                        c = s >> 32u;
                    };
                    s = (u64)t[n] + c;
                    t[n - 1] = (uint)s;
                    t[n] = t[n + 1] + (uint)(s >> 32u);
                };

                if (t[n] != 0u | rsa_cmp(@t[0], @m.n[0], n) >= 0)
                {
                    rsa_sub(r, @t[0], @m.n[0], n);
                }
                else
                {
                    for (i = 0; i < n; i++) { r[i] = t[i]; };
                };
            };

            // r = base ^ exp mod n. base < n (len limbs), exp has elen limbs.
            def rsa_mont_exp(RSA_MONT* m, uint* r, uint* base, uint* exp, int elen) -> void
            {
                uint[128] bm, acc, onev;
                int i, b, n, top;
                bool started;

                n = m.len;
                rsa_mont_mul(m, @bm[0], base, @m.rr[0]);
                for (i = 0; i < n; i++) { acc[i] = m.one[i]; onev[i] = 0u; };
                onev[0] = 1u;

                started = false;
                for (i = elen - 1; i >= 0; i--)
                {
                    for (b = 31; b >= 0; b--)
                    {
                        if (started)
                        {
                            rsa_mont_mul(m, @acc[0], @acc[0], @acc[0]);
                        };
                        if (((exp[i] >> (uint)b) `& 1u) != 0u)
                        {
                            rsa_mont_mul(m, @acc[0], @acc[0], @bm[0]);
                            started = true;
                        };
                    };
                };

                rsa_mont_mul(m, r, @acc[0], @onev[0]);
            };

            // ---- raw RSA operations on big endian byte strings ----

            // out[k] = inp ^ e mod n, k = significant bytes of n. inp must be k bytes.
            // Returns false when the modulus is unusable or inp >= n.
            def rsa_modexp_bytes(byte* out, byte* inp, byte* n, int n_len,
                                 byte* e, int e_len) -> bool
            {
                RSA_MONT mont;
                uint[128] nl, xl, el, rl;
                int k, nlimbs, elimbs;

                k = rsa_byte_len(n, n_len);
                if (k < 12 | k > 512) { return false; };
                if ((n[n_len - 1] `& (byte)1) == (byte)0) { return false; };

                nlimbs = (k + 3) / 4;
                rsa_be_to_limbs(@nl[0], 128, n + (n_len - k), k);
                rsa_be_to_limbs(@xl[0], 128, inp, k);
                if (rsa_cmp(@xl[0], @nl[0], 128) >= 0) { return false; };

                elimbs = (e_len + 3) / 4;
                if (elimbs > 128) { return false; };
                rsa_be_to_limbs(@el[0], 128, e, e_len);

                rsa_mont_init(@mont, @nl[0], nlimbs);
                rsa_mont_exp(@mont, @rl[0], @xl[0], @el[0], elimbs);
                rsa_limbs_to_be(out, k, @rl[0], nlimbs);
                return true;
            };

            def rsa_public_op(byte* out, byte* inp, byte* n, int n_len,
                              byte* e, int e_len) -> bool
            {
                return rsa_modexp_bytes(out, inp, n, n_len, e, e_len);
            };

            def rsa_private_op(byte* out, byte* inp, byte* n, int n_len,
                               byte* d, int d_len) -> bool
            {
                return rsa_modexp_bytes(out, inp, n, n_len, d, d_len);
            };

            // Private operation with the Chinese remainder theorem.
            // m1 = c^dp mod p, m2 = c^dq mod q, h = qinv (m1 - m2) mod p, m = m2 + h q
            def rsa_private_crt_op(byte* out, byte* inp, byte* n, int n_len,
                                   byte* p, int p_len, byte* q, int q_len,
                                   byte* dp, int dp_len, byte* dq, int dq_len,
                                   byte* qinv, int qinv_len) -> bool
            {
                RSA_MONT mp, mq;
                uint[128] nl, cl, pl, ql, dpl, dql, qil;
                uint[128] c1, c2, m1, m2, m2p, diff, hq, xm, hh;
                uint[260] prod;
                int k, plimbs, qlimbs, i, j;
                u64 s, c;

                k = rsa_byte_len(n, n_len);
                if (k < 12 | k > 512) { return false; };
                rsa_be_to_limbs(@nl[0], 128, n + (n_len - k), k);
                rsa_be_to_limbs(@cl[0], 128, inp, k);
                if (rsa_cmp(@cl[0], @nl[0], 128) >= 0) { return false; };

                rsa_be_to_limbs(@pl[0], 128, p, p_len);
                rsa_be_to_limbs(@ql[0], 128, q, q_len);
                rsa_be_to_limbs(@dpl[0], 128, dp, dp_len);
                rsa_be_to_limbs(@dql[0], 128, dq, dq_len);
                rsa_be_to_limbs(@qil[0], 128, qinv, qinv_len);
                plimbs = rsa_limb_len(@pl[0], 128);
                qlimbs = rsa_limb_len(@ql[0], 128);
                if (plimbs < 1 | qlimbs < 1) { return false; };
                if ((pl[0] `& 1u) == 0u | (ql[0] `& 1u) == 0u) { return false; };

                rsa_mont_init(@mp, @pl[0], plimbs);
                rsa_mont_init(@mq, @ql[0], qlimbs);

                // c mod p and c mod q
                rsa_mod(@c1[0], @cl[0], 128, @pl[0], plimbs);
                rsa_mod(@c2[0], @cl[0], 128, @ql[0], qlimbs);

                rsa_mont_exp(@mp, @m1[0], @c1[0], @dpl[0], rsa_limb_len(@dpl[0], 128));
                rsa_mont_exp(@mq, @m2[0], @c2[0], @dql[0], rsa_limb_len(@dql[0], 128));

                // diff = (m1 - m2) mod p
                rsa_mod(@m2p[0], @m2[0], qlimbs, @pl[0], plimbs);
                if (rsa_cmp(@m1[0], @m2p[0], plimbs) >= 0)
                {
                    rsa_sub(@diff[0], @m1[0], @m2p[0], plimbs);
                }
                else
                {
                    rsa_sub(@diff[0], @m1[0], @m2p[0], plimbs);
                    rsa_add(@diff[0], @diff[0], @pl[0], plimbs);
                };

                // h = qinv * diff mod p, with qinv taken into Montgomery form first
                rsa_mod(@xm[0], @qil[0], 128, @pl[0], plimbs);
                rsa_mont_mul(@mp, @xm[0], @xm[0], @mp.rr[0]);
                rsa_mont_mul(@mp, @hh[0], @xm[0], @diff[0]);

                // m = m2 + h * q
                for (i = 0; i < 260; i++) { prod[i] = 0u; };
                for (i = 0; i < plimbs; i++)
                {
                    c = (u64)0;
                    for (j = 0; j < qlimbs; j++)
                    {
                        s = (u64)prod[i + j] + (u64)hh[i] * (u64)ql[j] + c;
                        prod[i + j] = (uint)s;
                        c = s >> 32u;
                    };
                    prod[i + qlimbs] = (uint)c;
                };
                c = (u64)0;
                for (i = 0; i < 260; i++)
                {
                    s = (u64)prod[i] + c;
                    if (i < qlimbs) { s = s + (u64)m2[i]; };
                    prod[i] = (uint)s;
                    c = s >> 32u;
                };

                rsa_limbs_to_be(out, k, @prod[0], 260);
                return true;
            };

            // ---- hash helpers ----

            def rsa_hash_len(int hash_id) -> int
            {
                if (hash_id == 1) { return 32; };
                if (hash_id == 2) { return 48; };
                if (hash_id == 3) { return 64; };
                return 0;
            };

            // out = H(a || b), b may be null
            def rsa_hash2(int hash_id, byte* a, int a_len, byte* b, int b_len, byte* out) -> void
            {
                SHA256_CTX c256;
                SHA384_CTX c384;
                if (hash_id == 1)
                {
                    SHA256::sha256_init(@c256);
                    SHA256::sha256_update(@c256, a, (u64)a_len);
                    if (b != (byte*)0) { SHA256::sha256_update(@c256, b, (u64)b_len); };
                    SHA256::sha256_final(@c256, out);
                }
                else
                {
                    if (hash_id == 2) { SHA384::sha384_init(@c384); } else { SHA384::sha512_init(@c384); };
                    SHA384::sha384_update(@c384, a, (u64)a_len);
                    if (b != (byte*)0) { SHA384::sha384_update(@c384, b, (u64)b_len); };
                    if (hash_id == 2) { SHA384::sha384_final(@c384, out); } else { SHA384::sha512_final(@c384, out); };
                };
            };

            // DigestInfo prefix for EMSA-PKCS1-v1_5, returns its length (19) or 0
            def rsa_digestinfo_prefix(int hash_id, byte* out) -> int
            {
                byte[19] p256 = [48,49,48,13,6,9,96,134,72,1,101,3,4,2,1,5,0,4,32];
                byte[19] p384 = [48,65,48,13,6,9,96,134,72,1,101,3,4,2,2,5,0,4,48];
                byte[19] p512 = [48,81,48,13,6,9,96,134,72,1,101,3,4,2,3,5,0,4,64];
                int i;
                for (i = 0; i < 19; i++)
                {
                    if (hash_id == 1) { out[i] = p256[i]; };
                    if (hash_id == 2) { out[i] = p384[i]; };
                    if (hash_id == 3) { out[i] = p512[i]; };
                };
                if (hash_id < 1 | hash_id > 3) { return 0; };
                return 19;
            };

            // ---- PKCS#1 v1.5 ----

            // Builds EM = 00 01 FF .. FF 00 DigestInfo || digest, k bytes
            def rsa_pkcs1_encode(byte* em, int k, int hash_id, byte* digest) -> bool
            {
                byte[19] prefix;
                int hl, tl, i;

                hl = rsa_hash_len(hash_id);
                if (hl == 0) { return false; };
                tl = rsa_digestinfo_prefix(hash_id, @prefix[0]) + hl;
                if (k < tl + 11) { return false; };

                em[0] = (byte)0x00;
                em[1] = (byte)0x01;
                for (i = 2; i < k - tl - 1; i++) { em[i] = (byte)0xFF; };
                em[k - tl - 1] = (byte)0x00;
                for (i = 0; i < 19; i++) { em[k - tl + i] = prefix[i]; };
                for (i = 0; i < hl; i++) { em[k - hl + i] = digest[i]; };
                return true;
            };

            def rsa_pkcs1_verify(byte* n, int n_len, byte* e, int e_len,
                                 int hash_id, byte* digest,
                                 byte* sig, int sig_len) -> bool
            {
                byte[512] em, expect, dec;
                int k, i;
                byte diff;

                k = rsa_byte_len(n, n_len);
                if (k < 12 | k > 512 | sig_len != k) { return false; };
                if (!rsa_public_op(@dec[0], sig, n, n_len, e, e_len)) { return false; };
                if (!rsa_pkcs1_encode(@expect[0], k, hash_id, digest)) { return false; };

                diff = (byte)0;
                for (i = 0; i < k; i++) { diff = diff `| (dec[i] ^| expect[i]); };
                return diff == (byte)0;
            };

            def rsa_pkcs1_sign_crt(byte* sig, int hash_id, byte* digest,
                                   byte* n, int n_len,
                                   byte* p, int p_len, byte* q, int q_len,
                                   byte* dp, int dp_len, byte* dq, int dq_len,
                                   byte* qinv, int qinv_len) -> bool
            {
                byte[512] em;
                int k;
                k = rsa_byte_len(n, n_len);
                if (k < 12 | k > 512) { return false; };
                if (!rsa_pkcs1_encode(@em[0], k, hash_id, digest)) { return false; };
                return rsa_private_crt_op(sig, @em[0], n, n_len, p, p_len, q, q_len,
                                          dp, dp_len, dq, dq_len, qinv, qinv_len);
            };

            // ---- PSS (RFC 8017 section 9.1), salt length equal to the hash length ----

            // mask = MGF1(seed, mask_len) with the given hash
            def rsa_mgf1(int hash_id, byte* seed, int seed_len, byte* mask, int mask_len) -> void
            {
                byte[4] ctr;
                byte[64] block;
                byte[1100] buf;
                int hl, done, i, take;
                u32 counter;

                hl = rsa_hash_len(hash_id);
                for (i = 0; i < seed_len; i++) { buf[i] = seed[i]; };
                done = 0;
                counter = 0u;
                while (done < mask_len)
                {
                    buf[seed_len]     = (byte)((counter >> 24u) `& 0xFFu);
                    buf[seed_len + 1] = (byte)((counter >> 16u) `& 0xFFu);
                    buf[seed_len + 2] = (byte)((counter >> 8u) `& 0xFFu);
                    buf[seed_len + 3] = (byte)(counter `& 0xFFu);
                    rsa_hash2(hash_id, @buf[0], seed_len + 4, (byte*)0, 0, @block[0]);
                    take = mask_len - done;
                    if (take > hl) { take = hl; };
                    for (i = 0; i < take; i++) { mask[done + i] = block[i]; };
                    done = done + take;
                    counter = counter + 1u;
                };
            };

            def rsa_pss_verify(byte* n, int n_len, byte* e, int e_len,
                               int hash_id, byte* digest,
                               byte* sig, int sig_len) -> bool
            {
                byte[512] dec, db_mask;
                byte[64] h_check, mprime_hash;
                byte[136] mprime;
                int k, hl, sl, em_bits, em_len, top_bits, i, db_len, ps_len;
                int mod_bits;
                byte b, diff;
                byte* em;

                hl = rsa_hash_len(hash_id);
                if (hl == 0) { return false; };
                sl = hl;
                k = rsa_byte_len(n, n_len);
                if (k < 12 | k > 512 | sig_len != k) { return false; };
                if (!rsa_public_op(@dec[0], sig, n, n_len, e, e_len)) { return false; };

                // modulus bit length
                mod_bits = k * 8;
                b = n[n_len - k];
                while ((b `& (byte)0x80) == (byte)0) { b = (byte)(b << 1u); mod_bits = mod_bits - 1; };

                em_bits = mod_bits - 1;
                em_len = (em_bits + 7) / 8;
                top_bits = 8 * em_len - em_bits;
                // EM is the low em_len bytes of the result, anything above must be zero
                for (i = 0; i < k - em_len; i++)
                {
                    if (dec[i] != (byte)0) { return false; };
                };
                em = @dec[k - em_len];

                if (em_len < hl + sl + 2) { return false; };
                if (em[em_len - 1] != (byte)0xBC) { return false; };

                db_len = em_len - hl - 1;
                // the leftmost top_bits bits of maskedDB must be zero
                if (top_bits > 0)
                {
                    if ((em[0] `& (byte)(0xFF << (8 - top_bits))) != (byte)0) { return false; };
                };

                rsa_mgf1(hash_id, em + db_len, hl, @db_mask[0], db_len);
                for (i = 0; i < db_len; i++) { db_mask[i] = db_mask[i] ^| em[i]; };
                if (top_bits > 0)
                {
                    db_mask[0] = db_mask[0] `& (byte)(0xFF >> top_bits);
                };

                ps_len = db_len - sl - 1;
                for (i = 0; i < ps_len; i++)
                {
                    if (db_mask[i] != (byte)0) { return false; };
                };
                if (db_mask[ps_len] != (byte)0x01) { return false; };

                for (i = 0; i < 8; i++) { mprime[i] = (byte)0; };
                for (i = 0; i < hl; i++) { mprime[8 + i] = digest[i]; };
                for (i = 0; i < sl; i++) { mprime[8 + hl + i] = db_mask[ps_len + 1 + i]; };
                rsa_hash2(hash_id, @mprime[0], 8 + hl + sl, (byte*)0, 0, @h_check[0]);

                diff = (byte)0;
                for (i = 0; i < hl; i++) { diff = diff `| (h_check[i] ^| em[db_len + i]); };
                return diff == (byte)0;
            };

            // salt must hold hash_len random bytes supplied by the caller
            def rsa_pss_sign_crt(byte* sig, int hash_id, byte* digest, byte* salt,
                                 byte* n, int n_len,
                                 byte* p, int p_len, byte* q, int q_len,
                                 byte* dp, int dp_len, byte* dq, int dq_len,
                                 byte* qinv, int qinv_len) -> bool
            {
                byte[512] em, db_mask, padded;
                byte[64] hh;
                byte[136] mprime;
                int k, hl, sl, em_bits, em_len, top_bits, i, db_len, ps_len, mod_bits;
                byte b;

                hl = rsa_hash_len(hash_id);
                if (hl == 0) { return false; };
                sl = hl;
                k = rsa_byte_len(n, n_len);
                if (k < 12 | k > 512) { return false; };

                mod_bits = k * 8;
                b = n[n_len - k];
                while ((b `& (byte)0x80) == (byte)0) { b = (byte)(b << 1u); mod_bits = mod_bits - 1; };
                em_bits = mod_bits - 1;
                em_len = (em_bits + 7) / 8;
                top_bits = 8 * em_len - em_bits;
                if (em_len < hl + sl + 2) { return false; };

                for (i = 0; i < 8; i++) { mprime[i] = (byte)0; };
                for (i = 0; i < hl; i++) { mprime[8 + i] = digest[i]; };
                for (i = 0; i < sl; i++) { mprime[8 + hl + i] = salt[i]; };
                rsa_hash2(hash_id, @mprime[0], 8 + hl + sl, (byte*)0, 0, @hh[0]);

                db_len = em_len - hl - 1;
                ps_len = db_len - sl - 1;
                for (i = 0; i < ps_len; i++) { em[i] = (byte)0; };
                em[ps_len] = (byte)0x01;
                for (i = 0; i < sl; i++) { em[ps_len + 1 + i] = salt[i]; };

                rsa_mgf1(hash_id, @hh[0], hl, @db_mask[0], db_len);
                for (i = 0; i < db_len; i++) { em[i] = em[i] ^| db_mask[i]; };
                if (top_bits > 0)
                {
                    em[0] = em[0] `& (byte)(0xFF >> top_bits);
                };
                for (i = 0; i < hl; i++) { em[db_len + i] = hh[i]; };
                em[em_len - 1] = (byte)0xBC;

                for (i = 0; i < k - em_len; i++) { padded[i] = (byte)0; };
                for (i = 0; i < em_len; i++) { padded[k - em_len + i] = em[i]; };

                return rsa_private_crt_op(sig, @padded[0], n, n_len, p, p_len, q, q_len,
                                          dp, dp_len, dq, dq_len, qinv, qinv_len);
            };

        }; // RSA

        namespace P384
        {
            // =========================================================================
            // ECDSA over P-384 (secp384r1)
            //
            // Field and scalar arithmetic reuse the Montgomery routines of the RSA
            // namespace on 12 limb values. Points are Jacobian, kept in Montgomery form.
            // All byte interfaces are big endian 48 byte values.
            //
            // Public API:
            //   ecdsa_p384_pubkey(qx48, qy48, priv48) -> bool
            //   ecdsa_p384_sign(r48, s48, priv48, hash, hash_len, nonce48) -> bool
            //   ecdsa_p384_verify(r48, s48, qx48, qy48, hash, hash_len) -> bool
            //   ecdsa_p256n_pubkey / _sign / _verify: the same for P-256 with 32 byte values
            //   ecdsa_der_encode_n(der_out, der_len*, r, s, nbytes)
            //   ecdsa_der_decode_n(r, s, nbytes, der_in, der_len) -> bool
            //
            // hash_len may be any length; the leftmost 48 bytes are used. The nonce is
            // supplied by the caller and must be uniformly random in [1, n-1]. Not
            // constant time.
            // =========================================================================

            global uint[12] P384_P = [0xFFFFFFFFu, 0x00000000u, 0x00000000u, 0xFFFFFFFFu, 0xFFFFFFFEu, 0xFFFFFFFFu, 0xFFFFFFFFu, 0xFFFFFFFFu, 0xFFFFFFFFu, 0xFFFFFFFFu, 0xFFFFFFFFu, 0xFFFFFFFFu];
            global uint[12] P384_N = [0xCCC52973u, 0xECEC196Au, 0x48B0A77Au, 0x581A0DB2u, 0xF4372DDFu, 0xC7634D81u, 0xFFFFFFFFu, 0xFFFFFFFFu, 0xFFFFFFFFu, 0xFFFFFFFFu, 0xFFFFFFFFu, 0xFFFFFFFFu];
            global uint[12] P384_B = [0xD3EC2AEFu, 0x2A85C8EDu, 0x8A2ED19Du, 0xC656398Du, 0x5013875Au, 0x0314088Fu, 0xFE814112u, 0x181D9C6Eu, 0xE3F82D19u, 0x988E056Bu, 0xE23EE7E4u, 0xB3312FA7u];
            global uint[12] P384_GX = [0x72760AB7u, 0x3A545E38u, 0xBF55296Cu, 0x5502F25Du, 0x82542A38u, 0x59F741E0u, 0x8BA79B98u, 0x6E1D3B62u, 0xF320AD74u, 0x8EB1C71Eu, 0xBE8B0537u, 0xAA87CA22u];
            global uint[12] P384_GY = [0x90EA0E5Fu, 0x7A431D7Cu, 0x1D7E819Du, 0x0A60B1CEu, 0xB5F0B8C0u, 0xE9DA3113u, 0x289A147Cu, 0xF8F41DBDu, 0x9292DC29u, 0x5D9E98BFu, 0x96262C6Fu, 0x3617DE4Au];

            global uint[12] P256N_P = [0xFFFFFFFFu, 0xFFFFFFFFu, 0xFFFFFFFFu, 0x00000000u, 0x00000000u, 0x00000000u, 0x00000001u, 0xFFFFFFFFu, 0x00000000u, 0x00000000u, 0x00000000u, 0x00000000u];
            global uint[12] P256N_N = [0xFC632551u, 0xF3B9CAC2u, 0xA7179E84u, 0xBCE6FAADu, 0xFFFFFFFFu, 0xFFFFFFFFu, 0x00000000u, 0xFFFFFFFFu, 0x00000000u, 0x00000000u, 0x00000000u, 0x00000000u];
            global uint[12] P256N_B = [0x27D2604Bu, 0x3BCE3C3Eu, 0xCC53B0F6u, 0x651D06B0u, 0x769886BCu, 0xB3EBBD55u, 0xAA3A93E7u, 0x5AC635D8u, 0x00000000u, 0x00000000u, 0x00000000u, 0x00000000u];
            global uint[12] P256N_GX = [0xD898C296u, 0xF4A13945u, 0x2DEB33A0u, 0x77037D81u, 0x63A440F2u, 0xF8BCE6E5u, 0xE12C4247u, 0x6B17D1F2u, 0x00000000u, 0x00000000u, 0x00000000u, 0x00000000u];
            global uint[12] P256N_GY = [0x37BF51F5u, 0xCBB64068u, 0x6B315ECEu, 0x2BCE3357u, 0x7C0F9E16u, 0x8EE7EB4Au, 0xFE1A7F9Bu, 0x4FE342E2u, 0x00000000u, 0x00000000u, 0x00000000u, 0x00000000u];

            struct P384_PT
            {
                uint[12] x;
                uint[12] y;
                uint[12] z;
            };

            // Montgomery multiply that keeps unused upper limbs zero for curves narrower than 12 limbs
            def p384_fmul(RSA_MONT* m, uint* r, uint* a, uint* b) -> void
            {
                int i;
                RSA::rsa_mont_mul(m, r, a, b);
                for (i = m.len; i < 12; i++) { r[i] = 0u; };
            };

            def p384_zero(uint* a) -> void
            {
                int i;
                for (i = 0; i < 12; i++) { a[i] = 0u; };
            };

            def p384_copy(uint* d, uint* s) -> void
            {
                int i;
                for (i = 0; i < 12; i++) { d[i] = s[i]; };
            };

            def p384_iszero(uint* a) -> bool
            {
                int i;
                for (i = 0; i < 12; i++) { if (a[i] != 0u) { return false; }; };
                return true;
            };

            // modulus taken from the context
            def p384_addmod(RSA_MONT* m, uint* r, uint* a, uint* b) -> void
            {
                uint c = RSA::rsa_add(r, a, b, 12);
                if (c != 0u | RSA::rsa_cmp(r, @m.n[0], 12) >= 0)
                {
                    RSA::rsa_sub(r, r, @m.n[0], 12);
                };
            };

            def p384_submod(RSA_MONT* m, uint* r, uint* a, uint* b) -> void
            {
                uint br = RSA::rsa_sub(r, a, b, 12);
                if (br != 0u) { RSA::rsa_add(r, r, @m.n[0], 12); };
            };

            // a * b mod n for values in normal form
            def p384_nmul(RSA_MONT* m, uint* r, uint* a, uint* b) -> void
            {
                uint[12] t;
                p384_fmul(m, @t[0], a, @m.rr[0]);
                p384_fmul(m, r, @t[0], b);
            };

            // a ^ -1 mod modulus for a value in normal form (modulus prime)
            def p384_inv(RSA_MONT* m, uint* r, uint* a) -> void
            {
                uint[12] e, two;
                p384_zero(@two[0]);
                two[0] = 2u;
                RSA::rsa_sub(@e[0], @m.n[0], @two[0], 12);
                int i;
                RSA::rsa_mont_exp(m, r, a, @e[0], 12);
                for (i = m.len; i < 12; i++) { r[i] = 0u; };
            };

            def p384_to_mont(RSA_MONT* m, uint* r, uint* a) -> void
            {
                p384_fmul(m, r, a, @m.rr[0]);
            };

            def p384_from_mont(RSA_MONT* m, uint* r, uint* a) -> void
            {
                uint[12] one;
                p384_zero(@one[0]);
                one[0] = 1u;
                p384_fmul(m, r, a, @one[0]);
            };

            def p384_set_inf(P384_PT* r) -> void
            {
                p384_zero(@r.x[0]);
                p384_zero(@r.y[0]);
                p384_zero(@r.z[0]);
            };

            def p384_dbl(RSA_MONT* m, P384_PT* r, P384_PT* p) -> void
            {
                uint[12] delta, gamma, beta, t1, t2, t, alpha, b2, b4, b8, x3, y3, z3, g2;
                uint* P = @m.n[0];

                if (p384_iszero(@p.z[0]) | p384_iszero(@p.y[0]))
                {
                    p384_set_inf(r);
                    return;
                };

                p384_fmul(m, @delta[0], @p.z[0], @p.z[0]);
                p384_fmul(m, @gamma[0], @p.y[0], @p.y[0]);
                p384_fmul(m, @beta[0], @p.x[0], @gamma[0]);
                p384_submod(m, @t1[0], @p.x[0], @delta[0]);
                p384_addmod(m, @t2[0], @p.x[0], @delta[0]);
                p384_fmul(m, @t[0], @t1[0], @t2[0]);
                p384_addmod(m, @alpha[0], @t[0], @t[0]);
                p384_addmod(m, @alpha[0], @alpha[0], @t[0]);

                p384_addmod(m, @b2[0], @beta[0], @beta[0]);
                p384_addmod(m, @b4[0], @b2[0], @b2[0]);
                p384_addmod(m, @b8[0], @b4[0], @b4[0]);

                p384_fmul(m, @x3[0], @alpha[0], @alpha[0]);
                p384_submod(m, @x3[0], @x3[0], @b8[0]);

                p384_addmod(m, @t1[0], @p.y[0], @p.z[0]);
                p384_fmul(m, @z3[0], @t1[0], @t1[0]);
                p384_submod(m, @z3[0], @z3[0], @gamma[0]);
                p384_submod(m, @z3[0], @z3[0], @delta[0]);

                p384_submod(m, @t1[0], @b4[0], @x3[0]);
                p384_fmul(m, @y3[0], @alpha[0], @t1[0]);
                p384_fmul(m, @g2[0], @gamma[0], @gamma[0]);
                p384_addmod(m, @g2[0], @g2[0], @g2[0]);
                p384_addmod(m, @g2[0], @g2[0], @g2[0]);
                p384_addmod(m, @g2[0], @g2[0], @g2[0]);
                p384_submod(m, @y3[0], @y3[0], @g2[0]);

                p384_copy(@r.x[0], @x3[0]);
                p384_copy(@r.y[0], @y3[0]);
                p384_copy(@r.z[0], @z3[0]);
            };

            def p384_add(RSA_MONT* m, P384_PT* r, P384_PT* p, P384_PT* q) -> void
            {
                uint[12] z1z1, z2z2, u1, u2, s1, s2, h, rr, i2, j, v, x3, y3, z3, t, t2;

                if (p384_iszero(@p.z[0]))
                {
                    p384_copy(@r.x[0], @q.x[0]);
                    p384_copy(@r.y[0], @q.y[0]);
                    p384_copy(@r.z[0], @q.z[0]);
                    return;
                };
                if (p384_iszero(@q.z[0]))
                {
                    p384_copy(@r.x[0], @p.x[0]);
                    p384_copy(@r.y[0], @p.y[0]);
                    p384_copy(@r.z[0], @p.z[0]);
                    return;
                };

                p384_fmul(m, @z1z1[0], @p.z[0], @p.z[0]);
                p384_fmul(m, @z2z2[0], @q.z[0], @q.z[0]);
                p384_fmul(m, @u1[0], @p.x[0], @z2z2[0]);
                p384_fmul(m, @u2[0], @q.x[0], @z1z1[0]);
                p384_fmul(m, @t[0], @q.z[0], @z2z2[0]);
                p384_fmul(m, @s1[0], @p.y[0], @t[0]);
                p384_fmul(m, @t[0], @p.z[0], @z1z1[0]);
                p384_fmul(m, @s2[0], @q.y[0], @t[0]);

                p384_submod(m, @h[0], @u2[0], @u1[0]);
                p384_submod(m, @rr[0], @s2[0], @s1[0]);
                if (p384_iszero(@h[0]))
                {
                    if (p384_iszero(@rr[0]))
                    {
                        p384_dbl(m, r, p);
                    }
                    else
                    {
                        p384_set_inf(r);
                    };
                    return;
                };
                p384_addmod(m, @rr[0], @rr[0], @rr[0]);

                p384_addmod(m, @t[0], @h[0], @h[0]);
                p384_fmul(m, @i2[0], @t[0], @t[0]);
                p384_fmul(m, @j[0], @h[0], @i2[0]);
                p384_fmul(m, @v[0], @u1[0], @i2[0]);

                p384_fmul(m, @x3[0], @rr[0], @rr[0]);
                p384_submod(m, @x3[0], @x3[0], @j[0]);
                p384_submod(m, @x3[0], @x3[0], @v[0]);
                p384_submod(m, @x3[0], @x3[0], @v[0]);

                p384_submod(m, @t[0], @v[0], @x3[0]);
                p384_fmul(m, @y3[0], @rr[0], @t[0]);
                p384_fmul(m, @t2[0], @s1[0], @j[0]);
                p384_addmod(m, @t2[0], @t2[0], @t2[0]);
                p384_submod(m, @y3[0], @y3[0], @t2[0]);

                p384_addmod(m, @t[0], @p.z[0], @q.z[0]);
                p384_fmul(m, @z3[0], @t[0], @t[0]);
                p384_submod(m, @z3[0], @z3[0], @z1z1[0]);
                p384_submod(m, @z3[0], @z3[0], @z2z2[0]);
                p384_fmul(m, @z3[0], @z3[0], @h[0]);

                p384_copy(@r.x[0], @x3[0]);
                p384_copy(@r.y[0], @y3[0]);
                p384_copy(@r.z[0], @z3[0]);
            };

            // r = k * p, k is 48 big endian bytes
            def p384_mul(RSA_MONT* m, P384_PT* r, byte* k, int nb, P384_PT* p) -> void
            {
                P384_PT acc, base;
                int i, b;
                p384_copy(@base.x[0], @p.x[0]);
                p384_copy(@base.y[0], @p.y[0]);
                p384_copy(@base.z[0], @p.z[0]);
                p384_set_inf(@acc);
                for (i = 0; i < nb; i++)
                {
                    for (b = 7; b >= 0; b--)
                    {
                        p384_dbl(m, @acc, @acc);
                        if (((k[i] >> (byte)b) `& (byte)1) != (byte)0)
                        {
                            p384_add(m, @acc, @acc, @base);
                        };
                    };
                };
                p384_copy(@r.x[0], @acc.x[0]);
                p384_copy(@r.y[0], @acc.y[0]);
                p384_copy(@r.z[0], @acc.z[0]);
            };

            // affine normal form coordinates. Returns false at infinity.
            def p384_to_affine(RSA_MONT* m, uint* ax, uint* ay, P384_PT* p) -> bool
            {
                uint[12] zn, zi, zim, zi2, zi3, x, y;
                if (p384_iszero(@p.z[0])) { return false; };
                p384_from_mont(m, @zn[0], @p.z[0]);
                p384_inv(m, @zi[0], @zn[0]);
                p384_to_mont(m, @zim[0], @zi[0]);
                p384_fmul(m, @zi2[0], @zim[0], @zim[0]);
                p384_fmul(m, @zi3[0], @zi2[0], @zim[0]);
                p384_fmul(m, @x[0], @p.x[0], @zi2[0]);
                p384_fmul(m, @y[0], @p.y[0], @zi3[0]);
                p384_from_mont(m, ax, @x[0]);
                p384_from_mont(m, ay, @y[0]);
                return true;
            };

            // affine normal form to a Montgomery Jacobian point
            def p384_from_affine(RSA_MONT* m, P384_PT* r, uint* ax, uint* ay) -> void
            {
                p384_to_mont(m, @r.x[0], ax);
                p384_to_mont(m, @r.y[0], ay);
                p384_copy(@r.z[0], @m.one[0]);
            };

            // y^2 == x^3 - 3x + b for normal form coordinates below p
            def p384_on_curve(RSA_MONT* m, uint* ax, uint* ay, uint* bconst) -> bool
            {
                uint[12] x, y, y2, x2, x3, t, bm, rhs;
                if (RSA::rsa_cmp(ax, @m.n[0], 12) >= 0) { return false; };
                if (RSA::rsa_cmp(ay, @m.n[0], 12) >= 0) { return false; };
                p384_to_mont(m, @x[0], ax);
                p384_to_mont(m, @y[0], ay);
                p384_to_mont(m, @bm[0], bconst);
                p384_fmul(m, @y2[0], @y[0], @y[0]);
                p384_fmul(m, @x2[0], @x[0], @x[0]);
                p384_fmul(m, @x3[0], @x2[0], @x[0]);
                p384_addmod(m, @t[0], @x[0], @x[0]);
                p384_addmod(m, @t[0], @t[0], @x[0]);
                p384_submod(m, @rhs[0], @x3[0], @t[0]);
                p384_addmod(m, @rhs[0], @rhs[0], @bm[0]);
                return RSA::rsa_cmp(@y2[0], @rhs[0], 12) == 0;
            };

            def p384_load(uint* out, byte* be, int nb) -> void
            {
                RSA::rsa_be_to_limbs(out, 12, be, nb);
            };

            def p384_store(byte* be, uint* v, int nb) -> void
            {
                RSA::rsa_limbs_to_be(be, nb, v, 12);
            };

            // hash to an integer below n, using the leftmost nb bytes
            def p384_hash_to_scalar(RSA_MONT* fn, uint* out, byte* hash, int hash_len, int nb) -> void
            {
                byte[48] buf;
                uint[12] tmp;
                int i, n;
                n = hash_len;
                if (n > nb) { n = nb; };
                for (i = 0; i < 48; i++) { buf[i] = (byte)0; };
                for (i = 0; i < n; i++) { buf[nb - n + i] = hash[i]; };
                p384_load(@tmp[0], @buf[0], nb);
                RSA::rsa_mod(out, @tmp[0], 12, @fn.n[0], 12);
            };

            // ---- curve independent operations ----
            // nl limbs and nb bytes per field element, with the curve constants

            def p3_pubkey(int nl, int nb, uint* cp, uint* cn, uint* cgx, uint* cgy,
                          byte* qx, byte* qy, byte* priv) -> bool
            {
                RSA_MONT fp, fn;
                P384_PT g, q;
                uint[12] d, ax, ay;

                RSA::rsa_mont_init(@fp, cp, nl);
                RSA::rsa_mont_init(@fn, cn, nl);
                p384_load(@d[0], priv, nb);
                if (p384_iszero(@d[0]) | RSA::rsa_cmp(@d[0], @fn.n[0], 12) >= 0) { return false; };

                p384_from_affine(@fp, @g, cgx, cgy);
                p384_mul(@fp, @q, priv, nb, @g);
                if (!p384_to_affine(@fp, @ax[0], @ay[0], @q)) { return false; };
                p384_store(qx, @ax[0], nb);
                p384_store(qy, @ay[0], nb);
                return true;
            };

            def p3_sign(int nl, int nb, uint* cp, uint* cn, uint* cgx, uint* cgy,
                        byte* rout, byte* sout, byte* priv,
                        byte* hash, int hash_len, byte* nonce) -> bool
            {
                RSA_MONT fp, fn;
                P384_PT g, kg;
                uint[12] d, k, e, ax, ay, rr, t, kinv, ss;

                RSA::rsa_mont_init(@fp, cp, nl);
                RSA::rsa_mont_init(@fn, cn, nl);
                p384_load(@d[0], priv, nb);
                p384_load(@k[0], nonce, nb);
                if (p384_iszero(@d[0]) | RSA::rsa_cmp(@d[0], @fn.n[0], 12) >= 0) { return false; };
                if (p384_iszero(@k[0]) | RSA::rsa_cmp(@k[0], @fn.n[0], 12) >= 0) { return false; };

                p384_from_affine(@fp, @g, cgx, cgy);
                p384_mul(@fp, @kg, nonce, nb, @g);
                if (!p384_to_affine(@fp, @ax[0], @ay[0], @kg)) { return false; };

                RSA::rsa_mod(@rr[0], @ax[0], 12, @fn.n[0], 12);
                if (p384_iszero(@rr[0])) { return false; };

                p384_hash_to_scalar(@fn, @e[0], hash, hash_len, nb);
                p384_nmul(@fn, @t[0], @rr[0], @d[0]);
                p384_addmod(@fn, @t[0], @t[0], @e[0]);
                p384_inv(@fn, @kinv[0], @k[0]);
                p384_nmul(@fn, @ss[0], @kinv[0], @t[0]);
                if (p384_iszero(@ss[0])) { return false; };

                p384_store(rout, @rr[0], nb);
                p384_store(sout, @ss[0], nb);
                return true;
            };

            def p3_verify(int nl, int nb, uint* cp, uint* cn, uint* cb, uint* cgx, uint* cgy,
                          byte* rin, byte* sin, byte* qxin, byte* qyin,
                          byte* hash, int hash_len) -> bool
            {
                RSA_MONT fp, fn;
                P384_PT g, q, a, b, sum;
                uint[12] r, s, e, w, u1, u2, qx, qy, ax, ay, xr;
                byte[48] u1b, u2b;

                RSA::rsa_mont_init(@fp, cp, nl);
                RSA::rsa_mont_init(@fn, cn, nl);
                p384_load(@r[0], rin, nb);
                p384_load(@s[0], sin, nb);
                if (p384_iszero(@r[0]) | RSA::rsa_cmp(@r[0], @fn.n[0], 12) >= 0) { return false; };
                if (p384_iszero(@s[0]) | RSA::rsa_cmp(@s[0], @fn.n[0], 12) >= 0) { return false; };

                p384_load(@qx[0], qxin, nb);
                p384_load(@qy[0], qyin, nb);
                if (!p384_on_curve(@fp, @qx[0], @qy[0], cb)) { return false; };

                p384_hash_to_scalar(@fn, @e[0], hash, hash_len, nb);
                p384_inv(@fn, @w[0], @s[0]);
                p384_nmul(@fn, @u1[0], @e[0], @w[0]);
                p384_nmul(@fn, @u2[0], @r[0], @w[0]);
                p384_store(@u1b[0], @u1[0], nb);
                p384_store(@u2b[0], @u2[0], nb);

                p384_from_affine(@fp, @g, cgx, cgy);
                p384_from_affine(@fp, @q, @qx[0], @qy[0]);
                p384_mul(@fp, @a, @u1b[0], nb, @g);
                p384_mul(@fp, @b, @u2b[0], nb, @q);
                p384_add(@fp, @sum, @a, @b);
                if (!p384_to_affine(@fp, @ax[0], @ay[0], @sum)) { return false; };

                RSA::rsa_mod(@xr[0], @ax[0], 12, @fn.n[0], 12);
                return RSA::rsa_cmp(@xr[0], @r[0], 12) == 0;
            };

            // ---- P-384 ----

            def ecdsa_p384_pubkey(byte* qx48, byte* qy48, byte* priv48) -> bool
            {
                return p3_pubkey(12, 48, @P384_P[0], @P384_N[0], @P384_GX[0], @P384_GY[0], qx48, qy48, priv48);
            };

            def ecdsa_p384_sign(byte* r48, byte* s48, byte* priv48,
                                byte* hash, int hash_len, byte* nonce48) -> bool
            {
                return p3_sign(12, 48, @P384_P[0], @P384_N[0], @P384_GX[0], @P384_GY[0],
                               r48, s48, priv48, hash, hash_len, nonce48);
            };

            def ecdsa_p384_verify(byte* r48, byte* s48, byte* qx48, byte* qy48,
                                  byte* hash, int hash_len) -> bool
            {
                return p3_verify(12, 48, @P384_P[0], @P384_N[0], @P384_B[0], @P384_GX[0], @P384_GY[0],
                                 r48, s48, qx48, qy48, hash, hash_len);
            };

            // ---- P-256 (secp256r1) on the same engine ----

            def ecdsa_p256n_pubkey(byte* qx32, byte* qy32, byte* priv32) -> bool
            {
                return p3_pubkey(8, 32, @P256N_P[0], @P256N_N[0], @P256N_GX[0], @P256N_GY[0], qx32, qy32, priv32);
            };

            def ecdsa_p256n_sign(byte* r32, byte* s32, byte* priv32,
                                 byte* hash, int hash_len, byte* nonce32) -> bool
            {
                return p3_sign(8, 32, @P256N_P[0], @P256N_N[0], @P256N_GX[0], @P256N_GY[0],
                               r32, s32, priv32, hash, hash_len, nonce32);
            };

            def ecdsa_p256n_verify(byte* r32, byte* s32, byte* qx32, byte* qy32,
                                   byte* hash, int hash_len) -> bool
            {
                return p3_verify(8, 32, @P256N_P[0], @P256N_N[0], @P256N_B[0], @P256N_GX[0], @P256N_GY[0],
                                 r32, s32, qx32, qy32, hash, hash_len);
            };

            // ---- DER signature encoding for any field size ----

            // one INTEGER from nb big endian bytes, returns bytes written
            def ecdsa_der_put_int(byte* out, byte* v, int nb) -> int
            {
                int start = 0, len, pos = 0, i;
                while (start < nb - 1 & v[start] == (byte)0) { start++; };
                len = nb - start;
                out[pos] = (byte)2;
                pos++;
                if ((v[start] `& (byte)0x80) != (byte)0)
                {
                    out[pos] = (byte)(len + 1);
                    pos++;
                    out[pos] = (byte)0;
                    pos++;
                }
                else
                {
                    out[pos] = (byte)len;
                    pos++;
                };
                for (i = 0; i < len; i++) { out[pos + i] = v[start + i]; };
                return pos + len;
            };

            def ecdsa_der_encode_n(byte* der_out, int* der_len, byte* r, byte* s, int nb) -> void
            {
                byte[140] body;
                int bl, i, pos = 0;
                bl = ecdsa_der_put_int(@body[0], r, nb);
                bl = bl + ecdsa_der_put_int(@body[bl], s, nb);
                der_out[pos] = (byte)0x30;
                pos++;
                if (bl >= 128)
                {
                    der_out[pos] = (byte)0x81;
                    pos++;
                };
                der_out[pos] = (byte)bl;
                pos++;
                for (i = 0; i < bl; i++) { der_out[pos + i] = body[i]; };
                *der_len = pos + bl;
            };

            // parse one INTEGER at der[*pos] into nb big endian bytes
            def ecdsa_der_get_int(byte* out, int nb, byte* der, int der_len, int* pos) -> bool
            {
                int len, p, i, skip;
                p = *pos;
                if (p + 2 > der_len) { return false; };
                if (der[p] != (byte)2) { return false; };
                len = (int)der[p + 1];
                p = p + 2;
                if (len == 0 | len >= 128 | p + len > der_len) { return false; };
                if ((der[p] `& (byte)0x80) != (byte)0) { return false; };
                skip = 0;
                while (skip < len - 1 & der[p + skip] == (byte)0) { skip++; };
                if (len - skip > nb) { return false; };
                for (i = 0; i < nb; i++) { out[i] = (byte)0; };
                for (i = 0; i < len - skip; i++) { out[nb - (len - skip) + i] = der[p + skip + i]; };
                *pos = p + len;
                return true;
            };

            def ecdsa_der_decode_n(byte* r, byte* s, int nb, byte* der, int der_len) -> bool
            {
                int pos, total;
                if (der_len < 8 | der[0] != (byte)0x30) { return false; };
                pos = 2;
                total = (int)der[1];
                if (total == 0x81)
                {
                    total = (int)der[2];
                    pos = 3;
                }
                else
                {
                    if (total >= 128) { return false; };
                };
                if (pos + total != der_len) { return false; };
                if (!ecdsa_der_get_int(r, nb, der, der_len, @pos)) { return false; };
                if (!ecdsa_der_get_int(s, nb, der, der_len, @pos)) { return false; };
                return pos == der_len;
            };

        }; // P384

        namespace X509
        {
            // =========================================================================
            // ASN.1 DER reader, X.509 certificate parsing, PEM bundle loading, hostname
            // matching and chain validation.
            //
            // A parsed X509_CERT holds pointers into the DER buffer it was parsed from,
            // so that buffer must stay alive and unmodified while the certificate is used.
            //
            // Supported signatures: RSA PKCS#1 v1.5 and ECDSA with SHA-256/384/512.
            // Supported keys: RSA, EC P-256, EC P-384. RSASSA-PSS signed certificates are
            // reported as unsupported. Names are compared as raw DER bytes.
            //
            // Public API:
            //   x509_parse(X509_CERT* c, byte* der, int der_len) -> bool
            //   x509_load_pem_bundle(pem, pem_len, der_out, der_cap, certs, max) -> int
            //   x509_check_sig(X509_CERT* c, X509_CERT* issuer) -> int
            //   x509_match_host(X509_CERT* c, byte* host, int host_len) -> bool
            //   x509_verify_chain(chain, n, roots, nroots, now, host, host_len) -> int
            //
            // x509_verify_chain error codes:
            //   0 ok, 2 expired or not yet valid, 3 bad signature, 4 issuer is not a CA,
            //   5 no trusted root, 6 hostname mismatch, 7 unsupported algorithm,
            //   8 path length exceeded, 9 key usage forbids certificate signing
            // `now` is unix time in seconds supplied by the caller.
            // =========================================================================

            global byte[9] X509_OID_RSA    = [42,134,72,134,247,13,1,1,1];
            global byte[9] X509_OID_SHA256_RSA = [42,134,72,134,247,13,1,1,11];
            global byte[9] X509_OID_SHA384_RSA = [42,134,72,134,247,13,1,1,12];
            global byte[9] X509_OID_SHA512_RSA = [42,134,72,134,247,13,1,1,13];
            global byte[8] X509_OID_ECDSA_SHA256 = [42,134,72,206,61,4,3,2];
            global byte[8] X509_OID_ECDSA_SHA384 = [42,134,72,206,61,4,3,3];
            global byte[8] X509_OID_ECDSA_SHA512 = [42,134,72,206,61,4,3,4];
            global byte[7] X509_OID_EC_KEY = [42,134,72,206,61,2,1];
            global byte[8] X509_OID_P256 = [42,134,72,206,61,3,1,7];
            global byte[5] X509_OID_P384 = [43,129,4,0,34];
            global byte[3] X509_OID_BASIC = [85,29,19];
            global byte[3] X509_OID_KEYUSE = [85,29,15];
            global byte[3] X509_OID_SAN = [85,29,17];
            global byte[3] X509_OID_CN = [85,4,3];

            global const int X509_KEY_RSA = 1, X509_KEY_P256 = 2, X509_KEY_P384 = 3;

            struct X509_CERT
            {
                byte* der;
                int der_len;
                byte* tbs;
                int tbs_len;
                int sig_alg;        // 1..3 RSA sha256/384/512, 4..6 ECDSA sha256/384/512, 0 unsupported
                byte* sig;
                int sig_len;
                byte* issuer;
                int issuer_len;
                byte* subject;
                int subject_len;
                i64 not_before;
                i64 not_after;
                int key_type;
                byte* rsa_n;
                int rsa_n_len;
                byte* rsa_e;
                int rsa_e_len;
                byte* ec_point;     // uncompressed point 04 || X || Y
                int ec_len;
                byte* san;          // content of the GeneralNames sequence
                int san_len;
                byte* cn;
                int cn_len;
                bool has_bc;
                bool is_ca;
                int path_len;       // -1 when absent
                bool has_ku;
                int ku;             // first key usage byte
            };

            // ---- DER reader ----

            // Reads the header at pos. cstart is the content offset, clen its length.
            def asn1_hdr(byte* b, int len, int pos, int* tag, int* cstart, int* clen) -> bool
            {
                int l, p, nb, i;
                if (pos < 0 | pos + 2 > len) { return false; };
                if (((int)b[pos] `& 31) == 31) { return false; };
                *tag = (int)b[pos];
                l = (int)b[pos + 1];
                p = pos + 2;
                if ((l `& 128) != 0)
                {
                    nb = l `& 127;
                    if (nb == 0 | nb > 3 | p + nb > len) { return false; };
                    l = 0;
                    for (i = 0; i < nb; i++) { l = l * 256 + (int)b[p + i]; };
                    p = p + nb;
                };
                if (l < 0 | p + l > len) { return false; };
                *cstart = p;
                *clen = l;
                return true;
            };

            def x509_oid_is(byte* d, int off, int len, byte* oid, int n) -> bool
            {
                int i;
                if (len != n) { return false; };
                for (i = 0; i < n; i++) { if (d[off + i] != oid[i]) { return false; }; };
                return true;
            };

            // ---- time ----

            def x509_days_from_civil(int y, int m, int d) -> i64
            {
                int era, yoe, doy, doe, mp;
                if (m <= 2) { y = y - 1; };
                era = y / 400;
                yoe = y - era * 400;
                mp = m + 9;
                if (m > 2) { mp = m - 3; };
                doy = (153 * mp + 2) / 5 + d - 1;
                doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
                return (i64)era * (i64)146097 + (i64)doe - (i64)719468;
            };

            def x509_digits(byte* b, int off, int n) -> int
            {
                int i, v = 0;
                for (i = 0; i < n; i++) { v = v * 10 + ((int)b[off + i] - 48); };
                return v;
            };

            // UTCTime (tag 23) or GeneralizedTime (tag 24) to unix seconds
            def x509_parse_time(byte* b, int off, int len, int tag, i64* out) -> bool
            {
                int y, mo, d, h, mi, s, p;
                if (tag == 23)
                {
                    if (len != 13) { return false; };
                    y = x509_digits(b, off, 2);
                    if (y < 50) { y = y + 2000; } else { y = y + 1900; };
                    p = off + 2;
                }
                else
                {
                    if (len != 15) { return false; };
                    y = x509_digits(b, off, 4);
                    p = off + 4;
                };
                mo = x509_digits(b, p, 2);
                d = x509_digits(b, p + 2, 2);
                h = x509_digits(b, p + 4, 2);
                mi = x509_digits(b, p + 6, 2);
                s = x509_digits(b, p + 8, 2);
                *out = x509_days_from_civil(y, mo, d) * (i64)86400 + (i64)(h * 3600 + mi * 60 + s);
                return true;
            };

            // ---- certificate parsing ----

            def x509_sig_alg(byte* d, int off, int len) -> int
            {
                if (x509_oid_is(d, off, len, @X509_OID_SHA256_RSA[0], 9)) { return 1; };
                if (x509_oid_is(d, off, len, @X509_OID_SHA384_RSA[0], 9)) { return 2; };
                if (x509_oid_is(d, off, len, @X509_OID_SHA512_RSA[0], 9)) { return 3; };
                if (x509_oid_is(d, off, len, @X509_OID_ECDSA_SHA256[0], 8)) { return 4; };
                if (x509_oid_is(d, off, len, @X509_OID_ECDSA_SHA384[0], 8)) { return 5; };
                if (x509_oid_is(d, off, len, @X509_OID_ECDSA_SHA512[0], 8)) { return 6; };
                return 0;
            };

            def x509_parse_extensions(X509_CERT* c, byte* d, int start, int len) -> void
            {
                int pos, end, tag, cs, cl, ep, eend, os, ol, vs, vl, ip, itag, ics, icl, bs, bl;
                pos = start;
                end = start + len;
                while (pos < end)
                {
                    if (!asn1_hdr(d, end, pos, @tag, @cs, @cl)) { return; };
                    ep = cs;
                    eend = cs + cl;
                    pos = cs + cl;
                    if (tag != 48) { continue; };
                    if (!asn1_hdr(d, eend, ep, @tag, @os, @ol)) { return; };
                    ep = os + ol;
                    if (ep < eend)
                    {
                        if (d[ep] == (byte)1)
                        {
                            if (!asn1_hdr(d, eend, ep, @itag, @ics, @icl)) { return; };
                            ep = ics + icl;
                        };
                    };
                    if (!asn1_hdr(d, eend, ep, @itag, @vs, @vl)) { return; };
                    if (itag != 4) { continue; };

                    if (x509_oid_is(d, os, ol, @X509_OID_BASIC[0], 3))
                    {
                        c.has_bc = true;
                        c.is_ca = false;
                        c.path_len = 0 - 1;
                        if (asn1_hdr(d, vs + vl, vs, @itag, @ics, @icl))
                        {
                            ip = ics;
                            if (ip < ics + icl)
                            {
                                if (d[ip] == (byte)1)
                                {
                                    if (asn1_hdr(d, ics + icl, ip, @itag, @bs, @bl))
                                    {
                                        if (bl == 1 & d[bs] != (byte)0) { c.is_ca = true; };
                                        ip = bs + bl;
                                    };
                                };
                            };
                            if (ip < ics + icl)
                            {
                                if (d[ip] == (byte)2)
                                {
                                    if (asn1_hdr(d, ics + icl, ip, @itag, @bs, @bl))
                                    {
                                        if (bl == 1) { c.path_len = (int)d[bs]; };
                                    };
                                };
                            };
                        };
                    };
                    if (x509_oid_is(d, os, ol, @X509_OID_KEYUSE[0], 3))
                    {
                        if (asn1_hdr(d, vs + vl, vs, @itag, @ics, @icl))
                        {
                            if (itag == 3 & icl >= 2)
                            {
                                c.has_ku = true;
                                c.ku = (int)d[ics + 1];
                            };
                        };
                    };
                    if (x509_oid_is(d, os, ol, @X509_OID_SAN[0], 3))
                    {
                        if (asn1_hdr(d, vs + vl, vs, @itag, @ics, @icl))
                        {
                            c.san = d + ics;
                            c.san_len = icl;
                        };
                    };
                };
            };

            // Finds the commonName in a Name (SEQUENCE of SET of SEQUENCE)
            def x509_find_cn(X509_CERT* c, byte* d, int start, int len) -> void
            {
                int pos, end, tag, cs, cl, sp, send, qs, ql, qpos, qend, os, ol, vs, vl, vtag;
                pos = start;
                end = start + len;
                while (pos < end)
                {
                    if (!asn1_hdr(d, end, pos, @tag, @cs, @cl)) { return; };
                    sp = cs;
                    send = cs + cl;
                    pos = cs + cl;
                    while (sp < send)
                    {
                        if (!asn1_hdr(d, send, sp, @tag, @qs, @ql)) { return; };
                        sp = qs + ql;
                        qpos = qs;
                        qend = qs + ql;
                        if (!asn1_hdr(d, qend, qpos, @tag, @os, @ol)) { return; };
                        qpos = os + ol;
                        if (!asn1_hdr(d, qend, qpos, @vtag, @vs, @vl)) { return; };
                        if (x509_oid_is(d, os, ol, @X509_OID_CN[0], 3))
                        {
                            c.cn = d + vs;
                            c.cn_len = vl;
                        };
                    };
                };
            };

            def x509_parse(X509_CERT* c, byte* der, int der_len) -> bool
            {
                int tag, cs, cl, pos, tend, certend, ts, tl, ot, os, ol, bits;
                int spos, send, kt, ks, kl, ao, al, kp, pos2, t2, cs2, cl2;
                int tbs_start;

                c.der = der;
                c.der_len = der_len;
                c.sig_alg = 0;
                c.key_type = 0;
                c.san = (byte*)0;
                c.san_len = 0;
                c.cn = (byte*)0;
                c.cn_len = 0;
                c.has_bc = false;
                c.is_ca = false;
                c.path_len = 0 - 1;
                c.has_ku = false;
                c.ku = 0;
                c.rsa_n = (byte*)0;
                c.rsa_e = (byte*)0;
                c.ec_point = (byte*)0;

                // Certificate ::= SEQUENCE { tbs, sigAlg, sigValue }
                if (!asn1_hdr(der, der_len, 0, @tag, @cs, @cl) | tag != 48) { return false; };
                certend = cs + cl;
                tbs_start = cs;
                if (!asn1_hdr(der, certend, cs, @tag, @ts, @tl) | tag != 48) { return false; };
                c.tbs = der + tbs_start;
                c.tbs_len = (ts + tl) - tbs_start;
                pos = ts + tl;

                // outer signatureAlgorithm
                if (!asn1_hdr(der, certend, pos, @tag, @os, @ol) | tag != 48) { return false; };
                if (asn1_hdr(der, os + ol, os, @ot, @ks, @kl))
                {
                    c.sig_alg = x509_sig_alg(der, ks, kl);
                };
                pos = os + ol;

                // signatureValue BIT STRING
                if (!asn1_hdr(der, certend, pos, @tag, @os, @ol) | tag != 3 | ol < 1) { return false; };
                c.sig = der + os + 1;
                c.sig_len = ol - 1;

                // ---- TBSCertificate ----
                pos = ts;
                tend = ts + tl;
                if (pos < tend)
                {
                    if (der[pos] == (byte)160)
                    {
                        if (!asn1_hdr(der, tend, pos, @tag, @cs, @cl)) { return false; };
                        pos = cs + cl;
                    };
                };
                // serial
                if (!asn1_hdr(der, tend, pos, @tag, @cs, @cl) | tag != 2) { return false; };
                pos = cs + cl;
                // inner signature algorithm
                if (!asn1_hdr(der, tend, pos, @tag, @cs, @cl) | tag != 48) { return false; };
                pos = cs + cl;
                // issuer
                if (!asn1_hdr(der, tend, pos, @tag, @cs, @cl) | tag != 48) { return false; };
                c.issuer = der + pos;
                c.issuer_len = (cs + cl) - pos;
                pos = cs + cl;
                // validity
                if (!asn1_hdr(der, tend, pos, @tag, @cs, @cl) | tag != 48) { return false; };
                pos2 = cs;
                if (!asn1_hdr(der, cs + cl, pos2, @t2, @cs2, @cl2)) { return false; };
                if (!x509_parse_time(der, cs2, cl2, t2, @c.not_before)) { return false; };
                pos2 = cs2 + cl2;
                if (!asn1_hdr(der, cs + cl, pos2, @t2, @cs2, @cl2)) { return false; };
                if (!x509_parse_time(der, cs2, cl2, t2, @c.not_after)) { return false; };
                pos = cs + cl;
                // subject
                if (!asn1_hdr(der, tend, pos, @tag, @cs, @cl) | tag != 48) { return false; };
                c.subject = der + pos;
                c.subject_len = (cs + cl) - pos;
                x509_find_cn(c, der, cs, cl);
                pos = cs + cl;
                // SubjectPublicKeyInfo
                if (!asn1_hdr(der, tend, pos, @tag, @cs, @cl) | tag != 48) { return false; };
                spos = cs;
                send = cs + cl;
                pos = cs + cl;
                if (!asn1_hdr(der, send, spos, @tag, @os, @ol) | tag != 48) { return false; };
                // algorithm OID
                if (!asn1_hdr(der, os + ol, os, @ot, @ao, @al) | ot != 6) { return false; };
                kp = ao + al;       // start of parameters
                spos = os + ol;
                // subjectPublicKey BIT STRING
                if (!asn1_hdr(der, send, spos, @tag, @ks, @kl) | tag != 3 | kl < 2) { return false; };
                if (x509_oid_is(der, ao, al, @X509_OID_RSA[0], 9))
                {
                    // RSAPublicKey ::= SEQUENCE { n INTEGER, e INTEGER }
                    if (!asn1_hdr(der, ks + kl, ks + 1, @tag, @cs, @cl) | tag != 48) { return false; };
                    pos2 = cs;
                    if (!asn1_hdr(der, cs + cl, pos2, @t2, @cs2, @cl2) | t2 != 2) { return false; };
                    c.rsa_n = der + cs2;
                    c.rsa_n_len = cl2;
                    pos2 = cs2 + cl2;
                    if (!asn1_hdr(der, cs + cl, pos2, @t2, @cs2, @cl2) | t2 != 2) { return false; };
                    c.rsa_e = der + cs2;
                    c.rsa_e_len = cl2;
                    c.key_type = 1;
                };
                if (x509_oid_is(der, ao, al, @X509_OID_EC_KEY[0], 7))
                {
                    if (!asn1_hdr(der, os + ol, kp, @tag, @cs, @cl) | tag != 6) { return false; };
                    if (x509_oid_is(der, cs, cl, @X509_OID_P256[0], 8) & kl == 66)
                    {
                        c.key_type = 2;
                    };
                    if (x509_oid_is(der, cs, cl, @X509_OID_P384[0], 5) & kl == 98)
                    {
                        c.key_type = 3;
                    };
                    c.ec_point = der + ks + 1;
                    c.ec_len = kl - 1;
                    if (c.key_type != 0 & der[ks + 1] != (byte)4) { c.key_type = 0; };
                };

                // optional [1] [2] [3]
                while (pos < tend)
                {
                    if (!asn1_hdr(der, tend, pos, @tag, @cs, @cl)) { return false; };
                    if (tag == 163)
                    {
                        // extensions: EXPLICIT SEQUENCE OF Extension
                        if (asn1_hdr(der, cs + cl, cs, @t2, @cs2, @cl2))
                        {
                            x509_parse_extensions(c, der, cs2, cl2);
                        };
                    };
                    pos = cs + cl;
                };
                return true;
            };

            // ---- PEM ----

            def x509_b64val(byte ch) -> int
            {
                if (ch >= (byte)65 & ch <= (byte)90) { return (int)ch - 65; };
                if (ch >= (byte)97 & ch <= (byte)122) { return (int)ch - 71; };
                if (ch >= (byte)48 & ch <= (byte)57) { return (int)ch + 4; };
                if (ch == (byte)43) { return 62; };
                if (ch == (byte)47) { return 63; };
                return 0 - 1;
            };

            // true when the zero terminated literal appears at buf[pos]
            def x509_match_at(byte* buf, int len, int pos, byte* lit) -> bool
            {
                int i = 0;
                while (lit[i] != (byte)0)
                {
                    if (pos + i >= len) { return false; };
                    if (buf[pos + i] != lit[i]) { return false; };
                    i++;
                };
                return true;
            };

            // Decodes every CERTIFICATE block of a PEM bundle. DER bytes are written back
            // to back into der_out and each certificate that parses is stored in certs.
            // Returns the number of certificates stored.
            def x509_load_pem_bundle(byte* pem, int pem_len, byte* der_out, int der_cap,
                                     X509_CERT* certs, int max) -> int
            {
                byte* begin_lit = "-----BEGIN CERTIFICATE-----\0";
                byte* end_lit = "-----END CERTIFICATE-----\0";
                int pos = 0, count = 0, used = 0, start, acc, nbits, v, outpos;
                byte ch;

                while (pos < pem_len & count < max)
                {
                    if (!x509_match_at(pem, pem_len, pos, begin_lit)) { pos++; continue; };
                    pos = pos + 27;
                    start = used;
                    acc = 0;
                    nbits = 0;
                    outpos = used;
                    while (pos < pem_len & !x509_match_at(pem, pem_len, pos, end_lit))
                    {
                        ch = pem[pos];
                        pos++;
                        v = x509_b64val(ch);
                        if (v < 0) { continue; };
                        acc = (acc << 6) `| v;
                        nbits = nbits + 6;
                        if (nbits >= 8)
                        {
                            nbits = nbits - 8;
                            if (outpos >= der_cap) { return count; };
                            der_out[outpos] = (byte)((acc >> nbits) `& 255);
                            outpos++;
                            acc = acc `& ((1 << nbits) - 1);
                        };
                    };
                    used = outpos;
                    if (x509_parse(@certs[count], der_out + start, used - start)) { count++; };
                };
                return count;
            };

            // ---- signature check ----

            def x509_check_sig(X509_CERT* c, X509_CERT* issuer) -> int
            {
                byte[64] digest;
                byte[48] r, s;
                int hash_id, hl, nb;
                bool ok;

                if (c.sig_alg == 0) { return 7; };
                hash_id = ((c.sig_alg - 1) % 3) + 1;
                hl = RSA::rsa_hash_len(hash_id);
                RSA::rsa_hash2(hash_id, c.tbs, c.tbs_len, (byte*)0, 0, @digest[0]);

                if (c.sig_alg <= 3)
                {
                    if (issuer.key_type != 1) { return 3; };
                    ok = RSA::rsa_pkcs1_verify(issuer.rsa_n, issuer.rsa_n_len,
                                               issuer.rsa_e, issuer.rsa_e_len,
                                               hash_id, @digest[0], c.sig, c.sig_len);
                    if (ok) { return 0; };
                    return 3;
                };

                if (issuer.key_type == 2)
                {
                    nb = 32;
                    if (!P384::ecdsa_der_decode_n(@r[0], @s[0], nb, c.sig, c.sig_len)) { return 3; };
                    ok = P384::ecdsa_p256n_verify(@r[0], @s[0], issuer.ec_point + 1,
                                                  issuer.ec_point + 33, @digest[0], hl);
                    if (ok) { return 0; };
                    return 3;
                };
                if (issuer.key_type == 3)
                {
                    nb = 48;
                    if (!P384::ecdsa_der_decode_n(@r[0], @s[0], nb, c.sig, c.sig_len)) { return 3; };
                    ok = P384::ecdsa_p384_verify(@r[0], @s[0], issuer.ec_point + 1,
                                                 issuer.ec_point + 49, @digest[0], hl);
                    if (ok) { return 0; };
                    return 3;
                };
                return 3;
            };

            // ---- names ----

            def x509_lower(byte ch) -> byte
            {
                if (ch >= (byte)65 & ch <= (byte)90) { return ch + (byte)32; };
                return ch;
            };

            // case insensitive pattern match with an optional leading "*." wildcard
            def x509_host_matches(byte* pat, int plen, byte* host, int hlen) -> bool
            {
                int i, dot, off;
                if (plen > 2 & pat[0] == (byte)42 & pat[1] == (byte)46)
                {
                    // wildcard covers exactly one non empty leftmost label
                    dot = 0;
                    while (dot < hlen & host[dot] != (byte)46) { dot++; };
                    if (dot == 0 | dot >= hlen) { return false; };
                    off = dot;
                    if (hlen - off != plen - 1) { return false; };
                    for (i = 0; i < plen - 1; i++)
                    {
                        if (x509_lower(pat[1 + i]) != x509_lower(host[off + i])) { return false; };
                    };
                    return true;
                };
                if (plen != hlen) { return false; };
                for (i = 0; i < plen; i++)
                {
                    if (x509_lower(pat[i]) != x509_lower(host[i])) { return false; };
                };
                return true;
            };

            def x509_match_host(X509_CERT* c, byte* host, int host_len) -> bool
            {
                int pos, tag, cs, cl;
                bool any_dns = false;
                if (c.san_len > 0)
                {
                    pos = 0;
                    while (pos < c.san_len)
                    {
                        if (!asn1_hdr(c.san, c.san_len, pos, @tag, @cs, @cl)) { break; };
                        pos = cs + cl;
                        if (tag == 130)
                        {
                            any_dns = true;
                            if (x509_host_matches(c.san + cs, cl, host, host_len)) { return true; };
                        };
                    };
                };
                if (any_dns) { return false; };
                if (c.cn_len > 0) { return x509_host_matches(c.cn, c.cn_len, host, host_len); };
                return false;
            };

            // ---- chain ----

            def x509_bytes_eq(byte* a, int alen, byte* b, int blen) -> bool
            {
                int i;
                if (alen != blen) { return false; };
                for (i = 0; i < alen; i++) { if (a[i] != b[i]) { return false; }; };
                return true;
            };

            def x509_valid_at(X509_CERT* c, i64 now) -> bool
            {
                return now >= c.not_before & now <= c.not_after;
            };

            // may this certificate sign others? returns 0 or an error code
            def x509_ca_ok(X509_CERT* c) -> int
            {
                if (!c.has_bc | !c.is_ca) { return 4; };
                if (c.has_ku)
                {
                    if ((c.ku `& 4) == 0) { return 9; };
                };
                return 0;
            };

            // chain[0] is the leaf, chain[n-1] the last intermediate or the root itself.
            // host may be null to skip the hostname check.
            def x509_verify_chain(X509_CERT* chain, int n, X509_CERT* roots, int nroots,
                                  i64 now, byte* host, int host_len) -> int
            {
                int i, j, rc, anchored;
                X509_CERT* last;

                if (n < 1) { return 5; };
                if (host != (byte*)0)
                {
                    if (!x509_match_host(@chain[0], host, host_len)) { return 6; };
                };
                // Walk up the chain. The first certificate that a trusted root vouches for (it is
                // a trusted root itself, or a trusted root with its issuer name signed it) anchors
                // the chain, and the certificates the server sent beyond it are ignored.
                for (i = 0; i < n; i++)
                {
                    if (!x509_valid_at(@chain[i], now)) { return 2; };
                    last = @chain[i];
                    for (j = 0; j < nroots; j++)
                    {
                        if (x509_bytes_eq(last.der, last.der_len, roots[j].der, roots[j].der_len))
                        {
                            if (x509_valid_at(@roots[j], now)) { return 0; };
                            break;
                        };
                    };
                    for (j = 0; j < nroots; j++)
                    {
                        if (!x509_bytes_eq(last.issuer, last.issuer_len,
                                           roots[j].subject, roots[j].subject_len)) { continue; };
                        if (!x509_valid_at(@roots[j], now)) { continue; };
                        if (x509_ca_ok(@roots[j]) != 0) { continue; };
                        if (x509_check_sig(last, @roots[j]) == 0) { return 0; };
                    };
                    if (i + 1 >= n) { return 5; };
                    if (!x509_bytes_eq(chain[i].issuer, chain[i].issuer_len,
                                       chain[i + 1].subject, chain[i + 1].subject_len)) { return 5; };
                    rc = x509_ca_ok(@chain[i + 1]);
                    if (rc != 0) { return rc; };
                    if (chain[i + 1].path_len >= 0)
                    {
                        if (i > chain[i + 1].path_len) { return 8; };
                    };
                    rc = x509_check_sig(@chain[i], @chain[i + 1]);
                    if (rc != 0) { return rc; };
                };
                return 5;
            };

        }; // X509

        namespace CSPRNG
        {
            // =========================================================================
            // Operating system cryptographic random bytes
            //   Linux:   getrandom(2)
            //   Windows: BCryptGenRandom with the system preferred RNG
            //
            //   random_bytes(byte* out, int n) -> bool
            // =========================================================================

#ifdef __LINUX__
            extern
            {
                def !! getrandom(void*, u64, u32) -> i64;
            };

            def random_bytes(byte* out, int n) -> bool
            {
                int done = 0;
                i64 r;
                while (done < n)
                {
                    r = getrandom((void*)(out + done), (u64)(n - done), 0u);
                    if (r <= (i64)0) { return false; };
                    done = done + (int)r;
                };
                return true;
            };
#endif;

#ifdef __WINDOWS__
            extern
            {
                def !! BCryptGenRandom(void*, void*, u32, u32) -> i32;
            };

            def random_bytes(byte* out, int n) -> bool
            {
                // BCRYPT_USE_SYSTEM_PREFERRED_RNG = 2
                return BCryptGenRandom((void*)0, (void*)out, (u32)n, 2u) == 0;
            };
#endif;

        }; // CSPRNG
    };
};


#endif;