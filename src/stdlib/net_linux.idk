// Author: Karac V. Thweatt

// Networking Library - Linux sockets
// Platform half of the socket library: implements the primitives that the
// neutral builtins/socket_object_raw.idk is written against, and keeps the
// Linux only extras (Unix domain sockets, fd passing, epoll) in standard::net.
// Socket externs come from linux.idk.

#ifndef IDEKA_STANDARD
#def IDEKA_STANDARD 1;
#endif;

#ifndef IDEKA_STANDARD_NET_LINUX
#def IDEKA_STANDARD_NET_LINUX 1;

#ifndef IDEKA_STANDARD_TYPES
#import "types.idk";
#endif;

#ifndef IDEKA_STANDARD_MEMORY
#import "memory.idk";
#endif;

#ifndef __LINUX_INTERFACE__
#import "linux.idk";
#endif;

// ============================================================================
// ADDITIONAL EXTERNS NOT IN LINUX.IDK
// ============================================================================

#ifdef __LINUX__
extern
{
    def !!
        htons(u16)      -> u16,
        htonl(u32)      -> u32,
        ntohs(u16)      -> u16,
        ntohl(u32)      -> u32,
        inet_addr(byte*) -> u32,
        inet_ntoa(u32)  -> byte*,
        getaddrinfo(byte*, byte*, void*, void**) -> int,
        freeaddrinfo(void*)                      -> void,
        getnameinfo(void*, u32, byte*, u32, byte*, u32, int) -> int,
        gethostname(byte*, size_t)               -> int,
        select(int, void*, void*, void*, void*)  -> int,
        sendto(int, void*, size_t, int, void*, u32)  -> i64,
        recvfrom(int, void*, size_t, int, void*, u32*) -> i64,
        dlsym(void*, byte*)                      -> void*;
};
#endif;

// errno lives behind __errno_location(). The compiler does not resolve calls to
// names that start with two underscores, so it is looked up with dlsym and
// called through a function pointer.
def{}* errno_location_fp() -> int*;

// ============================================================================
// STRUCTURES
// ============================================================================

// addrinfo for getaddrinfo
struct addrinfo
{
    int    ai_flags,
           ai_family,
           ai_socktype,
           ai_protocol;
    u32    ai_addrlen;
    byte*  ai_canonname;
    void*  ai_addr,
           ai_next;
};

// fd_set for select() - 1024 fds, 128 bytes
struct fd_set_t
{
    byte[128] fds_bits;
};

// Neutral half. Imported after the externs above so they precede the socket object.
#ifndef IDEKA_STANDARD_SOCKETS
#import <socket_object_raw.idk>;
#endif;

// ============================================================================
// NAMESPACES
// ============================================================================

namespace standard
{
    namespace sockets
    {
        // ====================================================================
        // CONSTANTS (Linux values)
        // ====================================================================

        global const int AF_UNIX    = 1,
                         AF_INET6   = 10,
                         SOCK_NONBLOCK  = 0x800,
                         SOCK_CLOEXEC   = 0x80000,

        // Socket options
                         SO_REUSEADDR = 2,
                         SO_KEEPALIVE = 9,
                         SO_BROADCAST = 6,
                         SO_RCVBUF    = 8,
                         SO_SNDBUF    = 7,
                         SO_RCVTIMEO  = 20,
                         SO_SNDTIMEO  = 21,
                         SO_ERROR     = 4,
                         SO_TYPE      = 3,

        // SOL_SOCKET level
                         SOL_SOCKET = 1,

        // Shutdown modes
                         SHUT_RD   = 0,
                         SHUT_WR   = 1,
                         SHUT_RDWR = 2,

        // fcntl flags for non-blocking
                         O_NONBLOCK = 0x800,

        // CMsghdr levels/types for SCM_RIGHTS
                         SCM_RIGHTS = 1;

        // ====================================================================
        // INITIALIZATION (nothing to start up on Linux)
        // ====================================================================

        def init() -> int
        {
            return 0;
        };

        def cleanup() -> int
        {
            return 0;
        };

        // errno of the calling thread
        def get_last_error() -> int
        {
            errno_location_fp = dlsym((void*)0, "__errno_location\0");   // RTLD_DEFAULT
            int* e = errno_location_fp();
            return e[0];
        };

        // ====================================================================
        // PRIMITIVES
        // ====================================================================

        def tcp_socket() -> int
        {
            return socket(AF_INET, SOCK_STREAM, IPPROTO_TCP);
        };

        def udp_socket() -> int
        {
            return socket(AF_INET, SOCK_DGRAM, IPPROTO_UDP);
        };

        def sock_close(int fd) -> int
        {
            return close(fd);
        };

        def sock_shutdown(int fd) -> int
        {
            return shutdown(fd, SHUT_RDWR);
        };

        def sock_bind(int fd, sockaddr_in* addr) -> int
        {
            return bind(fd, (void*)addr, (u32)(sizeof(sockaddr_in) / 8));
        };

        def sock_listen(int fd, int backlog) -> int
        {
            return listen(fd, backlog);
        };

        def sock_accept(int fd, sockaddr_in* addr) -> int
        {
            u32 addr_len = (u32)(sizeof(sockaddr_in) / 8);
            return accept(fd, (void*)addr, @addr_len);
        };

        def sock_connect(int fd, sockaddr_in* addr) -> int
        {
            return connect(fd, (void*)addr, (u32)(sizeof(sockaddr_in) / 8));
        };

        def sock_send(int fd, byte* buf, int len) -> int
        {
            return (int)send(fd, (void*)buf, (size_t)len, 0);
        };

        def sock_recv(int fd, byte* buf, int len) -> int
        {
            return (int)recv(fd, (void*)buf, (size_t)len, 0);
        };

        def sock_sendto(int fd, byte* buf, int len, sockaddr_in* addr) -> int
        {
            return (int)sendto(fd, (void*)buf, (size_t)len, 0, (void*)addr, (u32)(sizeof(sockaddr_in) / 8));
        };

        def sock_recvfrom(int fd, byte* buf, int len, sockaddr_in* addr) -> int
        {
            u32 addr_len = (u32)(sizeof(sockaddr_in) / 8);
            return (int)recvfrom(fd, (void*)buf, (size_t)len, 0, (void*)addr, @addr_len);
        };

        // Set socket non-blocking via fcntl
        def set_nonblocking(int fd) -> int
        {
            int flags = fcntl(fd, 3, 0);   // F_GETFL
            if (flags < 0)
            {
                return -1;
            };
            return fcntl(fd, 4, flags | O_NONBLOCK);   // F_SETFL
        };

        // Set socket blocking
        def set_blocking(int fd) -> int
        {
            int flags = fcntl(fd, 3, 0);   // F_GETFL
            if (flags < 0)
            {
                return -1;
            };
            return fcntl(fd, 4, flags & `!O_NONBLOCK);  // F_SETFL
        };

        // Enable SO_REUSEADDR
        def set_reuseaddr(int fd, bool enable) -> int
        {
            int val = 0;
            if (enable) { val = 1; };
            return setsockopt(fd, SOL_SOCKET, SO_REUSEADDR, (void*)@val, (u32)4);
        };

        // Set receive timeout, milliseconds (converted to a timeval)
        def set_recv_timeout(int fd, int milliseconds) -> int
        {
            standard::system::linux::timeval tv;
            tv.tv_sec  = milliseconds / 1000;
            tv.tv_usec = (milliseconds % 1000) * 1000;
            return setsockopt(fd, SOL_SOCKET, SO_RCVTIMEO, (void*)@tv, (u32)(sizeof(standard::system::linux::timeval) / 8));
        };

        // Set send timeout, milliseconds (converted to a timeval)
        def set_send_timeout(int fd, int milliseconds) -> int
        {
            standard::system::linux::timeval tv;
            tv.tv_sec  = milliseconds / 1000;
            tv.tv_usec = (milliseconds % 1000) * 1000;
            return setsockopt(fd, SOL_SOCKET, SO_SNDTIMEO, (void*)@tv, (u32)(sizeof(standard::system::linux::timeval) / 8));
        };

        // Convert port to/from network byte order
        def port_hton(u16 p) -> u16 { return htons(p); };
        def port_ntoh(u16 p) -> u16 { return ntohs(p); };

        def ip_from_string(byte* ip_str) -> u32
        {
            return inet_addr(ip_str);
        };

        def ip_to_string(u32 ip) -> byte*
        {
            return inet_ntoa(ip);
        };
    };
};

using standard::sockets;

namespace standard
{
    namespace net
    {
        // ====================================================================
        // UNIX DOMAIN SOCKETS
        // ====================================================================

        // Connect to a Unix domain socket by path
        def unix_connect(byte* path) -> int
        {
            standard::system::linux::sockaddr_un addr;
            memset((void*)@addr, 0, (size_t)(sizeof(standard::system::linux::sockaddr_un) / 8));
            addr.family = (u16)AF_UNIX;

            int path_len = standard::strings::strlen(path);
            memcpy((void*)@addr.path, (void*)path, (size_t)path_len);

            int fd = socket(AF_UNIX, SOCK_STREAM, 0);
            if (fd < 0) { return -1; };

            if (connect(fd, (void*)@addr, (u32)(2 + path_len + 1)) < 0)
            {
                close(fd);
                return -1;
            };

            return fd;
        };

        // Create and bind a Unix domain socket server
        def unix_server_create(byte* path, int backlog) -> int
        {
            unlink(path);   // Remove stale socket file

            standard::system::linux::sockaddr_un addr;
            memset((void*)@addr, 0, (size_t)(sizeof(standard::system::linux::sockaddr_un) / 8));
            addr.family = (u16)AF_UNIX;

            int path_len = standard::strings::strlen(path);
            memcpy((void*)@addr.path, (void*)path, (size_t)path_len);

            int fd = socket(AF_UNIX, SOCK_STREAM, 0);
            if (fd < 0) { return -1; };

            if (bind(fd, (void*)@addr, (u32)(sizeof(standard::system::linux::sockaddr_un) / 8)) < 0)
            {
                close(fd);
                return -1;
            };

            if (listen(fd, backlog) < 0)
            {
                close(fd);
                return -1;
            };

            return fd;
        };

        // ====================================================================
        // SCM_RIGHTS - pass file descriptors over Unix sockets
        // ====================================================================

        // Send a file descriptor over a Unix socket
        def send_fd(int sock, int fd_to_send) -> bool
        {
            return standard::system::linux::send_fd(sock, fd_to_send);
        };

        // ====================================================================
        // EPOLL
        // ====================================================================

        def epoll_create() -> int
        {
            return epoll_create1(0);
        };

        def epoll_add(int epfd, int fd, u32 events) -> int
        {
            standard::system::linux::epoll_event ev;
            ev.events   = events;
            ev.evt_data = (u64)fd;
            return epoll_ctl(epfd, (int)standard::system::linux::EpollOp.EPOLL_CTL_ADD, fd, (void*)@ev);
        };

        def epoll_del(int epfd, int fd) -> int
        {
            standard::system::linux::epoll_event ev;
            ev.events   = (u32)0;
            ev.evt_data = (u64)0;
            return epoll_ctl(epfd, (int)standard::system::linux::EpollOp.EPOLL_CTL_DEL, fd, (void*)@ev);
        };

        // Wait for events, returns number of ready fds
        def epoll_wait_events(int epfd, standard::system::linux::epoll_event* events, int max_events, int timeout_ms) -> int
        {
            return epoll_wait(epfd, (void*)events, max_events, timeout_ms);
        };
    };
};

using standard::net;

#endif;
