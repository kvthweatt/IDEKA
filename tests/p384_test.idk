// P-384 ECDSA test against vectors from tests/p384_gen.py
#import <standard.idk>, <cryptography.idk>;

using standard::io::console,
      standard::crypto::P384;

def hexval(byte c) -> int
{
    if (c >= (byte)97) { return (int)c - 87; };
    return (int)c - 48;
};

def unhex(byte* s, byte* out) -> int
{
    int n = 0;
    while (s[n * 2] != (byte)0) { out[n] = (byte)(hexval(s[n * 2]) * 16 + hexval(s[n * 2 + 1])); n++; };
    return n;
};

def hexd(byte* h, int n) -> void
{
    int i, hi, lo;
    for (i = 0; i < n; i++)
    {
        hi = (int)((h[i] >> 4) `& (byte)15);
        lo = (int)(h[i] `& (byte)15);
        if (hi < 10) { print(hi); } else { print((byte)(hi - 10 + 97)); };
        if (lo < 10) { print(lo); } else { print((byte)(lo - 10 + 97)); };
    };
};

global int fails = 0;

def check(byte* name, bool ok) -> void
{
    if (ok) { print(name); print(" ok\n\0"); } else { print(name); print(" FAIL\n\0"); fails++; };
};

def vec0() -> void
{
    byte[49] b_d;
    byte* s_d = "43a2814dd6226456c8d2b21ba8716446b8a401c5202a6e9b2a59eb9c833969e09e2294f5115546d6baef79aa91af8c90\0";
    int l_d = unhex(s_d, @b_d[0]);
    byte[49] b_qx;
    byte* s_qx = "cefe037eb1d1b0e9687dc12c8877c2eafb11fc1d0bf0140c216a917814a775ae94eec3afeed0e0a6ce904707ea44cdb0\0";
    int l_qx = unhex(s_qx, @b_qx[0]);
    byte[49] b_qy;
    byte* s_qy = "689b9091390c9f9b9adf119673f21a9ddb49027263318269451ac4ea0f803eb4fcbfc79e43821ba0a5af192eb53b9d65\0";
    int l_qy = unhex(s_qy, @b_qy[0]);
    byte[49] b_dig;
    byte* s_dig = "57499807bcfc62cce9141021e11943458508111509bd478cd63922f4068fce8106e90ca810cb89188248633d9618a24c\0";
    int l_dig = unhex(s_dig, @b_dig[0]);
    byte[49] b_r;
    byte* s_r = "4b1d2db8dd56a0255fb6c4cb5b4ebd89723c0664892cba8a3c457c4e35748cbc5f126c4514ebec84d13cadadc226667f\0";
    int l_r = unhex(s_r, @b_r[0]);
    byte[49] b_s;
    byte* s_s = "4efe31ed4694c2661740ca84b5461c3c4b0b0e051dd59941e7c8cb3974bfc19e0264db3d266f43712a3fc8a3e7e90def\0";
    int l_s = unhex(s_s, @b_s[0]);
    byte[103] b_der;
    byte* s_der = "306402304b1d2db8dd56a0255fb6c4cb5b4ebd89723c0664892cba8a3c457c4e35748cbc5f126c4514ebec84d13cadadc226667f02304efe31ed4694c2661740ca84b5461c3c4b0b0e051dd59941e7c8cb3974bfc19e0264db3d266f43712a3fc8a3e7e90def\0";
    int l_der = unhex(s_der, @b_der[0]);
    byte[48] px, py, r2, s2, nonce, dr, ds;
    byte[120] der2;
    int dl, j;
    bool same;
    for (j = 0; j < 48; j++) { nonce[j] = (byte)(j * 5 + 9); };
    print("vector 0\n\0");
    check("pubkey\0", P384::ecdsa_p384_pubkey(@px[0], @py[0], @b_d[0]));
    same = true;
    for (j = 0; j < 48; j++) { if (px[j] != b_qx[j] | py[j] != b_qy[j]) { same = false; }; };
    check("pubkey matches\0", same);
    check("verify python sig\0", P384::ecdsa_p384_verify(@b_r[0], @b_s[0], @b_qx[0], @b_qy[0], @b_dig[0], l_dig));
    check("der decode\0", P384::ecdsa_der_decode_n(@dr[0], @ds[0], 48, @b_der[0], l_der));
    same = true;
    for (j = 0; j < 48; j++) { if (dr[j] != b_r[j] | ds[j] != b_s[j]) { same = false; }; };
    check("der decode matches\0", same);
    P384::ecdsa_der_encode_n(@der2[0], @dl, @dr[0], @ds[0], 48);
    same = dl == l_der;
    for (j = 0; j < dl; j++) { if (der2[j] != b_der[j]) { same = false; }; };
    check("der roundtrip\0", same);
    b_s[10] = b_s[10] ^| (byte)4;
    check("tamper rejected\0", !P384::ecdsa_p384_verify(@b_r[0], @b_s[0], @b_qx[0], @b_qy[0], @b_dig[0], l_dig));
    check("own sign\0", P384::ecdsa_p384_sign(@r2[0], @s2[0], @b_d[0], @b_dig[0], l_dig, @nonce[0]));
    check("own verify\0", P384::ecdsa_p384_verify(@r2[0], @s2[0], @b_qx[0], @b_qy[0], @b_dig[0], l_dig));
    print("SIG \0"); hexd(@b_qx[0], 48); print(" \0"); hexd(@b_qy[0], 48); print(" \0"); hexd(@b_dig[0], l_dig); print(" \0"); hexd(@r2[0], 48); print(" \0"); hexd(@s2[0], 48); print("\n\0");
};

