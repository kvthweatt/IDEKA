// PBKDF2 and scrypt test against Python hashlib (generated by tests/kdf_gen.py)
#import <standard.idk>, <cryptography.idk>;

using standard::io::console,
      standard::crypto::KDF;

def hexval(byte c) -> int
{
    if (c >= (byte)97) { return (int)c - 87; };
    return (int)c - 48;
};

def unhex(byte* s, byte* out) -> int
{
    int n = 0;
    while (s[n * 2] != (byte)0) { out[n] = (byte)(hexval(s[n * 2]) * 16 + hexval(s[n * 2 + 1])); n++; };
    return n;
};

def same(byte* a, byte* b, int n) -> bool
{
    int i;
    for (i = 0; i < n; i++) { if (a[i] != b[i]) { return false; }; };
    return true;
};

global int fails = 0;
global byte[20000000] g_work;

def check(byte* name, bool ok) -> void
{
    if (ok) { print(name); print(" ok\n\0"); } else { print(name); print(" FAIL\n\0"); fails++; };
    flush();
};

def pbkdf2_case(byte* name, bool wide, byte* s_pw, byte* s_salt, int iters, int dklen, byte* s_dk) -> void
{
    byte[128] pw;
    byte[300] salt;
    byte[200] dk, ex;
    int pl, sl;
    bool ok;
    pl = unhex(s_pw, pw);
    sl = unhex(s_salt, salt);
    unhex(s_dk, ex);
    if (wide) { ok = PBKDF2::pbkdf2_sha512(pw, pl, salt, sl, iters, dk, dklen); }
    else { ok = PBKDF2::pbkdf2_sha256(pw, pl, salt, sl, iters, dk, dklen); };
    check(name, ok & same(dk, ex, dklen));
};

def scrypt_case(byte* name, byte* s_pw, byte* s_salt, int N, int r, int p, int dklen, byte* s_dk) -> void
{
    byte[128] pw;
    byte[300] salt;
    byte[200] dk, ex;
    int pl, sl;
    bool ok;
    pl = unhex(s_pw, pw);
    sl = unhex(s_salt, salt);
    unhex(s_dk, ex);
    ok = Scrypt::scrypt(pw, pl, salt, sl, (u64)N, r, p, g_work, dk, dklen);
    check(name, ok & same(dk, ex, dklen));
};

def main() -> int
{
    pbkdf2_case("pbkdf2 sha256 iters 1 dk 20 pw 8\0", false, "70617373776f7264\0", "73616c74\0", 1, 20, "120fb6cffcf8b32c43e7225256c4f837a86548c9\0");
    pbkdf2_case("pbkdf2 sha256 iters 2 dk 32 pw 8\0", false, "70617373776f7264\0", "73616c74\0", 2, 32, "ae4d0c95af6b46d32d0adff928f06dd02a303f8ef3c251dfd6e2d85a95474c43\0");
    pbkdf2_case("pbkdf2 sha256 iters 4096 dk 32 pw 8\0", false, "70617373776f7264\0", "73616c74\0", 4096, 32, "c5e478d59288c841aa530db6845c4c8d962893a001ce4e11a4963873aa98134a\0");
    pbkdf2_case("pbkdf2 sha256 iters 4096 dk 40 pw 24\0", false, "70617373776f726450415353574f524470617373776f7264\0", "73616c7453414c5473616c7453414c5473616c7453414c5473616c7453414c5473616c74\0", 4096, 40, "348c89dbcbd32b2f32d814b8116e84cf2b17347ebc1800181c4e2a1fb8dd53e1c635518c7dac47e9\0");
    pbkdf2_case("pbkdf2 sha256 iters 1000 dk 100 pw 100\0", false, "e667503b716572c59e9ebd965f5f827f7df490e659c54030296d412284bba5dd27bfb3cbc5fe9aab793904bb949406e56b9a18e1e043008c66286c45f10a7c5f794e68eb25e051c15ca6a723748e9b8a937eabeadcc967d0f88f5c070c55ae727ca98687\0", "dbf5a1024dd8ffa282398838e56b1073\0", 1000, 100, "95a6effa0666bc28dccdf2ad0218f01cb1fa7364c7c74994f9b4976fc0e3cfbf763995a2caddac82181e78d9584090e496bfca95545f758353c2b39b972d56ae56e33dd227d7595ed2352aa2b28e64f625ad6201236543ae4f22a753307aeb275baf074b\0");
    pbkdf2_case("pbkdf2 sha256 iters 3 dk 64 pw 0\0", false, "\0", "73616c74\0", 3, 64, "5ddf839afa2d5fb4be56e1a0f48917617559bef61ec122bfca1c7f75ac8f401d060b470b704034975a53c7c7eb727409dd53a038c71e2271bcf1b0cc3427533c\0");
    pbkdf2_case("pbkdf2 sha256 iters 10 dk 129 pw 130\0", false, "c83ff600dadd06840bb20f797fcc2420faf153518f912daf4bde91d7a97a622d86cf63f1f0cae75ce4f8d315a4711a56190dc8e6c98ca404f82284602167d5ab52d79d08e3df587b4638312b59d3026f082b9d898e4501561a132c9a1d9adb91a30d2703b6588bfd99a576098a3c1a7e9225eee0b71a3f2b88ec3770140971a0b064\0", "\0", 10, 129, "61a5ee9939b8173abae0779481abefe2c9263015de22b3b82feab143e43837e4c562d17ff26dc1f89c844b93edb66a042482fe4da9187f131d3d1c383d616de263e8dae684e00a302e1ab233554436f92ba4cde2259e920285bafcedab8a49c10d4b13a005782566df7a75581fe443bf8b9eb4201281c1d4fd208c54f8607b8f1f\0");
    pbkdf2_case("pbkdf2 sha512 iters 1 dk 20 pw 8\0", true, "70617373776f7264\0", "73616c74\0", 1, 20, "867f70cf1ade02cff3752599a3a53dc4af34c7a6\0");
    pbkdf2_case("pbkdf2 sha512 iters 2 dk 32 pw 8\0", true, "70617373776f7264\0", "73616c74\0", 2, 32, "e1d9c16aa681708a45f5c7c4e215ceb66e011a2e9f0040713f18aefdb866d53c\0");
    pbkdf2_case("pbkdf2 sha512 iters 4096 dk 32 pw 8\0", true, "70617373776f7264\0", "73616c74\0", 4096, 32, "d197b1b33db0143e018b12f3d1d1479e6cdebdcc97c5c0f87f6902e072f457b5\0");
    pbkdf2_case("pbkdf2 sha512 iters 4096 dk 40 pw 24\0", true, "70617373776f726450415353574f524470617373776f7264\0", "73616c7453414c5473616c7453414c5473616c7453414c5473616c7453414c5473616c74\0", 4096, 40, "8c0511f4c6e597c6ac6315d8f0362e225f3c501495ba23b868c005174dc4ee71115b59f9e60cd953\0");
    pbkdf2_case("pbkdf2 sha512 iters 1000 dk 100 pw 100\0", true, "87f89510770a5a95cd25c3cf8f232c1d5771650d0ea43317e803a2076a522123f9e0efa5ba9200f3dd86d92f41668da2acce3a7450b2a0ab5d863d9d65a899436d7acc19cddd7f90528aa931a00cdbea3ebb1c87f3c7e2a1b47281a76bf6d8428e2c59d2\0", "8d096762f9c3bd47d0367dd62ee76a37\0", 1000, 100, "0ba3082aa955315149ed54c958b81606cb1f85161ec13eb599cc1d72b29d4a151d4bf92e5d21cd93d3472acdef7a6f25c926a55458d58397c59d8c778a4148a7700d3622c0eb1ad58034eb7e1f8c98e5e0bc956b49923b2bde4b9efacc3d624ea2cf369d\0");
    pbkdf2_case("pbkdf2 sha512 iters 3 dk 64 pw 0\0", true, "\0", "73616c74\0", 3, 64, "35728858479af699c1690e989eba0d104c6c9d7ff67373a48e4f87e90cb55af771ac93458ee4ba4ac24f1e927bc4aba5bfed6aa82a752ad40403fbfd9575a46c\0");
    pbkdf2_case("pbkdf2 sha512 iters 10 dk 129 pw 130\0", true, "af1f1b7aafe14e28394897fc26adef0b944d06873cf47af72506aa3063391e0ea26d2c2e158d241f3aa5f46229d0f0c15b8ca6e69839e2b5369dd54d05b832dc05ff62ad43bcd5f3497dedc9e70920e48dcf2d88dac40ecdd968011078900331be4bee24140c8039b62c403b0889df5f29cc75f7d6eaa613e6e319702e95dd3733b1\0", "\0", 10, 129, "11947070ef66d0ae5ce5b0b1a44f52f55db3c0c4ca5343ec4a35066f0087aa1126ee821d8b5efd1ba374dc8f87f55aed60c6313eddec82fb5b6bd97713cbdc1032a4d097e72e2bb0da377c43f9ae90f8f28d7adf8aa7bb47b6e7fe0b0c917c793969e1116739331d2734cc65fa930f58a802203423f15d717c50f1f3a89af70abf\0");
    scrypt_case("scrypt N 16 r 1 p 1\0", "\0", "\0", 16, 1, 1, 64, "77d6576238657b203b19ca42c18a0497f16b4844e3074ae8dfdffa3fede21442fcd0069ded0948f8326a753a0fc81f17e8d3e0fb2e0d3628cf35e20c38d18906\0");
    scrypt_case("scrypt N 1024 r 8 p 16\0", "70617373776f7264\0", "4e61436c\0", 1024, 8, 16, 64, "fdbabe1c9d3472007856e7190d01e9fe7c6ad7cbc8237830e77376634b3731622eaf30d92e22a3886ff109279d9830dac727afb94a83ee6d8360cbdfa2cc0640\0");
    scrypt_case("scrypt N 16384 r 8 p 1\0", "706c656173656c65746d65696e\0", "536f6469756d43686c6f72696465\0", 16384, 8, 1, 64, "7023bdcb3afd7348461c06cd81fd38ebfda8fbba904f8e3ea9b543f6545da1f2d5432955613f0fcf62d49705242a9af9e61e85dc0d651e40dfcf017b45575887\0");
    scrypt_case("scrypt N 64 r 2 p 3\0", "616263\0", "ff9d43a448e7742ac1ca50418deffcce\0", 64, 2, 3, 40, "ba4bda988b8724b12260443726fb6efc0c93d8bd694657d7d295751b9ba511686dd059eff64f9ca0\0");
    scrypt_case("scrypt N 256 r 4 p 2\0", "d05d0c0958ffaf1989cda01c2fae2313a5962418\0", "865ec1889146f4918fde8b55fe6aa54a21dfed8049144813eaf740f8bf202b96\0", 256, 4, 2, 100, "a3c0ae6258e90f08b5c9bf10e06fea0b450e26c0d63add4d8ba73b745eba8877cffb5d90d13481d7fbbc8218df3ae441f1c5272fbd27ac2eda84c3d031845e57b8a29274098a49c889b00ed6a71927e873773204db5e94da07da25b128bb0365a1454d5f\0");
    if (fails == 0) { print("ALL PASS\n\0"); } else { print("FAILS\n\0"); };
    flush();
    return fails;
};
