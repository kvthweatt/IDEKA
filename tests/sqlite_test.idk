// Dumps three SQLite fixture databases (made by tests/sqlite_gen.py) with sqlite.idk; output must equal tests/sqlite_fx.exp.
#import <standard.idk>, <sqlite.idk>;

using standard::io::console,
      standard::sqlite;

global SQLITE_DB g_db;

def put_hex(int v) -> void
{
    byte[17] hx = "0123456789abcdef\0";
    print(hx[(v >> 4) & 15]);
    print(hx[v & 15]);
};

def dump_row(SQ_CURSOR* cur) -> void
{
    int j, t, n, k;
    byte* p;
    double d;
    i64 r;
    print(cur.rowid);
    for (j = 0; j < sq_col_count(cur); j++)
    {
        print("|\0");
        t = sq_col_type(cur, j);
        if (t == SQ_NULL) { print("N\0"); };
        if (t == SQ_INTEGER) { print("i\0"); print(sq_col_int(cur, j)); };
        if (t == SQ_REAL)
        {
            d = sq_col_real(cur, j);
            if (d >= 0.0) { r = (i64)(d * 1000.0 + 0.5); } else { r = (i64)(d * 1000.0 - 0.5); };
            print("r\0");
            print(r);
        };
        if (t == SQ_TEXT)
        {
            n = sq_col_bytes(cur, j);
            p = sq_col_ptr(cur, j);
            print("t\0"); print(n); print(":\0");
            if (n <= 64) { for (k = 0; k < n; k++) { print(p[k]); }; }
            else
            {
                for (k = 0; k < 32; k++) { print(p[k]); };
                print("...\0");
                for (k = n - 32; k < n; k++) { print(p[k]); };
            };
        };
        if (t == SQ_BLOB)
        {
            n = sq_col_bytes(cur, j);
            p = sq_col_ptr(cur, j);
            print("b\0"); print(n); print(":\0");
            for (k = 0; k < n & k < 8; k++) { put_hex((int)p[k]); };
        };
    };
    print("\n\0");
};

def main() -> int
{
    byte*[3] paths;
    int d, i, rc;
    SQ_CURSOR cur;
    paths[0] = "tests/sqlite_fx_0.db\0";
    paths[1] = "tests/sqlite_fx_1.db\0";
    paths[2] = "tests/sqlite_fx_2.db\0";
    for (d = 0; d < 3; d++)
    {
        rc = sq_open(@g_db, paths[d]);
        if (rc != 0) { print("open failed \0"); print(rc); print("\n\0"); return 1; };
        if (sq_schema_load(@g_db) < 0) { print("schema failed\n\0"); return 1; };
        print("DB \0"); print(d); print("\n\0");
        for (i = 0; i < g_db.nschema; i++)
        {
            if (g_db.schema[i].kind == 1)
            {
                print("T \0"); print(@g_db.schema[i].name[0]); print(" \0"); print(g_db.schema[i].rootpage); print("\n\0");
                sq_cur_open(@cur, @g_db, g_db.schema[i].rootpage);
                rc = sq_cur_first(@cur);
                while (rc == 1)
                {
                    dump_row(@cur);
                    rc = sq_cur_next(@cur);
                };
                if (rc < 0) { print("cursor error\n\0"); return 1; };
                sq_cur_close(@cur);
            };
        };
        sq_close(@g_db);
    };
    return 0;
};
