// HTTP and WebSocket client test over native TLS 1.3 against tests/web_server.py (port 4443).
// Run: python3 tests/web_server.py   then this test, both from the repository root.
#import <standard.idk>, <socket_object_raw.idk>, <ffifio.idk>, <datetime.idk>, <cryptography.idk>, <tls.idk>, <webclient.idk>;

using standard::io::console,
      standard::sockets,
      standard::crypto::X509,
      standard::datetime,
      standard::tls13,
      standard::web;

global TLS13_CONN g_tls;
global WEB_STREAM g_s;
global byte[20000] g_pem, g_der;
global X509_CERT[4] g_roots;
global byte[70000] g_out;
global int fails = 0;

def check(byte* name, bool ok) -> void
{
    if (ok) { print(name); print(" ok\n\0"); } else { print(name); print(" FAIL\n\0"); fails++; };
};

def eq(byte* a, byte* b, int n) -> bool
{
    int i;
    for (i = 0; i < n; i++) { if (a[i] != b[i]) { return false; }; };
    return true;
};

def main() -> int
{
    int n, rc, status, op, i;
    byte[300] msg;
    DateTime utc;

    n = read_file("tests/tls13_data/ec.crt\0", g_pem, 6000);
    if (n <= 0) { print("run from the repository root\n\0"); flush(); return 1; };
    rc = X509::x509_load_pem_bundle(g_pem, n, g_der, 6000, g_roots, 4);
    utc = dt_now_utc();
    init();

    rc = web_connect(@g_s, @g_tls, "localhost\0", (u16)4443, 1, g_roots, rc, 1, dt_to_unix_sec(@utc));
    check("connect and tls\0", rc == 0);
    if (rc != 0) { print(rc); print("\n\0"); flush(); return 1; };

    n = http_request(@g_s, "GET\0", "localhost\0", "/hello\0", (byte*)0, (byte*)0, 0, g_out, 70000, @status);
    check("GET content-length\0", status == 200 & n == 12 & eq(g_out, "hello world\n\0", 12));

    n = http_request(@g_s, "GET\0", "localhost\0", "/chunked\0", (byte*)0, (byte*)0, 0, g_out, 70000, @status);
    check("GET chunked\0", status == 200 & n == 17 & eq(g_out, "chunk1-chunk2-end\0", 17));

    n = http_request(@g_s, "POST\0", "localhost\0", "/echo\0", "Content-Type: text/plain\r\n\0", "ping-body\0", 9, g_out, 70000, @status);
    check("POST echo keep-alive\0", status == 200 & n == 9 & eq(g_out, "ping-body\0", 9));

    n = http_request(@g_s, "GET\0", "localhost\0", "/big\0", (byte*)0, (byte*)0, 0, g_out, 70000, @status);
    check("GET 60000 bytes\0", status == 200 & n == 60000 & g_out[0] == (byte)65 & g_out[59999] == (byte)65);

    n = http_request(@g_s, "GET\0", "localhost\0", "/missing\0", (byte*)0, (byte*)0, 0, g_out, 70000, @status);
    check("404 status\0", status == 404);
    web_close(@g_s);

    // WebSocket on a fresh connection
    rc = web_connect(@g_s, @g_tls, "localhost\0", (u16)4443, 1, g_roots, 1, 1, dt_to_unix_sec(@utc));
    check("connect 2\0", rc == 0);
    check("ws handshake\0", ws_handshake(@g_s, "localhost\0", "/ws\0", (byte*)0));
    check("ws send text\0", ws_send(@g_s, 1, "hello ws\0", 8));
    n = ws_recv(@g_s, g_out, 70000, @op);
    check("ws echo text\0", n == 8 & op == 1 & eq(g_out, "hello ws\0", 8));
    for (i = 0; i < 300; i++) { msg[i] = (byte)(i * 3); };
    check("ws send binary 300\0", ws_send(@g_s, 2, @msg[0], 300));
    n = ws_recv(@g_s, g_out, 70000, @op);
    check("ws echo binary 300 (16 bit length)\0", n == 300 & op == 2 & eq(g_out, @msg[0], 300));
    check("ws ask for big frame\0", ws_send(@g_s, 1, "big\0", 3));
    n = ws_recv(@g_s, g_out, 70000, @op);
    check("ws receive 70000 byte style frame (64 bit length)\0", n == 66000 & op == 1 & g_out[0] == (byte)66);
    check("ws ask ping\0", ws_send(@g_s, 1, "ping\0", 4));
    n = ws_recv(@g_s, g_out, 70000, @op);
    check("ws data after server ping\0", n == 4 & eq(g_out, "pong\0", 4));
    check("ws fragmented\0", ws_send(@g_s, 1, "frag\0", 4));
    n = ws_recv(@g_s, g_out, 70000, @op);
    check("ws reassembled fragments\0", n == 9 & eq(g_out, "ab-cd-efg\0", 9));
    ws_close(@g_s, 1000);
    n = ws_recv(@g_s, g_out, 70000, @op);
    check("ws close frame\0", n == 0 - 2 & op == 8);
    web_close(@g_s);

    if (fails == 0) { print("ALL PASS\n\0"); } else { print("FAILS\n\0"); };
    flush();
    return fails;
};
