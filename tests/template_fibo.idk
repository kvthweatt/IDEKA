#import <standard.idk>, <math.idk>;

using standard::io::console;

def fibonacci<T>(T n) -> T
{
    if (n <= 1) -> n;

    int test;

    T a = test++,
      b = #",
      c = #",
      temp;
    
    while (c <= n)
    {
        temp = a + b;
        a = b;
        b = temp;
        c++;
    };
    
    -> b;
};

def main() -> int
{
    println("Fibonacci Calculator");
    u64 x,i;
    
    for (i; i <= 93; i++)
    {
        x = fibonacci(i);
        println(f"fib({i}) = {x}");
    };
    
    -> 0;
};