// Ed25519 test against vectors from the Python cryptography package (generated by tests/ed25519_gen.py)
#import <standard.idk>, <cryptography.idk>;

using standard::io::console,
      standard::crypto::Ed25519;

def hexval(byte c) -> int
{
    if (c >= (byte)97) { return (int)c - 87; };
    return (int)c - 48;
};

def unhex(byte* s, byte* out) -> int
{
    int n = 0;
    while (s[n * 2] != (byte)0) { out[n] = (byte)(hexval(s[n * 2]) * 16 + hexval(s[n * 2 + 1])); n++; };
    return n;
};

def same(byte* a, byte* b, int n) -> bool
{
    int i;
    for (i = 0; i < n; i++) { if (a[i] != b[i]) { return false; }; };
    return true;
};

global int fails = 0;

def check(byte* name, bool ok) -> void
{
    if (ok) { print(name); print(" ok\n\0"); } else { print(name); print(" FAIL\n\0"); fails++; };
    flush();
};

def run_case(byte* name, byte* s_seed, byte* s_pub, byte* s_msg, byte* s_sig) -> void
{
    byte[32] seed, pub, ex_pub, got_pub;
    byte[1100] msg;
    byte[64] sig, ex_sig, bad;
    int n, i;
    unhex(s_seed, seed);
    unhex(s_pub, ex_pub);
    n = unhex(s_msg, msg);
    unhex(s_sig, ex_sig);
    ed25519_publickey(seed, got_pub);
    check(name, same(got_pub, ex_pub, 32));
    ed25519_sign(seed, msg, n, sig);
    check("  signature matches\0", same(sig, ex_sig, 64));
    check("  verify ok\0", ed25519_verify(ex_pub, msg, n, ex_sig) == 1);
    for (i = 0; i < 64; i++) { bad[i] = ex_sig[i]; };
    bad[10] = bad[10] ^| (byte)1;
    check("  bad R rejected\0", ed25519_verify(ex_pub, msg, n, bad) == 0);
    for (i = 0; i < 64; i++) { bad[i] = ex_sig[i]; };
    bad[40] = bad[40] ^| (byte)2;
    check("  bad S rejected\0", ed25519_verify(ex_pub, msg, n, bad) == 0);
    if (n > 0)
    {
        msg[0] = msg[0] ^| (byte)1;
        check("  bad message rejected\0", ed25519_verify(ex_pub, msg, n, ex_sig) == 0);
    };
};

def main() -> int
{
    run_case("ed25519 case 0 (msg 0)\0", "9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60\0", "d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a\0", "\0", "e5564300c360ac729086e2cc806e828a84877f1eb8e5d974d873e065224901555fb8821590a33bacc61e39701cf9b46bd25bf5f0595bbe24655141438e7a100b\0");
    run_case("ed25519 case 1 (msg 1)\0", "4ccd089b28ff96da9db6c346ec114e0f5b8a319f35aba624da8cf6ed4fb8a6fb\0", "3d4017c3e843895a92b70aa74d1b7ebc9c982ccf2ec4968cc0cd55f12af4660c\0", "72\0", "92a009a9f0d4cab8720e820b5f642540a2b27b5416503f8fb3762223ebdb69da085ac1e43e15996e458f3613d0f11d8c387b2eaeb4302aeeb00d291612bb0c00\0");
    run_case("ed25519 case 2 (msg 2)\0", "c5aa8df43f9f837bedb7442f31dcb7b166d38535076f094b85ce3a2e0b4458f7\0", "fc51cd8e6218a1a38da47ed00230f0580816ed13ba3303ac5deb911548908025\0", "af82\0", "6291d657deec24024827e69c3abe01a30ce548a284743a445e3680d7db5ac3ac18ff9b538d16f290ae67f760984dc6594a7c15e9716ed28dc027beceea1ec40a\0");
    run_case("ed25519 case 3 (msg 1)\0", "540979cfc5c110c0da7ebcb0082010a321ebd27cabda91feb52c17223e58268e\0", "6721311cdac3d361c5daaa189043bcd0d4af0549904080d98a9ddafd4fb8ec60\0", "ed\0", "f36190778759d5355ac77804cdeee7637e98b2f892b6d745e5f1c786ca5d73e64a9d95406e2b2abf0a0eb6f129fc091745776252fcfbda7c6cb524434fac9f04\0");
    run_case("ed25519 case 4 (msg 31)\0", "c0587b808a265ac705a3eb7fd373af20f02b323eb4cce8d68fe186fe0555d2f1\0", "29ff6a117e720796b4c47550ef1df7183c1ced6f946a35f08e4e1ef53b98b5b3\0", "52081f7cd70402dc97d36ac64de4ea08de2027960f9c337c7cf9ff4abe8466\0", "0ac4de367cb756429edb69dc8660bf7b55a5dc11838edc2aa738f4239e129cd8cb60a5913a719861ce9427ab21660cd3a6440a6767a69ff0ba4fe7acc1944900\0");
    run_case("ed25519 case 5 (msg 32)\0", "f124153cdf6b179e76b57e6026da780e808627425152759742aadfed7c93c574\0", "59c98a167b42d77cbd124ae33113c836975fd4a3ebf07792a3a02a65dc48ed43\0", "1c4ac4a426c067c4fcc0341e3463d52216afc9e3226cf44c267fa9a4697efadf\0", "071b1a92c796a43b25787859d1104cfb557165bd1f4642ff47234e449a5d9c13d35285d14bbaa40642944deb826c8c9b8d9b8dd5b926a1d2f64a9a6084535801\0");
    run_case("ed25519 case 6 (msg 64)\0", "0b79063cda1d3398095c20ce47cf30908f026c4688f6ccf24e5f48d623e21f0d\0", "b28c5ca7637b634e667a9a8503220aaf7fd8c25cc532326640b7db9782abc65f\0", "d0469d2e770a752867dd9457c58d6b4534ca4828429fcce577c366b7136cdf61dd5220651e197d5090f0dbdb0e9235f43fc8938cd45c0dc1a201587804b80268\0", "d58a7a2fe7589e5ce8ec6cc20eb7ce6aba995730897895e3aa3c5c2bb4ce5d4ad714b03975c52cac24913f970691e8c15ace38dfc4453e87e1774ec9ab0aef06\0");
    run_case("ed25519 case 7 (msg 100)\0", "17b5a81bf564b489d0a4b5a208f9042a94f165812ff7fef0930a2ed48f575cf3\0", "3c3b3d3b67119d554f98027ee05c316d57cb66c93a6810b2be6af803814ab053\0", "3f89fd5e47a4321bb6564f0ab7276a7855d0b7eee1c4d4704d12521d0a69fd865e79ed60341bee10d9742f8acaf4cf166b16c83d707cccdbd68c8c4d7cf6bf01dc3835f2c5b914746b6a15e065af185f51ece64ef43a6ea9c6b8c9552754077dced61274\0", "9530f3c284ac09e82fcca4eecdd3ad0574cfd5d82b10deb72822793c50f726b9abe7c7a9d581c0c4544878b82fc5349ff3c704c86d1b92e459dbc0fb7e017807\0");
    run_case("ed25519 case 8 (msg 300)\0", "502e9a7d09d06559d00128a9a65dfc51c2c2e43ba3a9fcde157af8fb07602af4\0", "a40217f61839149a23cef8ca4cfe9b5c9b9c19a9425583cb132e01056ec6f36b\0", "\0", "96cd725a8315b815d976734cb4758358b33bf5b528cbcc30c9b75d78a424c5fa051e9959f887f4ed83cd9d9a65958bbe21ded86eb6b5f25ebf305e2d3e939e0b\0");
    run_case("ed25519 case 9 (msg 1000)\0", "2dd0c95cc1f1d59f6587f057cc6f1a6b9c1d275ebba61d1d443d3d6bf28026d8\0", "9a300384e63a14446eb9ed9e289648ed8df03d84188224f34b7ba80248507748\0", "\0", "ccce13f894922e143f271a1f3ce14ee15334a37396608876c848746cd8e68c6aa51d157b62e25b7fd4aae63873acc215018f083c5fdce13389eb62646e32c30b\0");
    {
        byte[32] p;
        byte[64] sg;
        byte[4] m;
        unhex("3d4017c3e843895a92b70aa74d1b7ebc9c982ccf2ec4968cc0cd55f12af4660c\0", p); unhex("92a009a9f0d4cab8720e820b5f642540a2b27b5416503f8fb3762223ebdb69daf52db7415978abc61b2c2eb6aeebfca0387b2eaeb4302aeeb00d291612bb0c10\0", sg); unhex("72\0", m);
        check("S plus L rejected\0", ed25519_verify(p, m, 1, sg) == 0);
    };
    if (fails == 0) { print("ALL PASS\n\0"); } else { print("FAILS\n\0"); };
    flush();
    return fails;
};
