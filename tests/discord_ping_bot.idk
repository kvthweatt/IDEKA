// Discord bot: replies "pong" to "!ping".
// Put the bot token in discord_token.txt (single line) in the working directory.
// Trust roots: /etc/ssl/certs/ca-certificates.crt on Linux, otherwise cacert.pem in the working directory.
// The bot needs the Message Content intent enabled in the Discord developer portal.
#import <standard.idk>, <socket_object_raw.idk>, <ffifio.idk>, <cryptography.idk>, <tls.idk>, <webclient.idk>, <json.idk>, <discord.idk>;

using standard::discord;

global DISCORD_BOT g_bot;
global DISCORD_EVENT g_ev;

main() -> int
{
    if (discord_start(@g_bot, "discord_token.txt\0",
                      INTENT_GUILD_MESSAGES + INTENT_DIRECT_MESSAGES + INTENT_MESSAGE_CONTENT) != 0) { return 1; };

    while (discord_next(@g_bot, @g_ev) == 1)
    {
        if (g_ev.author_bot == 0 & discord_content_is(@g_ev, "!ping\0"))
        {
            discord_reply(@g_bot, @g_ev, "pong\0");
        };
    };
    -> 0;
};
