    aead_case("chachapoly case 1 (pt 0, aad 0)\0", "3627b035ce7d1a15289c8bb7db36520c08a875a8f9f241c0288f5e4eb1ddf402\0", "fb3f9aa04c74943505f58ca4\0", "\0", "\0", "\0", "3672879578e583f9673c0ccf4b67b1e7\0");
