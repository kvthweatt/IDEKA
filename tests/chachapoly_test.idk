    poly_case("poly1305 len 31\0", "be0151b328b9cbbb551b900d9f330cf80ff959f33591d0f44afcd54b60306201\0", "596668031ac5d1ab6d0b429d86e91d19d0d1cdc108bac8eb449b3d72d8afe4\0", "800bc688c5487ef5fa737b7ce8caf6f6\0");
