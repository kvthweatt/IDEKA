// ChaCha20-Poly1305 test against vectors from the Python cryptography package (generated by tests/chachapoly_gen.py)
#import <standard.idk>, <cryptography.idk>;

using standard::io::console,
      standard::crypto::encryption::ChaCha20Poly1305;

def hexval(byte c) -> int
{
    if (c >= (byte)97) { return (int)c - 87; };
    return (int)c - 48;
};

def unhex(byte* s, byte* out) -> int
{
    int n = 0;
    while (s[n * 2] != (byte)0) { out[n] = (byte)(hexval(s[n * 2]) * 16 + hexval(s[n * 2 + 1])); n++; };
    return n;
};

def same(byte* a, byte* b, int n) -> bool
{
    int i;
    for (i = 0; i < n; i++) { if (a[i] != b[i]) { return false; }; };
    return true;
};

global int fails = 0;

def check(byte* name, bool ok) -> void
{
    if (ok) { print(name); print(" ok\n\0"); } else { print(name); print(" FAIL\n\0"); fails++; };
};

def poly_case(byte* name, byte* s_key, byte* s_msg, byte* s_tag) -> void
{
    byte[32] key;
    byte[2100] msg;
    byte[16] tag, ex;
    int n;
    unhex(s_key, key);
    n = unhex(s_msg, msg);
    unhex(s_tag, ex);
    poly1305_mac(key, msg, n, tag);
    check(name, same(tag, ex, 16));
};

def aead_case(byte* name, byte* s_key, byte* s_nonce, byte* s_aad, byte* s_pt, byte* s_ct, byte* s_tag) -> void
{
    byte[32] key;
    byte[12] nonce;
    byte[64] aad;
    byte[2100] pt, ct, ex_ct, dec;
    byte[16] tag, ex_tag, bad;
    int alen, plen, i;
    unhex(s_key, key);
    unhex(s_nonce, nonce);
    alen = unhex(s_aad, aad);
    plen = unhex(s_pt, pt);
    unhex(s_ct, ex_ct);
    unhex(s_tag, ex_tag);
    chachapoly_encrypt(key, nonce, aad, alen, pt, plen, ct, tag);
    check(name, same(ct, ex_ct, plen) & same(tag, ex_tag, 16));
    check("  decrypt verifies\0", chachapoly_decrypt(key, nonce, aad, alen, ex_ct, plen, dec, ex_tag) == 1 & same(dec, pt, plen));
    for (i = 0; i < 16; i++) { bad[i] = ex_tag[i]; };
    bad[5] = bad[5] ^| (byte)4;
    check("  tampered tag rejected\0", chachapoly_decrypt(key, nonce, aad, alen, ex_ct, plen, dec, bad) == 0);
};

def main() -> int
{
    poly_case("poly1305 RFC 8439 2.5.2\0", "85d6be7857556d337f4452fe42d506a80103808afb0db2fd4abff6af4149f51b\0", "43727970746f6772617068696320466f72756d2052657365617263682047726f7570\0", "a8061dc1305136c6c22b8baf0c0127a9\0");
    poly_case("poly1305 len 0\0", "999991fd17054f74f65e1b7ccbfd59aede06eec4b87037b69bfa4a3d76203a08\0", "\0", "de06eec4b87037b69bfa4a3d76203a08\0");
    poly_case("poly1305 len 1\0", "9c853ded7b6de7c810c98af56d2ba8e077d2f1ea40d019365f449c30d974c0ec\0", "f9\0", "33634e0913c2a0c600e5621ff01c7e38\0");
    poly_case("poly1305 len 15\0", "0d57669abb3acc4a4d3a796ffbc252d6db446b668c84270b5e8554230ece5206\0", "aad5dc6cbb5644e2b55ac6359837e1\0", "b95e2186f6983e74c9174836f530909a\0");
