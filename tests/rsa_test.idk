// RSA test against vectors from the Python cryptography package (generated by tests/rsa_gen.py)
#import <standard.idk>, <cryptography.idk>;

using standard::io::console,
      standard::crypto::RSA;

def hexval(byte c) -> int
{
    if (c >= (byte)97) { return (int)c - 87; };
    return (int)c - 48;
};

def unhex(byte* s, byte* out) -> int
{
    int n = 0;
    while (s[n * 2] != (byte)0) { out[n] = (byte)(hexval(s[n * 2]) * 16 + hexval(s[n * 2 + 1])); n++; };
    return n;
};

global int fails = 0;

def check(byte* name, bool ok) -> void
{
    if (ok) { print(name); print(" ok\n\0"); } else { print(name); print(" FAIL\n\0"); fails++; };
};

def key0() -> void
{
    byte[129] b_n;
    byte* s_n = "f412018481c9c3effc8220a5256978b432b97412593f3db2570e50b4029a831e2d6d8cb6ec6bc4c0d043f07ae0919a332fd51c77114f3f5dda3535387ba48f2a8947d34113433603ba5ff4e62ca5eefd3756bf27e0b216375b3cd965848d07399fff9649ec98bac7eeba0856b0caf3204db57202e4c6413df188d6ce7d0c5305\0";
    byte[4] b_e;
    byte* s_e = "010001\0";
    byte[65] b_p;
    byte* s_p = "fe9ab6bfef8e1280e7f4f7c52c3efc32fc22479e48279b1773b4e30ef78c31c1d2f625cf25744ac0eefc31964f8b69828812d947e95665ae2f8dc2c5ecf21813\0";
    byte[65] b_q;
    byte* s_q = "f568827aadf7b79f0849e428dbda9dfdce4d9f83fbe41b0230dcae5a57d4180bb14b6378c6f01e90eed182ee21b220477f848eba5664ad6ab22cf4553bfdfb87\0";
    byte[65] b_dp;
    byte* s_dp = "d5bc39d88d193ead5a8c8a87caea213c07f01b21643f63725f9f25d205bc7a74d54df055a282aad2a68dae6f19ddd6384f554b74940d049522b4a6231413f463\0";
    byte[65] b_dq;
    byte* s_dq = "c51881aabbebf71a8fd2a09f3c2bf1b5f52a1c92290d03b017c43577b390511b9af21c5ad513e6c8aa35b47d42acc8060461572c4ad4a2fecd4913971d0e9823\0";
    byte[65] b_qinv;
    byte* s_qinv = "7a79a876aada98cc13da5ba07839b0bfd5949c8bf465d1954f8772cdb28a1fbf529a7eb8981ea62248573b56013cda4a4352091ffcd57c0dd39217a6427968b9\0";
    byte[33] b_d256;
    byte* s_d256 = "2145ec0b9e66777f33680392580b8c12d29b528630fa42f08353d6b51624c54f\0";
    byte[49] b_d384;
    byte* s_d384 = "49795195d30fa7706f6695c36322032c0b17052c221ce478d2ee030f3f85c528b2afec7fc3a557eaa04992512b49148f\0";
    byte[129] b_pkcs256;
    byte* s_pkcs256 = "037cb0ad37ffadbb464f34103cc9ec9982f8fec07931cb51acab6f03e6dbdbc171a1330e1da232ea28eb402aeeba28eece43c9eff52cc4ba2433ed2d0832fd1084dbe78fbd59a9f1b29bb6c4d4bdfb485ef430d3ca04846a0ea4dcc5958649c3fc7b69f7780234b0dbdb186f7b47a92d8d29800da282aeba843bb35d5f4c342f\0";
    byte[129] b_pss256;
    byte* s_pss256 = "668efce8408ca7ab85b9aeaf7b72de3d16e56693a1ada96d7b7aefd4d27470f8301ed39193ac7dd5a2554cded741dbbce16449a0fcb7ee991d034b716834912b7b28b79ff687aab9a64416f1be6981bc02a543201260a0c606db1cf5280c3c9aa806c74ee9e0d3bb65b980de961c01e1e9e36e16d94943932ab94cbcfdc25c33\0";
    byte[129] b_pkcs384;
    byte* s_pkcs384 = "644f0cac4efe6b1c57756cf7657d64ae5e37d9dac22e7e0c8eee44c1933f999c12744da005ffc22dad359667750a87b9854434eb1f4a35801cea69570b7723d9027a889c017206cad66b5a058a09169129c349c9d425b50e974c9b65d94f20ab06f7520e719cb965de3389a336c7cb8c012b2dc6ed53c13b08c63b768ecfa842\0";
    byte[129] b_pss384;
    byte* s_pss384 = "93711c60180f3c8262de1ab18e0591d14ce11b113fc714e726d2252dfacb37ef29250f454383ee9abb2a228c1aefc551a9d97cba1c39b331df9beb1a9bc127cd86b77be4d44c20db109c6e4fd3cc95ce8350a67794705c069abeda34e22908bd6022ede62a644391e1e2603a695862dd8e4715375ea092414550ff415a6ad4cf\0";
    byte[128] mine, mine2;
    int l_n = unhex(s_n, @b_n[0]);
    int l_e = unhex(s_e, @b_e[0]);
    int l_p = unhex(s_p, @b_p[0]);
    int l_q = unhex(s_q, @b_q[0]);
    int l_dp = unhex(s_dp, @b_dp[0]);
    int l_dq = unhex(s_dq, @b_dq[0]);
    int l_qinv = unhex(s_qinv, @b_qinv[0]);
    int l_d256 = unhex(s_d256, @b_d256[0]);
    int l_d384 = unhex(s_d384, @b_d384[0]);
    int l_pkcs256 = unhex(s_pkcs256, @b_pkcs256[0]);
    int l_pss256 = unhex(s_pss256, @b_pss256[0]);
    int l_pkcs384 = unhex(s_pkcs384, @b_pkcs384[0]);
    int l_pss384 = unhex(s_pss384, @b_pss384[0]);
    int kl = l_n;
    byte[64] salt;
    int i;
    for (i = 0; i < 64; i++) { salt[i] = (byte)(i * 7 + 3); };
    print("key 1024 bits\n\0");
    check("pkcs256 verify\0", RSA::rsa_pkcs1_verify(@b_n[0], l_n, @b_e[0], l_e, 1, @b_d256[0], @b_pkcs256[0], kl));
    check("pss256 verify\0", RSA::rsa_pss_verify(@b_n[0], l_n, @b_e[0], l_e, 1, @b_d256[0], @b_pss256[0], kl));
    check("pkcs384 verify\0", RSA::rsa_pkcs1_verify(@b_n[0], l_n, @b_e[0], l_e, 2, @b_d384[0], @b_pkcs384[0], kl));
    check("pss384 verify\0", RSA::rsa_pss_verify(@b_n[0], l_n, @b_e[0], l_e, 2, @b_d384[0], @b_pss384[0], kl));
    b_pkcs256[5] = b_pkcs256[5] ^| (byte)1;
    check("tamper rejected\0", !RSA::rsa_pkcs1_verify(@b_n[0], l_n, @b_e[0], l_e, 1, @b_d256[0], @b_pkcs256[0], kl));
    b_pkcs256[5] = b_pkcs256[5] ^| (byte)1;
    check("pkcs256 sign equals\0", RSA::rsa_pkcs1_sign_crt(@mine[0], 1, @b_d256[0], @b_n[0], l_n, @b_p[0], l_p, @b_q[0], l_q, @b_dp[0], l_dp, @b_dq[0], l_dq, @b_qinv[0], l_qinv));
    for (i = 0; i < kl; i++) { if (mine[i] != b_pkcs256[i]) { fails++; print("sign mismatch\n\0"); break; }; };
    check("pss256 own roundtrip\0", RSA::rsa_pss_sign_crt(@mine2[0], 1, @b_d256[0], @salt[0], @b_n[0], l_n, @b_p[0], l_p, @b_q[0], l_q, @b_dp[0], l_dp, @b_dq[0], l_dq, @b_qinv[0], l_qinv));
    check("pss256 own verify\0", RSA::rsa_pss_verify(@b_n[0], l_n, @b_e[0], l_e, 1, @b_d256[0], @mine2[0], kl));
};

