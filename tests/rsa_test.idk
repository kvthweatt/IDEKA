    for (i = 0; i < kl; i++) { if (mine[i] != b_pkcs256[i]) { fails++; print("sign mismatch\n\0"); break; }; };
    check("pss256 own roundtrip\0", RSA::rsa_pss_sign_crt(@mine2[0], 1, @b_d256[0], @salt[0], @b_n[0], l_n, @b_p[0], l_p, @b_q[0], l_q, @b_dp[0], l_dp, @b_dq[0], l_dq, @b_qinv[0], l_qinv));
    check("pss256 own verify\0", RSA::rsa_pss_verify(@b_n[0], l_n, @b_e[0], l_e, 1, @b_d256[0], @mine2[0], kl));
};

def key2() -> void
{
    byte[513] b_n;
    byte* s_n = "\0";
    byte[4] b_e;
    byte* s_e = "010001\0";
    byte[257] b_p;
    byte* s_p = "\0";
    byte[257] b_q;
    byte* s_q = "\0";
    byte[257] b_dp;
    byte* s_dp = "\0";
    byte[257] b_dq;
    byte* s_dq = "\0";
    byte[257] b_qinv;
    byte* s_qinv = "\0";
    byte[33] b_d256;
    byte* s_d256 = "171a264a9d8dde1b90925c2a9d6304b9cada21f781026c9e297397c3b7afc19b\0";
    byte[49] b_d384;
