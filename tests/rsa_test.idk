    byte[513] b_pkcs384;
    byte* s_pkcs384 = "\0";
    byte[513] b_pss384;
    byte* s_pss384 = "\0";
    byte[512] mine, mine2;
    int l_n = unhex(s_n, @b_n[0]);
    int l_e = unhex(s_e, @b_e[0]);
    int l_p = unhex(s_p, @b_p[0]);
    int l_q = unhex(s_q, @b_q[0]);
    int l_dp = unhex(s_dp, @b_dp[0]);
    int l_dq = unhex(s_dq, @b_dq[0]);
    int l_qinv = unhex(s_qinv, @b_qinv[0]);
    int l_d256 = unhex(s_d256, @b_d256[0]);
    int l_d384 = unhex(s_d384, @b_d384[0]);
    int l_pkcs256 = unhex(s_pkcs256, @b_pkcs256[0]);
    int l_pss256 = unhex(s_pss256, @b_pss256[0]);
    int l_pkcs384 = unhex(s_pkcs384, @b_pkcs384[0]);
    int l_pss384 = unhex(s_pss384, @b_pss384[0]);
    int kl = l_n;
    byte[64] salt;
    int i;
    for (i = 0; i < 64; i++) { salt[i] = (byte)(i * 7 + 3); };
    print("key 4096 bits\n\0");
    check("pkcs256 verify\0", RSA::rsa_pkcs1_verify(@b_n[0], l_n, @b_e[0], l_e, 1, @b_d256[0], @b_pkcs256[0], kl));
    check("pss256 verify\0", RSA::rsa_pss_verify(@b_n[0], l_n, @b_e[0], l_e, 1, @b_d256[0], @b_pss256[0], kl));
    check("pkcs384 verify\0", RSA::rsa_pkcs1_verify(@b_n[0], l_n, @b_e[0], l_e, 2, @b_d384[0], @b_pkcs384[0], kl));
    check("pss384 verify\0", RSA::rsa_pss_verify(@b_n[0], l_n, @b_e[0], l_e, 2, @b_d384[0], @b_pss384[0], kl));
    b_pkcs256[5] = b_pkcs256[5] ^| (byte)1;
    check("tamper rejected\0", !RSA::rsa_pkcs1_verify(@b_n[0], l_n, @b_e[0], l_e, 1, @b_d256[0], @b_pkcs256[0], kl));
    b_pkcs256[5] = b_pkcs256[5] ^| (byte)1;
    check("pkcs256 sign equals\0", RSA::rsa_pkcs1_sign_crt(@mine[0], 1, @b_d256[0], @b_n[0], l_n, @b_p[0], l_p, @b_q[0], l_q, @b_dp[0], l_dp, @b_dq[0], l_dq, @b_qinv[0], l_qinv));
    for (i = 0; i < kl; i++) { if (mine[i] != b_pkcs256[i]) { fails++; print("sign mismatch\n\0"); break; }; };
    check("pss256 own roundtrip\0", RSA::rsa_pss_sign_crt(@mine2[0], 1, @b_d256[0], @salt[0], @b_n[0], l_n, @b_p[0], l_p, @b_q[0], l_q, @b_dp[0], l_dp, @b_dq[0], l_dq, @b_qinv[0], l_qinv));
    check("pss256 own verify\0", RSA::rsa_pss_verify(@b_n[0], l_n, @b_e[0], l_e, 1, @b_d256[0], @mine2[0], kl));
};

def main() -> int
{
    key0();
    key1();
    key2();
    if (fails == 0) { print("ALL PASS\n\0"); } else { print("FAILS\n\0"); };
    flush();
    return fails;
};