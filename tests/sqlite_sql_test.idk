// SELECT executor test against Python sqlite3 (generated by tests/sqlite_sql_gen.py). Output must equal tests/sqlite_sql.exp.
#import <standard.idk>, <sqlite.idk>, <sqlite_sql.idk>;

using standard::io::console,
      standard::sqlite;

global SQLITE_DB[3] g_dbs;
global SQ_STMT g_st;

def put_hex(int v) -> void
{
    byte[17] hx = "0123456789abcdef\0";
    print(hx[(v >> 4) & 15]);
    print(hx[v & 15]);
};

def main() -> int
{
    byte*[42] qs;
    int[42] qd;
    int q, d, i, j, rc, n, k, t;
    byte* p;
    double dv;
    i64 r;
    byte[256] nm;
    qs[0] = "select * from t_small\0"; qd[0] = 0;
    qs[1] = "select id, a, b from t_small where a > 100 order by a desc\0"; qd[1] = 0;
    qs[2] = "select rowid, a+1, a*2, a-1, a/3, a%7 from t_small where id < 25\0"; qd[2] = 0;
    qs[3] = "select upper(b), lower(b), length(b), substr(b,2), substr(b,-2,1), b||'-'||id from t_small\0"; qd[3] = 0;
    qs[4] = "select typeof(a), typeof(c), typeof(d), typeof(b) from t_small\0"; qd[4] = 0;
    qs[5] = "select id from t_small where b like 'v1%' or b like '%0'\0"; qd[5] = 0;
    qs[6] = "select id from t_small where a between -200 and 300\0"; qd[6] = 0;
    qs[7] = "select id from t_small where a in (0, 1, 127, 99999)\0"; qd[7] = 0;
    qs[8] = "select id from t_small where a not in (0,1) and a is not null\0"; qd[8] = 0;
    qs[9] = "select a, b from t_big where a > 100 and a < 130 order by a\0"; qd[9] = 0;
    qs[10] = "select a from t_big order by c desc, a limit 10\0"; qd[10] = 0;
    qs[11] = "select a, c from t_big order by c, a limit 10 offset 5\0"; qd[11] = 0;
    qs[12] = "select * from t_big where a = 2999\0"; qd[12] = 0;
    qs[13] = "select k, length(t), length(b) from t_ovf\0"; qd[13] = 0;
    qs[14] = "select k, substr(t, 3995, 20) from t_ovf where k >= 4000 order by k desc\0"; qd[14] = 0;
    qs[15] = "select * from t_empty\0"; qd[15] = 0;
    qs[16] = "select * from t_mixed order by a, rowid\0"; qd[16] = 0;
    qs[17] = "select a, b from t_mixed where b is null limit 7\0"; qd[17] = 0;
    qs[18] = "select coalesce(b, -1), ifnull(a, 'x') from t_mixed\0"; qd[18] = 0;
    qs[19] = "select 1+2, 'a'||'b', 7/2, 7.0/2, 7%3, -5, abs(-3), 'it''s', null\0"; qd[19] = 0;
    qs[20] = "select a as x, b as y from t_small order by x desc\0"; qd[20] = 0;
    qs[21] = "select a, b from t_small where a is not null order by 1, 2\0"; qd[21] = 0;
    qs[22] = "select round(c, 1), round(2.5), round(-2.5) from t_small where id < 5\0"; qd[22] = 0;
    qs[23] = "select min(a, 5), max(a, 5), nullif(a, 0) from t_small\0"; qd[23] = 0;
    qs[24] = "select id from t_small where not (a > 5)\0"; qd[24] = 0;
    qs[25] = "select id, a from t_small where a > 1 and (b like 'v%' or c < 0) order by id desc limit 3\0"; qd[25] = 0;
    qs[26] = "select a*1.5, a+0.25 from t_small where id < 8\0"; qd[26] = 0;
    qs[27] = "select t_big.a from t_big where t_big.a < 5\0"; qd[27] = 0;
    qs[28] = "select a, b from t_big where c > 999000 order by a\0"; qd[28] = 1;
    qs[29] = "select a from t_big order by b, a limit 20\0"; qd[29] = 1;
    qs[30] = "select * from t_big where a between 5000 and 5010\0"; qd[30] = 1;
    qs[31] = "select a, b from t_big order by a desc limit 5\0"; qd[31] = 1;
    qs[32] = "select length(b) from t_big where a < 12\0"; qd[32] = 0;
    qs[33] = "select a from t_big where b like 'row 1_ %'\0"; qd[33] = 1;
    qs[34] = "select a/0, a%0, 1/0 from t_small limit 2\0"; qd[34] = 0;
    qs[35] = "select typeof(1/2.0), typeof(1+1), typeof('1'+1), '12abc'+1, '3.5'*2\0"; qd[35] = 0;
    qs[36] = "select typeof(9223372036854775807 + 1), typeof(-9223372036854775807 - 10), typeof(3000000000*4000000000), typeof(4611686018427387904*2), typeof(-4611686018427387904*2), typeof(9223372036854775807*-1)\0"; qd[36] = 0;
    qs[37] = "select substr('hello', 0, 3), substr('hello', -3), substr('hello', 2, -1), substr('héllo wörld', 2, 4)\0"; qd[37] = 0;
    qs[38] = "select a, c from t_big order by c desc limit 3\0"; qd[38] = 2;
    qs[39] = "select x'00ff7f', hex(x'00ff7f'), hex('abc'), hex(255), typeof(x''), length(x'0102'), hex(d) from t_small where id < 4\0"; qd[39] = 0;
    qs[40] = "select 1 where 0\0"; qd[40] = 0;
    qs[41] = "select 5 limit 0\0"; qd[41] = 0;
    for (d = 0; d < 3; d++)
    {
        byte*[3] paths;
        paths[0] = "tests/sqlite_fx_0.db\0";
        paths[1] = "tests/sqlite_fx_1.db\0";
        paths[2] = "tests/sqlite_fx_2.db\0";
        if (sq_open(@g_dbs[d], paths[d]) != 0) { print("open failed\n\0"); return 1; };
        if (sq_schema_load(@g_dbs[d]) < 0) { print("schema failed\n\0"); return 1; };
    };
    for (q = 0; q < 42; q++)
    {
        print("Q \0"); print(qs[q]); print("\n\0");
        if (sq_prepare(@g_st, @g_dbs[qd[q]], qs[q]) != 0)
        {
            print("ERR \0"); print(@g_st.err[0]); print("\n\0");
            continue;
        };
        print("C \0");
        for (j = 0; j < sq_column_count(@g_st); j++)
        {
            if (j > 0) { print("|\0"); };
            sq_column_name(@g_st, j, @nm[0], 256);
            print(@nm[0]);
        };
        print("\n\0");
        rc = sq_step(@g_st);
        while (rc == 1)
        {
            for (j = 0; j < sq_column_count(@g_st); j++)
            {
                if (j > 0) { print("|\0"); };
                t = sq_column_type(@g_st, j);
                if (t == SQ_NULL) { print("N\0"); };
                if (t == SQ_INTEGER) { print("i\0"); print(sq_column_int(@g_st, j)); };
                if (t == SQ_REAL)
                {
                    dv = sq_column_real(@g_st, j);
                    if (dv >= 0.0) { r = (i64)(dv * 1000.0 + 0.5); } else { r = (i64)(dv * 1000.0 - 0.5); };
                    print("r\0"); print(r);
                };
                if (t == SQ_TEXT)
                {
                    n = sq_column_bytes(@g_st, j);
                    p = sq_column_ptr(@g_st, j);
                    print("t\0"); print(n); print(":\0");
                    if (n <= 64) { for (k = 0; k < n; k++) { print(p[k]); }; }
                    else
                    {
                        for (k = 0; k < 32; k++) { print(p[k]); };
                        print("...\0");
                        for (k = n - 32; k < n; k++) { print(p[k]); };
                    };
                };
                if (t == SQ_BLOB)
                {
                    n = sq_column_bytes(@g_st, j);
                    p = sq_column_ptr(@g_st, j);
                    print("b\0"); print(n); print(":\0");
                    for (k = 0; k < n & k < 8; k++) { put_hex((int)p[k]); };
                };
            };
            print("\n\0");
            rc = sq_step(@g_st);
        };
        if (rc < 0) { print("STEP ERR \0"); print(@g_st.err[0]); print("\n\0"); };
        sq_finalize(@g_st);
    };
    return 0;
};
