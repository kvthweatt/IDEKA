{
  "name": "IDEKA.lang",
  "publisher": "IDEKA",
  "displayName": "IDEKA Language Support",
  "description": "IDEKA syntax highlighting, editor configuration, and snippets",
  "version": "1.0.0",
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "IDEKA",
        "aliases": [
          "IDEKA"
        ],
        "extensions": [
          ".idk"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "IDEKA",
        "scopeName": "source.IDEKA",
        "path": "./syntaxes/IDEKA.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "IDEKA",
        "path": "./snippets/IDEKA.snippet.lang-1.0.0.json"
      }
    ]
  }
}
