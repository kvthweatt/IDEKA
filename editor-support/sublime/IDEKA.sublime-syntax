%YAML 1.2
---
name: IDEKA
file_extensions: [idk]
scope: source.IDEKA

variables:
  identifier: '\b[a-zA-Z_][a-zA-Z0-9_]*\b'
  
contexts:
  main:
    - match: '///'
      scope: punctuation.definition.comment.begin.IDEKA
      push: multiline_comment

    # Single-line comments
    - match: '//.*$\n?'
      scope: comment.line.double-slash.IDEKA

    # Ditto operator #"
    - match: "#\""
      scope: keyword.operator.ditto.IDEKA

    # Preprocessor directives
    - match: '^\s*(#import|#def|#psub|#dir|#ifdef|#ifndef|#ifpsub|#ifnpsub|#elif|#else|#endif|#warn|#stop)\b'
      captures:
        1: punctuation.definition.preprocessor.IDEKA
        2: keyword.control.preprocessor.IDEKA
      scope: meta.preprocessor.IDEKA

    # i-strings (interpolated strings)
    - match: 'i"'
      scope: string.quoted.double.IDEKA punctuation.definition.string.begin.IDEKA
      push: i_string_body

    # f-strings (formatted strings)
    - match: 'f"'
      scope: string.quoted.double.IDEKA punctuation.definition.string.begin.IDEKA
      push: f_string_body

    # g-strings (global strings)
    - match: 'g"'
      scope: string.quoted.double.IDEKA punctuation.definition.string.begin.IDEKA
      push: string_body

    # Regular strings
    - match: '"'
      scope: string.quoted.double.IDEKA punctuation.definition.string.begin.IDEKA
      push: string_body

    # Character literals
    - match: "'"
      scope: string.quoted.single.IDEKA punctuation.definition.string.begin.IDEKA
      push: char_body

    # Namespace/scope resolution (check this BEFORE keywords)
    - match: '({{identifier}})(::)'
      captures:
        1: entity.name.namespace.IDEKA
        2: punctuation.accessor.double-colon.IDEKA

    # Trait name before 'object' keyword - light blue
    - match: '\b({{identifier}})(?=\s+object\b)'
      captures:
        1: entity.name.trait.IDEKA

    # Primitive types (MUST come before keywords)
    - match: '\b(int|uint|long|ulong|float|double|void|bool|byte|char|data)\b'
      scope: storage.type.primitive.IDEKA

    # Storage types
    - match: '\b(enum|struct|object|union|dict)\b'
      scope: storage.type.IDEKA

    # Keywords (but NOT types)
    - match: '\b(alignof|and|as|asm|assert|auto|break|case|catch|cdecl|const|constraint|continue|def|defer|default|deprecate|do|elif|else|endianof|error|export|extern|false|fastcall|for|from|goto|global|has|heap|if|in|inline|interface|is|jump|label|local|module|namespace|noreturn|not|operator|or|private|public|register|return|signed|sizeof|stack|stdcall|super|switch|this|thiscall|throw|trait|true|try|typeof|union|unsigned|using|vectorcall|volatile|while|xor)\b'
      scope: keyword.control.IDEKA

    # Type modifiers
    - match: '\b(async|escape|noinit|singinit|const|volatile|signed|unsigned|heap|stack|register|macro|contract|emitideka|compiler|comptime|idkvm|naked|effect|attenuate|binding)\b'
      scope: storage.modifier.IDEKA

    # Special methods (dunder methods)
    - match: '\b__[a-z]+__\b'
      scope: entity.name.function.special.IDEKA

    # Function definitions with optional template parameters: def name<T, U>(...)
    - match: '\b(def|cdecl|stdcall|fastcall|thiscall|vectorcall)\s+({{identifier}})(\s*<[a-zA-Z_][a-zA-Z0-9_,\s]*>)?'
      captures:
        1: keyword.control.IDEKA
        2: entity.name.function.IDEKA
        3: storage.type.generic.IDEKA

    # Template call sites: identifier<Type>(...)
    - match: '({{identifier}})(<[a-zA-Z_][a-zA-Z0-9_,\s]*>)(?=\s*\()'
      captures:
        1: entity.name.function.call.IDEKA
        2: storage.type.generic.IDEKA

    # Function calls
    - match: '{{identifier}}(?=\s*\()'
      scope: entity.name.function.call.IDEKA

    # Variables and identifiers (catch-all, must be near the end)
    - match: '{{identifier}}'
      scope: variable.other.IDEKA

    # Member access
    - match: '\.'
      scope: punctuation.accessor.dot.IDEKA

    # Address-of operator
    - match: '@'
      scope: keyword.operator.address.IDEKA

    - match: '\$'
      scope: keyword.operator.stringify.IDEKA

    - match: '#'
      scope: keyword.operator.tag.IDEKA

    # Pointer dereference
    - match: '\*(?=[a-zA-Z_])'
      scope: keyword.operator.dereference.IDEKA

    # Numbers - Duotrigesimal
    - match: '\b0d[0-9A-V]+(l|u|ul|b|c)?\b'
      scope: constant.numeric.duotrigesimal.IDEKA

    # Numbers - Hex
    - match: '\b0x[0-9A-F]+(l|u|ul|b|c)?\b'
      scope: constant.numeric.hex.IDEKA

    # Numbers - Octal
    - match: '\b0o[0-7]+(l|u|ul|b|c)?\b'
      scope: constant.numeric.octal.IDEKA

    # Numbers - Binary
    - match: '\b0b[01]+(l|u|ul|b|c)?\b'
      scope: constant.numeric.binary.IDEKA

    # Numbers - Float
    - match: '\b\d+(\.\d+)?[f|d]\b'
      scope: constant.numeric.float.IDEKA

    # Numbers - Integer
    - match: '\b\d+(l|u|ul|b|c)?\b'
      scope: constant.numeric.integer.IDEKA

    # Operators - Custom operator definition
    - match: '\[([~!$%^&*\-+=|<>]+)\]'
      scope: keyword.operator.custom.IDEKA

    # Operators - Custom operator usage
    - match: '(``|`!&=|`!\|=|`\^\^=|`&=|`\|=|<<=|>>=|!&|!\||<->|\^\^=|&=|\|=|%=|\^=|\+=|-=|\*=|/=|`!&|`!\||`\^\^|\+\+|--|\\|`|;|~\$|#)'
      scope: keyword.operator.custom.IDEKA
    # Operators - Comparison
    - match: '(==|!=|>=|<=|>|<)'
      scope: keyword.operator.comparison.IDEKA
    # Operators - Logical
    - match: '(\&|\||!|and|or|not|xor)'
      scope: keyword.operator.logical.IDEKA
    # Operators - Bitwise
    - match: '(`!|`&|`\||`\^\^|<<|>>)'
      scope: keyword.operator.bitwise.IDEKA
    # Operators - Arithmetic
    - match: '(\*\*|\+|-|\*|/|%|\^)'
      scope: keyword.operator.arithmetic.IDEKA
    # Operators - Assignment
    - match: '(=|@|\.\.|::|~|\?|:)'
      scope: keyword.operator.assignment.IDEKA

    # Range operator
    - match: '\.\.'
      scope: keyword.operator.range.IDEKA

    # Arrow for return types
    - match: '->'
      scope: keyword.operator.arrow.IDEKA
    - match: '<~'
      scope: keyword.operator.arrow.IDEKA

    # Brackets
    - match: '\{'
      scope: punctuation.section.block.begin.IDEKA
    - match: '\}'
      scope: punctuation.section.block.end.IDEKA
    - match: '\['
      scope: punctuation.section.brackets.begin.IDEKA
    - match: '\]'
      scope: punctuation.section.brackets.end.IDEKA
    - match: '\('
      scope: punctuation.section.parens.begin.IDEKA
    - match: '\)'
      scope: punctuation.section.parens.end.IDEKA

    # Punctuation
    - match: ';'
      scope: punctuation.terminator.IDEKA
    - match: ','
      scope: punctuation.separator.IDEKA
    - match: ':'
      scope: punctuation.separator.colon.IDEKA

  # String contexts
  string_body:
    - meta_scope: string.quoted.double.IDEKA
    - match: '"'
      scope: punctuation.definition.string.end.IDEKA
      pop: true
    - match: '\\[\\"nrt0]'
      scope: constant.character.escape.IDEKA

  i_string_body:
    - meta_scope: string.quoted.double.IDEKA
    - match: '"'
      scope: punctuation.definition.string.end.IDEKA
      pop: true
    - match: '\{\}'
      scope: punctuation.section.interpolation.begin.IDEKA
    - match: '\\[\\"nrt0]'
      scope: constant.character.escape.IDEKA
    - match: '[^{}"\\]+'
      scope: string.quoted.double.IDEKA

  f_string_body:
    - meta_scope: string.quoted.double.IDEKA
    - match: '"'
      scope: punctuation.definition.string.end.IDEKA
      pop: true
    - match: '\\[\\"nrt0]'
      scope: constant.character.escape.IDEKA
    - match: '\{[^}]*\}'
      scope: meta.interpolation.IDEKA

  i_string_statement_block:
    - match: ':'
      scope: punctuation.separator.colon.IDEKA
      set: i_string_statements
    - match: '(?=\S)'
      pop: true

  i_string_statements:
    - match: '\{'
      scope: punctuation.section.block.begin.IDEKA
      set: i_string_statements_inner
    - match: '(?=\S)'
      pop: true

  i_string_statements_inner:
    - include: main
    - match: '\}'
      scope: punctuation.section.block.end.IDEKA
      pop: true

  char_body:
    - meta_scope: string.quoted.single.IDEKA
    - match: "'"
      scope: punctuation.definition.string.end.IDEKA
      pop: true
    - match: '\\[\\''nrt0]'
      scope: constant.character.escape.IDEKA
    - match: '.'
      scope: string.quoted.single.IDEKA

  interpolation_scope:
    - match: '\}'
      scope: punctuation.section.interpolation.end.IDEKA
      pop: true
    - include: main

  multiline_comment:
    - meta_scope: comment.block.IDEKA
    - match: '///'
      scope: punctuation.definition.comment.end.IDEKA
      pop: true
